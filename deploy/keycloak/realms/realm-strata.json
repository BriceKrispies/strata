{
  "realm": "strata",
  "displayName": "Strata test realm (local development only)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "verifyEmail": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 300,
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "development-only-rsa-signing-key",
        "providerId": "rsa",
        "subComponents": {},
        "config": {
          "priority": ["1000"],
          "enabled": ["true"],
          "active": ["true"],
          "algorithm": ["RS256"],
          "keyUse": ["SIG"],
          "privateKey": [""],
          "certificate": [""]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "strata",
      "name": "Strata (local development only)",
      "description": "The OpenID Connect client of Strata. The secret is a development-only value.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "strata-dev-keycloak-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "redirectUris": [
        "http://127.0.0.1:4100/federation/oidc/callback",
        "http://localhost:4100/federation/oidc/callback",
        "http://tidewater.localhost:4100/federation/oidc/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "strata-consent",
      "name": "Strata with a consent screen (local development only)",
      "description": "The same client with a consent screen, so that a test can cancel at the identity provider. The secret is a development-only value.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "strata-dev-keycloak-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": true,
      "redirectUris": [
        "http://127.0.0.1:4100/federation/oidc/callback",
        "http://localhost:4100/federation/oidc/callback",
        "http://tidewater.localhost:4100/federation/oidc/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "urn:strata:keycloak-saml",
      "name": "Strata over SAML (local development only)",
      "description": "The SAML service provider of Strata. Its entity identifier is the sp_entity_id of deploy/keycloak/saml.config.json.",
      "enabled": true,
      "protocol": "saml",
      "publicClient": false,
      "frontchannelLogout": false,
      "consentRequired": false,
      "redirectUris": [
        "http://127.0.0.1:4100/federation/saml/acs",
        "http://localhost:4100/federation/saml/acs",
        "http://tidewater.localhost:4100/federation/saml/acs"
      ],
      "attributes": {
        "saml_assertion_consumer_url_post": "http://127.0.0.1:4100/federation/saml/acs",
        "saml_force_name_id_format": "true",
        "saml_name_id_format": "username",
        "saml.authnstatement": "true",
        "saml.assertion.signature": "true",
        "saml.server.signature": "false",
        "saml.client.signature": "false",
        "saml.encrypt": "false",
        "saml.force.post.binding": "true",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml.onetimeuse.condition": "false",
        "saml_signature_canonicalization_method": "http://www.w3.org/2001/10/xml-exc-c14n#"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "attribute.name": "email",
            "friendly.name": "email",
            "attribute.nameformat": "Basic"
          }
        },
        {
          "name": "name",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "firstName",
            "attribute.name": "name",
            "friendly.name": "name",
            "attribute.nameformat": "Basic"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "upstream",
      "displayName": "upstream",
      "providerId": "keycloak-oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "strata-broker",
        "clientSecret": "strata-dev-broker-secret",
        "clientAuthMethod": "client_secret_post",
        "issuer": "http://keycloak.localhost:8180/realms/upstream",
        "authorizationUrl": "http://keycloak.localhost:8180/realms/upstream/protocol/openid-connect/auth",
        "tokenUrl": "http://keycloak.localhost:8180/realms/upstream/protocol/openid-connect/token",
        "userInfoUrl": "http://keycloak.localhost:8180/realms/upstream/protocol/openid-connect/userinfo",
        "jwksUrl": "http://keycloak.localhost:8180/realms/upstream/protocol/openid-connect/certs",
        "logoutUrl": "http://keycloak.localhost:8180/realms/upstream/protocol/openid-connect/logout",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "defaultScope": "openid email profile",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "syncMode": "IMPORT"
      }
    }
  ],
  "users": [
    {
      "username": "olive",
      "email": "olive@keycloak.example",
      "emailVerified": true,
      "firstName": "Olive",
      "lastName": "Oidc",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "strata-dev-olive", "temporary": false }]
    },
    {
      "username": "sana",
      "email": "sana@keycloak.example",
      "emailVerified": true,
      "firstName": "Sana",
      "lastName": "Saml",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "strata-dev-sana", "temporary": false }]
    },
    {
      "username": "cora",
      "email": "cora@keycloak.example",
      "emailVerified": true,
      "firstName": "Cora",
      "lastName": "Cancel",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "strata-dev-cora", "temporary": false }]
    }
  ]
}
