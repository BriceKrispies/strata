    {
      "id": "deny",
      "description": "A failed check of a policy whose condition did not hold.",
      "params": [{"name":"acc","type":"auth-state"},{"name":"rule","type":"string"}],
      "returns": "auth-state",
      "body": "auth-state{granted: acc.granted, checks: concat(acc.checks, [rule-check{rule, passed: false}])}",
      "examples": [
        {"args":{"acc":{"checks":[]},"rule":"policy:p"},"result":{"checks":[{"rule":"policy:p","passed":false}]}}
      ]
    },
    {
      "id": "policy-step",
      "description": "One applicable policy in authorize: no condition grants; a condition grants only when it evaluates to true; false, null or an evaluation error is a failed check.",
      "params": [{"name":"policy","type":"policy-def"},{"name":"env","type":"rule-env"},{"name":"acc","type":"auth-state"}],
      "returns": "auth-state",
      "let": [{"name":"rule","expr":"format(\"policy:{}\", policy.id)"}],
      "body": "match policy.condition { None => auth-state{granted: rule-check{rule, passed: true}, checks: acc.checks}, Some(c) => match eval(rule-language, c, env) { Ok(v) => match v { Bool(b) => if b then auth-state{granted: rule-check{rule, passed: true}, checks: acc.checks} else call deny(acc, rule), _ => call deny(acc, rule) }, Err(e) => call deny(acc, rule) } }",
      "examples": [
        {"args":{"policy":{"id":"writers_read_notes","role":"writer","resource":{"Object":"note"},"actions":["Read","Create"]},"env":{"param":{},"now":{"Time":5000},"principal":{"Str":"alpha:writer1"},"has_role":["public","writer"]},"acc":{"checks":[]}},"result":{"granted":{"rule":"policy:writers_read_notes","passed":true},"checks":[]}},
        {"description":"Comparing a string with an int is an evaluation error, which fails the check.","args":{"policy":{"id":"writers_read_notes","role":"writer","resource":{"Object":"note"},"actions":["Read","Create"],"condition":{"Cmp":{"op":"Eq","left":{"Lit":{"Str":"a"}},"right":{"Lit":{"Int":1}}}}},"env":{"param":{},"now":{"Time":5000},"principal":"Null","has_role":[]},"acc":{"checks":[]}},"result":{"checks":[{"rule":"policy:writers_read_notes","passed":false}]}}
      ]
    },
    {
      "id": "authorize",
      "description": "rules.rs authorize: default deny; the owner is allowed everything; otherwise the first applicable policy (in id order) without a condition, or whose condition is true, grants; a condition that is false, null or fails to evaluate denies; with no applicable policy the check is policy:none. Check details are not stated (see the report of WG-4933).",
      "params": [{"name":"tenant","type":"tenant"},{"name":"principal","type":"principal"},{"name":"now","type":"i64"},{"name":"action","type":"action"},{"name":"resource","type":"resource"},{"name":"subject","type":"subject"}],
      "returns": "decision",
      "let": [{"name":"roles","expr":"call roles-of(tenant, principal)"},{"name":"env","expr":"rule-env{record: if subject.old == null then subject.new else subject.old, old: subject.old, new: subject.new, param: {}, now: value.Time(now), principal: match principal { User(id) => value.Str(id), _ => value.Null }, has_role: roles}"},{"name":"state","expr":"fold(p in values(tenant.policies), acc = auth-state{granted: null, checks: []}, if acc.granted != null || !call policy-applies(p, roles, action, resource) then acc else call policy-step(p, env, acc))"}],
      "body": "if any(r in roles, r == 'owner') then decision{allowed: true, checks: [rule-check{rule: 'policy:builtin_owner', passed: true}]} else match state.granted { Some(c) => decision{allowed: true, checks: [c]}, None => decision{allowed: false, checks: if state.checks == [] then [rule-check{rule: 'policy:none', passed: false}] else state.checks} }",
      "examples": [
        {"description":"The owner role bypasses the policies.","args":{"tenant":{"members":{"alpha:owner":["owner"],"alpha:writer1":["writer"],"alpha:writer2":["writer"],"alpha:editor":["editor"]},"policies":{"public_reads_published":{"id":"public_reads_published","role":"public","resource":{"Object":"note"},"actions":["Read"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"status"}},"right":{"Lit":{"Str":"published"}}}}},"public_reads_people":{"id":"public_reads_people","role":"public","resource":{"Object":"person"},"actions":["Read"]},"writers_read_notes":{"id":"writers_read_notes","role":"writer","resource":{"Object":"note"},"actions":["Read","Create"]},"writers_edit_own":{"id":"writers_edit_own","role":"writer","resource":{"Object":"note"},"actions":["Update","Delete"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"$created_by"}},"right":"Principal"}}},"writers_add_people":{"id":"writers_add_people","role":"writer","resource":{"Object":"person"},"actions":["Create"]},"editors_manage_notes":{"id":"editors_manage_notes","role":"editor","resource":{"Object":"note"},"actions":["Read","Create","Update","Delete"]},"editors_manage_people":{"id":"editors_manage_people","role":"editor","resource":{"Object":"person"},"actions":["Read","Create","Update","Delete"]}}},"principal":{"User":"alpha:owner"},"now":5000,"action":"Delete","resource":{"Object":"note"},"subject":{"old":{"$id":{"Ref":1},"$version":{"Int":1},"$created_by":{"Str":"alpha:writer1"},"title":{"Str":"First"},"slug":{"Str":"first"}},"new":{"$id":{"Ref":1},"$version":{"Int":1},"$created_by":{"Str":"alpha:writer1"},"title":{"Str":"First"},"slug":{"Str":"first"}}}},"result":{"allowed":true,"checks":[{"rule":"policy:builtin_owner","passed":true}]}},
        {"description":"behaviour.rs create_applies_defaults_and_allocates_the_next_id: writers_read_notes grants the create.","args":{"tenant":{"members":{"alpha:owner":["owner"],"alpha:writer1":["writer"],"alpha:writer2":["writer"],"alpha:editor":["editor"]},"policies":{"public_reads_published":{"id":"public_reads_published","role":"public","resource":{"Object":"note"},"actions":["Read"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"status"}},"right":{"Lit":{"Str":"published"}}}}},"public_reads_people":{"id":"public_reads_people","role":"public","resource":{"Object":"person"},"actions":["Read"]},"writers_read_notes":{"id":"writers_read_notes","role":"writer","resource":{"Object":"note"},"actions":["Read","Create"]},"writers_edit_own":{"id":"writers_edit_own","role":"writer","resource":{"Object":"note"},"actions":["Update","Delete"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"$created_by"}},"right":"Principal"}}},"writers_add_people":{"id":"writers_add_people","role":"writer","resource":{"Object":"person"},"actions":["Create"]},"editors_manage_notes":{"id":"editors_manage_notes","role":"editor","resource":{"Object":"note"},"actions":["Read","Create","Update","Delete"]},"editors_manage_people":{"id":"editors_manage_people","role":"editor","resource":{"Object":"person"},"actions":["Read","Create","Update","Delete"]}}},"principal":{"User":"alpha:writer1"},"now":5000,"action":"Create","resource":{"Object":"note"},"subject":{"new":{"$id":{"Ref":1},"$version":{"Int":1},"$created_by":{"Str":"alpha:writer1"},"title":{"Str":"First"},"slug":{"Str":"first"}}}},"result":{"allowed":true,"checks":[{"rule":"policy:writers_read_notes","passed":true}]}},
        {"description":"behaviour.rs writers_edit_only_their_own_notes: writer2 is refused by writers_edit_own.","args":{"tenant":{"members":{"alpha:owner":["owner"],"alpha:writer1":["writer"],"alpha:writer2":["writer"],"alpha:editor":["editor"]},"policies":{"public_reads_published":{"id":"public_reads_published","role":"public","resource":{"Object":"note"},"actions":["Read"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"status"}},"right":{"Lit":{"Str":"published"}}}}},"public_reads_people":{"id":"public_reads_people","role":"public","resource":{"Object":"person"},"actions":["Read"]},"writers_read_notes":{"id":"writers_read_notes","role":"writer","resource":{"Object":"note"},"actions":["Read","Create"]},"writers_edit_own":{"id":"writers_edit_own","role":"writer","resource":{"Object":"note"},"actions":["Update","Delete"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"$created_by"}},"right":"Principal"}}},"writers_add_people":{"id":"writers_add_people","role":"writer","resource":{"Object":"person"},"actions":["Create"]},"editors_manage_notes":{"id":"editors_manage_notes","role":"editor","resource":{"Object":"note"},"actions":["Read","Create","Update","Delete"]},"editors_manage_people":{"id":"editors_manage_people","role":"editor","resource":{"Object":"person"},"actions":["Read","Create","Update","Delete"]}}},"principal":{"User":"alpha:writer2"},"now":5001,"action":"Update","resource":{"Object":"note"},"subject":{"old":{"$id":{"Ref":1},"$version":{"Int":1},"$created_by":{"Str":"alpha:writer1"},"title":{"Str":"First"},"slug":{"Str":"first"}},"new":{"$id":{"Ref":1},"$version":{"Int":1},"$created_by":{"Str":"alpha:writer1"},"title":{"Str":"First"},"slug":{"Str":"first"}}}},"result":{"allowed":false,"checks":[{"rule":"policy:writers_edit_own","passed":false}]}},
        {"description":"behaviour.rs writers_edit_only_their_own_notes: writer1 edits its own note.","args":{"tenant":{"members":{"alpha:owner":["owner"],"alpha:writer1":["writer"],"alpha:writer2":["writer"],"alpha:editor":["editor"]},"policies":{"public_reads_published":{"id":"public_reads_published","role":"public","resource":{"Object":"note"},"actions":["Read"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"status"}},"right":{"Lit":{"Str":"published"}}}}},"public_reads_people":{"id":"public_reads_people","role":"public","resource":{"Object":"person"},"actions":["Read"]},"writers_read_notes":{"id":"writers_read_notes","role":"writer","resource":{"Object":"note"},"actions":["Read","Create"]},"writers_edit_own":{"id":"writers_edit_own","role":"writer","resource":{"Object":"note"},"actions":["Update","Delete"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"$created_by"}},"right":"Principal"}}},"writers_add_people":{"id":"writers_add_people","role":"writer","resource":{"Object":"person"},"actions":["Create"]},"editors_manage_notes":{"id":"editors_manage_notes","role":"editor","resource":{"Object":"note"},"actions":["Read","Create","Update","Delete"]},"editors_manage_people":{"id":"editors_manage_people","role":"editor","resource":{"Object":"person"},"actions":["Read","Create","Update","Delete"]}}},"principal":{"User":"alpha:writer1"},"now":5002,"action":"Update","resource":{"Object":"note"},"subject":{"old":{"$id":{"Ref":1},"$version":{"Int":1},"$created_by":{"Str":"alpha:writer1"},"title":{"Str":"First"},"slug":{"Str":"first"}},"new":{"$id":{"Ref":1},"$version":{"Int":1},"$created_by":{"Str":"alpha:writer1"},"title":{"Str":"First"},"slug":{"Str":"first"}}}},"result":{"allowed":true,"checks":[{"rule":"policy:writers_edit_own","passed":true}]}},
        {"description":"No policy grants an anonymous create: policy:none.","args":{"tenant":{"members":{"alpha:owner":["owner"],"alpha:writer1":["writer"],"alpha:writer2":["writer"],"alpha:editor":["editor"]},"policies":{"public_reads_published":{"id":"public_reads_published","role":"public","resource":{"Object":"note"},"actions":["Read"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"status"}},"right":{"Lit":{"Str":"published"}}}}},"public_reads_people":{"id":"public_reads_people","role":"public","resource":{"Object":"person"},"actions":["Read"]},"writers_read_notes":{"id":"writers_read_notes","role":"writer","resource":{"Object":"note"},"actions":["Read","Create"]},"writers_edit_own":{"id":"writers_edit_own","role":"writer","resource":{"Object":"note"},"actions":["Update","Delete"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"$created_by"}},"right":"Principal"}}},"writers_add_people":{"id":"writers_add_people","role":"writer","resource":{"Object":"person"},"actions":["Create"]},"editors_manage_notes":{"id":"editors_manage_notes","role":"editor","resource":{"Object":"note"},"actions":["Read","Create","Update","Delete"]},"editors_manage_people":{"id":"editors_manage_people","role":"editor","resource":{"Object":"person"},"actions":["Read","Create","Update","Delete"]}}},"principal":"Anonymous","now":5000,"action":"Create","resource":{"Object":"note"},"subject":{"new":{"$id":{"Ref":1},"$version":{"Int":1},"$created_by":{"Str":"alpha:writer1"},"title":{"Str":"First"},"slug":{"Str":"first"}}}},"result":{"allowed":false,"checks":[{"rule":"policy:none","passed":false}]}},
        {"description":"A condition that is null fails: the note has no status, so record.status == published is null.","args":{"tenant":{"members":{"alpha:owner":["owner"],"alpha:writer1":["writer"],"alpha:writer2":["writer"],"alpha:editor":["editor"]},"policies":{"public_reads_published":{"id":"public_reads_published","role":"public","resource":{"Object":"note"},"actions":["Read"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"status"}},"right":{"Lit":{"Str":"published"}}}}},"public_reads_people":{"id":"public_reads_people","role":"public","resource":{"Object":"person"},"actions":["Read"]},"writers_read_notes":{"id":"writers_read_notes","role":"writer","resource":{"Object":"note"},"actions":["Read","Create"]},"writers_edit_own":{"id":"writers_edit_own","role":"writer","resource":{"Object":"note"},"actions":["Update","Delete"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"$created_by"}},"right":"Principal"}}},"writers_add_people":{"id":"writers_add_people","role":"writer","resource":{"Object":"person"},"actions":["Create"]},"editors_manage_notes":{"id":"editors_manage_notes","role":"editor","resource":{"Object":"note"},"actions":["Read","Create","Update","Delete"]},"editors_manage_people":{"id":"editors_manage_people","role":"editor","resource":{"Object":"person"},"actions":["Read","Create","Update","Delete"]}}},"principal":"Anonymous","now":5000,"action":"Read","resource":{"Object":"note"},"subject":{"old":{"$id":{"Ref":1},"$version":{"Int":1},"$created_by":{"Str":"alpha:writer1"},"title":{"Str":"First"},"slug":{"Str":"first"}},"new":{"$id":{"Ref":1},"$version":{"Int":1},"$created_by":{"Str":"alpha:writer1"},"title":{"Str":"First"},"slug":{"Str":"first"}}}},"result":{"allowed":false,"checks":[{"rule":"policy:public_reads_published","passed":false}]}},
