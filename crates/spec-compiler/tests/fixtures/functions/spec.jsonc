// Golden fixture for specc's function generation (WG-4934): the kernel's tenant rule language of the
// language fixture (tests/fixtures/language/spec.jsonc, WG-4931) and the functions of Exegra's function
// fixture (tests/fixtures/functions/fixtures.js, WG-4933), which state real decisions of the Strata kernel
// (crates/kernel/src/rules.rs: roles_of, may_attempt, authorize; crates/kernel/src/transition.rs:
// check_version) with examples taken from the kernel's own tests. The expected output is the pure crate
// crates/spec-compiler-functions-fixture: module rule_language (as in the language fixture) and module
// functions, whose tests are the examples. crates/spec-compiler/tests/functions.rs compares the
// generated authorize and check_version with the kernel on the same inputs.
{
  "exegra": "0.1",
  "system": { "id": "functions-fixture", "name": "Functions fixture", "generation": { "target": "rust" } },
  "types": [
    { "id": "cmp-op", "name": "Comparison", "kind": "enum", "values": ["Eq", "Ne", "Lt", "Le", "Gt", "Ge"] },
    { "id": "scope", "name": "Scope", "kind": "enum", "values": ["Record", "Old", "New"] },
    { "id": "value", "name": "Value", "kind": "union", "variants": [
      { "name": "Null" },
      { "name": "Bool", "newtype": true, "fields": [{ "name": "value", "type": "bool" }] },
      { "name": "Int", "newtype": true, "fields": [{ "name": "value", "type": "i64" }] },
      { "name": "Str", "newtype": true, "fields": [{ "name": "value", "type": "string" }] },
      { "name": "Time", "newtype": true, "fields": [{ "name": "value", "type": "i64" }] },
      { "name": "Ref", "newtype": true, "fields": [{ "name": "value", "type": "u64" }] },
      { "name": "List", "newtype": true, "fields": [{ "name": "value", "type": "list<value>" }] }
    ] },
    { "id": "expr", "name": "Expression", "kind": "union", "variants": [
      { "name": "Lit", "newtype": true, "fields": [{ "name": "value", "type": "value" }] },
      { "name": "Var", "fields": [{ "name": "scope", "type": "scope" }, { "name": "name", "type": "string" }] },
      { "name": "Through", "fields": [{ "name": "scope", "type": "scope" }, { "name": "field", "type": "string" }, { "name": "target", "type": "string" }] },
      { "name": "Param", "newtype": true, "fields": [{ "name": "name", "type": "string" }] },
      { "name": "Now" },
      { "name": "Principal" },
      { "name": "HasRole", "newtype": true, "fields": [{ "name": "role", "type": "string" }] },
      { "name": "Not", "newtype": true, "fields": [{ "name": "inner", "type": "expr" }] },
      { "name": "And", "newtype": true, "fields": [{ "name": "items", "type": "list<expr>" }] },
      { "name": "Or", "newtype": true, "fields": [{ "name": "items", "type": "list<expr>" }] },
      { "name": "Cmp", "fields": [{ "name": "op", "type": "cmp-op" }, { "name": "left", "type": "expr" }, { "name": "right", "type": "expr" }] },
      { "name": "In", "fields": [{ "name": "item", "type": "expr" }, { "name": "list", "type": "expr" }] },
      { "name": "IsNull", "newtype": true, "fields": [{ "name": "inner", "type": "expr" }] },
      { "name": "Len", "newtype": true, "fields": [{ "name": "inner", "type": "expr" }] },
      { "name": "Lower", "newtype": true, "fields": [{ "name": "inner", "type": "expr" }] },
      { "name": "Contains", "fields": [{ "name": "haystack", "type": "expr" }, { "name": "needle", "type": "expr" }] },
      { "name": "StartsWith", "fields": [{ "name": "text", "type": "expr" }, { "name": "prefix", "type": "expr" }] },
      { "name": "IsSlug", "newtype": true, "fields": [{ "name": "inner", "type": "expr" }] },
      { "name": "If", "fields": [{ "name": "cond", "type": "expr" }, { "name": "then", "type": "expr" }, { "name": "otherwise", "type": "expr" }] }
    ] },
    {"id":"action","name":"Action","kind":"enum","values":["Read","Create","Update","Delete","Manage"]},
    {"id":"resource","name":"Resource","kind":"union","variants":[{"name":"Object","newtype":true,"fields":[{"name":"object","type":"string"}]},{"name":"AnyObject"},{"name":"Schema"},{"name":"Members"}]},
    {"id":"principal","name":"Principal","kind":"union","variants":[{"name":"System"},{"name":"Anonymous"},{"name":"User","newtype":true,"fields":[{"name":"id","type":"string"}]}]},
    {"id":"policy-def","name":"Policy","kind":"struct","fields":[{"name":"id","type":"string"},{"name":"role","type":"string"},{"name":"resource","type":"resource"},{"name":"actions","type":"list<action>"},{"name":"condition","type":"option<expr>"}]},
    {"id":"tenant","name":"Tenant","kind":"struct","fields":[{"name":"members","type":"map<string, list<string>>"},{"name":"policies","type":"map<string, policy-def>"}]},
    {"id":"subject","name":"Subject","kind":"struct","fields":[{"name":"old","type":"option<map<string, value>>"},{"name":"new","type":"option<map<string, value>>"}]},
    {"id":"rule-env","name":"Rule environment","kind":"struct","fields":[{"name":"record","type":"option<map<string, value>>"},{"name":"old","type":"option<map<string, value>>"},{"name":"new","type":"option<map<string, value>>"},{"name":"param","type":"map<string, value>"},{"name":"now","type":"value"},{"name":"principal","type":"value"},{"name":"has_role","type":"list<string>"}]},
    {"id":"rule-check","name":"Check","kind":"struct","fields":[{"name":"rule","type":"string"},{"name":"passed","type":"bool"}]},
    {"id":"decision","name":"Decision","kind":"struct","fields":[{"name":"allowed","type":"bool"},{"name":"checks","type":"list<rule-check>"}]},
    {"id":"auth-state","name":"Authorization state","kind":"struct","fields":[{"name":"granted","type":"option<rule-check>"},{"name":"checks","type":"list<rule-check>"}]},
    {"id":"domain-error","name":"Domain error","kind":"union","variants":[{"name":"VersionConflict","fields":[{"name":"message","type":"string"}]}]},
    {"id":"unit","name":"Unit","kind":"union","variants":[{"name":"Unit"}]}
  ],
  "languages": [
    {
      "id": "rule-language",
      "name": "Tenant rule language",
      "ast": "expr",
      "values": "value",
      "shapes": ["bool", "int", "str", "time", "ref", "list", "any"],
      "anyShape": "any",
      "scopes": [
        { "name": "record", "kind": "record-scope", "value": "Record", "attributes": [
          { "name": "$id", "shape": "ref" }, { "name": "$version", "shape": "int" }, { "name": "$created_by", "shape": "str" },
          { "name": "$created_at", "shape": "time" }, { "name": "$updated_at", "shape": "time" } ] },
        { "name": "old", "kind": "record-scope", "value": "Old", "attributes": [
          { "name": "$id", "shape": "ref" }, { "name": "$version", "shape": "int" }, { "name": "$created_by", "shape": "str" },
          { "name": "$created_at", "shape": "time" }, { "name": "$updated_at", "shape": "time" } ] },
        { "name": "new", "kind": "record-scope", "value": "New", "attributes": [
          { "name": "$id", "shape": "ref" }, { "name": "$version", "shape": "int" }, { "name": "$created_by", "shape": "str" },
          { "name": "$created_at", "shape": "time" }, { "name": "$updated_at", "shape": "time" } ] },
        { "name": "param", "kind": "param" },
        { "name": "now", "kind": "constant" },
        { "name": "principal", "kind": "constant" },
        { "name": "has_role", "kind": "role-test" }
      ],
      "operators": [
        { "name": "lit-null", "variant": "Lit", "case": { "field": "value", "value": "Null" }, "syntax": { "form": "literal", "token": "null" }, "operands": [], "result": "any", "nulls": "total", "primitive": "literal" },
        { "name": "lit-bool", "variant": "Lit", "case": { "field": "value", "value": "Bool" }, "syntax": { "form": "literal", "token": "bool" }, "operands": [], "result": "bool", "nulls": "total", "primitive": "literal" },
        { "name": "lit-int", "variant": "Lit", "case": { "field": "value", "value": "Int" }, "syntax": { "form": "literal", "token": "int" }, "operands": [], "result": "int", "nulls": "total", "primitive": "literal" },
        { "name": "lit-str", "variant": "Lit", "case": { "field": "value", "value": "Str" }, "syntax": { "form": "literal", "token": "string" }, "operands": [], "result": "str", "nulls": "total", "primitive": "literal" },
        { "name": "lit-time", "variant": "Lit", "case": { "field": "value", "value": "Time" }, "syntax": { "form": "literal", "token": "time" }, "operands": [], "result": "time", "nulls": "total", "primitive": "literal" },
        { "name": "lit-ref", "variant": "Lit", "case": { "field": "value", "value": "Ref" }, "syntax": { "form": "literal", "token": "ref" }, "operands": [], "result": "ref", "nulls": "total", "primitive": "literal" },
        { "name": "lit-list", "variant": "Lit", "case": { "field": "value", "value": "List" }, "syntax": { "form": "literal", "token": "list" }, "operands": [], "result": "list", "nulls": "total", "primitive": "list-literal" },
        { "name": "var", "variant": "Var", "syntax": { "form": "scope" }, "operands": [], "nulls": "total", "primitive": "var" },
        { "name": "through", "variant": "Through", "syntax": { "form": "scope" }, "operands": [], "nulls": "total", "primitive": "through" },
        { "name": "param", "variant": "Param", "syntax": { "form": "scope", "token": "param" }, "operands": [], "result": "any", "nulls": "total", "primitive": "param" },
        { "name": "now", "variant": "Now", "syntax": { "form": "scope", "token": "now" }, "operands": [], "result": "time", "nulls": "total", "primitive": "now" },
        { "name": "principal", "variant": "Principal", "syntax": { "form": "scope", "token": "principal" }, "operands": [], "result": "str", "nulls": "total", "primitive": "principal" },
        { "name": "has-role", "variant": "HasRole", "syntax": { "form": "scope", "token": "has_role" }, "operands": [], "result": "bool", "nulls": "total", "primitive": "has-role" },
        { "name": "or", "variant": "Or", "syntax": { "form": "keyword-infix", "token": "or", "precedence": 1, "assoc": "n-ary" }, "operands": ["bool"], "result": "bool", "nulls": "kleene-or", "primitive": "or3" },
        { "name": "and", "variant": "And", "syntax": { "form": "keyword-infix", "token": "and", "precedence": 2, "assoc": "n-ary" }, "operands": ["bool"], "result": "bool", "nulls": "kleene-and", "primitive": "and3" },
        { "name": "not", "variant": "Not", "syntax": { "form": "prefix-word", "token": "not", "precedence": 3 }, "operands": ["bool"], "result": "bool", "nulls": "kleene-not", "primitive": "not3" },
        { "name": "eq", "variant": "Cmp", "case": { "field": "op", "value": "Eq" }, "syntax": { "form": "infix", "token": "==", "precedence": 4, "assoc": "none" }, "operands": ["any", "any"], "result": "bool", "nulls": "propagate", "primitive": "eq" },
        { "name": "ne", "variant": "Cmp", "case": { "field": "op", "value": "Ne" }, "syntax": { "form": "infix", "token": "!=", "precedence": 4, "assoc": "none" }, "operands": ["any", "any"], "result": "bool", "nulls": "propagate", "primitive": "ne" },
        { "name": "lt", "variant": "Cmp", "case": { "field": "op", "value": "Lt" }, "syntax": { "form": "infix", "token": "<", "precedence": 4, "assoc": "none" }, "operands": [["int", "time", "str"], ["int", "time", "str"]], "result": "bool", "nulls": "propagate", "primitive": "lt" },
        { "name": "le", "variant": "Cmp", "case": { "field": "op", "value": "Le" }, "syntax": { "form": "infix", "token": "<=", "precedence": 4, "assoc": "none" }, "operands": [["int", "time", "str"], ["int", "time", "str"]], "result": "bool", "nulls": "propagate", "primitive": "le" },
        { "name": "gt", "variant": "Cmp", "case": { "field": "op", "value": "Gt" }, "syntax": { "form": "infix", "token": ">", "precedence": 4, "assoc": "none" }, "operands": [["int", "time", "str"], ["int", "time", "str"]], "result": "bool", "nulls": "propagate", "primitive": "gt" },
        { "name": "ge", "variant": "Cmp", "case": { "field": "op", "value": "Ge" }, "syntax": { "form": "infix", "token": ">=", "precedence": 4, "assoc": "none" }, "operands": [["int", "time", "str"], ["int", "time", "str"]], "result": "bool", "nulls": "propagate", "primitive": "ge" },
        { "name": "in", "variant": "In", "syntax": { "form": "keyword-infix", "token": "in", "precedence": 4, "assoc": "none" }, "operands": ["any", "list"], "result": "bool", "nulls": "propagate", "primitive": "in-list" },
        { "name": "is-null", "variant": "IsNull", "syntax": { "form": "call", "token": "is_null" }, "operands": ["any"], "result": "bool", "nulls": "total", "primitive": "is-null" },
        { "name": "len", "variant": "Len", "syntax": { "form": "call", "token": "len" }, "operands": [["str", "list"]], "result": "int", "nulls": "propagate", "primitive": "len" },
        { "name": "lower", "variant": "Lower", "syntax": { "form": "call", "token": "lower" }, "operands": ["str"], "result": "str", "nulls": "propagate", "primitive": "lower" },
        { "name": "contains", "variant": "Contains", "syntax": { "form": "call", "token": "contains" }, "operands": [["str", "list"], "any"], "result": "bool", "nulls": "propagate", "primitive": "contains" },
        { "name": "starts-with", "variant": "StartsWith", "syntax": { "form": "call", "token": "starts_with" }, "operands": ["str", "str"], "result": "bool", "nulls": "propagate", "primitive": "starts-with" },
        { "name": "is-slug", "variant": "IsSlug", "syntax": { "form": "call", "token": "is_slug" }, "operands": ["str"], "result": "bool", "nulls": "propagate", "primitive": "is-slug" },
        { "name": "if", "variant": "If", "syntax": { "form": "call", "token": "if" }, "operands": ["bool", "any", "any"], "result": "operand:2", "nulls": "null-is-false", "primitive": "if" }
      ]
    }
  ],
  "functions": [
    {
      "id": "set-of",
      "description": "A BTreeSet<String> as a list: sorted by Unicode scalar values, each item once.",
      "params": [{"name":"items","type":"list<string>"}],
      "returns": "list<string>",
      "body": "fold(r in sortBy(r in items, r), acc = [], if any(a in acc, a == r) then acc else concat(acc, [r]))",
      "examples": [
        {"args":{"items":["writer","public","writer"]},"result":["public","writer"]},
        {"args":{"items":[]},"result":[]}
      ]
    },
    {
      "id": "roles-of",
      "description": "rules.rs roles_of: the roles a principal holds in a tenant; everyone but the system holds public.",
      "params": [{"name":"tenant","type":"tenant"},{"name":"principal","type":"principal"}],
      "returns": "list<string>",
      "body": "match principal { System => [], Anonymous => ['public'], User(id) => call set-of(concat(match get(tenant.members, id) { None => [], Some(roles) => roles }, ['public'])) }",
      "examples": [
        {"args":{"tenant":{"members":{"alpha:owner":["owner"],"alpha:writer1":["writer"],"alpha:writer2":["writer"],"alpha:editor":["editor"]},"policies":{"public_reads_published":{"id":"public_reads_published","role":"public","resource":{"Object":"note"},"actions":["Read"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"status"}},"right":{"Lit":{"Str":"published"}}}}},"public_reads_people":{"id":"public_reads_people","role":"public","resource":{"Object":"person"},"actions":["Read"]},"writers_read_notes":{"id":"writers_read_notes","role":"writer","resource":{"Object":"note"},"actions":["Read","Create"]},"writers_edit_own":{"id":"writers_edit_own","role":"writer","resource":{"Object":"note"},"actions":["Update","Delete"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"$created_by"}},"right":"Principal"}}},"writers_add_people":{"id":"writers_add_people","role":"writer","resource":{"Object":"person"},"actions":["Create"]},"editors_manage_notes":{"id":"editors_manage_notes","role":"editor","resource":{"Object":"note"},"actions":["Read","Create","Update","Delete"]},"editors_manage_people":{"id":"editors_manage_people","role":"editor","resource":{"Object":"person"},"actions":["Read","Create","Update","Delete"]}}},"principal":"System"},"result":[]},
        {"args":{"tenant":{"members":{"alpha:owner":["owner"],"alpha:writer1":["writer"],"alpha:writer2":["writer"],"alpha:editor":["editor"]},"policies":{"public_reads_published":{"id":"public_reads_published","role":"public","resource":{"Object":"note"},"actions":["Read"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"status"}},"right":{"Lit":{"Str":"published"}}}}},"public_reads_people":{"id":"public_reads_people","role":"public","resource":{"Object":"person"},"actions":["Read"]},"writers_read_notes":{"id":"writers_read_notes","role":"writer","resource":{"Object":"note"},"actions":["Read","Create"]},"writers_edit_own":{"id":"writers_edit_own","role":"writer","resource":{"Object":"note"},"actions":["Update","Delete"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"$created_by"}},"right":"Principal"}}},"writers_add_people":{"id":"writers_add_people","role":"writer","resource":{"Object":"person"},"actions":["Create"]},"editors_manage_notes":{"id":"editors_manage_notes","role":"editor","resource":{"Object":"note"},"actions":["Read","Create","Update","Delete"]},"editors_manage_people":{"id":"editors_manage_people","role":"editor","resource":{"Object":"person"},"actions":["Read","Create","Update","Delete"]}}},"principal":"Anonymous"},"result":["public"]},
        {"args":{"tenant":{"members":{"alpha:owner":["owner"],"alpha:writer1":["writer"],"alpha:writer2":["writer"],"alpha:editor":["editor"]},"policies":{"public_reads_published":{"id":"public_reads_published","role":"public","resource":{"Object":"note"},"actions":["Read"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"status"}},"right":{"Lit":{"Str":"published"}}}}},"public_reads_people":{"id":"public_reads_people","role":"public","resource":{"Object":"person"},"actions":["Read"]},"writers_read_notes":{"id":"writers_read_notes","role":"writer","resource":{"Object":"note"},"actions":["Read","Create"]},"writers_edit_own":{"id":"writers_edit_own","role":"writer","resource":{"Object":"note"},"actions":["Update","Delete"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"$created_by"}},"right":"Principal"}}},"writers_add_people":{"id":"writers_add_people","role":"writer","resource":{"Object":"person"},"actions":["Create"]},"editors_manage_notes":{"id":"editors_manage_notes","role":"editor","resource":{"Object":"note"},"actions":["Read","Create","Update","Delete"]},"editors_manage_people":{"id":"editors_manage_people","role":"editor","resource":{"Object":"person"},"actions":["Read","Create","Update","Delete"]}}},"principal":{"User":"alpha:writer1"}},"result":["public","writer"]},
        {"args":{"tenant":{"members":{"alpha:owner":["owner"],"alpha:writer1":["writer"],"alpha:writer2":["writer"],"alpha:editor":["editor"]},"policies":{"public_reads_published":{"id":"public_reads_published","role":"public","resource":{"Object":"note"},"actions":["Read"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"status"}},"right":{"Lit":{"Str":"published"}}}}},"public_reads_people":{"id":"public_reads_people","role":"public","resource":{"Object":"person"},"actions":["Read"]},"writers_read_notes":{"id":"writers_read_notes","role":"writer","resource":{"Object":"note"},"actions":["Read","Create"]},"writers_edit_own":{"id":"writers_edit_own","role":"writer","resource":{"Object":"note"},"actions":["Update","Delete"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"$created_by"}},"right":"Principal"}}},"writers_add_people":{"id":"writers_add_people","role":"writer","resource":{"Object":"person"},"actions":["Create"]},"editors_manage_notes":{"id":"editors_manage_notes","role":"editor","resource":{"Object":"note"},"actions":["Read","Create","Update","Delete"]},"editors_manage_people":{"id":"editors_manage_people","role":"editor","resource":{"Object":"person"},"actions":["Read","Create","Update","Delete"]}}},"principal":{"User":"alpha:stranger"}},"result":["public"]}
      ]
    },
    {
      "id": "policy-applies",
      "description": "Whether a policy names a role held, the action and the resource (AnyObject covers every object), its condition aside.",
      "params": [{"name":"policy","type":"policy-def"},{"name":"roles","type":"list<string>"},{"name":"action","type":"action"},{"name":"resource","type":"resource"}],
      "returns": "bool",
      "body": "any(r in roles, r == policy.role) && any(a in policy.actions, a == action) && match policy.resource { AnyObject => match resource { Object(_) => true, _ => policy.resource == resource }, _ => policy.resource == resource }",
      "examples": [
        {"args":{"policy":{"id":"writers_edit_own","role":"writer","resource":{"Object":"note"},"actions":["Update","Delete"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"$created_by"}},"right":"Principal"}}},"roles":["public","writer"],"action":"Update","resource":{"Object":"note"}},"result":true},
        {"args":{"policy":{"id":"writers_edit_own","role":"writer","resource":{"Object":"note"},"actions":["Update","Delete"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"$created_by"}},"right":"Principal"}}},"roles":["public","writer"],"action":"Read","resource":{"Object":"note"}},"result":false},
        {"args":{"policy":{"id":"writers_read_notes","role":"writer","resource":"AnyObject","actions":["Read","Create"]},"roles":["writer"],"action":"Read","resource":{"Object":"person"}},"result":true},
        {"args":{"policy":{"id":"writers_read_notes","role":"writer","resource":"AnyObject","actions":["Read","Create"]},"roles":["writer"],"action":"Read","resource":"Schema"},"result":false}
      ]
    },
    {
      "id": "may-attempt",
      "description": "rules.rs may_attempt: whether some policy could grant the action, conditions aside; the owner may do anything.",
      "params": [{"name":"tenant","type":"tenant"},{"name":"principal","type":"principal"},{"name":"action","type":"action"},{"name":"resource","type":"resource"}],
      "returns": "bool",
      "let": [{"name":"roles","expr":"call roles-of(tenant, principal)"}],
      "body": "any(r in roles, r == 'owner') || any(p in values(tenant.policies), call policy-applies(p, roles, action, resource))",
      "examples": [
