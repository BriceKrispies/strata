    {
      "id": "deny",
      "description": "A failed check of a policy whose condition did not hold.",
      "params": [{"name":"acc","type":"auth-state"},{"name":"rule","type":"string"}],
      "returns": "auth-state",
      "body": "auth-state{granted: acc.granted, checks: concat(acc.checks, [rule-check{rule, passed: false}])}",
      "examples": [
        {"args":{"acc":{"checks":[]},"rule":"policy:p"},"result":{"checks":[{"rule":"policy:p","passed":false}]}}
      ]
    },
    {
      "id": "policy-step",
      "description": "One applicable policy in authorize: no condition grants; a condition grants only when it evaluates to true; false, null or an evaluation error is a failed check.",
      "params": [{"name":"policy","type":"policy-def"},{"name":"env","type":"rule-env"},{"name":"acc","type":"auth-state"}],
      "returns": "auth-state",
      "let": [{"name":"rule","expr":"format(\"policy:{}\", policy.id)"}],
      "body": "match policy.condition { None => auth-state{granted: rule-check{rule, passed: true}, checks: acc.checks}, Some(c) => match eval(rule-language, c, env) { Ok(v) => match v { Bool(b) => if b then auth-state{granted: rule-check{rule, passed: true}, checks: acc.checks} else call deny(acc, rule), _ => call deny(acc, rule) }, Err(e) => call deny(acc, rule) } }",
      "examples": [
        {"args":{"policy":{"id":"writers_read_notes","role":"writer","resource":{"Object":"note"},"actions":["Read","Create"]},"env":{"param":{},"now":{"Time":5000},"principal":{"Str":"alpha:writer1"},"has_role":["public","writer"]},"acc":{"checks":[]}},"result":{"granted":{"rule":"policy:writers_read_notes","passed":true},"checks":[]}},
        {"description":"Comparing a string with an int is an evaluation error, which fails the check.","args":{"policy":{"id":"writers_read_notes","role":"writer","resource":{"Object":"note"},"actions":["Read","Create"],"condition":{"Cmp":{"op":"Eq","left":{"Lit":{"Str":"a"}},"right":{"Lit":{"Int":1}}}}},"env":{"param":{},"now":{"Time":5000},"principal":"Null","has_role":[]},"acc":{"checks":[]}},"result":{"checks":[{"rule":"policy:writers_read_notes","passed":false}]}}
      ]
    },
    {
      "id": "authorize",
      "description": "rules.rs authorize: default deny; the owner is allowed everything; otherwise the first applicable policy (in id order) without a condition, or whose condition is true, grants; a condition that is false, null or fails to evaluate denies; with no applicable policy the check is policy:none. Check details are not stated (see the report of WG-4933).",
      "params": [{"name":"tenant","type":"tenant"},{"name":"principal","type":"principal"},{"name":"now","type":"i64"},{"name":"action","type":"action"},{"name":"resource","type":"resource"},{"name":"subject","type":"subject"}],
      "returns": "decision",
      "let": [{"name":"roles","expr":"call roles-of(tenant, principal)"},{"name":"env","expr":"rule-env{record: if subject.old == null then subject.new else subject.old, old: subject.old, new: subject.new, param: {}, now: value.Time(now), principal: match principal { User(id) => value.Str(id), _ => value.Null }, has_role: roles}"},{"name":"state","expr":"fold(p in values(tenant.policies), acc = auth-state{granted: null, checks: []}, if acc.granted != null || !call policy-applies(p, roles, action, resource) then acc else call policy-step(p, env, acc))"}],
      "body": "if any(r in roles, r == 'owner') then decision{allowed: true, checks: [rule-check{rule: 'policy:builtin_owner', passed: true}]} else match state.granted { Some(c) => decision{allowed: true, checks: [c]}, None => decision{allowed: false, checks: if state.checks == [] then [rule-check{rule: 'policy:none', passed: false}] else state.checks} }",
      "examples": [
        {"description":"The owner role bypasses the policies.","args":{"tenant":{"members":{"alpha:owner":["owner"],"alpha:writer1":["writer"],"alpha:writer2":["writer"],"alpha:editor":["editor"]},"policies":{"public_reads_published":{"id":"public_reads_published","role":"public","resource":{"Object":"note"},"actions":["Read"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"status"}},"right":{"Lit":{"Str":"published"}}}}},"public_reads_people":{"id":"public_reads_people","role":"public","resource":{"Object":"person"},"actions":["Read"]},"writers_read_notes":{"id":"writers_read_notes","role":"writer","resource":{"Object":"note"},"actions":["Read","Create"]},"writers_edit_own":{"id":"writers_edit_own","role":"writer","resource":{"Object":"note"},"actions":["Update","Delete"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"$created_by"}},"right":"Principal"}}},"writers_add_people":{"id":"writers_add_people","role":"writer","resource":{"Object":"person"},"actions":["Create"]},"editors_manage_notes":{"id":"editors_manage_notes","role":"editor","resource":{"Object":"note"},"actions":["Read","Create","Update","Delete"]},"editors_manage_people":{"id":"editors_manage_people","role":"editor","resource":{"Object":"person"},"actions":["Read","Create","Update","Delete"]}}},"principal":{"User":"alpha:owner"},"now":5000,"action":"Delete","resource":{"Object":"note"},"subject":{"old":{"$id":{"Ref":1},"$version":{"Int":1},"$created_by":{"Str":"alpha:writer1"},"title":{"Str":"First"},"slug":{"Str":"first"}},"new":{"$id":{"Ref":1},"$version":{"Int":1},"$created_by":{"Str":"alpha:writer1"},"title":{"Str":"First"},"slug":{"Str":"first"}}}},"result":{"allowed":true,"checks":[{"rule":"policy:builtin_owner","passed":true}]}},
        {"description":"behaviour.rs create_applies_defaults_and_allocates_the_next_id: writers_read_notes grants the create.","args":{"tenant":{"members":{"alpha:owner":["owner"],"alpha:writer1":["writer"],"alpha:writer2":["writer"],"alpha:editor":["editor"]},"policies":{"public_reads_published":{"id":"public_reads_published","role":"public","resource":{"Object":"note"},"actions":["Read"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"status"}},"right":{"Lit":{"Str":"published"}}}}},"public_reads_people":{"id":"public_reads_people","role":"public","resource":{"Object":"person"},"actions":["Read"]},"writers_read_notes":{"id":"writers_read_notes","role":"writer","resource":{"Object":"note"},"actions":["Read","Create"]},"writers_edit_own":{"id":"writers_edit_own","role":"writer","resource":{"Object":"note"},"actions":["Update","Delete"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"$created_by"}},"right":"Principal"}}},"writers_add_people":{"id":"writers_add_people","role":"writer","resource":{"Object":"person"},"actions":["Create"]},"editors_manage_notes":{"id":"editors_manage_notes","role":"editor","resource":{"Object":"note"},"actions":["Read","Create","Update","Delete"]},"editors_manage_people":{"id":"editors_manage_people","role":"editor","resource":{"Object":"person"},"actions":["Read","Create","Update","Delete"]}}},"principal":{"User":"alpha:writer1"},"now":5000,"action":"Create","resource":{"Object":"note"},"subject":{"new":{"$id":{"Ref":1},"$version":{"Int":1},"$created_by":{"Str":"alpha:writer1"},"title":{"Str":"First"},"slug":{"Str":"first"}}}},"result":{"allowed":true,"checks":[{"rule":"policy:writers_read_notes","passed":true}]}},
        {"description":"behaviour.rs writers_edit_only_their_own_notes: writer2 is refused by writers_edit_own.","args":{"tenant":{"members":{"alpha:owner":["owner"],"alpha:writer1":["writer"],"alpha:writer2":["writer"],"alpha:editor":["editor"]},"policies":{"public_reads_published":{"id":"public_reads_published","role":"public","resource":{"Object":"note"},"actions":["Read"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"status"}},"right":{"Lit":{"Str":"published"}}}}},"public_reads_people":{"id":"public_reads_people","role":"public","resource":{"Object":"person"},"actions":["Read"]},"writers_read_notes":{"id":"writers_read_notes","role":"writer","resource":{"Object":"note"},"actions":["Read","Create"]},"writers_edit_own":{"id":"writers_edit_own","role":"writer","resource":{"Object":"note"},"actions":["Update","Delete"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"$created_by"}},"right":"Principal"}}},"writers_add_people":{"id":"writers_add_people","role":"writer","resource":{"Object":"person"},"actions":["Create"]},"editors_manage_notes":{"id":"editors_manage_notes","role":"editor","resource":{"Object":"note"},"actions":["Read","Create","Update","Delete"]},"editors_manage_people":{"id":"editors_manage_people","role":"editor","resource":{"Object":"person"},"actions":["Read","Create","Update","Delete"]}}},"principal":{"User":"alpha:writer2"},"now":5001,"action":"Update","resource":{"Object":"note"},"subject":{"old":{"$id":{"Ref":1},"$version":{"Int":1},"$created_by":{"Str":"alpha:writer1"},"title":{"Str":"First"},"slug":{"Str":"first"}},"new":{"$id":{"Ref":1},"$version":{"Int":1},"$created_by":{"Str":"alpha:writer1"},"title":{"Str":"First"},"slug":{"Str":"first"}}}},"result":{"allowed":false,"checks":[{"rule":"policy:writers_edit_own","passed":false}]}},
        {"description":"behaviour.rs writers_edit_only_their_own_notes: writer1 edits its own note.","args":{"tenant":{"members":{"alpha:owner":["owner"],"alpha:writer1":["writer"],"alpha:writer2":["writer"],"alpha:editor":["editor"]},"policies":{"public_reads_published":{"id":"public_reads_published","role":"public","resource":{"Object":"note"},"actions":["Read"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"status"}},"right":{"Lit":{"Str":"published"}}}}},"public_reads_people":{"id":"public_reads_people","role":"public","resource":{"Object":"person"},"actions":["Read"]},"writers_read_notes":{"id":"writers_read_notes","role":"writer","resource":{"Object":"note"},"actions":["Read","Create"]},"writers_edit_own":{"id":"writers_edit_own","role":"writer","resource":{"Object":"note"},"actions":["Update","Delete"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"$created_by"}},"right":"Principal"}}},"writers_add_people":{"id":"writers_add_people","role":"writer","resource":{"Object":"person"},"actions":["Create"]},"editors_manage_notes":{"id":"editors_manage_notes","role":"editor","resource":{"Object":"note"},"actions":["Read","Create","Update","Delete"]},"editors_manage_people":{"id":"editors_manage_people","role":"editor","resource":{"Object":"person"},"actions":["Read","Create","Update","Delete"]}}},"principal":{"User":"alpha:writer1"},"now":5002,"action":"Update","resource":{"Object":"note"},"subject":{"old":{"$id":{"Ref":1},"$version":{"Int":1},"$created_by":{"Str":"alpha:writer1"},"title":{"Str":"First"},"slug":{"Str":"first"}},"new":{"$id":{"Ref":1},"$version":{"Int":1},"$created_by":{"Str":"alpha:writer1"},"title":{"Str":"First"},"slug":{"Str":"first"}}}},"result":{"allowed":true,"checks":[{"rule":"policy:writers_edit_own","passed":true}]}},
        {"description":"No policy grants an anonymous create: policy:none.","args":{"tenant":{"members":{"alpha:owner":["owner"],"alpha:writer1":["writer"],"alpha:writer2":["writer"],"alpha:editor":["editor"]},"policies":{"public_reads_published":{"id":"public_reads_published","role":"public","resource":{"Object":"note"},"actions":["Read"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"status"}},"right":{"Lit":{"Str":"published"}}}}},"public_reads_people":{"id":"public_reads_people","role":"public","resource":{"Object":"person"},"actions":["Read"]},"writers_read_notes":{"id":"writers_read_notes","role":"writer","resource":{"Object":"note"},"actions":["Read","Create"]},"writers_edit_own":{"id":"writers_edit_own","role":"writer","resource":{"Object":"note"},"actions":["Update","Delete"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"$created_by"}},"right":"Principal"}}},"writers_add_people":{"id":"writers_add_people","role":"writer","resource":{"Object":"person"},"actions":["Create"]},"editors_manage_notes":{"id":"editors_manage_notes","role":"editor","resource":{"Object":"note"},"actions":["Read","Create","Update","Delete"]},"editors_manage_people":{"id":"editors_manage_people","role":"editor","resource":{"Object":"person"},"actions":["Read","Create","Update","Delete"]}}},"principal":"Anonymous","now":5000,"action":"Create","resource":{"Object":"note"},"subject":{"new":{"$id":{"Ref":1},"$version":{"Int":1},"$created_by":{"Str":"alpha:writer1"},"title":{"Str":"First"},"slug":{"Str":"first"}}}},"result":{"allowed":false,"checks":[{"rule":"policy:none","passed":false}]}},
        {"description":"A condition that is null fails: the note has no status, so record.status == published is null.","args":{"tenant":{"members":{"alpha:owner":["owner"],"alpha:writer1":["writer"],"alpha:writer2":["writer"],"alpha:editor":["editor"]},"policies":{"public_reads_published":{"id":"public_reads_published","role":"public","resource":{"Object":"note"},"actions":["Read"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"status"}},"right":{"Lit":{"Str":"published"}}}}},"public_reads_people":{"id":"public_reads_people","role":"public","resource":{"Object":"person"},"actions":["Read"]},"writers_read_notes":{"id":"writers_read_notes","role":"writer","resource":{"Object":"note"},"actions":["Read","Create"]},"writers_edit_own":{"id":"writers_edit_own","role":"writer","resource":{"Object":"note"},"actions":["Update","Delete"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"$created_by"}},"right":"Principal"}}},"writers_add_people":{"id":"writers_add_people","role":"writer","resource":{"Object":"person"},"actions":["Create"]},"editors_manage_notes":{"id":"editors_manage_notes","role":"editor","resource":{"Object":"note"},"actions":["Read","Create","Update","Delete"]},"editors_manage_people":{"id":"editors_manage_people","role":"editor","resource":{"Object":"person"},"actions":["Read","Create","Update","Delete"]}}},"principal":"Anonymous","now":5000,"action":"Read","resource":{"Object":"note"},"subject":{"old":{"$id":{"Ref":1},"$version":{"Int":1},"$created_by":{"Str":"alpha:writer1"},"title":{"Str":"First"},"slug":{"Str":"first"}},"new":{"$id":{"Ref":1},"$version":{"Int":1},"$created_by":{"Str":"alpha:writer1"},"title":{"Str":"First"},"slug":{"Str":"first"}}}},"result":{"allowed":false,"checks":[{"rule":"policy:public_reads_published","passed":false}]}},
        {"description":"A published note is read by anyone.","args":{"tenant":{"members":{"alpha:owner":["owner"],"alpha:writer1":["writer"],"alpha:writer2":["writer"],"alpha:editor":["editor"]},"policies":{"public_reads_published":{"id":"public_reads_published","role":"public","resource":{"Object":"note"},"actions":["Read"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"status"}},"right":{"Lit":{"Str":"published"}}}}},"public_reads_people":{"id":"public_reads_people","role":"public","resource":{"Object":"person"},"actions":["Read"]},"writers_read_notes":{"id":"writers_read_notes","role":"writer","resource":{"Object":"note"},"actions":["Read","Create"]},"writers_edit_own":{"id":"writers_edit_own","role":"writer","resource":{"Object":"note"},"actions":["Update","Delete"],"condition":{"Cmp":{"op":"Eq","left":{"Var":{"scope":"Record","name":"$created_by"}},"right":"Principal"}}},"writers_add_people":{"id":"writers_add_people","role":"writer","resource":{"Object":"person"},"actions":["Create"]},"editors_manage_notes":{"id":"editors_manage_notes","role":"editor","resource":{"Object":"note"},"actions":["Read","Create","Update","Delete"]},"editors_manage_people":{"id":"editors_manage_people","role":"editor","resource":{"Object":"person"},"actions":["Read","Create","Update","Delete"]}}},"principal":"Anonymous","now":5000,"action":"Read","resource":{"Object":"note"},"subject":{"old":{"$id":{"Ref":1},"$version":{"Int":1},"$created_by":{"Str":"alpha:writer1"},"title":{"Str":"First"},"slug":{"Str":"first"},"status":{"Str":"published"}},"new":{"$id":{"Ref":1},"$version":{"Int":1},"$created_by":{"Str":"alpha:writer1"},"title":{"Str":"First"},"slug":{"Str":"first"},"status":{"Str":"published"}}}},"result":{"allowed":true,"checks":[{"rule":"policy:public_reads_published","passed":true}]}}
      ]
    },
    {
      "id": "check-version",
      "description": "transition.rs check_version: an expected version other than the stored one is a version conflict.",
      "params": [{"name":"version","type":"u64"},{"name":"expected","type":"option<u64>"}],
      "returns": "unit",
      "errors": "domain-error",
      "body": "match expected { Some(v) => if v != version then fail(domain-error.VersionConflict{message: format(\"record is at version {}, expected {}\", version, v)}) else (), None => () }",
      "examples": [
        {"description":"behaviour.rs a_stale_expected_version_is_a_conflict","args":{"version":2,"expected":1},"error":{"VersionConflict":{"message":"record is at version 2, expected 1"}}},
        {"description":"behaviour.rs every_rejection_lists_at_least_one_failed_check, stale version","args":{"version":1,"expected":7},"error":{"VersionConflict":{"message":"record is at version 1, expected 7"}}},
        {"description":"The built-in unit (WG-4966): () is the value, null in an example.","args":{"version":2,"expected":2},"result":null},
        {"args":{"version":2,"expected":null},"result":null}
      ]
    },
    {
      "id": "next-version",
      "description": "The version an update writes: the stored one plus one, after check_version.",
      "params": [{"name":"version","type":"u64"},{"name":"expected","type":"option<u64>"}],
      "returns": "u64",
      "errors": "domain-error",
      "let": [{"name":"checked","expr":"try call check-version(version, expected)"}],
      "body": "version + 1",
      "examples": [
        {"args":{"version":1},"result":2},
        {"args":{"version":1,"expected":1},"result":2},
        {"args":{"version":2,"expected":1},"error":{"VersionConflict":{"message":"record is at version 2, expected 1"}}}
      ]
    },
    {
      "id": "expires-at",
      "description": "A timestamp moved on by a number of milliseconds (WG-4966): checked i64 arithmetic on Timestamp.",
      "params": [{"name":"now","type":"timestamp"},{"name":"ttl","type":"i64"}],
      "returns": "timestamp",
      "body": "now + ttl",
      "examples": [
        {"args":{"now":5000,"ttl":250},"result":5250}
      ]
    },
    {
      "id": "expired",
      "description": "Whether a deadline has passed: timestamps compare by their milliseconds (WG-4966).",
      "params": [{"name":"at","type":"timestamp"},{"name":"now","type":"timestamp"}],
      "returns": "bool",
      "body": "at <= now",
      "examples": [
        {"args":{"at":5000,"now":5000},"result":true},
        {"args":{"at":5001,"now":5000},"result":false}
      ]
    },
    {
      "id": "role-set",
      "description": "A set of roles with one more (WG-4966): a set is a list to Exegra, so set-of takes it and its list result stands for a set.",
      "params": [{"name":"roles","type":"set<string>"},{"name":"extra","type":"string"}],
      "returns": "set<string>",
      "body": "if any(r in roles, r == extra) then roles else call set-of(concat(roles, [extra]))",
      "examples": [
        {"args":{"roles":["public","writer"],"extra":"editor"},"result":["editor","public","writer"]},
        {"args":{"roles":["public"],"extra":"public"},"result":["public"]},
        {"args":{"roles":[],"extra":"public"},"result":["public"]}
      ]
    },
    {
      "id": "grants-of",
      "description": "rules.rs: the grants a permission on an object type expands to, one per action in the order of the set (WG-4966).",
      "params": [{"name":"object","type":"string"},{"name":"actions","type":"set<action>"}],
      "returns": "list<grant>",
      "body": "map(a in actions, grant.Object{object, action: a})",
      "examples": [
        {"args":{"object":"note","actions":["Read","Update"]},"result":[{"Object":{"object":"note","action":"Read"}},{"Object":{"object":"note","action":"Update"}}]},
        {"args":{"object":"note","actions":[]},"result":[]}
      ]
    },
    {
      "id": "grant-text",
      "description": "A grant as text (WG-4966): a tuple variant taken apart by its field names.",
      "params": [{"name":"g","type":"grant"}],
      "returns": "string",
      "body": "match g { Capability(name) => format('capability {}', name), Object{object, action} => format('{}:{}', object, action) }",
      "examples": [
        {"args":{"g":{"Object":{"object":"note","action":"Delete"}}},"result":"note:Delete"},
        {"args":{"g":{"Capability":"export"}},"result":"capability export"}
      ]
    },
    {"id": "top", "description": "The value a shared field holds, cloned out of its Arc (WG-4966).", "params": [{"name": "s", "type": "store"}], "returns": "rec", "body": "s.top", "examples": [{"args": {"s": {"rows": {}, "top": {"id": 1, "name": "a"}}}, "result": {"id": 1, "name": "a"}}]},
    {"id": "row", "description": "A shared record of a map, as an option of the plain record (WG-4966).", "params": [{"name": "s", "type": "store"}, {"name": "id", "type": "u64"}], "returns": "option<rec>", "body": "get(s.rows, id)", "examples": [{"args": {"s": {"rows": {"2": {"id": 2, "name": "b"}}, "top": {"id": 1, "name": "a"}}, "id": 2}, "result": {"id": 2, "name": "b"}}, {"args": {"s": {"rows": {}, "top": {"id": 1, "name": "a"}}, "id": 2}, "result": null}]},
    {"id": "with-top", "description": "A store with another shared record: a plain value shared with Arc::new (WG-4966).", "params": [{"name": "s", "type": "store"}, {"name": "r", "type": "rec"}], "returns": "store", "body": "store{rows: s.rows, top: r}", "examples": [{"args": {"s": {"rows": {}, "top": {"id": 1, "name": "a"}}, "r": {"id": 2, "name": "b"}}, "result": {"rows": {}, "top": {"id": 2, "name": "b"}}}]},
    {"id": "text-checks", "description": "startsWith, endsWith and isAsciiLowercase (WG-4957, WG-4966).", "params": [{"name": "s", "type": "string"}], "returns": "bool", "body": "startsWith(s, 'ab') && endsWith(s, 'z') && isAsciiLowercase(s)", "examples": [{"args": {"s": "abz"}, "result": true}, {"args": {"s": "abZ"}, "result": false}]},
    {"id": "sizes", "description": "length of a string (its characters) and of a list (WG-4957, WG-4966).", "params": [{"name": "s", "type": "string"}, {"name": "xs", "type": "list<string>"}], "returns": "u64", "body": "length(s) + length(xs)", "examples": [{"args": {"s": "héllo", "xs": ["a"]}, "result": 6}]},
    {"id": "tidy", "description": "trim and chars (WG-4957, WG-4966).", "params": [{"name": "s", "type": "string"}], "returns": "list<string>", "body": "chars(trim(s))", "examples": [{"args": {"s": " ab\n"}, "result": ["a", "b"]}]},
    {"id": "snake", "description": "snakeCase, the kernel's snake_case of a PascalCase name (WG-4957, WG-4966).", "params": [{"name": "s", "type": "string"}], "returns": "string", "body": "snakeCase(s)", "examples": [{"args": {"s": "PostAuthor"}, "result": "post_author"}]},
    {"id": "millis", "description": "parseTime, substrate's parse_time (WG-4957, WG-4966).", "params": [{"name": "s", "type": "string"}], "returns": "i64", "body": "match parseTime(s) { Ok(ms) => ms, Err(e) => 0 - 1 }", "examples": [{"args": {"s": "1970-01-02"}, "result": 86400000}, {"args": {"s": "1970-01-01T00:01Z"}, "result": 60000}, {"args": {"s": "x"}, "result": -1}]},
    {"id": "num-text", "description": "An f64 bound by a match and written by {}, {:json} and {:?} (WG-4966).", "params": [{"name": "n", "type": "num"}], "returns": "string", "body": "match n { pos-int(u) => format('{}', u), float(x) => format('{} {:json} {:?}', x, x, n) }", "examples": [{"args": {"n": {"float": 2.5}}, "result": "2.5 2.5 Float(2.5)"}, {"args": {"n": {"float": 1}}, "result": "1 1.0 Float(1.0)"}, {"args": {"n": {"pos-int": 7}}, "result": "7"}]},
    {"id": "half", "description": "f64 division (WG-4966).", "params": [{"name": "x", "type": "f64"}], "returns": "f64", "body": "x / 2", "examples": [{"args": {"x": 3}, "result": 1.5}]},
    {"id": "double-negation", "description": "Whether an expression is not(not(..)): a boxed field (Not(Box<Expr>)) bound by a match (WG-4966).", "params": [{"name": "e", "type": "expr"}], "returns": "bool", "body": "match e { Not(inner) => match inner { Not(_) => true, _ => false }, _ => false }", "examples": [{"args": {"e": {"Not": {"Not": "Now"}}}, "result": true}, {"args": {"e": {"Not": "Now"}}, "result": false}, {"args": {"e": "Now"}, "result": false}]},
    {"id": "narrow", "description": "An i64 passed as a u64: checked, a fault where it does not fit (WG-4966).", "params": [{"name": "x", "type": "i64"}], "returns": "u64", "body": "x", "examples": [{"args": {"x": 3}, "result": 3}]},
    {"id": "rid-number", "description": "A record id as an i64: its u64, narrowed (WG-4966).", "params": [{"name": "r", "type": "rid"}], "returns": "i64", "body": "r", "examples": [{"args": {"r": 4}, "result": 4}]},
    {"id": "make-role", "description": "A string built as a constrained id: checked with RoleId::new (WG-4966).", "params": [{"name": "s", "type": "string"}], "returns": "role", "body": "s", "examples": [{"args": {"s": "editor"}, "result": "editor"}]},
    {"id": "role-map", "description": "A map of strings as a map of constrained ids: each key checked (WG-4966).", "params": [{"name": "m", "type": "map<string, string>"}], "returns": "map<role, string>", "body": "m", "examples": [{"args": {"m": {"editor": "x"}}, "result": {"editor": "x"}}]},
    {"id": "has-role", "description": "A lookup by a string in a map of constrained ids: the key built without the check (WG-4966).", "params": [{"name": "m", "type": "map<role, string>"}, {"name": "s", "type": "string"}], "returns": "bool", "body": "get(m, s) != null", "examples": [{"args": {"m": {"editor": "x"}, "s": "editor"}, "result": true}, {"args": {"m": {}, "s": "Not A Role"}, "result": false}]},
    {"id": "builtin-roles", "description": "Literal keys built (and checked by specc) as the constrained ids expected (WG-4966).", "params": [], "returns": "map<role, string>", "body": "insert(insert({}, 'owner', 'Owner'), 'public', 'Everyone')", "examples": [{"args": {}, "result": {"owner": "Owner", "public": "Everyone"}}]},
    {"id": "key-order", "description": "A number sort key of a record id and an i64, compared as an i128 (WG-4966).", "params": [{"name": "xs", "type": "list<key>"}], "returns": "list<key>", "body": "sortBy(x in xs, match x { rec(r) => r, num(i) => i })", "examples": [{"args": {"xs": [{"rec": 5}, {"num": -1}, {"num": 3}]}, "result": [{"num": -1}, {"num": 3}, {"rec": 5}]}]},
    {"id": "mentions-field", "description": "schema.rs mentions_field: whether an expression reads a field of a record (a name that is not a system attribute, or any hop through a reference), at any depth. Structural recursion (Exegra WG-4957): every call of itself is on a field of a variant matched from e, or an item of a list such a field holds (WG-5133).", "params": [{"name": "e", "type": "expr"}], "returns": "bool", "body": "match e { Var{name} => !startsWith(name, '$'), Through => true, Lit => false, Param => false, Now => false, Principal => false, HasRole => false, Not(a) => call mentions-field(a), IsNull(a) => call mentions-field(a), Len(a) => call mentions-field(a), Lower(a) => call mentions-field(a), IsSlug(a) => call mentions-field(a), And(items) => any(i in items, call mentions-field(i)), Or(items) => any(i in items, call mentions-field(i)), Cmp{left, right} => call mentions-field(left) || call mentions-field(right), In{item, list: l} => call mentions-field(item) || call mentions-field(l), Contains{haystack, needle} => call mentions-field(haystack) || call mentions-field(needle), StartsWith{text, prefix} => call mentions-field(text) || call mentions-field(prefix), If{cond, then: t, otherwise} => call mentions-field(cond) || call mentions-field(t) || call mentions-field(otherwise) }", "examples": [{"args": {"e": {"Var": {"scope": "Record", "name": "title"}}}, "result": true}, {"args": {"e": {"Var": {"scope": "Record", "name": "$id"}}}, "result": false}, {"description": "Three levels down: a hop inside a comparison inside an and.", "args": {"e": {"And": [{"Not": {"IsNull": {"Var": {"scope": "New", "name": "$version"}}}}, {"Cmp": {"op": "Eq", "left": "Now", "right": {"Through": {"scope": "New", "field": "author", "target": "name"}}}}]}}, "result": true}, {"args": {"e": {"If": {"cond": "Now", "then": {"Lit": "Null"}, "otherwise": {"Len": {"Var": {"scope": "Old", "name": "slug"}}}}}}, "result": true}, {"args": {"e": {"Or": [{"HasRole": "editor"}, {"Not": {"Lit": {"Bool": true}}}]}}, "result": false}]},
    {"id": "print-condition", "description": "print of the rule language (WG-4966): an expression in its authoring syntax, the generated printer, which is the kernel's Display of Expr.", "params": [{"name": "c", "type": "expr"}], "returns": "string", "body": "print(rule-language, c)", "examples": [{"description": "A comparison prints in parentheses, a string literal single-quoted.", "args": {"c": {"Cmp": {"op": "Eq", "left": {"Var": {"scope": "Record", "name": "status"}}, "right": {"Lit": {"Str": "published"}}}}}, "result": "(record.status == 'published')"}, {"description": "A read through a reference prints the scope, the field and the target.", "args": {"c": {"Through": {"scope": "New", "field": "author", "target": "name"}}}, "result": "new.author.name"}, {"description": "An empty and is printed as its identity.", "args": {"c": {"And": []}}, "result": "true"}]},
    {"id": "follow-reference", "description": "eval of the rule language with a lookup, its fourth argument (Exegra WG-4968, WG-5132): a hop through a reference reads the lookup; a target the lookup covers but does not hold is null, a field it does not cover is an evaluation error, written here as an error string.", "params": [{"name": "c", "type": "expr"}, {"name": "env", "type": "rule-env"}, {"name": "lookup", "type": "map<string, map<string, map<string, value>>>"}], "returns": "value", "body": "match eval(rule-language, c, env, lookup) { Ok(v) => v, Err(e) => value.Str(format('error: {}', e)) }", "examples": [{"description": "The target is in the lookup: its attribute.", "args": {"c": {"Through": {"scope": "New", "field": "author", "target": "name"}}, "env": {"new": {"author": {"Ref": 2}}, "param": {}, "now": {"Time": 0}, "principal": "Null", "has_role": []}, "lookup": {"author": {"2": {"name": {"Str": "Ada"}}}}}, "result": {"Str": "Ada"}}, {"description": "The lookup covers the field but holds no such record: null.", "args": {"c": {"Through": {"scope": "New", "field": "author", "target": "name"}}, "env": {"new": {"author": {"Ref": 2}}, "param": {}, "now": {"Time": 0}, "principal": "Null", "has_role": []}, "lookup": {"author": {}}}, "result": "Null"}, {"description": "The lookup does not cover the field: an evaluation error.", "args": {"c": {"Through": {"scope": "New", "field": "author", "target": "name"}}, "env": {"new": {"author": {"Ref": 2}}, "param": {}, "now": {"Time": 0}, "principal": "Null", "has_role": []}, "lookup": {}}, "result": {"Str": "error: the lookup does not cover author"}}, {"description": "An empty reference field is null before the lookup is read.", "args": {"c": {"Through": {"scope": "New", "field": "author", "target": "name"}}, "env": {"new": {}, "param": {}, "now": {"Time": 0}, "principal": "Null", "has_role": []}, "lookup": {}}, "result": "Null"}]},
    {"id": "later", "description": "A duration plus milliseconds: prelude::DurationMs, computed as its u64 (WG-5132).", "params": [{"name": "d", "type": "duration"}, {"name": "by", "type": "u64"}], "returns": "duration", "body": "d + by", "examples": [{"args": {"d": 1000, "by": 5}, "result": 1005}]}
  ]
}
