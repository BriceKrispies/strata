// Golden fixture for specc's pure crate (model-core) and the type features of WG-4925: unions with
// external, internal and adjacent tags; unit, newtype and struct-like variants; variant names in
// their declared case and in snake_case and kebab-case; maps keyed by string, by an id over a string
// (with constraints) and by an id and a built-in over integers; a union recursive through a list and
// a map (value) and through a box (expr); a struct recursive through an option (chain); id and
// scalar constraints (slug, token). account-id is a uuid and owner reaches it, so neither is in the
// pure crate. The expected output is the crate crates/spec-compiler-core-fixture, whose tests
// (roundtrip.rs) pin the JSON serde writes for each form.
{
  "exegra": "0.1",
  "system": { "id": "core-fixture", "name": "Core fixture", "generation": { "target": "rust" } },
  "types": [
    { "id": "slug", "name": "Slug", "kind": "id", "repr": "string", "constraints": { "pattern": "^[a-z][a-z0-9-]*$", "minLength": 1, "maxLength": 32 }, "description": "A lower-case address label." },
    { "id": "token", "name": "Token", "kind": "scalar", "repr": "bytes", "constraints": { "minLength": 4, "maxLength": 4 } },
    { "id": "tenant-ref", "name": "Tenant reference", "kind": "id", "repr": "u64" },
    { "id": "seat-count", "name": "Seat count", "kind": "scalar", "repr": "u32" },
    { "id": "value", "name": "Value", "kind": "union", "description": "A tenant value, tagged externally as serde does by default.",
      "variants": [
        { "name": "Null" },
        { "name": "Bool", "newtype": true, "fields": [{ "name": "value", "type": "bool" }] },
        { "name": "Int", "newtype": true, "fields": [{ "name": "value", "type": "i64" }] },
        { "name": "Text", "newtype": true, "fields": [{ "name": "value", "type": "string" }] },
        { "name": "List", "newtype": true, "fields": [{ "name": "items", "type": "list<value>" }] },
        { "name": "Record", "newtype": true, "fields": [{ "name": "members", "type": "map<string, value>" }] }
      ] },
    { "id": "expr", "name": "Expression", "kind": "union", "encoding": { "tag": "internal", "tagField": "op", "variantCase": "snake_case" },
      "variants": [
        { "name": "Literal", "fields": [{ "name": "value", "type": "value" }] },
        { "name": "Not", "fields": [{ "name": "operand", "type": "expr" }] },
        { "name": "And", "fields": [{ "name": "operands", "type": "list<expr>" }] },
        { "name": "Pick", "fields": [{ "name": "from", "type": "expr" }, { "name": "default", "type": "expr", "optional": true }] },
        { "name": "Missing" }
      ] },
    { "id": "change", "name": "Change", "kind": "union", "encoding": { "tag": "adjacent", "tagField": "type", "contentField": "data", "variantCase": "kebab-case" },
      "variants": [
        { "name": "Started" },
        { "name": "RenamedTo", "fields": [{ "name": "old-name", "type": "slug" }, { "name": "new-name", "type": "slug" }] },
        { "name": "Scored", "newtype": true, "fields": [{ "name": "score", "type": "u32" }] },
        { "name": "Moved", "newtype": true, "fields": [{ "name": "seats", "type": "seats" }] }
      ] },
    { "id": "seats", "name": "Seats", "kind": "struct",
      "fields": [
        { "name": "by-slug", "type": "map<slug, seat-count>" },
        { "name": "by-ref", "type": "map<tenant-ref, seat-count>" },
        { "name": "labels", "type": "map<u32, string>" }
      ] },
    { "id": "chain", "name": "Chain", "kind": "struct",
      "fields": [
        { "name": "label", "type": "string" },
        { "name": "next", "type": "option<chain>" }
      ] },
    { "id": "account-id", "name": "Account id", "kind": "id", "repr": "uuid" },
    { "id": "owner", "name": "Owner", "kind": "struct", "fields": [{ "name": "account", "type": "account-id" }, { "name": "slug", "type": "slug" }] }
  ]
}
