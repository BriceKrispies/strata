  // (tests/bundle.rs).
  "product": {
    "id": "member-tiers",
    "name": "Member tiers",
    "version": "1.0.0",
    "platform": { "min": "0.2" },
    "imports": { "spec": "../../../../../../specifications/spec.jsonc", "entities": [] }
  },
  "mailTemplates": [
    { "id": "member_tiers__welcome", "subject": "Welcome", "body": "[{\"type\":\"paragraph\",\"inlines\":[{\"type\":\"text\",\"text\":\"Welcome.\"}]}]" }
  ],
  "noticeTemplates": [
    { "id": "member_tiers__welcome", "title": "Welcome", "body": "[{\"type\":\"paragraph\",\"inlines\":[{\"type\":\"text\",\"text\":\"Welcome.\"}]}]" }
  ]
}
