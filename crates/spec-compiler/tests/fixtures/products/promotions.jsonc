{
  // "Redeem a promotion" as a product on the Strata platform (WG-5032): a time window, a stock kept in
  // the ledger and one redemption record, all in one tenant operation that a member may invoke without
  // ledger-post or content-write (D-6546 to D-6551, OPR-1540 to OPR-1554). The file declares everything
  // it names, in its own namespace promotions__ (D-6582): the object types, the ledger units, the pool
  // and the floor of the stock, the manager role and the two operations. Only platform primitives are
  // used, and each typed section holds values of a platform type (src/layer_values.rs): objects of
  // object-type-def, ledgerUnits of ledger-unit-decl, ledgerPools of ledger-pool-decl, ledgerLimits of
  // ledger-limit and operations of tenant-operation-def. Expressions are tenant rule language text.
  //
  // What this file leaves out, because the tenant rule language does not read balances or segments yet
  // (D-6543 specifies balance and in_segment; WG-5062):
  // - eligibility by segment (in_segment): there is no segment and no segment field;
  // - the limit per person (balance of the member's redemptions, compared with a limit on the record):
  //   a member may redeem as often as the stock of the promotion lasts.
  // What it keeps: the window (now against the starts_at and ends_at of the record, and at most 90 days
  // long, through the time arithmetic of D-6541), a stock per promotion (the pool account in the scope
  // text(record.$id), D-6542) with the floor of 0 that refuses a redemption when that stock is gone,
  // the redemption counted for the member in the ledger, and the redemption record, in one atomic
  // invocation.
  "product": {
    "id": "promotions",
    "name": "Promotions",
    "description": "Time-boxed promotions that members redeem from a shared stock.",
    "imports": {
      "spec": "../../../../../specifications/spec.jsonc",
      "entities": ["tenant-operation-invoke", "product-module"]
    }
  },
  "objects": [
    {
      "id": "promotions__promotion",
      "label": "Promotion",
      "fields": {
        "title": { "id": "title", "label": "Title", "ty": "Str", "required": true, "unique": false },
        "starts_at": { "id": "starts_at", "label": "Starts at", "ty": "Time", "required": true, "unique": false },
        "ends_at": { "id": "ends_at", "label": "Ends at", "ty": "Time", "required": true, "unique": false }
      },
      "constraints": {
        "window": {
          "id": "window",
          "expr": "new.ends_at > new.starts_at and new.ends_at <= new.starts_at + days(90)",
          "message": "A promotion ends after it starts and runs at most 90 days."
        }
      }
    },
    {
      "id": "promotions__redemption",
      "label": "Redemption",
      "fields": {
        "promotion": {
          "id": "promotion",
          "label": "Promotion",
          "ty": { "Ref": { "target": "promotions__promotion", "on-delete": "Restrict" } },
          "required": true,
          "unique": false
        },
        "person": {
          "id": "person",
          "label": "Person",
          "ty": "Str",
          "required": true,
          "unique": false,
          // The redeeming person is the creator of the record: the operation creates it as the invoker (D-6547).
          "personal": { "kind": "identifier", "subject": "Creator", "searchable": false }
        },
        "redeemed_at": { "id": "redeemed_at", "label": "Redeemed at", "ty": "Time", "required": true, "unique": false }
      },
      "constraints": {},
      "retention": { "days": 730, "from": "Created" }
    }
  ],
  "ledgerUnits": [
    { "id": "promotions__stock", "description": "The stock of each promotion: one account of the pool per promotion, in the scope of its id, debited by each redemption." },
    { "id": "promotions__redemptions", "description": "The redemptions of a person: one account per person, credited by each redemption." }
  ],
  "ledgerPools": [
    { "id": "promotions__pool", "description": "The pool that holds the stock of the promotions." }
  ],
  "ledgerLimits": [
    {
      // The floor of 0 refuses the debit of a redemption when the stock is gone (LDG-013).
      "id": "promotions__stock_floor",
      "unit": "promotions__stock",
      "owner": { "pool": { "pool": "promotions__pool" } },
      "floor": 0
    }
  ],
  "roles": [
    {
      "id": "promotions__manager",
      "name": "Promotions manager",
      "description": "A member of the tenant who creates promotions and funds their stock through the create operation.",
      "level": "tenant",
      "holders": ["person", "team"],
      "capabilities": ["tenant-operation-invoke"]
    }
  ],
  "operations": [
    {
      "id": "promotions__create",
      "label": "Create a promotion and fund the stock",
      "inputs": [
        { "name": "title", "ty": "Str", "required": true },
        { "name": "starts_at", "ty": "Time", "required": true },
        { "name": "ends_at", "ty": "Time", "required": true },
        { "name": "stock", "ty": "Int", "required": true, "label": "Units added to the stock" }
      ],
      "invokers": { "signed-in": false, "roles": ["promotions__manager"] },
      "conditions": [
        { "id": "window", "expr": "param.ends_at > param.starts_at and ms_between(param.starts_at, param.ends_at) <= days(90)", "error": "bad-window", "message": "A promotion ends after it starts and runs at most 90 days." },
        { "id": "stock", "expr": "param.stock > 0", "error": "bad-stock", "message": "The stock added is positive." }
      ],
      "steps": [
        {
          "CreateRecord": {
            "id": "promotion",
            "object": "promotions__promotion",
            "fields": { "title": "param.title", "starts_at": "param.starts_at", "ends_at": "param.ends_at" }
          }
        },
        {
          // The stock of this promotion: the pool account in the scope of the new record's id, which
          // a later step reads as param.promotion (D-6548).
          "PostLedger": {
            "id": "fund",
            "owner": { "Pool": { "pool": "promotions__pool" } },
            "unit": "promotions__stock",
            "scope": "text(param.promotion)",
            "amount": "param.stock",
            "reason": "stock"
          }
        }
      ]
    },
    {
      "id": "promotions__redeem",
      "label": "Redeem a promotion",
      "inputs": [
        { "name": "promotion", "ty": { "Ref": { "target": "promotions__promotion", "on-delete": "Restrict" } }, "required": true }
      ],
      // Any signed-in member: no ledger-post and no content-write is needed (OPR-1546).
      "invokers": { "signed-in": true, "roles": [] },
      // The promotion named by the input is the record scope of the conditions and steps.
      "subject": { "object": "promotions__promotion", "input": "promotion" },
      "conditions": [
        { "id": "window", "expr": "now >= record.starts_at and now < record.ends_at", "error": "outside-window", "message": "This promotion is not running." }
      ],
      "steps": [
        {
          // The floor of the unit refuses the debit when the stock is gone, and the refusal refuses the whole invocation (OPR-1542).
          "PostLedger": {
            "id": "take_stock",
            "owner": { "Pool": { "pool": "promotions__pool" } },
            "unit": "promotions__stock",
            "scope": "text(record.$id)",
            "amount": "-1",
            "reason": "redemption"
          }
        },
        {
          "PostLedger": {
            "id": "count",
            "owner": "Invoker",
            "unit": "promotions__redemptions",
            "amount": "1",
            "reason": "redemption"
          }
        },
        {
          "CreateRecord": {
            "id": "redemption",
            "object": "promotions__redemption",
            "fields": { "promotion": "record.$id", "person": "principal", "redeemed_at": "now" }
          }
        }
      ]
    }
  ],
  "claims": [
    {
      "id": "promotions__redeem-is-one-operation",
      "kind": "structural",
      "statement": "Redeeming a promotion is one tenant operation that checks the window, debits the stock of that promotion, counts the redemption for the member and creates the redemption record in one transaction, or changes nothing.",
      "subjects": ["product-module"],
      "rationale": "OPR-1541 and OPR-1542 make the invocation atomic; the floor of the stock unit makes the stock hold under concurrent requests (LDG-017).",
      "evaluate": { "method": "external-evidence" }
    }
  ]
}
