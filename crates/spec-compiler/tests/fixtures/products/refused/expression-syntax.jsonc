{
  // Refused: a trigger condition and an operation condition that use a call the tenant rule language does
  // not define (balance), and a string written with double quotes (layer.expr-syntax, WG-5060).
  "product": { "id": "member-tiers", "name": "Member tiers", "imports": { "spec": "../../../../../../specifications/spec.jsonc", "entities": [] } },
  "objects": [
    {
      "id": "member_tiers__tier",
      "label": "Tier",
      "fields": {
        "name": { "id": "name", "label": "Name", "ty": "Str", "required": true, "unique": false },
        "points": { "id": "points", "label": "Points", "ty": "Int", "required": true, "unique": false },
        "owner": { "id": "owner", "label": "Owner", "ty": { "Ref": { "target": "member_tiers__member", "on-delete": "Restrict" } }, "required": false, "unique": false }
      },
      "constraints": {}
    },
    {
      "id": "member_tiers__member",
      "label": "Member",
      "fields": { "email": { "id": "email", "label": "Email", "ty": "Str", "required": true, "unique": false } },
      "constraints": {}
    }
  ],
  "triggers": [
    { "id": "member_tiers__on_post", "on": { "LedgerPosted": { "unit": "points" } }, "condition": "balance(param.owner) > 1", "automation": "member_tiers__notify" }
  ],
  "automations": [
    { "id": "member_tiers__notify", "label": "Notify", "run-as": { "roles": [] }, "start": "done", "steps": { "done": { "action": "End" } } }
  ],
  "operations": [
    {
      "id": "member_tiers__grant",
      "label": "Operation",
      "inputs": [ { "name": "name", "ty": "Str", "required": true } ],
      "invokers": { "signed-in": true, "roles": [] },
      "conditions": [ { "id": "check", "expr": "param.name == \"gold\"", "error": "refused", "message": "Refused." } ],
      "steps": []
    }
  ]
}
