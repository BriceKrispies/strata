{
  // Refused: a comparison of a text with a number, an operand of the wrong shape, and a hop through a field
  // that is not a single reference (layer.expr-type, WG-5060).
  "product": { "id": "member-tiers", "name": "Member tiers", "imports": { "spec": "../../../../../../specifications/spec.jsonc", "entities": [] } },
  "objects": [
    {
      "id": "member_tiers__tier",
      "label": "Tier",
      "fields": {
        "name": { "id": "name", "label": "Name", "ty": "Str", "required": true, "unique": false },
        "points": { "id": "points", "label": "Points", "ty": "Int", "required": true, "unique": false },
        "owner": { "id": "owner", "label": "Owner", "ty": { "Ref": { "target": "member_tiers__member", "on-delete": "Restrict" } }, "required": false, "unique": false }
      },
      "constraints": {}
    },
    {
      "id": "member_tiers__member",
      "label": "Member",
      "fields": { "email": { "id": "email", "label": "Email", "ty": "Str", "required": true, "unique": false } },
      "constraints": {}
    }
  ],
  "policies": [
    { "id": "member_tiers__readers", "role": "member", "resource": { "Object": "member_tiers__tier" }, "actions": ["Read"], "condition": "record.name > 1" },
    { "id": "member_tiers__editors", "role": "member", "resource": { "Object": "member_tiers__tier" }, "actions": ["Update"], "condition": "len(record.points) > 1" },
    { "id": "member_tiers__owners", "role": "member", "resource": { "Object": "member_tiers__tier" }, "actions": ["Delete"], "condition": "record.name.email == 'a'" }
  ]
}
