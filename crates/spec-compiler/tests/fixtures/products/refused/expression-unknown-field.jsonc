      "invokers": { "signed-in": true, "roles": [] },
      "subject": { "object": "member_tiers__tier", "input": "tier" },
      "conditions": [ { "id": "check", "expr": "record.owner.phone == null", "error": "refused", "message": "Refused." } ],
      "steps": []
    }
  ]
