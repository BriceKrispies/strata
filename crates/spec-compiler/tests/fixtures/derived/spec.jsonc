// Golden fixture for specc's derived and facade contracts (WG-4935, NC-4 and NC-5 of WG-4895), the same
// specification as Exegra's fixture tests/fixtures/derivations/fixtures.js. A store of named counters is reached
// through two contracts the component store implements, load-counters (load what a list of needs names) and
// commit-bump (commit one change against the revision it was decided on). Derived from them and from functions:
// pick-larger (pure), read-counter (read), and copy-counter and copy-counter-once (command: the load-decide-commit
// loop of crates/storage-api/src/lib.rs execute, with need rounds and conflict retries). edit-counter is a facade:
// no trait method and no route; a client lowers it onto mutate-counter, the served contract its bffRoute names.
// The expected output is crates/spec-compiler-derived-fixture; crates/spec-compiler/tests/derived.rs runs the
// generated loops against a store that conflicts, lacks state and runs out of bounds.
{
  "exegra": "0.1",
  "system": { "id": "derived-fixture", "name": "Derived fixture", "generation": { "target": "rust" } },
  "vocabulary": {
    "properties": [
      { "entity": "contract", "name": "bffRoute", "type": "string", "label": "BFF route", "doc": "How a client calls the contract: \"<METHOD> <path>\", optionally followed by a shape." }
    ]
  },
  "components": [
    { "id": "store", "name": "Store", "category": "computational" }
  ],
  "types": [
    { "id": "counter-need", "name": "Counter need", "kind": "struct", "fields": [{ "name": "name", "type": "string" }] },
    { "id": "bump", "name": "Bump", "kind": "struct", "fields": [{ "name": "name", "type": "string" }, { "name": "value", "type": "u64" }] },
    { "id": "copy-error", "name": "Copy error", "kind": "union", "variants": [
      { "name": "Missing", "newtype": true, "fields": [{ "name": "need", "type": "counter-need" }] }
    ] }
  ],
  "functions": [
    { "id": "larger", "description": "The larger of two counts.",
      "params": [{ "name": "a", "type": "u64" }, { "name": "b", "type": "u64" }], "returns": "u64",
      "body": "if a > b then a else b",
      "examples": [{ "args": { "a": 3, "b": 5 }, "result": 5 }, { "args": { "a": 7, "b": 2 }, "result": 7 }] },
    { "id": "read-needs", "description": "What a read of one counter loads: that counter.",
      "params": [{ "name": "name", "type": "string" }], "returns": "list<counter-need>",
      "body": "[counter-need{name}]",
      "examples": [{ "args": { "name": "a" }, "result": [{ "name": "a" }] }] },
    { "id": "read-value", "description": "The value of a loaded counter.",
      "params": [{ "name": "name", "type": "string" }, { "name": "counters", "type": "map<string, u64>" }], "returns": "u64",
      "errors": "copy-error",
      "body": "match get(counters, name) { None => fail(copy-error.Missing(counter-need{name})), Some(v) => v }",
      "examples": [
        { "args": { "name": "a", "counters": { "a": 3 } }, "result": 3 },
        { "args": { "name": "b", "counters": { "a": 3 } }, "error": { "Missing": { "name": "b" } } }
      ] },
    { "id": "copy-needs", "description": "What a copy loads first: the source counter only, so the target is asked for by the decision.",
      "params": [{ "name": "source", "type": "string" }], "returns": "list<counter-need>",
      "body": "[counter-need{name: source}]",
      "examples": [{ "args": { "source": "a" }, "result": [{ "name": "a" }] }] },
    { "id": "decide-copy", "description": "The change a copy makes: the target takes the source's value. A counter that was not loaded is asked for.",
      "params": [{ "name": "source", "type": "string" }, { "name": "target", "type": "string" }, { "name": "counters", "type": "map<string, u64>" }],
      "returns": "bump", "errors": "copy-error",
      "body": "match get(counters, source) { None => fail(copy-error.Missing(counter-need{name: source})), Some(v) => match get(counters, target) { None => fail(copy-error.Missing(counter-need{name: target})), Some(_) => bump{name: target, value: v} } }",
      "examples": [
        { "args": { "source": "a", "target": "b", "counters": { "a": 3, "b": 1 } }, "result": { "name": "b", "value": 3 } },
        { "args": { "source": "a", "target": "b", "counters": { "a": 3 } }, "error": { "Missing": { "name": "b" } } }
      ] }
  ],
  "contracts": [
    { "id": "load-counters", "name": "Load counters", "ref": "CT-001", "realisation": "generated", "implementedBy": "store",
      "inputs": [{ "name": "needs", "type": "list<counter-need>" }],
      "outputs": [{ "name": "counters", "type": "map<string, u64>" }, { "name": "revision", "type": "u64" }],
      "postconditions": ["counters holds every counter a need names that exists, and revision is the store's revision they were read at."],
      "errors": [{ "name": "unavailable", "condition": "The store did not answer." }] },
    { "id": "commit-bump", "name": "Commit a bump", "ref": "CT-002", "realisation": "generated", "implementedBy": "store",
      "inputs": [{ "name": "bump", "type": "bump" }, { "name": "revision", "type": "u64" }],
      "outputs": [{ "name": "revision", "type": "u64" }],
      "postconditions": ["The counter of the bump holds its value, and revision is the store's new revision."],
      "errors": [
        { "name": "conflict", "condition": "Another commit changed the store since revision." },
        { "name": "unavailable", "condition": "The store did not answer." }
      ] },
    { "id": "mutate-counter", "name": "Change a counter", "ref": "CT-003", "realisation": "generated", "implementedBy": "store",
      "bffRoute": "POST /api/counters records",
      "inputs": [{ "name": "op", "type": "string" }, { "name": "name", "type": "string" }, { "name": "value", "type": "u64", "optional": true }],
      "outputs": [{ "name": "revision", "type": "u64" }],
      "postconditions": ["The generic counter endpoint: op names the change."],
      "errors": [{ "name": "unavailable", "condition": "The store did not answer." }] },
    { "id": "pick-larger", "name": "Pick the larger count", "ref": "CT-004", "realisation": "derived",
      "derivation": { "kind": "pure", "function": "larger" },
      "inputs": [{ "name": "a", "type": "u64" }, { "name": "b", "type": "u64" }],
      "outputs": [{ "name": "larger", "type": "u64" }],
      "errors": [] },
    { "id": "read-counter", "name": "Read a counter", "ref": "CT-005", "realisation": "derived",
      "derivation": { "kind": "read", "needs": "read-needs", "load": "load-counters", "decide": "read-value" },
      "inputs": [{ "name": "name", "type": "string" }],
      "outputs": [{ "name": "value", "type": "u64" }],
      "errors": [
        { "name": "missing", "condition": "The counter does not exist.", "type": "counter-need" },
        { "name": "unavailable", "condition": "The store did not answer." }
      ] },
    { "id": "copy-counter", "name": "Copy a counter", "ref": "CT-006", "realisation": "derived",
      "derivation": { "kind": "command", "needs": "copy-needs", "load": "load-counters", "decide": "decide-copy", "commit": "commit-bump",
        "conflict": "conflict", "insufficient": "Missing", "needRounds": 4, "retries": 3 },
      "inputs": [{ "name": "source", "type": "string" }, { "name": "target", "type": "string" }],
      "outputs": [{ "name": "revision", "type": "u64" }, { "name": "value", "type": "u64" }],
      "errors": [
        { "name": "missing", "condition": "A counter does not exist, or more were asked for than needRounds allows.", "type": "counter-need" },
        { "name": "conflict", "condition": "Every commit lost its race, retries times over." },
        { "name": "unavailable", "condition": "The store did not answer." }
      ] },
    { "id": "copy-counter-once", "name": "Copy a counter without asking twice", "ref": "CT-007", "realisation": "derived",
      "derivation": { "kind": "command", "needs": "copy-needs", "load": "load-counters", "decide": "decide-copy", "commit": "commit-bump",
        "conflict": "conflict", "insufficient": "Missing", "needRounds": 0, "retries": 0 },
      "inputs": [{ "name": "source", "type": "string" }, { "name": "target", "type": "string" }],
      "outputs": [{ "name": "revision", "type": "u64" }, { "name": "value", "type": "u64" }],
      "errors": [
        { "name": "missing", "condition": "The decision asked for a counter that was not loaded.", "type": "counter-need" },
        { "name": "conflict", "condition": "The commit lost its race." },
        { "name": "unavailable", "condition": "The store did not answer." }
      ] },
    { "id": "edit-counter", "name": "Edit a counter", "ref": "CT-008", "realisation": "facade",
      "bffRoute": "POST /api/counters records update counter",
      "inputs": [{ "name": "name", "type": "string" }, { "name": "value", "type": "u64" }],
      "outputs": [{ "name": "revision", "type": "u64" }],
      "errors": [{ "name": "unavailable", "condition": "The store did not answer." }] }
  ]
}
