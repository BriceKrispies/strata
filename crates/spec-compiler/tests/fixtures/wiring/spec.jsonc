// Golden fixture for specc's wiring backends (routes, deps, handlers). The expected output is the
// crate crates/spec-compiler-wiring-fixture, which tests/wiring.rs serves and calls.
//
// - gateway calls scheduler and worker; scheduler calls reports; nobody calls gateway. worker
//   implements no contract, so gateway gets no client for it.
// - submit-job has a binding path, a validation, a policy, a quota refusing with a contract error
//   and an audit; make-report has a retry policy; the others take the default path.
// - machine job receives job-submitted and job-cancel through contracts and job-tick from its own
//   timer; it publishes job-started to machine tracker. tracker-reset arrives in no stated way.
// - wire names (WG-4881): the system names JSON members in snake_case, so make-report's error
//   not-found is not_found on the wire, and inspect-job (no implementer) sends job-id as job_id
//   and its job-summary struct as display_name, started_at, extra_info; inspect-job-camel
//   overrides the case with binding.case camelCase (jobId, lastSeen). filter-params, details and
//   extra-info are json.
// - contract errors on the wire (WG-4893): every failure is answered with the error body
//   api-error {code, message, detail?, correlation}; busy is of kind throttled (429) and
//   make-report's not-found of kind not_found (404) carrying an api-error.
// - exposure and auth (WG-4908): ping is public with the session scheme, the only contract routed
//   through the gateway; submit-job is internal with the session scheme; cancel-job and
//   make-report are internal and anonymous, which the test's authorizer admits without a
//   principal.
// - capabilities (WG-4954): submit-job requires jobs-submit, cancel-job jobs-cancel, ping ping and
//   make-report reports-make, all core; reports-premium is entitled only by plan pro and gated by
//   the flag premium-reports (off by default). operator (platform) confers jobs-submit and ping,
//   visitor (anonymous) jobs-cancel and reports-make, editor (tenant) ping and reports-premium;
//   support receives reports-premium in one tenant through support-access, which editors issue;
//   the delegation report-agent passes on ping alone, from the scope reports:read.
{
  "exegra": "0.1",
  "system": { "id": "wiring-fixture", "name": "Wiring fixture", "generation": { "target": "rust", "wireCase": "snake_case",
    "errorKinds": { "unauthenticated": 401, "forbidden": 403, "not_found": 404, "throttled": 429, "invalid": 422, "unavailable": 503, "internal": 500 },
    "errorBody": { "type": "api-error", "code": "code", "message": "message", "correlation": "correlation",
      "runtime": { "unauthenticated": "unauthenticated", "forbidden": "forbidden", "invalid-request": "invalid", "timeout": "unavailable", "unavailable": "unavailable", "internal": "internal" } } } },
  "components": [
    { "id": "gateway", "name": "Gateway", "category": "service", "purpose": "Takes requests from outside." },
    { "id": "scheduler", "name": "Scheduler", "category": "service", "purpose": "Runs jobs." },
    { "id": "reports", "name": "Reports", "category": "service", "purpose": "Writes job reports." },
    { "id": "worker", "name": "Worker", "category": "external", "purpose": "Does the work." }
  ],
  "relationships": [
    { "id": "gateway-calls-scheduler", "kind": "calls", "from": "gateway", "to": "scheduler", "description": "Jobs are submitted through the gateway." },
    { "id": "gateway-calls-worker", "kind": "calls", "from": "gateway", "to": "worker", "description": "The gateway wakes workers." },
    { "id": "scheduler-calls-reports", "kind": "calls", "from": "scheduler", "to": "reports", "description": "A finished job gets a report." },
    { "id": "reports-reads-scheduler", "kind": "reads", "from": "reports", "to": "scheduler", "description": "Not a call: gives no client." }
  ],
  "types": [
    { "id": "error-code", "name": "Error code", "kind": "enum", "values": [ "unauthenticated", "forbidden", "not_found", "throttled", "invalid", "unavailable", "internal" ] },
    { "id": "api-error", "name": "Api error", "kind": "struct", "fields": [ { "name": "code", "type": "error-code" }, { "name": "message", "type": "string" }, { "name": "detail", "type": "string", "optional": true }, { "name": "correlation", "type": "string" } ] },
    { "id": "job-summary", "name": "Job summary", "kind": "struct", "fields": [ { "name": "display-name", "type": "string" }, { "name": "started-at", "type": "option<timestamp>", "optional": true }, { "name": "extra-info", "type": "json" } ] }
  ],
  "records": [
    { "id": "rec-job", "name": "Job", "owner": "scheduler", "key": ["job"], "schemaVersion": 1,
      "fields": [
        { "name": "job", "type": "string" },
        { "name": "state", "type": "string" },
        { "name": "attempts", "type": "u32" }
      ] },
    { "id": "rec-tracker", "name": "Tracker", "owner": "scheduler", "key": ["job"], "schemaVersion": 1,
      "fields": [
        { "name": "job", "type": "string" },
        { "name": "state", "type": "string" },
        { "name": "seen", "type": "u32" }
      ] },
    { "id": "rec-job-audit", "name": "Job audit entry", "owner": "scheduler", "key": ["log-id"], "schemaVersion": 1,
      "fields": [
        { "name": "log-id", "type": "u64" },
        { "name": "actor", "type": "string" },
        { "name": "job", "type": "string" },
        { "name": "at", "type": "timestamp" }
      ] }
  ],
  "contracts": [
    { "id": "submit-job", "name": "Submit job", "ref": "CT-1", "realisation": "generated", "implementedBy": "scheduler",
      "binding": { "protocol": "http", "method": "POST", "path": "/api/jobs/submit" },
      "exposure": "internal", "auth": { "scheme": "session", "requires": ["jobs-submit"], "description": "An operator." }, "idempotent": true, "timeoutMs": 2000, "policyDefault": "deny",
      "inputs": [{ "name": "job", "type": "string" }, { "name": "priority", "type": "u32" }],
      "outputs": [{ "name": "accepted", "type": "bool" }],
      "errors": [{ "name": "busy", "condition": "Too many jobs were submitted in the last minute.", "kind": "throttled" }] },
    { "id": "cancel-job", "name": "Cancel job", "ref": "CT-2", "realisation": "generated", "implementedBy": "scheduler", "exposure": "internal", "auth": { "scheme": "anonymous", "requires": ["jobs-cancel"], "justification": "Cancelling is safe to repeat and names only a job." }, "idempotent": true, "timeoutMs": 1000,
      "inputs": [{ "name": "job", "type": "string" }],
      "outputs": [] },
    { "id": "ping", "name": "Ping", "ref": "CT-3", "realisation": "generated", "implementedBy": "gateway", "exposure": "public", "readOnly": true, "tenantScope": "request", "auth": { "scheme": "session", "requires": ["ping"] }, "idempotent": false, "policyDefault": "allow",
      "outputs": [{ "name": "pong", "type": "string" }] },
    { "id": "make-report", "name": "Make report", "ref": "CT-4", "realisation": "generated", "implementedBy": "reports", "exposure": "internal", "auth": { "scheme": "anonymous", "requires": ["reports-make"], "justification": "Reports are asked for by the scheduler on the service network." }, "idempotent": true, "timeoutMs": 1000,
      "inputs": [{ "name": "job", "type": "string" }],
      "outputs": [{ "name": "text", "type": "string" }],
      "errors": [{ "name": "not-found", "condition": "No job has the id.", "type": "api-error", "kind": "not_found" }] },
    { "id": "inspect-job", "name": "Inspect job", "ref": "CT-5", "realisation": "generated", "idempotent": true,
      "inputs": [{ "name": "job-id", "type": "string" }, { "name": "filter-params", "type": "json", "optional": true }],
      "outputs": [{ "name": "summary", "type": "job-summary" }],
      "errors": [{ "name": "not-found", "condition": "No job has the id." }] },
    { "id": "inspect-job-camel", "name": "Inspect job, camel case", "ref": "CT-6", "realisation": "generated", "idempotent": true,
      "binding": { "case": "camelCase" },
      "inputs": [{ "name": "job-id", "type": "string" }],
      "outputs": [{ "name": "last-seen", "type": "option<timestamp>" }, { "name": "details", "type": "json" }] }
  ],
  "capabilities": [
    { "id": "jobs-submit", "name": "Submit jobs", "core": true },
    { "id": "jobs-cancel", "name": "Cancel jobs", "core": true },
    { "id": "ping", "name": "Ping", "core": true },
    { "id": "reports-make", "name": "Make reports", "core": true },
    { "id": "reports-premium", "name": "Premium reports" }
  ],
  "plans": [
    { "id": "basic", "name": "Basic", "capabilities": [] },
    { "id": "pro", "name": "Pro", "capabilities": ["reports-premium"] }
  ],
  "roles": [
    { "id": "operator", "name": "Operator", "level": "platform", "holders": ["person"], "capabilities": ["jobs-submit", "ping"] },
    { "id": "visitor", "name": "Visitor", "level": "platform", "holders": ["anonymous"], "capabilities": ["jobs-cancel", "reports-make"] },
    { "id": "support", "name": "Support", "level": "platform", "holders": ["person"], "capabilities": [] },
    { "id": "editor", "name": "Editor", "level": "tenant", "holders": ["person", "team"], "capabilities": ["ping", "reports-premium"] }
  ],
  "grants": [
    { "id": "support-access", "name": "Support access", "issuer": "editor", "grantee": "support", "capabilities": ["reports-premium"], "perTenant": true }
  ],
  "tokenScopes": [
    { "id": "reports-read", "name": "reports:read", "capabilities": ["ping", "reports-premium"] }
  ],
  "delegations": [
    { "id": "report-agent", "name": "Report agent", "from": "reports-read", "to": "agent", "capabilities": ["ping"] }
  ],
  "featureFlags": [
    { "id": "premium-reports", "name": "Premium reports", "gates": ["reports-premium"], "default": "off" }
  ],
  "policies": [
    { "id": "pol-operator-submit", "subject": { "principal": "operator" }, "contract": "submit-job", "effect": "allow" },
    { "id": "pol-guest-submit", "subject": { "principal": "operator", "role": "guest" }, "contract": "submit-job", "effect": "deny" }
  ],
  "validations": [
    { "id": "val-priority-range", "contract": "submit-job", "input": "priority", "rule": "range", "min": 1, "max": 9, "message": "A priority is 1 to 9." }
  ],
  "quotas": [
    { "id": "quota-submit", "scope": "principal", "contract": "submit-job", "limit": 2, "window": "1 min", "onExceed": "refuse", "error": "busy", "heldBy": "scheduler" }
  ],
  "retries": [
    { "id": "retry-report", "contract": "make-report", "attempts": 2, "backoff": { "kind": "fixed", "base": "10 ms" }, "timeout": "1 s" }
  ],
  "audits": [
    { "id": "job-submitted-audit", "contract": "submit-job", "record": "rec-job-audit", "immutability": "append-only",
      "capture": [ { "field": "actor", "from": "principal.id" }, { "field": "job", "from": "request.job" }, { "field": "at", "from": "time" } ] }
  ],
  "events": [
    { "id": "job-submitted", "name": "Job submitted", "contract": "submit-job", "role": "request", "payload": [ { "name": "job", "type": "string" }, { "name": "priority", "type": "u32" } ] },
    { "id": "job-cancel", "name": "Job cancelled", "contract": "cancel-job", "role": "request", "payload": [ { "name": "job", "type": "string" } ] },
    { "id": "job-tick", "name": "Job retry due", "elapsed": true, "payload": [ { "name": "job", "type": "string" } ] },
    { "id": "job-started", "name": "Job started", "delivery": "at-least-once", "payload": [ { "name": "job", "type": "string" }, { "name": "attempts", "type": "u32" } ] },
    { "id": "tracker-reset", "name": "Tracker reset", "payload": [ { "name": "job", "type": "string" } ] }
  ],
  "behaviors": [
    {
      "id": "job", "name": "Job", "subject": "scheduler", "initial": "idle", "level": "implementation",
      "description": "One job per key: started when submitted with a priority, retried by a timer up to three attempts, cancelled on request.",
      "variables": [ { "name": "attempts", "type": "number", "initial": 0, "repr": "u32" } ],
      "instances": { "key": "job", "storedIn": "rec-job" }, "storage": { "record": "rec-job", "key": "job", "creates": true },
      "transaction": { "scope": "transition", "isolation": "serializable" },
      "states": [
        { "id": "idle", "name": "Waiting", "ignores": ["job-tick", "job-cancel"] },
        { "id": "running", "name": "Running", "ignores": ["job-submitted"] },
        { "id": "done", "name": "Done", "terminal": true }
      ],
      "transitions": [
        { "id": "submit", "from": "idle", "to": "running", "on": "job-submitted", "guard": "event.priority > 0",
          "effects": [
            { "set": "attempts", "to": "attempts + 1" },
            { "emit": "job-started", "to": "tracker", "payload": { "job": "event.job", "attempts": "attempts" } },
            { "timer": "retry", "after": 100, "emit": "job-tick", "payload": { "job": "event.job" } }
          ] },
        { "id": "retry", "from": "running", "to": "running", "on": "job-tick", "guard": "attempts < 3",
          "effects": [
            { "set": "attempts", "to": "attempts + 1" },
            { "timer": "retry", "after": 100, "emit": "job-tick", "payload": { "job": "event.job" } }
          ] },
        { "id": "give-up", "from": "running", "to": "done", "on": "job-tick", "otherwise": true },
        { "id": "cancel", "from": "running", "to": "done", "on": "job-cancel", "otherwise": true,
          "effects": [ { "cancel": "retry" } ] }
      ]
    },
    {
      "id": "tracker", "name": "Tracker", "subject": "scheduler", "initial": "watching", "level": "implementation",
      "description": "Counts how often each job was started.",
      "variables": [ { "name": "seen", "type": "number", "initial": 0, "repr": "u32" } ],
      "storage": { "record": "rec-tracker", "key": "job", "creates": true },
      "transaction": { "scope": "transition", "isolation": "serializable" },
      "states": [ { "id": "watching", "name": "Watching" } ],
      "transitions": [
        { "id": "count", "from": "watching", "to": "watching", "on": "job-started", "effects": [ { "set": "seen", "to": "seen + 1" } ] },
        { "id": "reset", "from": "watching", "to": "watching", "on": "tracker-reset", "effects": [ { "set": "seen", "to": "0" } ] }
      ]
    }
  ]
}
