// Golden fixture for specc's wiring backends (routes, deps, handlers). The expected output is the
// crate crates/spec-compiler-wiring-fixture, which tests/wiring.rs serves and calls.
//
// - gateway calls scheduler and worker; scheduler calls reports; nobody calls gateway. worker
//   implements no contract, so gateway gets no client for it.
// - submit-job has a binding path, a validation, a policy, a quota refusing with a contract error
//   and an audit; make-report has a retry policy; the others take the default path.
// - machine job receives job-submitted and job-cancel through contracts and job-tick from its own
//   timer; it publishes job-started to machine tracker. tracker-reset arrives in no stated way.
{
  "exegra": "0.1",
  "system": { "id": "wiring-fixture", "name": "Wiring fixture", "generation": { "target": "rust" } },
  "components": [
    { "id": "gateway", "name": "Gateway", "category": "service", "purpose": "Takes requests from outside." },
    { "id": "scheduler", "name": "Scheduler", "category": "service", "purpose": "Runs jobs." },
    { "id": "reports", "name": "Reports", "category": "service", "purpose": "Writes job reports." },
    { "id": "worker", "name": "Worker", "category": "external", "purpose": "Does the work." }
  ],
  "relationships": [
    { "id": "gateway-calls-scheduler", "kind": "calls", "from": "gateway", "to": "scheduler", "description": "Jobs are submitted through the gateway." },
    { "id": "gateway-calls-worker", "kind": "calls", "from": "gateway", "to": "worker", "description": "The gateway wakes workers." },
    { "id": "scheduler-calls-reports", "kind": "calls", "from": "scheduler", "to": "reports", "description": "A finished job gets a report." },
    { "id": "reports-reads-scheduler", "kind": "reads", "from": "reports", "to": "scheduler", "description": "Not a call: gives no client." }
  ],
  "records": [
    { "id": "rec-job", "name": "Job", "owner": "scheduler", "key": ["job"], "schemaVersion": 1,
      "fields": [
        { "name": "job", "type": "string" },
        { "name": "state", "type": "string" },
        { "name": "attempts", "type": "u32" }
      ] },
    { "id": "rec-tracker", "name": "Tracker", "owner": "scheduler", "key": ["job"], "schemaVersion": 1,
      "fields": [
        { "name": "job", "type": "string" },
        { "name": "state", "type": "string" },
        { "name": "seen", "type": "u32" }
      ] },
    { "id": "rec-job-audit", "name": "Job audit entry", "owner": "scheduler", "key": ["log-id"], "schemaVersion": 1,
      "fields": [
        { "name": "log-id", "type": "u64" },
        { "name": "actor", "type": "string" },
        { "name": "job", "type": "string" },
        { "name": "at", "type": "timestamp" }
      ] }
  ],
  "contracts": [
    { "id": "submit-job", "name": "Submit job", "ref": "CT-1", "realisation": "generated", "implementedBy": "scheduler",
      "binding": { "protocol": "http", "method": "POST", "path": "/api/jobs/submit" },
      "auth": "An operator.", "idempotent": true, "timeoutMs": 2000, "policyDefault": "deny",
      "inputs": [{ "name": "job", "type": "string" }, { "name": "priority", "type": "u32" }],
      "outputs": [{ "name": "accepted", "type": "bool" }],
      "errors": [{ "name": "busy", "condition": "Too many jobs were submitted in the last minute." }] },
    { "id": "cancel-job", "name": "Cancel job", "ref": "CT-2", "realisation": "generated", "implementedBy": "scheduler", "idempotent": true, "timeoutMs": 1000,
      "inputs": [{ "name": "job", "type": "string" }],
      "outputs": [] },
    { "id": "ping", "name": "Ping", "ref": "CT-3", "realisation": "generated", "implementedBy": "gateway", "idempotent": false, "policyDefault": "allow",
      "outputs": [{ "name": "pong", "type": "string" }] },
    { "id": "make-report", "name": "Make report", "ref": "CT-4", "realisation": "generated", "implementedBy": "reports", "idempotent": true, "timeoutMs": 1000,
      "inputs": [{ "name": "job", "type": "string" }],
      "outputs": [{ "name": "text", "type": "string" }],
      "errors": [{ "name": "not-found", "condition": "No job has the id." }] }
  ],
  "policies": [
    { "id": "pol-operator-submit", "subject": { "principal": "operator" }, "contract": "submit-job", "effect": "allow" },
    { "id": "pol-guest-submit", "subject": { "principal": "operator", "role": "guest" }, "contract": "submit-job", "effect": "deny" }
  ],
  "validations": [
    { "id": "val-priority-range", "contract": "submit-job", "input": "priority", "rule": "range", "min": 1, "max": 9, "message": "A priority is 1 to 9." }
  ],
  "quotas": [
    { "id": "quota-submit", "scope": "principal", "contract": "submit-job", "limit": 2, "window": "1 min", "onExceed": "refuse", "error": "busy", "heldBy": "scheduler" }
  ],
  "retries": [
    { "id": "retry-report", "contract": "make-report", "attempts": 2, "backoff": { "kind": "fixed", "base": "10 ms" }, "timeout": "1 s" }
  ],
  "audits": [
    { "id": "job-submitted-audit", "contract": "submit-job", "record": "rec-job-audit", "immutability": "append-only",
      "capture": [ { "field": "actor", "from": "principal.id" }, { "field": "job", "from": "request.job" }, { "field": "at", "from": "time" } ] }
  ],
  "events": [
    { "id": "job-submitted", "name": "Job submitted", "contract": "submit-job", "role": "request", "payload": [ { "name": "job", "type": "string" }, { "name": "priority", "type": "u32" } ] },
    { "id": "job-cancel", "name": "Job cancelled", "contract": "cancel-job", "role": "request", "payload": [ { "name": "job", "type": "string" } ] },
    { "id": "job-tick", "name": "Job retry due", "elapsed": true, "payload": [ { "name": "job", "type": "string" } ] },
    { "id": "job-started", "name": "Job started", "delivery": "at-least-once", "payload": [ { "name": "job", "type": "string" }, { "name": "attempts", "type": "u32" } ] },
    { "id": "tracker-reset", "name": "Tracker reset", "payload": [ { "name": "job", "type": "string" } ] }
  ],
  "behaviors": [
    {
      "id": "job", "name": "Job", "subject": "scheduler", "initial": "idle", "level": "implementation",
      "description": "One job per key: started when submitted with a priority, retried by a timer up to three attempts, cancelled on request.",
      "variables": [ { "name": "attempts", "type": "number", "initial": 0, "repr": "u32" } ],
      "instances": { "key": "job", "storedIn": "rec-job" }, "storage": { "record": "rec-job", "key": "job", "creates": true },
      "transaction": { "scope": "transition", "isolation": "serializable" },
      "states": [
        { "id": "idle", "name": "Waiting", "ignores": ["job-tick", "job-cancel"] },
        { "id": "running", "name": "Running", "ignores": ["job-submitted"] },
        { "id": "done", "name": "Done", "terminal": true }
      ],
      "transitions": [
        { "id": "submit", "from": "idle", "to": "running", "on": "job-submitted", "guard": "event.priority > 0",
          "effects": [
            { "set": "attempts", "to": "attempts + 1" },
            { "emit": "job-started", "to": "tracker", "payload": { "job": "event.job", "attempts": "attempts" } },
            { "timer": "retry", "after": 100, "emit": "job-tick", "payload": { "job": "event.job" } }
          ] },
        { "id": "retry", "from": "running", "to": "running", "on": "job-tick", "guard": "attempts < 3",
          "effects": [
            { "set": "attempts", "to": "attempts + 1" },
            { "timer": "retry", "after": 100, "emit": "job-tick", "payload": { "job": "event.job" } }
          ] },
        { "id": "give-up", "from": "running", "to": "done", "on": "job-tick", "otherwise": true },
        { "id": "cancel", "from": "running", "to": "done", "on": "job-cancel", "otherwise": true,
          "effects": [ { "cancel": "retry" } ] }
      ]
    },
    {
      "id": "tracker", "name": "Tracker", "subject": "scheduler", "initial": "watching", "level": "implementation",
      "description": "Counts how often each job was started.",
      "variables": [ { "name": "seen", "type": "number", "initial": 0, "repr": "u32" } ],
      "storage": { "record": "rec-tracker", "key": "job", "creates": true },
      "transaction": { "scope": "transition", "isolation": "serializable" },
      "states": [ { "id": "watching", "name": "Watching" } ],
      "transitions": [
        { "id": "count", "from": "watching", "to": "watching", "on": "job-started", "effects": [ { "set": "seen", "to": "seen + 1" } ] },
        { "id": "reset", "from": "watching", "to": "watching", "on": "tracker-reset", "effects": [ { "set": "seen", "to": "0" } ] }
      ]
    }
  ]
}
