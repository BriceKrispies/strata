// Golden fixture for specc: every type kind and built-in representation, list and option,
// every record constraint, unique set, index, reference and onDelete, schema versions, and
// contracts with a hole, errors with and without payload types, and several implementing
// components, and every cross-cutting construct: policies, validations, retentions, quotas, retries
// and audits (append-only and hash-chained). The expected output is the crate
// crates/spec-compiler-fixture.
{
  "exegra": "0.1",
  "system": { "id": "fixture-platform", "name": "Fixture platform", "generation": { "target": "rust", "errorKinds": { "conflict": 409, "invalid": 422, "not_found": 404, "throttled": 429 }, "errorStatus": 422 } },
  "components": [
    { "id": "gateway", "name": "Gateway", "category": "service" },
    { "id": "ledger", "name": "Ledger", "category": "service" },
    { "id": "identity", "name": "Identity", "category": "service" },
    { "id": "control-plane", "name": "Control plane", "category": "service" },
  ],
  "types": [
    { "id": "tenant-id", "name": "Tenant id", "kind": "id", "repr": "string", "description": "Identifies a tenant across every region." },
    { "id": "account-id", "name": "Account id", "kind": "id", "repr": "uuid" },
    { "id": "sequence", "name": "Sequence number", "kind": "scalar", "repr": "u64" },
    { "id": "score", "name": "Score", "kind": "scalar", "repr": "f64" },
    { "id": "deadline", "name": "Deadline", "kind": "scalar", "repr": "timestamp" },
    { "id": "ttl", "name": "Time to live", "kind": "scalar", "repr": "duration" },
    { "id": "blob", "name": "Blob", "kind": "scalar", "repr": "bytes" },
    { "id": "enabled", "name": "Enabled", "kind": "scalar", "repr": "bool" },
    { "id": "priority", "name": "Priority", "kind": "scalar", "repr": "u8" },
    { "id": "port", "name": "Port", "kind": "scalar", "repr": "u16" },
    { "id": "quota", "name": "Quota", "kind": "scalar", "repr": "u32" },
    { "id": "offset", "name": "Offset", "kind": "scalar", "repr": "i32" },
    { "id": "balance", "name": "Balance", "kind": "scalar", "repr": "i64" },
    { "id": "tenant-state", "name": "Tenant state", "kind": "enum", "values": ["active", "suspended", "pending-deletion"] },
    { "id": "money", "name": "Money", "kind": "struct", "fields": [{ "name": "amount", "type": "i64" }, { "name": "currency", "type": "string" }, { "name": "note", "type": "string", "optional": true }] },
    { "id": "geo-point", "name": "Geographic point", "kind": "struct", "fields": [{ "name": "lat", "type": "f64" }, { "name": "lon", "type": "f64" }] },
    { "id": "tree-node", "name": "Tree node", "kind": "struct", "fields": [{ "name": "label", "type": "string" }, { "name": "children", "type": "list<tree-node>" }, { "name": "weight", "type": "option<score>" }] },
    { "id": "tag", "name": "Tag", "kind": "struct", "fields": [{ "name": "type", "type": "string" }, { "name": "value", "type": "list<option<string>>" }, { "name": "expires", "type": "option<deadline>" }] },
  ],
  "records": [
    { "id": "rec-tenant", "name": "Tenant", "owner": "control-plane", "key": ["tenant-id"], "schemaVersion": 2, "changes": [{ "version": 1, "description": "First shape." }, { "version": 2, "description": "Added the parent tenant." }],
      "fields": [
        { "name": "tenant-id", "type": "tenant-id" },
        { "name": "slug", "type": "string", "constraints": { "maxLength": 32, "pattern": "^[a-z][a-z0-9-]*$" }, "description": "The tenant's address label." },
        { "name": "state", "type": "tenant-state" },
        { "name": "plan-seats", "type": "u32", "constraints": { "min": 1, "max": 500 } },
        { "name": "created", "type": "timestamp", "constraints": { "min": 0 } },
        { "name": "owner-account", "type": "account-id", "refersTo": "rec-account", "onDelete": "restrict" },
        { "name": "parent", "type": "tenant-id", "optional": true, "refersTo": "rec-tenant", "onDelete": "set-null" }
      ],
      "unique": [["slug"]], "indexes": [{ "name": "by-state", "fields": ["state"] }, { "name": "by-owner", "fields": ["owner-account", "created"] }],
      "retention": "Until the tenant is deleted." },
    { "id": "rec-account", "name": "Account", "owner": "identity", "key": ["account-id"], "schemaVersion": 1,
      "fields": [
        { "name": "account-id", "type": "account-id" },
        { "name": "principal", "type": "uuid", "refersTo": "principal", "onDelete": "cascade", "personal": "identifier", "role": "subject" },
        { "name": "display-name", "type": "string", "optional": true, "personal": "name", "constraints": { "maxLength": 64 } },
        { "name": "balance", "type": "balance", "constraints": { "min": -1000, "max": 1000000 } },
        { "name": "score", "type": "option<score>", "constraints": { "min": 0, "max": 100.5 } },
        { "name": "quota", "type": "quota", "optional": true, "constraints": { "min": 0, "max": 10 } },
        { "name": "labels", "type": "list<string>" },
        { "name": "avatar", "type": "blob", "optional": true },
        { "name": "expires-in", "type": "ttl", "optional": true, "constraints": { "max": 86400000 } },
        { "name": "home-port", "type": "port" },
        { "name": "enabled", "type": "enabled" }
      ],
      "unique": [["principal"], ["display-name", "home-port"]], "indexes": [],
      "retention": "Until the principal is deleted.", "erasure": { "point": "When the principal is deleted." } },
    { "id": "rec-ledger-entry", "name": "Ledger entry", "owner": "ledger", "key": ["account-id", "sequence"], "schemaVersion": 3,
      "fields": [
        { "name": "account-id", "type": "account-id", "refersTo": "rec-account", "onDelete": "cascade" },
        { "name": "sequence", "type": "sequence" },
        { "name": "amount", "type": "money" },
        { "name": "location", "type": "geo-point", "optional": true },
        { "name": "at", "type": "timestamp" },
        { "name": "settle-by", "type": "deadline", "optional": true, "constraints": { "min": 1 } },
        { "name": "priority", "type": "u8", "constraints": { "min": 1, "max": 9 } },
        { "name": "offset", "type": "offset", "constraints": { "min": -5, "max": 5 } },
        { "name": "tags", "type": "list<tag>" },
        { "name": "memo", "type": "option<string>", "constraints": { "pattern": "^\\S.*$" } }
      ],
      "description": "One posting to an account; entries are never changed once written.",
      "retention": "Seven years after the account closes." },
    { "id": "rec-tenant-audit", "name": "Tenant audit entry", "owner": "control-plane", "key": ["entry-id"], "schemaVersion": 1,
      "fields": [
        { "name": "entry-id", "type": "sequence" },
        { "name": "actor", "type": "string" },
        { "name": "at", "type": "timestamp" },
        { "name": "tenant", "type": "tenant-id" },
        { "name": "state", "type": "tenant-state" },
        { "name": "parent", "type": "tenant-id", "optional": true },
        { "name": "chain", "type": "bytes" }
      ],
      "description": "One entry of the tenant audit log; entries are never changed." },
    { "id": "rec-close-audit", "name": "Account closing audit entry", "owner": "identity", "key": ["log-id"], "schemaVersion": 1,
      "fields": [
        { "name": "log-id", "type": "sequence" },
        { "name": "actor", "type": "string" },
        { "name": "account", "type": "account-id" },
        { "name": "grace", "type": "ttl" },
        { "name": "at", "type": "timestamp" },
        { "name": "digest", "type": "string" }
      ] },
    { "id": "rec-access-log", "name": "Account read log entry", "owner": "ledger", "key": ["log-id"], "schemaVersion": 1,
      "fields": [
        { "name": "log-id", "type": "sequence" },
        { "name": "who", "type": "string" },
        { "name": "account", "type": "account-id" },
        { "name": "at", "type": "timestamp", "optional": true }
      ] }
  ],
  "contracts": [
    { "id": "create-tenant", "name": "Create tenant", "ref": "CT-001", "realisation": "generated", "implementedBy": "gateway", "exposure": "internal", "tenantScope": "platform", "auth": { "scheme": "session", "requires": ["tenants-create"], "roles": ["operator"], "csrf": true, "origin": true, "description": "An operator of the control plane." }, "idempotent": true, "timeoutMs": 2000, "policyDefault": "deny",
      "description": "Creates a tenant and reserves its slug.",
      "inputs": [{ "name": "slug", "type": "string" }, { "name": "plan-seats", "type": "u32" }, { "name": "parent", "type": "tenant-id", "optional": true }, { "name": "type", "type": "string", "optional": true, "description": "A free-form tenant category." }],
      "outputs": [{ "name": "tenant-id", "type": "tenant-id" }, { "name": "state", "type": "tenant-state" }],
      "preconditions": ["The slug is not taken.", "The caller is an operator."],
      "postconditions": ["A tenant record exists in state active.", "The slug is reserved for it."],
      "errors": [{ "name": "slug-taken", "condition": "Another tenant holds the slug.", "kind": "conflict" }, { "name": "invalid-slug", "condition": "The slug breaks the slug pattern.", "type": "string" }, { "name": "quota-exceeded", "type": "quota", "kind": "throttled" }] },
    { "id": "get-account", "name": "Get account", "ref": "CT-002", "realisation": "generated", "implementedBy": "ledger", "exposure": "public", "readOnly": true, "tenantScope": "request", "auth": { "scheme": "session", "requires": ["accounts-read"], "stepUp": "15 min" }, "idempotent": true, "timeoutMs": 500, "policyDefault": "deny",
      "inputs": [{ "name": "account-id", "type": "account-id" }, { "name": "as-of", "type": "option<timestamp>" }],
      "outputs": [{ "name": "balance", "type": "money" }, { "name": "location", "type": "option<geo-point>" }, { "name": "entries", "type": "list<sequence>" }],
      "errors": [{ "name": "not-found", "condition": "No account has the id.", "kind": "not_found" }] },
    { "id": "post-entry", "name": "Post entry", "ref": "H-7", "realisation": "hand", "implementedBy": "ledger", "exposure": "local", "auth": { "scheme": "in-process", "description": "The ledger's own workers." }, "idempotent": false,
      "inputs": [{ "name": "account-id", "type": "account-id" }, { "name": "amount", "type": "money" }, { "name": "deadline", "type": "deadline" }],
      "outputs": [{ "name": "sequence", "type": "sequence" }],
      "postconditions": ["Exactly one ledger entry is appended with the next sequence number.", "The account balance changes by the amount."] },
    { "id": "close-account", "name": "Close account", "ref": "CT-003", "realisation": "generated", "implementedBy": "identity", "exposure": "internal", "tenantScope": "platform", "auth": { "scheme": "service", "requires": ["accounts-close"] }, "timeoutMs": 10000,
      "inputs": [{ "name": "account-id", "type": "account-id" }, { "name": "grace", "type": "duration" }],
      "outputs": [],
      "errors": [{ "name": "still-funded", "condition": "The balance is not zero.", "type": "money", "status": 409 }, { "name": "location-unknown", "type": "geo-point" }] },
    { "id": "ping", "name": "Ping", "realisation": "generated", "idempotent": false, "policyDefault": "allow" }
  ],
  "capabilities": [
    { "id": "tenants-create", "name": "Create tenants", "core": true },
    { "id": "accounts-read", "name": "Read accounts", "core": true },
    { "id": "accounts-close", "name": "Close accounts", "core": true }
  ],
  "roles": [
    { "id": "operator", "name": "Operator", "level": "platform", "holders": ["person"], "capabilities": ["tenants-create"] },
    { "id": "account-holder", "name": "Account holder", "level": "tenant", "holders": ["person"], "capabilities": ["accounts-read"] },
    { "id": "platform-service", "name": "Platform service", "level": "platform", "holders": ["service"], "capabilities": ["accounts-close"] }
  ],
  "policies": [
    { "id": "pol-operator-create", "subject": { "principal": "operator" }, "contract": "create-tenant", "effect": "allow", "condition": "request.plan-seats <= 500" },
    { "id": "pol-guest-create", "subject": { "principal": "member", "role": "guest" }, "contract": "create-tenant", "effect": "deny" },
    { "id": "pol-read-account", "subject": { "principal": "member" }, "contract": "get-account", "resource": "rec-account", "effect": "allow", "condition": "record.enabled && principal.role != 'banned'" },
  ],
  "validations": [
    { "id": "val-slug-required", "contract": "create-tenant", "input": "slug", "rule": "required", "message": "A slug is required." },
    { "id": "val-slug-length", "contract": "create-tenant", "input": "slug", "rule": "maxLength", "maxLength": 32, "unit": "characters", "message": "A slug has at most 32 characters." },
    { "id": "val-slug-pattern", "contract": "create-tenant", "input": "slug", "rule": "pattern", "pattern": "[a-z][a-z0-9-]*", "message": "A slug is lower-case words joined by hyphens." },
    { "id": "val-seats-range", "contract": "create-tenant", "input": "plan-seats", "rule": "range", "min": 1, "max": 500, "message": "A plan has 1 to 500 seats." },
    { "id": "val-seats-even", "contract": "create-tenant", "input": "plan-seats", "rule": "custom", "expr": "value % 2 == 0 || request.slug == 'trial'", "message": "Seats are bought in pairs." },
    { "id": "val-category", "contract": "create-tenant", "input": "type", "rule": "oneOf", "values": ["cell", "region"], "message": "A category is cell or region." },
    { "id": "val-name-bytes", "record": "rec-account", "field": "display-name", "rule": "maxLength", "maxLength": 200, "unit": "bytes", "message": "A name has at most 200 bytes." },
    { "id": "val-balance-sign", "record": "rec-account", "field": "balance", "rule": "custom", "expr": "value >= 0 || record.enabled", "message": "Only an enabled account may be overdrawn." },
  ],
  "retentions": [
    { "id": "ret-account", "record": "rec-account", "keepFor": "400 d", "then": "anonymise", "fields": ["display-name", "principal", "labels"] },
    { "id": "ret-ledger", "record": "rec-ledger-entry", "until": "account-closed", "then": "archive", "archiveTo": "control-plane" },
    { "id": "ret-tenant", "record": "rec-tenant", "keepFor": "36.5 h", "then": "delete" },
  ],
  "quotas": [
    { "id": "quota-create-tenant", "scope": "tenant", "contract": "create-tenant", "limit": 100, "window": "1 min", "onExceed": "refuse", "error": "quota-exceeded", "heldBy": "gateway" },
    { "id": "quota-entry-events", "scope": "principal", "event": "entry-posted", "limit": 1000, "window": "1 h", "onExceed": "throttle", "heldBy": "ledger" },
  ],
  "retries": [
    { "id": "retry-get-account", "contract": "get-account", "attempts": 3, "backoff": { "kind": "exponential", "base": "100 ms", "cap": "2 s" }, "timeout": "500 ms" },
    { "id": "retry-entry-event", "event": "entry-posted", "attempts": 5, "backoff": { "kind": "fixed", "base": "1 s" }, "idempotencyKey": "sequence", "timeout": "10 s" },
  ],
  "audits": [
    { "id": "tenant-created", "contract": "create-tenant", "record": "rec-tenant-audit", "immutability": "chained-hash", "chainField": "chain",
      "capture": [
        { "field": "actor", "from": "principal.id" }, { "field": "at", "from": "time" },
        { "field": "tenant", "from": "response.tenant-id" }, { "field": "state", "from": "response.state" },
        { "field": "parent", "from": "request.parent" } ] },
    { "id": "account-closing", "contract": "close-account", "record": "rec-close-audit", "immutability": "chained-hash", "chainField": "digest",
      "capture": [
        { "field": "actor", "from": "principal.id" }, { "field": "account", "from": "request.account-id" },
        { "field": "grace", "from": "request.grace" }, { "field": "at", "from": "time" } ] },
    { "id": "account-read", "contract": "get-account", "record": "rec-access-log", "immutability": "append-only",
      "capture": [ { "field": "who", "from": "principal.id" }, { "field": "account", "from": "request.account-id" } ] },
  ]
}
