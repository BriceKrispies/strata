// Golden fixture for specc: every type kind and built-in representation, list and option,
// every record constraint, unique set, index, reference and onDelete, schema versions, and
// contracts with a hole, errors with and without payload types, and several implementing
// components. The expected output is the crate crates/spec-compiler-fixture.
{
  "exegra": "0.1",
  "system": { "id": "fixture-platform", "name": "Fixture platform", "generation": { "target": "rust" } },
  "components": [
    { "id": "gateway", "name": "Gateway", "category": "service" },
    { "id": "ledger", "name": "Ledger", "category": "service" },
    { "id": "identity", "name": "Identity", "category": "service" },
    { "id": "control-plane", "name": "Control plane", "category": "service" },
  ],
  "types": [
    { "id": "tenant-id", "name": "Tenant id", "kind": "id", "repr": "string", "description": "Identifies a tenant across every region." },
    { "id": "account-id", "name": "Account id", "kind": "id", "repr": "uuid" },
    { "id": "sequence", "name": "Sequence number", "kind": "scalar", "repr": "u64" },
    { "id": "score", "name": "Score", "kind": "scalar", "repr": "f64" },
    { "id": "deadline", "name": "Deadline", "kind": "scalar", "repr": "timestamp" },
    { "id": "ttl", "name": "Time to live", "kind": "scalar", "repr": "duration" },
    { "id": "blob", "name": "Blob", "kind": "scalar", "repr": "bytes" },
    { "id": "enabled", "name": "Enabled", "kind": "scalar", "repr": "bool" },
    { "id": "priority", "name": "Priority", "kind": "scalar", "repr": "u8" },
    { "id": "port", "name": "Port", "kind": "scalar", "repr": "u16" },
    { "id": "quota", "name": "Quota", "kind": "scalar", "repr": "u32" },
    { "id": "offset", "name": "Offset", "kind": "scalar", "repr": "i32" },
    { "id": "balance", "name": "Balance", "kind": "scalar", "repr": "i64" },
    { "id": "tenant-state", "name": "Tenant state", "kind": "enum", "values": ["active", "suspended", "pending-deletion"] },
    { "id": "money", "name": "Money", "kind": "struct", "fields": [{ "name": "amount", "type": "i64" }, { "name": "currency", "type": "string" }, { "name": "note", "type": "string", "optional": true }] },
    { "id": "geo-point", "name": "Geographic point", "kind": "struct", "fields": [{ "name": "lat", "type": "f64" }, { "name": "lon", "type": "f64" }] },
    { "id": "tree-node", "name": "Tree node", "kind": "struct", "fields": [{ "name": "label", "type": "string" }, { "name": "children", "type": "list<tree-node>" }, { "name": "weight", "type": "option<score>" }] },
    { "id": "tag", "name": "Tag", "kind": "struct", "fields": [{ "name": "type", "type": "string" }, { "name": "value", "type": "list<option<string>>" }, { "name": "expires", "type": "option<deadline>" }] },
  ],
  "records": [
    { "id": "rec-tenant", "name": "Tenant", "owner": "control-plane", "key": ["tenant-id"], "schemaVersion": 2, "changes": [{ "version": 1, "description": "First shape." }, { "version": 2, "description": "Added the parent tenant." }],
      "fields": [
        { "name": "tenant-id", "type": "tenant-id" },
        { "name": "slug", "type": "string", "constraints": { "maxLength": 32, "pattern": "^[a-z][a-z0-9-]*$" }, "description": "The tenant's address label." },
        { "name": "state", "type": "tenant-state" },
        { "name": "plan-seats", "type": "u32", "constraints": { "min": 1, "max": 500 } },
        { "name": "created", "type": "timestamp", "constraints": { "min": 0 } },
        { "name": "owner-account", "type": "account-id", "refersTo": "rec-account", "onDelete": "restrict" },
        { "name": "parent", "type": "tenant-id", "optional": true, "refersTo": "rec-tenant", "onDelete": "set-null" }
      ],
      "unique": [["slug"]], "indexes": [{ "name": "by-state", "fields": ["state"] }, { "name": "by-owner", "fields": ["owner-account", "created"] }],
      "retention": "Until the tenant is deleted." },
    { "id": "rec-account", "name": "Account", "owner": "identity", "key": ["account-id"], "schemaVersion": 1,
      "fields": [
        { "name": "account-id", "type": "account-id" },
        { "name": "principal", "type": "uuid", "refersTo": "principal", "onDelete": "cascade", "personal": "identifier", "role": "subject" },
        { "name": "display-name", "type": "string", "optional": true, "personal": "name", "constraints": { "maxLength": 64 } },
        { "name": "balance", "type": "balance", "constraints": { "min": -1000, "max": 1000000 } },
        { "name": "score", "type": "option<score>", "constraints": { "min": 0, "max": 100.5 } },
        { "name": "quota", "type": "quota", "optional": true, "constraints": { "min": 0, "max": 10 } },
        { "name": "labels", "type": "list<string>" },
        { "name": "avatar", "type": "blob", "optional": true },
        { "name": "expires-in", "type": "ttl", "optional": true, "constraints": { "max": 86400000 } },
        { "name": "home-port", "type": "port" },
        { "name": "enabled", "type": "enabled" }
      ],
      "unique": [["principal"], ["display-name", "home-port"]], "indexes": [],
      "retention": "Until the principal is deleted.", "erasure": { "point": "When the principal is deleted." } },
    { "id": "rec-ledger-entry", "name": "Ledger entry", "owner": "ledger", "key": ["account-id", "sequence"], "schemaVersion": 3,
      "fields": [
        { "name": "account-id", "type": "account-id", "refersTo": "rec-account", "onDelete": "cascade" },
        { "name": "sequence", "type": "sequence" },
        { "name": "amount", "type": "money" },
        { "name": "location", "type": "geo-point", "optional": true },
        { "name": "at", "type": "timestamp" },
        { "name": "settle-by", "type": "deadline", "optional": true, "constraints": { "min": 1 } },
        { "name": "priority", "type": "u8", "constraints": { "min": 1, "max": 9 } },
        { "name": "offset", "type": "offset", "constraints": { "min": -5, "max": 5 } },
        { "name": "tags", "type": "list<tag>" },
        { "name": "memo", "type": "option<string>", "constraints": { "pattern": "^\\S.*$" } }
      ],
      "description": "One posting to an account; entries are never changed once written.",
      "retention": "Seven years after the account closes." }
  ],
  "contracts": [
    { "id": "create-tenant", "name": "Create tenant", "ref": "CT-001", "realisation": "generated", "implementedBy": "gateway", "auth": "An operator of the control plane.", "idempotent": true, "timeoutMs": 2000,
      "description": "Creates a tenant and reserves its slug.",
      "inputs": [{ "name": "slug", "type": "string" }, { "name": "plan-seats", "type": "u32" }, { "name": "parent", "type": "tenant-id", "optional": true }, { "name": "type", "type": "string", "optional": true, "description": "A free-form tenant category." }],
      "outputs": [{ "name": "tenant-id", "type": "tenant-id" }, { "name": "state", "type": "tenant-state" }],
      "preconditions": ["The slug is not taken.", "The caller is an operator."],
      "postconditions": ["A tenant record exists in state active.", "The slug is reserved for it."],
      "errors": [{ "name": "slug-taken", "condition": "Another tenant holds the slug." }, { "name": "invalid-slug", "condition": "The slug breaks the slug pattern.", "type": "string" }, { "name": "quota-exceeded", "type": "quota" }] },
    { "id": "get-account", "name": "Get account", "ref": "CT-002", "realisation": "generated", "implementedBy": "ledger", "idempotent": true, "timeoutMs": 500,
      "inputs": [{ "name": "account-id", "type": "account-id" }, { "name": "as-of", "type": "option<timestamp>" }],
      "outputs": [{ "name": "balance", "type": "money" }, { "name": "location", "type": "option<geo-point>" }, { "name": "entries", "type": "list<sequence>" }],
      "errors": [{ "name": "not-found", "condition": "No account has the id." }] },
    { "id": "post-entry", "name": "Post entry", "ref": "H-7", "realisation": "hand", "implementedBy": "ledger", "auth": "The ledger's own workers.", "idempotent": false,
      "inputs": [{ "name": "account-id", "type": "account-id" }, { "name": "amount", "type": "money" }, { "name": "deadline", "type": "deadline" }],
      "outputs": [{ "name": "sequence", "type": "sequence" }],
      "postconditions": ["Exactly one ledger entry is appended with the next sequence number.", "The account balance changes by the amount."] },
    { "id": "close-account", "name": "Close account", "ref": "CT-003", "realisation": "generated", "implementedBy": "identity", "timeoutMs": 10000,
      "inputs": [{ "name": "account-id", "type": "account-id" }, { "name": "grace", "type": "duration" }],
      "outputs": [],
      "errors": [{ "name": "still-funded", "condition": "The balance is not zero.", "type": "money" }, { "name": "location-unknown", "type": "geo-point" }] },
    { "id": "ping", "name": "Ping", "realisation": "generated", "idempotent": false }
  ]
}
