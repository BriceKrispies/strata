{
  "format": "exegra-expr-cases",
  "version": 1,
  "description": "The shared case table of expression and value semantics (WG-4902, docs/semantics.md, sections Numbers, Equality, Absent values and Time). Each case is an expression, the declared types of its references, an environment and the expected outcome: {value}, or {error} with one of the kinds overflow (a result or operand outside its integer type), division-by-zero, absent (a value that is not an option is missing; generated code refuses it when decoding) and refused (generated code refuses the expression when compiling it; the simulator ends the step). Types are specification type names; point is a struct {x: i64, y: i64}. A path missing from env is absent. Exegra runs the table on its evaluator and its Lean core (tests/core/expr-cases.test.js); Strata runs a byte-identical copy on the generated Rust and JavaScript (crates/spec-expr-cases/cases.json). The two copies must stay identical.",
  "cases": [
    { "name": "u32 subtraction below zero", "expr": "n - 1", "types": { "n": "u32" }, "env": { "n": 0 }, "expect": { "error": "overflow" } },
    { "name": "u32 subtraction to zero", "expr": "n - 1", "types": { "n": "u32" }, "env": { "n": 1 }, "expect": { "value": 0 } },
    { "name": "u8 addition past its maximum", "expr": "n + 1", "types": { "n": "u8" }, "env": { "n": 255 }, "expect": { "error": "overflow" } },
    { "name": "u8 addition to its maximum", "expr": "n + 1", "types": { "n": "u8" }, "env": { "n": 254 }, "expect": { "value": 255 } },
    { "name": "u16 addition past its maximum", "expr": "n + 1", "types": { "n": "u16" }, "env": { "n": 65535 }, "expect": { "error": "overflow" } },
    { "name": "u32 addition past its maximum", "expr": "n + 1", "types": { "n": "u32" }, "env": { "n": 4294967295 }, "expect": { "error": "overflow" } },
    { "name": "u64 addition to 2^53 - 1", "expr": "n + 1", "types": { "n": "u64" }, "env": { "n": 9007199254740990 }, "expect": { "value": 9007199254740991 } },
    { "name": "u64 addition past 2^53 - 1", "expr": "n + 1", "types": { "n": "u64" }, "env": { "n": 9007199254740991 }, "expect": { "error": "overflow" } },
    { "name": "i64 multiplication to 2^53", "expr": "n * 2", "types": { "n": "i64" }, "env": { "n": 4503599627370496 }, "expect": { "error": "overflow" } },
    { "name": "i64 multiplication of a negative", "expr": "n * 2", "types": { "n": "i64" }, "env": { "n": -4503599627370495 }, "expect": { "value": -9007199254740990 } },
    { "name": "i64 subtraction below -(2^53 - 1)", "expr": "n - 1", "types": { "n": "i64" }, "env": { "n": -9007199254740991 }, "expect": { "error": "overflow" } },
    { "name": "i32 addition past its maximum", "expr": "n + 1", "types": { "n": "i32" }, "env": { "n": 2147483647 }, "expect": { "error": "overflow" } },
    { "name": "i32 subtraction past its minimum", "expr": "n - 1", "types": { "n": "i32" }, "env": { "n": -2147483648 }, "expect": { "error": "overflow" } },
    { "name": "i32 negation of its minimum", "expr": "-n", "types": { "n": "i32" }, "env": { "n": -2147483648 }, "expect": { "error": "overflow" } },
    { "name": "i64 negation", "expr": "-n", "types": { "n": "i64" }, "env": { "n": 5 }, "expect": { "value": -5 } },
    { "name": "u32 product past its maximum", "expr": "n * m", "types": { "n": "u32", "m": "u32" }, "env": { "n": 65536, "m": 65536 }, "expect": { "error": "overflow" } },
    { "name": "i32 product below its minimum", "expr": "n * m", "types": { "n": "i32", "m": "i32" }, "env": { "n": -46341, "m": 46341 }, "expect": { "error": "overflow" } },
    { "name": "unsigned subtraction inside a comparison", "expr": "n - m < 1", "types": { "n": "u32", "m": "u32" }, "env": { "n": 3, "m": 5 }, "expect": { "error": "overflow" } },
    { "name": "integer division truncates", "expr": "n / m", "types": { "n": "i32", "m": "i32" }, "env": { "n": 7, "m": 2 }, "expect": { "value": 3 } },
    { "name": "integer division of a negative dividend truncates toward zero", "expr": "n / m", "types": { "n": "i32", "m": "i32" }, "env": { "n": -7, "m": 2 }, "expect": { "value": -3 } },
    { "name": "integer division by a negative divisor truncates toward zero", "expr": "n / m", "types": { "n": "i32", "m": "i32" }, "env": { "n": 7, "m": -2 }, "expect": { "value": -3 } },
    { "name": "integer division by a literal", "expr": "n / 2", "types": { "n": "i64" }, "env": { "n": -9 }, "expect": { "value": -4 } },
    { "name": "remainder takes the sign of the dividend (negative)", "expr": "n % m", "types": { "n": "i32", "m": "i32" }, "env": { "n": -7, "m": 2 }, "expect": { "value": -1 } },
    { "name": "remainder takes the sign of the dividend (positive)", "expr": "n % m", "types": { "n": "i32", "m": "i32" }, "env": { "n": 7, "m": -2 }, "expect": { "value": 1 } },
    { "name": "integer division by zero", "expr": "n / m", "types": { "n": "u32", "m": "u32" }, "env": { "n": 7, "m": 0 }, "expect": { "error": "division-by-zero" } },
    { "name": "integer remainder by zero", "expr": "n % m", "types": { "n": "u32", "m": "u32" }, "env": { "n": 7, "m": 0 }, "expect": { "error": "division-by-zero" } },
    { "name": "i32 minimum divided by -1", "expr": "n / m", "types": { "n": "i32", "m": "i32" }, "env": { "n": -2147483648, "m": -1 }, "expect": { "error": "overflow" } },
    { "name": "i32 minimum remainder -1", "expr": "n % m", "types": { "n": "i32", "m": "i32" }, "env": { "n": -2147483648, "m": -1 }, "expect": { "value": 0 } },
    { "name": "u64 division at 2^53 - 1", "expr": "n / m", "types": { "n": "u64", "m": "u64" }, "env": { "n": 9007199254740991, "m": 2 }, "expect": { "value": 4503599627370495 } },
    { "name": "f64 division is exact", "expr": "x / y", "types": { "x": "f64", "y": "f64" }, "env": { "x": 7, "y": 2 }, "expect": { "value": 3.5 } },
    { "name": "f64 remainder", "expr": "x % y", "types": { "x": "f64", "y": "f64" }, "env": { "x": 7.5, "y": 2 }, "expect": { "value": 1.5 } },
    { "name": "a fractional literal with an integer", "expr": "n + 0.5", "types": { "n": "u32" }, "env": { "n": 1 }, "expect": { "error": "refused" } },
    { "name": "string concatenation", "expr": "s + t", "types": { "s": "string", "t": "string" }, "env": { "s": "a", "t": "b" }, "expect": { "value": "ab" } },
    { "name": "equal lists", "expr": "a == b", "types": { "a": "list<u32>", "b": "list<u32>" }, "env": { "a": [1, 2], "b": [1, 2] }, "expect": { "value": true } },
    { "name": "lists in another order", "expr": "a == b", "types": { "a": "list<u32>", "b": "list<u32>" }, "env": { "a": [1, 2], "b": [2, 1] }, "expect": { "value": false } },
    { "name": "empty lists", "expr": "a != b", "types": { "a": "list<u32>", "b": "list<u32>" }, "env": { "a": [], "b": [] }, "expect": { "value": false } },
    { "name": "equal structs", "expr": "p == q", "types": { "p": "point", "q": "point" }, "env": { "p": { "x": 1, "y": 2 }, "q": { "x": 1, "y": 2 } }, "expect": { "value": true } },
    { "name": "structs that differ in one field", "expr": "p == q", "types": { "p": "point", "q": "point" }, "env": { "p": { "x": 1, "y": 2 }, "q": { "x": 1, "y": 3 } }, "expect": { "value": false } },
    { "name": "json objects in another key order, 1 and 1.0", "expr": "j == k", "types": { "j": "json", "k": "json" }, "env": { "j": { "a": 1, "b": [1, { "c": true }] }, "k": { "b": [1.0, { "c": true }], "a": 1.0 } }, "expect": { "value": true } },
    { "name": "json 1 and 1.0", "expr": "j == k", "types": { "j": "json", "k": "json" }, "env": { "j": 1, "k": 1.0 }, "expect": { "value": true } },
    { "name": "json arrays of different length", "expr": "j == k", "types": { "j": "json", "k": "json" }, "env": { "j": [1, 2], "k": [1, 2, 3] }, "expect": { "value": false } },
    { "name": "json null", "expr": "j == null", "types": { "j": "json" }, "env": { "j": null }, "expect": { "value": true } },
    { "name": "an absent option reads as null", "expr": "x == null", "types": { "x": "option<u32>" }, "env": {}, "expect": { "value": true } },
    { "name": "a present option is not null", "expr": "x != null", "types": { "x": "option<u32>" }, "env": { "x": 3 }, "expect": { "value": true } },
    { "name": "an absent option payload field reads as null", "expr": "event.s == null", "types": { "event.s": "option<string>" }, "env": {}, "expect": { "value": true } },
    { "name": "an absent integer payload field", "expr": "event.n + 1", "types": { "event.n": "u32" }, "env": {}, "expect": { "error": "absent" } },
    { "name": "an absent boolean variable", "expr": "flag", "types": { "flag": "bool" }, "env": {}, "expect": { "error": "absent" } },
    { "name": "time difference", "expr": "time - checkedAt", "types": { "time": "timestamp", "checkedAt": "timestamp" }, "env": { "time": 10000, "checkedAt": 4000 }, "expect": { "value": 6000 } },
    { "name": "a time difference with a value set ahead is negative", "expr": "time - checkedAt", "types": { "time": "timestamp", "checkedAt": "timestamp" }, "env": { "time": 10000, "checkedAt": 12000 }, "expect": { "value": -2000 } },
    { "name": "an unguarded freshness test reads a value set ahead as fresh", "expr": "time - checkedAt < 5000", "types": { "time": "timestamp", "checkedAt": "timestamp" }, "env": { "time": 10000, "checkedAt": 12000 }, "expect": { "value": true } },
    { "name": "the guarded freshness test does not", "expr": "checkedAt <= time && time - checkedAt < 5000", "types": { "time": "timestamp", "checkedAt": "timestamp" }, "env": { "time": 10000, "checkedAt": 12000 }, "expect": { "value": false } },
    { "name": "the guarded freshness test within the bound", "expr": "checkedAt <= time && time - checkedAt < 5000", "types": { "time": "timestamp", "checkedAt": "timestamp" }, "env": { "time": 10000, "checkedAt": 6000 }, "expect": { "value": true } }
  ]
}
