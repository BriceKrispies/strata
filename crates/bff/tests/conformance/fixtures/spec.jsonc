// The fixtures of the contract conformance suite (WG-5182). The checks the generated suite makes
// are shown to fail: every contract named violates-<rule> is served by a stand-in handler that
// breaks exactly that rule, and its generated test must fail with [<rule>]; the conforms-* contracts
// are served correctly and must pass, which shows the harness itself is right. The stand-in is
// crates/bff/tests/contract_conformance_fixtures.rs.
//
//   specc conformance --spec crates/bff/tests/conformance/fixtures/spec.jsonc --out crates/bff/tests/conformance/fixtures/generated --expect-fail-prefix violates-
//   cargo test -p strata-bff --test contract_conformance_fixtures
//
// Only specc reads this file; it is not an Exegra project.
{
  "system": {
    "id": "conformance-fixtures",
    "name": "Conformance fixtures",
    "generation": {
      "wireCase": "snake_case",
      "errorKinds": {
        "unauthenticated": 401,
        "forbidden": 403,
        "not_found": 404,
        "conflict": 409,
        "invalid": 422,
        "throttled": 429,
        "unavailable": 503,
        "internal": 500
      },
      "errorBody": {
        "type": "api-error",
        "code": "code",
        "message": "message",
        "correlation": "correlation",
        "runtime": {
          "unauthenticated": "unauthenticated",
          "forbidden": "forbidden",
          "invalid-request": "invalid",
          "timeout": "unavailable",
          "unavailable": "unavailable",
          "internal": "internal"
        }
      }
    }
  },
  "types": [
    {
      "id": "error-code",
      "name": "Error Code",
      "kind": "enum",
      "values": [
        "unauthenticated",
        "forbidden",
        "not_found",
        "conflict",
        "invalid",
        "throttled",
        "unavailable",
        "internal"
      ],
      "description": "strata_protocol::api::ErrorCode, as it is written on the wire (snake_case); each has one HTTP status, the one system.generation.errorKinds gives the error kind of the same name."
    },
    {
      "id": "api-error",
      "name": "Api Error",
      "kind": "struct",
      "fields": [
        {
          "name": "code",
          "type": "error-code"
        },
        {
          "name": "message",
          "type": "string"
        },
        {
          "name": "kind",
          "type": "string",
          "optional": true
        },
        {
          "name": "failed",
          "type": "list<check>",
          "optional": true
        },
        {
          "name": "correlation",
          "type": "string"
        }
      ],
      "description": "strata_protocol::api::ErrorReply: the error body of every HTTP operation (system.generation.errorBody). kind and failed are left out when absent, and the correlation is the request's correlation id as given."
    },
    {
      "id": "tenant-id",
      "kind": "id",
      "repr": "string",
      "name": "Tenant Id"
    },
    {
      "id": "note-id",
      "kind": "id",
      "repr": "u64",
      "name": "Note Id"
    },
    {
      "id": "note",
      "kind": "struct",
      "fields": [
        {
          "name": "title",
          "type": "string"
        },
        {
          "name": "word-count",
          "type": "u32"
        },
        {
          "name": "tags",
          "type": "list<string>",
          "optional": true
        }
      ],
      "name": "Note"
    },
    {
      "id": "check",
      "name": "Check",
      "kind": "struct",
      "fields": [
        {
          "name": "rule",
          "type": "string"
        },
        {
          "name": "passed",
          "type": "bool"
        },
        {
          "name": "detail",
          "type": "string"
        }
      ],
      "description": "strata_kernel::Check: one evaluated rule."
    }
  ],
  "roles": [
    {
      "id": "visitor",
      "capabilities": [
        "notes-browse"
      ],
      "level": "platform"
    },
    {
      "id": "account-holder",
      "capabilities": [
        "session-manage"
      ],
      "level": "platform"
    },
    {
      "id": "owner",
      "capabilities": [
        "notes-read",
        "notes-write",
        "notes-delete"
      ],
      "level": "tenant"
    },
    {
      "id": "writer",
      "capabilities": [
        "notes-read",
        "notes-write"
      ],
      "level": "tenant"
    },
    {
      "id": "reader",
      "capabilities": [
        "notes-read"
      ],
      "level": "tenant"
    }
  ],
  "quotas": [
    {
      "id": "q-ping",
      "contract": "conforms-ping",
      "scope": "source-address",
      "limit": 3,
      "window": "1 min",
      "onExceed": "refuse",
      "error": "throttled"
    },
    {
      "id": "q-unthrottled-ping",
      "contract": "violates-quota",
      "scope": "source-address",
      "limit": 3,
      "window": "1 min",
      "onExceed": "refuse",
      "error": "throttled"
    }
  ],
  "contracts": [
