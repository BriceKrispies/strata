        },
        {
          "name": "forbidden",
          "kind": "forbidden"
        },
        {
          "name": "not-found",
          "kind": "not_found"
        }
      ],
      "conformanceExample": "{\"note\": 1}",
      "name": "Conforms Read Note",
      "realisation": "hand",
      "implementedBy": "fixture-server",
