// The fixtures of the contract conformance suite (WG-5182). The checks the generated suite makes
// are shown to fail: every contract named violates-<rule> is served by a stand-in handler that
// breaks exactly that rule, and its generated test must fail with [<rule>]; the conforms-* contracts
// are served correctly and must pass, which shows the harness itself is right. The stand-in is
// crates/bff/tests/contract_conformance_fixtures.rs.
//
//   specc conformance --spec crates/bff/tests/conformance/fixtures/spec.jsonc --out crates/bff/tests/conformance/fixtures/generated --expect-fail-prefix violates-
//   cargo test -p strata-bff --test contract_conformance_fixtures
//
// Only specc reads this file; it is not an Exegra project.
{
  "system": {
    "id": "conformance-fixtures",
    "name": "Conformance fixtures",
    "generation": {
      "wireCase": "snake_case",
      "errorKinds": { "unauthenticated": 401, "forbidden": 403, "not_found": 404, "invalid": 422, "throttled": 429, "unavailable": 503 },
      "errorBody": { "type": "api-error" }
    }
  },
  "types": [
    { "id": "error-code", "kind": "enum", "values": ["unauthenticated", "forbidden", "not_found", "invalid", "throttled", "unavailable"] },
    {
      "id": "api-error", "kind": "struct",
      "fields": [
        { "name": "code", "type": "error-code" },
        { "name": "message", "type": "string" },
        { "name": "kind", "type": "string", "optional": true },
        { "name": "correlation", "type": "string" }
      ]
    },
    { "id": "tenant-id", "kind": "id", "repr": "string" },
    { "id": "note-id", "kind": "id", "repr": "u64" },
    {
      "id": "note", "kind": "struct",
      "fields": [
        { "name": "title", "type": "string" },
        { "name": "word-count", "type": "u32" },
        { "name": "tags", "type": "list<string>", "optional": true }
      ]
    }
  ],
  "roles": [
    { "id": "visitor", "capabilities": ["notes-browse"] },
    { "id": "account-holder", "capabilities": ["session-manage"] },
    { "id": "owner", "capabilities": ["notes-read", "notes-write", "notes-delete"] },
    { "id": "writer", "capabilities": ["notes-read", "notes-write"] },
    { "id": "reader", "capabilities": ["notes-read"] }
  ],
  "quotas": [
    { "id": "q-ping", "contract": "conforms-ping", "scope": "source-address", "limit": 3, "window": "1 min", "onExceed": "refuse", "error": "throttled" },
    { "id": "q-unthrottled-ping", "contract": "violates-quota", "scope": "source-address", "limit": 3, "window": "1 min", "onExceed": "refuse", "error": "throttled" }
  ],
  "contracts": [
    {
