/-
A benchmark of the kernels, as a library function the scenario runner calls (`--bench <n>`).

It generates a workload of `n` operations against the fixture tenant (creates with unique fields and
references, updates that change and clash on a unique field, deletes that are refused for a
restricting reference or clear a clearing one), then runs the same operations through three kernels
and prints operations per second for each:

* the spec (`Strata.stepTenant`): records in lists, every check a scan;
* stage 1 (`Strata.Impl.stepTenantI`): records in slots, the unique, composite and referrer checks
  still scans;
* stage 2 (`Strata.Impl.stepTenantX`): the same with the indexes.

The workload is generated by running the indexed kernel (so a delete names a record that exists, a
reference an id that was created), and is then replayed unchanged on the others. The kernels must end
with the same counts and the same checksum of the records; the benchmark says so, or fails.
-/

import Strata.Impl.XWorld

namespace Strata

open Impl

/-- The next pseudo-random number and seed. -/
def nextRand (seed : UInt64) : UInt64 × Nat :=
  let s := seed * 6364136223846793005 + 1442695040888963407
  (s, (s >>> 33).toNat)

/-- A uniformly chosen index of a non-empty array. -/
def pickIdx (r : Nat) (a : Array Nat) : Nat := r % a.size

/-- Remove the entry at `idx` by moving the last entry into its place. -/
def swapRemove (a : Array Nat) (idx : Nat) : Array Nat :=
  let last := a.back!
  let a' := a.pop
  if idx < a'.size then a'.set! idx last else a'

/-- The `k`-th operation of the workload, given the seed and the live ids of each type; the new seed,
    the operation, and for a delete the type and the index in the live ids it names. -/
def genOp (seed : UInt64) (items parts : Array Nat) (k : Nat) : UInt64 × Intent × Option (Nat × Nat) :=
  let (seed, r0) := nextRand seed
  let (seed, r1) := nextRand seed
  let (seed, r2) := nextRand seed
  let kind := r0 % 100
  let itemRef := if items.isEmpty then Val.null else Val.ref items[pickIdx r1 items]!
  let itemRef2 := if items.isEmpty then Val.null else Val.ref items[pickIdx r2 items]!
  if kind < 35 then
    let fs : Fields := [(1, .str s!"n{k}"), (10, .str s!"u{k}"), (2, .int k)] ++
      (if r1 % 3 == 0 then [(4, itemRef)] else []) ++
      (if r1 % 7 == 0 then [(5, itemRef2)] else []) ++
      (if r2 % 5 == 0 && !items.isEmpty then [(8, .list [.ref items[pickIdx r1 items]!])] else [])
    (seed, .create 1 fs, none)
  else if kind < 50 then
    (seed, .create 2 ([(4, .int k)] ++ (if r1 % 2 == 0 then [(1, itemRef)] else [(2, itemRef)])), none)
  else if kind < 70 then
    if items.isEmpty then (seed, .create 1 [(1, .str s!"n{k}")], none)
    else
      let id := items[pickIdx r1 items]!
      let fs : Fields := [(2, .int k)] ++ (if r2 % 2 == 0 then [(10, .str s!"u{k}x")] else [])
      (seed, .update 1 id fs none, none)
  else if kind < 80 then
    if items.isEmpty then (seed, .create 1 [(1, .str s!"n{k}")], none)
    else
      let id := items[pickIdx r1 items]!
      -- a unique value some record may already hold
      (seed, .update 1 id [(10, .str s!"u{r2 % (k + 1)}")] none, none)
  else if r1 % 3 == 0 && !parts.isEmpty then
    let idx := pickIdx r2 parts
    (seed, .delete 2 parts[idx]! none, some (2, idx))
  else if !items.isEmpty then
    let idx := pickIdx r2 items
    (seed, .delete 1 items[idx]! none, some (1, idx))
  else (seed, .create 1 [(1, .str s!"n{k}")], none)

/-- Generate `n` operations by running them through the indexed kernel. -/
def genWorkload (n : Nat) : Array Intent := Id.run do
  let mut seed : UInt64 := 12345
  let mut items : Array Nat := #[]
  let mut parts : Array Nat := #[]
  let mut x : XTenant := XTenant.ofCore (ITenant.ofEmpty (initialTenant 1))
  let mut ops : Array Intent := Array.mkEmpty n
  for k in [0:n] do
    let (seed', op, del) := genOp seed items parts k
    seed := seed'
    ops := ops.push op
    let id := x.core.nextId
    match stepTenantXL x (.user 100) op with
    | .error (_, x') => x := x'
    | .ok x' =>
      x := x'
      match op, del with
      | .create 1 _, _ => items := items.push id
      | .create 2 _, _ => parts := parts.push id
      | .delete 1 _ _, some (_, idx) => items := swapRemove items idx
      | .delete 2 _ _, some (_, idx) => parts := swapRemove parts idx
      | _, _ => pure ()
  return ops

/-- A number summarising the records of a tenant: the sum over records of a function of id,
    version, owner and field count and size, so it does not depend on the order. -/
def recSum (q : RecordId × Record) : Nat :=
  (q.1 * 7919 + q.2.version * 31 + q.2.fields.length * 17 + q.2.size + (q.2.owner.getD 0)) % 1000000007

def checksum (t : Tenant) : Nat :=
  t.types.foldl (fun acc e => (acc + e.1 + e.2.records.foldl (fun a q => a + recSum q) 0) % 1000000007)
    t.nextId

/-- The sum of `recSum` over the records in slots. -/
def slotSum (a : Array (Option Record)) : Nat :=
  (a.foldl (fun (p : Nat × Nat) o => match o with
    | some r => (p.1 + recSum (p.2, r), p.2 + 1)
    | none => (p.1, p.2 + 1)) (0, 0)).1

/-- The same number for a tenant in slots (linear in the slots). -/
def checksumX (t : ITenant) : Nat :=
  t.types.foldl (fun acc e => (acc + e.1 + slotSum e.2.slots) % 1000000007) t.nextId

/-- Run the operations through a kernel; the final state and the number of accepted operations. -/
def runKernel {T : Type} (step : T → Intent → Except Err T) (init : T) (ops : Array Intent) :
    T × Nat := Id.run do
  let mut t := init
  let mut ok := 0
  for op in ops do
    match step t op with
    | .ok t' => t := t'; ok := ok + 1
    | .error _ => pure ()
  return (t, ok)

def opsPerSec (n ms : Nat) : String :=
  if ms == 0 then "inf" else toString (n * 1000 / ms)

/-- The indexed kernel through its linear interface, which hands the tenant back on a refusal. -/
def runIndexed (init : XTenant) (ops : Array Intent) : XTenant × Nat := Id.run do
  let mut t := init
  let mut ok := 0
  for op in ops do
    match stepTenantXL t (.user 100) op with
    | .ok t' => t := t'; ok := ok + 1
    | .error (_, t') => t := t'
  return (t, ok)

/-- Time one kernel, print the line, and return its accepted count and the checksum of its end
    state. -/
def timeKernel {T : Type} (name : String) (step : T → Intent → Except Err T) (init : T)
    (sum : T → Nat) (ops : Array Intent) : IO (Nat × Nat) := do
  let t0 ← IO.monoMsNow
  let (t, ok) := runKernel step init ops
  let cs := sum t
  let t1 ← IO.monoMsNow
  IO.println s!"{name}: {ops.size} ops in {t1 - t0} ms, {opsPerSec ops.size (t1 - t0)} ops/s, {ok} accepted, checksum {cs}"
  return (ok, cs)

/-- The benchmark: `n` operations through the spec (when `n ≤ specMax`), stage 1 (when
    `n ≤ stage1Max`) and the indexed kernel. -/
def bench (n specMax stage1Max : Nat) : IO Bool := do
  let g0 ← IO.monoMsNow
  let ops := genWorkload n
  let g1 ← IO.monoMsNow
  IO.println s!"workload: {ops.size} operations generated in {g1 - g0} ms"
  let spec := initialTenant 1
  let t0 ← IO.monoMsNow
  let (tx, okx) := runIndexed (XTenant.ofCore (ITenant.ofEmpty spec)) ops
  let t1 ← IO.monoMsNow
  let csx := checksumX tx.core
  IO.println s!"indexed (stage 2): {ops.size} ops in {t1 - t0} ms, {opsPerSec ops.size (t1 - t0)} ops/s, {okx} accepted, checksum {csx}"
  let r1 := (okx, csx)
  let mut good := true
  if n ≤ stage1Max then
    let r2 ← timeKernel "slots   (stage 1)" (fun t op => stepTenantI t (.user 100) op)
      (ITenant.ofEmpty spec) checksumX ops
    if r2 != r1 then
      IO.println "MISMATCH: stage 1 and the indexed kernel end differently"
      good := false
  else
    IO.println s!"slots   (stage 1): skipped (n > {stage1Max})"
  if n ≤ specMax then
    let r3 ← timeKernel "spec            " (fun t op => stepTenant t (.user 100) op) spec checksum ops
    if r3 != r1 then
      IO.println "MISMATCH: the spec and the indexed kernel end differently"
      good := false
  else
    IO.println s!"spec            : skipped (n > {specMax})"
  return good

end Strata
