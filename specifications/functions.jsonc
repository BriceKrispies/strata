    {
      "id": "role-permissions-with",
      "description": "TenantSchemaExt::set_role_permissions: the table of permissions with those of one role replaced; none removes the role's entry, and a table left empty is none, as the genesis schema holds it.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "role",
          "type": "role-id"
        },
        {
          "name": "permissions",
          "type": "list<permission>"
        }
      ],
      "returns": "option<map<role-id, list<permission>>>",
      "let": [
        {
          "name": "table",
          "expr": "match schema.role-permissions { Some(t) => t, None => {} }"
        },
        {
          "name": "next",
          "expr": "if permissions == [] then remove(table, role) else insert(table, role, permissions)"
        }
      ],
      "body": "if keys(next) == [] then null else next",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-8"
            },
            "role": "editor",
            "permissions": [
              {
                "object": {
                  "object": "note",
                  "actions": [
                    "read",
                    "update"
                  ]
                }
              },
              {
                "capability": "content-write"
              }
            ]
          },
          "result": {
            "editor": [
              {
                "object": {
                  "object": "note",
                  "actions": [
                    "read",
                    "update"
                  ]
                }
              },
              {
                "capability": "content-write"
              }
            ]
          }
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-20"
            },
            "role": "writer",
            "permissions": []
          },
          "result": {
            "editor": [
              {
                "object": {
                  "object": "note",
                  "actions": [
                    "read",
                    "update"
                  ]
                }
              },
              {
                "capability": "content-write"
              }
            ]
          }
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-8",
              "with": {
                "role-permissions": {
                  "writer": [
                    {
                      "object": {
                        "object": "note",
                        "actions": [
                          "read"
                        ]
                      }
                    }
                  ]
                }
              }
            },
            "role": "writer",
            "permissions": []
          },
          "result": null
        }
      ]
    },
    {
      "id": "revoke-invitation",
      "description": "transition.rs revoke_invitation (ADM-1083): a person withdraws an invitation that was not redeemed. Authorised as Manage on Members; the invitation must exist, be unredeemed and unrevoked, and offer only roles the person may confer (require-conferrable). The invitation stays in the schema, marked with who revoked it, and is never redeemable again.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "invitation",
          "type": "invitation-id"
        }
      ],
      "returns": "decided",
      "errors": "rejection",
      "let": [
        {
          "name": "d1",
          "expr": "try call require(d, action.manage, resource.members, subject{})"
        }
      ],
      "body": "match d1.ctx.principal { user(actor) => match get(call invitations-of(d1.tenant.schema), invitation) { None => fail(call draft-reject(d1.evidence, error-kind.invalid-intent, format('no invitation {}', invitation))), Some(offer) => match offer.redeemed-by { Some(by) => fail(call draft-reject(d1.evidence, error-kind.invalid-intent, 'the invitation was already redeemed')), None => match offer.revoked-by { Some(by) => fail(call draft-reject(d1.evidence, error-kind.invalid-intent, 'the invitation was already revoked')), None => let d2 = try call require-conferrable(d1, offer.roles) in decided{draft: draft{tenant: d2.tenant, ctx: d2.ctx, coverage: d2.coverage, ops: concat(d2.ops, [delta-op.put-schema(call schema-with-invitation(d2.tenant.schema, invitation-def{id: offer.id, address: offer.address, roles: offer.roles, created-by: offer.created-by, redeemed-by: offer.redeemed-by, expires-at: offer.expires-at, revoked-by: actor}))]), events: d2.events, effects: d2.effects, evidence: d2.evidence, next-record: d2.next-record}, output: output.member} } } }, _ => fail(call draft-reject(d1.evidence, error-kind.invalid-intent, 'a person revokes an invitation')) }",
      "examples": [
        {
          "args": {
            "d": {
              "fixture": "fx-draft-20"
            },
            "invitation": "inv-1"
          },
          "result": {
            "draft": {
              "tenant": {
                "id": "alpha",
                "name": "alpha",
                "revision": 5,
                "next-record": 1,
                "event-seq": 5,
                "schema": {
                  "version": 2,
                  "objects": {},
                  "roles": {
                    "editor": {
                      "id": "editor",
                      "label": "Editor"
                    },
                    "owner": {
                      "id": "owner",
                      "label": "Owner"
                    },
                    "public": {
                      "id": "public",
                      "label": "Everyone"
                    },
                    "writer": {
                      "id": "writer",
                      "label": "Writer"
                    }
                  },
                  "policies": {},
                  "workflows": {},
                  "queries": {},
                  "views": {},
                  "invitations": {
                    "inv-1": {
                      "id": "inv-1",
                      "address": "guest@example.org",
                      "roles": [
                        "editor"
                      ],
                      "created-by": "alpha:owner",
                      "redeemed-by": null,
                      "expires-at": 1209605000
                    }
                  }
                },
                "members": {
                  "alpha:editor": [
                    "editor"
                  ],
                  "alpha:owner": [
                    "owner"
                  ],
                  "alpha:writer1": [
                    "writer"
                  ],
                  "alpha:writer2": [
                    "writer"
                  ]
                },
                "records": {}
              },
              "ctx": {
                "tenant": "alpha",
                "principal": {
                  "user": "alpha:owner"
                },
                "now": 5000,
                "correlation": "test-5000"
              },
              "coverage": "complete",
              "ops": [
                {
                  "put-schema": {
                    "version": 2,
                    "objects": {},
                    "roles": {
                      "editor": {
                        "id": "editor",
                        "label": "Editor"
                      },
                      "owner": {
                        "id": "owner",
                        "label": "Owner"
                      },
                      "public": {
                        "id": "public",
                        "label": "Everyone"
                      },
                      "writer": {
                        "id": "writer",
                        "label": "Writer"
                      }
                    },
                    "invitations": {
                      "inv-1": {
                        "id": "inv-1",
                        "address": "guest@example.org",
                        "roles": [
                          "editor"
                        ],
                        "created-by": "alpha:owner",
                        "expires-at": 1209605000,
                        "revoked-by": "alpha:owner"
                      }
                    },
                    "policies": {},
                    "workflows": {},
                    "queries": {},
                    "views": {}
                  }
                }
              ],
              "events": [],
              "effects": [],
              "evidence": [
                {
                  "rule": "policy:builtin_owner",
                  "passed": true,
                  "detail": "Manage on Members"
                },
                {
                  "rule": "permission:confer:editor",
                  "passed": true,
                  "detail": "role editor grants no permission"
                }
              ],
              "next-record": 1
            },
            "output": "member"
          },
          "description": "The owner revokes an invitation that was not redeemed."
        },
        {
          "args": {
            "d": {
              "fixture": "fx-draft-20"
            },
            "invitation": "inv-9"
          },
          "error": {
            "rejected": {
              "kind": "invalid-intent",
              "message": "no invitation inv-9",
