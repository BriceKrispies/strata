                    }
                  },
                  "policies": {
                    "editors_manage_notes": {
                      "id": "editors_manage_notes",
                      "role": "editor",
                      "resource": {
                        "object": "note"
                      },
                      "actions": [
                        "read",
                        "create",
                        "update",
