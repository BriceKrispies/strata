    {
      "id": "scoped-of",
      "description": "scoped.rs of: the scoped assignments of one principal, in the order they were made.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "id",
          "type": "principal-id"
        }
      ],
      "returns": "list<scoped-role>",
      "body": "filter(a in call scoped-roles-of(schema), a.principal == id)",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-6",
