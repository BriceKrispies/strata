    },
    {
      "id": "setting-capability-check",
      "description": "settings.rs write_setting: the acting principal holds the capability of a level (the owner holds every one): the check permission:capability:<name> passes with \"holds <name>\", or the write is Unauthorized \"a write at the <level> level needs the capability <name>\".",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "ctx",
          "type": "context"
        },
        {
          "name": "level",
          "type": "setting-level"
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "evidence",
          "type": "list<check>"
        }
      ],
      "returns": "list<check>",
      "errors": "rejection",
      "body": "if any(r in call roles-of(tenant, ctx.principal), r == 'owner') || any(g in call effective-permissions(tenant, ctx.principal), g == grant.capability(name)) then concat(evidence, [check{rule: format('permission:capability:{}', name), passed: true, detail: format('holds {}', name)}]) else fail(call setting-refusal(evidence, error-kind.unauthorized, format('permission:capability:{}', name), format('a write at the {} level needs the capability {}', level, name)))",
      "examples": [
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-35"
            },
            "ctx": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:owner"
              },
              "session": null,
              "now": 5000,
              "correlation": "test-5000"
            },
            "level": "team",
            "name": "setting-write-team",
            "evidence": []
          },
          "result": [
            {
              "rule": "permission:capability:setting-write-team",
              "passed": true,
              "detail": "holds setting-write-team"
            }
          ]
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-35"
            },
            "ctx": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:editor"
              },
              "session": null,
              "now": 5000,
              "correlation": "test-5000"
            },
            "level": "tenant",
            "name": "setting-write-tenant",
            "evidence": []
          },
          "result": [
            {
              "rule": "permission:capability:setting-write-tenant",
              "passed": true,
              "detail": "holds setting-write-tenant"
            }
          ]
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-35"
            },
            "ctx": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:editor"
              },
              "session": null,
              "now": 5000,
              "correlation": "test-5000"
            },
            "level": "team",
            "name": "setting-write-team",
            "evidence": []
          },
          "error": {
            "rejected": {
              "kind": "unauthorized",
              "message": "a write at the team level needs the capability setting-write-team",
              "evidence": [
                {
                  "rule": "permission:capability:setting-write-team",
                  "passed": false,
                  "detail": "a write at the team level needs the capability setting-write-team"
                }
              ],
              "missing": null
            }
          }
        }
      ]
    },
    {
      "id": "setting-definition-of",
      "description": "settings.rs write_setting: the definition of the setting, or UnknownObject \"no setting <id>\" with the failed check setting:is_defined after the checks that passed.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "setting",
          "type": "setting-id"
        },
        {
          "name": "evidence",
          "type": "list<check>"
        }
      ],
      "returns": "setting-def",
      "errors": "rejection",
      "body": "match get(call settings-of(tenant.schema), setting) { Some(def) => def, None => fail(call setting-refusal(evidence, error-kind.unknown-object, 'setting:is_defined', format('no setting {}', setting))) }",
      "examples": [
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-32"
            },
            "setting": "theme",
            "evidence": []
          },
          "result": {
            "id": "theme",
            "label": "theme",
            "type": "string",
            "default": {
              "str": "light"
            },
            "levels": [
              "tenant",
              "team",
              "person"
            ]
          }
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-32"
            },
            "setting": "nothing",
            "evidence": [
              {
                "rule": "x",
                "passed": true,
                "detail": "y"
              }
            ]
          },
          "error": {
            "rejected": {
              "kind": "unknown-object",
              "message": "no setting nothing",
              "evidence": [
                {
                  "rule": "x",
                  "passed": true,
                  "detail": "y"
                },
                {
                  "rule": "setting:is_defined",
                  "passed": false,
                  "detail": "no setting nothing"
                }
              ],
              "missing": null
            }
          }
        }
      ]
    },
    {
      "id": "setting-level-check",
      "description": "settings.rs write_setting: the level is open (setting-open) or the write is InvalidIntent \"setting <id> takes no override at the <level> level: a lock of the definition closes it\" when the definition allows the level and \"the definition does not allow it\" when it does not (setting:level_is_open).",
      "params": [
        {
          "name": "def",
          "type": "setting-def"
        },
        {
          "name": "setting",
          "type": "setting-id"
        },
        {
          "name": "level",
          "type": "setting-level"
        },
        {
          "name": "evidence",
          "type": "list<check>"
        }
      ],
      "returns": "list<check>",
      "errors": "rejection",
      "body": "if call setting-open(def, level) then concat(evidence, [check{rule: 'setting:level_is_open', passed: true, detail: format('{}', level)}]) else fail(call setting-refusal(evidence, error-kind.invalid-intent, 'setting:level_is_open', format('setting {} takes no override at the {} level: {}', setting, level, if any(l in def.levels, l == level) then 'a lock of the definition closes it' else 'the definition does not allow it')))",
      "examples": [
        {
          "args": {
            "def": {
              "id": "theme",
              "label": "theme",
              "type": "string",
              "default": {
                "str": "light"
              },
              "levels": [
                "tenant",
                "team",
                "person"
              ]
            },
            "setting": "theme",
            "level": "team",
            "evidence": []
          },
          "result": [
            {
              "rule": "setting:level_is_open",
              "passed": true,
              "detail": "team"
            }
          ]
        },
        {
          "args": {
            "def": {
              "id": "theme",
              "label": "theme",
              "type": "string",
              "default": {
                "str": "light"
              },
              "levels": [
                "tenant"
              ]
            },
            "setting": "theme",
            "level": "person",
            "evidence": []
          },
          "error": {
            "rejected": {
              "kind": "invalid-intent",
              "message": "setting theme takes no override at the person level: the definition does not allow it",
              "evidence": [
                {
                  "rule": "setting:level_is_open",
                  "passed": false,
                  "detail": "setting theme takes no override at the person level: the definition does not allow it"
                }
              ],
              "missing": null
            }
          }
        },
        {
          "args": {
            "def": {
              "id": "theme",
              "label": "theme",
              "type": "string",
              "default": {
                "str": "light"
              },
              "levels": [
                "tenant",
                "team",
                "person"
              ],
              "locked-by": "tenant"
            },
            "setting": "theme",
            "level": "team",
            "evidence": []
          },
          "error": {
            "rejected": {
              "kind": "invalid-intent",
              "message": "setting theme takes no override at the team level: a lock of the definition closes it",
              "evidence": [
                {
                  "rule": "setting:level_is_open",
                  "passed": false,
                  "detail": "setting theme takes no override at the team level: a lock of the definition closes it"
                }
              ],
              "missing": null
            }
          }
        }
      ]
    },
    {
      "id": "setting-subject",
      "description": "settings.rs write_setting: whose override is written: the tenant's at the tenant level, the caller's own at the person level (no other person's value can be named, SET-034), the named team's at the team level. A team that does not exist is InvalidIntent \"no team <id>\" (setting:team_exists); the team level without a team is setting:team_named; a team named at another level is setting:team_only_at_team_level.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "caller",
          "type": "principal-id"
        },
        {
          "name": "level",
          "type": "setting-level"
        },
        {
          "name": "team",
          "type": "option<team-id>"
        },
        {
          "name": "evidence",
          "type": "list<check>"
        }
      ],
      "returns": "string",
      "errors": "rejection",
      "body": "match level { tenant => match team { None => tenant.id, Some(_) => fail(call setting-refusal(evidence, error-kind.invalid-intent, 'setting:team_only_at_team_level', format('a write at the {} level names no team', level))) }, person => match team { None => caller, Some(_) => fail(call setting-refusal(evidence, error-kind.invalid-intent, 'setting:team_only_at_team_level', format('a write at the {} level names no team', level))) }, team => match team { Some(id) => if get(call teams-of(tenant.schema), id) == null then fail(call setting-refusal(evidence, error-kind.invalid-intent, 'setting:team_exists', format('no team {}', id))) else id, None => fail(call setting-refusal(evidence, error-kind.invalid-intent, 'setting:team_named', 'a write at the team level names the team')) }, platform => fail(call setting-refusal(evidence, error-kind.invalid-intent, 'setting:team_only_at_team_level', format('a write at the {} level names no team', level))) }",
      "examples": [
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-32"
            },
            "caller": "alpha:ed",
            "level": "tenant",
            "team": null,
            "evidence": []
          },
          "result": "alpha"
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-32"
            },
            "caller": "alpha:ed",
            "level": "person",
            "team": null,
            "evidence": []
          },
          "result": "alpha:ed"
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-32"
            },
            "caller": "alpha:ed",
            "level": "team",
            "team": "lab",
            "evidence": []
          },
          "result": "lab"
        },
        {
          "args": {
