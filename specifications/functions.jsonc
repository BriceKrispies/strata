    {
      "id": "redeem-invitation-intent",
      "description": "transition.rs redeem_invitation (ADM-153): the roles of an invitation go to the one signed-in person who redeems it with the address it names, once. The address is the one the shell verified for that person (context verified-address); the intent carries none, and a refusal for a wrong address does not say which address the invitation names. The roles it gives must not give the redeemer two duties kept apart (duty-made-by, ADM-1630). No policy is consulted for the redeemer: the invitation is the authority, and it stands only while it is unrevoked and unexpired (ADM-1082, ADM-1083) and its issuer still manages members and could confer every role it offers (ADM-1084).",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "invitation",
          "type": "invitation-id"
        }
      ],
      "returns": "decided",
      "errors": "rejection",
      "body": "match d.ctx.principal { user(redeemer) => match get(call invitations-of(d.tenant.schema), invitation) { None => fail(call draft-reject(d.evidence, error-kind.invalid-intent, format('no invitation {}', invitation))), Some(offer) => match d.ctx.verified-address { None => fail(call draft-reject(concat(d.evidence, [check{rule: 'invitation:address_matches', passed: false, detail: 'the redeemer has no verified address'}]), error-kind.unauthorized, 'the invitation needs a verified address')), Some(verified) => if call normalise-address(verified) != offer.address then fail(call draft-reject(concat(d.evidence, [check{rule: 'invitation:address_matches', passed: false, detail: \"the redeemer's verified address is not the address the invitation names\"}]), error-kind.unauthorized, 'the invitation names another address')) else let ev1 = concat(d.evidence, [check{rule: 'invitation:address_matches', passed: true, detail: 'the verified address is the one the invitation names'}]) in match offer.redeemed-by { Some(by) => fail(call draft-reject(concat(ev1, [check{rule: 'invitation:redeemed_once', passed: false, detail: format('already redeemed by {}', by)}]), error-kind.invalid-intent, 'the invitation was already redeemed')), None => let ev2 = concat(ev1, [check{rule: 'invitation:redeemed_once', passed: true, detail: 'not redeemed before'}]) in match offer.revoked-by { Some(by) => fail(call draft-reject(concat(ev2, [check{rule: 'invitation:not_revoked', passed: false, detail: format('revoked by {}', by)}]), error-kind.invalid-intent, 'the invitation was revoked')), None => let ev3 = concat(ev2, [check{rule: 'invitation:not_revoked', passed: true, detail: 'not revoked'}]) in let live = match offer.expires-at { Some(at) => d.ctx.now < at, None => false } in if !live then fail(call draft-reject(concat(ev3, [check{rule: 'invitation:not_expired', passed: false, detail: 'the invitation has expired'}]), error-kind.invalid-intent, 'the invitation has expired')) else let ev4 = concat(ev3, [check{rule: 'invitation:not_expired', passed: true, detail: 'not expired'}]) in let issuer = principal.user(offer.created-by) in if !(call authorize(d.tenant, d.tenant.schema, issuer, d.ctx.now, action.manage, resource.members, subject{})).allowed then fail(call draft-reject(concat(ev4, [check{rule: 'invitation:issuer_authority', passed: false, detail: 'the issuer may no longer manage members'}]), error-kind.unauthorized, \"the invitation's issuer no longer holds the authority to issue it\")) else match find(r in offer.roles, !(call may-confer(d.tenant, issuer, r)).passed) { Some(r) => fail(call draft-reject(concat(ev4, [call may-confer(d.tenant, issuer, r), check{rule: 'invitation:issuer_authority', passed: false, detail: format('the issuer may no longer confer {}', r)}]), error-kind.unauthorized, \"the invitation's issuer no longer holds the authority to issue it\")), None => let ev5 = concat(ev4, [check{rule: 'invitation:issuer_authority', passed: true, detail: 'the issuer still holds the authority to issue it'}]) in let roles = call set-of(concat(match get(d.tenant.members, redeemer) { Some(rs) => rs, None => [] }, offer.roles)) in let schema = call schema-with-invitation(d.tenant.schema, invitation-def{id: offer.id, address: offer.address, roles: offer.roles, created-by: offer.created-by, redeemed-by: redeemer, expires-at: offer.expires-at, revoked-by: offer.revoked-by}) in match call duty-made-by(d.tenant.members, d.tenant.schema, insert(d.tenant.members, redeemer, roles), schema) { Some(m) => fail(call draft-reject(ev5, error-kind.conflicting-roles, m)), None => decided{draft: draft{tenant: d.tenant, ctx: d.ctx, coverage: d.coverage, ops: concat(d.ops, [delta-op.put-schema(schema), delta-op.put-member{principal: redeemer, roles}]), events: concat(d.events, [event-body.member-changed{principal: redeemer, roles: call assigned-roles(insert(d.tenant.members, redeemer, roles), schema, redeemer)}]), effects: d.effects, evidence: ev5, next-record: d.next-record}, output: output.member} } } } } } }, _ => fail(call draft-reject(concat(d.evidence, [check{rule: 'invitation:redeemer_is_person', passed: false, detail: 'only a signed-in person redeems an invitation'}]), error-kind.unauthorized, 'only a signed-in person redeems an invitation')) }",
      "examples": [
