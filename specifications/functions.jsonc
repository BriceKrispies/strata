      "returns": "tenant-schema",
      "body": "tenant-schema{version: schema.version, settings: schema.settings, capabilities: schema.capabilities, ledger: schema.ledger, triggers: schema.triggers, automations: schema.automations, operations: schema.operations, objects: schema.objects, roles: schema.roles, role-permissions: schema.role-permissions, teams: insert(call teams-of(schema), team.id, team), invitations: schema.invitations, policies: schema.policies, workflows: schema.workflows, queries: schema.queries, views: schema.views, mail-templates: schema.mail-templates, notice-templates: schema.notice-templates, tokens: schema.tokens, products: schema.products, hold-rules: schema.hold-rules, holds: schema.holds, ui: schema.ui, scoped-roles: schema.scoped-roles, separations: schema.separations}",      "examples": [
