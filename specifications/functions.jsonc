              "with": {
                "coverage.partial": [
                  {
                    "record": {
                      "object": "person",
                      "id": 1
                    }
                  }
                ]
              }
            },
            "times": {}
          },
          "error": {
            "insufficient-state": {
              "by-field": {
                "object": "post",
                "field": "author",
                "value": {
                  "ref": 1
                }
              }
            }
          }
        }
      ]
    },
    {
      "id": "execute-read-decide",
      "description": "crates/storage-api/src/lib.rs query, the decide of contract execute-read (CT-032): the needs read-needs names for the snapshot's schema (none without a tenant) are asked for first, then the kernel answers (kernel-read); a rejection is the contract's domain error.",
      "params": [
        {
          "name": "state",
          "type": "state"
        },
        {
          "name": "request",
          "type": "read-request"
        },
        {
          "name": "context",
          "type": "context"
        }
      ],
      "returns": "read-result",
      "errors": "execute-failure",
      "body": "match call first-missing(state.coverage, match state.tenant { Some(t) => call read-needs(t.schema, request), None => [] }) { Some(n) => fail(execute-failure.insufficient-state(n)), None => match call kernel-read(state, request, context) { Ok(r) => r, Err(e) => match e { rejected(d) => match d.missing { Some(n) => if d.kind == error-kind.insufficient-state then fail(execute-failure.insufficient-state(n)) else fail(execute-failure.domain(d)), None => fail(execute-failure.domain(d)) } } } }",
      "examples": [
        {
          "args": {
            "state": {
              "fixture": "fx-state-8"
            },
            "request": {
              "named": {
                "query": "published",
                "params": {}
              }
            },
