      "errors": "rejection",
      "let": [
        {
          "name": "d1",
          "expr": "try call require(d, action.manage, resource.members, subject{})"
        },
        {
          "name": "def0",
          "expr": "try call team-of(d1, team)"
        }
      ],
      "body": "if get(d1.tenant.schema.roles, role) == null then fail(call draft-reject(d1.evidence, error-kind.unknown-role, format('no role {}', role))) else if role == 'public' then fail(call draft-reject(d1.evidence, error-kind.invalid-intent, 'everyone already holds public')) else let d2 = try call require-conferrable(d1, [role]) in let def = team-def{id: def0.id, label: def0.label, members: def0.members, roles: if grant then call set-of(concat(def0.roles, [role])) else filter(r in def0.roles, r != role)} in let after = call schema-with-team(d2.tenant.schema, def) in let lost = if grant then [] else filter(m in def.members, (match get(d2.tenant.members, m) { Some(rs) => rs == [], None => true }) && call assigned-roles({}, after, m) == []) in if !grant && call owner-lost(d2.tenant.members, d2.tenant.schema, d2.tenant.members, after) then fail(call draft-reject(d2.evidence, error-kind.last-owner, 'a tenant keeps at least one owner')) else match (if grant then call duty-made-by(d2.tenant.members, d2.tenant.schema, d2.tenant.members, after) else null) { Some(m) => fail(call draft-reject(d2.evidence, error-kind.conflicting-roles, m)), None => decided{draft: call put-team(draft{tenant: d2.tenant, ctx: d2.ctx, coverage: d2.coverage, ops: d2.ops, events: d2.events, effects: concat(d2.effects, map(p in lost, effect.revoke-sessions{principal: p})), evidence: d2.evidence, next-record: d2.next-record}, d2.tenant.schema, def), output: output.member} }",
