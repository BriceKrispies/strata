                                "scope": "new",
                                "field": "title"
                              }
                            }
                          },
                          "right": {
                            "lit": {
                              "int": 24
                            }
                          }
                        }
                      },
                      "message": "A title has at most 24 characters"
                    }
                  }
                },
                "person": {
                  "id": "person",
                  "label": "Person",
                  "fields": {
                    "name": {
                      "id": "name",
                      "label": "name",
                      "ty": "str",
                      "required": true,
                      "unique": false
                    }
                  },
                  "constraints": {}
                }
              },
              "roles": {
                "editor": {
                  "id": "editor",
                  "label": "Editor"
                },
                "owner": {
                  "id": "owner",
                  "label": "Owner"
                },
                "public": {
                  "id": "public",
                  "label": "Everyone"
                },
                "writer": {
                  "id": "writer",
                  "label": "Writer"
                }
              },
              "policies": {
                "editors_manage_notes": {
                  "id": "editors_manage_notes",
                  "role": "editor",
                  "resource": {
                    "object": "note"
                  },
                  "actions": [
                    "read",
                    "create",
                    "update",
                    "delete"
                  ],
                  "condition": null
                },
                "editors_manage_people": {
                  "id": "editors_manage_people",
                  "role": "editor",
                  "resource": {
                    "object": "person"
                  },
                  "actions": [
                    "read",
                    "create",
                    "update",
                    "delete"
                  ],
                  "condition": null
                },
                "public_reads_people": {
                  "id": "public_reads_people",
                  "role": "public",
                  "resource": {
                    "object": "person"
                  },
                  "actions": [
                    "read"
                  ],
                  "condition": null
                },
                "public_reads_published": {
                  "id": "public_reads_published",
                  "role": "public",
                  "resource": {
                    "object": "note"
                  },
                  "actions": [
                    "read"
                  ],
                  "condition": {
                    "cmp": {
                      "op": "eq",
                      "left": {
                        "var": {
                          "scope": "record",
                          "field": "status"
                        }
                      },
                      "right": {
