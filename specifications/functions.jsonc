              "workflows": {},
              "queries": {},
              "views": {}
            },
            "after-members": {
              "alpha:owner": [],
              "alpha:second": [
                "owner"
              ]
            },
            "after-schema": {
              "version": 1,
              "objects": {},
              "roles": {},
              "policies": {},
              "workflows": {},
              "queries": {},
              "views": {}
            }
          },
          "result": false
        },
        {
          "description": "An owner through a team counts: the direct owner may lose owner while the team holds it.",
          "args": {
            "before-members": {
              "alpha:owner": [
                "owner"
              ]
            },
            "before-schema": {
              "version": 1,
              "objects": {},
              "roles": {},
              "policies": {},
              "workflows": {},
              "queries": {},
              "views": {},
              "teams": {
                "desk": {
                  "id": "desk",
                  "label": "Desk",
                  "members": [
                    "alpha:guest"
                  ],
                  "roles": [
                    "owner"
                  ]
                }
              }
            },
            "after-members": {
              "alpha:owner": []
            },
            "after-schema": {
              "version": 1,
              "objects": {},
              "roles": {},
              "policies": {},
              "workflows": {},
              "queries": {},
              "views": {},
              "teams": {
                "desk": {
                  "id": "desk",
                  "label": "Desk",
                  "members": [
                    "alpha:guest"
                  ],
