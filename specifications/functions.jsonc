        },
        {
          "description": "The limits of single accounts are not in the snapshot: the change needs them.",
          "args": {
            "d": {
              "fixture": "fx-draft-28",
              "with": {
                "coverage": {
                  "partial": []
                }
              }
            },
            "w": {
              "evidence": []
            },
            "c": {
              "set-ledger-limit": {
                "unit": "credits",
                "owner": {
                  "principal": {
                    "principal": "alpha:ed"
                  }
                },
                "cap": 9
              }
            },
            "max": 3
          },
          "error": {
            "rejected": {
              "kind": "insufficient-state",
              "message": "the snapshot does not cover Ledger(Limits)",
              "evidence": [
                {
                  "rule": "coverage",
                  "passed": false,
                  "detail": "Ledger(Limits)"
                }
              ],
              "missing": {
                "ledger": "limits"
              }
            }
          }
        },
        {
          "description": "A limit of a new account past the ceiling is refused with too-many.",
          "args": {
            "d": {
              "fixture": "fx-draft-28"
            },
            "w": {
              "evidence": [],
              "held": [
                {
                  "unit": "credits",
                  "owner": {
                    "principal": {
                      "principal": "alpha:ed"
                    }
                  },
                  "scope": "promo",
                  "cap": 5
                }
              ]
            },
            "c": {
              "set-ledger-limit": {
                "unit": "credits",
