                "version": 1,
                "created-by": "user:ann",
                "created-at": 1800000000000,
                "updated-at": 1800000000000,
                "fields": {
                  "title": {
                    "str": "Hello"
                  }
                }
              },
              "new": {
                "id": 7,
                "object": "post",
                "version": 1,
                "created-by": "user:ann",
                "created-at": 1800000000000,
                "updated-at": 1800000000000,
