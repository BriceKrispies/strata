            },
            "times": {}
          },
          "error": {
            "refused": {
              "code": "not_found",
              "message": "no post 3",
              "kind": "UnknownRecord",
              "failed": [
                {
                  "rule": "intent:unknown_record",
                  "passed": false,
                  "detail": "no post 3"
                }
              ],
              "correlation": "c-1"
            }
          }
        },
        {
          "description": "The records that refer to a deleted record are needed too.",
          "args": {
