                    }
                  }
                },
                "unit": "points",
                "scope": {
                  "param": "note"
                },
                "amount": {
                  "lit": {
                    "int": 1
                  }
                },
                "reason": "r"
              }
            },
            "env": {
              "fields": {},
              "params": [
                "note"
              ],
              "roles": [
                "editor",
                "owner",
                "public"
              ]
            }
          },
          "result": [
            "operation o: step \"Count\" is not a name",
            "operation o.Count: owner: undeclared parameter who"
          ]
        },
        {
          "description": "A posting to the invoker without a scope.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-24"
            },
            "at": "operation o",
            "inputs": [
              "note"
            ],
            "step": {
              "post-ledger": {
                "id": "count",
                "owner": "invoker",
                "unit": "points",
                "scope": null,
                "amount": {
                  "param": "note"
                },
                "reason": "r"
              }
            },
            "env": {
              "fields": {},
              "params": [
                "note"
              ],
              "roles": [
                "editor",
                "owner",
                "public"
              ]
            }
          },
          "result": []
        },
        {
          "description": "An update step on an unknown type.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-10"
            },
            "at": "operation o",
            "inputs": [
              "note"
            ],
            "step": {
