    {
      "id": "put-team",
      "description": "transition.rs put_team: record a changed team: an event for the team (team-principal), the schema with the team, and an event for each of its members with the roles it now holds (assigned-roles).",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "team",
          "type": "team-def"
        }
      ],
      "returns": "draft",
      "let": [
        {
          "name": "after",
          "expr": "call schema-with-team(schema, team)"
        }
      ],
      "body": "draft{tenant: d.tenant, ctx: d.ctx, coverage: d.coverage, ops: concat(d.ops, [delta-op.put-schema(after)]), events: concat(concat(d.events, [event-body.member-changed{principal: call team-principal(team.id), roles: team.roles}]), map(m in team.members, event-body.member-changed{principal: m, roles: call assigned-roles(d.tenant.members, after, m)})), effects: d.effects, evidence: d.evidence, next-record: d.next-record}",
      "examples": [
        {
          "args": {
            "d": {
              "fixture": "fx-draft-18"
            },
            "schema": {
              "fixture": "fx-tenant-schema-8"
            },
