    {
      "id": "error-kind-debug",
      "description": "The Rust Debug name of an ErrorKind ({:?}), as backend app.rs ApiError::domain writes it into the error body's kind.",
      "params": [
        {
          "name": "kind",
          "type": "error-kind"
        }
      ],
      "returns": "string",
      "body": "match kind { tenant-mismatch => 'TenantMismatch', tenant-exists => 'TenantExists', tenant-not-found => 'TenantNotFound', unauthorized => 'Unauthorized', unknown-object => 'UnknownObject', unknown-field => 'UnknownField', unknown-record => 'UnknownRecord', unknown-role => 'UnknownRole', unknown-query => 'UnknownQuery', type-mismatch => 'TypeMismatch', missing-required => 'MissingRequired', constraint-violated => 'ConstraintViolated', unique-violated => 'UniqueViolated', dangling-reference => 'DanglingReference', still-referenced => 'StillReferenced', workflow-violation => 'WorkflowViolation', version-conflict => 'VersionConflict', schema-conflict => 'SchemaConflict', invalid-schema => 'InvalidSchema', migration-rejected => 'MigrationRejected', insufficient-state => 'InsufficientState', evaluation => 'Evaluation', invalid-intent => 'InvalidIntent', limit-exceeded => 'LimitExceeded', idempotency-mismatch => 'IdempotencyMismatch', self-action => 'SelfAction', last-owner => 'LastOwner', conflicting-roles => 'ConflictingRoles', scope-unknown-field => 'ScopeUnknownField', view-read-only => 'ViewReadOnly', audience-not-permitted => 'AudienceNotPermitted', approver-permission => 'ApproverPermission', hold-expired => 'HoldExpired', stale-hold => 'StaleHold' }",
      "examples": [
        {
          "args": {
            "kind": "unauthorized"
          },
          "result": "Unauthorized"
        },
        {
          "args": {
            "kind": "version-conflict"
          },
          "result": "VersionConflict"
        },
        {
          "args": {
