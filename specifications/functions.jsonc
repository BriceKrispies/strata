    {
      "id": "validate-record",
      "description": "rules.rs validate_record: validate a whole candidate record (of the schema it reads only the workflows, so the examples give no others): unknown fields, then per declared field (in id order) required, type, unique and reference, then each composite unique constraint (unique-step, in id order), then workflow states, and the constraints only when nothing failed. old is the stored record on update. The roles are rules.rs roles_of(lookup.tenant, principal); a unique clash names the other record only when read.rs visible lets the principal read it. texts holds the printed constraint expressions (the print gap of WG-4957). Before everything the size of the record (limits.rs, record-limit-check: 262144 bytes of JSON); per field after required, the limits of the value (limit-step: a string of 65536 bytes, a list of 1000 items, a value of a unique field of 200 encoded bytes), which skip the rest of the field.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "coverage",
          "type": "coverage"
        },
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "object",
          "type": "object-type-def"
        },
        {
          "name": "candidate",
          "type": "record"
        },
        {
          "name": "old",
          "type": "option<record>"
        },
        {
          "name": "principal",
          "type": "principal"
        },
        {
          "name": "now",
          "type": "timestamp"
        }
      ],
      "returns": "validation-outcome",
      "errors": "rejection",
      "let": [
        {
          "name": "roles",
          "expr": "call roles-of(tenant, principal)"
        },
        {
          "name": "unknown",
          "expr": "call unknown-field-checks(object, candidate, call record-limit-check(validation-outcome{passed: [], failed: []}, object, candidate, 262144))"
        },
        {
          "name": "checked",
          "expr": "fold(f in values(object.fields), a = unknown, try call field-step(tenant, coverage, object, candidate, principal, now, a, f))"
        },
        {
          "name": "uniques",
          "expr": "fold(u in values(call uniques-of(object)), a = checked, try call unique-step(tenant, coverage, object, candidate, principal, now, a, u))"
        },
        {
          "name": "flows",
          "expr": "call workflow-checks(schema, object, candidate, uniques)"
        }
      ],
      "body": "if flows.failed == [] then call constraint-checks(object, candidate, old, principal, now, roles, flows) else flows",
      "examples": [
        {
          "description": "behaviour.rs create_applies_defaults_and_allocates_the_next_id: a valid note.",
