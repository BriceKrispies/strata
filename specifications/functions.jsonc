    {
      "id": "change-member",
      "description": "transition.rs change_member: assign a role to a principal or revoke it. Authorised as Manage on Members; the role must exist and not be public; the role must be one the acting principal may confer, whether it is handed out or taken away (require-conferrable, ADM-152, ADM-1080); a grant must not give the person two duties kept apart (duty-made-by, ADM-1630, ADM-1642), and a revocation takes the scoped assignments of the role with it (D-8403); a revocation must leave the tenant an owner, counting the owners through teams (owner-lost, ADM-1081). The event names every role the principal now holds, its own and its teams' (assigned-roles); a principal left with no role at all has its sessions revoked.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "who",
          "type": "principal-id"
        },
        {
          "name": "role",
          "type": "role-id"
        },
        {
          "name": "grant",
          "type": "bool"
        }
      ],
      "returns": "decided",
      "errors": "rejection",
      "let": [
        {
          "name": "d1",
          "expr": "try call require(d, action.manage, resource.members, subject{})"
        },
        {
          "name": "current",
          "expr": "match get(d1.tenant.members, who) { Some(rs) => rs, None => [] }"
        },
        {
          "name": "roles",
          "expr": "if grant then call set-of(concat(current, [role])) else filter(r in current, r != role)"
        }
      ],
      "body": "if get(d1.tenant.schema.roles, role) == null then fail(call draft-reject(d1.evidence, error-kind.unknown-role, format('no role {}', role))) else if role == 'public' then fail(call draft-reject(d1.evidence, error-kind.invalid-intent, 'everyone already holds public')) else let d2 = try call require-conferrable(d1, [role]) in if !grant && call owner-lost(d2.tenant.members, d2.tenant.schema, insert(d2.tenant.members, who, roles), d2.tenant.schema) then fail(call draft-reject(d2.evidence, error-kind.last-owner, 'a tenant keeps at least one owner')) else match (if grant then call duty-made-by(d2.tenant.members, d2.tenant.schema, insert(d2.tenant.members, who, roles), d2.tenant.schema) else null) { Some(m) => fail(call draft-reject(d2.evidence, error-kind.conflicting-roles, m)), None => let through = call assigned-roles({}, d2.tenant.schema, who) in decided{draft: draft{tenant: d2.tenant, ctx: d2.ctx, coverage: d2.coverage, ops: concat(concat(d2.ops, [delta-op.put-member{principal: who, roles}]), if !grant && any(a in call scoped-of(d2.tenant.schema, who), a.role == role) then [delta-op.put-schema(call schema-with-scoped(d2.tenant.schema, filter(a in call scoped-roles-of(d2.tenant.schema), !(a.principal == who && a.role == role))))] else []), events: concat(d2.events, [event-body.member-changed{principal: who, roles: call set-of(concat(roles, through))}]), effects: if roles == [] && through == [] then concat(d2.effects, [effect.revoke-sessions{principal: who}]) else d2.effects, evidence: d2.evidence, next-record: d2.next-record}, output: output.member} }",
      "examples": [
        {
          "description": "behaviour.rs removing_the_last_role_asks_for_the_sessions_to_end_and_the_last_owner_stays: revoking writer1's only role.",
