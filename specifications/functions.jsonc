        }
      ],
      "returns": "tenant-schema",
      "body": "tenant-schema{version: schema.version, objects: schema.objects, roles: schema.roles, role-permissions: schema.role-permissions, teams: schema.teams, invitations: schema.invitations, policies: schema.policies, workflows: schema.workflows, queries: schema.queries, views: schema.views, triggers: schema.triggers, automations: schema.automations, operations: schema.operations, settings: schema.settings, capabilities: schema.capabilities, ledger: schema.ledger, mail-templates: schema.mail-templates, notice-templates: schema.notice-templates, tokens: schema.tokens, products: schema.products, hold-rules: schema.hold-rules, holds: schema.holds, ui: schema.ui, scoped-roles: if held == [] then null else held, separations: schema.separations}",
      "examples": [
