                    "scope": {
                      "cmp": {
                        "op": "eq",
                        "left": {
                          "var": {
                            "scope": "record",
                            "field": "slug"
                          }
                        },
                        "right": {
                          "lit": {
                            "str": "north"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            },
            "p": "alpha:ann"
          },
