                  "role": "writer",
                  "resource": {
                    "object": "note"
                  },
                  "actions": [
                    "update",
                    "delete"
                  ],
                  "condition": {
                    "cmp": {
                      "op": "eq",
                      "left": {
                        "var": {
                          "scope": "record",
                          "field": "$created_by"
                        }
                      },
                      "right": "principal"
                    }
                  }
                },
                "writers_read_notes": {
                  "id": "writers_read_notes",
                  "role": "writer",
                  "resource": {
                    "object": "note"
                  },
                  "actions": [
                    "read",
                    "create"
                  ],
                  "condition": null
                }
              },
              "workflows": {
                "note_status": {
                  "id": "note_status",
                  "object": "note",
                  "field": "status",
                  "initial": [
                    "draft"
                  ],
                  "transitions": [
                    {
                      "name": "publish",
                      "from": "draft",
                      "to": "published",
                      "guard": {
                        "cmp": {
                          "op": "eq",
                          "left": "principal",
                          "right": {
                            "lit": {
                              "str": "alpha:editor"
                            }
                          }
                        }
                      },
                      "set": {
                        "published_at": "now"
                      }
                    },
                    {
                      "name": "unpublish",
                      "from": "published",
                      "to": "draft",
                      "guard": null,
                      "set": {
                        "published_at": {
                          "lit": "null"
                        }
                      }
                    }
                  ]
                }
              },
              "queries": {},
              "views": {},
              "settings": {
                "s000": {
                  "id": "s000",
                  "label": "s000",
                  "type": "string",
                  "default": {
                    "str": "light"
                  },
                  "levels": [
                    "tenant",
                    "team",
                    "person"
                  ]
                },
                "s001": {
                  "id": "s001",
                  "label": "s001",
