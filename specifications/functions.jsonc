    {
      "id": "json-number-text",
      "description": "serde_json Display of a number.",
      "params": [
        {
          "name": "n",
          "type": "json-number"
        }
      ],
      "returns": "string",
      "body": "match n { pos-int(u) => format('{}', u), neg-int(i) => format('{}', i), float(x) => format('{}', x) }",
      "examples": [
        {
          "args": {
            "n": {
              "pos-int": 3
            }
          },
          "result": "3"
        },
        {
          "args": {
            "n": {
              "neg-int": -3
            }
          },
          "result": "-3"
        },
        {
          "args": {
            "n": {
              "float": 1.5
            }
          },
          "result": "1.5"
        }
      ]
    },
    {
      "id": "json-leaf-text",
      "description": "serde_json Display (compact JSON) of a value that is not an array or object; an array is written [..] and an object {..}.",
      "params": [
        {
          "name": "j",
          "type": "plain-json"
        }
      ],
      "returns": "string",
      "body": "match j { bool(b) => format('{}', b), number(n) => call json-number-text(n), string(s) => format('\"{}\"', s), array(_) => '[..]', object(_) => '{..}', _ => 'null' }",
      "examples": [
        {
          "args": {
            "j": {
              "string": "3"
            }
          },
          "result": "\"3\""
        },
        {
          "args": {
            "j": "null"
          },
          "result": "null"
        },
        {
          "args": {
            "j": {
              "bool": false
            }
          },
          "result": "false"
        },
        {
          "args": {
            "j": {
              "array": []
            }
          },
          "result": "[..]"
        },
        {
          "args": {
            "j": {
              "object": {}
            }
          },
          "result": "{..}"
        }
      ]
    },
    {
      "id": "json-text",
      "description": "serde_json Display (compact JSON) of a value, as plain.rs writes it into a mismatch; arrays and objects are written one level deep.",
      "params": [
        {
          "name": "j",
          "type": "plain-json"
        }
      ],
      "returns": "string",
      "body": "match j { array(items) => '[' + fold(i in items, acc = '', let t = call json-leaf-text(i) in if acc == '' then t else acc + ',' + t) + ']', object(m) => '{' + fold(k in keys(m), acc = '', let t = format('\"{}\":{}', k, match get(m, k) { Some(x) => call json-leaf-text(x), None => 'null' }) in if acc == '' then t else acc + ',' + t) + '}', _ => call json-leaf-text(j) }",
      "examples": [
        {
          "args": {
            "j": {
              "array": [
                {
                  "string": "a"
                },
                {
                  "number": {
                    "pos-int": 1
                  }
                }
              ]
            }
          },
          "result": "[\"a\",1]"
        },
        {
          "args": {
            "j": {
              "object": {
                "b": {
                  "bool": true
                },
                "a": "null"
              }
            }
          },
          "result": "{\"a\":null,\"b\":true}"
        },
        {
          "args": {
            "j": {
              "number": {
                "pos-int": 7
              }
            }
          },
          "result": "7"
        }
      ]
    },
    {
      "id": "json-as-i64",
      "description": "serde_json Number::as_i64.",
      "params": [
        {
          "name": "n",
          "type": "json-number"
        }
      ],
      "returns": "option<i64>",
      "body": "match n { pos-int(u) => if u <= 9223372036854775807 then u else null, neg-int(i) => i, float(_) => null }",
      "examples": [
        {
          "args": {
            "n": {
              "pos-int": 3
            }
          },
          "result": 3
        },
        {
          "args": {
            "n": {
              "neg-int": -3
            }
          },
          "result": -3
        },
        {
          "args": {
            "n": {
              "float": 3.5
            }
          },
          "result": null
        }
      ]
    },
    {
      "id": "json-as-u64",
      "description": "serde_json Number::as_u64.",
      "params": [
        {
          "name": "n",
          "type": "json-number"
        }
      ],
      "returns": "option<u64>",
      "body": "match n { pos-int(u) => u, _ => null }",
      "examples": [
        {
          "args": {
            "n": {
              "pos-int": 3
            }
          },
          "result": 3
        },
        {
          "args": {
            "n": {
              "neg-int": -3
            }
          },
          "result": null
        }
      ]
    },
    {
      "id": "coerce-mismatch",
      "description": "plain.rs coerce, the mismatch message: expected <type name>, got <the JSON>.",
      "params": [
        {
          "name": "ty",
          "type": "field-type"
        },
        {
          "name": "j",
          "type": "plain-json"
        }
      ],
      "returns": "plain-error",
      "body": "plain-error.message(format('expected {}, got {}', call field-type-name(ty), call json-text(j)))",
      "examples": [
        {
          "args": {
            "ty": "int",
            "j": {
              "string": "3"
            }
          },
          "result": {
            "message": "expected int, got \"3\""
          }
        }
      ]
    },
    {
      "id": "coerce-scalar",
      "description": "plain.rs coerce for every JSON value but an array of a list type: null is null whatever the type; a string for str; an integer for int and time (as_i64); a bool for bool; a string for time through parse_time; an id for ref (as_u64), or a symbolic reference @key through resolve. refs maps each symbolic reference as written (with its @) to the record id resolve gives; times maps each text parse_time accepts to its milliseconds. Anything else is a mismatch.",
      "params": [
        {
          "name": "ty",
          "type": "field-type"
        },
        {
          "name": "j",
          "type": "plain-json"
        },
        {
          "name": "refs",
          "type": "map<string, record-id>"
        },
        {
          "name": "times",
          "type": "map<string, i64>"
        }
      ],
      "returns": "value",
      "errors": "plain-error",
      "body": "match j { bool(b) => match ty { bool => value.bool(b), _ => fail(call coerce-mismatch(ty, j)) }, number(n) => match ty { int => match call json-as-i64(n) { Some(i) => value.int(i), None => fail(call coerce-mismatch(ty, j)) }, time => match call json-as-i64(n) { Some(i) => value.time(i), None => fail(call coerce-mismatch(ty, j)) }, ref => match call json-as-u64(n) { Some(u) => value.ref(u), None => fail(call coerce-mismatch(ty, j)) }, _ => fail(call coerce-mismatch(ty, j)) }, string(s) => match ty { str => value.str(s), time => match get(times, s) { Some(t) => value.time(t), None => fail(plain-error.message(format('not a UTC timestamp: \"{}\"', s))) }, ref => if call text-starts-with(s, '@') then match get(refs, s) { Some(id) => value.ref(id), None => fail(plain-error.message(format('unknown record key {}', s))) } else fail(call coerce-mismatch(ty, j)), _ => fail(call coerce-mismatch(ty, j)) }, array(_) => fail(call coerce-mismatch(ty, j)), object(_) => fail(call coerce-mismatch(ty, j)), _ => call null-value() }",
      "examples": [
        {
          "description": "plain.rs coerces_by_field_type: null stays null.",
          "args": {
            "ty": "bool",
            "j": "null",
            "refs": {},
            "times": {}
          },
          "result": "null"
        },
        {
          "description": "plain.rs coerces_by_field_type: a string is not an int.",
          "args": {
            "ty": "int",
            "j": {
              "string": "3"
            },
            "refs": {},
            "times": {}
          },
          "error": {
            "message": "expected int, got \"3\""
          }
        },
        {
          "description": "plain.rs coerces_by_field_type: a UTC date.",
          "args": {
            "ty": "time",
            "j": {
              "string": "1970-01-02"
            },
            "refs": {},
            "times": {
              "1970-01-02": 86400000
            }
          },
          "result": {
            "time": 86400000
          }
        },
        {
          "description": "plain.rs parses_utc_timestamps: a time needs its Z.",
          "args": {
            "ty": "time",
            "j": {
              "string": "2026-11-18T09:30"
            },
            "refs": {},
            "times": {}
          },
          "error": {
            "message": "not a UTC timestamp: \"2026-11-18T09:30\""
          }
        },
        {
          "args": {
            "ty": "int",
            "j": {
              "number": {
                "neg-int": -4
              }
            },
            "refs": {},
            "times": {}
          },
          "result": {
            "int": -4
          }
        },
        {
          "args": {
            "ty": "int",
            "j": {
              "number": {
                "float": 1.5
              }
            },
            "refs": {},
            "times": {}
          },
          "error": {
            "message": "expected int, got 1.5"
          }
        },
        {
          "args": {
            "ty": "time",
            "j": {
              "number": {
                "pos-int": 5000
              }
            },
            "refs": {},
            "times": {}
          },
          "result": {
            "time": 5000
          }
        },
        {
          "args": {
            "ty": "str",
            "j": {
              "string": "a"
            },
            "refs": {},
            "times": {}
          },
          "result": {
            "str": "a"
          }
        },
        {
          "args": {
            "ty": "bool",
            "j": {
              "bool": true
            },
            "refs": {},
            "times": {}
          },
          "result": {
            "bool": true
          }
        },
        {
          "args": {
            "ty": "bool",
            "j": {
              "number": {
                "pos-int": 1
              }
            },
            "refs": {},
            "times": {}
          },
          "error": {
            "message": "expected bool, got 1"
          }
        },
        {
          "args": {
            "ty": {
              "ref": {
                "target": "author",
                "on-delete": "restrict"
              }
            },
            "j": {
              "number": {
                "pos-int": 2
              }
            },
            "refs": {},
            "times": {}
          },
          "result": {
            "ref": 2
          }
        },
        {
          "args": {
            "ty": {
              "ref": {
                "target": "author",
                "on-delete": "restrict"
              }
            },
            "j": {
              "number": {
                "neg-int": -2
              }
            },
            "refs": {},
            "times": {}
          },
          "error": {
            "message": "expected reference<author>, got -2"
          }
        },
        {
          "description": "bundle.rs: a symbolic reference resolved through the bundle's keys.",
          "args": {
            "ty": {
              "ref": {
                "target": "author",
                "on-delete": "restrict"
              }
            },
            "j": {
              "string": "@ines"
            },
            "refs": {
              "@ines": 2
            },
            "times": {}
          },
          "result": {
            "ref": 2
          }
        },
        {
          "args": {
            "ty": {
              "ref": {
                "target": "author",
                "on-delete": "restrict"
              }
            },
            "j": {
              "string": "@nobody"
            },
            "refs": {},
            "times": {}
          },
          "error": {
            "message": "unknown record key @nobody"
          }
        },
        {
          "args": {
            "ty": {
              "ref": {
                "target": "author",
                "on-delete": "restrict"
              }
            },
            "j": {
              "string": "ines"
            },
            "refs": {},
            "times": {}
          },
          "error": {
            "message": "expected reference<author>, got \"ines\""
          }
        },
        {
          "args": {
            "ty": "str",
            "j": {
              "object": {
                "a": {
                  "number": {
                    "pos-int": 1
                  }
                }
              }
            },
            "refs": {},
            "times": {}
          },
          "error": {
            "message": "expected string, got {\"a\":1}"
          }
        },
        {
          "args": {
            "ty": "int",
            "j": {
              "bool": true
            },
            "refs": {},
            "times": {}
          },
          "error": {
            "message": "expected int, got true"
          }
        },
        {
          "args": {
            "ty": {
              "ref": {
                "target": "person",
                "on-delete": "set-null"
              }
            },
            "j": {
              "number": {
                "float": 1.5
              }
            },
            "refs": {},
            "times": {}
          },
          "error": {
            "message": "expected reference<person>, got 1.5"
          }
        }
      ]
    },
    {
      "id": "coerce",
      "description": "plain.rs coerce: turn plain JSON into a value of a field type; a list type takes an array whose items are coerced to its element type.",
      "params": [
        {
          "name": "ty",
          "type": "field-type"
        },
        {
          "name": "j",
          "type": "plain-json"
        },
        {
          "name": "refs",
          "type": "map<string, record-id>"
        },
        {
          "name": "times",
          "type": "map<string, i64>"
        }
      ],
      "returns": "value",
      "errors": "plain-error",
      "body": "match ty { list(inner) => match j { array(items) => value.list(map(i in items, try call coerce-scalar(inner, i, refs, times))), _ => try call coerce-scalar(ty, j, refs, times) }, _ => try call coerce-scalar(ty, j, refs, times) }",
      "examples": [
        {
          "description": "plain.rs coerces_by_field_type: a list of strings.",
          "args": {
            "ty": {
              "list": "str"
            },
            "j": {
              "array": [
                {
                  "string": "a"
                },
                {
                  "string": "b"
                }
              ]
            },
            "refs": {},
            "times": {}
          },
          "result": {
            "list": [
              {
                "str": "a"
              },
              {
                "str": "b"
              }
            ]
          }
        },
        {
          "args": {
            "ty": {
              "list": "str"
            },
            "j": {
              "array": [
                {
                  "string": "a"
                },
                {
                  "number": {
                    "pos-int": 1
                  }
                }
              ]
            },
            "refs": {},
            "times": {}
          },
          "error": {
            "message": "expected string, got 1"
          }
        },
        {
          "args": {
            "ty": {
              "list": "str"
            },
            "j": {
              "string": "a"
            },
            "refs": {},
            "times": {}
          },
          "error": {
            "message": "expected list<string>, got \"a\""
          }
        },
        {
          "args": {
            "ty": {
              "list": "str"
            },
            "j": "null",
            "refs": {},
            "times": {}
          },
          "result": "null"
        },
        {
          "args": {
            "ty": "int",
            "j": {
              "array": []
            },
            "refs": {},
            "times": {}
          },
          "error": {
            "message": "expected int, got []"
          }
        },
        {
          "args": {
            "ty": "int",
            "j": {
              "number": {
                "pos-int": 3
              }
            },
            "refs": {},
            "times": {}
          },
          "result": {
            "int": 3
          }
        }
      ]
    },
    {
      "id": "coerce-fields",
      "description": "plain.rs coerce_fields: a plain JSON object as field values of an object type, in name order; a name the type does not declare is <object> has no field <name>, and a value that does not coerce is <name>: <error>.",
      "params": [
        {
          "name": "object",
          "type": "object-type-def"
        },
        {
          "name": "fields",
          "type": "map<string, plain-json>"
        },
        {
          "name": "refs",
          "type": "map<string, record-id>"
        },
        {
          "name": "times",
          "type": "map<string, i64>"
        }
      ],
      "returns": "map<field-id, value>",
      "errors": "plain-error",
      "body": "fold(name in keys(fields), out = {}, match get(object.fields, name) { None => fail(plain-error.message(format('{} has no field {}', object.id, name))), Some(def) => match get(fields, name) { Some(j) => match call coerce(def.ty, j, refs, times) { Ok(x) => insert(out, name, x), Err(e) => match e { message(m) => fail(plain-error.message(format('{}: {}', name, m))) } }, None => out } })",
      "examples": [
        {
          "description": "bundle.rs: a seeded post with a symbolic author, tags and a date.",
          "args": {
            "object": {
              "fixture": "fx-object-type-def-3"
            },
            "fields": {
              "title": {
                "string": "Kiln"
              },
              "author": {
                "string": "@ines"
              },
              "tags": {
                "array": [
                  {
                    "string": "clay"
                  }
                ]
              },
              "published_at": {
                "string": "2026-11-18T09:30Z"
              }
            },
            "refs": {
              "@ines": 2
            },
            "times": {
              "2026-11-18T09:30Z": 1794994200000
            }
          },
          "result": {
            "author": {
              "ref": 2
            },
            "published_at": {
              "time": 1794994200000
            },
            "tags": {
              "list": [
                {
                  "str": "clay"
                }
              ]
            },
            "title": {
              "str": "Kiln"
            }
          }
        },
        {
          "args": {
            "object": {
              "fixture": "fx-object-type-def-3"
            },
            "fields": {
              "title": {
                "string": "Kiln"
              },
              "mood": {
                "string": "x"
              }
            },
            "refs": {},
            "times": {}
          },
          "error": {
            "message": "post has no field mood"
          }
        },
        {
          "args": {
            "object": {
              "fixture": "fx-object-type-def-3"
            },
            "fields": {
              "title": {
                "number": {
                  "pos-int": 3
                }
              }
            },
            "refs": {},
            "times": {}
          },
          "error": {
            "message": "title: expected string, got 3"
          }
        },
        {
          "args": {
            "object": {
              "fixture": "fx-object-type-def-3"
            },
            "fields": {
              "title": "null"
            },
            "refs": {},
            "times": {}
          },
          "result": {
            "title": "null"
          }
        }
      ]
    },
    {
      "id": "refuse",
      "description": "transition.rs refuse: a rejection made before any rule of the tenant is consulted; it names the failed check.",
      "params": [
        {
          "name": "kind",
          "type": "error-kind"
        },
        {
          "name": "rule",
          "type": "string"
        },
        {
          "name": "message",
          "type": "string"
        }
      ],
      "returns": "domain-error",
      "body": "domain-error{kind, message, evidence: [check{rule, passed: false, detail: message}]}",
      "examples": [
        {
          "args": {
            "kind": "tenant-not-found",
            "rule": "tenant:exists",
            "message": "no such tenant"
          },
          "result": {
            "kind": "tenant-not-found",
            "message": "no such tenant",
            "evidence": [
              {
                "rule": "tenant:exists",
                "passed": false,
                "detail": "no such tenant"
              }
            ],
            "missing": null
          }
        }
      ]
    },
    {
      "id": "principal-debug",
      "description": "The Rust Debug text of a Principal ({:?}).",
      "params": [
        {
          "name": "p",
          "type": "principal"
        }
      ],
      "returns": "string",
      "body": "match p { system => 'System', anonymous => 'Anonymous', user(id) => format('User(PrincipalId(\"{}\"))', id) }",
      "examples": [
        {
          "args": {
            "p": {
              "user": "alpha:writer2"
            }
          },
          "result": "User(PrincipalId(\"alpha:writer2\"))"
        },
        {
          "args": {
            "p": "anonymous"
          },
          "result": "Anonymous"
        },
        {
          "args": {
            "p": "system"
          },
          "result": "System"
        }
      ]
    },
    {
      "id": "resource-debug",
      "description": "The Rust Debug text of a Resource ({resource:?}).",
      "params": [
        {
          "name": "r",
          "type": "resource"
        }
      ],
      "returns": "string",
      "body": "match r { object(o) => format('Object(ObjectTypeId(\"{}\"))', o), any-object => 'AnyObject', schema => 'Schema', members => 'Members', ledger{unit} => format('Ledger { unit: {} }', match unit { Some(u) => format('Some(LedgerUnit(\"{}\"))', u), None => 'None' }) }",
      "examples": [
        {
          "args": {
            "r": {
              "object": "note"
            }
          },
          "result": "Object(ObjectTypeId(\"note\"))"
        },
        {
          "args": {
            "r": "members"
          },
          "result": "Members"
        },
        {
          "args": {
            "r": "any-object"
          },
          "result": "AnyObject"
        },
        {
          "args": {
            "r": "schema"
          },
          "result": "Schema"
        },
        {
          "args": {
            "r": {
              "ledger": {
                "unit": "points"
              }
            }
          },
          "result": "Ledger { unit: Some(LedgerUnit(\"points\")) }"
        }
      ]
    },
    {
      "id": "revision-debug",
      "description": "The Rust Debug text of an Option<StateRevision>.",
      "params": [
        {
          "name": "r",
          "type": "option<state-revision>"
        }
      ],
      "returns": "string",
      "body": "match r { Some(n) => format('Some(StateRevision({}))', n), None => 'None' }",
      "examples": [
        {
          "args": {
            "r": 3
          },
          "result": "Some(StateRevision(3))"
        },
        {
          "args": {
            "r": null
          },
          "result": "None"
        }
      ]
    },
    {
      "id": "string-set-debug",
      "description": "The Rust Debug text of a BTreeSet<String> ({:?}): the items quoted, in order, between braces. Quotes and backslashes inside an item are not escaped (the body language has no string operations).",
      "params": [
        {
          "name": "items",
          "type": "set<string>"
        }
      ],
      "returns": "string",
      "body": "'{' + fold(s in items, acc = '', if acc == '' then format('\"{}\"', s) else acc + ', ' + format('\"{}\"', s)) + '}'",
      "examples": [
        {
          "args": {
            "items": [
              "draft"
            ]
          },
          "result": "{\"draft\"}"
        },
        {
          "args": {
            "items": [
              "a",
              "b"
            ]
          },
          "result": "{\"a\", \"b\"}"
        },
        {
          "args": {
            "items": []
          },
          "result": "{}"
        }
      ]
    },
    {
      "id": "join-semicolon",
      "description": "Vec<String>::join(\"; \") for the refusals of a workflow step, which are never empty.",
      "params": [
        {
          "name": "items",
          "type": "list<string>"
        }
      ],
      "returns": "string",
      "body": "fold(s in items, acc = '', if acc == '' then s else acc + '; ' + s)",
      "examples": [
        {
          "args": {
            "items": [
              "publish: guard is not true",
              "publish2: guard is not true"
            ]
          },
          "result": "publish: guard is not true; publish2: guard is not true"
        },
        {
          "args": {
            "items": [
              "x: y"
            ]
          },
          "result": "x: y"
        }
      ]
    },
    {
      "id": "genesis-schema",
      "description": "schema.rs TenantSchema::genesis: version 1, the built-in roles public (Everyone) and owner (Owner), nothing else.",
      "params": [],
      "returns": "tenant-schema",
      "body": "tenant-schema{version: 1, objects: {}, roles: insert(insert({}, 'owner', role-def{id: 'owner', label: 'Owner'}), 'public', role-def{id: 'public', label: 'Everyone'}), policies: {}, workflows: {}, queries: {}, views: {}}",
      "examples": [
