      ]
    },
    {
      "id": "query-page-size",
      "description": "read.rs page_size, before its checks: the page size of a named query read is the one the read names, else the limit the query declares, else 50 (KRN-1285).",
      "params": [
        {
          "name": "def",
          "type": "query-def"
        },
        {
          "name": "asked",
          "type": "option<u32>"
        }
      ],
      "returns": "u32",
      "body": "match asked { Some(n) => n, None => match def.limit { Some(l) => l, None => 50 } }",
      "examples": [
        {
          "args": {
            "def": {
              "id": "q",
              "object": "post",
              "filter": null,
              "params": [],
              "order": [],
              "limit": null
            },
            "asked": null
          },
          "result": 50
        },
        {
          "args": {
            "def": {
              "id": "q",
              "object": "post",
              "filter": null,
              "params": [],
              "order": [],
              "limit": 7
            },
            "asked": null
          },
          "result": 7
        },
        {
          "args": {
            "def": {
              "id": "q",
              "object": "post",
              "filter": null,
              "params": [],
              "order": [],
              "limit": 7
            },
            "asked": 20
          },
          "result": 20
        }
      ]
    },
    {
      "id": "query-windowed",
      "description": "read.rs is_windowed: a named query is served by a window of its object type in id order when it has no filter and orders by nothing or by the record id ascending (KRN-1287); any other query is served by a sorted scan.",
      "params": [
        {
          "name": "def",
          "type": "query-def"
        }
      ],
      "returns": "bool",
      "body": "match def.filter { Some(_) => false, None => length(def.order) == 0 || (length(def.order) == 1 && any(k in def.order, k.field == '$id' && !k.descending)) }",
      "examples": [
        {
          "description": "No filter and no order: a window serves it.",
          "args": {
            "def": {
              "id": "q",
              "object": "post",
              "filter": null,
              "params": [],
              "order": [],
              "limit": null
            }
          },
          "result": true
        },
        {
          "args": {
            "def": {
              "id": "q",
              "object": "post",
              "filter": null,
              "params": [],
              "order": [
                {
                  "field": "$id",
                  "descending": false
                }
              ],
              "limit": null
            }
          },
          "result": true
        },
        {
          "args": {
            "def": {
              "id": "q",
              "object": "post",
              "filter": null,
              "params": [],
              "order": [
                {
                  "field": "$id",
                  "descending": true
                }
              ],
              "limit": null
            }
          },
          "result": false
        },
        {
          "args": {
            "def": {
              "id": "q",
              "object": "post",
              "filter": null,
              "params": [],
              "order": [
                {
                  "field": "title",
                  "descending": false
                }
              ],
              "limit": null
            }
          },
          "result": false
        },
        {
          "args": {
            "def": {
              "id": "q",
              "object": "post",
              "filter": {
                "lit": {
                  "bool": true
                }
              },
              "params": [],
              "order": [],
              "limit": null
            }
          },
          "result": false
        }
      ]
    },
    {
      "id": "cursor-after",
      "description": "read.rs plan: the record id a cursor continues after; none for no cursor, for an offset cursor and for an index position.",
      "params": [
        {
          "name": "cursor",
          "type": "option<page-cursor>"
        }
      ],
      "returns": "option<record-id>",
      "body": "match cursor { Some(c) => match c { after(a) => a, offset(_) => null, at(_) => null }, None => null }",
      "examples": [
        {
          "args": {
            "cursor": {
              "after": 7
            }
          },
          "result": 7
        },
        {
          "args": {
            "cursor": {
              "offset": 3
            }
          },
          "result": null
        },
        {
          "args": {
            "cursor": null
          },
          "result": null
        },
        {
          "description": "An index position continues a planned query, not a window.",
          "args": {
            "cursor": {
              "at": {
                "value": {
                  "int": 5
                },
                "id": 7
              }
            }
          },
          "result": null
        }
      ]
    },
    {
      "id": "cursor-offset",
      "description": "read.rs plan: the number of rows an offset cursor skips; none for no cursor, for an after cursor and for an index position.",
      "params": [
        {
          "name": "cursor",
          "type": "option<page-cursor>"
        }
      ],
      "returns": "u32",
      "body": "match cursor { Some(c) => match c { offset(n) => n, after(_) => 0, at(_) => 0 }, None => 0 }",
      "examples": [
        {
          "args": {
            "cursor": {
              "offset": 3
            }
          },
          "result": 3
        },
        {
          "args": {
            "cursor": {
              "after": 7
            }
          },
          "result": 0
        },
        {
          "args": {
            "cursor": null
          },
          "result": 0
        },
        {
          "description": "An index position skips no rows of a scan.",
          "args": {
            "cursor": {
              "at": {
                "value": {
                  "int": 5
                },
                "id": 7
              }
            }
          },
          "result": 0
        }
      ]
    },
    {
      "id": "query-page-errors",
      "description": "read.rs plan: why a named query read's page size or cursor is refused, as no error or one. A page size of 0 is invalid-intent, one above 200 is limit-exceeded (KRN-1285), and a cursor of the other kind than the query is served by is invalid-intent. An at cursor, which only a query planned on an index issues (KRN-2521), is refused here: the functions of the specification do not plan queries yet (difference 11 of generated_differential.rs).",
      "params": [
        {
          "name": "def",
          "type": "query-def"
        },
        {
          "name": "asked",
          "type": "option<u32>"
        },
        {
          "name": "cursor",
          "type": "option<page-cursor>"
        }
      ],
      "returns": "list<domain-error>",
      "let": [
        {
          "name": "size",
          "expr": "call query-page-size(def, asked)"
        },
        {
          "name": "windowed",
          "expr": "call query-windowed(def)"
        }
      ],
      "body": "if size == 0 then [domain-error{kind: error-kind.invalid-intent, message: 'a page size is at least 1', evidence: []}] else if size > 200 then [domain-error{kind: error-kind.limit-exceeded, message: format('a page size of {} is more than the maximum of 200', size), evidence: []}] else match cursor { None => [], Some(c) => match c { after(_) => if windowed then [] else [domain-error{kind: error-kind.invalid-intent, message: 'the cursor is not one this query issued', evidence: []}], offset(_) => if windowed then [domain-error{kind: error-kind.invalid-intent, message: 'the cursor is not one this query issued', evidence: []}] else [], at(_) => [domain-error{kind: error-kind.invalid-intent, message: 'the cursor is not one this query issued', evidence: []}] } }",
      "examples": [
        {
          "args": {
            "def": {
              "id": "q",
              "object": "post",
              "filter": null,
              "params": [],
              "order": [],
              "limit": null
            },
            "asked": null,
            "cursor": null
          },
          "result": []
        },
        {
          "args": {
            "def": {
              "id": "q",
              "object": "post",
              "filter": null,
              "params": [],
              "order": [],
              "limit": null
            },
            "asked": 0,
            "cursor": null
          },
          "result": [
            {
              "kind": "invalid-intent",
              "message": "a page size is at least 1",
              "evidence": [],
              "missing": null
            }
          ]
        },
        {
          "args": {
            "def": {
              "id": "q",
              "object": "post",
              "filter": null,
              "params": [],
              "order": [],
              "limit": null
            },
            "asked": 201,
            "cursor": null
          },
          "result": [
            {
              "kind": "limit-exceeded",
              "message": "a page size of 201 is more than the maximum of 200",
              "evidence": [],
              "missing": null
            }
          ]
        },
        {
          "args": {
            "def": {
              "id": "q",
              "object": "post",
              "filter": null,
              "params": [],
              "order": [],
              "limit": null
            },
            "asked": 200,
            "cursor": {
              "after": 4
            }
          },
          "result": []
        },
        {
          "description": "An offset cursor is not one a window serves.",
          "args": {
            "def": {
              "id": "q",
              "object": "post",
              "filter": null,
              "params": [],
              "order": [],
              "limit": null
            },
            "asked": null,
            "cursor": {
              "offset": 4
            }
          },
          "result": [
            {
              "kind": "invalid-intent",
              "message": "the cursor is not one this query issued",
              "evidence": [],
              "missing": null
            }
          ]
        },
        {
          "description": "An offset cursor continues a scan.",
          "args": {
            "def": {
              "id": "q",
              "object": "post",
              "filter": {
                "lit": {
                  "bool": true
                }
              },
              "params": [],
              "order": [],
              "limit": null
            },
            "asked": null,
            "cursor": {
              "offset": 4
            }
          },
          "result": []
        },
        {
          "description": "An after cursor is not one a scan serves.",
          "args": {
            "def": {
              "id": "q",
              "object": "post",
              "filter": {
                "lit": {
                  "bool": true
                }
              },
              "params": [],
              "order": [],
              "limit": null
            },
            "asked": null,
            "cursor": {
              "after": 4
            }
          },
          "result": [
            {
              "kind": "invalid-intent",
              "message": "the cursor is not one this query issued",
              "evidence": [],
              "missing": null
            }
          ]
        },
        {
          "description": "An at cursor is refused until the functions plan queries (difference 11).",
          "args": {
            "def": {
              "id": "q",
              "object": "post",
              "filter": null,
              "params": [],
              "order": [],
              "limit": null
            },
            "asked": null,
            "cursor": {
              "at": {
                "value": {
                  "int": 5
                },
                "id": 7
              }
