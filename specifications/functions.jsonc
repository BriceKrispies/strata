    {
      "id": "trigger-problems",
      "description": "definitions.rs trigger_problems (WFL-1520, INT-1522, CT-790): more than one hundred triggers, then the problems of each trigger in id order.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "roles",
          "type": "list<role-id>"
        }
      ],
      "returns": "list<string>",
      "let": [
        {
          "name": "ts",
          "expr": "values(call triggers-of(schema))"
        }
      ],
      "body": "concat(if length(ts) > 100 then [format('limit: {} triggers is more than the maximum of 100', length(ts))] else [], fold(t in ts, ps = [], concat(ps, call trigger-def-problems(schema, roles, t))))",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-9",
              "with": {
                "triggers": {
                  "on_points": {
                    "id": "on_points",
                    "on": {
                      "ledger-posted": {
                        "unit": "points"
                      }
                    },
                    "condition": {
                      "cmp": {
                        "op": "ge",
                        "left": {
                          "param": "balance"
                        },
                        "right": {
                          "lit": {
                            "int": 500
                          }
                        }
                      }
                    },
                    "automation": "award"
                  }
                },
                "ledger": {
                  "units": {
                    "points": {
                      "unit": "points",
                      "description": "points"
                    }
                  },
                  "pools": {},
                  "limits": []
                }
              }
            },
            "roles": [
              "editor",
              "owner",
              "public"
            ]
          },
          "result": []
        }
      ]
    },
    {
      "id": "step-outputs",
      "description": "definitions.rs step_outputs (automation-step-result, WFL-1523): the outputs of a completed step of a kind.",
      "params": [
        {
          "name": "action",
          "type": "automation-step"
        }
      ],
      "returns": "list<string>",
      "body": "match action { create-record => ['record', 'version'], update-record => ['version'], delete-record => [], post-ledger => ['entry_sequence', 'balance'], send-mail => ['message'], create-notice => ['item'], send-digest => ['messages'], call-webhook => ['delivery', 'status'], wait-for => [], wait-until => [], branch => ['taken'], fan-out => ['members', 'batches'], request-approval => ['approved', 'by'], invoke-operation => ['created', 'changed', 'deleted'], end => [] }",
      "examples": [
        {
          "args": {
            "action": "end"
          },
          "result": []
        },
        {
          "args": {
            "action": {
              "create-record": {
                "object": "note",
                "fields": {
                  "title": {
                    "param": "owner"
                  },
                  "status": {
                    "lit": {
                      "str": "draft"
                    }
                  }
                }
              }
            }
          },
          "result": [
            "record",
            "version"
          ]
        },
        {
          "args": {
            "action": {
              "invoke-operation": {
                "operation": "award_badge",
                "inputs": {}
              }
            }
          },
          "result": [
            "created",
            "changed",
            "deleted"
          ]
        },
        {
          "description": "A digest step binds the number of messages it sent.",
          "args": {
            "action": {
              "send-digest": {
                "category": "orders",
                "template": "daily",
                "since": 0,
                "until": 86400000
              }
            }
          },
          "result": [
            "messages"
          ]
        }
      ]
    },
    {
      "id": "automation-params",
      "description": "definitions.rs automation_params (D-6523, D-6535): what the expressions of an automation may read: every parameter an event binds, member, and <step>_<output> for each output of each of its steps.",
      "params": [
        {
          "name": "a",
          "type": "automation-def"
        }
      ],
      "returns": "list<string>",
      "body": "concat(['seq', 'at', 'hop', 'transition', 'person', 'segment', 'reason', 'owner', 'unit', 'amount', 'balance', 'balance_before', 'entry_sequence', 'setting', 'level', 'subject', 'schedule', 'due_at', 'endpoint', 'event_id', 'body', 'member'], fold(n in keys(a.steps), acc = [], match get(a.steps, n) { Some(s) => concat(acc, map(o in call step-outputs(s.action), format('{}_{}', n, o))), None => acc }))",
      "examples": [
        {
          "args": {
            "a": {
              "fixture": "fx-automation-def-1"
            }
          },
          "result": [
            "seq",
            "at",
            "hop",
            "transition",
            "person",
            "segment",
            "reason",
            "owner",
            "unit",
            "amount",
            "balance",
            "balance_before",
            "entry_sequence",
            "setting",
            "level",
            "subject",
            "schedule",
            "due_at",
            "endpoint",
            "event_id",
            "body",
            "member",
            "check_taken",
            "make_record",
            "make_version"
          ]
        }
      ]
    },
    {
      "id": "step-successors",
      "description": "definitions.rs successors: the steps a step names, in order: then and else of a branch, each of a fan-out, approved and refused of an approval, then its next step, then its compensation.",
      "params": [
        {
          "name": "s",
          "type": "automation-step-def"
        }
      ],
      "returns": "list<step-name>",
      "body": "concat(concat(match s.action { branch{then: yes, else: no} => [yes, no], fan-out{each} => [each], request-approval{approved, refused} => [approved, refused], _ => [] }, match s.next { Some(n) => [n], None => [] }), match s.compensate { Some(c) => [c], None => [] })",
      "examples": [
        {
          "args": {
            "s": {
              "action": {
                "create-record": {
                  "object": "note",
                  "fields": {
                    "title": {
                      "param": "owner"
                    },
                    "status": {
                      "lit": {
                        "str": "draft"
                      }
                    }
                  }
                }
              },
              "next": "check"
            }
          },
          "result": [
            "check"
          ]
        },
        {
          "args": {
            "s": {
              "fixture": "fx-automation-step-def-1"
            }
          },
          "result": [
            "done",
            "done"
          ]
        },
        {
          "args": {
            "s": {
              "action": "end"
            }
          },
          "result": []
        },
        {
          "description": "A step with a compensation.",
          "args": {
            "s": {
              "action": "end",
              "next": "a",
              "compensate": "b"
            }
          },
          "result": [
            "a",
            "b"
          ]
        }
      ]
    },
    {
      "id": "reachable-steps",
      "description": "definitions.rs reachable: the steps reachable from the start step, following every step a step names (step-successors); as many rounds as the automation has steps reach every one.",
      "params": [
        {
          "name": "a",
          "type": "automation-def"
        }
      ],
      "returns": "list<step-name>",
      "let": [
        {
          "name": "start",
          "expr": "if get(a.steps, a.start) == null then [] else [a.start]"
        }
      ],
      "body": "fold(n in keys(a.steps), seen = start, fold(m in seen, acc = seen, match get(a.steps, m) { Some(s) => fold(x in call step-successors(s), acc2 = acc, if get(a.steps, x) != null && !any(y in acc2, y == x) then concat(acc2, [x]) else acc2), None => acc }))",
      "examples": [
        {
          "args": {
            "a": {
              "fixture": "fx-automation-def-1"
            }
          },
          "result": [
            "make",
            "check",
            "done"
          ]
        }
      ]
    },
    {
      "id": "written-problems",
      "description": "definitions.rs written_problems: the problems of the fields a record step writes: an unknown object type, or per field in id order an unknown field and an expression that does not check (expr-problem).",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "at",
          "type": "string"
        },
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "fields",
          "type": "map<field-id, expr>"
        },
        {
          "name": "env",
          "type": "expr-check-env"
        }
      ],
      "returns": "list<string>",
      "body": "match get(schema.objects, object) { None => [format('{}: unknown object type {}', at, object)], Some(d) => fold(f in keys(fields), ps = [], concat(concat(ps, if get(d.fields, f) == null then [format('{}: unknown field {}', at, f)] else []), match get(fields, f) { Some(x) => call expr-problem(at, format('{}', f), x, env), None => [] })) }",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-10"
            },
            "at": "automation a.s",
            "object": "note",
            "fields": {
              "colour": {
                "param": "x"
              },
              "title": {
                "param": "owner"
              }
            },
            "env": {
              "fields": {},
              "params": [
                "owner"
              ],
              "roles": [
                "editor",
                "owner",
                "public"
              ]
            }
          },
          "result": [
            "automation a.s: unknown field colour",
            "automation a.s: colour: undeclared parameter x"
          ]
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-10"
            },
            "at": "automation a.s",
            "object": "tag",
            "fields": {},
            "env": {
              "fields": {},
              "params": [],
              "roles": [
                "editor",
                "owner",
                "public"
              ]
            }
          },
          "result": [
            "automation a.s: unknown object type tag"
          ]
        }
      ]
    },
    {
      "id": "automation-step-problems",
      "description": "definitions.rs automation_problems, one step: each step it names that the automation does not declare, retry attempts outside 1 to 10, then the problems of its action: record steps (written-problems, then record), the expressions of a posting, a mail, a notice, a webhook body and a wait-until, a branch (record and object type named together, the condition a truth value over the fields of that type), a fan-out batch outside 1 to 100, and an approval policy the schema does not have. The bounds of durations (retry delays, attempt timeouts, waits) are checked by the kernel only: the function language does not compile durations. A posting step names a unit the tenant declares (definitions.rs ledger_unit_reference).",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "a",
          "type": "automation-def"
        },
        {
          "name": "at",
          "type": "string"
        },
        {
          "name": "s",
          "type": "automation-step-def"
        },
        {
          "name": "env",
          "type": "expr-check-env"
        }
      ],
      "returns": "list<string>",
      "let": [
        {
          "name": "p1",
          "expr": "fold(x in call step-successors(s), ps = [], if get(a.steps, x) == null then concat(ps, [format('{}: unknown step {}', at, x)]) else ps)"
        },
        {
          "name": "p2",
          "expr": "match s.retry { Some(r) => if r.attempts == 0 || r.attempts > 10 then [format('{}: retry attempts outside 1 to 10', at)] else [], None => [] }"
        },
        {
          "name": "mismatch",
          "expr": "[format('{}: a branch names both an object type and a record, or neither', at)]"
        },
        {
          "name": "p3",
          "expr": "match s.action { create-record{object, fields} => call written-problems(schema, at, object, fields, env), update-record{object, record, fields} => concat(call written-problems(schema, at, object, fields, env), call expr-problem(at, 'record', record, env)), delete-record{object, record} => concat(call written-problems(schema, at, object, {}, env), call expr-problem(at, 'record', record, env)), post-ledger{owner, amount, unit} => concat(concat(call expr-problem(at, 'owner', owner, env), call expr-problem(at, 'amount', amount, env)), if get(call ledger-of(schema).units, unit) == null then [format('{}: names ledger unit {}, which the tenant does not declare', at, unit)] else []), send-mail{to, address, segment} => let hasto = match to { Some(_) => true, None => false } in let hasaddress = match address { Some(_) => true, None => false } in let hassegment = match segment { Some(_) => true, None => false } in concat(concat(if (hasto && !hasaddress && !hassegment) || (!hasto && hasaddress && !hassegment) || (!hasto && !hasaddress && hassegment) then [] else [format('{}: a mail names exactly one of to, address and segment', at)], match to { Some(t) => call expr-problem(at, 'to', t, env), None => [] }), match address { Some(x) => call expr-problem(at, 'address', x, env), None => [] }), create-notice{to, segment, record} => let hasto = match to { Some(_) => true, None => false } in let hassegment = match segment { Some(_) => true, None => false } in concat(concat(if (hasto && !hassegment) || (!hasto && hassegment) then [] else [format('{}: a notice names exactly one of to and segment', at)], match to { Some(t) => call expr-problem(at, 'to', t, env), None => [] }), match record { Some(r) => call expr-problem(at, 'record', r, env), None => [] }), send-digest => [], call-webhook{body} => fold(k in keys(body), ps = [], match get(body, k) { Some(x) => concat(ps, call expr-problem(at, format('body {}', k), x, env)), None => ps }), wait-for => [], wait-until{at: when} => call expr-problem(at, 'at', when, env), branch{condition, object, record} => let shapes = match object { Some(o) => match record { Some(_) => match get(schema.objects, o) { Some(d) => call field-shapes(d.fields), None => {} }, None => {} }, None => {} } in concat(match object { Some(o) => match record { Some(r) => concat(call expr-problem(at, 'record', r, env), if get(schema.objects, o) == null then [format('{}: unknown object type {}', at, o)] else []), None => mismatch }, None => match record { Some(_) => mismatch, None => [] } }, call truth-problem(at, 'condition', condition, expr-check-env{fields: shapes, params: env.params, roles: env.roles})), fan-out{batch} => if batch == 0 || batch > 100 then [format('{}: a fan-out batch is from 1 to 100', at)] else [], request-approval{policy} => if get(schema.policies, policy) == null then [format('{}: unknown policy {}', at, policy)] else [], invoke-operation{inputs} => fold(k in keys(inputs), ps = [], match get(inputs, k) { Some(x) => concat(ps, call expr-problem(at, format('input {}', k), x, env)), None => ps }), end => [] }"
        }
      ],
      "body": "concat(concat(p1, p2), p3)",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-10"
            },
            "a": {
              "fixture": "fx-automation-def-1"
            },
            "at": "automation award.check",
            "s": {
              "fixture": "fx-automation-step-def-1"
            },
            "env": {
              "fields": {},
              "params": [
                "make_record"
              ],
              "roles": [
                "editor",
                "owner",
                "public"
              ]
            }
          },
          "result": []
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-10"
            },
            "a": {
              "fixture": "fx-automation-def-1"
            },
            "at": "automation award.x",
            "s": {
              "action": {
                "branch": {
                  "condition": {
                    "lit": {
                      "int": 1
                    }
                  },
                  "object": "note",
                  "then": "done",
                  "else": "gone"
                }
              },
              "retry": {
                "attempts": 11
              }
            },
            "env": {
