                      ],
                      "condition": null
                    },
                    "editors_manage_people": {
                      "id": "editors_manage_people",
                      "role": "editor",
                      "resource": {
                        "object": "person"
                      },
                      "actions": [
                        "read",
                        "create",
                        "update",
                        "delete"
                      ],
                      "condition": null
                    },
                    "public_reads_people": {
                      "id": "public_reads_people",
                      "role": "public",
                      "resource": {
                        "object": "person"
                      },
                      "actions": [
                        "read"
                      ],
                      "condition": null
                    },
                    "public_reads_published": {
                      "id": "public_reads_published",
                      "role": "public",
                      "resource": {
                        "object": "note"
                      },
                      "actions": [
                        "read"
                      ],
                      "condition": {
                        "cmp": {
                          "op": "eq",
                          "left": {
                            "var": {
                              "scope": "record",
                              "field": "status"
                            }
                          },
                          "right": {
