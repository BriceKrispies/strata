    {
      "id": "scoped-roles-of",
      "description": "The role assignments of a schema that are narrowed by a scope, in the order they were made, none when it holds no table of them (TenantSchema.scoped_roles, D-8403).",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        }
      ],
      "returns": "list<scoped-role>",
      "body": "match schema.scoped-roles { Some(held) => held, None => [] }",
