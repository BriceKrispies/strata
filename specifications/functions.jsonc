// functions.jsonc: the transcribed function layer and its example fixtures.
// A part of the Strata specification; spec.jsonc lists the parts. Generated by scripts/split-spec.mjs
// the first time, edited in place after that. See specifications/README.md.
{
  "functions": [
    {
      "id": "set-of",
      "description": "A BTreeSet<RoleId> as the body language holds it: the items sorted by Unicode scalar values, each once.",
      "params": [
        {
          "name": "items",
          "type": "list<role-id>"
        }
      ],
      "returns": "set<role-id>",
      "body": "fold(r in sortBy(r in items, r), acc = [], if any(a in acc, a == r) then acc else concat(acc, [r]))",
      "examples": [
        {
          "args": {
            "items": [
              "author",
              "public",
              "author"
            ]
          },
          "result": [
            "author",
            "public"
          ]
        },
        {
          "args": {
            "items": []
          },
          "result": []
        }
      ]
    },
    {
      "id": "roles-of",
      "description": "rules.rs roles_of: the roles a principal holds in a tenant, assigned to it directly or through a team (assigned-roles). Everyone but the system holds public. An automation principal automation:<id> holds exactly the run-as roles of its automation and no other, not public and no role of the table of members or of a team (automation-roles; automation.rs, WFL-1527).",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "principal",
          "type": "principal"
        }
      ],
      "returns": "set<role-id>",
      "body": "match principal { system => [], anonymous => ['public'], user(id) => if startsWith(id, 'automation:') then call automation-roles(tenant.schema, id) else call set-of(concat(call assigned-roles(tenant.members, tenant.schema, id), ['public'])) }",
      "examples": [
        {
          "description": "The system holds no role.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-1"
            },
            "principal": "system"
          },
          "result": []
        },
        {
          "description": "Anyone holds public.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-1"
            },
            "principal": "anonymous"
          },
          "result": [
            "public"
          ]
        },
        {
          "description": "publication_template.rs: ann is an author of the gazette.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-1"
            },
            "principal": {
              "user": "user:ann"
            }
          },
          "result": [
            "author",
            "public"
          ]
        },
        {
          "description": "The owner the install made (bundle.rs install_into, CreateTenant).",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-1"
            },
            "principal": {
              "user": "user:admin"
            }
          },
          "result": [
            "owner",
            "public"
          ]
        },
        {
          "description": "A user who is not a member holds only public.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-1"
            },
            "principal": {
              "user": "user:stranger"
            }
          },
          "result": [
            "public"
          ]
        },
        {
          "description": "A member of a team holds the team's roles.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-14",
              "with": {
                "schema.teams": {
                  "desk": {
                    "id": "desk",
                    "label": "Desk",
                    "members": [
                      "alpha:guest"
                    ],
                    "roles": [
                      "editor"
                    ]
                  }
                }
              }
            },
            "principal": {
              "user": "alpha:guest"
            }
          },
          "result": [
            "editor",
            "public"
          ]
        },
        {
          "description": "The automation principal holds its run-as role and not public.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-2"
            },
            "principal": {
              "user": "automation:award"
            }
          },
          "result": [
            "editor"
          ]
        },
        {
          "description": "An automation principal holds no role from the table of members: only its run-as.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-2",
              "with": {
                "members.automation:award": [
                  "owner"
                ]
              }
            },
            "principal": {
              "user": "automation:award"
            }
          },
          "result": [
            "editor"
          ]
        },
        {
          "description": "A removed automation holds no role at all, not even public.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-2"
            },
            "principal": {
              "user": "automation:gone"
            }
          },
          "result": []
        },
        {
          "description": "A suspended automation holds no role.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-2"
            },
            "principal": {
              "user": "automation:frozen"
            }
          },
          "result": []
        },
        {
          "description": "A person whose id merely contains automation: is an ordinary member.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-2"
            },
            "principal": {
              "user": "alpha:automation:x"
            }
          },
          "result": [
            "public"
          ]
        }
      ]
    },
    {
      "id": "policy-applies",
      "description": "The match of rules.rs authorize and may_attempt: the policy names a role held, the action and the resource, where AnyObject covers every Object; the condition aside.",
      "params": [
        {
          "name": "policy",
          "type": "policy-def"
        },
        {
          "name": "roles",
          "type": "set<role-id>"
        },
        {
          "name": "action",
          "type": "action"
        },
        {
          "name": "resource",
          "type": "resource"
        }
      ],
      "returns": "bool",
      "body": "any(r in roles, r == policy.role) && any(a in policy.actions, a == action) && match policy.resource { any-object => match resource { object(_) => true, _ => policy.resource == resource }, _ => policy.resource == resource }",
      "examples": [
        {
          "description": "authors_own_posts covers an author updating a post.",
          "args": {
            "policy": {
              "fixture": "fx-policy-def-1"
            },
            "roles": [
              "author",
              "public"
            ],
            "action": "update",
            "resource": {
              "object": "post"
            }
          },
          "result": true
        },
        {
          "description": "authors_own_posts does not cover create.",
          "args": {
            "policy": {
              "fixture": "fx-policy-def-1"
            },
            "roles": [
              "author",
              "public"
            ],
            "action": "create",
            "resource": {
              "object": "post"
            }
          },
          "result": false
        },
        {
          "description": "A role not held.",
          "args": {
            "policy": {
              "id": "editors_run_posts",
              "role": "editor",
              "resource": {
                "object": "post"
              },
              "actions": [
                "read",
                "create",
                "update",
                "delete"
              ]
            },
            "roles": [
              "author",
              "public"
            ],
            "action": "update",
            "resource": {
              "object": "post"
            }
          },
          "result": false
        },
        {
          "description": "Another object type.",
          "args": {
            "policy": {
              "fixture": "fx-policy-def-2"
            },
            "roles": [
              "public"
            ],
            "action": "read",
            "resource": {
              "object": "author"
            }
          },
          "result": false
        },
        {
          "description": "An AnyObject policy matches any object.",
          "args": {
            "policy": {
              "id": "auditors_read_all",
              "role": "auditor",
              "resource": "any-object",
              "actions": [
                "read"
              ]
            },
            "roles": [
              "auditor",
              "public"
            ],
            "action": "read",
            "resource": {
              "object": "category"
            }
          },
          "result": true
        },
        {
          "description": "An AnyObject policy does not match the schema.",
          "args": {
            "policy": {
              "id": "auditors_read_all",
              "role": "auditor",
              "resource": "any-object",
              "actions": [
                "read"
              ]
            },
            "roles": [
              "auditor",
              "public"
            ],
            "action": "read",
            "resource": "schema"
          },
          "result": false
        }
      ]
    },
    {
      "id": "may-attempt",
      "description": "crates/kernel/src/rules.rs may_attempt: whether some policy of the tenant schema could grant the action, conditions aside, or whether a permission of one of its roles grants the verb on the object type; the owner may do anything. For user interfaces; the decision is authorize.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "principal",
          "type": "principal"
        },
        {
          "name": "action",
          "type": "action"
        },
        {
          "name": "resource",
          "type": "resource"
        }
      ],
      "returns": "bool",
      "let": [
        {
          "name": "roles",
          "expr": "call roles-of(tenant, principal)"
        }
      ],
      "body": "any(r in roles, r == 'owner') || any(g in call effective-permissions(tenant, principal), call grant-allows(g, action, resource)) || any(p in values(tenant.schema.policies), call policy-applies(p, roles, action, resource))",
      "examples": [
        {
          "description": "The owner may manage the schema.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-1"
            },
            "principal": {
              "user": "user:admin"
            },
            "action": "manage",
            "resource": "schema"
          },
          "result": true
        },
        {
          "description": "An author may attempt to update a post, whoever wrote it: the condition is not consulted.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-1"
            },
            "principal": {
              "user": "user:bob"
            },
            "action": "update",
            "resource": {
              "object": "post"
            }
          },
          "result": true
        },
        {
          "description": "An author may not manage the schema.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-1"
            },
            "principal": {
              "user": "user:ann"
            },
            "action": "manage",
            "resource": "schema"
          },
          "result": false
        },
        {
          "description": "Anyone may attempt to read a post.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-1"
            },
            "principal": "anonymous",
            "action": "read",
            "resource": {
              "object": "post"
            }
          },
          "result": true
        },
        {
          "description": "No policy lets the public create a post.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-1"
            },
            "principal": "anonymous",
            "action": "create",
            "resource": {
              "object": "post"
            }
          },
          "result": false
        },
        {
          "description": "The system holds no role, not even public.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-1"
            },
            "principal": "system",
            "action": "read",
            "resource": {
              "object": "author"
            }
          },
          "result": false
        },
        {
          "description": "A permission of the principal's role lets it attempt what no policy does: the editor role holds post:create.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-3",
              "with": {
                "schema.role-permissions.editor.0.object.actions.0": "create"
              }
            },
            "principal": {
              "user": "user:ed"
            },
            "action": "create",
            "resource": {
              "object": "post"
            }
          },
          "result": true
        }
      ]
    },
    {
      "id": "request-text",
      "description": "The \"what\" of rules.rs authorize: format!(\"{action:?} on {resource:?}\"), the Debug forms of Action and Resource.",
      "params": [
        {
          "name": "action",
          "type": "action"
        },
        {
          "name": "resource",
          "type": "resource"
        }
      ],
      "returns": "string",
      "body": "format('{} on {}', match action { read => 'Read', create => 'Create', update => 'Update', delete => 'Delete', manage => 'Manage' }, match resource { object(o) => format('Object(ObjectTypeId(\"{}\"))', o), any-object => 'AnyObject', schema => 'Schema', members => 'Members', ledger{unit} => format('Ledger { unit: {} }', match unit { Some(u) => format('Some(LedgerUnit(\"{}\"))', u), None => 'None' }) })",
      "examples": [
        {
          "args": {
            "action": "update",
            "resource": {
              "object": "post"
            }
          },
          "result": "Update on Object(ObjectTypeId(\"post\"))"
        },
        {
          "args": {
            "action": "manage",
            "resource": "schema"
          },
          "result": "Manage on Schema"
        },
        {
          "args": {
            "action": "read",
            "resource": "any-object"
          },
          "result": "Read on AnyObject"
        },
        {
          "args": {
            "action": "delete",
            "resource": "members"
          },
          "result": "Delete on Members"
        },
        {
          "description": "The ledger of every unit.",
          "args": {
            "action": "read",
            "resource": {
              "ledger": {}
            }
          },
          "result": "Read on Ledger { unit: None }"
        },
        {
          "description": "The ledger of one unit.",
          "args": {
            "action": "read",
            "resource": {
              "ledger": {
                "unit": "points"
              }
            }
          },
          "result": "Read on Ledger { unit: Some(LedgerUnit(\"points\")) }"
        }
      ]
    },
    {
      "id": "record-scope",
      "description": "A record as a record scope of expr-env: its fields and its system attributes, as expr.rs attribute reads them ($created_by only when the record has a creator).",
      "params": [
        {
          "name": "r",
          "type": "record"
        }
      ],
      "returns": "map<string, value>",
      "body": "match r.created-by { Some(p) => insert(base, '$created_by', value.str(p)), None => base }",
      "examples": [
        {
          "args": {
            "r": {
              "id": 1,
              "object": "note",
              "version": 1,
              "created-by": "alpha:writer1",
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "title": {
                  "str": "First"
                },
                "slug": {
                  "str": "first"
                },
                "status": {
                  "str": "draft"
                }
              }
            }
          },
          "result": {
            "$created_at": {
              "time": 5000
            },
            "$created_by": {
              "str": "alpha:writer1"
            },
            "$id": {
              "ref": 1
            },
            "$updated_at": {
              "time": 5000
            },
            "$version": {
              "int": 1
            },
            "slug": {
              "str": "first"
            },
            "status": {
              "str": "draft"
            },
            "title": {
              "str": "First"
            }
          }
        },
        {
          "args": {
            "r": {
              "id": 2,
              "object": "note",
              "version": 1,
              "created-at": 7,
              "updated-at": 7,
              "fields": {
                "title": {
                  "str": "T"
                }
              }
            }
          },
          "result": {
            "$created_at": {
              "time": 7
            },
            "$id": {
              "ref": 2
            },
            "$updated_at": {
              "time": 7
            },
            "$version": {
              "int": 1
            },
            "title": {
              "str": "T"
            }
          }
        }
      ],
      "let": [
        {
          "name": "base",
          "expr": "insert(insert(insert(insert(r.fields, '$id', value.ref(r.id)), '$version', value.int(r.version)), '$created_at', value.time(r.created-at)), '$updated_at', value.time(r.updated-at))"
        }
      ]
    },
    {
      "id": "scope-of",
      "description": "A record scope of the rule environment: no record is null, a record is record-scope of it.",
      "params": [
        {
          "name": "record",
          "type": "option<record>"
        }
      ],
      "returns": "option<map<string, value>>",
      "body": "match record { None => null, Some(r) => call record-scope(r) }",
      "examples": [
        {
          "args": {
            "record": null
          },
          "result": null
        },
        {
          "args": {
            "record": {
              "id": 3,
              "object": "category",
              "version": 1,
              "created-by": "user:ed",
              "created-at": 1767312000000,
              "updated-at": 1767312000000,
              "fields": {}
            }
          },
          "result": {
            "$created_at": {
              "time": 1767312000000
            },
            "$created_by": {
              "str": "user:ed"
            },
            "$id": {
              "ref": 3
            },
            "$updated_at": {
              "time": 1767312000000
            },
            "$version": {
              "int": 1
            }
          }
        }
      ]
    },
    {
      "id": "null-value",
      "description": "Value::Null. The null variant of value is named null, a keyword of the body language, so a body cannot write value.null; it is read as an absent parameter, which the language evaluates to null.",
      "params": [],
      "returns": "value",
      "body": "match eval(tenant-rule-language, expr.param('absent'), expr-env{record: null, old: null, new: null, param: {}, now: value.time(0), principal: value.str(''), has_role: []}) { Ok(x) => x, Err(e) => value.int(0) }",
      "examples": [
        {
          "args": {},
          "result": "null"
        }
      ]
    },
    {
      "id": "deny",
      "description": "A failed check of a policy whose condition did not give true, added to the checks of the policy loop. The need found so far is kept.",
      "params": [
        {
          "name": "acc",
          "type": "policy-progress"
        },
        {
          "name": "rule",
          "type": "string"
        },
        {
          "name": "what",
          "type": "string"
        },
        {
          "name": "outcome",
          "type": "policy-outcome"
        },
        {
          "name": "condition",
          "type": "expr"
        }
      ],
      "returns": "policy-progress",
      "body": "policy-progress{granted: acc.granted, checks: concat(acc.checks, [policy-check{rule, passed: false, what, outcome, condition}]), needed: acc.needed}",
      "examples": [
        {
          "args": {
            "acc": {
              "checks": []
            },
            "rule": "policy:authors_own_posts",
            "what": "Update on Object(ObjectTypeId(\"post\"))",
            "outcome": "is-false",
            "condition": {
              "cmp": {
                "op": "eq",
                "left": {
                  "var": {
                    "scope": "record",
                    "field": "$created_by"
                  }
                },
                "right": "principal"
              }
            }
          },
          "result": {
            "checks": [
              {
                "rule": "policy:authors_own_posts",
                "passed": false,
                "what": "Update on Object(ObjectTypeId(\"post\"))",
                "outcome": "is-false",
                "condition": {
                  "cmp": {
                    "op": "eq",
                    "left": {
                      "var": {
                        "scope": "record",
                        "field": "$created_by"
                      }
                    },
                    "right": "principal"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "policy-step",
      "description": "One applicable policy in the loop of rules.rs authorize: no condition grants; a condition grants when it evaluates to Bool(true); Null fails the check as \"is null\", any other value as \"is false\", an evaluation error as failed. The condition follows a reference through lookup (rule-lookup); when it fails to evaluate and reach is given, the first record it needs that the snapshot does not cover (rule-missing) becomes needed, unless an earlier condition named one.",
      "params": [
        {
          "name": "policy",
          "type": "policy-def"
        },
        {
          "name": "env",
          "type": "expr-env"
        },
        {
          "name": "acc",
          "type": "policy-progress"
        },
        {
          "name": "what",
          "type": "string"
        },
        {
          "name": "lookup",
          "type": "map<string, map<string, map<string, value>>>"
        },
        {
          "name": "reach",
          "type": "option<rule-reach>"
        }
      ],
      "returns": "policy-progress",
      "let": [
        {
          "name": "rule",
          "expr": "format('policy:{}', policy.id)"
        }
      ],
      "body": "match policy.condition { None => policy-progress{granted: policy-check{rule, passed: true, what, outcome: policy-outcome.unconditional}, checks: acc.checks}, Some(c) => match eval(tenant-rule-language, c, env, lookup) { Ok(v) => match v { bool(b) => if b then policy-progress{granted: policy-check{rule, passed: true, what, outcome: policy-outcome.held, condition: c}, checks: acc.checks} else call deny(acc, rule, what, policy-outcome.is-false, c), int(_) => call deny(acc, rule, what, policy-outcome.is-false, c), str(_) => call deny(acc, rule, what, policy-outcome.is-false, c), time(_) => call deny(acc, rule, what, policy-outcome.is-false, c), ref(_) => call deny(acc, rule, what, policy-outcome.is-false, c), list(_) => call deny(acc, rule, what, policy-outcome.is-false, c), _ => call deny(acc, rule, what, policy-outcome.is-null, c) }, Err(_) => let d = call deny(acc, rule, what, policy-outcome.failed, c) in policy-progress{granted: d.granted, checks: d.checks, needed: if acc.needed != null then acc.needed else match reach { Some(r) => call rule-missing(c, r), None => null }} } }",
      "examples": [
        {
          "description": "A policy without a condition grants.",
          "args": {
            "policy": {
              "id": "editors_run_posts",
              "role": "editor",
              "resource": {
                "object": "post"
              },
              "actions": [
                "read",
                "create",
                "update",
                "delete"
              ]
            },
            "env": {
              "fixture": "fx-expr-env-1",
              "with": {
                "principal": {
                  "str": "user:ed"
                },
                "has_role": [
                  "editor",
                  "public"
                ]
              }
            },
            "acc": {
              "checks": []
            },
            "what": "Update on Object(ObjectTypeId(\"post\"))",
            "lookup": {}
          },
          "result": {
            "granted": {
              "rule": "policy:editors_run_posts",
              "passed": true,
              "what": "Update on Object(ObjectTypeId(\"post\"))",
              "outcome": "unconditional"
            },
            "checks": []
          }
        },
        {
          "description": "authors_own_posts holds for the creator.",
          "args": {
            "policy": {
              "fixture": "fx-policy-def-1"
            },
            "env": {
              "fixture": "fx-expr-env-1",
              "with": {
                "principal": {
                  "str": "user:ann"
                },
                "has_role": [
                  "author",
                  "public"
                ]
              }
            },
            "acc": {
              "checks": []
            },
