                          "left": {
                            "var": {
                              "scope": "record",
                              "field": "$created_by"
                            }
                          },
                          "right": "principal"
                        }
                      }
                    },
                    "writers_read_notes": {
                      "id": "writers_read_notes",
                      "role": "writer",
                      "resource": {
