              "ref": 1
            }
          },
          "result": true
        },
        {
          "args": {
            "ty": "str",
            "x": {
              "str": "a"
            }
          },
          "result": true
        },
        {
          "args": {
            "ty": "str",
            "x": "null"
          },
          "result": false
        },
        {
