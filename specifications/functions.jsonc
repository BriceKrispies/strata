    {
      "id": "ledger-removal-step",
      "description": "ledger.rs check_removals, one removal: the snapshot covers the need or the change is InsufficientState; an account that names the unit or the pool (used) is StillReferenced with the failed check ledger:in-use; otherwise the check passes.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "wanted",
          "type": "need"
        },
        {
          "name": "what",
          "type": "string"
        },
        {
          "name": "used",
          "type": "bool"
        }
      ],
      "returns": "draft",
      "errors": "rejection",
      "body": "if !call covers(d.coverage, wanted) then fail(rejection.rejected(call insufficient(wanted))) else if used then fail(rejection.rejected(domain-error{kind: error-kind.still-referenced, message: format('{} is named by an account and is not removed', what), evidence: concat(d.evidence, [check{rule: 'ledger:in-use', passed: false, detail: format('{} is named by an account and is not removed', what)}])})) else draft{tenant: d.tenant, ctx: d.ctx, coverage: d.coverage, ops: d.ops, events: d.events, effects: d.effects, evidence: concat(d.evidence, [check{rule: 'ledger:in-use', passed: true, detail: format('no account names {}', what)}]), next-record: d.next-record}",
