    {
      "id": "operation-problems",
      "description": "definitions.rs operation_problems (D-6546 to D-6549, OPR-1549): the problems of each tenant operation in id order.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "roles",
          "type": "list<role-id>"
        }
      ],
      "returns": "list<string>",
      "body": "fold(op in values(call operations-of(schema)), ps = [], concat(ps, call operation-def-problems(schema, roles, op)))",
      "examples": [
        {
