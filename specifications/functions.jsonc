    {
      "id": "fx-list-schema-change-1",
      "type": "list<schema-change>",
      "value": [
        {
          "define-automation": {
            "id": "award",
            "label": "Award",
            "run-as": {
              "roles": [
                "editor"
              ]
            },
            "start": "make",
            "steps": {
              "make": {
                "action": {
                  "create-record": {
                    "object": "note",
                    "fields": {
                      "title": {
                        "param": "owner"
                      },
                      "status": {
                        "lit": {
                          "str": "draft"
                        }
                      }
                    }
                  }
                },
                "next": "check"
              },
              "check": {
                "action": {
                  "branch": {
                    "condition": {
                      "cmp": {
                        "op": "eq",
                        "left": {
                          "var": {
                            "scope": "record",
                            "field": "status"
                          }
                        },
                        "right": {
                          "lit": {
                            "str": "draft"
                          }
                        }
                      }
                    },
                    "object": "note",
                    "record": {
                      "param": "make_record"
                    },
                    "then": "done",
                    "else": "done"
                  }
                }
              },
              "done": {
                "action": "end"
              }
            }
          }
        }
      ],
      "description": "Example value of type list<schema-change>, shared by 2 example argument(s) (WG-4963)."
