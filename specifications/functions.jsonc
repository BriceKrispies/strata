    {
      "id": "team-of",
      "description": "transition.rs team_of: a team of the tenant, or InvalidIntent \"no team <id>\".",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "team",
          "type": "team-id"
        }
      ],
      "returns": "team-def",
      "errors": "rejection",
      "body": "match get(call teams-of(d.tenant.schema), team) { Some(t) => t, None => fail(call draft-reject(d.evidence, error-kind.invalid-intent, format('no team {}', team))) }",
      "examples": [
        {
