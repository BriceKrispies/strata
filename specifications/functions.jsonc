                    "label": "Editor"
                  },
                  "owner": {
                    "id": "owner",
                    "label": "Owner"
                  },
                  "public": {
                    "id": "public",
                    "label": "Everyone"
                  },
                  "writer": {
                    "id": "writer",
                    "label": "Writer"
                  }
                },
                "policies": {},
                "workflows": {},
                "queries": {},
                "views": {}
              },
              "members": {
                "alpha:editor": [
                  "editor"
                ],
                "alpha:owner": [
                  "owner"
                ],
                "alpha:writer1": [
                  "writer"
                ],
                "alpha:writer2": [
                  "writer"
                ]
              },
              "records": {}
            },
            "ctx": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:owner"
              },
              "now": 5000,
              "correlation": "test-5000"
            },
            "coverage": "complete",
            "ops": [
              {
                "put-schema": {
                  "version": 2,
                  "objects": {},
                  "roles": {
                    "editor": {
                      "id": "editor",
                      "label": "Editor"
                    },
                    "owner": {
                      "id": "owner",
                      "label": "Owner"
                    },
                    "public": {
                      "id": "public",
                      "label": "Everyone"
                    },
                    "writer": {
                      "id": "writer",
                      "label": "Writer"
                    }
                  },
                  "teams": {
