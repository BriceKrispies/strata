    {
      "id": "setting-refusal",
      "description": "settings.rs refuse: a refusal of a setting write that names the check that failed after the checks that passed; unlike a refusal of the draft it adds no intent:<kind> check.",
      "params": [
        {
          "name": "passed",
          "type": "list<check>"
        },
        {
          "name": "kind",
          "type": "error-kind"
        },
        {
          "name": "rule",
          "type": "string"
        },
        {
          "name": "message",
          "type": "string"
        }
      ],
      "returns": "rejection",
      "body": "rejection.rejected(domain-error{kind, message, evidence: concat(passed, [check{rule, passed: false, detail: message}])})",
      "examples": [
        {
          "args": {
            "passed": [
              {
                "rule": "a",
                "passed": true,
                "detail": "x"
              }
            ],
            "kind": "invalid-intent",
            "rule": "setting:level_is_open",
            "message": "closed"
          },
          "result": {
            "rejected": {
              "kind": "invalid-intent",
              "message": "closed",
              "evidence": [
                {
                  "rule": "a",
                  "passed": true,
                  "detail": "x"
                },
                {
                  "rule": "setting:level_is_open",
                  "passed": false,
                  "detail": "closed"
                }
              ],
              "missing": null
            }
          }
        }
      ]
    },
    {
      "id": "setting-caller",
      "description": "settings.rs write_setting, the first check: only a signed-in person writes a setting (Unauthorized, setting:caller_is_a_person); the person is the caller.",
      "params": [
        {
          "name": "ctx",
          "type": "context"
        }
      ],
      "returns": "principal-id",
