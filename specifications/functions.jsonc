                "updated-at": 1800000000000,
                "fields": {
                  "author": {
                    "ref": 2
                  },
                  "title": {
                    "str": "Hello"
                  }
                }
              }
            },
            "s": "record"
          },
          "result": {
            "id": 7,
            "object": "post",
            "version": 1,
            "created-by": "user:ann",
            "created-at": 1800000000000,
            "updated-at": 1800000000000,
            "fields": {
              "author": {
                "ref": 2
              },
              "title": {
                "str": "Hello"
              }
            }
          }
        },
        {
          "args": {
            "subject": {
              "new": {
                "id": 7,
                "object": "post",
                "version": 1,
                "created-by": "user:ann",
                "created-at": 1800000000000,
                "updated-at": 1800000000000,
                "fields": {
                  "author": {
                    "ref": 2
                  },
                  "title": {
                    "str": "Hello"
                  }
                }
              }
            },
            "s": "old"
          },
          "result": null
        },
        {
          "args": {
            "subject": {
              "old": {
                "id": 7,
