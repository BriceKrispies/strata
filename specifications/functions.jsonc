    {
      "id": "require-operation-powers",
      "description": "transition.rs require_operation_powers (D-6547, OPR-1547): the definer of a tenant operation holds every power its steps use (operation-lacks); the check operation:<id>:definer_powers is evidence, and a definer who lacks one is refused as Unauthorized naming what it lacks.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "op",
          "type": "tenant-operation-def"
        }
      ],
      "returns": "draft",
      "errors": "rejection",
      "let": [
        {
          "name": "lacking",
          "expr": "call operation-lacks(d.tenant, d.ctx.principal, op)"
        },
        {
          "name": "rule",
          "expr": "format('operation:{}:definer_powers', op.id)"
        },
        {
          "name": "detail",
          "expr": "fold(l in lacking, acc = '', if acc == '' then l else format('{}, {}', acc, l))"
        }
      ],
      "body": "if lacking == [] then draft{tenant: d.tenant, ctx: d.ctx, coverage: d.coverage, ops: d.ops, events: d.events, effects: d.effects, evidence: concat(d.evidence, [check{rule, passed: true, detail: 'the definer holds every power the steps use'}]), next-record: d.next-record} else fail(call draft-reject(concat(d.evidence, [check{rule, passed: false, detail}]), error-kind.unauthorized, format('may not define operation {}: lacks {}', op.id, detail)))",
