    {
      "id": "ledger-limit-checks",
      "description": "ledger.rs check_limits: the evidence of the draft with the checks of the limits of single accounts among the changes, in order (ledger-limit-step, at most 10000 held, LDG-1550), or the refusal of the first change that fails. The limits of a unit are not checked here.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "changes",
          "type": "list<schema-change>"
        }
      ],
      "returns": "list<check>",
      "errors": "rejection",
      "body": "let walk = fold(c in changes, acc = ledger-limit-walk{evidence: d.evidence}, try call ledger-limit-step(d, acc, c, 10000)) in walk.evidence",
      "examples": [
        {
          "description": "No change: the evidence of the draft.",
          "args": {
            "d": {
              "fixture": "fx-draft-28",
              "with": {
                "evidence": [
                  {
                    "rule": "a",
                    "passed": true,
                    "detail": "x"
                  }
                ]
              }
            },
            "changes": []
          },
          "result": [
            {
              "rule": "a",
              "passed": true,
              "detail": "x"
            }
          ]
        },
        {
          "description": "The limits of single accounts are not in the snapshot: the first change needs them.",
          "args": {
            "d": {
              "fixture": "fx-draft-28",
              "with": {
                "coverage": {
                  "partial": []
                }
              }
            },
            "changes": [
              {
                "set-ledger-limit": {
                  "unit": "credits",
                  "owner": {
                    "principal": {
                      "principal": "alpha:ed"
                    }
                  },
                  "cap": 9
                }
              }
            ]
          },
          "error": {
            "rejected": {
              "kind": "insufficient-state",
              "message": "the snapshot does not cover Ledger(Limits)",
              "evidence": [
                {
                  "rule": "coverage",
                  "passed": false,
                  "detail": "Ledger(Limits)"
                }
              ],
              "missing": {
                "ledger": "limits"
              }
            }
          }
        },
        {
          "description": "Two limits of accounts count each after the one before it.",
          "args": {
            "d": {
              "fixture": "fx-draft-28",
              "with": {
                "tenant.ledger": {
                  "accounts": {},
                  "entries": {},
                  "limits": [
                    {
                      "unit": "credits",
                      "owner": {
                        "principal": {
                          "principal": "alpha:ed"
                        }
                      },
                      "scope": "promo",
                      "cap": 5
                    }
                  ]
                }
              }
            },
            "changes": [
              {
                "set-ledger-limit": {
                  "unit": "credits",
                  "owner": {
                    "principal": {
                      "principal": "alpha:ed"
                    }
                  },
                  "cap": 9
                }
              },
              {
                "set-ledger-limit": {
                  "unit": "credits",
                  "owner": {
                    "principal": {
                      "principal": "alpha:kim"
                    }
                  },
                  "cap": 2
                }
              }
            ]
          },
          "result": [
            {
              "rule": "ledger:account-limits",
              "passed": true,
              "detail": "2 account limit(s) after the change"
            },
            {
              "rule": "ledger:account-limits",
              "passed": true,
              "detail": "3 account limit(s) after the change"
            }
          ]
        }
      ]
    },
    {
      "id": "ledger-limit-ops",
      "description": "ledger.rs limit_ops: the delta operations of the limits of single accounts among the changes, in order (WG-5172): setting one puts it, removing one removes it from the ledger's own storage in the commit of the schema change. The limits of a unit stay in the schema.",
      "params": [
        {
          "name": "changes",
          "type": "list<schema-change>"
        }
      ],
      "returns": "list<delta-op>",
      "body": "fold(c in changes, acc = [], match c { set-ledger-limit(l) => match l.owner { Some(_) => concat(acc, [delta-op.ledger(ledger-delta.put-limit(l))]), None => acc }, remove-ledger-definition(r) => match r { limit{unit, owner, scope} => match owner { Some(o) => concat(acc, [delta-op.ledger(ledger-delta.remove-limit{owner: o, unit, scope: match scope { Some(q) => q, None => '' }})]), None => acc }, _ => acc }, _ => acc })",
      "examples": [
        {
          "description": "No change: no operation.",
          "args": {
            "changes": []
          },
          "result": []
        },
        {
          "description": "The limit of an account is put, and the limit of a unit is not.",
          "args": {
            "changes": [
              {
                "set-ledger-limit": {
                  "unit": "credits",
                  "owner": {
                    "principal": {
                      "principal": "alpha:ed"
                    }
                  },
                  "cap": 9
                }
              },
              {
                "set-ledger-limit": {
                  "unit": "credits",
                  "floor": 0
                }
              }
            ]
          },
          "result": [
            {
              "ledger": {
                "put-limit": {
                  "unit": "credits",
                  "owner": {
                    "principal": {
                      "principal": "alpha:ed"
                    }
                  },
                  "cap": 9
                }
              }
            }
          ]
        },
        {
          "description": "The limit of an account is removed, and the limit of a unit and a unit are not.",
          "args": {
            "changes": [
              {
                "remove-ledger-definition": {
                  "limit": {
                    "unit": "credits",
                    "owner": {
                      "principal": {
                        "principal": "alpha:ed"
                      }
                    },
                    "scope": "promo"
                  }
                }
              },
              {
                "remove-ledger-definition": {
                  "limit": {
                    "unit": "credits"
                  }
                }
              },
              {
                "remove-ledger-definition": {
                  "unit": {
                    "unit": "credits"
                  }
                }
              }
            ]
          },
          "result": [
            {
              "ledger": {
                "remove-limit": {
                  "owner": {
                    "principal": {
                      "principal": "alpha:ed"
                    }
                  },
                  "unit": "credits",
                  "scope": "promo"
                }
              }
            }
          ]
        },
        {
          "description": "A limit removed with no scope names the empty scope.",
          "args": {
            "changes": [
              {
                "remove-ledger-definition": {
                  "limit": {
                    "unit": "credits",
                    "owner": {
                      "principal": {
                        "principal": "alpha:ed"
                      }
                    }
                  }
                }
              }
            ]
          },
          "result": [
            {
              "ledger": {
                "remove-limit": {
                  "owner": {
                    "principal": {
                      "principal": "alpha:ed"
                    }
                  },
                  "unit": "credits",
                  "scope": ""
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "ledger-removal-check",
      "description": "ledger.rs check_removals (LDG-1549, LDG-1550, D-6554, WG-5172): first the limits of single accounts among the changes (ledger-limit-checks), then a unit or a pool that an account names is not removed. For each removal of a unit or a pool, in order: the snapshot must cover the need (unit-used, pool-used), or the change is InsufficientState naming it; an account that names it is StillReferenced \"ledger unit <id> is named by an account and is not removed\" with the failed check ledger:in-use after the evidence so far (no intent:<kind> check); otherwise ledger:in-use passes with \"no account names ledger unit <id>\". The accounts are those of the snapshot.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "changes",
          "type": "list<schema-change>"
        }
      ],
      "returns": "draft",
      "errors": "rejection",
      "let": [
        {
          "name": "accounts",
          "expr": "match d.tenant.ledger { Some(l) => values(l.accounts), None => [] }"
        }
      ],
      "body": "let evidence = try call ledger-limit-checks(d, changes) in let d1 = draft{tenant: d.tenant, ctx: d.ctx, coverage: d.coverage, ops: d.ops, events: d.events, effects: d.effects, evidence: evidence, next-record: d.next-record} in fold(c in changes, acc = d1, match c { remove-ledger-definition(r) => match r { unit{unit} => try call ledger-removal-step(acc, need.ledger(ledger-need.unit-used{unit}), format('ledger unit {}', unit), any(a in accounts, a.unit == unit)), pool{pool} => try call ledger-removal-step(acc, need.ledger(ledger-need.pool-used{pool}), format('ledger pool {}', pool), any(a in accounts, match a.owner { Some(o) => match o { pool{pool: p} => p == pool, _ => false }, None => false })), limit => acc }, _ => acc })",
      "examples": [
