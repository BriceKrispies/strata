              "id": "branchy",
              "role": "writer",
              "resource": "any-object",
              "actions": [
                "delete"
              ],
              "condition": {
                "if": {
                  "condition": {
                    "lit": {
                      "bool": true
                    }
                  },
                  "then": {
                    "lit": {
                      "bool": true
                    }
                  },
                  "else": {
                    "cmp": {
                      "op": "eq",
                      "left": {
                        "var": {
                          "scope": "record",
                          "field": "status"
                        }
                      },
                      "right": {
                        "lit": {
                          "str": "x"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
