    {
      "id": "unique-duplicates",
      "description": "transition.rs plan_migration, the check of CMS-1556: for each define-unique change, in order, on an object type the current schema already has, the constraint as the working copy holds it is checked against the records of the type (duplicate-check); the first pair found, as a failed check, or none.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "coverage",
          "type": "coverage"
        },
        {
          "name": "current",
          "type": "tenant-schema"
        },
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "changes",
          "type": "list<schema-change>"
        }
      ],
      "returns": "list<check>",
      "errors": "rejection",
      "body": "fold(c in changes, found = [], if found != [] then found else match c { define-unique{object, unique} => if get(current.objects, object) == null then found else match get(schema.objects, object) { Some(o) => match get(call uniques-of(o), unique.id) { Some(u) => call duplicate-check(try call lookup-all(tenant, coverage, object), object, u), None => found }, None => found }, _ => found })",
      "examples": [
        {
          "description": "Two records already share the values (CMS-1556).",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-11"
            },
            "coverage": "complete",
            "current": {
              "fixture": "fx-tenant-schema-21"
            },
            "schema": {
              "fixture": "fx-tenant-schema-22"
            },
            "changes": [
              {
                "define-unique": {
                  "object": "note",
                  "unique": {
                    "id": "title_status",
                    "fields": [
                      "title",
                      "status"
                    ],
                    "message": "One note per title and status."
                  }
                }
              }
            ]
          },
          "result": [
            {
              "rule": "unique:note.title_status",
              "passed": false,
              "detail": "records 1 and 2 have the same values in title, status"
            }
          ]
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-21"
            },
            "coverage": "complete",
            "current": {
              "fixture": "fx-tenant-schema-21"
            },
            "schema": {
              "fixture": "fx-tenant-schema-22"
            },
            "changes": [
              {
                "define-unique": {
                  "object": "note",
                  "unique": {
                    "id": "title_status",
                    "fields": [
                      "title",
                      "status"
                    ],
                    "message": "One note per title and status."
                  }
                }
              }
            ]
          },
          "result": []
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-11"
            },
            "coverage": {
              "partial": []
            },
            "current": {
              "fixture": "fx-tenant-schema-21"
            },
            "schema": {
              "fixture": "fx-tenant-schema-22"
            },
            "changes": [
              {
                "define-unique": {
                  "object": "note",
                  "unique": {
                    "id": "title_status",
                    "fields": [
                      "title",
                      "status"
                    ],
                    "message": "One note per title and status."
                  }
                }
              }
            ]
          },
          "error": {
            "rejected": {
              "kind": "insufficient-state",
              "message": "the snapshot does not cover AllOf(ObjectTypeId(\"note\"))",
              "evidence": [
                {
                  "rule": "coverage",
                  "passed": false,
                  "detail": "AllOf(ObjectTypeId(\"note\"))"
                }
              ],
              "missing": {
                "all-of": "note"
              }
            }
          }
        },
        {
          "description": "An object type the change itself defines has no records to check.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-11"
            },
            "coverage": "complete",
            "current": {
              "fixture": "fx-tenant-schema-23"
            },
            "schema": {
              "fixture": "fx-tenant-schema-22"
            },
            "changes": [
              {
                "define-unique": {
                  "object": "note",
                  "unique": {
                    "id": "title_status",
                    "fields": [
                      "title",
                      "status"
                    ],
                    "message": "One note per title and status."
                  }
                }
              }
            ]
          },
          "result": []
        },
        {
          "description": "Only define-unique changes are checked; the first pair stops the search.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-11"
            },
            "coverage": "complete",
