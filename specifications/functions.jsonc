    {
      "id": "automation-def-problems",
      "description": "definitions.rs automation_problems, one automation: an id taken by a field workflow, more than fifty steps, an unknown start step, each run-as role the schema does not declare or that is public, a run key that does not check, the problems of each step in name order (automation-step-problems), and, when the start step exists, each step that cannot be reached from it.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "roles",
          "type": "list<role-id>"
        },
        {
          "name": "a",
          "type": "automation-def"
        }
      ],
      "returns": "list<string>",
      "let": [
        {
          "name": "at",
          "expr": "format('automation {}', a.id)"
        },
        {
          "name": "p1",
          "expr": "if get(schema.workflows, a.id) == null then [] else [format('{}: the id is taken by a field workflow', at)]"
        },
        {
          "name": "p2",
          "expr": "if length(keys(a.steps)) > 50 then [format('{}: {} steps is more than the maximum of 50', at, length(keys(a.steps)))] else []"
        },
        {
          "name": "has-start",
          "expr": "get(a.steps, a.start) != null"
        },
        {
          "name": "p3",
          "expr": "if has-start then [] else [format('{}: unknown start step {}', at, a.start)]"
        },
        {
          "name": "p4",
          "expr": "fold(r in a.run-as.roles, ps = [], concat(concat(ps, if any(k in roles, k == r) then [] else [format('{}: unknown role {}', at, r)]), if r == 'public' then [format('{}: everyone already holds public', at)] else []))"
        },
        {
          "name": "env",
          "expr": "expr-check-env{fields: {}, params: call automation-params(a), roles}"
        },
        {
          "name": "p5",
          "expr": "match a.run-key { Some(k) => call expr-problem(at, 'run key', k, env), None => [] }"
        },
        {
          "name": "p6",
          "expr": "fold(n in keys(a.steps), ps = [], match get(a.steps, n) { Some(s) => concat(ps, call automation-step-problems(schema, a, format('{}.{}', at, n), s, env)), None => ps })"
        },
        {
          "name": "reached",
          "expr": "call reachable-steps(a)"
        },
        {
          "name": "p7",
          "expr": "if has-start then fold(n in keys(a.steps), ps = [], if any(r in reached, r == n) then ps else concat(ps, [format('{}.{}: cannot be reached from the start step', at, n)])) else []"
        }
      ],
      "body": "concat(concat(concat(concat(concat(concat(p1, p2), p3), p4), p5), p6), p7)",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-10"
            },
            "roles": [
              "editor",
              "owner",
              "public"
            ],
            "a": {
              "fixture": "fx-automation-def-1"
            }
          },
          "result": []
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-10"
            },
            "roles": [
              "editor",
              "owner",
              "public"
            ],
            "a": {
              "fixture": "fx-automation-def-1",
              "with": {
                "id": "note_status",
                "run-as.roles": [
                  "ghost",
                  "public"
                ],
                "start": "begin",
                "steps.lost": {
                  "action": "end"
                },
                "run-key": {
                  "param": "nope"
                }
              }
            }
          },
          "result": [
            "automation note_status: the id is taken by a field workflow",
            "automation note_status: unknown start step begin",
            "automation note_status: unknown role ghost",
            "automation note_status: everyone already holds public",
            "automation note_status: run key: undeclared parameter nope"
          ]
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-10"
            },
            "roles": [
              "editor",
              "owner",
              "public"
            ],
            "a": {
              "fixture": "fx-automation-def-1",
              "with": {
                "steps.lost": {
                  "action": "end"
                }
              }
            }
          },
          "result": [
            "automation award.lost: cannot be reached from the start step"
          ]
        }
      ]
    },
    {
      "id": "automation-problems",
      "description": "definitions.rs automation_problems (D-6520 to D-6535, INT-1522, CT-792): the problems of each automation in id order.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "roles",
          "type": "list<role-id>"
        }
      ],
      "returns": "list<string>",
      "body": "fold(a in values(call automations-of(schema)), ps = [], concat(ps, call automation-def-problems(schema, roles, a)))",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-9"
            },
            "roles": [
              "editor",
              "owner",
              "public"
            ]
          },
          "result": []
        }
      ]
    },
    {
      "id": "operation-step-id",
      "description": "definitions.rs step_id: the id of a step of a tenant operation.",
      "params": [
        {
          "name": "step",
          "type": "tenant-operation-step"
        }
      ],
      "returns": "string",
      "body": "match step { create-record{id} => id, update-record{id} => id, delete-record{id} => id, post-ledger{id} => id, reverse-ledger{id} => id, find-record{id} => id, branch{id} => id, write-setting{id} => id }",
      "examples": [
        {
          "args": {
            "step": {
              "create-record": {
                "id": "copy",
                "object": "note",
                "fields": {
                  "title": {
                    "var": {
                      "scope": "record",
                      "field": "title"
                    }
                  },
                  "status": {
                    "lit": {
                      "str": "draft"
                    }
                  }
                }
              }
            }
          },
          "result": "copy"
        },
        {
          "args": {
            "step": {
              "delete-record": {
                "id": "drop",
                "object": "note",
                "record": {
                  "param": "note"
                }
              }
            }
          },
          "result": "drop"
        },
        {
          "args": {
            "step": {
              "post-ledger": {
                "id": "count",
                "owner": "invoker",
                "unit": "points",
                "scope": null,
                "amount": {
                  "lit": {
                    "int": 1
                  }
                },
                "reason": "r"
              }
            }
          },
          "result": "count"
        }
      ]
    },
    {
      "id": "operation-step-problems",
      "description": "definitions.rs operation_problems, one step: an id that is not a name, an id equal to an input name, the fields of a record step (written-problems), then its record, or the owner, scope and amount of a posting, that do not check. A posting step names a unit the tenant declares (definitions.rs ledger_unit_reference).",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "at",
          "type": "string"
        },
        {
          "name": "inputs",
          "type": "list<string>"
        },
        {
          "name": "step",
          "type": "tenant-operation-step"
        },
        {
          "name": "env",
          "type": "expr-check-env"
        }
      ],
      "returns": "list<string>",
      "let": [
        {
          "name": "id",
          "expr": "call operation-step-id(step)"
        },
        {
          "name": "sat",
          "expr": "format('{}.{}', at, id)"
        },
        {
          "name": "p1",
          "expr": "concat(if call is-param-name(id) then [] else [format('{}: step {:?} is not a name', at, id)], if any(i in inputs, i == id) then [format('{}: step {} has the name of an input', at, id)] else [])"
        }
      ],
      "body": "concat(p1, match step { create-record{object, fields} => call written-problems(schema, sat, object, fields, env), update-record{object, record, fields} => concat(call written-problems(schema, sat, object, fields, env), call expr-problem(sat, 'record', record, env)), delete-record{object, record} => concat(call written-problems(schema, sat, object, {}, env), call expr-problem(sat, 'record', record, env)), post-ledger{owner, scope, amount, unit, reference} => concat(concat(concat(concat(match owner { principal{principal: who} => call expr-problem(sat, 'owner', who, env), _ => [] }, match scope { Some(x) => call expr-problem(sat, 'scope', x, env), None => [] }), call expr-problem(sat, 'amount', amount, env)), if get(call ledger-of(schema).units, unit) == null then [format('{}: names ledger unit {}, which the tenant does not declare', sat, unit)] else []), match reference { Some(x) => call expr-problem(sat, 'reference', x, env), None => [] }), reverse-ledger{reference} => call expr-problem(sat, 'reference', reference, env), find-record => [], branch{test} => match test { found{binding} => [], condition{expr} => call expr-problem(sat, 'condition', expr, env) }, write-setting{value} => call expr-problem(sat, 'value', value, env) })",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-10"
            },
            "at": "operation redeem",
            "inputs": [
              "note"
            ],
            "step": {
              "create-record": {
                "id": "note",
                "object": "note",
                "fields": {
                  "title": {
                    "param": "copy"
                  }
                }
              }
            },
            "env": {
              "fields": {},
              "params": [
                "note"
              ],
              "roles": [
                "editor",
                "owner",
                "public"
              ]
            }
          },
          "result": [
            "operation redeem: step note has the name of an input",
            "operation redeem.note: title: undeclared parameter copy"
          ]
        },
        {
          "description": "A delete step whose record does not check.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-10"
            },
            "at": "operation o",
            "inputs": [
              "note"
            ],
            "step": {
              "delete-record": {
                "id": "drop",
                "object": "note",
                "record": {
                  "param": "gone"
                }
              }
            },
            "env": {
              "fields": {},
              "params": [
                "note"
              ],
              "roles": [
                "editor",
                "owner",
                "public"
              ]
            }
          },
          "result": [
            "operation o.drop: record: undeclared parameter gone"
          ]
        },
        {
          "description": "A posting to a principal, in a scope.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-24"
            },
            "at": "operation o",
            "inputs": [
              "note"
            ],
            "step": {
              "post-ledger": {
                "id": "Count",
                "owner": {
                  "principal": {
                    "principal": {
