    {
      "id": "define-team",
      "description": "transition.rs define_team: define a team, or relabel one and keep its members and roles. Managing members is authorised (Manage on Members); a blank label is InvalidIntent.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "team",
          "type": "team-id"
        },
        {
          "name": "label",
          "type": "string"
        }
      ],
      "returns": "decided",
      "errors": "rejection",
      "let": [
        {
          "name": "d1",
          "expr": "try call require(d, action.manage, resource.members, subject{})"
        }
      ],
      "body": "if trim(label) == '' then fail(call draft-reject(d1.evidence, error-kind.invalid-intent, 'a team needs a label')) else decided{draft: call put-team(d1, d1.tenant.schema, match get(call teams-of(d1.tenant.schema), team) { Some(t) => team-def{id: t.id, label, members: t.members, roles: t.roles}, None => team-def{id: team, label, members: [], roles: []} }), output: output.member}",
      "examples": [
        {
          "description": "Relabelling a team keeps its members and roles.",
          "args": {
            "d": {
              "fixture": "fx-draft-17"
            },
            "team": "desk",
            "label": "News desk"
          },
          "result": {
            "draft": {
              "tenant": {
                "id": "alpha",
