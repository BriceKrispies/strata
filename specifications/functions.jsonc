    {
      "id": "setting-revisions-of",
      "description": "The revision of each setting a tenant state holds; none when it holds no setting values.",
      "params": [
        {
          "name": "s",
          "type": "tenant-state"
        }
      ],
      "returns": "map<setting-id, u64>",
      "body": "match s.setting-values { Some(v) => v.revisions, None => {} }",
      "examples": [
        {
          "args": {
            "s": {
              "fixture": "fx-tenant-state-32"
            }
          },
          "result": {}
        },
        {
          "args": {
