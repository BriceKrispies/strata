                            "field": "slug"
                          }
                        },
                        "right": {
                          "lit": {
                            "str": "north"
                          }
                        }
                      }
                    }
                  },
                  {
                    "principal": "alpha:bob",
                    "role": "editor",
                    "object": "note",
                    "scope": {
                      "cmp": {
                        "op": "eq",
                        "left": {
                          "var": {
                            "scope": "record",
                            "field": "slug"
                          }
                        },
                        "right": {
                          "lit": {
                            "str": "south"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            },
            "id": "alpha:bob"
          },
          "result": [
            {
              "principal": "alpha:bob",
              "role": "editor",
              "object": "note",
              "scope": {
                "cmp": {
                  "op": "eq",
                  "left": {
                    "var": {
                      "scope": "record",
                      "field": "slug"
                    }
                  },
                  "right": {
                    "lit": {
                      "str": "south"
                    }
                  }
                }
              }
            }
