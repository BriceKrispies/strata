    {
      "id": "kernel-transition",
      "description": "crates/kernel/src/transition.rs transition as contract decide-intent (CT-001) takes it: intent-decision with the context and the printed expressions (texts, an input of the contract until the function language can print an expression, WG-4957).",
      "params": [
        {
          "name": "state",
          "type": "state"
        },
        {
          "name": "intent",
          "type": "intent"
        },
        {
          "name": "context",
          "type": "context"
        }
      ],
      "returns": "transition-result",
      "errors": "rejection",
      "body": "try call intent-decision(state, intent, context)",
      "examples": [
        {
          "description": "behaviour.rs only_the_system_creates_tenants_and_a_tenant_is_created_once.",
          "args": {
            "state": {
              "tenant-id": "gamma",
              "tenant": null,
              "coverage": "complete"
            },
            "intent": {
              "create-tenant": {
                "name": "Gamma",
                "owner": "gamma:owner"
              }
            },
            "context": {
              "tenant": "gamma",
              "principal": "system",
              "session": null,
              "now": 5001,
              "correlation": "test-5001"
            }
          },
          "result": {
            "delta": {
              "tenant": "gamma",
              "base-revision": null,
              "new-revision": 1,
              "next-record": 1,
              "event-seq": 1,
              "ops": [
                {
                  "create-tenant": {
                    "name": "Gamma"
                  }
                },
                {
                  "put-schema": {
                    "version": 1,
                    "objects": {},
                    "roles": {
                      "owner": {
                        "id": "owner",
                        "label": "Owner"
                      },
                      "public": {
                        "id": "public",
                        "label": "Everyone"
                      }
                    },
                    "policies": {},
                    "workflows": {},
                    "queries": {},
                    "views": {}
                  }
                },
                {
                  "put-member": {
                    "principal": "gamma:owner",
                    "roles": [
                      "owner"
                    ]
                  }
                }
              ]
            },
            "events": [
              {
                "tenant": "gamma",
                "seq": 1,
                "revision": 1,
                "at": 5001,
                "principal": "system",
                "correlation": "test-5001",
                "body": {
                  "tenant-created": {
                    "name": "Gamma"
                  }
                }
              }
            ],
            "effects": [
              {
                "publish": {
                  "seq": 1
                }
              }
            ],
            "evidence": [
              {
                "rule": "policy:builtin_system",
                "passed": true,
                "detail": "CreateTenant"
              }
            ],
            "output": "tenant"
          }
        },
        {
          "args": {
            "state": {
              "tenant-id": "gamma",
              "tenant": null,
              "coverage": "complete"
            },
            "intent": {
              "create-tenant": {
                "name": "Gamma",
                "owner": "gamma:owner"
              }
            },
            "context": {
              "tenant": "alpha",
              "principal": "system",
              "session": null,
              "now": 5001,
              "correlation": "test-5001"
            }
          },
          "error": {
            "rejected": {
              "kind": "tenant-mismatch",
              "message": "snapshot is of gamma, context names alpha",
              "evidence": [
                {
                  "rule": "tenant:snapshot_matches_context",
                  "passed": false,
                  "detail": "snapshot is of gamma, context names alpha"
                }
              ],
              "missing": null
            }
          }
        }
      ]
    },
    {
