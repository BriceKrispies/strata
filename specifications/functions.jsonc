                    "condition": {
                      "is-null": {
                        "var": {
                          "scope": "new",
                          "field": "published_at"
                        }
                      }
                    }
                  },
                  "writers_edit": {
                    "id": "writers_edit",
                    "role": "writer",
                    "resource": {
                      "object": "note"
                    },
                    "actions": [
                      "update"
                    ],
                    "condition": null
                  }
                }
              }
            },
            "principal": {
              "user": "alpha:writer1"
            },
            "role": "editor"
          },
          "result": {
            "rule": "permission:confer:editor",
            "passed": true,
            "detail": "holds every permission that role editor grants"
          }
        },
        {
          "description": "A principal whose own policy is conditional does not hold the power of an unconditional one: writer1 may update only unpublished notes, so may not confer the editor role that updates any.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-17",
              "with": {
                "schema.policies": {
                  "editors_update": {
