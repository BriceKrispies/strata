                  "rule": "type:note.slug",
                  "passed": true,
                  "detail": "string"
                },
                {
                  "rule": "unique:note.slug",
                  "passed": true,
                  "detail": "no other record has this value"
                },
                {
                  "rule": "required:note.status",
                  "passed": true,
                  "detail": "present"
                },
                {
                  "rule": "type:note.status",
                  "passed": true,
                  "detail": "string"
                },
                {
                  "rule": "required:note.title",
                  "passed": true,
                  "detail": "present"
                },
                {
                  "rule": "type:note.title",
                  "passed": true,
                  "detail": "string"
                },
                {
                  "rule": "workflow_state:note_status",
                  "passed": true,
                  "detail": "published is a state"
                },
                {
                  "rule": "constraint:note.title_length",
                  "passed": true,
                  "detail": "(len(new.title) <= 24)"
                }
              ],
              "next-record": 2
            },
            "output": {
              "record": {
                "object": "note",
                "id": 1,
                "version": 2
              }
            }
          }
        },
        {
          "description": "behaviour.rs writers_edit_only_their_own_notes; with a stale expected version too, the refusal is Unauthorized: authorisation comes before the version check.",
          "args": {
            "d": {
              "fixture": "fx-draft-2"
            },
            "object": "note",
            "id": 1,
            "fields": {
              "title": {
                "str": "Mine now"
