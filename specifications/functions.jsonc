                },
                "slug": {
                  "str": "draft"
                },
                "body": {
                  "str": "Text."
                },
                "author": {
                  "ref": 2
                },
                "status": {
                  "str": "draft"
                }
              }
            },
            "who": {
              "user": "site:ann"
            },
            "now": 6000,
            "roles": [
              "author",
              "public"
            ],
            "acc": {
              "passed": [],
              "failed": []
            }
          },
          "result": {
