    {
      "id": "setting-overrides-of",
      "description": "The overrides a tenant state holds, by key; none when it holds no setting values.",
      "params": [
        {
          "name": "s",
          "type": "tenant-state"
        }
      ],
      "returns": "map<string, setting-override>",
      "body": "match s.setting-values { Some(v) => v.overrides, None => {} }",
      "examples": [
        {
          "args": {
            "s": {
              "fixture": "fx-tenant-state-32"
            }
          },
          "result": {}
        },
        {
          "args": {
            "s": {
