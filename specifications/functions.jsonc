    {
      "id": "scope-predicate-problem",
      "description": "scoped.rs predicate_problem (D-8403, ADM-1611): why a predicate is not one over the records of an object type, as the error kind and the message of the refusal, or none when it is. An object type that does not exist is unknown-object; a predicate that names a field the object type does not declare (the check says unknown field) is scope-unknown-field; any other fault of the predicate, or a shape that is not a truth value (any included, unlike truth-problem), is invalid-intent. A reference hop is checked as the any shape (expr-check-env has no objects).",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "predicate",
          "type": "expr"
        }
      ],
      "returns": "option<scope-problem>",
      "let": [
        {
          "name": "shapes",
          "expr": "match get(schema.objects, object) { Some(o) => call field-shapes(o.fields), None => {} }"
        }
      ],
      "body": "match get(schema.objects, object) { None => scope-problem{kind: error-kind.unknown-object, message: format('no object type {}', object)}, Some(_) => match check(tenant-rule-language, predicate, expr-check-env{fields: shapes, params: [], roles: keys(schema.roles)}) { Ok(s) => if s == 'bool' then null else scope-problem{kind: error-kind.invalid-intent, message: format('a scope predicate is a truth value, not {}', call shape-debug(s))}, Err(e) => if startsWith(e, 'unknown field') then scope-problem{kind: error-kind.scope-unknown-field, message: format('the scope names a field {} does not declare: {}', object, e)} else scope-problem{kind: error-kind.invalid-intent, message: format('the scope: {}', e)} } }",
      "examples": [
        {
          "description": "A predicate over a declared field is one.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-6"
            },
            "object": "note",
            "predicate": {
              "cmp": {
                "op": "eq",
                "left": {
                  "var": {
                    "scope": "record",
                    "field": "slug"
                  }
                },
                "right": {
                  "lit": {
                    "str": "north"
                  }
                }
              }
            }
          },
          "result": null
        },
        {
          "description": "An object type the schema does not have.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-6"
            },
            "object": "nosuch",
            "predicate": {
              "cmp": {
                "op": "eq",
                "left": {
                  "var": {
                    "scope": "record",
                    "field": "slug"
                  }
                },
                "right": {
                  "lit": {
                    "str": "north"
                  }
                }
              }
            }
          },
          "result": {
            "kind": "unknown-object",
            "message": "no object type nosuch"
          }
        },
        {
          "description": "A field the object type does not declare.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-6"
            },
            "object": "note",
            "predicate": {
              "cmp": {
                "op": "eq",
                "left": {
                  "var": {
                    "scope": "record",
                    "field": "region"
                  }
                },
                "right": {
                  "lit": {
                    "str": "north"
                  }
                }
              }
            }
          },
          "result": {
            "kind": "scope-unknown-field",
            "message": "the scope names a field note does not declare: unknown field region"
          }
        },
        {
          "description": "A value that is not a truth value.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-6"
            },
            "object": "note",
            "predicate": {
              "lit": {
                "int": 3
              }
            }
          },
          "result": {
            "kind": "invalid-intent",
            "message": "a scope predicate is a truth value, not Int"
          }
        }
      ]
    },
    {
      "id": "scoped-policy-step",
      "description": "rules.rs authorize_needing, a policy of a role held through a scope that applies to the action and the resource (D-8403): no condition grants where the scope holds (detail: <what> where <scope>); a condition that is true grants (detail: <what> where <condition> and <scope>); a condition that is false or null fails the check as policy-step does, and one that fails to evaluate fails it and names the first record it needs that the snapshot does not cover, unless an earlier condition named one.",
      "params": [
        {
          "name": "p",
          "type": "policy-def"
        },
        {
          "name": "s",
          "type": "scoped-role"
        },
        {
          "name": "env",
          "type": "expr-env"
        },
        {
          "name": "acc",
          "type": "policy-progress"
        },
        {
          "name": "what",
          "type": "string"
        },
        {
          "name": "lookup",
          "type": "map<string, map<string, map<string, value>>>"
        },
        {
          "name": "reach",
          "type": "option<rule-reach>"
        }
      ],
      "returns": "policy-progress",
      "let": [
        {
          "name": "rule",
          "expr": "format('policy:{}:scoped:{}', p.id, s.role)"
        }
      ],
      "body": "match p.condition { None => policy-progress{granted: policy-check{rule, passed: true, what, outcome: policy-outcome.held, condition: s.scope}, checks: acc.checks}, Some(c) => match eval(tenant-rule-language, c, env, lookup) { Ok(v) => match v { bool(b) => if b then policy-progress{granted: policy-check{rule, passed: true, what, outcome: policy-outcome.held-with-scope, condition: c, scope: s.scope}, checks: acc.checks} else call deny(acc, rule, what, policy-outcome.is-false, c), int(_) => call deny(acc, rule, what, policy-outcome.is-false, c), str(_) => call deny(acc, rule, what, policy-outcome.is-false, c), time(_) => call deny(acc, rule, what, policy-outcome.is-false, c), ref(_) => call deny(acc, rule, what, policy-outcome.is-false, c), list(_) => call deny(acc, rule, what, policy-outcome.is-false, c), _ => call deny(acc, rule, what, policy-outcome.is-null, c) }, Err(_) => let d = call deny(acc, rule, what, policy-outcome.failed, c) in policy-progress{granted: d.granted, checks: d.checks, needed: if acc.needed != null then acc.needed else match reach { Some(r) => call rule-missing(c, r), None => null }} } }",
      "examples": [
        {
          "description": "A policy without a condition grants where the scope holds.",
          "args": {
            "p": {
              "id": "editors_run_posts",
              "role": "editor",
              "resource": {
                "object": "post"
              },
              "actions": [
                "update"
              ]
            },
            "s": {
              "principal": "user:ed",
              "role": "editor",
              "object": "post",
              "scope": {
                "lit": {
                  "bool": true
                }
              }
            },
            "env": {
              "fixture": "fx-expr-env-1",
              "with": {
                "principal": {
                  "str": "user:ed"
                },
                "has_role": [
                  "public"
                ]
              }
            },
            "acc": {
              "checks": []
            },
            "what": "Update on Object(ObjectTypeId(\"post\"))",
            "lookup": {}
          },
          "result": {
            "granted": {
              "rule": "policy:editors_run_posts:scoped:editor",
              "passed": true,
              "what": "Update on Object(ObjectTypeId(\"post\"))",
              "outcome": "held",
              "condition": {
                "lit": {
                  "bool": true
                }
              }
            },
            "checks": []
          }
        },
        {
          "description": "A condition that is false fails the check and names no record.",
          "args": {
            "p": {
              "fixture": "fx-policy-def-1"
            },
            "s": {
              "principal": "user:bob",
              "role": "author",
              "object": "post",
              "scope": {
                "lit": {
                  "bool": true
                }
              }
            },
            "env": {
              "fixture": "fx-expr-env-1",
              "with": {
                "principal": {
                  "str": "user:bob"
                },
                "has_role": [
                  "public"
                ]
              }
            },
            "acc": {
              "checks": []
            },
            "what": "Update on Object(ObjectTypeId(\"post\"))",
            "lookup": {}
          },
          "result": {
            "checks": [
              {
                "rule": "policy:authors_own_posts:scoped:author",
                "passed": false,
                "what": "Update on Object(ObjectTypeId(\"post\"))",
                "outcome": "is-false",
                "condition": {
                  "cmp": {
                    "op": "eq",
                    "left": {
                      "var": {
                        "scope": "record",
                        "field": "$created_by"
                      }
                    },
                    "right": "principal"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "scoped-step",
      "description": "rules.rs authorize_needing, one role held through a scope (D-8403, ADM-1611) on a record of its object type: the scope is evaluated on the record first, and where it does not give true the check fails (detail <scope> is false or null, or the evaluation error) and nothing of the role applies; where it holds, a permission of the role on the object type for the verb of the action grants (permission:scoped:<role>, detail <what> where <scope>), else each policy of the role that names the action and the resource is tried in turn (scoped-policy-step), the scope ANDed into its condition.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "s",
          "type": "scoped-role"
        },
        {
          "name": "env",
          "type": "expr-env"
        },
        {
          "name": "acc",
          "type": "policy-progress"
        },
        {
          "name": "what",
          "type": "string"
        },
        {
          "name": "lookup",
          "type": "map<string, map<string, map<string, value>>>"
        },
        {
          "name": "reach",
          "type": "option<rule-reach>"
        },
        {
          "name": "action",
          "type": "action"
        },
        {
          "name": "resource",
          "type": "resource"
        }
      ],
      "returns": "policy-progress",
      "let": [
        {
          "name": "rule",
          "expr": "format('scope:{}', s.role)"
        }
      ],
      "body": "match eval(tenant-rule-language, s.scope, env, lookup) { Ok(v) => match v { bool(b) => if b then (if any(g in call grants-of(schema, s.role), call grant-allows(g, action, resource)) then policy-progress{granted: policy-check{rule: format('permission:scoped:{}', s.role), passed: true, what, outcome: policy-outcome.held, condition: s.scope}, checks: acc.checks} else fold(p in values(schema.policies), a = acc, if a.granted != null || !call policy-applies(p, [s.role], action, resource) then a else call scoped-policy-step(p, s, env, a, what, lookup, reach))) else call deny(acc, rule, what, policy-outcome.is-false, s.scope), int(_) => call deny(acc, rule, what, policy-outcome.is-false, s.scope), str(_) => call deny(acc, rule, what, policy-outcome.is-false, s.scope), time(_) => call deny(acc, rule, what, policy-outcome.is-false, s.scope), ref(_) => call deny(acc, rule, what, policy-outcome.is-false, s.scope), list(_) => call deny(acc, rule, what, policy-outcome.is-false, s.scope), _ => call deny(acc, rule, what, policy-outcome.is-null, s.scope) }, Err(_) => let d = call deny(acc, rule, what, policy-outcome.failed, s.scope) in policy-progress{granted: d.granted, checks: d.checks, needed: if acc.needed != null then acc.needed else match reach { Some(r) => call rule-missing(s.scope, r), None => null }} }",
      "examples": [
        {
          "description": "A scope that is false fails the check and nothing of the role applies.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-29"
            },
            "s": {
              "principal": "user:ann",
              "role": "author",
              "object": "post",
              "scope": {
                "lit": {
                  "bool": false
                }
              }
            },
            "env": {
              "fixture": "fx-expr-env-1",
              "with": {
                "principal": {
                  "str": "user:ann"
                },
                "has_role": [
                  "public"
                ]
              }
            },
            "acc": {
              "checks": []
            },
            "what": "Update on Object(ObjectTypeId(\"post\"))",
            "lookup": {},
            "action": "update",
            "resource": {
              "object": "post"
            }
          },
          "result": {
            "checks": [
              {
                "rule": "scope:author",
                "passed": false,
                "what": "Update on Object(ObjectTypeId(\"post\"))",
                "outcome": "is-false",
                "condition": {
                  "lit": {
                    "bool": false
                  }
                }
              }
            ]
          }
        },
        {
          "description": "A scope that is not a truth value is null.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-29"
            },
            "s": {
              "principal": "user:ann",
              "role": "author",
              "object": "post",
              "scope": {
                "lit": "null"
              }
            },
            "env": {
              "fixture": "fx-expr-env-1",
              "with": {
                "principal": {
                  "str": "user:ann"
                },
                "has_role": [
                  "public"
                ]
              }
            },
            "acc": {
              "checks": []
            },
            "what": "Update on Object(ObjectTypeId(\"post\"))",
            "lookup": {},
            "action": "update",
            "resource": {
              "object": "post"
            }
          },
          "result": {
            "checks": [
              {
                "rule": "scope:author",
                "passed": false,
                "what": "Update on Object(ObjectTypeId(\"post\"))",
                "outcome": "is-null",
                "condition": {
                  "lit": "null"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "separations-in-force",
      "description": "duties.rs effective: the separations of duties in force in a schema, in id order: the platform's own (D-8426: the capability that posts to the ledger is never held with the one that reads every account of it) and those the schema declares (D-8482). A declaration adds to the platform's and never replaces them.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        }
      ],
      "returns": "list<separation-def>",
      "body": "sortBy(s in concat([separation-def{id: 'ledger-adjust-and-review', left: 'ledger-post', left-duty: 'posts ledger adjustments', right: 'ledger-read', right-duty: 'reviews the ledger'}], values(call separations-of(schema))), s.id)",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-6"
            }
          },
          "result": [
            {
              "id": "ledger-adjust-and-review",
              "left": "ledger-post",
              "left-duty": "posts ledger adjustments",
              "right": "ledger-read",
              "right-duty": "reviews the ledger"
            }
          ]
        }
      ]
    },
    {
      "id": "duty-people",
      "description": "duties.rs conflicts: the principals whose duties are looked at, in order: those with an entry in the table of members, those in a team and those holding a scoped assignment.",
      "params": [
        {
          "name": "members",
          "type": "map<principal-id, set<role-id>>"
        },
        {
          "name": "schema",
          "type": "tenant-schema"
        }
      ],
      "returns": "set<principal-id>",
      "body": "call principal-set-of(concat(concat(keys(members), fold(t in values(call teams-of(schema)), acc = [], concat(acc, t.members))), map(s in call scoped-roles-of(schema), s.principal)))",
      "examples": [
        {
          "args": {
            "members": {
              "alpha:ann": [
                "editor"
              ]
            },
            "schema": {
              "fixture": "fx-tenant-schema-6",
              "with": {
                "scoped-roles": [
                  {
                    "principal": "alpha:bob",
                    "role": "editor",
                    "object": "note",
                    "scope": {
                      "cmp": {
                        "op": "eq",
                        "left": {
                          "var": {
                            "scope": "record",
                            "field": "slug"
                          }
                        },
                        "right": {
                          "lit": {
                            "str": "south"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
          "result": [
            "alpha:ann",
            "alpha:bob"
          ]
        }
      ]
    },
    {
      "id": "duty-roles-held",
      "description": "duties.rs roles_held: the roles a principal holds for the rule of duties kept apart: those it is assigned directly or through a team, and those it holds narrowed by a scope (a narrower scope still lets the person do the duty on the records it reaches).",
      "params": [
        {
          "name": "members",
          "type": "map<principal-id, set<role-id>>"
        },
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "p",
          "type": "principal-id"
        }
      ],
      "returns": "set<role-id>",
      "body": "call set-of(concat(call assigned-roles(members, schema, p), map(s in call scoped-of(schema, p), s.role)))",
      "examples": [
        {
          "args": {
            "members": {
              "alpha:ann": [
                "editor"
              ]
            },
            "schema": {
              "fixture": "fx-tenant-schema-6",
