    {
      "id": "scope-record",
      "description": "The record a scope of a rule reads in rules.rs authorize: record is the old record, or the new one when there is none; old and new are themselves.",
      "params": [
        {
          "name": "subject",
          "type": "subject"
        },
        {
          "name": "s",
          "type": "scope"
        }
      ],
      "returns": "option<record>",
      "body": "match s { record => if subject.old == null then subject.new else subject.old, old => subject.old, new => subject.new }",
      "examples": [
        {
          "args": {
            "subject": {
              "new": {
                "id": 7,
                "object": "post",
                "version": 1,
                "created-by": "user:ann",
