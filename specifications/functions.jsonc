        }
      ]
    },
    {
      "id": "schema-with-team",
      "description": "TenantSchemaExt::put_team: the schema with a team defined or replaced. A team changes through its own intents, not ChangeSchema, and does not raise the schema version.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
