    {
      "id": "setting-change-effects",
      "description": "settings.rs schema_change_effects: the overrides, the revisions and the events that a list of schema changes brings with it, or why the changes are refused: the type of a definition does not change while an override of the setting exists (SET-004; refused as InvalidSchema with the evidence so far); removing a definition removes its overrides, because an override without a definition has no type and no level; a change of a definition raises the revision of the setting at the tenant and is an event that names the setting, the tenant level and the tenant (SET-051, D-5048). The operations are the deletions in the order of the changes, then one PutSettingRevision for each setting touched, in setting id order (setting-effects-step).",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "changes",
          "type": "list<schema-change>"
        },
        {
          "name": "evidence",
          "type": "list<check>"
        }
      ],
      "returns": "setting-effects",
      "errors": "rejection",
      "let": [
        {
          "name": "acc",
          "expr": "fold(c in changes, a = setting-effects-acc{ops: [], events: [], revisions: {}, types: {}, emptied: [], problem: null}, if a.problem != null then a else match c { define-setting(d) => call setting-effects-step(tenant, a, d.id, d.type, false), remove-setting(id) => call setting-effects-step(tenant, a, id, '', true), _ => a })"
        }
      ],
      "body": "match acc.problem { Some(p) => fail(call draft-reject(evidence, error-kind.invalid-schema, p)), None => setting-effects{ops: concat(acc.ops, map(s in keys(acc.revisions), delta-op.put-setting-revision{setting: s, revision: match get(acc.revisions, s) { Some(r) => r, None => 0 }})), events: acc.events} }",
      "examples": [
        {
          "description": "Changes that touch no setting bring nothing.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-38"
            },
            "changes": [
              {
                "remove-field": {
                  "object": "note",
                  "field": "body"
                }
              }
            ],
            "evidence": []
          },
          "result": {
            "ops": [],
            "events": []
          }
        },
        {
          "description": "Two definitions: an event each and the revisions, in setting id order.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-36"
            },
            "changes": [
              {
                "define-setting": {
                  "id": "zeta",
                  "label": "zeta",
                  "type": "string",
                  "default": {
                    "str": "light"
                  },
                  "levels": [
                    "tenant",
                    "team",
                    "person"
                  ]
                }
              },
              {
                "define-setting": {
                  "id": "alpha_mode",
                  "label": "alpha_mode",
                  "type": "string",
                  "default": {
                    "str": "light"
                  },
                  "levels": [
                    "tenant",
                    "team",
                    "person"
                  ]
                }
              }
            ],
            "evidence": []
          },
          "result": {
            "ops": [
              {
                "put-setting-revision": {
                  "setting": "alpha_mode",
                  "revision": 1
                }
              },
              {
                "put-setting-revision": {
                  "setting": "zeta",
                  "revision": 1
                }
              }
            ],
            "events": [
              {
                "setting-changed": {
                  "setting": "zeta",
                  "level": "tenant",
                  "subject": "alpha"
                }
              },
              {
                "setting-changed": {
                  "setting": "alpha_mode",
                  "level": "tenant",
                  "subject": "alpha"
                }
              }
            ]
          }
        },
        {
          "description": "Removing a setting deletes its overrides and raises its revision.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-38"
            },
            "changes": [
              {
                "remove-setting": "theme"
              }
            ],
            "evidence": []
          },
          "result": {
            "ops": [
              {
                "delete-setting-override": {
                  "setting": "theme",
                  "level": "tenant",
                  "subject": "alpha"
                }
              },
              {
                "put-setting-revision": {
                  "setting": "theme",
                  "revision": 2
                }
              }
            ],
            "events": [
              {
                "setting-changed": {
                  "setting": "theme",
                  "level": "tenant",
                  "subject": "alpha"
                }
              }
            ]
          }
        },
        {
          "description": "A change of type under overrides is refused as an invalid schema.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-38"
            },
            "changes": [
              {
                "define-setting": {
                  "id": "theme",
                  "label": "theme",
                  "type": "bool",
                  "default": {
                    "bool": false
                  },
                  "levels": [
                    "tenant",
                    "team",
                    "person"
                  ]
                }
              }
            ],
            "evidence": [
              {
                "rule": "permission:capability:setting-define",
                "passed": true,
                "detail": "holds setting-define"
              }
            ]
          },
          "error": {
            "rejected": {
              "kind": "invalid-schema",
              "message": "setting theme: the type changes from string to bool while overrides of it exist (SET-004)",
              "evidence": [
                {
                  "rule": "permission:capability:setting-define",
                  "passed": true,
                  "detail": "holds setting-define"
                },
                {
                  "rule": "intent:invalid_schema",
                  "passed": false,
                  "detail": "setting theme: the type changes from string to bool while overrides of it exist (SET-004)"
                }
              ],
              "missing": null
            }
          }
        },
        {
          "description": "The first problem ends the search: a later change is not looked at.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-38"
            },
            "changes": [
              {
                "define-setting": {
                  "id": "theme",
                  "label": "theme",
                  "type": "bool",
                  "default": {
                    "bool": false
                  },
                  "levels": [
                    "tenant",
                    "team",
                    "person"
                  ]
                }
              },
              {
                "define-setting": {
                  "id": "other",
                  "label": "other",
                  "type": "string",
                  "default": {
                    "str": "light"
                  },
                  "levels": [
                    "tenant",
                    "team",
                    "person"
                  ]
                }
              }
            ],
            "evidence": []
          },
          "error": {
            "rejected": {
              "kind": "invalid-schema",
              "message": "setting theme: the type changes from string to bool while overrides of it exist (SET-004)",
              "evidence": [
                {
                  "rule": "intent:invalid_schema",
                  "passed": false,
                  "detail": "setting theme: the type changes from string to bool while overrides of it exist (SET-004)"
                }
              ],
              "missing": null
            }
          }
        }
      ]
    },
    {
      "id": "setting-def-problems",
      "description": "settings.rs definition_problems, one definition: held under another key than its id; allows no level; a lock that is by a team or a person (a lock is by the platform or the tenant); a blank label; a default that is not a value of its type (setting-type-problem, SET-002). The names of platform definitions (SET-003) are none yet.",
      "params": [
        {
          "name": "key",
          "type": "setting-id"
        },
        {
          "name": "def",
          "type": "setting-def"
        }
      ],
      "returns": "list<string>",
      "let": [
        {
          "name": "at",
          "expr": "format('setting {}', def.id)"
        }
      ],
      "body": "concat(concat(concat(concat(if key != def.id then [format('{}: held under the key {}', at, key)] else [], if def.levels == [] then [format('{}: a setting allows at least one level', at)] else []), match def.locked-by { Some(l) => match l { team => [format('{}: a lock is by the platform or the tenant', at)], person => [format('{}: a lock is by the platform or the tenant', at)], _ => [] }, None => [] }), if trim(def.label) == '' then [format('{}: a setting needs a label', at)] else []), match call setting-type-problem(def.type, def.default) { Some(p) => [format('{}: default: {} (SET-002)', at, p.message)], None => [] })",
      "examples": [
        {
          "args": {
            "key": "theme",
            "def": {
              "id": "theme",
              "label": "theme",
              "type": "string",
              "default": {
                "str": "light"
              },
              "levels": [
                "tenant",
                "team",
                "person"
              ]
            }
          },
          "result": []
        },
        {
          "args": {
            "key": "other",
            "def": {
              "id": "theme",
              "label": "theme",
              "type": "string",
              "default": {
                "str": "light"
              },
              "levels": [
                "tenant",
                "team",
                "person"
              ]
            }
          },
          "result": [
            "setting theme: held under the key other"
          ]
        },
        {
          "args": {
            "key": "theme",
            "def": {
              "id": "theme",
              "label": "theme",
              "type": "string",
              "default": {
                "str": "light"
              },
              "levels": []
            }
          },
          "result": [
            "setting theme: a setting allows at least one level"
          ]
        },
        {
          "args": {
            "key": "theme",
            "def": {
              "id": "theme",
              "label": "theme",
              "type": "string",
              "default": {
                "str": "light"
              },
              "levels": [
                "tenant",
                "team",
                "person"
              ],
              "locked-by": "team"
            }
          },
          "result": [
            "setting theme: a lock is by the platform or the tenant"
          ]
        },
        {
          "args": {
            "key": "theme",
            "def": {
              "id": "theme",
              "label": "theme",
              "type": "string",
              "default": {
                "str": "light"
              },
              "levels": [
                "tenant",
                "team",
                "person"
              ],
              "locked-by": "person"
            }
          },
          "result": [
            "setting theme: a lock is by the platform or the tenant"
          ]
        },
        {
          "args": {
            "key": "theme",
            "def": {
              "id": "theme",
              "label": "theme",
              "type": "string",
              "default": {
                "str": "light"
              },
              "levels": [
                "tenant",
                "team",
                "person"
              ],
              "locked-by": "tenant"
            }
          },
          "result": []
        },
        {
          "args": {
            "key": "theme",
            "def": {
              "id": "theme",
              "label": "  ",
              "type": "string",
              "default": {
                "str": "light"
              },
              "levels": [
                "tenant",
                "team",
                "person"
              ]
            }
          },
          "result": [
            "setting theme: a setting needs a label"
          ]
        },
        {
          "args": {
            "key": "theme",
            "def": {
              "id": "theme",
              "label": "theme",
              "type": "string",
              "default": {
                "int": 1
              },
              "levels": [
                "tenant",
                "team",
                "person"
              ]
            }
          },
          "result": [
            "setting theme: default: a int is not a value of type string (SET-002)"
          ]
        },
        {
          "description": "Every problem, in order.",
          "args": {
            "key": "x",
            "def": {
              "id": "theme",
              "label": "",
              "type": "string",
              "default": {
                "bool": true
              },
              "levels": [],
              "locked-by": "person"
            }
          },
          "result": [
            "setting theme: held under the key x",
            "setting theme: a setting allows at least one level",
            "setting theme: a lock is by the platform or the tenant",
            "setting theme: a setting needs a label",
            "setting theme: default: a bool is not a value of type string (SET-002)"
          ]
        }
      ]
    },
    {
      "id": "setting-problems",
      "description": "settings.rs definition_problems: the problems of the setting definitions of a schema, in the order of their ids: more than 500 settings, then each definition (setting-def-problems).",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        }
      ],
      "returns": "list<string>",
      "body": "match schema.settings { None => [], Some(defs) => concat(call limit-count-problem('settings', length(keys(defs)), 500), fold(k in keys(defs), ps = [], concat(ps, fold(d in values(defs), qs = [], if get(defs, k) == d then call setting-def-problems(k, d) else qs)))) }",
      "examples": [
        {
          "description": "A schema that defines no setting.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-6"
            }
          },
          "result": []
        },
        {
          "description": "Two definitions, one with a problem.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-6",
              "with": {
                "settings": {
                  "a": {
                    "id": "a",
                    "label": "a",
                    "type": "string",
                    "default": {
                      "str": "light"
                    },
                    "levels": [
                      "tenant",
                      "team",
                      "person"
                    ]
                  },
                  "b": {
                    "id": "b",
                    "label": "b",
                    "type": "string",
                    "default": {
                      "str": "light"
                    },
                    "levels": []
                  }
                }
              }
            }
          },
          "result": [
            "setting b: a setting allows at least one level"
          ]
        },
        {
          "description": "More than 500 settings.",
          "args": {
            "schema": {
              "version": 2,
              "objects": {
                "note": {
