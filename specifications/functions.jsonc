                          "ty": "str",
                          "required": true,
                          "unique": false
                        }
                      },
                      "constraints": {}
                    }
                  },
                  "roles": {
                    "editor": {
                      "id": "editor",
                      "label": "Editor"
                    },
                    "owner": {
