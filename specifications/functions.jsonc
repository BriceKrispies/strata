              "fixture": "fx-tenant-schema-14"
            },
            "change": {
              "remove-ledger-definition": {
                "limit": {
                  "unit": "credits"
                }
              }
            }
          },
          "error": {
            "problem": "no such limit of ledger unit credits"
          }
        },
        {
          "description": "The limit of one account of a unit that is not declared is refused with the first problem of the limit (CT-286).",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-6"
            },
            "change": {
              "set-ledger-limit": {
                "unit": "credits",
                "owner": {
                  "principal": {
                    "principal": "alpha:ed"
                  }
                },
                "cap": 9
              }
            }
          },
          "error": {
            "problem": "ledger limit of credits: unknown ledger unit credits"
          }
        }
      ],
      "let": [
        {
          "name": "ledger",
          "expr": "call ledger-of(schema)"
        }
      ]
    },
    {
      "id": "touched-objects",
      "description": "transition.rs touched_objects: the object types whose records are re-validated after the changes (a field, relationship, constraint, composite unique constraint or workflow changed on them), and the targets of the reference fields and relationships they introduce, in id order.",
      "params": [
        {
          "name": "changes",
          "type": "list<schema-change>"
        }
      ],
      "returns": "set<object-type-id>",
      "body": "let all = fold(c in changes, acc = [], concat(acc, match c { define-field{object, field} => concat([object], match call ref-target(field.ty) { Some(t) => [t], None => [] }), define-relationship{object, target} => [object, target], remove-field{object} => [object], define-constraint{object} => [object], remove-constraint{object} => [object], define-workflow(w) => [w.object], define-unique{object} => [object], remove-unique{object} => [object], _ => [] })) in fold(o in sortBy(o in all, o), acc = [], if any(a in acc, a == o) then acc else concat(acc, [o]))",
      "examples": [
        {
          "args": {
            "changes": [
              {
                "define-relationship": {
                  "object": "note",
                  "field": "editor",
                  "label": "Editor",
                  "target": "person",
                  "on-delete": "restrict",
                  "required": false
                }
              },
              {
                "define-role": {
                  "id": "guest",
                  "label": "Guest"
                }
              },
              {
                "remove-field": {
                  "object": "note",
                  "field": "body"
                }
              }
            ]
          },
          "result": [
            "note",
            "person"
          ]
        },
        {
          "args": {
            "changes": [
              {
                "define-workflow": {
                  "id": "note_status",
                  "object": "note",
                  "field": "status",
                  "initial": [
                    "draft"
                  ],
                  "transitions": [
                    {
                      "name": "publish",
                      "from": "draft",
                      "to": "published",
                      "guard": {
                        "cmp": {
                          "op": "eq",
                          "left": "principal",
                          "right": {
                            "lit": {
                              "str": "alpha:editor"
                            }
                          }
                        }
                      },
                      "set": {
                        "published_at": "now"
                      }
                    },
                    {
                      "name": "unpublish",
                      "from": "published",
                      "to": "draft",
                      "guard": null,
                      "set": {
                        "published_at": {
                          "lit": "null"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "define-field": {
                  "object": "tag",
                  "field": {
                    "id": "who",
                    "label": "who",
                    "ty": {
                      "list": {
                        "ref": {
                          "target": "person",
                          "on-delete": "restrict"
                        }
                      }
                    },
                    "required": false,
                    "unique": false
                  }
                }
              }
            ]
          },
          "result": [
            "note",
            "person",
            "tag"
          ]
        },
        {
          "args": {
            "changes": [
              {
                "define-object": {
                  "id": "tag",
                  "label": "Tag"
                }
              }
            ]
          },
          "result": []
        },
        {
          "args": {
            "changes": [
              {
                "define-constraint": {
                  "object": "note",
                  "constraint": {
                    "id": "title_length",
                    "expr": {
                      "cmp": {
                        "op": "le",
                        "left": {
                          "len": {
                            "var": {
                              "scope": "new",
                              "field": "title"
                            }
                          }
                        },
                        "right": {
                          "lit": {
                            "int": 24
                          }
                        }
                      }
                    },
                    "message": "A title has at most 24 characters"
                  }
                }
              },
              {
                "remove-constraint": {
                  "object": "person",
                  "constraint": "x"
                }
              }
            ]
          },
          "result": [
            "note",
            "person"
          ]
        },
        {
          "description": "A composite unique constraint re-validates the records of its type.",
          "args": {
            "changes": [
              {
                "define-unique": {
                  "object": "note",
                  "unique": {
                    "id": "title_status",
                    "fields": [
                      "title",
                      "status"
                    ],
                    "message": "One note per title and status."
                  }
                }
              },
              {
                "remove-unique": {
                  "object": "tag",
                  "unique": "x"
                }
              }
            ]
          },
          "result": [
            "note",
            "tag"
          ]
        }
      ]
    },
    {
      "id": "lookup-all",
      "description": "rules.rs Lookup::all_of: every record of an object type, in id order; refused when the snapshot does not cover them.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "coverage",
          "type": "coverage"
        },
        {
          "name": "object",
          "type": "object-type-id"
        }
      ],
      "returns": "list<record>",
      "errors": "rejection",
      "let": [
        {
          "name": "wanted",
          "expr": "need.all-of(object)"
        }
      ],
      "body": "if call covers(coverage, wanted) then match get(tenant.records, object) { Some(rs) => values(rs), None => [] } else fail(rejection.rejected(call insufficient(wanted)))",
      "examples": [
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-9"
            },
            "coverage": {
              "partial": [
                {
                  "all-of": "note"
                }
              ]
            },
            "object": "note"
          },
          "result": [
            {
              "id": 1,
              "object": "note",
              "version": 1,
              "created-by": "alpha:writer1",
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "slug": {
                  "str": "first"
                },
                "status": {
                  "str": "draft"
                },
                "title": {
                  "str": "First"
                }
              }
            }
          ]
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-9"
            },
            "coverage": "complete",
            "object": "person"
          },
          "result": []
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-9"
            },
            "coverage": {
              "partial": [
                {
                  "record": {
                    "object": "note",
                    "id": 1
                  }
                }
              ]
            },
            "object": "note"
          },
          "error": {
            "rejected": {
              "kind": "insufficient-state",
              "message": "the snapshot does not cover AllOf(ObjectTypeId(\"note\"))",
              "evidence": [
                {
                  "rule": "coverage",
                  "passed": false,
                  "detail": "AllOf(ObjectTypeId(\"note\"))"
                }
              ],
              "missing": {
                "all-of": "note"
              }
            }
          }
        }
      ]
    },
    {
      "id": "plan-migration",
      "description": "transition.rs plan_migration, the body of contract plan-schema-migration (CT-007) through kernel-plan-migration, which calls it with a complete snapshot: apply the changes in order to a working copy of the tenant's schema (a refused change is InvalidSchema with the schema:change checks so far and the failed one); a working copy with problems (schema-problems) is InvalidSchema with the first problem as message and one schema:consistency check per problem; otherwise the version is one higher. Then a composite unique constraint that a change defines on an object type that already existed is refused with UniqueViolated when two of its records hold equal values in every field of it, naming the first such pair (CMS-1556, unique-duplicates), whether the change grandfathers other records or not. Then every record of each touched object type that already existed is re-validated as the system against the new schema, after its fields the new schema no longer declares are stripped (such a record is rewritten, its version one higher and updated now). Each failed check of a record is a violation. texts.constraints holds the printed constraints of the new schema.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "coverage",
          "type": "coverage"
        },
        {
          "name": "changes",
          "type": "list<schema-change>"
        },
        {
          "name": "now",
          "type": "timestamp"
        }
      ],
      "returns": "migration-plan",
      "errors": "rejection",
      "let": [
        {
          "name": "current",
          "expr": "tenant.schema"
        },
        {
          "name": "applied",
          "expr": "fold(c in changes, acc = migration-progress{schema: current, summary: [], evidence: []}, match call apply-change(acc.schema, c) { Ok(st) => migration-progress{schema: st.schema, summary: concat(acc.summary, [st.line]), evidence: concat(acc.evidence, [check{rule: 'schema:change', passed: true, detail: st.line}])}, Err(e) => match e { problem(p) => fail(rejection.rejected(domain-error{kind: error-kind.invalid-schema, message: p, evidence: concat(acc.evidence, [check{rule: 'schema:change', passed: false, detail: p}])})) } })"
        },
        {
          "name": "problems",
          "expr": "call schema-problems(applied.schema)"
        },
        {
          "name": "schema",
          "expr": "tenant-schema{version: current.version + 1, triggers: applied.schema.triggers, automations: applied.schema.automations, operations: applied.schema.operations, objects: applied.schema.objects, roles: applied.schema.roles, role-permissions: applied.schema.role-permissions, teams: applied.schema.teams, invitations: applied.schema.invitations, policies: applied.schema.policies, workflows: applied.schema.workflows, queries: applied.schema.queries, views: applied.schema.views, settings: applied.schema.settings, capabilities: applied.schema.capabilities, ledger: applied.schema.ledger, mail-templates: applied.schema.mail-templates, notice-templates: applied.schema.notice-templates, tokens: applied.schema.tokens, products: applied.schema.products, hold-rules: applied.schema.hold-rules, holds: applied.schema.holds, ui: applied.schema.ui, scoped-roles: applied.schema.scoped-roles}"        }
      ],
      "body": "match get(problems, 0) { Some(first) => fail(rejection.rejected(domain-error{kind: error-kind.invalid-schema, message: first, evidence: concat(applied.evidence, map(p in problems, check{rule: 'schema:consistency', passed: false, detail: p}))})), None => match get(try call unique-duplicates(tenant, coverage, current, schema, changes), 0) { Some(c) => fail(rejection.rejected(domain-error{kind: error-kind.unique-violated, message: format('{}: {}', c.rule, c.detail), evidence: concat(applied.evidence, [c])})), None => fold(o in call touched-objects(changes), acc = migration-plan{schema, summary: applied.summary, rewritten: [], violations: []}, match get(schema.objects, o) { None => acc, Some(def) => if get(current.objects, o) == null then acc else fold(r in try call lookup-all(tenant, coverage, o), a = acc, let stripped = fold(k in keys(r.fields), m = {}, if get(def.fields, k) == null then m else match get(r.fields, k) { Some(x) => insert(m, k, x), None => m }) in let same = keys(stripped) == keys(r.fields) in let candidate = if same then r else record{id: r.id, object: r.object, version: r.version + 1, created-by: r.created-by, created-at: r.created-at, updated-at: now, fields: stripped} in let outcome = try call validate-record(tenant, coverage, schema, def, candidate, null, principal.system, now) in migration-plan{schema: a.schema, summary: a.summary, rewritten: if same then a.rewritten else concat(a.rewritten, [candidate]), violations: concat(a.violations, map(f in outcome.failed, violation{object: o, id: r.id, check: f.check, kind: f.kind}))}) }) } }",
      "examples": [
        {
          "description": "behaviour.rs a_strict_migration_is_rejected_when_existing_records_would_not_conform: a new required field, which neither note has.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-10"
            },
            "coverage": "complete",
            "changes": [
              {
