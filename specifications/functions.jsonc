                "label": "Everyone"
              }
            },
            "policies": {},
            "workflows": {},
            "queries": {},
            "views": {}
          }
        }
      ]
    },
    {
      "id": "policy-check-text",
      "description": "A check of rules.rs authorize as the kernel writes it: the detail printed from the outcome, the request and the condition the check carries, printed as the kernel's Display of Expr writes it (print of the tenant rule language, WG-4966). For a condition that failed to evaluate the kernel writes \"<condition>: <evaluation error>\"; policy-check does not carry the error, so the detail is \"<condition>: evaluation failed\" (a gap of WG-4938).",
      "params": [
        {
          "name": "c",
          "type": "policy-check"
        }
      ],
      "returns": "check",
      "let": [
        {
          "name": "text",
          "expr": "match c.condition { Some(e) => print(tenant-rule-language, e), None => '' }"
        },
        {
          "name": "scope-text",
          "expr": "match c.scope { Some(e) => print(tenant-rule-language, e), None => '' }"
        }
      ],
      "body": "check{rule: c.rule, passed: c.passed, detail: match c.outcome { owner => c.what, unconditional => c.what, held => format('{} where {}', c.what, text), held-with-scope => format('{} where {} and {}', c.what, text, scope-text), is-false => format('{} is false', text), is-null => format('{} is null', text), failed => format('{}: evaluation failed', text), no-policy => format('no policy grants {}', c.what) }}",
      "examples": [
        {
          "args": {
            "c": {
              "rule": "policy:writers_edit_own",
              "passed": true,
              "what": "Update on Object(ObjectTypeId(\"note\"))",
              "outcome": "held",
              "condition": {
                "cmp": {
                  "op": "eq",
                  "left": {
                    "var": {
                      "scope": "record",
                      "field": "$created_by"
                    }
                  },
                  "right": "principal"
                }
              }
            }
          },
          "result": {
            "rule": "policy:writers_edit_own",
            "passed": true,
            "detail": "Update on Object(ObjectTypeId(\"note\")) where (record.$created_by == principal)"
          }
        },
        {
          "args": {
            "c": {
              "rule": "policy:writers_edit_own",
              "passed": false,
              "what": "Update on Object(ObjectTypeId(\"note\"))",
              "outcome": "is-false",
              "condition": {
                "cmp": {
