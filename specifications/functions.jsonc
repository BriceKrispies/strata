    {
      "id": "reserved-principal",
      "description": "transition.rs refuse_reserved_principals, as a test: the refusal text for the first principal id that starts with a reserved prefix, or none. A person may not hold an id that starts with team: (a team appears in events under team:<id>) or automation: (the principal an automation acts as, automation.rs, WFL-1527). The ids examined are those of the owner a CreateTenant names, the principal an AssignRole or AddTeamMember names, and the caller. The team: prefix is checked first, over all of them in that order; then automation:, for the principal an intent names, and for the caller only when it has a session, since an automation acts without one (reserved_problem).",
      "params": [
        {
          "name": "intent",
          "type": "intent"
        },
        {
          "name": "ctx",
          "type": "context"
        }
      ],
      "returns": "option<string>",
      "let": [
        {
          "name": "named",
          "expr": "match intent { create-tenant{owner: o} => [o], assign-role{principal: p} => [p], assign-scoped-role{principal: p} => [p], add-team-member{principal: p} => [p], _ => [] }"
        },
        {
          "name": "caller",
          "expr": "match ctx.principal { user(id) => [id], _ => [] }"
        },
        {
          "name": "team",
          "expr": "find(id in concat(named, caller), startsWith(id, 'team:'))"
        },
        {
          "name": "automation",
          "expr": "find(id in named, startsWith(id, 'automation:'))"
        },
        {
          "name": "signed-in",
          "expr": "match ctx.session { Some(_) => caller, None => [] }"
        },
        {
          "name": "automation-caller",
          "expr": "find(id in signed-in, startsWith(id, 'automation:'))"
        }
      ],
      "body": "match team { Some(id) => format('the principal id {} starts with the reserved prefix team:', id), None => match automation { Some(id) => format('the principal id {} starts with the reserved prefix automation:', id), None => match automation-caller { Some(id) => format('the principal id {} starts with the reserved prefix automation:, which no signed-in person may hold', id), None => null } } }",
      "examples": [
        {
          "description": "A person whose id starts with the prefix is the one.",
          "args": {
            "intent": {
              "assign-role": {
                "principal": "alpha:writer1",
                "role": "writer"
              }
            },
            "ctx": {
              "tenant": "alpha",
              "principal": {
                "user": "team:boss"
              },
              "session": null,
              "now": 5000,
              "correlation": "test-5000"
            }
          },
          "result": "the principal id team:boss starts with the reserved prefix team:"
        },
        {
          "description": "The principal an assignment names comes before the caller.",
          "args": {
            "intent": {
              "assign-role": {
                "principal": "team:guest",
                "role": "writer"
              }
            },
            "ctx": {
              "tenant": "alpha",
              "principal": {
                "user": "team:boss"
              },
              "session": null,
              "now": 5000,
              "correlation": "test-5000"
            }
          },
          "result": "the principal id team:guest starts with the reserved prefix team:"
        },
        {
          "description": "The owner of a new tenant.",
          "args": {
            "intent": {
              "create-tenant": {
                "name": "Gamma",
                "owner": "team:owner"
              }
            },
            "ctx": {
              "tenant": "gamma",
              "principal": "system",
              "session": null,
              "now": 5000,
              "correlation": "test-5000"
            }
          },
          "result": "the principal id team:owner starts with the reserved prefix team:"
        },
        {
          "description": "The member added to a team.",
          "args": {
            "intent": {
              "add-team-member": {
                "team": "desk",
                "principal": "team:guest"
              }
            },
            "ctx": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:owner"
              },
              "session": null,
              "now": 5000,
              "correlation": "test-5000"
            }
          },
          "result": "the principal id team:guest starts with the reserved prefix team:"
        },
        {
          "description": "Ordinary ids are not reserved.",
          "args": {
            "intent": {
              "assign-role": {
                "principal": "alpha:writer1",
                "role": "writer"
              }
            },
            "ctx": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:owner"
              },
              "session": null,
              "now": 5000,
              "correlation": "test-5000"
            }
          },
          "result": null
        },
        {
          "description": "An automation id for the principal an assignment names.",
          "args": {
            "intent": {
              "assign-role": {
                "principal": "automation:award",
                "role": "writer"
              }
            },
            "ctx": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:owner"
              },
              "session": null,
              "now": 5000,
              "correlation": "test-5000"
            }
          },
          "result": "the principal id automation:award starts with the reserved prefix automation:"
        },
        {
          "description": "An automation id for the owner of a new tenant.",
          "args": {
            "intent": {
              "create-tenant": {
                "name": "Gamma",
                "owner": "automation:x"
              }
            },
            "ctx": {
              "tenant": "gamma",
              "principal": "system",
              "session": null,
              "now": 5000,
              "correlation": "test-5000"
            }
          },
          "result": "the principal id automation:x starts with the reserved prefix automation:"
        },
        {
          "description": "An automation id as the member added to a team.",
          "args": {
            "intent": {
              "add-team-member": {
                "team": "desk",
                "principal": "automation:x"
              }
            },
            "ctx": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:owner"
              },
              "session": null,
              "now": 5000,
              "correlation": "test-5000"
            }
          },
          "result": "the principal id automation:x starts with the reserved prefix automation:"
        },
        {
          "description": "A caller with a session may not hold an automation id.",
          "args": {
            "intent": {
              "assign-role": {
                "principal": "alpha:writer1",
                "role": "writer"
              }
            },
            "ctx": {
              "tenant": "alpha",
              "principal": {
                "user": "automation:award"
              },
              "session": "sess-1",
              "now": 5000,
              "correlation": "test-5000"
            }
          },
          "result": "the principal id automation:award starts with the reserved prefix automation:, which no signed-in person may hold"
        },
        {
          "description": "The automation worker acts under its id without a session.",
          "args": {
            "intent": {
              "assign-role": {
                "principal": "alpha:writer1",
                "role": "writer"
              }
            },
            "ctx": {
              "tenant": "alpha",
              "principal": {
                "user": "automation:award"
              },
              "session": null,
              "now": 5000,
              "correlation": "test-5000"
            }
          },
          "result": null
        },
        {
          "description": "The team prefix is found before the automation prefix.",
          "args": {
            "intent": {
              "assign-role": {
                "principal": "automation:award",
                "role": "writer"
              }
            },
            "ctx": {
              "tenant": "alpha",
              "principal": {
                "user": "team:boss"
              },
              "session": null,
              "now": 5000,
              "correlation": "test-5000"
            }
          },
          "result": "the principal id team:boss starts with the reserved prefix team:"
        }
      ]
    },
    {
      "id": "ref-needs",
      "description": "transition.rs needs, the schema change arm: the records of the target of each reference field of an object type, whole, as the re-validation of the changed object type looks up every reference of every one of its records (an AllOf need for each target, once each, in field id order). None for an object type the schema does not hold.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "object",
          "type": "object-type-id"
        }
      ],
      "returns": "list<need>",
      "body": "match get(schema.objects, object) { None => [], Some(def) => fold(f in values(def.fields), acc = [], match call ref-target(f.ty) { Some(t) => concat(acc, [need.all-of(t)]), None => acc }) }",
      "examples": [
        {
          "description": "note refers to person.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-6"
            },
            "object": "note"
          },
          "result": [
            {
              "all-of": "person"
            }
          ]
        },
        {
          "description": "person has no reference field.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-6"
            },
            "object": "person"
          },
          "result": []
        },
        {
          "description": "An object type the schema does not hold has none.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-6"
            },
            "object": "nothing"
          },
          "result": []
        }
      ]
    },
    {
