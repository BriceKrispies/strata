          },
          "result": [
            "operation o.count: names ledger unit points, which the tenant does not declare"
          ]
        }
      ]
    },
    {
      "id": "operation-def-problems",
      "description": "definitions.rs operation_problems, one tenant operation (OPR-1549): more than sixteen steps or eight postings, no invoker, unknown invoker roles, per input a name that param cannot read and a reference to an unknown object type, inputs declared twice, an unknown subject object type and a subject input that is not a reference to it, per condition a blank error code and a condition that is not a truth value over the inputs and the subject fields, conditions declared twice, per step its problems (operation-step-problems) with the inputs and the ids of the create steps before it as parameters, and steps declared twice. The bound of two hundred nodes on a condition is checked by the kernel only: counting nodes needs recursion, which the function language does not compile. The self-action field of the subject (D-8405) must be a field of the subject's object type that holds text (self-action-problem).",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "roles",
          "type": "list<role-id>"
        },
        {
          "name": "op",
          "type": "tenant-operation-def"
        }
      ],
      "returns": "list<string>",
      "let": [
        {
          "name": "at",
          "expr": "format('operation {}', op.id)"
        },
        {
          "name": "postings",
          "expr": "length(filter(s in op.steps, match s { post-ledger => true, _ => false }))"
        },
        {
          "name": "p1",
          "expr": "concat(concat(concat(if length(op.steps) > 16 then [format('{}: {} steps is more than the maximum of 16', at, length(op.steps))] else [], if postings > 8 then [format('{}: {} posting steps is more than the maximum of 8', at, postings)] else []), if !op.invokers.signed-in && op.invokers.roles == [] then [format('{}: names no invoker', at)] else []), fold(r in op.invokers.roles, ps = [], if any(k in roles, k == r) then ps else concat(ps, [format('{}: unknown role {}', at, r)])))"
        },
        {
          "name": "p2",
          "expr": "concat(fold(i in op.inputs, ps = [], concat(concat(ps, if call is-param-name(i.name) then [] else [format('{}: input {:?} is not a name', at, i.name)]), match call ref-target(i.ty) { Some(t) => if get(schema.objects, t) == null then [format('{}: input {} refers to unknown object type {}', at, i.name, t)] else [], None => [] })), map(n in call repeated-names(map(i in op.inputs, i.name)), format('{}: input {} is declared twice', at, n)))"
        },
        {
          "name": "inputs",
          "expr": "map(i in filter(i in op.inputs, call is-param-name(i.name)), i.name)"
        },
        {
          "name": "p3",
          "expr": "match op.subject { Some(sub) => concat(concat(if get(schema.objects, sub.object) == null then [format('{}: unknown subject object type {}', at, sub.object)] else [], if any(i in op.inputs, i.name == sub.input && match i.ty { ref{target} => target == sub.object, _ => false }) then [] else [format('{}: subject input {} is not a reference to {}', at, sub.input, sub.object)]), call self-action-problem(schema, at, sub)), None => [] }"
        },
        {
          "name": "shapes",
          "expr": "match op.subject { Some(sub) => match get(schema.objects, sub.object) { Some(o) => call field-shapes(o.fields), None => {} }, None => {} }"
        },
        {
          "name": "p4",
          "expr": "concat(fold(c in op.conditions, ps = [], concat(concat(ps, if trim(c.error) == '' then [format('{}: condition {} names no error code', at, c.id)] else []), call truth-problem(at, format('condition {}', c.id), c.expr, expr-check-env{fields: shapes, params: inputs, roles}))), map(n in call repeated-names(map(c in op.conditions, c.id)), format('{}: condition {} is declared twice', at, n)))"
        },
        {
          "name": "scan",
          "expr": "fold(s in op.steps, acc = operation-scan{problems: [], params: inputs}, operation-scan{problems: concat(acc.problems, call operation-step-problems(schema, at, inputs, s, expr-check-env{fields: shapes, params: acc.params, roles})), params: match s { create-record{id} => concat(acc.params, [id]), _ => acc.params }})"
        },
        {
          "name": "p5",
          "expr": "concat(scan.problems, map(n in call repeated-names(map(s in op.steps, call operation-step-id(s))), format('{}: step {} is declared twice', at, n)))"
        }
      ],
      "body": "concat(concat(concat(concat(p1, p2), p3), p4), p5)",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-10"
            },
            "roles": [
              "editor",
              "owner",
              "public"
            ],
            "op": {
              "fixture": "fx-tenant-operation-def-1"
            }
          },
          "result": []
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-10"
            },
            "roles": [
              "editor",
              "owner",
              "public"
            ],
            "op": {
              "id": "redeem",
              "label": "Redeem",
              "inputs": [
                {
                  "name": "note",
                  "ty": {
                    "ref": {
                      "target": "note",
                      "on-delete": "restrict"
                    }
                  },
                  "required": true
                },
                {
                  "name": "Bad",
                  "ty": "int",
                  "required": false
                },
                {
                  "name": "note",
                  "ty": "int",
                  "required": false
                }
              ],
              "invokers": {
                "signed-in": false,
                "roles": [
                  "ghost"
                ]
              },
              "subject": {
                "object": "note",
                "input": "title"
              },
              "conditions": [
                {
                  "id": "c",
                  "expr": {
                    "lit": {
                      "str": "x"
                    }
                  },
                  "error": "",
                  "message": "m"
                },
                {
                  "id": "c",
                  "expr": {
                    "lit": {
                      "str": "y"
                    }
                  },
                  "error": "e",
                  "message": "m"
                }
              ],
              "steps": [
                {
                  "create-record": {
                    "id": "copy",
