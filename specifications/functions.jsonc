    {
      "id": "write-setting",
      "description": "settings.rs write_setting (D-5044, D-5045, SET-020 to SET-034): set the override of a setting at a level to a value, or remove it when there is none, against the revision the caller read the override at (zero for an override that does not exist). In the order of the kernel: only a signed-in person writes (setting-caller); the capability of the level (setting-capability); the setting is defined (setting-definition-of); the level is open (setting-level-check); whose override it is (setting-subject); the value has the type (setting-value-check); the revision is current (setting-revision-check); a removal removes something and a new override is within the most a tenant holds (setting-existence-check). Accepted, the override or its removal and the new revision of the setting (one higher than at the tenant) are delta operations, one setting-changed event names the setting, the level and the subject and no value (SET-040, SET-1543), and the output is the setting with its new revision. The decision is the caller's own: the person level takes no subject, so no other person's value can be named (SET-034). The refusal is the one the check names, with the checks that passed before it and no intent:<kind> check.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "setting",
          "type": "setting-id"
        },
        {
          "name": "level",
          "type": "setting-level"
        },
        {
          "name": "team",
          "type": "option<team-id>"
        },
        {
          "name": "value",
          "type": "option<value>"
        },
        {
          "name": "expected-revision",
          "type": "u64"
        }
      ],
      "returns": "decided",
      "errors": "rejection",
      "let": [
        {
          "name": "caller",
          "expr": "try call setting-caller(d.ctx)"
        },
        {
          "name": "e1",
          "expr": "[check{rule: 'setting:caller_is_a_person', passed: true, detail: caller}]"
        },
        {
          "name": "e2",
          "expr": "try call setting-capability(d.tenant, d.ctx, level, e1)"
        },
        {
          "name": "def",
          "expr": "try call setting-definition-of(d.tenant, setting, e2)"
        },
        {
          "name": "e3",
          "expr": "concat(e2, [check{rule: 'setting:is_defined', passed: true, detail: setting}])"
        },
        {
          "name": "e4",
          "expr": "try call setting-level-check(def, setting, level, e3)"
        },
        {
          "name": "subject",
          "expr": "try call setting-subject(d.tenant, caller, level, team, e4)"
        },
        {
          "name": "e5",
          "expr": "try call setting-value-check(def, setting, value, e4)"
        },
        {
          "name": "current",
          "expr": "call setting-override-at(d.tenant, setting, level, subject)"
        },
        {
          "name": "e6",
          "expr": "try call setting-revision-check(setting, match current { Some(h) => h.revision, None => 0 }, expected-revision, e5)"
        },
        {
          "name": "e7",
          "expr": "try call setting-existence-check(d.tenant, setting, value, current, e6)"
        },
        {
          "name": "revision",
          "expr": "call setting-revision-of(d.tenant, setting) + 1"
        }
      ],
      "body": "decided{draft: draft{tenant: d.tenant, ctx: d.ctx, coverage: d.coverage, ops: concat(d.ops, [match value { Some(v) => delta-op.put-setting-override(setting-override{setting, level, subject, value: v, revision, set-by: caller, set-at: d.ctx.now}), None => delta-op.delete-setting-override{setting, level, subject} }, delta-op.put-setting-revision{setting, revision}]), events: concat(d.events, [event-body.setting-changed{setting, level, subject}]), effects: d.effects, evidence: concat(d.evidence, e7), next-record: d.next-record}, output: output.setting{setting, revision}}",
      "examples": [
        {
          "description": "The owner overrides the tenant level against the revision it read: the override, the revision, and an event that names the setting, the level and the subject and no value.",
          "args": {
            "d": {
              "fixture": "fx-draft-26"
            },
            "setting": "theme",
            "level": "tenant",
            "team": null,
            "value": {
              "str": "light"
            },
            "expected-revision": 3
          },
          "result": {
            "draft": {
              "tenant": {
                "id": "alpha",
                "name": "alpha",
                "revision": 6,
                "next-record": 2,
                "event-seq": 6,
                "schema": {
                  "version": 2,
                  "objects": {
                    "note": {
                      "id": "note",
                      "label": "Note",
                      "fields": {
                        "author": {
                          "id": "author",
                          "label": "Author",
                          "ty": {
                            "ref": {
                              "target": "person",
                              "on-delete": "set-null"
                            }
                          },
                          "required": false,
                          "unique": false
                        },
                        "body": {
                          "id": "body",
                          "label": "body",
                          "ty": "str",
                          "required": false,
                          "unique": false
                        },
                        "published_at": {
                          "id": "published_at",
                          "label": "published_at",
                          "ty": "time",
                          "required": false,
                          "unique": false
                        },
                        "rank": {
                          "id": "rank",
                          "label": "rank",
                          "ty": "int",
                          "required": false,
                          "unique": false
                        },
                        "slug": {
                          "id": "slug",
                          "label": "slug",
                          "ty": "str",
                          "required": true,
                          "unique": true
                        },
                        "status": {
                          "id": "status",
                          "label": "status",
                          "ty": "str",
                          "required": true,
                          "unique": false,
                          "default": {
                            "lit": {
                              "str": "draft"
                            }
                          }
                        },
                        "title": {
                          "id": "title",
                          "label": "title",
                          "ty": "str",
                          "required": true,
                          "unique": false
                        }
                      },
                      "constraints": {
                        "title_length": {
                          "id": "title_length",
                          "expr": {
                            "cmp": {
                              "op": "le",
                              "left": {
                                "len": {
                                  "var": {
                                    "scope": "new",
                                    "field": "title"
                                  }
                                }
                              },
                              "right": {
                                "lit": {
                                  "int": 24
                                }
                              }
                            }
                          },
                          "message": "A title has at most 24 characters"
                        }
                      }
                    },
                    "person": {
                      "id": "person",
                      "label": "Person",
                      "fields": {
                        "name": {
                          "id": "name",
                          "label": "name",
                          "ty": "str",
                          "required": true,
                          "unique": false
                        }
                      },
                      "constraints": {}
                    }
                  },
                  "roles": {
                    "editor": {
                      "id": "editor",
                      "label": "Editor"
                    },
                    "owner": {
                      "id": "owner",
                      "label": "Owner"
                    },
                    "public": {
                      "id": "public",
                      "label": "Everyone"
                    },
                    "writer": {
                      "id": "writer",
                      "label": "Writer"
                    }
                  },
                  "policies": {
                    "editors_manage_notes": {
                      "id": "editors_manage_notes",
                      "role": "editor",
                      "resource": {
                        "object": "note"
                      },
                      "actions": [
                        "read",
                        "create",
                        "update",
                        "delete"
                      ],
                      "condition": null
                    },
                    "editors_manage_people": {
                      "id": "editors_manage_people",
                      "role": "editor",
                      "resource": {
                        "object": "person"
                      },
                      "actions": [
                        "read",
                        "create",
                        "update",
                        "delete"
                      ],
                      "condition": null
                    },
                    "public_reads_people": {
                      "id": "public_reads_people",
                      "role": "public",
                      "resource": {
                        "object": "person"
                      },
                      "actions": [
                        "read"
                      ],
                      "condition": null
                    },
                    "public_reads_published": {
                      "id": "public_reads_published",
                      "role": "public",
                      "resource": {
                        "object": "note"
                      },
                      "actions": [
                        "read"
                      ],
                      "condition": {
                        "cmp": {
                          "op": "eq",
                          "left": {
                            "var": {
                              "scope": "record",
                              "field": "status"
                            }
                          },
                          "right": {
                            "lit": {
                              "str": "published"
                            }
                          }
                        }
                      }
                    },
                    "writers_add_people": {
                      "id": "writers_add_people",
                      "role": "writer",
                      "resource": {
                        "object": "person"
                      },
                      "actions": [
                        "create"
                      ],
                      "condition": null
                    },
                    "writers_edit_own": {
                      "id": "writers_edit_own",
                      "role": "writer",
                      "resource": {
                        "object": "note"
                      },
                      "actions": [
                        "update",
                        "delete"
                      ],
                      "condition": {
                        "cmp": {
