                      "update"
                    ],
                    "condition": null
                  },
                  "writers_edit": {
                    "id": "writers_edit",
                    "role": "writer",
                    "resource": {
                      "object": "note"
                    },
                    "actions": [
                      "update"
                    ],
                    "condition": {
                      "is-null": {
                        "var": {
                          "scope": "new",
                          "field": "published_at"
                        }
                      }
                    }
                  }
                }
              }
            },
            "principal": {
              "user": "alpha:writer1"
            },
            "role": "editor"
          },
          "result": {
            "rule": "permission:confer:editor",
            "passed": false,
            "detail": "lacks 1 of the 1 permissions that role editor grants: policy editors_update: Update on Object(ObjectTypeId(\"note\"))"
          }
        }
      ]
    },
    {
      "id": "require-conferrable",
      "description": "transition.rs require_conferrable (ADM-152): every role must be one the acting principal may confer (may-confer). Each check is evidence, in the order of the roles; the first role it may not confer refuses the intent as Unauthorized.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "roles",
          "type": "list<role-id>"
        }
      ],
      "returns": "draft",
      "errors": "rejection",
      "let": [
        {
          "name": "added",
          "expr": "fold(r in roles, acc = [], if any(c in acc, !c.passed) then acc else concat(acc, [call may-confer(d.tenant, d.ctx.principal, r)]))"
        },
        {
          "name": "evidence",
          "expr": "concat(d.evidence, added)"
        },
        {
          "name": "refused",
          "expr": "find(r in roles, !(call may-confer(d.tenant, d.ctx.principal, r)).passed)"
        }
      ],
      "body": "match refused { Some(r) => fail(call draft-reject(evidence, error-kind.unauthorized, format('may not confer role {}: {}', r, (call may-confer(d.tenant, d.ctx.principal, r)).detail))), None => draft{tenant: d.tenant, ctx: d.ctx, coverage: d.coverage, ops: d.ops, events: d.events, effects: d.effects, evidence: evidence, next-record: d.next-record} }",
      "examples": [
        {
          "args": {
            "d": {
              "fixture": "fx-draft-18",
              "with": {
                "tenant.schema.role-permissions": {
                  "editor": [
                    {
                      "object": {
                        "object": "note",
                        "actions": [
                          "read",
                          "update"
                        ]
                      }
                    },
                    {
                      "capability": "content-write"
                    }
                  ],
                  "writer": [
                    {
                      "object": {
                        "object": "note",
                        "actions": [
                          "read"
                        ]
                      }
                    }
                  ]
                }
              }
            },
            "roles": [
              "editor",
              "writer"
            ]
          },
          "result": {
            "tenant": {
              "id": "alpha",
              "name": "alpha",
              "revision": 5,
              "next-record": 1,
              "event-seq": 5,
              "schema": {
                "version": 2,
                "objects": {},
                "roles": {
                  "editor": {
                    "id": "editor",
                    "label": "Editor"
                  },
                  "owner": {
                    "id": "owner",
                    "label": "Owner"
                  },
                  "public": {
                    "id": "public",
                    "label": "Everyone"
                  },
                  "writer": {
                    "id": "writer",
                    "label": "Writer"
                  }
                },
                "role-permissions": {
                  "editor": [
                    {
                      "object": {
                        "object": "note",
                        "actions": [
                          "read",
                          "update"
                        ]
                      }
                    },
                    {
                      "capability": "content-write"
                    }
                  ],
                  "writer": [
                    {
                      "object": {
                        "object": "note",
                        "actions": [
                          "read"
                        ]
                      }
                    }
                  ]
                },
                "policies": {},
                "workflows": {},
                "queries": {},
                "views": {}
              },
              "members": {
                "alpha:editor": [
                  "editor"
                ],
                "alpha:owner": [
                  "owner"
                ],
                "alpha:writer1": [
                  "writer"
                ],
                "alpha:writer2": [
                  "writer"
                ]
              },
              "records": {}
            },
            "ctx": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:owner"
              },
              "now": 5000,
              "correlation": "test-5000"
            },
            "coverage": "complete",
            "ops": [],
            "events": [],
            "effects": [],
            "evidence": [
              {
                "rule": "permission:confer:editor",
                "passed": true,
                "detail": "holds every permission that role editor grants"
              },
              {
                "rule": "permission:confer:writer",
                "passed": true,
                "detail": "holds every permission that role writer grants"
              }
            ],
            "next-record": 1
          }
        },
        {
          "description": "A writer may not confer editor, which grants what it does not hold.",
          "args": {
            "d": {
              "fixture": "fx-draft-18",
              "with": {
                "tenant.schema.role-permissions": {
                  "editor": [
                    {
                      "object": {
                        "object": "note",
                        "actions": [
                          "read",
                          "update"
                        ]
                      }
                    },
                    {
                      "capability": "content-write"
                    }
                  ],
                  "writer": [
                    {
                      "object": {
                        "object": "note",
                        "actions": [
                          "read"
                        ]
                      }
                    }
                  ]
                },
                "ctx.principal.user": "alpha:writer1"
              }
            },
            "roles": [
              "editor",
              "writer"
            ]
          },
          "error": {
            "rejected": {
              "kind": "unauthorized",
              "message": "may not confer role editor: lacks 2 of the 3 permissions that role editor grants: capability content-write, note:update",
              "evidence": [
                {
                  "rule": "permission:confer:editor",
                  "passed": false,
                  "detail": "lacks 2 of the 3 permissions that role editor grants: capability content-write, note:update"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "team-principal",
