          },
          "result": [
            "editor"
          ]
        }
      ]
    },
    {
      "id": "duty-capabilities",
      "description": "duties.rs: the capabilities the given roles name among their permissions: their capability strings, and nothing of their object-type permissions (rules.rs role_capabilities).",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "roles",
          "type": "set<role-id>"
        }
      ],
      "returns": "list<string>",
      "body": "fold(r in roles, acc = [], concat(acc, fold(g in call grants-of(schema, r), cs = [], match g { capability(name) => concat(cs, [name]), _ => cs })))",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-6"
            },
            "roles": [
              "public"
            ]
          },
          "result": []
        }
      ]
    },
    {
      "id": "duty-pairs-of",
      "description": "duties.rs conflicts, one principal: the pairs of duties it holds together, one for each separation whose two capabilities its roles name. The built-in owner role holds every capability and is not counted.",
      "params": [
        {
          "name": "members",
          "type": "map<principal-id, set<role-id>>"
        },
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "seps",
          "type": "list<separation-def>"
        },
        {
          "name": "p",
          "type": "principal-id"
        }
      ],
      "returns": "list<duty-pair>",
      "let": [
        {
          "name": "roles",
          "expr": "call duty-roles-held(members, schema, p)"
        },
        {
          "name": "caps",
          "expr": "call duty-capabilities(schema, roles)"
        }
      ],
      "body": "if any(r in roles, r == 'owner') then [] else fold(s in seps, acc = [], if any(c in caps, c == s.left) && any(c in caps, c == s.right) then concat(acc, [duty-pair{key: format('{} {} {} {}', p, s.id, s.left, s.right), message: format('{} would hold the role that {} and the role that {}', p, s.left-duty, s.right-duty)}]) else acc)",
      "examples": [
        {
          "args": {
            "members": {
              "alpha:ann": [
                "editor"
              ]
            },
            "schema": {
              "fixture": "fx-tenant-schema-6"
            },
            "seps": [
              {
                "id": "x",
                "left": "ledger-post",
                "left-duty": "posts",
                "right": "ledger-read",
                "right-duty": "reads"
              }
            ],
            "p": "alpha:ann"
          },
          "result": []
        }
      ]
    },
    {
      "id": "duty-pairs",
      "description": "duties.rs conflicts: every pair of duties a principal holds together, in the order of the principal and then of the separation id.",
      "params": [
        {
          "name": "members",
          "type": "map<principal-id, set<role-id>>"
        },
        {
          "name": "schema",
          "type": "tenant-schema"
        }
      ],
      "returns": "list<duty-pair>",
      "let": [
        {
          "name": "seps",
          "expr": "call separations-in-force(schema)"
        }
      ],
      "body": "fold(p in call duty-people(members, schema), acc = [], concat(acc, call duty-pairs-of(members, schema, seps, p)))",
      "examples": [
        {
          "args": {
            "members": {
              "alpha:ann": [
                "editor"
              ]
            },
            "schema": {
              "fixture": "fx-tenant-schema-6"
            }
          },
          "result": []
        }
      ]
    },
    {
      "id": "duty-made-by",
      "description": "duties.rs made_by: the sentence of the first pair of duties the state after a change holds that the state before it did not, or none. A pair a tenant already holds is not made worse by an unrelated change, so it is not held to this.",
      "params": [
        {
          "name": "before-members",
          "type": "map<principal-id, set<role-id>>"
        },
        {
          "name": "before-schema",
          "type": "tenant-schema"
        },
        {
          "name": "after-members",
          "type": "map<principal-id, set<role-id>>"
        },
        {
          "name": "after-schema",
          "type": "tenant-schema"
        }
      ],
      "returns": "option<string>",
      "let": [
        {
          "name": "held",
          "expr": "map(x in call duty-pairs(before-members, before-schema), x.key)"
        }
      ],
      "body": "match get(filter(x in call duty-pairs(after-members, after-schema), !any(h in held, h == x.key)), 0) { Some(x) => x.message, None => null }",
      "examples": [
        {
          "args": {
            "before-members": {},
            "before-schema": {
              "fixture": "fx-tenant-schema-6"
            },
            "after-members": {
              "alpha:ann": [
                "editor"
              ]
            },
            "after-schema": {
              "fixture": "fx-tenant-schema-6"
            }
          },
          "result": null
        }
      ]
    },
    {
      "id": "require-duties-apart",
      "description": "transition.rs require_duties_apart (ADM-1630, ADM-1642): a change must not give a principal two duties kept apart, the platform's and the tenant's. members and the schema are the state after the change; a pair held before it is not made worse by it. The refusal is conflicting-roles.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "members",
          "type": "map<principal-id, set<role-id>>"
        },
        {
          "name": "schema",
          "type": "tenant-schema"
        }
      ],
      "returns": "draft",
      "errors": "rejection",
      "body": "match call duty-made-by(d.tenant.members, d.tenant.schema, members, schema) { Some(m) => fail(call draft-reject(d.evidence, error-kind.conflicting-roles, m)), None => d }",
      "examples": [
        {
          "description": "A change that gives one person the role that posts ledger adjustments and the role that reviews the ledger is refused.",
          "args": {
            "d": {
              "fixture": "fx-draft-13"
            },
            "members": {
              "alpha:stranger": [
                "editor",
                "writer"
              ]
            },
            "schema": {
              "fixture": "fx-tenant-schema-6",
              "with": {
                "role-permissions": {
                  "writer": [
                    {
                      "capability": "ledger-post"
                    }
                  ],
                  "editor": [
                    {
                      "capability": "ledger-read"
                    }
                  ]
                }
              }
            }
          },
          "error": {
            "rejected": {
              "kind": "conflicting-roles",
              "message": "alpha:stranger would hold the role that posts ledger adjustments and the role that reviews the ledger",
              "evidence": [
                {
                  "rule": "intent:conflicting_roles",
                  "passed": false,
                  "detail": "alpha:stranger would hold the role that posts ledger adjustments and the role that reviews the ledger"
                }
              ],
              "missing": null
            }
          }
        },
        {
          "args": {
            "d": {
              "fixture": "fx-draft-22"
            },
            "members": {},
            "schema": {
              "fixture": "fx-tenant-schema-6"
            }
          },
          "result": {
            "fixture": "fx-draft-22"
          }
        }
      ]
    },
    {
      "id": "require-owner-role-kept",
      "description": "transition.rs require_owner_role_kept (ADM-1624): a change of role definitions does not remove or redefine the built-in owner role while the tenant has an owner, because every owner would be demoted with it. A product install or upgrade reaches the schema through the same change. The refusal is last-owner.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "changes",
          "type": "list<schema-change>"
        }
      ],
      "returns": "draft",
      "errors": "rejection",
      "body": "if any(c in changes, match c { remove-role(r) => r == 'owner', define-role(def) => def.id == 'owner', _ => false }) && length(call effective-owners(d.tenant.members, d.tenant.schema)) > 0 then fail(call draft-reject(d.evidence, error-kind.last-owner, 'a tenant keeps at least one owner: the owner role is not redefined or removed')) else d",
      "examples": [
        {
          "description": "The owner role is not removed while the tenant has an owner.",
          "args": {
            "d": {
              "fixture": "fx-draft-13"
            },
            "changes": [
              {
                "remove-role": "owner"
              }
            ]
          },
          "error": {
            "rejected": {
              "kind": "last-owner",
              "message": "a tenant keeps at least one owner: the owner role is not redefined or removed",
              "evidence": [
                {
                  "rule": "intent:last_owner",
                  "passed": false,
                  "detail": "a tenant keeps at least one owner: the owner role is not redefined or removed"
                }
              ],
              "missing": null
            }
          }
        },
        {
          "args": {
            "d": {
              "fixture": "fx-draft-22"
            },
            "changes": []
          },
          "result": {
            "fixture": "fx-draft-22"
          }
        }
      ]
    },
    {
      "id": "decide-assign-scoped-role",
      "description": "transition.rs assign_scoped_role (D-8403, ADM-1611): give a principal a role narrowed by a predicate over the records of one object type. Authorised as Manage on Members; the role must exist and not be public or owner; the predicate is checked against the fields of the object type (scope-problem), its fault is a failed scope:predicate check and the refusal; the role must be one the acting principal may confer (require-conferrable); the assignment replaces one of the same role to the same principal on the same object type and goes last; more than 10000 assignments is limit-exceeded; and it must not give the principal two duties kept apart (require-duties-apart). It adds nothing to the roles the principal holds.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "principal",
          "type": "principal-id"
        },
        {
          "name": "role",
          "type": "role-id"
        },
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "predicate",
          "type": "expr"
        }
      ],
      "returns": "decided",
      "errors": "rejection",
      "let": [
        {
          "name": "d1",
          "expr": "try call require(d, action.manage, resource.members, subject{})"
        }
      ],
      "body": "if get(d1.tenant.schema.roles, role) == null then fail(call draft-reject(d1.evidence, error-kind.unknown-role, format('no role {}', role))) else if role == 'public' || role == 'owner' then fail(call draft-reject(d1.evidence, error-kind.invalid-intent, format('the role {} is not narrowed by a scope', role))) else match call scope-predicate-problem(d1.tenant.schema, object, predicate) { Some(p) => fail(call draft-reject(concat(d1.evidence, [check{rule: 'scope:predicate', passed: false, detail: p.message}]), p.kind, p.message)), None => let d2 = try call require-conferrable(d1, [role]) in let held = concat(filter(a in call scoped-roles-of(d2.tenant.schema), !(a.principal == principal && a.role == role && a.object == object)), [scoped-role{principal, role, object, scope: predicate}]) in if length(held) > 10000 then fail(call draft-reject(d2.evidence, error-kind.limit-exceeded, 'more than 10000 scoped role assignments')) else let schema = call schema-with-scoped(d2.tenant.schema, held) in let d3 = try call require-duties-apart(d2, d2.tenant.members, schema) in decided{draft: draft{tenant: d3.tenant, ctx: d3.ctx, coverage: d3.coverage, ops: concat(d3.ops, [delta-op.put-schema(schema)]), events: d3.events, effects: d3.effects, evidence: d3.evidence, next-record: d3.next-record}, output: output.member} }",
      "examples": [
        {
          "description": "A role the tenant does not have is refused.",
          "args": {
            "d": {
              "fixture": "fx-draft-13"
            },
            "principal": "alpha:ann",
            "role": "nosuch",
            "object": "note",
            "predicate": {
              "cmp": {
                "op": "eq",
                "left": {
                  "var": {
                    "scope": "record",
                    "field": "slug"
                  }
                },
                "right": {
                  "lit": {
                    "str": "north"
                  }
                }
              }
            }
          },
          "error": {
            "rejected": {
              "kind": "unknown-role",
              "message": "no role nosuch",
              "evidence": [
                {
                  "rule": "policy:builtin_owner",
                  "passed": true,
                  "detail": "Manage on Members"
                },
                {
                  "rule": "intent:unknown_role",
                  "passed": false,
                  "detail": "no role nosuch"
                }
              ],
              "missing": null
            }
          }
        },
        {
          "description": "The owner role is not narrowed by a scope.",
          "args": {
            "d": {
              "fixture": "fx-draft-13"
            },
            "principal": "alpha:ann",
            "role": "owner",
            "object": "note",
            "predicate": {
              "cmp": {
                "op": "eq",
                "left": {
                  "var": {
                    "scope": "record",
                    "field": "slug"
                  }
                },
                "right": {
                  "lit": {
                    "str": "north"
                  }
                }
              }
            }
          },
          "error": {
            "rejected": {
              "kind": "invalid-intent",
              "message": "the role owner is not narrowed by a scope",
              "evidence": [
                {
                  "rule": "policy:builtin_owner",
                  "passed": true,
                  "detail": "Manage on Members"
                },
                {
                  "rule": "intent:invalid_intent",
                  "passed": false,
                  "detail": "the role owner is not narrowed by a scope"
                }
              ],
              "missing": null
            }
          }
        },
        {
          "description": "The editor role scoped to the north note: the schema holds the assignment and the roles of the person are untouched.",
          "args": {
            "d": {
              "fixture": "fx-draft-13"
            },
