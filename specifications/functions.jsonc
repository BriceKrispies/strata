                      ],
                      "condition": null
                    },
                    "writers_edit_own": {
                      "id": "writers_edit_own",
                      "role": "writer",
                      "resource": {
                        "object": "note"
                      },
                      "actions": [
                        "update",
                        "delete"
                      ],
                      "condition": {
                        "cmp": {
                          "op": "eq",
                          "left": {
                            "var": {
                              "scope": "record",
                              "field": "$created_by"
                            }
                          },
                          "right": "principal"
                        }
                      }
                    },
                    "writers_read_notes": {
                      "id": "writers_read_notes",
                      "role": "writer",
                      "resource": {
                        "object": "note"
                      },
                      "actions": [
                        "read",
                        "create"
                      ],
                      "condition": null
                    }
                  },
                  "workflows": {
                    "note_status": {
                      "id": "note_status",
                      "object": "note",
                      "field": "status",
                      "initial": [
                        "draft"
                      ],
                      "transitions": [
                        {
                          "name": "publish",
                          "from": "draft",
                          "to": "published",
                          "guard": {
                            "cmp": {
                              "op": "eq",
                              "left": "principal",
                              "right": {
                                "lit": {
                                  "str": "alpha:editor"
