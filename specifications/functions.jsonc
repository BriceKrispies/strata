          },
          "error": {
            "rejected": {
              "kind": "unauthorized",
              "message": "User(PrincipalId(\"alpha:writer2\")) may not Update Object(ObjectTypeId(\"note\"))",
              "evidence": [
                {
                  "rule": "policy:writers_edit_own",
                  "passed": false,
                  "detail": "(record.$created_by == principal) is false"
                }
              ],
              "missing": null
