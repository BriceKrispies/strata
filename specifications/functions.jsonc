          ]
        },
        {
          "description": "A posting step that names a unit the tenant does not declare is a problem (definitions.rs ledger_unit_reference).",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-10"
            },
            "at": "operation o",
            "inputs": [
              "note"
            ],
            "step": {
              "post-ledger": {
                "id": "count",
                "owner": "invoker",
                "unit": "points",
                "scope": null,
                "amount": {
                  "param": "note"
                },
                "reason": "r"
              }
            },
            "env": {
              "fields": {},
              "params": [
                "note"
              ],
              "roles": [
                "editor",
