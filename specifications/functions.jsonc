            },
            "principal": {
              "user": "alpha:writer1"
            },
            "act": "update",
            "res": "schema",
            "cond": null
          },
          "result": false
        }
      ]
    },
    {
      "id": "effective-owners",
      "description": "transition.rs effective_owners: the principals who hold owner in effect, directly or through a team: every principal of the table of members or of a team whose assigned-roles include owner.",
      "params": [
        {
          "name": "members",
          "type": "map<principal-id, set<role-id>>"
        },
        {
          "name": "schema",
          "type": "tenant-schema"
        }
      ],
      "returns": "list<principal-id>",
      "body": "filter(p in call principal-set-of(concat(keys(members), fold(t in values(call teams-of(schema)), acc = [], concat(acc, t.members)))), any(r in call assigned-roles(members, schema, p), r == 'owner'))",
      "examples": [
        {
          "description": "A direct owner.",
          "args": {
            "members": {
              "alpha:owner": [
                "owner"
              ],
              "alpha:writer1": [
                "writer"
              ]
            },
            "schema": {
              "version": 1,
              "objects": {},
              "roles": {},
              "policies": {},
              "workflows": {},
              "queries": {},
              "views": {}
            }
          },
          "result": [
            "alpha:owner"
          ]
        },
        {
          "description": "A member of a team that holds owner is an owner in effect, with no assignment of its own.",
          "args": {
            "members": {
              "alpha:owner": [
                "owner"
              ]
            },
            "schema": {
              "version": 1,
              "objects": {},
              "roles": {},
              "policies": {},
              "workflows": {},
              "queries": {},
              "views": {},
              "teams": {
                "desk": {
                  "id": "desk",
                  "label": "Desk",
                  "members": [
                    "alpha:guest"
                  ],
                  "roles": [
                    "owner"
                  ]
                }
              }
            }
          },
          "result": [
            "alpha:guest",
            "alpha:owner"
          ]
        },
        {
          "description": "A tenant with no owner has none.",
          "args": {
            "members": {
              "alpha:writer1": [
                "writer"
              ]
            },
            "schema": {
              "version": 1,
              "objects": {},
              "roles": {},
              "policies": {},
              "workflows": {},
              "queries": {},
              "views": {}
            }
          },
          "result": []
        }
      ]
    },
    {
      "id": "owner-lost",
      "description": "transition.rs require_an_owner_remains, as a test: whether a change leaves a tenant with no owner that had one. A tenant that has no owner before the change is not made worse by it, so it is not held to this. The members and the schema are the state before and after the change; counting goes through teams as well as direct assignments (effective-owners).",
      "params": [
        {
          "name": "before-members",
          "type": "map<principal-id, set<role-id>>"
        },
        {
          "name": "before-schema",
          "type": "tenant-schema"
        },
        {
          "name": "after-members",
          "type": "map<principal-id, set<role-id>>"
        },
        {
          "name": "after-schema",
          "type": "tenant-schema"
        }
      ],
      "returns": "bool",
      "body": "length(call effective-owners(before-members, before-schema)) > 0 && length(call effective-owners(after-members, after-schema)) == 0",
      "examples": [
        {
          "description": "The last direct owner losing owner leaves no owner.",
          "args": {
            "before-members": {
              "alpha:owner": [
                "owner"
              ]
            },
            "before-schema": {
              "version": 1,
              "objects": {},
              "roles": {},
              "policies": {},
              "workflows": {},
              "queries": {},
              "views": {}
            },
            "after-members": {
              "alpha:owner": []
            },
            "after-schema": {
              "version": 1,
              "objects": {},
              "roles": {},
              "policies": {},
              "workflows": {},
              "queries": {},
              "views": {}
            }
          },
          "result": true
        },
        {
          "description": "Another owner remains.",
          "args": {
            "before-members": {
              "alpha:owner": [
                "owner"
              ],
              "alpha:second": [
                "owner"
