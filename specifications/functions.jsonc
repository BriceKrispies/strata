            },
            "now": 1800000000000,
            "action": "create",
            "resource": {
              "object": "post"
            },
            "subject": {
              "new": {
                "id": 7,
                "object": "post",
                "version": 1,
                "created-by": "user:ann",
                "created-at": 1800000000000,
                "updated-at": 1800000000000,
                "fields": {
                  "author": {
                    "ref": 9
                  },
                  "title": {
                    "str": "Hello"
                  }
                }
              }
            },
            "coverage": "complete"
          },
          "result": {
            "allowed": false,
            "checks": [
              {
                "rule": "policy:authors_write_posts",
                "passed": false,
                "what": "Create on Object(ObjectTypeId(\"post\"))",
                "outcome": "is-null",
                "condition": {
                  "cmp": {
                    "op": "eq",
                    "left": {
                      "through": {
                        "scope": "new",
                        "reference": "author",
                        "field": "principal"
                      }
                    },
                    "right": "principal"
                  }
                }
              }
            ]
          }
        },
        {
          "description": "Without coverage there is no lookup: following the byline fails to evaluate, and nothing is needed (rules.rs authorize with no lookup).",
          "args": {
