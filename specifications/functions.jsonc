              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "status": {
                  "str": "draft"
                },
                "title": {
                  "str": "First"
                }
              }
            },
            "principal": {
              "user": "alpha:owner"
            },
            "now": 5000,
            "acc": {
              "passed": [],
              "failed": []
            },
            "u": {
              "id": "title_status",
              "fields": [
                "title",
                "status"
              ],
              "message": "One note per title and status."
            }
          },
          "result": {
            "passed": [],
            "failed": [
              {
                "check": {
                  "rule": "unique:note.title_status",
                  "passed": false,
                  "detail": "One note per title and status.: record 1 already has these values"
                },
                "kind": "unique-violated"
              }
            ]
          }
        },
        {
          "description": "A field without a value: the constraint does not apply (CMS-1555).",
