                  },
                  "actions": [
                    "read",
                    "create"
                  ],
                  "condition": null
                }
              },
              "workflows": {
                "note_status": {
                  "id": "note_status",
                  "object": "note",
                  "field": "status",
                  "initial": [
                    "draft"
                  ],
                  "transitions": [
                    {
                      "name": "publish",
                      "from": "draft",
                      "to": "published",
                      "guard": {
                        "cmp": {
                          "op": "eq",
