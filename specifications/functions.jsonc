        {
          "description": "The limit of an account the changes before it set is removed from the limits held.",
          "args": {
            "d": {
              "fixture": "fx-draft-28"
            },
            "w": {
              "evidence": [],
              "held": [
                {
                  "unit": "credits",
                  "owner": {
                    "principal": {
                      "principal": "alpha:ed"
                    }
                  },
                  "scope": "promo",
                  "cap": 5
                },
                {
                  "unit": "credits",
                  "owner": {
                    "principal": {
                      "principal": "alpha:ed"
                    }
                  },
                  "cap": 9
                }
              ]
            },
            "c": {
              "remove-ledger-definition": {
                "limit": {
                  "unit": "credits",
