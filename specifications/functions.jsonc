            "editor"
          ]
        },
        {
          "args": {
            "members": {},
            "schema": {
              "fixture": "fx-tenant-schema-6",
              "with": {
                "scoped-roles": [
                  {
                    "principal": "alpha:bob",
                    "role": "editor",
                    "object": "note",
                    "scope": {
                      "cmp": {
                        "op": "eq",
                        "left": {
                          "var": {
                            "scope": "record",
                            "field": "slug"
                          }
                        },
