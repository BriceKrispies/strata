                      "id": "body",
                      "label": "body",
                      "ty": "str",
                      "required": false,
                      "unique": false
                    },
                    "published_at": {
                      "id": "published_at",
                      "label": "published_at",
                      "ty": "time",
                      "required": false,
                      "unique": false
                    },
                    "rank": {
                      "id": "rank",
                      "label": "rank",
                      "ty": "int",
                      "required": false,
                      "unique": false
                    },
                    "slug": {
                      "id": "slug",
                      "label": "slug",
                      "ty": "str",
                      "required": true,
                      "unique": true
                    },
                    "status": {
                      "id": "status",
                      "label": "status",
                      "ty": "str",
                      "required": true,
                      "unique": false,
                      "default": {
                        "lit": {
                          "str": "draft"
                        }
                      }
                    },
                    "title": {
