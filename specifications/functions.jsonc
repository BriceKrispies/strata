              "id": "theme",
              "label": "theme",
              "type": "string",
              "default": {
                "str": "light"
              },
              "levels": [
                "tenant",
                "team",
                "person"
              ]
            },
            "setting": "theme",
            "value": {
              "str": "dark"
            },
            "evidence": []
          },
          "result": [
            {
              "rule": "setting:value_has_the_type",
              "passed": true,
              "detail": "string"
            }
          ]
        },
        {
          "args": {
            "def": {
              "id": "theme",
              "label": "theme",
              "type": "string",
              "default": {
                "str": "light"
              },
              "levels": [
                "tenant",
                "team",
                "person"
              ]
            },
            "setting": "theme",
            "value": "null",
            "evidence": []
          },
          "error": {
            "rejected": {
              "kind": "type-mismatch",
              "message": "a null is no value of a setting; remove the override instead",
              "evidence": [
