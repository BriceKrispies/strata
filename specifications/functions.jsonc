    {
      "id": "decide-revoke-scoped-role",
      "description": "transition.rs revoke_scoped_role (ADM-1643): take away the one scoped assignment of a role that a principal holds on an object type. Authorised as Manage on Members; the role must exist and be one the acting principal may confer (require-conferrable, as taking a role away asks); an assignment that does not exist is invalid-intent. The role a person holds directly, and the same role scoped to another object type, are untouched.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "principal",
          "type": "principal-id"
        },
        {
          "name": "role",
          "type": "role-id"
        },
        {
          "name": "object",
          "type": "object-type-id"
        }
      ],
      "returns": "decided",
      "errors": "rejection",
      "let": [
        {
          "name": "d1",
          "expr": "try call require(d, action.manage, resource.members, subject{})"
        }
      ],
      "body": "if get(d1.tenant.schema.roles, role) == null then fail(call draft-reject(d1.evidence, error-kind.unknown-role, format('no role {}', role))) else let d2 = try call require-conferrable(d1, [role]) in let all = call scoped-roles-of(d2.tenant.schema) in let kept = filter(a in all, !(a.principal == principal && a.role == role && a.object == object)) in if length(kept) == length(all) then fail(call draft-reject(d2.evidence, error-kind.invalid-intent, format('{} holds no scoped role {} on {}', principal, role, object))) else decided{draft: draft{tenant: d2.tenant, ctx: d2.ctx, coverage: d2.coverage, ops: concat(d2.ops, [delta-op.put-schema(call schema-with-scoped(d2.tenant.schema, kept))]), events: d2.events, effects: d2.effects, evidence: d2.evidence, next-record: d2.next-record}, output: output.member}",
      "examples": [
        {
          "description": "A role the tenant does not have is refused.",
          "args": {
            "d": {
              "fixture": "fx-draft-13"
            },
            "principal": "alpha:ann",
            "role": "nosuch",
            "object": "note"
          },
          "error": {
            "rejected": {
              "kind": "unknown-role",
              "message": "no role nosuch",
              "evidence": [
                {
                  "rule": "policy:builtin_owner",
                  "passed": true,
                  "detail": "Manage on Members"
                },
                {
                  "rule": "intent:unknown_role",
                  "passed": false,
                  "detail": "no role nosuch"
                }
              ],
              "missing": null
            }
          }
        },
        {
          "description": "A person who holds no such assignment has none taken away.",
          "args": {
            "d": {
              "fixture": "fx-draft-13"
            },
            "principal": "alpha:ann",
            "role": "writer",
            "object": "note"
          },
          "error": {
            "rejected": {
              "kind": "invalid-intent",
              "message": "alpha:ann holds no scoped role writer on note",
              "evidence": [
                {
                  "rule": "policy:builtin_owner",
                  "passed": true,
                  "detail": "Manage on Members"
                },
                {
                  "rule": "permission:confer:writer",
                  "passed": true,
                  "detail": "holds every permission that role writer grants"
                },
                {
                  "rule": "intent:invalid_intent",
                  "passed": false,
                  "detail": "alpha:ann holds no scoped role writer on note"
                }
              ],
              "missing": null
            }
          }
        },
