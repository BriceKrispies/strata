    {
      "id": "require",
      "description": "transition.rs Draft::require: authorize the action on the resource against the tenant's own schema with the snapshot's lookup (rules.rs authorize_needing: authorize-needing with the draft's coverage), and add its checks to the evidence as the kernel writes them; when it is not allowed, answer InsufficientState for the record a failed condition needs and the snapshot does not cover, and otherwise refuse with Unauthorized \"<principal:?> may not <action:?> <resource:?>\".",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "action",
          "type": "action"
        },
        {
          "name": "resource",
          "type": "resource"
        },
        {
          "name": "subject",
          "type": "subject"
        }
      ],
      "returns": "draft",
      "errors": "rejection",
      "let": [
        {
          "name": "decision",
          "expr": "call authorize-needing(d.tenant, d.tenant.schema, d.ctx.principal, d.ctx.now, action, resource, subject, d.coverage)"
        },
        {
          "name": "evidence",
          "expr": "concat(d.evidence, map(c in decision.checks, call policy-check-text(c)))"
        }
      ],
      "body": "if decision.allowed then draft{tenant: d.tenant, ctx: d.ctx, coverage: d.coverage, ops: d.ops, events: d.events, effects: d.effects, evidence: evidence, next-record: d.next-record} else match decision.needed { Some(n) => fail(rejection.rejected(call insufficient(n))), None => fail(call draft-reject(evidence, error-kind.unauthorized, format('{} may not {} {}', call principal-debug(d.ctx.principal), call action-debug(action), call resource-debug(resource)))) }",
      "examples": [
        {
