    {
      "id": "value-rank",
      "description": "The position of a value's variant in the derived order of Value (Null, Bool, Int, Str, Time, Ref, List), the most significant part of comparing two values.",
      "params": [
        {
          "name": "x",
          "type": "value"
        }
      ],
      "returns": "i64",
      "body": "match x { bool(_) => 1, int(_) => 2, str(_) => 3, time(_) => 4, ref(_) => 5, list(_) => 6, _ => 0 }",
      "examples": [
        {
          "args": {
            "x": "null"
          },
          "result": 0
        },
        {
          "args": {
            "x": {
              "str": "a"
            }
          },
          "result": 3
        },
        {
          "args": {
            "x": {
              "bool": true
            }
          },
          "result": 1
        },
        {
          "args": {
            "x": {
              "int": 3
            }
          },
          "result": 2
        },
        {
          "args": {
            "x": {
              "str": "a"
            }
          },
          "result": 3
        },
        {
          "args": {
            "x": {
              "time": 5
            }
          },
          "result": 4
        },
        {
          "args": {
            "x": {
              "ref": 1
            }
          },
          "result": 5
        },
        {
          "args": {
            "x": {
              "list": []
            }
          },
          "result": 6
        },
        {
          "args": {
            "x": "null"
          },
          "result": 0
        }
      ]
    },
    {
      "id": "value-number",
      "description": "The order within a variant of a value that is a bool (false before true), an integer, a time or a reference; 0 for any other value. A reference id above the largest i64 is not ordered (record ids are allocated from 1).",
      "params": [
        {
          "name": "x",
          "type": "value"
        }
      ],
      "returns": "i64",
      "body": "match x { bool(b) => if b then 1 else 0, int(i) => i, time(t) => t, ref(r) => r, _ => 0 }",
      "examples": [
        {
          "args": {
            "x": {
              "bool": true
            }
          },
          "result": 1
        },
        {
          "args": {
            "x": {
              "time": 7
            }
          },
          "result": 7
        },
        {
          "args": {
            "x": {
              "str": "a"
            }
          },
          "result": 0
        },
        {
          "args": {
            "x": {
              "int": 4
            }
          },
          "result": 4
        },
        {
          "args": {
            "x": {
              "ref": 9
            }
          },
          "result": 9
        },
        {
          "args": {
            "x": {
              "bool": false
            }
          },
          "result": 0
        }
      ]
    },
    {
      "id": "value-text",
      "description": "The order within the variant of a string value (by Unicode scalar values, as Rust orders str); the empty text for any other value.",
      "params": [
        {
          "name": "x",
          "type": "value"
        }
      ],
      "returns": "string",
      "body": "match x { str(s) => s, _ => '' }",
      "examples": [
        {
          "args": {
            "x": {
              "str": "b"
            }
          },
          "result": "b"
        },
        {
          "args": {
            "x": {
              "int": 1
            }
          },
          "result": ""
        }
      ]
    },
    {
      "id": "record-attribute",
      "description": "expr.rs attribute(Some(record), name): a system attribute or a field of a record, null when unset. A name that is not a field id reads as null here, where the kernel refuses it (an order key or a section attribute is checked by schema-problems first).",
      "params": [
        {
          "name": "r",
          "type": "record"
        },
        {
          "name": "field",
          "type": "string"
        }
      ],
      "returns": "value",
      "body": "match get(call record-scope(r), field) { Some(x) => x, None => call null-value() }",
      "examples": [
        {
          "args": {
            "r": {
              "id": 2,
              "object": "post",
              "version": 1,
              "created-by": "alpha:writer",
              "created-at": 2000,
              "updated-at": 2000,
              "fields": {
                "author": {
                  "ref": 1
                },
                "status": {
                  "str": "published"
                },
                "title": {
                  "str": "B"
                }
              }
            },
            "field": "title"
          },
          "result": {
            "str": "B"
          }
        },
        {
          "args": {
            "r": {
              "id": 3,
              "object": "post",
              "version": 1,
              "created-by": "alpha:writer",
              "created-at": 2001,
              "updated-at": 2001,
              "fields": {
                "status": {
                  "str": "draft"
                },
                "title": {
                  "str": "A"
                }
              }
            },
            "field": "$id"
          },
          "result": {
            "ref": 3
          }
        },
        {
          "args": {
            "r": {
              "id": 3,
              "object": "post",
              "version": 1,
              "created-by": "alpha:writer",
              "created-at": 2001,
              "updated-at": 2001,
              "fields": {
                "status": {
                  "str": "draft"
                },
                "title": {
                  "str": "A"
                }
              }
            },
            "field": "author"
          },
          "result": "null"
        }
      ]
    },
    {
      "id": "reverse-records",
      "description": "The records in the opposite order.",
      "params": [
        {
          "name": "xs",
          "type": "list<record>"
        }
      ],
      "returns": "list<record>",
      "body": "fold(x in xs, acc = [], concat([x], acc))",
      "examples": [
        {
          "args": {
            "xs": [
              {
                "id": 2,
                "object": "post",
                "version": 1,
                "created-by": "alpha:writer",
                "created-at": 2000,
                "updated-at": 2000,
                "fields": {
                  "author": {
                    "ref": 1
                  },
                  "status": {
                    "str": "published"
                  },
                  "title": {
                    "str": "B"
                  }
                }
              },
              {
                "id": 3,
                "object": "post",
                "version": 1,
                "created-by": "alpha:writer",
                "created-at": 2001,
                "updated-at": 2001,
                "fields": {
                  "status": {
                    "str": "draft"
                  },
                  "title": {
                    "str": "A"
                  }
                }
              }
            ]
          },
          "result": [
            {
              "id": 3,
              "object": "post",
              "version": 1,
              "created-by": "alpha:writer",
              "created-at": 2001,
              "updated-at": 2001,
              "fields": {
                "status": {
                  "str": "draft"
                },
                "title": {
                  "str": "A"
                }
              }
            },
            {
              "id": 2,
              "object": "post",
              "version": 1,
              "created-by": "alpha:writer",
              "created-at": 2000,
              "updated-at": 2000,
              "fields": {
                "author": {
                  "ref": 1
                },
                "status": {
                  "str": "published"
                },
                "title": {
                  "str": "B"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "order-pass",
      "description": "One key of a query order, applied as a stable sort: by the attribute in the derived order of Value (its variant, then within a number or a string), ascending, or descending with equal keys kept in the order they had. A list value is not ordered by its items (a gap: Value orders lists element by element).",
      "params": [
        {
          "name": "rows",
          "type": "list<record>"
        },
        {
          "name": "key",
          "type": "order-key"
        }
      ],
      "returns": "list<record>",
      "let": [
        {
          "name": "start",
          "expr": "if key.descending then call reverse-records(rows) else rows"
        },
        {
          "name": "asc",
          "expr": "sortBy(r in sortBy(r in sortBy(r in start, call value-number(call record-attribute(r, key.field))), call value-text(call record-attribute(r, key.field))), call value-rank(call record-attribute(r, key.field)))"
        }
      ],
      "body": "if key.descending then call reverse-records(asc) else asc",
