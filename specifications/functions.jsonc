    {
      "id": "trigger-decline",
      "description": "triggers.rs decide, the decline closure: the effect decline-automation for a trigger that matched an event and starts no run for a recorded reason (SCH-1532), with a detail of at most 256 characters.",
      "params": [
        {
          "name": "trigger",
          "type": "trigger-def"
        },
        {
          "name": "event",
          "type": "domain-event"
        },
        {
          "name": "hop",
          "type": "u32"
        },
        {
          "name": "reason",
          "type": "automation-exception-reason"
        },
        {
          "name": "text",
          "type": "string"
        }
      ],
      "returns": "effect",
      "body": "effect.decline-automation(automation-decline{trigger: trigger.id, automation: trigger.automation, event-seq: event.seq, hop, reason, detail: call trigger-detail(text)})",
      "examples": [
        {
          "args": {
            "trigger": {
              "fixture": "fx-trigger-def-1"
            },
            "event": {
              "fixture": "fx-domain-event-2"
            },
            "hop": 3,
            "reason": "hop-limit",
            "text": "hop 9 is past the hop limit of 8"
          },
          "result": {
            "decline-automation": {
              "trigger": "on_publish",
              "automation": "award",
              "event-seq": 7,
              "hop": 3,
              "reason": "hop-limit",
              "detail": "hop 9 is past the hop limit of 8"
            }
          }
        }
      ]
    },
    {
      "id": "trigger-start",
      "description": "triggers.rs decide, the start: the effect start-automation handed to the automation worker for a run to start (D-7200): the trigger and its automation, the event sequence and hop, the automation principal its steps act as (caused-by, WFL-1530), the definer whose authority bounds it, the schema version the run starts on, the canonical JSON of the run key value when the automation declares one (the kernel writes its SHA-256 in hexadecimal, D-6534: the function language has no hash, so the differential hashes this text) and the parameters the event binds.",
      "params": [
        {
          "name": "after",
          "type": "tenant-state"
        },
        {
          "name": "a",
          "type": "automation-def"
        },
        {
          "name": "trigger",
          "type": "trigger-def"
        },
        {
          "name": "event",
          "type": "domain-event"
        },
        {
          "name": "hop",
          "type": "u32"
        },
        {
          "name": "params",
          "type": "map<string, value>"
        },
        {
          "name": "run-key",
          "type": "option<string>"
        }
      ],
      "returns": "effect",
      "body": "effect.start-automation(automation-start{trigger: trigger.id, automation: a.id, event-seq: event.seq, hop, caused-by: format('automation:{}', a.id), on-behalf-of: a.defined-by, definition-version: after.schema.version, run-key, params})",
      "examples": [
        {
          "args": {
            "after": {
              "fixture": "fx-tenant-state-9"
