with-ledger(schema, ledger-declarations{units: ledger.units, pools: remove(ledger.pools, pool), limits: ledger.limits}), line: format('remove ledger pool {}', pool)}, limit{unit, owner, scope} => match owner { Some(_) => schema-step{schema: schema, line: format('remove a limit of one account of ledger unit {}', unit)}, None => let kept = filter(x in ledger.limits, !call ledger-same-limit(x, unit, owner, call ledger-scope-text(scope))) in if length(kept) == length(ledger.limits) then fail(schema-problem.problem(format('no such limit of ledger unit {}', unit))) else schema-step{schema: call schema-with-ledger(schema, ledger-declarations{units: ledger.units, pools: ledger.pools, limits: kept}), line: format('remove a limit of ledger unit {}', unit)} } }, define-separation(d) => if d.id == 'ledger-adjust-and-review' then fail(schema-problem.problem(format('{} is a separation of the platform, which a tenant does not declare again', d.id))) else schema-step{schema: call schema-with-separations(schema, insert(call separations-of(schema), d.id, d)), line: format('define separation {}', d.id)}, remove-separation(id) => if id == 'ledger-adjust-and-review' then fail(schema-problem.problem(format('{} is a separation of the platform, which is not removed', id))) else if get(call separations-of(schema), id) == null then fail(schema-problem.problem(format('no separation {}', id))) else schema-step{schema: call schema-with-separations(schema, remove(call separations-of(schema), id)), line: format('remove separation {}', id)}, _ => try call apply-meta-change(schema, change) }",      "examples": [
