                  "passed": false,
                  "detail": "setting theme: a int is not a value of type string"
                }
              ],
              "missing": null
            }
          }
        },
        {
          "args": {
            "def": {
              "id": "theme",
              "label": "theme",
              "type": "string",
              "default": {
                "str": "light"
              },
              "levels": [
                "tenant",
                "team",
