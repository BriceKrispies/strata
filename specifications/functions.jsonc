    {
      "id": "header-needs",
      "description": "What storage-api execute and query load before they decide: nothing beyond what every load holds (the schema, members and counters, load-tenant CT-012). The decision asks for the rest (the insufficient-state loop of execute-intent, execute-read, mutate-record and read-view), because the needs of an intent or a read follow from the schema, which only a load gives.",
      "params": [],
      "returns": "list<need>",
      "body": "[]",
      "examples": [
        {
          "args": {},
          "result": []
        }
      ]
    },
    {
      "id": "first-missing",
      "description": "The first need a snapshot does not cover (state.rs Coverage::covers), which a derivation asks for next.",
      "params": [
        {
          "name": "coverage",
          "type": "coverage"
        },
        {
          "name": "wanted",
          "type": "list<need>"
        }
      ],
      "returns": "option<need>",
      "body": "find(n in wanted, !call covers(coverage, n))",
      "examples": [
        {
          "args": {
            "coverage": {
              "partial": [
                {
                  "all-of": "post"
                }
              ]
            },
            "wanted": [
              {
                "record": {
                  "object": "post",
                  "id": 2
                }
              },
              {
                "all-of": "person"
              }
            ]
          },
          "result": {
            "all-of": "person"
          }
        },
        {
          "args": {
            "coverage": "complete",
            "wanted": [
              {
                "all-of": "person"
              }
            ]
          },
          "result": null
        }
      ]
    },
    {
      "id": "mutation-reply-of",
      "description": "backend ops.rs mutate, the reply of an accepted transition that changed a record: its object, id and new version (none after a delete), the revision (the delta's new revision, which the commit's receipt repeats), the tenant event sequence after it, and the number of checks of its evidence. Any other output has no reply.",
      "params": [
        {
          "name": "t",
          "type": "transition-result"
        }
      ],
      "returns": "option<mutation-reply>",
      "let": [
        {
          "name": "checks",
          "expr": "fold(c in t.evidence, n = 0, n + 1)"
        }
      ],
      "body": "match t.output { record{object, id, version} => mutation-reply{object, id, version, revision: t.delta.new-revision, event-seq: t.delta.event-seq, checks-passed: checks}, deleted{object, id} => mutation-reply{object, id, revision: t.delta.new-revision, event-seq: t.delta.event-seq, checks-passed: checks}, _ => null }",
      "examples": [
        {
          "args": {
            "t": {
              "delta": {
                "tenant": "alpha",
                "base-revision": 5,
                "new-revision": 6,
                "next-record": 6,
                "event-seq": 6,
                "ops": []
              },
              "events": [],
              "effects": [],
              "evidence": [
                {
                  "rule": "policy:builtin_owner",
                  "passed": true,
                  "detail": "x"
                },
                {
                  "rule": "record:valid",
                  "passed": true,
                  "detail": "y"
                }
              ],
              "output": {
                "record": {
                  "object": "post",
                  "id": 5,
                  "version": 1
                }
              }
            }
          },
          "result": {
            "object": "post",
            "id": 5,
            "version": 1,
            "revision": 6,
            "event-seq": 6,
            "checks-passed": 2
          }
        },
        {
          "args": {
            "t": {
              "delta": {
                "tenant": "alpha",
                "base-revision": 5,
                "new-revision": 6,
                "next-record": 6,
                "event-seq": 6,
                "ops": []
              },
              "events": [],
              "effects": [],
              "evidence": [
                {
                  "rule": "policy:builtin_owner",
                  "passed": true,
                  "detail": "x"
                },
                {
                  "rule": "record:valid",
                  "passed": true,
                  "detail": "y"
                }
              ],
              "output": {
                "deleted": {
                  "object": "post",
                  "id": 3
                }
              }
            }
          },
          "result": {
            "object": "post",
            "id": 3,
            "version": null,
            "revision": 6,
            "event-seq": 6,
            "checks-passed": 2
          }
        },
        {
          "args": {
            "t": {
              "delta": {
                "tenant": "alpha",
                "base-revision": 5,
                "new-revision": 6,
                "next-record": 6,
                "event-seq": 6,
                "ops": []
              },
              "events": [],
              "effects": [],
              "evidence": [
                {
                  "rule": "policy:builtin_owner",
                  "passed": true,
                  "detail": "x"
                },
                {
                  "rule": "record:valid",
                  "passed": true,
                  "detail": "y"
                }
              ],
              "output": "member"
            }
          },
          "result": null
        }
      ]
    },
    {
      "id": "execute-decide",
      "description": "crates/storage-api/src/lib.rs execute, one decision, the decide of contract execute-intent (CT-031): the needs plan-intent-needs names for the snapshot's schema are asked for first, one at a time (storage-api loads them together after a header load); then the kernel decides (intent-decision). An InsufficientState rejection naming a need asks for it; any other rejection is the contract's domain error. An accepted transition is handed to the commit with its intent and its record reply.",
      "params": [
        {
          "name": "state",
          "type": "state"
        },
        {
          "name": "intent",
          "type": "intent"
        },
        {
          "name": "context",
          "type": "context"
        }
      ],
      "returns": "accepted-intent",
      "errors": "execute-failure",
      "body": "match call first-missing(state.coverage, call needs(match state.tenant { Some(t) => t.schema, None => null }, intent)) { Some(n) => fail(execute-failure.insufficient-state(n)), None => match call intent-decision(state, intent, context) { Ok(tr) => accepted-intent{intent, transition: tr, reply: call mutation-reply-of(tr)}, Err(e) => match e { rejected(d) => match d.missing { Some(n) => if d.kind == error-kind.insufficient-state then fail(execute-failure.insufficient-state(n)) else fail(execute-failure.domain(d)), None => fail(execute-failure.domain(d)) } } } }",
      "examples": [
        {
          "args": {
            "state": {
              "tenant-id": "gamma",
              "tenant": null,
              "coverage": "complete"
            },
            "intent": {
              "create-tenant": {
                "name": "Gamma",
                "owner": "gamma:owner"
              }
            },
            "context": {
              "tenant": "gamma",
              "principal": "system",
              "session": null,
              "now": 5001,
              "correlation": "test-5001"
            }
          },
          "result": {
            "intent": {
              "create-tenant": {
                "name": "Gamma",
                "owner": "gamma:owner"
              }
            },
            "transition": {
              "delta": {
                "tenant": "gamma",
                "base-revision": null,
                "new-revision": 1,
                "next-record": 1,
                "event-seq": 1,
                "ops": [
                  {
                    "create-tenant": {
                      "name": "Gamma"
                    }
                  },
                  {
                    "put-schema": {
                      "version": 1,
                      "objects": {},
                      "roles": {
                        "owner": {
                          "id": "owner",
                          "label": "Owner"
                        },
                        "public": {
                          "id": "public",
                          "label": "Everyone"
                        }
                      },
                      "policies": {},
                      "workflows": {},
                      "queries": {},
                      "views": {}
                    }
                  },
                  {
                    "put-member": {
                      "principal": "gamma:owner",
                      "roles": [
                        "owner"
                      ]
                    }
                  }
                ]
              },
              "events": [
                {
                  "tenant": "gamma",
                  "seq": 1,
                  "revision": 1,
                  "at": 5001,
                  "principal": "system",
                  "correlation": "test-5001",
                  "body": {
                    "tenant-created": {
                      "name": "Gamma"
                    }
                  }
                }
              ],
              "effects": [
                {
                  "publish": {
                    "seq": 1
                  }
                }
              ],
              "evidence": [
                {
                  "rule": "policy:builtin_system",
                  "passed": true,
                  "detail": "CreateTenant"
                }
              ],
              "output": "tenant"
            },
            "reply": null
          }
        },
        {
          "description": "The needs of the intent are loaded before it is decided.",
          "args": {
            "state": {
              "fixture": "fx-state-7"
            },
            "intent": {
              "update-record": {
                "object": "post",
                "id": 3,
                "fields": {
                  "title": {
                    "str": "Z"
                  }
                },
                "expected-version": null
              }
            },
            "context": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:owner"
              },
              "session": "s-1",
              "now": 3000,
              "correlation": "c-1"
            }
          },
          "error": {
            "insufficient-state": {
              "record": {
                "object": "post",
                "id": 3
              }
            }
          }
        },
        {
          "args": {
            "state": {
              "tenant-id": "gamma",
              "tenant": null,
              "coverage": "complete"
            },
            "intent": {
              "create-tenant": {
                "name": "Gamma",
                "owner": "gamma:owner"
              }
            },
            "context": {
              "tenant": "alpha",
              "principal": "system",
              "session": null,
              "now": 5001,
              "correlation": "test-5001"
            }
          },
          "error": {
            "domain": {
              "kind": "tenant-mismatch",
              "message": "snapshot is of gamma, context names alpha",
              "evidence": [
                {
                  "rule": "tenant:snapshot_matches_context",
                  "passed": false,
                  "detail": "snapshot is of gamma, context names alpha"
                }
              ],
              "missing": null
            }
          }
        }
      ]
    },
    {
      "id": "problem-field",
      "description": "backend ops.rs mutate, the field a coercion problem names: problem.split(':').next().trim(), which is the field of \"<field>: <error>\" and the whole text of \"<object> has no field <name>\". Read here as the given field whose name and a colon begin the problem, else the whole problem; the two differ only for an unknown field whose name holds a colon (no string operations, WG-4957).",
      "params": [
        {
          "name": "problem",
          "type": "string"
        },
        {
          "name": "fields",
          "type": "map<string, plain-json>"
        }
      ],
      "returns": "string",
      "body": "match find(n in keys(fields), call text-starts-with(problem, format('{}:', n))) { Some(n) => n, None => problem }",
      "examples": [
        {
          "args": {
            "problem": "title: expected string, got 3",
            "fields": {
              "status": {
                "string": "x"
              },
              "title": {
                "number": {
                  "pos-int": 3
                }
              }
            }
          },
          "result": "title"
        },
        {
          "args": {
            "problem": "post has no field colour",
            "fields": {
              "colour": {
                "string": "red"
              }
            }
          },
          "result": "post has no field colour"
        }
      ]
    },
    {
      "id": "mutation-fields",
      "description": "backend ops.rs mutate, fields_of: the object type of the tenant's schema (not_found \"no object type <object>\" without one) and its fields coerced from plain JSON (coerce-fields, with no symbolic references: the resolver gives none); a problem is invalid with the problem as message and one failed check input:<object>.<field> (problem-field). times holds the milliseconds of each string a time field may take (parse_time, a stand-in until string operations exist, WG-4957).",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "object",
          "type": "string"
        },
        {
          "name": "fields",
          "type": "map<string, plain-json>"
        },
        {
          "name": "context",
          "type": "context"
        },
        {
          "name": "times",
          "type": "map<string, i64>"
        }
      ],
      "returns": "map<field-id, value>",
      "errors": "api-failure",
      "body": "match get(tenant.schema.objects, object) { None => fail(api-failure.refused(api-error{code: error-code.not_found, message: format('no object type {}', object), failed: [], correlation: context.correlation})), Some(def) => match call coerce-fields(def, fields, {}, times) { Ok(m) => m, Err(e) => match e { message(p) => fail(api-failure.refused(api-error{code: error-code.invalid, message: p, failed: [check{rule: format('input:{}.{}', object, call problem-field(p, fields)), passed: false, detail: p}], correlation: context.correlation})) } } }",
      "examples": [
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-12"
            },
            "object": "post",
            "fields": {
              "status": {
                "string": "draft"
              },
              "title": {
                "string": "D"
              }
            },
            "context": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:owner"
              },
              "session": "s-1",
              "now": 3000,
              "correlation": "c-1"
            },
            "times": {}
          },
          "result": {
            "status": {
              "str": "draft"
            },
            "title": {
              "str": "D"
            }
          }
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-12"
            },
            "object": "post",
            "fields": {
              "title": {
                "number": {
                  "pos-int": 3
                }
              }
            },
            "context": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:owner"
              },
              "session": "s-1",
              "now": 3000,
              "correlation": "c-1"
            },
            "times": {}
          },
          "error": {
            "refused": {
              "code": "invalid",
              "message": "title: expected string, got 3",
              "kind": null,
              "failed": [
                {
                  "rule": "input:post.title",
                  "passed": false,
                  "detail": "title: expected string, got 3"
                }
              ],
              "correlation": "c-1"
            }
          }
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-12"
            },
            "object": "page",
            "fields": {},
            "context": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:owner"
              },
              "session": "s-1",
              "now": 3000,
              "correlation": "c-1"
            },
            "times": {}
          },
          "error": {
            "refused": {
              "code": "not_found",
              "message": "no object type page",
              "kind": null,
              "failed": [],
              "correlation": "c-1"
            }
          }
        }
      ]
    },
    {
      "id": "coerce-mutation",
      "description": "backend ops.rs mutate up to the intent: the tenant must exist (header: not_found \"no site <tenant>\"); a create or an update coerces its fields (mutation-fields) and becomes CreateRecord or UpdateRecord, a delete DeleteRecord. An object name that is not a valid ObjectTypeId is not checked here (the backend answers not_found \"no object type <name>\" before the kernel; here the kernel answers UnknownObject), a gap of the missing string operations (WG-4957).",
      "params": [
        {
          "name": "mutation",
          "type": "mutation"
        },
        {
          "name": "state",
          "type": "state"
        },
        {
          "name": "context",
          "type": "context"
        },
        {
          "name": "times",
          "type": "map<string, i64>"
        }
      ],
      "returns": "intent",
      "errors": "api-failure",
      "let": [
        {
          "name": "site",
          "expr": "match state.tenant { Some(t) => t, None => fail(api-failure.refused(api-error{code: error-code.not_found, message: format('no site {}', context.tenant), failed: [], correlation: context.correlation})) }"
        }
      ],
      "body": "match mutation { create{object, fields} => intent.create-record{object, fields: try call mutation-fields(site, object, fields, context, times)}, update{object, id, fields, expected-version} => intent.update-record{object, id, fields: try call mutation-fields(site, object, fields, context, times), expected-version}, delete{object, id, expected-version} => intent.delete-record{object, id, expected-version} }",
      "examples": [
        {
          "args": {
            "mutation": {
              "update": {
                "object": "post",
                "id": 3,
                "fields": {
                  "title": {
                    "string": "Z"
                  }
                },
                "expected-version": 1
              }
            },
            "state": {
              "fixture": "fx-state-5"
            },
            "context": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:owner"
              },
              "session": "s-1",
              "now": 3000,
              "correlation": "c-1"
            },
            "times": {}
          },
          "result": {
            "update-record": {
              "object": "post",
              "id": 3,
              "fields": {
                "title": {
                  "str": "Z"
                }
              },
              "expected-version": 1
            }
          }
        },
        {
          "args": {
            "mutation": {
              "delete": {
                "object": "post",
                "id": 3,
                "expected-version": null
              }
            },
            "state": {
              "fixture": "fx-state-5"
            },
            "context": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:owner"
              },
              "session": "s-1",
              "now": 3000,
              "correlation": "c-1"
            },
            "times": {}
          },
          "result": {
            "delete-record": {
              "object": "post",
              "id": 3,
              "expected-version": null
            }
          }
        },
        {
          "args": {
            "mutation": {
              "create": {
                "object": "post",
                "fields": {}
              }
            },
            "state": {
              "tenant-id": "alpha",
              "tenant": null,
              "coverage": "complete"
            },
            "context": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:owner"
              },
              "session": "s-1",
              "now": 3000,
              "correlation": "c-1"
            },
            "times": {}
          },
          "error": {
            "refused": {
              "code": "not_found",
              "message": "no site alpha",
              "kind": null,
              "failed": [],
              "correlation": "c-1"
            }
          }
        }
      ]
    },
    {
      "id": "unreadable-as-missing",
      "description": "backend ops.rs hide_unreadable (WG-4918): a refused change to a record the caller cannot read answers as the kernel answers a record that is not there, UnknownRecord \"no <object> <id>\" with a failed intent:unknown_record check; a record the caller may read (visible) keeps the refusal. A record the snapshot does not hold, or does not cover, is not readable. The backend reads the record again with a fresh load and the current time; here it is the snapshot the decision was made on, at the context's time.",
      "params": [
        {
          "name": "d",
          "type": "domain-error"
        },
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "coverage",
          "type": "coverage"
        },
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "id",
          "type": "record-id"
        },
        {
          "name": "context",
          "type": "context"
        }
      ],
      "returns": "domain-error",
      "let": [
        {
          "name": "readable",
          "expr": "match call lookup-record(tenant, coverage, object, id) { Ok(found) => match found { Some(r) => call visible(tenant, context.principal, r, context.now), None => false }, Err(_) => false }"
        },
        {
          "name": "message",
          "expr": "format('no {} {}', object, id)"
        }
      ],
      "body": "if readable then d else domain-error{kind: error-kind.unknown-record, message, evidence: [check{rule: 'intent:unknown_record', passed: false, detail: message}]}",
      "examples": [
        {
          "description": "A writer without a policy cannot read the draft, so the refusal says it is not there.",
          "args": {
            "d": {
              "kind": "unauthorized",
              "message": "m",
              "evidence": []
            },
            "tenant": {
              "fixture": "fx-tenant-state-13"
            },
            "coverage": "complete",
            "object": "post",
            "id": 3,
            "context": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:writer"
              },
              "session": "s-2",
              "now": 3000,
              "correlation": "c-1"
            }
          },
          "result": {
            "kind": "unknown-record",
            "message": "no post 3",
            "evidence": [
              {
                "rule": "intent:unknown_record",
                "passed": false,
                "detail": "no post 3"
              }
            ],
            "missing": null
          }
        },
        {
          "description": "A published post is readable, so the refusal stands.",
          "args": {
            "d": {
              "kind": "unauthorized",
              "message": "m",
              "evidence": []
            },
            "tenant": {
              "fixture": "fx-tenant-state-13"
            },
            "coverage": "complete",
            "object": "post",
            "id": 2,
            "context": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:writer"
              },
              "session": "s-2",
              "now": 3000,
              "correlation": "c-1"
            }
          },
          "result": {
            "kind": "unauthorized",
            "message": "m",
            "evidence": [],
            "missing": null
          }
        }
      ]
    },
    {
      "id": "hide-unreadable",
      "description": "backend ops.rs mutate, the Unauthorized refusal of an update or a delete passed through hide_unreadable (unreadable-as-missing); every other rejection stands.",
      "params": [
        {
          "name": "d",
          "type": "domain-error"
        },
        {
          "name": "state",
          "type": "state"
        },
        {
          "name": "intent",
          "type": "intent"
        },
        {
          "name": "context",
          "type": "context"
        }
      ],
      "returns": "domain-error",
      "body": "if d.kind != error-kind.unauthorized then d else match state.tenant { None => d, Some(t) => match intent { update-record{object, id} => call unreadable-as-missing(d, t, state.coverage, object, id, context), delete-record{object, id} => call unreadable-as-missing(d, t, state.coverage, object, id, context), _ => d } }",
      "examples": [
        {
          "args": {
            "d": {
              "kind": "unauthorized",
              "message": "m",
              "evidence": []
            },
            "state": {
              "fixture": "fx-state-5"
            },
            "intent": {
              "delete-record": {
                "object": "post",
                "id": 3,
                "expected-version": null
              }
            },
            "context": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:writer"
              },
              "session": "s-2",
              "now": 3000,
              "correlation": "c-1"
            }
          },
          "result": {
            "kind": "unknown-record",
            "message": "no post 3",
            "evidence": [
              {
                "rule": "intent:unknown_record",
                "passed": false,
                "detail": "no post 3"
              }
            ],
            "missing": null
          }
        },
        {
          "args": {
            "d": {
              "kind": "unauthorized",
              "message": "m",
              "evidence": []
            },
            "state": {
              "fixture": "fx-state-5"
            },
            "intent": {
              "create-record": {
                "object": "post",
                "fields": {}
              }
            },
            "context": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:writer"
              },
              "session": "s-2",
              "now": 3000,
              "correlation": "c-1"
            }
          },
          "result": {
            "kind": "unauthorized",
            "message": "m",
            "evidence": [],
            "missing": null
          }
        }
      ]
    },
    {
      "id": "decide-mutation",
      "description": "backend ops.rs mutate, one decision, the decide of contract mutate-record (CT-263): the mutation as an intent (coerce-mutation), its needs asked for first, then the kernel's decision (intent-decision). An InsufficientState rejection naming a need asks for it; any other rejection is answered as the error body (api-error-of, after hide-unreadable). An accepted transition is handed to the commit with its intent and the record reply.",
      "params": [
        {
          "name": "mutation",
          "type": "mutation"
        },
        {
          "name": "context",
          "type": "context"
        },
        {
          "name": "state",
          "type": "state"
        },
        {
          "name": "times",
          "type": "map<string, i64>"
        }
      ],
      "returns": "accepted-intent",
      "errors": "api-failure",
      "let": [
        {
          "name": "intent",
          "expr": "try call coerce-mutation(mutation, state, context, times)"
        }
      ],
      "body": "match call first-missing(state.coverage, call needs(match state.tenant { Some(t) => t.schema, None => null }, intent)) { Some(n) => fail(api-failure.insufficient-state(n)), None => match call intent-decision(state, intent, context) { Ok(tr) => accepted-intent{intent, transition: tr, reply: call mutation-reply-of(tr)}, Err(e) => match e { rejected(d) => match d.missing { Some(n) => if d.kind == error-kind.insufficient-state then fail(api-failure.insufficient-state(n)) else fail(api-failure.refused(call api-error-of(call hide-unreadable(d, state, intent, context), context))), None => fail(api-failure.refused(call api-error-of(call hide-unreadable(d, state, intent, context), context))) } } } }",
      "examples": [
        {
          "description": "The owner deletes a draft.",
          "args": {
            "mutation": {
              "delete": {
                "object": "post",
                "id": 3,
                "expected-version": 1
              }
            },
            "context": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:owner"
              },
              "session": "s-1",
              "now": 3000,
              "correlation": "c-1"
            },
            "state": {
              "fixture": "fx-state-5"
            },
            "times": {}
          },
          "result": {
            "intent": {
              "delete-record": {
                "object": "post",
                "id": 3,
                "expected-version": 1
              }
            },
            "transition": {
              "delta": {
                "tenant": "alpha",
                "base-revision": 5,
                "new-revision": 6,
                "next-record": 5,
                "event-seq": 6,
                "ops": [
                  {
                    "delete-record": {
                      "object": "post",
                      "id": 3
                    }
                  }
                ]
              },
              "events": [
                {
                  "tenant": "alpha",
                  "seq": 6,
                  "revision": 6,
                  "at": 3000,
                  "principal": {
                    "user": "alpha:owner"
                  },
                  "correlation": "c-1",
                  "body": {
                    "record-deleted": {
                      "before": {
                        "id": 3,
                        "object": "post",
                        "version": 1,
                        "created-by": "alpha:writer",
                        "created-at": 2001,
                        "updated-at": 2001,
                        "fields": {
                          "status": {
                            "str": "draft"
                          },
                          "title": {
                            "str": "A"
                          }
                        }
                      }
                    }
                  }
                }
              ],
              "effects": [
                {
                  "publish": {
                    "seq": 6
                  }
                }
              ],
              "evidence": [
                {
                  "rule": "policy:builtin_owner",
                  "passed": true,
                  "detail": "Delete on Object(ObjectTypeId(\"post\"))"
                }
              ],
              "output": {
                "deleted": {
                  "object": "post",
                  "id": 3
                }
              }
            },
            "reply": {
              "object": "post",
              "id": 3,
              "version": null,
              "revision": 6,
              "event-seq": 6,
              "checks-passed": 1
            }
          }
        },
        {
          "description": "ops.rs a refused change to a record the caller cannot read answers as a missing record.",
          "args": {
            "mutation": {
              "delete": {
                "object": "post",
                "id": 3,
                "expected-version": null
              }
            },
            "context": {
              "tenant": "alpha",
              "principal": {
