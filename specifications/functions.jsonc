              "id": "theme",
              "label": "theme",
              "type": "string",
              "default": {
                "str": "light"
              },
              "levels": [
                "tenant",
                "team",
                "person"
              ]
            },
            "principal": {
              "user": "alpha:writer1"
            }
          },
          "result": {
            "source": "default",
            "value": {
              "str": "light"
            }
          }
        },
        {
          "description": "The tenant's override.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-31"
