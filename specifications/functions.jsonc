    {
      "id": "setting-rank",
      "description": "settings.rs rank: the place of a level from the least to the most specific.",
      "params": [
        {
          "name": "level",
          "type": "setting-level"
        }
      ],
      "returns": "u64",
      "body": "match level { platform => 0, tenant => 1, team => 2, person => 3 }",
      "examples": [
        {
          "args": {
            "level": "platform"
          },
          "result": 0
        },
        {
          "args": {
            "level": "tenant"
          },
          "result": 1
        },
        {
          "args": {
            "level": "team"
          },
          "result": 2
        },
        {
          "args": {
            "level": "person"
          },
          "result": 3
        }
      ]
    },
    {
      "id": "setting-open",
      "description": "settings.rs is_open: whether the definition lets a level hold an override that is read: the definition allows the level and no lock closes it. A lock of the platform leaves the platform level and a lock of the tenant leaves the platform and tenant levels (D-5043).",
      "params": [
        {
          "name": "def",
          "type": "setting-def"
        },
        {
          "name": "level",
          "type": "setting-level"
        }
      ],
      "returns": "bool",
      "body": "any(l in def.levels, l == level) && (match def.locked-by { None => true, Some(lock) => call setting-rank(level) <= call setting-rank(lock) })",
      "examples": [
        {
          "args": {
            "def": {
              "id": "theme",
              "label": "theme",
              "type": "string",
              "default": {
                "str": "light"
              },
              "levels": [
                "tenant",
                "team",
                "person"
              ]
            },
            "level": "team"
          },
          "result": true
        },
        {
          "args": {
            "def": {
              "id": "theme",
              "label": "theme",
              "type": "string",
              "default": {
                "str": "light"
              },
              "levels": [
                "tenant"
              ]
            },
            "level": "person"
          },
          "result": false
        },
        {
          "args": {
            "def": {
              "id": "theme",
              "label": "theme",
              "type": "string",
              "default": {
                "str": "light"
              },
              "levels": [
                "tenant",
                "team",
                "person"
              ],
              "locked-by": "tenant"
            },
            "level": "tenant"
          },
          "result": true
        },
        {
          "args": {
            "def": {
              "id": "theme",
              "label": "theme",
              "type": "string",
              "default": {
                "str": "light"
              },
              "levels": [
                "tenant",
                "team",
                "person"
              ],
              "locked-by": "tenant"
            },
            "level": "team"
          },
          "result": false
        },
        {
          "args": {
            "def": {
              "id": "theme",
              "label": "theme",
              "type": "string",
              "default": {
                "str": "light"
              },
              "levels": [
                "platform",
                "tenant"
              ],
              "locked-by": "platform"
            },
            "level": "tenant"
          },
          "result": false
        },
        {
          "args": {
            "def": {
              "id": "theme",
              "label": "theme",
              "type": "string",
              "default": {
                "str": "light"
              },
              "levels": [
                "platform",
                "tenant"
              ],
              "locked-by": "platform"
            },
            "level": "platform"
          },
          "result": true
        }
      ]
    },
    {
      "id": "setting-override-at",
      "description": "settings.rs override_of: one override, by setting, level and subject (the tenant, a team or a person), keyed \"<setting>/<level>/<subject>\".",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "setting",
          "type": "setting-id"
        },
        {
          "name": "level",
          "type": "setting-level"
        },
        {
          "name": "subject",
          "type": "string"
        }
      ],
      "returns": "option<setting-override>",
      "body": "match tenant.setting-values { None => null, Some(v) => get(v.overrides, format('{}/{}/{}', setting, level, subject)) }",
      "examples": [
        {
          "description": "An override that is held.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-31"
            },
            "setting": "theme",
            "level": "tenant",
            "subject": "alpha"
          },
          "result": {
            "setting": "theme",
            "level": "tenant",
            "subject": "alpha",
            "value": {
              "str": "dark"
            },
            "revision": 1,
            "set-by": "alpha:owner",
            "set-at": 4000
          }
        },
        {
          "description": "No override at that level.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-31"
            },
            "setting": "theme",
            "level": "person",
            "subject": "alpha:ed"
          },
          "result": null
        },
        {
          "description": "A tenant that holds no values.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-32"
            },
            "setting": "theme",
            "level": "tenant",
            "subject": "alpha"
          },
          "result": null
        }
      ]
    },
    {
      "id": "setting-revision-of",
      "description": "settings.rs tenant_revision: the revision of a setting at the tenant (SET-051): zero until its first change.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "setting",
          "type": "setting-id"
        }
      ],
      "returns": "u64",
      "body": "match tenant.setting-values { None => 0, Some(v) => match get(v.revisions, setting) { Some(r) => r, None => 0 } }",
      "examples": [
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-33"
            },
            "setting": "theme"
          },
          "result": 4
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-33"
            },
            "setting": "other"
          },
          "result": 0
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-32"
            },
            "setting": "theme"
          },
          "result": 0
        }
      ]
    },
    {
      "id": "setting-type-problem",
      "description": "settings.rs type_problem: why a value is not a value of a setting type, or none (D-5046, SET-021). The types held are bool, i64, string and timestamp; f64 has no value in the kernel's value algebra, and the id of a declared type of kind id, scalar or enum is not held, because the kernel knows no declared types. TypeMismatch for a value of another type or a type that is not held, LimitExceeded for a value past the maximums of a record field (65536 bytes of a string).",
      "params": [
        {
          "name": "ty",
          "type": "string"
        },
        {
          "name": "value",
          "type": "value"
        }
      ],
      "returns": "option<setting-problem>",
      "body": "if ty == 'bool' || ty == 'i64' || ty == 'string' || ty == 'timestamp' then (if (match value { bool(_) => ty == 'bool', int(_) => ty == 'i64', str(_) => ty == 'string', time(_) => ty == 'timestamp', _ => false }) then (let p = call value-limit-problem(value, 65536, 1000) in if p == '' then null else setting-problem{kind: error-kind.limit-exceeded, message: p}) else setting-problem{kind: error-kind.type-mismatch, message: format('a {} is not a value of type {}', call value-kind(value), ty)}) else setting-problem{kind: error-kind.type-mismatch, message: if ty == 'f64' then \"type f64 has no value in the kernel's value algebra, which holds no float\" else format('type {} is not one the kernel holds: bool, i64, string or timestamp (a declared id, scalar or enum type is not held)', ty)}",
      "examples": [
        {
          "args": {
            "ty": "bool",
            "value": {
              "bool": true
            }
          },
          "result": null
        },
        {
          "args": {
            "ty": "i64",
            "value": {
              "int": 7
            }
          },
          "result": null
        },
        {
          "args": {
            "ty": "string",
            "value": {
              "str": "dark"
            }
          },
          "result": null
        },
        {
          "args": {
            "ty": "timestamp",
            "value": {
              "time": 5000
            }
          },
          "result": null
        },
        {
          "description": "A string past the longest a field holds.",
          "args": {
            "ty": "string",
            "value": {
              "str": ""
            }
          },
          "result": {
            "kind": "limit-exceeded",
            "message": "a string of 65537 bytes is longer than the maximum of 65536"
          }
        },
        {
          "description": "A value of another type.",
          "args": {
            "ty": "bool",
            "value": {
              "str": "yes"
            }
          },
          "result": {
            "kind": "type-mismatch",
            "message": "a string is not a value of type bool"
          }
        },
        {
          "args": {
            "ty": "i64",
            "value": {
              "bool": true
            }
          },
          "result": {
            "kind": "type-mismatch",
            "message": "a bool is not a value of type i64"
          }
        },
        {
          "args": {
            "ty": "timestamp",
            "value": {
              "int": 1
            }
          },
          "result": {
            "kind": "type-mismatch",
            "message": "a int is not a value of type timestamp"
          }
        },
        {
          "args": {
            "ty": "string",
            "value": {
              "ref": 3
            }
          },
          "result": {
            "kind": "type-mismatch",
            "message": "a reference is not a value of type string"
          }
        },
        {
          "description": "A type the kernel holds no float for.",
          "args": {
            "ty": "f64",
            "value": {
              "int": 1
            }
          },
          "result": {
            "kind": "type-mismatch",
            "message": "type f64 has no value in the kernel's value algebra, which holds no float"
          }
        },
        {
          "description": "A declared type is not held.",
          "args": {
            "ty": "tier",
            "value": {
              "str": "gold"
            }
          },
          "result": {
            "kind": "type-mismatch",
            "message": "type tier is not one the kernel holds: bool, i64, string or timestamp (a declared id, scalar or enum type is not held)"
          }
        }
      ]
    },
    {
      "id": "setting-found-of",
      "description": "settings.rs resolve_definition: the value of a setting for a principal and the level it came from (SET-010 to SET-014): the person's own override, then that of the first team in id order (the ascending byte order of the identifiers, SET-011) that has the person as a member and an override, then the tenant's, then the default. A level the definition does not allow, or that a lock closes, is ignored; its override is kept (SET-024). An anonymous principal and the system have no person and no team, so they are answered from the tenant level and the default (SET-013). The platform level is absent: the control plane holds it (settings.rs, module notes).",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "def",
          "type": "setting-def"
        },
        {
          "name": "principal",
          "type": "principal"
        }
      ],
      "returns": "setting-found",
      "let": [
        {
          "name": "person-hit",
          "expr": "match principal { user(id) => if call setting-open(def, setting-level.person) then (match call setting-override-at(tenant, def.id, setting-level.person, id) { Some(h) => [setting-found{source: setting-source.person, value: h.value}], None => [] }) else [], _ => [] }"
        },
        {
          "name": "team-hit",
          "expr": "match principal { user(id) => if call setting-open(def, setting-level.team) then fold(tm in values(call teams-of(tenant.schema)), acc = [], if acc != [] || !any(m in tm.members, m == id) then acc else match call setting-override-at(tenant, def.id, setting-level.team, tm.id) { Some(h) => [setting-found{source: setting-source.team, team: tm.id, value: h.value}], None => acc }) else [], _ => [] }"
        },
        {
          "name": "tenant-hit",
          "expr": "if call setting-open(def, setting-level.tenant) then (match call setting-override-at(tenant, def.id, setting-level.tenant, tenant.id) { Some(h) => [setting-found{source: setting-source.tenant, value: h.value}], None => [] }) else []"
        }
      ],
      "body": "let candidates = concat(concat(person-hit, team-hit), tenant-hit) in match get(candidates, 0) { Some(f) => f, None => setting-found{source: setting-source.default, value: def.default} }",
      "examples": [
        {
          "description": "No override: the default.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-33",
              "with": {
                "setting-values.revisions.theme": 0
              }
            },
