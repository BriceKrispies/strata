    {
      "id": "lookup-page",
      "description": "rules.rs Lookup::page_of: at most limit records of an object type with an id above after (all when after is none), in id order; refused when the snapshot does not cover them.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "coverage",
          "type": "coverage"
        },
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "after",
          "type": "option<record-id>"
        },
        {
          "name": "limit",
          "type": "u32"
        }
      ],
      "returns": "list<record>",
      "errors": "rejection",
      "let": [
        {
          "name": "wanted",
          "expr": "need.page-of{object, after, limit}"
        }
      ],
      "body": "if call covers(coverage, wanted) then match get(tenant.records, object) { Some(rs) => take(filter(r in values(rs), match after { Some(a) => r.id > a, None => true }), limit), None => [] } else fail(rejection.rejected(call insufficient(wanted)))",
      "examples": [
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-9"
            },
            "coverage": {
              "partial": [
                {
                  "page-of": {
                    "object": "note",
                    "after": null,
                    "limit": 5
                  }
                }
              ]
            },
            "object": "note",
            "after": null,
            "limit": 5
          },
          "result": [
            {
              "id": 1,
              "object": "note",
              "version": 1,
              "created-by": "alpha:writer1",
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "slug": {
                  "str": "first"
                },
                "status": {
                  "str": "draft"
                },
                "title": {
                  "str": "First"
                }
              }
            }
          ]
        },
        {
          "description": "An object type that holds no record has an empty page.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-9"
            },
            "coverage": "complete",
            "object": "person",
            "after": null,
            "limit": 5
          },
          "result": []
        },
        {
          "description": "No record has an id above the cursor.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-9"
            },
            "coverage": "complete",
            "object": "note",
            "after": 1,
            "limit": 5
          },
          "result": []
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-9"
            },
            "coverage": {
              "partial": [
                {
                  "record": {
                    "object": "note",
                    "id": 1
                  }
                }
              ]
            },
            "object": "note",
            "after": null,
            "limit": 5
          },
          "error": {
            "rejected": {
              "kind": "insufficient-state",
              "message": "the snapshot does not cover PageOf { object: ObjectTypeId(\"note\"), after: None, limit: 5 }",
              "evidence": [
                {
                  "rule": "coverage",
                  "passed": false,
                  "detail": "PageOf { object: ObjectTypeId(\"note\"), after: None, limit: 5 }"
                }
              ],
              "missing": {
                "page-of": {
                  "object": "note",
                  "after": null,
                  "limit": 5
                }
              }
            }
          }
        }
      ]
    },
    {
      "id": "named-read",
      "description": "crates/kernel/src/read.rs read and query_plan.rs read_named, the named branch of kernel-read: refuses an unknown query (UnknownQuery), a parameter it does not declare and a page size or cursor it refuses (query-page-errors), then answers one page. A query served by a window (query-windowed) examines at most 200 records after the cursor, keeps those the principal may read (visible-in), and returns the first page-size of them as the reader receives them (redact) with a cursor after the last one it returned, or after the last record of the window when the window was full. Any other query examines at most 10001 records of its object type and is refused with limit-exceeded above 10000; each record the principal may read is taken as the reader receives it (redact) and kept when the filter holds of it (KRN-2522; a record the filter cannot be evaluated on is left out of the answer); the rows are sorted by the order keys and then by id, and the cursor is an offset. Read policies, the filter and the field read conditions follow a reference through the snapshot's lookup (rule-lookup), and a record one of them needs that the snapshot does not cover is InsufficientState naming it, in the order the records are examined (WG-5096). A page is not padded: a reader who may read few of the records examined gets a short page and a cursor.",
      "params": [
        {
          "name": "t",
          "type": "tenant-state"
        },
        {
          "name": "coverage",
          "type": "coverage"
        },
        {
          "name": "context",
          "type": "context"
        },
        {
          "name": "query",
          "type": "query-id"
        },
        {
          "name": "params",
          "type": "map<string, value>"
        },
        {
          "name": "page-size",
          "type": "option<u32>"
        },
        {
          "name": "cursor",
          "type": "option<page-cursor>"
        }
      ],
      "returns": "read-result",
      "errors": "rejection",
      "body": "match get(t.schema.queries, query) { None => fail(rejection.rejected(domain-error{kind: error-kind.unknown-query, message: format('no query {}', query), evidence: []})), Some(def) => match find(k in keys(params), !any(p in def.params, p == k)) { Some(extra) => fail(rejection.rejected(domain-error{kind: error-kind.invalid-intent, message: format('query {} has no parameter {}', query, extra), evidence: []})), None => match get(call query-page-errors(def, page-size, cursor), 0) { Some(e) => fail(rejection.rejected(e)), None => let windowed = call query-windowed(def) in let size = call query-page-size(def, page-size) in let window = try call lookup-page(t, coverage, def.object, call cursor-after(cursor), if windowed then 200 else 10001) in if !windowed && length(window) > 10000 then fail(rejection.rejected(domain-error{kind: error-kind.limit-exceeded, message: format('query {} orders {} records, more than the scan bound of 10000', query, def.object), evidence: [check{rule: format('scan-bound:{}', query), passed: false, detail: 'the query is not served by a window of the object type'}]})) else let roles = call roles-of(t, context.principal) in let kept = fold(r in window, acc = [], if !(try call visible-in(t, coverage, context.principal, r, context.now)) then acc else let shown = if windowed then r else try call redact(t, coverage, context.principal, context.now, r) in match def.filter { None => concat(acc, [shown]), Some(filter) => let reach = rule-reach{tenant: t, coverage, subject: subject{old: shown, new: shown}} in match eval(tenant-rule-language, filter, expr-env{record: call record-scope(shown), old: call record-scope(shown), new: call record-scope(shown), param: params, now: value.time(context.now), principal: call principal-value(context.principal), has_role: roles}, call rule-lookup(reach)) { Ok(x) => if x == value.bool(true) then concat(acc, [shown]) else acc, Err(_) => match call rule-missing(filter, reach) { Some(n) => fail(rejection.rejected(call insufficient(n))), None => acc } } }) in let sorted = call order-rows(kept, def.order) in let offset = call cursor-offset(cursor) in if windowed then read-result{rows: try call redact-rows(t, coverage, context.principal, context.now, take(sorted, size)), revision: t.revision, schema-version: t.schema.version, next: if length(sorted) > size then match get(fold(r in take(sorted, size), acc = [], [r]), 0) { Some(r) => page-cursor.after(r.id), None => null } else if length(window) == 200 then match get(fold(r in window, acc = [], [r]), 0) { Some(r) => page-cursor.after(r.id), None => null } else null } else read-result{rows: filter(r in take(sorted, offset + size), !any(d in take(sorted, offset), d.id == r.id)), revision: t.revision, schema-version: t.schema.version, next: if offset + size < length(sorted) then page-cursor.offset(offset + size) else null} } } }",
      "examples": [
        {
          "description": "A scan: the owner reads the last title first, one row, and a cursor for the rest.",
          "args": {
            "t": {
              "fixture": "fx-tenant-state-13"
            },
            "coverage": "complete",
            "context": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:owner"
