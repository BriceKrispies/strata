    {
      "id": "duplicate-check",
      "description": "transition.rs duplicate_pair (CMS-1556): over the records of an object type in id order, the first record whose values in every field of a composite unique constraint, none of them null, equal those of an earlier record, as the failed check unique:<object>.<constraint> naming the earlier and the later record; none when there is no such pair.",
      "params": [
        {
          "name": "records",
          "type": "list<record>"
        },
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "u",
          "type": "unique-def"
        }
      ],
      "returns": "list<check>",
      "let": [
        {
          "name": "keyed",
          "expr": "filter(r in records, all(f in u.fields, match get(r.fields, f) { Some(x) => !call value-is-null(x), None => false }))"
        },
        {
          "name": "names",
          "expr": "fold(f in u.fields, acc = '', if acc == '' then format('{}', f) else format('{}, {}', acc, f))"
        },
        {
          "name": "found",
          "expr": "fold(r in keyed, acc = [], if acc != [] then acc else match find(e in keyed, e.id < r.id && all(f in u.fields, get(e.fields, f) == get(r.fields, f))) { Some(e) => [format('records {} and {} have the same values in {}', e.id, r.id, names)], None => [] })"
        }
      ],
      "body": "map(detail in found, check{rule: format('unique:{}.{}', object, u.id), passed: false, detail})",
      "examples": [
        {
          "args": {
            "records": [
              {
                "id": 1,
                "object": "note",
                "version": 1,
                "created-by": "alpha:writer1",
                "created-at": 5000,
                "updated-at": 5000,
                "fields": {
                  "status": {
                    "str": "draft"
                  },
                  "title": {
                    "str": "First"
                  }
                }
              },
              {
                "id": 2,
                "object": "note",
                "version": 1,
                "created-by": "alpha:writer1",
                "created-at": 5000,
                "updated-at": 5000,
                "fields": {
                  "status": {
                    "str": "draft"
                  },
                  "title": {
                    "str": "First"
                  }
                }
              },
              {
                "id": 3,
                "object": "note",
                "version": 1,
                "created-by": "alpha:writer1",
                "created-at": 5000,
                "updated-at": 5000,
                "fields": {
                  "status": {
                    "str": "draft"
                  },
                  "title": {
                    "str": "Second"
                  }
                }
              }
            ],
            "object": "note",
            "u": {
              "id": "title_status",
              "fields": [
                "title",
                "status"
              ],
              "message": "One note per title and status."
            }
          },
          "result": [
            {
              "rule": "unique:note.title_status",
              "passed": false,
              "detail": "records 1 and 2 have the same values in title, status"
            }
          ]
        },
        {
          "args": {
            "records": [
              {
                "id": 1,
                "object": "note",
                "version": 1,
                "created-by": "alpha:writer1",
                "created-at": 5000,
                "updated-at": 5000,
                "fields": {
                  "status": {
                    "str": "draft"
                  },
                  "title": {
                    "str": "First"
                  }
                }
              },
              {
                "id": 2,
                "object": "note",
                "version": 1,
                "created-by": "alpha:writer1",
                "created-at": 5000,
                "updated-at": 5000,
                "fields": {
                  "status": {
                    "str": "draft"
                  },
                  "title": {
                    "str": "Second"
                  }
                }
              }
            ],
            "object": "note",
            "u": {
              "id": "title_status",
              "fields": [
                "title",
                "status"
              ],
              "message": "One note per title and status."
            }
          },
          "result": []
        },
        {
          "description": "A record without a value in a field of the constraint is left out (CMS-1555).",
          "args": {
