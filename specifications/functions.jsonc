        }
      ]
    },
    {
      "id": "single-reference",
      "description": "The object type a single reference field of an object type points at (types.rs FieldType::ref_target with many false); none for a field that is not one, or an object type or field the schema lacks.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "field",
          "type": "string"
        }
      ],
      "returns": "option<object-type-id>",
      "body": "match get(schema.objects, object) { None => null, Some(o) => match get(o.fields, field) { None => null, Some(d) => match d.ty { ref{target} => target, _ => null } } }",
      "examples": [
        {
