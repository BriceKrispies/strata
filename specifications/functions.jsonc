                }
              ],
              "missing": null
            }
          }
        }
      ]
    },
    {
      "id": "setting-revision-check",
      "description": "settings.rs write_setting: the revision the caller read the override at (zero for an override that does not exist) is the revision it holds, or the write is VersionConflict \"the override of <id> is at revision <held>, expected <expected>\" (setting:revision_is_current, SET-025).",
      "params": [
        {
          "name": "setting",
          "type": "setting-id"
        },
        {
          "name": "held",
          "type": "u64"
        },
        {
          "name": "expected",
          "type": "u64"
        },
        {
          "name": "evidence",
          "type": "list<check>"
        }
      ],
      "returns": "list<check>",
      "errors": "rejection",
      "body": "if expected == held then concat(evidence, [check{rule: 'setting:revision_is_current', passed: true, detail: format('{}', held)}]) else fail(call setting-refusal(evidence, error-kind.version-conflict, 'setting:revision_is_current', format('the override of {} is at revision {}, expected {}', setting, held, expected)))",
      "examples": [
        {
          "args": {
            "setting": "theme",
            "held": 3,
            "expected": 3,
            "evidence": []
          },
          "result": [
            {
              "rule": "setting:revision_is_current",
              "passed": true,
              "detail": "3"
            }
          ]
        },
        {
          "args": {
            "setting": "theme",
            "held": 0,
            "expected": 0,
            "evidence": []
          },
          "result": [
            {
              "rule": "setting:revision_is_current",
              "passed": true,
              "detail": "0"
            }
          ]
        },
        {
          "args": {
            "setting": "theme",
            "held": 3,
            "expected": 2,
            "evidence": []
          },
          "error": {
            "rejected": {
              "kind": "version-conflict",
              "message": "the override of theme is at revision 3, expected 2",
              "evidence": [
                {
                  "rule": "setting:revision_is_current",
                  "passed": false,
                  "detail": "the override of theme is at revision 3, expected 2"
                }
              ],
              "missing": null
            }
          }
        }
      ]
    },
    {
      "id": "setting-override-count-check",
      "description": "settings.rs write_setting: a new override past the most a tenant holds is LimitExceeded \"<count> overrides is the maximum of <max>\" (setting:overrides_within_the_maximum, limits.rs MAX_SETTING_OVERRIDES). write-setting passes the count of the tenant and 100000; the maximum is a parameter so that an example can reach it.",
      "params": [
        {
          "name": "count",
          "type": "u64"
        },
        {
          "name": "max",
          "type": "u64"
        },
        {
          "name": "evidence",
          "type": "list<check>"
        }
      ],
      "returns": "list<check>",
      "errors": "rejection",
      "body": "if count >= max then fail(call setting-refusal(evidence, error-kind.limit-exceeded, 'setting:overrides_within_the_maximum', format('{} overrides is the maximum of {}', count, max))) else evidence",
      "examples": [
        {
          "args": {
            "count": 2,
            "max": 3,
            "evidence": []
          },
          "result": []
        },
        {
          "args": {
            "count": 3,
            "max": 3,
            "evidence": [
              {
                "rule": "x",
                "passed": true,
                "detail": "y"
              }
            ]
          },
          "error": {
            "rejected": {
              "kind": "limit-exceeded",
              "message": "3 overrides is the maximum of 3",
              "evidence": [
                {
                  "rule": "x",
                  "passed": true,
                  "detail": "y"
                },
                {
                  "rule": "setting:overrides_within_the_maximum",
                  "passed": false,
                  "detail": "3 overrides is the maximum of 3"
                }
              ],
              "missing": null
            }
          }
        }
      ]
    },
    {
      "id": "setting-existence-check",
      "description": "settings.rs write_setting: removing an override that does not exist is InvalidIntent \"there is no override of <id> to remove\" (setting:override_exists); writing a new one is checked against the most overrides a tenant holds (setting-override-count-check, 100000).",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "setting",
          "type": "setting-id"
        },
        {
          "name": "value",
          "type": "option<value>"
        },
        {
          "name": "current",
          "type": "option<setting-override>"
        },
        {
          "name": "evidence",
          "type": "list<check>"
        }
      ],
      "returns": "list<check>",
      "errors": "rejection",
      "body": "match value { None => match current { None => fail(call setting-refusal(evidence, error-kind.invalid-intent, 'setting:override_exists', format('there is no override of {} to remove', setting))), Some(_) => evidence }, Some(_) => match current { Some(_) => evidence, None => try call setting-override-count-check(match tenant.setting-values { Some(v) => length(keys(v.overrides)), None => 0 }, 100000, evidence) } }",
      "examples": [
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-31"
            },
            "setting": "theme",
            "value": {
              "str": "x"
            },
            "current": {
              "setting": "theme",
              "level": "tenant",
              "subject": "alpha",
              "value": {
                "str": "dark"
              },
              "revision": 1,
              "set-by": "alpha:owner",
              "set-at": 4000
            },
            "evidence": []
          },
          "result": []
        },
        {
          "args": {
