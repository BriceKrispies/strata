      ]
    },
    {
      "id": "workflow-has-state",
      "description": "schema.rs WorkflowDef::states contains a state: an initial state, or the source or target of a transition.",
      "params": [
        {
          "name": "workflow",
          "type": "workflow-def"
        },
        {
          "name": "state",
          "type": "string"
        }
      ],
      "returns": "bool",
      "body": "any(s in workflow.initial, s == state) || any(t in workflow.transitions, t.from == state || t.to == state)",
      "examples": [
        {
          "args": {
            "workflow": {
              "fixture": "fx-workflow-def-1"
            },
            "state": "published"
          },
          "result": true
        },
        {
          "args": {
            "workflow": {
              "fixture": "fx-workflow-def-1"
            },
            "state": "archived"
          },
          "result": false
        }
      ]
    },
    {
      "id": "principal-value",
      "description": "expr.rs eval, Expr::Principal: the acting principal's id as a string for a user; null for an anonymous or system principal.",
      "params": [
        {
          "name": "who",
          "type": "principal"
        }
      ],
      "returns": "value",
      "body": "match who { user(id) => value.str(id), _ => call null-value() }",
      "examples": [
        {
          "args": {
            "who": {
              "user": "alpha:writer1"
            }
          },
          "result": {
            "str": "alpha:writer1"
          }
        },
        {
          "args": {
            "who": "anonymous"
          },
          "result": "null"
        }
      ]
    },
    {
      "id": "outcome-pass",
      "description": "rules.rs Validation::pass.",
      "params": [
        {
          "name": "acc",
          "type": "validation-outcome"
        },
        {
          "name": "rule",
          "type": "string"
        },
        {
          "name": "detail",
          "type": "string"
        }
      ],
      "returns": "validation-outcome",
      "body": "validation-outcome{passed: concat(acc.passed, [check{rule, passed: true, detail}]), failed: acc.failed}",
      "examples": [
        {
          "args": {
            "acc": {
              "passed": [],
              "failed": []
            },
            "rule": "type:note.title",
            "detail": "string"
          },
          "result": {
            "passed": [
              {
                "rule": "type:note.title",
                "passed": true,
                "detail": "string"
              }
            ],
            "failed": []
          }
        }
      ]
    },
    {
      "id": "outcome-fail",
      "description": "rules.rs Validation::fail.",
      "params": [
        {
          "name": "acc",
          "type": "validation-outcome"
        },
        {
          "name": "kind",
          "type": "error-kind"
        },
        {
          "name": "rule",
          "type": "string"
        },
        {
          "name": "detail",
          "type": "string"
        }
      ],
      "returns": "validation-outcome",
      "body": "validation-outcome{passed: acc.passed, failed: concat(acc.failed, [validation-failure{check: check{rule, passed: false, detail}, kind}])}",
      "examples": [
        {
          "args": {
            "acc": {
              "passed": [],
              "failed": []
            },
            "kind": "unknown-field",
            "rule": "field:note.nope",
            "detail": "no such field"
          },
          "result": {
            "passed": [],
            "failed": [
              {
                "check": {
                  "rule": "field:note.nope",
                  "passed": false,
                  "detail": "no such field"
                },
                "kind": "unknown-field"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "unknown-field-checks",
      "description": "rules.rs validate_record, first loop: a candidate field the object type does not declare is field:<object>.<field>, UnknownField. start is the outcome so far (the record limit of validate-record).",
      "params": [
        {
          "name": "object",
          "type": "object-type-def"
        },
        {
          "name": "candidate",
          "type": "record"
        },
        {
          "name": "start",
          "type": "validation-outcome"
        }
      ],
      "returns": "validation-outcome",
      "body": "fold(f in keys(candidate.fields), acc = start, if get(object.fields, f) == null then call outcome-fail(acc, error-kind.unknown-field, format('field:{}.{}', object.id, f), 'no such field') else acc)",
      "examples": [
        {
          "args": {
            "object": {
              "fixture": "fx-object-type-def-1"
            },
            "candidate": {
              "id": 2,
              "object": "note",
              "version": 1,
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "title": {
                  "str": "T"
                },
                "slug": {
                  "str": "x"
                },
                "nope": {
                  "str": "y"
                }
              }
            },
            "start": {
              "passed": [],
              "failed": []
            }
          },
          "result": {
            "passed": [],
            "failed": [
              {
                "check": {
                  "rule": "field:note.nope",
                  "passed": false,
                  "detail": "no such field"
                },
                "kind": "unknown-field"
              }
            ]
          }
        },
        {
          "args": {
            "object": {
              "fixture": "fx-object-type-def-1"
            },
            "candidate": {
              "id": 1,
              "object": "note",
              "version": 1,
              "created-by": "alpha:writer1",
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "title": {
                  "str": "First"
                },
                "slug": {
                  "str": "first"
                },
                "status": {
                  "str": "draft"
                }
              }
            },
            "start": {
              "passed": [],
              "failed": []
            }
          },
          "result": {
            "passed": [],
            "failed": []
          }
        }
      ]
    },
    {
      "id": "field-step",
      "description": "rules.rs validate_record, second loop, one declared field: required:, then type: (a wrong type skips the rest of the field), unique: (the clashing record is named only to a principal who may read it: read.rs visible, against the tenant's own schema), and reference: per referenced id. Between required and type: limit-step (a limit the value breaks skips the rest of the field).",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "coverage",
          "type": "coverage"
        },
        {
          "name": "object",
          "type": "object-type-def"
        },
        {
          "name": "candidate",
          "type": "record"
        },
        {
          "name": "principal",
          "type": "principal"
        },
        {
          "name": "now",
          "type": "timestamp"
        },
        {
          "name": "acc",
          "type": "validation-outcome"
        },
        {
          "name": "field",
          "type": "field-def"
        }
      ],
      "returns": "validation-outcome",
      "errors": "rejection",
      "let": [
        {
          "name": "x",
          "expr": "match get(candidate.fields, field.id) { Some(y) => y, None => call null-value() }"
        },
        {
          "name": "at",
          "expr": "format('{}.{}', object.id, field.id)"
        }
      ],
      "body": "if call value-is-null(x) then (if field.required then call outcome-fail(acc, error-kind.missing-required, format('required:{}', at), 'a value is required') else acc) else let a1 = if field.required then call outcome-pass(acc, format('required:{}', at), 'present') else acc in let l1 = call limit-step(a1, at, field, x, 65536, 1000, 200) in if length(l1.failed) != length(a1.failed) then l1 else if !call field-type-admits(field.ty, x) then call outcome-fail(a1, error-kind.type-mismatch, format('type:{}', at), format('expected {}, found {}', call field-type-name(field.ty), call value-kind(x))) else let a2 = call outcome-pass(a1, format('type:{}', at), call field-type-name(field.ty)) in let a3 = if field.unique then (match find(o in try call lookup-by-field(tenant, coverage, object.id, field.id, x), o.id != candidate.id) { Some(o) => if call visible(tenant, principal, o, now) then call outcome-fail(a2, error-kind.unique-violated, format('unique:{}', at), format('record {} already has this value', o.id)) else call outcome-fail(a2, error-kind.unique-violated, format('unique:{}', at), 'another record already has this value'), None => call outcome-pass(a2, format('unique:{}', at), 'no other record has this value') }) else a2 in match call ref-target(field.ty) { Some(target) => fold(id in call refs-in(x), a = a3, match try call lookup-record(tenant, coverage, target, id) { Some(_) => call outcome-pass(a, format('reference:{}', at), format('{} {} exists', target, id)), None => call outcome-fail(a, error-kind.dangling-reference, format('reference:{}', at), format('{} {} does not exist', target, id)) }), None => a3 }",
      "examples": [
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-4"
            },
            "coverage": "complete",
            "object": {
              "fixture": "fx-object-type-def-1"
            },
            "candidate": {
              "id": 1,
              "object": "note",
              "version": 1,
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "slug": {
                  "str": "x"
                }
              }
            },
            "acc": {
              "passed": [],
              "failed": []
            },
            "field": {
              "id": "title",
              "label": "title",
              "ty": "str",
              "required": true,
              "unique": false
            },
            "principal": {
              "user": "alpha:writer1"
            },
            "now": 5001
          },
          "result": {
            "passed": [],
            "failed": [
              {
                "check": {
                  "rule": "required:note.title",
                  "passed": false,
                  "detail": "a value is required"
                },
                "kind": "missing-required"
              }
            ]
          }
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-4"
            },
            "coverage": "complete",
            "object": {
              "fixture": "fx-object-type-def-1"
            },
            "candidate": {
              "id": 1,
              "object": "note",
              "version": 1,
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "title": {
                  "int": 3
                }
              }
            },
            "acc": {
              "passed": [],
              "failed": []
            },
            "field": {
              "id": "title",
              "label": "title",
              "ty": "str",
              "required": true,
              "unique": false
            },
            "principal": {
              "user": "alpha:writer1"
            },
            "now": 5001
          },
          "result": {
            "passed": [
              {
                "rule": "required:note.title",
                "passed": true,
                "detail": "present"
              }
            ],
            "failed": [
              {
                "check": {
                  "rule": "type:note.title",
                  "passed": false,
                  "detail": "expected string, found int"
                },
                "kind": "type-mismatch"
              }
            ]
          }
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-4"
            },
            "coverage": "complete",
            "object": {
              "fixture": "fx-object-type-def-1"
            },
            "candidate": {
              "id": 1,
              "object": "note",
              "version": 1,
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {}
            },
            "acc": {
              "passed": [],
              "failed": []
            },
            "field": {
              "id": "body",
              "label": "body",
              "ty": "str",
              "required": false,
              "unique": false
            },
            "principal": {
              "user": "alpha:writer1"
            },
            "now": 5001
          },
          "result": {
            "passed": [],
            "failed": []
          }
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-4"
            },
            "coverage": "complete",
            "object": {
              "fixture": "fx-object-type-def-1"
            },
            "candidate": {
              "id": 2,
              "object": "note",
              "version": 1,
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "author": {
                  "ref": 1
                }
              }
            },
            "acc": {
              "passed": [],
              "failed": []
            },
            "field": {
              "id": "author",
              "label": "Author",
              "ty": {
                "ref": {
                  "target": "person",
                  "on-delete": "set-null"
                }
              },
              "required": false,
              "unique": false
            },
            "principal": {
              "user": "alpha:writer1"
            },
            "now": 5001
          },
          "result": {
            "passed": [
              {
                "rule": "type:note.author",
                "passed": true,
                "detail": "reference<person>"
              },
              {
                "rule": "reference:note.author",
                "passed": true,
                "detail": "person 1 exists"
              }
            ],
            "failed": []
          }
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-4"
            },
            "coverage": {
              "partial": []
            },
            "object": {
              "fixture": "fx-object-type-def-1"
            },
            "candidate": {
              "id": 2,
              "object": "note",
              "version": 1,
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "author": {
                  "ref": 99
                }
              }
            },
            "acc": {
              "passed": [],
              "failed": []
            },
            "field": {
              "id": "author",
              "label": "Author",
              "ty": {
                "ref": {
                  "target": "person",
                  "on-delete": "set-null"
                }
              },
              "required": false,
              "unique": false
            },
            "principal": {
              "user": "alpha:writer1"
            },
            "now": 5001
          },
          "error": {
            "rejected": {
              "kind": "insufficient-state",
              "message": "the snapshot does not cover Record { object: ObjectTypeId(\"person\"), id: RecordId(99) }",
              "evidence": [
                {
                  "rule": "coverage",
                  "passed": false,
                  "detail": "Record { object: ObjectTypeId(\"person\"), id: RecordId(99) }"
                }
              ],
              "missing": {
                "record": {
                  "object": "person",
                  "id": 99
                }
              }
            }
          }
        }
      ]
    },
    {
      "id": "workflow-checks",
      "description": "rules.rs validate_record, workflow loop: for each workflow of the object type (in id order) whose field holds a string, workflow_state:<workflow> passes when the string is a state of the workflow and fails with WorkflowViolation otherwise.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "object",
          "type": "object-type-def"
        },
        {
          "name": "candidate",
          "type": "record"
        },
        {
          "name": "acc",
          "type": "validation-outcome"
        }
      ],
      "returns": "validation-outcome",
      "body": "fold(w in filter(w in values(schema.workflows), w.object == object.id), a = acc, match get(candidate.fields, w.field) { Some(x) => match x { str(state) => if call workflow-has-state(w, state) then call outcome-pass(a, format('workflow_state:{}', w.id), format('{} is a state', state)) else call outcome-fail(a, error-kind.workflow-violation, format('workflow_state:{}', w.id), format('{} is not a state', state)), _ => a }, None => a })",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-2"
            },
            "object": {
              "fixture": "fx-object-type-def-1"
            },
            "candidate": {
              "id": 1,
              "object": "note",
              "version": 1,
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "status": {
                  "str": "archived"
                }
              }
            },
            "acc": {
              "passed": [],
              "failed": []
            }
          },
          "result": {
            "passed": [],
            "failed": [
              {
                "check": {
                  "rule": "workflow_state:note_status",
                  "passed": false,
                  "detail": "archived is not a state"
                },
                "kind": "workflow-violation"
              }
            ]
          }
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-2"
            },
            "object": {
              "fixture": "fx-object-type-def-1"
            },
            "candidate": {
              "id": 1,
              "object": "note",
              "version": 1,
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "status": {
                  "str": "published"
                }
              }
            },
            "acc": {
              "passed": [],
              "failed": []
            }
          },
          "result": {
            "passed": [
              {
                "rule": "workflow_state:note_status",
                "passed": true,
                "detail": "published is a state"
              }
            ],
            "failed": []
          }
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-2"
            },
            "object": {
              "fixture": "fx-object-type-def-1"
            },
            "candidate": {
              "id": 1,
              "object": "note",
              "version": 1,
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {}
            },
            "acc": {
              "passed": [],
              "failed": []
            }
          },
          "result": {
            "passed": [],
            "failed": []
          }
        },
        {
          "description": "A workflow field holding something other than text is not checked.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-2"
            },
            "object": {
              "fixture": "fx-object-type-def-1"
            },
            "candidate": {
              "id": 1,
              "object": "note",
              "version": 1,
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "status": {
                  "int": 3
                }
              }
            },
            "acc": {
              "passed": [],
              "failed": []
            }
          },
          "result": {
            "passed": [],
            "failed": []
          }
        }
      ]
    },
    {
      "id": "constraint-checks",
      "description": "rules.rs validate_record, constraint loop: each constraint of the object type (in id order) is evaluated with record and new the candidate, old the stored record, no parameters; false fails with ConstraintViolated, an evaluation error with Evaluation, anything else passes. texts holds the printed form of each constraint expression (the kernel writes it with Display); see the report of WG-4937.",
      "params": [
        {
          "name": "object",
          "type": "object-type-def"
        },
        {
          "name": "candidate",
          "type": "record"
        },
        {
          "name": "old",
          "type": "option<record>"
        },
        {
          "name": "who",
          "type": "principal"
        },
        {
          "name": "now",
          "type": "timestamp"
        },
        {
          "name": "roles",
          "type": "set<role-id>"
        },
        {
          "name": "acc",
          "type": "validation-outcome"
        }
      ],
      "returns": "validation-outcome",
      "let": [
        {
          "name": "scope-new",
          "expr": "call record-scope(candidate)"
        },
        {
          "name": "env",
          "expr": "expr-env{record: scope-new, old: match old { Some(o) => call record-scope(o), None => null }, new: scope-new, param: {}, now: value.time(now), principal: call principal-value(who), has_role: roles}"
        }
      ],
      "body": "fold(c in values(object.constraints), a = acc, let rule = format('constraint:{}.{}', object.id, c.id) in let text = print(tenant-rule-language, c.expr) in match eval(tenant-rule-language, c.expr, env) { Ok(r) => match r { bool(b) => if b then call outcome-pass(a, rule, text) else call outcome-fail(a, error-kind.constraint-violated, rule, format('{} [{}]', c.message, text)), _ => call outcome-pass(a, rule, text) }, Err(e) => call outcome-fail(a, error-kind.evaluation, rule, format('{}: {}', text, e)) })",
      "examples": [
        {
          "description": "behaviour.rs a_rejection_explains_itself",
          "args": {
            "object": {
              "fixture": "fx-object-type-def-1"
            },
            "candidate": {
              "fixture": "fx-record-3"
            },
            "who": {
              "user": "alpha:writer1"
            },
            "now": 5000,
            "roles": [
              "public",
              "writer"
            ],
            "acc": {
              "passed": [],
              "failed": []
            }
          },
          "result": {
            "passed": [],
            "failed": [
              {
                "check": {
                  "rule": "constraint:note.title_length",
                  "passed": false,
                  "detail": "A title has at most 24 characters [(len(new.title) <= 24)]"
                },
                "kind": "constraint-violated"
              }
            ]
          }
        },
        {
          "description": "An unset excerpt makes len null, which does not violate.",
          "args": {
            "object": {
              "fixture": "fx-object-type-def-2",
              "with": {
                "constraints": {
                  "excerpt_length": {
                    "id": "excerpt_length",
                    "expr": {
                      "cmp": {
                        "op": "le",
                        "left": {
                          "len": {
                            "var": {
                              "scope": "new",
                              "field": "excerpt"
                            }
                          }
                        },
                        "right": {
                          "lit": {
                            "int": 280
                          }
                        }
                      }
                    },
                    "message": "An excerpt has at most 280 characters"
                  }
                }
              }
            },
