    {
      "id": "id-set",
      "description": "A BTreeSet<RecordId> collected into a list: each id once, in order.",
      "params": [
        {
          "name": "ids",
          "type": "list<record-id>"
        }
      ],
      "returns": "list<record-id>",
      "body": "fold(i in sortBy(i in ids, i), acc = [], if any(a in acc, a == i) then acc else concat(acc, [i]))",
      "examples": [
        {
          "args": {
            "ids": [
              3,
              1,
              3
            ]
          },
          "result": [
            1,
            3
          ]
        }
      ]
    },
    {
      "id": "included-refs",
      "description": "crates/substrate/src/project.rs included_refs: for each included field of the section that refers to an object type, the record ids the rows name in it (a reference, or the references of a list), each once, in order.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "section",
          "type": "view-section"
        },
        {
          "name": "rows",
          "type": "list<record>"
        }
      ],
      "returns": "map<field-id, included-target>",
      "body": "match get(schema.objects, object) { None => {}, Some(def) => fold(f in section.include, out = {}, match get(def.fields, f) { None => out, Some(fd) => match call ref-target(fd.ty) { None => out, Some(target) => insert(out, f, included-target{object: target, ids: call id-set(fold(r in rows, ids = [], concat(ids, call refs-in(call field-value(r, f)))))}) } }) }",
      "examples": [
        {
          "description": "A field that is not a reference includes nothing.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-16"
            },
            "object": "post",
            "section": {
              "query": "published",
              "args": {},
              "include": [
                "author",
                "title"
              ],
              "markdown": [],
              "single": false
            },
            "rows": {
              "fixture": "fx-list-record-1"
            }
          },
          "result": {
            "author": {
              "object": "person",
              "ids": [
                1
              ]
            }
          }
        }
      ]
    },
    {
      "id": "view-needs",
      "description": "crates/backend/src/ops.rs view, depends_on: the object types whose changes can alter a view, every record of which it loads: the object type of each section's query (a section of an unknown query adds nothing) and the target of each of its included reference fields.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "view",
          "type": "view-def"
        }
      ],
      "returns": "set<object-type-id>",
      "let": [
        {
          "name": "found",
          "expr": "fold(s in values(view.sections), acc = [], match get(schema.queries, s.query) { None => acc, Some(q) => concat(concat(acc, [q.object]), match get(schema.objects, q.object) { None => [], Some(o) => fold(f in s.include, xs = [], match get(o.fields, f) { None => xs, Some(fd) => match call ref-target(fd.ty) { Some(target) => concat(xs, [target]), None => xs } }) }) })"
        }
      ],
      "body": "fold(o in sortBy(o in found, o), acc = [], if any(a in acc, a == o) then acc else concat(acc, [o]))",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-16"
            },
            "view": {
              "id": "home",
              "route": "/",
              "title": "Home",
              "sections": {
                "posts": {
                  "query": "published",
                  "args": {},
                  "include": [
                    "author"
                  ],
                  "markdown": [],
                  "single": false
                }
              }
            }
          },
          "result": [
            "person",
            "post"
          ]
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-16"
            },
            "view": {
              "id": "home",
              "route": "/",
              "title": "Home",
              "sections": {
                "gone": {
                  "query": "nothing",
                  "args": {},
                  "include": [
                    "author"
                  ],
                  "markdown": [],
                  "single": false
                }
              }
            }
          },
          "result": []
        }
      ]
    },
    {
      "id": "without-others-authorship",
      "description": "crates/backend/src/ops.rs without_others_authorship (WG-4918): who created a record is told only to its creator; anyone else gets the record without created_by.",
      "params": [
        {
          "name": "principal",
          "type": "principal"
        },
        {
          "name": "r",
          "type": "record"
        }
      ],
      "returns": "record",
      "let": [
        {
          "name": "own",
          "expr": "match principal { user(id) => r.created-by == id, _ => false }"
        }
      ],
      "body": "if own || r.created-by == null then r else record{id: r.id, object: r.object, version: r.version, created-at: r.created-at, updated-at: r.updated-at, fields: r.fields}",
      "examples": [
        {
          "args": {
            "principal": "anonymous",
            "r": {
              "id": 2,
              "object": "post",
              "version": 1,
              "created-by": "alpha:writer",
              "created-at": 2000,
              "updated-at": 2000,
              "fields": {
                "author": {
                  "ref": 1
                },
                "status": {
                  "str": "published"
                },
                "title": {
                  "str": "B"
                }
              }
            }
          },
          "result": {
            "id": 2,
            "object": "post",
            "version": 1,
            "created-at": 2000,
            "updated-at": 2000,
            "fields": {
              "author": {
                "ref": 1
              },
              "status": {
                "str": "published"
              },
              "title": {
                "str": "B"
              }
            }
          }
        },
        {
          "args": {
            "principal": {
              "user": "alpha:writer"
            },
            "r": {
              "id": 2,
              "object": "post",
              "version": 1,
              "created-by": "alpha:writer",
              "created-at": 2000,
              "updated-at": 2000,
              "fields": {
                "author": {
                  "ref": 1
                },
                "status": {
                  "str": "published"
                },
                "title": {
                  "str": "B"
                }
              }
            }
          },
          "result": {
            "id": 2,
            "object": "post",
            "version": 1,
            "created-by": "alpha:writer",
            "created-at": 2000,
            "updated-at": 2000,
            "fields": {
              "author": {
                "ref": 1
              },
              "status": {
                "str": "published"
              },
              "title": {
                "str": "B"
              }
            }
          }
        }
      ]
    },
    {
      "id": "view-read",
      "description": "backend ops.rs view, one read of the kernel (kernel-read): a rejection is answered as the error body (api-error-of); InsufficientState naming a need asks for it.",
      "params": [
        {
          "name": "state",
          "type": "state"
        },
        {
          "name": "request",
          "type": "read-request"
        },
        {
          "name": "context",
          "type": "context"
        }
      ],
      "returns": "read-result",
      "errors": "api-failure",
      "body": "match call kernel-read(state, request, context) { Ok(r) => r, Err(e) => match e { rejected(d) => match d.missing { Some(n) => if d.kind == error-kind.insufficient-state then fail(api-failure.insufficient-state(n)) else fail(api-failure.refused(call api-error-of(d, context))), None => fail(api-failure.refused(call api-error-of(d, context))) } } }",
      "examples": [
        {
          "args": {
            "state": {
              "fixture": "fx-state-5"
            },
            "request": {
              "records": {
                "object": "person",
                "ids": [
                  1
                ]
              }
            },
            "context": {
              "tenant": "alpha",
              "principal": "anonymous",
              "session": null,
              "now": 3000,
              "correlation": "c-1"
            }
          },
          "result": {
            "rows": [
              {
                "id": 1,
                "object": "person",
                "version": 1,
                "created-by": "alpha:owner",
                "created-at": 1000,
                "updated-at": 1000,
                "fields": {
                  "name": {
                    "str": "Ada"
                  }
                }
              }
            ],
            "revision": 5,
            "schema-version": 2
          }
        },
        {
          "args": {
            "state": {
              "fixture": "fx-state-7"
            },
            "request": {
              "records": {
                "object": "person",
                "ids": [
                  1
                ]
              }
            },
            "context": {
              "tenant": "alpha",
              "principal": "anonymous",
              "session": null,
              "now": 3000,
              "correlation": "c-1"
            }
          },
          "error": {
            "insufficient-state": {
              "record": {
                "object": "person",
                "id": 1
              }
            }
          }
        },
        {
          "args": {
            "state": {
              "fixture": "fx-state-9"
            },
            "request": {
              "named": {
                "query": "nothing",
                "params": {}
              }
            },
            "context": {
              "tenant": "alpha",
              "principal": "anonymous",
              "session": null,
              "now": 3000,
              "correlation": "c-1"
            }
          },
          "error": {
            "refused": {
              "code": "not_found",
              "message": "no query nothing",
              "kind": "UnknownQuery",
              "failed": [],
              "correlation": "c-1"
            }
          }
        }
      ]
    },
    {
      "id": "view-section-step",
      "description": "crates/backend/src/ops.rs view, one section: its named read (section-request), then for each included field the records it names that the principal may read (included-refs, a records read). The rows and included records sent lose another principal's authorship (without-others-authorship); a single section's first row, authorship included, is kept for the sections that read it.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "state",
          "type": "state"
        },
        {
          "name": "context",
          "type": "context"
        },
        {
          "name": "route",
          "type": "map<string, string>"
        },
        {
          "name": "request",
          "type": "map<string, string>"
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "section",
          "type": "view-section"
        },
        {
          "name": "acc",
          "type": "view-progress"
        }
      ],
      "returns": "view-progress",
      "errors": "api-failure",
      "let": [
        {
          "name": "result",
          "expr": "try call view-read(state, call section-request(section, route, request, acc.done), context)"
        },
        {
          "name": "refs",
          "expr": "match get(tenant.schema.queries, section.query) { Some(q) => call included-refs(tenant.schema, q.object, section, result.rows), None => {} }"
        },
        {
          "name": "included",
          "expr": "fold(f in keys(refs), m = {}, match get(refs, f) { None => m, Some(tg) => insert(m, f, fold(r in (try call view-read(state, read-request.records{object: tg.object, ids: tg.ids}, context)).rows, rs = {}, insert(rs, r.id, call without-others-authorship(context.principal, r)))) })"
        }
      ],
      "body": "view-progress{done: if section.single then insert(acc.done, name, get(result.rows, 0)) else acc.done, sections: insert(acc.sections, name, section-data{single: section.single, rows: map(r in result.rows, call without-others-authorship(context.principal, r)), included, markdown: section.markdown}), revision: result.revision}",
      "examples": [
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-13"
            },
            "state": {
              "fixture": "fx-state-5"
            },
            "context": {
              "tenant": "alpha",
              "principal": "anonymous",
              "session": null,
              "now": 3000,
              "correlation": "c-1"
            },
            "route": {},
            "request": {},
            "name": "posts",
            "section": {
              "query": "published",
              "args": {},
              "include": [
                "author"
              ],
              "markdown": [],
              "single": false
            },
            "acc": {
              "done": {},
              "sections": {},
              "revision": 5
            }
          },
          "result": {
            "done": {},
            "sections": {
              "posts": {
                "single": false,
                "rows": [
                  {
                    "id": 2,
                    "object": "post",
                    "version": 1,
                    "created-at": 2000,
                    "updated-at": 2000,
                    "fields": {
                      "author": {
                        "ref": 1
                      },
                      "status": {
                        "str": "published"
                      },
                      "title": {
                        "str": "B"
                      }
                    }
                  },
                  {
                    "id": 4,
                    "object": "post",
                    "version": 1,
                    "created-at": 2002,
                    "updated-at": 2002,
                    "fields": {
                      "status": {
                        "str": "published"
                      },
                      "title": {
                        "str": "C"
                      }
                    }
                  }
                ],
                "included": {
                  "author": {
                    "1": {
                      "id": 1,
                      "object": "person",
                      "version": 1,
                      "created-at": 1000,
                      "updated-at": 1000,
                      "fields": {
                        "name": {
                          "str": "Ada"
                        }
                      }
                    }
                  }
                },
                "markdown": []
              }
            },
            "revision": 5
          }
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-13",
              "with": {
                "schema.policies": {},
                "schema.views": {},
                "records": {}
              }
            },
            "state": {
              "fixture": "fx-state-7",
              "with": {
                "tenant.schema.policies": {},
                "tenant.schema.views": {},
                "tenant.records": {}
              }
            },
            "context": {
              "tenant": "alpha",
              "principal": "anonymous",
              "session": null,
              "now": 3000,
              "correlation": "c-1"
            },
            "route": {},
            "request": {},
            "name": "posts",
            "section": {
              "query": "published",
              "args": {},
              "include": [
                "author"
              ],
              "markdown": [],
              "single": false
            },
            "acc": {
              "done": {},
              "sections": {},
              "revision": 5
            }
          },
          "error": {
            "insufficient-state": {
              "page-of": {
                "object": "post",
                "after": null,
                "limit": 10001
              }
            }
          }
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-12"
            },
            "state": {
              "fixture": "fx-state-9"
            },
            "context": {
              "tenant": "alpha",
              "principal": "anonymous",
              "session": null,
              "now": 3000,
              "correlation": "c-1"
            },
            "route": {},
            "request": {},
            "name": "posts",
            "section": {
              "query": "nothing",
              "args": {},
              "include": [
                "author"
              ],
              "markdown": [],
              "single": false
            },
            "acc": {
              "done": {},
              "sections": {},
