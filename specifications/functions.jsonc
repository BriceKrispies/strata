            }
          },
          "result": null
        },
        {
          "description": "An update binds old only when the principal read the record as it was: a reader of published notes sees the new record and not the draft before it.",
          "args": {
            "t": {
              "fixture": "fx-tenant-state-26",
              "with": {
                "schema.roles.reader": {
                  "id": "reader",
                  "label": "Reader"
                },
                "schema.policies.reader_reads_published": {
                  "id": "reader_reads_published",
                  "role": "reader",
                  "resource": {
                    "object": "note"
                  },
                  "actions": [
                    "read"
                  ],
                  "condition": {
                    "cmp": {
                      "op": "eq",
                      "left": {
