    {
      "id": "stamp-definitions",
      "description": "triggers.rs stamp_definitions: the changes of a schema change with every definition of a trigger or an automation stamped with who defined it and when, from the context and never from the input (D-7204, WFL-2201): defined-by is the acting person (none for the system or an anonymous caller), defined-at the time of the context. An automation defined again is no longer suspended: the change that defines it checks that its definer may confer every run-as role before it is accepted (WFL-1528), which is what lifts a suspension (D-6526).",
      "params": [
        {
          "name": "changes",
          "type": "list<schema-change>"
        },
        {
          "name": "ctx",
          "type": "context"
        }
      ],
      "returns": "list<schema-change>",
      "let": [
        {
          "name": "definer",
          "expr": "match ctx.principal { user(id) => id, _ => null }"
        }
      ],
      "body": "map(c in changes, match c { define-trigger(t) => schema-change.define-trigger(trigger-def{id: t.id, on: t.on, condition: t.condition, automation: t.automation, paused: t.paused, defined-by: definer, defined-at: ctx.now}), define-automation(a) => schema-change.define-automation(automation-def{id: a.id, label: a.label, run-as: a.run-as, run-key: a.run-key, start: a.start, steps: a.steps, defined-by: definer, defined-at: ctx.now}), _ => c })",
      "examples": [
        {
          "description": "A trigger and an automation take the acting person and the time of the context; a suspension is lifted; another change is left as it is.",
          "args": {
            "changes": [
              {
                "define-trigger": {
                  "id": "on_publish",
                  "on": {
                    "record-updated": {
                      "object": "note",
                      "transition": "publish"
                    }
                  },
                  "condition": {
                    "cmp": {
                      "op": "eq",
                      "left": {
                        "var": {
                          "scope": "new",
                          "field": "status"
                        }
                      },
                      "right": {
                        "lit": {
                          "str": "published"
                        }
                      }
                    }
                  },
                  "automation": "award",
                  "defined-by": "alpha:ed",
                  "defined-at": 1
                }
              },
              {
                "define-automation": {
                  "id": "award",
                  "label": "award",
                  "run-as": {
                    "roles": [
                      "editor"
                    ]
                  },
                  "start": "done",
                  "steps": {
                    "done": {
                      "action": "end"
                    }
                  },
                  "suspended-for": "editor",
                  "defined-by": "alpha:ed",
                  "defined-at": 1
                }
              },
              {
                "remove-field": {
                  "object": "note",
                  "field": "body"
                }
              }
            ],
            "ctx": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:owner"
              },
              "session": null,
              "now": 6000,
              "correlation": "test-6000"
            }
          },
          "result": [
            {
              "define-trigger": {
                "id": "on_publish",
                "on": {
                  "record-updated": {
                    "object": "note",
                    "transition": "publish"
                  }
                },
                "condition": {
                  "cmp": {
                    "op": "eq",
                    "left": {
                      "var": {
                        "scope": "new",
                        "field": "status"
                      }
                    },
                    "right": {
                      "lit": {
                        "str": "published"
                      }
                    }
                  }
                },
                "automation": "award",
                "defined-by": "alpha:owner",
                "defined-at": 6000
              }
            },
            {
              "define-automation": {
