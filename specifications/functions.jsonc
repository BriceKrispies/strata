    {
      "id": "team-role",
      "description": "transition.rs team_role: assign a role to a team or revoke it. Authorised as Manage on Members; the team must exist, the role must exist and not be public, and the role must be one the principal may confer, granted or revoked (require-conferrable). A grant must not give a member two duties kept apart (duty-made-by, ADM-1630). A revocation must leave the tenant an owner, counting the owners through teams (owner-lost). A member left with no role at all by a revocation has its sessions revoked.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "team",
          "type": "team-id"
        },
