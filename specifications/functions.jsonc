    {
      "id": "match-route",
      "description": "crates/substrate/src/project.rs match_route: the view (in id order) whose route has as many segments as the path and matches it segment by segment, a literal exactly and a :name taking the path's segment as its parameter; of several, the first with the most literal segments. wanted is the path split at / without empty segments, and routes each view's route so split and read (route-segment): stand-ins until the function language has string operations (WG-4957).",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "wanted",
          "type": "list<string>"
        },
        {
          "name": "routes",
          "type": "map<view-id, list<route-segment>>"
        }
      ],
      "returns": "option<route-match>",
      "let": [
        {
          "name": "picked",
          "expr": "fold(v in values(schema.views), best = route-pick{literal: 0, found: null}, let pattern = match get(routes, v.id) { Some(p) => p, None => [] } in if fold(s in pattern, n = 0, n + 1) != fold(w in wanted, n = 0, n + 1) then best else let tried = fold(seg in pattern, acc = route-try{at: 0, ok: true, literal: 0, params: {}}, match seg { param(name) => route-try{at: acc.at + 1, ok: acc.ok, literal: acc.literal, params: if acc.ok then insert(acc.params, name, match get(wanted, acc.at) { Some(w) => w, None => '' }) else acc.params}, literal(text) => route-try{at: acc.at + 1, ok: acc.ok && get(wanted, acc.at) == text, literal: if acc.ok then acc.literal + 1 else acc.literal, params: acc.params} }) in if tried.ok && (best.found == null || tried.literal > best.literal) then route-pick{literal: tried.literal, found: route-match{view: v, params: tried.params}} else best)"
        }
      ],
      "body": "picked.found",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-18"
            },
            "wanted": [
              "posts",
              "B"
            ],
            "routes": {
              "home": [],
              "one": [
                {
                  "literal": "posts"
                },
                {
                  "param": "title"
                }
              ]
            }
          },
          "result": {
            "view": {
              "id": "one",
              "route": "/posts/:title",
              "title": "Post",
              "sections": {
                "post": {
                  "query": "by_title",
                  "args": {
                    "title": {
                      "route": "title"
                    }
                  },
                  "include": [],
                  "markdown": [],
                  "single": true
                }
              }
            },
            "params": {
              "title": "B"
            }
          }
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-18"
            },
            "wanted": [],
            "routes": {
              "home": [],
              "one": [
                {
                  "literal": "posts"
                },
                {
                  "param": "title"
                }
              ]
            }
          },
          "result": {
            "view": {
              "id": "home",
              "route": "/",
              "title": "Home",
              "sections": {
                "posts": {
                  "query": "published",
                  "args": {},
                  "include": [
                    "author"
                  ],
                  "markdown": [],
                  "single": false
                }
              }
            },
            "params": {}
          }
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-18"
            },
            "wanted": [
              "pages",
              "B"
            ],
            "routes": {
              "home": [],
              "one": [
                {
                  "literal": "posts"
                },
                {
                  "param": "title"
                }
              ]
            }
          },
          "result": null
        },
        {
          "description": "The match with the most literal segments wins.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-18"
            },
            "wanted": [
              "posts",
              "new"
            ],
            "routes": {
              "home": [
                {
                  "literal": "posts"
                },
                {
                  "literal": "new"
                }
              ],
              "one": [
                {
                  "literal": "posts"
                },
                {
                  "param": "title"
                }
              ]
            }
          },
          "result": {
            "view": {
              "id": "home",
              "route": "/",
              "title": "Home",
              "sections": {
                "posts": {
                  "query": "published",
                  "args": {},
                  "include": [
                    "author"
                  ],
                  "markdown": [],
                  "single": false
                }
              }
            },
            "params": {}
          }
        }
      ]
    },
    {
      "id": "section-depends",
      "description": "project.rs section_order, depends: whether a section reads an attribute of another section's row.",
      "params": [
        {
          "name": "section",
          "type": "view-section"
        }
      ],
      "returns": "bool",
      "body": "any(a in values(section.args), match a { section => true, _ => false })",
      "examples": [
        {
          "args": {
            "section": {
              "query": "by_title",
              "args": {
                "title": {
                  "section": {
                    "section": "z_top",
                    "attribute": "title"
                  }
                }
              },
              "include": [],
              "markdown": [],
              "single": true
            }
          },
          "result": true
        },
        {
          "args": {
            "section": {
              "query": "published",
              "args": {},
              "include": [
                "author"
              ],
              "markdown": [],
              "single": false
            }
          },
          "result": false
        }
      ]
    },
    {
      "id": "section-order",
      "description": "crates/substrate/src/project.rs section_order: the section names in evaluation order, those that read no other section first, each group in name order. A section may read only a section that reads none (schema-problems).",
      "params": [
        {
          "name": "view",
          "type": "view-def"
        }
      ],
      "returns": "list<string>",
      "body": "concat(filter(n in keys(view.sections), match get(view.sections, n) { Some(s) => !call section-depends(s), None => false }), filter(n in keys(view.sections), match get(view.sections, n) { Some(s) => call section-depends(s), None => false }))",
      "examples": [
        {
          "description": "A section that reads another comes after the sections that read none.",
          "args": {
            "view": {
              "id": "feed",
              "route": "/",
              "title": "Feed",
              "sections": {
                "a_lead": {
                  "query": "by_title",
                  "args": {
                    "title": {
                      "section": {
                        "section": "z_top",
                        "attribute": "title"
                      }
                    }
                  },
                  "include": [],
                  "markdown": [],
                  "single": true
                },
                "z_top": {
                  "query": "newest",
                  "args": {},
                  "include": [],
                  "markdown": [],
                  "single": true
                }
              }
            }
          },
          "result": [
            "z_top",
            "a_lead"
          ]
        },
        {
          "args": {
            "view": {
              "id": "home",
              "route": "/",
              "title": "Home",
              "sections": {
                "posts": {
                  "query": "published",
                  "args": {},
                  "include": [
                    "author"
                  ],
                  "markdown": [],
                  "single": false
                }
              }
            }
          },
          "result": [
            "posts"
          ]
        }
      ]
    },
    {
      "id": "text-value",
      "description": "project.rs section_request, text: a route or request parameter as a string value, null when absent.",
      "params": [
        {
          "name": "text",
          "type": "option<string>"
        }
      ],
      "returns": "value",
      "body": "match text { Some(s) => value.str(s), None => call null-value() }",
      "examples": [
        {
          "args": {
            "text": "B"
          },
          "result": {
            "str": "B"
          }
        },
        {
          "args": {
            "text": null
          },
          "result": "null"
        }
      ]
    },
    {
      "id": "section-request",
      "description": "crates/substrate/src/project.rs section_request: the named read of a section, each argument (in name order) from a route parameter, a request parameter (each a string, null when absent), a constant, or an attribute of the single row of a section already evaluated (record-attribute; null when that section had no row). An argument that comes from a setting (setting) or from the reader (principal) is null here: the hand-written section_request_with resolves it for the reader.",
      "params": [
        {
          "name": "section",
          "type": "view-section"
        },
        {
          "name": "route",
          "type": "map<string, string>"
        },
        {
          "name": "request",
          "type": "map<string, string>"
        },
        {
          "name": "done",
          "type": "map<string, option<record>>"
        }
      ],
      "returns": "read-request",
      "body": "read-request.named{query: section.query, params: fold(k in keys(section.args), m = {}, match get(section.args, k) { None => m, Some(src) => insert(m, k, match src { route(key) => call text-value(get(route, key)), request(key) => call text-value(get(request, key)), const(x) => x, setting(s) => call null-value(), principal => call null-value(), section{section: from, attribute} => match get(done, from) { Some(row) => match row { Some(r) => call record-attribute(r, attribute), None => call null-value() }, None => call null-value() } }) })}",
      "examples": [
        {
          "args": {
            "section": {
              "query": "by_title",
              "args": {
                "title": {
                  "route": "title"
                }
              },
              "include": [],
              "markdown": [],
              "single": true
            },
            "route": {
              "title": "B"
            },
            "request": {},
            "done": {}
          },
          "result": {
            "named": {
              "query": "by_title",
              "params": {
                "title": {
                  "str": "B"
                }
              }
            }
          }
        },
        {
          "description": "publication_template.rs a_dependent_section_reads_through_the_single_row_it_depends_on.",
          "args": {
            "section": {
              "query": "by_title",
              "args": {
                "title": {
                  "section": {
                    "section": "z_top",
                    "attribute": "title"
                  }
                }
              },
              "include": [],
              "markdown": [],
              "single": true
            },
            "route": {},
            "request": {},
            "done": {
              "z_top": {
                "id": 4,
                "object": "post",
                "version": 1,
                "created-by": "alpha:owner",
                "created-at": 2002,
                "updated-at": 2002,
                "fields": {
                  "status": {
                    "str": "published"
                  },
                  "title": {
                    "str": "C"
                  }
                }
              }
            }
          },
          "result": {
            "named": {
              "query": "by_title",
              "params": {
                "title": {
                  "str": "C"
                }
              }
            }
          }
        },
        {
          "description": "A section read before had no row.",
          "args": {
            "section": {
              "query": "by_title",
              "args": {
                "title": {
                  "section": {
                    "section": "z_top",
                    "attribute": "title"
                  }
                }
              },
              "include": [],
              "markdown": [],
              "single": true
            },
            "route": {},
            "request": {},
            "done": {
              "z_top": null
            }
          },
          "result": {
            "named": {
              "query": "by_title",
              "params": {
                "title": "null"
              }
            }
          }
        },
        {
          "description": "An argument that comes from a setting is null in the generated function (SET-1540).",
          "args": {
            "section": {
              "query": "by_title",
              "args": {
                "title": {
                  "setting": "home_slug"
                }
              },
              "include": [],
              "markdown": [],
              "single": true
            },
            "route": {},
            "request": {},
            "done": {}
          },
          "result": {
            "named": {
              "query": "by_title",
              "params": {
                "title": "null"
              }
            }
          }
        }
      ]
    },
    {
      "id": "field-value",
      "description": "state.rs Record::get: a field's value, null when unset.",
      "params": [
