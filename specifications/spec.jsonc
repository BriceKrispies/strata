    "properties": [
      {
        "entity": "component",
        "name": "ref",
        "type": "string",
        "label": "Specification id",
        "doc": "The identifier as written in the the project specification."
      },
      {
        "entity": "component",
        "name": "source",
        "type": "string",
        "label": "Source",
