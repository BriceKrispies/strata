                  "passed": false,
                  "detail": "a null is no value of a setting; remove the override instead"
                }
              ],
              "missing": null
            }
          }
        },
        {
          "args": {
            "def": {
              "id": "theme",
              "label": "theme",
              "type": "string",
              "default": {
                "str": "light"
              },
