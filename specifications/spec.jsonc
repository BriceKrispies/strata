    {
      "id": "tokint-flow-impl",
      "name": "Token introspection (implementation)",
      "subject": "identity-service",
      "level": "implementation",
      "initial": "tokint-open-i",
      "description": "A caller asks the introspection endpoint about a token. A permitted caller receives the scopes, the subject and the expiry of the token; another caller receives nothing. This is the decision as the code takes it: it keeps nothing between presentations.",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "states": [
        {
          "id": "tokint-open-i",
          "name": "Deciding"
        }
      ],
      "transitions": [
        {
          "id": "tokint-accept-i",
          "from": "tokint-open-i",
          "to": "tokint-open-i",
          "on": "tokint-presented",
          "guard": "(event.caller == 'permitted')",
          "effects": [
            {
              "emit": "tokint-accepted",
              "to": "web-application",
              "payload": {
                "scopes": "event.scopes",
                "subject": "event.subject",
                "expiry": "event.expiry"
              }
            }
          ]
        },
        {
          "id": "tokint-refuse-i",
          "from": "tokint-open-i",
          "to": "tokint-open-i",
          "on": "tokint-presented",
          "otherwise": true,
          "effects": [
            {
              "emit": "tokint-refused",
              "to": "web-application"
            }
          ]
        }
