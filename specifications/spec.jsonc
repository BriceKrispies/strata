                "created-at": 2002,
                "updated-at": 2002,
                "fields": {
                  "status": {
                    "str": "published"
                  },
                  "title": {
                    "str": "C"
                  }
                }
              }
            ],
            "revision": 5,
            "schema-version": 2
          }
        },
        {
          "args": {
