    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-identity-docs",
      "name": "Identity service documents (tenant file)",
      "scope": "platform",
      "key": [
        "kind",
        "key"
      ],
      "fields": [
        {
          "name": "kind",
          "type": "string",
          "description": "signing-key, client, grant, provisioning token, SCIM user, group role, group members or disabled."
        },
        {
          "name": "key",
          "type": "string"
        },
        {
          "name": "value",
          "type": "string",
          "personal": "other",
          "description": "The document as JSON text; a SCIM user document holds the person's attributes, a signing key its private key."
        }
      ],
      "retention": "Until the code that owns the kind removes it: SCIM user documents, group mappings, memberships and provisioning tokens are removed by the SCIM operations that retire them; signing keys, clients and grants stay until the tenant file is deleted. Not otherwise specified. Erasing a subject (the contract erase-subject) removes the SCIM user document, the deactivation flag and the place in each provisioned group of the person, and revokes the delegations to agents of the person and clears their purpose. The receipts of erasures are kept here under the kind erasure-receipt, as the receipt of each erasure (PRV-353), until the tenant file is deleted. The tenant key (kind tenant-key) and the subject keys (kinds subject-key and subject-key-of) are kept here wrapped (D-7722): a subject key is destroyed by the erasure of its subject, which removes its wrapped key and its principal and keeps its id and the time. It also holds the restrictions (kind restriction, removed when lifted or with the erasure of the principal), the legal holds (kind legal-hold, kept after release), and the export requests, their parts while the export is built and their results (kinds subject-export-request, subject-export-part and subject-export), removed when the export expires seven days after the request (PRV-2741).",
      "erasure": {
        "point": "the removal of the document by its owning operation, or the deletion of the tenant file"
      },
      "description": "Table identity_docs of a tenant file: the identity service's keyed documents (TOK-001 to TOK-009, FED-014)."
    },
    {
      "id": "rec-audit-anchor",
      "name": "Audit anchor",
      "owner": "platform-audit-store",
      "key": [
        "tenant-id",
        "head-seq"
      ],
      "fields": [
        {
          "name": "tenant-id",
          "type": "tenant-id",
          "constraints": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 64
          }
        },
        {
          "name": "head-seq",
          "type": "u64"
        },
        {
          "name": "head-hash",
          "type": "hash"
        },
        {
          "name": "anchored-at",
          "type": "timestamp"
        }
      ],
      "retention": "Seven years (D-707), and not removed with the tenant. It holds a sequence number and a hash and no tenant content (D-6208).",
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target"
    },
    {
      "id": "rec-deletion-request",
      "name": "Tenant deletion request",
      "owner": "control-plane",
      "key": [
        "tenant-id"
      ],
      "fields": [
        {
          "name": "tenant-id",
          "type": "tenant-id",
          "constraints": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 64
          }
        },
        {
          "name": "requested-by",
          "type": "principal-id",
          "refersTo": "principal",
          "role": "party",
          "constraints": {
            "pattern": "^[A-Za-z0-9_:.-]+$",
            "maxLength": 96
          },
          "onDelete": "restrict"
        },
        {
          "name": "requested-at",
          "type": "timestamp"
        },
        {
          "name": "executes-at",
          "type": "timestamp"
        },
        {
          "name": "cancelled-at",
          "type": "timestamp",
          "optional": true
        }
      ],
      "retention": "Until the tenant is deleted (TEN-011), with the certificate of PRV-354 (D-6207).",
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target"
    },
    {
      "id": "rec-message-send",
