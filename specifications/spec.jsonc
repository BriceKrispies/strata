      },
      {
        "entity": "claim",
        "name": "casesPath",
        "type": "string",
        "label": "Unresolved case paths",
        "doc": "Cases paths that match no file under specifications/, as written."
      },
      {
        "entity": "transition",
        "name": "per",
        "type": "list",
        "items": {
          "type": "ref",
          "ref": [
            "claim"
          ]
        },
        "label": "Stated by",
        "doc": "The requirements that state this step of the behavior model. The behavior model is descriptive: it restates requirements so Exegra can simulate them, and states nothing of its own."
      },
      {
        "entity": "transition",
        "name": "assumes",
        "type": "list",
        "items": {
          "type": "ref",
          "ref": [
            "assumption"
          ]
        },
        "label": "Assumes",
        "doc": "What this step relies on that no requirement states."
      },
      {
        "entity": "event",
        "name": "per",
        "type": "list",
        "items": {
          "type": "ref",
          "ref": [
            "claim"
          ]
        },
        "label": "Stated by",
        "doc": "The requirements that state this message."
      },
      {
        "entity": "event",
        "name": "boundary",
        "type": "ref",
        "ref": [
          "boundary"
        ],
        "label": "Crosses boundary",
        "doc": "The white-paper boundary this message crosses, when it crosses one."
      },
      {
        "entity": "scenario",
        "name": "per",
        "type": "list",
        "items": {
          "type": "ref",
          "ref": [
            "claim"
          ]
        },
        "label": "Stated by",
        "doc": "The requirements whose flow this scenario runs (typically those verified by a scenario)."
      },
      {
        "entity": "fault",
        "name": "per",
        "type": "list",
        "items": {
          "type": "ref",
          "ref": [
            "claim"
          ]
        },
        "label": "Stated by",
        "doc": "The requirements that say what must happen under this fault."
      },
      {
        "entity": "claim",
        "name": "models",
        "type": "ref",
        "ref": [
          "claim"
        ],
        "label": "Checks requirement",
        "doc": "For a check over the behavior model (not a requirement itself): the requirement it restates as a condition on simulated traces."
      },
      {
        "entity": "claim",
        "name": "faultBasis",
        "type": "enum",
        "values": [
          "fault",
          "restatement"
        ],
        "label": "Fault basis",
        "doc": "For a check over the behavior model: fault when a listed scenario injects a real fault (a lost, late or repeated message, a stop, a concurrent actor) and the check holds because of the modelled mechanism and fails when that mechanism is removed; restatement when it fails only under a defect built to negate the claim. See specifications/README.md."
      },
      {
        "entity": "failureMode",
        "name": "modelling",
        "type": "enum",
        "values": [
          "exercised",
          "not-modelled"
        ],
        "label": "Modelling",
        "doc": "exercised: a fault of a scenario realises this failure mode and a model claim lists that scenario. not-modelled: no behaviour model exercises it; the design answers it by other means (see modellingNote)."
      },
      {
        "entity": "failureMode",
        "name": "modellingNote",
        "type": "text",
        "label": "Modelling note",
        "doc": "Why the failure mode is not modelled, and what answers it instead."
      }
    ],
    "relationshipKinds": {
      "controls": {
        "label": "Controls",
        "line": "dashed",
        "color": "violet",
        "dependency": false,
        "description": "The source tells the target how to route or run, and exchanges no request, record or tenant data with it. A colour switch is an instruction to the traffic switch of this kind."
      }
    },
    "verificationMethods": {
      "conformance": {
        "label": "Conformance",
        "description": "When: An umbrella whose detail is a case table (see spec-format.md). Proof: One table-driven test through the boundary. It reads the `Cases:` files, runs every row, and fails with every failing row named, never only the first. Adding a row adds a case without touching the test. (docs/agents/verification.md)"
      },
      "property": {
        "label": "Property",
        "description": "When: \"For every\", \"never\", \"always\", and invariants. Proof: A property-based test through the boundary, with generated inputs and shrinking. A fixed seed and case count are recorded in the test. (docs/agents/verification.md)"
      },
      "scenario": {
        "label": "Scenario",
        "description": "When: A workflow of several steps, or a failure and recovery. Proof: An end-to-end test that drives the boundary as a user would: run the CLI, call the API, read the files. (docs/agents/verification.md)"
      },
      "example": {
        "label": "Example",
        "description": "When: One concrete input decides it. Proof: One case through the boundary: input in, observed output compared with the expected output. Golden files for formats. (docs/agents/verification.md)"
      },
      "proof": {
        "label": "Proof",
        "description": "When: A mathematical property of an algorithm or model (Lean 4). Proof: A Lean `theorem` whose doc comment declares `Verifies: ID`. It must build with no `sorry`. (docs/agents/verification.md)"
      },
      "budget": {
        "label": "Budget",
        "description": "When: A time, size, memory or count limit. Proof: A measurement that records the number and fails above the limit, at the measurement point, clock and machine class its row in `specifications/21-verification/cases/budget-measurement.md` names. A protocol timer, retention period or alert deadline is measured on the simulator's virtual clock and needs no machine; a latency or throughput limit is measured in the benchmark harness on the named machine class. (docs/agents/verification.md)"
      }
    }
  },

  // ---- Components (C-n) and the relationships between them ---------------------------------------
  "components": [
    {"id":"kernel","name":"Kernel","category":"logical","purpose":"Pure decision functions: decide an intent, answer a read, plan the state a decision needs.","responsibilities":["Decide transitions","Authorise by policy","Validate records and schema changes","Describe effects as data"],"trustZone":"core","ref":"C-1","implementation":{"status":"manual","notes":"crates/kernel"}},
    {"id":"substrate","name":"Substrate","category":"logical","purpose":"Pure interpreters around kernel data: bundles, expressions as text, view projection, constrained Markdown, themes.","responsibilities":["Install tenant bundles as intents","Project views","Parse rich text into blocks"],"trustZone":"core","ref":"C-2","implementation":{"status":"manual","notes":"crates/substrate"}},
    {"id":"store-contract","name":"Store contract","category":"logical","purpose":"The persistence contract and its conformance suite.","responsibilities":["State what a store guarantees","Run the conformance suite"],"trustZone":"core","ref":"C-3","implementation":{"status":"manual","notes":"crates/storage-api"}},
    {"id":"sqlite-adapter","name":"SQLite adapter","category":"storage","purpose":"The store contract on a SQLite file, for one process, tests and simulation.","responsibilities":["Atomic commits","Durable event log and outbox"],"trustZone":"data","ref":"C-4","implementation":{"status":"manual","notes":"crates/storage-sqlite"}},
    {"id":"postgres-adapter","name":"PostgreSQL adapter","category":"storage","purpose":"The store contract on one PostgreSQL database per tenant.","responsibilities":["Open a tenant database from its placement","Hold connections within the tenant quota"],"trustZone":"data","ref":"C-5","implementation":{"status":"not-implemented"}},
    {"id":"tenant-database","name":"Tenant database","category":"storage","purpose":"One PostgreSQL database per tenant holding everything the tenant owns.","responsibilities":["Hold schema, records, events, journal, jobs, realm and audit log of one tenant"],"trustZone":"data","ref":"C-6","implementation":{"status":"not-implemented"}},
    {"id":"control-plane","name":"Control plane","category":"computational","purpose":"Owns the tenant directory and carries out tenant lifecycle operations.","responsibilities":["Provision, suspend, export, move and delete tenants","Bind domains","Keep the wake index"],"trustZone":"control","ref":"C-7","implementation":{"status":"not-implemented"}},
    {"id":"control-database","name":"Control database","category":"storage","purpose":"Holds the tenant directory, placements, domain bindings and the wake index, and no tenant content.","responsibilities":["Hold identifiers, states and addresses"],"trustZone":"control","ref":"C-8","implementation":{"status":"not-implemented"}},
    {"id":"identity-service","name":"Identity service","category":"computational","purpose":"The only component that handles credentials: sign-in methods, sessions, factors, federation, tokens.","responsibilities":["Authenticate people","Issue and revoke sessions","Sign assertions and access tokens","Record every authentication decision"],"trustZone":"identity","ref":"C-9","implementation":{"status":"not-implemented","notes":"Sign-in and sessions exist today inside the runtime (crates/backend/src/auth.rs) and move here."}},
    {"id":"runtime","name":"Runtime","category":"computational","purpose":"Runs the kernel for a tenant: loads state through the store contract, decides, commits, publishes events.","responsibilities":["Execute intents and reads","Publish committed events from the outbox","Maintain stored view copies"],"trustZone":"tenant","ref":"C-10","implementation":{"status":"manual","notes":"crates/backend"}},
    {"id":"gateway","name":"Gateway","category":"computational","purpose":"The only component a browser reaches: resolves the tenant from the host, carries the session, projects views.","responsibilities":["Resolve tenant by host","Guard state-changing requests","Relay the event stream","Apply request limits"],"trustZone":"edge","ref":"C-11","implementation":{"status":"manual","notes":"crates/bff"}},
    {"id":"automation-worker","name":"Automation worker","category":"computational","purpose":"Finds due work through the wake index, runs jobs under leases, and advances workflow runs by asking the kernel to decide each step.","responsibilities":["Grant and expire leases","Retry failed attempts","Advance workflow runs and run compensations","Wait for approvals","Record outcomes"],"trustZone":"tenant","ref":"C-12","implementation":{"status":"not-implemented"}},
    {"id":"connector-runner","name":"Connector runner","category":"computational","purpose":"Carries out external effects after commit: HTTP calls, webhooks, mail.","responsibilities":["Call external addresses","Refuse private addresses","Record idempotency keys with outcomes"],"trustZone":"egress","ref":"C-14","implementation":{"status":"not-implemented"}},
    {"id":"copy-store","name":"Copy store","category":"storage","purpose":"Holds stored view copies keyed by the versions they were computed from.","responsibilities":["Store and serve copies by key","Remove copies by tag"],"trustZone":"data","ref":"C-15","implementation":{"status":"not-implemented"}},
    {"id":"file-store","name":"File store","category":"storage","purpose":"Holds tenant files addressed by content hash in a namespace per tenant.","responsibilities":["Store and serve objects","Sign addresses for private objects"],"trustZone":"data","ref":"C-16","implementation":{"status":"not-implemented"}},
    {"id":"delivery-network","name":"Content delivery network","category":"external","purpose":"Holds edge copies of public responses close to readers and serves them on the request path.","responsibilities":["Serve stored responses by host and path","Fetch a missing or expired response from the traffic switch as its origin","Drop the copies that a purge names","Terminate TLS for tenant domains"],"trustZone":"public","ref":"C-17","implementation":{"status":"not-implemented"}},
    {"id":"delivery-network-control","name":"Control interface of the content delivery network","category":"external","purpose":"Takes instructions for the content delivery network from the platform. It is apart from the request path: it calls nothing of the platform.","responsibilities":["Accept a purge by surrogate key","Register and remove tenant domains","Install and renew certificates for tenant domains"],"trustZone":"public","ref":"C-557","implementation":{"status":"not-implemented"}},
    {"id":"agent-gateway","name":"Agent gateway","category":"computational","purpose":"Serves the operation catalogue, dry runs and proposals to agents and operators.","responsibilities":["List operations per principal","Run dry runs and projections","Hold proposals and approvals","Apply operation budgets"],"trustZone":"edge","ref":"C-18","implementation":{"status":"not-implemented"}},
    {"id":"telemetry-pipeline","name":"Telemetry pipeline","category":"infrastructure","purpose":"Collects traces, metrics and logs from every component.","responsibilities":["Receive telemetry","Export to a backend"],"trustZone":"operations","ref":"C-19","implementation":{"status":"not-implemented"}},
    {"id":"audit-log","name":"Audit log","category":"storage","purpose":"The append-only, hash-chained record of security-relevant actions. Each tenant's entries are held in that tenant's database; the entries of platform operations are held in the platform audit store (D-707).","responsibilities":["Append entries","Verify the chain"],"trustZone":"data","ref":"C-20","implementation":{"status":"not-implemented"}},
    {"id":"key-service","name":"Key service","category":"external","purpose":"Holds the wrapping keys of tenant data keys.","responsibilities":["Wrap and unwrap data keys","Destroy a key"],"trustZone":"operations","ref":"C-21","implementation":{"status":"not-implemented"}},
    {"id":"mail-service","name":"Mail provider","category":"external","purpose":"Delivers mail. Reached only through the mail dispatcher.","responsibilities":["Deliver one rendered message to one address","Report bounces and complaints"],"trustZone":"egress","ref":"C-22","implementation":{"status":"not-implemented"}},
    {"id":"external-identity-provider","name":"External identity provider","category":"external","purpose":"An OpenID Connect or SAML provider that a tenant configured.","responsibilities":["Authenticate the tenant's people","Provision and deprovision through SCIM"],"trustZone":"public","ref":"C-23","implementation":{"status":"not-implemented"}},
    {"id":"web-application","name":"Web application","category":"client","purpose":"The reader site, the authoring application and the sign-in pages in the browser.","responsibilities":["Render view models","Send intents through the worker kernel"],"trustZone":"public","ref":"C-24","implementation":{"status":"manual","notes":"web"}},
    {"id":"simulator","name":"Simulator","category":"logical","purpose":"Runs the kernel under a schedule with logical time and injected faults, and compares executions.","responsibilities":["Run scenarios","Project proposed changes","Replay journals"],"trustZone":"core","ref":"C-25","implementation":{"status":"manual","notes":"crates/simulation"}},
    {"id":"verification","name":"Verification","category":"logical","purpose":"State invariants, the Lean model and its correspondence with the kernel.","responsibilities":["Evaluate invariants","Check the Lean proofs","Compare model and kernel"],"trustZone":"core","ref":"C-26","implementation":{"status":"manual","notes":"crates/verification, lean"}},
    {"id":"agent","name":"Agent","category":"client","purpose":"A program acting through the operation catalogue, for itself or for a person.","responsibilities":["Discover operations","Propose and apply changes"],"trustZone":"public","ref":"C-27","implementation":{"status":"not-implemented"}},
    {"id":"limit-store","name":"Limit store","category":"storage","purpose":"Holds shared counters for request rates and agent operation budgets, so that every instance of a component enforces one limit.","responsibilities":["Count requests by key within a window","Expire windows"],"trustZone":"data","ref":"C-100","implementation":{"status":"not-implemented"}},
    {"id":"backup-archive","name":"Backup archive","category":"storage","purpose":"Holds encrypted point-in-time copies of each tenant database and its files, and of the control database, each under the key of its owner and removed at the end of its retention.","responsibilities":["Store copies of one tenant database and its files","Restore one tenant to a point in time","Remove copies at the end of retention"],"trustZone":"data","ref":"C-101","implementation":{"status":"not-implemented"}},
    {"id":"fleet-reporting","name":"Fleet reporting","category":"storage","purpose":"Holds telemetry and the summaries tenants publish, for reports that span tenants.","responsibilities":["Hold summaries keyed by tenant identifier","Answer operator reports across tenants"],"trustZone":"operations","ref":"C-102","implementation":{"status":"not-implemented"}},
    {"id":"product-module","name":"Product module","category":"logical","purpose":"A product feature: tenant metadata and any platform code it registers.","responsibilities":["Declare record types, views, workflows and operations","Reach tenant data through the runtime"],"trustZone":"tenant","ref":"C-103","implementation":{"status":"not-implemented"}},
    {"id":"external-endpoint","name":"External endpoint","category":"external","purpose":"An external address that a connector calls, such as a customer's webhook receiver or an HTTP interface.","responsibilities":["Receive signed requests","Answer with an outcome"],"trustZone":"public","ref":"C-104","implementation":{"status":"not-implemented"}},
    {"id":"notice-queue","name":"Notice queue","category":"transport","purpose":"Carries tenant-scoped notices: due-work wake notices, session revocations and domain events. Each notice is delivered until its subscriber acknowledges it.","responsibilities":["Deliver each notice until its subscriber acknowledges it","Carry tenant identifiers and sequence numbers, not record content"],"trustZone":"control","ref":"C-28","implementation":{"status":"not-implemented"}},
    {"id":"search-index","name":"Search index","category":"storage","purpose":"Holds the search entries of each tenant, built from the tenant's own records and read through the search index contract.","responsibilities":["Store entries per tenant","Answer queries limited to an audience class"],"trustZone":"data","ref":"C-150","implementation":{"status":"not-implemented"}},
    {"id":"notification-service","name":"Notification service","category":"computational","purpose":"Turns subscriptions and workflow tasks into email and inbox notices, filtered by what each recipient may read.","responsibilities":["Match events to subscriptions","Write inbox items","Commit mail jobs for email notices"],"trustZone":"tenant","ref":"C-151","implementation":{"status":"not-implemented"}},
    {"id":"conversation-service","name":"Conversation service","category":"computational","purpose":"Runs the assistant for one person: keeps conversations and pending actions as tenant data, asks the model provider for replies, and runs each change through the operation catalogue with the person's delegated token.","responsibilities":["Stream replies to the gateway","Keep turns and pending actions as records","Run operations with the delegated token of the person","Explain refusals from the failed checks"],"trustZone":"tenant","ref":"C-200","implementation":{"status":"not-implemented"}},
    {"id":"model-provider","name":"Model provider","category":"external","purpose":"A hosted model that generates replies and tool requests for the conversation service, under the tenant's policy.","responsibilities":["Generate a reply from messages and operation descriptions","Stream the output","Report usage"],"trustZone":"egress","ref":"C-201","implementation":{"status":"not-implemented"}},
    {"id":"local-model-adapter","name":"Local model adapter","category":"infrastructure","purpose":"The model provider contract served from a container with no cloud account, for the local stack and for tests.","responsibilities":["Serve the model provider contract locally","Replay fixed replies for the conformance suite"],"trustZone":"operations","ref":"C-202","implementation":{"status":"not-implemented"}},
    {"id":"operator-console","name":"Operator console","category":"client","purpose":"The operator and support interface. Reachable only from the operations network, and asks for a tenant grant before it reads tenant content.","responsibilities":["Show platform state to operators","Request an access grant and show only the view it limits","Record every access"],"trustZone":"operations","ref":"C-250","implementation":{"status":"not-implemented"}},
    {"id":"outbound-gate","name":"Outbound gate","category":"computational","purpose":"The one path from the platform to addresses that a tenant names. It judges each address under the outbound rule and connects only to the address it judged.","responsibilities":["Resolve and judge addresses","Refuse redirects to addresses the rule forbids","Limit response size and time"],"trustZone":"egress","ref":"C-251","implementation":{"status":"not-implemented"}},
    {"id":"upload-scanner","name":"Upload scanner and rendition sandbox","category":"computational","purpose":"Scans uploaded files, confirms their media types from content and produces renditions in a process that holds no credential and no network access.","responsibilities":["Scan uploads before release","Confirm media types from content","Produce renditions"],"trustZone":"data","ref":"C-252","implementation":{"status":"not-implemented"}},
    {"id":"mail-dispatcher","name":"Mail dispatcher","category":"computational","purpose":"Takes mail jobs, renders each message for its recipient and hands it to the adapter of the configured mail provider.","responsibilities":["Render a message from its template and tokens","Check the suppression list and the mail quota of the tenant","Submit with an idempotency key and retry","Record delivery reports"],"trustZone":"egress","ref":"C-450","implementation":{"status":"not-implemented"}},
    {"id":"release-controller","name":"Release controller","category":"computational","purpose":"Runs each release through its promotion gates, holds release and environment records through the control plane, instructs the traffic switch to switch colours and switch back, starts migration runs as migration jobs, and refuses production releases during a freeze. It holds no access to tenant data of its own.","responsibilities":["Hold the promotion path and its gates","Switch colours and switch back","Refuse a production release during a freeze","Report differences between definitions and what runs"],"trustZone":"operations","ref":"C-550","implementation":{"status":"not-implemented"}},
    {"id":"release-pipeline","name":"Release pipeline","category":"infrastructure","purpose":"Builds the component images of a commit, signs them and publishes each one by digest to the image registry.","responsibilities":["Build from a commit","Publish each image by digest","Run the specification gate on the commit"],"trustZone":"operations","ref":"C-551","implementation":{"status":"not-implemented"}},
    {"id":"image-registry","name":"Image registry","category":"storage","purpose":"Holds signed component images addressed by digest, in the account of each environment that deploys them.","responsibilities":["Store images by digest","Serve images by digest to the environment that deploys them"],"trustZone":"operations","ref":"C-552","implementation":{"status":"not-implemented"}},
    {"id":"traffic-switch","name":"Traffic switch","category":"infrastructure","purpose":"The load balancer listener that sends public requests to the live colour of each component.","responsibilities":["Route public requests to one colour","Switch the colour on the release controller's instruction"],"trustZone":"edge","ref":"C-553","implementation":{"status":"not-implemented"}},
    {"id":"agent-traffic-switch","name":"Agent traffic switch","category":"infrastructure","purpose":"The listener of the same load balancer that sends the requests of agents to the live colour of the agent gateway.","responsibilities":["Route agent requests to one colour of the agent gateway","Switch the colour on the release controller's instruction"],"trustZone":"edge","ref":"C-554","implementation":{"status":"not-implemented"}},
    {"id":"migration-job","name":"Migration job","category":"computational","purpose":"Runs one migration run over the records of one tenant through the store contract, and commits each batch together with its cursor. The release controller starts it and holds no tenant data access itself (D-707).","responsibilities":["Convert the records of one tenant in batches","Commit the cursor with each batch","Resume a stopped run from its cursor"],"trustZone":"tenant","ref":"C-555","implementation":{"status":"not-implemented"}},
    {"id":"platform-audit-store","name":"Platform audit store","category":"storage","purpose":"The append-only, hash-chained record of the operations of the platform itself: releases, colour switches, freezes and acts of platform operators. It holds no tenant data and is apart from every tenant database (D-707).","responsibilities":["Append one chained entry for each platform operation","Serve entries to platform owners and to the operation catalogue"],"trustZone":"operations","ref":"C-556","implementation":{"status":"not-implemented"}},
    {"id":"subject-rights-service","name":"Subject rights service","category":"computational","purpose":"Carries out export, rectification, restriction and erasure requests for one data subject across one tenant.","responsibilities":["Find every record and copy of a principal","Destroy a subject key","Issue a receipt for each request"],"trustZone":"tenant","ref":"C-352","implementation":{"status":"not-implemented"}}
  ],
  "relationships": [
    {"id":"browser-calls-gateway","kind":"calls","from":"web-application","to":"traffic-switch","description":"Every request of the browser reaches the traffic switch, which sends it to the gateway of the live colour."},
    {"id":"network-calls-traffic-switch","kind":"calls","from":"delivery-network","to":"traffic-switch","description":"The content delivery network fetches from the traffic switch as its origin, which sends the fetch to the gateway of the live colour."},
    {"id":"browser-calls-network","kind":"calls","from":"web-application","to":"delivery-network","description":"Readers reach public pages through the content delivery network."},
    {"id":"agent-calls-agent-traffic-switch","kind":"calls","from":"agent","to":"agent-traffic-switch","description":"An agent calls operations through the agent listener of the traffic switch."},
    {"id":"gateway-calls-identity","kind":"calls","from":"gateway","to":"identity-service","description":"The gateway asks who a session belongs to and starts sign-in flows."},
    {"id":"gateway-calls-runtime","kind":"calls","from":"gateway","to":"runtime","description":"The gateway forwards reads and intents."},
    {"id":"gateway-calls-control-plane","kind":"calls","from":"gateway","to":"control-plane","description":"The gateway resolves hosts to tenants from the directory."},
    {"id":"gateway-reads-copy-store","kind":"reads","from":"gateway","to":"copy-store","description":"The gateway answers from stored view copies."},
    {"id":"agent-gateway-calls-identity","kind":"calls","from":"agent-gateway","to":"identity-service","description":"The agent gateway verifies tokens and reads grants."},
    {"id":"agent-gateway-calls-runtime","kind":"calls","from":"agent-gateway","to":"runtime","description":"Operations over tenant data are kernel decisions in the runtime."},
    {"id":"agent-gateway-calls-control-plane","kind":"calls","from":"agent-gateway","to":"control-plane","description":"Operations over tenants are carried out by the control plane."},
    {"id":"agent-gateway-calls-simulator","kind":"calls","from":"agent-gateway","to":"simulator","description":"Dry runs and projections are run by the simulator."},
    {"id":"agent-gateway-writes-audit","kind":"writes","from":"agent-gateway","to":"audit-log","description":"Every operation of an agent is recorded."},
    {"id":"identity-uses-store","kind":"depends-on","from":"identity-service","to":"store-contract","description":"The realm is tenant data, reached through the store contract."},
    {"id":"identity-uses-kernel","kind":"depends-on","from":"identity-service","to":"kernel","description":"Realm policies are decided by the kernel."},
    {"id":"identity-calls-provider","kind":"calls","from":"identity-service","to":"external-identity-provider","description":"Token exchange and metadata refresh."},
    {"id":"provider-calls-identity","kind":"calls","from":"external-identity-provider","to":"identity-service","description":"SAML responses and SCIM provisioning arrive from the provider."},
    {"id":"identity-calls-keys","kind":"calls","from":"identity-service","to":"key-service","description":"Signing keys and tenant data keys are wrapped by the key service."},
    {"id":"identity-writes-audit","kind":"writes","from":"identity-service","to":"audit-log","description":"Every authentication decision is recorded."},
    {"id":"runtime-uses-kernel","kind":"depends-on","from":"runtime","to":"kernel","description":"The runtime decides nothing itself."},
    {"id":"runtime-uses-substrate","kind":"depends-on","from":"runtime","to":"substrate","description":"View projection and bundle installation."},
    {"id":"runtime-uses-store","kind":"depends-on","from":"runtime","to":"store-contract","description":"Tenant state is reached only through the store contract."},
    {"id":"runtime-calls-control-plane","kind":"calls","from":"runtime","to":"control-plane","description":"The runtime reads placements from the directory."},
    {"id":"runtime-writes-copy-store","kind":"writes","from":"runtime","to":"copy-store","description":"The runtime stores view copies it computed."},
    {"id":"runtime-calls-network-control","kind":"calls","from":"runtime","to":"delivery-network-control","description":"The outbox consumer purges surrogate keys."},
    {"id":"runtime-publishes-wake","kind":"publishes","from":"runtime","to":"notice-queue","description":"A commit that creates due work, or a domain event, announces it."},
    {"id":"runtime-writes-audit","kind":"writes","from":"runtime","to":"audit-log","description":"Security-relevant changes are recorded."},
    {"id":"runtime-calls-keys","kind":"calls","from":"runtime","to":"key-service","description":"Tenant data keys are unwrapped by the key service."},
    {"id":"runtime-writes-files","kind":"writes","from":"runtime","to":"file-store","description":"Uploaded files are stored per tenant."},
    {"id":"postgres-implements-store","kind":"depends-on","from":"postgres-adapter","to":"store-contract","description":"An adapter of the store contract."},
    {"id":"sqlite-implements-store","kind":"depends-on","from":"sqlite-adapter","to":"store-contract","description":"An adapter of the store contract."},
    {"id":"store-uses-kernel","kind":"depends-on","from":"store-contract","to":"kernel","description":"The contract is written in kernel types."},
    {"id":"substrate-uses-kernel","kind":"depends-on","from":"substrate","to":"kernel","description":"Interpreters over kernel data."},
    {"id":"postgres-writes-tenant-database","kind":"writes","from":"postgres-adapter","to":"tenant-database","description":"The adapter is the only writer of a tenant database."},
    {"id":"store-reaches-postgres","kind":"data-flow","from":"store-contract","to":"postgres-adapter","description":"Calls through the contract are carried out by the adapter chosen for the deployment."},
    {"id":"control-plane-writes-control-database","kind":"writes","from":"control-plane","to":"control-database","description":"The directory and the wake index."},
    {"id":"control-plane-uses-store","kind":"depends-on","from":"control-plane","to":"store-contract","description":"Provisioning creates a tenant through the store contract."},
    {"id":"control-plane-calls-keys","kind":"calls","from":"control-plane","to":"key-service","description":"A tenant's key is created and destroyed with the tenant."},
    {"id":"control-plane-calls-network-control","kind":"calls","from":"control-plane","to":"delivery-network-control","description":"Domains and certificates are registered at the edge."},
    {"id":"network-control-controls-network","kind":"controls","from":"delivery-network-control","to":"delivery-network","description":"A purge, a domain binding and a certificate are instructions to the content delivery network. They carry no request and return nothing to the platform."},
    {"id":"control-plane-writes-audit","kind":"writes","from":"control-plane","to":"audit-log","description":"Lifecycle operations are recorded."},
    {"id":"automation-worker-calls-control-plane","kind":"calls","from":"automation-worker","to":"control-plane","description":"The automation worker reads the wake index."},
    {"id":"automation-worker-subscribes-notices","kind":"subscribes","from":"automation-worker","to":"notice-queue","description":"A wake notice prompts the automation worker before its next poll."},
    {"id":"automation-worker-uses-store","kind":"depends-on","from":"automation-worker","to":"store-contract","description":"Jobs are tenant data."},
    {"id":"automation-worker-uses-kernel","kind":"depends-on","from":"automation-worker","to":"kernel","description":"Lease and retry decisions are kernel decisions."},
    {"id":"automation-worker-calls-connectors","kind":"calls","from":"automation-worker","to":"connector-runner","description":"Effects of a committed step are handed to the connector runner."},
    {"id":"connectors-call-keys","kind":"calls","from":"connector-runner","to":"key-service","description":"Connector secrets are unwrapped at the time of the call."},
    {"id":"simulator-uses-kernel","kind":"depends-on","from":"simulator","to":"kernel","description":"The simulator runs the production kernel."},
    {"id":"simulator-uses-verification","kind":"depends-on","from":"simulator","to":"verification","description":"Invariants are evaluated on simulated states."},
    {"id":"verification-uses-kernel","kind":"depends-on","from":"verification","to":"kernel","description":"Invariants are evaluated with the kernel's own validation."},
    {"id":"telemetry-observes-gateway","kind":"observes","from":"telemetry-pipeline","to":"gateway","description":"Telemetry of the gateway."},
    {"id":"telemetry-observes-runtime","kind":"observes","from":"telemetry-pipeline","to":"runtime","description":"Telemetry of the runtime."},
    {"id":"telemetry-observes-identity","kind":"observes","from":"telemetry-pipeline","to":"identity-service","description":"Telemetry of the identity service."},
    {"id":"telemetry-observes-control-plane","kind":"observes","from":"telemetry-pipeline","to":"control-plane","description":"Telemetry of the control plane."},
    {"id":"telemetry-observes-automation-worker","kind":"observes","from":"telemetry-pipeline","to":"automation-worker","description":"Telemetry of the automation worker."},
    {"id":"arc-gateway-writes-limits","kind":"writes","from":"gateway","to":"limit-store","description":"Request rates are counted in the shared limit store."},
    {"id":"arc-agent-gateway-writes-limits","kind":"writes","from":"agent-gateway","to":"limit-store","description":"Operation budgets are counted in the shared limit store."},
    {"id":"arc-tenant-database-backed-up","kind":"data-flow","from":"tenant-database","to":"backup-archive","description":"Point-in-time copies of each tenant database."},
    {"id":"arc-control-plane-schedules-backup","kind":"calls","from":"control-plane","to":"backup-archive","description":"The control plane schedules backups and asks for restores."},
    {"id":"arc-identity-publishes-revocation","kind":"publishes","from":"identity-service","to":"notice-queue","description":"A session revocation is announced to gateways."},
    {"id":"arc-gateway-subscribes-notices","kind":"subscribes","from":"gateway","to":"notice-queue","description":"Each gateway instance receives revocations until it acknowledges them."},
    {"id":"arc-agent-gateway-subscribes-notices","kind":"subscribes","from":"agent-gateway","to":"notice-queue","description":"Domain events that the policies of the subscribing principal permit it to read."},
    {"id":"arc-telemetry-feeds-fleet","kind":"data-flow","from":"telemetry-pipeline","to":"fleet-reporting","description":"Telemetry exported for reports that span tenants."},
    {"id":"arc-runtime-publishes-summaries","kind":"publishes","from":"runtime","to":"fleet-reporting","description":"Summaries that a tenant publishes about itself, with no record content."},
    {"id":"arc-product-module-calls-runtime","kind":"calls","from":"product-module","to":"runtime","description":"A module that needs platform code calls the runtime, and reaches no store of its own."},
    {"id":"arc-connector-calls-endpoint","kind":"calls","from":"outbound-gate","to":"external-endpoint","description":"The outbound gate connects to the external address it judged, for the connector runner."},
    {"id":"gateway-reads-search-index","kind":"reads","from":"gateway","to":"search-index","description":"Search requests are answered from the tenant's search entries."},
    {"id":"runtime-writes-search-index","kind":"writes","from":"runtime","to":"search-index","description":"A commit that changes a record updates its search entries."},
    {"id":"runtime-calls-notification-service","kind":"calls","from":"runtime","to":"notification-service","description":"A committed event that has subscribers is handed to the notification service."},
    {"id":"notification-service-uses-store","kind":"depends-on","from":"notification-service","to":"store-contract","description":"Subscriptions and inbox items are tenant data."},
    {"id":"notification-service-uses-kernel","kind":"depends-on","from":"notification-service","to":"kernel","description":"Which recipients may read a record is a kernel decision."},
    {"id":"cnv-gateway-calls-conversation","kind":"calls","from":"gateway","to":"conversation-service","description":"Conversation requests and the reply stream go through the gateway, which carries the person's session."},
    {"id":"cnv-conversation-calls-agent-gateway","kind":"calls","from":"conversation-service","to":"agent-gateway","description":"Every operation of the assistant is run through the agent gateway with the delegated token of the person."},
    {"id":"cnv-conversation-calls-identity","kind":"calls","from":"conversation-service","to":"identity-service","description":"Obtains the delegated token of a person's session."},
    {"id":"cnv-conversation-uses-store","kind":"depends-on","from":"conversation-service","to":"store-contract","description":"Conversations, turns and pending actions are tenant data."},
    {"id":"cnv-conversation-writes-audit","kind":"writes","from":"conversation-service","to":"audit-log","description":"Changes the assistant makes are recorded with the person it acted for."},
    {"id":"cnv-conversation-sends-model","kind":"data-flow","from":"conversation-service","to":"model-provider","description":"Model requests carry tenant content as far as the tenant policy permits."},
    {"id":"cnv-local-adapter-serves-model","kind":"depends-on","from":"local-model-adapter","to":"model-provider","description":"The local adapter is one implementation of the model provider contract."},
    {"id":"cnv-telemetry-observes-conversation","kind":"observes","from":"telemetry-pipeline","to":"conversation-service","description":"Telemetry of the conversation service."},
    {"id":"operator-console-calls-control-plane","kind":"calls","from":"operator-console","to":"control-plane","description":"Operators carry out tenant lifecycle operations."},
    {"id":"operator-console-calls-identity","kind":"calls","from":"operator-console","to":"identity-service","description":"Operators sign in, and each access grant is requested from and checked by the identity service."},
    {"id":"operator-console-calls-runtime","kind":"calls","from":"operator-console","to":"runtime","description":"Support reads of tenant content, made under a grant."},
    {"id":"connector-runner-calls-outbound-gate","kind":"calls","from":"connector-runner","to":"outbound-gate","description":"Every external call leaves through the outbound gate."},
    {"id":"runtime-calls-upload-scanner","kind":"calls","from":"runtime","to":"upload-scanner","description":"Uploaded files are scanned before they are released."},
    {"id":"upload-scanner-reads-file-store","kind":"reads","from":"upload-scanner","to":"file-store","description":"The scanner reads an uploaded object and records its verdict."},
    {"id":"postgres-writes-backups","kind":"writes","from":"postgres-adapter","to":"backup-archive","description":"Encrypted images of each tenant database and of the control database."},
    {"id":"file-store-writes-backups","kind":"writes","from":"file-store","to":"backup-archive","description":"Encrypted images of tenant files."},
    {"id":"postgres-writes-exports","kind":"writes","from":"postgres-adapter","to":"file-store","description":"A tenant export is written from the tenant database to the file namespace of the tenant."},
    {"id":"audit-log-uses-store","kind":"depends-on","from":"audit-log","to":"store-contract","description":"The audit log is held in the tenant database through the store contract."},
    {"id":"operator-console-writes-audit","kind":"writes","from":"operator-console","to":"audit-log","description":"Every access is recorded."},
    {"id":"subject-rights-uses-store","kind":"depends-on","from":"subject-rights-service","to":"store-contract","description":"Export, rectification, restriction and erasure of the records of one principal."},
    {"id":"subject-rights-calls-keys","kind":"calls","from":"subject-rights-service","to":"key-service","description":"Erasure destroys the subject key."},
    {"id":"subject-rights-writes-audit","kind":"writes","from":"subject-rights-service","to":"audit-log","description":"Every request and its receipt are recorded."},
    {"id":"identity-requests-mail","kind":"data-flow","from":"identity-service","to":"mail-dispatcher","description":"Sign-in links and account notices, as mail jobs in the tenant database."},
    {"id":"notification-service-requests-mail","kind":"data-flow","from":"notification-service","to":"mail-dispatcher","description":"Email notices, as mail jobs."},
    {"id":"automation-worker-requests-mail","kind":"data-flow","from":"automation-worker","to":"mail-dispatcher","description":"Mail steps of workflows, as mail jobs."},
    {"id":"automation-worker-calls-mail-dispatcher","kind":"calls","from":"automation-worker","to":"mail-dispatcher","description":"A due mail job is handed to the dispatcher under a lease."},
    {"id":"mail-dispatcher-uses-store","kind":"depends-on","from":"mail-dispatcher","to":"store-contract","description":"Templates, tokens, the suppression list and the mail log are tenant data."},
    {"id":"mail-dispatcher-uses-kernel","kind":"depends-on","from":"mail-dispatcher","to":"kernel","description":"Tokens are evaluated by the kernel for each recipient."},
    {"id":"mail-dispatcher-uses-substrate","kind":"depends-on","from":"mail-dispatcher","to":"substrate","description":"Structured blocks are rendered into the parts of a message."},
    {"id":"mail-dispatcher-calls-keys","kind":"calls","from":"mail-dispatcher","to":"key-service","description":"Provider credentials and signing keys of sender domains."},
    {"id":"mail-dispatcher-calls-mail","kind":"calls","from":"mail-dispatcher","to":"mail-service","description":"Submission through the adapter of the configured provider."},
    {"id":"telemetry-observes-mail-dispatcher","kind":"observes","from":"telemetry-pipeline","to":"mail-dispatcher","description":"Telemetry of the mail dispatcher."},
    {"id":"release-pipeline-publishes-registry","kind":"publishes","from":"release-pipeline","to":"image-registry","description":"Each signed image is published by digest."},
    {"id":"release-controller-reads-registry","kind":"reads","from":"release-controller","to":"image-registry","description":"The release controller deploys the images that a release record names by digest."},
    {"id":"release-controller-controls-traffic-switch","kind":"controls","from":"release-controller","to":"traffic-switch","description":"A colour switch and a switch back are instructions to the traffic switch. They carry no request or tenant data."},
    {"id":"release-controller-controls-agent-traffic-switch","kind":"controls","from":"release-controller","to":"agent-traffic-switch","description":"A colour switch and a switch back are instructions to the agent listener too."},
    {"id":"release-controller-calls-control-plane","kind":"calls","from":"release-controller","to":"control-plane","description":"Release records and environment records are written through the control plane."},
    {"id":"release-controller-starts-migration-job","kind":"calls","from":"release-controller","to":"migration-job","description":"A tenant migration run is started as a migration job. The job holds the tenant data access; the controller does not."},
    {"id":"release-controller-writes-platform-audit","kind":"writes","from":"release-controller","to":"platform-audit-store","description":"Each promotion, colour switch, switch back and freeze is recorded in the platform audit store, not in a tenant database."},
    {"id":"migration-job-uses-store","kind":"depends-on","from":"migration-job","to":"store-contract","description":"A migration run converts the records of a tenant through the store contract."},
    {"id":"migration-job-uses-kernel","kind":"depends-on","from":"migration-job","to":"kernel","description":"The conversion of each record is a kernel decision."},
    {"id":"traffic-switch-calls-gateway","kind":"calls","from":"traffic-switch","to":"gateway","description":"Public requests of the live colour reach its gateway instances."},
    {"id":"agent-traffic-switch-calls-agent-gateway","kind":"calls","from":"agent-traffic-switch","to":"agent-gateway","description":"Agent requests of the live colour reach its agent gateway instances."},
    {"id":"str-runtime-reads-copy-store","kind":"reads","from":"runtime","to":"copy-store","description":"The runtime answers from its stored view copies, and from the tenant database while the copy store is out."},
    {"id":"str-agent-gateway-reads-audit","kind":"reads","from":"agent-gateway","to":"audit-log","description":"An audit query by an agent reads the entries that the policies of its principal permit it to read."},
    {"id":"str-mail-service-reports-to-dispatcher","kind":"data-flow","from":"mail-service","to":"mail-dispatcher","description":"Delivery reports, bounces and complaints, signed by the provider, return to the dispatcher."},
    {"id":"str-gateway-reads-file-store","kind":"reads","from":"gateway","to":"file-store","description":"The gateway serves tenant files from the file domain of the platform."},
    {"id":"str-gateway-calls-notification-service","kind":"calls","from":"gateway","to":"notification-service","description":"A principal reads its inbox through the gateway, which the notification service answers."},
    {"id":"str-agent-gateway-reads-search-index","kind":"reads","from":"agent-gateway","to":"search-index","description":"Search requests of agents are answered from the search entries, filtered by the policies of the requester."},
    {"id":"str-gateway-calls-subject-rights-service","kind":"calls","from":"gateway","to":"subject-rights-service","description":"An export, rectification, restriction or erasure request for one data subject is carried out through the subject rights service."},
    {"id":"str-release-pipeline-calls-release-controller","kind":"calls","from":"release-pipeline","to":"release-controller","description":"A built and signed release, named by its commit, is handed to the release controller, which runs its promotion gates."},
    {"id":"str-identity-writes-limit-store","kind":"writes","from":"identity-service","to":"limit-store","description":"Emailed sign-in links and sign-up requests are counted in the shared limit store."},
    {"id":"str-automation-worker-calls-notification-service","kind":"calls","from":"automation-worker","to":"notification-service","description":"Workflow tasks are handed to the notification service, which turns them into notices."},
    {"id":"str-identity-calls-outbound-gate","kind":"calls","from":"identity-service","to":"outbound-gate","description":"Federation metadata and keys are fetched through the outbound gate."},
    {"id":"str-upload-scanner-writes-file-store","kind":"writes","from":"upload-scanner","to":"file-store","description":"Renditions produced from a stored file are written to the file namespace of its tenant."},
    {"id":"str-subject-rights-writes-copy-store","kind":"writes","from":"subject-rights-service","to":"copy-store","description":"Erasure reaches each stored copy that holds a field of the principal, and removes it within its bound."},
    {"id":"str-subject-rights-writes-search-index","kind":"writes","from":"subject-rights-service","to":"search-index","description":"Erasure reaches each search entry built from a record of the principal."},
    {"id":"str-subject-rights-reads-file-store","kind":"reads","from":"subject-rights-service","to":"file-store","description":"An export for one principal includes the files that name the principal."},
    {"id":"str-operator-console-reads-fleet-reporting","kind":"reads","from":"operator-console","to":"fleet-reporting","description":"An operator report that spans tenants is answered from telemetry and published summaries."},
    {"id":"str-postgres-adapter-reads-backups","kind":"reads","from":"postgres-adapter","to":"backup-archive","description":"A restore reads an encrypted backup image of a tenant database or of the control database."},
    {"id":"str-store-contract-reaches-sqlite","kind":"data-flow","from":"store-contract","to":"sqlite-adapter","description":"Calls through the contract are carried out by the SQLite adapter in tests and simulation."},
    {"id":"str-telemetry-observes-connector-runner","kind":"observes","from":"telemetry-pipeline","to":"connector-runner","description":"Telemetry of the connector runner."},
    {"id":"str-telemetry-observes-outbound-gate","kind":"observes","from":"telemetry-pipeline","to":"outbound-gate","description":"Telemetry of the outbound gate."},
    {"id":"str-telemetry-observes-upload-scanner","kind":"observes","from":"telemetry-pipeline","to":"upload-scanner","description":"Telemetry of the upload scanner."},
    {"id":"str-telemetry-observes-notification-service","kind":"observes","from":"telemetry-pipeline","to":"notification-service","description":"Telemetry of the notification service."},
    {"id":"str-telemetry-observes-subject-rights-service","kind":"observes","from":"telemetry-pipeline","to":"subject-rights-service","description":"Telemetry of the subject rights service."},
    {"id":"str-telemetry-observes-operator-console","kind":"observes","from":"telemetry-pipeline","to":"operator-console","description":"Telemetry of the operator console."},
    {"id":"str-telemetry-observes-limit-store","kind":"observes","from":"telemetry-pipeline","to":"limit-store","description":"Telemetry of the limit store."},
    {"id":"str-telemetry-observes-wake-queue","kind":"observes","from":"telemetry-pipeline","to":"notice-queue","description":"Telemetry of the notice queue."},
    {"id":"str-telemetry-observes-key-service","kind":"observes","from":"telemetry-pipeline","to":"key-service","description":"Telemetry of the key service."},
    {"id":"str-telemetry-observes-release-controller","kind":"observes","from":"telemetry-pipeline","to":"release-controller","description":"Telemetry of the release controller."},
    {"id":"str-telemetry-observes-traffic-switch","kind":"observes","from":"telemetry-pipeline","to":"traffic-switch","description":"Telemetry of the traffic switch."},
    {"id":"str-telemetry-observes-release-pipeline","kind":"observes","from":"telemetry-pipeline","to":"release-pipeline","description":"Telemetry of the release pipeline."},
    {"id":"str-telemetry-observes-image-registry","kind":"observes","from":"telemetry-pipeline","to":"image-registry","description":"Telemetry of the image registry."},
    {"id":"str-telemetry-observes-agent-traffic-switch","kind":"observes","from":"telemetry-pipeline","to":"agent-traffic-switch","description":"Telemetry of the agent listener of the traffic switch."},
    {"id":"str-telemetry-observes-migration-job","kind":"observes","from":"telemetry-pipeline","to":"migration-job","description":"Telemetry of the migration job."},
    {"id":"str-telemetry-observes-platform-audit-store","kind":"observes","from":"telemetry-pipeline","to":"platform-audit-store","description":"Telemetry of the platform audit store."},
    {"id":"str-telemetry-observes-backup-archive","kind":"observes","from":"telemetry-pipeline","to":"backup-archive","description":"Metrics, traces and logs of the backup archive."},
    {"id":"str-telemetry-observes-search-index","kind":"observes","from":"telemetry-pipeline","to":"search-index","description":"Metrics, traces and logs of the search index."},
    {"id":"str-telemetry-observes-file-store","kind":"observes","from":"telemetry-pipeline","to":"file-store","description":"Metrics, traces and logs of the file store."},
    {"id":"str-telemetry-observes-copy-store","kind":"observes","from":"telemetry-pipeline","to":"copy-store","description":"Metrics, traces and logs of the copy store."},
    {"id":"str-telemetry-observes-tenant-database","kind":"observes","from":"telemetry-pipeline","to":"tenant-database","description":"Metrics, traces and logs of the tenant databases."},
    {"id":"str-telemetry-observes-local-model-adapter","kind":"observes","from":"telemetry-pipeline","to":"local-model-adapter","description":"Telemetry of the local model adapter."},
    {"id":"telemetry-observes-agent-gateway","kind":"observes","from":"telemetry-pipeline","to":"agent-gateway","description":"Telemetry of the agent gateway."}
  ],

  // ---- White paper: goals, non-goals, boundaries, decisions, constraints, open questions ---------
  "goals": [
    {"id":"g-1","statement":"Each tenant has a database of its own, so a tenant can be backed up, restored, moved, exported and deleted as one unit.","stage":"R0","group":"Tenancy","ref":"G-1"},
    {"id":"g-2","statement":"A tenant is provisioned from a template with no manual step and is usable as soon as provisioning reports success.","stage":"R0","group":"Tenancy","ref":"G-2"},
    {"id":"g-3","statement":"A tenant can be placed in a chosen region and moved between database clusters without a change of address.","stage":"R0","group":"Tenancy","ref":"G-3"},
    {"id":"g-4","statement":"The load of one tenant cannot exhaust capacity that another tenant depends on.","stage":"R0","group":"Tenancy","ref":"G-4"},
    {"id":"g-5","statement":"Tenant structure stays versioned data interpreted by one deterministic kernel, as in the prototype.","stage":"R0","group":"Tenancy","ref":"G-5"},
    {"id":"g-6","statement":"A person can sign in with a password, a passkey, an emailed link, an OpenID Connect provider or a SAML provider, as the tenant configures.","stage":"R1","group":"Identity","ref":"G-6"},
    {"id":"g-7","statement":"An organisation can require its own identity provider for its people and have them provisioned and deprovisioned from it.","stage":"R1","group":"Identity","ref":"G-7"},
    {"id":"g-8","statement":"A tenant can require a second factor, and sensitive operations can require a recent authentication.","stage":"R1","group":"Identity","ref":"G-8"},
    {"id":"g-9","statement":"Sessions can be listed and revoked, and a revocation takes effect everywhere within a stated bound.","stage":"R1","group":"Identity","ref":"G-9"},
    {"id":"g-10","statement":"Services and agents have identities of their own, with scoped credentials that expire.","stage":"R1","group":"Identity","ref":"G-10"},
    {"id":"g-11","statement":"Every authentication decision is recorded with enough evidence to explain it afterwards.","stage":"R1","group":"Identity","ref":"G-11"},
    {"id":"g-12","statement":"One identity service is the only component that handles credentials, and every other component learns who is calling from what it signs.","stage":"R1","group":"Identity","ref":"G-12"},
    {"id":"g-13","statement":"A tenant can schedule work at a time, on a recurring rule or in response to an event.","stage":"R2","group":"Automation","ref":"G-13"},
    {"id":"g-14","statement":"Scheduled work survives the failure of a process or a host and ends in a recorded outcome.","stage":"R2","group":"Automation","ref":"G-14"},
    {"id":"g-15","statement":"An external effect is applied once even when the job that causes it is attempted more than once.","stage":"R2","group":"Automation","ref":"G-15"},
    {"id":"g-16","statement":"Workflows are tenant metadata and are projected against history before activation, like any schema change.","stage":"R2","group":"Automation","ref":"G-16"},
    {"id":"g-17","statement":"Content can be published and withdrawn at a scheduled time.","stage":"R2","group":"Automation","ref":"G-17"},
    {"id":"g-18","statement":"Published content is served from stored copies near readers without a query to the tenant database on each request.","stage":"R2","group":"Delivery","ref":"G-18"},
    {"id":"g-19","statement":"A committed change is visible to readers within a stated bound.","stage":"R2","group":"Delivery","ref":"G-19"},
    {"id":"g-20","statement":"No reader receives another tenant's content, or content their role may not read, from any stored copy or any interface.","stage":"R2","group":"Delivery","ref":"G-20"},
    {"id":"g-21","statement":"A tenant can serve its site from its own domain names, with certificates the platform manages.","stage":"R2","group":"Delivery","ref":"G-21"},
    {"id":"g-22","statement":"Deleting data removes it from every stored copy within a stated bound.","stage":"R2","group":"Delivery","ref":"G-22"},
    {"id":"g-23","statement":"Everything an operator can observe or change, an agent can observe or change through a documented, typed interface.","stage":"R3","group":"Agents","ref":"G-23"},
    {"id":"g-24","statement":"An agent can find out what it may do, what an operation needs and what it would change, before doing it.","stage":"R3","group":"Agents","ref":"G-24"},
    {"id":"g-25","statement":"Every change made by an agent is attributable to the agent and to the person it acted for, and is reversible where the operation allows.","stage":"R3","group":"Agents","ref":"G-25"},
    {"id":"g-26","statement":"A risky change passes through a proposal that is projected and then approved under the tenant's policy.","stage":"R3","group":"Agents","ref":"G-26"},
    {"id":"g-27","statement":"The platform describes its own state (health, configuration, topology, recent failures) in machine-readable form.","stage":"R3","group":"Agents","ref":"G-27"},
    {"id":"g-28","statement":"The reach of an agent can be limited in scope and in volume, and cut off at once.","stage":"R3","group":"Agents","ref":"G-28"},
    {"id":"g-29","statement":"One request can be followed through every component by one identifier.","stage":"R3","group":"Observability","ref":"G-29"},
    {"id":"g-30","statement":"Security-relevant actions are kept in an append-only record that reveals tampering.","stage":"R3","group":"Observability","ref":"G-30"},
    {"id":"g-31","statement":"Content types, relationships, workflows, queries and views are defined by tenants as data.","stage":"R4","group":"Content","ref":"G-31"},
    {"id":"g-32","statement":"Every published version of a record can be retrieved, compared and restored.","stage":"R4","group":"Content","ref":"G-32"},
    {"id":"g-33","statement":"Media files are stored, turned into renditions and delivered with the same isolation as records.","stage":"R4","group":"Content","ref":"G-33"},
    {"id":"g-34","statement":"Content can exist in several languages, with a fallback.","stage":"R4","group":"Content","ref":"G-34"},
    {"id":"g-35","statement":"An author can preview unpublished content exactly as it would be delivered.","stage":"R4","group":"Content","ref":"G-35"},
    {"id":"g-36","statement":"The whole platform runs on one machine in containers, with no cloud account.","stage":"R0","group":"Platform","ref":"G-36"},
    {"id":"g-37","statement":"The same component images deploy to a cloud provider through adapters, Amazon Web Services first.","stage":"R4","group":"Platform","ref":"G-37"},
    {"id":"g-38","statement":"Every dependency on infrastructure sits behind a contract with a conformance suite and at least two adapters.","stage":"R0","group":"Platform","ref":"G-38"},
    {"id":"g-39","statement":"The platform recovers from the loss of a zone within stated objectives, and any tenant can be restored to a point in time.","stage":"R4","group":"Platform","ref":"G-39"},
    {"id":"g-40","statement":"Tenant data and secrets are encrypted under a key held for that tenant, and destroying the key makes them unreadable.","stage":"R1","group":"Platform","ref":"G-40"},
    {"id":"g-41","statement":"Every requirement is tied to a proof whose recorded result Concordance checks.","stage":"R0","group":"Assurance","ref":"G-41"},
    {"id":"g-42","statement":"Behaviour that matters under failure is modelled and checked in Exegra before it is built.","stage":"R0","group":"Assurance","ref":"G-42"},
    {"id":"g-43","statement":"The core properties of the kernel stay machine-checked as it grows.","stage":"R0","group":"Assurance","ref":"G-43"},
    {"id":"g-44","statement":"A proposed change to tenant metadata can be projected against recorded history before it is made.","stage":"R0","group":"Assurance","ref":"G-44"},
    {"id":"g-45","statement":"The sign-in pages and the authoring application meet WCAG 2.2 level AA.","stage":"R4","group":"Assurance","ref":"G-45"},
    {"id":"g-46","statement":"Sign-in resists enumeration of accounts, guessing of credentials, replay of one-time material and takeover through federation.","stage":"R1","group":"Identity","ref":"G-46"},
    {"id":"g-100","statement":"Operators can answer questions that span tenants without reading the data of any tenant.","stage":"R3","group":"Observability","ref":"G-100"},
    {"id":"g-101","statement":"Reads of a tenant's directory entry and published content keep working through the loss of the control plane.","stage":"R2","group":"Delivery","ref":"G-101"},
    {"id":"g-102","statement":"Adding a tenant adds no load to a shared component that grows with the number of tenants.","stage":"R2","group":"Tenancy","ref":"G-102"},
    {"id":"g-103","statement":"A product feature is added as tenant metadata and modules, with no change to the kernel.","stage":"R0","group":"Platform","ref":"G-103"},
    {"id":"g-104","statement":"Stored formats and layouts change while the versions that read them run together.","stage":"R4","group":"Platform","ref":"G-104"},
    {"id":"g-150","statement":"An author can create and edit records of tenant-defined content types in the authoring application, and an edit reaches readers only when it is published.","stage":"R2","group":"Content","ref":"G-150"},
    {"id":"g-151","statement":"A tenant can require that the people it names review a record before it is published.","stage":"R2","group":"Content","ref":"G-151"},
    {"id":"g-152","statement":"A tenant's application can read published content through a documented delivery interface with field selection, paging and filtering.","stage":"R2","group":"Delivery","ref":"G-152"},
    {"id":"g-153","statement":"A tenant can define roles and teams, and each person can do only what the roles that reach them allow.","stage":"R1","group":"Identity","ref":"G-153"},
    {"id":"g-154","statement":"A new organisation can start a sandbox tenant from a template without contacting the platform operator, and keep it or let it expire.","stage":"R1","group":"Tenancy","ref":"G-154"},
    {"id":"g-155","statement":"People receive the tasks and notices that concern them in an inbox or by email, and no notice shows a record its recipient cannot read.","stage":"R2","group":"Automation","ref":"G-155"},
    {"id":"g-156","statement":"Other systems can start a tenant's workflows through signed webhooks, and a tenant can see the outcome of each webhook it sends.","stage":"R2","group":"Automation","ref":"G-156"},
    {"id":"g-157","statement":"Each tenant has a plan whose quotas are enforced, its metered use is counted, and the counts can be sent to its billing system.","stage":"R2","group":"Business","ref":"G-157"},
    {"id":"g-158","statement":"A reviewer without an account can see a draft exactly as it would be delivered, through a link that expires.","stage":"R2","group":"Content","ref":"G-158"},
    {"id":"g-159","statement":"The addresses of published pages keep working when a page moves, and search engines can find every published page of a site.","stage":"R2","group":"Delivery","ref":"G-159"},
    {"id":"g-160","statement":"A tenant owner can export all of the tenant's data, and can delete the tenant after a grace period during which the deletion can be cancelled.","stage":"R2","group":"Tenancy","ref":"G-160"},
    {"id":"g-161","statement":"Visitors can search a tenant's published content, and editors can search the drafts they are permitted to read.","stage":"R4","group":"Content","ref":"G-161"},
    {"id":"g-162","statement":"A tenant can collect submissions from a form on its site, and each submission is stored, notified and exportable.","stage":"R4","group":"Content","ref":"G-162"},
    {"id":"g-163","statement":"Records can be exported and imported as documents in the tenant's own format, and a copy imported elsewhere keeps the identifiers and versions of its records.","stage":"R4","group":"Content","ref":"G-163"},
    {"id":"g-164","statement":"A tenant's configuration can be promoted from a staging tenant to its production tenant through a proposal that production approves, with content kept apart.","stage":"R3","group":"Platform","ref":"G-164"},
    {"id":"g-165","statement":"Platform operators act in a tenant only under a support grant that the tenant owner issued, and every act they make is recorded.","stage":"R1","group":"Identity","ref":"G-165"},
    {"id":"g-166","statement":"Customers can see the limits that apply to them and the changes to the delivery interface, and an old delivery version stays served for a stated period.","stage":"R2","group":"Delivery","ref":"G-166"},
    {"id":"g-167","statement":"A tenant can install a template or an integration that the platform publishes, after seeing what it changes.","stage":"R3","group":"Platform","ref":"G-167"},
    {"id":"g-168","statement":"The platform publishes, for each plan, the objectives it measures and the results measured each month.","stage":"R4","group":"Business","ref":"G-168"},
    {"id":"g-200","statement":"A person can do in conversation everything they can do in the authoring application, and the assistant acts with that person's permissions and no more.","stage":"R3","group":"Conversation","ref":"G-200"},
    {"id":"g-201","statement":"Every change an assistant makes is previewed, and is applied only when the person confirms it.","stage":"R3","group":"Conversation","ref":"G-201"},
    {"id":"g-202","statement":"A person can ask why an action was refused, what it would do, what changed and who changed it, and the answer names its sources.","stage":"R3","group":"Conversation","ref":"G-202"},
    {"id":"g-203","statement":"The conversation and the direct interface are one interface: a person can move between them at any point and sees the effect of each in the other.","stage":"R3","group":"Conversation","ref":"G-203"},
    {"id":"g-204","statement":"The conversation works with a keyboard, a screen reader, reduced motion, a small screen and a poor network connection.","stage":"R3","group":"Conversation","ref":"G-204"},
    {"id":"g-205","statement":"A tenant can turn the assistant off, and tenant content reaches a model provider only under the tenant's policy.","stage":"R3","group":"Conversation","ref":"G-205"},
    {"id":"g-206","statement":"Editing in the authoring application keeps unsaved and conflicting work from being lost, and shows who else is editing.","stage":"R4","group":"Authoring","ref":"G-206"},
    {"id":"g-207","statement":"A new tenant is set up through the conversation, with a template, its content types and its people.","stage":"R4","group":"Authoring","ref":"G-207"},
    {"id":"g-250","statement":"A page of a tenant cannot run script, load a frame or submit a form that the tenant did not publish.","stage":"R2","group":"Security","ref":"G-250"},
    {"id":"g-251","statement":"Attempts to guess a password are limited by the account, by the source and by the platform as a whole.","stage":"R1","group":"Security","ref":"G-251"},
    {"id":"g-252","statement":"Sign-in, sign-up, recovery and provisioning reveal nothing about which accounts exist.","stage":"R1","group":"Security","ref":"G-252"},
    {"id":"g-253","statement":"A person whose account is attacked is told, and can end every session that the attacker holds.","stage":"R1","group":"Security","ref":"G-253"},
    {"id":"g-254","statement":"A session cookie reaches only the host that set it.","stage":"R1","group":"Security","ref":"G-254"},
    {"id":"g-255","statement":"Federation accepts a provider's message only after every field that binds it to this tenant, this client and this request has been checked.","stage":"R1","group":"Security","ref":"G-255"},
    {"id":"g-256","statement":"Each component accepts a connection only from the components the architecture names as its callers, and the operator console is reachable only from the operations network.","stage":"R0","group":"Security","ref":"G-256"},
    {"id":"g-257","statement":"A tenant cannot make the platform contact an address that the outbound rule forbids, by any name, encoding or redirect.","stage":"R2","group":"Security","ref":"G-257"},
    {"id":"g-258","statement":"An operator or a support person reads tenant content only under a grant that the tenant gave and that ends.","stage":"R1","group":"Security","ref":"G-258"},
    {"id":"g-259","statement":"Every component image that runs can be traced to the source and the build that produced it, and to the dependencies it contains.","stage":"R0","group":"Security","ref":"G-259"},
    {"id":"g-260","statement":"A tenant's upload is stored, scanned and delivered without being run and without exhausting the platform.","stage":"R4","group":"Security","ref":"G-260"},
    {"id":"g-261","statement":"A tenant's keys can be rotated while the tenant is in service, and a compromised key can be retired at once.","stage":"R1","group":"Security","ref":"G-261"},
    {"id":"g-262","statement":"Abuse by one tenant or one source does not degrade the platform for others, and a tenant domain used for abuse can be taken down.","stage":"R2","group":"Security","ref":"G-262"},
    {"id":"g-263","statement":"No principal widens its own authority through an operation, an approval, an export or a change to roles and policies.","stage":"R3","group":"Security","ref":"G-263"},
    {"id":"g-264","statement":"An export or a generated file contains no formula or markup that a reader's application would run.","stage":"R2","group":"Security","ref":"G-264"},
    {"id":"g-265","statement":"Security problems reported to the platform are received, fixed and disclosed to the tenants they affect.","stage":"R0","group":"Security","ref":"G-265"},
    {"id":"g-266","statement":"A tenant's database credentials reach only that tenant's database, and a compromised runtime instance reaches no other tenant.","stage":"R1","group":"Security","ref":"G-266"},
    {"id":"g-267","statement":"The edge serves a copy of a page only to the requests that the copy was made for.","stage":"R2","group":"Security","ref":"G-267"},
    {"id":"g-300","statement":"Each tenant-facing surface has a stated availability objective and latency objectives for its reads and writes, and its alerts come from the error budget those objectives leave.","stage":"R3","group":"Operations","ref":"G-300"},
    {"id":"g-301","statement":"The failure of one dependency or one tenant leaves the work that does not need it answering, and overload is refused early rather than answered late.","stage":"R2","group":"Resilience","ref":"G-301"},
    {"id":"g-302","statement":"Each tenant database can be restored to a moment within a stated window, and corruption is found by the platform before a reader finds it.","stage":"R4","group":"Data safety","ref":"G-302"},
    {"id":"g-303","statement":"A release or a layout change reaches tenants in stages, can be undone, and stops itself when its own criteria fail.","stage":"R2","group":"Change","ref":"G-303"},
    {"id":"g-304","statement":"An operator or an agent can diagnose one tenant and act on an alert from the platform's own description, without reading the code.","stage":"R3","group":"Operations","ref":"G-304"},
    {"id":"g-350","statement":"A person whose personal data a tenant holds can obtain it, have it corrected or restricted, and have it erased, with each request ending in a recorded answer.","stage":"R2","group":"Privacy","ref":"G-350"},
    {"id":"g-351","statement":"Every place that holds personal data is declared in the data model with its owner, its personal fields and its retention.","stage":"R0","group":"Privacy","ref":"G-351"},
    {"id":"g-352","statement":"Erasing a person leaves the tamper-evident audit record intact and records what was erased.","stage":"R3","group":"Privacy","ref":"G-352"},
    {"id":"g-353","statement":"A tenant's personal data is stored, copied, backed up and sent only within the region of its placement, and each transfer out of it is named.","stage":"R4","group":"Privacy","ref":"G-353"},
    {"id":"g-354","statement":"Access by platform staff to a tenant's data is granted for a stated purpose, expires, is visible to the tenant and is refused where the tenant forbids it.","stage":"R3","group":"Privacy","ref":"G-354"},
    {"id":"g-355","statement":"Retention is set per record type by the tenant, and a legal hold suspends the erasure and the expiry of the records it names.","stage":"R2","group":"Privacy","ref":"G-355"},
    {"id":"g-356","statement":"The platform produces the compliance evidence an auditor asks for: processing records, change approvals, encryption statements and access reports.","stage":"R3","group":"Privacy","ref":"G-356"},
    {"id":"g-400","statement":"A run of an agent can be explained afterwards from its recorded inputs, operations and outcomes, by the owner of each tenant the run touched.","stage":"R3","group":"Agents","ref":"G-400"},
    {"id":"g-401","statement":"An agent is held to the authority of the person it acts for, and it cannot widen that authority, change the rules that constrain it, or switch off its own record or its own halt.","stage":"R3","group":"Agents","ref":"G-401"},
    {"id":"g-402","statement":"Text that an agent reads from a tenant, a file, a webhook, an error, another agent or a log line cannot direct the agent beyond the authority of the person it acts for.","stage":"R3","group":"Agents","ref":"G-402"},
    {"id":"g-403","statement":"The reach of change made by an agent is bounded in volume, in time and in reversibility, and it stops when an anomaly appears.","stage":"R3","group":"Agents","ref":"G-403"},
    {"id":"g-404","statement":"Agents that operate the platform itself have identities of their own and pass stricter approval than agents that serve a tenant.","stage":"R3","group":"Agents","ref":"G-404"},
    {"id":"g-405","statement":"An agent cannot take data out of the platform to an address that the tenant has not allowed.","stage":"R3","group":"Agents","ref":"G-405"},
    {"id":"g-450","statement":"A tenant defines named tokens whose values are computed by expressions, and uses them in any content a reader sees and in email.","stage":"R2","group":"Content","ref":"G-450"},
    {"id":"g-451","statement":"A token shows each reader only what that reader is permitted to read, and its value arrives as text, not as markup.","stage":"R2","group":"Content","ref":"G-451"},
    {"id":"g-452","statement":"The platform sends email through one contract, and the provider behind it is a matter of configuration.","stage":"R1","group":"Platform","ref":"G-452"},
    {"id":"g-453","statement":"Mail of a tenant comes from the tenant's own proved domain, respects bounces, complaints and unsubscription, and is delivered once.","stage":"R2","group":"Automation","ref":"G-453"},
    {"id":"g-550","statement":"Each component image is built once, is addressed by its digest, and runs unchanged in every environment that runs it.","stage":"R0","group":"Platform","ref":"G-550"},
    {"id":"g-551","statement":"The image that passes the gate in the stage environment is the image that production runs.","stage":"R4","group":"Platform","ref":"G-551"},
    {"id":"g-552","statement":"Production changes without refusing a request, and the previous colour stays available so that switching back is a single operation.","stage":"R4","group":"Platform","ref":"G-552"},
    {"id":"g-553","statement":"A release that changes stored data or stored formats is either undone within a stated window or marked roll-forward only before it starts.","stage":"R4","group":"Platform","ref":"G-553"},
    {"id":"g-554","statement":"Production changes only through release records and audited operations, and the platform reports every difference between its definitions and what runs.","stage":"R4","group":"Platform","ref":"G-554"},
    {"id":"g-555","statement":"The stage environment holds no personal data of a production tenant.","stage":"R4","group":"Privacy","ref":"G-555"},
    {"id":"g-556","statement":"A change to a tenant's content model is previewed, recorded and attributable, and a change that fails leaves the tenant as it was.","stage":"R2","group":"Tenancy","ref":"G-556"},
    {"id":"g-557","statement":"No committed data of a tenant is lost, and no reader sees a partly converted record, when the platform or the tenant changes stored data.","stage":"R2","group":"Tenancy","ref":"G-557"},
    {"id":"g-558","statement":"A tenant can move to another database cluster or a dedicated instance with a bounded write freeze, and its source keeps serving until the target is verified.","stage":"R2","group":"Tenancy","ref":"G-558"},
    {"id":"g-47","statement":"Tenant automation cannot reach the platform's own network or another tenant.","stage":"R2","group":"Automation","ref":"G-47"}
  ],
  "nonGoals": [
    {"id":"ng-1","statement":"No tenancy mode in which tenants share one database. Isolation by database is the product, not an option (D-1).","horizon":"Not planned.","ref":"NG-1"},
    {"id":"ng-2","statement":"No general identity provider for third-party applications. The identity service signs assertions for the platform's own components and tokens for a tenant's own service accounts and agents (D-4).","horizon":"Not at launch.","ref":"NG-2"},
    {"id":"ng-3","statement":"No execution of tenant-supplied code inside platform processes. Automation is workflows over declared steps and calls to external addresses (D-506).","horizon":"Not planned.","ref":"NG-3"},
    {"id":"ng-4","statement":"No active-active operation across regions. One region is primary for a tenant, and recovery in another region is a restore (D-23).","horizon":"Not at launch.","ref":"NG-4"},
    {"id":"ng-5","statement":"No visual page builder. Pages are view definitions and templates held as metadata.","horizon":"Not at launch.","ref":"NG-5"},
    {"id":"ng-6","statement":"No query of tenant data spans tenants. Reports across tenants read telemetry, published summaries and the tenant directory (ARC-110), and operations over tenants are operations of the control plane.","horizon":"Not planned.","ref":"NG-6"},
    {"id":"ng-7","statement":"No GraphQL interface. Delivery is HTTP with JSON over named queries and view definitions (D-507).","horizon":"Not at launch.","ref":"NG-7"},
    {"id":"ng-8","statement":"No built-in web analytics, email marketing or commerce.","horizon":"Not planned.","ref":"NG-8"},
    {"id":"ng-9","statement":"No installer for customer-operated sites. The local container stack is for development and proof, not a supported production form.","horizon":"Not at launch.","ref":"NG-9"},
    {"id":"ng-150","statement":"No marketplace where third parties publish code. Templates and integrations are platform-authored declarative bundles (INT-155, NG-3).","horizon":"Not at launch.","ref":"NG-150"},
    {"id":"ng-151","statement":"No reader comments on published content. Review notes live on the draft version under review.","horizon":"Not planned.","ref":"NG-151"},
    {"id":"ng-152","statement":"No payment processing, invoicing or tax calculation inside the platform. Usage leaves through the billing export (BIL-153).","horizon":"Not planned.","ref":"NG-152"},
    {"id":"ng-153","statement":"No client libraries in the first releases. The delivery interface is described in a machine-readable document from which clients can be generated (CMS-169).","horizon":"Not at launch.","ref":"NG-153"},
    {"id":"ng-154","statement":"No importers for named third-party content systems in the first releases. Records move as documents in the tenant's own export format (CMS-172).","horizon":"Not at launch.","ref":"NG-154"},
    {"id":"ng-155","statement":"No contractual service credits in the platform. The objectives are published as data (BIL-155).","horizon":"Not planned.","ref":"NG-155"},
    {"id":"ng-10","statement":"No search across tenants, and no search over the text of files. Search is per tenant over its published and draft content, as the audience of the reader permits (SRH-150, SRH-151).","horizon":"Not at launch.","ref":"NG-10"},
    {"id":"ng-200","statement":"No assistant with more authority than the person it serves. The assistant holds no credential of its own, and no conversation grants a permission that the person lacks (D-18, TOK-004).","horizon":"Never.","ref":"NG-200"},
    {"id":"ng-201","statement":"No change applied by the assistant without the person's confirmation, except steps of a workflow that the tenant declared, which run under that workflow's own approvals (WFL-006).","horizon":"Not planned.","ref":"NG-201"},
    {"id":"ng-202","statement":"No voice-only interface at launch. Speech may be added later through the same operations, previews and confirmations.","horizon":"Not at launch.","ref":"NG-202"},
    {"id":"ng-350","statement":"No tenant content reaches a model provider unless the tenant has turned the assistant on and the provider is listed among its subprocessors. A tenant that turns the assistant off has no model request made (CNV-234).","horizon":"Standing rule.","ref":"NG-350"},
    {"id":"ng-351","statement":"No purpose built around the personal data of children or the special categories of personal data. A tenant that collects such data is its controller, and the platform offers it no feature made for that purpose.","horizon":"Not planned.","ref":"NG-351"},
    {"id":"ng-550","statement":"No zero-downtime move of a tenant between regions. A move has a bounded write freeze (D-576), and a move across regions is a restore (NG-4).","horizon":"Not planned.","ref":"NG-550"},
    {"id":"ng-551","statement":"No automatic reversal of a tenant's schema change once later writes depend on it. The recovery for such a change is a restore to a point in time (TEN-015).","horizon":"Not planned.","ref":"NG-551"},
    {"id":"ng-552","statement":"No guarantee that grandfathered records conform to a later schema. Only strict mode guarantees conformance (KRN-009, KRN-010).","horizon":"Not planned.","ref":"NG-552"},
    {"id":"ng-553","statement":"No ephemeral environment for each change or branch. The local stack and the stage environment are the two non-production environments (D-552).","horizon":"Not planned.","ref":"NG-553"},
    {"id":"ng-554","statement":"No automatic promotion of a release to production. Each production release waits for its approvals (REL-560).","horizon":"Not planned.","ref":"NG-554"},
    {"id":"ng-555","statement":"No reversal of committed tenant data by replaying changes backwards. Lost data comes back from a restore to a point in time (OPS-320, TEN-015).","horizon":"Not planned.","ref":"NG-555"},
    {"id":"ng-556","statement":"No delivery shape is served after the window that its notice states has ended. A client that has not moved by then loses the old shape (CMS-170).","horizon":"Not planned.","ref":"NG-556"},
    {"id":"ng-400","statement":"No promise about the reasoning of a third-party agent's model. The platform records what such an agent reads, calls and decides at its own boundary and enforces the authority it holds, but it makes no promise about what the model computes or why.","horizon":"Not promised.","ref":"NG-400"}
  ],
  "boundaries": [
    {"id":"b-1","name":"Kernel interface: decide an intent, answer a read, plan the state a decision needs","interfaceKind":"Rust library","usedBy":"runtime, identity service, automation worker, simulator, verification","ref":"B-1"},
    {"id":"b-2","name":"Store contract: tenant-scoped snapshots, atomic commits guarded by a revision, ordered events, journal","interfaceKind":"Rust trait with a conformance suite","usedBy":"runtime, identity service, automation worker, control plane","ref":"B-2"},
    {"id":"b-3","name":"Tenant directory: tenants, placements, domain bindings, lifecycle operations","interfaceKind":"HTTP with JSON","usedBy":"gateway, runtime, automation worker, operators, agents","ref":"B-3"},
    {"id":"b-4","name":"Identity interface: sign-in methods, sessions, factors, recovery, realm configuration","interfaceKind":"HTTP with JSON","usedBy":"gateway, authoring application, agents","ref":"B-4"},
    {"id":"b-5","name":"Federation endpoints: OpenID Connect redirect and callback, SAML metadata and assertion consumer, SCIM provisioning","interfaceKind":"HTTP (OpenID Connect, SAML 2.0, SCIM 2.0)","usedBy":"external identity providers, browsers","ref":"B-5"},
    {"id":"b-6","name":"Token endpoint: client credentials, token exchange, introspection, signing keys","interfaceKind":"HTTP (OAuth 2.1)","usedBy":"service accounts, agents, platform components","ref":"B-6"},
    {"id":"b-7","name":"Scheduling interface: jobs, schedules, triggers, leases","interfaceKind":"HTTP with JSON, kernel intents","usedBy":"runtime, workflow engine, workers, agents","ref":"B-7"},
    {"id":"b-8","name":"Workflow definitions: steps, waits, compensations, approvals","interfaceKind":"tenant metadata","usedBy":"tenant owners, agents","ref":"B-8"},
    {"id":"b-9","name":"Delivery interface: views and named queries over published content","interfaceKind":"HTTP with JSON","usedBy":"browsers, content delivery network, tenant applications","ref":"B-9"},
    {"id":"b-10","name":"Edge contract: storability directives, surrogate keys, purge, signed addresses, domain routing","interfaceKind":"HTTP headers and a purge call","usedBy":"content delivery network, gateway","ref":"B-10"},
    {"id":"b-11","name":"Operation catalogue and change proposals","interfaceKind":"HTTP with JSON, Model Context Protocol","usedBy":"agents, operators, authoring application","ref":"B-11"},
    {"id":"b-12","name":"Telemetry export and audit log","interfaceKind":"OpenTelemetry protocol, HTTP with JSON","usedBy":"operators, agents, tenant owners","ref":"B-12"},
    {"id":"b-13","name":"Authoring application and sign-in pages","interfaceKind":"UI (semantic HTML, layered CSS, vanilla JavaScript)","usedBy":"authors, editors, tenant owners","ref":"B-13"},
    {"id":"b-14","name":"File store contract: tenant-scoped objects addressed by content hash","interfaceKind":"Rust trait with a conformance suite","usedBy":"runtime, connector runner","ref":"B-14"},
    {"id":"b-15","name":"Copy store contract: keyed stored copies with tags and removal by tag","interfaceKind":"Rust trait with a conformance suite","usedBy":"runtime, gateway","ref":"B-15"},
    {"id":"b-16","name":"Notice contract: tenant-scoped notices of due work, revocations and domain events, delivered until acknowledged","interfaceKind":"Rust trait with a conformance suite","usedBy":"runtime, automation worker, identity service, gateway, agent gateway","ref":"B-16"},
    {"id":"b-17","name":"Key service contract: per-tenant data keys, wrapping, destruction","interfaceKind":"Rust trait with a conformance suite","usedBy":"identity service, runtime, control plane","ref":"B-17"},
    {"id":"b-18","name":"Mail contract: submission of one rendered message with an idempotency key, and delivery reports","interfaceKind":"Rust trait with a conformance suite","usedBy":"mail dispatcher","ref":"B-18"},
    {"id":"b-19","name":"Deployment descriptors: the local container stack and the cloud profile","interfaceKind":"compose file, infrastructure modules, command line","usedBy":"developers, operators, agents","ref":"B-19"},
    {"id":"b-20","name":"Projection interface: fork a tenant, apply a proposed change, replay, compare","interfaceKind":"HTTP with JSON","usedBy":"tenant owners, agents","ref":"B-20"},
    {"id":"b-100","name":"Limit contract: shared counters for request rates and agent operation budgets","interfaceKind":"Rust trait with a conformance suite","usedBy":"gateway, agent gateway","ref":"B-100"},
    {"id":"b-101","name":"Backup archive contract: point-in-time copies of one tenant database, encrypted under its key","interfaceKind":"Rust trait with a conformance suite","usedBy":"control plane, runtime","ref":"B-101"},
    {"id":"b-150","name":"Webhook endpoints: signed inbound deliveries that start runs, and the log of outbound deliveries","interfaceKind":"HTTP with JSON, signed bodies","usedBy":"external systems, tenant owners","ref":"B-150"},
    {"id":"b-151","name":"Search index contract: entries per tenant, updated from commits, queried by audience class","interfaceKind":"Rust trait with a conformance suite","usedBy":"runtime, gateway","ref":"B-151"},
    {"id":"b-152","name":"Form intake: submissions with submission tokens, stored and notified","interfaceKind":"HTTP with JSON","usedBy":"readers, tenant owners","ref":"B-152"},
    {"id":"b-153","name":"Archive documents: tenant archives, record exports and form exports","interfaceKind":"JSON documents with a manifest","usedBy":"tenant owners, agents","ref":"B-153"},
    {"id":"b-154","name":"Notification subscriptions and inbox: email and in-platform notices","interfaceKind":"HTTP with JSON, mail","usedBy":"people, tenant owners","ref":"B-154"},
    {"id":"b-155","name":"Usage export: signed usage documents to the billing system the tenant configures","interfaceKind":"HTTP with JSON, signed documents","usedBy":"billing systems, tenant owners","ref":"B-155"},
    {"id":"b-156","name":"Status page and changelog","interfaceKind":"HTML and HTTP with JSON","usedBy":"operators, tenant owners, the public","ref":"B-156"},
    {"id":"b-200","name":"Conversation interface: turns, reply streams, pending actions and their confirmation","interfaceKind":"HTTP with JSON and server-sent events","usedBy":"authoring application, tenant owners, editors","ref":"B-200"},
    {"id":"b-201","name":"Model provider contract: generate a reply from messages and operation descriptions, stream it, report usage","interfaceKind":"Rust trait with a conformance suite","usedBy":"conversation service","ref":"B-201"},
    {"id":"b-202","name":"Collaboration channel: presence, saved drafts and conflicts on one record","interfaceKind":"HTTP with JSON and server-sent events","usedBy":"authoring application, editors","ref":"B-202"},
    {"id":"b-250","name":"Operator console and support grants","interfaceKind":"HTTP with JSON","usedBy":"operators, support staff","ref":"B-250"},
    {"id":"b-251","name":"Tenant file upload: intake, scanning and file-domain delivery","interfaceKind":"HTTP multipart and HTTP","usedBy":"authors, tenant applications, the upload scanner","ref":"B-251"},
    {"id":"b-252","name":"Outbound gate: the one path from connectors to external addresses","interfaceKind":"HTTP and HTTPS client under the outbound rule","usedBy":"connector runner","ref":"B-252"},
    {"id":"b-350","name":"Subject rights and access grants: export, rectification, restriction and erasure of one principal's records, and grants of platform access to a tenant","interfaceKind":"HTTP with JSON","usedBy":"tenant owners, platform operators, the operator console","ref":"B-350"},
    {"id":"b-450","name":"Content token definitions and the token reference in content","interfaceKind":"Tenant metadata (JSON) and a node of the structured blocks","usedBy":"authors, tenant owners, agents","ref":"B-450"},
    {"id":"b-451","name":"Mail interface: templates, sender domains, the suppression list and the mail log","interfaceKind":"HTTP and catalogue operations","usedBy":"tenant owners, authors, agents","ref":"B-451"},
    {"id":"b-550","name":"Release controller interface: release records, promotions, colour switches, switches back and freezes","interfaceKind":"HTTP with JSON and catalogue operations","usedBy":"release engineers, operators, agents of the platform, the release pipeline","ref":"B-550"},
    {"id":"b-551","name":"Traffic switch: the listener rule that sends public requests to the live colour of a component","interfaceKind":"load balancer listener configuration","usedBy":"release controller, delivery network origin","ref":"B-551"},
    {"id":"b-552","name":"Tenant migration run: the cursor, the batches and the preview a run is applied from","interfaceKind":"HTTP with JSON and catalogue operations","usedBy":"tenant owners, agents, automation worker","ref":"B-552"},
    {"id":"b-553","name":"Tenant move: the move record, the read-only window and the placement switch","interfaceKind":"HTTP with JSON","usedBy":"control plane, operators, tenant owners","ref":"B-553"},
    {"id":"b-21","name":"Tenant bundle: a tenant or a template written as one document","interfaceKind":"JSON document","usedBy":"control plane, developers, agents","ref":"B-21"}
  ],
  "decisions": [
    {"id":"d-1","title":"One PostgreSQL database per tenant","statement":"**One PostgreSQL database per tenant.** Each tenant has one PostgreSQL database, grouped in clusters. The SQLite adapter stays for single-process local use, tests and simulation. A tenant is the unit of backup, restore, move, export, key and deletion.","group":"Tenancy","decided":"2026-11-18","ref":"D-1"},
    {"id":"d-2","title":"A control plane with its own database","statement":"**A control plane with its own database.** A control plane owns the tenant directory (tenants, placements, domain bindings), provisioning, moves and the wake index. Its database holds identifiers, states and addresses, and no tenant content (K-2).","group":"Tenancy","decided":"2026-11-18","ref":"D-2"},
    {"id":"d-3","title":"An identity realm per tenant, stored in the tenant database","statement":"**An identity realm per tenant, stored in the tenant database.** A tenant's principals, credentials, provider configurations, sessions and audit entries live in that tenant's database, so isolation, residency, export and deletion of identity follow the tenant. Platform operators have a realm of their own in the control database. A person who works in two tenants has two principals, which a shared identity provider may link (D-500).","group":"Identity","decided":"2026-11-18","ref":"D-3"},
    {"id":"d-4","title":"The identity service signs, everything else verifies","statement":"**The identity service signs, everything else verifies.** The identity service is the only holder of credentials. It gives the gateway a short-lived signed assertion for each request's session, and gives service accounts and agents signed access tokens. Other components verify signatures against published keys and never see a credential.","group":"Identity","decided":"2026-11-18","ref":"D-4"},
    {"id":"d-5","title":"Sessions are opaque and held by the platform","statement":"**Sessions are opaque and held by the platform.** A browser session is a random secret in an HttpOnly cookie (K-16). The session itself is a record that can be listed and revoked. Signed tokens are used only between components and for non-browser callers, with lifetimes short enough that revocation needs no list.","group":"Identity","decided":"2026-11-18","ref":"D-5"},
    {"id":"d-6","title":"The address selects the realm, the email domain selects the provider","statement":"**The address selects the realm, the email domain selects the provider.** The host name of a request selects the tenant and so the realm. Within a realm an email domain can be bound to an identity provider, and then that provider is the only way in for addresses in the domain.","group":"Identity","decided":"2026-11-18","ref":"D-6"},
    {"id":"d-7","title":"OpenID Connect by authorization code with a proof key","statement":"**OpenID Connect by authorization code with a proof key.** As a relying party the identity service uses the authorization code flow with a proof key, a state value and a nonce, and verifies issuer, audience, signature and nonce of the identity token.","group":"Identity","decided":"2026-11-18","ref":"D-7"},
    {"id":"d-8","title":"SAML started by the service provider","statement":"**SAML started by the service provider.** SAML sign-in starts at the platform. A response is accepted when it answers a pending request and its assertion is signed by a certificate the tenant configured. Sign-in started by the provider is off unless a tenant turns it on.","group":"Identity","decided":"2026-11-18","ref":"D-8"},
    {"id":"d-9","title":"Emailed links are single-use and bound to the requesting browser","statement":"**Emailed links are single-use and bound to the requesting browser.** A sign-in link carries a random token stored as a hash, is accepted once, expires fifteen minutes after it was sent and is accepted only in the browser that asked for it. The answer to a request for a link is the same whether or not the address has an account.","group":"Identity","decided":"2026-11-18","ref":"D-9"},
    {"id":"d-10","title":"Job state lives with the tenant, a wake index lives with the control plane","statement":"**Job state lives with the tenant, a wake index lives with the control plane.** Jobs, schedules and workflow runs are records in the tenant database, written in the same transaction as the change that caused them. The control database holds only a wake index: tenant and next due time. Workers read the index to find tenants with due work, so idle tenants cost nothing.","group":"Automation","decided":"2026-11-18","ref":"D-10"},
    {"id":"d-11","title":"Leases with fencing tokens","statement":"**Leases with fencing tokens.** A worker takes a job under a lease with a token that rises on every grant. The tenant database refuses a result that carries a superseded token (K-17), so a stalled worker cannot overwrite the work of its replacement.","group":"Automation","decided":"2026-11-18","ref":"D-11"},
    {"id":"d-12","title":"At least once, made once by idempotency keys","statement":"**At least once, made once by idempotency keys.** Jobs are attempted at least once. Each external effect carries an idempotency key derived from the job and step, and the adapter that carries it out records the key with the outcome.","group":"Automation","decided":"2026-11-18","ref":"D-12"},
    {"id":"d-13","title":"Workflow steps are kernel decisions","statement":"**Workflow steps are kernel decisions.** A workflow is a state machine held as tenant metadata. Each step is decided by the kernel from the run's recorded state and returns effect descriptions (K-9), so a run is replayable and a workflow can be projected before it is activated.","group":"Automation","decided":"2026-11-18","ref":"D-13"},
    {"id":"d-14","title":"A copy is keyed by the versions it was computed from","statement":"**A copy is keyed by the versions it was computed from.** The key of a stored copy contains the tenant, what was asked, the audience class, the schema version and the revision of each object type the answer depends on. A change makes a new key instead of racing an old entry. A lifetime is kept only as a backstop.","group":"Delivery","decided":"2026-11-18","ref":"D-14"},
    {"id":"d-15","title":"Audience classes come from the kernel","statement":"**Audience classes come from the kernel.** The kernel derives from a tenant's policies which principals are indistinguishable for a read: the audience class. Copies are stored per class, never per person unless the policy itself reads the principal.","group":"Delivery","decided":"2026-11-18","ref":"D-15"},
    {"id":"d-16","title":"The content delivery network is keyed by host and purged by surrogate key","statement":"**The content delivery network is keyed by host and purged by surrogate key.** Every response for a tenant is keyed by its host name. Published pages carry surrogate keys naming the tenant and the records they were rendered from, and an outbox consumer purges those keys when a change commits.","group":"Delivery","decided":"2026-11-18","ref":"D-16"},
    {"id":"d-17","title":"Three tiers of copy","statement":"**Three tiers of copy.** Schema and compiled expressions are kept in process, keyed by schema version. View results are kept in a shared copy store. Public pages and media are kept at the content delivery network. Each tier is described in the copy class table.","group":"Delivery","decided":"2026-11-18","ref":"D-17"},
    {"id":"d-18","title":"One operation catalogue for people and agents","statement":"**One operation catalogue for people and agents.** Every capability is an operation with a name, an input schema and a description, generated from platform code and tenant metadata. The authoring application, the command line and the Model Context Protocol server are all clients of the same catalogue.","group":"Agents","decided":"2026-11-18","ref":"D-18"},
    {"id":"d-19","title":"Risky changes go through proposals","statement":"**Risky changes go through proposals.** A change that tenant policy classes as risky is made as a proposal: the change, its projection against recorded history, and an approval. A proposal is applied only at the revision it was projected against.","group":"Agents","decided":"2026-11-18","ref":"D-19"},
    {"id":"d-20","title":"An audit log chained by hash, per tenant","statement":"**An audit log chained by hash, per tenant.** Each tenant database holds an append-only audit log in which every entry contains the hash of the one before. The control database holds the same for platform operations. Operational telemetry is separate and carries no record content.","group":"Observability","decided":"2026-11-18","ref":"D-20"},
    {"id":"d-21","title":"OpenTelemetry everywhere","statement":"**OpenTelemetry everywhere.** Every component exports traces, metrics and logs through the OpenTelemetry protocol with the correlation identifier of the request and the tenant identifier.","group":"Observability","decided":"2026-11-18","ref":"D-21"},
    {"id":"d-22","title":"Containers locally","statement":"**Containers locally.** The local stack is a compose file: the platform components, PostgreSQL, an object store, a copy store, a mail catcher, a test identity provider and a telemetry collector. This replaces the prototype's rule against containers.","group":"Platform","decided":"2026-11-18","ref":"D-22"},
    {"id":"d-23","title":"Amazon Web Services first, one region per tenant","statement":"**Amazon Web Services first, one region per tenant.** The first cloud profile uses managed containers, managed PostgreSQL, object storage, a managed copy store, a content delivery network, a key service and a mail service, created from version-controlled infrastructure definitions. A tenant has one primary region.","group":"Platform","decided":"2026-11-18","ref":"D-23"},
    {"id":"d-24","title":"Seams are traits with conformance suites","statement":"**Seams are traits with conformance suites.** Each infrastructure dependency is a Rust trait written in the platform's terms, with a conformance suite, a local adapter and a cloud adapter, as the store contract already is.","group":"Platform","decided":"2026-11-18","ref":"D-24"},
    {"id":"d-25","title":"Envelope encryption per tenant","statement":"**Envelope encryption per tenant.** Each tenant has a data key wrapped by the key service. Destroying the wrapped key is how a deleted tenant's backups become unreadable.","group":"Platform","decided":"2026-11-18","ref":"D-25"},
    {"id":"d-26","title":"One specification, two tools","statement":"**One specification, two tools.** The specification is one Exegra JSONC file. Exegra validates it, evaluates structural and data claims, and runs the behaviour models. Concordance renders its requirements, lints them and reconciles them with code and recorded test results. A milestone is started in the gate when work on it begins.","group":"Assurance","decided":"2026-11-18","ref":"D-26"},
    {"id":"d-27","title":"The prototype's services become the gateway and the runtime","statement":"**The prototype's services become the gateway and the runtime.** The backend-for-frontend becomes the gateway. The backend becomes the runtime. Sign-in, sessions and password handling move out of the runtime into the identity service.","group":"Platform","decided":"2026-11-18","ref":"D-27"},
    {"id":"d-100","title":"Directory reads survive a control plane outage","statement":"**Directory reads survive a control plane outage.** Gateways and runtimes hold directory entries and answer reads for a tenant from them while the control plane cannot be reached. State changes are refused while the control plane cannot be reached (ARC-100). The age of the entry served is stated, so a reader can tell how old the answer is (ARC-100).","group":"Tenancy","decided":"2026-11-18","ref":"D-100"},
    {"id":"d-101","title":"Cross-tenant reporting is fed, not queried","statement":"**Cross-tenant reporting is fed, not queried.** Operator reports over many tenants read telemetry, summaries that tenants publish, and the tenant directory. Nothing reaches into a tenant database from outside it (ARC-110).","group":"Observability","decided":"2026-11-18","ref":"D-101"},
    {"id":"d-102","title":"Outbox delivery is a job","statement":"**Outbox delivery is a job.** Events that a commit leaves unpublished are published by a job in the tenant database. A runtime that stops after its commit therefore does not strand them (ARC-105).","group":"Automation","decided":"2026-11-18","ref":"D-102"},
    {"id":"d-103","title":"Modules extend the platform as tenant metadata","statement":"**Modules extend the platform as tenant metadata.** A product feature is a module: record types, views, workflows and operations written as tenant metadata and installed through kernel intents. A module that needs platform code reaches tenant data through the runtime alone (ARC-112, ARC-113).","group":"Platform","decided":"2026-11-18","ref":"D-103"},
    {"id":"d-150","title":"Environments are tenants","statement":"**Environments are tenants.** A staging environment and a sandbox are tenants of their own, each with its own database, identity realm and key. A tenant records its kind, and a staging tenant names the production tenant it serves (ADM-157).","group":"Tenancy","decided":"2026-11-18","ref":"D-150"},
    {"id":"d-151","title":"Staging promotes configuration, not content","statement":"**Staging promotes configuration, not content.** A promotion carries tenant metadata through a proposal to production. Records of content stay with the tenant they were written in, and move by export and import (CMS-172).","group":"Platform","decided":"2026-11-18","ref":"D-151"},
    {"id":"d-152","title":"Delivery keys are service accounts with a delivery scope","statement":"**Delivery keys are service accounts with a delivery scope.** A headless application reads published content with a service account that names one site and one audience class, and the identity service revokes it like any other grant.","group":"Identity","decided":"2026-11-18","ref":"D-152"},
    {"id":"d-153","title":"Search and forms live in the tenant's own storage","statement":"**Search and forms live in the tenant's own storage.** The search index of a tenant is built from its own records, and a form submission is a record of its tenant. Neither is a shared service that holds several tenants.","group":"Tenancy","decided":"2026-11-18","ref":"D-153"},
    {"id":"d-154","title":"Billing exports usage and charges nothing","statement":"**Billing exports usage and charges nothing.** The platform counts metered quantities per tenant and sends signed usage documents to the billing system the tenant names. Prices, invoices and payment stay outside the platform (NG-152).","group":"Platform","decided":"2026-11-18","ref":"D-154"},
    {"id":"d-200","title":"The assistant is a client of the operation catalogue","statement":"**The assistant is a client of the operation catalogue.** The conversation service runs every change through the operations that a direct edit calls, with a delegated token that names the person (TOK-003). It holds no operation of its own, and its token grants no permission that the person lacks (TOK-004).","group":"Agents","decided":"2026-11-18","ref":"D-200"},
    {"id":"d-201","title":"Every change is previewed and confirmed","statement":"**Every change is previewed and confirmed.** The assistant shows each change as a preview and applies it only when the person confirms that preview. A risky change becomes a proposal (D-19). Undo is the inverse operation, previewed and confirmed in the same way.","group":"Agents","decided":"2026-11-18","ref":"D-201"},
    {"id":"d-202","title":"The model provider is a seam","statement":"**The model provider is a seam.** Model calls go through a contract with a conformance suite (D-24) and a local adapter that runs without cloud credentials (K-10). The platform offers one provider (D-514), and which tenant content it may receive is set by the tenant's policy and subprocessor list.","group":"Agents","decided":"2026-11-18","ref":"D-202"},
    {"id":"d-203","title":"The conversation is tenant data","statement":"**The conversation is tenant data.** Turns, pending actions and their evidence are records in the tenant database (K-2), read and written through the store contract. The browser holds no transcript.","group":"Agents","decided":"2026-11-18","ref":"D-203"},
    {"id":"d-204","title":"Interfaces are rendered from definitions","statement":"**Interfaces are rendered from definitions.** A reply shows an interface by naming a view definition and structured blocks. The model writes no markup, script or style (K-12).","group":"Content","decided":"2026-11-18","ref":"D-204"},
    {"id":"d-205","title":"The browser reaches the assistant through the gateway","statement":"**The browser reaches the assistant through the gateway.** Conversation requests and their streams pass through the gateway, which carries the person's session (K-6). The conversation service has no address that a browser can reach.","group":"Platform","decided":"2026-11-18","ref":"D-205"},
    {"id":"d-250","title":"Session cookies are host-only","statement":"**Session cookies are host-only.** The session cookie is set without a domain attribute, carries the host name prefix and the attribute that limits it to encrypted connections, and is read only by the host that set it. A tenant host cannot give a cookie to a parent domain or to a sibling host.","group":"Identity","decided":"2026-11-18","ref":"D-250"},
    {"id":"d-251","title":"Tenant files come from the file domain","statement":"**Tenant files come from the file domain.** Uploaded files are delivered from the file domain of the platform under a sandboxed policy, and not from a tenant host name.","group":"Content","decided":"2026-11-18","ref":"D-251"},
    {"id":"d-252","title":"Throttles at three levels","statement":"**Throttles at three levels.** Password attempts are throttled per account, per source and per realm, and across the platform, each level with its own counter.","group":"Identity","decided":"2026-11-18","ref":"D-252"},
    {"id":"d-253","title":"Break-glass access is time-limited and consented","statement":"**Break-glass access is time-limited and consented.** An operator reads tenant content in an emergency only under a grant that names the tenant, the purpose and the person, and that ends at its own expiry.","group":"Platform","decided":"2026-11-18","ref":"D-253"},
    {"id":"d-254","title":"Outbound addresses are judged where they are used","statement":"**Outbound addresses are judged where they are used.** A connector resolves the address it calls, judges the resolved address under the outbound rule, and connects to that address and to no other.","group":"Platform","decided":"2026-11-18","ref":"D-254"},
    {"id":"d-350","title":"Erasure by destroying the key of the subject","statement":"**Erasure by destroying the key of the subject.** Each personal field is sealed under a key held for its subject. Erasing the subject destroys that key, which makes every copy, backup and journal entry of the field unreadable without rewriting history. The audit chain and the event journal hash the sealed form, so a destroyed key breaks no link.","group":"Privacy","decided":"2026-11-18","ref":"D-350"},
    {"id":"d-351","title":"Backups and exports expire on a schedule","statement":"**Backups and exports expire on a schedule.** Backup images and tenant exports are encrypted under the tenant key and removed at the end of a retention period that the tenant policy sets. Erasure reaches them through the subject keys of D-350, so no image is edited to remove a person.","group":"Privacy","decided":"2026-11-18","ref":"D-351"},
    {"id":"d-352","title":"Platform staff read tenant data only under a grant","statement":"**Platform staff read tenant data only under a grant.** A grant names the operator, the tenant, the purpose and an expiry. The tenant sees each grant in its access report, and a tenant that forbids platform access has every grant refused.","group":"Privacy","decided":"2026-11-18","ref":"D-352"},
    {"id":"d-450","title":"Content tokens are tenant metadata evaluated by the kernel","statement":"**Content tokens are tenant metadata evaluated by the kernel.** A token is a name, an expression in the tenant expression language and a fallback text. It is stored under the schema version like every other definition. A reference to it in content is a node of the structured blocks, not a piece of text to substitute, so the value is placed as text by the renderer of each output context. The kernel evaluates the expression with the reader as the principal, which makes a token subject to the same read policies as a query, and makes its dependencies known for stored copies.","group":"Content","decided":"2026-11-18","ref":"D-450"},
    {"id":"d-451","title":"Mail is a job handled by one dispatcher behind the mail contract","statement":"**Mail is a job handled by one dispatcher behind the mail contract.** A component that wants mail sent commits a mail job with the change it belongs to. The mail dispatcher takes the job, renders the message for its recipient, checks the suppression list and the quota of the tenant, and hands the message to the adapter of the configured provider with an idempotency key. Providers differ in what they guarantee, so the contract states the guarantees and each adapter makes up the difference. Delivery reports come back through the same contract.","group":"Platform","decided":"2026-11-18","ref":"D-451"},
    {"id":"d-500","title":"No account spans tenants","statement":"**No account spans tenants.** A person who works in several tenants has a principal in each. A shared identity provider is what links them. A platform-wide account would put personal data in the control database, against K-2.","group":"Identity","decided":"2026-11-18","ref":"D-500"},
    {"id":"d-501","title":"The first region is US East, the second is EU West","statement":"**The first region is US East, the second is EU West.** The first cloud profile is built in the Amazon Web Services region us-east-1. The second region is eu-west-1, added when the first tenant needs residency in the European Union. A tenant is placed in one of them and stays there (D-23).","group":"Platform","decided":"2026-11-18","ref":"D-501"},
    {"id":"d-502","title":"Managed containers, not Kubernetes","statement":"**Managed containers, not Kubernetes.** The cloud profile runs the component images on the provider's managed container service. Nothing in the specification needs a cluster orchestrator, and one less system is one less thing to operate and patch.","group":"Platform","decided":"2026-11-18","ref":"D-502"},
    {"id":"d-503","title":"A dedicated database instance is a placement, offered on the top plan","statement":"**A dedicated database instance is a placement, offered on the top plan.** Every tenant has its own database. Most share a cluster. A tenant on the top plan can be placed on an instance of its own, which is the same placement record with a cluster of one (D-2).","group":"Tenancy","decided":"2026-11-18","ref":"D-503"},
    {"id":"d-504","title":"Search starts on PostgreSQL full-text search","statement":"**Search starts on PostgreSQL full-text search.** The search index contract is met in both profiles by full-text search in the tenant database. A separate search service is a second copy of tenant content to secure, place and erase, and it is added only when a measured need shows the first adapter is not enough.","group":"Content","decided":"2026-11-18","ref":"D-504"},
    {"id":"d-505","title":"Keys are managed by the platform at launch","statement":"**Keys are managed by the platform at launch.** Each tenant has its own data key, wrapped by the platform's key service (D-25). Keys held by the tenant are not offered at launch. The key service contract leaves room for them.","group":"Platform","decided":"2026-11-18","ref":"D-505"},
    {"id":"d-506","title":"Automation is declared steps and calls to external addresses","statement":"**Automation is declared steps and calls to external addresses.** A workflow is made of the step kinds the platform declares, and reaches anything else by calling an external address. Tenant code does not run on the platform (NG-3).","group":"Automation","decided":"2026-11-18","ref":"D-506"},
    {"id":"d-507","title":"The delivery interface is HTTP with JSON","statement":"**The delivery interface is HTTP with JSON.** There is no GraphQL interface (NG-7). Field selection, filtering and paging are part of the one interface.","group":"Delivery","decided":"2026-11-18","ref":"D-507"},
    {"id":"d-508","title":"Three plans, with quotas held as data","statement":"**Three plans, with quotas held as data.** There are three plans. Standard: 20 database connections, 50 requests a second, 10 GB stored, 10,000 jobs a day, 5,000 emails a month. Business: 50 connections, 200 requests a second, 100 GB, 100,000 jobs a day, 50,000 emails a month. Enterprise: quotas set by contract, with a dedicated database instance available (D-503). The numbers are starting values held as data, and changing them is an audited operation, not a release.","group":"Tenancy","decided":"2026-11-18","ref":"D-508"},
    {"id":"d-509","title":"The first owner is admitted by a single-use bootstrap credential","statement":"**The first owner is admitted by a single-use bootstrap credential.** Provisioning issues one bootstrap credential for the first owner of the tenant. It works once, expires, and is the only way in until that owner sets up a sign-in method. It is built with provisioning, at the second milestone (TEN-500).","group":"Tenancy","decided":"2026-11-18","ref":"D-509"},
    {"id":"d-510","title":"Platform flags come from the environment, tenant features are tenant metadata","statement":"**Platform flags come from the environment, tenant features are tenant metadata.** A flag that turns platform behaviour on or off is configuration of the deployment. A feature a tenant chooses is tenant metadata, changed through the kernel and audited like any other change.","group":"Platform","decided":"2026-11-18","ref":"D-510"},
    {"id":"d-511","title":"Each database cluster has a connection pooler","statement":"**Each database cluster has a connection pooler.** Components reach tenant databases through a pooler in front of each cluster, in transaction mode. The connection quota of a tenant is enforced at the pooler. This is the ordinary way to run many small databases on one cluster, and it is how ARC-114 is met.","group":"Tenancy","decided":"2026-11-18","ref":"D-511"},
    {"id":"d-512","title":"The first sellable slice has no site search","statement":"**The first sellable slice has no site search.** Search is built at the eleventh milestone. The first slice sold ends at the sixth, with authoring, delivery and usage metering.","group":"Content","decided":"2026-11-18","ref":"D-512"},
    {"id":"d-513","title":"The first billing adapter is Stripe","statement":"**The first billing adapter is Stripe.** The usage export is generic (BIL-153). The first system that receives it is Stripe.","group":"Tenancy","decided":"2026-11-18","ref":"D-513"},
    {"id":"d-514","title":"One model provider chosen by the platform, and the assistant is off until the tenant turns it on","statement":"**One model provider chosen by the platform, and the assistant is off until the tenant turns it on.** The platform offers one model provider behind the seam (D-202). A tenant does not bring its own model key at launch. The assistant is off in a new tenant, and an owner turns it on (CNV-500). Conversations are private to the person who started them and to readers of the audit log.","group":"Conversation","decided":"2026-11-18","ref":"D-514"},
    {"id":"d-515","title":"The assistant answers in the language of the message","statement":"**The assistant answers in the language of the message.** When the language of the person and the default of the tenant differ, the reply uses the language of the message it answers (CNV-246).","group":"Conversation","decided":"2026-11-18","ref":"D-515"},
    {"id":"d-516","title":"A preview is valid while nothing has changed, and for fifteen minutes","statement":"**A preview is valid while nothing has changed, and for fifteen minutes.** A preview stops being valid when the revision of the tenant differs from the one it was computed against, or fifteen minutes after it was shown, whichever comes first. The person is then shown a new preview.","group":"Conversation","decided":"2026-11-18","ref":"D-516"},
    {"id":"d-517","title":"An identity outage fails closed","statement":"**An identity outage fails closed.** While the identity service cannot be reached, requests that need a session are refused, with the outage named (IDN-300). Published content stays up. Honouring sessions through an outage would make a revocation unenforceable, and security outranks availability here.","group":"Identity","decided":"2026-11-18","ref":"D-517"},
    {"id":"d-518","title":"Planning values stand until a deployment measures them","statement":"**Planning values stand until a deployment measures them.** The reference load and the rates of the failure modes are planning values (a-reference-load, a-planning-rates). They are replaced by measured values after the first deployment, and the reference load is then tied to the plans of D-508.","group":"Platform","decided":"2026-11-18","ref":"D-518"},
    {"id":"d-519","title":"An event that keeps failing is parked","statement":"**An event that keeps failing is parked.** Parking keeps the tenant flowing. Subscribers that have not received the parked event see later events first, and the tenant owner sees the parked event listed and can release it (OPS-348).","group":"Automation","decided":"2026-11-18","ref":"D-519"},
    {"id":"d-520","title":"Processor for tenant data, controller for account data","statement":"**Processor for tenant data, controller for account data.** The platform is a processor of the personal data its tenants hold, and a controller only of its own account data. Each tenant states the lawful basis for each of its record types.","group":"Privacy","decided":"2026-11-18","ref":"D-520"},
    {"id":"d-521","title":"Only the tenant places a legal hold","statement":"**Only the tenant places a legal hold.** A legal hold is placed and lifted by the tenant. The platform does not stop an erasure that a tenant carries out.","group":"Privacy","decided":"2026-11-18","ref":"D-521"},
    {"id":"d-522","title":"The journal covers the restore window, thirty days by default","statement":"**The journal covers the restore window, thirty days by default.** The event journal reaches back as far as the restore window the tenant chose, thirty days unless changed, and a snapshot carrying the state hash stands at the start of the window.","group":"Privacy","decided":"2026-11-18","ref":"D-522"},
    {"id":"d-523","title":"One mail provider account, the platform's","statement":"**One mail provider account, the platform's.** Mail leaves through the platform's account with its provider, which is Amazon Simple Email Service in the first cloud profile. A tenant sends from its own proved domain (EML-013) and does not bring a provider account at launch.","group":"Platform","decided":"2026-11-18","ref":"D-523"},
    {"id":"d-524","title":"A content token takes no arguments","statement":"**A content token takes no arguments.** A token is a name and an expression. Formatting follows the language of the reader (CTK-013). A variation is a second token.","group":"Content","decided":"2026-11-18","ref":"D-524"},
    {"id":"d-525","title":"A tenant can turn passwords off","statement":"**A tenant can turn passwords off.** A realm policy can allow only passkeys and federation. It is accepted only while every owner of the tenant has another sign-in method and a recovery path.","group":"Identity","decided":"2026-11-18","ref":"D-525"},
    {"id":"d-526","title":"One automation worker runs schedules and workflows","statement":"**One automation worker runs schedules and workflows.** The scheduler and the workflow engine are one component, the automation worker. A workflow step is a job, so one lease path and one retry path serve both.","group":"Automation","decided":"2026-11-18","ref":"D-526"},
    {"id":"d-527","title":"Tenant audit entries live in the tenant database, platform entries in the control database","statement":"**Tenant audit entries live in the tenant database, platform entries in the control database.** The audit log of a tenant is part of that tenant and leaves with it. Entries about the platform itself, which name no tenant content, are held in the control database. Both are hash-chained (D-20).","group":"Observability","decided":"2026-11-18","ref":"D-527"},
    {"id":"d-528","title":"A directory entry is served for fifteen minutes through a control plane outage","statement":"**A directory entry is served for fifteen minutes through a control plane outage.** While the control plane cannot be reached, the gateway and the runtime answer reads from the directory entries they hold for up to fifteen minutes (ARC-500), and refuse changes (ARC-100).","group":"Tenancy","decided":"2026-11-18","ref":"D-528"},
    {"id":"d-529","title":"Outbox publication is one job per tenant","statement":"**Outbox publication is one job per tenant.** Committed events of a tenant are published by one job that takes them in order, not by a job per transaction.","group":"Automation","decided":"2026-11-18","ref":"D-529"},
    {"id":"d-530","title":"People operate the platform until the last release stage","statement":"**People operate the platform until the last release stage.** Agents that deploy, migrate or change infrastructure are not admitted before R4. When they are, they come through an operations gateway of their own that reaches the control plane and no tenant content (AGS-426).","group":"Agents","decided":"2026-11-18","ref":"D-530"},
    {"id":"d-531","title":"Agent limits have platform defaults and floors","statement":"**Agent limits have platform defaults and floors.** Every budget, delay window and undo window of an agent has a default set by the platform. A tenant can tighten a limit, and can loosen it only down to the floor the platform sets.","group":"Agents","decided":"2026-11-18","ref":"D-531"},
    {"id":"d-532","title":"Data handed to an agent carries one of three trust levels","statement":"**Data handed to an agent carries one of three trust levels.** Platform: written by the platform. Tenant-authored: written by a principal of the tenant. External: anything that arrived from outside, such as a webhook body, a fetched page or a received email.","group":"Agents","decided":"2026-11-18","ref":"D-532"},
    {"id":"d-533","title":"Verification status is readable by tenant owners and platform operators","statement":"**Verification status is readable by tenant owners and platform operators.** The requirements of this specification are readable by any principal. Their verification status is readable by owners of a tenant and by platform operators (AGT-414).","group":"Agents","decided":"2026-11-18","ref":"D-533"},
    {"id":"d-534","title":"The adversarial corpus runs in the gate","statement":"**The adversarial corpus runs in the gate.** The cases of the agent safety corpus (AGS-435) are run by the gate once the agent plane exists, like every other conformance table.","group":"Agents","decided":"2026-11-18","ref":"D-534"},
    {"id":"d-535","title":"Throttle thresholds are realm defaults set by the platform","statement":"**Throttle thresholds are realm defaults set by the platform.** The thresholds and windows of the three throttles (D-252) are defaults held as data, which a realm can tighten. The platform-wide counter holds a hash of the source address and no tenant content, so it does not cross the isolation rule (K-2).","group":"Identity","decided":"2026-11-18","ref":"D-535"},
    {"id":"d-536","title":"The session cookie takes a host-only name with the next gateway work","statement":"**The session cookie takes a host-only name with the next gateway work.** The cookie is renamed with the host prefix when the identity service of the third milestone is built (IDN-262). The prototype keeps its current name until then.","group":"Identity","decided":"2026-11-18","ref":"D-536"},
    {"id":"d-537","title":"Access tokens live five minutes","statement":"**Access tokens live five minutes.** An access token is valid for five minutes (TOK-005), and revoking its grant is also announced to the gateways, so a cut-off does not wait for the lifetime.","group":"Identity","decided":"2026-11-18","ref":"D-537"},
    {"id":"d-538","title":"Scope of the first product release","statement":"**Scope of the first product release.** Milestone six stays whole. A sandbox tenant is self-serve. A delivery key is a service account. Search waits for the last release stage. Promotion from staging to production waits for the proposal flow of the seventh milestone, and carries configuration and no content.","group":"Content","decided":"2026-11-18","ref":"D-538"},
    {"id":"d-539","title":"Audit entries and consent evidence are kept for one year by default","statement":"**Audit entries and consent evidence are kept for one year by default.** A tenant can lengthen the period. Client addresses in edge logs are truncated (PRV-363).","group":"Privacy","decided":"2026-11-18","ref":"D-539"},
    {"id":"d-550","title":"Images are addressed by digest and promoted, and rebuilt in no environment","statement":"**Images are addressed by digest and promoted, and rebuilt in no environment.** Each component image is addressed by its content digest. The image that the gate tested in stage is the image production runs. No environment rebuilds an image, because a second build is a second program that nobody tested.","group":"Platform","decided":"2026-11-18","ref":"D-550"},
    {"id":"d-551","title":"Stage and production are platform environments, not staging tenants","statement":"**Stage and production are platform environments, not staging tenants.** The stage environment and the production environment are the platform's own environments, made from the same definitions. They are not tenants. A staging tenant remains a tenant of a production tenant (ADM-157).","group":"Platform","decided":"2026-11-18","ref":"D-551"},
    {"id":"d-552","title":"No ephemeral review environments at launch","statement":"**No ephemeral review environments at launch.** There is one stage environment and one production environment in the cloud profile, and the local stack for development. A review environment per branch adds a third place that holds the platform and needs its own care, and no requirement is met by it that the stage environment does not meet.","group":"Platform","decided":"2026-11-18","ref":"D-552"},
    {"id":"d-553","title":"Stage and production share region and zones, and differ in accounts, networks, keys, databases and realms","statement":"**Stage and production share region and zones, and differ in accounts, networks, keys, databases and realms.** The two environments run in the same region and the same three zones, so that latency, zone behaviour and managed service versions match. They use separate cloud accounts, networks, key service keys, databases and identity realms (REL-556). The parity table states each allowed difference.","group":"Platform","decided":"2026-11-18","ref":"D-553"},
    {"id":"d-554","title":"The standard path includes a canary share before the full colour switch","statement":"**The standard path includes a canary share before the full colour switch.** A colour switch first sends a small share of public requests to the new colour for a stated period, then the full share. The canary is the cheapest evidence that the new colour works under real traffic before every reader reaches it.","group":"Platform","decided":"2026-11-18","ref":"D-554"},
    {"id":"d-555","title":"Automatic switch back on the criteria of OPS-327, and a manual switch back is one operation","statement":"**Automatic switch back on the criteria of OPS-327, and a manual switch back is one operation.** A breached criterion of the release record switches traffic back by itself (OPS-327). An operator who decides to switch back does so with one operation of the release controller that deploys nothing (REL-568).","group":"Platform","decided":"2026-11-18","ref":"D-555"},
    {"id":"d-556","title":"Blue and green for production, with the previous colour warm for 24 hours","statement":"**Blue and green for production, with the previous colour warm for 24 hours.** Production runs two complete colours of each component, one live and one warm. The warm colour keeps its instances running for the window of its release record, which is at least 24 hours (REL-569). A rolling update is not used for production, because it leaves no complete previous version to return to.","group":"Platform","decided":"2026-11-18","ref":"D-556"},
    {"id":"d-557","title":"Shared state is not duplicated between colours, and a colour writes only what the other colour reads","statement":"**Shared state is not duplicated between colours, and a colour writes only what the other colour reads.** Tenant databases, the control database, the copy store, the file store and the notice queue are shared by both colours (REL-572). The rule that keeps both colours readable is expand and contract (OPS-324), and a stored copy carries the release that computed it (REL-573).","group":"Platform","decided":"2026-11-18","ref":"D-557"},
    {"id":"d-558","title":"Long-lived streams close with a notice and resume by sequence number, with no sticky sessions","statement":"**Long-lived streams close with a notice and resume by sequence number, with no sticky sessions.** An event stream or a streamed reply on a withdrawn colour is closed with a notice that names its last sequence number, and the client resumes on the live colour. The traffic switch keeps no session affinity, so no session is pinned to a colour.","group":"Platform","decided":"2026-11-18","ref":"D-558"},
    {"id":"d-559","title":"Control plane lifecycle operations run in one active instance, elected through the control database","statement":"**Control plane lifecycle operations run in one active instance, elected through the control database.** Creating, moving and deleting tenants is done by one active instance of the control plane at a time, so that two colours cannot provision the same tenant twice. Reads of the directory run in every instance (D-100).","group":"Platform","decided":"2026-11-18","ref":"D-559"},
    {"id":"d-560","title":"The gateway and the identity service are stateless, so sessions survive a colour switch","statement":"**The gateway and the identity service are stateless, so sessions survive a colour switch.** Sessions live in the tenant databases and the gateway holds only copies with a bound (K-5). Both colours verify the same sessions and tokens, so a colour switch ends no sign-in (REL-579).","group":"Identity","decided":"2026-11-18","ref":"D-560"},
    {"id":"d-561","title":"The automation worker of both colours shares one wake index, and leases with fencing tokens hold one job at a time","statement":"**The automation worker of both colours shares one wake index, and leases with fencing tokens hold one job at a time.** Both colours read the wake index and lease jobs from the tenant databases (D-10, D-11). A withdrawn colour finishes or releases its leases before it stops (REL-570), so no job is held by two workers that both record a result.","group":"Automation","decided":"2026-11-18","ref":"D-561"},
    {"id":"d-562","title":"The emergency path is the same pipeline and the same gates, with a shortened soak of at least one hour","statement":"**The emergency path is the same pipeline and the same gates, with a shortened soak of at least one hour.** A hotfix passes every gate of the promotion path. Its stage soak is shortened to a stated minimum of one hour, and it needs the same two approvals as any production release (REL-564).","group":"Platform","decided":"2026-11-18","ref":"D-562"},
    {"id":"d-563","title":"Freeze windows are declared by a platform owner and enforced by the release controller","statement":"**Freeze windows are declared by a platform owner and enforced by the release controller.** A platform owner declares a freeze window in the release controller. Releases inside the window are refused, except a hotfix that the freeze names (REL-563). A freeze binds people and agents alike.","group":"Platform","decided":"2026-11-18","ref":"D-563"},
    {"id":"d-564","title":"Two approvals from distinct principals, neither the author, and no agent among them","statement":"**Two approvals from distinct principals, neither the author, and no agent among them.** The separation rule of AGS-409 and the two-principal rule of AGS-426 apply to every production release, and D-530 keeps agents out of the approvals before the last release stage. So a production release carries two approvals from two people, neither of whom wrote the change (REL-560).","group":"Platform","decided":"2026-11-18","ref":"D-564"},
    {"id":"d-565","title":"Release records and environment records are held in the control database, written through the control plane","statement":"**Release records and environment records are held in the control database, written through the control plane.** Release and environment records hold identifiers, digests and principal identifiers, and no tenant content. The control plane writes them, so the control database keeps the single writer it already has (K-2, ARC-110).","group":"Platform","decided":"2026-11-18","ref":"D-565"},
    {"id":"d-566","title":"Drift is reported and not silently corrected","statement":"**Drift is reported and not silently corrected.** When the definitions of an environment and what runs in it differ, the release controller reports the difference (REL-562). A person or an approved release brings them together, so that the record of what was changed stays complete.","group":"Platform","decided":"2026-11-18","ref":"D-566"},
    {"id":"d-567","title":"Production changes only through release records or audited operations","statement":"**Production changes only through release records or audited operations.** A change to production is a release, or an operation of the catalogue that is audited. No one changes production by hand (REL-561), so every change of production has a record with its approval.","group":"Platform","decided":"2026-11-18","ref":"D-567"},
    {"id":"d-568","title":"Migrations run as jobs of the automation worker, with no separate migration service","statement":"**Migrations run as jobs of the automation worker, with no separate migration service.** A migration run is a job with a lease, a cursor and a retry (D-10, D-11). The automation worker already carries those properties, so a second service that does the same work would add a second lease path.","group":"Tenancy","decided":"2026-11-18","ref":"D-568"},
    {"id":"d-569","title":"A schema change applies in one transition up to a record limit, and as a migration run above it","statement":"**A schema change applies in one transition up to a record limit, and as a migration run above it.** A change of at most 10000 records of one type applies in one transition (MIG-551), so the tenant never shows a partly changed state. A larger change runs in batches, and a reader sees each record in its prior form or its migrated form (MIG-552).","group":"Tenancy","decided":"2026-11-18","ref":"D-569"},
    {"id":"d-570","title":"Lossless type conversions apply, and the others apply only with a declared transformation","statement":"**Lossless type conversions apply, and the others apply only with a declared transformation.** The conversion table lists which pairs of field types convert without loss. A pair that loses information applies only with a transformation that the schema change declares, and where none is declared the change is refused (MIG-558).","group":"Tenancy","decided":"2026-11-18","ref":"D-570"},
    {"id":"d-571","title":"Every schema change is previewed on a copy, and an irreversible change is marked in its preview","statement":"**Every schema change is previewed on a copy, and an irreversible change is marked in its preview.** The preview runs the change against a copy of the tenant, so the owner sees what the change does to real records before it applies (MIG-550). A change that removes a field or a constraint is marked irreversible (MIG-557).","group":"Tenancy","decided":"2026-11-18","ref":"D-571"},
    {"id":"d-572","title":"A failed migration run leaves the tenant as it was, and a partly applied batch is not visible","statement":"**A failed migration run leaves the tenant as it was, and a partly applied batch is not visible.** A run commits each batch with its cursor. A failed run stops with the tenant in the form it had before the run, with the failure named in its record (MIG-555), and no reader sees a batch that did not commit (MIG-552).","group":"Tenancy","decided":"2026-11-18","ref":"D-572"},
    {"id":"d-573","title":"Strict is the default mode of a schema change, and grandfather mode lists the records that no longer conform","statement":"**Strict is the default mode of a schema change, and grandfather mode lists the records that no longer conform.** Strict mode refuses a change that would leave a record out of line (KRN-009). Grandfather mode applies the change and lists the non-conforming records in its evidence (KRN-010). The owner chooses the mode in the preview, and strict is the default.","group":"Tenancy","decided":"2026-11-18","ref":"D-573"},
    {"id":"d-574","title":"A changed delivery shape keeps the old shape for at least 90 days","statement":"**A changed delivery shape keeps the old shape for at least 90 days.** Integrators get a minimum window of 90 days, or the longer window that the notice states, in which the old shape is served (CMS-170). After the window the old shape is removed (NG-556).","group":"Delivery","decided":"2026-11-18","ref":"D-574"},
    {"id":"d-575","title":"A migration applied to a staging tenant is run again in its production tenant against production data","statement":"**A migration applied to a staging tenant is run again in its production tenant against production data.** A staging tenant is used to prepare a change, not to carry data. The production tenant runs the same migration as a migration run with its own preview, so the change is checked against the data it will change (MIG-567).","group":"Platform","decided":"2026-11-18","ref":"D-575"},
    {"id":"d-576","title":"A tenant move has a read-only window of at most 60 seconds, verified by state hash, and keeps its source until verified","statement":"**A tenant move has a read-only window of at most 60 seconds, verified by state hash, and keeps its source until verified.** The window is the final synchronisation of a move. The target state hash must equal the source hash before the directory switches (MIG-570), and a failed copy leaves the source serving (MIG-571). The source is kept for at least 7 days after the switch (MIG-572).","group":"Tenancy","decided":"2026-11-18","ref":"D-576"},
    {"id":"d-577","title":"Layout changes reach tenants in waves, and a tenant that lags holds the release back while it keeps serving","statement":"**Layout changes reach tenants in waves, and a tenant that lags holds the release back while it keeps serving.** A layout change runs in waves that can stop (OPS-323). A tenant whose change fails stays on its previous layout and keeps serving (MIG-565). The contracting phase of the release waits for every tenant (OPS-324).","group":"Data safety","decided":"2026-11-18","ref":"D-577"},
    {"id":"d-578","title":"An upgrade of an installed template is a proposal, and it is never applied automatically","statement":"**An upgrade of an installed template is a proposal, and it is never applied automatically.** A platform template or integration that a tenant installed changes only when the tenant approves the projection of the upgrade (MIG-564). The platform does not apply an upgrade to a tenant's records by itself.","group":"Platform","decided":"2026-11-18","ref":"D-578"},
    {"id":"d-579","title":"A point-in-time restore reports the window of committed changes that it did not restore","statement":"**A point-in-time restore reports the window of committed changes that it did not restore.** A restore names the first and the last change it does not carry (MIG-573). The journal keeps the window the tenant chose (D-522), so the report names what the tenant can recover by other means.","group":"Data safety","decided":"2026-11-18","ref":"D-579"},
    {"id":"d-580","title":"A tenant is served by a newer kernel version only after its journal replays under that version","statement":"**A tenant is served by a newer kernel version only after its journal replays under that version.** Before a tenant changes kernel version, its journal replays under the new version to the state hash the journal records (MIG-566). The check is the same one that restore uses (TEN-015).","group":"Tenancy","decided":"2026-11-18","ref":"D-580"},
    {"id":"d-700","ref":"D-700","title":"Platform defaults for throttles, retries, sessions and recovery","group":"Platform","decided":"2026-11-18","statement":"**Platform defaults for throttles, retries, sessions and recovery.** Password attempts are refused for an account after ten failed attempts and for a source after one hundred failed attempts within fifteen minutes, and the attempts across one realm are slowed to one a second once the realm passes one thousand failures within fifteen minutes. A one-time code is spent after five failed presentations. A realm sends at most five second-factor prompts to one account in an hour, issues at most five sign-in links to one address and twenty to one browser in an hour, and accepts at most twenty sign-up requests from one source in an hour. The token endpoint accepts at most thirty credential requests from one client in a minute. A session ends twelve hours after it was last used or fourteen days after sign-in, whichever comes first. Account recovery notifies the contacts of the account and completes after a delay of twenty-four hours. A component that sees its retries to one dependency exceed ten percent of its first attempts within sixty seconds makes no retry to that dependency for sixty seconds, and it stops calling a dependency for thirty seconds after five consecutive failures. After a restart, refills of stored copies are released at one hundred requests a second per cluster. Synthetic probes run every minute. A layout change stops when more than five percent of the tenants of one wave fail. A fresh authentication is one made within the step-up age of fifteen minutes. The hop limit of a trigger chain is eight events, and the job admission rate of a tenant is one hundred jobs a minute unless the tenant sets another. A realm may tighten any of these defaults (D-535)."},
    {"id":"d-701","ref":"D-701","title":"The tenant export is the owner's archive","group":"Tenancy","decided":"2026-11-18","statement":"**The tenant export is the owner's archive.** The export of a tenant (TEN-010) and the archive that a tenant owner receives (ADM-161) are one artifact: the archive, with the documented formats and the manifest of ADM-162, from which the tenant restores to the canonical hash of its state."},
    {"id":"d-702","ref":"D-702","title":"The outbound gate judges the addresses that tenants name","group":"Platform","decided":"2026-11-18","statement":"**The outbound gate judges the addresses that tenants name.** Every connection to an address that a tenant names, such as a webhook receiver, a connector endpoint, or the metadata, keys and token endpoint of a provider the tenant configured, leaves through the outbound gate (K-252). The platform's own fixed endpoints, the mail provider, the model provider, the content delivery network and the key service, are reached through their own adapters and are listed in the subprocessor register (PRV-373)."},
    {"id":"d-703","ref":"D-703","title":"An emailed sign-in link carries its token in the fragment","group":"Identity","decided":"2026-11-18","statement":"**An emailed sign-in link carries its token in the fragment of its address.** A browser does not send a fragment to the platform, so the token appears in no request address, referrer or query string (K-250). The page that the link opens sends the token in the body of a request to the sign-in link endpoint (IDN-003)."},
    {"id":"d-704","ref":"D-704","title":"A network context is kept as a keyed hash","group":"Identity","decided":"2026-11-18","statement":"**A network context is kept as a keyed hash.** A realm rule that compares the network context of a session (IDN-260) keeps only a keyed hash of that context in the session record, so the record holds no network address in clear form (PRV-364)."},
    {"id":"d-705","ref":"D-705","title":"Deletion grace is fourteen days and a sandbox lasts thirty days","group":"Tenancy","decided":"2026-11-18","statement":"**Deletion grace is fourteen days and a sandbox lasts thirty days.** An owner can cancel the deletion of a tenant for fourteen days after requesting it, and a sandbox that its owner does not keep is deleted thirty days after it was started. The plan states both periods (BIL-150)."},
    {"id":"d-28","title":"Rust for components, vanilla JavaScript in the browser","statement":"**Rust for components, vanilla JavaScript in the browser.** Platform components are written in Rust. Browser code stays framework-free JavaScript run by a kernel in a worker.","group":"Platform","decided":"2026-11-18","ref":"D-28"},
    {"id":"d-706","ref":"D-706","title":"Backup images are kept for thirty-five days","group":"Privacy","decided":"2026-11-18","statement":"**Backup images are kept for thirty-five days.** A backup image of a tenant database or of the control database is removed thirty-five days after it was taken. A tenant policy may shorten the period and the platform allows none longer, so the erasure bound of a backup image is thirty-five days at most (D-351, PRV-700)."},
    {"id":"d-707","ref":"D-707","title":"The platform audit store and the migration job are apart from tenant data","group":"Platform","decided":"2026-11-18","statement":"**The platform audit store and the migration job are apart from tenant data.** The operations of the platform itself are recorded in a platform audit store that holds no tenant data and is apart from every tenant database, and entries are kept seven years. A tenant migration run is a job of a component of its own, the migration job, which the release controller starts. The controller holds no access to tenant data: it writes the platform audit store and instructs the traffic switch, and the control plane and the migration job hold the access that provisioning and migration need."},
    {"id":"d-708","ref":"D-708","title":"Retention bounds and the notice of a breach","group":"Privacy","decided":"2026-11-18","statement":"**Retention bounds and the notice of a breach.** The retention rule of a record type may set a period from thirty days to ten years, and a record type with no tenant rule keeps the period that its class states. The platform reports a breach of personal data to the tenant owner within twenty-four hours of confirming it, and a tenant policy may shorten that notice period and may not extend it beyond forty-eight hours."},
    {"id":"d-709","ref":"D-709","title":"Windows and depth of agent safety","group":"Agents","decided":"2026-11-18","statement":"**Windows and depth of agent safety.** An irreversible operation of an agent takes effect after a delay window of twenty-four hours unless a person approved it, and a tenant may set a window from one hour to seven days. A declared reversal of an applied agent change is available for seven days, and a tenant may set an undo window from one hour to thirty days. A chain of events that starts the same agent again is stopped at a loop depth of five, and a tenant may set a depth from one to the hop limit of D-700."},
    {"id":"d-710","ref":"D-710","title":"Calls between platform components form no cycle","group":"Platform","decided":"2026-11-18","statement":"**Calls between platform components form no cycle.** A component of the platform calls only components below it: the edge calls the gateways, the gateways call the runtime and the control plane, and those call the stores and the outward services. A provider that the platform both receives requests from and instructs is modelled as two components, its request path and its control interface. The content delivery network is the first case: readers reach the platform through the network, and the runtime and the control plane instruct it through its control interface, which calls nothing of the platform."}
  ],
  "constraints": [
    {"id":"k-1","statement":"The kernel performs no input or output and reads no clock and no source of randomness.","group":"Kernel","ref":"K-1"},
    {"id":"k-2","statement":"Tenant content is stored only in that tenant's database and file namespace. The control database holds no tenant content.","group":"Tenancy","ref":"K-2"},
    {"id":"k-3","statement":"A component reaches a tenant database only through the store contract (B-2).","group":"Tenancy","ref":"K-3"},
    {"id":"k-4","statement":"Passwords, session secrets, tokens and one-time codes are handled only by the identity service and appear in no log.","group":"Identity","ref":"K-4"},
    {"id":"k-5","statement":"A network-facing component keeps no state between requests that another instance could not serve from.","group":"Platform","ref":"K-5"},
    {"id":"k-6","statement":"A browser reaches only the gateway and the content delivery network, and calls between components carry a credential issued to the calling component.","group":"Platform","ref":"K-6"},
    {"id":"k-7","statement":"No shared copy holds personal data or anything that depends on who is asking.","group":"Delivery","ref":"K-7"},
    {"id":"k-8","statement":"Every stored copy has a stated owner, key, freshness bound and erasure point.","group":"Delivery","ref":"K-8"},
    {"id":"k-9","statement":"Every external effect is described as data by the kernel and carried out by an adapter after the transaction that produced it commits.","group":"Kernel","ref":"K-9"},
    {"id":"k-10","statement":"Every infrastructure dependency has an adapter that runs in a container without a cloud account.","group":"Platform","ref":"K-10"},
    {"id":"k-11","statement":"Time and randomness enter decisions as explicit inputs, so every decision can be simulated and replayed.","group":"Kernel","ref":"K-11"},
    {"id":"k-12","statement":"Tenant-authored content cannot inject script, markup or style into a page.","group":"Content","ref":"K-12"},
    {"id":"k-13","statement":"An agent is authorised by the same policies as a person, through the same kernel decision.","group":"Agents","ref":"K-13"},
    {"id":"k-14","statement":"Where a standard protocol exists the platform uses it: OAuth 2.1 and OpenID Connect, SAML 2.0, SCIM 2.0, WebAuthn, the OpenTelemetry protocol, the Model Context Protocol.","group":"Platform","ref":"K-14"},
    {"id":"k-15","statement":"No requirement counts as met without a recorded passing proof.","group":"Assurance","ref":"K-15"},
    {"id":"k-16","statement":"A session secret is an opaque random value, held by the browser in an HttpOnly cookie and by the platform only as a hash.","group":"Identity","ref":"K-16"},
    {"id":"k-100","statement":"A decision loads only the records that its plan names.","group":"Kernel","ref":"K-100"},
    {"id":"k-200","statement":"Tenant content leaves the platform only in a model request that the tenant policy permits, to the model provider the platform offers, and only where the tenant's subprocessor list names that provider.","group":"Platform","ref":"K-200"},
    {"id":"k-250","statement":"Credentials, session secrets, tokens and one-time codes appear in no address, referrer or query string, except that an emailed sign-in link carries its single-use token in the fragment of its address (D-703).","group":"Identity","ref":"K-250"},
    {"id":"k-251","statement":"Tenant files and tenant templates are data, and no platform process runs them.","group":"Content","ref":"K-251"},
    {"id":"k-252","statement":"Every outbound connection of the platform to an address that a tenant names leaves through one gate that applies the outbound rule (D-702).","group":"Platform","ref":"K-252"},
    {"id":"k-300","statement":"Overload is refused at the boundary where it arrives, before the work is queued for a shared resource.","group":"Platform","ref":"K-300"},
    {"id":"k-301","statement":"Two versions of a component run together during every rollout.","group":"Change","ref":"K-301"},
    {"id":"k-302","statement":"An irreversible operation names the object it destroys in its request.","group":"Data safety","ref":"K-302"},
    {"id":"k-350","statement":"Personal data is held only in a record or a copy that declares its owner, its personal fields, its retention and its erasure point.","group":"Privacy","ref":"K-350"},
    {"id":"k-351","statement":"Personal data reaches a log, a metric, a trace, a backup, an export, a mail or a file only through a declared record or copy.","group":"Privacy","ref":"K-351"},
    {"id":"k-352","statement":"A personal field is sealed under the key of its subject, and that key is destroyed when the subject is erased.","group":"Privacy","ref":"K-352"},
    {"id":"k-400","statement":"Data that the platform returns to an agent is marked with the origin and the trust level of each text it contains.","group":"Agents","ref":"K-400"},
    {"id":"k-401","statement":"A platform-operating agent holds no grant that reads tenant content.","group":"Agents","ref":"K-401"},
    {"id":"k-402","statement":"The record of agent activity is written by the platform, and an agent cannot alter the entries that describe its own activity.","group":"Agents","ref":"K-402"},
    {"id":"k-450","statement":"A token value enters a page or a message in the form of its output context, as text.","group":"Content","ref":"K-450"},
    {"id":"k-451","statement":"The mail dispatcher is the one component that talks to a mail provider.","group":"Platform","ref":"K-451"},
    {"id":"k-550","statement":"A change to a stored layout or a stored format SHALL reach production in a release of its own, separate from any colour switch.","group":"Platform","ref":"K-550"},
    {"id":"k-551","statement":"The kernel decides each step of a migration run, and each step commits together with the cursor that records it.","group":"Tenancy","ref":"K-551"},
    {"id":"k-17","statement":"A lease on work carries a fencing token that the tenant database checks when the work is recorded.","group":"Automation","ref":"K-17"}
  ],
  "openQuestions": [
  ],

  // ---- Roadmap -----------------------------------------------------------------------------------
  "releaseStages": [
    {"id":"r0","name":"Foundation","purpose":"The specification gates the code, and a tenant is a database behind clean seams, running locally in containers","milestones":"1, 2","exitEvidence":"Every goal tagged R0 verified. Both tools pass on every commit of the main line.","ref":"R0"},
    {"id":"r1","name":"Identity","purpose":"The identity service carries every sign-in method, sessions, tokens and audit","milestones":"3, 4","exitEvidence":"Every goal tagged R1 verified, with the behaviour models of sign-in checked in Exegra and a security review of the federation endpoints.","ref":"R1"},
    {"id":"r2","name":"Automation and delivery","purpose":"Tenants schedule work, are notified and approve content, and a first site is authored, reviewed and served from stored copies and the edge","milestones":"5, 6","exitEvidence":"Every goal tagged R2 verified, with the freshness and start budgets measured on the local stack, and a first site taken through authoring, review, preview and delivery there.","ref":"R2"},
    {"id":"r3","name":"Agent operation","purpose":"Agents observe, explain, propose and apply changes under policy, with a tamper-evident record","milestones":"7, 8, 9","exitEvidence":"Every goal tagged R3 verified, including an agent carrying out a schema change through a proposal end to end.","ref":"R3"},
    {"id":"r4","name":"Enterprise readiness","purpose":"The content features are complete and the platform is deployed and recovered in the cloud","milestones":"10, 11, 12","exitEvidence":"Every goal tagged R4 verified, with a zone-loss drill and a tenant point-in-time restore measured against their objectives.","ref":"R4"}
  ],
  "milestones": [
    {"id":"rm-1","name":"Gate","number":1,"proves":"the specification and the two tools hold the code that already exists to account.","stage":"R0","stageRef":"r0","detail":"**Proves:** the specification and the two tools hold the code that already exists to account.\n\nThe requirements of the prototype's kernel, store, runtime, gateway and simulator are written, each tied to an existing test, and Concordance reports them verified from a recorded run. Exegra validates the specification and its structural, data and behaviour claims.","ref":"RM-1"},
    {"id":"rm-2","name":"Tenant databases and seams","number":2,"proves":"a tenant is a PostgreSQL database behind the store contract, found through a directory, in a local container stack.","stage":"R0","stageRef":"r0","detail":"**Proves:** a tenant is a PostgreSQL database behind the store contract, found through a directory, in a local container stack.\n\nThe PostgreSQL adapter passes the conformance suite. The control plane provisions, suspends, exports and deletes tenants. Every other seam (files, copies, wake, keys, mail, limits, backup) has its trait, suite and local adapter. Each tenant database is backed up to the backup archive, and each tenant has a data key held by the key service. Component-to-component credentials replace the shared service token. Tenants have a kind (production, staging or sandbox), and a tenant can be archived, exported and deleted after a grace period.","ref":"RM-2"},
    {"id":"rm-3","name":"Identity core","number":3,"proves":"sign-in, sessions and their revocation live in one service with an audit record.","stage":"R1","stageRef":"r1","detail":"**Proves:** sign-in, sessions and their revocation live in one service with an audit record.\n\nRealms per tenant, passwords, passkeys, emailed links, second factors, step-up, recovery, session listing and revocation. Sign-in code is removed from the runtime. Roles and teams, invitations and sandbox tenants started from a template.","ref":"RM-3"},
    {"id":"rm-4","name":"Federation and tokens","number":4,"proves":"organisations bring their identity providers, and services and agents get identities.","stage":"R1","stageRef":"r1","detail":"**Proves:** organisations bring their identity providers, and services and agents get identities.\n\nOpenID Connect and SAML sign-in, SCIM provisioning, domains bound to a provider, service accounts, delegated tokens for agents, key rotation. Support grants that a tenant owner issues to platform operators, with every act recorded.","ref":"RM-4"},
    {"id":"rm-5","name":"Scheduling and workflows","number":5,"proves":"tenants schedule work that survives failure and applies effects once.","stage":"R2","stageRef":"r2","detail":"**Proves:** tenants schedule work that survives failure and applies effects once.\n\nJobs, schedules, triggers, leases with fencing, retries, the wake index, workflows as metadata, the connector runner, scheduled publication. Notices and the inbox, inbound and outbound webhooks, bulk jobs, and the trigger and action catalogue.","ref":"RM-5"},
    {"id":"rm-6","name":"Copies, the edge and the first site","number":6,"proves":"published content is served from stored copies with bounded staleness and no leakage.","stage":"R2","stageRef":"r2","detail":"**Proves:** published content is served from stored copies with bounded staleness and no leakage.\n\nVersion-keyed view copies, audience classes, tags and removal, the content delivery network contract, purge from the outbox, custom domains and certificates. Authoring of records of tenant-defined content types, named content tokens, review by named approvers, preview links, redirects, sitemaps and feeds, the delivery interface with field selection, paging and filtering, delivery keys, plan quotas and metering with the billing export.","ref":"RM-6"},
    {"id":"rm-7","name":"Agent plane","number":7,"proves":"agents operate the platform through the catalogue, under policy, on the record.","stage":"R3","stageRef":"r3","detail":"**Proves:** agents operate the platform through the catalogue, under policy, on the record.\n\nThe operation catalogue, queries and operations over the platform, dry runs, proposals with projections and approvals, the Model Context Protocol server and self-description. Promotion of configuration from a staging tenant through a proposal, and installation of platform templates after a projection.","ref":"RM-7"},
    {"id":"rm-8","name":"Agent safety, telemetry and audit","number":8,"proves":"agents act within limits, every act is attributed to a principal, and the platform's telemetry and audit are complete.","stage":"R3","stageRef":"r3","detail":"**Proves:** agents act within limits, every act is attributed to a principal, and the platform's telemetry and audit are complete.\n\nTelemetry export and correlation, the hash-chained audit log, the status page, agent run traces, the registry and attestation, delegation and authority, blast-radius limits, the kill switch, platform-operating agents, untrusted text, data leaving the platform, concurrent and chained change, and evaluation.","ref":"RM-8"},
    {"id":"rm-9","name":"Conversation","number":9,"proves":"a person changes the platform by talking to an assistant that acts only through the operation catalogue, with the authority of that person.","stage":"R3","stageRef":"r3","detail":"**Proves:** a person changes the platform by talking to an assistant that acts only through the operation catalogue, with the authority of that person.\n\nOperations and authority, previews and confirmation, explanation and evidence, one interface, replies, streams and cancellation, records, retention and visibility, the model provider, accessibility, network and language, and untrusted content.","ref":"RM-9"},
    {"id":"rm-10","name":"Operations, privacy and threat controls","number":10,"proves":"the platform is operated and defended on its own evidence, and answers to its privacy duties.","stage":"R4","stageRef":"r4","detail":"**Proves:** the platform is operated and defended on its own evidence, and answers to its privacy duties.\n\nCapacity and fan-out, alerts, runbooks and diagnostics, objectives and budgets, data safety, reporting and backup, sealing and audit of personal data, access by platform staff, compliance evidence, incidents and disclosure, and the reach of the operator console.","ref":"RM-10"},
    {"id":"rm-11","name":"Content features","number":11,"proves":"the content model is complete for editorial work.","stage":"R4","stageRef":"r4","detail":"**Proves:** the content model is complete for editorial work.\n\nVersion history and restore, media with renditions, languages with fallback, preview, accessibility conformance of the authoring application. Search by audience, form submissions, import and export of records, and the review diff.","ref":"RM-11"},
    {"id":"rm-12","name":"Cloud profile","number":12,"proves":"the same images run in the cloud and recover from failure.","stage":"R4","stageRef":"r4","detail":"**Proves:** the same images run in the cloud and recover from failure.\n\nInfrastructure definitions, cloud adapters for every seam, deployments without refused requests, zone-loss and restore drills.","ref":"RM-12"}
  ],

  // ---- Requirements (kind "requirement") and the claims Exegra evaluates itself (m-...) ----------
  "claims": [
    {"id":"krn-001","kind":"requirement","statement":"For every snapshot, intent and context, two evaluations of the transition function SHALL return equal results.","rationale":"Replay, simulation and projection all rest on this.","evaluate":{"method":"property"},"ref":"KRN-001","area":"01-core","section":"Decisions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["k-11","g-5"],"milestone":1,"inSection":"sec-kernel-2","realisation":"checked"},
    {"id":"krn-002","kind":"requirement","statement":"An accepted transition SHALL produce a state delta addressed only to the tenant named in its context.","rationale":"Isolation starts at the decision: a delta for another tenant cannot be expressed.","evaluate":{"method":"property"},"ref":"KRN-002","area":"01-core","section":"Decisions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::World::step`","traces":["g-1","k-2"],"milestone":1,"inSection":"sec-kernel-2","realisation":"checked"},
    {"id":"krn-003","kind":"requirement","statement":"A transition requested by a principal that no policy authorises SHALL be rejected without a state delta.","rationale":"Authorisation is default deny and has no side door.","evaluate":{"method":"property"},"ref":"KRN-003","area":"01-core","section":"Decisions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["k-13","g-20"],"milestone":1,"inSection":"sec-kernel-2","realisation":"checked"},
    {"id":"krn-004","kind":"requirement","statement":"A read SHALL return only records that the policies of the requesting principal permit.","rationale":"Reads are filtered by the same decision that guards writes.","evaluate":{"method":"property"},"ref":"KRN-004","area":"01-core","section":"Decisions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::read`","traces":["g-20"],"milestone":1,"inSection":"sec-kernel-2","realisation":"checked"},
    {"id":"krn-005","kind":"requirement","statement":"A transition evaluated on a partial snapshot SHALL return the result of the complete snapshot or a rejection naming the state it lacks.","rationale":"A store may load only part of a tenant. A missing record must not turn into a wrong acceptance.","evaluate":{"method":"property"},"ref":"KRN-005","area":"01-core","section":"Decisions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::needs`","traces":["k-3","g-5"],"milestone":1,"inSection":"sec-kernel-2","realisation":"checked"},
    {"id":"krn-006","kind":"requirement","statement":"Each accepted transition SHALL advance the tenant revision by exactly one step.","rationale":"Revisions are the versions that stored copies and optimistic commits are keyed by.","evaluate":{"method":"property"},"ref":"KRN-006","area":"01-core","section":"Decisions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::apply_delta`","traces":["g-5"],"milestone":1,"inSection":"sec-kernel-2","realisation":"checked"},
    {"id":"krn-007","kind":"requirement","statement":"A rejected transition SHALL list the checks that failed.","rationale":"People and agents act on the reason, not on the fact of a refusal.","evaluate":{"method":"example"},"ref":"KRN-007","area":"01-core","section":"Decisions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::DomainError`","traces":["g-24","g-11"],"milestone":1,"inSection":"sec-kernel-2","realisation":"checked"},
    {"id":"krn-008","kind":"requirement","statement":"A change to a workflow field SHALL be rejected unless a declared workflow transition permits it.","rationale":"Workflows are data, and the kernel is what enforces them.","evaluate":{"method":"example"},"ref":"KRN-008","area":"01-core","section":"Decisions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["g-31"],"milestone":1,"inSection":"sec-kernel-2","realisation":"checked"},
    {"id":"krn-009","kind":"requirement","statement":"A schema change applied in strict mode SHALL be rejected while an existing record would not conform to the new schema.","rationale":"A strict change either leaves every record valid or does not happen.","evaluate":{"method":"example"},"ref":"KRN-009","area":"01-core","section":"Schema changes","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::plan_migration`","traces":["g-44","d-573"],"milestone":1,"inSection":"sec-kernel-3","realisation":"checked"},
    {"id":"krn-010","kind":"requirement","statement":"A schema change applied in grandfather mode SHALL be accepted with the non-conforming records listed in its evidence.","rationale":"The other honest option: accept, and say exactly what is now out of line.","evaluate":{"method":"example"},"ref":"KRN-010","area":"01-core","section":"Schema changes","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::plan_migration`","traces":["g-44"],"milestone":1,"inSection":"sec-kernel-3","realisation":"checked"},
    {"id":"krn-011","kind":"requirement","statement":"Every state accepted by the transition function without a grandfathered change SHALL satisfy every state invariant.","rationale":"This is the invariant the abstract model proves for its fragment, checked on the real kernel.","evaluate":{"method":"property"},"ref":"KRN-011","area":"01-core","section":"Schema changes","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_verification::invariants::check_world`","traces":["g-43"],"milestone":1,"inSection":"sec-kernel-3","realisation":"checked"},
    {"id":"krn-012","kind":"requirement","statement":"The kernel crate SHALL contain no reference to file, network, clock, randomness, environment or process facilities.","rationale":"Purity is what makes the kernel simulable. It is kept by a scan, not by intention.","evaluate":{"method":"example"},"ref":"KRN-012","area":"01-core","section":"Purity and proof","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel`","traces":["k-1"],"milestone":1,"inSection":"sec-kernel-4","realisation":"construction"},
    {"id":"krn-013","kind":"requirement","statement":"The step function of the abstract model SHALL leave every tenant other than the addressed one unchanged.","rationale":"Tenant isolation, machine-checked for the model.","evaluate":{"method":"proof"},"ref":"KRN-013","area":"01-core","section":"Purity and proof","lifecycle":"active","boundary":"b-1","boundaryDetail":"`Strata.step`","traces":["g-43"],"milestone":1,"inSection":"sec-kernel-4","realisation":"checked"},
    {"id":"krn-014","kind":"requirement","statement":"An accepted strict step of the abstract model SHALL preserve the well-formedness of every tenant.","rationale":"Invariant preservation, machine-checked for the model.","evaluate":{"method":"proof"},"ref":"KRN-014","area":"01-core","section":"Purity and proof","lifecycle":"active","boundary":"b-1","boundaryDetail":"`Strata.step`","traces":["g-43"],"milestone":1,"inSection":"sec-kernel-4","realisation":"checked"},
    {"id":"krn-015","kind":"requirement","statement":"A step of the abstract model requested by an unauthorised principal SHALL yield no new world.","rationale":"Authorisation, machine-checked for the model.","evaluate":{"method":"proof"},"ref":"KRN-015","area":"01-core","section":"Purity and proof","lifecycle":"active","boundary":"b-1","boundaryDetail":"`Strata.step`","traces":["g-43","k-13"],"milestone":1,"inSection":"sec-kernel-4","realisation":"checked"},
    {"id":"krn-016","kind":"requirement","statement":"The kernel and the abstract model SHALL produce identical outcomes for every scenario of the correspondence fixtures.","rationale":"The proofs are about the model. This is what ties the model to the code.","evaluate":{"method":"property"},"ref":"KRN-016","area":"01-core","section":"Purity and proof","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_verification::lean::kernel_output`","traces":["g-43"],"milestone":1,"inSection":"sec-kernel-4","realisation":"checked"},
    {"id":"sto-001","kind":"requirement","statement":"The memory adapter SHALL pass every check of the storage conformance table.","rationale":"The reference adapter states the contract in the simplest code.","evaluate":{"method":"conformance"},"ref":"STO-001","area":"01-core","section":"Adapters","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["g-38"],"milestone":1,"cases":["cases-storage-conformance"],"inSection":"sec-storage-2","realisation":"checked"},
    {"id":"sto-002","kind":"requirement","statement":"The SQLite adapter SHALL pass every check of the storage conformance table on a database file.","rationale":"The adapter used for single-process local work and for simulation.","evaluate":{"method":"conformance"},"ref":"STO-002","area":"01-core","section":"Adapters","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["g-38","g-36"],"milestone":1,"cases":["cases-storage-conformance"],"inSection":"sec-storage-2","realisation":"checked"},
    {"id":"sto-003","kind":"requirement","statement":"Data acknowledged by the SQLite adapter SHALL be readable after the database file is reopened.","rationale":"Durability is claimed by the adapter and checked.","evaluate":{"method":"example"},"ref":"STO-003","area":"01-core","section":"Adapters","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["g-39"],"milestone":1,"inSection":"sec-storage-2","realisation":"checked"},
    {"id":"sto-004","kind":"requirement","statement":"The PostgreSQL adapter SHALL pass every check of the storage conformance table against a database of one tenant.","rationale":"The production adapter is accepted on the same terms as the others.","evaluate":{"method":"conformance"},"ref":"STO-004","area":"01-core","section":"Adapters","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["g-38","g-1","d-1"],"milestone":2,"cases":["cases-storage-conformance"],"inSection":"sec-storage-2","realisation":"checked"},
    {"id":"sto-005","kind":"requirement","statement":"An adapter SHALL open a tenant database using only the placement that the tenant directory returns for that tenant.","rationale":"A move changes the placement and nothing else.","evaluate":{"method":"scenario"},"ref":"STO-005","area":"01-core","section":"Adapters","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["k-3","g-3"],"milestone":2,"inSection":"sec-storage-2","realisation":"checked"},
    {"id":"sto-006","kind":"requirement","statement":"The connections an adapter holds open for one tenant SHALL stay within that tenant's connection quota.","rationale":"A database per tenant makes connections the first shared resource to run out.","evaluate":{"method":"property"},"ref":"STO-006","area":"01-core","section":"Adapters","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["g-4"],"milestone":2,"inSection":"sec-storage-2","realisation":"checked"},
    {"id":"run-001","kind":"requirement","statement":"A subscriber SHALL receive a notice about a record only when the policies of its principal permit reading that record.","rationale":"Live updates go through the same read decision as queries.","evaluate":{"method":"scenario"},"ref":"RUN-001","area":"01-core","section":"Runtime","lifecycle":"active","boundary":"b-9","boundaryDetail":"`event stream`","traces":["g-20"],"milestone":1,"inSection":"sec-runtime-2","realisation":"checked"},
    {"id":"run-002","kind":"requirement","statement":"A session issued for one tenant SHALL carry no identity when presented at the address of another tenant.","rationale":"A session belongs to a realm, and a realm to a tenant.","evaluate":{"method":"scenario"},"ref":"RUN-002","area":"01-core","section":"Runtime","lifecycle":"active","boundary":"b-4","boundaryDetail":"`session`","traces":["g-20","k-2"],"milestone":1,"inSection":"sec-runtime-2","realisation":"checked"},
    {"id":"run-003","kind":"requirement","statement":"The runtime SHALL refuse any request, other than the health check, that lacks the service credential.","rationale":"Only platform components call the runtime.","evaluate":{"method":"scenario"},"ref":"RUN-003","area":"01-core","section":"Runtime","lifecycle":"active","boundary":"b-3","boundaryDetail":"`service credential`","traces":["k-6"],"milestone":1,"inSection":"sec-runtime-2","realisation":"checked"},
    {"id":"run-004","kind":"requirement","statement":"Installing the same tenant bundles into an empty store SHALL produce the same tenant state.","rationale":"Provisioning from a template is a deterministic sequence of kernel intents.","evaluate":{"method":"scenario"},"ref":"RUN-004","area":"01-core","section":"Runtime","lifecycle":"active","boundary":"b-21","boundaryDetail":"`tenant bundle`","traces":["k-11","g-2"],"milestone":1,"inSection":"sec-runtime-2","realisation":"checked"},
    {"id":"run-005","kind":"requirement","statement":"The runtime SHALL publish a domain event only after the transaction that produced it has committed.","rationale":"Subscribers, triggers and purges all act on events, so an event for a change that did not happen is a defect everywhere at once.","evaluate":{"method":"scenario"},"ref":"RUN-005","area":"01-core","section":"Runtime","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["k-9"],"milestone":2,"inSection":"sec-runtime-2","realisation":"checked"},
    {"id":"gwy-001","kind":"requirement","statement":"The gateway SHALL resolve the tenant of a request from its host name alone.","rationale":"Nothing a client sends in a header, a parameter or a body can name a tenant.","evaluate":{"method":"scenario"},"ref":"GWY-001","area":"01-core","section":"Gateway","lifecycle":"active","boundary":"b-9","boundaryDetail":"`Host`","traces":["g-20","d-6","d-27"],"milestone":1,"inSection":"sec-runtime-3","realisation":"checked"},
    {"id":"gwy-002","kind":"requirement","statement":"The gateway SHALL refuse a state-changing request that lacks the request token of its session.","rationale":"A cross-site request carries the cookie and not the token.","evaluate":{"method":"scenario"},"ref":"GWY-002","area":"01-core","section":"Gateway","lifecycle":"active","boundary":"b-9","boundaryDetail":"`x-csrf-token`","traces":["g-46"],"milestone":1,"inSection":"sec-runtime-3","realisation":"checked"},
    {"id":"gwy-003","kind":"requirement","statement":"The gateway SHALL set the session cookie with the HttpOnly and SameSite=Strict attributes.","rationale":"Page script cannot read the secret and other sites cannot send it.","evaluate":{"method":"scenario"},"ref":"GWY-003","area":"01-core","section":"Gateway","lifecycle":"active","boundary":"b-4","boundaryDetail":"`strata_sid`","traces":["k-16"],"milestone":1,"inSection":"sec-runtime-3","realisation":"checked"},
    {"id":"gwy-004","kind":"requirement","statement":"The gateway SHALL refuse a WebSocket upgrade whose origin is not an allowed origin.","rationale":"A socket opened from another site would carry the cookie.","evaluate":{"method":"scenario"},"ref":"GWY-004","area":"01-core","section":"Gateway","lifecycle":"active","boundary":"b-9","boundaryDetail":"`Origin`","traces":["g-46"],"milestone":1,"inSection":"sec-runtime-3","realisation":"checked"},
    {"id":"gwy-005","kind":"requirement","statement":"A page response SHALL carry a content security policy that allows no inline script.","rationale":"The second line of defence behind structured content.","evaluate":{"method":"example"},"ref":"GWY-005","area":"01-core","section":"Gateway","lifecycle":"active","boundary":"b-13","boundaryDetail":"`Content-Security-Policy`","traces":["k-12"],"milestone":1,"inSection":"sec-runtime-3","realisation":"checked"},
    {"id":"sim-001","kind":"requirement","statement":"Two runs of one scenario SHALL produce traces with equal hashes.","rationale":"A simulation that cannot be repeated proves nothing.","evaluate":{"method":"example"},"ref":"SIM-001","area":"01-core","section":"Simulator","lifecycle":"active","boundary":"b-20","boundaryDetail":"`strata_simulation::engine::run`","traces":["k-11","g-42"],"milestone":1,"inSection":"sec-runtime-4","realisation":"checked"},
    {"id":"sim-002","kind":"requirement","statement":"A projection of a change that alters no behaviour SHALL report no divergence.","rationale":"The comparison has no false positives on an empty change.","evaluate":{"method":"example"},"ref":"SIM-002","area":"01-core","section":"Simulator","lifecycle":"active","boundary":"b-20","boundaryDetail":"`strata_simulation::project::project`","traces":["g-44"],"milestone":1,"inSection":"sec-runtime-4","realisation":"checked"},
    {"id":"sim-003","kind":"requirement","statement":"A projection SHALL report the first scheduled operation whose outcome differs under the proposed change.","rationale":"The first divergence is the one certainly caused by the change.","evaluate":{"method":"example"},"ref":"SIM-003","area":"01-core","section":"Simulator","lifecycle":"active","boundary":"b-20","boundaryDetail":"`strata_simulation::project::project`","traces":["g-44","g-26"],"milestone":1,"inSection":"sec-runtime-4","realisation":"checked"},
    {"id":"sim-004","kind":"requirement","statement":"A replay of a tenant journal SHALL reproduce the recorded state delta of each entry.","rationale":"Production and simulation run the same kernel, and this is the check that they agree.","evaluate":{"method":"example"},"ref":"SIM-004","area":"01-core","section":"Simulator","lifecycle":"active","boundary":"b-20","boundaryDetail":"`strata_simulation::journal::replay_journal`","traces":["g-42","k-11"],"milestone":1,"inSection":"sec-runtime-4","realisation":"checked"},
    {"id":"ten-001","kind":"requirement","statement":"Provisioning a tenant SHALL create a database that holds the data of that tenant alone.","rationale":"The database is the isolation boundary.","evaluate":{"method":"scenario"},"ref":"TEN-001","area":"02-tenancy","section":"Provisioning","lifecycle":"active","boundary":"b-3","boundaryDetail":"`POST /tenants`","traces":["g-1"],"milestone":2,"inSection":"sec-tenancy-2","realisation":"checked"},
    {"id":"ten-002","kind":"requirement","statement":"The tenant directory SHALL report a tenant as active only after its database layout and its template have been installed.","rationale":"Active means usable. Modelled as the provisioning flow.","evaluate":{"method":"scenario"},"ref":"TEN-002","area":"02-tenancy","section":"Provisioning","lifecycle":"active","boundary":"b-3","boundaryDetail":"`tenant state`","traces":["g-2"],"milestone":2,"inSection":"sec-tenancy-2","realisation":"checked"},
    {"id":"ten-003","kind":"requirement","statement":"A provisioning run that fails SHALL leave no tenant reported as active.","rationale":"A half-made tenant is removed or retried, and is not offered to anyone meanwhile.","evaluate":{"method":"scenario"},"ref":"TEN-003","area":"02-tenancy","section":"Provisioning","lifecycle":"active","boundary":"b-3","boundaryDetail":"`tenant state`","traces":["g-2"],"milestone":2,"inSection":"sec-tenancy-2","realisation":"checked"},
    {"id":"ten-004","kind":"requirement","statement":"Provisioning a tenant from the publication template SHALL complete within 30 seconds at the 95th percentile.","rationale":"Sign-up waits for this.","evaluate":{"method":"budget"},"ref":"TEN-004","area":"02-tenancy","section":"Provisioning","lifecycle":"active","boundary":"b-3","boundaryDetail":"`POST /tenants`","traces":["g-2"],"milestone":2,"inSection":"sec-tenancy-2","realisation":"operational"},
    {"id":"ten-005","kind":"requirement","statement":"A tenant created with a region SHALL have its database and its stored files placed in that region.","rationale":"Residency is a property of the placement.","evaluate":{"method":"scenario"},"ref":"TEN-005","area":"02-tenancy","section":"Provisioning","lifecycle":"active","boundary":"b-3","boundaryDetail":"`placement`","traces":["g-3","d-503"],"milestone":2,"inSection":"sec-tenancy-2","realisation":"checked"},
    {"id":"ten-006","kind":"requirement","statement":"The control database SHALL hold no field of a tenant record.","rationale":"Identifiers, states and addresses only, so that a tenant can be deleted by deleting its own things.","evaluate":{"method":"property"},"ref":"TEN-006","area":"02-tenancy","section":"Isolation","lifecycle":"active","boundary":"b-3","boundaryDetail":"`control database`","traces":["k-2","d-2"],"milestone":2,"inSection":"sec-tenancy-3","realisation":"checked"},
    {"id":"ten-007","kind":"requirement","statement":"A request for one tenant SHALL be served using a database connection opened for that tenant alone.","rationale":"No pooled connection is ever switched between tenants.","evaluate":{"method":"property"},"ref":"TEN-007","area":"02-tenancy","section":"Isolation","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["g-20","k-3"],"milestone":2,"inSection":"sec-tenancy-3","realisation":"checked"},
    {"id":"ten-008","kind":"requirement","statement":"A tenant that exceeds its connection quota SHALL receive a throttling response while other tenants are served.","rationale":"The noisy tenant is the one that waits.","evaluate":{"method":"scenario"},"ref":"TEN-008","area":"02-tenancy","section":"Isolation","lifecycle":"active","boundary":"b-2","boundaryDetail":"`429`","traces":["g-4"],"milestone":2,"inSection":"sec-tenancy-3","realisation":"checked"},
    {"id":"ten-009","kind":"requirement","statement":"A suspended tenant SHALL refuse state-changing requests.","rationale":"Suspension is reversible and loses nothing.","evaluate":{"method":"scenario"},"ref":"TEN-009","area":"02-tenancy","section":"Life cycle","lifecycle":"active","boundary":"b-3","boundaryDetail":"`POST /tenants/{id}/suspend`","traces":["g-1"],"milestone":2,"inSection":"sec-tenancy-4","realisation":"checked"},
    {"id":"ten-010","kind":"requirement","statement":"An export of a tenant SHALL restore into an empty installation as a state with the same canonical hash.","rationale":"The tenant is portable, and the hash is the proof.","evaluate":{"method":"scenario"},"ref":"TEN-010","area":"02-tenancy","section":"Life cycle","lifecycle":"active","boundary":"b-3","boundaryDetail":"`POST /tenants/{id}/export`","traces":["g-1"],"milestone":2,"inSection":"sec-tenancy-4","realisation":"checked"},
    {"id":"ten-011","kind":"requirement","statement":"Deleting a tenant SHALL remove its database, its stored files and its encryption key.","rationale":"Deletion is the removal of three things that belong to nobody else.","evaluate":{"method":"scenario"},"ref":"TEN-011","area":"02-tenancy","section":"Life cycle","lifecycle":"active","boundary":"b-3","boundaryDetail":"`DELETE /tenants/{id}`","traces":["g-1","g-40"],"milestone":2,"inSection":"sec-tenancy-4","realisation":"checked"},
    {"id":"ten-012","kind":"requirement","statement":"Moving a tenant to another database cluster SHALL preserve the canonical hash of its state.","rationale":"A move is a copy that can be checked.","evaluate":{"method":"scenario"},"ref":"TEN-012","area":"02-tenancy","section":"Life cycle","lifecycle":"active","boundary":"b-3","boundaryDetail":"`POST /tenants/{id}/move`","traces":["g-3"],"milestone":2,"inSection":"sec-tenancy-4","realisation":"checked"},
    {"id":"ten-013","kind":"requirement","statement":"The address of a tenant SHALL resolve to the same tenant before and after a move.","rationale":"Addresses belong to the directory, not to a cluster.","evaluate":{"method":"scenario"},"ref":"TEN-013","area":"02-tenancy","section":"Life cycle","lifecycle":"active","boundary":"b-3","boundaryDetail":"`domain binding`","traces":["g-3"],"milestone":2,"inSection":"sec-tenancy-4","realisation":"checked"},
    {"id":"ten-014","kind":"requirement","statement":"A change to the storage layout SHALL be applied to each tenant database separately with its outcome recorded per tenant.","rationale":"With a database per tenant, a layout change is many small changes, and some will lag.","evaluate":{"method":"scenario"},"ref":"TEN-014","area":"02-tenancy","section":"Life cycle","lifecycle":"active","boundary":"b-3","boundaryDetail":"`layout version`","traces":["g-1"],"milestone":2,"inSection":"sec-tenancy-4","realisation":"checked"},
    {"id":"ten-015","kind":"requirement","statement":"A tenant restored to a point in time SHALL have the state hash that its journal records at that point.","rationale":"Restore is checked the same way as replay.","evaluate":{"method":"scenario"},"ref":"TEN-015","area":"02-tenancy","section":"Life cycle","lifecycle":"active","boundary":"b-3","boundaryDetail":"`POST /tenants/{id}/restore`","traces":["g-39"],"milestone":12,"inSection":"sec-tenancy-4","realisation":"checked"},
    {"id":"idn-001","kind":"requirement","statement":"Each sign-in method SHALL issue a session only for the outcomes that the sign-in method table marks as accepted.","rationale":"One table states, per method, what is accepted and what is refused.","evaluate":{"method":"conformance"},"ref":"IDN-001","area":"03-identity","section":"Sign-in methods","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/{method}`","traces":["g-6"],"milestone":3,"cases":["cases-sign-in-methods"],"inSection":"sec-identity-2","realisation":"checked"},
    {"id":"idn-002","kind":"requirement","statement":"A stored password SHALL be an Argon2id hash with a salt drawn for that password.","rationale":"A stolen database yields no passwords.","evaluate":{"method":"property"},"ref":"IDN-002","area":"03-identity","section":"Sign-in methods","lifecycle":"active","boundary":"b-4","boundaryDetail":"`credential`","traces":["k-4","g-46"],"milestone":3,"inSection":"sec-identity-2","realisation":"checked"},
    {"id":"idn-003","kind":"requirement","statement":"An emailed sign-in link SHALL be accepted once.","rationale":"Modelled as the emailed link flow, with replay as its negative.","evaluate":{"method":"scenario"},"ref":"IDN-003","area":"03-identity","section":"Sign-in methods","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/link`","traces":["g-6","d-9","d-703"],"milestone":3,"inSection":"sec-identity-2","realisation":"checked"},
    {"id":"idn-004","kind":"requirement","statement":"An emailed sign-in link SHALL be refused after its lifetime has passed.","rationale":"A link in an old mailbox is not a credential.","evaluate":{"method":"scenario"},"ref":"IDN-004","area":"03-identity","section":"Sign-in methods","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/link`","traces":["g-46","d-9"],"milestone":3,"inSection":"sec-identity-2","realisation":"checked"},
    {"id":"idn-005","kind":"requirement","statement":"An emailed sign-in link SHALL be accepted only in the browser that requested it.","rationale":"A forwarded or intercepted link does not sign anyone else in.","evaluate":{"method":"scenario"},"ref":"IDN-005","area":"03-identity","section":"Sign-in methods","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/link`","traces":["g-46","d-9"],"milestone":3,"inSection":"sec-identity-2","realisation":"checked"},
    {"id":"idn-006","kind":"requirement","statement":"The response to a request for a sign-in link SHALL be the same whether or not the address belongs to an account.","rationale":"The endpoint does not tell an attacker who has an account.","evaluate":{"method":"property"},"ref":"IDN-006","area":"03-identity","section":"Sign-in methods","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/link/request`","traces":["g-46"],"milestone":3,"inSection":"sec-identity-2","realisation":"checked"},
    {"id":"idn-007","kind":"requirement","statement":"A passkey registration SHALL bind the credential to the address of the tenant as the relying party.","rationale":"A passkey for one tenant is useless at another.","evaluate":{"method":"scenario"},"ref":"IDN-007","area":"03-identity","section":"Sign-in methods","lifecycle":"active","boundary":"b-4","boundaryDetail":"`WebAuthn relying party`","traces":["g-6","k-14"],"milestone":3,"inSection":"sec-identity-2","realisation":"checked"},
    {"id":"idn-008","kind":"requirement","statement":"Repeated failed sign-in attempts for one account SHALL delay further attempts for that account.","rationale":"Guessing is slowed without locking the owner out for good.","evaluate":{"method":"scenario"},"ref":"IDN-008","area":"03-identity","section":"Sign-in methods","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/password`","traces":["g-46"],"milestone":3,"inSection":"sec-identity-2","realisation":"checked"},
    {"id":"idn-009","kind":"requirement","statement":"A principal of one tenant SHALL be unknown to the sign-in of every other tenant.","rationale":"Realms do not overlap.","evaluate":{"method":"property"},"ref":"IDN-009","area":"03-identity","section":"Sign-in methods","lifecycle":"active","boundary":"b-4","boundaryDetail":"`realm`","traces":["g-20","d-3","d-500"],"milestone":3,"inSection":"sec-identity-2","realisation":"checked"},
    {"id":"idn-010","kind":"requirement","statement":"A session secret SHALL be stored only as a hash.","rationale":"A stolen database yields no sessions.","evaluate":{"method":"property"},"ref":"IDN-010","area":"03-identity","section":"Sessions","lifecycle":"active","boundary":"b-4","boundaryDetail":"`sign-in session`","traces":["k-16","d-5"],"milestone":3,"inSection":"sec-identity-3","realisation":"checked"},
    {"id":"idn-011","kind":"requirement","statement":"A successful authentication SHALL end the session that the same browser held before it.","rationale":"The secret changes at every authentication, so one planted beforehand is worthless.","evaluate":{"method":"scenario"},"ref":"IDN-011","area":"03-identity","section":"Sessions","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/{method}`","traces":["g-46"],"milestone":3,"inSection":"sec-identity-3","realisation":"checked"},
    {"id":"idn-012","kind":"requirement","statement":"A person SHALL be able to list and revoke each of their own sessions.","rationale":"The person is the one who knows which devices are theirs.","evaluate":{"method":"scenario"},"ref":"IDN-012","area":"03-identity","section":"Sessions","lifecycle":"active","boundary":"b-4","boundaryDetail":"`GET /sessions`","traces":["g-9","d-5"],"milestone":3,"inSection":"sec-identity-3","realisation":"checked"},
    {"id":"idn-013","kind":"requirement","statement":"A revoked session SHALL be refused by the gateway once the revocation bound has passed, including when the revocation notice is lost.","rationale":"Modelled as the session revocation flow: the notice is the quick path and a recheck is the backstop.","evaluate":{"method":"scenario"},"ref":"IDN-013","area":"03-identity","section":"Sessions","lifecycle":"active","boundary":"b-4","boundaryDetail":"`assertion`","traces":["g-9"],"milestone":3,"inSection":"sec-identity-3","realisation":"checked"},
    {"id":"idn-014","kind":"requirement","statement":"A session revocation SHALL be honoured by every gateway instance within 5 seconds.","rationale":"The bound the model's recheck interval stands for.","evaluate":{"method":"budget"},"ref":"IDN-014","area":"03-identity","section":"Sessions","lifecycle":"active","boundary":"b-4","boundaryDetail":"`assertion`","traces":["g-9"],"milestone":3,"inSection":"sec-identity-3","realisation":"operational"},
    {"id":"idn-015","kind":"requirement","statement":"The identity service SHALL answer a session lookup within 20 ms at the 99th percentile.","rationale":"Every authenticated request pays this once per freshness interval.","evaluate":{"method":"budget"},"ref":"IDN-015","area":"03-identity","section":"Sessions","lifecycle":"active","boundary":"b-4","boundaryDetail":"`assertion`","traces":["g-18","g-12"],"milestone":3,"inSection":"sec-identity-3","realisation":"operational"},
    {"id":"idn-016","kind":"requirement","statement":"Changing a password SHALL revoke the other sessions of the account.","rationale":"Whoever knew the old password is signed out.","evaluate":{"method":"scenario"},"ref":"IDN-016","area":"03-identity","section":"Sessions","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /password`","traces":["g-9"],"milestone":3,"inSection":"sec-identity-3","realisation":"checked"},
    {"id":"idn-017","kind":"requirement","statement":"A component other than the identity service SHALL accept a caller identity only from an assertion that the identity service signed.","rationale":"One issuer, many verifiers.","evaluate":{"method":"scenario"},"ref":"IDN-017","area":"03-identity","section":"Sessions","lifecycle":"active","boundary":"b-4","boundaryDetail":"`assertion`","traces":["g-12","d-4"],"milestone":3,"inSection":"sec-identity-3","realisation":"checked"},
    {"id":"idn-018","kind":"requirement","statement":"A realm policy that asks for a second factor SHALL withhold the session until a second factor has been verified.","rationale":"The first factor alone yields nothing usable.","evaluate":{"method":"scenario"},"ref":"IDN-018","area":"03-identity","section":"Factors, step-up and recovery","lifecycle":"active","boundary":"b-4","boundaryDetail":"`realm policy`","traces":["g-8"],"milestone":3,"inSection":"sec-identity-4","realisation":"checked"},
    {"id":"idn-019","kind":"requirement","statement":"An operation marked sensitive SHALL be refused when the last authentication of the session is older than the step-up age that D-700 states.","rationale":"An unattended browser cannot change a password or a key.","evaluate":{"method":"scenario"},"ref":"IDN-019","area":"03-identity","section":"Factors, step-up and recovery","lifecycle":"active","boundary":"b-4","boundaryDetail":"`authentication age`","traces":["g-8"],"milestone":3,"inSection":"sec-identity-4","realisation":"checked"},
    {"id":"idn-020","kind":"requirement","statement":"Account recovery SHALL revoke every existing session of the account.","rationale":"Recovery is used when control was lost, so it takes control back everywhere.","evaluate":{"method":"scenario"},"ref":"IDN-020","area":"03-identity","section":"Factors, step-up and recovery","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /recovery`","traces":["g-46"],"milestone":3,"inSection":"sec-identity-4","realisation":"checked"},
    {"id":"idn-021","kind":"requirement","statement":"Every authentication decision SHALL append an audit entry naming the method, the outcome and the checks evaluated.","rationale":"A refused sign-in can be explained to the person and to their administrator.","evaluate":{"method":"property"},"ref":"IDN-021","area":"03-identity","section":"Record and presentation","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit entry`","traces":["g-11"],"milestone":3,"seam":2,"inSection":"sec-identity-5","realisation":"checked"},
    {"id":"idn-022","kind":"requirement","statement":"A log line or audit entry SHALL contain no password, session secret, token or one-time code.","rationale":"Checked by scanning real output for the secrets of a test run.","evaluate":{"method":"property"},"ref":"IDN-022","area":"03-identity","section":"Record and presentation","lifecycle":"active","boundary":"b-12","boundaryDetail":"`log line`","traces":["k-4"],"milestone":3,"seam":1,"inSection":"sec-identity-5","realisation":"checked"},
    {"id":"idn-023","kind":"requirement","statement":"The sign-in pages SHALL meet WCAG 2.2 level AA.","rationale":"Signing in is the one flow nobody can skip.","evaluate":{"method":"example"},"ref":"IDN-023","area":"03-identity","section":"Record and presentation","lifecycle":"active","boundary":"b-13","boundaryDetail":"`sign-in pages`","traces":["g-45"],"milestone":3,"inSection":"sec-identity-5","realisation":"checked"},
    {"id":"fed-001","kind":"requirement","statement":"An OpenID Connect callback whose state value matches no pending request of that browser SHALL be refused.","rationale":"Modelled as the callback flow, with a forged callback as its negative.","evaluate":{"method":"scenario"},"ref":"FED-001","area":"03-identity","section":"OpenID Connect","lifecycle":"active","boundary":"b-5","boundaryDetail":"`GET /federation/oidc/callback`","traces":["g-46","d-7"],"milestone":4,"inSection":"sec-federation-2","realisation":"checked"},
    {"id":"fed-002","kind":"requirement","statement":"An OpenID Connect sign-in SHALL use the authorization code flow with a proof key.","rationale":"An intercepted code cannot be redeemed.","evaluate":{"method":"scenario"},"ref":"FED-002","area":"03-identity","section":"OpenID Connect","lifecycle":"active","boundary":"b-5","boundaryDetail":"`GET /federation/oidc/start`","traces":["k-14","d-7"],"milestone":4,"inSection":"sec-federation-2","realisation":"checked"},
    {"id":"fed-003","kind":"requirement","statement":"An identity token whose issuer, audience, signature or nonce fails verification SHALL be refused.","rationale":"A token for another client, or from another issuer, signs nobody in.","evaluate":{"method":"scenario"},"ref":"FED-003","area":"03-identity","section":"OpenID Connect","lifecycle":"active","boundary":"b-5","boundaryDetail":"`identity token`","traces":["g-46"],"milestone":4,"inSection":"sec-federation-2","realisation":"checked"},
    {"id":"fed-004","kind":"requirement","statement":"Provider signing keys SHALL be refreshed from the provider metadata when a token names an unknown key.","rationale":"Providers rotate keys without notice.","evaluate":{"method":"scenario"},"ref":"FED-004","area":"03-identity","section":"OpenID Connect","lifecycle":"active","boundary":"b-5","boundaryDetail":"`provider metadata`","traces":["g-6"],"milestone":4,"inSection":"sec-federation-2","realisation":"checked"},
    {"id":"fed-005","kind":"requirement","statement":"A SAML response SHALL be accepted only when its assertion is signed by a certificate that the tenant configured.","rationale":"An unsigned or wrongly signed assertion is just text.","evaluate":{"method":"scenario"},"ref":"FED-005","area":"03-identity","section":"SAML","lifecycle":"active","boundary":"b-5","boundaryDetail":"`POST /federation/saml/acs`","traces":["g-6","d-8"],"milestone":4,"inSection":"sec-federation-3","realisation":"checked"},
    {"id":"fed-006","kind":"requirement","statement":"A SAML assertion presented a second time SHALL be refused.","rationale":"Assertions are bearer material until their identifier is remembered.","evaluate":{"method":"scenario"},"ref":"FED-006","area":"03-identity","section":"SAML","lifecycle":"active","boundary":"b-5","boundaryDetail":"`POST /federation/saml/acs`","traces":["g-46"],"milestone":4,"inSection":"sec-federation-3","realisation":"checked"},
    {"id":"fed-007","kind":"requirement","statement":"A SAML response that answers no pending request SHALL be refused unless the tenant enabled sign-in started by the provider.","rationale":"The unsolicited form is the one attackers inject into.","evaluate":{"method":"scenario"},"ref":"FED-007","area":"03-identity","section":"SAML","lifecycle":"active","boundary":"b-5","boundaryDetail":"`POST /federation/saml/acs`","traces":["d-8","g-46"],"milestone":4,"inSection":"sec-federation-3","realisation":"checked"},
    {"id":"fed-008","kind":"requirement","statement":"A SAML response whose audience or recipient names another service SHALL be refused.","rationale":"An assertion issued for a different service provider is not for this one.","evaluate":{"method":"scenario"},"ref":"FED-008","area":"03-identity","section":"SAML","lifecycle":"active","boundary":"b-5","boundaryDetail":"`POST /federation/saml/acs`","traces":["g-46"],"milestone":4,"inSection":"sec-federation-3","realisation":"checked"},
    {"id":"fed-009","kind":"requirement","statement":"A realm that binds an email domain to an identity provider SHALL refuse password and emailed-link sign-in for addresses in that domain.","rationale":"When the organisation says its provider decides, nothing else does.","evaluate":{"method":"scenario"},"ref":"FED-009","area":"03-identity","section":"Policy and linking","lifecycle":"active","boundary":"b-4","boundaryDetail":"`realm policy`","traces":["g-7","d-6"],"milestone":4,"inSection":"sec-federation-4","realisation":"checked"},
    {"id":"fed-010","kind":"requirement","statement":"The sign-in page SHALL offer the identity providers configured for the realm of the address it is served at.","rationale":"The address selects the realm before anyone types anything.","evaluate":{"method":"scenario"},"ref":"FED-010","area":"03-identity","section":"Policy and linking","lifecycle":"active","boundary":"b-4","boundaryDetail":"`sign-in page`","traces":["g-6","d-6"],"milestone":4,"inSection":"sec-federation-4","realisation":"checked"},
    {"id":"fed-011","kind":"requirement","statement":"A first federated sign-in SHALL create a principal only when the realm enabled creation on first sign-in.","rationale":"Otherwise people are admitted by provisioning or invitation.","evaluate":{"method":"scenario"},"ref":"FED-011","area":"03-identity","section":"Policy and linking","lifecycle":"active","boundary":"b-5","boundaryDetail":"`first federated sign-in`","traces":["g-7"],"milestone":4,"inSection":"sec-federation-4","realisation":"checked"},
    {"id":"fed-012","kind":"requirement","statement":"A federated identity SHALL be linked to an existing principal only after that principal has authenticated.","rationale":"A matching email address at a provider is not proof of owning the account.","evaluate":{"method":"scenario"},"ref":"FED-012","area":"03-identity","section":"Policy and linking","lifecycle":"active","boundary":"b-5","boundaryDetail":"`identity link`","traces":["g-46"],"milestone":4,"inSection":"sec-federation-4","realisation":"checked"},
    {"id":"fed-013","kind":"requirement","statement":"An outage of an external identity provider SHALL leave the other sign-in methods of the realm usable.","rationale":"One provider failing does not take the tenant down.","evaluate":{"method":"scenario"},"ref":"FED-013","area":"03-identity","section":"Policy and linking","lifecycle":"active","boundary":"b-4","boundaryDetail":"`sign-in methods`","traces":["g-6"],"milestone":4,"inSection":"sec-federation-4","realisation":"checked"},
    {"id":"fed-014","kind":"requirement","statement":"The provisioning endpoint SHALL behave as the provisioning case table states for each listed operation.","rationale":"SCIM is a standard, and conformance to it is a table.","evaluate":{"method":"conformance"},"ref":"FED-014","area":"03-identity","section":"Provisioning","lifecycle":"active","boundary":"b-5","boundaryDetail":"`/scim/v2`","traces":["g-7","k-14"],"milestone":4,"cases":["cases-provisioning-operations"],"inSection":"sec-federation-5","realisation":"checked"},
    {"id":"fed-015","kind":"requirement","statement":"Deactivating a person through provisioning SHALL revoke the sessions of that person.","rationale":"Leaving the organisation ends access now, not at the next sign-in.","evaluate":{"method":"scenario"},"ref":"FED-015","area":"03-identity","section":"Provisioning","lifecycle":"active","boundary":"b-5","boundaryDetail":"`/scim/v2/Users`","traces":["g-7","g-9"],"milestone":4,"inSection":"sec-federation-5","realisation":"checked"},
    {"id":"tok-001","kind":"requirement","statement":"A service account SHALL obtain an access token through the client credentials grant.","rationale":"The standard grant for a caller that is itself.","evaluate":{"method":"scenario"},"ref":"TOK-001","area":"03-identity","section":"Issue","lifecycle":"active","boundary":"b-6","boundaryDetail":"`POST /token`","traces":["g-10"],"milestone":4,"inSection":"sec-tokens-2","realisation":"checked"},
    {"id":"tok-002","kind":"requirement","statement":"An access token SHALL grant no scope beyond those of the grant it was issued from.","rationale":"A token is a subset of a grant.","evaluate":{"method":"property"},"ref":"TOK-002","area":"03-identity","section":"Issue","lifecycle":"active","boundary":"b-6","boundaryDetail":"`access token`","traces":["g-10"],"milestone":4,"inSection":"sec-tokens-2","realisation":"checked"},
    {"id":"tok-003","kind":"requirement","statement":"An agent acting for a person SHALL present a token that names both the agent and the person.","rationale":"Attribution needs both names on the request itself.","evaluate":{"method":"scenario"},"ref":"TOK-003","area":"03-identity","section":"Issue","lifecycle":"active","boundary":"b-6","boundaryDetail":"`POST /token`","traces":["g-25"],"milestone":4,"inSection":"sec-tokens-2","realisation":"checked"},
    {"id":"tok-004","kind":"requirement","statement":"A delegated token SHALL grant no permission that the delegating person lacks.","rationale":"Delegation narrows and cannot widen.","evaluate":{"method":"property"},"ref":"TOK-004","area":"03-identity","section":"Issue","lifecycle":"active","boundary":"b-6","boundaryDetail":"`delegated token`","traces":["k-13","g-28"],"milestone":4,"inSection":"sec-tokens-2","realisation":"checked"},
    {"id":"tok-005","kind":"requirement","statement":"An access token SHALL be valid for at most 5 minutes.","rationale":"Short enough that a missed revocation notice costs little (D-537).","evaluate":{"method":"budget"},"ref":"TOK-005","area":"03-identity","section":"Issue","lifecycle":"active","boundary":"b-6","boundaryDetail":"`access token`","traces":["g-28","d-537"],"milestone":4,"inSection":"sec-tokens-2","realisation":"operational"},
    {"id":"tok-006","kind":"requirement","statement":"An access token issued for one tenant SHALL be refused by every other tenant.","rationale":"The audience of a token is a tenant.","evaluate":{"method":"property"},"ref":"TOK-006","area":"03-identity","section":"Verify and revoke","lifecycle":"active","boundary":"b-6","boundaryDetail":"`access token`","traces":["g-20"],"milestone":4,"inSection":"sec-tokens-3","realisation":"checked"},
    {"id":"tok-007","kind":"requirement","statement":"Revoking a grant SHALL cause tokens issued from it to be refused within the revocation bound that applies to sessions.","rationale":"The revocation notice is the quick path, as it is for sessions, and the token lifetime is the backstop when the notice is lost.","evaluate":{"method":"scenario"},"ref":"TOK-007","area":"03-identity","section":"Verify and revoke","lifecycle":"active","boundary":"b-6","boundaryDetail":"`grant`","traces":["g-28"],"milestone":4,"inSection":"sec-tokens-3","realisation":"checked"},
    {"id":"tok-008","kind":"requirement","statement":"Rotation of a signing key SHALL leave tokens signed by the previous key verifiable until they expire.","rationale":"Rotation is routine and breaks nobody.","evaluate":{"method":"scenario"},"ref":"TOK-008","area":"03-identity","section":"Verify and revoke","lifecycle":"active","boundary":"b-6","boundaryDetail":"`GET /keys`","traces":["g-10"],"milestone":4,"inSection":"sec-tokens-3","realisation":"checked"},
    {"id":"tok-009","kind":"requirement","statement":"Token introspection SHALL report the scopes, the subject and the expiry of a token to a caller permitted to ask.","rationale":"An agent can find out what its own token allows.","evaluate":{"method":"scenario"},"ref":"TOK-009","area":"03-identity","section":"Verify and revoke","lifecycle":"active","boundary":"b-6","boundaryDetail":"`POST /introspect`","traces":["g-24"],"milestone":4,"inSection":"sec-tokens-3","realisation":"checked"},
    {"id":"sch-001","kind":"requirement","statement":"A job scheduled for a time SHALL be offered to a worker no earlier than that time.","rationale":"The due time is a promise in one direction.","evaluate":{"method":"scenario"},"ref":"SCH-001","area":"04-automation","section":"Due work","lifecycle":"active","boundary":"b-7","boundaryDetail":"`job`","traces":["g-13"],"milestone":5,"inSection":"sec-scheduling-2","realisation":"checked"},
    {"id":"sch-002","kind":"requirement","statement":"A due job SHALL start within 5 seconds of its due time at the 99th percentile.","rationale":"The other direction, as a measured bound.","evaluate":{"method":"budget"},"ref":"SCH-002","area":"04-automation","section":"Due work","lifecycle":"active","boundary":"b-7","boundaryDetail":"`job`","traces":["g-13"],"milestone":5,"inSection":"sec-scheduling-2","realisation":"operational"},
    {"id":"sch-003","kind":"requirement","statement":"A recurring schedule SHALL create its next job in the transaction that completes the current one.","rationale":"A crash between the two cannot lose the recurrence.","evaluate":{"method":"scenario"},"ref":"SCH-003","area":"04-automation","section":"Due work","lifecycle":"active","boundary":"b-7","boundaryDetail":"`schedule`","traces":["g-13"],"milestone":5,"inSection":"sec-scheduling-2","realisation":"checked"},
    {"id":"sch-004","kind":"requirement","statement":"A committed domain event SHALL create the jobs of the triggers subscribed to it in the transaction that commits the event.","rationale":"An event and its consequences are one fact.","evaluate":{"method":"scenario"},"ref":"SCH-004","area":"04-automation","section":"Due work","lifecycle":"active","boundary":"b-7","boundaryDetail":"`trigger`","traces":["g-13"],"milestone":5,"inSection":"sec-scheduling-2","realisation":"checked"},
    {"id":"sch-005","kind":"requirement","statement":"A paused schedule SHALL create no job.","rationale":"Pausing is the safe way to stop automation while looking at it.","evaluate":{"method":"scenario"},"ref":"SCH-005","area":"04-automation","section":"Due work","lifecycle":"active","boundary":"b-7","boundaryDetail":"`schedule`","traces":["g-13"],"milestone":5,"inSection":"sec-scheduling-2","realisation":"checked"},
    {"id":"sch-006","kind":"requirement","statement":"Cancelling a job SHALL prevent every later attempt of it.","rationale":"Cancel is final.","evaluate":{"method":"scenario"},"ref":"SCH-006","area":"04-automation","section":"Due work","lifecycle":"active","boundary":"b-7","boundaryDetail":"`job`","traces":["g-13"],"milestone":5,"inSection":"sec-scheduling-2","realisation":"checked"},
    {"id":"sch-007","kind":"requirement","statement":"The automation worker SHALL find due work without a query to the database of a tenant that has none.","rationale":"Thousands of idle tenants cost nothing.","evaluate":{"method":"scenario"},"ref":"SCH-007","area":"04-automation","section":"Finding work","lifecycle":"active","boundary":"b-3","boundaryDetail":"`wake index`","traces":["g-4","d-10"],"milestone":5,"inSection":"sec-scheduling-3","realisation":"checked"},
    {"id":"sch-008","kind":"requirement","statement":"A wake index entry SHALL hold a tenant identifier and a due time and no content of a job.","rationale":"The control database learns when, not what.","evaluate":{"method":"property"},"ref":"SCH-008","area":"04-automation","section":"Finding work","lifecycle":"active","boundary":"b-3","boundaryDetail":"`wake index`","traces":["k-2"],"milestone":5,"seam":2,"inSection":"sec-scheduling-3","realisation":"checked"},
    {"id":"sch-009","kind":"requirement","statement":"The queued work of one tenant SHALL leave the due jobs of other tenants within the start budget.","rationale":"Fairness between tenants is part of the schedule.","evaluate":{"method":"scenario"},"ref":"SCH-009","area":"04-automation","section":"Finding work","lifecycle":"active","boundary":"b-7","boundaryDetail":"`job`","traces":["g-4"],"milestone":5,"inSection":"sec-scheduling-3","realisation":"checked"},
    {"id":"sch-010","kind":"requirement","statement":"A job whose worker stops responding SHALL be offered to another worker after its lease expires.","rationale":"Modelled as the lease flow.","evaluate":{"method":"scenario"},"ref":"SCH-010","area":"04-automation","section":"Failure","lifecycle":"active","boundary":"b-7","boundaryDetail":"`lease`","traces":["g-14"],"milestone":5,"inSection":"sec-scheduling-4","realisation":"checked"},
    {"id":"sch-011","kind":"requirement","statement":"A result presented with a superseded lease token SHALL be refused.","rationale":"The stalled worker that wakes up cannot overwrite its replacement.","evaluate":{"method":"property"},"ref":"SCH-011","area":"04-automation","section":"Failure","lifecycle":"active","boundary":"b-7","boundaryDetail":"`fencing token`","traces":["k-17","d-11"],"milestone":5,"inSection":"sec-scheduling-4","realisation":"checked"},
    {"id":"sch-012","kind":"requirement","statement":"A job SHALL end in exactly one recorded outcome.","rationale":"Completed, failed or cancelled: one of them, once.","evaluate":{"method":"property"},"ref":"SCH-012","area":"04-automation","section":"Failure","lifecycle":"active","boundary":"b-7","boundaryDetail":"`job`","traces":["g-14"],"milestone":5,"inSection":"sec-scheduling-4","realisation":"checked"},
    {"id":"sch-013","kind":"requirement","statement":"A failed attempt SHALL be retried after a delay that grows with the number of attempts.","rationale":"A struggling dependency is given room.","evaluate":{"method":"scenario"},"ref":"SCH-013","area":"04-automation","section":"Failure","lifecycle":"active","boundary":"b-7","boundaryDetail":"`job`","traces":["g-14"],"milestone":5,"inSection":"sec-scheduling-4","realisation":"checked"},
    {"id":"sch-014","kind":"requirement","statement":"A job that exhausts its attempts SHALL be recorded as failed with the error of each attempt.","rationale":"Dead work is visible and explained, not silently dropped.","evaluate":{"method":"scenario"},"ref":"SCH-014","area":"04-automation","section":"Failure","lifecycle":"active","boundary":"b-7","boundaryDetail":"`job`","traces":["g-14","g-27"],"milestone":5,"inSection":"sec-scheduling-4","realisation":"checked"},
    {"id":"sch-015","kind":"requirement","statement":"An effect that carries an idempotency key SHALL be applied once however many times its job is attempted.","rationale":"At least once in, exactly once out.","evaluate":{"method":"property"},"ref":"SCH-015","area":"04-automation","section":"Failure","lifecycle":"active","boundary":"b-7","boundaryDetail":"`idempotency key`","traces":["g-15","d-12"],"milestone":5,"inSection":"sec-scheduling-4","realisation":"checked"},
    {"id":"sch-016","kind":"requirement","statement":"Two simulations of the automation worker with one seed SHALL produce equal traces.","rationale":"Scheduling decisions are kernel decisions, so they are simulable like the rest.","evaluate":{"method":"property"},"ref":"SCH-016","area":"04-automation","section":"Failure","lifecycle":"active","boundary":"b-20","boundaryDetail":"`strata_simulation::engine::run`","traces":["k-11","g-42"],"milestone":5,"inSection":"sec-scheduling-4","realisation":"checked"},
    {"id":"wfl-001","kind":"requirement","statement":"A workflow definition SHALL be stored as tenant metadata under the schema version.","rationale":"Workflows are versioned, migrated and inspected like the rest of the schema.","evaluate":{"method":"scenario"},"ref":"WFL-001","area":"04-automation","section":"Definition and activation","lifecycle":"active","boundary":"b-8","boundaryDetail":"`workflow definition`","traces":["g-16","g-31"],"milestone":5,"inSection":"sec-workflows-2","realisation":"checked"},
    {"id":"wfl-002","kind":"requirement","statement":"Activation of a workflow definition SHALL be refused until a projection of it has run.","rationale":"Automation is tried on history before it runs on the present.","evaluate":{"method":"scenario"},"ref":"WFL-002","area":"04-automation","section":"Definition and activation","lifecycle":"active","boundary":"b-20","boundaryDetail":"`projection`","traces":["g-16"],"milestone":5,"inSection":"sec-workflows-2","realisation":"checked"},
    {"id":"wfl-003","kind":"requirement","statement":"Each workflow step SHALL be decided by the kernel from the recorded state of the run.","rationale":"A run can be replayed, and a step cannot depend on anything unrecorded.","evaluate":{"method":"property"},"ref":"WFL-003","area":"04-automation","section":"Definition and activation","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["k-9","k-11","d-13"],"milestone":5,"inSection":"sec-workflows-2","realisation":"checked"},
    {"id":"wfl-004","kind":"requirement","statement":"A workflow run SHALL continue from its last recorded step after a process restart.","rationale":"The run is a record, not a thread.","evaluate":{"method":"scenario"},"ref":"WFL-004","area":"04-automation","section":"Definition and activation","lifecycle":"active","boundary":"b-8","boundaryDetail":"`workflow run`","traces":["g-14"],"milestone":5,"inSection":"sec-workflows-2","realisation":"checked"},
    {"id":"wfl-005","kind":"requirement","statement":"A failed step SHALL run the declared compensation steps of the completed steps in reverse order.","rationale":"A workflow that cannot finish undoes what it can.","evaluate":{"method":"scenario"},"ref":"WFL-005","area":"04-automation","section":"Definition and activation","lifecycle":"active","boundary":"b-8","boundaryDetail":"`compensation`","traces":["g-14"],"milestone":5,"inSection":"sec-workflows-2","realisation":"checked"},
    {"id":"wfl-006","kind":"requirement","statement":"A workflow waiting for approval SHALL continue only after a principal permitted by its policy approves.","rationale":"People stay in the loop where the tenant puts them.","evaluate":{"method":"scenario"},"ref":"WFL-006","area":"04-automation","section":"Definition and activation","lifecycle":"active","boundary":"b-8","boundaryDetail":"`approval step`","traces":["g-26"],"milestone":5,"inSection":"sec-workflows-2","realisation":"checked"},
    {"id":"wfl-007","kind":"requirement","statement":"A step that calls an external address SHALL be carried out by the connector runner after the transaction of the step commits.","rationale":"No call is made for a step that did not happen.","evaluate":{"method":"scenario"},"ref":"WFL-007","area":"04-automation","section":"External effects","lifecycle":"active","boundary":"b-8","boundaryDetail":"`call step`","traces":["k-9","d-506"],"milestone":5,"inSection":"sec-workflows-3","realisation":"checked"},
    {"id":"wfl-008","kind":"requirement","statement":"An external call SHALL be refused when its address resolves to a private, link-local or loopback network.","rationale":"Tenant automation is not a way into the platform's network.","evaluate":{"method":"scenario"},"ref":"WFL-008","area":"04-automation","section":"External effects","lifecycle":"active","boundary":"b-8","boundaryDetail":"`call step`","traces":["g-47"],"milestone":5,"inSection":"sec-workflows-3","realisation":"checked"},
    {"id":"wfl-009","kind":"requirement","statement":"A connector secret SHALL be readable only by the connector runner at the time of the call.","rationale":"Secrets are write-only to everyone else, agents included.","evaluate":{"method":"property"},"ref":"WFL-009","area":"04-automation","section":"External effects","lifecycle":"active","boundary":"b-17","boundaryDetail":"`connector secret`","traces":["g-40","g-47"],"milestone":5,"inSection":"sec-workflows-3","realisation":"checked"},
    {"id":"wfl-010","kind":"requirement","statement":"A webhook delivery SHALL carry a signature over its body made with the secret of its subscription.","rationale":"The receiver can tell the platform sent it.","evaluate":{"method":"scenario"},"ref":"WFL-010","area":"04-automation","section":"External effects","lifecycle":"active","boundary":"b-8","boundaryDetail":"`webhook`","traces":["g-13"],"milestone":5,"inSection":"sec-workflows-3","realisation":"checked"},
    {"id":"wfl-011","kind":"requirement","statement":"A content record with a publication time SHALL be published by a job at that time.","rationale":"Scheduled publication is the first workflow every publication needs.","evaluate":{"method":"scenario"},"ref":"WFL-011","area":"04-automation","section":"External effects","lifecycle":"active","boundary":"b-7","boundaryDetail":"`publication time`","traces":["g-17"],"milestone":5,"inSection":"sec-workflows-3","realisation":"checked"},
    {"id":"cpy-001","kind":"requirement","statement":"Each stored copy class SHALL have the owner, key, freshness bound and erasure point that the copy class table states.","rationale":"The table is the design. The data model in this specification is checked against the same rules.","evaluate":{"method":"conformance"},"ref":"CPY-001","area":"05-delivery","section":"Classes and keys","lifecycle":"active","boundary":"b-15","boundaryDetail":"`copy class`","traces":["k-8"],"milestone":6,"cases":["cases-copy-classes"],"inSection":"sec-copies-2","realisation":"construction"},
    {"id":"cpy-002","kind":"requirement","statement":"The key of a stored view copy SHALL contain the tenant, the view, its arguments, the audience class, the schema version and the revision of each object type it depends on.","rationale":"A change produces a new key, so a stale entry cannot be read by mistake.","evaluate":{"method":"property"},"ref":"CPY-002","area":"05-delivery","section":"Classes and keys","lifecycle":"active","boundary":"b-15","boundaryDetail":"`copy key`","traces":["d-14","g-19"],"milestone":6,"inSection":"sec-copies-2","realisation":"checked"},
    {"id":"cpy-003","kind":"requirement","statement":"A stored copy key SHALL begin with the tenant identifier.","rationale":"No two tenants can ever address the same entry.","evaluate":{"method":"property"},"ref":"CPY-003","area":"05-delivery","section":"Classes and keys","lifecycle":"active","boundary":"b-15","boundaryDetail":"`copy key`","traces":["g-20"],"milestone":6,"inSection":"sec-copies-2","realisation":"checked"},
    {"id":"cpy-004","kind":"requirement","statement":"Every read result SHALL name the object types and records it depends on.","rationale":"Invalidation is exact because the kernel says what an answer was made from.","evaluate":{"method":"property"},"ref":"CPY-004","area":"05-delivery","section":"Classes and keys","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::read`","traces":["d-14","g-19"],"milestone":6,"seam":2,"inSection":"sec-copies-2","realisation":"checked"},
    {"id":"cpy-005","kind":"requirement","statement":"The audience class of a principal for a read SHALL be derived by the kernel from the policies of the tenant.","rationale":"Who may share a copy is an authorisation question and has one answer.","evaluate":{"method":"property"},"ref":"CPY-005","area":"05-delivery","section":"Classes and keys","lifecycle":"active","boundary":"b-1","boundaryDetail":"`audience class`","traces":["d-15","k-13"],"milestone":6,"seam":3,"inSection":"sec-copies-2","realisation":"checked"},
    {"id":"cpy-006","kind":"requirement","statement":"A view copy stored for one audience class SHALL be served only to principals of that class.","rationale":"A draft stored for editors is not an answer for readers.","evaluate":{"method":"property"},"ref":"CPY-006","area":"05-delivery","section":"Isolation","lifecycle":"active","boundary":"b-15","boundaryDetail":"`audience class`","traces":["g-20"],"milestone":6,"inSection":"sec-copies-3","realisation":"checked"},
    {"id":"cpy-007","kind":"requirement","statement":"A shared copy SHALL contain no personal field and no field that depends on the requesting principal.","rationale":"Also evaluated by Exegra on the data model of this specification.","evaluate":{"method":"property"},"ref":"CPY-007","area":"05-delivery","section":"Isolation","lifecycle":"active","boundary":"b-15","boundaryDetail":"`shared copy`","traces":["k-7"],"milestone":6,"inSection":"sec-copies-3","realisation":"construction"},
    {"id":"cpy-008","kind":"requirement","statement":"A committed change SHALL supersede every stored copy that depends on a record it changed.","rationale":"Version keys do this for view copies, and tags do it where a key cannot.","evaluate":{"method":"scenario"},"ref":"CPY-008","area":"05-delivery","section":"Freshness and failure","lifecycle":"active","boundary":"b-15","boundaryDetail":"`remove by tag`","traces":["g-19"],"milestone":6,"inSection":"sec-copies-4","realisation":"checked"},
    {"id":"cpy-009","kind":"requirement","statement":"A committed change SHALL be visible through the delivery interface within 2 seconds at the 99th percentile.","rationale":"The freshness bound of the shared copy tier. A reader served from the edge sees the change within the edge bound of EDG-007.","evaluate":{"method":"budget"},"ref":"CPY-009","area":"05-delivery","section":"Freshness and failure","lifecycle":"active","boundary":"b-9","boundaryDetail":"`delivery interface`","traces":["g-19"],"milestone":6,"inSection":"sec-copies-4","realisation":"operational"},
    {"id":"cpy-010","kind":"requirement","statement":"At least 95 percent of delivery requests for published content SHALL be answered without a query to the tenant database.","rationale":"The point of the design, measured.","evaluate":{"method":"budget"},"ref":"CPY-010","area":"05-delivery","section":"Freshness and failure","lifecycle":"active","boundary":"b-9","boundaryDetail":"`delivery interface`","traces":["g-18"],"milestone":6,"inSection":"sec-copies-4","realisation":"operational"},
    {"id":"cpy-011","kind":"requirement","statement":"An outage of the copy store SHALL be answered by reads from the tenant database without an error to the reader.","rationale":"A copy store is an optimisation and its loss is a slowdown.","evaluate":{"method":"scenario"},"ref":"CPY-011","area":"05-delivery","section":"Freshness and failure","lifecycle":"active","boundary":"b-15","boundaryDetail":"`copy store`","traces":["g-18"],"milestone":6,"inSection":"sec-copies-4","realisation":"checked"},
    {"id":"cpy-012","kind":"requirement","statement":"Simultaneous requests for one missing copy SHALL cause one computation of it.","rationale":"A popular page expiring does not become a stampede on one tenant database.","evaluate":{"method":"scenario"},"ref":"CPY-012","area":"05-delivery","section":"Freshness and failure","lifecycle":"active","boundary":"b-15","boundaryDetail":"`copy store`","traces":["g-4"],"milestone":6,"inSection":"sec-copies-4","realisation":"checked"},
    {"id":"cpy-013","kind":"requirement","statement":"Deleting a record SHALL remove every stored copy that holds a field of it within the erasure bound of its class.","rationale":"Erasure reaches copies by design.","evaluate":{"method":"scenario"},"ref":"CPY-013","area":"05-delivery","section":"Freshness and failure","lifecycle":"active","boundary":"b-15","boundaryDetail":"`remove by tag`","traces":["g-22"],"milestone":6,"inSection":"sec-copies-4","realisation":"checked"},
    {"id":"cpy-014","kind":"requirement","statement":"A compiled schema SHALL be reused across requests while the schema version of the tenant is unchanged.","rationale":"The cheapest copy is the one keyed by a version that rarely moves.","evaluate":{"method":"scenario"},"ref":"CPY-014","area":"05-delivery","section":"Freshness and failure","lifecycle":"active","boundary":"b-1","boundaryDetail":"`schema version`","traces":["g-18","d-17"],"milestone":6,"inSection":"sec-copies-4","realisation":"checked"},
    {"id":"edg-001","kind":"requirement","statement":"The edge key of a response SHALL include the host name of its request.","rationale":"Two tenants with the same path are two entries.","evaluate":{"method":"property"},"ref":"EDG-001","area":"05-delivery","section":"Storability","lifecycle":"active","boundary":"b-10","boundaryDetail":"`Host`","traces":["g-20","d-16"],"milestone":6,"inSection":"sec-edge-2","realisation":"checked"},
    {"id":"edg-002","kind":"requirement","statement":"A response that depends on the requesting principal SHALL be marked as not storable by shared intermediaries.","rationale":"Only what is the same for everyone is kept at the edge.","evaluate":{"method":"property"},"ref":"EDG-002","area":"05-delivery","section":"Storability","lifecycle":"active","boundary":"b-10","boundaryDetail":"`Cache-Control`","traces":["k-7"],"milestone":6,"inSection":"sec-edge-2","realisation":"checked"},
    {"id":"edg-003","kind":"requirement","statement":"A published page SHALL carry surrogate keys naming the tenant and each record it was rendered from.","rationale":"The page says what would make it wrong.","evaluate":{"method":"scenario"},"ref":"EDG-003","area":"05-delivery","section":"Storability","lifecycle":"active","boundary":"b-10","boundaryDetail":"`Surrogate-Key`","traces":["g-19","d-16"],"milestone":6,"inSection":"sec-edge-2","realisation":"checked"},
    {"id":"edg-004","kind":"requirement","statement":"Static assets SHALL be served at addresses derived from their content.","rationale":"An asset can be kept at the edge indefinitely because its address changes when it does.","evaluate":{"method":"property"},"ref":"EDG-004","area":"05-delivery","section":"Storability","lifecycle":"active","boundary":"b-10","boundaryDetail":"`asset address`","traces":["g-18"],"milestone":6,"inSection":"sec-edge-2","realisation":"checked"},
    {"id":"edg-005","kind":"requirement","statement":"A committed change SHALL purge the surrogate keys of the records it changed.","rationale":"Driven from the outbox, so a purge follows a commit and nothing else.","evaluate":{"method":"scenario"},"ref":"EDG-005","area":"05-delivery","section":"Purge","lifecycle":"active","boundary":"b-10","boundaryDetail":"`purge`","traces":["g-19"],"milestone":6,"inSection":"sec-edge-3","realisation":"checked"},
    {"id":"edg-006","kind":"requirement","statement":"An edge copy older than its lifetime SHALL be revalidated with the origin before it is served.","rationale":"Modelled as the edge copy flow: the purge is the quick path and the lifetime is the backstop when a purge is lost.","evaluate":{"method":"scenario"},"ref":"EDG-006","area":"05-delivery","section":"Purge","lifecycle":"active","boundary":"b-10","boundaryDetail":"`s-maxage`","traces":["g-19"],"milestone":6,"inSection":"sec-edge-3","realisation":"checked"},
    {"id":"edg-007","kind":"requirement","statement":"A purge SHALL take effect at the edge within 5 seconds at the 99th percentile.","rationale":"The freshness bound of the edge tier.","evaluate":{"method":"budget"},"ref":"EDG-007","area":"05-delivery","section":"Purge","lifecycle":"active","boundary":"b-10","boundaryDetail":"`purge`","traces":["g-19"],"milestone":6,"inSection":"sec-edge-3","realisation":"operational"},
    {"id":"edg-008","kind":"requirement","statement":"Removing a domain binding SHALL purge every edge copy stored under that host name.","rationale":"A domain that leaves takes its copies with it.","evaluate":{"method":"scenario"},"ref":"EDG-008","area":"05-delivery","section":"Purge","lifecycle":"active","boundary":"b-10","boundaryDetail":"`purge`","traces":["g-22"],"milestone":6,"inSection":"sec-edge-3","realisation":"checked"},
    {"id":"edg-009","kind":"requirement","statement":"A tenant SHALL be able to serve its site from a domain name after proving control of that name.","rationale":"Proof first, so one tenant cannot claim another's name.","evaluate":{"method":"scenario"},"ref":"EDG-009","area":"05-delivery","section":"Domains and limits","lifecycle":"active","boundary":"b-3","boundaryDetail":"`domain binding`","traces":["g-21"],"milestone":6,"inSection":"sec-edge-4","realisation":"checked"},
    {"id":"edg-010","kind":"requirement","statement":"The certificate of a tenant domain SHALL be renewed before it expires.","rationale":"Certificates are the platform's job.","evaluate":{"method":"scenario"},"ref":"EDG-010","area":"05-delivery","section":"Domains and limits","lifecycle":"active","boundary":"b-3","boundaryDetail":"`certificate`","traces":["g-21"],"milestone":6,"inSection":"sec-edge-4","realisation":"checked"},
    {"id":"edg-011","kind":"requirement","statement":"A host name bound to no tenant SHALL receive a not-found response without contact with a tenant database.","rationale":"Unknown hosts are answered from the directory copy alone.","evaluate":{"method":"scenario"},"ref":"EDG-011","area":"05-delivery","section":"Domains and limits","lifecycle":"active","boundary":"b-9","boundaryDetail":"`Host`","traces":["g-20"],"milestone":6,"inSection":"sec-edge-4","realisation":"checked"},
    {"id":"edg-012","kind":"requirement","statement":"A private media file SHALL be delivered only through an address signed for the requesting principal with an expiry.","rationale":"Private files use the edge without becoming public.","evaluate":{"method":"scenario"},"ref":"EDG-012","area":"05-delivery","section":"Domains and limits","lifecycle":"active","boundary":"b-10","boundaryDetail":"`signed address`","traces":["g-33","g-20"],"milestone":11,"inSection":"sec-edge-4","realisation":"checked"},
    {"id":"edg-013","kind":"requirement","statement":"A request rate above the limit of a tenant SHALL receive a throttling response at the gateway.","rationale":"Limits are applied before work is done.","evaluate":{"method":"scenario"},"ref":"EDG-013","area":"05-delivery","section":"Domains and limits","lifecycle":"active","boundary":"b-9","boundaryDetail":"`429`","traces":["g-4"],"milestone":6,"inSection":"sec-edge-4","realisation":"checked"},
    {"id":"agt-001","kind":"requirement","statement":"Every operation available through the authoring application SHALL be listed in the operation catalogue with its input schema.","rationale":"There is no capability reachable only through a screen.","evaluate":{"method":"property"},"ref":"AGT-001","area":"06-agents","section":"Discover","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /operations`","traces":["g-23","d-18"],"milestone":7,"inSection":"sec-agents-2","realisation":"checked"},
    {"id":"agt-002","kind":"requirement","statement":"The operation catalogue SHALL mark for the requesting principal each operation that its policies permit it to attempt.","rationale":"An agent plans with what it can do, not with everything that exists.","evaluate":{"method":"scenario"},"ref":"AGT-002","area":"06-agents","section":"Discover","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /operations`","traces":["g-24"],"milestone":7,"inSection":"sec-agents-2","realisation":"checked"},
    {"id":"agt-003","kind":"requirement","statement":"The operation catalogue of a tenant SHALL reflect a change of its schema version without a deployment.","rationale":"Operations over tenant objects come from tenant metadata.","evaluate":{"method":"scenario"},"ref":"AGT-003","area":"06-agents","section":"Discover","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /operations`","traces":["g-23","g-31"],"milestone":7,"inSection":"sec-agents-2","realisation":"checked"},
    {"id":"agt-004","kind":"requirement","statement":"The agent gateway SHALL expose the operation catalogue through the Model Context Protocol.","rationale":"The standard way for agents to find and call tools.","evaluate":{"method":"scenario"},"ref":"AGT-004","area":"06-agents","section":"Discover","lifecycle":"active","boundary":"b-11","boundaryDetail":"`Model Context Protocol`","traces":["g-23","k-14"],"milestone":7,"inSection":"sec-agents-2","realisation":"checked"},
    {"id":"agt-005","kind":"requirement","statement":"The catalogue entry of an operation SHALL name the requirements of this specification that it implements.","rationale":"An agent can ask what an operation is supposed to guarantee.","evaluate":{"method":"scenario"},"ref":"AGT-005","area":"06-agents","section":"Discover","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /operations/{name}`","traces":["g-41"],"milestone":7,"inSection":"sec-agents-2","realisation":"checked"},
    {"id":"agt-006","kind":"requirement","statement":"The platform SHALL publish its component topology, configuration and health in machine-readable form.","rationale":"Self-description is what lets an agent diagnose instead of guess.","evaluate":{"method":"scenario"},"ref":"AGT-006","area":"06-agents","section":"Discover","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /platform`","traces":["g-27"],"milestone":7,"inSection":"sec-agents-2","realisation":"checked"},
    {"id":"agt-007","kind":"requirement","statement":"The agent gateway SHALL deliver to a subscribed agent the domain events that the policies of its principal permit it to read.","rationale":"Watching is the other half of operating.","evaluate":{"method":"scenario"},"ref":"AGT-007","area":"06-agents","section":"Discover","lifecycle":"active","boundary":"b-11","boundaryDetail":"`event stream`","traces":["g-23"],"milestone":7,"inSection":"sec-agents-2","realisation":"checked"},
    {"id":"agt-008","kind":"requirement","statement":"An operation invoked as a dry run SHALL return the state changes it would make without committing them.","rationale":"The kernel already separates deciding from committing.","evaluate":{"method":"scenario"},"ref":"AGT-008","area":"06-agents","section":"Try and explain","lifecycle":"active","boundary":"b-11","boundaryDetail":"`dry run`","traces":["g-24"],"milestone":7,"seam":2,"inSection":"sec-agents-3","realisation":"checked"},
    {"id":"agt-009","kind":"requirement","statement":"A rejected operation SHALL return the checks that failed in machine-readable form.","rationale":"The same evidence a form shows a person.","evaluate":{"method":"scenario"},"ref":"AGT-009","area":"06-agents","section":"Try and explain","lifecycle":"active","boundary":"b-11","boundaryDetail":"`error`","traces":["g-24"],"milestone":7,"inSection":"sec-agents-3","realisation":"checked"},
    {"id":"agt-010","kind":"requirement","statement":"The result of an applied change SHALL name an inverse operation or state that none exists.","rationale":"Reversibility is declared per operation.","evaluate":{"method":"scenario"},"ref":"AGT-010","area":"06-agents","section":"Try and explain","lifecycle":"active","boundary":"b-11","boundaryDetail":"`inverse`","traces":["g-25"],"milestone":7,"inSection":"sec-agents-3","realisation":"checked"},
    {"id":"agt-011","kind":"requirement","statement":"A change classed as risky by tenant policy SHALL be applied only from an approved proposal.","rationale":"Modelled as the proposal flow, with an unapproved apply as its negative.","evaluate":{"method":"scenario"},"ref":"AGT-011","area":"06-agents","section":"Propose and approve","lifecycle":"active","boundary":"b-11","boundaryDetail":"`proposal`","traces":["g-26","d-19"],"milestone":7,"inSection":"sec-agents-4","realisation":"checked"},
    {"id":"agt-012","kind":"requirement","statement":"A proposal SHALL carry the projection of its change against the recorded history of the tenant.","rationale":"The approver sees consequences, not intentions.","evaluate":{"method":"scenario"},"ref":"AGT-012","area":"06-agents","section":"Propose and approve","lifecycle":"active","boundary":"b-20","boundaryDetail":"`proposal`","traces":["g-26","g-44"],"milestone":7,"inSection":"sec-agents-4","realisation":"checked"},
    {"id":"agt-013","kind":"requirement","statement":"An approved proposal SHALL be refused when the revision of the tenant differs from the revision it was projected against.","rationale":"An approval is for one state of the world.","evaluate":{"method":"property"},"ref":"AGT-013","area":"06-agents","section":"Propose and approve","lifecycle":"active","boundary":"b-11","boundaryDetail":"`proposal`","traces":["g-26"],"milestone":7,"inSection":"sec-agents-4","realisation":"checked"},
    {"id":"agt-014","kind":"requirement","statement":"An operation performed by an agent SHALL be authorised by the same policies as that operation performed by a person.","rationale":"There is one authorisation path.","evaluate":{"method":"property"},"ref":"AGT-014","area":"06-agents","section":"Authorise, attribute and limit","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["k-13"],"milestone":7,"inSection":"sec-agents-5","realisation":"checked"},
    {"id":"agt-015","kind":"requirement","statement":"Every operation performed by an agent SHALL be recorded with the agent, the person it acted for and the correlation identifier.","rationale":"Who, for whom, and which request.","evaluate":{"method":"property"},"ref":"AGT-015","area":"06-agents","section":"Authorise, attribute and limit","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit entry`","traces":["g-25"],"milestone":7,"inSection":"sec-agents-5","realisation":"checked"},
    {"id":"agt-016","kind":"requirement","statement":"The requests of a disabled agent SHALL be refused by the agent gateway.","rationale":"The kill switch does not wait for a token to expire.","evaluate":{"method":"scenario"},"ref":"AGT-016","area":"06-agents","section":"Authorise, attribute and limit","lifecycle":"active","boundary":"b-11","boundaryDetail":"`agent state`","traces":["g-28"],"milestone":7,"inSection":"sec-agents-5","realisation":"checked"},
    {"id":"agt-017","kind":"requirement","statement":"An agent that exceeds its operation budget SHALL be refused until the budget window ends.","rationale":"A runaway loop is bounded by volume.","evaluate":{"method":"scenario"},"ref":"AGT-017","area":"06-agents","section":"Authorise, attribute and limit","lifecycle":"active","boundary":"b-11","boundaryDetail":"`operation budget`","traces":["g-28"],"milestone":7,"inSection":"sec-agents-5","realisation":"checked"},
    {"id":"obs-001","kind":"requirement","statement":"Every log line, span and audit entry produced for a request SHALL carry the correlation identifier of that request.","rationale":"One search finds the whole story.","evaluate":{"method":"property"},"ref":"OBS-001","area":"06-agents","section":"Telemetry","lifecycle":"active","boundary":"b-12","boundaryDetail":"`correlation identifier`","traces":["g-29"],"milestone":8,"seam":1,"inSection":"sec-observability-2","realisation":"checked"},
    {"id":"obs-002","kind":"requirement","statement":"Each process of the platform other than the telemetry pipeline, and each store that holds tenant content, SHALL export traces, metrics and logs through the OpenTelemetry protocol.","rationale":"One collector, any backend. A library, an external service and a client program export nothing: the process that hosts or calls it does.","evaluate":{"method":"scenario"},"ref":"OBS-002","area":"06-agents","section":"Telemetry","lifecycle":"active","boundary":"b-12","boundaryDetail":"`OpenTelemetry protocol`","traces":["k-14","g-27","d-21"],"milestone":8,"seam":2,"inSection":"sec-observability-2","realisation":"checked"},
    {"id":"obs-003","kind":"requirement","statement":"Telemetry SHALL carry the tenant identifier and no content of a tenant record.","rationale":"Operational data can be shared with operators and agents that may not read tenant data.","evaluate":{"method":"property"},"ref":"OBS-003","area":"06-agents","section":"Telemetry","lifecycle":"active","boundary":"b-12","boundaryDetail":"`telemetry`","traces":["k-2","g-29"],"milestone":8,"inSection":"sec-observability-2","realisation":"checked"},
    {"id":"obs-004","kind":"requirement","statement":"A component SHALL report readiness only while its dependencies answer.","rationale":"Health that can be trusted for routing and for diagnosis.","evaluate":{"method":"scenario"},"ref":"OBS-004","area":"06-agents","section":"Telemetry","lifecycle":"active","boundary":"b-12","boundaryDetail":"`readiness`","traces":["g-27"],"milestone":8,"seam":2,"inSection":"sec-observability-2","realisation":"checked"},
    {"id":"obs-005","kind":"requirement","statement":"A service level objective SHALL be stored as data with the query that measures it.","rationale":"Objectives are inspectable and changeable by the same means as everything else.","evaluate":{"method":"scenario"},"ref":"OBS-005","area":"06-agents","section":"Telemetry","lifecycle":"active","boundary":"b-12","boundaryDetail":"`service level objective`","traces":["g-27"],"milestone":8,"inSection":"sec-observability-2","realisation":"checked"},
    {"id":"obs-006","kind":"requirement","statement":"An audit entry SHALL contain the hash of the entry before it.","rationale":"The chain is what makes a removal visible.","evaluate":{"method":"property"},"ref":"OBS-006","area":"06-agents","section":"Audit","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit entry`","traces":["g-30","d-20","d-527"],"milestone":8,"seam":3,"inSection":"sec-observability-3","realisation":"checked"},
    {"id":"obs-007","kind":"requirement","statement":"Verification of an audit log from which an entry was removed SHALL report the break.","rationale":"The negative case of the chain.","evaluate":{"method":"scenario"},"ref":"OBS-007","area":"06-agents","section":"Audit","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit verification`","traces":["g-30"],"milestone":8,"inSection":"sec-observability-3","realisation":"checked"},
    {"id":"obs-008","kind":"requirement","statement":"The audit log of a tenant SHALL be exportable by the owner of that tenant.","rationale":"The record belongs to the tenant.","evaluate":{"method":"scenario"},"ref":"OBS-008","area":"06-agents","section":"Audit","lifecycle":"active","boundary":"b-12","boundaryDetail":"`GET /audit`","traces":["g-30","g-11"],"milestone":8,"inSection":"sec-observability-3","realisation":"checked"},
    {"id":"cms-001","kind":"requirement","statement":"The publication template SHALL install as tenant metadata through kernel intents.","rationale":"The blog is data, and installing it exercises the kernel like any other change.","evaluate":{"method":"scenario"},"ref":"CMS-001","area":"07-content","section":"Model","lifecycle":"active","boundary":"b-21","boundaryDetail":"`tenant bundle`","traces":["g-31"],"milestone":1,"inSection":"sec-content-2","realisation":"checked"},
    {"id":"cms-002","kind":"requirement","statement":"A delivery response SHALL be produced from named queries and view definitions held as tenant metadata.","rationale":"No page is written into platform code.","evaluate":{"method":"scenario"},"ref":"CMS-002","area":"07-content","section":"Model","lifecycle":"active","boundary":"b-9","boundaryDetail":"`view`","traces":["g-31"],"milestone":1,"inSection":"sec-content-2","realisation":"checked"},
    {"id":"cms-003","kind":"requirement","statement":"A draft SHALL be invisible to principals whose policies permit published content alone.","rationale":"Visibility is policy, evaluated by the kernel.","evaluate":{"method":"scenario"},"ref":"CMS-003","area":"07-content","section":"Model","lifecycle":"active","boundary":"b-9","boundaryDetail":"`view`","traces":["g-20"],"milestone":1,"inSection":"sec-content-2","realisation":"checked"},
    {"id":"cms-004","kind":"requirement","statement":"Tenant-authored rich text SHALL reach the browser as structured blocks with markup left as text.","rationale":"Nothing a tenant writes is parsed as HTML.","evaluate":{"method":"example"},"ref":"CMS-004","area":"07-content","section":"Model","lifecycle":"active","boundary":"b-9","boundaryDetail":"`strata_substrate::markdown::parse`","traces":["k-12"],"milestone":1,"inSection":"sec-content-2","realisation":"checked"},
    {"id":"cms-005","kind":"requirement","statement":"A theme value that is not a value of the token schema SHALL be rejected.","rationale":"A tenant selects tokens and supplies no style.","evaluate":{"method":"example"},"ref":"CMS-005","area":"07-content","section":"Model","lifecycle":"active","boundary":"b-21","boundaryDetail":"`theme tokens`","traces":["k-12"],"milestone":1,"inSection":"sec-content-2","realisation":"checked"},
    {"id":"cms-006","kind":"requirement","statement":"Each published version of a record SHALL be retrievable.","rationale":"History is kept, not reconstructed.","evaluate":{"method":"scenario"},"ref":"CMS-006","area":"07-content","section":"Versions, media and languages","lifecycle":"active","boundary":"b-9","boundaryDetail":"`GET /records/{id}/versions`","traces":["g-32"],"milestone":11,"inSection":"sec-content-3","realisation":"checked"},
    {"id":"cms-007","kind":"requirement","statement":"Restoring an earlier version SHALL create a new version with the earlier content.","rationale":"Restore moves forward, so history stays linear.","evaluate":{"method":"scenario"},"ref":"CMS-007","area":"07-content","section":"Versions, media and languages","lifecycle":"active","boundary":"b-9","boundaryDetail":"`POST /records/{id}/restore`","traces":["g-32"],"milestone":11,"inSection":"sec-content-3","realisation":"checked"},
    {"id":"cms-008","kind":"requirement","statement":"An uploaded file SHALL be stored in the file namespace of its tenant under its content hash.","rationale":"Files follow the tenant like records do.","evaluate":{"method":"scenario"},"ref":"CMS-008","area":"07-content","section":"Versions, media and languages","lifecycle":"active","boundary":"b-14","boundaryDetail":"`file store`","traces":["g-33"],"milestone":11,"seam":2,"inSection":"sec-content-3","realisation":"checked"},
    {"id":"cms-009","kind":"requirement","statement":"A rendition SHALL be produced from a stored file by a job.","rationale":"Slow work is scheduled work.","evaluate":{"method":"scenario"},"ref":"CMS-009","area":"07-content","section":"Versions, media and languages","lifecycle":"active","boundary":"b-7","boundaryDetail":"`rendition job`","traces":["g-33"],"milestone":11,"inSection":"sec-content-3","realisation":"checked"},
    {"id":"cms-010","kind":"requirement","statement":"A record requested in a language it lacks SHALL be answered in the fallback language of the tenant.","rationale":"A missing translation is not a missing page.","evaluate":{"method":"scenario"},"ref":"CMS-010","area":"07-content","section":"Versions, media and languages","lifecycle":"active","boundary":"b-9","boundaryDetail":"`Accept-Language`","traces":["g-34"],"milestone":11,"inSection":"sec-content-3","realisation":"checked"},
    {"id":"cms-011","kind":"requirement","statement":"A preview SHALL render unpublished content through the view definitions that delivery uses.","rationale":"What the author sees is what readers will get.","evaluate":{"method":"scenario"},"ref":"CMS-011","area":"07-content","section":"Versions, media and languages","lifecycle":"active","boundary":"b-9","boundaryDetail":"`preview`","traces":["g-35"],"milestone":11,"inSection":"sec-content-3","realisation":"checked"},
    {"id":"cms-012","kind":"requirement","statement":"The authoring application SHALL meet WCAG 2.2 level AA.","rationale":"Authors are users too.","evaluate":{"method":"example"},"ref":"CMS-012","area":"07-content","section":"Versions, media and languages","lifecycle":"active","boundary":"b-13","boundaryDetail":"`authoring application`","traces":["g-45"],"milestone":11,"inSection":"sec-content-3","realisation":"checked"},
    {"id":"dep-001","kind":"requirement","statement":"A single command SHALL start every platform component and its dependencies in containers on one machine.","rationale":"The whole system is something a developer or an agent can hold.","evaluate":{"method":"scenario"},"ref":"DEP-001","area":"08-platform","section":"Local stack and seams","lifecycle":"active","boundary":"b-19","boundaryDetail":"`compose file`","traces":["g-36","d-22"],"milestone":2,"inSection":"sec-platform-2","realisation":"checked"},
    {"id":"dep-002","kind":"requirement","statement":"The local stack SHALL start without credentials for a cloud provider.","rationale":"No account, no bill, no network.","evaluate":{"method":"scenario"},"ref":"DEP-002","area":"08-platform","section":"Local stack and seams","lifecycle":"active","boundary":"b-19","boundaryDetail":"`compose file`","traces":["k-10"],"milestone":2,"inSection":"sec-platform-2","realisation":"checked"},
    {"id":"dep-003","kind":"requirement","statement":"Each infrastructure seam SHALL have the contract, the local adapter and the cloud adapter that the seam table names.","rationale":"The table is the list of everything that may differ between local and cloud.","evaluate":{"method":"conformance"},"ref":"DEP-003","area":"08-platform","section":"Local stack and seams","lifecycle":"active","boundary":"b-19","boundaryDetail":"`seam`","traces":["g-38","d-24"],"milestone":2,"cases":["cases-seams"],"inSection":"sec-platform-2","realisation":"checked"},
    {"id":"dep-004","kind":"requirement","statement":"Each adapter of a seam SHALL pass the conformance suite of that seam.","rationale":"An adapter is accepted by behaviour, as the store adapters already are.","evaluate":{"method":"scenario"},"ref":"DEP-004","area":"08-platform","section":"Local stack and seams","lifecycle":"active","boundary":"b-19","boundaryDetail":"`conformance suite`","traces":["g-38"],"milestone":2,"inSection":"sec-platform-2","realisation":"checked"},
    {"id":"dep-005","kind":"requirement","statement":"A request SHALL be answerable by every running instance of the component it is addressed to.","rationale":"Instances are interchangeable, so they can be added, removed and replaced.","evaluate":{"method":"scenario"},"ref":"DEP-005","area":"08-platform","section":"Local stack and seams","lifecycle":"active","boundary":"b-19","boundaryDetail":"`instance`","traces":["k-5"],"milestone":2,"inSection":"sec-platform-2","realisation":"checked"},
    {"id":"dep-006","kind":"requirement","statement":"A component SHALL read its configuration from its environment.","rationale":"The image is the same everywhere and only the environment differs.","evaluate":{"method":"scenario"},"ref":"DEP-006","area":"08-platform","section":"Local stack and seams","lifecycle":"active","boundary":"b-19","boundaryDetail":"`environment`","traces":["g-37","d-510"],"milestone":2,"inSection":"sec-platform-2","realisation":"checked"},
    {"id":"dep-007","kind":"requirement","statement":"The cloud profile SHALL be created from version-controlled infrastructure definitions without a manual step.","rationale":"An environment is reproducible, and an agent can read what it is made of.","evaluate":{"method":"scenario"},"ref":"DEP-007","area":"08-platform","section":"Cloud profile","lifecycle":"active","boundary":"b-19","boundaryDetail":"`infrastructure modules`","traces":["g-37","d-23","d-501","d-502"],"milestone":12,"inSection":"sec-platform-3","realisation":"checked"},
    {"id":"dep-008","kind":"requirement","statement":"A component image SHALL run unchanged in the local stack and in the cloud profile.","rationale":"What was tested is what is deployed.","evaluate":{"method":"scenario"},"ref":"DEP-008","area":"08-platform","section":"Cloud profile","lifecycle":"active","boundary":"b-19","boundaryDetail":"`image`","traces":["g-37"],"milestone":12,"inSection":"sec-platform-3","realisation":"checked"},
    {"id":"dep-009","kind":"requirement","statement":"A release SHALL refuse no request that the live colour of its component can answer.","rationale":"Releases are routine, and each is a colour switch (REL-566 to REL-568).","evaluate":{"method":"scenario"},"ref":"DEP-009","area":"08-platform","section":"Cloud profile","lifecycle":"active","boundary":"b-19","boundaryDetail":"`deployment`","traces":["g-37"],"milestone":12,"inSection":"sec-platform-3","realisation":"checked"},
    {"id":"dep-010","kind":"requirement","statement":"After the loss of one zone the platform SHALL serve requests again within 15 minutes.","rationale":"The recovery time objective.","evaluate":{"method":"budget"},"ref":"DEP-010","area":"08-platform","section":"Cloud profile","lifecycle":"active","boundary":"b-19","boundaryDetail":"`zone loss`","traces":["g-39"],"milestone":12,"inSection":"sec-platform-3","realisation":"operational"},
    {"id":"dep-011","kind":"requirement","statement":"A restored tenant SHALL lose at most 5 minutes of committed changes.","rationale":"The recovery point objective.","evaluate":{"method":"budget"},"ref":"DEP-011","area":"08-platform","section":"Cloud profile","lifecycle":"active","boundary":"b-19","boundaryDetail":"`restore`","traces":["g-39"],"milestone":12,"inSection":"sec-platform-3","realisation":"operational"},
    {"id":"sec-001","kind":"requirement","statement":"The stored data of each tenant SHALL be encrypted under a key held for that tenant alone.","rationale":"One tenant's key opens nothing else.","evaluate":{"method":"property"},"ref":"SEC-001","area":"08-platform","section":"Keys and credentials","lifecycle":"active","boundary":"b-17","boundaryDetail":"`data key`","traces":["g-40","d-25","d-505"],"milestone":2,"seam":2,"inSection":"sec-platform-4","realisation":"checked"},
    {"id":"sec-002","kind":"requirement","statement":"Destroying the key of a tenant SHALL make the stored data and the backups of that tenant unreadable.","rationale":"Deletion that reaches backups.","evaluate":{"method":"scenario"},"ref":"SEC-002","area":"08-platform","section":"Keys and credentials","lifecycle":"active","boundary":"b-17","boundaryDetail":"`destroy key`","traces":["g-40"],"milestone":2,"inSection":"sec-platform-4","realisation":"checked"},
    {"id":"sec-003","kind":"requirement","statement":"A secret SHALL be stored only in encrypted form, with its wrapping key held by the key service.","rationale":"The database alone is not enough to read a secret.","evaluate":{"method":"scenario"},"ref":"SEC-003","area":"08-platform","section":"Keys and credentials","lifecycle":"active","boundary":"b-17","boundaryDetail":"`wrap`","traces":["g-40"],"milestone":3,"inSection":"sec-platform-4","realisation":"checked"},
    {"id":"sec-004","kind":"requirement","statement":"A call between platform components SHALL carry a credential issued to the calling component.","rationale":"Replaces the single shared service token of the prototype.","evaluate":{"method":"scenario"},"ref":"SEC-004","area":"08-platform","section":"Keys and credentials","lifecycle":"active","boundary":"b-6","boundaryDetail":"`component credential`","traces":["k-6","g-12"],"milestone":2,"inSection":"sec-platform-4","realisation":"checked"},
    {"id":"sec-005","kind":"requirement","statement":"A platform component SHALL reach a tenant database only through the store contract.","rationale":"Checked structurally by Exegra on the component model and by Concordance on the code.","evaluate":{"method":"property"},"ref":"SEC-005","area":"08-platform","section":"Keys and credentials","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["k-3"],"milestone":2,"inSection":"sec-platform-4","realisation":"construction"},
    {"id":"asr-001","kind":"requirement","statement":"The gate SHALL fail while a requirement of a started milestone has no proof with a recorded passing result.","rationale":"Done is something the tools say, not something a person says.","evaluate":{"method":"scenario"},"ref":"ASR-001","area":"08-platform","section":"Assurance","lifecycle":"active","boundary":"b-19","boundaryDetail":"`gate`","traces":["g-41","k-15","d-26"],"milestone":2,"inSection":"sec-platform-5","realisation":"checked"},
    {"id":"asr-002","kind":"requirement","statement":"Each behaviour claim that Exegra evaluates in this specification SHALL declare a run that violates it.","rationale":"A check that cannot fail shows nothing.","evaluate":{"method":"scenario"},"ref":"ASR-002","area":"08-platform","section":"Assurance","lifecycle":"active","boundary":"b-20","boundaryDetail":"`behaviour claim`","traces":["g-42"],"milestone":2,"inSection":"sec-platform-5","realisation":"checked"},
    {"id":"ops-300","kind":"requirement","statement":"The reference load SHALL hold the tenant, request, payload and connection values that the reference load table states.","rationale":"Every budget is measured under one stated load, so the numbers mean the same in every run.","evaluate":{"method":"conformance"},"ref":"OPS-300","area":"09-operations","section":"Reference load","lifecycle":"active","boundary":"b-19","boundaryDetail":"`benchmark harness`","traces":["g-300","g-4","d-518"],"milestone":2,"cases":["cases-reference-load"],"inSection":"sec-operations-2","realisation":"checked"},
    {"id":"ops-301","kind":"requirement","statement":"When the work queued for a cluster is at the queue limit of that cluster, the gateway SHALL refuse a further request for that cluster with a throttling response, without queuing it.","rationale":"Refusing early keeps a backlog from turning every request into a late failure.","evaluate":{"method":"scenario"},"ref":"OPS-301","area":"09-operations","section":"Admission and deadlines","lifecycle":"active","boundary":"b-9","boundaryDetail":"`429`","traces":["g-301","k-300"],"milestone":6,"inSection":"sec-operations-3","realisation":"checked"},
    {"id":"ops-302","kind":"requirement","statement":"Under overload, the gateway SHALL refuse requests for authoring and sign-in before it refuses requests for published content.","rationale":"Published content is the part of the platform that readers depend on most.","evaluate":{"method":"scenario"},"ref":"OPS-302","area":"09-operations","section":"Admission and deadlines","lifecycle":"active","boundary":"b-9","boundaryDetail":"`429`","traces":["g-301","g-18"],"milestone":6,"inSection":"sec-operations-3","realisation":"checked"},
    {"id":"ops-303","kind":"requirement","statement":"A request admitted by the gateway SHALL receive a final response within 10 seconds, counting the retries it made.","rationale":"A caller waits a bounded time, whatever the dependencies below the gateway are doing.","evaluate":{"method":"budget"},"ref":"OPS-303","area":"09-operations","section":"Admission and deadlines","lifecycle":"active","boundary":"b-9","boundaryDetail":"`gateway request`","traces":["g-301"],"milestone":6,"inSection":"sec-operations-3","realisation":"operational"},
    {"id":"ops-304","kind":"requirement","statement":"A slow call to an external address SHALL occupy connector capacity only for the tenant that made the call.","rationale":"One tenant's slow endpoint does not starve the connectors of other tenants.","evaluate":{"method":"scenario"},"ref":"OPS-304","area":"09-operations","section":"Dependencies and retries","lifecycle":"active","boundary":"b-8","boundaryDetail":"`connector slot`","traces":["g-4","g-301"],"milestone":5,"inSection":"sec-operations-4","realisation":"checked"},
    {"id":"ops-305","kind":"requirement","statement":"Every retry between platform components SHALL be bounded in attempts, in total time and by jitter in its delay.","rationale":"Unbounded retries turn one failing dependency into a load that keeps it failing.","evaluate":{"method":"property"},"ref":"OPS-305","area":"09-operations","section":"Dependencies and retries","lifecycle":"active","boundary":"b-19","boundaryDetail":"`retry policy`","traces":["g-301"],"milestone":2,"inSection":"sec-operations-4","realisation":"checked"},
    {"id":"ops-306","kind":"requirement","statement":"When the retries of one component to one dependency exceed the share of its first attempts that D-700 states within the window that D-700 states, the component SHALL make no further retries to that dependency until that window ends.","rationale":"A retry budget gives a struggling dependency room to recover.","evaluate":{"method":"scenario"},"ref":"OPS-306","area":"09-operations","section":"Dependencies and retries","lifecycle":"active","boundary":"b-19","boundaryDetail":"`retry budget`","traces":["g-301","d-700"],"milestone":2,"inSection":"sec-operations-4","realisation":"checked"},
    {"id":"ops-307","kind":"requirement","statement":"When calls from a component to a dependency keep failing, the component SHALL stop calling that dependency for the cool-down period that D-700 states, answering from its stored copies or refusing without waiting.","rationale":"A dependency that is down is answered from what the platform already holds, not called again at once.","evaluate":{"method":"scenario"},"ref":"OPS-307","area":"09-operations","section":"Dependencies and retries","lifecycle":"active","boundary":"b-19","boundaryDetail":"`circuit`","traces":["g-301","d-700"],"milestone":2,"inSection":"sec-operations-4","realisation":"checked"},
    {"id":"ops-308","kind":"requirement","statement":"After every instance of a component restarts, the requests that refill its stored copies SHALL be released at the rate that D-700 states in each cluster.","rationale":"A restart of the whole fleet otherwise sends every tenant's first read to its database at once.","evaluate":{"method":"scenario"},"ref":"OPS-308","area":"09-operations","section":"Dependencies and retries","lifecycle":"active","boundary":"b-15","boundaryDetail":"`copy store`","traces":["g-301","g-4","d-700"],"milestone":6,"inSection":"sec-operations-4","realisation":"checked"},
    {"id":"ops-309","kind":"requirement","statement":"The platform SHALL report, in each cluster, the time remaining before each capacity measure reaches its limit, computed from the trend of its recent window.","rationale":"A forecast turns a capacity alert into a planned change.","evaluate":{"method":"scenario"},"ref":"OPS-309","area":"09-operations","section":"Capacity and fan-out","lifecycle":"active","boundary":"b-12","boundaryDetail":"`capacity report`","traces":["g-304"],"milestone":10,"inSection":"sec-operations-5","realisation":"checked"},
    {"id":"ops-310","kind":"requirement","statement":"The platform SHALL report each tenant whose share of a cluster's connections or job runs stays above its fair share through the window that D-700 states, together with the measure that exceeded.","rationale":"A noisy tenant is visible before the other tenants on its cluster feel it.","evaluate":{"method":"scenario"},"ref":"OPS-310","area":"09-operations","section":"Capacity and fan-out","lifecycle":"active","boundary":"b-12","boundaryDetail":"`noisy neighbour report`","traces":["g-4","g-304","d-700"],"milestone":10,"inSection":"sec-operations-5","realisation":"checked"},
    {"id":"ops-311","kind":"requirement","statement":"A subscriber that takes events more slowly than they are committed SHALL NOT delay their delivery to the other subscribers of the same tenant.","rationale":"Webhooks and subscribers are outside the platform's control, and their speed stays their own problem.","evaluate":{"method":"scenario"},"ref":"OPS-311","area":"09-operations","section":"Capacity and fan-out","lifecycle":"active","boundary":"b-9","boundaryDetail":"`event stream`","traces":["g-301","g-4"],"milestone":2,"inSection":"sec-operations-5","realisation":"checked"},
    {"id":"ops-312","kind":"requirement","statement":"While the control database is unreachable, the gateway SHALL keep serving each tenant whose directory entry is younger than the age that ARC-500 allows and refuse each tenant whose entry records a deletion.","rationale":"The directory copy keeps published sites up through a control database outage, and a deleted tenant is not served from it.","evaluate":{"method":"scenario"},"ref":"OPS-312","area":"09-operations","section":"Failure containment","lifecycle":"active","boundary":"b-3","boundaryDetail":"`directory entry`","traces":["g-301","g-20"],"milestone":2,"inSection":"sec-operations-6","realisation":"checked"},
    {"id":"ops-313","kind":"requirement","statement":"While the key service is unreachable, the platform SHALL serve published pages and requests that read no encrypted field, refusing other requests with a response that names the outage.","rationale":"Only the requests that need a tenant data key depend on the key service.","evaluate":{"method":"scenario"},"ref":"OPS-313","area":"09-operations","section":"Failure containment","lifecycle":"active","boundary":"b-17","boundaryDetail":"`key service contract`","traces":["g-40","g-301"],"milestone":3,"inSection":"sec-operations-6","realisation":"checked"},
    {"id":"ops-314","kind":"requirement","statement":"While the mail service is unreachable, mail SHALL wait in a queue and leave in the order it was queued once the service answers.","rationale":"A sign-in link that arrives late is still a valid sign-in link, and ordered mail keeps notices in sequence.","evaluate":{"method":"scenario"},"ref":"OPS-314","area":"09-operations","section":"Failure containment","lifecycle":"active","boundary":"b-18","boundaryDetail":"`mail contract`","traces":["g-6","g-301"],"milestone":3,"inSection":"sec-operations-6","realisation":"checked"},
    {"id":"ops-315","kind":"requirement","statement":"While the content delivery network is unavailable, the origin SHALL refuse page renders beyond its admission limit with a response that names the outage.","rationale":"Without the edge, every page render reaches the origin, so the origin needs its own limit.","evaluate":{"method":"scenario"},"ref":"OPS-315","area":"09-operations","section":"Failure containment","lifecycle":"active","boundary":"b-10","boundaryDetail":"`origin response`","traces":["g-18","g-301"],"milestone":6,"inSection":"sec-operations-6","realisation":"checked"},
    {"id":"ops-316","kind":"requirement","statement":"A freshness check SHALL treat a stored copy whose age has decreased since its last check as expired.","rationale":"A clock that steps backwards would otherwise keep a copy fresh for as long as the step lasts.","evaluate":{"method":"property"},"ref":"OPS-316","area":"09-operations","section":"Failure containment","lifecycle":"active","boundary":"b-15","boundaryDetail":"`freshness check`","traces":["g-19","k-8"],"milestone":6,"inSection":"sec-operations-6","realisation":"checked"},
    {"id":"ops-317","kind":"requirement","statement":"A commit interrupted by the failover of a tenant database SHALL be reported to its caller as committed or as not committed, never as both.","rationale":"A caller that retries after an unknown outcome needs one answer that is true.","evaluate":{"method":"property"},"ref":"OPS-317","area":"09-operations","section":"Failure containment","lifecycle":"active","boundary":"b-2","boundaryDetail":"`commit`","traces":["g-39","g-14"],"milestone":12,"inSection":"sec-operations-6","realisation":"checked"},
    {"id":"ops-318","kind":"requirement","statement":"A request that repeats an intent whose idempotency key the tenant has already committed SHALL receive the first result, without a second commit.","rationale":"Browsers and agents retry. A repeated intent changes the tenant only once.","evaluate":{"method":"scenario"},"ref":"OPS-318","area":"09-operations","section":"Failure containment","lifecycle":"active","boundary":"b-2","boundaryDetail":"`Idempotency-Key`","traces":["g-15","g-14"],"milestone":2,"inSection":"sec-operations-6","realisation":"checked"},
    {"id":"ops-320","kind":"requirement","statement":"A tenant database SHALL keep a restorable window of at least 14 days.","rationale":"A window shorter than the time it takes to notice a bad change leaves nothing to restore to.","evaluate":{"method":"budget"},"ref":"OPS-320","area":"09-operations","section":"Data safety","lifecycle":"active","boundary":"b-3","boundaryDetail":"`tenant restore`","traces":["g-302","g-1","d-522"],"milestone":12,"inSection":"sec-operations-7","realisation":"operational"},
    {"id":"ops-321","kind":"requirement","statement":"A restore drill SHALL restore a backup of each tenant of the drill into a separate database, and it fails, naming the tenant, when the restored state hash differs from the hash its journal records.","rationale":"A backup that has never been restored is an assumption, and the state hash is the proof that it works.","evaluate":{"method":"scenario"},"ref":"OPS-321","area":"09-operations","section":"Data safety","lifecycle":"active","boundary":"b-3","boundaryDetail":"`tenant restore`","traces":["g-302"],"milestone":12,"inSection":"sec-operations-7","realisation":"operational"},
    {"id":"ops-322","kind":"requirement","statement":"The platform SHALL recompute the state hash of each tenant from its journal on a schedule, reporting with the tenant identifier each tenant whose hash differs.","rationale":"Silent corruption is found by the platform, not by the first reader who notices it.","evaluate":{"method":"scenario"},"ref":"OPS-322","area":"09-operations","section":"Data safety","lifecycle":"active","boundary":"b-12","boundaryDetail":"`integrity report`","traces":["g-302","g-30"],"milestone":10,"inSection":"sec-operations-7","realisation":"checked"},
    {"id":"ops-323","kind":"requirement","statement":"A layout change SHALL be applied in waves, and each wave stops the change when the share of its tenants that failed exceeds the limit that D-700 states.","rationale":"A bad layout reaches a few tenants before it reaches all of them.","evaluate":{"method":"scenario"},"ref":"OPS-323","area":"09-operations","section":"Data safety","lifecycle":"active","boundary":"b-3","boundaryDetail":"`layout version`","traces":["g-1","g-303","d-700"],"milestone":2,"inSection":"sec-operations-7","realisation":"checked"},
    {"id":"ops-324","kind":"requirement","statement":"A layout change SHALL run its expanding phase on all tenants before any tenant runs its contracting phase.","rationale":"Expand and contract keeps the old and the new version of the layout readable at the same time.","evaluate":{"method":"scenario"},"ref":"OPS-324","area":"09-operations","section":"Data safety","lifecycle":"active","boundary":"b-3","boundaryDetail":"`layout version`","traces":["g-303","g-1"],"milestone":2,"inSection":"sec-operations-7","realisation":"checked"},
    {"id":"ops-325","kind":"requirement","statement":"An irreversible operation SHALL be refused unless its request repeats the identifier of the object it destroys.","rationale":"A name or a label typed by mistake does not destroy the wrong tenant.","evaluate":{"method":"scenario"},"ref":"OPS-325","area":"09-operations","section":"Data safety","lifecycle":"active","boundary":"b-3","boundaryDetail":"`tenant lifecycle operation`","traces":["g-22","k-302"],"milestone":2,"inSection":"sec-operations-7","realisation":"checked"},
    {"id":"ops-326","kind":"requirement","statement":"While two versions of a component run together, each version SHALL accept the requests and the events that the other writes, apart from the commit format that ARC-106 states.","rationale":"A rollout is a period in which both versions are live. The format of a commit is the subject of ARC-106 and is not stated twice.","evaluate":{"method":"scenario"},"ref":"OPS-326","area":"09-operations","section":"Releases and change","lifecycle":"active","boundary":"b-19","boundaryDetail":"`rolling deployment`","traces":["g-303","k-301"],"milestone":12,"inSection":"sec-operations-8","realisation":"checked"},
    {"id":"ops-327","kind":"requirement","statement":"A colour switch SHALL return traffic to the previous colour when a criterion named in its release record is breached while the new colour is live.","rationale":"Rollback is decided by criteria written before the release, not by an argument during the incident.","evaluate":{"method":"scenario"},"ref":"OPS-327","area":"09-operations","section":"Releases and change","lifecycle":"active","boundary":"b-19","boundaryDetail":"`deployment`","traces":["g-303"],"milestone":12,"inSection":"sec-operations-8","realisation":"checked"},
    {"id":"ops-328","kind":"requirement","statement":"A feature flag SHALL be off for a tenant unless the release record of the flag enables it for that tenant.","rationale":"A flag that is on by default is an unreviewed release.","evaluate":{"method":"property"},"ref":"OPS-328","area":"09-operations","section":"Releases and change","lifecycle":"active","boundary":"b-19","boundaryDetail":"`feature flag`","traces":["g-303","g-1"],"milestone":12,"inSection":"sec-operations-8","realisation":"checked"},
    {"id":"ops-329","kind":"requirement","statement":"A configuration change SHALL be recorded in the audit log with the previous value, the new value, the principal and the correlation identifier.","rationale":"A changed setting is a change of behaviour, and it is explained the same way as any other change.","evaluate":{"method":"scenario"},"ref":"OPS-329","area":"09-operations","section":"Releases and change","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit entry`","traces":["g-30"],"milestone":10,"inSection":"sec-operations-8","realisation":"checked"},
    {"id":"ops-331","kind":"requirement","statement":"The delivery of published content SHALL answer at least 99.95 percent of its requests without a platform error over each window of 30 days.","rationale":"Readers feel delivery first, so its objective is the highest.","evaluate":{"method":"budget"},"ref":"OPS-331","area":"09-operations","section":"Objectives and budgets","lifecycle":"active","boundary":"b-9","boundaryDetail":"`delivery interface`","traces":["g-300","g-18"],"milestone":12,"inSection":"sec-operations-9","realisation":"operational"},
    {"id":"ops-332","kind":"requirement","statement":"The authoring application and the sign-in pages SHALL answer at least 99.9 percent of their requests without a platform error over each window of 30 days.","rationale":"Authoring and sign-in are used less than delivery, and each failure costs a person a whole session.","evaluate":{"method":"budget"},"ref":"OPS-332","area":"09-operations","section":"Objectives and budgets","lifecycle":"active","boundary":"b-13","boundaryDetail":"`authoring application`","traces":["g-300","g-6"],"milestone":12,"inSection":"sec-operations-9","realisation":"operational"},
    {"id":"ops-333","kind":"requirement","statement":"A delivery request answered from a stored copy SHALL complete within 100 ms at the 99th percentile.","rationale":"The read path of the design, held to a bound a reader cannot notice.","evaluate":{"method":"budget"},"ref":"OPS-333","area":"09-operations","section":"Objectives and budgets","lifecycle":"active","boundary":"b-9","boundaryDetail":"`delivery interface`","traces":["g-18","g-300"],"milestone":6,"inSection":"sec-operations-9","realisation":"operational"},
    {"id":"ops-334","kind":"requirement","statement":"A state-changing intent SHALL be confirmed as committed within 300 ms at the 99th percentile.","rationale":"The write path of the design, held to a bound that an editor still feels as responsive.","evaluate":{"method":"budget"},"ref":"OPS-334","area":"09-operations","section":"Objectives and budgets","lifecycle":"active","boundary":"b-2","boundaryDetail":"`commit`","traces":["g-300","g-19"],"milestone":2,"inSection":"sec-operations-9","realisation":"operational"},
    {"id":"ops-335","kind":"requirement","statement":"A tenant whose database is lost SHALL answer requests again within 4 hours of the loss.","rationale":"A tenant is one database, so its recovery time is the restore time of one database.","evaluate":{"method":"budget"},"ref":"OPS-335","area":"09-operations","section":"Objectives and budgets","lifecycle":"active","boundary":"b-3","boundaryDetail":"`tenant restore`","traces":["g-1","g-302"],"milestone":12,"inSection":"sec-operations-9","realisation":"operational"},
    {"id":"ops-336","kind":"requirement","statement":"The first request for an idle tenant SHALL complete within 2 seconds at the 95th percentile.","rationale":"Thousands of idle tenants cost nothing, so the first request after an idle period pays for opening the tenant.","evaluate":{"method":"budget"},"ref":"OPS-336","area":"09-operations","section":"Objectives and budgets","lifecycle":"active","boundary":"b-9","boundaryDetail":"`delivery interface`","traces":["g-4","g-300"],"milestone":6,"inSection":"sec-operations-9","realisation":"operational"},
    {"id":"ops-337","kind":"requirement","statement":"A request waiting in the queue of a cluster SHALL start within 1 second at the 99th percentile, or be refused.","rationale":"A queue that is allowed to grow silently breaks every deadline behind it.","evaluate":{"method":"budget"},"ref":"OPS-337","area":"09-operations","section":"Objectives and budgets","lifecycle":"active","boundary":"b-9","boundaryDetail":"`gateway queue`","traces":["g-301"],"milestone":6,"inSection":"sec-operations-9","realisation":"operational"},
    {"id":"ops-338","kind":"requirement","statement":"An outage of a tenant-facing surface SHALL raise an alert within 5 minutes of its start.","rationale":"An alert that comes after the readers have noticed is a report, not an alert.","evaluate":{"method":"budget"},"ref":"OPS-338","area":"09-operations","section":"Objectives and budgets","lifecycle":"active","boundary":"b-12","boundaryDetail":"`alert`","traces":["g-300"],"milestone":10,"inSection":"sec-operations-9","realisation":"operational"},
    {"id":"ops-339","kind":"requirement","statement":"The telemetry of one cluster SHALL hold fewer than 500000 metric series at the reference load.","rationale":"Every tenant label multiplies the series, so the count is bounded by the design.","evaluate":{"method":"budget"},"ref":"OPS-339","area":"09-operations","section":"Objectives and budgets","lifecycle":"active","boundary":"b-12","boundaryDetail":"`metric series`","traces":["g-304"],"milestone":10,"inSection":"sec-operations-9","realisation":"operational"},
    {"id":"ops-340","kind":"requirement","statement":"An alert of a tenant-facing surface SHALL be raised from the rate at which its error budget is consumed over a short window and over a long window together.","rationale":"Two windows separate a fast burn that needs a person now from a slow burn that can wait for the morning.","evaluate":{"method":"scenario"},"ref":"OPS-340","area":"09-operations","section":"Alerts, runbooks and diagnostics","lifecycle":"active","boundary":"b-12","boundaryDetail":"`alert`","traces":["g-300"],"milestone":10,"inSection":"sec-operations-10","realisation":"operational"},
    {"id":"ops-341","kind":"requirement","statement":"Each alert names the catalogue operation that carries its runbook, and that operation SHALL run as a dry run before it runs as a change.","rationale":"A runbook is an operation like any other, so an agent can read it and try it first.","evaluate":{"method":"scenario"},"ref":"OPS-341","area":"09-operations","section":"Alerts, runbooks and diagnostics","lifecycle":"active","boundary":"b-11","boundaryDetail":"`runbook operation`","traces":["g-304","g-23"],"milestone":10,"inSection":"sec-operations-10","realisation":"operational"},
    {"id":"ops-342","kind":"requirement","statement":"The agent gateway SHALL offer read-only diagnostic operations for one tenant, covering its health, its configuration and its recent failures.","rationale":"An agent diagnoses one tenant without the power to change it.","evaluate":{"method":"scenario"},"ref":"OPS-342","area":"09-operations","section":"Alerts, runbooks and diagnostics","lifecycle":"active","boundary":"b-11","boundaryDetail":"`diagnostic operation`","traces":["g-304","g-24"],"milestone":10,"inSection":"sec-operations-10","realisation":"checked"},
    {"id":"ops-343","kind":"requirement","statement":"When no step of an alert's runbook resolves the alert, the alert SHALL be handed to the person on call with the diagnostic output of the runbook attached.","rationale":"An agent that cannot resolve an alert hands over what it already found, not a bare page.","evaluate":{"method":"scenario"},"ref":"OPS-343","area":"09-operations","section":"Alerts, runbooks and diagnostics","lifecycle":"active","boundary":"b-11","boundaryDetail":"`escalation`","traces":["g-304"],"milestone":10,"inSection":"sec-operations-10","realisation":"operational"},
    {"id":"ops-344","kind":"requirement","statement":"Telemetry SHALL carry the tenant identifier as the only per-tenant dimension of a metric, and no record identifier as a dimension of any metric.","rationale":"Record identifiers as labels make the telemetry unaffordable at thousands of tenants.","evaluate":{"method":"property"},"ref":"OPS-344","area":"09-operations","section":"Alerts, runbooks and diagnostics","lifecycle":"active","boundary":"b-12","boundaryDetail":"`metric dimension`","traces":["g-29","g-304"],"milestone":10,"inSection":"sec-operations-10","realisation":"checked"},
    {"id":"ops-345","kind":"requirement","statement":"The platform SHALL attribute to each tenant its connection time, stored bytes, job runs, copy bytes and outbound calls, each as a measure the tenant owner can read.","rationale":"Cost and load are attributed to the tenant that causes them.","evaluate":{"method":"scenario"},"ref":"OPS-345","area":"09-operations","section":"Alerts, runbooks and diagnostics","lifecycle":"active","boundary":"b-12","boundaryDetail":"`tenant measure`","traces":["g-27","g-4"],"milestone":10,"inSection":"sec-operations-10","realisation":"checked"},
    {"id":"ops-346","kind":"requirement","statement":"A synthetic request from outside the platform network SHALL run against each tenant-facing surface at the interval that D-700 states, and a failed one raises an alert even when no tenant request fails.","rationale":"A quiet surface is not necessarily a working one.","evaluate":{"method":"scenario"},"ref":"OPS-346","area":"09-operations","section":"Alerts, runbooks and diagnostics","lifecycle":"active","boundary":"b-12","boundaryDetail":"`synthetic probe`","traces":["g-300","g-27","d-700"],"milestone":10,"inSection":"sec-operations-10","realisation":"operational"},
    {"id":"ops-347","kind":"requirement","statement":"No sampling rule SHALL discard an error record, an alert or an audit entry.","rationale":"Sampling is for the routine records, and the records that explain a failure are kept whole.","evaluate":{"method":"property"},"ref":"OPS-347","area":"09-operations","section":"Alerts, runbooks and diagnostics","lifecycle":"active","boundary":"b-12","boundaryDetail":"`sampling rule`","traces":["g-30","g-27"],"milestone":10,"inSection":"sec-operations-10","realisation":"checked"},
    {"id":"ops-348","kind":"requirement","statement":"A committed domain event that keeps failing to publish SHALL be parked with the error of each attempt, and it stays visible to the tenant owner until it is published or dropped by the tenant owner.","rationale":"A poison event otherwise stops the outbox silently, with nobody able to see which event it is.","evaluate":{"method":"scenario"},"ref":"OPS-348","area":"09-operations","section":"Undeliverable events","lifecycle":"active","boundary":"b-12","boundaryDetail":"`parked event`","traces":["g-14","g-27","d-519"],"milestone":2,"inSection":"sec-operations-11","realisation":"checked"},
    {"id":"ops-349","kind":"requirement","statement":"Every failure mode of the operations fault model SHALL have a fault injection hook in the local stack, named in the fault injection table.","rationale":"A failure that cannot be injected locally is tested only in production.","evaluate":{"method":"conformance"},"ref":"OPS-349","area":"09-operations","section":"Local failure injection","lifecycle":"active","boundary":"b-19","boundaryDetail":"`fault injection hook`","traces":["g-42","g-301"],"milestone":2,"cases":["cases-fault-injection"],"inSection":"sec-operations-12","realisation":"checked"},
    {"id":"idn-300","kind":"requirement","statement":"While the identity service is unreachable, the gateway SHALL refuse a request that needs a session, with a response that names the identity outage.","rationale":"A signed-in request cannot be checked during the outage, so it is refused and not guessed at.","evaluate":{"method":"scenario"},"ref":"IDN-300","area":"03-identity","section":"Outage","lifecycle":"active","boundary":"b-4","boundaryDetail":"`session`","traces":["g-301","g-9","d-517"],"milestone":3,"inSection":"sec-identity-6","realisation":"checked"},
    {"id":"idn-301","kind":"requirement","statement":"While the identity service is unreachable, the gateway SHALL keep serving published content to readers who need no session.","rationale":"Published content does not depend on who is asking, so its readers are not affected by the identity outage.","evaluate":{"method":"scenario"},"ref":"IDN-301","area":"03-identity","section":"Outage","lifecycle":"active","boundary":"b-9","boundaryDetail":"`published content`","traces":["g-18","g-301"],"milestone":6,"inSection":"sec-identity-6","realisation":"checked"},
    {"id":"idn-302","kind":"requirement","statement":"A session lookup SHALL end with an answer or a refusal within 2 seconds.","rationale":"A lookup that hangs holds the request that waits for it.","evaluate":{"method":"budget"},"ref":"IDN-302","area":"03-identity","section":"Outage","lifecycle":"active","boundary":"b-4","boundaryDetail":"`session lookup`","traces":["g-301","g-9"],"milestone":3,"inSection":"sec-identity-6","realisation":"operational"},
    {"id":"sch-300","kind":"requirement","statement":"A trigger SHALL create no job for an event whose chain of triggers has passed the hop limit that D-700 states for its tenant.","rationale":"A trigger that creates an event that starts the trigger again is a loop, and the hop limit is what ends it.","evaluate":{"method":"scenario"},"ref":"SCH-300","area":"04-automation","section":"Chains, bursts and lease outage","lifecycle":"active","boundary":"b-7","boundaryDetail":"`trigger`","traces":["g-13","g-14"],"milestone":5,"inSection":"sec-scheduling-5","realisation":"checked"},
    {"id":"sch-301","kind":"requirement","statement":"A worker that cannot reach the tenant database of a job SHALL take no lease on that job.","rationale":"A worker that cannot record its result cannot hold the job either, so the job is left for a worker that can.","evaluate":{"method":"scenario"},"ref":"SCH-301","area":"04-automation","section":"Chains, bursts and lease outage","lifecycle":"active","boundary":"b-7","boundaryDetail":"`lease`","traces":["g-14","k-17"],"milestone":5,"inSection":"sec-scheduling-5","realisation":"checked"},
    {"id":"sch-302","kind":"requirement","statement":"A burst of due jobs of one tenant SHALL be released to workers at the job admission rate that D-700 states for that tenant.","rationale":"A tenant that schedules a thousand jobs at one minute does not occupy every worker for an hour.","evaluate":{"method":"scenario"},"ref":"SCH-302","area":"04-automation","section":"Chains, bursts and lease outage","lifecycle":"active","boundary":"b-7","boundaryDetail":"`job`","traces":["g-4","g-13"],"milestone":5,"inSection":"sec-scheduling-5","realisation":"checked"},
    {"id":"m-link-accepted-once","kind":"invariant","models":"idn-003","statement":"In the emailed link scenarios, one link yields at most one session.","evaluate":{"method":"state-invariant","scenarios":["link-used-twice","link-presented-late","link-presented-elsewhere","link-presentation-duplicated"],"expr":"emailed-link-flow.sessions <= 1","negatives":[{"scenario":"link-used-twice","faults":["defect-link-replay"]},{"scenario":"link-presentation-duplicated","faults":["defect-link-replay"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-link-accepted-in-time","kind":"temporal","models":"idn-003","statement":"A link presented in the requesting browser within its lifetime yields a session.","evaluate":{"method":"eventually","scenarios":["link-used-twice"],"occurs":{"event":"ml-session-issued"},"negatives":[{"scenario":"link-used-twice","faults":["link-acceptance-disabled"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-tick"],"faultBasis":"restatement"},
    {"id":"m-late-link-refused","kind":"temporal","models":"idn-004","statement":"A link presented after its lifetime yields no session.","evaluate":{"method":"never","scenarios":["link-presented-late","link-presented-after-delay"],"occurs":{"event":"ml-session-issued"},"negatives":[{"scenario":"link-presented-late","faults":["defect-link-lifetime-unchecked"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-tick"],"faultBasis":"fault"},
    {"id":"m-foreign-browser-refused","kind":"temporal","models":"idn-005","statement":"A link presented in a browser that did not request it yields no session.","evaluate":{"method":"never","scenarios":["link-presented-elsewhere","link-intercepted"],"occurs":{"event":"ml-session-issued"},"negatives":[{"scenario":"link-presented-elsewhere","faults":["defect-link-browser-unchecked"]},{"scenario":"link-intercepted","faults":["defect-link-browser-unchecked"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-emailed-link-flow-refined","kind":"temporal","models":"idn-003","statement":"The implementation of the emailed link, with its stored challenge and expiry, refines the emailed link model.","evaluate":{"method":"refines","behavior":"emailed-link-flow-impl","scenarios":["link-used-twice-impl","link-presented-late-impl","link-presented-elsewhere-impl","link-presented-after-delay-impl","link-presentation-duplicated-impl","link-intercepted-impl"]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-forged-callback-refused","kind":"temporal","models":"fed-001","statement":"A callback whose state matches no pending request yields no session.","evaluate":{"method":"never","scenarios":["oidc-forged-callback","oidc-provider-silent-forged-callback"],"occurs":{"event":"oidc-session-issued"},"negatives":[{"scenario":"oidc-forged-callback","faults":["defect-oidc-state-unchecked"]},{"scenario":"oidc-provider-silent-forged-callback","faults":["defect-oidc-state-unchecked"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-provider-signatures"],"faultBasis":"fault"},
    {"id":"m-matching-callback-accepted","kind":"temporal","models":"fed-001","statement":"A callback that carries the pending state yields a session.","evaluate":{"method":"eventually","scenarios":["oidc-sign-in"],"occurs":{"event":"oidc-session-issued"},"negatives":[{"scenario":"oidc-sign-in","faults":["oidc-acceptance-disabled"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-provider-signatures"],"faultBasis":"restatement"},
    {"id":"m-oidc-callback-flow-refined","kind":"temporal","models":"fed-001","statement":"The implementation of the provider sign-in callback refines the callback model.","evaluate":{"method":"refines","behavior":"oidc-callback-flow-impl","scenarios":["oidc-sign-in-impl","oidc-forged-callback-impl","oidc-provider-silent-forged-callback-impl"]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-revocation-bounded","kind":"invariant","models":"idn-013","statement":"The gateway never accepts a session 5 ticks or more after it was revoked, whether or not the revocation notice arrives.","evaluate":{"method":"state-invariant","scenarios":["revocation-heard","revocation-notice-lost"],"expr":"!gateway-session-flow.staleAccept","negatives":[{"scenario":"revocation-notice-lost","faults":["defect-gateway-no-recheck"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-clock-skew","a-tick"],"faultBasis":"fault"},
    {"id":"m-revoked-session-refused","kind":"temporal","models":"idn-013","statement":"When the revocation notice is lost, a request after the bound is still refused.","evaluate":{"method":"eventually","scenarios":["revocation-notice-lost"],"occurs":{"event":"sr-refused"},"negatives":[{"scenario":"revocation-notice-lost","faults":["defect-gateway-no-recheck"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-clock-skew","a-tick"],"faultBasis":"fault"},
    {"id":"m-gateway-session-flow-refined","kind":"temporal","models":"idn-013","statement":"The implementation of the gateway copy of a session refines the gateway session model.","evaluate":{"method":"refines","behavior":"gateway-session-flow-impl","scenarios":["revocation-heard-impl","revocation-notice-lost-impl"]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-result-carries-current-token","kind":"invariant","models":"sch-011","statement":"A recorded result carries the token of the current lease.","evaluate":{"method":"state-invariant","scenarios":["lease-takeover","lease-report-in-transit"],"expr":"job-lease-flow.completions > 0 => job-lease-flow.acceptedToken == job-lease-flow.token","negatives":[{"scenario":"lease-takeover","faults":["defect-result-token-unchecked"]},{"scenario":"lease-report-in-transit","faults":["defect-result-token-unchecked"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-database-commit"],"faultBasis":"fault"},
    {"id":"m-job-completes-after-takeover","kind":"temporal","models":"sch-010","statement":"A job whose first worker stalls is completed by its replacement.","evaluate":{"method":"eventually","scenarios":["lease-takeover","lease-report-in-transit","lease-report-lost-in-partition"],"occurs":{"event":"job-completed"},"negatives":[{"scenario":"lease-takeover","faults":["completion-disabled"]},{"scenario":"lease-report-lost-in-partition","faults":["completion-disabled"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-database-commit"],"faultBasis":"fault"},
    {"id":"m-edge-staleness-bounded","kind":"invariant","models":"edg-006","statement":"The edge never serves a version 5 ticks or more after it was superseded, whether or not the purge arrives.","evaluate":{"method":"state-invariant","scenarios":["page-purged","page-purge-lost"],"expr":"!edge-copy-flow.staleServed","negatives":[{"scenario":"page-purge-lost","faults":["defect-edge-ignores-lifetime"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-tick"],"faultBasis":"fault"},
    {"id":"m-active-means-ready","kind":"invariant","models":"ten-002","statement":"A tenant reported as active has its layout applied and its template installed.","evaluate":{"method":"state-invariant","scenarios":["tenant-provisioned","tenant-provisioning-fails","tenant-provisioning-fails-late"],"expr":"provisioning-flow.active => provisioning-flow.layout && provisioning-flow.template","negatives":[{"scenario":"tenant-provisioned","faults":["defect-early-activation"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-failed-provisioning-not-active","kind":"temporal","models":"ten-003","statement":"A provisioning run that fails never reports the tenant as active.","evaluate":{"method":"never","scenarios":["tenant-provisioning-fails","tenant-provisioning-fails-late"],"occurs":{"event":"pv-activated"},"negatives":[{"scenario":"tenant-provisioning-fails","faults":["defect-early-activation"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-applied-means-cleared","kind":"invariant","models":"agt-011","statement":"An applied change was projected, and was either classed as safe or approved.","evaluate":{"method":"state-invariant","scenarios":["safe-change-applied","risky-change-approved","risky-change-rejected","risky-change-approval-in-transit"],"expr":"proposal-flow.applied => proposal-flow.projected && proposal-flow.cleared","negatives":[{"scenario":"risky-change-approved","faults":["defect-apply-unapproved"]},{"scenario":"risky-change-approval-in-transit","faults":["defect-apply-unapproved"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-rejected-change-not-applied","kind":"temporal","models":"agt-011","statement":"A rejected change is never applied.","evaluate":{"method":"never","scenarios":["risky-change-rejected","rejected-change-apply-redelivered"],"occurs":{"event":"cp-applied"},"negatives":[{"scenario":"risky-change-rejected","faults":["defect-apply-rejected"]},{"scenario":"rejected-change-apply-redelivered","faults":["defect-apply-rejected"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-commit-precedes-publication","kind":"temporal","models":"run-005","statement":"Every published event is preceded by the confirmation of its commit.","evaluate":{"method":"precedes","scenarios":["intent-committed","intent-commit-confirmation-delayed"],"first":{"event":"rt-committed"},"then":{"event":"rt-published"},"negatives":[{"scenario":"intent-committed","faults":["defect-publish-before-commit"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-database-commit"],"faultBasis":"fault"},
    {"id":"m-browser-reaches-data-through-gateway","kind":"structural","models":"gwy-700","statement":"Every path from the web application to a tenant database passes through the gateway.","evaluate":{"method":"only-via","from":"web-application","to":"tenant-database","via":"gateway"},"assumptions":["a-model-abstraction"]},
    {"id":"m-external-requests-pass-traffic-switch","kind":"structural","models":"rel-577","statement":"Every path from a client of the platform (the web application, an agent, the content delivery network) to the gateway or the agent gateway passes through a listener of the traffic switch. The model holds paths between components, not requests: it shows that no relationship lets a client bypass the switch, and the choice of colour per request is the behaviour of the colour switch model.","evaluate":{"method":"only-via","from":["web-application","agent","delivery-network"],"to":["gateway","agent-gateway"],"via":["traffic-switch","agent-traffic-switch"],"kinds":["depends-on","calls","data-flow","publishes","subscribes","reads","writes"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-agents-reach-data-through-agent-gateway","kind":"structural","models":"agt-014","statement":"Every path from an agent to a tenant database passes through the agent gateway.","evaluate":{"method":"only-via","from":"agent","to":"tenant-database","via":"agent-gateway"},"assumptions":["a-model-abstraction"]},
    {"id":"m-tenant-database-through-store-contract","kind":"structural","models":"sec-005","statement":"Every path from a component other than the tenant database, the two database adapters and the store contract to a tenant database passes through the store contract (telemetry observation excepted, OBS-003).","evaluate":{"method":"only-via","from":["kernel","substrate","control-plane","control-database","identity-service","runtime","gateway","automation-worker","connector-runner","copy-store","file-store","delivery-network","delivery-network-control","agent-gateway","telemetry-pipeline","audit-log","key-service","mail-service","external-identity-provider","web-application","simulator","verification","agent","limit-store","backup-archive","fleet-reporting","product-module","external-endpoint","notice-queue","search-index","notification-service","conversation-service","model-provider","local-model-adapter","operator-console","outbound-gate","upload-scanner","mail-dispatcher","release-controller","release-pipeline","image-registry","traffic-switch","subject-rights-service","agent-traffic-switch","migration-job","platform-audit-store"],"to":"tenant-database","via":"store-contract","kinds":["depends-on","calls","data-flow","publishes","subscribes","reads","writes"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-kernel-reaches-nothing","kind":"structural","models":"krn-012","statement":"The kernel has no path to any store, service or external component.","evaluate":{"method":"no-relationship","from":"kernel","to":{"all":true},"transitive":true},"assumptions":["a-model-abstraction"]},
    {"id":"m-control-database-private","kind":"structural","models":"ten-006","statement":"The control plane alone reaches the control database: no other component has a data relationship to (telemetry observation excepted, OBS-003) it.","evaluate":{"method":"no-relationship","from":["kernel","substrate","store-contract","sqlite-adapter","postgres-adapter","tenant-database","identity-service","runtime","gateway","automation-worker","connector-runner","copy-store","file-store","delivery-network","delivery-network-control","agent-gateway","telemetry-pipeline","audit-log","key-service","mail-service","external-identity-provider","web-application","simulator","verification","agent","limit-store","backup-archive","fleet-reporting","product-module","external-endpoint","notice-queue","search-index","notification-service","conversation-service","model-provider","local-model-adapter","operator-console","outbound-gate","upload-scanner","mail-dispatcher","release-controller","release-pipeline","image-registry","traffic-switch","subject-rights-service","agent-traffic-switch","migration-job","platform-audit-store"],"to":"control-database","transitive":false,"kinds":["depends-on","calls","data-flow","publishes","subscribes","reads","writes"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-dependencies-acyclic","kind":"structural","models":"krn-012","statement":"The depends-on relationships between components have no cycle.","evaluate":{"method":"acyclic","kinds":["depends-on"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-calls-acyclic","kind":"structural","models":"arc-701","statement":"The calls relationships between the components of the platform have no cycle. Components outside the platform (clients and providers) are left out: a sign-in redirect goes to the identity provider and comes back by design.","evaluate":{"method":"acyclic","kinds":["calls"],"within":["kernel","substrate","store-contract","sqlite-adapter","postgres-adapter","tenant-database","control-plane","control-database","identity-service","runtime","gateway","automation-worker","connector-runner","copy-store","file-store","agent-gateway","telemetry-pipeline","audit-log","simulator","verification","limit-store","backup-archive","fleet-reporting","product-module","notice-queue","search-index","notification-service","conversation-service","local-model-adapter","outbound-gate","upload-scanner","mail-dispatcher","release-controller","release-pipeline","image-registry","traffic-switch","agent-traffic-switch","migration-job","platform-audit-store","subject-rights-service"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-copies-designed","kind":"structural","models":"cpy-001","statement":"Every stored copy states a freshness bound, is reachable from its owner, and states an erasure point where it holds personal data or a principal.","evaluate":{"method":"data-model","rules":["freshness-bound","holder-reaches-owner","erasure-point"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-records-state-erasure","kind":"structural","models":"prv-353","statement":"Every record that holds a personal or credential field states the point at which it is erased, or a bound after which it is removed.","evaluate":{"method":"data-model","rules":["record-erasure-point"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-shared-copies-impersonal","kind":"structural","models":"cpy-007","statement":"No shared copy holds a personal field or a principal, and none depends on who is asking.","evaluate":{"method":"data-model","rules":["no-principal-in-shared"]},"assumptions":["a-model-abstraction"]},
    {"id":"arc-100","kind":"requirement","statement":"While the control plane cannot be reached, the gateway SHALL answer reads for a tenant from the directory entry it holds, while that entry is within the age that ARC-500 allows, stating its age, and refuse every state-changing request for that tenant.","rationale":"Without this, every request depends on the control plane, so an outage of the directory becomes an outage of every tenant.","evaluate":{"method":"scenario"},"ref":"ARC-100","area":"09-architecture","section":"Control plane and wake index","lifecycle":"active","boundary":"b-3","boundaryDetail":"`directory entry`","traces":["g-101","d-100"],"milestone":2,"inSection":"sec-arch-2","realisation":"checked"},
    {"id":"arc-101","kind":"requirement","statement":"The wake index SHALL be rebuildable from the tenant databases, so that losing it delays due work and loses none of it.","rationale":"The index is a convenience of the control plane. Due work lives in the tenant databases, so the index can be lost without losing a job.","evaluate":{"method":"scenario"},"ref":"ARC-101","area":"09-architecture","section":"Control plane and wake index","lifecycle":"active","boundary":"b-3","boundaryDetail":"`wake index`","traces":["g-14","g-102","d-10"],"milestone":5,"inSection":"sec-arch-2","realisation":"checked"},
    {"id":"arc-102","kind":"requirement","statement":"A domain event SHALL reach the notice queue as a reference that names its tenant and sequence number, with no content of the record it changed.","rationale":"The queue sits in the control zone. Record content stays in the tenant database, which subscribers read when they need it.","evaluate":{"method":"property"},"ref":"ARC-102","area":"09-architecture","section":"Notices and outbox","lifecycle":"active","boundary":"b-16","boundaryDetail":"`notice`","traces":["k-2","d-10"],"milestone":3,"inSection":"sec-arch-3","realisation":"checked"},
    {"id":"arc-103","kind":"requirement","statement":"The notice queue SHALL redeliver a notice to each subscriber until that subscriber acknowledges it, so that every notice reaches every subscriber it names.","rationale":"Delivery repeats until acknowledged, so a lost notice is a delay and not a loss. The revocation bound depends on this.","evaluate":{"method":"scenario"},"ref":"ARC-103","area":"09-architecture","section":"Notices and outbox","lifecycle":"active","boundary":"b-16","boundaryDetail":"`notice delivery`","traces":["d-12","g-19"],"milestone":3,"inSection":"sec-arch-3","realisation":"checked"},
    {"id":"arc-104","kind":"requirement","statement":"A subscriber that receives a domain event a second time SHALL make no further effect from it.","rationale":"Redelivery is what makes delivery reliable, so the subscriber is the one that makes each effect once.","evaluate":{"method":"property"},"ref":"ARC-104","area":"09-architecture","section":"Notices and outbox","lifecycle":"active","boundary":"b-16","boundaryDetail":"`notice subscriber`","traces":["d-12","g-15"],"milestone":3,"inSection":"sec-arch-3","realisation":"checked"},
    {"id":"arc-105","kind":"requirement","statement":"An event that a commit left unpublished SHALL reach its subscribers after the process that made the commit has stopped.","rationale":"Without this, a crash between the commit and the publication strands the event until someone next writes to the tenant.","evaluate":{"method":"scenario"},"ref":"ARC-105","area":"09-architecture","section":"Notices and outbox","lifecycle":"active","boundary":"b-7","boundaryDetail":"`outbox job`","traces":["g-14","d-102","d-529"],"milestone":5,"inSection":"sec-arch-3","realisation":"checked"},
    {"id":"arc-106","kind":"requirement","statement":"While two versions of the platform run together, a commit SHALL be written in a format that both versions read.","rationale":"A rolling deployment has an old process and a new process serving the same tenant database at once.","evaluate":{"method":"scenario"},"ref":"ARC-106","area":"09-architecture","section":"Change across versions","lifecycle":"active","boundary":"b-2","boundaryDetail":"`commit format`","traces":["g-104","g-5"],"milestone":12,"inSection":"sec-arch-4","realisation":"checked"},
    {"id":"arc-107","kind":"requirement","statement":"A layout change SHALL reach every tenant database before code that needs the new layout serves that tenant.","rationale":"Layouts change one tenant database at a time, so the code that depends on a layout waits for its tenant.","evaluate":{"method":"scenario"},"ref":"ARC-107","area":"09-architecture","section":"Change across versions","lifecycle":"active","boundary":"b-3","boundaryDetail":"`layout version`","traces":["g-104","g-1"],"milestone":2,"inSection":"sec-arch-4","realisation":"checked"},
    {"id":"arc-108","kind":"requirement","statement":"A decision SHALL load only the records that its plan names.","rationale":"A tenant holds a great many records. A decision that loads its whole tenant makes the kernel's memory and latency a function of tenant size rather than of the decision.","evaluate":{"method":"property"},"ref":"ARC-108","area":"09-architecture","section":"Kernel load, limits and connections","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::needs`","traces":["k-100","g-4"],"milestone":2,"inSection":"sec-arch-5","realisation":"checked"},
    {"id":"arc-109","kind":"requirement","statement":"Request rates SHALL be counted in one store that every gateway instance reads and writes.","rationale":"A limit counted separately in each instance is a limit that grows with the number of instances.","evaluate":{"method":"scenario"},"ref":"ARC-109","area":"09-architecture","section":"Kernel load, limits and connections","lifecycle":"active","boundary":"b-100","boundaryDetail":"`request limit`","traces":["g-4","g-102"],"milestone":6,"inSection":"sec-arch-5","realisation":"checked"},
    {"id":"arc-110","kind":"requirement","statement":"An operator report that spans tenants SHALL be answered from telemetry, published summaries and the tenant directory alone.","rationale":"Operators need the fleet view, and the data of a tenant stays with that tenant.","evaluate":{"method":"property"},"ref":"ARC-110","area":"09-architecture","section":"Reporting and backup","lifecycle":"active","boundary":"b-12","boundaryDetail":"`fleet report`","traces":["g-100","ng-6","d-101"],"milestone":10,"inSection":"sec-arch-6","realisation":"construction"},
    {"id":"arc-111","kind":"requirement","statement":"Each tenant database SHALL be backed up to the backup archive on a schedule, with every copy encrypted under the key of that tenant.","rationale":"A backup that no schedule produces, or that another tenant's key can open, is not a backup of that tenant.","evaluate":{"method":"scenario"},"ref":"ARC-111","area":"09-architecture","section":"Reporting and backup","lifecycle":"active","boundary":"b-101","boundaryDetail":"`backup archive`","traces":["g-1","g-40","d-706"],"milestone":2,"inSection":"sec-arch-6","realisation":"operational"},
    {"id":"arc-112","kind":"requirement","statement":"A product module SHALL reach tenant data only through the runtime.","rationale":"A module with its own path to a tenant database would bypass the authorisation and the copies that the runtime applies.","evaluate":{"method":"property"},"ref":"ARC-112","area":"09-architecture","section":"Extension","lifecycle":"active","boundary":"b-21","boundaryDetail":"`product module`","traces":["k-3","g-31"],"milestone":2,"inSection":"sec-arch-7","realisation":"construction"},
    {"id":"arc-113","kind":"requirement","statement":"A product module SHALL add its record types, views, workflows and operations as tenant metadata, with no change to the kernel.","rationale":"A feature that changes the kernel changes every tenant at once, and cannot be installed, removed or projected on its own.","evaluate":{"method":"scenario"},"ref":"ARC-113","area":"09-architecture","section":"Extension","lifecycle":"active","boundary":"b-21","boundaryDetail":"`module bundle`","traces":["g-103","k-1","d-103"],"milestone":2,"inSection":"sec-arch-7","realisation":"checked"},
    {"id":"arc-114","kind":"requirement","statement":"The total of connections that one database cluster holds open SHALL stay within the configured ceiling of that cluster, whatever the number of tenants on it.","rationale":"With a database per tenant, connections are the first shared resource that runs out as tenants are added.","evaluate":{"method":"property"},"ref":"ARC-114","area":"09-architecture","section":"Kernel load, limits and connections","lifecycle":"active","boundary":"b-2","boundaryDetail":"`cluster connection ceiling`","traces":["g-102","d-1","d-511"],"milestone":2,"inSection":"sec-arch-5","realisation":"checked"},
    {"id":"arc-115","kind":"requirement","statement":"A stored event SHALL name the version of its format, so that a reader refuses a version that it does not support.","rationale":"Old and new readers meet during a rolling change, and a reader that guesses at a format writes a wrong state.","evaluate":{"method":"property"},"ref":"ARC-115","area":"09-architecture","section":"Change across versions","lifecycle":"active","boundary":"b-2","boundaryDetail":"`event format`","traces":["g-5","g-104"],"milestone":2,"inSection":"sec-arch-4","realisation":"checked"},
    {"id":"m-outbox-effect-once","kind":"invariant","models":"arc-104","statement":"A subscriber that receives one notice twice makes one effect from it.","evaluate":{"method":"state-invariant","scenarios":["arc-outbox-duplicate-delivery","arc-outbox-delayed-first-delivery"],"expr":"arc-outbox-consumer-flow.effects <= 1","negatives":[{"scenario":"arc-outbox-duplicate-delivery","faults":["arc-defect-outbox-duplicate-applied"]},{"scenario":"arc-outbox-delayed-first-delivery","faults":["arc-defect-outbox-duplicate-applied"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-outbox-published-after-crash","kind":"temporal","models":"arc-105","statement":"An event that a stopped runtime left unpublished is published by the outbox job.","evaluate":{"method":"eventually","scenarios":["arc-publisher-crashed-after-commit"],"occurs":{"event":"arc-ob-published"},"negatives":[{"scenario":"arc-publisher-crashed-after-commit","faults":["arc-recovery-disabled"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-database-commit"],"faultBasis":"fault"},
    {"id":"m-old-format-while-old-runs","kind":"invariant","models":"arc-106","statement":"Once a commit is written in the newer format, no older version is still running.","evaluate":{"method":"state-invariant","scenarios":["arc-rolling-deploy-with-commit","rolling-deploy-finish-delayed"],"expr":"arc-rolling-change-flow.newFormat => !arc-rolling-change-flow.oldRunning","negatives":[{"scenario":"arc-rolling-deploy-with-commit","faults":["arc-defect-new-format-early"]},{"scenario":"rolling-deploy-finish-delayed","faults":["arc-defect-new-format-early"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-module-through-runtime","kind":"structural","models":"arc-112","statement":"Every path from a product module to a tenant database passes through the runtime.","evaluate":{"method":"only-via","from":"product-module","to":"tenant-database","via":"runtime"},"assumptions":["a-model-abstraction"]},
    {"id":"m-fleet-reads-no-tenant-database","kind":"structural","models":"arc-110","statement":"Fleet reporting has no path to any tenant database.","evaluate":{"method":"no-relationship","from":"fleet-reporting","to":"tenant-database","transitive":true},"assumptions":["a-model-abstraction"]},
    {"id":"m-backup-archive-private","kind":"structural","models":"arc-111","statement":"No component other than the tenant database, the control plane, the PostgreSQL adapter and the file store has a data relationship to the backup archive (telemetry observation excepted, OBS-003).","evaluate":{"method":"no-relationship","from":["kernel","substrate","store-contract","sqlite-adapter","control-database","identity-service","runtime","gateway","automation-worker","connector-runner","copy-store","delivery-network","delivery-network-control","agent-gateway","telemetry-pipeline","audit-log","key-service","mail-service","external-identity-provider","web-application","simulator","verification","agent","limit-store","fleet-reporting","product-module","external-endpoint","notice-queue","search-index","notification-service","conversation-service","model-provider","local-model-adapter","operator-console","outbound-gate","upload-scanner","mail-dispatcher","release-controller","release-pipeline","image-registry","traffic-switch","subject-rights-service","agent-traffic-switch","migration-job","platform-audit-store"],"to":"backup-archive","transitive":false,"kinds":["depends-on","calls","data-flow","publishes","subscribes","reads","writes"]},"assumptions":["a-model-abstraction"]},
    {"id":"adm-150","kind":"requirement","statement":"A tenant SHALL define roles as named sets of permissions over the operations and object types of its schema, and assign each role to people, services, agents and teams.","rationale":"Custom roles fit a tenant's own organisation into the one policy model.","evaluate":{"method":"scenario"},"ref":"ADM-150","area":"09-administration","section":"Roles and teams","lifecycle":"active","boundary":"b-4","boundaryDetail":"`role assignment`","traces":["g-153","k-13"],"milestone":3,"inSection":"sec-administration-2","realisation":"checked"},
    {"id":"adm-151","kind":"requirement","statement":"A principal SHALL hold the permissions of each role assigned to it directly and of each role of each team it belongs to, and no other permission.","rationale":"Team membership grants roles through the same decision as a direct assignment.","evaluate":{"method":"property"},"ref":"ADM-151","area":"09-administration","section":"Roles and teams","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["g-153"],"milestone":3,"inSection":"sec-administration-2","realisation":"checked"},
    {"id":"adm-152","kind":"requirement","statement":"Assigning a role SHALL be refused when the assigning principal holds none of the permissions that the role grants.","rationale":"Nobody raises their own reach by handing out a role they could not use.","evaluate":{"method":"scenario"},"ref":"ADM-152","area":"09-administration","section":"Roles and teams","lifecycle":"active","boundary":"b-4","boundaryDetail":"`role assignment`","traces":["g-153","k-13"],"milestone":3,"inSection":"sec-administration-2","realisation":"checked"},
    {"id":"adm-153","kind":"requirement","statement":"An invitation SHALL grant its roles to the one person who redeems it with the address it names, and to no one else.","rationale":"An invitation is a grant of roles, so it binds to one address and one redemption.","evaluate":{"method":"scenario"},"ref":"ADM-153","area":"09-administration","section":"Invitations and onboarding","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /invitations/accept`","traces":["g-153"],"milestone":3,"inSection":"sec-administration-3","realisation":"checked"},
    {"id":"adm-154","kind":"requirement","statement":"A person SHALL start a sandbox tenant from a published template and become its owner, with no step taken by the platform operator.","rationale":"A buyer who has to wait for a sales call does not try the product first.","evaluate":{"method":"scenario"},"ref":"ADM-154","area":"09-administration","section":"Invitations and onboarding","lifecycle":"active","boundary":"b-3","boundaryDetail":"`POST /sandboxes`","traces":["g-154"],"milestone":3,"inSection":"sec-administration-3","realisation":"checked"},
    {"id":"adm-155","kind":"requirement","statement":"A sandbox tenant SHALL be deleted at the end of the period that its plan states, unless its owner has kept it.","rationale":"An abandoned sandbox holds personal data and storage that nobody uses.","evaluate":{"method":"scenario"},"ref":"ADM-155","area":"09-administration","section":"Invitations and onboarding","lifecycle":"active","boundary":"b-3","boundaryDetail":"`sandbox expiry`","traces":["g-154","g-157","d-705"],"milestone":3,"inSection":"sec-administration-3","realisation":"checked"},
    {"id":"adm-156","kind":"requirement","statement":"Keeping a sandbox tenant SHALL change its kind to production without copying its records.","rationale":"The kept tenant is the one the customer keeps using, so nothing has to move.","evaluate":{"method":"scenario"},"ref":"ADM-156","area":"09-administration","section":"Invitations and onboarding","lifecycle":"active","boundary":"b-3","boundaryDetail":"`keep sandbox`","traces":["g-154"],"milestone":3,"inSection":"sec-administration-3","realisation":"checked"},
    {"id":"adm-157","kind":"requirement","statement":"Each tenant SHALL record whether it is production, staging or sandbox, and the production tenant that a staging tenant serves.","rationale":"Environments are tenants, so their kind and their link are directory data.","evaluate":{"method":"example"},"ref":"ADM-157","area":"09-administration","section":"Tenant kinds and environments","lifecycle":"active","boundary":"b-3","boundaryDetail":"`tenant kind`","traces":["g-1","d-150"],"milestone":2,"inSection":"sec-administration-4","realisation":"checked"},
    {"id":"adm-158","kind":"requirement","statement":"A change to the configuration of a staging tenant SHALL reach its production tenant only through a proposal that the production policies approve.","rationale":"A promotion changes production, so it takes the route of any other risky change.","evaluate":{"method":"scenario"},"ref":"ADM-158","area":"09-administration","section":"Tenant kinds and environments","lifecycle":"active","boundary":"b-11","boundaryDetail":"`proposal`","traces":["g-164","g-26"],"milestone":7,"inSection":"sec-administration-4","realisation":"checked"},
    {"id":"adm-159","kind":"requirement","statement":"A promotion SHALL carry the tenant metadata of the staging tenant and leave the records of its content where they are.","rationale":"Content is written by people in the tenant that holds it, and a promotion moves configuration only.","evaluate":{"method":"scenario"},"ref":"ADM-159","area":"09-administration","section":"Tenant kinds and environments","lifecycle":"active","boundary":"b-11","boundaryDetail":"`promotion`","traces":["g-164","d-151"],"milestone":7,"inSection":"sec-administration-4","realisation":"checked"},
    {"id":"adm-160","kind":"requirement","statement":"A tenant deletion requested by its owner SHALL stay cancellable until the grace period that its plan states has ended.","rationale":"A deletion made by mistake is the costliest mistake a customer can make.","evaluate":{"method":"scenario"},"ref":"ADM-160","area":"09-administration","section":"Offboarding","lifecycle":"active","boundary":"b-3","boundaryDetail":"`DELETE /tenants/{id}`","traces":["g-160","d-705"],"milestone":2,"inSection":"sec-administration-5","realisation":"checked"},
    {"id":"adm-161","kind":"requirement","statement":"A tenant owner SHALL be able to request the export of TEN-010 and receive it as an archive of the tenant's records, files, configuration and audit entries in documented formats.","rationale":"The customer leaves with the data in a format that another system reads. The archive is the export of TEN-010, one artifact at one endpoint, and this requirement states who may ask for it and what it holds (D-701).","evaluate":{"method":"scenario"},"ref":"ADM-161","area":"09-administration","section":"Offboarding","lifecycle":"active","boundary":"b-153","boundaryDetail":"`POST /tenants/{id}/export`","traces":["g-160","g-1","d-701"],"milestone":2,"inSection":"sec-administration-5","realisation":"checked"},
    {"id":"adm-162","kind":"requirement","statement":"Every archive SHALL hold a manifest that names the hash of each file the archive includes.","rationale":"A customer can check an archive without trusting the platform that produced it.","evaluate":{"method":"property"},"ref":"ADM-162","area":"09-administration","section":"Offboarding","lifecycle":"active","boundary":"b-153","boundaryDetail":"`archive manifest`","traces":["g-160"],"milestone":2,"inSection":"sec-administration-5","realisation":"checked"},
    {"id":"adm-163","kind":"requirement","statement":"A support grant SHALL be issued by an owner of the tenant that it names.","rationale":"The tenant owner decides who may look, and until when.","evaluate":{"method":"scenario"},"ref":"ADM-163","area":"09-administration","section":"Support access","lifecycle":"active","boundary":"b-350","boundaryDetail":"`POST /tenants/{id}/access-grants`","traces":["g-165"],"milestone":4,"inSection":"sec-administration-6","realisation":"checked"},
    {"id":"adm-164","kind":"requirement","statement":"An act of a platform operator in a tenant SHALL leave an audit entry that names the operator, the support grant and the request.","rationale":"The tenant can read back every look that the platform took.","evaluate":{"method":"property"},"ref":"ADM-164","area":"09-administration","section":"Support access","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit entry`","traces":["g-165","g-30"],"milestone":4,"inSection":"sec-administration-6","realisation":"checked"},
    {"id":"adm-165","kind":"requirement","statement":"Withdrawing a support grant SHALL refuse every later request made under that grant.","rationale":"Withdrawal takes effect without waiting for a token to expire.","evaluate":{"method":"scenario"},"ref":"ADM-165","area":"09-administration","section":"Support access","lifecycle":"active","boundary":"b-350","boundaryDetail":"`DELETE /tenants/{id}/access-grants/{grant-id}`","traces":["g-165","g-28"],"milestone":4,"inSection":"sec-administration-6","realisation":"checked"},
    {"id":"bil-150","kind":"requirement","statement":"A tenant SHALL hold one plan that states the quotas of its connections, requests, stored bytes, jobs and emails.","rationale":"Without a plan a tenant has no bound on its own heavy use.","evaluate":{"method":"example"},"ref":"BIL-150","area":"02-tenancy","section":"Plans and quotas","lifecycle":"active","boundary":"b-3","boundaryDetail":"`tenant plan`","traces":["g-157","d-508"],"milestone":2,"inSection":"sec-billing-2","realisation":"checked"},
    {"id":"bil-151","kind":"requirement","statement":"A write that would exceed a quota of the tenant's plan SHALL be refused, with the quota it would exceed named in the refusal.","rationale":"A refused write tells the customer which limit to raise.","evaluate":{"method":"scenario"},"ref":"BIL-151","area":"02-tenancy","section":"Plans and quotas","lifecycle":"active","boundary":"b-11","boundaryDetail":"`operation`","traces":["g-157","g-4"],"milestone":6,"inSection":"sec-billing-2","realisation":"checked"},
    {"id":"bil-152","kind":"requirement","statement":"The platform SHALL count the metered quantities of each tenant for each billing period from the records that carry them.","rationale":"Counts that come from the records can be checked against the records.","evaluate":{"method":"property"},"ref":"BIL-152","area":"02-tenancy","section":"Metering and export","lifecycle":"active","boundary":"b-155","boundaryDetail":"`usage count`","traces":["g-157"],"milestone":6,"inSection":"sec-billing-4","realisation":"checked"},
    {"id":"bil-153","kind":"requirement","statement":"The usage of each billing period SHALL be delivered to the billing system that the tenant configures as a signed document that carries an idempotency key.","rationale":"A billing system that receives the same usage twice counts it once.","evaluate":{"method":"scenario"},"ref":"BIL-153","area":"02-tenancy","section":"Metering and export","lifecycle":"active","boundary":"b-155","boundaryDetail":"`usage export`","traces":["g-157","d-154","d-513"],"milestone":6,"inSection":"sec-billing-4","realisation":"checked"},
    {"id":"bil-154","kind":"requirement","statement":"A trial that ends without a chosen plan SHALL suspend the tenant with all of its data kept.","rationale":"A lapsed trial is a pause, and the buyer can still choose a plan.","evaluate":{"method":"scenario"},"ref":"BIL-154","area":"02-tenancy","section":"Trials","lifecycle":"active","boundary":"b-3","boundaryDetail":"`trial end`","traces":["g-157"],"milestone":2,"inSection":"sec-billing-3","realisation":"checked"},
    {"id":"bil-155","kind":"requirement","statement":"The platform SHALL publish the objectives of each plan and the result measured in each calendar month.","rationale":"A published objective is one that the customer can hold the platform to.","evaluate":{"method":"example"},"ref":"BIL-155","area":"02-tenancy","section":"Published objectives","lifecycle":"active","boundary":"b-156","boundaryDetail":"`service objectives`","traces":["g-168","g-27"],"milestone":12,"inSection":"sec-billing-5","realisation":"checked"},
    {"id":"ntf-150","kind":"requirement","statement":"An email notice SHALL omit the field values of each record that its recipient has no right to read.","rationale":"Email leaves the platform, and what it carries leaves with it.","evaluate":{"method":"property"},"ref":"NTF-150","area":"04-automation","section":"Notices and inbox","lifecycle":"active","boundary":"b-154","boundaryDetail":"`email notice`","traces":["g-155","g-20"],"milestone":5,"inSection":"sec-notifications-2","realisation":"checked"},
    {"id":"ntf-151","kind":"requirement","statement":"Each subscription SHALL choose delivery by email, by the inbox of its recipient, or by both.","rationale":"Some notices belong in the inbox alone, and others are also sent by mail.","evaluate":{"method":"example"},"ref":"NTF-151","area":"04-automation","section":"Notices and inbox","lifecycle":"active","boundary":"b-154","boundaryDetail":"`subscription`","traces":["g-155"],"milestone":5,"inSection":"sec-notifications-2","realisation":"checked"},
    {"id":"ntf-152","kind":"requirement","statement":"An approval step SHALL appear in the inbox of each principal that its policy names, and in no other inbox.","rationale":"The approver sees the task where the approver works, and nobody else sees it.","evaluate":{"method":"scenario"},"ref":"NTF-152","area":"04-automation","section":"Notices and inbox","lifecycle":"active","boundary":"b-154","boundaryDetail":"`approval task`","traces":["g-155","g-151"],"milestone":5,"inSection":"sec-notifications-2","realisation":"checked"},
    {"id":"int-150","kind":"requirement","statement":"An inbound webhook delivery SHALL start a workflow run only when its signature matches the secret of its endpoint.","rationale":"A caller without the secret cannot start work in the tenant.","evaluate":{"method":"scenario"},"ref":"INT-150","area":"04-automation","section":"Inbound webhooks","lifecycle":"active","boundary":"b-150","boundaryDetail":"`inbound webhook`","traces":["g-156"],"milestone":5,"inSection":"sec-integrations-2","realisation":"checked"},
    {"id":"int-151","kind":"requirement","statement":"A repeated inbound delivery of one event SHALL leave the number of runs that it started unchanged.","rationale":"Senders retry, and a retry does not run the workflow twice.","evaluate":{"method":"scenario"},"ref":"INT-151","area":"04-automation","section":"Inbound webhooks","lifecycle":"active","boundary":"b-150","boundaryDetail":"`inbound webhook`","traces":["g-156"],"milestone":5,"inSection":"sec-integrations-2","realisation":"checked"},
    {"id":"int-152","kind":"requirement","statement":"The tenant SHALL see the response status and the attempt count of each outbound webhook delivery that it sent.","rationale":"A failing receiver is diagnosed from the log rather than from guesses.","evaluate":{"method":"scenario"},"ref":"INT-152","area":"04-automation","section":"Outbound deliveries and the catalogue","lifecycle":"active","boundary":"b-150","boundaryDetail":"`webhook log`","traces":["g-156"],"milestone":5,"inSection":"sec-integrations-3","realisation":"checked"},
    {"id":"int-153","kind":"requirement","statement":"A workflow definition that names a trigger or an action outside the published catalogue SHALL be refused at activation.","rationale":"A workflow uses only what the platform describes and can check.","evaluate":{"method":"scenario"},"ref":"INT-153","area":"04-automation","section":"Outbound deliveries and the catalogue","lifecycle":"active","boundary":"b-8","boundaryDetail":"`activation`","traces":["g-156","g-16"],"milestone":5,"inSection":"sec-integrations-3","realisation":"checked"},
    {"id":"int-154","kind":"requirement","statement":"A tenant SHALL install a platform template or integration only after reviewing the projection of the changes it makes.","rationale":"Installing a template is a change, so it is projected like one.","evaluate":{"method":"scenario"},"ref":"INT-154","area":"04-automation","section":"Installed templates and integrations","lifecycle":"active","boundary":"b-21","boundaryDetail":"`template install`","traces":["g-167","g-44"],"milestone":7,"inSection":"sec-integrations-4","realisation":"checked"},
    {"id":"int-155","kind":"requirement","statement":"A bundle installed from the platform catalogue SHALL contain declared metadata and no executable code.","rationale":"Installing a bundle runs no code of its author, so review means reading what the bundle says.","evaluate":{"method":"property"},"ref":"INT-155","area":"04-automation","section":"Installed templates and integrations","lifecycle":"active","boundary":"b-21","boundaryDetail":"`tenant bundle`","traces":["g-167","ng-150"],"milestone":7,"inSection":"sec-integrations-4","realisation":"checked"},
    {"id":"sch-150","kind":"requirement","statement":"A bulk change to many records SHALL run as jobs that record the outcome of every record they change.","rationale":"A bulk change that stops halfway has a known extent.","evaluate":{"method":"scenario"},"ref":"SCH-150","area":"04-automation","section":"Bulk work","lifecycle":"active","boundary":"b-7","boundaryDetail":"`bulk job`","traces":["g-14"],"milestone":5,"inSection":"sec-scheduling-150","realisation":"checked"},
    {"id":"cms-150","kind":"requirement","statement":"A record SHALL be refused when one of its fields does not hold a value of the field type that its content type declares.","rationale":"The field types are the schema of the content, and every write is checked against them.","evaluate":{"method":"property"},"ref":"CMS-150","area":"07-content","section":"Authoring","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["g-31","g-150"],"milestone":6,"inSection":"sec-content-150","realisation":"checked"},
    {"id":"cms-151","kind":"requirement","statement":"A reference field SHALL name only a record of the content type that the field declares.","rationale":"A reference to the wrong kind of record breaks every page that follows it.","evaluate":{"method":"property"},"ref":"CMS-151","area":"07-content","section":"Authoring","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["g-31"],"milestone":6,"inSection":"sec-content-150","realisation":"checked"},
    {"id":"cms-152","kind":"requirement","statement":"Deleting a record that another record refers to SHALL be refused until the referring field is changed.","rationale":"A deletion leaves no dangling reference on a published page.","evaluate":{"method":"scenario"},"ref":"CMS-152","area":"07-content","section":"Authoring","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["g-31"],"milestone":6,"inSection":"sec-content-150","realisation":"checked"},
    {"id":"cms-153","kind":"requirement","statement":"Saving an edit to a published record SHALL leave its published version unchanged until the draft is published.","rationale":"Readers see a change when it is published, not when it is typed.","evaluate":{"method":"scenario"},"ref":"CMS-153","area":"07-content","section":"Authoring","lifecycle":"active","boundary":"b-1","boundaryDetail":"`draft save`","traces":["g-150"],"milestone":6,"inSection":"sec-content-150","realisation":"checked"},
    {"id":"cms-154","kind":"requirement","statement":"A record created in the authoring application SHALL start as a draft.","rationale":"Nothing a new record holds reaches readers before someone publishes it.","evaluate":{"method":"example"},"ref":"CMS-154","area":"07-content","section":"Authoring","lifecycle":"active","boundary":"b-13","boundaryDetail":"`authoring application`","traces":["g-150"],"milestone":6,"inSection":"sec-content-150","realisation":"checked"},
    {"id":"cms-155","kind":"requirement","statement":"A save from a copy of a draft that is older than the stored draft SHALL be refused, with the current version named.","rationale":"Two editors cannot overwrite each other without a trace.","evaluate":{"method":"scenario"},"ref":"CMS-155","area":"07-content","section":"Authoring","lifecycle":"active","boundary":"b-13","boundaryDetail":"`draft save`","traces":["g-150"],"milestone":6,"inSection":"sec-content-150","realisation":"checked"},
    {"id":"cms-156","kind":"requirement","statement":"A record of a content type that the tenant marks for review SHALL be published only after an approval by a principal that the review policy names.","rationale":"Review is a workflow step with a named approver, so it can be audited.","evaluate":{"method":"scenario"},"ref":"CMS-156","area":"07-content","section":"Review and publication","lifecycle":"active","boundary":"b-8","boundaryDetail":"`review step`","traces":["g-151","g-17"],"milestone":6,"inSection":"sec-content-151","realisation":"checked"},
    {"id":"cms-157","kind":"requirement","statement":"A reviewer SHALL see the differences between a draft and the published version of its record before approving it.","rationale":"A reviewer approves the change itself, not a summary of it.","evaluate":{"method":"scenario"},"ref":"CMS-157","area":"07-content","section":"Review and publication","lifecycle":"active","boundary":"b-13","boundaryDetail":"`review diff`","traces":["g-32"],"milestone":11,"inSection":"sec-content-151","realisation":"checked"},
    {"id":"cms-158","kind":"requirement","statement":"Scheduling a publication SHALL remain cancellable until the publication time.","rationale":"A scheduled change is a plan, and a plan changes until it runs.","evaluate":{"method":"scenario"},"ref":"CMS-158","area":"07-content","section":"Review and publication","lifecycle":"active","boundary":"b-7","boundaryDetail":"`publication time`","traces":["g-17"],"milestone":6,"inSection":"sec-content-151","realisation":"checked"},
    {"id":"cms-159","kind":"requirement","statement":"A preview link SHALL show one stated draft version of one record to a reader without an account, and stop showing it at the expiry that the link states.","rationale":"The reviewer sees what delivery would show, for as long as the review lasts.","evaluate":{"method":"scenario"},"ref":"CMS-159","area":"07-content","section":"Preview links","lifecycle":"active","boundary":"b-9","boundaryDetail":"`preview link`","traces":["g-158","g-20"],"milestone":6,"inSection":"sec-content-152","realisation":"checked"},
    {"id":"cms-160","kind":"requirement","statement":"A preview link SHALL grant access to no record and no screen of the authoring application other than its own draft version.","rationale":"A link sent to a reviewer opens one draft and nothing else.","evaluate":{"method":"scenario"},"ref":"CMS-160","area":"07-content","section":"Preview links","lifecycle":"active","boundary":"b-9","boundaryDetail":"`preview link`","traces":["g-158","g-20"],"milestone":6,"inSection":"sec-content-152","realisation":"checked"},
    {"id":"cms-161","kind":"requirement","statement":"Changing the address of a published page SHALL keep the former address answering with a redirect to the new address.","rationale":"Links from outside the site keep working after a page moves.","evaluate":{"method":"scenario"},"ref":"CMS-161","area":"07-content","section":"Addresses and redirects","lifecycle":"active","boundary":"b-9","boundaryDetail":"`address`","traces":["g-159"],"milestone":6,"inSection":"sec-content-153","realisation":"checked"},
    {"id":"cms-162","kind":"requirement","statement":"A redirect SHALL be refused when it would form a loop with the redirects of the same site.","rationale":"A loop is a page that no reader can reach.","evaluate":{"method":"scenario"},"ref":"CMS-162","area":"07-content","section":"Addresses and redirects","lifecycle":"active","boundary":"b-9","boundaryDetail":"`redirect`","traces":["g-159"],"milestone":6,"inSection":"sec-content-153","realisation":"checked"},
    {"id":"cms-163","kind":"requirement","statement":"A delivery query SHALL return only the fields that the request names in its field selection.","rationale":"Readers take the fields they ask for and no others, so responses stay small and private fields stay private.","evaluate":{"method":"property"},"ref":"CMS-163","area":"07-content","section":"Delivery interface","lifecycle":"active","boundary":"b-9","boundaryDetail":"`field selection`","traces":["g-152","d-507"],"milestone":6,"inSection":"sec-content-154","realisation":"checked"},
    {"id":"cms-164","kind":"requirement","statement":"A delivery list SHALL return one page of results together with the cursor that fetches the next page.","rationale":"Lists of any length arrive in pages that a client can finish.","evaluate":{"method":"scenario"},"ref":"CMS-164","area":"07-content","section":"Delivery interface","lifecycle":"active","boundary":"b-9","boundaryDetail":"`cursor`","traces":["g-152"],"milestone":6,"inSection":"sec-content-154","realisation":"checked"},
    {"id":"cms-165","kind":"requirement","statement":"A delivery list SHALL filter only on the fields that its named query declares as filterable.","rationale":"The filters a client can use are the ones the tenant chose to publish.","evaluate":{"method":"property"},"ref":"CMS-165","area":"07-content","section":"Delivery interface","lifecycle":"active","boundary":"b-9","boundaryDetail":"`named query`","traces":["g-152","g-31"],"milestone":6,"inSection":"sec-content-154","realisation":"checked"},
    {"id":"cms-166","kind":"requirement","statement":"A delivery key SHALL read only the site and the audience class that the key names.","rationale":"A key for one site cannot read another site of the same tenant.","evaluate":{"method":"scenario"},"ref":"CMS-166","area":"07-content","section":"Delivery interface","lifecycle":"active","boundary":"b-6","boundaryDetail":"`delivery key`","traces":["g-152","g-20","d-152"],"milestone":6,"inSection":"sec-content-154","realisation":"checked"},
    {"id":"cms-167","kind":"requirement","statement":"A delivery key that its owner revokes SHALL be refused by the delivery interface on the same terms as a revoked session.","rationale":"One revocation rule covers both kinds of credential.","evaluate":{"method":"scenario"},"ref":"CMS-167","area":"07-content","section":"Delivery interface","lifecycle":"active","boundary":"b-6","boundaryDetail":"`delivery key`","traces":["g-152","g-9"],"milestone":6,"inSection":"sec-content-154","realisation":"checked"},
    {"id":"cms-168","kind":"requirement","statement":"A throttled delivery response SHALL name the limit that applied and the time after which the next request is permitted, as a Retry-After value in seconds.","rationale":"A client that is told the limit can back off without guessing.","evaluate":{"method":"scenario"},"ref":"CMS-168","area":"07-content","section":"Delivery interface","lifecycle":"active","boundary":"b-9","boundaryDetail":"`429`","traces":["g-166","g-4"],"milestone":6,"inSection":"sec-content-154","realisation":"checked"},
    {"id":"cms-169","kind":"requirement","statement":"The delivery interface SHALL be described in a machine-readable document that names each operation with its input and output schema and its version.","rationale":"Clients and tools read the description instead of the documentation.","evaluate":{"method":"example"},"ref":"CMS-169","area":"07-content","section":"Delivery interface","lifecycle":"active","boundary":"b-9","boundaryDetail":"`description document`","traces":["g-152","g-166"],"milestone":6,"inSection":"sec-content-154","realisation":"checked"},
    {"id":"cms-170","kind":"requirement","statement":"A delivery version SHALL remain served for at least 90 days after its replacement is published, or for the longer period that its notice states.","rationale":"A client gets the time it was promised to move.","evaluate":{"method":"budget"},"ref":"CMS-170","area":"07-content","section":"Delivery interface","lifecycle":"active","boundary":"b-9","boundaryDetail":"`delivery version`","traces":["g-166","d-574"],"milestone":6,"inSection":"sec-content-154","realisation":"operational"},
    {"id":"cms-171","kind":"requirement","statement":"A change to the delivery interface SHALL appear in a changelog that names the version it introduced.","rationale":"Customers find changes where they already look.","evaluate":{"method":"example"},"ref":"CMS-171","area":"07-content","section":"Delivery interface","lifecycle":"active","boundary":"b-156","boundaryDetail":"`changelog`","traces":["g-166"],"milestone":6,"inSection":"sec-content-154","realisation":"checked"},
    {"id":"cms-173","kind":"requirement","statement":"A delivery key SHALL be a service account, with the secret, the rotation and the revocation of one.","rationale":"A delivery key is not a second kind of credential: it is issued, rotated and revoked as the service account it is (D-538, TOK-252).","evaluate":{"method":"scenario"},"ref":"CMS-173","area":"07-content","section":"Delivery interface","lifecycle":"active","boundary":"b-6","boundaryDetail":"`delivery key`","traces":["g-152","d-538"],"milestone":6,"inSection":"sec-content-154","realisation":"checked"},
    {"id":"cms-172","kind":"requirement","statement":"An import of records SHALL refuse a record whose fields its content type does not declare.","rationale":"An import cannot add fields that the schema does not have.","evaluate":{"method":"scenario"},"ref":"CMS-172","area":"07-content","section":"Import and export","lifecycle":"active","boundary":"b-153","boundaryDetail":"`record import`","traces":["g-163","g-31"],"milestone":11,"inSection":"sec-content-155","realisation":"checked"},
    {"id":"edg-150","kind":"requirement","statement":"A published site SHALL serve a sitemap that lists the address of each published page of that site.","rationale":"Search engines find the pages that the site lists, so the list is the site's own statement.","evaluate":{"method":"scenario"},"ref":"EDG-150","area":"05-delivery","section":"Discovery","lifecycle":"active","boundary":"b-9","boundaryDetail":"`sitemap`","traces":["g-159"],"milestone":6,"inSection":"sec-edge-150","realisation":"checked"},
    {"id":"edg-151","kind":"requirement","statement":"A collection of published records SHALL be served as a syndication feed that names the address and the publication time of each record.","rationale":"Readers who subscribe get each new record with its time.","evaluate":{"method":"scenario"},"ref":"EDG-151","area":"05-delivery","section":"Discovery","lifecycle":"active","boundary":"b-9","boundaryDetail":"`feed`","traces":["g-159"],"milestone":6,"inSection":"sec-edge-150","realisation":"checked"},
    {"id":"obs-150","kind":"requirement","statement":"A status page SHALL name the state of each component and of each open incident, for readers who hold no account.","rationale":"Customers check status without signing in, and tools read the same page.","evaluate":{"method":"scenario"},"ref":"OBS-150","area":"06-agents","section":"Status","lifecycle":"active","boundary":"b-156","boundaryDetail":"`status page`","traces":["g-27"],"milestone":8,"inSection":"sec-observability-150","realisation":"operational"},
    {"id":"frm-150","kind":"requirement","statement":"A form submission SHALL be stored in the tenant database before the reader is told that it was received.","rationale":"A reader is not told that a message arrived which the tenant cannot see.","evaluate":{"method":"scenario"},"ref":"FRM-150","area":"07-content","section":"Submissions","lifecycle":"active","boundary":"b-152","boundaryDetail":"`form submission`","traces":["g-162","d-153"],"milestone":11,"inSection":"sec-forms-2","realisation":"checked"},
    {"id":"frm-151","kind":"requirement","statement":"A form submission SHALL be refused when it carries no submission token that the form issued to the browser that sent it.","rationale":"Automated posts that did not load the form are refused.","evaluate":{"method":"scenario"},"ref":"FRM-151","area":"07-content","section":"Submissions","lifecycle":"active","boundary":"b-152","boundaryDetail":"`submission token`","traces":["g-162","g-20"],"milestone":11,"inSection":"sec-forms-2","realisation":"checked"},
    {"id":"frm-152","kind":"requirement","statement":"The notice of a submission SHALL be sent through the notification subscriptions that the form names.","rationale":"Submissions reach the people who handle them, by the channels they chose.","evaluate":{"method":"scenario"},"ref":"FRM-152","area":"07-content","section":"Submissions","lifecycle":"active","boundary":"b-154","boundaryDetail":"`submission notice`","traces":["g-162","g-155"],"milestone":11,"inSection":"sec-forms-2","realisation":"checked"},
    {"id":"frm-154","kind":"requirement","statement":"A person with the role that reads submissions SHALL export the submissions of a form as a document of their declared fields.","rationale":"The people who handle submissions can take them out of the platform.","evaluate":{"method":"scenario"},"ref":"FRM-154","area":"07-content","section":"Submissions","lifecycle":"active","boundary":"b-153","boundaryDetail":"`form export`","traces":["g-162"],"milestone":11,"inSection":"sec-forms-2","realisation":"checked"},
    {"id":"srh-150","kind":"requirement","statement":"A search over a site SHALL return only the published records that the audience class of the reader permits.","rationale":"Search is a read like any other, decided by the same policies.","evaluate":{"method":"property"},"ref":"SRH-150","area":"07-content","section":"Queries","lifecycle":"active","boundary":"b-151","boundaryDetail":"`search query`","traces":["g-161","g-20","d-504","d-512"],"milestone":11,"inSection":"sec-search-2","realisation":"checked"},
    {"id":"srh-151","kind":"requirement","statement":"A search by an editor SHALL return the drafts that the editor's roles permit reading, each with its status.","rationale":"An editor finds unpublished work without seeing work the roles do not permit reading.","evaluate":{"method":"scenario"},"ref":"SRH-151","area":"07-content","section":"Queries","lifecycle":"active","boundary":"b-151","boundaryDetail":"`search query`","traces":["g-161"],"milestone":11,"inSection":"sec-search-2","realisation":"checked"},
    {"id":"srh-152","kind":"requirement","statement":"A search entry SHALL follow the commit of the record it was made from, including the commit of its deletion.","rationale":"A deleted record is not found, and an edited one is found by its new words.","evaluate":{"method":"scenario"},"ref":"SRH-152","area":"07-content","section":"Queries","lifecycle":"active","boundary":"b-151","boundaryDetail":"`search entry`","traces":["g-161","g-22","d-153"],"milestone":11,"inSection":"sec-search-2","realisation":"checked"},
    {"id":"m-inbound-repeat-single-run","kind":"invariant","models":"int-151","statement":"In the repeated inbound delivery scenario, a repeated delivery of one event starts no second run.","evaluate":{"method":"state-invariant","scenarios":["inbound-repeated-delivery","inbound-delivery-redelivered"],"expr":"inbound-run-flow.runs <= 1","negatives":[{"scenario":"inbound-repeated-delivery","faults":["defect-webhook-no-dedupe"]},{"scenario":"inbound-delivery-redelivered","faults":["defect-webhook-no-dedupe"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-preview-expired-refused","kind":"temporal","models":"cms-159","statement":"A preview link presented after its expiry shows no draft.","evaluate":{"method":"never","scenarios":["preview-presented-late","preview-presentation-in-transit"],"occurs":{"event":"pl-shown"},"negatives":[{"scenario":"preview-presented-late","faults":["defect-preview-unchecked"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-tick"],"faultBasis":"fault"},
    {"id":"cnv-200","kind":"requirement","statement":"For every operation that the assistant proposes, the same operation with the same input SHALL be available to the person in the authoring application.","rationale":"The assistant is a client of the catalogue, not a second way to change the platform.","evaluate":{"method":"property"},"ref":"CNV-200","area":"09-conversation","section":"Operations and authority","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /operations`","traces":["g-200","d-200"],"milestone":9,"inSection":"sec-conversation-2","realisation":"checked"},
    {"id":"cnv-201","kind":"requirement","statement":"The assistant SHALL call each operation only with the delegated token of the person it acts for.","rationale":"The token names both the assistant and the person, so every request carries its own attribution.","evaluate":{"method":"scenario"},"ref":"CNV-201","area":"09-conversation","section":"Operations and authority","lifecycle":"active","boundary":"b-11","boundaryDetail":"`POST /operations/{name}`","traces":["g-200","d-200","k-13"],"milestone":9,"inSection":"sec-conversation-2","realisation":"checked"},
    {"id":"cnv-202","kind":"requirement","statement":"The operation catalogue SHALL refuse a call by the assistant for each operation that the person it acts for lacks permission to attempt.","rationale":"The assistant is held to the person's permissions at the one place every call passes.","evaluate":{"method":"property"},"ref":"CNV-202","area":"09-conversation","section":"Operations and authority","lifecycle":"active","boundary":"b-11","boundaryDetail":"`POST /operations/{name}`","traces":["g-200","k-13"],"milestone":9,"inSection":"sec-conversation-2","realisation":"checked"},
    {"id":"cnv-203","kind":"requirement","statement":"When the permissions of a person change during a conversation, the assistant SHALL use the permissions that person holds when each operation runs.","rationale":"A permission withdrawn in the middle of a conversation stops the work, including work already previewed.","evaluate":{"method":"scenario"},"ref":"CNV-203","area":"09-conversation","section":"Operations and authority","lifecycle":"active","boundary":"b-11","boundaryDetail":"`POST /operations/{name}`","traces":["g-200","k-13"],"milestone":9,"inSection":"sec-conversation-2","realisation":"checked"},
    {"id":"cnv-205","kind":"requirement","statement":"A preview SHALL list the records that the change creates, changes and removes, and the views that the change alters.","rationale":"The preview is the projection the person confirms, so it names what changes.","evaluate":{"method":"example"},"ref":"CNV-205","area":"09-conversation","section":"Preview and confirmation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`GET /pending-actions/{id}`","traces":["g-201"],"milestone":9,"inSection":"sec-conversation-3","realisation":"checked"},
    {"id":"cnv-206","kind":"requirement","statement":"A change SHALL be applied only after the person confirms the preview that shows it.","rationale":"Confirmation is the step that turns a suggestion into a change.","evaluate":{"method":"scenario"},"ref":"CNV-206","area":"09-conversation","section":"Preview and confirmation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /pending-actions/{id}/confirm`","traces":["g-201","d-201"],"milestone":9,"inSection":"sec-conversation-3","realisation":"checked"},
    {"id":"cnv-207","kind":"requirement","statement":"A confirmation SHALL bind to the preview it answers, so that an edited or replaced preview needs a new confirmation.","rationale":"A yes to one preview is not a yes to a different change.","evaluate":{"method":"scenario"},"ref":"CNV-207","area":"09-conversation","section":"Preview and confirmation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /pending-actions/{id}/confirm`","traces":["g-201","d-201"],"milestone":9,"inSection":"sec-conversation-3","realisation":"checked"},
    {"id":"cnv-208","kind":"requirement","statement":"A change that tenant policy classes as risky SHALL reach the person as a proposal with its projection, and no control in the conversation applies it directly.","rationale":"Risky changes keep the proposal flow of the agent plane (D-19) whichever interface asks for them.","evaluate":{"method":"scenario"},"ref":"CNV-208","area":"09-conversation","section":"Preview and confirmation","lifecycle":"active","boundary":"b-11","boundaryDetail":"`POST /proposals`","traces":["g-26","d-19","g-201"],"milestone":9,"inSection":"sec-conversation-3","realisation":"checked"},
    {"id":"cnv-209","kind":"requirement","statement":"Undoing a change SHALL preview its inverse operation and apply that inverse only after the person confirms.","rationale":"Undo is a change in its own right, so it is previewed and confirmed like any other.","evaluate":{"method":"scenario"},"ref":"CNV-209","area":"09-conversation","section":"Preview and confirmation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /turns/{id}/undo`","traces":["g-25","g-201"],"milestone":9,"inSection":"sec-conversation-3","realisation":"checked"},
    {"id":"cnv-210","kind":"requirement","statement":"A preview that the person cancels SHALL apply no change to any record.","rationale":"Cancelling stops the proposal it belongs to.","evaluate":{"method":"scenario"},"ref":"CNV-210","area":"09-conversation","section":"Preview and confirmation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /pending-actions/{id}/cancel`","traces":["g-201"],"milestone":9,"inSection":"sec-conversation-3","realisation":"checked"},
    {"id":"cnv-211","kind":"requirement","statement":"A preview SHALL be shown within 3 seconds at the 95th percentile for a tenant of one hundred thousand records.","rationale":"A person waits for the preview before deciding, so the wait is bounded.","evaluate":{"method":"budget"},"ref":"CNV-211","area":"09-conversation","section":"Preview and confirmation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`GET /pending-actions/{id}`","traces":["g-201"],"milestone":9,"inSection":"sec-conversation-3","realisation":"operational"},
    {"id":"cnv-212","kind":"requirement","statement":"A refusal shown in the conversation SHALL name the policy that refused the person and the next step open to the person.","rationale":"A person acts on the reason for a refusal, which the kernel returns as failed checks.","evaluate":{"method":"scenario"},"ref":"CNV-212","area":"09-conversation","section":"Explanation and evidence","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /conversations/{id}/turns`","traces":["g-202","g-24"],"milestone":9,"inSection":"sec-conversation-4","realisation":"checked"},
    {"id":"cnv-213","kind":"requirement","statement":"An answer about what an action would do SHALL come from a dry run of that action, named in the answer.","rationale":"Predictions come from the decision the platform would make, not from the model.","evaluate":{"method":"scenario"},"ref":"CNV-213","area":"09-conversation","section":"Explanation and evidence","lifecycle":"active","boundary":"b-11","boundaryDetail":"`dry run`","traces":["g-202","g-24"],"milestone":9,"inSection":"sec-conversation-4","realisation":"checked"},
    {"id":"cnv-214","kind":"requirement","statement":"For every statement about tenant data that a conversation reply makes, the reply SHALL cite the operation, projection or audit entry that the statement was read from.","rationale":"A statement the reply did not read is a guess, and the person needs to tell the two apart.","evaluate":{"method":"property"},"ref":"CNV-214","area":"09-conversation","section":"Explanation and evidence","lifecycle":"active","boundary":"b-200","boundaryDetail":"`reply`","traces":["g-202","k-2"],"milestone":9,"inSection":"sec-conversation-4","realisation":"checked"},
    {"id":"cnv-215","kind":"requirement","statement":"A reply that has no source for an answer SHALL say so in place of the answer.","rationale":"Silence about the source is not an answer.","evaluate":{"method":"scenario"},"ref":"CNV-215","area":"09-conversation","section":"Explanation and evidence","lifecycle":"active","boundary":"b-200","boundaryDetail":"`reply`","traces":["g-202"],"milestone":9,"inSection":"sec-conversation-4","realisation":"checked"},
    {"id":"cnv-216","kind":"requirement","statement":"A reply SHALL open, point at or fill a view of the authoring application using the view definition that the person would open directly.","rationale":"The conversation and the direct interface show the same screen.","evaluate":{"method":"scenario"},"ref":"CNV-216","area":"09-conversation","section":"One interface","lifecycle":"active","boundary":"b-13","boundaryDetail":"`view definition`","traces":["g-203","d-204"],"milestone":9,"inSection":"sec-conversation-5","realisation":"checked"},
    {"id":"cnv-217","kind":"requirement","statement":"The authoring application SHALL send the current selection to the conversation as context, and show the person that context before the next turn is sent.","rationale":"The selection is what the person is pointing at, so the assistant receives it without a copy step.","evaluate":{"method":"scenario"},"ref":"CNV-217","area":"09-conversation","section":"One interface","lifecycle":"active","boundary":"b-13","boundaryDetail":"`selection`","traces":["g-203"],"milestone":9,"inSection":"sec-conversation-5","realisation":"checked"},
    {"id":"cnv-218","kind":"requirement","statement":"A direct edit in the authoring application SHALL take effect while a reply is in progress, without waiting for that reply.","rationale":"The person can take over at any point.","evaluate":{"method":"scenario"},"ref":"CNV-218","area":"09-conversation","section":"One interface","lifecycle":"active","boundary":"b-13","boundaryDetail":"`edit`","traces":["g-203"],"milestone":9,"inSection":"sec-conversation-5","realisation":"checked"},
    {"id":"cnv-219","kind":"requirement","statement":"For every interface that a reply generates, the interface SHALL be rendered from a view definition and structured blocks, not from markup that a model produced.","rationale":"Generated interfaces are data the platform renders, so a model cannot inject script or style.","evaluate":{"method":"property"},"ref":"CNV-219","area":"09-conversation","section":"One interface","lifecycle":"active","boundary":"b-200","boundaryDetail":"`reply blocks`","traces":["k-12","d-204"],"milestone":9,"inSection":"sec-conversation-5","realisation":"checked"},
    {"id":"cnv-220","kind":"requirement","statement":"A reply SHALL stream as it is produced and end in one recorded state: complete, interrupted or failed.","rationale":"A stream that ends without a state cannot be resumed or explained.","evaluate":{"method":"scenario"},"ref":"CNV-220","area":"09-conversation","section":"Replies, streams and cancellation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`GET /conversations/{id}/stream`","traces":["g-203"],"milestone":9,"inSection":"sec-conversation-6","realisation":"checked"},
    {"id":"cnv-221","kind":"requirement","statement":"Cancelling a reply SHALL stop the model output and every operation of that reply that has not committed.","rationale":"The person's stop applies to the work as well as the words.","evaluate":{"method":"scenario"},"ref":"CNV-221","area":"09-conversation","section":"Replies, streams and cancellation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /turns/{id}/cancel`","traces":["g-201"],"milestone":9,"inSection":"sec-conversation-6","realisation":"checked"},
    {"id":"cnv-222","kind":"requirement","statement":"For every operation of a reply that is cancelled before its commit, the operation SHALL commit no change to any record.","rationale":"An operation that commits after a cancel is the defect cancellation exists to prevent.","evaluate":{"method":"property"},"ref":"CNV-222","area":"09-conversation","section":"Replies, streams and cancellation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /turns/{id}/cancel`","traces":["g-201"],"milestone":9,"inSection":"sec-conversation-6","realisation":"checked"},
    {"id":"cnv-223","kind":"requirement","statement":"A browser that reloads during a reply SHALL resume the reply from its last recorded part, with no part shown twice.","rationale":"A reload must neither lose the reply nor repeat it.","evaluate":{"method":"scenario"},"ref":"CNV-223","area":"09-conversation","section":"Replies, streams and cancellation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`GET /conversations/{id}/stream`","traces":["g-203"],"milestone":9,"inSection":"sec-conversation-6","realisation":"checked"},
    {"id":"cnv-224","kind":"requirement","statement":"The conversation service SHALL send the first part of a reply within 1 second at the 95th percentile after it accepts the person's message.","rationale":"Measures the platform time to the first part, with the model adapter replying from a fixed script.","evaluate":{"method":"budget"},"ref":"CNV-224","area":"09-conversation","section":"Replies, streams and cancellation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`GET /conversations/{id}/stream`","traces":["g-204"],"milestone":9,"inSection":"sec-conversation-6","realisation":"operational"},
    {"id":"cnv-225","kind":"requirement","statement":"A cancellation SHALL take effect within 1 second at the 99th percentile after the person cancels.","rationale":"A stop that arrives late is not a stop.","evaluate":{"method":"budget"},"ref":"CNV-225","area":"09-conversation","section":"Replies, streams and cancellation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /turns/{id}/cancel`","traces":["g-201"],"milestone":9,"inSection":"sec-conversation-6","realisation":"operational"},
    {"id":"cnv-226","kind":"requirement","statement":"The conversation service SHALL keep every turn of a conversation as tenant data in the tenant database and no transcript in the browser.","rationale":"Conversations follow the tenant, so they are exported and deleted with it (K-2).","evaluate":{"method":"property"},"ref":"CNV-226","area":"09-conversation","section":"Records, retention and visibility","lifecycle":"active","boundary":"b-200","boundaryDetail":"`conversation record`","traces":["k-2","g-200","d-203"],"milestone":9,"inSection":"sec-conversation-7","realisation":"checked"},
    {"id":"cnv-227","kind":"requirement","statement":"Each change that the assistant makes SHALL appear in the audit log with the person it acted for, and in the history of the record it changed, visible to each member permitted to read that record.","rationale":"Several people can see what an assistant did on someone's behalf, and the record says whom it acted for.","evaluate":{"method":"scenario"},"ref":"CNV-227","area":"09-conversation","section":"Records, retention and visibility","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit entry`","traces":["g-25","g-30"],"milestone":9,"inSection":"sec-conversation-7","realisation":"checked"},
    {"id":"cnv-228","kind":"requirement","statement":"For every turn of a conversation, the turn SHALL name by principal identifier the principal that wrote it.","rationale":"Assistant turns and person turns are attributed the same way as other records.","evaluate":{"method":"property"},"ref":"CNV-228","area":"09-conversation","section":"Records, retention and visibility","lifecycle":"active","boundary":"b-200","boundaryDetail":"`turn record`","traces":["g-25","g-200"],"milestone":9,"inSection":"sec-conversation-7","realisation":"checked"},
    {"id":"cnv-229","kind":"requirement","statement":"Deleting a conversation SHALL remove its turns, its pending actions and its model request context within the erasure bound of its class.","rationale":"Conversation history has retention and erasure like any other tenant data.","evaluate":{"method":"scenario"},"ref":"CNV-229","area":"09-conversation","section":"Records, retention and visibility","lifecycle":"active","boundary":"b-200","boundaryDetail":"`DELETE /conversations/{id}`","traces":["g-22","k-8"],"milestone":9,"inSection":"sec-conversation-7","realisation":"checked"},
    {"id":"cnv-230","kind":"requirement","statement":"A conversation SHALL be readable only by the principal that started it and by holders of the tenant's audit permission.","rationale":"Other members see the effects of the assistant in records and in the audit log, not the private conversation.","evaluate":{"method":"scenario"},"ref":"CNV-230","area":"09-conversation","section":"Records, retention and visibility","lifecycle":"active","boundary":"b-200","boundaryDetail":"`GET /conversations/{id}`","traces":["g-20"],"milestone":9,"inSection":"sec-conversation-7","realisation":"checked"},
    {"id":"cnv-231","kind":"requirement","statement":"The model provider adapters SHALL pass every check of the model provider conformance table.","rationale":"An adapter is accepted by behaviour, as the store adapters are.","evaluate":{"method":"conformance"},"ref":"CNV-231","area":"09-conversation","section":"Model provider","lifecycle":"active","boundary":"b-201","boundaryDetail":"`model provider contract`","traces":["g-38","d-202"],"milestone":9,"inSection":"sec-conversation-8","cases":["cases-model-provider-conformance"],"realisation":"checked"},
    {"id":"cnv-232","kind":"requirement","statement":"The local stack SHALL answer a conversation turn through the local model adapter without any cloud credential.","rationale":"The conversation runs in containers with no account, as the rest of the platform does.","evaluate":{"method":"scenario"},"ref":"CNV-232","area":"09-conversation","section":"Model provider","lifecycle":"active","boundary":"b-19","boundaryDetail":"`compose file`","traces":["g-36","k-10"],"milestone":9,"inSection":"sec-conversation-8","realisation":"checked"},
    {"id":"cnv-233","kind":"requirement","statement":"For every model request, the content sent to the model provider SHALL be only the content that the tenant policy permits for the read of the person the request serves.","rationale":"Tenant content reaches a model only as far as a read by that person would reach.","evaluate":{"method":"property"},"ref":"CNV-233","area":"09-conversation","section":"Model provider","lifecycle":"active","boundary":"b-201","boundaryDetail":"`model request`","traces":["k-200","g-205"],"milestone":9,"inSection":"sec-conversation-8","realisation":"checked"},
    {"id":"cnv-234","kind":"requirement","statement":"A tenant that turns the assistant off SHALL have every conversation refused and no model request made, while its records stay readable.","rationale":"Turning the assistant off stops the disclosure and loses nothing.","evaluate":{"method":"scenario"},"ref":"CNV-234","area":"09-conversation","section":"Model provider","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /conversations/{id}/turns`","traces":["g-205"],"milestone":9,"inSection":"sec-conversation-8","realisation":"checked"},
    {"id":"cnv-235","kind":"requirement","statement":"The conversation service SHALL send tenant content to a model provider only under a contract that forbids the provider to train a model on that content.","rationale":"Tenant content is not training material unless the tenant contract says so.","evaluate":{"method":"property"},"ref":"CNV-235","area":"09-conversation","section":"Model provider","lifecycle":"active","boundary":"b-201","boundaryDetail":"`model request`","traces":["g-205"],"milestone":9,"inSection":"sec-conversation-8","realisation":"checked"},
    {"id":"cnv-236","kind":"requirement","statement":"Each reply SHALL name the model provider and the model that produced it.","rationale":"A person can see which system answered.","evaluate":{"method":"example"},"ref":"CNV-236","area":"09-conversation","section":"Model provider","lifecycle":"active","boundary":"b-200","boundaryDetail":"`reply`","traces":["g-205"],"milestone":9,"inSection":"sec-conversation-8","realisation":"checked"},
    {"id":"cnv-237","kind":"requirement","statement":"The conversation SHALL announce a streamed reply in a live region that receives one message when the reply starts and one when it ends.","rationale":"A reply that announces every part floods a screen reader.","evaluate":{"method":"example"},"ref":"CNV-237","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`live region`","traces":["g-204"],"milestone":9,"inSection":"sec-conversation-9","realisation":"checked"},
    {"id":"cnv-238","kind":"requirement","statement":"Every control of the conversation SHALL be operable with the keyboard alone.","rationale":"A conversation that needs a pointer is not usable by everyone.","evaluate":{"method":"example"},"ref":"CNV-238","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`conversation controls`","traces":["g-204"],"milestone":9,"inSection":"sec-conversation-9","realisation":"checked"},
    {"id":"cnv-239","kind":"requirement","statement":"When a preview appears in answer to a message the person sent, focus SHALL move to it, and an unasked preview is announced without moving focus.","rationale":"Focus moves only when the person asked for the result.","evaluate":{"method":"scenario"},"ref":"CNV-239","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`preview`","traces":["g-204"],"milestone":9,"inSection":"sec-conversation-9","realisation":"checked"},
    {"id":"cnv-240","kind":"requirement","statement":"The live region of the conversation SHALL announce no more than one message per 10 seconds while a reply streams.","rationale":"A bounded announcement rate keeps a screen reader usable during a long reply.","evaluate":{"method":"budget"},"ref":"CNV-240","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`live region`","traces":["g-204"],"milestone":9,"inSection":"sec-conversation-9","realisation":"operational"},
    {"id":"cnv-241","kind":"requirement","statement":"Motion in the conversation SHALL stop while the person prefers reduced motion.","rationale":"Reduced motion is a setting the platform honours.","evaluate":{"method":"example"},"ref":"CNV-241","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`conversation`","traces":["g-204"],"milestone":9,"inSection":"sec-conversation-9","realisation":"checked"},
    {"id":"cnv-242","kind":"requirement","statement":"A stream SHALL resume within 3 seconds at the 95th percentile after a dropped connection is restored.","rationale":"Poor networks drop connections, and the reply should carry on from where it stopped.","evaluate":{"method":"budget"},"ref":"CNV-242","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`GET /conversations/{id}/stream`","traces":["g-204"],"milestone":9,"inSection":"sec-conversation-9","realisation":"operational"},
    {"id":"cnv-243","kind":"requirement","statement":"Every control of the conversation SHALL have a target of at least 24 CSS pixels in each direction at a width of 360 CSS pixels.","rationale":"The minimum target size of WCAG 2.2 at the narrowest phone width the platform supports.","evaluate":{"method":"budget"},"ref":"CNV-243","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`conversation controls`","traces":["g-204"],"milestone":9,"inSection":"sec-conversation-9","realisation":"operational"},
    {"id":"cnv-244","kind":"requirement","statement":"A reply SHALL reflow without horizontal scrolling at a width of 360 CSS pixels.","rationale":"A long reply does not need sideways scrolling on a phone.","evaluate":{"method":"budget"},"ref":"CNV-244","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`reply`","traces":["g-204"],"milestone":9,"inSection":"sec-conversation-9","realisation":"operational"},
    {"id":"cnv-245","kind":"requirement","statement":"While the connection is lost, the conversation SHALL keep the drafted message and send it once when the connection returns, with no duplicate turn.","rationale":"A message written on a train arrives once.","evaluate":{"method":"scenario"},"ref":"CNV-245","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`draft`","traces":["g-204"],"milestone":9,"inSection":"sec-conversation-9","realisation":"checked"},
    {"id":"cnv-246","kind":"requirement","statement":"A reply SHALL follow the language of the message it answers, and the interface text of the conversation follows the language the person chose.","rationale":"Localisation of the conversation follows the localisation of content (G-34).","evaluate":{"method":"example"},"ref":"CNV-246","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`reply`","traces":["g-34","g-204","d-515"],"milestone":11,"inSection":"sec-conversation-9","realisation":"checked"},
    {"id":"cnv-247","kind":"requirement","statement":"A new tenant SHALL be set up through the conversation by choosing a template, defining its content types and inviting people, with each step applied only after the person confirms it.","rationale":"Onboarding uses the same previews and confirmations as every other change.","evaluate":{"method":"scenario"},"ref":"CNV-247","area":"09-conversation","section":"Onboarding","lifecycle":"active","boundary":"b-200","boundaryDetail":"`conversation`","traces":["g-207","g-2"],"milestone":11,"inSection":"sec-conversation-10","realisation":"checked"},
    {"id":"cnv-248","kind":"requirement","statement":"Text from a source outside the tenant, such as a received email or a fetched web page, SHALL be shown with a label that names its source wherever the conversation presents it.","rationale":"The person sees that text came from outside the tenant. This is the interface half of the defence against injected instructions.","evaluate":{"method":"example"},"ref":"CNV-248","area":"09-conversation","section":"Untrusted content","lifecycle":"active","boundary":"b-200","boundaryDetail":"`reply`","traces":["k-12","g-200"],"milestone":9,"inSection":"sec-conversation-11","realisation":"checked"},
    {"id":"uxa-200","kind":"requirement","statement":"An empty list in the authoring application SHALL name what it will hold and offer the action that fills it.","rationale":"An empty list that says nothing tells a person nothing.","evaluate":{"method":"example"},"ref":"UXA-200","area":"09-conversation","section":"Empty states, errors and sign-in","lifecycle":"active","boundary":"b-13","boundaryDetail":"`authoring application list`","traces":["g-206"],"milestone":11,"inSection":"sec-authoring-2","realisation":"checked"},
    {"id":"uxa-201","kind":"requirement","statement":"An error in the authoring application SHALL name the field or record it concerns and say how to correct it.","rationale":"An error that names no field sends the person looking for the problem.","evaluate":{"method":"example"},"ref":"UXA-201","area":"09-conversation","section":"Empty states, errors and sign-in","lifecycle":"active","boundary":"b-13","boundaryDetail":"`authoring application error`","traces":["g-206"],"milestone":11,"inSection":"sec-authoring-2","realisation":"checked"},
    {"id":"uxa-202","kind":"requirement","statement":"A sign-in error SHALL state the next step in words that do not depend on whether the address has an account.","rationale":"The person learns what to do without learning who has an account.","evaluate":{"method":"example"},"ref":"UXA-202","area":"09-conversation","section":"Empty states, errors and sign-in","lifecycle":"active","boundary":"b-13","boundaryDetail":"`POST /sign-in/{method}`","traces":["g-46","g-206"],"milestone":3,"inSection":"sec-authoring-2","realisation":"checked"},
    {"id":"uxa-203","kind":"requirement","statement":"The sign-in page SHALL offer recovery beside every sign-in method it offers, so that a person who has lost every method reaches recovery from the same page.","rationale":"A locked-out person needs recovery on the page they are already on.","evaluate":{"method":"example"},"ref":"UXA-203","area":"09-conversation","section":"Empty states, errors and sign-in","lifecycle":"active","boundary":"b-13","boundaryDetail":"`sign-in page`","traces":["g-46","g-206"],"milestone":3,"inSection":"sec-authoring-2","realisation":"checked"},
    {"id":"uxa-204","kind":"requirement","statement":"The authoring application SHALL save a draft within 2 seconds after the person's last edit.","rationale":"Autosave removes the fear of losing work without a save control.","evaluate":{"method":"budget"},"ref":"UXA-204","area":"09-conversation","section":"Drafts, saves and conflicts","lifecycle":"active","boundary":"b-13","boundaryDetail":"`draft`","traces":["g-206"],"milestone":11,"inSection":"sec-authoring-3","realisation":"operational"},
    {"id":"uxa-205","kind":"requirement","statement":"A draft not yet saved SHALL stay on screen through a connection loss and be sent when the connection returns.","rationale":"A dropped connection does not discard typed work.","evaluate":{"method":"scenario"},"ref":"UXA-205","area":"09-conversation","section":"Drafts, saves and conflicts","lifecycle":"active","boundary":"b-13","boundaryDetail":"`draft`","traces":["g-206"],"milestone":11,"inSection":"sec-authoring-3","realisation":"checked"},
    {"id":"uxa-206","kind":"requirement","statement":"When two people save changes to one record from the same version, the second save SHALL be refused with both versions shown.","rationale":"A silent overwrite is the defect that collaborative editing exists to prevent.","evaluate":{"method":"scenario"},"ref":"UXA-206","area":"09-conversation","section":"Drafts, saves and conflicts","lifecycle":"active","boundary":"b-202","boundaryDetail":"`PUT /records/{id}`","traces":["g-206","g-32"],"milestone":11,"inSection":"sec-authoring-3","realisation":"checked"},
    {"id":"uxa-207","kind":"requirement","statement":"A resolved conflict SHALL become a new version in which the person chose the value of each field that conflicted.","rationale":"The history records the decision and keeps the earlier versions.","evaluate":{"method":"scenario"},"ref":"UXA-207","area":"09-conversation","section":"Drafts, saves and conflicts","lifecycle":"active","boundary":"b-202","boundaryDetail":"`PUT /records/{id}`","traces":["g-206","g-32"],"milestone":11,"inSection":"sec-authoring-3","realisation":"checked"},
    {"id":"uxa-208","kind":"requirement","statement":"A change of another editor's presence SHALL appear in the authoring application within 3 seconds at the 95th percentile.","rationale":"Presence that lags says nothing about who is editing now.","evaluate":{"method":"budget"},"ref":"UXA-208","area":"09-conversation","section":"Drafts, saves and conflicts","lifecycle":"active","boundary":"b-202","boundaryDetail":"`presence`","traces":["g-206"],"milestone":11,"inSection":"sec-authoring-3","realisation":"operational"},
    {"id":"uxa-209","kind":"requirement","statement":"The authoring application SHALL show by display name each other person editing a record before the person starts editing it.","rationale":"Two people on one field are found before the second one types.","evaluate":{"method":"example"},"ref":"UXA-209","area":"09-conversation","section":"Drafts, saves and conflicts","lifecycle":"active","boundary":"b-202","boundaryDetail":"`presence`","traces":["g-206"],"milestone":11,"inSection":"sec-authoring-3","realisation":"checked"},
    {"id":"uxa-210","kind":"requirement","statement":"The authoring application SHALL mark a change shown before the server confirms it as pending, and withdraw it with its reason when the server refuses it.","rationale":"An optimistic change that is reverted without a reason teaches people not to trust the screen.","evaluate":{"method":"scenario"},"ref":"UXA-210","area":"09-conversation","section":"Drafts, saves and conflicts","lifecycle":"active","boundary":"b-13","boundaryDetail":"`save`","traces":["g-206"],"milestone":11,"inSection":"sec-authoring-3","realisation":"checked"},
    {"id":"uxa-211","kind":"requirement","statement":"A session that ends during editing SHALL keep the unsaved changes on screen and offer sign-in again without losing them.","rationale":"Revocation or expiry does not take unsaved work with it.","evaluate":{"method":"scenario"},"ref":"UXA-211","area":"09-conversation","section":"Sessions, destructive actions and layout","lifecycle":"active","boundary":"b-13","boundaryDetail":"`session`","traces":["g-9","g-206"],"milestone":11,"inSection":"sec-authoring-4","realisation":"checked"},
    {"id":"uxa-212","kind":"requirement","statement":"A destructive action SHALL name what it removes and require a confirmation that repeats that name.","rationale":"Deleting the wrong record is the most expensive mistake an author can make.","evaluate":{"method":"example"},"ref":"UXA-212","area":"09-conversation","section":"Sessions, destructive actions and layout","lifecycle":"active","boundary":"b-13","boundaryDetail":"`destructive action`","traces":["g-206"],"milestone":11,"inSection":"sec-authoring-4","realisation":"checked"},
    {"id":"uxa-213","kind":"requirement","statement":"The sign-in page SHALL show its first content within 1 second at the 95th percentile.","rationale":"Signing in is the one flow nobody can skip.","evaluate":{"method":"budget"},"ref":"UXA-213","area":"09-conversation","section":"Empty states, errors and sign-in","lifecycle":"active","boundary":"b-13","boundaryDetail":"`GET /sign-in`","traces":["g-45"],"milestone":3,"inSection":"sec-authoring-2","realisation":"operational"},
    {"id":"uxa-214","kind":"requirement","statement":"Each view of the authoring application SHALL reflow without horizontal scrolling at a width of 360 CSS pixels.","rationale":"Authors on a phone can read and edit every view.","evaluate":{"method":"budget"},"ref":"UXA-214","area":"09-conversation","section":"Sessions, destructive actions and layout","lifecycle":"active","boundary":"b-13","boundaryDetail":"`view`","traces":["g-45","g-206"],"milestone":11,"inSection":"sec-authoring-4","realisation":"operational"},
    {"id":"m-cv-applied-after-confirmation","kind":"invariant","models":"cnv-206","statement":"A change the assistant applied was confirmed by the person first.","evaluate":{"method":"state-invariant","scenarios":["cv-confirmed-apply","cv-unconfirmed-apply","cv-cancelled-preview","cv-confirmation-in-transit"],"expr":"cv-change-flow.applied => cv-change-flow.confirmed","negatives":[{"scenario":"cv-unconfirmed-apply","faults":["defect-cv-apply-unconfirmed"]},{"scenario":"cv-confirmation-in-transit","faults":["defect-cv-apply-unconfirmed"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-cv-unconfirmed-never-applied","kind":"temporal","models":"cnv-206","statement":"A change applied before the person confirmed it never commits.","evaluate":{"method":"never","scenarios":["cv-unconfirmed-apply","cv-apply-before-delayed-confirmation"],"occurs":{"event":"cv-applied"},"negatives":[{"scenario":"cv-unconfirmed-apply","faults":["defect-cv-apply-unconfirmed"]},{"scenario":"cv-apply-before-delayed-confirmation","faults":["defect-cv-apply-unconfirmed"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-cv-stale-authority-refused","kind":"temporal","models":"cnv-203","statement":"An operation whose permission was withdrawn before it runs never commits.","evaluate":{"method":"never","scenarios":["cv-withdrawn-before-run","cv-run-in-transit-past-withdrawal"],"occurs":{"event":"cv-operation-committed"},"negatives":[{"scenario":"cv-withdrawn-before-run","faults":["defect-cv-apply-stale"]},{"scenario":"cv-run-in-transit-past-withdrawal","faults":["defect-cv-apply-stale"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-cv-permitted-operation-commits","kind":"temporal","models":"cnv-203","statement":"An operation run while its permission holds commits.","evaluate":{"method":"eventually","scenarios":["cv-permitted-run"],"occurs":{"event":"cv-operation-committed"},"negatives":[{"scenario":"cv-permitted-run","faults":["cv-run-disabled"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"restatement"},
    {"id":"m-conversation-reaches-data-through-store","kind":"structural","models":"cnv-226","statement":"Every path from the conversation service to a tenant database passes through the store contract.","evaluate":{"method":"only-via","from":"conversation-service","to":"tenant-database","via":"store-contract"},"assumptions":["a-model-abstraction"]},
    {"id":"m-browser-reaches-conversation-through-gateway","kind":"structural","models":"cnv-700","statement":"Every path from the web application to the conversation service passes through the gateway.","evaluate":{"method":"only-via","from":"web-application","to":"conversation-service","via":"gateway"},"assumptions":["a-model-abstraction"]},
    {"id":"m-model-provider-no-tenant-database","kind":"structural","models":"cnv-233","statement":"The model provider has no path to any tenant database.","evaluate":{"method":"no-relationship","from":"model-provider","to":"tenant-database","transitive":true},"assumptions":["a-model-abstraction"]},
    {"id":"idn-250","kind":"requirement","statement":"Password attempts from one source SHALL be refused across all accounts once the failures from that source reach the threshold that D-700 states.","rationale":"A password sprayed across many accounts from one source is refused at the source.","evaluate":{"method":"scenario"},"ref":"IDN-250","area":"03-identity","section":"Guessing and enumeration","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/password`","traces":["g-251","d-252","d-535","d-700"],"milestone":3,"inSection":"sec-identity-250","realisation":"checked"},
    {"id":"idn-251","kind":"requirement","statement":"Password attempts across the accounts of one realm SHALL be slowed while their failure rate stays above the rate that D-700 states.","rationale":"Spraying is slowed for the whole realm, whichever source it comes from.","evaluate":{"method":"scenario"},"ref":"IDN-251","area":"03-identity","section":"Guessing and enumeration","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/password`","traces":["g-251","d-252","d-700"],"milestone":3,"inSection":"sec-identity-250","realisation":"checked"},
    {"id":"idn-252","kind":"requirement","statement":"A password chosen at sign-up or at a change SHALL be refused when it appears on the breached-password list that the realm uses.","rationale":"Passwords taken from other breaches are the ones guessing starts with.","evaluate":{"method":"example"},"ref":"IDN-252","area":"03-identity","section":"Guessing and enumeration","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-up`","traces":["g-251"],"milestone":3,"inSection":"sec-identity-250","realisation":"checked"},
    {"id":"idn-253","kind":"requirement","statement":"A one-time code SHALL be spent when its failed presentations reach the limit that D-700 states.","rationale":"A code that can be tried without end is a password with a short alphabet.","evaluate":{"method":"scenario"},"ref":"IDN-253","area":"03-identity","section":"Guessing and enumeration","lifecycle":"active","boundary":"b-4","boundaryDetail":"`one-time code`","traces":["g-251","k-4","d-700"],"milestone":3,"inSection":"sec-identity-250","realisation":"checked"},
    {"id":"idn-254","kind":"requirement","statement":"A one-time code SHALL be drawn at random for each challenge, so that a code of one challenge opens no other challenge.","rationale":"Codes drawn in sequence, or shared across challenges, can be predicted.","evaluate":{"method":"property"},"ref":"IDN-254","area":"03-identity","section":"Guessing and enumeration","lifecycle":"active","boundary":"b-4","boundaryDetail":"`one-time code`","traces":["g-251"],"milestone":3,"inSection":"sec-identity-250","realisation":"checked"},
    {"id":"idn-255","kind":"requirement","statement":"A password sign-in for an account that does not exist SHALL take as long to answer as a wrong password for an account that does exist.","rationale":"A difference in answer time tells an attacker which accounts exist.","evaluate":{"method":"scenario"},"ref":"IDN-255","area":"03-identity","section":"Guessing and enumeration","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/password`","traces":["g-252"],"milestone":3,"inSection":"sec-identity-250","realisation":"checked"},
    {"id":"idn-256","kind":"requirement","statement":"A sign-up request for an address that already has an account SHALL receive the response that a new address receives.","rationale":"Sign-up does not confirm which addresses hold accounts.","evaluate":{"method":"scenario"},"ref":"IDN-256","area":"03-identity","section":"Guessing and enumeration","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-up`","traces":["g-252"],"milestone":3,"inSection":"sec-identity-250","realisation":"checked"},
    {"id":"idn-257","kind":"requirement","statement":"The owner of an address SHALL be sent a notice when a sign-up or a recovery request names that address.","rationale":"The owner learns of the attempt even though the attacker learns nothing.","evaluate":{"method":"scenario"},"ref":"IDN-257","area":"03-identity","section":"Guessing and enumeration","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-up`","traces":["g-252","g-253"],"milestone":3,"inSection":"sec-identity-250","realisation":"checked"},
    {"id":"idn-258","kind":"requirement","statement":"A sign-in that succeeds from a source or a device the account has not used before SHALL send the account owner a notice.","rationale":"Credential stuffing that succeeds is visible to the owner at once.","evaluate":{"method":"scenario"},"ref":"IDN-258","area":"03-identity","section":"Guessing and enumeration","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/password`","traces":["g-253"],"milestone":3,"inSection":"sec-identity-250","realisation":"checked"},
    {"id":"idn-259","kind":"requirement","statement":"A session SHALL end when its idle lifetime or its absolute lifetime, whichever the realm sets shorter, has passed.","rationale":"A session left open on a shared machine is a session that someone else can use.","evaluate":{"method":"scenario"},"ref":"IDN-259","area":"03-identity","section":"Sessions, cookies and passkeys","lifecycle":"active","boundary":"b-4","boundaryDetail":"`sign-in session`","traces":["g-9","k-16"],"milestone":3,"inSection":"sec-identity-251","realisation":"checked"},
    {"id":"idn-260","kind":"requirement","statement":"A sensitive operation SHALL require a fresh authentication when its session appears from a network context that differs from the one that authenticated it.","rationale":"A session moved to another network is treated as a new arrival.","evaluate":{"method":"scenario"},"ref":"IDN-260","area":"03-identity","section":"Sessions, cookies and passkeys","lifecycle":"active","boundary":"b-4","boundaryDetail":"`realm policy`","traces":["g-8","g-253","d-704"],"milestone":3,"inSection":"sec-identity-251","realisation":"checked"},
    {"id":"idn-261","kind":"requirement","statement":"A session cookie SHALL be set without a domain attribute, so that the browser returns it only to the host that set it.","rationale":"A cookie with a parent domain reaches every sibling tenant and every host under it, and public suffix rules do not protect a platform's own tenants.","evaluate":{"method":"example"},"ref":"IDN-261","area":"03-identity","section":"Sessions, cookies and passkeys","lifecycle":"active","boundary":"b-4","boundaryDetail":"`strata_sid`","traces":["g-254","d-250","k-16"],"milestone":3,"inSection":"sec-identity-251","realisation":"checked"},
    {"id":"idn-262","kind":"requirement","statement":"A session cookie SHALL carry the host name prefix and the attribute that limits it to encrypted connections.","rationale":"The prefix stops another host from setting a cookie of the same name, and the attribute keeps it off plain connections.","evaluate":{"method":"example"},"ref":"IDN-262","area":"03-identity","section":"Sessions, cookies and passkeys","lifecycle":"active","boundary":"b-4","boundaryDetail":"`__Host-strata_sid`","traces":["g-254","k-16","d-536"],"milestone":3,"inSection":"sec-identity-251","realisation":"checked"},
    {"id":"idn-263","kind":"requirement","statement":"Sign-out SHALL revoke the session at the identity service, and not only the cookie in the browser.","rationale":"A copied cookie does not outlive the sign-out of its owner.","evaluate":{"method":"scenario"},"ref":"IDN-263","area":"03-identity","section":"Sessions, cookies and passkeys","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-out`","traces":["g-9","g-253"],"milestone":3,"inSection":"sec-identity-251","realisation":"checked"},
    {"id":"idn-264","kind":"requirement","statement":"A passkey assertion SHALL carry a challenge issued for that sign-in and bound to the address that the sign-in was requested at.","rationale":"A replayed assertion from another sign-in or another address is refused.","evaluate":{"method":"scenario"},"ref":"IDN-264","area":"03-identity","section":"Sessions, cookies and passkeys","lifecycle":"active","boundary":"b-4","boundaryDetail":"`WebAuthn relying party`","traces":["g-6","k-14"],"milestone":3,"inSection":"sec-identity-251","realisation":"checked"},
    {"id":"idn-265","kind":"requirement","statement":"Account recovery SHALL notify every registered contact of the account before it completes, after the delay that D-700 states.","rationale":"Recovery is the weakest factor, so the owner is told and given time to object.","evaluate":{"method":"scenario"},"ref":"IDN-265","area":"03-identity","section":"Recovery, factors and prompts","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /recovery`","traces":["g-253","g-46","d-700"],"milestone":3,"inSection":"sec-identity-252","realisation":"checked"},
    {"id":"idn-266","kind":"requirement","statement":"Account recovery SHALL leave the second factor of the realm in force at the next sign-in.","rationale":"Recovery of a password does not switch off the second factor.","evaluate":{"method":"scenario"},"ref":"IDN-266","area":"03-identity","section":"Recovery, factors and prompts","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /recovery`","traces":["g-8"],"milestone":3,"inSection":"sec-identity-252","realisation":"checked"},
    {"id":"idn-267","kind":"requirement","statement":"A realm that requires a second factor SHALL refuse a sign-in method that proves only one factor.","rationale":"A sign-in through a provider or an emailed link is not a way around the second factor.","evaluate":{"method":"scenario"},"ref":"IDN-267","area":"03-identity","section":"Recovery, factors and prompts","lifecycle":"active","boundary":"b-4","boundaryDetail":"`realm policy`","traces":["g-8"],"milestone":3,"inSection":"sec-identity-252","realisation":"checked"},
    {"id":"idn-268","kind":"requirement","statement":"The number of second-factor prompts sent to one account SHALL be limited by the realm within the window that D-700 states.","rationale":"Prompt flooding wears a person down until they approve one.","evaluate":{"method":"scenario"},"ref":"IDN-268","area":"03-identity","section":"Recovery, factors and prompts","lifecycle":"active","boundary":"b-4","boundaryDetail":"`second factor prompt`","traces":["g-253","g-8","d-700"],"milestone":3,"inSection":"sec-identity-252","realisation":"checked"},
    {"id":"idn-269","kind":"requirement","statement":"The emailed sign-in links requested for one address and those requested from one browser SHALL each be limited by the platform.","rationale":"Limits on both keys stop email bombing and the use of the link endpoint to flood a mailbox.","evaluate":{"method":"scenario"},"ref":"IDN-269","area":"03-identity","section":"Recovery, factors and prompts","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/link/request`","traces":["g-251","d-9"],"milestone":3,"inSection":"sec-identity-252","realisation":"checked"},
    {"id":"idn-270","kind":"requirement","statement":"Sign-up requests from one source SHALL be limited by the platform within the window that D-700 states.","rationale":"Sign-up is an abuse path for mail and for account creation.","evaluate":{"method":"scenario"},"ref":"IDN-270","area":"03-identity","section":"Recovery, factors and prompts","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-up`","traces":["g-251","g-262","d-700"],"milestone":3,"inSection":"sec-identity-252","realisation":"checked"},
    {"id":"fed-250","kind":"requirement","statement":"The return address of a federated sign-in SHALL name a path on the host of the tenant that started it, whichever protocol carried the sign-in.","rationale":"A return address that leaves the tenant turns a sign-in into an open redirect.","evaluate":{"method":"property"},"ref":"FED-250","area":"03-identity","section":"Messages and return addresses","lifecycle":"active","boundary":"b-5","boundaryDetail":"`return address`","traces":["g-255"],"milestone":4,"inSection":"sec-federation-250","realisation":"checked"},
    {"id":"fed-251","kind":"requirement","statement":"A SAML message SHALL be read with external entity and document type processing turned off.","rationale":"A message that names an external entity can read files of the platform or reach its network.","evaluate":{"method":"example"},"ref":"FED-251","area":"03-identity","section":"Messages and return addresses","lifecycle":"active","boundary":"b-5","boundaryDetail":"`POST /federation/saml/acs`","traces":["g-255"],"milestone":4,"inSection":"sec-federation-250","realisation":"checked"},
    {"id":"fed-252","kind":"requirement","statement":"A SAML sign-in SHALL take the subject and the attributes only from the assertion whose signature covers them.","rationale":"A signed assertion with an unsigned copy wrapped around it is the signature wrapping attack.","evaluate":{"method":"scenario"},"ref":"FED-252","area":"03-identity","section":"Messages and return addresses","lifecycle":"active","boundary":"b-5","boundaryDetail":"`POST /federation/saml/acs`","traces":["g-255"],"milestone":4,"inSection":"sec-federation-250","realisation":"checked"},
    {"id":"fed-253","kind":"requirement","statement":"The subject identifier of a SAML assertion SHALL be the complete text of its name identifier, with markup comments excluded.","rationale":"A comment inside the identifier does not split it into a name that another person holds.","evaluate":{"method":"example"},"ref":"FED-253","area":"03-identity","section":"Messages and return addresses","lifecycle":"active","boundary":"b-5","boundaryDetail":"`POST /federation/saml/acs`","traces":["g-255"],"milestone":4,"inSection":"sec-federation-250","realisation":"checked"},
    {"id":"fed-254","kind":"requirement","statement":"A SAML assertion SHALL be accepted only from the issuer that the provider configuration of the realm names.","rationale":"An assertion from a second provider that a tenant once trusted is not accepted for the first.","evaluate":{"method":"scenario"},"ref":"FED-254","area":"03-identity","section":"Messages and return addresses","lifecycle":"active","boundary":"b-5","boundaryDetail":"`POST /federation/saml/acs`","traces":["g-255"],"milestone":4,"inSection":"sec-federation-250","realisation":"checked"},
    {"id":"fed-255","kind":"requirement","statement":"An identity token SHALL be verified only with the signature method that the provider configuration names.","rationale":"A token that names a weaker or no signature method is the algorithm confusion attack.","evaluate":{"method":"scenario"},"ref":"FED-255","area":"03-identity","section":"Assertions and tokens checked","lifecycle":"active","boundary":"b-5","boundaryDetail":"`identity token`","traces":["g-255"],"milestone":4,"inSection":"sec-federation-251","realisation":"checked"},
    {"id":"fed-256","kind":"requirement","statement":"A signing key of one provider SHALL verify the tokens of that provider only.","rationale":"A key of one provider that verified another provider's tokens would let one tenant's provider sign in as another's.","evaluate":{"method":"scenario"},"ref":"FED-256","area":"03-identity","section":"Assertions and tokens checked","lifecycle":"active","boundary":"b-5","boundaryDetail":"`provider metadata`","traces":["g-255","g-20"],"milestone":4,"inSection":"sec-federation-251","realisation":"checked"},
    {"id":"fed-257","kind":"requirement","statement":"An email address that a provider asserts SHALL link to an existing principal only when the provider marks the address as verified.","rationale":"A provider that lets a person type any address into a claim can take over the account of that address.","evaluate":{"method":"scenario"},"ref":"FED-257","area":"03-identity","section":"Binding, provisioning and metadata","lifecycle":"active","boundary":"b-5","boundaryDetail":"`identity link`","traces":["g-255","g-46"],"milestone":4,"inSection":"sec-federation-252","realisation":"checked"},
    {"id":"fed-258","kind":"requirement","statement":"A principal created at a first federated sign-in SHALL receive only the default role that the realm names.","rationale":"Just-in-time creation does not grant the roles of an administrator.","evaluate":{"method":"scenario"},"ref":"FED-258","area":"03-identity","section":"Binding, provisioning and metadata","lifecycle":"active","boundary":"b-5","boundaryDetail":"`first federated sign-in`","traces":["g-7"],"milestone":4,"inSection":"sec-federation-252","realisation":"checked"},
    {"id":"fed-259","kind":"requirement","statement":"A provisioning token SHALL grant access to the provisioning endpoint of one realm and to no other endpoint.","rationale":"A token that provisions users can also read the realm's configuration if its scope is wider than provisioning.","evaluate":{"method":"scenario"},"ref":"FED-259","area":"03-identity","section":"Binding, provisioning and metadata","lifecycle":"active","boundary":"b-5","boundaryDetail":"`/scim/v2`","traces":["g-7"],"milestone":4,"inSection":"sec-federation-252","realisation":"checked"},
    {"id":"fed-260","kind":"requirement","statement":"A provisioning request SHALL change the roles of a principal only through the group mapping that the realm declares.","rationale":"A provisioning client cannot grant a role that no group of the realm maps to.","evaluate":{"method":"scenario"},"ref":"FED-260","area":"03-identity","section":"Binding, provisioning and metadata","lifecycle":"active","boundary":"b-5","boundaryDetail":"`/scim/v2/Groups`","traces":["g-7","g-263"],"milestone":4,"inSection":"sec-federation-252","realisation":"checked"},
    {"id":"fed-261","kind":"requirement","statement":"The metadata, the keys and the token endpoint of a provider SHALL be reached only at the address that the provider configuration names, and through the outbound gate.","rationale":"A tenant that names an address on the platform's own network as its provider's metadata address would make the platform fetch from that network.","evaluate":{"method":"scenario"},"ref":"FED-261","area":"03-identity","section":"Binding, provisioning and metadata","lifecycle":"active","boundary":"b-252","boundaryDetail":"`provider metadata`","traces":["g-257","k-252","d-702"],"milestone":4,"inSection":"sec-federation-252","realisation":"checked"},
    {"id":"tok-250","kind":"requirement","statement":"A resource SHALL refuse an access token whose audience names a client other than the one presenting it.","rationale":"A token issued to one client is worthless to another client that holds it.","evaluate":{"method":"property"},"ref":"TOK-250","area":"03-identity","section":"Audience, compromise and clients","lifecycle":"active","boundary":"b-6","boundaryDetail":"`access token`","traces":["g-10","g-20"],"milestone":4,"inSection":"sec-tokens-250","realisation":"checked"},
    {"id":"tok-251","kind":"requirement","statement":"A compromised signing key SHALL be retired at once, so that the tokens it signed are refused from the moment of retirement.","rationale":"Rotation is for routine change; a compromised key needs an immediate cut.","evaluate":{"method":"scenario"},"ref":"TOK-251","area":"03-identity","section":"Audience, compromise and clients","lifecycle":"active","boundary":"b-6","boundaryDetail":"`GET /keys`","traces":["g-261","g-10"],"milestone":4,"inSection":"sec-tokens-250","realisation":"checked"},
    {"id":"tok-252","kind":"requirement","statement":"A client secret of a service account SHALL be stored only as a hash and shown once, when it is created.","rationale":"A stolen database yields no client secret, and a secret that is shown again is one more place it can leak.","evaluate":{"method":"example"},"ref":"TOK-252","area":"03-identity","section":"Audience, compromise and clients","lifecycle":"active","boundary":"b-6","boundaryDetail":"`POST /token`","traces":["g-10","k-4"],"milestone":4,"inSection":"sec-tokens-250","realisation":"checked"},
    {"id":"tok-253","kind":"requirement","statement":"The token endpoint SHALL limit the credential requests of each client within the window that D-700 states.","rationale":"Client credentials are guessed at the token endpoint as much as at sign-in.","evaluate":{"method":"scenario"},"ref":"TOK-253","area":"03-identity","section":"Audience, compromise and clients","lifecycle":"active","boundary":"b-6","boundaryDetail":"`POST /token`","traces":["g-251","g-10","d-700"],"milestone":4,"inSection":"sec-tokens-250","realisation":"checked"},
    {"id":"ten-251","kind":"requirement","statement":"A job, a wake notice or a file address carries the tenant identifier of the tenant it acts for, and its receiver SHALL refuse one that names another tenant.","rationale":"A tenant identifier that is only implied is one that a shared component can mix up.","evaluate":{"method":"property"},"ref":"TEN-251","area":"02-tenancy","section":"Operator access and tenant identifiers","lifecycle":"active","boundary":"b-16","boundaryDetail":"`wake notice`","traces":["g-20","k-2"],"milestone":5,"inSection":"sec-tenancy-250","realisation":"checked"},
    {"id":"ten-252","kind":"requirement","statement":"A backup of one tenant SHALL be unreadable with the key of any other tenant.","rationale":"Backups follow the tenant, and so do their keys.","evaluate":{"method":"scenario"},"ref":"TEN-252","area":"02-tenancy","section":"Operator access and tenant identifiers","lifecycle":"active","boundary":"b-3","boundaryDetail":"`POST /tenants/{id}/restore`","traces":["g-1","g-40","g-266"],"milestone":2,"inSection":"sec-tenancy-250","realisation":"checked"},
    {"id":"ten-255","kind":"requirement","statement":"A runtime instance SHALL hold database credentials only for the tenant databases of the placements it serves, issued for a lifetime that ends when it stops serving them.","rationale":"A compromised instance reaches only the tenants it was serving, and only while it serves them.","evaluate":{"method":"scenario"},"ref":"TEN-255","area":"02-tenancy","section":"Credentials and reach","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["g-266","k-3"],"milestone":2,"inSection":"sec-tenancy-251","realisation":"checked"},
    {"id":"ten-256","kind":"requirement","statement":"Each database credential SHALL open one tenant database and no other database of its cluster.","rationale":"A credential that opens a cluster opens every tenant on it.","evaluate":{"method":"property"},"ref":"TEN-256","area":"02-tenancy","section":"Credentials and reach","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["g-266","k-3"],"milestone":2,"inSection":"sec-tenancy-251","realisation":"checked"},
    {"id":"ten-257","kind":"requirement","statement":"A platform component acting for a tenant SHALL act only on the tenant that the credential authorising the call names.","rationale":"The confused deputy is a component that holds more authority than the call it is making.","evaluate":{"method":"property"},"ref":"TEN-257","area":"02-tenancy","section":"Credentials and reach","lifecycle":"active","boundary":"b-6","boundaryDetail":"`component credential`","traces":["g-266","k-6"],"milestone":2,"inSection":"sec-tenancy-251","realisation":"checked"},
    {"id":"sec-250","kind":"requirement","statement":"When the key service does not answer, the platform SHALL refuse each request that needs a data key and answer requests that need none.","rationale":"A key outage slows secret reads and blocks the reads that need a key, and nothing else.","evaluate":{"method":"scenario"},"ref":"SEC-250","area":"08-platform","section":"Keys under stress","lifecycle":"active","boundary":"b-17","boundaryDetail":"`data key`","traces":["g-261","g-4"],"milestone":3,"inSection":"sec-platform-250","realisation":"checked"},
    {"id":"sec-251","kind":"requirement","statement":"A tenant data key SHALL be rotated while the tenant reads and writes its records.","rationale":"Rotation that needs a pause is rotation that is not done.","evaluate":{"method":"scenario"},"ref":"SEC-251","area":"08-platform","section":"Keys under stress","lifecycle":"active","boundary":"b-17","boundaryDetail":"`data key`","traces":["g-261","g-40"],"milestone":3,"inSection":"sec-platform-250","realisation":"checked"},
    {"id":"sec-252","kind":"requirement","statement":"A compromised tenant data key SHALL be replaced by a key that protects every record the old key protected.","rationale":"A replacement that leaves some records under the compromised key leaves them open.","evaluate":{"method":"scenario"},"ref":"SEC-252","area":"08-platform","section":"Keys under stress","lifecycle":"active","boundary":"b-17","boundaryDetail":"`destroy key`","traces":["g-261","g-40"],"milestone":3,"inSection":"sec-platform-250","realisation":"checked"},
    {"id":"sec-253","kind":"requirement","statement":"A request whose address carries a session secret, a token or a one-time code SHALL be refused.","rationale":"Addresses are written to logs, histories and referrers, so a secret in one is a secret in all of them.","evaluate":{"method":"example"},"ref":"SEC-253","area":"08-platform","section":"Secrets in addresses","lifecycle":"active","boundary":"b-4","boundaryDetail":"`request address`","traces":["k-250"],"milestone":3,"inSection":"sec-platform-251","realisation":"checked"},
    {"id":"cms-250","kind":"requirement","statement":"A link in tenant rich text SHALL carry only the web and mail schemes.","rationale":"A link with a script scheme runs script in the reader's page when it is followed.","evaluate":{"method":"example"},"ref":"CMS-250","area":"07-content","section":"Markup and expressions","lifecycle":"active","boundary":"b-9","boundaryDetail":"`strata_substrate::markdown::parse`","traces":["k-12"],"milestone":2,"inSection":"sec-content-250","realisation":"checked"},
    {"id":"cms-251","kind":"requirement","statement":"A tenant expression, constraint or workflow guard SHALL read only the fields of the record it is evaluated on and the values that the kernel passes to it.","rationale":"Tenant expressions are data reach: they read no other record and no platform state.","evaluate":{"method":"property"},"ref":"CMS-251","area":"07-content","section":"Markup and expressions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["g-20","g-31"],"milestone":2,"inSection":"sec-content-250","realisation":"checked"},
    {"id":"cms-252","kind":"requirement","statement":"A tenant expression SHALL be evaluated under a step budget, and an evaluation that exhausts the budget is refused.","rationale":"A loop written by a tenant is bounded by steps, so one expression cannot hold a worker.","evaluate":{"method":"scenario"},"ref":"CMS-252","area":"07-content","section":"Markup and expressions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["g-4","g-31"],"milestone":2,"inSection":"sec-content-250","realisation":"checked"},
    {"id":"cms-253","kind":"requirement","statement":"Tenant template text SHALL be rendered only by the substrate expression interpreter, and no tenant text reaches the evaluator of the host language.","rationale":"Template text that reaches the host language's evaluator runs code from the tenant.","evaluate":{"method":"property"},"ref":"CMS-253","area":"07-content","section":"Markup and expressions","lifecycle":"active","boundary":"b-9","boundaryDetail":"`view`","traces":["k-251","g-31"],"milestone":2,"inSection":"sec-content-250","realisation":"checked"},
    {"id":"cms-254","kind":"requirement","statement":"A query over tenant records SHALL bind each value it receives as data, so that no value becomes part of the query text.","rationale":"A value that becomes query text changes what the query reads.","evaluate":{"method":"property"},"ref":"CMS-254","area":"07-content","section":"Queries and patterns","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["g-31","g-20"],"milestone":2,"inSection":"sec-content-251","realisation":"checked"},
    {"id":"cms-255","kind":"requirement","statement":"A query that would read more records than its plan allows SHALL be refused before it reads them.","rationale":"Expensive queries are refused by their plan before they cost the platform anything.","evaluate":{"method":"scenario"},"ref":"CMS-255","area":"07-content","section":"Queries and patterns","lifecycle":"active","boundary":"b-9","boundaryDetail":"`named query`","traces":["g-4"],"milestone":2,"inSection":"sec-content-251","realisation":"checked"},
    {"id":"cms-256","kind":"requirement","statement":"A pattern that a tenant supplies SHALL be evaluated by an engine whose running time grows linearly with the length of its input.","rationale":"A pattern with exponential backtracking holds a worker for as long as the pattern is written to.","evaluate":{"method":"property"},"ref":"CMS-256","area":"07-content","section":"Queries and patterns","lifecycle":"active","boundary":"b-9","boundaryDetail":"`named query`","traces":["g-4"],"milestone":2,"inSection":"sec-content-251","realisation":"checked"},
    {"id":"cms-257","kind":"requirement","statement":"A file name that a tenant supplies SHALL be stored as data and escaped wherever the platform shows it.","rationale":"A file name is tenant text, so it is treated like any other tenant text.","evaluate":{"method":"example"},"ref":"CMS-257","area":"07-content","section":"Uploads","lifecycle":"active","boundary":"b-14","boundaryDetail":"`file store`","traces":["g-260"],"milestone":11,"inSection":"sec-content-252","realisation":"checked"},
    {"id":"cms-258","kind":"requirement","statement":"A file of a markup or script capable media type SHALL be delivered only from the file domain of the platform, under a sandboxed policy.","rationale":"A script in an uploaded SVG or HTML file runs with the authority of the host that serves it.","evaluate":{"method":"scenario"},"ref":"CMS-258","area":"07-content","section":"Uploads","lifecycle":"active","boundary":"b-251","boundaryDetail":"`file-domain delivery`","traces":["g-260","d-251","k-251"],"milestone":11,"inSection":"sec-content-252","realisation":"checked"},
    {"id":"cms-259","kind":"requirement","statement":"A tenant host name SHALL serve no file that a tenant uploaded.","rationale":"A tenant host carries the tenant's cookies, so an upload served there is a stored attack on its readers.","evaluate":{"method":"property"},"ref":"CMS-259","area":"07-content","section":"Uploads","lifecycle":"active","boundary":"b-251","boundaryDetail":"`file-domain delivery`","traces":["g-260","d-251"],"milestone":11,"inSection":"sec-content-252","realisation":"checked"},
    {"id":"cms-260","kind":"requirement","statement":"An uploaded file SHALL be released for delivery only after the upload scanner records a clean result for it.","rationale":"A file is untrusted until a scan has looked at it.","evaluate":{"method":"scenario"},"ref":"CMS-260","area":"07-content","section":"Uploads","lifecycle":"active","boundary":"b-251","boundaryDetail":"`release`","traces":["g-260"],"milestone":11,"inSection":"sec-content-252","realisation":"checked"},
    {"id":"cms-261","kind":"requirement","statement":"An upload SHALL be accepted only for a media type that its content confirms, and not only for the type it declares.","rationale":"A file declared as an image and carrying markup is refused on what it is.","evaluate":{"method":"example"},"ref":"CMS-261","area":"07-content","section":"Uploads","lifecycle":"active","boundary":"b-251","boundaryDetail":"`upload intake`","traces":["g-260"],"milestone":11,"inSection":"sec-content-252","realisation":"checked"},
    {"id":"cms-262","kind":"requirement","statement":"A rendition SHALL be produced by a process that holds no connector secret and no network access.","rationale":"A process that parses hostile images holds nothing worth taking.","evaluate":{"method":"scenario"},"ref":"CMS-262","area":"07-content","section":"Uploads","lifecycle":"active","boundary":"b-7","boundaryDetail":"`rendition job`","traces":["g-260","g-40"],"milestone":11,"inSection":"sec-content-252","realisation":"checked"},
    {"id":"cms-263","kind":"requirement","statement":"An archive or an image whose decompressed size exceeds the limit of the tenant plan SHALL be refused before it is fully expanded.","rationale":"A decompression bomb is refused by its declared size before it fills the disk.","evaluate":{"method":"scenario"},"ref":"CMS-263","area":"07-content","section":"Uploads","lifecycle":"active","boundary":"b-251","boundaryDetail":"`upload intake`","traces":["g-260","g-4"],"milestone":11,"inSection":"sec-content-252","realisation":"checked"},
    {"id":"gwy-250","kind":"requirement","statement":"A page response SHALL allow script only from the scripts whose hash or nonce the response declares.","rationale":"Structured content is the first defence; this is the second, and it stops script that a template or a reflected value adds.","evaluate":{"method":"example"},"ref":"GWY-250","area":"01-core","section":"Pages and browser requests","lifecycle":"active","boundary":"b-13","boundaryDetail":"`Content-Security-Policy`","traces":["k-12","g-250"],"milestone":2,"inSection":"sec-runtime-250","realisation":"checked"},
    {"id":"gwy-251","kind":"requirement","statement":"A page response SHALL forbid framing by other origins through the frame-ancestors directive.","rationale":"A framed sign-in page lets another site click for the reader.","evaluate":{"method":"example"},"ref":"GWY-251","area":"01-core","section":"Pages and browser requests","lifecycle":"active","boundary":"b-13","boundaryDetail":"`frame-ancestors`","traces":["g-250"],"milestone":2,"inSection":"sec-runtime-250","realisation":"checked"},
    {"id":"gwy-252","kind":"requirement","statement":"A page response SHALL restrict the base-uri, object-src and form-action directives to the page's own origin or to none.","rationale":"A base element or a form target on another origin moves the page's relative addresses or its submissions.","evaluate":{"method":"example"},"ref":"GWY-252","area":"01-core","section":"Pages and browser requests","lifecycle":"active","boundary":"b-13","boundaryDetail":"`base-uri`","traces":["g-250","k-12"],"milestone":2,"inSection":"sec-runtime-250","realisation":"checked"},
    {"id":"gwy-253","kind":"requirement","statement":"A page response SHALL require Trusted Types for script sinks.","rationale":"A string that reaches a script sink without a typed wrapper is the DOM cross-site scripting path.","evaluate":{"method":"example"},"ref":"GWY-253","area":"01-core","section":"Pages and browser requests","lifecycle":"active","boundary":"b-13","boundaryDetail":"`Trusted Types`","traces":["g-250"],"milestone":2,"inSection":"sec-runtime-250","realisation":"checked"},
    {"id":"gwy-254","kind":"requirement","statement":"A response SHALL state its media type and carry the header that forbids content sniffing.","rationale":"A browser that guesses a type runs an upload as a page.","evaluate":{"method":"example"},"ref":"GWY-254","area":"01-core","section":"Pages and browser requests","lifecycle":"active","boundary":"b-9","boundaryDetail":"`response`","traces":["g-250","g-260"],"milestone":2,"inSection":"sec-runtime-250","realisation":"checked"},
    {"id":"gwy-255","kind":"requirement","statement":"Each value reflected into a response SHALL be escaped for the place in the response where it appears.","rationale":"Escaping for the wrong place, such as HTML text inside a script, is still cross-site scripting.","evaluate":{"method":"property"},"ref":"GWY-255","area":"01-core","section":"Pages and browser requests","lifecycle":"active","boundary":"b-9","boundaryDetail":"`reflected value`","traces":["g-250"],"milestone":2,"inSection":"sec-runtime-250","realisation":"checked"},
    {"id":"gwy-256","kind":"requirement","statement":"A WebSocket upgrade SHALL be refused unless it carries the request token of the session.","rationale":"A socket opened from another site carries the cookie, and only the token proves the request came from the page.","evaluate":{"method":"scenario"},"ref":"GWY-256","area":"01-core","section":"Pages and browser requests","lifecycle":"active","boundary":"b-9","boundaryDetail":"`Origin`","traces":["g-46","g-250"],"milestone":2,"inSection":"sec-runtime-250","realisation":"checked"},
    {"id":"gwy-257","kind":"requirement","statement":"A sign-in request and a sign-out request SHALL carry a request token that the gateway issued to the browser.","rationale":"Login CSRF plants an attacker's session in the victim's browser, and forced sign-out is a nuisance attack.","evaluate":{"method":"scenario"},"ref":"GWY-257","area":"01-core","section":"Pages and browser requests","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-out`","traces":["g-46","g-253"],"milestone":2,"inSection":"sec-runtime-250","realisation":"checked"},
    {"id":"gwy-258","kind":"requirement","statement":"A delivery response SHALL allow cross-origin reads only from the origins that the tenant lists.","rationale":"A tenant's content read from an origin the tenant did not list is a copy made outside its control.","evaluate":{"method":"scenario"},"ref":"GWY-258","area":"01-core","section":"Requests, exports and limits","lifecycle":"active","boundary":"b-9","boundaryDetail":"`Access-Control-Allow-Origin`","traces":["g-20"],"milestone":2,"inSection":"sec-runtime-251","realisation":"checked"},
    {"id":"gwy-259","kind":"requirement","statement":"A request whose body exceeds the limit of its route SHALL be refused before the body is processed.","rationale":"Limits are applied before work is done, not after the body is read.","evaluate":{"method":"scenario"},"ref":"GWY-259","area":"01-core","section":"Requests, exports and limits","lifecycle":"active","boundary":"b-9","boundaryDetail":"`request body`","traces":["g-4","g-262"],"milestone":2,"inSection":"sec-runtime-251","realisation":"checked"},
    {"id":"gwy-260","kind":"requirement","statement":"Each absolute address that the gateway emits SHALL be built from the configured host of the tenant alone.","rationale":"A host header that the gateway echoes into a link is a way to poison the links of the next reader.","evaluate":{"method":"property"},"ref":"GWY-260","area":"01-core","section":"Requests, exports and limits","lifecycle":"active","boundary":"b-9","boundaryDetail":"`Host`","traces":["g-20","g-267"],"milestone":2,"inSection":"sec-runtime-251","realisation":"checked"},
    {"id":"gwy-261","kind":"requirement","statement":"The gateway SHALL refuse a request whose message framing the edge and the gateway read differently.","rationale":"Request smuggling depends on two components disagreeing about where one request ends.","evaluate":{"method":"scenario"},"ref":"GWY-261","area":"01-core","section":"Requests, exports and limits","lifecycle":"active","boundary":"b-9","boundaryDetail":"`request framing`","traces":["g-250","g-267"],"milestone":2,"inSection":"sec-runtime-251","realisation":"checked"},
    {"id":"gwy-262","kind":"requirement","statement":"An export file SHALL prefix each cell that begins with a formula character, so that a spreadsheet reads the cell as text.","rationale":"A cell that begins with an equals sign is run by the spreadsheet of the person who opens the export.","evaluate":{"method":"example"},"ref":"GWY-262","area":"01-core","section":"Requests, exports and limits","lifecycle":"active","boundary":"b-9","boundaryDetail":"`export`","traces":["g-264"],"milestone":2,"inSection":"sec-runtime-251","realisation":"checked"},
    {"id":"gwy-263","kind":"requirement","statement":"A client SHALL be refused a new WebSocket connection when it already holds the connections that the gateway allows it.","rationale":"Connection limits keep one client from holding the gateway's sockets.","evaluate":{"method":"scenario"},"ref":"GWY-263","area":"01-core","section":"Requests, exports and limits","lifecycle":"active","boundary":"b-9","boundaryDetail":"`WebSocket`","traces":["g-262","g-4"],"milestone":2,"inSection":"sec-runtime-251","realisation":"checked"},
    {"id":"edg-250","kind":"requirement","statement":"The edge key of a response SHALL include every request header that changes the response and no other request header.","rationale":"A header that changes the response but is not in the key lets one reader's response serve another.","evaluate":{"method":"property"},"ref":"EDG-250","area":"05-delivery","section":"Keys and paths","lifecycle":"active","boundary":"b-10","boundaryDetail":"`Vary`","traces":["g-267","d-16"],"milestone":6,"inSection":"sec-edge-250","realisation":"checked"},
    {"id":"edg-251","kind":"requirement","statement":"The edge key of a response SHALL be formed from the normalised path of the request that produced it.","rationale":"Two spellings of one path that get two keys let a private page be cached under a public name.","evaluate":{"method":"property"},"ref":"EDG-251","area":"05-delivery","section":"Keys and paths","lifecycle":"active","boundary":"b-10","boundaryDetail":"`edge key`","traces":["g-267","g-20"],"milestone":6,"inSection":"sec-edge-250","realisation":"checked"},
    {"id":"edg-252","kind":"requirement","statement":"A tenant domain binding SHALL be removed when its name stops resolving to the platform.","rationale":"A binding left behind after its name moves elsewhere serves the next owner's traffic.","evaluate":{"method":"scenario"},"ref":"EDG-252","area":"05-delivery","section":"Domains and headers","lifecycle":"active","boundary":"b-3","boundaryDetail":"`domain binding`","traces":["g-21","g-262"],"milestone":6,"inSection":"sec-edge-251","realisation":"checked"},
    {"id":"edg-253","kind":"requirement","statement":"A name that a removed tenant held SHALL be bound to another tenant only after proof of control is given again.","rationale":"A name that a departed tenant left is a name a new tenant can take over.","evaluate":{"method":"scenario"},"ref":"EDG-253","area":"05-delivery","section":"Domains and headers","lifecycle":"active","boundary":"b-3","boundaryDetail":"`domain binding`","traces":["g-21"],"milestone":6,"inSection":"sec-edge-251","realisation":"checked"},
    {"id":"edg-254","kind":"requirement","statement":"The platform SHALL issue a certificate for a tenant domain only when the certificate authority record of that domain permits it.","rationale":"A certificate issued against a record that does not name the platform is one the platform would not have issued.","evaluate":{"method":"scenario"},"ref":"EDG-254","area":"05-delivery","section":"Domains and headers","lifecycle":"active","boundary":"b-10","boundaryDetail":"`certificate`","traces":["g-21"],"milestone":6,"inSection":"sec-edge-251","realisation":"checked"},
    {"id":"edg-255","kind":"requirement","statement":"A response header value that a tenant supplies SHALL be refused when it contains a line break.","rationale":"A line break in a header value starts a second header, or a second response.","evaluate":{"method":"example"},"ref":"EDG-255","area":"05-delivery","section":"Domains and headers","lifecycle":"active","boundary":"b-10","boundaryDetail":"`response header`","traces":["k-12","g-250"],"milestone":6,"inSection":"sec-edge-251","realisation":"checked"},
    {"id":"agt-250","kind":"requirement","statement":"The agent gateway SHALL accept cross-origin requests only from the origins that the operator lists.","rationale":"An agent interface readable from any site is one a visited page can drive with the operator's credentials.","evaluate":{"method":"scenario"},"ref":"AGT-250","area":"06-agents","section":"Interfaces and inputs","lifecycle":"active","boundary":"b-11","boundaryDetail":"`Access-Control-Allow-Origin`","traces":["g-28","g-23"],"milestone":7,"inSection":"sec-agents-250","realisation":"checked"},
    {"id":"agt-251","kind":"requirement","statement":"An operation SHALL accept only the input fields that its input schema declares.","rationale":"A field the schema does not declare, set through JSON coercion, is a way to set what the operation was not meant to set.","evaluate":{"method":"property"},"ref":"AGT-251","area":"06-agents","section":"Interfaces and inputs","lifecycle":"active","boundary":"b-11","boundaryDetail":"`operation input`","traces":["g-263","g-24"],"milestone":7,"inSection":"sec-agents-250","realisation":"checked"},
    {"id":"agt-253","kind":"requirement","statement":"A change to a role, a policy or a schema SHALL be authorised only for a principal whose policies permit administering that object.","rationale":"A principal that can change its own policy has no limit on its authority.","evaluate":{"method":"scenario"},"ref":"AGT-253","area":"06-agents","section":"Separation and reach","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["g-263","k-13"],"milestone":7,"inSection":"sec-agents-251","realisation":"checked"},
    {"id":"agt-254","kind":"requirement","statement":"An export, a search result and a subscription SHALL include only the records that the policies of the requester permit reading.","rationale":"The read decision guards queries; exports, searches and subscriptions are reads too.","evaluate":{"method":"property"},"ref":"AGT-254","area":"06-agents","section":"Separation and reach","lifecycle":"active","boundary":"b-11","boundaryDetail":"`export`","traces":["g-263","g-20"],"milestone":7,"inSection":"sec-agents-251","realisation":"checked"},
    {"id":"wfl-250","kind":"requirement","statement":"An outbound call SHALL connect only to the address that the outbound gate resolved and judged, so that a later resolution cannot change the target.","rationale":"A name that resolves to a private address on the second lookup defeats a check made on the first.","evaluate":{"method":"scenario"},"ref":"WFL-250","area":"04-automation","section":"Outbound calls","lifecycle":"active","boundary":"b-252","boundaryDetail":"`outbound gate`","traces":["g-257","k-252","d-254","d-702"],"milestone":4,"inSection":"sec-workflows-250","realisation":"checked"},
    {"id":"wfl-251","kind":"requirement","statement":"The outbound gate SHALL refuse a redirect whose address the outbound rule does not allow.","rationale":"A permitted address that redirects to a forbidden one is the redirect bypass.","evaluate":{"method":"scenario"},"ref":"WFL-251","area":"04-automation","section":"Outbound calls","lifecycle":"active","boundary":"b-252","boundaryDetail":"`redirect`","traces":["g-257"],"milestone":4,"inSection":"sec-workflows-250","realisation":"checked"},
    {"id":"wfl-252","kind":"requirement","statement":"The outbound gate SHALL judge an address in its canonical numeric form, including mapped, encoded and cloud metadata forms.","rationale":"Alternate spellings of a private or metadata address are the usual way past a text check.","evaluate":{"method":"example"},"ref":"WFL-252","area":"04-automation","section":"Outbound calls","lifecycle":"active","boundary":"b-252","boundaryDetail":"`outbound rule`","traces":["g-257"],"milestone":4,"inSection":"sec-workflows-250","realisation":"checked"},
    {"id":"wfl-253","kind":"requirement","statement":"A connector call SHALL end when its response exceeds the size that the connector policy names or when the time that the policy names has passed.","rationale":"An external server that answers slowly or without end holds a worker.","evaluate":{"method":"scenario"},"ref":"WFL-253","area":"04-automation","section":"Outbound calls","lifecycle":"active","boundary":"b-252","boundaryDetail":"`response`","traces":["g-257","g-14"],"milestone":5,"inSection":"sec-workflows-250","realisation":"checked"},
    {"id":"wfl-254","kind":"requirement","statement":"A connector log entry SHALL omit the query and the userinfo of the address called, and every connector secret.","rationale":"Addresses carry tokens in their queries and passwords in their userinfo.","evaluate":{"method":"property"},"ref":"WFL-254","area":"04-automation","section":"Outbound calls","lifecycle":"active","boundary":"b-12","boundaryDetail":"`log line`","traces":["g-40","k-4"],"milestone":5,"inSection":"sec-workflows-250","realisation":"checked"},
    {"id":"wfl-255","kind":"requirement","statement":"A webhook delivery SHALL carry a timestamp by which the receiver refuses a repeat of an old delivery.","rationale":"A captured signed delivery replayed later is accepted unless the receiver has a time to compare against.","evaluate":{"method":"example"},"ref":"WFL-255","area":"04-automation","section":"Outbound calls","lifecycle":"active","boundary":"b-8","boundaryDetail":"`webhook`","traces":["g-13"],"milestone":5,"inSection":"sec-workflows-250","realisation":"checked"},
    {"id":"wfl-256","kind":"requirement","statement":"The connector runner SHALL reach no platform component other than the outbound gate and the key service.","rationale":"A connector that reaches the platform's own components is a route from tenant automation into the platform.","evaluate":{"method":"scenario"},"ref":"WFL-256","area":"04-automation","section":"Reach","lifecycle":"active","boundary":"b-252","boundaryDetail":"`connector runner`","traces":["g-47","k-252"],"milestone":5,"inSection":"sec-workflows-251","realisation":"construction"},
    {"id":"thr-250","kind":"requirement","statement":"Every HTTP response of a platform component SHALL carry the security header set of its response class, including error and redirect responses.","rationale":"Headers left off error pages are headers an attacker can find.","evaluate":{"method":"property"},"ref":"THR-250","area":"09-threat","section":"Responses and transport","lifecycle":"active","boundary":"b-9","boundaryDetail":"`HTTP response`","traces":["g-250","g-256"],"milestone":2,"inSection":"sec-threat-251","realisation":"checked"},
    {"id":"thr-251","kind":"requirement","statement":"A connection to a platform endpoint SHALL negotiate only the protocol versions of TLS that the platform policy lists.","rationale":"An older protocol version is a downgrade that the endpoint refuses.","evaluate":{"method":"example"},"ref":"THR-251","area":"09-threat","section":"Responses and transport","lifecycle":"active","boundary":"b-10","boundaryDetail":"`TLS`","traces":["g-21","g-256"],"milestone":6,"inSection":"sec-threat-251","realisation":"checked"},
    {"id":"thr-252","kind":"requirement","statement":"The strict transport security header of a custom domain SHALL omit the preload and subdomain directives unless the tenant owner requests them in writing.","rationale":"A preloaded directive applies to every name under the domain, including the ones the tenant does not run.","evaluate":{"method":"example"},"ref":"THR-252","area":"09-threat","section":"Responses and transport","lifecycle":"active","boundary":"b-10","boundaryDetail":"`Strict-Transport-Security`","traces":["g-21"],"milestone":6,"inSection":"sec-threat-251","realisation":"checked"},
    {"id":"thr-253","kind":"requirement","statement":"The operator console SHALL accept connections only from the operations network.","rationale":"An administration interface on the public network is found by scanning.","evaluate":{"method":"scenario"},"ref":"THR-253","area":"09-threat","section":"Reachability","lifecycle":"active","boundary":"b-250","boundaryDetail":"`operator console`","traces":["g-256"],"milestone":10,"inSection":"sec-threat-252","realisation":"operational"},
    {"id":"thr-254","kind":"requirement","statement":"A deployment SHALL refuse a network connection from a component that the architecture does not name as a caller of the receiving component.","rationale":"Network policy is the architecture enforced, so an unnamed caller is refused at the network.","evaluate":{"method":"scenario"},"ref":"THR-254","area":"09-threat","section":"Reachability","lifecycle":"active","boundary":"b-19","boundaryDetail":"`network policy`","traces":["g-256"],"milestone":2,"inSection":"sec-threat-252","realisation":"checked"},
    {"id":"thr-255","kind":"requirement","statement":"A component image SHALL run only when its signature and its build provenance verify against the release key.","rationale":"An image that cannot be traced to its build is one that nobody can vouch for.","evaluate":{"method":"scenario"},"ref":"THR-255","area":"09-threat","section":"Supply chain","lifecycle":"active","boundary":"b-19","boundaryDetail":"`image`","traces":["g-259"],"milestone":2,"inSection":"sec-threat-253","realisation":"operational"},
    {"id":"thr-256","kind":"requirement","statement":"Each component image SHALL carry a software bill of materials that lists every package the image contains.","rationale":"A vulnerability in a package is found in the images that contain it only if the images say what they contain.","evaluate":{"method":"example"},"ref":"THR-256","area":"09-threat","section":"Supply chain","lifecycle":"active","boundary":"b-19","boundaryDetail":"`image`","traces":["g-259"],"milestone":2,"inSection":"sec-threat-253","realisation":"checked"},
    {"id":"thr-257","kind":"requirement","statement":"A release build SHALL fail when a dependency of the build carries a published vulnerability of a severity that the release policy blocks.","rationale":"The gate is in the build, so a known vulnerability cannot ship by default.","evaluate":{"method":"scenario"},"ref":"THR-257","area":"09-threat","section":"Supply chain","lifecycle":"active","boundary":"b-19","boundaryDetail":"`release build`","traces":["g-259"],"milestone":2,"inSection":"sec-threat-253","realisation":"operational"},
    {"id":"thr-258","kind":"requirement","statement":"A component SHALL run under a cloud identity that grants only the actions its deployment descriptor lists.","rationale":"A component that holds the whole account's rights is the reach of its worst bug.","evaluate":{"method":"scenario"},"ref":"THR-258","area":"09-threat","section":"Supply chain","lifecycle":"active","boundary":"b-19","boundaryDetail":"`infrastructure modules`","traces":["g-256","d-23"],"milestone":12,"inSection":"sec-threat-253","realisation":"operational"},
    {"id":"thr-259","kind":"requirement","statement":"An attempt to cross a tenant boundary SHALL raise an alert to the platform operators and be recorded as an audit entry.","rationale":"A boundary attempt is the earliest sign of a breach and needs a person watching for it.","evaluate":{"method":"scenario"},"ref":"THR-259","area":"09-threat","section":"Incidents and disclosure","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit entry`","traces":["g-30","g-266"],"milestone":10,"inSection":"sec-threat-254","realisation":"checked"},
    {"id":"thr-260","kind":"requirement","statement":"A security incident SHALL open an audit record that names the affected tenants and that the owner of each affected tenant is shown.","rationale":"A tenant hears of an incident from the record of it, not from a rumour.","evaluate":{"method":"scenario"},"ref":"THR-260","area":"09-threat","section":"Incidents and disclosure","lifecycle":"active","boundary":"b-12","boundaryDetail":"`GET /audit`","traces":["g-30","g-265"],"milestone":10,"inSection":"sec-threat-254","realisation":"checked"},
    {"id":"thr-261","kind":"requirement","statement":"The platform SHALL publish a disclosure policy that names a reporting address and the steps taken for affected tenants.","rationale":"A reporter who finds no address reports to a public forum instead.","evaluate":{"method":"example"},"ref":"THR-261","area":"09-threat","section":"Incidents and disclosure","lifecycle":"active","boundary":"b-13","boundaryDetail":"`disclosure policy`","traces":["g-265"],"milestone":2,"inSection":"sec-threat-254","realisation":"checked"},
    {"id":"thr-262","kind":"requirement","statement":"A tenant domain named in a takedown SHALL stop serving content and have its edge copies purged.","rationale":"A takedown that leaves the edge serving the content is not a takedown.","evaluate":{"method":"scenario"},"ref":"THR-262","area":"09-threat","section":"Abuse and takedown","lifecycle":"active","boundary":"b-10","boundaryDetail":"`purge`","traces":["g-262"],"milestone":6,"inSection":"sec-threat-255","realisation":"checked"},
    {"id":"thr-263","kind":"requirement","statement":"The published content of a tenant SHALL occupy none of the paths that the platform reserves for sign-in and federation.","rationale":"A tenant page at the sign-in path is a phishing page on the platform's own domain.","evaluate":{"method":"property"},"ref":"THR-263","area":"09-threat","section":"Abuse and takedown","lifecycle":"active","boundary":"b-9","boundaryDetail":"`reserved paths`","traces":["g-6","g-262"],"milestone":6,"inSection":"sec-threat-255","realisation":"checked"},
    {"id":"m-saml-assertion-single-use","kind":"invariant","models":"fed-006","statement":"A SAML assertion yields at most one session.","evaluate":{"method":"state-invariant","scenarios":["saml-replayed","saml-response-redelivered"],"expr":"saml-assertion-flow.sessions <= 1","negatives":[{"scenario":"saml-replayed","faults":["defect-saml-replay-accepted"]},{"scenario":"saml-response-redelivered","faults":["defect-saml-replay-accepted"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-provider-signatures"],"faultBasis":"fault"},
    {"id":"m-guessing-throttled","kind":"invariant","models":"idn-008","statement":"A guess that arrives after three failed guesses is refused, because the model counts the failures against one account. The threshold of 3 stands for the ten of D-700.","evaluate":{"method":"state-invariant","scenarios":["guesses-from-one-source","guesses-on-parallel-connections"],"expr":"guess-throttle-flow.throttled == 0","negatives":[{"scenario":"guesses-from-one-source","faults":["defect-throttle-ignored"]},{"scenario":"guesses-on-parallel-connections","faults":["defect-throttle-ignored"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-operator-console-private","kind":"structural","models":"thr-253","statement":"No public component and no gateway has a path to the operator console.","evaluate":{"method":"no-relationship","from":["gateway","delivery-network","delivery-network-control","agent-gateway","external-identity-provider","web-application","agent","external-endpoint","traffic-switch","agent-traffic-switch"],"to":"operator-console","transitive":true},"assumptions":["a-model-abstraction"]},
    {"id":"m-connector-runner-isolated","kind":"structural","models":"wfl-256","statement":"The connector runner has no path to a platform component other than the outbound gate and the key service; components outside the platform (category external) are reached only through the outbound gate.","evaluate":{"method":"no-relationship","from":"connector-runner","to":["kernel","substrate","store-contract","sqlite-adapter","postgres-adapter","tenant-database","control-plane","control-database","identity-service","runtime","gateway","automation-worker","copy-store","file-store","agent-gateway","telemetry-pipeline","audit-log","web-application","simulator","verification","agent","limit-store","backup-archive","fleet-reporting","product-module","notice-queue","search-index","notification-service","conversation-service","local-model-adapter","operator-console","upload-scanner","mail-dispatcher","release-controller","release-pipeline","image-registry","traffic-switch","subject-rights-service","agent-traffic-switch","migration-job","platform-audit-store"],"transitive":true},"assumptions":["a-model-abstraction"]},
    {"id":"m-trigger-chain-bounded","kind":"invariant","models":"sch-300","statement":"A chain of triggers creates no more jobs than the hop limit of eight (D-700) allows.","evaluate":{"method":"state-invariant","scenarios":["trigger-chain-runaway","trigger-chain-reentered"],"expr":"trigger-chain-flow.accepted <= 8","negatives":[{"scenario":"trigger-chain-runaway","faults":["defect-trigger-loop-unbounded"]},{"scenario":"trigger-chain-reentered","faults":["defect-trigger-loop-unbounded"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-outage-no-acceptance","kind":"temporal","models":"idn-300","statement":"While a session lookup is unanswered, the gateway accepts no request that needs a session.","evaluate":{"method":"never","scenarios":["identity-unreachable"],"occurs":{"event":"sr-accepted"},"negatives":[{"scenario":"identity-unreachable","faults":["defect-gateway-accepts-unanswered"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction","a-tick"],"faultBasis":"fault"},
    {"id":"m-outage-refusal-given","kind":"temporal","models":"idn-300","statement":"A request that needs a session and meets an unanswered lookup is refused with the outage named.","evaluate":{"method":"eventually","scenarios":["identity-unreachable"],"occurs":{"event":"sr-unavailable"},"negatives":[{"scenario":"identity-unreachable","faults":["outage-refusal-disabled"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction","a-tick"],"faultBasis":"fault"},
    {"id":"m-session-authority-flow-refined","kind":"temporal","models":"idn-013","statement":"The implementation of the identity service record of a session refines the session authority model.","evaluate":{"method":"refines","behavior":"session-authority-flow-impl","scenarios":["revocation-heard-impl","revocation-notice-lost-impl","identity-unreachable-impl"]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"prv-350","kind":"requirement","statement":"The tenant SHALL obtain, for one principal, every field of every record and copy of the tenant that names that principal, as one machine-readable export.","rationale":"The access right and the portability right for one person, across the tenant.","evaluate":{"method":"scenario"},"ref":"PRV-350","area":"09-privacy","section":"Data subject rights","lifecycle":"active","boundary":"b-350","boundaryDetail":"`GET /tenants/{id}/subjects/{principal-id}/export`","traces":["g-350","k-2"],"milestone":6,"inSection":"sec-privacy-2","realisation":"checked"},
    {"id":"prv-351","kind":"requirement","statement":"A rectification of one personal field SHALL replace that field in its record and in every copy that holds it.","rationale":"A corrected value must not survive in a copy that was made before the correction.","evaluate":{"method":"scenario"},"ref":"PRV-351","area":"09-privacy","section":"Data subject rights","lifecycle":"active","boundary":"b-350","boundaryDetail":"`PATCH /tenants/{id}/subjects/{principal-id}/fields`","traces":["g-350","k-8"],"milestone":6,"inSection":"sec-privacy-2","realisation":"checked"},
    {"id":"prv-352","kind":"requirement","statement":"A restriction placed on one principal SHALL refuse every read that names the personal fields of that principal until the restriction is lifted.","rationale":"Restriction stops the use of data without deleting it.","evaluate":{"method":"scenario"},"ref":"PRV-352","area":"09-privacy","section":"Data subject rights","lifecycle":"active","boundary":"b-350","boundaryDetail":"`POST /tenants/{id}/subjects/{principal-id}/restriction`","traces":["g-350"],"milestone":2,"inSection":"sec-privacy-2","realisation":"checked"},
    {"id":"prv-353","kind":"requirement","statement":"An erasure request for one principal SHALL end in a receipt that names each record and copy reached and the erasure point each one reached.","rationale":"The person and the controller can see what was erased and when it stopped being held.","evaluate":{"method":"scenario"},"ref":"PRV-353","area":"09-privacy","section":"Data subject rights","lifecycle":"active","boundary":"b-350","boundaryDetail":"`DELETE /tenants/{id}/subjects/{principal-id}`","traces":["g-350","k-352"],"milestone":6,"inSection":"sec-privacy-2","realisation":"checked"},
    {"id":"prv-354","kind":"requirement","statement":"The deletion of a tenant SHALL produce a certificate that states when the tenant key was destroyed and when each backup image and export of the tenant expires.","rationale":"Deleting a tenant is only shown to be complete when the copies that outlive the database are named.","evaluate":{"method":"scenario"},"ref":"PRV-354","area":"09-privacy","section":"Data subject rights","lifecycle":"active","boundary":"b-3","boundaryDetail":"`DELETE /tenants/{id}`","traces":["g-22","g-350","d-706"],"milestone":6,"inSection":"sec-privacy-2","realisation":"checked"},
    {"id":"prv-355","kind":"requirement","statement":"A legal hold SHALL suspend the erasure and the expiry of each record that it names until the hold is released.","rationale":"A hold is the tenant's instruction to keep data, and it overrides the schedule.","evaluate":{"method":"scenario"},"ref":"PRV-355","area":"09-privacy","section":"Retention and legal hold","lifecycle":"active","boundary":"b-350","boundaryDetail":"`legal hold`","traces":["g-355","d-521"],"milestone":5,"inSection":"sec-privacy-3","realisation":"checked"},
    {"id":"prv-356","kind":"requirement","statement":"Each record type SHALL carry a retention rule whose period the tenant policy sets within the bounds that the platform defines.","rationale":"Retention is the tenant's choice, and the platform sets the limits a choice may reach: from thirty days to ten years (D-708).","evaluate":{"method":"scenario"},"ref":"PRV-356","area":"09-privacy","section":"Retention and legal hold","lifecycle":"active","boundary":"b-3","boundaryDetail":"`retention rule`","traces":["g-355","d-708"],"milestone":5,"inSection":"sec-privacy-3","realisation":"checked"},
    {"id":"prv-357","kind":"requirement","statement":"A record whose retention rule has ended SHALL be removed by a scheduled job.","rationale":"Removal is scheduled work, so it survives failure and leaves a recorded outcome.","evaluate":{"method":"scenario"},"ref":"PRV-357","area":"09-privacy","section":"Retention and legal hold","lifecycle":"active","boundary":"b-7","boundaryDetail":"`retention sweep`","traces":["g-355","g-14"],"milestone":5,"inSection":"sec-privacy-3","realisation":"checked"},
    {"id":"prv-358","kind":"requirement","statement":"A personal field SHALL be stored sealed under the key of the principal it concerns, so that destroying that key makes the field unreadable in every copy and backup.","rationale":"Erasure that reaches backups without editing them, because the key is the only way in.","evaluate":{"method":"property"},"ref":"PRV-358","area":"09-privacy","section":"Sealing and audit","lifecycle":"active","boundary":"b-17","boundaryDetail":"`subject key`","traces":["g-350","k-352","d-350"],"milestone":3,"inSection":"sec-privacy-4","realisation":"checked"},
    {"id":"prv-359","kind":"requirement","statement":"An erasure of one principal SHALL leave the audit chain of its tenant verifiable with no break.","rationale":"The audit log is immutable, and erasure must not break it.","evaluate":{"method":"scenario"},"ref":"PRV-359","area":"09-privacy","section":"Sealing and audit","lifecycle":"active","boundary":"b-12","boundaryDetail":"`GET /audit`","traces":["g-352","d-20"],"milestone":10,"inSection":"sec-privacy-4","realisation":"checked"},
    {"id":"prv-360","kind":"requirement","statement":"The hash that links each audit entry SHALL be computed over the sealed form of that entry.","rationale":"A hash over plain values would break on erasure. A hash over sealed values does not.","evaluate":{"method":"property"},"ref":"PRV-360","area":"09-privacy","section":"Sealing and audit","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit entry`","traces":["g-352","k-352","d-350"],"milestone":10,"inSection":"sec-privacy-4","realisation":"checked"},
    {"id":"prv-361","kind":"requirement","statement":"Replay of the event journal of a tenant after an erasure SHALL report each erased personal field in sealed form.","rationale":"Replay still reproduces the history, and the erased values appear only as sealed.","evaluate":{"method":"scenario"},"ref":"PRV-361","area":"09-privacy","section":"Sealing and audit","lifecycle":"active","boundary":"b-2","boundaryDetail":"`journal`","traces":["g-352","k-352"],"milestone":3,"inSection":"sec-privacy-4","realisation":"checked"},
    {"id":"prv-362","kind":"requirement","statement":"The destruction of a subject key SHALL be recorded in the audit log with the principal or tenant it concerned and no key material.","rationale":"Destruction is the erasure, so it must be evidenced without keeping what it destroyed.","evaluate":{"method":"scenario"},"ref":"PRV-362","area":"09-privacy","section":"Sealing and audit","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit entry`","traces":["g-352","k-352"],"milestone":10,"inSection":"sec-privacy-4","realisation":"checked"},
    {"id":"prv-363","kind":"requirement","statement":"A log line, span or metric SHALL carry no personal field other than the tenant identifier, the correlation identifier and a client network address with its host part removed.","rationale":"Operational data is shared more widely than tenant data, so it carries as little personal data as diagnosis allows.","evaluate":{"method":"property"},"ref":"PRV-363","area":"09-privacy","section":"Logs and minimisation","lifecycle":"active","boundary":"b-12","boundaryDetail":"`log line`","traces":["g-350","k-351"],"milestone":6,"inSection":"sec-privacy-5","realisation":"checked"},
    {"id":"prv-364","kind":"requirement","statement":"A session record SHALL hold no user agent string, and no network address except as a keyed hash that a realm rule compares.","rationale":"Session records last a day. A user agent adds personal data that sign-in does not need, and a network context is kept only as the keyed hash that the rule of IDN-260 compares (D-704).","evaluate":{"method":"example"},"ref":"PRV-364","area":"09-privacy","section":"Logs and minimisation","lifecycle":"active","boundary":"b-4","boundaryDetail":"`sign-in session`","traces":["g-350","k-16","d-704"],"milestone":3,"inSection":"sec-privacy-5","realisation":"checked"},
    {"id":"prv-365","kind":"requirement","statement":"A sign-in link challenge SHALL hold the identifier of its principal and no email address.","rationale":"The address is needed to send the link, and the link is then bound to the browser. Keeping it adds nothing.","evaluate":{"method":"property"},"ref":"PRV-365","area":"09-privacy","section":"Logs and minimisation","lifecycle":"active","boundary":"b-4","boundaryDetail":"`sign-in challenge`","traces":["g-350","d-9"],"milestone":3,"inSection":"sec-privacy-5","realisation":"checked"},
    {"id":"prv-366","kind":"requirement","statement":"The connector runner SHALL record each external call with its target address, its outcome and its idempotency key, and no body of the request or of the response.","rationale":"A record of the call supports retries and disputes. A copy of the payload would be a second store of personal data.","evaluate":{"method":"property"},"ref":"PRV-366","area":"09-privacy","section":"Logs and minimisation","lifecycle":"active","boundary":"b-7","boundaryDetail":"`call step`","traces":["k-351","g-15"],"milestone":5,"inSection":"sec-privacy-5","realisation":"checked"},
    {"id":"prv-367","kind":"requirement","statement":"Platform staff SHALL reach tenant personal data only through an access grant that names the operator, the tenant, the purpose and an expiry.","rationale":"Access is a grant with a purpose and an end, and no other route exists.","evaluate":{"method":"scenario"},"ref":"PRV-367","area":"09-privacy","section":"Access by platform staff","lifecycle":"active","boundary":"b-350","boundaryDetail":"`POST /tenants/{id}/access-grants`","traces":["g-354","g-258","d-352","d-253"],"milestone":4,"inSection":"sec-privacy-6","realisation":"checked"},
    {"id":"prv-368","kind":"requirement","statement":"An access grant SHALL appear in the audit log of its tenant before the first read made under it.","rationale":"The tenant can see the access before the data is read, not only afterwards.","evaluate":{"method":"scenario"},"ref":"PRV-368","area":"09-privacy","section":"Access by platform staff","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit entry`","traces":["g-354","g-356"],"milestone":10,"inSection":"sec-privacy-6","realisation":"checked"},
    {"id":"prv-369","kind":"requirement","statement":"A grant of platform access to a tenant that forbids platform access SHALL be refused, and the refusal appears in the audit log of that tenant.","rationale":"A tenant's refusal is a setting the platform honours, and the refusal is itself evidence.","evaluate":{"method":"scenario"},"ref":"PRV-369","area":"09-privacy","section":"Access by platform staff","lifecycle":"active","boundary":"b-350","boundaryDetail":"`POST /tenants/{id}/access-grants`","traces":["g-354"],"milestone":10,"inSection":"sec-privacy-6","realisation":"checked"},
    {"id":"prv-370","kind":"requirement","statement":"The owner of a tenant SHALL receive an access report that lists each grant made to the data of the tenant over a period the owner chooses.","rationale":"The report is how an owner checks who looked at its data.","evaluate":{"method":"scenario"},"ref":"PRV-370","area":"09-privacy","section":"Access by platform staff","lifecycle":"active","boundary":"b-12","boundaryDetail":"`GET /tenants/{id}/access-report`","traces":["g-354","g-356"],"milestone":10,"inSection":"sec-privacy-6","realisation":"checked"},
    {"id":"prv-371","kind":"requirement","statement":"The backups, exports, copies, logs and mail of a tenant SHALL be stored in the region of its primary placement.","rationale":"Residency that covers only the database is not residency, because the other copies hold the same personal data.","evaluate":{"method":"scenario"},"ref":"PRV-371","area":"09-privacy","section":"Residency and subprocessors","lifecycle":"active","boundary":"b-3","boundaryDetail":"`placement`","traces":["g-353","d-23"],"milestone":12,"inSection":"sec-privacy-7","realisation":"operational"},
    {"id":"prv-372","kind":"requirement","statement":"A call that sends tenant personal data to a subprocessor outside the region of the tenant SHALL be refused unless the tenant policy lists that subprocessor.","rationale":"A transfer is named and refused by default, not discovered afterwards.","evaluate":{"method":"scenario"},"ref":"PRV-372","area":"09-privacy","section":"Residency and subprocessors","lifecycle":"active","boundary":"b-3","boundaryDetail":"`subprocessor transfer`","traces":["g-353"],"milestone":12,"inSection":"sec-privacy-7","realisation":"checked"},
    {"id":"prv-373","kind":"requirement","statement":"The subprocessor register SHALL list each component that holds tenant personal data, with its region, its role and the transfer basis that applies to it.","rationale":"The register is data, so a tenant can read it and an agent can check it.","evaluate":{"method":"example"},"ref":"PRV-373","area":"09-privacy","section":"Residency and subprocessors","lifecycle":"active","boundary":"b-350","boundaryDetail":"`subprocessor register`","traces":["g-351","g-356","d-520"],"milestone":2,"inSection":"sec-privacy-7","realisation":"checked"},
    {"id":"prv-374","kind":"requirement","statement":"The platform SHALL set on a tenant site no cookie other than the session cookie and the request token, both needed for sign-in and for the protection of forms.","rationale":"Strictly necessary cookies need no consent. Any other cookie the platform set would need a basis the specification does not give.","evaluate":{"method":"example"},"ref":"PRV-374","area":"09-privacy","section":"Consent and cookies","lifecycle":"active","boundary":"b-9","boundaryDetail":"`Set-Cookie`","traces":["g-46","k-16"],"milestone":3,"inSection":"sec-privacy-8","realisation":"checked"},
    {"id":"prv-375","kind":"requirement","statement":"A consent decision of a site visitor SHALL be recorded with its purpose, its time and the text the visitor was shown.","rationale":"A consent is evidence only with the wording the visitor saw.","evaluate":{"method":"scenario"},"ref":"PRV-375","area":"09-privacy","section":"Consent and cookies","lifecycle":"active","boundary":"b-9","boundaryDetail":"`consent record`","traces":["g-350"],"milestone":6,"inSection":"sec-privacy-8","realisation":"checked"},
    {"id":"prv-376","kind":"requirement","statement":"A tenant feature that sets a cookie for a purpose SHALL be refused while no consent record of the visitor covers that purpose.","rationale":"The platform enforces the consent the tenant recorded, rather than trusting the tenant's script.","evaluate":{"method":"scenario"},"ref":"PRV-376","area":"09-privacy","section":"Consent and cookies","lifecycle":"active","boundary":"b-9","boundaryDetail":"`cookie`","traces":["g-350","g-355"],"milestone":6,"inSection":"sec-privacy-8","realisation":"checked"},
    {"id":"prv-378","kind":"requirement","statement":"The platform SHALL export, for one tenant, a processing record that lists each record type with its owner, retention, personal fields and encryption, and each copy that holds those fields.","rationale":"The processing record is the document a controller asks a processor for.","evaluate":{"method":"scenario"},"ref":"PRV-378","area":"09-privacy","section":"Compliance evidence","lifecycle":"active","boundary":"b-350","boundaryDetail":"`GET /tenants/{id}/processing-record`","traces":["g-356","g-351"],"milestone":10,"inSection":"sec-privacy-9","realisation":"checked"},
    {"id":"prv-379","kind":"requirement","statement":"A field that holds personal data SHALL name the kind of personal data it holds.","rationale":"The processing record and the erasure rules can only list the personal fields that are named.","evaluate":{"method":"example"},"ref":"PRV-379","area":"09-privacy","section":"Compliance evidence","lifecycle":"active","boundary":"b-2","boundaryDetail":"`record declaration`","traces":["g-351","k-350"],"milestone":2,"inSection":"sec-privacy-9","realisation":"checked"},
    {"id":"prv-380","kind":"requirement","statement":"A breach of personal data held for a tenant SHALL be reported to the tenant owner, with the records and copies it reached, within the notice period that the tenant policy sets.","rationale":"The tenant has a duty to notify, and the platform must give it the facts in time to do so: within twenty-four hours of confirming the breach, shortened or extended up to forty-eight hours by the tenant policy (D-708).","evaluate":{"method":"scenario"},"ref":"PRV-380","area":"09-privacy","section":"Compliance evidence","lifecycle":"active","boundary":"b-12","boundaryDetail":"`breach notice`","traces":["g-356","d-708"],"milestone":10,"inSection":"sec-privacy-9","realisation":"checked"},
    {"id":"m-erasure-reaches-copy","kind":"invariant","models":"cpy-013","statement":"A copy of an erased principal's personal data serves no reader after its erasure bound has passed, whether or not the purge arrives.","evaluate":{"method":"state-invariant","scenarios":["erasure-purged","erasure-purge-lost"],"expr":"!erasure-copy-flow.leak","negatives":[{"scenario":"erasure-purge-lost","faults":["defect-erasure-ignores-lifetime"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-tick"],"faultBasis":"fault"},
    {"id":"m-shred-leaves-no-plain-value","kind":"invariant","models":"sec-002","statement":"In the model, once the key of a subject is destroyed, no read returns a plain value of that subject's sealed field.","evaluate":{"method":"state-invariant","scenarios":["subject-shredded","read-in-transit-past-shred"],"expr":"!subject-key-flow.plainAfterShred","negatives":[{"scenario":"subject-shredded","faults":["defect-shred-ignored"]},{"scenario":"read-in-transit-past-shred","faults":["defect-shred-ignored"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-database-commit"],"faultBasis":"fault"},
    {"id":"m-audit-chain-survives-erasure","kind":"invariant","models":"prv-359","statement":"In the model, sealing the entries of an erased principal does not clear the audit chain's validity flag.","evaluate":{"method":"state-invariant","scenarios":["audit-erasure","audit-erasure-redelivered"],"expr":"audit-chain-flow.chainOk","negatives":[{"scenario":"audit-erasure","faults":["defect-audit-rewrites-entry"]},{"scenario":"audit-erasure-redelivered","faults":["defect-audit-rewrites-entry"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-support-only-via-store","kind":"structural","models":"prv-367","statement":"Every path from the operator console to a tenant database passes through the store contract.","evaluate":{"method":"only-via","from":"operator-console","to":"tenant-database","via":"store-contract"},"assumptions":["a-model-abstraction"]},
    {"id":"agt-400","kind":"requirement","statement":"Every operation in the operation catalogue SHALL carry a stable name, a version and a deprecation state.","rationale":"Agents write against names and versions, so a silent change breaks them.","evaluate":{"method":"property"},"ref":"AGT-400","area":"06-agents","section":"Catalogue contract","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /operations`","traces":["g-23","d-18"],"milestone":7,"inSection":"sec-agents-401","realisation":"checked"},
    {"id":"agt-401","kind":"requirement","statement":"The meaning of an operation at one version SHALL stay unchanged in every later release of the platform.","rationale":"A version names a meaning. Changing the meaning under the same name is the silent break the version exists to prevent.","evaluate":{"method":"property"},"ref":"AGT-401","area":"06-agents","section":"Catalogue contract","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /operations/{name}`","traces":["g-23"],"milestone":7,"inSection":"sec-agents-401","realisation":"checked"},
    {"id":"agt-402","kind":"requirement","statement":"A deprecated operation SHALL keep answering its callers until the removal date that its catalogue entry declares.","rationale":"Removal is announced in the catalogue, so a caller can move before it happens.","evaluate":{"method":"scenario"},"ref":"AGT-402","area":"06-agents","section":"Catalogue contract","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /operations/{name}`","traces":["g-23"],"milestone":7,"inSection":"sec-agents-401","realisation":"checked"},
    {"id":"agt-403","kind":"requirement","statement":"A mutating operation SHALL accept an idempotency key chosen by its caller.","rationale":"A caller that retries after a lost response needs a way to name the same request twice.","evaluate":{"method":"scenario"},"ref":"AGT-403","area":"06-agents","section":"Catalogue contract","lifecycle":"active","boundary":"b-11","boundaryDetail":"`Idempotency-Key`","traces":["g-25"],"milestone":7,"inSection":"sec-agents-401","realisation":"checked"},
    {"id":"agt-405","kind":"requirement","statement":"A list operation SHALL return its results in pages, each with a cursor that resumes the same listing.","rationale":"A tenant can hold more records than a single response carries.","evaluate":{"method":"scenario"},"ref":"AGT-405","area":"06-agents","section":"Catalogue contract","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /records`","traces":["g-24"],"milestone":7,"inSection":"sec-agents-401","realisation":"checked"},
    {"id":"agt-406","kind":"requirement","statement":"An operation whose work outlasts its request SHALL return an operation handle whose state stays readable until the work ends.","rationale":"Long work is started, then watched, so the handle is the contract for the wait.","evaluate":{"method":"scenario"},"ref":"AGT-406","area":"06-agents","section":"Catalogue contract","lifecycle":"active","boundary":"b-11","boundaryDetail":"`operation handle`","traces":["g-24"],"milestone":7,"inSection":"sec-agents-401","realisation":"checked"},
    {"id":"agt-407","kind":"requirement","statement":"A failed operation SHALL return a stable error code and a flag that states whether repeating the same request would succeed.","rationale":"An agent decides whether to retry from the error alone, so the error must be machine-readable and stable.","evaluate":{"method":"scenario"},"ref":"AGT-407","area":"06-agents","section":"Catalogue contract","lifecycle":"active","boundary":"b-11","boundaryDetail":"`error`","traces":["g-24"],"milestone":7,"inSection":"sec-agents-401","realisation":"checked"},
    {"id":"agt-408","kind":"requirement","statement":"An event subscription SHALL resume after a disconnect from the last position that its subscriber acknowledged.","rationale":"A watching agent that reconnects must not silently miss committed changes.","evaluate":{"method":"scenario"},"ref":"AGT-408","area":"06-agents","section":"Catalogue contract","lifecycle":"active","boundary":"b-11","boundaryDetail":"`event stream`","traces":["g-23"],"milestone":7,"inSection":"sec-agents-401","realisation":"checked"},
    {"id":"agt-409","kind":"requirement","statement":"The events delivered to one subscription SHALL keep the commit order of the tenant they come from.","rationale":"Events of one tenant are a sequence, and an agent that reads them out of order reaches a wrong state.","evaluate":{"method":"property"},"ref":"AGT-409","area":"06-agents","section":"Catalogue contract","lifecycle":"active","boundary":"b-11","boundaryDetail":"`event stream`","traces":["g-23"],"milestone":7,"inSection":"sec-agents-401","realisation":"checked"},
    {"id":"agt-410","kind":"requirement","statement":"The operation catalogue SHALL offer queries over metrics, logs and traces to agents.","rationale":"An agent that diagnoses a fault needs the telemetry through the same contract as everything else.","evaluate":{"method":"scenario"},"ref":"AGT-410","area":"06-agents","section":"Queries over the platform","lifecycle":"active","boundary":"b-11","boundaryDetail":"`telemetry query`","traces":["g-23","g-27"],"milestone":7,"inSection":"sec-agents-402","realisation":"checked"},
    {"id":"agt-411","kind":"requirement","statement":"A telemetry query made by an agent SHALL return only the series, log lines and spans that the policies of the agent's principal permit it to read.","rationale":"Telemetry carries no record content, but it still reveals who is active and where, so it is filtered like a read.","evaluate":{"method":"scenario"},"ref":"AGT-411","area":"06-agents","section":"Queries over the platform","lifecycle":"active","boundary":"b-12","boundaryDetail":"`telemetry query`","traces":["g-23","g-27"],"milestone":7,"inSection":"sec-agents-402","realisation":"checked"},
    {"id":"agt-412","kind":"requirement","statement":"An audit query made by an agent SHALL return only the entries that the policies of the agent's principal permit it to read.","rationale":"The audit log describes people and tenants, so an agent sees the part its principal may see and no more.","evaluate":{"method":"scenario"},"ref":"AGT-412","area":"06-agents","section":"Queries over the platform","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit query`","traces":["g-30","g-23"],"milestone":7,"inSection":"sec-agents-402","realisation":"checked"},
    {"id":"agt-413","kind":"requirement","statement":"A result that withholds audit entries from an agent SHALL state that entries were withheld.","rationale":"A filtered record that looks complete misleads the agent that reads it.","evaluate":{"method":"scenario"},"ref":"AGT-413","area":"06-agents","section":"Queries over the platform","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit query`","traces":["g-30"],"milestone":7,"inSection":"sec-agents-402","realisation":"checked"},
    {"id":"agt-414","kind":"requirement","statement":"The verification status of each requirement of this specification SHALL be readable through the operation catalogue by owners of a tenant and by platform operators.","rationale":"An agent asks what the platform is required to guarantee before it relies on it.","evaluate":{"method":"scenario"},"ref":"AGT-414","area":"06-agents","section":"Queries over the platform","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /specification/requirements`","traces":["g-41","g-27","d-533"],"milestone":7,"inSection":"sec-agents-402","realisation":"checked"},
    {"id":"agt-415","kind":"requirement","statement":"Every tenant lifecycle operation SHALL be a catalogue operation that offers a dry run and writes an audit entry.","rationale":"Provisioning, suspension, export, move and deletion are the operations with the largest effect, so they carry the same evidence as every other operation.","evaluate":{"method":"scenario"},"ref":"AGT-415","area":"06-agents","section":"Operations over the platform","lifecycle":"active","boundary":"b-3","boundaryDetail":"`POST /tenants`","traces":["g-23","g-30"],"milestone":7,"inSection":"sec-agents-403","realisation":"checked"},
    {"id":"agt-416","kind":"requirement","statement":"The jobs and schedules of a tenant SHALL be listable through the operation catalogue with their state, their attempts and the error of each attempt.","rationale":"An agent that reasons about stuck automation needs the record that the automation worker keeps.","evaluate":{"method":"scenario"},"ref":"AGT-416","area":"06-agents","section":"Operations over the platform","lifecycle":"active","boundary":"b-7","boundaryDetail":"`job`","traces":["g-13","g-27"],"milestone":7,"inSection":"sec-agents-403","realisation":"checked"},
    {"id":"agt-417","kind":"requirement","statement":"Cancelling a job SHALL be a catalogue operation that records the requester and the reason for the cancellation.","rationale":"A cancelled job is final, so the reason is kept with it.","evaluate":{"method":"scenario"},"ref":"AGT-417","area":"06-agents","section":"Operations over the platform","lifecycle":"active","boundary":"b-7","boundaryDetail":"`job cancel`","traces":["g-13","g-25"],"milestone":7,"inSection":"sec-agents-403","realisation":"checked"},
    {"id":"agt-418","kind":"requirement","statement":"Retrying a failed job SHALL create a new attempt and leave the recorded outcome of earlier attempts unchanged.","rationale":"Dead work is explained by its history, so a retry adds to the history and does not rewrite it.","evaluate":{"method":"scenario"},"ref":"AGT-418","area":"06-agents","section":"Operations over the platform","lifecycle":"active","boundary":"b-7","boundaryDetail":"`job retry`","traces":["g-14","g-25"],"milestone":7,"inSection":"sec-agents-403","realisation":"checked"},
    {"id":"agt-419","kind":"requirement","statement":"Purging a stored copy by tag SHALL be a catalogue operation that records the tag, the requester and the outcome.","rationale":"A purge removes what readers saw, so it needs the same record as a change.","evaluate":{"method":"scenario"},"ref":"AGT-419","area":"06-agents","section":"Operations over the platform","lifecycle":"active","boundary":"b-15","boundaryDetail":"`remove by tag`","traces":["g-22","g-25"],"milestone":7,"inSection":"sec-agents-403","realisation":"checked"},
    {"id":"agt-420","kind":"requirement","statement":"Feature flags and tenant quotas SHALL be readable and changeable through the operation catalogue as tenant metadata.","rationale":"Flags and quotas are how a tenant controls its own load and its own rollout, so an agent reaches them through the same catalogue.","evaluate":{"method":"scenario"},"ref":"AGT-420","area":"06-agents","section":"Operations over the platform","lifecycle":"active","boundary":"b-11","boundaryDetail":"`feature flag`","traces":["g-23","g-4"],"milestone":7,"inSection":"sec-agents-403","realisation":"checked"},
    {"id":"agt-421","kind":"requirement","statement":"Incident records SHALL be readable and updatable through the operation catalogue with their affected tenants and their timeline.","rationale":"An agent working an incident reads and writes the same incident record as the people on call.","evaluate":{"method":"scenario"},"ref":"AGT-421","area":"06-agents","section":"Operations over the platform","lifecycle":"active","boundary":"b-11","boundaryDetail":"`incident`","traces":["g-27"],"milestone":7,"inSection":"sec-agents-403","realisation":"checked"},
    {"id":"agt-422","kind":"requirement","statement":"A projection of a change SHALL be requestable through the operation catalogue against the recorded history of a tenant at a revision that the caller names.","rationale":"Simulation on demand is what lets an agent test a change before it proposes it.","evaluate":{"method":"scenario"},"ref":"AGT-422","area":"06-agents","section":"Operations over the platform","lifecycle":"active","boundary":"b-20","boundaryDetail":"`projection`","traces":["g-44","g-24"],"milestone":7,"inSection":"sec-agents-403","realisation":"checked"},
    {"id":"agt-423","kind":"requirement","statement":"The operation catalogue SHALL report the spend attributable to each agent and to each tenant for a period that the caller names.","rationale":"Cost is a cost of operation, and an agent that spends must be seen spending.","evaluate":{"method":"scenario"},"ref":"AGT-423","area":"06-agents","section":"Operations over the platform","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /spend`","traces":["g-27","g-28"],"milestone":7,"inSection":"sec-agents-403","realisation":"checked"},
    {"id":"agt-424","kind":"requirement","statement":"A deployment or configuration change SHALL be a catalogue operation that offers a dry run and records its outcome.","rationale":"The platform's own configuration is changed through the same contract as tenant metadata, so the same evidence applies.","evaluate":{"method":"scenario"},"ref":"AGT-424","area":"06-agents","section":"Operations over the platform","lifecycle":"active","boundary":"b-19","boundaryDetail":"`deployment descriptor`","traces":["g-23","g-44"],"milestone":7,"inSection":"sec-agents-403","realisation":"checked"},
    {"id":"agt-425","kind":"requirement","statement":"Identity realm configuration SHALL be readable and changeable through the operation catalogue, with each change projected before it applies.","rationale":"Sign-in policy is the most consequential configuration of a tenant, and it is projected like any schema change.","evaluate":{"method":"scenario"},"ref":"AGT-425","area":"06-agents","section":"Operations over the platform","lifecycle":"active","boundary":"b-4","boundaryDetail":"`realm configuration`","traces":["g-23","g-44"],"milestone":7,"inSection":"sec-agents-403","realisation":"checked"},
    {"id":"obs-400","kind":"requirement","statement":"Every run of an agent SHALL produce a trace that names each input the run read, each operation the run called and the outcome of each.","rationale":"The trace is the account of a run, so it names what the run saw and what it did.","evaluate":{"method":"scenario"},"ref":"OBS-400","area":"06-agents","section":"Agent run traces","lifecycle":"active","boundary":"b-12","boundaryDetail":"`agent run trace`","traces":["g-400"],"milestone":8,"inSection":"sec-observability-401","realisation":"checked"},
    {"id":"obs-401","kind":"requirement","statement":"A run trace of the platform's own conversational assistant SHALL name the model, its provider and its version behind each decision.","rationale":"A decision of the platform's own assistant is traceable to the model that made it. Third-party agents are covered by the non-goal on their reasoning.","evaluate":{"method":"example"},"ref":"OBS-401","area":"06-agents","section":"Agent run traces","lifecycle":"active","boundary":"b-12","boundaryDetail":"`assistant run trace`","traces":["g-400"],"milestone":8,"inSection":"sec-observability-401","realisation":"checked"},
    {"id":"obs-402","kind":"requirement","statement":"The platform-side steps of a run trace SHALL be replayable from the recorded inputs and operation outcomes.","rationale":"A replay shows whether the platform did what the record says, without asking the agent to repeat itself.","evaluate":{"method":"scenario"},"ref":"OBS-402","area":"06-agents","section":"Agent run traces","lifecycle":"active","boundary":"b-12","boundaryDetail":"`run replay`","traces":["g-400"],"milestone":8,"inSection":"sec-observability-401","realisation":"checked"},
    {"id":"obs-403","kind":"requirement","statement":"A run trace SHALL be visible to the owner of each tenant that the run touched and to no principal that lacks a permission on that tenant.","rationale":"The trace is the tenant's own record of what acted in it.","evaluate":{"method":"scenario"},"ref":"OBS-403","area":"06-agents","section":"Agent run traces","lifecycle":"active","boundary":"b-12","boundaryDetail":"`agent run trace`","traces":["g-400"],"milestone":8,"inSection":"sec-observability-401","realisation":"checked"},
    {"id":"obs-404","kind":"requirement","statement":"Each run trace, retained for the period that the tenant owner sets, SHALL name the agent and the person it acted for.","rationale":"Attribution is what makes the trace useful after the run is over.","evaluate":{"method":"scenario"},"ref":"OBS-404","area":"06-agents","section":"Agent run traces","lifecycle":"active","boundary":"b-12","boundaryDetail":"`agent run trace`","traces":["g-400","g-25"],"milestone":8,"inSection":"sec-observability-401","realisation":"checked"},
    {"id":"obs-405","kind":"requirement","statement":"The platform SHALL raise an alert when the operations of an agent depart from the pattern recorded for that agent.","rationale":"A compromised or confused agent is first visible as a change in its own pattern.","evaluate":{"method":"scenario"},"ref":"OBS-405","area":"06-agents","section":"Registry, attestation and alerts","lifecycle":"active","boundary":"b-12","boundaryDetail":"`alert`","traces":["g-403","g-27"],"milestone":8,"inSection":"sec-observability-402","realisation":"checked"},
    {"id":"obs-406","kind":"requirement","statement":"The agent registry SHALL list every agent with its owner, its purpose, its scopes and its tier.","rationale":"An agent that nobody owns is an agent nobody can stop, so the registry is complete by rule.","evaluate":{"method":"property"},"ref":"OBS-406","area":"06-agents","section":"Registry, attestation and alerts","lifecycle":"active","boundary":"b-11","boundaryDetail":"`agent registry`","traces":["g-23","g-10"],"milestone":8,"inSection":"sec-observability-402","realisation":"checked"},
    {"id":"obs-407","kind":"requirement","statement":"An agent request whose identity fails attestation SHALL be refused.","rationale":"Attestation ties each request to a registered agent, and a request without it is not that agent's.","evaluate":{"method":"scenario"},"ref":"OBS-407","area":"06-agents","section":"Registry, attestation and alerts","lifecycle":"active","boundary":"b-6","boundaryDetail":"`agent identity`","traces":["g-10","k-6"],"milestone":8,"inSection":"sec-observability-402","realisation":"checked"},
    {"id":"ags-400","kind":"requirement","statement":"Data that the platform returns to an agent SHALL carry the origin and the trust level of every text it contains.","rationale":"An agent cannot weigh a text it cannot place, so origin and trust travel with the text.","evaluate":{"method":"property"},"ref":"AGS-400","area":"06-agents","section":"Untrusted text","lifecycle":"active","boundary":"b-11","boundaryDetail":"`agent response`","traces":["k-400","g-402","d-532"],"milestone":8,"inSection":"sec-ags-2","realisation":"checked"},
    {"id":"ags-401","kind":"requirement","statement":"An instruction found inside data that an agent reads SHALL carry no authority over the operations that the agent performs.","rationale":"Prompt injection is the case where text written by a stranger is read as a command, and this rule removes that reading.","evaluate":{"method":"scenario"},"ref":"AGS-401","area":"06-agents","section":"Untrusted text","lifecycle":"active","boundary":"b-11","boundaryDetail":"`agent response`","traces":["g-402"],"milestone":8,"inSection":"sec-ags-2","realisation":"checked"},
    {"id":"ags-402","kind":"requirement","statement":"An operation requested while the agent works on text of low trust SHALL be refused when it would widen a scope, change a policy, or send data to an address that the tenant has not allowed.","rationale":"The three effects a planted instruction wants are the three that need a person, so the platform refuses them while the text is untrusted.","evaluate":{"method":"scenario"},"ref":"AGS-402","area":"06-agents","section":"Untrusted text","lifecycle":"active","boundary":"b-11","boundaryDetail":"`operation`","traces":["g-402","g-401"],"milestone":8,"inSection":"sec-ags-2","realisation":"checked"},
    {"id":"ags-403","kind":"requirement","statement":"Each case of the agent safety corpus SHALL end in the outcome that its row states.","rationale":"The corpus is the standing evidence that the rules above hold against the attacks it lists.","evaluate":{"method":"conformance"},"ref":"AGS-403","area":"06-agents","section":"Untrusted text","lifecycle":"active","boundary":"b-11","boundaryDetail":"`operation`","traces":["g-402","g-401"],"milestone":8,"cases":["cases-agent-safety-corpus"],"inSection":"sec-ags-2","realisation":"checked"},
    {"id":"ags-404","kind":"requirement","statement":"The platform's own conversational assistant SHALL receive tenant-authored text only inside a delimited data field.","rationale":"The assistant reads everything a tenant writes, so its context marks which text is data and which is its instruction.","evaluate":{"method":"example"},"ref":"AGS-404","area":"06-agents","section":"Untrusted text","lifecycle":"active","boundary":"b-11","boundaryDetail":"`assistant context`","traces":["g-402"],"milestone":8,"inSection":"sec-ags-2","realisation":"checked"},
    {"id":"ags-405","kind":"requirement","statement":"Tenant-defined object names SHALL appear in the operation catalogue only as quoted data inside a description.","rationale":"Operation names come from tenant metadata, so a crafted object name is the cheapest injection a catalogue offers.","evaluate":{"method":"property"},"ref":"AGS-405","area":"06-agents","section":"Untrusted text","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /operations`","traces":["g-402","k-400"],"milestone":8,"inSection":"sec-ags-2","realisation":"checked"},
    {"id":"ags-406","kind":"requirement","statement":"A delegation issued from a delegated token SHALL grant no scope beyond the scopes of that token.","rationale":"A chain of delegations narrows at every link, so the last agent holds no more than the first delegated token allowed.","evaluate":{"method":"property"},"ref":"AGS-406","area":"06-agents","section":"Delegation and authority","lifecycle":"active","boundary":"b-6","boundaryDetail":"`delegated token`","traces":["g-401","k-13"],"milestone":8,"inSection":"sec-ags-3","realisation":"checked"},
    {"id":"ags-407","kind":"requirement","statement":"A delegation SHALL name a purpose and an expiry that is no later than the expiry of the token it is issued from.","rationale":"A delegation without a purpose is a grant of everything the token reaches, and one that outlives its token is a way around revocation.","evaluate":{"method":"property"},"ref":"AGS-407","area":"06-agents","section":"Delegation and authority","lifecycle":"active","boundary":"b-6","boundaryDetail":"`delegation`","traces":["g-401"],"milestone":8,"inSection":"sec-ags-3","realisation":"checked"},
    {"id":"ags-408","kind":"requirement","statement":"A delegated token SHALL be refused for an operation outside the purpose that the delegation names.","rationale":"The purpose is checked at each use, not only at issue.","evaluate":{"method":"scenario"},"ref":"AGS-408","area":"06-agents","section":"Delegation and authority","lifecycle":"active","boundary":"b-6","boundaryDetail":"`delegated token`","traces":["g-401"],"milestone":8,"inSection":"sec-ags-3","realisation":"checked"},
    {"id":"ags-409","kind":"requirement","statement":"A proposal SHALL be approved only by a principal other than its author.","rationale":"An author who approves their own change is no check at all, so separation of duties is a rule of the approval and not a matter of convention.","evaluate":{"method":"scenario"},"ref":"AGS-409","area":"06-agents","section":"Delegation and authority","lifecycle":"active","boundary":"b-11","boundaryDetail":"`proposal approval`","traces":["g-401","g-26"],"milestone":8,"inSection":"sec-ags-3","realisation":"checked"},
    {"id":"ags-410","kind":"requirement","statement":"Approval of a change that tenant policy assigns to human approval SHALL come from a person and from no agent.","rationale":"Where policy names a person, an agent in the loop does not satisfy it, however capable it is.","evaluate":{"method":"scenario"},"ref":"AGS-410","area":"06-agents","section":"Delegation and authority","lifecycle":"active","boundary":"b-11","boundaryDetail":"`proposal approval`","traces":["g-26","k-13"],"milestone":8,"inSection":"sec-ags-3","realisation":"checked"},
    {"id":"ags-411","kind":"requirement","statement":"The approvals that count toward a quorum SHALL come from distinct principals that the policy names.","rationale":"A quorum counted with one principal twice is a quorum of one.","evaluate":{"method":"property"},"ref":"AGS-411","area":"06-agents","section":"Delegation and authority","lifecycle":"active","boundary":"b-11","boundaryDetail":"`proposal approval`","traces":["g-26"],"milestone":8,"inSection":"sec-ags-3","realisation":"checked"},
    {"id":"ags-412","kind":"requirement","statement":"A principal SHALL be refused a grant of any scope that its own policies do not permit it to grant, including a grant to itself.","rationale":"Granting is authority over authority, so it is decided by the same rule as any other act and has no exception for the grantor.","evaluate":{"method":"property"},"ref":"AGS-412","area":"06-agents","section":"Delegation and authority","lifecycle":"active","boundary":"b-6","boundaryDetail":"`grant`","traces":["g-401","k-13"],"milestone":8,"inSection":"sec-ags-3","realisation":"checked"},
    {"id":"ags-413","kind":"requirement","statement":"Changing the policy, the budget, the audit setting or the halt of an agent SHALL require a principal other than that agent.","rationale":"These are the four controls that bound an agent, and an agent that could change one of them would be unbounded.","evaluate":{"method":"scenario"},"ref":"AGS-413","area":"06-agents","section":"Delegation and authority","lifecycle":"active","boundary":"b-11","boundaryDetail":"`policy change`","traces":["g-401","g-28"],"milestone":8,"inSection":"sec-ags-3","realisation":"checked"},
    {"id":"ags-414","kind":"requirement","statement":"The platform SHALL count the operations, the records changed, the spend and the external calls of each agent against budgets of that agent and of its tenant.","rationale":"Volume is the first thing a runaway agent exhausts, so it is counted at two levels.","evaluate":{"method":"scenario"},"ref":"AGS-414","area":"06-agents","section":"Blast radius","lifecycle":"active","boundary":"b-11","boundaryDetail":"`operation budget`","traces":["g-403","g-28","d-531"],"milestone":8,"inSection":"sec-ags-4","realisation":"checked"},
    {"id":"ags-415","kind":"requirement","statement":"A bulk operation SHALL be refused unless a projection of the same operation ran against the current revision of the tenant.","rationale":"A bulk change is the one whose mistakes cannot be seen one record at a time, so it is seen whole first.","evaluate":{"method":"scenario"},"ref":"AGS-415","area":"06-agents","section":"Blast radius","lifecycle":"active","boundary":"b-11","boundaryDetail":"`bulk operation`","traces":["g-403","g-44"],"milestone":8,"inSection":"sec-ags-4","realisation":"checked"},
    {"id":"ags-416","kind":"requirement","statement":"An irreversible operation SHALL take effect only after the delay window that the tenant configured has passed, unless a person approved it.","rationale":"A window gives a person time to notice, and it is the only defence against a change nobody can undo. The default is twenty-four hours, and a tenant may set one hour to seven days (D-709).","evaluate":{"method":"scenario"},"ref":"AGS-416","area":"06-agents","section":"Blast radius","lifecycle":"active","boundary":"b-11","boundaryDetail":"`irreversible operation`","traces":["g-403","d-709"],"milestone":8,"inSection":"sec-ags-4","realisation":"checked"},
    {"id":"ags-417","kind":"requirement","statement":"A change by an agent to published content SHALL be applied first to a canary subset of records, and widened only after the checks on that subset pass.","rationale":"A published page reaches readers at once, so the first effect of an agent's change is limited to a subset that can be checked.","evaluate":{"method":"scenario"},"ref":"AGS-417","area":"06-agents","section":"Blast radius","lifecycle":"active","boundary":"b-9","boundaryDetail":"`published content`","traces":["g-403","g-26"],"milestone":8,"inSection":"sec-ags-4","realisation":"checked"},
    {"id":"ags-418","kind":"requirement","statement":"An agent SHALL be halted automatically when an anomaly rule of its tenant trips.","rationale":"A halt that waits for a person arrives after the damage, so the platform stops the agent itself and a person decides afterwards.","evaluate":{"method":"scenario"},"ref":"AGS-418","area":"06-agents","section":"Blast radius","lifecycle":"active","boundary":"b-11","boundaryDetail":"`agent halt`","traces":["g-403","g-28"],"milestone":8,"inSection":"sec-ags-4","realisation":"checked"},
    {"id":"ags-419","kind":"requirement","statement":"A halted agent SHALL have every further operation refused until a principal other than that agent resumes it.","rationale":"A halt that the agent can lift is not a halt, so resuming is for a person.","evaluate":{"method":"scenario"},"ref":"AGS-419","area":"06-agents","section":"Blast radius","lifecycle":"active","boundary":"b-11","boundaryDetail":"`agent halt`","traces":["g-403","g-28"],"milestone":8,"inSection":"sec-ags-4","realisation":"checked"},
    {"id":"ags-420","kind":"requirement","statement":"The anomaly rules of a tenant SHALL cover an error spike, a violated state invariant and a mass deletion.","rationale":"These are the three signatures of a runaway agent that the platform can see directly.","evaluate":{"method":"example"},"ref":"AGS-420","area":"06-agents","section":"Blast radius","lifecycle":"active","boundary":"b-11","boundaryDetail":"`anomaly rule`","traces":["g-403"],"milestone":8,"inSection":"sec-ags-4","realisation":"checked"},
    {"id":"ags-421","kind":"requirement","statement":"An applied agent change whose operation declares a reversal SHALL be reversible within the undo window that the tenant configured.","rationale":"Reversibility is declared per operation, and the window is the time in which a declared reversal is still possible. The default is seven days, and a tenant may set one hour to thirty days (D-709).","evaluate":{"method":"scenario"},"ref":"AGS-421","area":"06-agents","section":"Blast radius","lifecycle":"active","boundary":"b-11","boundaryDetail":"`undo`","traces":["g-403","g-25","d-709"],"milestone":8,"inSection":"sec-ags-4","realisation":"checked"},
    {"id":"ags-422","kind":"requirement","statement":"A change by an agent that exceeds a rate configured by the tenant SHALL be held for approval.","rationale":"The rate limit bounds how fast a mistake spreads, and the hold gives a person the choice before the rest of the changes happen.","evaluate":{"method":"scenario"},"ref":"AGS-422","area":"06-agents","section":"Blast radius","lifecycle":"active","boundary":"b-11","boundaryDetail":"`rate limit`","traces":["g-403","g-26"],"milestone":8,"inSection":"sec-ags-4","realisation":"checked"},
    {"id":"ags-423","kind":"requirement","statement":"A chain of events in which the output of an agent starts an event that starts the same agent again SHALL be stopped at the loop depth that the tenant configured.","rationale":"Agents that react to each other's events can loop without any single step being wrong, so the chain is measured as a whole. The default loop depth is five, and a tenant may set one up to the hop limit of D-700 (D-709).","evaluate":{"method":"scenario"},"ref":"AGS-423","area":"06-agents","section":"Blast radius","lifecycle":"active","boundary":"b-7","boundaryDetail":"`trigger chain`","traces":["g-403","d-709"],"milestone":8,"inSection":"sec-ags-4","realisation":"checked"},
    {"id":"ags-424","kind":"requirement","statement":"A platform-operating agent SHALL hold an identity separate from every tenant agent, with no grant that reads tenant content.","rationale":"An agent that deploys the platform is a different class of principal, and a tenant agent must not be one of them by accident.","evaluate":{"method":"scenario"},"ref":"AGS-424","area":"06-agents","section":"Platform-operating agents","lifecycle":"active","boundary":"b-19","boundaryDetail":"`platform identity`","traces":["k-401","g-404","d-530"],"milestone":8,"inSection":"sec-ags-5","realisation":"checked"},
    {"id":"ags-425","kind":"requirement","statement":"A platform-operating agent SHALL be refused any write to the audit log, to the specification gate and to the kill switch.","rationale":"These three are the means by which a platform-operating agent would hide what it did or stop being watched.","evaluate":{"method":"scenario"},"ref":"AGS-425","area":"06-agents","section":"Platform-operating agents","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit entry`","traces":["k-402","g-404"],"milestone":8,"inSection":"sec-ags-5","realisation":"checked"},
    {"id":"ags-426","kind":"requirement","statement":"A change to deployment or configuration by a platform-operating agent SHALL need approval from two principals, neither of which is that agent.","rationale":"A change to the platform reaches every tenant, so it is the change that most needs a second pair of eyes.","evaluate":{"method":"scenario"},"ref":"AGS-426","area":"06-agents","section":"Platform-operating agents","lifecycle":"active","boundary":"b-19","boundaryDetail":"`deployment descriptor`","traces":["g-404"],"milestone":12,"inSection":"sec-ags-5","realisation":"checked"},
    {"id":"ags-427","kind":"requirement","statement":"A change freeze declared by a platform owner SHALL refuse every deployment and configuration change by an agent until a person lifts the freeze.","rationale":"A freeze is the platform owner's statement that nothing changes now, and it binds agents as much as people.","evaluate":{"method":"scenario"},"ref":"AGS-427","area":"06-agents","section":"Platform-operating agents","lifecycle":"active","boundary":"b-19","boundaryDetail":"`change freeze`","traces":["g-404","g-28"],"milestone":12,"inSection":"sec-ags-5","realisation":"checked"},
    {"id":"ags-428","kind":"requirement","statement":"Break-glass access granted to an agent SHALL expire at a stated time, with each use audited.","rationale":"Break-glass is the emergency path, so it is the path that most needs a time limit and a record.","evaluate":{"method":"scenario"},"ref":"AGS-428","area":"06-agents","section":"Platform-operating agents","lifecycle":"active","boundary":"b-6","boundaryDetail":"`break-glass grant`","traces":["g-404","g-30"],"milestone":12,"inSection":"sec-ags-5","realisation":"checked"},
    {"id":"ags-429","kind":"requirement","statement":"Data that an agent reads SHALL leave the platform only through an address on the allow list that the tenant configured.","rationale":"What an agent reads is the one thing that can leave the platform by means that no record shows, so the allow list is the control.","evaluate":{"method":"scenario"},"ref":"AGS-429","area":"06-agents","section":"Data leaving the platform","lifecycle":"active","boundary":"b-11","boundaryDetail":"`agent export`","traces":["g-405"],"milestone":8,"inSection":"sec-ags-6","realisation":"checked"},
    {"id":"ags-430","kind":"requirement","statement":"An agent scope SHALL name the data classifications that the agent reads, and a read of any other classification is refused.","rationale":"Classification is the label that tells a read what it touches, so a scope that names it limits the read at the boundary.","evaluate":{"method":"property"},"ref":"AGS-430","area":"06-agents","section":"Data leaving the platform","lifecycle":"active","boundary":"b-11","boundaryDetail":"`agent scope`","traces":["g-405","g-20"],"milestone":8,"inSection":"sec-ags-6","realisation":"checked"},
    {"id":"ags-431","kind":"requirement","statement":"An operation of the agent plane SHALL return no value of a connector secret in a result, a dry run, an error or a projection.","rationale":"Connector secrets are write-only to every principal, and an agent is a principal, so no output of the agent plane carries one.","evaluate":{"method":"property"},"ref":"AGS-431","area":"06-agents","section":"Data leaving the platform","lifecycle":"active","boundary":"b-17","boundaryDetail":"`connector secret`","traces":["g-405","g-40"],"milestone":8,"inSection":"sec-ags-6","realisation":"checked"},
    {"id":"ags-432","kind":"requirement","statement":"A model provider that receives tenant data through an agent SHALL appear in the subprocessor list of that tenant with its region.","rationale":"A model provider that reads tenant data is a processor of it, and the tenant has to be able to see that.","evaluate":{"method":"example"},"ref":"AGS-432","area":"06-agents","section":"Data leaving the platform","lifecycle":"active","boundary":"b-11","boundaryDetail":"`subprocessor list`","traces":["g-405"],"milestone":8,"inSection":"sec-ags-6","realisation":"checked"},
    {"id":"ags-433","kind":"requirement","statement":"A direct operation that names a revision older than the current revision of its record SHALL be refused.","rationale":"A direct operation based on a stale read silently overwrites a change another agent made, so the revision it was based on is part of the request.","evaluate":{"method":"property"},"ref":"AGS-433","area":"06-agents","section":"Concurrent and chained change","lifecycle":"active","boundary":"b-11","boundaryDetail":"`operation revision`","traces":["g-25","g-26"],"milestone":8,"inSection":"sec-ags-7","realisation":"checked"},
    {"id":"ags-434","kind":"requirement","statement":"An agent that operates on a record with an open change by another agent SHALL receive that change in the status of the record.","rationale":"Two agents editing one record without knowing of each other is a conflict the platform can name, so the status says it.","evaluate":{"method":"scenario"},"ref":"AGS-434","area":"06-agents","section":"Concurrent and chained change","lifecycle":"active","boundary":"b-11","boundaryDetail":"`record status`","traces":["g-23","g-25"],"milestone":8,"inSection":"sec-ags-7","realisation":"checked"},
    {"id":"ags-435","kind":"requirement","statement":"The gate SHALL fail while any case of the agent safety corpus fails.","rationale":"An adversarial suite that does not block a change is a report, and the gate is what blocks it.","evaluate":{"method":"conformance"},"ref":"AGS-435","area":"06-agents","section":"Evaluation","lifecycle":"active","boundary":"b-19","boundaryDetail":"`gate`","traces":["g-41","k-15","d-534"],"milestone":8,"cases":["cases-agent-safety-corpus"],"inSection":"sec-ags-8","realisation":"checked"},
    {"id":"m-halted-agent-applies-nothing","kind":"temporal","models":"ags-419","statement":"After an anomaly halts an agent, no operation of that agent is applied.","evaluate":{"method":"never","scenarios":["anomaly-then-operation","operation-in-transit-at-halt"],"occurs":{"event":"ah-applied"},"negatives":[{"scenario":"anomaly-then-operation","faults":["defect-halt-ignored"]},{"scenario":"operation-in-transit-at-halt","faults":["defect-halt-ignored"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-anomaly-halts","kind":"temporal","models":"ags-418","statement":"A tripped anomaly rule halts the agent it concerns.","evaluate":{"method":"eventually","scenarios":["anomaly-then-operation"],"occurs":{"event":"ah-halted"},"negatives":[{"scenario":"anomaly-then-operation","faults":["ah-trip-disabled"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"restatement"},
    {"id":"m-running-agent-applies","kind":"temporal","models":"ags-418","statement":"An agent that has not been halted applies the operation it is asked to perform.","evaluate":{"method":"eventually","scenarios":["operation-when-running"],"occurs":{"event":"ah-applied"},"negatives":[{"scenario":"operation-when-running","faults":["ah-apply-disabled"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"restatement"},
    {"id":"m-self-approval-clears-nothing","kind":"temporal","models":"ags-409","statement":"An approval by the author of a proposal clears nothing.","evaluate":{"method":"never","scenarios":["self-approval-attempted","self-approval-redelivered"],"occurs":{"event":"sp-cleared"},"negatives":[{"scenario":"self-approval-attempted","faults":["defect-self-approval-accepted"]},{"scenario":"self-approval-redelivered","faults":["defect-self-approval-accepted"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-other-approval-clears","kind":"temporal","models":"ags-409","statement":"An approval by a principal other than the author clears the proposal.","evaluate":{"method":"eventually","scenarios":["other-approves"],"occurs":{"event":"sp-cleared"},"negatives":[{"scenario":"other-approves","faults":["sp-other-approval-disabled"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"restatement"},
    {"id":"ctk-001","kind":"requirement","statement":"A content token SHALL be stored as tenant metadata under the schema version, holding a name, an expression and a fallback text.","rationale":"Tokens are versioned, migrated, exported and inspected like the rest of the schema.","evaluate":{"method":"scenario"},"ref":"CTK-001","area":"07-content","section":"Definition","lifecycle":"active","boundary":"b-450","boundaryDetail":"`token definition`","traces":["g-450","g-31","d-450","d-524"],"milestone":6,"inSection":"sec-content-tokens-2","realisation":"checked"},
    {"id":"ctk-002","kind":"requirement","statement":"A token definition whose expression fails to parse SHALL be rejected with the position of the error.","rationale":"The author fixes the expression where it is wrong.","evaluate":{"method":"example"},"ref":"CTK-002","area":"07-content","section":"Definition","lifecycle":"active","boundary":"b-450","boundaryDetail":"`token definition`","traces":["g-450","g-24"],"milestone":6,"inSection":"sec-content-tokens-2","realisation":"checked"},
    {"id":"ctk-003","kind":"requirement","statement":"A token definition that refers to itself through other tokens SHALL be rejected.","rationale":"Evaluation then has an end.","evaluate":{"method":"scenario"},"ref":"CTK-003","area":"07-content","section":"Definition","lifecycle":"active","boundary":"b-450","boundaryDetail":"`token definition`","traces":["g-450","g-4"],"milestone":6,"inSection":"sec-content-tokens-2","realisation":"checked"},
    {"id":"ctk-004","kind":"requirement","statement":"Removing a token that stored content refers to SHALL be rejected in strict mode with the referring records listed.","rationale":"The same rule as any schema change: either everything still conforms or the change does not happen.","evaluate":{"method":"scenario"},"ref":"CTK-004","area":"07-content","section":"Definition","lifecycle":"active","boundary":"b-450","boundaryDetail":"`token definition`","traces":["g-450","g-44"],"milestone":6,"inSection":"sec-content-tokens-2","realisation":"checked"},
    {"id":"ctk-005","kind":"requirement","statement":"Saving content that refers to an undefined token SHALL be rejected with the name of that token.","rationale":"A misspelt token is found by the author, not by a reader.","evaluate":{"method":"scenario"},"ref":"CTK-005","area":"07-content","section":"Definition","lifecycle":"active","boundary":"b-450","boundaryDetail":"`token reference`","traces":["g-450","g-24"],"milestone":6,"inSection":"sec-content-tokens-2","realisation":"checked"},
    {"id":"ctk-006","kind":"requirement","statement":"A change to a token definition SHALL be offered with a projection that lists the content whose rendered text differs.","rationale":"One token appears on many pages, so its change is previewed like a schema change.","evaluate":{"method":"scenario"},"ref":"CTK-006","area":"07-content","section":"Definition","lifecycle":"active","boundary":"b-20","boundaryDetail":"`projection`","traces":["g-450","g-44"],"milestone":7,"inSection":"sec-content-tokens-2","realisation":"checked"},
    {"id":"ctk-007","kind":"requirement","statement":"The operation catalogue SHALL list the tokens of a tenant with their expressions and the fields they read.","rationale":"Agents and the assistant work with tokens through the same catalogue as people.","evaluate":{"method":"scenario"},"ref":"CTK-007","area":"07-content","section":"Definition","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /operations`","traces":["g-450","g-23"],"milestone":7,"inSection":"sec-content-tokens-2","realisation":"checked"},
    {"id":"ctk-008","kind":"requirement","statement":"For every snapshot, token and context, two evaluations of the token SHALL return equal values.","rationale":"A token is a kernel decision, so it replays and simulates like the rest.","evaluate":{"method":"property"},"ref":"CTK-008","area":"07-content","section":"Evaluation","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::read`","traces":["g-450","k-11"],"milestone":6,"inSection":"sec-content-tokens-3","realisation":"checked"},
    {"id":"ctk-009","kind":"requirement","statement":"A token expression SHALL receive the record being rendered, the reader, the tenant and the time of the request as its whole context.","rationale":"The time is a value handed in, so the kernel still reads no clock.","evaluate":{"method":"property"},"ref":"CTK-009","area":"07-content","section":"Evaluation","lifecycle":"active","boundary":"b-1","boundaryDetail":"`evaluation context`","traces":["g-450","k-1"],"milestone":6,"inSection":"sec-content-tokens-3","realisation":"checked"},
    {"id":"ctk-010","kind":"requirement","statement":"A token value SHALL be computed from field values that the policies of the reader permit that reader to read, and from no other field.","rationale":"A token is a read, and a read is filtered by policy. A token cannot be used to show a reader what a query would hide.","evaluate":{"method":"property"},"ref":"CTK-010","area":"07-content","section":"Evaluation","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::read`","traces":["g-451","g-20"],"milestone":6,"inSection":"sec-content-tokens-3","realisation":"checked"},
    {"id":"ctk-011","kind":"requirement","statement":"A token whose expression yields no value SHALL render its fallback text.","rationale":"Three-valued logic gives unknown, and the reader gets the text the author chose for that case.","evaluate":{"method":"scenario"},"ref":"CTK-011","area":"07-content","section":"Evaluation","lifecycle":"active","boundary":"b-450","boundaryDetail":"`fallback`","traces":["g-450"],"milestone":6,"inSection":"sec-content-tokens-3","realisation":"checked"},
    {"id":"ctk-012","kind":"requirement","statement":"A token evaluation that exhausts its step budget SHALL render the fallback text and record the failure for the tenant.","rationale":"A costly token degrades to its fallback and the owner hears about it.","evaluate":{"method":"scenario"},"ref":"CTK-012","area":"07-content","section":"Evaluation","lifecycle":"active","boundary":"b-450","boundaryDetail":"`fallback`","traces":["g-450","g-4"],"milestone":6,"inSection":"sec-content-tokens-3","realisation":"checked"},
    {"id":"ctk-013","kind":"requirement","statement":"A token value that is a date or a number SHALL be formatted for the language of the reader.","rationale":"The same token reads naturally in each language of the site.","evaluate":{"method":"scenario"},"ref":"CTK-013","area":"07-content","section":"Evaluation","lifecycle":"active","boundary":"b-9","boundaryDetail":"`Accept-Language`","traces":["g-450","g-34"],"milestone":11,"inSection":"sec-content-tokens-3","realisation":"checked"},
    {"id":"ctk-014","kind":"requirement","statement":"A token value SHALL enter each output context in the form that the token output context table states.","rationale":"A value is data. What makes it safe is the context it lands in, so each context has its row.","evaluate":{"method":"conformance"},"ref":"CTK-014","area":"07-content","section":"Output","lifecycle":"active","boundary":"b-450","boundaryDetail":"`output context`","traces":["k-450","k-12"],"milestone":6,"cases":["cases-token-output-contexts"],"inSection":"sec-content-tokens-4","realisation":"checked"},
    {"id":"ctk-015","kind":"requirement","statement":"A delivery response SHALL carry each resolved token as a text node of its structured blocks.","rationale":"The browser builds the page from nodes, so a value with markup characters shows those characters.","evaluate":{"method":"scenario"},"ref":"CTK-015","area":"07-content","section":"Output","lifecycle":"active","boundary":"b-9","boundaryDetail":"`structured blocks`","traces":["k-450","k-12"],"milestone":6,"inSection":"sec-content-tokens-4","realisation":"checked"},
    {"id":"ctk-016","kind":"requirement","statement":"The authoring application SHALL preview the tokens of a draft with the values that a reader chosen by the author would see.","rationale":"The author checks what a member, a guest or a named recipient will read.","evaluate":{"method":"scenario"},"ref":"CTK-016","area":"07-content","section":"Output","lifecycle":"active","boundary":"b-13","boundaryDetail":"`authoring application`","traces":["g-450","g-35"],"milestone":6,"inSection":"sec-content-tokens-4","realisation":"checked"},
    {"id":"ctk-017","kind":"requirement","statement":"A view that holds a token whose value depends on the requesting principal SHALL be marked as dependent on that principal.","rationale":"The mark is what keeps it out of shared copies and out of the edge. Modelled, with a shared store as the defect.","evaluate":{"method":"property"},"ref":"CTK-017","area":"07-content","section":"Stored copies","lifecycle":"active","boundary":"b-15","boundaryDetail":"`audience class`","traces":["g-451","k-7"],"milestone":6,"inSection":"sec-content-tokens-5","realisation":"checked"},
    {"id":"ctk-018","kind":"requirement","statement":"A read result that holds token values SHALL name the records and object types that each token expression read.","rationale":"A page is superseded when something its tokens read changes, not only when its own record does.","evaluate":{"method":"property"},"ref":"CTK-018","area":"07-content","section":"Stored copies","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::read`","traces":["g-450","g-19"],"milestone":6,"inSection":"sec-content-tokens-5","realisation":"checked"},
    {"id":"ctk-019","kind":"requirement","statement":"A token in an email SHALL be evaluated once for each recipient, with that recipient as the reader.","rationale":"A mailing to many people is many renderings, each under its own authority.","evaluate":{"method":"property"},"ref":"CTK-019","area":"07-content","section":"Email","lifecycle":"active","boundary":"b-451","boundaryDetail":"`mail template`","traces":["g-450","g-451"],"milestone":6,"inSection":"sec-content-tokens-6","realisation":"checked"},
    {"id":"ctk-020","kind":"requirement","statement":"An email addressed to a recipient that is no principal of the tenant SHALL evaluate its tokens with the authority of an anonymous reader.","rationale":"An outside address gets what the public gets.","evaluate":{"method":"scenario"},"ref":"CTK-020","area":"07-content","section":"Email","lifecycle":"active","boundary":"b-451","boundaryDetail":"`mail template`","traces":["g-451","g-20"],"milestone":6,"inSection":"sec-content-tokens-6","realisation":"checked"},
    {"id":"eml-001","kind":"requirement","statement":"Each mail adapter SHALL behave as the mail conformance table states for each listed case.","rationale":"An adapter is accepted by behaviour, like every other seam.","evaluate":{"method":"conformance"},"ref":"EML-001","area":"04-automation","section":"The mail contract","lifecycle":"active","boundary":"b-18","boundaryDetail":"`mail contract`","traces":["g-452","g-38"],"milestone":3,"cases":["cases-mail-conformance"],"inSection":"sec-email-2","realisation":"checked"},
    {"id":"eml-002","kind":"requirement","statement":"The mail provider of a deployment SHALL be selected by configuration, with no change to a component image.","rationale":"Changing provider is an operation, not a release.","evaluate":{"method":"scenario"},"ref":"EML-002","area":"04-automation","section":"The mail contract","lifecycle":"active","boundary":"b-19","boundaryDetail":"`environment`","traces":["g-452","k-10"],"milestone":3,"inSection":"sec-email-2","realisation":"checked"},
    {"id":"eml-003","kind":"requirement","statement":"A platform component other than the mail dispatcher SHALL hold no credential of a mail provider and open no connection to one.","rationale":"One place to rate-limit, suppress, log and swap. Checked structurally on the component model.","evaluate":{"method":"property"},"ref":"EML-003","area":"04-automation","section":"The mail contract","lifecycle":"active","boundary":"b-18","boundaryDetail":"`mail contract`","traces":["k-451","g-452"],"milestone":3,"inSection":"sec-email-2","realisation":"construction"},
    {"id":"eml-004","kind":"requirement","statement":"The credential of a mail provider SHALL be read from the key service at the time of sending.","rationale":"The credential sits in no image, no environment file and no tenant database.","evaluate":{"method":"scenario"},"ref":"EML-004","area":"04-automation","section":"The mail contract","lifecycle":"active","boundary":"b-17","boundaryDetail":"`unwrap`","traces":["g-452","g-40","d-523"],"milestone":3,"inSection":"sec-email-2","realisation":"checked"},
    {"id":"eml-005","kind":"requirement","statement":"A request to send mail SHALL become a job in the transaction that commits the change it belongs to.","rationale":"No mail for a change that did not happen, and no change whose mail is lost.","evaluate":{"method":"scenario"},"ref":"EML-005","area":"04-automation","section":"Sending","lifecycle":"active","boundary":"b-7","boundaryDetail":"`mail job`","traces":["g-452","k-9","d-451"],"milestone":5,"inSection":"sec-email-3","realisation":"checked"},
    {"id":"eml-006","kind":"requirement","statement":"A message submitted again with the idempotency key of an accepted message SHALL be delivered once.","rationale":"A lost acknowledgement leads to a retry, and the retry is not a second email. Modelled, with a repeat delivery as the defect.","evaluate":{"method":"property"},"ref":"EML-006","area":"04-automation","section":"Sending","lifecycle":"active","boundary":"b-18","boundaryDetail":"`idempotency key`","traces":["g-453","g-15"],"milestone":3,"inSection":"sec-email-3","realisation":"checked"},
    {"id":"eml-007","kind":"requirement","statement":"A temporary refusal by the mail provider SHALL leave its message queued for a later attempt.","rationale":"Providers throttle and defer as a matter of course.","evaluate":{"method":"scenario"},"ref":"EML-007","area":"04-automation","section":"Sending","lifecycle":"active","boundary":"b-18","boundaryDetail":"`temporary refusal`","traces":["g-453","g-14"],"milestone":3,"inSection":"sec-email-3","realisation":"checked"},
    {"id":"eml-008","kind":"requirement","statement":"A message that the provider refuses for a permanent reason SHALL be recorded as failed with the reason and attempted no further.","rationale":"A bad address does not get better.","evaluate":{"method":"scenario"},"ref":"EML-008","area":"04-automation","section":"Sending","lifecycle":"active","boundary":"b-18","boundaryDetail":"`permanent refusal`","traces":["g-453","g-14"],"milestone":3,"inSection":"sec-email-3","realisation":"checked"},
    {"id":"eml-009","kind":"requirement","statement":"A message that carries a sign-in link SHALL be discarded unsent once the lifetime of its link has passed.","rationale":"After an outage the queue does not deliver links that no longer work.","evaluate":{"method":"scenario"},"ref":"EML-009","area":"04-automation","section":"Sending","lifecycle":"active","boundary":"b-7","boundaryDetail":"`mail job`","traces":["g-452","g-46"],"milestone":5,"inSection":"sec-email-3","realisation":"checked"},
    {"id":"eml-010","kind":"requirement","statement":"The state of each message SHALL be readable by a principal that the policies of the tenant permit to read its mail log.","rationale":"Did it send is the first support question, and an agent can answer it.","evaluate":{"method":"scenario"},"ref":"EML-010","area":"04-automation","section":"Sending","lifecycle":"active","boundary":"b-451","boundaryDetail":"`GET /mail/messages`","traces":["g-453","g-23"],"milestone":5,"inSection":"sec-email-3","realisation":"checked"},
    {"id":"eml-011","kind":"requirement","statement":"The mail log SHALL keep the state and the recipient of a message and drop its body once the provider has accepted it.","rationale":"The log answers what happened without keeping a second copy of what was said.","evaluate":{"method":"property"},"ref":"EML-011","area":"04-automation","section":"Sending","lifecycle":"active","boundary":"b-451","boundaryDetail":"`mail log`","traces":["g-453","g-22"],"milestone":5,"inSection":"sec-email-3","realisation":"checked"},
    {"id":"eml-012","kind":"requirement","statement":"A mail template SHALL be stored as tenant metadata holding a subject, structured blocks and content tokens.","rationale":"Templates are data, so they are versioned, projected and exported with the tenant.","evaluate":{"method":"scenario"},"ref":"EML-012","area":"04-automation","section":"Tenant mail","lifecycle":"active","boundary":"b-451","boundaryDetail":"`mail template`","traces":["g-453","g-31"],"milestone":6,"inSection":"sec-email-4","realisation":"checked"},
    {"id":"eml-013","kind":"requirement","statement":"Mail of a tenant SHALL carry a sender address on a domain of that tenant only after the tenant has proved control of that domain.","rationale":"Proof first, so one tenant cannot send as another, or as anyone else.","evaluate":{"method":"scenario"},"ref":"EML-013","area":"04-automation","section":"Tenant mail","lifecycle":"active","boundary":"b-451","boundaryDetail":"`sender domain`","traces":["g-453","g-21"],"milestone":5,"inSection":"sec-email-4","realisation":"checked"},
    {"id":"eml-014","kind":"requirement","statement":"Mail of a tenant with no proved domain SHALL be sent from an address of the platform that names the tenant.","rationale":"A new tenant can send on its first day.","evaluate":{"method":"scenario"},"ref":"EML-014","area":"04-automation","section":"Tenant mail","lifecycle":"active","boundary":"b-451","boundaryDetail":"`sender domain`","traces":["g-453"],"milestone":5,"inSection":"sec-email-4","realisation":"checked"},
    {"id":"eml-015","kind":"requirement","statement":"A message sent from a tenant domain SHALL be signed with a key published under that domain.","rationale":"Receivers check alignment between the sender address and the signature.","evaluate":{"method":"scenario"},"ref":"EML-015","area":"04-automation","section":"Tenant mail","lifecycle":"active","boundary":"b-18","boundaryDetail":"`DKIM-Signature`","traces":["g-453","k-14"],"milestone":5,"inSection":"sec-email-4","realisation":"checked"},
    {"id":"eml-016","kind":"requirement","statement":"A message SHALL be rendered from structured blocks into an HTML part and a plain text part.","rationale":"No tenant markup reaches a mail client, and every message is readable as text.","evaluate":{"method":"scenario"},"ref":"EML-016","area":"04-automation","section":"Tenant mail","lifecycle":"active","boundary":"b-451","boundaryDetail":"`mail template`","traces":["k-12","k-450"],"milestone":5,"inSection":"sec-email-4","realisation":"checked"},
    {"id":"eml-017","kind":"requirement","statement":"A permanent bounce or a complaint reported by the provider SHALL add its address to the suppression list of the tenant.","rationale":"Sending again to an address that bounced or complained costs the reputation of every sender on the platform.","evaluate":{"method":"scenario"},"ref":"EML-017","area":"04-automation","section":"Tenant mail","lifecycle":"active","boundary":"b-18","boundaryDetail":"`delivery report`","traces":["g-453"],"milestone":5,"inSection":"sec-email-4","realisation":"checked"},
    {"id":"eml-018","kind":"requirement","statement":"A message addressed to a suppressed address SHALL be recorded as suppressed and left unsent.","rationale":"The suppression list is checked at the one place all mail passes.","evaluate":{"method":"property"},"ref":"EML-018","area":"04-automation","section":"Tenant mail","lifecycle":"active","boundary":"b-451","boundaryDetail":"`suppression list`","traces":["g-453"],"milestone":5,"inSection":"sec-email-4","realisation":"checked"},
    {"id":"eml-019","kind":"requirement","statement":"A delivery report SHALL be accepted only when it carries the signature of the provider that the deployment is configured for.","rationale":"A forged bounce would silence mail to a real address.","evaluate":{"method":"scenario"},"ref":"EML-019","area":"04-automation","section":"Tenant mail","lifecycle":"active","boundary":"b-18","boundaryDetail":"`delivery report`","traces":["g-453","g-46"],"milestone":5,"inSection":"sec-email-4","realisation":"checked"},
    {"id":"eml-020","kind":"requirement","statement":"Mail that a tenant sends to an audience SHALL carry an unsubscribe header and a link that take effect without a sign-in.","rationale":"What mailbox providers expect of bulk senders, and what recipients are owed.","evaluate":{"method":"scenario"},"ref":"EML-020","area":"04-automation","section":"Tenant mail","lifecycle":"active","boundary":"b-451","boundaryDetail":"`List-Unsubscribe`","traces":["g-453","k-14"],"milestone":5,"inSection":"sec-email-4","realisation":"checked"},
    {"id":"eml-021","kind":"requirement","statement":"A tenant that exceeds its mail quota SHALL have its further messages held while sign-in mail and the mail of other tenants leave.","rationale":"One tenant's campaign does not delay another tenant's sign-in link.","evaluate":{"method":"scenario"},"ref":"EML-021","area":"04-automation","section":"Tenant mail","lifecycle":"active","boundary":"b-451","boundaryDetail":"`mail quota`","traces":["g-453","g-4"],"milestone":5,"inSection":"sec-email-4","realisation":"checked"},
    {"id":"m-token-value-not-shared","kind":"invariant","models":"ctk-017","statement":"In the model, no reader is served a stored page rendered for another reader, because the normal design stores no reader-dependent page.","evaluate":{"method":"state-invariant","scenarios":["token-two-readers","token-reader-joins-concurrently"],"expr":"!token-render-flow.leak","negatives":[{"scenario":"token-two-readers","faults":["defect-token-stored-shared"]},{"scenario":"token-reader-joins-concurrently","faults":["defect-token-stored-shared"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-mail-delivered-once","kind":"invariant","models":"eml-006","statement":"A message submitted twice with one idempotency key is delivered once, and a message with another key is not taken for it. Two keys are modelled: the table of the adapter has two slots.","evaluate":{"method":"state-invariant","scenarios":["mail-timeout-then-retry","mail-first-acknowledgement-lost","mail-first-submission-lost","mail-same-key-twice","mail-two-keys"],"expr":"mail-adapter-flow.deliveredK1 <= 1 && mail-adapter-flow.deliveredK2 <= 1","negatives":[{"scenario":"mail-timeout-then-retry","faults":["defect-mail-delivered-again"]},{"scenario":"mail-two-keys","faults":["defect-mail-delivered-again"]},{"scenario":"mail-two-keys","faults":["defect-mail-delivered-again-k2"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-mail-recorded-after-retry","kind":"temporal","models":"eml-006","statement":"A message whose first acknowledgement came late, or was lost, is still recorded as sent.","evaluate":{"method":"eventually","scenarios":["mail-timeout-then-retry","mail-first-acknowledgement-lost","mail-first-submission-lost"],"occurs":{"event":"em-recorded"},"negatives":[{"scenario":"mail-timeout-then-retry","faults":["mail-recording-disabled"]},{"scenario":"mail-first-submission-lost","faults":["mail-recording-disabled"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-mail-only-via-dispatcher","kind":"structural","models":"eml-003","statement":"Every path from a component other than the mail dispatcher to the mail provider passes through the mail dispatcher.","evaluate":{"method":"only-via","from":["kernel","substrate","store-contract","sqlite-adapter","postgres-adapter","tenant-database","control-plane","control-database","identity-service","runtime","gateway","automation-worker","connector-runner","copy-store","file-store","delivery-network","delivery-network-control","agent-gateway","telemetry-pipeline","audit-log","key-service","external-identity-provider","web-application","simulator","verification","agent","limit-store","backup-archive","fleet-reporting","product-module","external-endpoint","notice-queue","search-index","notification-service","conversation-service","model-provider","local-model-adapter","operator-console","outbound-gate","upload-scanner","release-controller","release-pipeline","image-registry","traffic-switch","subject-rights-service","agent-traffic-switch","migration-job","platform-audit-store"],"to":"mail-service","via":"mail-dispatcher"},"assumptions":["a-model-abstraction"]},
    {"id":"cnv-500","kind":"requirement","statement":"A new tenant SHALL have the assistant turned off until an owner of that tenant turns it on.","rationale":"Nothing is sent to a model provider that the tenant did not choose to send (D-514).","evaluate":{"method":"scenario"},"ref":"CNV-500","area":"09-conversation","section":"Model provider","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /conversations/{id}/turns`","traces":["g-205","d-514"],"milestone":9,"inSection":"sec-conversation-8","realisation":"checked"},
    {"id":"ten-500","kind":"requirement","statement":"Provisioning a tenant SHALL issue one bootstrap credential for its first owner, which is refused after its first use and after its expiry.","rationale":"A tenant is usable from the milestone that provisions it, before any other sign-in method exists (D-509).","evaluate":{"method":"scenario"},"ref":"TEN-500","area":"02-tenancy","section":"Provisioning","lifecycle":"active","boundary":"b-3","boundaryDetail":"`bootstrap credential`","traces":["g-2","d-509"],"milestone":2,"inSection":"sec-tenancy-2","realisation":"checked"},
    {"id":"arc-500","kind":"requirement","statement":"A directory entry SHALL be served for at most 15 minutes after the control plane was last reached.","rationale":"Long enough to ride out a restart or a failover of the control plane, short enough that a suspended or moved tenant is not served for long (D-528).","evaluate":{"method":"budget"},"ref":"ARC-500","area":"09-architecture","section":"Control plane and wake index","lifecycle":"active","boundary":"b-3","boundaryDetail":"`directory entry`","traces":["g-101","d-528"],"milestone":2,"inSection":"sec-arch-2","realisation":"operational"},
    {"id":"agt-500","kind":"requirement","statement":"Disabling an agent SHALL be honoured by every agent gateway instance within 5 seconds.","rationale":"The bound on the kill switch, measured like the bound on session revocation.","evaluate":{"method":"budget"},"ref":"AGT-500","area":"06-agents","section":"Authorise, attribute and limit","lifecycle":"active","boundary":"b-11","boundaryDetail":"`agent state`","traces":["g-28"],"milestone":7,"inSection":"sec-agents-5","realisation":"operational"},
    {"id":"rel-550","kind":"requirement","lifecycle":"active","statement":"A component image SHALL be addressed by its content digest in every release record and every deployment descriptor.","rationale":"A tag can be moved after a test, so a name that moves is not evidence of what ran.","evaluate":{"method":"property"},"ref":"REL-550","area":"08-platform","section":"Images and configuration","boundary":"b-19","boundaryDetail":"`deployment descriptor`","traces":["g-550","d-550"],"milestone":2,"inSection":"sec-release-2","realisation":"operational"},
    {"id":"rel-551","kind":"requirement","lifecycle":"active","statement":"The image that passes the gate in the stage environment SHALL be the image that the production environment runs, with the same digest.","rationale":"What was tested is what is deployed. A second build is a second program.","evaluate":{"method":"scenario"},"ref":"REL-551","area":"08-platform","section":"Images and configuration","boundary":"b-19","boundaryDetail":"`release record`","traces":["g-551","d-550"],"milestone":12,"inSection":"sec-release-2","realisation":"checked"},
    {"id":"rel-552","kind":"requirement","lifecycle":"active","statement":"A component image SHALL be rebuilt on a newer base image within 7 days of the publication of a fix to its base image.","rationale":"A base image that is not rebuilt keeps the fixed flaw in every image that uses it.","evaluate":{"method":"budget"},"ref":"REL-552","area":"08-platform","section":"Images and configuration","boundary":"b-19","boundaryDetail":"`base image`","traces":["g-550","g-259"],"milestone":12,"inSection":"sec-release-2","realisation":"operational"},
    {"id":"rel-553","kind":"requirement","lifecycle":"active","statement":"A release record SHALL name each configuration value of its deployment and hold no secret value.","rationale":"Configuration is named where it is set, and a secret reaches a component only from the key service (DEP-006, SEC-003).","evaluate":{"method":"property"},"ref":"REL-553","area":"08-platform","section":"Images and configuration","boundary":"b-550","boundaryDetail":"`release record`","traces":["g-550","g-554"],"milestone":12,"inSection":"sec-release-2","realisation":"checked"},
    {"id":"rel-554","kind":"requirement","lifecycle":"active","statement":"The stage environment and the production environment SHALL differ only in the ways that the rule column of the environment parity table allows.","rationale":"The parity table is the list of what the stage evidence covers, and each row is checked.","evaluate":{"method":"conformance"},"cases":["cases-environment-parity"],"ref":"REL-554","area":"08-platform","section":"Environments and parity","boundary":"b-19","boundaryDetail":"`environment`","traces":["g-551","d-553"],"milestone":12,"inSection":"sec-release-3","realisation":"checked"},
    {"id":"rel-555","kind":"requirement","lifecycle":"active","statement":"The stage environment SHALL hold only synthetic tenants and scrubbed copies, and no personal data of a production tenant.","rationale":"A personal field of a production tenant held in stage is a copy that the subject rights of PRV-350 to PRV-353 must reach, and the stage environment is not built to reach it.","evaluate":{"method":"property"},"ref":"REL-555","area":"08-platform","section":"Environments and parity","boundary":"b-19","boundaryDetail":"`stage tenant`","traces":["g-555"],"milestone":12,"inSection":"sec-release-3","realisation":"checked"},
    {"id":"rel-556","kind":"requirement","lifecycle":"active","statement":"The stage environment and the production environment SHALL use separate cloud accounts, networks, keys, databases and identity realms.","rationale":"A compromise or a mistake in one environment reaches the other only through a shared account, key or realm, so none is shared.","evaluate":{"method":"scenario"},"ref":"REL-556","area":"08-platform","section":"Environments and parity","boundary":"b-19","boundaryDetail":"`environment`","traces":["g-555","d-553"],"milestone":12,"inSection":"sec-release-3","realisation":"operational"},
    {"id":"rel-584","kind":"requirement","lifecycle":"active","statement":"The cloud profile SHALL hold one stage environment and one production environment, and no environment for a branch or a change.","rationale":"A review environment per branch is a third place that holds the platform and needs its own care, and no requirement is met by it that the stage environment does not meet (D-552).","evaluate":{"method":"scenario"},"ref":"REL-584","area":"08-platform","section":"Environments and parity","boundary":"b-19","boundaryDetail":"`environment`","traces":["g-554","d-552"],"milestone":12,"inSection":"sec-release-3","realisation":"checked"},
    {"id":"rel-557","kind":"requirement","lifecycle":"active","statement":"A release SHALL reach the production environment only after each gate of its promotion path has recorded a passing result in its release record.","rationale":"A gate that is skipped leaves no record, so the record is the proof that every gate ran.","evaluate":{"method":"scenario"},"ref":"REL-557","area":"08-platform","section":"Promotion and approval","boundary":"b-550","boundaryDetail":"`promotion`","traces":["g-551","d-551"],"milestone":12,"inSection":"sec-release-4","realisation":"checked"},
    {"id":"rel-558","kind":"requirement","lifecycle":"active","statement":"A release SHALL pass the smoke checks, the conformance suites of every seam, a migration rehearsal on a copy of production-shaped data and the synthetic probes in the stage environment before its soak begins.","rationale":"Each check answers a different failure: the smoke checks the start, the suites the seams, the rehearsal the data and the probes the outside view.","evaluate":{"method":"scenario"},"ref":"REL-558","area":"08-platform","section":"Promotion and approval","boundary":"b-550","boundaryDetail":"`stage verification`","traces":["g-551"],"milestone":12,"inSection":"sec-release-4","realisation":"checked"},
    {"id":"rel-559","kind":"requirement","lifecycle":"active","statement":"A release SHALL remain in the stage environment for at least 24 hours with its probes passing before its approval is requested.","rationale":"A soak exposes faults that appear only after time, such as a leak or a schedule that runs once a day.","evaluate":{"method":"budget"},"ref":"REL-559","area":"08-platform","section":"Promotion and approval","boundary":"b-550","boundaryDetail":"`stage soak`","traces":["g-551"],"milestone":12,"inSection":"sec-release-4","realisation":"operational"},
    {"id":"rel-560","kind":"requirement","lifecycle":"active","statement":"A production release SHALL carry approvals from two distinct principals, neither of which is its author, and none of which is an agent.","rationale":"The separation rule of AGS-409 and the two-principal rule of AGS-426 apply to every production release, and D-530 keeps agents out of approvals until the last release stage.","evaluate":{"method":"property"},"ref":"REL-560","area":"08-platform","section":"Promotion and approval","boundary":"b-550","boundaryDetail":"`approval`","traces":["g-554","d-564"],"milestone":12,"inSection":"sec-release-4","realisation":"checked"},
    {"id":"rel-561","kind":"requirement","lifecycle":"active","statement":"A change to the production environment SHALL be made only through a release record or an audited operation of the operation catalogue.","rationale":"A change without a record cannot be explained, and an unexplained change to production is the first thing an audit asks about.","evaluate":{"method":"property"},"ref":"REL-561","area":"08-platform","section":"Promotion and approval","boundary":"b-550","boundaryDetail":"`production change`","traces":["g-554","d-567"],"milestone":12,"inSection":"sec-release-4","realisation":"checked"},
    {"id":"rel-562","kind":"requirement","lifecycle":"active","statement":"The release controller SHALL report each difference between the definitions of an environment and what runs in it, at a stated interval.","rationale":"A difference that is only found at the next release is a release that fails for a reason nobody recorded.","evaluate":{"method":"scenario"},"ref":"REL-562","area":"08-platform","section":"Promotion and approval","boundary":"b-550","boundaryDetail":"`drift report`","traces":["g-554","d-566"],"milestone":12,"inSection":"sec-release-4","realisation":"checked"},
    {"id":"rel-563","kind":"requirement","lifecycle":"active","statement":"The release controller SHALL refuse a production release that falls within a freeze window declared by a platform owner, unless the release is a hotfix that the freeze names.","rationale":"A freeze is the owner's statement that nothing changes now, and an emergency fix is the one release a freeze names.","evaluate":{"method":"scenario"},"ref":"REL-563","area":"08-platform","section":"Promotion and approval","boundary":"b-550","boundaryDetail":"`freeze window`","traces":["g-554","d-563"],"milestone":12,"inSection":"sec-release-4","realisation":"checked"},
    {"id":"rel-564","kind":"requirement","lifecycle":"active","statement":"A hotfix SHALL pass every gate of the promotion path, with a stage soak of at least one hour before its approval is requested.","rationale":"The emergency path keeps every gate and shortens only the soak, so that the fix is proved before it reaches readers.","evaluate":{"method":"budget"},"ref":"REL-564","area":"08-platform","section":"Emergency path","boundary":"b-550","boundaryDetail":"`hotfix`","traces":["g-554","d-562"],"milestone":12,"inSection":"sec-release-5","realisation":"operational"},
    {"id":"rel-565","kind":"requirement","lifecycle":"active","statement":"A colour switch SHALL first send at most 5 percent of public requests to the new colour for at least 15 minutes, and then the full share.","rationale":"The canary is the cheapest evidence that the new colour works under real traffic before every reader reaches it (d-554).","evaluate":{"method":"budget"},"ref":"REL-565","area":"08-platform","section":"Colour switch","boundary":"b-551","boundaryDetail":"`canary share`","traces":["g-552","d-554"],"milestone":12,"inSection":"sec-release-6","realisation":"operational"},
    {"id":"rel-566","kind":"requirement","lifecycle":"active","statement":"A new colour SHALL take no public traffic until the release record names it as verified against production dependencies.","rationale":"The new colour is deployed beside the live one and is checked against production databases, queues and identity before a reader can reach it.","evaluate":{"method":"scenario"},"ref":"REL-566","area":"08-platform","section":"Colour switch","boundary":"b-551","boundaryDetail":"`public traffic`","traces":["g-552","d-556"],"milestone":12,"inSection":"sec-release-6","realisation":"checked"},
    {"id":"rel-567","kind":"requirement","lifecycle":"active","statement":"A colour switch or a switch back SHALL take effect at the traffic switch within 30 seconds at the 99th percentile after the release controller requests it.","rationale":"A switch that takes minutes is a deployment, and the short bound keeps a switch back as a remedy and not a project.","evaluate":{"method":"budget"},"ref":"REL-567","area":"08-platform","section":"Colour switch","boundary":"b-551","boundaryDetail":"`colour switch`","traces":["g-552"],"milestone":12,"inSection":"sec-release-6","realisation":"operational"},
    {"id":"rel-568","kind":"requirement","lifecycle":"active","statement":"A switch back SHALL be a single operation of the release controller that deploys nothing.","rationale":"Switching back returns to a colour that is still running, so it needs no build, no deployment and no second decision.","evaluate":{"method":"scenario"},"ref":"REL-568","area":"08-platform","section":"Colour switch","boundary":"b-550","boundaryDetail":"`switch back`","traces":["g-552","d-555"],"milestone":12,"inSection":"sec-release-6","realisation":"checked"},
    {"id":"rel-569","kind":"requirement","lifecycle":"active","statement":"The previous colour SHALL keep its instances running for at least 24 hours after a colour switch.","rationale":"A problem found the next morning is still answered by a switch back, because the previous colour is still there (d-556).","evaluate":{"method":"budget"},"ref":"REL-569","area":"08-platform","section":"Colour switch","boundary":"b-551","boundaryDetail":"`warm colour`","traces":["g-552","d-556"],"milestone":12,"inSection":"sec-release-6","realisation":"operational"},
    {"id":"rel-570","kind":"requirement","lifecycle":"active","statement":"Withdrawing a colour SHALL wait until each of its workers has finished or released the job leases it holds, or until those leases have expired.","rationale":"A job whose lease is held by a withdrawn worker is finished by its replacement only after the lease expires (SCH-010, SCH-011).","evaluate":{"method":"scenario"},"ref":"REL-570","area":"08-platform","section":"Withdrawing a colour","boundary":"b-7","boundaryDetail":"`job lease`","traces":["g-552","d-561"],"milestone":12,"inSection":"sec-release-7","realisation":"checked"},
    {"id":"rel-571","kind":"requirement","lifecycle":"active","statement":"A colour that is withdrawn SHALL close each open event stream and streamed reply with a notice that names the last sequence number it sent.","rationale":"A stream that ends without a notice looks like a failure. With the number, the client resumes on the live colour without a gap (d-558).","evaluate":{"method":"scenario"},"ref":"REL-571","area":"08-platform","section":"Withdrawing a colour","boundary":"b-9","boundaryDetail":"`event stream`","traces":["g-552","d-558"],"milestone":12,"inSection":"sec-release-7","realisation":"checked"},
    {"id":"rel-572","kind":"requirement","lifecycle":"active","statement":"Both colours SHALL share the tenant databases, the copy store, the file store and the notice queue, with no private copy of any of them held by a colour.","rationale":"Shared state is what lets a switch be undone, and a private copy would be lost with its colour (d-557).","evaluate":{"method":"scenario"},"ref":"REL-572","area":"08-platform","section":"Withdrawing a colour","boundary":"b-2","boundaryDetail":"`shared state`","traces":["g-552","d-557"],"milestone":12,"inSection":"sec-release-7","realisation":"checked"},
    {"id":"rel-573","kind":"requirement","lifecycle":"active","statement":"A stored copy SHALL carry the release identifier of the colour that computed it, so that the other colour treats it as absent.","rationale":"A copy computed by one colour is an answer the other colour may compute differently, and the identifier keeps the two apart (CPY-002).","evaluate":{"method":"scenario"},"ref":"REL-573","area":"08-platform","section":"Withdrawing a colour","boundary":"b-15","boundaryDetail":"`copy key`","traces":["g-552","d-557"],"milestone":12,"inSection":"sec-release-7","realisation":"checked"},
    {"id":"rel-577","kind":"requirement","lifecycle":"active","statement":"After a switch back, the traffic switch SHALL send no public request to the withdrawn colour.","rationale":"A withdrawn colour that still takes traffic serves the state that was rolled back.","evaluate":{"method":"scenario"},"ref":"REL-577","area":"08-platform","section":"Withdrawing a colour","boundary":"b-551","boundaryDetail":"`public traffic`","traces":["g-552"],"milestone":12,"inSection":"sec-release-7","realisation":"checked"},
    {"id":"rel-574","kind":"requirement","lifecycle":"active","statement":"A release that carries a contracting phase of a stored layout change SHALL carry it in a release of its own.","rationale":"A contracting phase removes what the previous colour reads, so it cannot be undone by a switch back (k-550, OPS-324).","evaluate":{"method":"example"},"ref":"REL-574","area":"08-platform","section":"Rollback and roll-forward","boundary":"b-3","boundaryDetail":"`layout version`","traces":["g-553","k-550"],"milestone":12,"inSection":"sec-release-8","realisation":"checked"},
    {"id":"rel-575","kind":"requirement","lifecycle":"active","statement":"The release record of a release SHALL classify the release as rollback-safe or roll-forward-only, naming each stored change that the previous colour cannot read.","rationale":"The classification is written before the release starts, so the question whether to undo a release is answered by the record and not by an argument during an incident.","evaluate":{"method":"scenario"},"ref":"REL-575","area":"08-platform","section":"Rollback and roll-forward","boundary":"b-550","boundaryDetail":"`release record`","traces":["g-553"],"milestone":12,"inSection":"sec-release-8","realisation":"checked"},
    {"id":"rel-576","kind":"requirement","lifecycle":"active","statement":"Lifecycle operations of the control plane SHALL run in one active instance at a time, across both colours.","rationale":"Two instances of the control plane acting on one tenant at once can provision, move or delete it twice (d-559).","evaluate":{"method":"scenario"},"ref":"REL-576","area":"08-platform","section":"Control plane, identity and edge","boundary":"b-3","boundaryDetail":"`tenant operation`","traces":["g-552","d-559"],"milestone":12,"inSection":"sec-release-9","realisation":"checked"},
    {"id":"rel-578","kind":"requirement","lifecycle":"active","statement":"The edge configuration of a release SHALL be versioned in its release record and change only with the colour switch of that release.","rationale":"The domain bindings, cache rules and response headers are part of what readers receive, so they move with the release that changes them.","evaluate":{"method":"scenario"},"ref":"REL-578","area":"08-platform","section":"Control plane, identity and edge","boundary":"b-10","boundaryDetail":"`edge configuration`","traces":["g-554"],"milestone":12,"inSection":"sec-release-9","realisation":"checked"},
    {"id":"rel-579","kind":"requirement","lifecycle":"active","statement":"A colour switch SHALL end no sign-in session and no delegated grant.","rationale":"Sessions live in the tenant databases and both colours verify them, so a switch that ends a session would be a bug in the switch (d-560).","evaluate":{"method":"scenario"},"ref":"REL-579","area":"08-platform","section":"Control plane, identity and edge","boundary":"b-4","boundaryDetail":"`sign-in session`","traces":["g-552","d-560"],"milestone":12,"inSection":"sec-release-9","realisation":"checked"},
    {"id":"rel-580","kind":"requirement","lifecycle":"active","statement":"The release controller SHALL have no relationship of any kind, calls included, to a tenant database, a copy store or a file store, and no path to one that avoids the control plane and the migration job.","rationale":"The controller changes the platform and never reads tenant content, so its own reach is the registry, the traffic switch, the platform audit store, the control plane and the migration job (K-2, D-707). The control plane and the migration job hold tenant data access of their own, as they must to provision and to migrate.","evaluate":{"method":"property"},"ref":"REL-580","area":"08-platform","section":"The release controller and its records","boundary":"b-550","boundaryDetail":"`release controller`","traces":["k-2","g-554","d-707"],"milestone":12,"inSection":"sec-release-10","realisation":"construction"},
    {"id":"rel-581","kind":"requirement","lifecycle":"active","statement":"The operation catalogue SHALL list the release record of each production release with its digests, its gate results, its approvals and its colour history.","rationale":"An agent or an operator who asks what runs in production gets the same answer the release controller holds (AGT-414).","evaluate":{"method":"scenario"},"ref":"REL-581","area":"08-platform","section":"The release controller and its records","boundary":"b-11","boundaryDetail":"`GET /releases`","traces":["g-554","d-565"],"milestone":12,"inSection":"sec-release-10","realisation":"checked"},
    {"id":"rel-582","kind":"requirement","lifecycle":"active","statement":"Each platform component that the platform builds SHALL run from a component image that the release pipeline built, and runs from no process installed on a host.","rationale":"A component that runs from an installed process cannot be rebuilt, signed, rolled back or compared with the image that was tested (DEP-001, DEP-008).","evaluate":{"method":"property"},"ref":"REL-582","area":"08-platform","section":"Images and configuration","boundary":"b-19","boundaryDetail":"`component image`","traces":["g-550","g-37"],"milestone":12,"inSection":"sec-release-2","realisation":"operational"},
    {"id":"rel-583","kind":"requirement","lifecycle":"active","statement":"A release SHALL be built only from a commit that the specification gate has passed, and its release record names that commit.","rationale":"The gate is the first step of the promotion path, so an image that was built from an unchecked commit never reaches stage (ASR-001).","evaluate":{"method":"scenario"},"ref":"REL-583","area":"08-platform","section":"Promotion and approval","boundary":"b-550","boundaryDetail":"`release build`","traces":["g-551","g-41"],"milestone":12,"inSection":"sec-release-4","realisation":"operational"},
    {"id":"mig-550","kind":"requirement","lifecycle":"active","statement":"A schema change SHALL be previewed on a copy of the tenant before it is applied to the tenant.","rationale":"The copy holds the tenant's own data, so the preview reports what the change does to the records it will change (d-571).","evaluate":{"method":"scenario"},"ref":"MIG-550","area":"02-tenancy","section":"The guarantee","boundary":"b-1","boundaryDetail":"`schema change`","traces":["g-556","g-44"],"milestone":2,"inSection":"sec-migration-2","realisation":"checked"},
    {"id":"mig-552","kind":"requirement","lifecycle":"active","statement":"A reader SHALL see each record of a tenant in its prior form or in its migrated form, and in no partly converted form.","rationale":"A reader that sees half of a record sees data that no version of the schema has.","evaluate":{"method":"property"},"ref":"MIG-552","area":"02-tenancy","section":"The guarantee","boundary":"b-552","boundaryDetail":"`migrated record`","traces":["g-557"],"milestone":2,"inSection":"sec-migration-2","realisation":"checked"},
    {"id":"mig-555","kind":"requirement","lifecycle":"active","statement":"A migration run that fails SHALL leave the tenant in the form it had before the run, with the failure named in its migration run record.","rationale":"A failed run that leaves the tenant partly changed is a second incident on top of the first.","evaluate":{"method":"scenario"},"ref":"MIG-555","area":"02-tenancy","section":"The guarantee","boundary":"b-552","boundaryDetail":"`migration run`","traces":["g-556","g-557","d-572"],"milestone":2,"inSection":"sec-migration-2","realisation":"checked"},
    {"id":"mig-556","kind":"requirement","lifecycle":"active","statement":"Each migration run SHALL record the preview it was applied from, its batches and its outcome, together with the principal that started it.","rationale":"A change to a tenant's content is attributable in the same way as any other change of the tenant (AGT-015).","evaluate":{"method":"scenario"},"ref":"MIG-556","area":"02-tenancy","section":"The guarantee","boundary":"b-552","boundaryDetail":"`migration run record`","traces":["g-556","g-25"],"milestone":2,"inSection":"sec-migration-2","realisation":"checked"},
    {"id":"mig-579","kind":"requirement","lifecycle":"active","statement":"A committed record of a tenant SHALL remain readable after a migration run or a move that the platform reports as complete.","rationale":"Completion is a claim about the data, and this states what the claim covers.","evaluate":{"method":"property"},"ref":"MIG-579","area":"02-tenancy","section":"The guarantee","boundary":"b-2","boundaryDetail":"`tenant database`","traces":["g-557"],"milestone":2,"inSection":"sec-migration-2","realisation":"checked"},
    {"id":"mig-580","kind":"requirement","lifecycle":"active","statement":"Each batch of a migration run SHALL read and write records of its own tenant only.","rationale":"A batch that reads another tenant to build its own change breaks isolation, which holds through every change (K-2, TEN-007).","evaluate":{"method":"property"},"ref":"MIG-580","area":"02-tenancy","section":"The guarantee","boundary":"b-552","boundaryDetail":"`migration batch`","traces":["g-20","k-2"],"milestone":2,"inSection":"sec-migration-2","realisation":"checked"},
    {"id":"mig-581","kind":"requirement","lifecycle":"active","statement":"A migration run SHALL stop when the tenant owner stops it, with its cursor recorded and the tenant serving its readers.","rationale":"The owner controls the change to their own content, and stopping it leaves the tenant working.","evaluate":{"method":"scenario"},"ref":"MIG-581","area":"02-tenancy","section":"The guarantee","boundary":"b-552","boundaryDetail":"`migration run`","traces":["g-557","g-28"],"milestone":5,"inSection":"sec-migration-2","realisation":"checked"},
    {"id":"mig-551","kind":"requirement","lifecycle":"active","statement":"A schema change of at most 10000 records of one type SHALL apply in one transition, and a larger change runs as a migration run.","rationale":"One transition is the simplest guarantee. The limit keeps one commit within what a single transaction can hold (d-569).","evaluate":{"method":"budget"},"ref":"MIG-551","area":"02-tenancy","section":"Schema changes","boundary":"b-1","boundaryDetail":"`schema change`","traces":["g-557","d-569"],"milestone":2,"inSection":"sec-migration-3","realisation":"operational"},
    {"id":"mig-557","kind":"requirement","lifecycle":"active","statement":"A schema change that removes a field or a constraint SHALL be marked irreversible in its preview.","rationale":"A removal cannot be undone by the platform once later writes depend on it, so the preview says so before the owner decides (AGT-010, NG-551).","evaluate":{"method":"example"},"ref":"MIG-557","area":"02-tenancy","section":"Schema changes","boundary":"b-1","boundaryDetail":"`schema change preview`","traces":["g-556","d-571"],"milestone":2,"inSection":"sec-migration-3","realisation":"checked"},
    {"id":"mig-558","kind":"requirement","lifecycle":"active","statement":"Each conversion of a field from one type to another SHALL behave as the type conversion table states for that pair of types.","rationale":"A conversion is accepted by its table, the way every adapter is accepted by its conformance suite (d-570).","evaluate":{"method":"conformance"},"cases":["cases-type-conversions"],"ref":"MIG-558","area":"02-tenancy","section":"Schema changes","boundary":"b-1","boundaryDetail":"`field type conversion`","traces":["g-557","d-570"],"milestone":2,"inSection":"sec-migration-3","realisation":"checked"},
    {"id":"mig-559","kind":"requirement","lifecycle":"active","statement":"A new field SHALL take the value of each existing record from the expression that its schema change declares.","rationale":"A backfill that is written by hand is a second rule that nobody previews. The expression is in the preview like the rest of the change.","evaluate":{"method":"scenario"},"ref":"MIG-559","area":"02-tenancy","section":"Schema changes","boundary":"b-1","boundaryDetail":"`backfill expression`","traces":["g-556"],"milestone":2,"inSection":"sec-migration-3","realisation":"checked"},
    {"id":"mig-560","kind":"requirement","lifecycle":"active","statement":"A rename SHALL keep the values of existing records under the new name, so that a request under the old name is refused after the change.","rationale":"A rename that drops the values is a delete, and a rename that keeps the old name alive is two fields.","evaluate":{"method":"scenario"},"ref":"MIG-560","area":"02-tenancy","section":"Schema changes","boundary":"b-1","boundaryDetail":"`rename`","traces":["g-557"],"milestone":2,"inSection":"sec-migration-3","realisation":"checked"},
    {"id":"mig-561","kind":"requirement","lifecycle":"active","statement":"A save of a draft made under a prior schema version SHALL be refused with the current version named, and the author's text stays on screen.","rationale":"The author keeps the work, and learns which schema the save was refused against.","evaluate":{"method":"scenario"},"ref":"MIG-561","area":"02-tenancy","section":"Schema changes","boundary":"b-13","boundaryDetail":"`draft save`","traces":["g-556","g-206"],"milestone":6,"inSection":"sec-migration-3","realisation":"checked"},
    {"id":"mig-562","kind":"requirement","lifecycle":"active","statement":"A workflow run SHALL continue under the definition version that started it, and a run that the new definition cannot continue stops with its state recorded.","rationale":"A run started under one definition is finished under it, unless the definition has changed in a way the run cannot follow.","evaluate":{"method":"scenario"},"ref":"MIG-562","area":"02-tenancy","section":"Schema changes","boundary":"b-8","boundaryDetail":"`workflow run`","traces":["g-16","g-556"],"milestone":5,"inSection":"sec-migration-3","realisation":"checked"},
    {"id":"mig-563","kind":"requirement","lifecycle":"active","statement":"A scheduled job SHALL be checked against the schema version in force when it falls due, and it is refused with the changed field named when its definition no longer fits.","rationale":"A job created under the old schema is checked when it runs, because the schema it was written for may no longer exist.","evaluate":{"method":"scenario"},"ref":"MIG-563","area":"02-tenancy","section":"Schema changes","boundary":"b-7","boundaryDetail":"`job`","traces":["g-13","g-556"],"milestone":5,"inSection":"sec-migration-3","realisation":"checked"},
    {"id":"mig-553","kind":"requirement","lifecycle":"active","statement":"A batch of a migration run SHALL hold the writes of its tenant for no longer than 1 second at the 99th percentile.","rationale":"The write pause is the one visible cost of a batched run, so it has a bound that the owner can rely on.","evaluate":{"method":"budget"},"ref":"MIG-553","area":"02-tenancy","section":"Batched runs","boundary":"b-552","boundaryDetail":"`migration batch`","traces":["g-557"],"milestone":2,"inSection":"sec-migration-4","realisation":"operational"},
    {"id":"mig-554","kind":"requirement","lifecycle":"active","statement":"A migration run that stops SHALL resume from its last committed cursor, so that each record of the tenant is converted once.","rationale":"A run that restarts from the beginning converts some records twice, and the cursor is what makes the resume exact.","evaluate":{"method":"scenario"},"ref":"MIG-554","area":"02-tenancy","section":"Batched runs","boundary":"b-7","boundaryDetail":"`migration cursor`","traces":["g-557","k-551","d-568"],"milestone":2,"inSection":"sec-migration-4","realisation":"checked"},
    {"id":"mig-564","kind":"requirement","lifecycle":"active","statement":"A newer version of an installed template SHALL reach a tenant only as a proposal that carries its projection and that the tenant approves before any change applies.","rationale":"An upgrade changes the tenant's own records, so the tenant sees its projection and decides (d-578, INT-154).","evaluate":{"method":"scenario"},"ref":"MIG-564","area":"02-tenancy","section":"Delivery shape and templates","boundary":"b-21","boundaryDetail":"`template upgrade`","traces":["g-167","g-556","d-578"],"milestone":7,"inSection":"sec-migration-5","realisation":"checked"},
    {"id":"mig-582","kind":"requirement","lifecycle":"active","statement":"Both delivery shapes SHALL return the same content for each field that they both carry while the old shape is served.","rationale":"A client that moves at its own pace must not find different facts in the old shape and the new one.","evaluate":{"method":"property"},"ref":"MIG-582","area":"02-tenancy","section":"Delivery shape and templates","boundary":"b-9","boundaryDetail":"`delivery interface`","traces":["g-166"],"milestone":6,"inSection":"sec-migration-5","realisation":"checked"},
    {"id":"mig-565","kind":"requirement","lifecycle":"active","statement":"A tenant whose layout change fails SHALL stay on its previous layout and keep serving its readers.","rationale":"A failed wave is a tenant that lags, and a lagging tenant that stops serving is an outage caused by a release (OPS-323, d-577).","evaluate":{"method":"scenario"},"ref":"MIG-565","area":"02-tenancy","section":"Platform-driven changes","boundary":"b-3","boundaryDetail":"`layout version`","traces":["g-557","g-303","d-577"],"milestone":2,"inSection":"sec-migration-6","realisation":"checked"},
    {"id":"mig-566","kind":"requirement","lifecycle":"active","statement":"A tenant SHALL be served by a newer kernel version only after its journal replays under that version to the state hash that the journal records.","rationale":"The replay is the proof that the new kernel decides the same history the old one did (SIM-004, TEN-015).","evaluate":{"method":"scenario"},"ref":"MIG-566","area":"02-tenancy","section":"Platform-driven changes","boundary":"b-20","boundaryDetail":"`kernel version`","traces":["g-5","g-557","d-580"],"milestone":12,"inSection":"sec-migration-6","realisation":"checked"},
    {"id":"mig-567","kind":"requirement","lifecycle":"active","statement":"A migration applied to a staging tenant SHALL reach its production tenant only as a migration run of that tenant, previewed against the production data.","rationale":"The staging tenant prepares the change, and the production run is the one that changes production (d-575, ADM-158).","evaluate":{"method":"scenario"},"ref":"MIG-567","area":"02-tenancy","section":"Platform-driven changes","boundary":"b-11","boundaryDetail":"`promotion`","traces":["g-164","g-556","d-575"],"milestone":7,"inSection":"sec-migration-6","realisation":"checked"},
    {"id":"mig-568","kind":"requirement","lifecycle":"active","statement":"Writes to a tenant that is moving SHALL be refused for no longer than 60 seconds at the 99th percentile.","rationale":"The read-only window is the visible cost of a move, and the bound states it in advance (d-576).","evaluate":{"method":"budget"},"ref":"MIG-568","area":"02-tenancy","section":"Moving a tenant","boundary":"b-553","boundaryDetail":"`tenant move`","traces":["g-558"],"milestone":2,"inSection":"sec-migration-7","realisation":"operational"},
    {"id":"mig-569","kind":"requirement","lifecycle":"active","statement":"The owner of a tenant SHALL receive notice of the read-only window of a move at least 48 hours before the window starts.","rationale":"The owner plans around a window they know about, and a window announced at its start is an outage.","evaluate":{"method":"budget"},"ref":"MIG-569","area":"02-tenancy","section":"Moving a tenant","boundary":"b-553","boundaryDetail":"`move notice`","traces":["g-558"],"milestone":2,"inSection":"sec-migration-7","realisation":"operational"},
    {"id":"mig-570","kind":"requirement","lifecycle":"active","statement":"The directory SHALL switch a moving tenant to its target placement only after the target state hash equals the source state hash.","rationale":"The hash is the proof that the copy holds the same state, so the directory does not switch to an unverified copy (TEN-012).","evaluate":{"method":"scenario"},"ref":"MIG-570","area":"02-tenancy","section":"Moving a tenant","boundary":"b-553","boundaryDetail":"`placement switch`","traces":["g-558","d-576"],"milestone":2,"inSection":"sec-migration-7","realisation":"checked"},
    {"id":"mig-571","kind":"requirement","lifecycle":"active","statement":"A move whose copy fails SHALL leave the source serving every request and the directory on the source placement.","rationale":"A failed copy is a failed move, and the tenant is where it was before the move started.","evaluate":{"method":"scenario"},"ref":"MIG-571","area":"02-tenancy","section":"Moving a tenant","boundary":"b-553","boundaryDetail":"`tenant move`","traces":["g-558"],"milestone":2,"inSection":"sec-migration-7","realisation":"checked"},
    {"id":"mig-572","kind":"requirement","lifecycle":"active","statement":"The source database of a moved tenant SHALL be kept for at least 7 days after its placement switch.","rationale":"A problem found after the switch is undone by switching back to the source, which exists only for the retention (d-576).","evaluate":{"method":"budget"},"ref":"MIG-572","area":"02-tenancy","section":"Moving a tenant","boundary":"b-553","boundaryDetail":"`source retention`","traces":["g-558"],"milestone":2,"inSection":"sec-migration-7","realisation":"operational"},
    {"id":"mig-573","kind":"requirement","lifecycle":"active","statement":"A point-in-time restore SHALL report the first and the last committed change that it did not restore.","rationale":"A restore that loses changes without naming them leaves the owner to find out what is missing (D-579, OPS-320).","evaluate":{"method":"example"},"ref":"MIG-573","area":"02-tenancy","section":"Restore","boundary":"b-3","boundaryDetail":"`tenant restore`","traces":["g-39","g-302","d-579"],"milestone":12,"inSection":"sec-migration-8","realisation":"checked"},
    {"id":"mig-574","kind":"requirement","lifecycle":"active","statement":"An import of records SHALL update a record that the tenant already holds rather than duplicate it, so that the import can be run again.","rationale":"An import that stops halfway is run again, and a second run that duplicates every record is worse than the first failure.","evaluate":{"method":"scenario"},"ref":"MIG-574","area":"02-tenancy","section":"Import and export","boundary":"b-153","boundaryDetail":"`record import`","traces":["g-163"],"milestone":11,"inSection":"sec-migration-9","realisation":"checked"},
    {"id":"mig-575","kind":"requirement","lifecycle":"active","statement":"An import SHALL produce a mapping report that names each source field with its target field and each value that it could not map.","rationale":"The report is the record of what the import changed and what it refused, and the owner reviews it before the import is trusted.","evaluate":{"method":"example"},"ref":"MIG-575","area":"02-tenancy","section":"Import and export","boundary":"b-153","boundaryDetail":"`mapping report`","traces":["g-163"],"milestone":11,"inSection":"sec-migration-9","realisation":"checked"},
    {"id":"mig-576","kind":"requirement","lifecycle":"active","statement":"An import SHALL keep the identifiers, version numbers, timestamps and authors that the archive names for each record.","rationale":"Links and references between records survive a move between systems only when identifiers survive it (G-163).","evaluate":{"method":"property"},"ref":"MIG-576","area":"02-tenancy","section":"Import and export","boundary":"b-153","boundaryDetail":"`record import`","traces":["g-163"],"milestone":11,"inSection":"sec-migration-9","realisation":"checked"},
    {"id":"mig-577","kind":"requirement","lifecycle":"active","statement":"An import of pages SHALL create a redirect from each former address that the archive names to the address of the imported page.","rationale":"Links from outside the old site keep working after the move (CMS-161).","evaluate":{"method":"scenario"},"ref":"MIG-577","area":"02-tenancy","section":"Import and export","boundary":"b-9","boundaryDetail":"`redirect`","traces":["g-159"],"milestone":11,"inSection":"sec-migration-9","realisation":"checked"},
    {"id":"mig-578","kind":"requirement","lifecycle":"active","statement":"An archive SHALL state each kind of content that it does not carry.","rationale":"An archive that looks complete and is not misleads the customer who takes it elsewhere (ADM-161).","evaluate":{"method":"example"},"ref":"MIG-578","area":"02-tenancy","section":"Import and export","boundary":"b-153","boundaryDetail":"`archive manifest`","traces":["g-163"],"milestone":11,"inSection":"sec-migration-9","realisation":"checked"},
    {"id":"mig-583","kind":"requirement","lifecycle":"active","statement":"A plan change SHALL be refused while the tenant holds more of a metered quantity than the new plan allows, with that quantity named.","rationale":"A downgrade is a migration of the tenant's own usage, and it is refused where the tenant would be out of line (BIL-151).","evaluate":{"method":"scenario"},"ref":"MIG-583","area":"02-tenancy","section":"Plans","boundary":"b-3","boundaryDetail":"`tenant plan`","traces":["g-157","g-4"],"milestone":6,"inSection":"sec-migration-10","realisation":"checked"},
    {"id":"mig-584","kind":"requirement","lifecycle":"active","statement":"A migration run SHALL carry each published version of a record across its change, with the schema version under which that version was written.","rationale":"A record's history reads the same after a change of schema, and each version says which schema it was written under (CMS-006, G-32).","evaluate":{"method":"scenario"},"ref":"MIG-584","area":"02-tenancy","section":"Schema changes","boundary":"b-552","boundaryDetail":"`record history`","traces":["g-32","g-556"],"milestone":11,"inSection":"sec-migration-3","realisation":"checked"},
    {"id":"mig-586","kind":"requirement","lifecycle":"active","statement":"A request that began before a placement switch SHALL complete on the source placement, and a request that begins after it uses the target placement.","rationale":"A switch that changes the placement under a request in flight writes to the wrong database for that request.","evaluate":{"method":"scenario"},"ref":"MIG-586","area":"02-tenancy","section":"Moving a tenant","boundary":"b-553","boundaryDetail":"`placement switch`","traces":["g-558"],"milestone":2,"inSection":"sec-migration-7","realisation":"checked"},
    {"id":"mig-587","kind":"requirement","lifecycle":"active","statement":"A placement switch SHALL leave the stored copies and the edge copies of the tenant valid, because their keys name the tenant and not the placement.","rationale":"A move that purges every copy turns a placement change into a load spike on the target database.","evaluate":{"method":"scenario"},"ref":"MIG-587","area":"02-tenancy","section":"Moving a tenant","boundary":"b-553","boundaryDetail":"`placement switch`","traces":["g-558","g-18"],"milestone":6,"inSection":"sec-migration-7","realisation":"checked"},
    {"id":"mig-588","kind":"requirement","lifecycle":"active","statement":"After a placement switch, the backups and the files of the tenant SHALL be those of the target placement, with the source backups kept for the source retention.","rationale":"Backups and files follow the placement that holds the tenant, and the source copies stay available for the retention (MIG-572).","evaluate":{"method":"scenario"},"ref":"MIG-588","area":"02-tenancy","section":"Moving a tenant","boundary":"b-553","boundaryDetail":"`placement switch`","traces":["g-558","g-1","d-706"],"milestone":2,"inSection":"sec-migration-7","realisation":"checked"},
    {"id":"m-release-controller-no-tenant-data","kind":"structural","models":"rel-580","statement":"The release controller has no relationship of any kind, calls and instructions included, to a tenant database, a copy store or a file store.","evaluate":{"method":"no-relationship","from":"release-controller","to":["tenant-database","copy-store","file-store"],"transitive":false},"assumptions":["a-model-abstraction"]},
    {"id":"m-release-controller-tenant-data-only-via-lifecycle","kind":"structural","models":"rel-580","statement":"Every path from the release controller to a tenant database, a copy store or a file store passes through the control plane or the migration job. Instructions to the traffic switch are of the kind controls: they carry no request or tenant data, and the check follows the other kinds, calls included.","evaluate":{"method":"only-via","from":"release-controller","to":["tenant-database","copy-store","file-store"],"via":["control-plane","migration-job"],"kinds":["depends-on","calls","data-flow","publishes","subscribes","reads","writes"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-platform-audit-store-apart","kind":"structural","models":"rel-580","statement":"The platform audit store has no path of any kind to a tenant database, a copy store, a file store or the store contract.","evaluate":{"method":"no-relationship","from":"platform-audit-store","to":["tenant-database","copy-store","file-store","store-contract"],"transitive":true},"assumptions":["a-model-abstraction"]},
    {"id":"m-no-traffic-before-verification","kind":"temporal","models":"rel-566","statement":"A colour switch that is requested before the new colour is verified sends no public traffic to green.","evaluate":{"method":"never","scenarios":["switch-before-verification","switch-before-delayed-verification","switch-instruction-lost"],"occurs":{"event":"cs-traffic-green"},"negatives":[{"scenario":"switch-before-verification","faults":["defect-switch-unverified"]},{"scenario":"switch-before-delayed-verification","faults":["defect-switch-unverified"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction","a-stage-parity"],"faultBasis":"fault"},
    {"id":"m-green-takes-traffic-when-verified","kind":"temporal","models":"rel-566","statement":"A colour switch requested after the new colour is verified sends public traffic to green.","evaluate":{"method":"eventually","scenarios":["verified-switch"],"occurs":{"event":"cs-traffic-green"},"negatives":[{"scenario":"verified-switch","faults":["colour-switch-disabled"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction","a-stage-parity"],"faultBasis":"restatement"},
    {"id":"m-rollback-restores-blue","kind":"temporal","models":"rel-568","statement":"In the model, a switch back sends public traffic to blue; that it deploys nothing is not checked.","evaluate":{"method":"eventually","scenarios":["rollback-then-request"],"occurs":{"event":"cs-traffic-blue"},"negatives":[{"scenario":"rollback-then-request","faults":["colour-rollback-disabled"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction"],"faultBasis":"restatement"},
    {"id":"m-switch-back-withdrawn-silent","kind":"temporal","models":"rel-577","statement":"A request after a switch back is served by no withdrawn colour.","evaluate":{"method":"never","scenarios":["rollback-then-request","request-in-flight-at-switch-back"],"occurs":{"event":"cs-served-withdrawn"},"negatives":[{"scenario":"rollback-then-request","faults":["defect-serve-withdrawn"]},{"scenario":"request-in-flight-at-switch-back","faults":["defect-serve-withdrawn"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-production-gated","kind":"invariant","models":"rel-557","statement":"A production environment that receives a release has a passed gate for it.","evaluate":{"method":"state-invariant","scenarios":["release-promoted","release-promote-without-gate","gate-result-arrives-late"],"expr":"release-promotion-flow.live => release-promotion-flow.gated","negatives":[{"scenario":"release-promote-without-gate","faults":["defect-promote-ungated"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction","a-stage-parity"],"faultBasis":"fault"},
    {"id":"m-production-two-approvals","kind":"invariant","models":"rel-560","statement":"A production environment that receives a release holds at least two approvals for it.","evaluate":{"method":"state-invariant","scenarios":["release-promoted","release-promote-unapproved","release-approval-duplicated"],"expr":"release-promotion-flow.live => release-promotion-flow.approvals >= 2","negatives":[{"scenario":"release-promote-unapproved","faults":["defect-promote-unapproved"]},{"scenario":"release-approval-duplicated","faults":["defect-promote-unapproved"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-production-promotion-possible","kind":"temporal","models":"rel-557","statement":"A gated release with two approvals reaches production.","evaluate":{"method":"eventually","scenarios":["release-promoted"],"occurs":{"event":"rp-production-received"},"negatives":[{"scenario":"release-promoted","faults":["promotion-disabled"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction"],"faultBasis":"restatement"},
    {"id":"m-migration-converts-once","kind":"invariant","models":"mig-554","statement":"A migration run that stops and resumes converts no record more than once, given that each batch commits together with its cursor.","evaluate":{"method":"state-invariant","scenarios":["migration-interrupted-resumed"],"expr":"migration-batch-flow.converted <= 3","negatives":[{"scenario":"migration-interrupted-resumed","faults":["defect-migration-restarts"]},{"scenario":"migration-interrupted-resumed","faults":["migration-crash-before-cursor"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction","a-database-commit"],"faultBasis":"fault"},
    {"id":"m-migration-finishes","kind":"temporal","models":"mig-554","statement":"A migration run that stops and resumes reaches its end.","evaluate":{"method":"eventually","scenarios":["migration-interrupted-resumed"],"occurs":{"event":"mg-done"},"negatives":[{"scenario":"migration-interrupted-resumed","faults":["migration-batches-disabled"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction","a-database-commit"],"faultBasis":"restatement"},
    {"id":"m-writes-refused-while-frozen","kind":"temporal","models":"mig-568","statement":"In the model, a write to a moving tenant during its read-only window is refused; the 60-second bound of MIG-568 is not modelled.","evaluate":{"method":"never","scenarios":["move-write-during-freeze","move-write-in-flight"],"occurs":{"event":"tm-write-accepted"},"negatives":[{"scenario":"move-write-during-freeze","faults":["defect-write-during-freeze"]},{"scenario":"move-write-in-flight","faults":["defect-write-during-freeze"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction","a-database-commit"],"faultBasis":"fault"},
    {"id":"m-directory-switch-after-hash","kind":"temporal","models":"mig-570","statement":"The directory switches a moving tenant only after the target hash has been checked.","evaluate":{"method":"precedes","scenarios":["move-completes","move-switch-requested-early","move-with-concurrent-write","move-switch-request-premature"],"first":{"event":"tm-hash-checked"},"then":{"event":"tm-directory-switched"},"negatives":[{"scenario":"move-switch-requested-early","faults":["defect-move-switch-unverified"]},{"scenario":"move-switch-request-premature","faults":["defect-move-switch-unverified"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction","a-database-commit"],"faultBasis":"fault"},
    {"id":"m-move-completes","kind":"temporal","models":"mig-570","statement":"A move whose hash matches reaches its target placement.","evaluate":{"method":"eventually","scenarios":["move-completes"],"occurs":{"event":"tm-directory-switched"},"negatives":[{"scenario":"move-completes","faults":["move-switch-disabled"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction","a-database-commit"],"faultBasis":"restatement"},
    {"id":"m-failed-move-keeps-source","kind":"temporal","models":"mig-571","statement":"A move whose copy fails leaves the directory on the source placement.","evaluate":{"method":"never","scenarios":["move-copy-fails"],"occurs":{"event":"tm-directory-switched"},"negatives":[{"scenario":"move-copy-fails","faults":["defect-switch-on-failure"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction","a-database-commit"],"faultBasis":"fault"},
    {"kind":"requirement","lifecycle":"active","ref":"CNV-700","area":"09-conversation","section":"Consistency review additions","id":"cnv-700","statement":"A browser SHALL reach the conversation service only through the gateway.","rationale":"The conversation service has no address of its own that a browser can reach (D-205).","evaluate":{"method":"property"},"boundary":"b-200","boundaryDetail":"`conversation service`","traces":["d-205","k-6"],"milestone":9,"inSection":"sec-conversation-700","realisation":"construction"},
    {"kind":"requirement","lifecycle":"active","ref":"CNV-701","area":"09-conversation","section":"Consistency review additions","id":"cnv-701","statement":"A preview SHALL stop being valid when the revision of the tenant changes, or 15 minutes after it was shown, whichever comes first.","rationale":"A preview is what the person confirmed, so it does not outlive the state it was computed against (D-516).","evaluate":{"method":"budget"},"boundary":"b-200","boundaryDetail":"`POST /pending-actions/{id}/confirm`","traces":["d-516","g-201"],"milestone":9,"inSection":"sec-conversation-700","realisation":"operational"},
    {"kind":"requirement","lifecycle":"active","ref":"GWY-700","area":"01-core","section":"Consistency review additions","id":"gwy-700","statement":"A browser SHALL reach no platform component except the gateway and the content delivery network.","rationale":"Every other path would bypass the gateway that carries the session and the tenant from the host name (K-6).","evaluate":{"method":"property"},"boundary":"b-9","boundaryDetail":"`browser request`","traces":["k-6","g-20"],"milestone":2,"inSection":"sec-runtime-700","realisation":"construction"},
    {"kind":"requirement","lifecycle":"active","ref":"IDN-700","area":"03-identity","section":"Consistency review additions","id":"idn-700","statement":"A realm policy that turns password sign-in off SHALL be refused while an owner of the tenant has no other sign-in method and no recovery path.","rationale":"Passwords can be turned off, but never in a way that strands an owner (D-525).","evaluate":{"method":"scenario"},"boundary":"b-4","boundaryDetail":"`realm policy`","traces":["g-6","d-525"],"milestone":3,"inSection":"sec-identity-700","realisation":"checked"},
    {"kind":"requirement","lifecycle":"active","ref":"IDN-701","area":"03-identity","section":"Consistency review additions","id":"idn-701","statement":"Audit entries SHALL be kept for the retention period of the tenant policy, which is the platform default when the tenant sets none (D-539).","rationale":"The audit record outlives the change it describes, for the period the tenant can lengthen.","evaluate":{"method":"scenario"},"boundary":"b-12","boundaryDetail":"`audit entry`","traces":["d-539","g-30"],"milestone":3,"inSection":"sec-identity-700","realisation":"checked"},
    {"kind":"requirement","lifecycle":"active","ref":"PRV-700","area":"09-privacy","section":"Consistency review additions","id":"prv-700","statement":"A backup image or tenant export SHALL be removed when its retention period has ended.","rationale":"Backups and exports expire on a schedule, so that a copy of a person's data is not kept beyond the retention the tenant chose (D-351).","evaluate":{"method":"scenario"},"boundary":"b-101","boundaryDetail":"`backup image`","traces":["d-351","g-22","d-706"],"milestone":2,"inSection":"sec-privacy-700","realisation":"checked"},
    {"kind":"requirement","lifecycle":"active","ref":"ARC-700","area":"09-architecture","section":"Consistency review additions","id":"arc-700","statement":"A workflow step SHALL run as a job under the lease and retry rules that apply to every scheduled job.","rationale":"One lease path and one retry path serve schedules and workflows (D-526).","evaluate":{"method":"scenario"},"boundary":"b-8","boundaryDetail":"`workflow step`","traces":["d-526","g-14"],"milestone":5,"inSection":"sec-arch-700","realisation":"checked"},
    {"kind":"requirement","lifecycle":"active","ref":"ARC-701","area":"09-architecture","section":"Consistency review additions","id":"arc-701","statement":"The calls between the components of the platform SHALL form no cycle.","rationale":"A cycle of calls has no order in which its members can start, be released or fail apart (D-710). Checked structurally by Exegra on the component model.","evaluate":{"method":"property"},"boundary":"b-3","boundaryDetail":"`component model`","traces":["d-710","g-101"],"milestone":2,"inSection":"sec-arch-700","realisation":"construction"},
    {"kind":"requirement","lifecycle":"active","ref":"AGS-700","area":"06-agents","section":"Consistency review additions","id":"ags-700","statement":"A tenant policy SHALL NOT loosen an agent limit below the floor that the platform sets.","rationale":"Limits have platform defaults and floors, and a tenant can tighten them without limit (D-531).","evaluate":{"method":"property"},"boundary":"b-11","boundaryDetail":"`agent limit`","traces":["d-531","g-28"],"milestone":8,"inSection":"sec-ags-700","realisation":"checked"},
    {"kind":"requirement","lifecycle":"active","ref":"UXA-700","area":"09-conversation","section":"Consistency review additions","id":"uxa-700","statement":"The browser code of the platform SHALL use no client framework.","rationale":"Browser code stays framework-free JavaScript run by a kernel in a worker (D-28).","evaluate":{"method":"example"},"boundary":"b-13","boundaryDetail":"`browser code`","traces":["d-28","g-5"],"milestone":3,"inSection":"sec-authoring-700","realisation":"checked"},
    {"id":"m-public-no-direct-storage","kind":"structural","models":"arc-112","statement":"No component in the public zone has a data relationship to (telemetry observation excepted, OBS-003) a storage component.","evaluate":{"method":"no-relationship","from":{"trustZone":"public"},"to":{"category":"storage"},"transitive":false,"kinds":["depends-on","calls","data-flow","publishes","subscribes","reads","writes"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-public-no-direct-data","kind":"structural","models":"arc-112","statement":"No component in the public zone has a data relationship to (telemetry observation excepted, OBS-003) a component of the data zone.","evaluate":{"method":"no-relationship","from":{"trustZone":"public"},"to":{"trustZone":"data"},"transitive":false,"kinds":["depends-on","calls","data-flow","publishes","subscribes","reads","writes"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-model-provider-only-via-conversation","kind":"structural","models":"cnv-235","statement":"Every path from a component other than the conversation service and the local model adapter to the model provider passes through the conversation service.","evaluate":{"method":"only-via","from":["kernel","substrate","store-contract","sqlite-adapter","postgres-adapter","tenant-database","control-plane","control-database","identity-service","runtime","gateway","automation-worker","connector-runner","copy-store","file-store","delivery-network","delivery-network-control","agent-gateway","telemetry-pipeline","audit-log","key-service","mail-service","external-identity-provider","web-application","simulator","verification","agent","limit-store","backup-archive","fleet-reporting","product-module","external-endpoint","notice-queue","search-index","notification-service","operator-console","outbound-gate","upload-scanner","mail-dispatcher","release-controller","release-pipeline","image-registry","traffic-switch","subject-rights-service","agent-traffic-switch","migration-job","platform-audit-store"],"to":"model-provider","via":"conversation-service","kinds":["depends-on","calls","data-flow","publishes","subscribes","reads","writes"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-external-only-via-outbound-gate","kind":"structural","models":"wfl-250","statement":"Every path from a component to an external endpoint passes through the outbound gate.","evaluate":{"method":"only-via","from":["kernel","substrate","store-contract","sqlite-adapter","postgres-adapter","tenant-database","control-plane","control-database","identity-service","runtime","gateway","automation-worker","connector-runner","copy-store","file-store","delivery-network","delivery-network-control","agent-gateway","telemetry-pipeline","audit-log","key-service","mail-service","external-identity-provider","web-application","simulator","verification","agent","limit-store","backup-archive","fleet-reporting","product-module","notice-queue","search-index","notification-service","conversation-service","model-provider","local-model-adapter","operator-console","upload-scanner","mail-dispatcher","release-controller","release-pipeline","image-registry","traffic-switch","subject-rights-service","agent-traffic-switch","migration-job","platform-audit-store"],"to":"external-endpoint","via":"outbound-gate"},"assumptions":["a-model-abstraction"]},
    {"id":"m-copy-store-private","kind":"structural","models":"cpy-011","statement":"Only the runtime, the gateway and the subject rights service have a data relationship to (telemetry observation excepted, OBS-003) the copy store.","evaluate":{"method":"no-relationship","from":["kernel","substrate","store-contract","sqlite-adapter","postgres-adapter","tenant-database","control-plane","control-database","identity-service","automation-worker","connector-runner","file-store","delivery-network","delivery-network-control","agent-gateway","telemetry-pipeline","audit-log","key-service","mail-service","external-identity-provider","web-application","simulator","verification","agent","limit-store","backup-archive","fleet-reporting","product-module","external-endpoint","notice-queue","search-index","notification-service","conversation-service","model-provider","local-model-adapter","operator-console","outbound-gate","upload-scanner","mail-dispatcher","release-controller","release-pipeline","image-registry","traffic-switch","agent-traffic-switch","migration-job","platform-audit-store"],"to":"copy-store","transitive":false,"kinds":["depends-on","calls","data-flow","publishes","subscribes","reads","writes"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-file-store-private","kind":"structural","models":"cms-008","statement":"Only the runtime, the upload scanner, the gateway, the subject rights service and the PostgreSQL adapter have a data relationship to (telemetry observation excepted, OBS-003) the file store.","evaluate":{"method":"no-relationship","from":["kernel","substrate","store-contract","sqlite-adapter","tenant-database","control-plane","control-database","identity-service","automation-worker","connector-runner","copy-store","delivery-network","delivery-network-control","agent-gateway","telemetry-pipeline","audit-log","key-service","mail-service","external-identity-provider","web-application","simulator","verification","agent","limit-store","backup-archive","fleet-reporting","product-module","external-endpoint","notice-queue","search-index","notification-service","conversation-service","model-provider","local-model-adapter","operator-console","outbound-gate","mail-dispatcher","release-controller","release-pipeline","image-registry","traffic-switch","agent-traffic-switch","migration-job","platform-audit-store"],"to":"file-store","transitive":false,"kinds":["depends-on","calls","data-flow","publishes","subscribes","reads","writes"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-search-index-private","kind":"structural","models":"srh-150","statement":"Only the gateway, the runtime, the agent gateway and the subject rights service have a data relationship to (telemetry observation excepted, OBS-003) the search index.","evaluate":{"method":"no-relationship","from":["kernel","substrate","store-contract","sqlite-adapter","postgres-adapter","tenant-database","control-plane","control-database","identity-service","automation-worker","connector-runner","copy-store","file-store","delivery-network","delivery-network-control","telemetry-pipeline","audit-log","key-service","mail-service","external-identity-provider","web-application","simulator","verification","agent","limit-store","backup-archive","fleet-reporting","product-module","external-endpoint","notice-queue","notification-service","conversation-service","model-provider","local-model-adapter","operator-console","outbound-gate","upload-scanner","mail-dispatcher","release-controller","release-pipeline","image-registry","traffic-switch","agent-traffic-switch","migration-job","platform-audit-store"],"to":"search-index","transitive":false,"kinds":["depends-on","calls","data-flow","publishes","subscribes","reads","writes"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-limit-store-private","kind":"structural","models":"arc-109","statement":"Only the gateway, the agent gateway and the identity service have a data relationship to (telemetry observation excepted, OBS-003) the limit store.","evaluate":{"method":"no-relationship","from":["kernel","substrate","store-contract","sqlite-adapter","postgres-adapter","tenant-database","control-plane","control-database","runtime","automation-worker","connector-runner","copy-store","file-store","delivery-network","delivery-network-control","telemetry-pipeline","audit-log","key-service","mail-service","external-identity-provider","web-application","simulator","verification","agent","backup-archive","fleet-reporting","product-module","external-endpoint","notice-queue","search-index","notification-service","conversation-service","model-provider","local-model-adapter","operator-console","outbound-gate","upload-scanner","mail-dispatcher","release-controller","release-pipeline","image-registry","traffic-switch","subject-rights-service","agent-traffic-switch","migration-job","platform-audit-store"],"to":"limit-store","transitive":false,"kinds":["depends-on","calls","data-flow","publishes","subscribes","reads","writes"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-parties-by-identifier","kind":"structural","models":"agt-015","statement":"Every record that names a party to an act names it by principal identifier.","evaluate":{"method":"data-model","rules":["party-by-id"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-mail-keys-distinguished","kind":"temporal","models":"eml-006","faultBasis":"fault","statement":"Messages with two different idempotency keys are each delivered once: the second key is not taken for the first.","evaluate":{"method":"eventually","scenarios":["mail-two-keys"],"expr":"mail-adapter-flow.delivered == 2","negatives":[{"scenario":"mail-two-keys","faults":["defect-keys-treated-alike"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-move-target-holds-every-write","kind":"invariant","models":"mig-570","faultBasis":"fault","statement":"The directory switches a moving tenant only when the target holds every write the source accepted, including the writes accepted while the copy ran. The comparison is computed from the writes each side holds.","evaluate":{"method":"state-invariant","scenarios":["move-completes","move-with-concurrent-write","move-write-in-flight","move-concurrent-write-early-switch"],"expr":"!tenant-move-flow.switched || tenant-move-flow.targetVersion == tenant-move-flow.sourceVersion","negatives":[{"scenario":"move-concurrent-write-early-switch","faults":["reconcile-disabled","defect-move-switch-unverified"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction","a-database-commit"]},
    {"id":"m-move-with-writes-completes","kind":"temporal","models":"mig-570","faultBasis":"fault","statement":"A move during which a writer wrote reaches its target placement only because the source is frozen and the missed writes are applied: without the final synchronisation, or without the freeze, the hashes differ or are never compared, and the directory does not switch.","evaluate":{"method":"eventually","scenarios":["move-with-concurrent-write","move-write-in-flight"],"occurs":{"event":"tm-directory-switched"},"negatives":[{"scenario":"move-with-concurrent-write","faults":["reconcile-disabled"]},{"scenario":"move-with-concurrent-write","faults":["freeze-disabled"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction","a-database-commit"]},
    {"id":"m-source-throttled-across-accounts","kind":"invariant","models":"idn-250","faultBasis":"fault","statement":"Once the failures from one source reach the threshold, no attempt from that source is evaluated, whichever account it names. The threshold of 3 stands for the 100 failures of D-700 and the window is not modelled.","evaluate":{"method":"state-invariant","scenarios":["password-spray-one-source"],"expr":"source-throttle-flow.evaluatedWhileThrottled == 0","negatives":[{"scenario":"password-spray-one-source","faults":["defect-source-throttle-ignored"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-throttle-isolates-sources","kind":"temporal","models":"idn-250","faultBasis":"restatement","statement":"A source that has not reached the threshold is still answered while another source is throttled.","evaluate":{"method":"eventually","scenarios":["password-spray-one-source"],"occurs":{"event":"src-accepted"},"negatives":[{"scenario":"password-spray-one-source","faults":["source-acceptance-disabled"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]}
  ],

  // ---- Glossary ----------------------------------------------------------------------------------
  "terms": [
    {"id":"term-tenant","term":"Tenant","definition":"an organisation's isolated installation: one database, one file namespace, one identity realm, one key."},
    {"id":"term-tenant-database","term":"Tenant database","definition":"the PostgreSQL database that holds everything a tenant owns: schema, records, events, journal, jobs, identity realm and audit log."},
    {"id":"term-control-plane","term":"Control plane","definition":"the component that owns the tenant directory and carries out tenant lifecycle operations."},
    {"id":"term-tenant-directory","term":"Tenant directory","definition":"the control plane's list of tenants with their state, placement and domain bindings."},
    {"id":"term-placement","term":"Placement","definition":"where a tenant's database and files are: cluster, region and database name."},
    {"id":"term-realm","term":"Realm","definition":"The set of principals, credentials and identity provider configurations of one tenant, or of the platform's operators."},
    {"id":"term-principal","term":"Principal","definition":"an identity that can act: a person, a service account or an agent."},
    {"id":"term-sign-in-session","term":"Sign-in session","definition":"the record that says a browser has authenticated as a principal, identified by a secret the browser holds."},
    {"id":"term-assertion","term":"Assertion","definition":"a short-lived statement signed by the identity service saying which principal and session a request belongs to."},
    {"id":"term-access-token","term":"Access token","definition":"a signed, expiring statement of scopes issued to a service account or an agent."},
    {"id":"term-delegation","term":"Delegation","definition":"an agent acting for a person, with a token that names both and grants no more than the person holds."},
    {"id":"term-emailed-link","term":"Emailed link","definition":"a single-use sign-in link sent to an address."},
    {"id":"term-step-up","term":"Step-up","definition":"a fresh authentication asked for before a sensitive operation."},
    {"id":"term-job","term":"Job","definition":"one unit of scheduled work with a due time, a state and a recorded outcome."},
    {"id":"term-schedule","term":"Schedule","definition":"a rule that creates jobs: once at a time, or repeatedly."},
    {"id":"term-trigger","term":"Trigger","definition":"a subscription that creates a job when a matching domain event commits."},
    {"id":"term-lease","term":"Lease","definition":"a worker's time-limited claim on a job."},
    {"id":"term-fencing-token","term":"Fencing token","definition":"a number that rises with every lease on a job and is checked when a result is recorded."},
    {"id":"term-idempotency-key","term":"Idempotency key","definition":"a value that lets the receiver of an effect recognise a repeat."},
    {"id":"term-wake-index","term":"Wake index","definition":"the control plane's list of tenants with their next due time."},
    {"id":"term-workflow","term":"Workflow","definition":"a state machine held as tenant metadata whose steps the kernel decides."},
    {"id":"term-connector","term":"Connector","definition":"an adapter that carries out one kind of external effect, such as an HTTP call or a mail."},
    {"id":"term-stored-copy","term":"Stored copy","definition":"A copy of tenant data kept outside the record that owns it, for reads, for backup, for transfer or for a grant: a view copy, an edge copy, a backup image, an export, a move replica or a support view. Each copy declares its owner, key, freshness bound and erasure point."},
    {"id":"term-shared-copy","term":"Shared copy","definition":"a stored copy served as stored to more than one reader."},
    {"id":"term-audience-class","term":"Audience class","definition":"the set of principals that a tenant's policies cannot tell apart for a given read."},
    {"id":"term-freshness-bound","term":"Freshness bound","definition":"the longest time a stored copy may differ from its source."},
    {"id":"term-erasure-point","term":"Erasure point","definition":"the moment by which a deletion has reached a stored copy."},
    {"id":"term-surrogate-key","term":"Surrogate key","definition":"a label on an edge copy by which it can be purged."},
    {"id":"term-edge-copy","term":"Edge copy","definition":"a stored copy held by the content delivery network."},
    {"id":"term-operation","term":"Operation","definition":"a named capability with an input schema, listed in the operation catalogue."},
    {"id":"term-operation-catalogue","term":"Operation catalogue","definition":"the machine-readable list of every operation, generated from platform code and tenant metadata."},
    {"id":"term-proposal","term":"Proposal","definition":"a change submitted for approval together with its projection."},
    {"id":"term-projection","term":"Projection","definition":"the result of replaying recorded or generated activity with and without a proposed change, and comparing."},
    {"id":"term-audit-log","term":"Audit log","definition":"the append-only, hash-chained record of security-relevant actions."},
    {"id":"term-correlation-identifier","term":"Correlation identifier","definition":"the value that ties together every record of one request."},
    {"id":"term-seam","term":"Seam","definition":"a boundary to infrastructure expressed as a contract with a conformance suite and adapters."},
    {"id":"term-adapter","term":"Adapter","definition":"an implementation of a seam for one piece of infrastructure."},
    {"id":"term-sandbox-tenant","term":"Sandbox tenant","definition":"a tenant started from a template by a new organisation, which its owner keeps or lets expire."},
    {"id":"term-staging-tenant","term":"Staging tenant","definition":"a tenant where configuration is prepared before it is promoted to its production tenant. This is a tenant, and it is not the stage environment, which is a platform environment."},
    {"id":"term-environment","term":"Environment","definition":"A platform environment: the local stack, the stage environment or the production environment, each built from the same definitions. A tenant's kind (production, staging or sandbox) is not an environment."},
    {"id":"term-draft","term":"Draft","definition":"a version of a record that is not yet published and that readers do not see."},
    {"id":"term-preview-link","term":"Preview link","definition":"an expiring address that shows one draft version of one record to a reader without an account."},
    {"id":"term-delivery-key","term":"Delivery key","definition":"a service account whose only permission is to read the published content of one site for one audience class."},
    {"id":"term-support-grant","term":"Support grant","definition":"A time-limited permission that a tenant owner issues to a platform operator for work in the tenant. It is called an access grant in the data model, and a break-glass grant is a support grant issued in an emergency, with the same fields."},
    {"id":"term-notice","term":"Notice","definition":"a message about an event, sent by email or placed in an inbox, to a person who subscribed to it."},
    {"id":"term-inbox","term":"Inbox","definition":"the list of tasks and notices shown to one person in the platform."},
    {"id":"term-plan","term":"Plan","definition":"the set of quotas, trial terms and objectives that apply to a tenant."},
    {"id":"term-quota","term":"Quota","definition":"a limit on one metered quantity of a tenant, stated by its plan."},
    {"id":"term-webhook","term":"Webhook","definition":"an HTTP delivery of an event to an address, signed with a shared secret."},
    {"id":"term-redirect","term":"Redirect","definition":"a stored answer that sends a request for a former address to the current address of a page."},
    {"id":"term-submission","term":"Submission","definition":"the data a reader sends through a form on a site, stored as a record of the tenant."},
    {"id":"term-search-index","term":"Search index","definition":"the entries of one tenant from which its search queries are answered."},
    {"id":"term-archive","term":"Archive","definition":"a document with a manifest that holds the records, files or configuration of a tenant for export."},
    {"id":"term-assistant","term":"Assistant","definition":"a program that proposes changes and answers questions in a conversation, acting for one person with that person's delegated token."},
    {"id":"term-conversation","term":"Conversation","definition":"an ordered set of turns between one person and the assistant, kept as tenant data."},
    {"id":"term-turn","term":"Turn","definition":"one message of a conversation, from the person or from the assistant, with the replies and operations it produced."},
    {"id":"term-preview","term":"Preview","definition":"the projection of a proposed change, shown before the change is applied."},
    {"id":"term-confirmation","term":"Confirmation","definition":"the person's explicit answer to a preview, bound to that preview."},
    {"id":"term-pending-action","term":"Pending action","definition":"a proposed change waiting for a preview, a confirmation or an approval."},
    {"id":"term-model-provider","term":"Model provider","definition":"the service that generates a reply from messages and operation descriptions, reached through the model provider contract."},
    {"id":"term-content-token","term":"Content token","definition":"a name that a tenant defines, with an expression that gives its value when content or an email is rendered for a reader. Not an access token."},
    {"id":"term-mail-dispatcher","term":"Mail dispatcher","definition":"the component that renders each message and hands it to the mail provider through the mail contract."},
    {"id":"term-suppression-list","term":"Suppression list","definition":"the addresses of a tenant that bounced for good, complained or unsubscribed, to which no further mail is sent."},
    {"id":"term-sender-domain","term":"Sender domain","definition":"a domain that a tenant has proved control of and sends mail from."},
    {"id":"term-trust-level","term":"Trust level","definition":"the mark on data handed to an agent that says who wrote it: the platform, a principal of the tenant, or a source outside the tenant."},
    {"id":"term-blue","term":"Blue","definition":"One of the two colours of a component in production. Blue and green alternate: each release deploys into the colour that is not live, and a colour switch makes it live."},
    {"id":"term-green","term":"Green","definition":"The other colour of a component in production. A release deploys into green while blue is live, and into blue while green is live."},
    {"id":"term-colour-switch","term":"Colour switch","definition":"The change of the colour that takes public traffic, made at the traffic switch by the release controller, and its reverse, the switch back."},
    {"id":"term-stage-environment","term":"Stage environment","definition":"The platform's pre-production environment, made from the same definitions as production with its own accounts, where each release is verified before it is promoted. It holds synthetic or scrubbed tenants and no personal data of a production tenant. It is not a staging tenant (ADM-157)."},
    {"id":"term-production-environment","term":"Production environment","definition":"The platform's live environment, made from the same definitions as the stage environment and changed only through release records and audited operations. It holds the production tenants and is not one of them."},
    {"id":"term-migration-run","term":"Migration run","definition":"A sequence of kernel decisions that carries one tenant's records from one schema version to another, applied in one transition or in batches, with a cursor and a record of each batch."},
    {"id":"term-kernel","term":"Kernel","definition":"the pure decision functions of the platform: they decide an intent, answer a read and plan the state a decision needs, with no input, output, clock or randomness of their own."},
    {"id":"term-effect","term":"Effect","definition":"an external action that a decision describes as data, such as a call, a mail or a purge, carried out by an adapter after the transaction that decided it commits."},
    {"id":"term-grant","term":"Grant","definition":"a record that gives a principal a permission for a stated purpose, with an expiry and a revocation. A support grant, a delegation and a grant of roles are grants, and a token issued from a grant carries no more than the grant does."},
    {"id":"term-erasure","term":"Erasure","definition":"the removal of one person's personal data from every record and copy that holds it, by deletion or by destroying the subject key that seals it."},
    {"id":"term-retention","term":"Retention","definition":"the period for which a record or copy is kept, set per record type by the tenant policy within the platform's bounds, after which it is removed."},
    {"id":"term-legal-hold","term":"Legal hold","definition":"a tenant's instruction to keep the records it names, which suspends their erasure and expiry until it is lifted."},
    {"id":"term-subject-key","term":"Subject key","definition":"the key under which one person's personal fields are sealed. Destroying it makes those fields unreadable in every copy and backup."},
    {"id":"term-personal-data","term":"Personal data","definition":"a value that identifies a person, or that identifies one together with other values, held in a field that the data model marks as personal."},
    {"id":"term-layout","term":"Layout","definition":"the stored structure of a tenant database or of the control database, its tables, indexes and encodings, which changes from one version to the next."},
    {"id":"term-outbox","term":"Outbox","definition":"the events that a commit leaves for publication, published in commit order by one job per tenant."},
    {"id":"term-intent","term":"Intent","definition":"a request to change a tenant, which the kernel decides. An intent that may be repeated carries an idempotency key."},
    {"id":"term-revision","term":"Revision","definition":"the count of accepted transitions of a tenant. Each accepted transition advances it by one."},
    {"id":"term-journal","term":"Journal","definition":"the ordered record of a tenant's accepted transitions, from which its state is replayed and checked against its state hash."},
    {"id":"term-state-hash","term":"State hash","definition":"the canonical hash of a tenant's state, which a restore, a move, an export and a replay must reproduce."},
    {"id":"term-budget","term":"Budget","definition":"a stated limit on a measured quantity, verified by a recorded measurement that its row in the budget measurement table describes."},
    {"id":"term-halt","term":"Halt","definition":"the stopping of an agent: its requests are refused until a principal other than the agent resumes it. The kill switch is an operator's halt of an agent."},
    {"id":"term-tenant-metadata","term":"Tenant metadata","definition":"the definitions a tenant holds as data, such as its schema, views, workflows, templates, tokens and flags. They are stored under a schema version and changed through audited kernel intents."},
    {"id":"term-template","term":"Template","definition":"a platform-authored bundle of tenant metadata that a tenant installs after reviewing its projection."},
    {"id":"term-request-token","term":"Request token","definition":"the token that the gateway issues to a browser and requires on each state-changing request, against requests forged from another site."},
    {"id":"term-submission-token","term":"Submission token","definition":"the token that a form issues to the browser that loads it, and that the form requires on each submission."},
    {"id":"term-theme-token","term":"Theme token","definition":"a named value of a site's theme, such as a colour or a size, which a tenant selects from the token schema without supplying style."},
    {"id":"term-canary","term":"Canary","definition":"a small share of public requests sent to a new colour for a stated period before the full share (REL-565)."},
    {"id":"term-token","term":"Token","definition":"the bare word names none of the tokens in this glossary. Say access token, content token, fencing token (the lease token of a job), request token, submission token, or theme token."},
    {"id":"term-release-record","term":"Release record","definition":"The data that states what one release deployed: its commit, the digests of its images, the results of its gates, its approvals, its rollback class and the colour it made live."},
    {"id":"term-tick","term":"Tick","definition":"the unit of logical time in a behaviour model. One tick stands for one minute for the bounds that a requirement or decision states in minutes (a-tick); a gap of a few ticks between messages is an order, not a duration."}
  ],

