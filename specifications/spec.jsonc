    {
      "id": "apply-delta",
      "description": "transition.rs apply_delta, the pure body of contract apply-state-delta (CT-006): apply an accepted delta to the tenant state it was computed against. No tenant and no base revision starts from the CreateTenant op (none is InvalidIntent \"delta creates no tenant\"); a tenant at the base revision with the delta's id starts from itself; anything else is VersionConflict \"delta is based on <base:?>, state is at <revision:?>\". Then the ops in order (an empty membership removes the member; deleting a type's last record removes the type's map) and the delta's revision, next record and event sequence. These errors carry no evidence.",
      "params": [
        {
          "name": "tenant",
          "type": "option<tenant-state>"
        },
        {
          "name": "delta",
          "type": "state-delta"
        }
      ],
      "returns": "tenant-state",
      "errors": "rejection",
      "let": [
        {
          "name": "conflict",
          "expr": "rejection.rejected(domain-error{kind: error-kind.version-conflict, message: format('delta is based on {}, state is at {}', call revision-debug(delta.base-revision), call revision-debug(match tenant { Some(t) => t.revision, None => null })), evidence: []})"
        },
        {
          "name": "start",
          "expr": "match tenant { None => match delta.base-revision { None => match find(op in delta.ops, match op { create-tenant => true, _ => false }) { Some(op) => match op { create-tenant{name} => tenant-state{id: delta.tenant, name, revision: 0, next-record: 1, event-seq: 0, schema: call genesis-schema(), members: {}, records: {}}, _ => fail(conflict) }, None => fail(rejection.rejected(domain-error{kind: error-kind.invalid-intent, message: 'delta creates no tenant', evidence: []})) }, Some(_) => fail(conflict) }, Some(t) => match delta.base-revision { Some(b) => if t.revision == b && t.id == delta.tenant then t else fail(conflict), None => fail(conflict) } }"
        },
        {
          "name": "next",
          "expr": "fold(op in delta.ops, s = start, match op { create-tenant => s, put-schema(sc) => tenant-state{id: s.id, name: s.name, revision: s.revision, next-record: s.next-record, event-seq: s.event-seq, schema: sc, members: s.members, records: s.records}, put-member{principal: p, roles} => tenant-state{id: s.id, name: s.name, revision: s.revision, next-record: s.next-record, event-seq: s.event-seq, schema: s.schema, members: if roles == [] then remove(s.members, p) else insert(s.members, p, roles), records: s.records}, put-record(r) => tenant-state{id: s.id, name: s.name, revision: s.revision, next-record: s.next-record, event-seq: s.event-seq, schema: s.schema, members: s.members, records: insert(s.records, r.object, insert(match get(s.records, r.object) { Some(m) => m, None => {} }, r.id, r))}, delete-record{object, id} => match get(s.records, object) { None => s, Some(m) => let left = remove(m, id) in tenant-state{id: s.id, name: s.name, revision: s.revision, next-record: s.next-record, event-seq: s.event-seq, schema: s.schema, members: s.members, records: if keys(left) == [] then remove(s.records, object) else insert(s.records, object, left)} } })"
        }
      ],
      "body": "tenant-state{id: next.id, name: next.name, revision: delta.new-revision, next-record: delta.next-record, event-seq: delta.event-seq, schema: next.schema, members: next.members, records: next.records}",
      "examples": [
        {
          "description": "testkit.rs add_notes_tenant: the CreateTenant delta.",
          "args": {
            "tenant": null,
            "delta": {
              "tenant": "gamma",
              "base-revision": null,
              "new-revision": 1,
              "next-record": 1,
              "event-seq": 1,
              "ops": [
                {
                  "create-tenant": {
                    "name": "Gamma"
                  }
                },
                {
                  "put-schema": {
                    "version": 1,
                    "objects": {},
                    "roles": {
                      "owner": {
                        "id": "owner",
                        "label": "Owner"
                      },
                      "public": {
                        "id": "public",
                        "label": "Everyone"
                      }
                    },
                    "policies": {},
                    "workflows": {},
                    "queries": {},
                    "views": {}
                  }
                },
                {
                  "put-member": {
                    "principal": "gamma:owner",
                    "roles": [
                      "owner"
                    ]
                  }
                }
              ]
            }
          },
          "result": {
            "id": "gamma",
            "name": "Gamma",
            "revision": 1,
            "next-record": 1,
            "event-seq": 1,
            "schema": {
              "version": 1,
              "objects": {},
              "roles": {
                "owner": {
                  "id": "owner",
                  "label": "Owner"
                },
                "public": {
                  "id": "public",
                  "label": "Everyone"
                }
              },
              "policies": {},
              "workflows": {},
              "queries": {},
              "views": {}
            },
            "members": {
              "gamma:owner": [
                "owner"
              ]
            },
            "records": {}
          }
        },
