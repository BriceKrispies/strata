    {
      "id": "null-value",
      "description": "Value::Null. The null variant of value is named null, a keyword of the body language, so a body cannot write value.null; it is read as an absent parameter, which the language evaluates to null.",
      "params": [],
      "returns": "value",
      "body": "match eval(tenant-rule-language, expr.param('absent'), expr-env{record: null, old: null, new: null, param: {}, now: value.time(0), principal: value.str(''), has_role: []}) { Ok(x) => x, Err(e) => value.int(0) }",
      "examples": [
        {
          "args": {},
          "result": "null"
        }
      ]
    },
    {
      "id": "deny",
      "description": "A failed check of a policy whose condition did not give true, added to the checks of the policy loop. The need found so far is kept.",
      "params": [
        {
          "name": "acc",
          "type": "policy-progress"
        },
        {
          "name": "rule",
          "type": "string"
        },
        {
          "name": "what",
          "type": "string"
        },
        {
          "name": "outcome",
          "type": "policy-outcome"
        },
        {
          "name": "condition",
          "type": "expr"
        }
      ],
      "returns": "policy-progress",
      "body": "policy-progress{granted: acc.granted, checks: concat(acc.checks, [policy-check{rule, passed: false, what, outcome, condition}]), needed: acc.needed}",
      "examples": [
        {
          "args": {
            "acc": {
              "checks": []
            },
            "rule": "policy:authors_own_posts",
            "what": "Update on Object(ObjectTypeId(\"post\"))",
            "outcome": "is-false",
            "condition": {
              "cmp": {
                "op": "eq",
                "left": {
                  "var": {
                    "scope": "record",
                    "field": "$created_by"
                  }
                },
                "right": "principal"
              }
            }
          },
          "result": {
            "checks": [
              {
                "rule": "policy:authors_own_posts",
                "passed": false,
                "what": "Update on Object(ObjectTypeId(\"post\"))",
                "outcome": "is-false",
                "condition": {
                  "cmp": {
                    "op": "eq",
                    "left": {
                      "var": {
                        "scope": "record",
                        "field": "$created_by"
                      }
                    },
                    "right": "principal"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "policy-step",
      "description": "One applicable policy in the loop of rules.rs authorize: no condition grants; a condition grants when it evaluates to Bool(true); Null fails the check as \"is null\", any other value as \"is false\", an evaluation error as failed. The condition follows a reference through lookup (rule-lookup); when it fails to evaluate and reach is given, the first record it needs that the snapshot does not cover (rule-missing) becomes needed, unless an earlier condition named one.",
      "params": [
        {
          "name": "policy",
          "type": "policy-def"
        },
        {
          "name": "env",
          "type": "expr-env"
        },
        {
          "name": "acc",
          "type": "policy-progress"
        },
        {
          "name": "what",
          "type": "string"
        },
        {
          "name": "lookup",
          "type": "map<string, map<string, map<string, value>>>"
        },
        {
          "name": "reach",
          "type": "option<rule-reach>"
        }
      ],
      "returns": "policy-progress",
      "let": [
        {
          "name": "rule",
          "expr": "format('policy:{}', policy.id)"
        }
      ],
      "body": "match policy.condition { None => policy-progress{granted: policy-check{rule, passed: true, what, outcome: policy-outcome.unconditional}, checks: acc.checks}, Some(c) => match eval(tenant-rule-language, c, env, lookup) { Ok(v) => match v { bool(b) => if b then policy-progress{granted: policy-check{rule, passed: true, what, outcome: policy-outcome.held, condition: c}, checks: acc.checks} else call deny(acc, rule, what, policy-outcome.is-false, c), int(_) => call deny(acc, rule, what, policy-outcome.is-false, c), str(_) => call deny(acc, rule, what, policy-outcome.is-false, c), time(_) => call deny(acc, rule, what, policy-outcome.is-false, c), ref(_) => call deny(acc, rule, what, policy-outcome.is-false, c), list(_) => call deny(acc, rule, what, policy-outcome.is-false, c), _ => call deny(acc, rule, what, policy-outcome.is-null, c) }, Err(_) => let d = call deny(acc, rule, what, policy-outcome.failed, c) in policy-progress{granted: d.granted, checks: d.checks, needed: if acc.needed != null then acc.needed else match reach { Some(r) => call rule-missing(c, r), None => null }} } }",
      "examples": [
        {
          "description": "A policy without a condition grants.",
          "args": {
            "policy": {
              "id": "editors_run_posts",
              "role": "editor",
              "resource": {
                "object": "post"
              },
              "actions": [
                "read",
                "create",
                "update",
                "delete"
              ]
            },
            "env": {
              "fixture": "fx-expr-env-1",
              "with": {
                "principal": {
                  "str": "user:ed"
                },
                "has_role": [
                  "editor",
                  "public"
                ]
              }
            },
            "acc": {
              "checks": []
            },
            "what": "Update on Object(ObjectTypeId(\"post\"))",
            "lookup": {}
          },
          "result": {
            "granted": {
              "rule": "policy:editors_run_posts",
              "passed": true,
              "what": "Update on Object(ObjectTypeId(\"post\"))",
              "outcome": "unconditional"
            },
            "checks": []
          }
        },
