          }
        }
      ]
    },
    {
      "id": "cleared-record",
      "description": "transition.rs delete_record: a record that refers to the deleted record in one or more fields, rewritten once with every one of those fields cleared (removed from a list, removed otherwise), the version one higher and updated now. hits are the referrer fields found for it, in referrer order.",
      "params": [
        {
          "name": "record",
          "type": "record"
        },
        {
          "name": "hits",
          "type": "list<referrer-hit>"
        },
        {
          "name": "target",
          "type": "value"
        },
        {
          "name": "now",
          "type": "timestamp"
        }
      ],
      "returns": "record",
      "body": "record{id: record.id, object: record.object, version: record.version + 1, created-by: record.created-by, created-at: record.created-at, updated-at: now, fields: fold(g in filter(g in hits, g.record.object == record.object && g.record.id == record.id), fs = record.fields, match get(fs, g.referrer.field.id) { Some(x) => match x { list(items) => insert(fs, g.referrer.field.id, value.list(filter(i in items, i != target))), _ => remove(fs, g.referrer.field.id) }, None => remove(fs, g.referrer.field.id) })}",
