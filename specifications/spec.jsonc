                            }
                          },
                          "required": false,
                          "unique": false
                        },
                        "body": {
                          "id": "body",
                          "label": "body",
                          "ty": "str",
                          "required": false,
                          "unique": false
                        },
                        "published_at": {
                          "id": "published_at",
                          "label": "published_at",
                          "ty": "time",
                          "required": false,
                          "unique": false
                        },
                        "rank": {
                          "id": "rank",
                          "label": "rank",
                          "ty": "int",
                          "required": false,
                          "unique": false
                        },
                        "slug": {
                          "id": "slug",
                          "label": "slug",
                          "ty": "str",
                          "required": true,
                          "unique": true
                        },
                        "status": {
                          "id": "status",
                          "label": "status",
                          "ty": "str",
                          "required": true,
                          "unique": false,
                          "default": {
                            "lit": {
                              "str": "draft"
                            }
                          }
                        },
                        "title": {
                          "id": "title",
                          "label": "title",
                          "ty": "str",
                          "required": true,
                          "unique": false
                        }
                      },
                      "constraints": {
                        "title_length": {
                          "id": "title_length",
                          "expr": {
                            "cmp": {
                              "op": "le",
                              "left": {
                                "len": {
                                  "var": {
                                    "scope": "new",
                                    "field": "title"
                                  }
                                }
                              },
                              "right": {
                                "lit": {
