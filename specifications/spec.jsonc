    {
      "id": "workflow-step",
      "description": "transition.rs update_record, one workflow of the object type: nothing when the update leaves its field as it was; otherwise the first transition from the old string state to the new one whose guard holds (no guard, or expr.rs holds: exactly Bool(true)) fires: its assignments are evaluated (in field id order) with record and old the stored record and new the candidate, then set (a null clears the field), and workflow:<id>:<transition> passes. No transition that fires is WorkflowViolation with a failed workflow:<id> check: \"<transition>: guard is not true\" or \"<transition>: <evaluation error>\" per refused transition joined with \"; \", or \"no transition from <old:?> to <new:?>\". An assignment that fails to evaluate is Evaluation \"<transition>: set <field>: <error>\". Conditions read no reference (see the gaps of WG-4938).",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "old",
          "type": "record"
        },
        {
          "name": "candidate",
          "type": "record"
        },
        {
          "name": "workflow",
          "type": "workflow-def"
        }
      ],
      "returns": "workflow-outcome",
      "errors": "rejection",
      "let": [
        {
          "name": "from",
          "expr": "match get(old.fields, workflow.field) { Some(y) => y, None => call null-value() }"
        },
        {
          "name": "to",
          "expr": "match get(candidate.fields, workflow.field) { Some(y) => y, None => call null-value() }"
        },
        {
          "name": "rule",
          "expr": "format('workflow:{}', workflow.id)"
        },
        {
          "name": "env",
          "expr": "expr-env{record: call record-scope(old), old: call record-scope(old), new: call record-scope(candidate), param: {}, now: value.time(d.ctx.now), principal: call principal-value(d.ctx.principal), has_role: call roles-of(d.tenant, d.ctx.principal)}"
        }
      ],
      "body": "if from == to then workflow-outcome{draft: d, candidate} else let search = fold(t in workflow.transitions, s = workflow-search{refused: []}, if s.fired != null || from != value.str(t.from) || to != value.str(t.to) then s else match t.guard { None => workflow-search{fired: t, refused: s.refused}, Some(g) => match eval(tenant-rule-language, g, env) { Ok(r) => match r { bool(b) => if b then workflow-search{fired: t, refused: s.refused} else workflow-search{refused: concat(s.refused, [format('{}: guard is not true', t.name)])}, _ => workflow-search{refused: concat(s.refused, [format('{}: guard is not true', t.name)])} }, Err(e) => workflow-search{refused: concat(s.refused, [format('{}: {}', t.name, e)])} } }) in match search.fired { None => let detail = if search.refused == [] then format('no transition from {} to {}', call value-debug(from), call value-debug(to)) else call join-semicolon(search.refused) in fail(call draft-reject(concat(d.evidence, [check{rule, passed: false, detail}]), error-kind.workflow-violation, detail)), Some(t) => let assigned = fold(k in keys(t.set), acc = {}, match get(t.set, k) { Some(e) => match eval(tenant-rule-language, e, env) { Ok(x) => insert(acc, k, x), Err(err) => fail(call draft-reject(d.evidence, error-kind.evaluation, format('{}: set {}: {}', t.name, k, err))) }, None => acc }) in workflow-outcome{draft: draft{tenant: d.tenant, ctx: d.ctx, coverage: d.coverage, ops: d.ops, events: d.events, effects: d.effects, evidence: concat(d.evidence, [check{rule: format('{}:{}', rule, t.name), passed: true, detail: format('{} -> {}', t.from, t.to)}]), next-record: d.next-record}, candidate: record{id: candidate.id, object: candidate.object, version: candidate.version, created-by: candidate.created-by, created-at: candidate.created-at, updated-at: candidate.updated-at, fields: fold(k in keys(assigned), m = candidate.fields, match get(assigned, k) { Some(x) => if call value-is-null(x) then remove(m, k) else insert(m, k, x), None => m })}} }",
