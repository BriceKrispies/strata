    {
      "id": "order-pass",
      "description": "One key of a query order, applied as a stable sort: by the attribute in the derived order of Value (its variant, then within a number or a string), ascending, or descending with equal keys kept in the order they had. A list value is not ordered by its items (a gap: Value orders lists element by element).",
      "params": [
        {
          "name": "rows",
          "type": "list<record>"
        },
        {
          "name": "key",
          "type": "order-key"
        }
      ],
      "returns": "list<record>",
      "let": [
        {
          "name": "start",
          "expr": "if key.descending then call reverse-records(rows) else rows"
        },
        {
          "name": "asc",
          "expr": "sortBy(r in sortBy(r in sortBy(r in start, call value-number(call record-attribute(r, key.field))), call value-text(call record-attribute(r, key.field))), call value-rank(call record-attribute(r, key.field)))"
        }
      ],
      "body": "if key.descending then call reverse-records(asc) else asc",
      "examples": [
        {
          "args": {
            "rows": {
              "fixture": "fx-list-record-1"
            },
            "key": {
              "field": "title",
              "descending": false
            }
          },
          "result": [
