    {
      "id": "section-order",
      "description": "crates/substrate/src/project.rs section_order: the section names in evaluation order, those that read no other section first, each group in name order. A section may read only a section that reads none (schema-problems).",
      "params": [
        {
          "name": "view",
          "type": "view-def"
        }
      ],
      "returns": "list<string>",
      "body": "concat(filter(n in keys(view.sections), match get(view.sections, n) { Some(s) => !call section-depends(s), None => false }), filter(n in keys(view.sections), match get(view.sections, n) { Some(s) => call section-depends(s), None => false }))",
      "examples": [
        {
          "description": "A section that reads another comes after the sections that read none.",
          "args": {
            "view": {
              "id": "feed",
              "route": "/",
              "title": "Feed",
              "sections": {
                "a_lead": {
                  "query": "by_title",
                  "args": {
                    "title": {
                      "section": {
                        "section": "z_top",
                        "attribute": "title"
                      }
                    }
                  },
                  "include": [],
                  "markdown": [],
                  "single": true
                },
                "z_top": {
                  "query": "newest",
                  "args": {},
                  "include": [],
                  "markdown": [],
                  "single": true
                }
              }
            }
          },
          "result": [
            "z_top",
            "a_lead"
          ]
        },
        {
          "args": {
            "view": {
              "id": "home",
              "route": "/",
              "title": "Home",
              "sections": {
                "posts": {
                  "query": "published",
                  "args": {},
                  "include": [
                    "author"
                  ],
                  "markdown": [],
                  "single": false
                }
              }
            }
          },
          "result": [
            "posts"
          ]
        }
      ]
    },
    {
      "id": "text-value",
      "description": "project.rs section_request, text: a route or request parameter as a string value, null when absent.",
      "params": [
        {
          "name": "text",
          "type": "option<string>"
        }
      ],
      "returns": "value",
      "body": "match text { Some(s) => value.str(s), None => call null-value() }",
      "examples": [
        {
          "args": {
            "text": "B"
          },
          "result": {
            "str": "B"
          }
        },
        {
          "args": {
            "text": null
          },
          "result": "null"
        }
      ]
    },
    {
      "id": "section-request",
      "description": "crates/substrate/src/project.rs section_request: the named read of a section, each argument (in name order) from a route parameter, a request parameter (each a string, null when absent), a constant, or an attribute of the single row of a section already evaluated (record-attribute; null when that section had no row). An argument that comes from a setting (setting) is null here: the hand-written section_request_with resolves it for the reader.",
      "params": [
        {
          "name": "section",
          "type": "view-section"
        },
        {
          "name": "route",
          "type": "map<string, string>"
        },
        {
          "name": "request",
          "type": "map<string, string>"
        },
        {
          "name": "done",
          "type": "map<string, option<record>>"
        }
      ],
      "returns": "read-request",
      "body": "read-request.named{query: section.query, params: fold(k in keys(section.args), m = {}, match get(section.args, k) { None => m, Some(src) => insert(m, k, match src { route(key) => call text-value(get(route, key)), request(key) => call text-value(get(request, key)), const(x) => x, setting(s) => call null-value(), section{section: from, attribute} => match get(done, from) { Some(row) => match row { Some(r) => call record-attribute(r, attribute), None => call null-value() }, None => call null-value() } }) })}",
      "examples": [
        {
          "args": {
            "section": {
              "query": "by_title",
              "args": {
                "title": {
                  "route": "title"
                }
              },
              "include": [],
              "markdown": [],
              "single": true
            },
            "route": {
              "title": "B"
            },
            "request": {},
            "done": {}
          },
          "result": {
            "named": {
              "query": "by_title",
              "params": {
                "title": {
                  "str": "B"
                }
              }
            }
          }
        },
        {
          "description": "publication_template.rs a_dependent_section_reads_through_the_single_row_it_depends_on.",
          "args": {
            "section": {
              "query": "by_title",
              "args": {
                "title": {
                  "section": {
                    "section": "z_top",
                    "attribute": "title"
                  }
                }
              },
              "include": [],
              "markdown": [],
              "single": true
            },
            "route": {},
            "request": {},
            "done": {
              "z_top": {
                "id": 4,
                "object": "post",
                "version": 1,
                "created-by": "alpha:owner",
                "created-at": 2002,
                "updated-at": 2002,
                "fields": {
                  "status": {
                    "str": "published"
                  },
                  "title": {
                    "str": "C"
                  }
                }
              }
            }
          },
          "result": {
            "named": {
              "query": "by_title",
              "params": {
                "title": {
                  "str": "C"
                }
              }
            }
          }
        },
        {
          "description": "A section read before had no row.",
          "args": {
            "section": {
              "query": "by_title",
              "args": {
                "title": {
                  "section": {
                    "section": "z_top",
                    "attribute": "title"
                  }
                }
              },
              "include": [],
              "markdown": [],
              "single": true
            },
            "route": {},
            "request": {},
            "done": {
              "z_top": null
            }
          },
          "result": {
            "named": {
              "query": "by_title",
              "params": {
                "title": "null"
              }
            }
          }
        },
        {
          "description": "An argument that comes from a setting is null in the generated function (SET-1540).",
          "args": {
            "section": {
              "query": "by_title",
              "args": {
                "title": {
                  "setting": "home_slug"
                }
              },
              "include": [],
              "markdown": [],
              "single": true
            },
            "route": {},
            "request": {},
            "done": {}
          },
          "result": {
            "named": {
              "query": "by_title",
              "params": {
                "title": "null"
              }
            }
          }
        }
      ]
    },
    {
      "id": "field-value",
      "description": "state.rs Record::get: a field's value, null when unset.",
      "params": [
        {
          "name": "r",
          "type": "record"
        },
        {
          "name": "field",
          "type": "field-id"
        }
      ],
      "returns": "value",
      "body": "match get(r.fields, field) { Some(x) => x, None => call null-value() }",
      "examples": [
        {
          "args": {
            "r": {
              "id": 2,
              "object": "post",
              "version": 1,
              "created-by": "alpha:writer",
              "created-at": 2000,
              "updated-at": 2000,
              "fields": {
                "author": {
                  "ref": 1
                },
                "status": {
                  "str": "published"
                },
                "title": {
                  "str": "B"
                }
              }
            },
            "field": "author"
          },
          "result": {
            "ref": 1
          }
        },
        {
          "args": {
            "r": {
              "id": 3,
              "object": "post",
              "version": 1,
              "created-by": "alpha:writer",
              "created-at": 2001,
              "updated-at": 2001,
              "fields": {
                "status": {
                  "str": "draft"
                },
                "title": {
                  "str": "A"
                }
              }
            },
            "field": "author"
          },
          "result": "null"
        }
      ]
    },
    {
      "id": "id-set",
      "description": "A BTreeSet<RecordId> collected into a list: each id once, in order.",
      "params": [
        {
          "name": "ids",
          "type": "list<record-id>"
        }
      ],
      "returns": "list<record-id>",
      "body": "fold(i in sortBy(i in ids, i), acc = [], if any(a in acc, a == i) then acc else concat(acc, [i]))",
      "examples": [
        {
          "args": {
            "ids": [
              3,
              1,
              3
            ]
          },
          "result": [
            1,
            3
          ]
        }
      ]
    },
    {
      "id": "included-refs",
      "description": "crates/substrate/src/project.rs included_refs: for each included field of the section that refers to an object type, the record ids the rows name in it (a reference, or the references of a list), each once, in order.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "section",
          "type": "view-section"
        },
        {
          "name": "rows",
          "type": "list<record>"
        }
      ],
      "returns": "map<field-id, included-target>",
      "body": "match get(schema.objects, object) { None => {}, Some(def) => fold(f in section.include, out = {}, match get(def.fields, f) { None => out, Some(fd) => match call ref-target(fd.ty) { None => out, Some(target) => insert(out, f, included-target{object: target, ids: call id-set(fold(r in rows, ids = [], concat(ids, call refs-in(call field-value(r, f)))))}) } }) }",
      "examples": [
        {
          "description": "A field that is not a reference includes nothing.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-16"
            },
            "object": "post",
            "section": {
              "query": "published",
              "args": {},
              "include": [
                "author",
                "title"
              ],
              "markdown": [],
              "single": false
            },
            "rows": {
              "fixture": "fx-list-record-1"
            }
          },
          "result": {
            "author": {
              "object": "person",
              "ids": [
                1
              ]
            }
          }
        }
      ]
    },
    {
      "id": "view-needs",
      "description": "crates/backend/src/ops.rs view, depends_on: the object types whose changes can alter a view, every record of which it loads: the object type of each section's query (a section of an unknown query adds nothing) and the target of each of its included reference fields.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "view",
          "type": "view-def"
        }
      ],
      "returns": "set<object-type-id>",
      "let": [
        {
          "name": "found",
          "expr": "fold(s in values(view.sections), acc = [], match get(schema.queries, s.query) { None => acc, Some(q) => concat(concat(acc, [q.object]), match get(schema.objects, q.object) { None => [], Some(o) => fold(f in s.include, xs = [], match get(o.fields, f) { None => xs, Some(fd) => match call ref-target(fd.ty) { Some(target) => concat(xs, [target]), None => xs } }) }) })"
        }
      ],
      "body": "fold(o in sortBy(o in found, o), acc = [], if any(a in acc, a == o) then acc else concat(acc, [o]))",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-16"
            },
            "view": {
              "id": "home",
              "route": "/",
              "title": "Home",
              "sections": {
                "posts": {
                  "query": "published",
                  "args": {},
                  "include": [
                    "author"
                  ],
                  "markdown": [],
                  "single": false
                }
              }
            }
          },
          "result": [
            "person",
            "post"
          ]
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-16"
            },
            "view": {
              "id": "home",
              "route": "/",
              "title": "Home",
              "sections": {
                "gone": {
                  "query": "nothing",
                  "args": {},
                  "include": [
                    "author"
                  ],
                  "markdown": [],
                  "single": false
                }
              }
            }
          },
          "result": []
        }
      ]
    },
    {
      "id": "without-others-authorship",
      "description": "crates/backend/src/ops.rs without_others_authorship (WG-4918): who created a record is told only to its creator; anyone else gets the record without created_by.",
      "params": [
        {
          "name": "principal",
          "type": "principal"
        },
        {
          "name": "r",
          "type": "record"
        }
      ],
      "returns": "record",
      "let": [
        {
          "name": "own",
          "expr": "match principal { user(id) => r.created-by == id, _ => false }"
        }
      ],
      "body": "if own || r.created-by == null then r else record{id: r.id, object: r.object, version: r.version, created-at: r.created-at, updated-at: r.updated-at, fields: r.fields}",
      "examples": [
        {
          "args": {
            "principal": "anonymous",
            "r": {
              "id": 2,
              "object": "post",
              "version": 1,
              "created-by": "alpha:writer",
              "created-at": 2000,
              "updated-at": 2000,
              "fields": {
                "author": {
                  "ref": 1
                },
                "status": {
                  "str": "published"
                },
                "title": {
                  "str": "B"
                }
              }
            }
          },
          "result": {
            "id": 2,
            "object": "post",
            "version": 1,
            "created-at": 2000,
            "updated-at": 2000,
            "fields": {
              "author": {
                "ref": 1
              },
              "status": {
                "str": "published"
              },
              "title": {
                "str": "B"
              }
            }
          }
        },
        {
          "args": {
            "principal": {
              "user": "alpha:writer"
            },
            "r": {
              "id": 2,
              "object": "post",
              "version": 1,
              "created-by": "alpha:writer",
              "created-at": 2000,
              "updated-at": 2000,
              "fields": {
                "author": {
                  "ref": 1
                },
                "status": {
                  "str": "published"
                },
                "title": {
                  "str": "B"
                }
              }
            }
          },
          "result": {
            "id": 2,
            "object": "post",
            "version": 1,
            "created-by": "alpha:writer",
            "created-at": 2000,
            "updated-at": 2000,
            "fields": {
              "author": {
                "ref": 1
              },
              "status": {
                "str": "published"
              },
              "title": {
                "str": "B"
              }
            }
          }
        }
      ]
    },
    {
      "id": "view-read",
      "description": "backend ops.rs view, one read of the kernel (kernel-read): a rejection is answered as the error body (api-error-of); InsufficientState naming a need asks for it.",
      "params": [
        {
          "name": "state",
          "type": "state"
        },
        {
          "name": "request",
          "type": "read-request"
        },
        {
          "name": "context",
          "type": "context"
        }
      ],
      "returns": "read-result",
      "errors": "api-failure",
      "body": "match call kernel-read(state, request, context) { Ok(r) => r, Err(e) => match e { rejected(d) => match d.missing { Some(n) => if d.kind == error-kind.insufficient-state then fail(api-failure.insufficient-state(n)) else fail(api-failure.refused(call api-error-of(d, context))), None => fail(api-failure.refused(call api-error-of(d, context))) } } }",
      "examples": [
        {
          "args": {
            "state": {
              "fixture": "fx-state-5"
            },
            "request": {
              "records": {
                "object": "person",
                "ids": [
                  1
                ]
              }
            },
            "context": {
              "tenant": "alpha",
              "principal": "anonymous",
              "session": null,
              "now": 3000,
              "correlation": "c-1"
            }
          },
          "result": {
            "rows": [
              {
                "id": 1,
                "object": "person",
                "version": 1,
                "created-by": "alpha:owner",
                "created-at": 1000,
                "updated-at": 1000,
                "fields": {
                  "name": {
                    "str": "Ada"
                  }
                }
              }
            ],
            "revision": 5,
            "schema-version": 2
          }
        },
        {
          "args": {
            "state": {
              "fixture": "fx-state-7"
            },
            "request": {
              "records": {
                "object": "person",
                "ids": [
                  1
                ]
              }
            },
            "context": {
              "tenant": "alpha",
              "principal": "anonymous",
              "session": null,
              "now": 3000,
              "correlation": "c-1"
            }
          },
          "error": {
            "insufficient-state": {
              "record": {
                "object": "person",
                "id": 1
              }
            }
          }
        },
        {
          "args": {
            "state": {
              "fixture": "fx-state-9"
            },
            "request": {
              "named": {
                "query": "nothing",
                "params": {}
              }
            },
            "context": {
              "tenant": "alpha",
              "principal": "anonymous",
              "session": null,
              "now": 3000,
              "correlation": "c-1"
            }
          },
          "error": {
            "refused": {
              "code": "not_found",
              "message": "no query nothing",
              "kind": "UnknownQuery",
              "failed": [],
              "correlation": "c-1"
            }
          }
        }
      ]
    },
    {
      "id": "view-section-step",
      "description": "crates/backend/src/ops.rs view, one section: its named read (section-request), then for each included field the records it names that the principal may read (included-refs, a records read). The rows and included records sent lose another principal's authorship (without-others-authorship); a single section's first row, authorship included, is kept for the sections that read it.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "state",
          "type": "state"
        },
        {
          "name": "context",
          "type": "context"
        },
        {
          "name": "route",
          "type": "map<string, string>"
        },
        {
          "name": "request",
          "type": "map<string, string>"
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "section",
          "type": "view-section"
        },
        {
          "name": "acc",
          "type": "view-progress"
        }
      ],
      "returns": "view-progress",
      "errors": "api-failure",
      "let": [
        {
          "name": "result",
          "expr": "try call view-read(state, call section-request(section, route, request, acc.done), context)"
        },
        {
          "name": "refs",
          "expr": "match get(tenant.schema.queries, section.query) { Some(q) => call included-refs(tenant.schema, q.object, section, result.rows), None => {} }"
        },
        {
          "name": "included",
          "expr": "fold(f in keys(refs), m = {}, match get(refs, f) { None => m, Some(tg) => insert(m, f, fold(r in (try call view-read(state, read-request.records{object: tg.object, ids: tg.ids}, context)).rows, rs = {}, insert(rs, r.id, call without-others-authorship(context.principal, r)))) })"
        }
      ],
      "body": "view-progress{done: if section.single then insert(acc.done, name, get(result.rows, 0)) else acc.done, sections: insert(acc.sections, name, section-data{single: section.single, rows: map(r in result.rows, call without-others-authorship(context.principal, r)), included, markdown: section.markdown}), revision: result.revision}",
      "examples": [
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-13"
            },
            "state": {
              "fixture": "fx-state-5"
            },
            "context": {
              "tenant": "alpha",
              "principal": "anonymous",
              "session": null,
              "now": 3000,
              "correlation": "c-1"
            },
            "route": {},
            "request": {},
            "name": "posts",
            "section": {
              "query": "published",
              "args": {},
              "include": [
                "author"
              ],
              "markdown": [],
              "single": false
            },
            "acc": {
              "done": {},
              "sections": {},
              "revision": 5
            }
          },
          "result": {
            "done": {},
            "sections": {
              "posts": {
                "single": false,
                "rows": [
                  {
                    "id": 2,
                    "object": "post",
                    "version": 1,
                    "created-at": 2000,
                    "updated-at": 2000,
                    "fields": {
                      "author": {
                        "ref": 1
                      },
                      "status": {
                        "str": "published"
                      },
                      "title": {
                        "str": "B"
                      }
                    }
                  },
                  {
                    "id": 4,
                    "object": "post",
                    "version": 1,
                    "created-at": 2002,
                    "updated-at": 2002,
                    "fields": {
                      "status": {
                        "str": "published"
                      },
                      "title": {
                        "str": "C"
                      }
                    }
                  }
                ],
                "included": {
                  "author": {
                    "1": {
                      "id": 1,
                      "object": "person",
                      "version": 1,
                      "created-at": 1000,
                      "updated-at": 1000,
                      "fields": {
                        "name": {
                          "str": "Ada"
                        }
                      }
                    }
                  }
                },
                "markdown": []
              }
            },
            "revision": 5
          }
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-13",
              "with": {
                "schema.policies": {},
                "schema.views": {},
                "records": {}
              }
            },
            "state": {
              "fixture": "fx-state-7",
              "with": {
                "tenant.schema.policies": {},
                "tenant.schema.views": {},
                "tenant.records": {}
              }
            },
            "context": {
              "tenant": "alpha",
              "principal": "anonymous",
              "session": null,
              "now": 3000,
              "correlation": "c-1"
            },
            "route": {},
            "request": {},
            "name": "posts",
            "section": {
              "query": "published",
              "args": {},
              "include": [
                "author"
              ],
              "markdown": [],
              "single": false
            },
            "acc": {
              "done": {},
              "sections": {},
              "revision": 5
            }
          },
          "error": {
            "insufficient-state": {
              "page-of": {
                "object": "post",
                "after": null,
                "limit": 10001
              }
            }
          }
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-12"
            },
            "state": {
              "fixture": "fx-state-9"
            },
            "context": {
              "tenant": "alpha",
              "principal": "anonymous",
              "session": null,
              "now": 3000,
              "correlation": "c-1"
            },
            "route": {},
            "request": {},
            "name": "posts",
            "section": {
              "query": "nothing",
              "args": {},
              "include": [
                "author"
              ],
              "markdown": [],
              "single": false
            },
            "acc": {
              "done": {},
              "sections": {},
              "revision": 5
            }
          },
          "error": {
            "refused": {
              "code": "not_found",
              "message": "no query nothing",
              "kind": "UnknownQuery",
              "failed": [],
              "correlation": "c-1"
            }
          }
        }
      ]
    },
    {
      "id": "assemble-view",
      "description": "crates/backend/src/ops.rs view, the decide of contract read-view (CT-264): the tenant (not_found \"no site <tenant>\"), the view whose route matches the path (match-route; not_found \"nothing at <path>\"), every record of the object types it depends on (view-needs) asked for first, then each section in evaluation order (section-order, view-section-step) read from the one snapshot. segments and routes are the path and the routes split (stand-ins of WG-4957).",
      "params": [
        {
          "name": "path",
          "type": "string"
        },
        {
          "name": "request",
          "type": "map<string, string>"
        },
        {
          "name": "context",
          "type": "context"
        },
        {
          "name": "state",
          "type": "state"
        },
        {
          "name": "segments",
          "type": "list<string>"
        },
        {
          "name": "routes",
          "type": "map<view-id, list<route-segment>>"
        }
      ],
      "returns": "view-data",
      "errors": "api-failure",
      "let": [
        {
          "name": "site",
          "expr": "match state.tenant { Some(t) => t, None => fail(api-failure.refused(api-error{code: error-code.not_found, message: format('no site {}', context.tenant), failed: [], correlation: context.correlation})) }"
        },
        {
          "name": "found",
          "expr": "match call match-route(site.schema, segments, routes) { Some(m) => m, None => fail(api-failure.refused(api-error{code: error-code.not_found, message: format('nothing at {}', path), failed: [], correlation: context.correlation})) }"
        },
        {
          "name": "depends",
          "expr": "call view-needs(site.schema, found.view)"
        },
        {
          "name": "progress",
          "expr": "match call first-missing(state.coverage, map(o in depends, need.all-of(o))) { Some(n) => fail(api-failure.insufficient-state(n)), None => fold(name in call section-order(found.view), acc = view-progress{done: {}, sections: {}, revision: site.revision}, match get(found.view.sections, name) { None => acc, Some(s) => try call view-section-step(site, state, context, found.params, request, name, s, acc) }) }"
        }
      ],
      "body": "view-data{view: found.view.id, title: found.view.title, params: found.params, sections: progress.sections, depends-on: depends, revision: progress.revision, schema-version: site.schema.version}",
      "examples": [
        {
          "args": {
            "path": "/posts/B",
            "request": {},
            "context": {
              "tenant": "alpha",
              "principal": "anonymous",
              "session": null,
              "now": 3000,
              "correlation": "c-1"
            },
            "state": {
              "fixture": "fx-state-8"
            },
            "segments": [
              "posts",
              "B"
            ],
            "routes": {
              "home": [],
              "one": [
                {
                  "literal": "posts"
                },
                {
                  "param": "title"
                }
              ]
            }
          },
          "result": {
            "view": "one",
            "title": "Post",
            "params": {
              "title": "B"
            },
            "sections": {
              "post": {
                "single": true,
                "rows": [
                  {
                    "id": 2,
                    "object": "post",
                    "version": 1,
                    "created-at": 2000,
                    "updated-at": 2000,
                    "fields": {
                      "author": {
                        "ref": 1
                      },
                      "status": {
                        "str": "published"
                      },
                      "title": {
                        "str": "B"
                      }
                    }
                  }
                ],
                "included": {},
                "markdown": []
              }
            },
            "depends-on": [
              "post"
            ],
            "revision": 5,
            "schema-version": 2
          }
        },
        {
          "description": "Every record of each object type the view depends on is loaded first.",
          "args": {
            "path": "/",
            "request": {},
            "context": {
              "tenant": "alpha",
              "principal": "anonymous",
              "session": null,
              "now": 3000,
              "correlation": "c-1"
            },
            "state": {
              "fixture": "fx-state-8"
            },
            "segments": [],
            "routes": {
              "home": [],
              "one": [
                {
                  "literal": "posts"
                },
                {
                  "param": "title"
                }
              ]
            }
          },
          "error": {
            "insufficient-state": {
              "all-of": "person"
            }
          }
        },
        {
          "args": {
            "path": "/pages/x",
            "request": {},
            "context": {
              "tenant": "alpha",
              "principal": "anonymous",
              "session": null,
              "now": 3000,
              "correlation": "c-1"
            },
            "state": {
              "fixture": "fx-state-5"
            },
            "segments": [
              "pages",
              "x"
            ],
            "routes": {
              "home": [],
              "one": [
                {
                  "literal": "posts"
                },
                {
                  "param": "title"
                }
              ]
            }
          },
          "error": {
            "refused": {
              "code": "not_found",
              "message": "nothing at /pages/x",
              "kind": null,
              "failed": [],
              "correlation": "c-1"
            }
          }
        }
      ]
    },
    {
      "id": "json-int",
      "description": "serde_json json!(i64): a negative integer is a NegInt, any other a PosInt.",
      "params": [
        {
          "name": "i",
          "type": "i64"
        }
      ],
      "returns": "plain-json",
      "body": "if i < 0 then plain-json.number(json-number.neg-int(i)) else plain-json.number(json-number.pos-int(i))",
      "examples": [
        {
          "args": {
            "i": 3
          },
          "result": {
            "number": {
              "pos-int": 3
            }
          }
        },
        {
          "args": {
            "i": -2
          },
          "result": {
            "number": {
              "neg-int": -2
            }
          }
        }
      ]
    },
    {
      "id": "to-plain-leaf",
      "description": "substrate plain.rs to_plain of a value that is not a list (a list of lists, which schema-problems refuse, is null here). none is the JSON null, which a body cannot write yet (the keyword-named variant gap of WG-4957): callers pass null.",
      "params": [
        {
          "name": "x",
          "type": "value"
        },
        {
          "name": "none",
          "type": "plain-json"
        }
      ],
      "returns": "plain-json",
      "body": "match x { bool(b) => plain-json.bool(b), int(i) => call json-int(i), str(s) => plain-json.string(s), time(t) => call json-int(t), ref(r) => plain-json.number(json-number.pos-int(r)), _ => none }",
      "examples": [
        {
          "args": {
            "x": {
              "time": 5
            },
            "none": "null"
          },
          "result": {
            "number": {
              "pos-int": 5
            }
          }
        },
        {
          "args": {
            "x": {
              "ref": 2
            },
            "none": "null"
          },
          "result": {
            "number": {
              "pos-int": 2
            }
          }
        },
        {
          "args": {
            "x": "null",
            "none": "null"
          },
          "result": "null"
        },
        {
          "args": {
            "x": {
              "int": 3
            },
            "none": "null"
          },
          "result": {
            "number": {
              "pos-int": 3
            }
          }
        },
        {
          "args": {
            "x": {
              "bool": true
            },
            "none": "null"
          },
          "result": {
            "bool": true
          }
        },
        {
          "args": {
            "x": {
              "str": "a"
            },
            "none": "null"
          },
          "result": {
            "string": "a"
          }
        }
      ]
    },
    {
      "id": "to-plain",
      "description": "crates/substrate/src/plain.rs to_plain: a value as plain JSON (a reference and a time as their numbers, a list item by item). none is the JSON null (see to-plain-leaf).",
      "params": [
        {
          "name": "x",
          "type": "value"
        },
        {
          "name": "none",
          "type": "plain-json"
        }
      ],
      "returns": "plain-json",
      "body": "match x { list(items) => plain-json.array(map(i in items, call to-plain-leaf(i, none))), _ => call to-plain-leaf(x, none) }",
      "examples": [
        {
          "args": {
            "x": {
              "list": [
                {
                  "str": "a"
                },
                {
                  "bool": false
                }
              ]
            },
            "none": "null"
          },
          "result": {
            "array": [
              {
                "string": "a"
              },
              {
                "bool": false
              }
            ]
          }
        },
        {
          "args": {
            "x": {
              "str": "a"
            },
            "none": "null"
          },
          "result": {
            "string": "a"
          }
        }
      ]
    },
    {
      "id": "project-record",
      "description": "crates/substrate/src/project.rs project_record: a record as the object id, object, version, created_at, updated_at, created_by (null when not told) and fields (to-plain). none is the JSON null (see to-plain-leaf).",
      "params": [
        {
          "name": "r",
          "type": "record"
        },
        {
          "name": "none",
          "type": "plain-json"
        }
      ],
      "returns": "map<string, plain-json>",
      "body": "insert(insert(insert(insert(insert(insert(insert({}, 'id', plain-json.number(json-number.pos-int(r.id))), 'object', plain-json.string(r.object)), 'version', plain-json.number(json-number.pos-int(r.version))), 'created_at', call json-int(r.created-at)), 'updated_at', call json-int(r.updated-at)), 'created_by', match r.created-by { Some(p) => plain-json.string(p), None => none }), 'fields', plain-json.object(fold(k in keys(r.fields), m = {}, match get(r.fields, k) { Some(x) => insert(m, k, call to-plain(x, none)), None => m })))",
      "examples": [
        {
          "args": {
            "r": {
              "id": 1,
              "object": "person",
              "version": 1,
              "created-at": 1000,
              "updated-at": 1000,
              "fields": {
                "name": {
                  "str": "Ada"
                }
              }
            },
            "none": "null"
          },
          "result": {
            "created_at": {
              "number": {
                "pos-int": 1000
              }
            },
            "created_by": "null",
            "fields": {
              "object": {
                "name": {
                  "string": "Ada"
                }
              }
            },
            "id": {
              "number": {
                "pos-int": 1
              }
            },
            "object": {
              "string": "person"
            },
            "updated_at": {
              "number": {
                "pos-int": 1000
              }
            },
            "version": {
              "number": {
                "pos-int": 1
              }
            }
          }
        }
      ]
    },
    {
      "id": "reading-minutes",
      "description": "crates/substrate/src/project.rs project_row (lines 211-212): reading time at 230 words a minute, rounded up, never less than one minute.",
      "params": [
        {
          "name": "words",
          "type": "u64"
        }
      ],
      "returns": "u64",
      "body": "if words == 0 then 1 else (words + 229) / 230",
      "examples": [
        {
          "args": {
            "words": 0
          },
          "result": 1
        },
        {
          "args": {
            "words": 230
          },
          "result": 1
        },
        {
          "args": {
            "words": 231
          },
          "result": 2
        }
      ]
    },
    {
      "id": "project-row",
      "description": "crates/substrate/src/project.rs project_row: the record (project-record) with refs, each included field's referenced record projected (null when not included; a list keeps the included ones), and, when the section names markdown fields, the blocks of each string one and reading_minutes over their words. markdown holds the parsed blocks and word count of each Markdown source (markdown.rs parse and word_count, a stand-in until the function language has string operations, WG-4957); a source it does not hold is left out. none is the JSON null (see to-plain-leaf).",
      "params": [
        {
          "name": "r",
          "type": "record"
        },
        {
          "name": "section",
          "type": "section-data"
        },
        {
          "name": "markdown",
          "type": "map<string, markdown-summary>"
        },
        {
          "name": "none",
          "type": "plain-json"
        }
      ],
      "returns": "plain-json",
      "let": [
        {
          "name": "base",
          "expr": "call project-record(r, none)"
        },
        {
          "name": "refs",
          "expr": "fold(f in keys(section.included), m = {}, match get(section.included, f) { None => m, Some(inc) => match call field-value(r, f) { ref(id) => insert(m, f, match get(inc, id) { Some(t) => plain-json.object(call project-record(t, none)), None => none }), list(items) => insert(m, f, plain-json.array(fold(i in items, xs = [], match i { ref(id) => match get(inc, id) { Some(t) => concat(xs, [plain-json.object(call project-record(t, none))]), None => xs }, _ => xs }))), _ => m } })"
        },
        {
          "name": "summary",
          "expr": "fold(f in section.markdown, acc = markdown-fold{blocks: {}, words: 0}, match call field-value(r, f) { str(source) => match get(markdown, source) { Some(md) => markdown-fold{blocks: insert(acc.blocks, f, md.blocks), words: acc.words + md.words}, None => acc }, _ => acc })"
        }
      ],
      "body": "plain-json.object(if section.markdown == [] then insert(base, 'refs', plain-json.object(refs)) else insert(insert(insert(base, 'refs', plain-json.object(refs)), 'blocks', plain-json.object(summary.blocks)), 'reading_minutes', call json-int(call reading-minutes(summary.words))))",
      "examples": [
        {
          "description": "A row with an included author and a markdown field.",
          "args": {
            "r": {
              "id": 2,
              "object": "post",
              "version": 1,
              "created-by": "alpha:writer",
              "created-at": 2000,
              "updated-at": 2000,
              "fields": {
                "author": {
                  "ref": 1
                },
                "status": {
                  "str": "published"
                },
                "title": {
                  "str": "B"
                }
              }
            },
            "section": {
              "single": false,
              "rows": [
                {
                  "id": 2,
                  "object": "post",
                  "version": 1,
                  "created-by": "alpha:writer",
                  "created-at": 2000,
                  "updated-at": 2000,
                  "fields": {
                    "author": {
                      "ref": 1
                    },
                    "status": {
                      "str": "published"
                    },
                    "title": {
                      "str": "B"
                    }
                  }
                }
              ],
              "included": {
                "author": {
                  "1": {
                    "id": 1,
                    "object": "person",
                    "version": 1,
                    "created-at": 1000,
                    "updated-at": 1000,
                    "fields": {
                      "name": {
                        "str": "Ada"
                      }
                    }
                  }
                }
              },
              "markdown": [
                "title"
              ]
            },
            "markdown": {
              "B": {
                "blocks": {
                  "array": []
                },
                "words": 1
              }
            },
            "none": "null"
          },
          "result": {
            "object": {
              "blocks": {
                "object": {
                  "title": {
                    "array": []
                  }
                }
              },
              "created_at": {
                "number": {
                  "pos-int": 2000
                }
              },
              "created_by": {
                "string": "alpha:writer"
              },
              "fields": {
                "object": {
                  "author": {
                    "number": {
                      "pos-int": 1
                    }
                  },
                  "status": {
                    "string": "published"
                  },
                  "title": {
                    "string": "B"
                  }
                }
              },
              "id": {
                "number": {
                  "pos-int": 2
                }
              },
              "object": {
                "string": "post"
              },
              "reading_minutes": {
                "number": {
                  "pos-int": 1
                }
              },
              "refs": {
                "object": {
                  "author": {
                    "object": {
                      "created_at": {
                        "number": {
                          "pos-int": 1000
                        }
                      },
                      "created_by": "null",
                      "fields": {
                        "object": {
                          "name": {
                            "string": "Ada"
                          }
                        }
                      },
                      "id": {
                        "number": {
                          "pos-int": 1
                        }
                      },
                      "object": {
                        "string": "person"
                      },
                      "updated_at": {
                        "number": {
                          "pos-int": 1000
                        }
                      },
                      "version": {
                        "number": {
                          "pos-int": 1
                        }
                      }
                    }
                  }
                }
              },
              "updated_at": {
                "number": {
                  "pos-int": 2000
                }
              },
              "version": {
                "number": {
                  "pos-int": 1
                }
              }
            }
          }
        }
      ]
    },
    {
      "id": "project-view",
      "description": "crates/substrate/src/project.rs project: raw view data as the plain view model the browser renders: view, title, params, data (a single section one row or null, any other an array of rows, project-row), depends_on, revision and schema_version. The BFF adds the path and the publication template's fields (theme and the desk's, WG-4942). none is the JSON null (see to-plain-leaf).",
      "params": [
        {
          "name": "data",
          "type": "view-data"
        },
        {
          "name": "markdown",
          "type": "map<string, markdown-summary>"
        },
        {
          "name": "none",
          "type": "plain-json"
        }
      ],
      "returns": "plain-json",
      "body": "plain-json.object(insert(insert(insert(insert(insert(insert(insert({}, 'view', plain-json.string(data.view)), 'title', plain-json.string(data.title)), 'params', plain-json.object(fold(k in keys(data.params), m = {}, match get(data.params, k) { Some(x) => insert(m, k, plain-json.string(x)), None => m }))), 'data', plain-json.object(fold(k in keys(data.sections), m = {}, match get(data.sections, k) { None => m, Some(s) => insert(m, k, if s.single then match get(s.rows, 0) { Some(r) => call project-row(r, s, markdown, none), None => none } else plain-json.array(map(r in s.rows, call project-row(r, s, markdown, none)))) }))), 'depends_on', plain-json.array(map(o in data.depends-on, plain-json.string(o)))), 'revision', plain-json.number(json-number.pos-int(data.revision))), 'schema_version', plain-json.number(json-number.pos-int(data.schema-version))))",
      "examples": [
        {
          "description": "A single section without a row is null.",
          "args": {
            "data": {
              "view": "one",
              "title": "Post",
              "params": {
                "title": "Q"
              },
              "sections": {
                "post": {
                  "single": true,
                  "rows": [],
                  "included": {},
                  "markdown": []
                }
              },
              "depends-on": [
                "post"
              ],
              "revision": 5,
              "schema-version": 2
            },
            "markdown": {},
            "none": "null"
          },
          "result": {
            "object": {
              "data": {
                "object": {
                  "post": "null"
                }
              },
              "depends_on": {
                "array": [
                  {
                    "string": "post"
                  }
                ]
              },
              "params": {
                "object": {
                  "title": {
                    "string": "Q"
                  }
                }
              },
              "revision": {
                "number": {
                  "pos-int": 5
                }
              },
              "schema_version": {
                "number": {
                  "pos-int": 2
                }
              },
              "title": {
                "string": "Post"
              },
              "view": {
                "string": "one"
              }
            }
          }
        }
      ]
    },
    {
      "id": "object-def",
      "description": "transition.rs object_def, for an intent that does action on the object type: the object type of the tenant's schema, or, when there is none, the action authorised on the object type with no record to test (require), so that a caller whom no policy could allow it gets Unauthorized whether or not the type exists, and only a caller who could learns UnknownObject.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "action",
          "type": "action"
        }
      ],
      "returns": "object-type-def",
      "errors": "rejection",
      "body": "match get(d.tenant.schema.objects, object) { Some(o) => o, None => fail(call draft-reject(d1.evidence, error-kind.unknown-object, format('no object type {}', object))) }",
      "examples": [
        {
          "args": {
            "d": {
              "fixture": "fx-draft-10"
            },
            "object": "person",
            "action": "update"
          },
          "result": {
            "id": "person",
            "label": "Person",
            "fields": {
              "name": {
                "id": "name",
                "label": "name",
                "ty": "str",
                "required": true,
                "unique": false
              }
            },
            "constraints": {}
          }
        },
        {
          "description": "behaviour.rs every_rejection_lists_at_least_one_failed_check: unknown object type, for the owner, who may do anything, so learns that it is missing.",
          "args": {
            "d": {
              "fixture": "fx-draft-10"
            },
            "object": "nothing",
            "action": "update"
          },
          "error": {
            "rejected": {
              "kind": "unknown-object",
              "message": "no object type nothing",
              "evidence": [
                {
                  "rule": "policy:builtin_owner",
                  "passed": true,
                  "detail": "Update on Object(ObjectTypeId(\"nothing\"))"
                },
                {
                  "rule": "intent:unknown_object",
                  "passed": false,
                  "detail": "no object type nothing"
                }
              ],
              "missing": null
            }
          }
        },
        {
          "description": "A caller whom no policy lets update the type gets Unauthorized whether or not the type exists: a refusal never tells anyone which types exist.",
          "args": {
            "d": {
              "fixture": "fx-draft-10",
              "with": {
                "ctx.principal.user": "alpha:writer1"
              }
            },
            "object": "nothing",
            "action": "update"
          },
          "error": {
            "rejected": {
              "kind": "unauthorized",
              "message": "User(PrincipalId(\"alpha:writer1\")) may not Update Object(ObjectTypeId(\"nothing\"))",
              "evidence": [
                {
                  "rule": "policy:none",
                  "passed": false,
                  "detail": "no policy grants Update on Object(ObjectTypeId(\"nothing\"))"
                }
              ],
              "missing": null
            }
          }
        }
      ],
      "let": [
        {
          "name": "d1",
          "expr": "match get(d.tenant.schema.objects, object) { Some(_) => d, None => try call require(d, action, resource.object(object), subject{}) }"
        }
      ]
    },
    {
      "id": "ascii-lowercase",
      "description": "Rust str::to_ascii_lowercase: A to Z become a to z, every other character stays.",
      "params": [
        {
          "name": "s",
          "type": "string"
        }
      ],
      "returns": "string",
      "body": "fold(c in chars(s), acc = '', acc + if c == 'A' then 'a' else if c == 'B' then 'b' else if c == 'C' then 'c' else if c == 'D' then 'd' else if c == 'E' then 'e' else if c == 'F' then 'f' else if c == 'G' then 'g' else if c == 'H' then 'h' else if c == 'I' then 'i' else if c == 'J' then 'j' else if c == 'K' then 'k' else if c == 'L' then 'l' else if c == 'M' then 'm' else if c == 'N' then 'n' else if c == 'O' then 'o' else if c == 'P' then 'p' else if c == 'Q' then 'q' else if c == 'R' then 'r' else if c == 'S' then 's' else if c == 'T' then 't' else if c == 'U' then 'u' else if c == 'V' then 'v' else if c == 'W' then 'w' else if c == 'X' then 'x' else if c == 'Y' then 'y' else if c == 'Z' then 'z' else c)",
      "examples": [
        {
          "args": {
            "s": "Ann@Example.ORG"
          },
          "result": "ann@example.org"
        },
        {
          "args": {
            "s": "Zoë"
          },
          "result": "zoë"
        }
      ]
    },
    {
      "id": "normalise-address",
      "description": "schema.rs normalise_address: the form in which an address is compared, trimmed and in ASCII lower case.",
      "params": [
        {
          "name": "address",
          "type": "string"
        }
      ],
      "returns": "string",
      "body": "call ascii-lowercase(trim(address))",
      "examples": [
        {
          "args": {
            "address": "  Guest@Example.org "
          },
          "result": "guest@example.org"
        }
      ]
    },
    {
      "id": "principal-set-of",
      "description": "A BTreeSet<PrincipalId> as the body language holds it: the items sorted by Unicode scalar values, each once.",
      "params": [
        {
          "name": "items",
          "type": "list<principal-id>"
        }
      ],
      "returns": "set<principal-id>",
      "body": "fold(p in sortBy(p in items, p), acc = [], if any(a in acc, a == p) then acc else concat(acc, [p]))",
      "examples": [
        {
          "args": {
            "items": [
              "alpha:writer1",
              "alpha:guest",
              "alpha:writer1"
            ]
          },
          "result": [
            "alpha:guest",
            "alpha:writer1"
          ]
        }
      ]
    },
    {
      "id": "teams-of",
      "description": "TenantSchema::all_teams as a map: the teams of a schema by id, none when it holds no table of teams.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        }
      ],
      "returns": "map<team-id, team-def>",
      "body": "match schema.teams { Some(ts) => ts, None => {} }",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-19"
            }
          },
          "result": {
            "desk": {
              "id": "desk",
              "label": "Desk",
              "members": [
                "alpha:guest"
              ],
              "roles": [
                "editor"
              ]
            }
          }
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-8"
            }
          },
          "result": {}
        }
      ]
    },
    {
      "id": "invitations-of",
      "description": "TenantSchema::all_invitations as a map: the invitations of a schema by id, none when it holds no table of invitations.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        }
      ],
      "returns": "map<invitation-id, invitation-def>",
      "body": "match schema.invitations { Some(xs) => xs, None => {} }",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-8",
              "with": {
                "invitations": {
                  "inv-1": {
                    "id": "inv-1",
                    "address": "guest@example.org",
                    "roles": [
                      "editor"
                    ],
                    "created-by": "alpha:owner",
                    "redeemed-by": null
                  }
                }
              }
            }
          },
          "result": {
            "inv-1": {
              "id": "inv-1",
              "address": "guest@example.org",
              "roles": [
                "editor"
              ],
              "created-by": "alpha:owner",
              "redeemed-by": null
            }
          }
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-8"
            }
          },
          "result": {}
        }
      ]
    },
    {
      "id": "assigned-roles",
      "description": "rules.rs assigned_roles: the roles a person holds through the table of members and the teams of a schema: those assigned to it directly and those of each team it belongs to, and no other.",
      "params": [
        {
          "name": "members",
          "type": "map<principal-id, set<role-id>>"
        },
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "id",
          "type": "principal-id"
        }
      ],
      "returns": "set<role-id>",
      "let": [
        {
          "name": "direct",
          "expr": "match get(members, id) { Some(rs) => rs, None => [] }"
        }
      ],
      "body": "call set-of(fold(t in values(call teams-of(schema)), acc = direct, if any(m in t.members, m == id) then concat(acc, t.roles) else acc))",
      "examples": [
        {
          "description": "A member of a team holds its roles beside its own.",
          "args": {
            "members": {
              "alpha:guest": [
                "writer"
              ]
            },
            "schema": {
              "fixture": "fx-tenant-schema-19"
            },
            "id": "alpha:guest"
          },
          "result": [
            "editor",
            "writer"
          ]
        },
        {
          "description": "Someone in no team holds only what is assigned to it.",
          "args": {
            "members": {
              "alpha:editor": [
                "editor"
              ],
              "alpha:owner": [
                "owner"
              ],
              "alpha:writer1": [
                "writer"
              ],
              "alpha:writer2": [
                "writer"
              ]
            },
            "schema": {
              "fixture": "fx-tenant-schema-19"
            },
            "id": "alpha:writer1"
          },
          "result": [
            "writer"
          ]
        }
      ]
    },
    {
      "id": "grant-key",
      "description": "The order of strata_kernel::Grant as a text key: a capability before an object grant, capabilities by name, object grants by object type and then by ObjectAction in its declared order.",
      "params": [
        {
          "name": "g",
          "type": "grant"
        }
      ],
      "returns": "string",
      "body": "match g { capability(name) => '0' + name, object{object, action} => format('1{} {}', object, match action { read => '0', create => '1', update => '2', delete => '3' }) }",
      "examples": [
        {
          "args": {
            "g": {
              "capability": "content-write"
            }
          },
          "result": "0content-write"
        },
        {
          "args": {
            "g": {
              "object": {
                "object": "note",
                "action": "update"
              }
            }
          },
          "result": "1note 2"
        }
      ]
    },
    {
      "id": "grant-set",
      "description": "A BTreeSet<Grant> as the body language holds it: the grants in the kernel order (grant-key), each once.",
      "params": [
        {
          "name": "items",
          "type": "list<grant>"
        }
      ],
      "returns": "list<grant>",
      "body": "fold(g in sortBy(g in items, call grant-key(g)), acc = [], if any(x in acc, x == g) then acc else concat(acc, [g]))",
      "examples": [
        {
          "args": {
            "items": [
              {
                "object": {
                  "object": "note",
                  "action": "update"
                }
              },
              {
                "capability": "content-write"
              },
              {
                "object": {
                  "object": "note",
                  "action": "read"
                }
              },
              {
                "capability": "content-write"
              }
            ]
          },
          "result": [
            {
              "capability": "content-write"
            },
            {
              "object": {
                "object": "note",
                "action": "read"
              }
            },
            {
              "object": {
                "object": "note",
                "action": "update"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "grants-of",
      "description": "schema.rs TenantSchemaExt::grants_of: every grant of a role, from its permissions (PermissionExt::grants); a role without permissions grants none.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "role",
          "type": "role-id"
        }
      ],
      "returns": "list<grant>",
      "let": [
        {
          "name": "permissions",
          "expr": "match schema.role-permissions { Some(t) => match get(t, role) { Some(ps) => ps, None => [] }, None => [] }"
        }
      ],
      "body": "call grant-set(fold(p in permissions, acc = [], concat(acc, match p { capability(name) => [grant.capability(name)], object{object, actions} => map(a in actions, grant.object{object, action: a}) })))",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-20"
            },
            "role": "editor"
          },
          "result": [
            {
              "capability": "content-write"
            },
            {
              "object": {
                "object": "note",
                "action": "read"
              }
            },
            {
              "object": {
                "object": "note",
                "action": "update"
              }
            }
          ]
        },
        {
          "description": "A role without permissions grants none.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-8"
            },
            "role": "editor"
          },
          "result": []
        }
      ]
    },
    {
      "id": "effective-permissions",
      "description": "rules.rs effective_permissions (ADM-151): the union of the grants of every role in roles-of, directly or through a team. The owner holds every permission, which may-confer decides, not this.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "principal",
          "type": "principal"
        }
      ],
      "returns": "list<grant>",
      "body": "call grant-set(fold(r in call roles-of(tenant, principal), acc = [], concat(acc, call grants-of(tenant.schema, r))))",
      "examples": [
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-15",
              "with": {
                "members.alpha:writer1": [
                  "editor",
                  "writer"
                ]
              }
            },
            "principal": {
              "user": "alpha:writer1"
            }
          },
          "result": [
            {
              "capability": "content-write"
            },
            {
              "object": {
                "object": "note",
                "action": "read"
              }
            },
            {
              "object": {
                "object": "note",
                "action": "update"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "grant-text",
      "description": "rules.rs describe_grant: a grant as a sentence fragment, capability <name> or <object>:<verb>.",
      "params": [
        {
          "name": "g",
          "type": "grant"
        }
      ],
      "returns": "string",
      "body": "match g { capability(name) => format('capability {}', name), object{object, action} => format('{}:{}', object, match action { read => 'read', create => 'create', update => 'update', delete => 'delete' }) }",
      "examples": [
        {
          "args": {
            "g": {
              "capability": "content-write"
            }
          },
          "result": "capability content-write"
        },
        {
          "args": {
            "g": {
              "object": {
                "object": "note",
                "action": "update"
              }
            }
          },
          "result": "note:update"
        }
      ]
    },
    {
      "id": "may-confer",
      "description": "rules.rs may_confer (ADM-152, ADM-1080): whether a principal may confer a role, which it may only when it holds every permission and capability the role grants, whether through its permissions or through a policy of the schema (a policy grants one power per action it names: holds-policy-power). A role that grants nothing, by permissions or policies, may be conferred, except owner, which only an owner confers. The check names the rule and the role; a refusal names what the principal lacks, the permissions first and then the policy powers. Taking a role away asks the same.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "principal",
          "type": "principal"
        },
        {
          "name": "role",
          "type": "role-id"
        }
      ],
      "returns": "check",
      "let": [
        {
          "name": "rule",
          "expr": "format('permission:confer:{}', role)"
        },
        {
          "name": "owner",
          "expr": "any(r in call roles-of(tenant, principal), r == 'owner')"
        },
        {
          "name": "grants",
          "expr": "call grants-of(tenant.schema, role)"
        },
        {
          "name": "held",
          "expr": "call effective-permissions(tenant, principal)"
        },
        {
          "name": "missing",
          "expr": "if owner then [] else filter(g in grants, !any(h in held, h == g))"
        },
        {
          "name": "powers",
          "expr": "fold(p in values(tenant.schema.policies), acc = [], if p.role != role then acc else concat(acc, map(a in p.actions, if call holds-policy-power(tenant, principal, a, p.resource, p.condition) then '' else format('policy {}: {} on {}', p.id, call action-debug(a), call resource-debug(p.resource)))))"
        },
        {
          "name": "lacking",
          "expr": "concat(map(g in missing, call grant-text(g)), filter(s in powers, s != ''))"
        }
      ],
      "body": "if role == 'owner' then (if owner then check{rule, passed: true, detail: 'an owner confers owner'} else check{rule, passed: false, detail: 'only an owner confers the owner role'}) else if grants == [] && powers == [] then check{rule, passed: true, detail: format('role {} grants no permission', role)} else if lacking == [] then check{rule, passed: true, detail: format('holds every permission that role {} grants', role)} else check{rule, passed: false, detail: format('lacks {} of the {} permissions that role {} grants: {}', length(lacking), length(grants) + length(powers), role, fold(s in lacking, acc = '', if acc == '' then s else acc + ', ' + s))}",
      "examples": [
        {
          "description": "An owner confers owner.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-14"
            },
            "principal": {
              "user": "alpha:owner"
            },
            "role": "owner"
          },
          "result": {
            "rule": "permission:confer:owner",
            "passed": true,
            "detail": "an owner confers owner"
          }
        },
        {
          "description": "Only an owner confers owner.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-14"
            },
            "principal": {
              "user": "alpha:editor"
            },
            "role": "owner"
          },
          "result": {
            "rule": "permission:confer:owner",
            "passed": false,
            "detail": "only an owner confers the owner role"
          }
        },
        {
          "description": "A role that grants nothing has nothing to over-grant.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-14"
            },
            "principal": {
              "user": "alpha:writer1"
            },
            "role": "editor"
          },
          "result": {
            "rule": "permission:confer:editor",
            "passed": true,
            "detail": "role editor grants no permission"
          }
        },
        {
          "description": "An editor holds every grant of editor.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-15"
            },
            "principal": {
              "user": "alpha:editor"
            },
            "role": "editor"
          },
          "result": {
            "rule": "permission:confer:editor",
            "passed": true,
            "detail": "holds every permission that role editor grants"
          }
        },
        {
          "description": "A writer lacks two of the three grants of editor.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-15"
            },
            "principal": {
              "user": "alpha:writer1"
            },
            "role": "editor"
          },
          "result": {
            "rule": "permission:confer:editor",
            "passed": false,
            "detail": "lacks 2 of the 3 permissions that role editor grants: capability content-write, note:update"
          }
        },
        {
          "description": "The owner holds every permission.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-15"
            },
            "principal": {
              "user": "alpha:owner"
            },
            "role": "editor"
          },
          "result": {
            "rule": "permission:confer:editor",
            "passed": true,
            "detail": "holds every permission that role editor grants"
          }
        },
        {
          "description": "A role whose power is given by a policy is not a role that grants nothing: the owner holds every power it names.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-14",
              "with": {
                "schema.policies.editors_manage_notes": {
                  "id": "editors_manage_notes",
                  "role": "editor",
                  "resource": {
                    "object": "note"
                  },
                  "actions": [
                    "read",
                    "update",
                    "delete"
                  ],
                  "condition": null
                }
              }
            },
            "principal": {
              "user": "alpha:owner"
            },
            "role": "editor"
          },
          "result": {
            "rule": "permission:confer:editor",
            "passed": true,
            "detail": "holds every permission that role editor grants"
          }
        },
        {
          "description": "A principal who holds only some of the powers of the policies of a role lacks the others: writer1 may read notes but not update or delete them, so may not confer editor.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-17",
              "with": {
                "schema.policies": {
                  "editors_manage_notes": {
                    "id": "editors_manage_notes",
                    "role": "editor",
                    "resource": {
                      "object": "note"
                    },
                    "actions": [
                      "read",
                      "update",
                      "delete"
                    ],
                    "condition": null
                  },
                  "writers_read_notes": {
                    "id": "writers_read_notes",
                    "role": "writer",
                    "resource": {
                      "object": "note"
                    },
                    "actions": [
                      "read"
                    ],
                    "condition": null
                  }
                }
              }
            },
            "principal": {
              "user": "alpha:writer1"
            },
            "role": "editor"
          },
          "result": {
            "rule": "permission:confer:editor",
            "passed": false,
            "detail": "lacks 2 of the 3 permissions that role editor grants: policy editors_manage_notes: Update on Object(ObjectTypeId(\"note\")), policy editors_manage_notes: Delete on Object(ObjectTypeId(\"note\"))"
          }
        },
        {
          "description": "A permission of the principal covers a policy power: writer1 holds note:update through its role permissions and the policy of the editor role names only that.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-19",
              "with": {
                "schema.policies.editors_update": {
                  "id": "editors_update",
                  "role": "editor",
                  "resource": {
                    "object": "note"
                  },
                  "actions": [
                    "update"
                  ],
                  "condition": null
                }
              }
            },
            "principal": {
              "user": "alpha:writer1"
            },
            "role": "editor"
          },
          "result": {
            "rule": "permission:confer:editor",
            "passed": true,
            "detail": "holds every permission that role editor grants"
          }
        },
        {
          "description": "A conditional policy power is held through an unconditional policy of the principal: writer1 updates any note, so holds the conditioned update of the editor role as well.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-17",
              "with": {
                "schema.policies": {
                  "editors_update": {
                    "id": "editors_update",
                    "role": "editor",
                    "resource": {
                      "object": "note"
                    },
                    "actions": [
                      "update"
                    ],
                    "condition": {
                      "is-null": {
                        "var": {
                          "scope": "new",
                          "field": "published_at"
                        }
                      }
                    }
                  },
                  "writers_edit": {
                    "id": "writers_edit",
                    "role": "writer",
                    "resource": {
                      "object": "note"
                    },
                    "actions": [
                      "update"
                    ],
                    "condition": null
                  }
                }
              }
            },
            "principal": {
              "user": "alpha:writer1"
            },
            "role": "editor"
          },
          "result": {
            "rule": "permission:confer:editor",
            "passed": true,
            "detail": "holds every permission that role editor grants"
          }
        },
        {
          "description": "A principal whose own policy is conditional does not hold the power of an unconditional one: writer1 may update only unpublished notes, so may not confer the editor role that updates any.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-17",
              "with": {
                "schema.policies": {
                  "editors_update": {
                    "id": "editors_update",
                    "role": "editor",
                    "resource": {
                      "object": "note"
                    },
                    "actions": [
                      "update"
                    ],
                    "condition": null
                  },
                  "writers_edit": {
                    "id": "writers_edit",
                    "role": "writer",
                    "resource": {
                      "object": "note"
                    },
                    "actions": [
                      "update"
                    ],
                    "condition": {
                      "is-null": {
                        "var": {
                          "scope": "new",
                          "field": "published_at"
                        }
                      }
                    }
                  }
                }
              }
            },
            "principal": {
              "user": "alpha:writer1"
            },
            "role": "editor"
          },
          "result": {
            "rule": "permission:confer:editor",
            "passed": false,
            "detail": "lacks 1 of the 1 permissions that role editor grants: policy editors_update: Update on Object(ObjectTypeId(\"note\"))"
          }
        }
      ]
    },
    {
      "id": "require-conferrable",
      "description": "transition.rs require_conferrable (ADM-152): every role must be one the acting principal may confer (may-confer). Each check is evidence, in the order of the roles; the first role it may not confer refuses the intent as Unauthorized.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "roles",
          "type": "list<role-id>"
        }
      ],
      "returns": "draft",
      "errors": "rejection",
      "let": [
        {
          "name": "added",
          "expr": "fold(r in roles, acc = [], if any(c in acc, !c.passed) then acc else concat(acc, [call may-confer(d.tenant, d.ctx.principal, r)]))"
        },
        {
          "name": "evidence",
          "expr": "concat(d.evidence, added)"
        },
        {
          "name": "refused",
          "expr": "find(r in roles, !(call may-confer(d.tenant, d.ctx.principal, r)).passed)"
        }
      ],
      "body": "match refused { Some(r) => fail(call draft-reject(evidence, error-kind.unauthorized, format('may not confer role {}: {}', r, (call may-confer(d.tenant, d.ctx.principal, r)).detail))), None => draft{tenant: d.tenant, ctx: d.ctx, coverage: d.coverage, ops: d.ops, events: d.events, effects: d.effects, evidence: evidence, next-record: d.next-record} }",
      "examples": [
