  "functions": [
    {
      "id": "set-of",
      "description": "A BTreeSet<RoleId> as the body language holds it: the items sorted by Unicode scalar values, each once.",
      "params": [
        {
          "name": "items",
          "type": "list<role-id>"
        }
      ],
      "returns": "set<role-id>",
      "body": "fold(r in sortBy(r in items, r), acc = [], if any(a in acc, a == r) then acc else concat(acc, [r]))",
      "examples": [
        {
          "args": {
            "items": [
              "author",
              "public",
              "author"
            ]
          },
          "result": [
            "author",
            "public"
          ]
        },
        {
          "args": {
            "items": []
          },
          "result": []
        }
      ]
    },
    {
      "id": "roles-of",
      "description": "crates/kernel/src/rules.rs roles_of: the roles a principal holds in a tenant. The system holds none; everyone else holds public, a user also the roles of its membership.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "principal",
          "type": "principal"
        }
      ],
      "returns": "set<role-id>",
      "body": "match principal { system => [], anonymous => ['public'], user(id) => call set-of(concat(match get(tenant.members, id) { None => [], Some(roles) => roles }, ['public'])) }",
      "examples": [
        {
          "description": "The system holds no role.",
          "args": {
            "tenant": {
              "id": "gazette",
              "name": "Gazette",
              "revision": 0,
              "next-record": 7,
              "event-seq": 0,
              "schema": {
                "version": 1,
                "objects": {},
                "roles": {},
                "policies": {
                  "authors_own_posts": {
                    "id": "authors_own_posts",
                    "role": "author",
                    "resource": {
                      "object": "post"
                    },
                    "actions": [
                      "read",
                      "update",
                      "delete"
                    ],
                    "condition": {
                      "cmp": {
                        "op": "eq",
                        "left": {
                          "var": {
                            "scope": "record",
                            "field": "$created_by"
                          }
                        },
                        "right": "principal"
                      }
                    }
                  },
                  "authors_write_posts": {
                    "id": "authors_write_posts",
                    "role": "author",
                    "resource": {
                      "object": "post"
                    },
                    "actions": [
                      "create"
                    ],
                    "condition": {
                      "cmp": {
                        "op": "eq",
                        "left": {
                          "through": {
                            "scope": "new",
                            "reference": "author",
                            "field": "principal"
                          }
                        },
                        "right": "principal"
                      }
                    }
                  },
                  "editors_run_authors": {
                    "id": "editors_run_authors",
                    "role": "editor",
                    "resource": {
                      "object": "author"
                    },
