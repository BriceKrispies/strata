    {
      "id": "section-depends",
      "description": "project.rs section_order, depends: whether a section reads an attribute of another section's row.",
      "params": [
        {
          "name": "section",
          "type": "view-section"
        }
      ],
      "returns": "bool",
      "body": "any(a in values(section.args), match a { section => true, _ => false })",
      "examples": [
        {
          "args": {
            "section": {
              "query": "by_title",
              "args": {
                "title": {
                  "section": {
                    "section": "z_top",
                    "attribute": "title"
                  }
                }
              },
              "include": [],
              "markdown": [],
              "single": true
            }
          },
          "result": true
        },
        {
          "args": {
            "section": {
              "query": "published",
              "args": {},
              "include": [
                "author"
              ],
              "markdown": [],
              "single": false
            }
          },
          "result": false
        }
      ]
    },
    {
      "id": "section-order",
      "description": "crates/substrate/src/project.rs section_order: the section names in evaluation order, those that read no other section first, each group in name order. A section may read only a section that reads none (schema-problems).",
      "params": [
        {
          "name": "view",
          "type": "view-def"
        }
      ],
      "returns": "list<string>",
      "body": "concat(filter(n in keys(view.sections), match get(view.sections, n) { Some(s) => !call section-depends(s), None => false }), filter(n in keys(view.sections), match get(view.sections, n) { Some(s) => call section-depends(s), None => false }))",
      "examples": [
        {
          "description": "A section that reads another comes after the sections that read none.",
          "args": {
            "view": {
              "id": "feed",
              "route": "/",
              "title": "Feed",
              "sections": {
                "a_lead": {
                  "query": "by_title",
                  "args": {
                    "title": {
                      "section": {
                        "section": "z_top",
                        "attribute": "title"
                      }
                    }
                  },
                  "include": [],
                  "markdown": [],
                  "single": true
                },
                "z_top": {
                  "query": "newest",
                  "args": {},
                  "include": [],
                  "markdown": [],
                  "single": true
                }
              }
            }
          },
          "result": [
            "z_top",
            "a_lead"
          ]
        },
        {
          "args": {
            "view": {
              "id": "home",
              "route": "/",
              "title": "Home",
              "sections": {
                "posts": {
                  "query": "published",
                  "args": {},
                  "include": [
                    "author"
                  ],
                  "markdown": [],
                  "single": false
                }
              }
            }
          },
          "result": [
            "posts"
          ]
        }
      ]
    },
    {
      "id": "text-value",
      "description": "project.rs section_request, text: a route or request parameter as a string value, null when absent.",
      "params": [
        {
          "name": "text",
          "type": "option<string>"
        }
      ],
      "returns": "value",
      "body": "match text { Some(s) => value.str(s), None => call null-value() }",
      "examples": [
        {
          "args": {
            "text": "B"
          },
          "result": {
            "str": "B"
          }
        },
        {
          "args": {
            "text": null
          },
          "result": "null"
        }
      ]
    },
    {
      "id": "section-request",
      "description": "crates/substrate/src/project.rs section_request: the named read of a section, each argument (in name order) from a route parameter, a request parameter (each a string, null when absent), a constant, or an attribute of the single row of a section already evaluated (record-attribute; null when that section had no row).",
      "params": [
        {
          "name": "section",
          "type": "view-section"
        },
        {
          "name": "route",
          "type": "map<string, string>"
        },
        {
          "name": "request",
          "type": "map<string, string>"
        },
        {
          "name": "done",
          "type": "map<string, option<record>>"
        }
      ],
      "returns": "read-request",
      "body": "read-request.named{query: section.query, params: fold(k in keys(section.args), m = {}, match get(section.args, k) { None => m, Some(src) => insert(m, k, match src { route(key) => call text-value(get(route, key)), request(key) => call text-value(get(request, key)), const(x) => x, section{section: from, attribute} => match get(done, from) { Some(row) => match row { Some(r) => call record-attribute(r, attribute), None => call null-value() }, None => call null-value() } }) })}",
      "examples": [
        {
          "args": {
            "section": {
              "query": "by_title",
              "args": {
                "title": {
                  "route": "title"
                }
              },
              "include": [],
              "markdown": [],
              "single": true
            },
            "route": {
              "title": "B"
            },
            "request": {},
            "done": {}
          },
          "result": {
            "named": {
              "query": "by_title",
              "params": {
                "title": {
                  "str": "B"
                }
              }
            }
          }
        },
        {
          "description": "publication_template.rs a_dependent_section_reads_through_the_single_row_it_depends_on.",
          "args": {
            "section": {
              "query": "by_title",
              "args": {
                "title": {
                  "section": {
                    "section": "z_top",
                    "attribute": "title"
                  }
                }
              },
              "include": [],
              "markdown": [],
              "single": true
            },
            "route": {},
            "request": {},
            "done": {
              "z_top": {
                "id": 4,
                "object": "post",
                "version": 1,
                "created-by": "alpha:owner",
                "created-at": 2002,
                "updated-at": 2002,
                "fields": {
                  "status": {
                    "str": "published"
                  },
                  "title": {
                    "str": "C"
                  }
                }
              }
            }
          },
          "result": {
            "named": {
              "query": "by_title",
              "params": {
                "title": {
                  "str": "C"
                }
              }
            }
          }
        },
        {
          "description": "A section read before had no row.",
          "args": {
            "section": {
              "query": "by_title",
              "args": {
                "title": {
                  "section": {
                    "section": "z_top",
                    "attribute": "title"
                  }
                }
              },
              "include": [],
              "markdown": [],
              "single": true
            },
            "route": {},
            "request": {},
            "done": {
              "z_top": null
            }
          },
          "result": {
            "named": {
              "query": "by_title",
              "params": {
                "title": "null"
              }
            }
          }
        }
      ]
    },
    {
      "id": "field-value",
      "description": "state.rs Record::get: a field's value, null when unset.",
      "params": [
        {
          "name": "r",
          "type": "record"
        },
        {
          "name": "field",
          "type": "field-id"
        }
      ],
      "returns": "value",
      "body": "match get(r.fields, field) { Some(x) => x, None => call null-value() }",
      "examples": [
        {
          "args": {
            "r": {
              "id": 2,
              "object": "post",
              "version": 1,
              "created-by": "alpha:writer",
              "created-at": 2000,
              "updated-at": 2000,
              "fields": {
                "author": {
                  "ref": 1
                },
                "status": {
                  "str": "published"
                },
                "title": {
                  "str": "B"
                }
              }
            },
            "field": "author"
          },
          "result": {
            "ref": 1
          }
        },
        {
          "args": {
            "r": {
              "id": 3,
              "object": "post",
              "version": 1,
              "created-by": "alpha:writer",
              "created-at": 2001,
              "updated-at": 2001,
              "fields": {
                "status": {
                  "str": "draft"
                },
                "title": {
                  "str": "A"
                }
              }
            },
            "field": "author"
          },
          "result": "null"
        }
      ]
    },
    {
      "id": "id-set",
      "description": "A BTreeSet<RecordId> collected into a list: each id once, in order.",
      "params": [
        {
          "name": "ids",
          "type": "list<record-id>"
        }
      ],
      "returns": "list<record-id>",
      "body": "fold(i in sortBy(i in ids, i), acc = [], if any(a in acc, a == i) then acc else concat(acc, [i]))",
      "examples": [
        {
          "args": {
            "ids": [
              3,
              1,
              3
            ]
          },
          "result": [
            1,
            3
          ]
        }
      ]
    },
    {
      "id": "included-refs",
      "description": "crates/substrate/src/project.rs included_refs: for each included field of the section that refers to an object type, the record ids the rows name in it (a reference, or the references of a list), each once, in order.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "section",
          "type": "view-section"
        },
        {
          "name": "rows",
          "type": "list<record>"
        }
      ],
      "returns": "map<field-id, included-target>",
      "body": "match get(schema.objects, object) { None => {}, Some(def) => fold(f in section.include, out = {}, match get(def.fields, f) { None => out, Some(fd) => match call ref-target(fd.ty) { None => out, Some(target) => insert(out, f, included-target{object: target, ids: call id-set(fold(r in rows, ids = [], concat(ids, call refs-in(call field-value(r, f)))))}) } }) }",
      "examples": [
        {
          "description": "A field that is not a reference includes nothing.",
          "args": {
            "schema": {
              "version": 2,
              "objects": {
                "person": {
                  "id": "person",
                  "label": "Person",
                  "fields": {
                    "name": {
                      "id": "name",
                      "label": "name",
                      "ty": "str",
                      "required": true,
                      "unique": false
                    }
                  },
                  "constraints": {}
