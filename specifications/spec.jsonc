    {
      "id": "initial-checks",
      "description": "transition.rs create_record, the workflows of the object type (in id order): the field must hold a string that is an initial state (workflow:<id>:initial, \"starts in <state>\").",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "candidate",
          "type": "record"
        }
      ],
      "returns": "draft",
      "errors": "rejection",
      "body": "fold(w in filter(w in values(d.tenant.schema.workflows), w.object == object), acc = d, let x = match get(candidate.fields, w.field) { Some(y) => y, None => call null-value() } in match x { str(s) => if any(i in w.initial, i == s) then draft{tenant: acc.tenant, ctx: acc.ctx, coverage: acc.coverage, ops: acc.ops, events: acc.events, effects: acc.effects, evidence: concat(acc.evidence, [check{rule: format('workflow:{}:initial', w.id), passed: true, detail: format('starts in {}', s)}]), next-record: acc.next-record} else fail(call initial-refusal(acc, w, x)), _ => fail(call initial-refusal(acc, w, x)) })",
