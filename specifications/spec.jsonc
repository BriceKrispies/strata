              "workflows": {
                "note_status": {
                  "id": "note_status",
                  "object": "note",
                  "field": "status",
                  "initial": [
                    "draft"
                  ],
                  "transitions": [
                    {
                      "name": "publish",
                      "from": "draft",
                      "to": "published",
                      "guard": {
                        "cmp": {
                          "op": "eq",
                          "left": {
                            "var": {
                              "scope": "old",
                              "field": "$created_by"
                            }
                          },
                          "right": "principal"
                        }
                      },
                      "set": {
                        "published_at": "now"
                      }
                    },
                    {
                      "name": "unpublish",
                      "from": "published",
                      "to": "draft",
                      "set": {
                        "published_at": {
                          "lit": "null"
                        }
                      }
                    }
                  ]
                }
