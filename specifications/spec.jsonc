    {
      "id": "lease-reach-flow",
      "name": "Lease and reach of the tenant database",
      "subject": "automation-worker",
      "initial": "lr-live",
      "description": "One job and one worker. The worker takes a lease on a due job only while it can reach the tenant database of the job; while it cannot, the job stays for another worker.",
      "variables": [
        {
          "name": "token",
          "type": "number",
          "initial": 0
        },
        {
          "name": "reachable",
          "type": "boolean",
          "initial": true
        }
      ],
      "states": [
        {
          "id": "lr-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "lr-grant-unreachable",
          "from": "lr-live",
          "to": "lr-live",
          "on": "lr-job-due",
          "description": "Defect: takes a lease although the tenant database cannot be reached.",
          "guard": "!reachable",
          "faultOnly": true,
          "effects": [
            {
              "set": "token",
              "to": "token + 1"
            },
            {
              "emit": "lr-lease-granted"
            }
          ]
        },
        {
          "id": "lr-grant",
          "from": "lr-live",
          "to": "lr-live",
          "on": "lr-job-due",
          "guard": "reachable",
          "effects": [
            {
              "set": "token",
              "to": "token + 1"
            },
            {
              "emit": "lr-lease-granted"
            }
          ]
        },
        {
          "id": "lr-skip",
          "from": "lr-live",
          "to": "lr-live",
          "on": "lr-job-due",
          "guard": "!reachable",
          "effects": [
            {
              "emit": "lr-lease-skipped"
            }
          ]
        },
        {
          "id": "lr-lose-database",
          "from": "lr-live",
          "to": "lr-live",
          "on": "lr-unreachable",
          "effects": [
            {
              "set": "reachable",
              "to": false
            }
          ]
        },
        {
          "id": "lr-regain-database",
          "from": "lr-live",
          "to": "lr-live",
          "on": "lr-reachable",
          "effects": [
            {
              "set": "reachable",
              "to": true
            }
          ]
        }
      ]
    },
    {
      "id": "lease-reach-flow-impl",
      "name": "Lease and reach of the tenant database (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "lease-reach-flow",
      "description": "One job and one worker. The worker takes a lease on a due job only while it can reach the tenant database of the job; while it cannot, the job stays for another worker.",
      "initial": "lr-live-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "token",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "reachable",
          "type": "boolean",
          "initial": true,
          "repr": "bool"
        }
      ],
      "states": [
        {
          "id": "lr-live-i",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "lr-grant-i",
          "from": "lr-live-i",
          "to": "lr-live-i",
          "on": "lr-job-due",
          "guard": "reachable",
          "effects": [
            {
              "set": "token",
              "to": "token + 1"
            },
            {
              "emit": "lr-lease-granted",
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "lr-skip-i",
          "from": "lr-live-i",
          "to": "lr-live-i",
          "on": "lr-job-due",
          "guard": "!reachable",
          "effects": [
            {
              "emit": "lr-lease-skipped",
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "lr-lose-database-i",
          "from": "lr-live-i",
          "to": "lr-live-i",
          "on": "lr-unreachable",
          "otherwise": true,
          "effects": [
            {
              "set": "reachable",
              "to": false
            }
          ]
        },
        {
          "id": "lr-regain-database-i",
          "from": "lr-live-i",
          "to": "lr-live-i",
          "on": "lr-reachable",
          "otherwise": true,
          "effects": [
            {
              "set": "reachable",
              "to": true
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "lr-live-i": "lr-live"
        },
        "variables": {
          "token": "token",
          "reachable": "reachable"
        },
        "transitions": {
          "lr-grant-i": "lr-grant",
          "lr-skip-i": "lr-skip",
          "lr-lose-database-i": "lr-lose-database",
          "lr-regain-database-i": "lr-regain-database"
        }
      },
      "storage": {
        "record": "rec-lease-attempt",
        "key": "job-id",
        "creates": true
      },
      "realisation": "target"
    },
    {
      "id": "job-admission-flow",
      "name": "Job admission",
      "subject": "automation-worker",
      "initial": "ad-live",
      "description": "The due jobs of one tenant are released to workers at the admission rate of 100 jobs a minute (D-700). A burst waits in a backlog that is released once a minute, 100 jobs at most. A due job of another tenant is released to a worker at once and never waits behind the backlog, so its start stays within the start budget. A tick is a second; the budget is modelled as the 5 seconds of SCH-002.",
      "variables": [
        {
          "name": "backlog",
          "type": "number",
          "initial": 0
        },
        {
          "name": "released",
          "type": "number",
          "initial": 0
        },
        {
          "name": "batch",
          "type": "number",
          "initial": 0
        },
        {
          "name": "rate",
          "type": "number",
          "initial": 100
        },
        {
          "name": "ticking",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "otherDueAt",
          "type": "number",
          "initial": 0
        },
        {
          "name": "otherStartedAt",
          "type": "number",
          "initial": 0
        },
        {
          "name": "budget",
          "type": "number",
          "initial": 5
        }
      ],
      "states": [
        {
          "id": "ad-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "ad-burst-first",
          "from": "ad-live",
          "to": "ad-live",
          "on": "ad-burst",
          "guard": "!ticking",
          "effects": [
            {
              "set": "backlog",
              "to": "backlog + event.jobs"
            },
            {
              "set": "ticking",
              "to": true
            },
            {
              "emit": "ad-tick",
              "after": 60
            }
          ]
        },
        {
          "id": "ad-burst-more",
          "from": "ad-live",
          "to": "ad-live",
          "on": "ad-burst",
          "effects": [
            {
              "set": "backlog",
              "to": "backlog + event.jobs"
            }
          ]
        },
        {
          "id": "ad-release-all",
          "from": "ad-live",
          "to": "ad-live",
          "on": "ad-tick",
          "description": "Defect: releases the whole backlog at once.",
          "guard": "backlog > 0",
          "faultOnly": true,
          "effects": [
            {
              "set": "released",
              "to": "released + backlog"
            },
            {
              "set": "batch",
              "to": "backlog"
            },
            {
              "set": "backlog",
              "to": 0
            },
            {
              "set": "ticking",
              "to": false
            }
          ]
        },
        {
          "id": "ad-release-full",
          "from": "ad-live",
          "to": "ad-live",
          "on": "ad-tick",
          "guard": "backlog > rate",
          "effects": [
            {
              "set": "released",
              "to": "released + rate"
            },
            {
              "set": "batch",
              "to": "rate"
            },
            {
              "set": "backlog",
              "to": "backlog - rate"
            },
            {
              "emit": "ad-tick",
              "after": 60
            }
          ]
        },
        {
          "id": "ad-release-rest",
          "from": "ad-live",
          "to": "ad-live",
          "on": "ad-tick",
          "guard": "backlog > 0",
          "effects": [
            {
              "set": "released",
              "to": "released + backlog"
            },
            {
              "set": "batch",
              "to": "backlog"
            },
            {
              "set": "backlog",
              "to": 0
            },
            {
              "set": "ticking",
              "to": false
            }
          ]
        },
        {
          "id": "ad-idle",
          "from": "ad-live",
          "to": "ad-live",
          "on": "ad-tick",
          "effects": [
            {
              "set": "ticking",
              "to": false
            }
          ]
        },
        {
          "id": "ad-other-queued",
          "from": "ad-live",
          "to": "ad-live",
          "on": "ad-other-due",
          "description": "Defect: the job of another tenant is released behind the backlog.",
          "faultOnly": true,
          "effects": [
            {
              "set": "otherDueAt",
              "to": "time"
            },
            {
              "set": "otherStartedAt",
              "to": "time + backlog * 60 / rate"
            },
            {
              "emit": "ad-other-started"
            }
          ]
        },
        {
          "id": "ad-other-started-t",
          "from": "ad-live",
          "to": "ad-live",
          "on": "ad-other-due",
          "effects": [
            {
              "set": "otherDueAt",
              "to": "time"
            },
            {
              "set": "otherStartedAt",
              "to": "time"
            },
            {
              "emit": "ad-other-started"
            }
          ]
        }
      ]
    },
    {
      "id": "job-admission-flow-impl",
      "name": "Job admission (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "job-admission-flow",
      "description": "The job admission of one tenant (rec-job-admission, keyed by tenant-id). The backlog of due jobs is released once a minute, at most the admission rate of 100 jobs; a job of another tenant is started at the moment it is due. Times are in milliseconds.",
      "initial": "ad-live-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "backlog",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "released",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "batch",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "rate",
          "type": "number",
          "initial": 100,
          "repr": "u64"
        },
        {
          "name": "ticking",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "otherDueAt",
          "type": "number",
          "initial": 0,
          "repr": "timestamp"
        },
        {
          "name": "otherStartedAt",
          "type": "number",
          "initial": 0,
          "repr": "timestamp"
        },
        {
          "name": "budget",
          "type": "number",
          "initial": 5000,
          "repr": "duration"
        }
      ],
      "states": [
        {
          "id": "ad-live-i",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "ad-burst-first-i",
          "from": "ad-live-i",
          "to": "ad-live-i",
          "on": "ad-burst",
          "guard": "!ticking",
          "effects": [
            {
              "set": "backlog",
              "to": "backlog + event.jobs"
            },
            {
              "set": "ticking",
              "to": true
            },
            {
              "emit": "ad-tick",
              "after": 60000,
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "ad-burst-more-i",
          "from": "ad-live-i",
          "to": "ad-live-i",
          "on": "ad-burst",
          "otherwise": true,
          "effects": [
            {
              "set": "backlog",
              "to": "backlog + event.jobs"
            }
          ]
        },
        {
          "id": "ad-release-full-i",
          "from": "ad-live-i",
          "to": "ad-live-i",
          "on": "ad-tick",
          "guard": "backlog > rate",
          "effects": [
            {
              "set": "released",
              "to": "released + rate"
            },
            {
              "set": "batch",
              "to": "rate"
            },
            {
              "set": "backlog",
              "to": "backlog - rate"
            },
            {
              "emit": "ad-tick",
              "after": 60000,
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "ad-release-rest-i",
          "from": "ad-live-i",
          "to": "ad-live-i",
          "on": "ad-tick",
          "guard": "backlog > 0",
          "effects": [
            {
              "set": "released",
              "to": "released + backlog"
            },
            {
              "set": "batch",
              "to": "backlog"
            },
            {
              "set": "backlog",
              "to": 0
            },
            {
              "set": "ticking",
              "to": false
            }
          ]
        },
        {
          "id": "ad-idle-i",
          "from": "ad-live-i",
          "to": "ad-live-i",
          "on": "ad-tick",
          "otherwise": true,
          "effects": [
            {
              "set": "ticking",
              "to": false
            }
          ]
        },
        {
          "id": "ad-other-started-t-i",
          "from": "ad-live-i",
          "to": "ad-live-i",
          "on": "ad-other-due",
          "otherwise": true,
          "effects": [
            {
              "set": "otherDueAt",
              "to": "time"
            },
            {
              "set": "otherStartedAt",
              "to": "time"
            },
            {
              "emit": "ad-other-started",
              "to": "automation-worker"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "ad-live-i": "ad-live"
        },
        "variables": {
          "backlog": "backlog",
          "released": "released",
          "batch": "batch",
          "rate": "rate",
          "ticking": "ticking",
          "otherDueAt": "otherDueAt / 1000",
          "otherStartedAt": "otherStartedAt / 1000",
          "budget": "budget / 1000"
        },
        "transitions": {
          "ad-burst-first-i": "ad-burst-first",
          "ad-burst-more-i": "ad-burst-more",
          "ad-release-full-i": "ad-release-full",
          "ad-release-rest-i": "ad-release-rest",
          "ad-idle-i": "ad-idle",
          "ad-other-started-t-i": "ad-other-started-t"
        },
        "timeScale": 1000
      },
      "storage": {
        "record": "rec-job-admission",
        "key": "tenant-id",
        "fields": {
          "otherDueAt": "other-due-at",
          "otherStartedAt": "other-started-at"
        },
        "creates": true
      },
      "realisation": "target"
    },
    {
      "id": "wake-flow",
      "name": "Wake scan",
      "subject": "automation-worker",
      "initial": "wk-live",
      "description": "The worker scans the wake index for tenants with due work. It queries the tenant database of a tenant that has an entry in the index and queries no other.",
      "variables": [
        {
          "name": "scans",
          "type": "number",
          "initial": 0
        },
        {
          "name": "awakeScans",
          "type": "number",
          "initial": 0
        },
        {
          "name": "queries",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "wk-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "wk-query-idle-tenant",
          "from": "wk-live",
          "to": "wk-live",
          "on": "wk-scan",
          "description": "Defect: queries the database of a tenant that has no entry.",
          "guard": "!event.awake",
          "faultOnly": true,
          "effects": [
            {
              "set": "scans",
              "to": "scans + 1"
            },
            {
              "set": "queries",
              "to": "queries + 1"
            },
            {
              "emit": "wk-query"
            }
          ]
        },
        {
          "id": "wk-scan-awake",
          "from": "wk-live",
          "to": "wk-live",
          "on": "wk-scan",
          "guard": "event.awake",
          "effects": [
            {
              "set": "scans",
              "to": "scans + 1"
            },
            {
              "set": "awakeScans",
              "to": "awakeScans + 1"
            },
            {
              "set": "queries",
              "to": "queries + 1"
            },
            {
              "emit": "wk-query"
            }
          ]
        },
        {
          "id": "wk-scan-idle",
          "from": "wk-live",
          "to": "wk-live",
          "on": "wk-scan",
          "effects": [
            {
              "set": "scans",
              "to": "scans + 1"
            }
          ]
        }
      ]
    },
    {
      "id": "wake-flow-impl",
      "name": "Wake scan (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "wake-flow",
      "description": "The worker scans the wake index for tenants with due work. It queries the tenant database of a tenant that has an entry in the index and queries no other.",
      "initial": "wk-live-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "scans",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "awakeScans",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "queries",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        }
      ],
      "states": [
        {
          "id": "wk-live-i",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "wk-scan-awake-i",
          "from": "wk-live-i",
          "to": "wk-live-i",
          "on": "wk-scan",
          "guard": "event.awake",
          "effects": [
            {
              "set": "scans",
              "to": "scans + 1"
            },
            {
              "set": "awakeScans",
              "to": "awakeScans + 1"
            },
            {
              "set": "queries",
              "to": "queries + 1"
            },
            {
              "emit": "wk-query",
              "to": "tenant-database"
            }
          ]
        },
        {
          "id": "wk-scan-idle-i",
          "from": "wk-live-i",
          "to": "wk-live-i",
          "on": "wk-scan",
          "otherwise": true,
          "effects": [
            {
              "set": "scans",
              "to": "scans + 1"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "wk-live-i": "wk-live"
        },
        "variables": {
          "scans": "scans",
          "awakeScans": "awakeScans",
          "queries": "queries"
        },
        "transitions": {
          "wk-scan-awake-i": "wk-scan-awake",
          "wk-scan-idle-i": "wk-scan-idle"
        }
      },
      "storage": {
        "record": "rec-wake-scan",
        "key": "scan-id",
        "fields": {
          "awakeScans": "awake-scans"
        },
        "creates": true
      },
      "realisation": "target"
    },
    {
      "id": "bulk-change-flow",
      "name": "Bulk change",
      "subject": "automation-worker",
      "initial": "bk-running",
      "description": "One bulk job over many records. Each record it processes has its outcome recorded in the same step, success or failure, so when the job stops the recorded outcomes are exactly the records it touched.",
      "variables": [
        {
          "name": "processed",
          "type": "number",
          "initial": 0
        },
        {
          "name": "recorded",
          "type": "number",
          "initial": 0
        },
        {
          "name": "failed",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "bk-running",
          "name": "Running"
        },
        {
          "id": "bk-stopped",
          "name": "Stopped"
        }
      ],
      "transitions": [
        {
          "id": "bk-process-unrecorded",
          "from": "bk-running",
          "to": "bk-running",
          "on": "bk-process",
          "description": "Defect: the outcome of a record that changed is not recorded.",
          "guard": "event.ok",
          "faultOnly": true,
          "effects": [
            {
              "set": "processed",
              "to": "processed + 1"
            }
          ]
        },
        {
          "id": "bk-process-ok",
          "from": "bk-running",
          "to": "bk-running",
          "on": "bk-process",
          "guard": "event.ok",
          "effects": [
            {
              "set": "processed",
              "to": "processed + 1"
            },
            {
              "set": "recorded",
              "to": "recorded + 1"
            },
            {
              "emit": "bk-outcome-recorded"
            }
          ]
        },
        {
          "id": "bk-process-failed",
          "from": "bk-running",
          "to": "bk-running",
          "on": "bk-process",
          "effects": [
            {
              "set": "processed",
              "to": "processed + 1"
            },
            {
              "set": "recorded",
              "to": "recorded + 1"
            },
            {
              "set": "failed",
              "to": "failed + 1"
            },
            {
              "emit": "bk-outcome-recorded"
            }
          ]
        },
        {
          "id": "bk-interrupt-t",
          "from": "bk-running",
          "to": "bk-stopped",
          "on": "bk-interrupt",
          "effects": []
        },
        {
          "id": "bk-resume-t",
          "from": "bk-stopped",
          "to": "bk-running",
          "on": "bk-resume",
          "effects": []
        }
      ]
    },
    {
      "id": "bulk-change-flow-impl",
      "name": "Bulk change (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "bulk-change-flow",
      "description": "One bulk job over many records. Each record it processes has its outcome recorded in the same step, success or failure, so when the job stops the recorded outcomes are exactly the records it touched.",
      "initial": "bk-running-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "processed",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "recorded",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "failed",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        }
      ],
      "states": [
        {
          "id": "bk-running-i",
          "name": "Running",
          "ignores": [
            "bk-resume"
          ]
        },
        {
          "id": "bk-stopped-i",
          "name": "Stopped",
          "ignores": [
            "bk-process",
            "bk-interrupt"
          ]
        }
      ],
      "transitions": [
        {
          "id": "bk-process-ok-i",
          "from": "bk-running-i",
          "to": "bk-running-i",
          "on": "bk-process",
          "guard": "event.ok",
          "effects": [
            {
              "set": "processed",
              "to": "processed + 1"
            },
            {
              "set": "recorded",
              "to": "recorded + 1"
            },
            {
              "emit": "bk-outcome-recorded",
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "bk-process-failed-i",
          "from": "bk-running-i",
          "to": "bk-running-i",
          "on": "bk-process",
          "otherwise": true,
          "effects": [
            {
              "set": "processed",
              "to": "processed + 1"
            },
            {
              "set": "recorded",
              "to": "recorded + 1"
            },
            {
              "set": "failed",
              "to": "failed + 1"
            },
            {
              "emit": "bk-outcome-recorded",
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "bk-interrupt-t-i",
          "from": "bk-running-i",
          "to": "bk-stopped-i",
          "on": "bk-interrupt",
          "otherwise": true,
          "effects": []
        },
        {
          "id": "bk-resume-t-i",
          "from": "bk-stopped-i",
          "to": "bk-running-i",
          "on": "bk-resume",
          "otherwise": true,
          "effects": []
        }
      ],
      "refinement": {
        "states": {
          "bk-running-i": "bk-running",
          "bk-stopped-i": "bk-stopped"
        },
        "variables": {
          "processed": "processed",
          "recorded": "recorded",
          "failed": "failed"
        },
        "transitions": {
          "bk-process-ok-i": "bk-process-ok",
          "bk-process-failed-i": "bk-process-failed",
          "bk-interrupt-t-i": "bk-interrupt-t",
          "bk-resume-t-i": "bk-resume-t"
        }
      },
      "storage": {
        "record": "rec-bulk-change",
        "key": "job-id",
        "stateValues": {
          "bk-running-i": "running",
          "bk-stopped-i": "stopped"
        },
        "creates": true
      },
      "realisation": "target"
    },
    {
      "id": "workflow-definition-flow",
      "name": "Workflow definition schema version",
      "subject": "automation-worker",
      "initial": "wd-live",
      "description": "One workflow definition, stored as tenant metadata. Saving it stamps it with the schema version in force, and a schema migration re-stamps it with the new version, so a stored definition is always under the current schema version.",
      "variables": [
        {
          "name": "schemaNow",
          "type": "number",
          "initial": 1
        },
        {
          "name": "saved",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "savedUnder",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "wd-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "wd-save-unversioned",
          "from": "wd-live",
          "to": "wd-live",
          "on": "wd-save",
          "description": "Defect: stores the definition without the schema version.",
          "faultOnly": true,
          "effects": [
            {
              "set": "saved",
              "to": true
            }
          ]
        },
        {
          "id": "wd-save-t",
          "from": "wd-live",
          "to": "wd-live",
          "on": "wd-save",
          "effects": [
            {
              "set": "saved",
              "to": true
            },
            {
              "set": "savedUnder",
              "to": "schemaNow"
            }
          ]
        },
        {
          "id": "wd-migrate-skips-definition",
          "from": "wd-live",
          "to": "wd-live",
          "on": "wd-migrate",
          "description": "Defect: a migration leaves the stored definition under the old version.",
          "guard": "saved",
          "faultOnly": true,
          "effects": [
            {
              "set": "schemaNow",
              "to": "event.version"
            }
          ]
        },
        {
          "id": "wd-migrate-saved",
          "from": "wd-live",
          "to": "wd-live",
          "on": "wd-migrate",
          "guard": "saved",
          "effects": [
            {
              "set": "schemaNow",
              "to": "event.version"
            },
            {
              "set": "savedUnder",
              "to": "event.version"
            }
          ]
        },
        {
          "id": "wd-migrate-unsaved",
          "from": "wd-live",
          "to": "wd-live",
          "on": "wd-migrate",
          "effects": [
            {
              "set": "schemaNow",
              "to": "event.version"
            }
          ]
        }
      ]
    },
    {
      "id": "workflow-definition-flow-impl",
      "name": "Workflow definition schema version (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "workflow-definition-flow",
      "description": "One workflow definition, stored as tenant metadata. Saving it stamps it with the schema version in force, and a schema migration re-stamps it with the new version, so a stored definition is always under the current schema version.",
      "initial": "wd-live-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "schemaNow",
          "type": "number",
          "initial": 1,
          "repr": "u64"
        },
        {
          "name": "saved",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "savedUnder",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        }
      ],
      "states": [
        {
          "id": "wd-live-i",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "wd-save-t-i",
          "from": "wd-live-i",
          "to": "wd-live-i",
          "on": "wd-save",
          "otherwise": true,
          "effects": [
            {
              "set": "saved",
              "to": true
            },
            {
              "set": "savedUnder",
              "to": "schemaNow"
            }
          ]
        },
        {
          "id": "wd-migrate-saved-i",
          "from": "wd-live-i",
          "to": "wd-live-i",
          "on": "wd-migrate",
          "guard": "saved",
          "effects": [
            {
              "set": "schemaNow",
              "to": "event.version"
            },
            {
              "set": "savedUnder",
              "to": "event.version"
            }
          ]
        },
        {
          "id": "wd-migrate-unsaved-i",
          "from": "wd-live-i",
          "to": "wd-live-i",
          "on": "wd-migrate",
          "otherwise": true,
          "effects": [
            {
              "set": "schemaNow",
              "to": "event.version"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "wd-live-i": "wd-live"
        },
        "variables": {
          "schemaNow": "schemaNow",
          "saved": "saved",
          "savedUnder": "savedUnder"
        },
        "transitions": {
          "wd-save-t-i": "wd-save-t",
          "wd-migrate-saved-i": "wd-migrate-saved",
          "wd-migrate-unsaved-i": "wd-migrate-unsaved"
        }
      },
      "storage": {
        "record": "rec-workflow-definition",
        "key": "workflow-id",
        "fields": {
          "schemaNow": "schema-now",
          "savedUnder": "saved-under"
        },
        "creates": true
      },
      "realisation": "target"
    },
    {
      "id": "workflow-activation-flow",
      "name": "Workflow activation",
      "subject": "automation-worker",
      "initial": "wa-draft",
      "description": "One workflow definition in draft. A projection of it can be run. Activation is refused until a projection has run, and refused when the definition names a trigger or action outside the published catalogue.",
      "variables": [
        {
          "name": "projections",
          "type": "number",
          "initial": 0
        },
        {
          "name": "catalogued",
          "type": "boolean",
          "initial": false
        }
      ],
      "states": [
        {
          "id": "wa-draft",
          "name": "Draft"
        },
        {
          "id": "wa-active",
          "name": "Active"
        }
      ],
      "transitions": [
        {
          "id": "wa-project-t",
          "from": "wa-draft",
          "to": "wa-draft",
          "on": "wa-project",
          "effects": [
            {
              "set": "projections",
              "to": "projections + 1"
            }
          ]
        },
        {
          "id": "wa-activate-unprojected",
          "from": "wa-draft",
          "to": "wa-active",
          "on": "wa-activate",
          "description": "Defect: activates a definition that no projection has covered.",
          "guard": "projections == 0",
          "faultOnly": true,
          "effects": [
            {
              "set": "catalogued",
              "to": "event.inCatalogue"
            },
            {
              "emit": "wa-activated"
            }
          ]
        },
        {
          "id": "wa-activate-uncatalogued",
          "from": "wa-draft",
          "to": "wa-active",
          "on": "wa-activate",
          "description": "Defect: activates a definition that names something outside the catalogue.",
          "guard": "!event.inCatalogue",
          "faultOnly": true,
          "effects": [
            {
              "set": "catalogued",
              "to": "event.inCatalogue"
            },
            {
              "emit": "wa-activated"
            }
          ]
        },
        {
          "id": "wa-activate-t",
          "from": "wa-draft",
          "to": "wa-active",
          "on": "wa-activate",
          "guard": "projections > 0 && event.inCatalogue",
          "effects": [
            {
              "set": "catalogued",
              "to": "event.inCatalogue"
            },
            {
              "emit": "wa-activated"
            }
          ]
        },
        {
          "id": "wa-refuse",
          "from": "wa-draft",
          "to": "wa-draft",
          "on": "wa-activate",
          "effects": [
            {
              "emit": "wa-refused"
            }
          ]
        }
      ]
    },
    {
      "id": "workflow-activation-flow-impl",
      "name": "Workflow activation (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "workflow-activation-flow",
      "description": "One workflow definition in draft. A projection of it can be run. Activation is refused until a projection has run, and refused when the definition names a trigger or action outside the published catalogue.",
      "initial": "wa-draft-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "projections",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "catalogued",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        }
      ],
      "states": [
        {
          "id": "wa-draft-i",
          "name": "Draft"
        },
        {
          "id": "wa-active-i",
          "name": "Active",
          "ignores": [
            "wa-project",
            "wa-activate"
          ]
        }
      ],
      "transitions": [
        {
          "id": "wa-project-t-i",
          "from": "wa-draft-i",
          "to": "wa-draft-i",
          "on": "wa-project",
          "otherwise": true,
          "effects": [
            {
              "set": "projections",
              "to": "projections + 1"
            }
          ]
        },
        {
          "id": "wa-activate-t-i",
          "from": "wa-draft-i",
          "to": "wa-active-i",
          "on": "wa-activate",
          "guard": "projections > 0 && event.inCatalogue",
          "effects": [
            {
              "set": "catalogued",
              "to": "event.inCatalogue"
            },
            {
              "emit": "wa-activated",
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "wa-refuse-i",
          "from": "wa-draft-i",
          "to": "wa-draft-i",
          "on": "wa-activate",
          "otherwise": true,
          "effects": [
            {
              "emit": "wa-refused",
              "to": "automation-worker"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "wa-draft-i": "wa-draft",
          "wa-active-i": "wa-active"
        },
        "variables": {
          "projections": "projections",
          "catalogued": "catalogued"
        },
        "transitions": {
          "wa-project-t-i": "wa-project-t",
          "wa-activate-t-i": "wa-activate-t",
          "wa-refuse-i": "wa-refuse"
        }
      },
      "storage": {
        "record": "rec-workflow-activation",
        "key": "workflow-id",
        "stateValues": {
          "wa-draft-i": "draft",
          "wa-active-i": "active"
        },
        "creates": true
      },
      "realisation": "target"
    },
    {
      "id": "template-install-flow",
      "name": "Template install",
      "subject": "runtime",
      "initial": "ti-offered",
      "description": "One platform template or integration offered to a tenant. The tenant reviews the projection of the changes it makes, and the install is refused until it has.",
      "variables": [
        {
          "name": "reviews",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "ti-offered",
          "name": "Offered"
        },
        {
          "id": "ti-installed",
          "name": "Installed"
        }
      ],
      "transitions": [
        {
          "id": "ti-review-t",
          "from": "ti-offered",
          "to": "ti-offered",
          "on": "ti-review",
          "effects": [
            {
              "set": "reviews",
              "to": "reviews + 1"
            }
          ]
        },
        {
          "id": "ti-install-unreviewed",
          "from": "ti-offered",
          "to": "ti-installed",
          "on": "ti-install",
          "description": "Defect: installs a template whose projection nobody reviewed.",
          "guard": "reviews == 0",
          "faultOnly": true,
          "effects": [
            {
              "emit": "ti-template-installed"
            }
          ]
        },
        {
          "id": "ti-install-t",
          "from": "ti-offered",
          "to": "ti-installed",
          "on": "ti-install",
          "guard": "reviews > 0",
          "effects": [
            {
              "emit": "ti-template-installed"
            }
          ]
        },
        {
          "id": "ti-refuse",
          "from": "ti-offered",
          "to": "ti-offered",
          "on": "ti-install",
          "effects": [
            {
              "emit": "ti-refused"
            }
          ]
        }
      ]
    },
    {
      "id": "template-install-flow-impl",
      "name": "Template install (implementation)",
      "level": "implementation",
      "subject": "runtime",
      "refines": "template-install-flow",
      "description": "One platform template or integration offered to a tenant. The tenant reviews the projection of the changes it makes, and the install is refused until it has.",
      "initial": "ti-offered-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "reviews",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        }
      ],
      "states": [
        {
          "id": "ti-offered-i",
          "name": "Offered"
        },
        {
          "id": "ti-installed-i",
          "name": "Installed",
          "ignores": [
            "ti-review",
            "ti-install"
          ]
        }
      ],
      "transitions": [
        {
          "id": "ti-review-t-i",
          "from": "ti-offered-i",
          "to": "ti-offered-i",
          "on": "ti-review",
          "otherwise": true,
          "effects": [
            {
              "set": "reviews",
              "to": "reviews + 1"
            }
          ]
        },
        {
          "id": "ti-install-t-i",
          "from": "ti-offered-i",
          "to": "ti-installed-i",
          "on": "ti-install",
          "guard": "reviews > 0",
          "effects": [
            {
              "emit": "ti-template-installed",
              "to": "runtime"
            }
          ]
        },
        {
          "id": "ti-refuse-i",
          "from": "ti-offered-i",
          "to": "ti-offered-i",
          "on": "ti-install",
          "otherwise": true,
          "effects": [
            {
              "emit": "ti-refused",
              "to": "runtime"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "ti-offered-i": "ti-offered",
          "ti-installed-i": "ti-installed"
        },
        "variables": {
          "reviews": "reviews"
        },
        "transitions": {
          "ti-review-t-i": "ti-review-t",
          "ti-install-t-i": "ti-install-t",
          "ti-refuse-i": "ti-refuse"
        }
      },
      "storage": {
        "record": "rec-template-install",
        "key": "install-id",
        "stateValues": {
          "ti-offered-i": "offered",
          "ti-installed-i": "installed"
        },
        "creates": true
      },
      "realisation": "target"
    },
    {
      "id": "workflow-run-flow",
      "name": "Workflow run",
      "subject": "automation-worker",
      "initial": "wr-running",
      "description": "One workflow run of three steps. Each step executes and records the step reached in the same step. A process restart loses the process and nothing else: the next step is the one after the last recorded step, so no step runs twice and none is skipped.",
      "variables": [
        {
          "name": "step",
          "type": "number",
          "initial": 0
        },
        {
          "name": "executions",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "wr-running",
          "name": "Running"
        },
        {
          "id": "wr-completed",
          "name": "Completed"
        }
      ],
      "transitions": [
        {
          "id": "wr-restart-from-start",
          "from": "wr-running",
          "to": "wr-running",
          "on": "wr-restart",
          "description": "Defect: a restarted process begins the run again.",
          "faultOnly": true,
          "effects": [
            {
              "set": "step",
              "to": 0
            }
          ]
        },
        {
          "id": "wr-restart-t",
          "from": "wr-running",
          "to": "wr-running",
          "on": "wr-restart",
          "effects": []
        },
        {
          "id": "wr-finish",
          "from": "wr-running",
          "to": "wr-completed",
          "on": "wr-advance",
          "guard": "step == 2",
          "effects": [
            {
              "set": "executions",
              "to": "executions + 1"
            },
            {
              "set": "step",
              "to": "step + 1"
            },
            {
              "emit": "wr-run-finished"
            }
          ]
        },
        {
          "id": "wr-advance-t",
          "from": "wr-running",
          "to": "wr-running",
          "on": "wr-advance",
          "guard": "step < 2",
          "effects": [
            {
              "set": "executions",
              "to": "executions + 1"
            },
            {
              "set": "step",
              "to": "step + 1"
            }
          ]
        }
      ]
    },
    {
      "id": "workflow-run-flow-impl",
      "name": "Workflow run (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "workflow-run-flow",
      "description": "One workflow run of three steps. Each step executes and records the step reached in the same step. A process restart loses the process and nothing else: the next step is the one after the last recorded step, so no step runs twice and none is skipped. Not realised by the worker (D-7705): a step is executed and its record written in two transactions, not one: the kernel commits the effect of the step under its step key, and the report then records the step, the run and the next job. A restart between the two repeats the execution of the step, and its effect is applied once by the step key (SCH-015, D-7700), not because the execution and the record are one step.",
      "initial": "wr-running-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "step",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "executions",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        }
      ],
      "states": [
        {
          "id": "wr-running-i",
          "name": "Running"
        },
        {
          "id": "wr-completed-i",
          "name": "Completed",
          "ignores": [
            "wr-restart",
            "wr-advance"
          ]
        }
      ],
      "transitions": [
        {
          "id": "wr-restart-t-i",
          "from": "wr-running-i",
          "to": "wr-running-i",
          "on": "wr-restart",
          "otherwise": true,
          "effects": []
        },
        {
          "id": "wr-finish-i",
          "from": "wr-running-i",
          "to": "wr-completed-i",
          "on": "wr-advance",
          "guard": "step == 2",
          "effects": [
            {
              "set": "executions",
              "to": "executions + 1"
            },
            {
              "set": "step",
              "to": "step + 1"
            },
            {
              "emit": "wr-run-finished",
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "wr-advance-t-i",
          "from": "wr-running-i",
          "to": "wr-running-i",
          "on": "wr-advance",
          "guard": "step < 2",
          "effects": [
            {
              "set": "executions",
              "to": "executions + 1"
            },
            {
              "set": "step",
              "to": "step + 1"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "wr-running-i": "wr-running",
          "wr-completed-i": "wr-completed"
        },
        "variables": {
          "step": "step",
          "executions": "executions"
        },
        "transitions": {
          "wr-restart-t-i": "wr-restart-t",
          "wr-finish-i": "wr-finish",
          "wr-advance-t-i": "wr-advance-t"
        }
      },
      "storage": {
        "record": "rec-workflow-run",
        "key": "run-id",
        "stateValues": {
          "wr-running-i": "running",
          "wr-completed-i": "completed"
        },
        "createdBy": "start-workflow-run"
      },
      "realisation": "target"
    },
    {
      "id": "workflow-compensation-flow",
      "name": "Workflow compensation",
      "subject": "automation-worker",
      "initial": "wc-running",
      "description": "One workflow run of up to three steps whose next step fails. The run compensates the steps that completed, newest first, and only those. A compensation of step k is a separate delivery, so the order of the deliveries is the order of compensation.",
      "variables": [
        {
          "name": "completed",
          "type": "number",
          "initial": 0
        },
        {
          "name": "compensated",
          "type": "number",
          "initial": 0
        },
        {
          "name": "lastComp",
          "type": "number",
          "initial": 0
        },
        {
          "name": "prevComp",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "wc-running",
          "name": "Running"
        },
        {
          "id": "wc-compensating",
          "name": "Compensating"
        },
        {
          "id": "wc-failed",
          "name": "Failed and compensated"
        }
      ],
      "transitions": [
        {
          "id": "wc-count-step",
          "from": "wc-running",
          "to": "wc-running",
          "on": "wc-step-done",
          "effects": [
            {
              "set": "completed",
              "to": "completed + 1"
            }
          ]
        },
        {
          "id": "wc-fail-oldest-first",
          "from": "wc-running",
          "to": "wc-compensating",
          "on": "wc-step-failed",
          "description": "Defect: compensates the oldest completed step first.",
          "guard": "completed == 2",
          "faultOnly": true,
          "effects": [
            {
              "emit": "wc-compensate",
              "after": 1,
              "payload": {
                "step": 1
              }
            },
            {
              "emit": "wc-compensate",
              "after": 2,
              "payload": {
                "step": 2
              }
            }
          ]
        },
        {
          "id": "wc-fail-nothing-done",
          "from": "wc-running",
          "to": "wc-failed",
          "on": "wc-step-failed",
          "guard": "completed == 0",
          "effects": [
            {
              "emit": "wc-compensation-finished"
            }
          ]
        },
        {
          "id": "wc-fail-one-done",
          "from": "wc-running",
          "to": "wc-compensating",
          "on": "wc-step-failed",
          "guard": "completed == 1",
          "effects": [
            {
              "emit": "wc-compensate",
              "after": 1,
              "payload": {
                "step": 1
              }
            }
          ]
        },
        {
          "id": "wc-fail-two-done",
          "from": "wc-running",
          "to": "wc-compensating",
          "on": "wc-step-failed",
          "guard": "completed == 2",
          "effects": [
            {
              "emit": "wc-compensate",
              "after": 1,
              "payload": {
                "step": 2
              }
            },
            {
              "emit": "wc-compensate",
              "after": 2,
              "payload": {
                "step": 1
              }
            }
          ]
        },
        {
          "id": "wc-fail-three-done",
          "from": "wc-running",
          "to": "wc-compensating",
          "on": "wc-step-failed",
          "guard": "completed >= 3",
          "effects": [
            {
              "emit": "wc-compensate",
              "after": 1,
              "payload": {
                "step": 3
              }
            },
            {
              "emit": "wc-compensate",
              "after": 2,
              "payload": {
                "step": 2
              }
            },
            {
              "emit": "wc-compensate",
              "after": 3,
              "payload": {
                "step": 1
              }
            }
          ]
        },
        {
          "id": "wc-compensate-last",
          "from": "wc-compensating",
          "to": "wc-failed",
          "on": "wc-compensate",
          "guard": "compensated + 1 == completed",
          "effects": [
            {
              "set": "compensated",
              "to": "compensated + 1"
            },
            {
              "set": "prevComp",
              "to": "lastComp"
            },
            {
              "set": "lastComp",
              "to": "event.step"
            },
            {
              "emit": "wc-compensation-finished"
            }
          ]
        },
        {
          "id": "wc-compensate-step",
          "from": "wc-compensating",
          "to": "wc-compensating",
          "on": "wc-compensate",
          "effects": [
            {
              "set": "compensated",
              "to": "compensated + 1"
            },
            {
              "set": "prevComp",
              "to": "lastComp"
            },
            {
              "set": "lastComp",
              "to": "event.step"
            }
          ]
        }
      ]
    },
    {
      "id": "workflow-compensation-flow-impl",
      "name": "Workflow compensation (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "workflow-compensation-flow",
      "description": "One workflow run of up to three steps whose next step fails. The run compensates the steps that completed, newest first, and only those. A compensation of step k is a separate delivery, so the order of the deliveries is the order of compensation. Not realised by the worker (D-7705): compensation is not built. A step that spends its attempts fails its run and dead-letters, and no completed step of the run is compensated.",
      "initial": "wc-running-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "completed",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "compensated",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "lastComp",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "prevComp",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        }
      ],
      "states": [
        {
          "id": "wc-running-i",
          "name": "Running",
          "ignores": [
            "wc-compensate"
          ]
        },
        {
          "id": "wc-compensating-i",
          "name": "Compensating",
          "ignores": [
            "wc-step-done",
            "wc-step-failed"
          ]
        },
        {
          "id": "wc-failed-i",
          "name": "Failed and compensated",
          "ignores": [
            "wc-step-done",
            "wc-step-failed",
            "wc-compensate"
          ]
        }
      ],
      "transitions": [
        {
          "id": "wc-count-step-i",
          "from": "wc-running-i",
          "to": "wc-running-i",
          "on": "wc-step-done",
          "otherwise": true,
          "effects": [
            {
              "set": "completed",
              "to": "completed + 1"
            }
          ]
        },
        {
          "id": "wc-fail-nothing-done-i",
          "from": "wc-running-i",
          "to": "wc-failed-i",
          "on": "wc-step-failed",
          "guard": "completed == 0",
          "effects": [
            {
              "emit": "wc-compensation-finished",
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "wc-fail-one-done-i",
          "from": "wc-running-i",
          "to": "wc-compensating-i",
          "on": "wc-step-failed",
          "guard": "completed == 1",
          "effects": [
            {
              "emit": "wc-compensate",
              "after": 1,
              "payload": {
                "step": 1
              },
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "wc-fail-two-done-i",
          "from": "wc-running-i",
          "to": "wc-compensating-i",
          "on": "wc-step-failed",
          "guard": "completed == 2",
          "effects": [
            {
              "emit": "wc-compensate",
              "after": 1,
              "payload": {
                "step": 2
              },
              "to": "automation-worker"
            },
            {
              "emit": "wc-compensate",
              "after": 2,
              "payload": {
                "step": 1
              },
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "wc-fail-three-done-i",
          "from": "wc-running-i",
          "to": "wc-compensating-i",
          "on": "wc-step-failed",
          "guard": "completed >= 3",
          "effects": [
            {
              "emit": "wc-compensate",
              "after": 1,
              "payload": {
                "step": 3
              },
              "to": "automation-worker"
            },
            {
              "emit": "wc-compensate",
              "after": 2,
              "payload": {
                "step": 2
              },
              "to": "automation-worker"
            },
            {
              "emit": "wc-compensate",
              "after": 3,
              "payload": {
                "step": 1
              },
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "wc-compensate-last-i",
          "from": "wc-compensating-i",
          "to": "wc-failed-i",
          "on": "wc-compensate",
          "guard": "compensated + 1 == completed",
          "effects": [
            {
              "set": "compensated",
              "to": "compensated + 1"
            },
            {
              "set": "prevComp",
              "to": "lastComp"
            },
            {
              "set": "lastComp",
              "to": "event.step"
            },
            {
              "emit": "wc-compensation-finished",
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "wc-compensate-step-i",
          "from": "wc-compensating-i",
          "to": "wc-compensating-i",
          "on": "wc-compensate",
          "otherwise": true,
          "effects": [
            {
              "set": "compensated",
              "to": "compensated + 1"
            },
            {
              "set": "prevComp",
              "to": "lastComp"
            },
            {
              "set": "lastComp",
              "to": "event.step"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "wc-running-i": "wc-running",
          "wc-compensating-i": "wc-compensating",
          "wc-failed-i": "wc-failed"
        },
        "variables": {
          "completed": "completed",
          "compensated": "compensated",
          "lastComp": "lastComp",
          "prevComp": "prevComp"
        },
        "transitions": {
          "wc-count-step-i": "wc-count-step",
          "wc-fail-nothing-done-i": "wc-fail-nothing-done",
          "wc-fail-one-done-i": "wc-fail-one-done",
          "wc-fail-two-done-i": "wc-fail-two-done",
          "wc-fail-three-done-i": "wc-fail-three-done",
          "wc-compensate-last-i": "wc-compensate-last",
          "wc-compensate-step-i": "wc-compensate-step"
        }
      },
      "storage": {
        "record": "rec-workflow-run",
        "key": "run-id",
        "fields": {
          "lastComp": "last-comp",
          "prevComp": "prev-comp"
        },
        "stateValues": {
          "wc-running-i": "running",
          "wc-compensating-i": "compensating",
          "wc-failed-i": "failed"
        },
        "createdBy": "start-workflow-run"
      },
      "realisation": "target"
    },
    {
      "id": "approval-flow",
      "name": "Workflow approval",
      "subject": "automation-worker",
      "initial": "wp-waiting",
      "description": "One workflow run waiting for approval. An approval carries the decision of the policy of the step on the principal who gave it. The run continues after an approval that the policy permits, and an approval that it does not permit is refused and leaves the run waiting.",
      "variables": [
        {
          "name": "permittedApprovals",
          "type": "number",
          "initial": 0
        },
        {
          "name": "refusedApprovals",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "wp-waiting",
          "name": "Waiting for approval"
        },
        {
          "id": "wp-continued",
          "name": "Continued"
        }
      ],
      "transitions": [
        {
          "id": "wp-continue-unpermitted",
          "from": "wp-waiting",
          "to": "wp-continued",
          "on": "wp-approve",
          "description": "Defect: any approval continues the run.",
          "guard": "!event.permitted",
          "faultOnly": true,
          "effects": [
            {
              "emit": "wp-run-continued"
            }
          ]
        },
        {
          "id": "wp-continue",
          "from": "wp-waiting",
          "to": "wp-continued",
          "on": "wp-approve",
          "guard": "event.permitted",
          "effects": [
            {
              "set": "permittedApprovals",
              "to": "permittedApprovals + 1"
            },
            {
              "emit": "wp-run-continued"
            }
          ]
        },
        {
          "id": "wp-refuse-approval",
          "from": "wp-waiting",
          "to": "wp-waiting",
          "on": "wp-approve",
          "effects": [
            {
              "set": "refusedApprovals",
              "to": "refusedApprovals + 1"
            },
            {
              "emit": "wp-approval-refused"
            }
          ]
        }
      ]
    },
    {
      "id": "approval-flow-impl",
      "name": "Workflow approval (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "approval-flow",
      "description": "One workflow run waiting for approval. An approval carries the decision of the policy of the step on the principal who gave it. The run continues after an approval that the policy permits, and an approval that it does not permit is refused and leaves the run waiting. Not realised by the worker (D-7705): the step kind request-approval is not built; a run that reaches it fails the step with the error that the kind is not built.",
      "initial": "wp-waiting-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "permittedApprovals",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "refusedApprovals",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        }
      ],
      "states": [
        {
          "id": "wp-waiting-i",
          "name": "Waiting for approval"
        },
        {
          "id": "wp-continued-i",
          "name": "Continued",
          "ignores": [
            "wp-approve"
          ]
        }
      ],
      "transitions": [
        {
          "id": "wp-continue-i",
          "from": "wp-waiting-i",
          "to": "wp-continued-i",
          "on": "wp-approve",
          "guard": "event.permitted",
          "effects": [
            {
              "set": "permittedApprovals",
              "to": "permittedApprovals + 1"
            },
            {
              "emit": "wp-run-continued",
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "wp-refuse-approval-i",
          "from": "wp-waiting-i",
          "to": "wp-waiting-i",
          "on": "wp-approve",
          "otherwise": true,
          "effects": [
            {
              "set": "refusedApprovals",
              "to": "refusedApprovals + 1"
            },
            {
              "emit": "wp-approval-refused",
              "to": "automation-worker"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "wp-waiting-i": "wp-waiting",
          "wp-continued-i": "wp-continued"
        },
        "variables": {
          "permittedApprovals": "permittedApprovals",
          "refusedApprovals": "refusedApprovals"
        },
        "transitions": {
          "wp-continue-i": "wp-continue",
          "wp-refuse-approval-i": "wp-refuse-approval"
        }
      },
      "storage": {
        "record": "rec-workflow-run",
        "key": "run-id",
        "fields": {
          "permittedApprovals": "permitted-approvals",
          "refusedApprovals": "refused-approvals"
        },
        "stateValues": {
          "wp-waiting-i": "awaiting-approval",
          "wp-continued-i": "running"
        },
        "createdBy": "start-workflow-run"
      },
      "realisation": "target"
    },
    {
      "id": "approval-inbox-flow",
      "name": "Approval task delivery",
      "subject": "notification-service",
      "initial": "ni-live",
      "description": "An approval step creates a task. For each principal, the policy of the step says whether the principal is named, and the task appears in the inbox of a principal that is named and of no other.",
      "variables": [
        {
          "name": "namedEvaluated",
          "type": "number",
          "initial": 0
        },
        {
          "name": "itemsNamed",
          "type": "number",
          "initial": 0
        },
        {
          "name": "itemsOther",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "ni-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "ni-deliver-to-unnamed",
          "from": "ni-live",
          "to": "ni-live",
          "on": "ni-evaluate",
          "description": "Defect: the task is put into the inbox of a principal the policy does not name.",
          "guard": "!event.named",
          "faultOnly": true,
          "effects": [
            {
              "set": "itemsOther",
              "to": "itemsOther + 1"
            },
            {
              "emit": "ni-item-delivered"
            }
          ]
        },
        {
          "id": "ni-drop-for-named",
          "from": "ni-live",
          "to": "ni-live",
          "on": "ni-evaluate",
          "description": "Defect: a named principal gets no item.",
          "guard": "event.named",
          "faultOnly": true,
          "effects": [
            {
              "set": "namedEvaluated",
              "to": "namedEvaluated + 1"
            }
          ]
        },
        {
          "id": "ni-deliver",
          "from": "ni-live",
          "to": "ni-live",
          "on": "ni-evaluate",
          "guard": "event.named",
          "effects": [
            {
              "set": "namedEvaluated",
              "to": "namedEvaluated + 1"
            },
            {
              "set": "itemsNamed",
              "to": "itemsNamed + 1"
            },
            {
              "emit": "ni-item-delivered"
            }
          ]
        },
        {
          "id": "ni-no-item",
          "from": "ni-live",
          "to": "ni-live",
          "on": "ni-evaluate",
          "effects": []
        }
      ]
    },
    {
      "id": "approval-inbox-flow-impl",
      "name": "Approval task delivery (implementation)",
      "level": "implementation",
      "subject": "notification-service",
      "refines": "approval-inbox-flow",
      "description": "An approval step creates a task. For each principal, the policy of the step says whether the principal is named, and the task appears in the inbox of a principal that is named and of no other.",
      "initial": "ni-live-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "namedEvaluated",
