        {
          "id": "im-update-r2-i",
          "from": "im-open-i",
          "to": "im-open-i",
          "on": "im-record-imported",
          "guard": "event.record == 'r2' && holdsR2",
          "effects": [
            {
              "set": "updates",
              "to": "updates + 1"
            }
          ]
        },
        {
          "id": "im-page-i",
          "from": "im-open-i",
          "to": "im-open-i",
          "on": "im-page-imported",
          "otherwise": true,
          "effects": [
            {
              "set": "formerAddresses",
              "to": "formerAddresses + event.formers"
            },
            {
              "set": "redirects",
              "to": "redirects + event.formers"
            }
          ]
        }
