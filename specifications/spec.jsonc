        },
        {
          "name": "refresh-skipped-at",
          "type": "timestamp",
          "optional": true,
          "description": "The time of the last refresh skipped for want of job quota (SEG-1544)."
        },
        {
          "name": "schema-version",
          "type": "schema-version",
          "description": "The schema version the definition was checked against (SEG-001)."
        }
      ],
      "unique": [
        [
          "name"
        ]
      ],
      "retention": "Until removed by the tenant; every version is kept in the schema history.",
      "schemaVersion": 1,
      "scope": "tenant-meta",
      "describedBy": "tenant-schema",
      "realisation": "target"
    },
