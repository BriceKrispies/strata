    {
      "id": "setting-capability",
      "description": "settings.rs write_setting, the capability of the level: the platform level is written by the control plane and refused (InvalidIntent, setting:platform_level_is_the_control_planes); the tenant level needs the capability setting-write-tenant and the team level setting-write-team, which the owner holds; the person level is the caller's own, whatever role the caller holds (SET-034). The check permission:capability:<name> is added when it passes.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "ctx",
          "type": "context"
        },
        {
          "name": "level",
          "type": "setting-level"
        },
        {
          "name": "evidence",
          "type": "list<check>"
        }
      ],
      "returns": "list<check>",
      "errors": "rejection",
      "body": "match level { platform => fail(call setting-refusal(evidence, error-kind.invalid-intent, 'setting:platform_level_is_the_control_planes', 'the platform level of a setting is written by the control plane')), person => evidence, tenant => try call setting-capability-check(tenant, ctx, level, 'setting-write-tenant', evidence), team => try call setting-capability-check(tenant, ctx, level, 'setting-write-team', evidence) }",
      "examples": [
        {
