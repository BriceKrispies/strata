        }
      ],
      "outputs": [
        {
          "name": "plaintext",
          "type": "bytes"
        }
      ],
      "postconditions": [
        "Opening what seal-field produced under the same key returns the original bytes."
      ],
      "errors": [
        {
          "name": "key-destroyed",
          "condition": "The key was destroyed.",
          "type": "store-error",
          "kind": "not_found"
        },
        {
          "name": "tampered",
          "condition": "The sealed bytes fail authentication.",
          "type": "store-error",
          "kind": "internal"
        }
      ],
      "exposure": "local"
    },
