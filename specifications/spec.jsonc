        {
          "id": "ni-no-item-i",
          "from": "ni-live-i",
          "to": "ni-live-i",
          "on": "ni-evaluate",
          "otherwise": true,
          "effects": []
        }
      ],
      "refinement": {
        "states": {
          "ni-live-i": "ni-live"
        },
        "variables": {
          "namedEvaluated": "namedEvaluated",
          "itemsNamed": "itemsNamed",
          "itemsOther": "itemsOther"
        },
        "transitions": {
          "ni-deliver-i": "ni-deliver",
          "ni-no-item-i": "ni-no-item"
        }
      },
      "storage": {
        "record": "rec-approval-task",
        "key": "task-id",
        "fields": {
          "namedEvaluated": "named-evaluated",
          "itemsNamed": "items-named",
          "itemsOther": "items-other"
        },
        "creates": true
      }
    },
    {
      "id": "call-step-flow",
      "name": "External call step",
      "subject": "connector-runner",
      "initial": "cs-open",
      "description": "One workflow step that calls an external address. The step writes the call to an outbox in its transaction. The connector runner reads the outbox, so it sees the call only after the transaction commits and never when it aborts.",
      "variables": [
        {
          "name": "calls",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "cs-open",
          "name": "Transaction open"
        },
        {
          "id": "cs-committed",
          "name": "Committed"
        },
        {
          "id": "cs-aborted",
          "name": "Rolled back"
        }
      ],
      "transitions": [
        {
          "id": "cs-call-uncommitted",
          "from": "cs-open",
          "to": "cs-open",
          "on": "cs-runner-poll",
          "description": "Defect: the runner calls before the transaction of the step has committed.",
          "faultOnly": true,
          "effects": [
            {
              "set": "calls",
              "to": "calls + 1"
            },
            {
              "emit": "cs-call-made"
            }
          ]
        },
        {
          "id": "cs-commit-t",
          "from": "cs-open",
          "to": "cs-committed",
          "on": "cs-commit",
          "effects": []
        },
        {
          "id": "cs-abort-t",
          "from": "cs-open",
          "to": "cs-aborted",
          "on": "cs-abort",
          "effects": []
        },
        {
          "id": "cs-call",
          "from": "cs-committed",
          "to": "cs-committed",
          "on": "cs-runner-poll",
          "effects": [
            {
              "set": "calls",
              "to": "calls + 1"
            },
            {
              "emit": "cs-call-made"
            }
          ]
        }
      ]
    },
    {
      "id": "call-step-flow-impl",
      "name": "External call step (implementation)",
      "level": "implementation",
      "subject": "connector-runner",
      "refines": "call-step-flow",
      "description": "One workflow step that calls an external address. The step writes the call to an outbox in its transaction. The connector runner reads the outbox, so it sees the call only after the transaction commits and never when it aborts.",
      "initial": "cs-open-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "calls",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        }
      ],
      "states": [
        {
          "id": "cs-open-i",
          "name": "Transaction open",
          "ignores": [
            "cs-runner-poll"
          ]
        },
        {
          "id": "cs-committed-i",
          "name": "Committed",
          "ignores": [
            "cs-commit",
            "cs-abort"
          ]
        },
        {
          "id": "cs-aborted-i",
          "name": "Rolled back",
          "ignores": [
            "cs-commit",
            "cs-abort",
            "cs-runner-poll"
          ]
        }
      ],
      "transitions": [
        {
          "id": "cs-commit-t-i",
          "from": "cs-open-i",
          "to": "cs-committed-i",
          "on": "cs-commit",
          "otherwise": true,
          "effects": []
        },
        {
          "id": "cs-abort-t-i",
          "from": "cs-open-i",
          "to": "cs-aborted-i",
          "on": "cs-abort",
          "otherwise": true,
          "effects": []
        },
        {
          "id": "cs-call-i",
          "from": "cs-committed-i",
          "to": "cs-committed-i",
          "on": "cs-runner-poll",
          "otherwise": true,
          "effects": [
            {
              "set": "calls",
              "to": "calls + 1"
            },
            {
              "emit": "cs-call-made",
              "to": "outbound-gate"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "cs-open-i": "cs-open",
          "cs-committed-i": "cs-committed",
          "cs-aborted-i": "cs-aborted"
        },
        "variables": {
          "calls": "calls"
        },
        "transitions": {
          "cs-commit-t-i": "cs-commit-t",
          "cs-abort-t-i": "cs-abort-t",
          "cs-call-i": "cs-call"
        }
      },
      "storage": {
        "record": "rec-call-step",
        "key": "step-id",
        "stateValues": {
          "cs-open-i": "open",
          "cs-committed-i": "committed",
          "cs-aborted-i": "aborted"
        },
        "creates": true
      }
    },
    {
      "id": "outbound-call-flow",
      "name": "Outbound call",
      "subject": "outbound-gate",
      "initial": "oc-idle",
      "description": "One outbound call through the outbound gate. The gate judges the address it resolved: a call connects only to a public address, and a redirect is followed only to a public address. Response bytes are counted against the size limit of the connector policy and the call ends when the limit would be passed or after the time of the policy, 30 seconds here; the size is modelled as 1 MiB. A tick is a second.",
      "variables": [
        {
          "name": "connectedNet",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "redirectNet",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "received",
          "type": "number",
          "initial": 0
        },
        {
          "name": "limit",
          "type": "number",
          "initial": 1048576
        }
      ],
      "states": [
        {
          "id": "oc-idle",
          "name": "Not connected"
        },
        {
          "id": "oc-open",
          "name": "Connected"
        },
        {
          "id": "oc-ended",
          "name": "Ended"
        }
      ],
      "transitions": [
        {
          "id": "oc-connect-any-address",
          "from": "oc-idle",
          "to": "oc-open",
          "on": "oc-request",
          "description": "Defect: connects to an address that is not public.",
          "guard": "event.net != 'public'",
          "faultOnly": true,
          "effects": [
            {
              "set": "connectedNet",
              "to": "event.net"
            },
            {
              "emit": "oc-connected"
            }
          ]
        },
        {
          "id": "oc-connect",
          "from": "oc-idle",
          "to": "oc-open",
          "on": "oc-request",
          "guard": "event.net == 'public'",
          "effects": [
            {
              "set": "connectedNet",
              "to": "event.net"
            },
            {
              "emit": "oc-connected"
            },
            {
              "emit": "oc-timeout",
              "after": 30
            }
          ]
        },
        {
          "id": "oc-refuse-address",
          "from": "oc-idle",
          "to": "oc-idle",
          "on": "oc-request",
          "effects": [
            {
              "emit": "oc-refused"
            }
          ]
        },
        {
          "id": "oc-follow-any-redirect",
          "from": "oc-open",
          "to": "oc-open",
          "on": "oc-redirect",
          "description": "Defect: follows a redirect to an address that is not public.",
          "guard": "event.net != 'public'",
          "faultOnly": true,
          "effects": [
            {
              "set": "redirectNet",
              "to": "event.net"
            }
          ]
        },
        {
          "id": "oc-follow-redirect",
          "from": "oc-open",
          "to": "oc-open",
          "on": "oc-redirect",
          "guard": "event.net == 'public'",
          "effects": [
            {
              "set": "redirectNet",
              "to": "event.net"
            }
          ]
        },
        {
          "id": "oc-refuse-redirect",
          "from": "oc-open",
          "to": "oc-ended",
          "on": "oc-redirect",
          "effects": [
            {
              "emit": "oc-refused"
            }
          ]
        },
        {
          "id": "oc-accept-oversize",
          "from": "oc-open",
          "to": "oc-open",
          "on": "oc-chunk",
          "description": "Defect: keeps reading past the size limit.",
          "guard": "received + event.bytes > limit",
          "faultOnly": true,
          "effects": [
            {
              "set": "received",
              "to": "received + event.bytes"
            }
          ]
        },
        {
          "id": "oc-receive",
          "from": "oc-open",
          "to": "oc-open",
          "on": "oc-chunk",
          "guard": "received + event.bytes <= limit",
          "effects": [
            {
              "set": "received",
              "to": "received + event.bytes"
            }
          ]
        },
        {
          "id": "oc-end-oversize",
          "from": "oc-open",
          "to": "oc-ended",
          "on": "oc-chunk",
          "effects": [
            {
              "emit": "oc-ended-size"
            }
          ]
        },
        {
          "id": "oc-end-timeout",
          "from": "oc-open",
          "to": "oc-ended",
          "on": "oc-timeout",
          "effects": [
            {
              "emit": "oc-ended-time"
            }
          ]
        }
      ]
    },
    {
      "id": "outbound-call-flow-impl",
      "name": "Outbound call (implementation)",
      "level": "implementation",
      "subject": "outbound-gate",
      "refines": "outbound-call-flow",
      "description": "One outbound call at the outbound gate (rec-outbound-call). The address the gate resolved is judged once, and only a public address is connected to or followed through a redirect; a private, link-local or loopback address is refused. Response bytes are counted against the size limit of the connector policy (1048576 bytes); a chunk that would pass it, or the end of the 30 second call time, ends the call. Times are in milliseconds.",
      "initial": "oc-idle-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "connectedNet",
          "type": "string",
          "initial": "none",
          "repr": "string"
        },
        {
          "name": "redirectNet",
          "type": "string",
          "initial": "none",
          "repr": "string"
        },
        {
          "name": "received",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "limit",
          "type": "number",
          "initial": 1048576,
          "repr": "u64"
        }
      ],
      "states": [
        {
          "id": "oc-idle-i",
          "name": "Not connected",
          "ignores": [
            "oc-redirect",
            "oc-chunk",
            "oc-timeout"
          ]
        },
        {
          "id": "oc-open-i",
          "name": "Connected",
          "ignores": [
            "oc-request"
          ]
        },
        {
          "id": "oc-ended-i",
          "name": "Ended",
          "ignores": [
            "oc-request",
            "oc-redirect",
            "oc-chunk",
            "oc-timeout"
          ]
        }
      ],
      "transitions": [
        {
          "id": "oc-connect-i",
          "from": "oc-idle-i",
          "to": "oc-open-i",
          "on": "oc-request",
          "guard": "event.net == 'public'",
          "effects": [
            {
              "set": "connectedNet",
              "to": "event.net"
            },
            {
              "emit": "oc-connected",
              "to": "outbound-gate"
            },
            {
              "emit": "oc-timeout",
              "after": 30000,
              "to": "outbound-gate"
            }
          ]
        },
        {
          "id": "oc-refuse-address-i",
          "from": "oc-idle-i",
          "to": "oc-idle-i",
          "on": "oc-request",
          "otherwise": true,
          "effects": [
            {
              "emit": "oc-refused",
              "to": "outbound-gate"
            }
          ]
        },
        {
          "id": "oc-follow-redirect-i",
          "from": "oc-open-i",
          "to": "oc-open-i",
          "on": "oc-redirect",
          "guard": "event.net == 'public'",
          "effects": [
            {
              "set": "redirectNet",
              "to": "event.net"
            }
          ]
        },
        {
          "id": "oc-refuse-redirect-i",
          "from": "oc-open-i",
          "to": "oc-ended-i",
          "on": "oc-redirect",
          "otherwise": true,
          "effects": [
            {
              "emit": "oc-refused",
              "to": "outbound-gate"
            }
          ]
        },
        {
          "id": "oc-receive-i",
          "from": "oc-open-i",
          "to": "oc-open-i",
          "on": "oc-chunk",
          "guard": "received + event.bytes <= limit",
          "effects": [
            {
              "set": "received",
              "to": "received + event.bytes"
            }
          ]
        },
        {
          "id": "oc-end-oversize-i",
          "from": "oc-open-i",
          "to": "oc-ended-i",
          "on": "oc-chunk",
          "otherwise": true,
          "effects": [
            {
              "emit": "oc-ended-size",
              "to": "outbound-gate"
            }
          ]
        },
        {
          "id": "oc-end-timeout-i",
          "from": "oc-open-i",
          "to": "oc-ended-i",
          "on": "oc-timeout",
          "otherwise": true,
          "effects": [
            {
              "emit": "oc-ended-time",
              "to": "outbound-gate"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "oc-idle-i": "oc-idle",
          "oc-open-i": "oc-open",
          "oc-ended-i": "oc-ended"
        },
        "variables": {
          "connectedNet": "connectedNet",
          "redirectNet": "redirectNet",
          "received": "received",
          "limit": "limit"
        },
        "transitions": {
          "oc-connect-i": "oc-connect",
          "oc-refuse-address-i": "oc-refuse-address",
          "oc-follow-redirect-i": "oc-follow-redirect",
          "oc-refuse-redirect-i": "oc-refuse-redirect",
          "oc-receive-i": "oc-receive",
          "oc-end-oversize-i": "oc-end-oversize",
          "oc-end-timeout-i": "oc-end-timeout"
        },
        "timeScale": 1000
      },
      "storage": {
        "record": "rec-outbound-call",
        "key": "call-id",
        "fields": {
          "connectedNet": "connected-net",
          "redirectNet": "redirect-net"
        },
        "stateValues": {
          "oc-idle-i": "idle",
          "oc-open-i": "open",
          "oc-ended-i": "ended"
        },
        "creates": true
      }
    },
    {
      "id": "webhook-delivery-flow",
      "name": "Outbound webhook delivery",
      "subject": "automation-worker",
      "initial": "wh-live",
      "description": "The deliveries of one subscription. Each attempt is signed with the secret of the subscription it goes to and is written to the delivery log in the same step; the response status is logged when the response arrives. A server error is retried after 5 seconds, up to three attempts. A tick is a second.",
      "variables": [
        {
          "name": "target",
          "type": "string",
          "initial": ""
        },
        {
          "name": "signedBy",
          "type": "string",
          "initial": ""
        },
        {
          "name": "attempts",
          "type": "number",
          "initial": 0
        },
        {
          "name": "logAttempts",
          "type": "number",
          "initial": 0
        },
        {
          "name": "lastStatus",
          "type": "number",
          "initial": 0
        },
        {
          "name": "logStatus",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "wh-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "wh-send-unsigned",
          "from": "wh-live",
          "to": "wh-live",
          "on": "wh-send",
          "description": "Defect: posts the body without a signature.",
          "faultOnly": true,
          "effects": [
            {
              "set": "target",
              "to": "event.subscription"
            },
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "logAttempts",
              "to": "logAttempts + 1"
            },
            {
              "set": "signedBy",
              "to": "''"
            },
            {
              "emit": "wh-posted"
            }
          ]
        },
        {
          "id": "wh-send-unlogged",
          "from": "wh-live",
          "to": "wh-live",
          "on": "wh-send",
          "description": "Defect: posts the attempt without writing it to the delivery log.",
          "faultOnly": true,
          "effects": [
            {
              "set": "target",
              "to": "event.subscription"
            },
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "signedBy",
              "to": "event.subscription"
            },
            {
              "emit": "wh-posted"
            }
          ]
        },
        {
          "id": "wh-send-t",
          "from": "wh-live",
          "to": "wh-live",
          "on": "wh-send",
          "effects": [
            {
              "set": "target",
              "to": "event.subscription"
            },
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "logAttempts",
              "to": "logAttempts + 1"
            },
            {
              "set": "signedBy",
              "to": "event.subscription"
            },
            {
              "emit": "wh-posted"
            }
          ]
        },
        {
          "id": "wh-respond-unlogged",
          "from": "wh-live",
          "to": "wh-live",
          "on": "wh-response",
          "description": "Defect: the response status is not written to the delivery log.",
          "faultOnly": true,
          "effects": [
            {
              "set": "lastStatus",
              "to": "event.status"
            }
          ]
        },
        {
          "id": "wh-respond-retry",
          "from": "wh-live",
          "to": "wh-live",
          "on": "wh-response",
          "guard": "event.status >= 500 && attempts < 3",
          "effects": [
            {
              "set": "lastStatus",
              "to": "event.status"
            },
            {
              "set": "logStatus",
              "to": "event.status"
            },
            {
              "emit": "wh-send",
              "after": 5,
              "payload": {
                "subscription": "target"
              }
            }
          ]
        },
        {
          "id": "wh-respond",
          "from": "wh-live",
          "to": "wh-live",
          "on": "wh-response",
          "effects": [
            {
              "set": "lastStatus",
              "to": "event.status"
            },
            {
              "set": "logStatus",
              "to": "event.status"
            }
          ]
        }
      ]
    },
    {
      "id": "webhook-delivery-flow-impl",
      "name": "Outbound webhook delivery (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "webhook-delivery-flow",
      "description": "The outbound webhook deliveries of the automation worker (rec-webhook-delivery). An attempt records the secret that signed it, which is the secret of the subscription it goes to, and the attempt count in the log; a response records its status in the log, and a server error schedules another attempt 5 seconds later, up to three. Times are in milliseconds.",
      "initial": "wh-live-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "target",
          "type": "string",
          "initial": "",
          "repr": "string"
        },
        {
          "name": "signedBy",
          "type": "string",
          "initial": "",
          "repr": "string"
        },
        {
          "name": "attempts",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "logAttempts",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "lastStatus",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "logStatus",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        }
      ],
      "states": [
        {
          "id": "wh-live-i",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "wh-send-t-i",
          "from": "wh-live-i",
          "to": "wh-live-i",
          "on": "wh-send",
          "otherwise": true,
          "effects": [
            {
              "set": "target",
              "to": "event.subscription"
            },
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "logAttempts",
              "to": "logAttempts + 1"
            },
            {
              "set": "signedBy",
              "to": "event.subscription"
            },
            {
              "emit": "wh-posted",
              "to": "external-endpoint"
            }
          ]
        },
        {
          "id": "wh-respond-retry-i",
          "from": "wh-live-i",
          "to": "wh-live-i",
          "on": "wh-response",
          "guard": "event.status >= 500 && attempts < 3",
          "effects": [
            {
              "set": "lastStatus",
              "to": "event.status"
            },
            {
              "set": "logStatus",
              "to": "event.status"
            },
            {
              "emit": "wh-send",
              "after": 5000,
              "payload": {
                "subscription": "target"
              },
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "wh-respond-i",
          "from": "wh-live-i",
          "to": "wh-live-i",
          "on": "wh-response",
          "otherwise": true,
          "effects": [
            {
              "set": "lastStatus",
              "to": "event.status"
            },
            {
              "set": "logStatus",
              "to": "event.status"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "wh-live-i": "wh-live"
        },
        "variables": {
          "target": "target",
          "signedBy": "signedBy",
          "attempts": "attempts",
          "logAttempts": "logAttempts",
          "lastStatus": "lastStatus",
          "logStatus": "logStatus"
        },
        "transitions": {
          "wh-send-t-i": "wh-send-t",
          "wh-respond-retry-i": "wh-respond-retry",
          "wh-respond-i": "wh-respond"
        },
        "timeScale": 1000
      },
      "storage": {
        "record": "rec-webhook-delivery",
        "key": "delivery-id",
        "fields": {
          "signedBy": "signed-by",
          "logAttempts": "log-attempts",
          "lastStatus": "last-status",
          "logStatus": "log-status"
        },
        "creates": true
      },
      "realisation": "target"
    },
    {
      "id": "scheduled-publication-flow",
      "name": "Scheduled publication",
      "subject": "automation-worker",
      "initial": "sp-draft",
      "description": "One content record that is published 8 ticks after it is saved. Saving the record creates a job; the record is published by that job when it runs at or after the time, and by nothing else. A tick is a second.",
      "variables": [
        {
          "name": "publishAt",
          "type": "number",
          "initial": 0
        },
        {
          "name": "jobRuns",
          "type": "number",
          "initial": 0
        },
        {
          "name": "publishedAt",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "sp-draft",
          "name": "Draft"
        },
        {
          "id": "sp-scheduled",
          "name": "Scheduled"
        },
        {
          "id": "sp-published",
          "name": "Published"
        }
      ],
      "transitions": [
        {
          "id": "sp-publish-at-save",
          "from": "sp-draft",
          "to": "sp-published",
          "on": "sp-save",
          "description": "Defect: publishes the record when it is saved, not by a job.",
          "faultOnly": true,
          "effects": [
            {
              "set": "publishedAt",
              "to": "time"
            },
            {
              "emit": "sp-record-published"
            }
          ]
        },
        {
          "id": "sp-schedule",
          "from": "sp-draft",
          "to": "sp-scheduled",
          "on": "sp-save",
          "effects": [
            {
              "set": "publishAt",
              "to": "time + 8"
            }
          ]
        },
        {
          "id": "sp-publish",
          "from": "sp-scheduled",
          "to": "sp-published",
          "on": "sp-job-run",
          "guard": "time >= publishAt",
          "effects": [
            {
              "set": "jobRuns",
              "to": "jobRuns + 1"
            },
            {
              "set": "publishedAt",
              "to": "time"
            },
            {
              "emit": "sp-record-published"
            }
          ]
        },
        {
          "id": "sp-job-early",
          "from": "sp-scheduled",
          "to": "sp-scheduled",
          "on": "sp-job-run",
          "effects": []
        }
      ]
    },
    {
      "id": "scheduled-publication-flow-impl",
      "name": "Scheduled publication (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "scheduled-publication-flow",
      "description": "One content record with a publication time (rec-scheduled-publication). Saving it with a publication time schedules a job; the record becomes published when that job runs at or after the publication time, and not otherwise. Times are in milliseconds.",
      "initial": "sp-draft-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "publishAt",
          "type": "number",
          "initial": 0,
          "repr": "timestamp"
        },
        {
          "name": "jobRuns",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "publishedAt",
          "type": "number",
          "initial": 0,
          "repr": "timestamp"
        }
      ],
      "states": [
        {
          "id": "sp-draft-i",
          "name": "Draft",
          "ignores": [
            "sp-job-run"
          ]
        },
        {
          "id": "sp-scheduled-i",
          "name": "Scheduled",
          "ignores": [
            "sp-save"
          ]
        },
        {
          "id": "sp-published-i",
          "name": "Published",
          "ignores": [
            "sp-save",
            "sp-job-run"
          ]
        }
      ],
      "transitions": [
        {
          "id": "sp-schedule-i",
          "from": "sp-draft-i",
          "to": "sp-scheduled-i",
          "on": "sp-save",
          "otherwise": true,
          "effects": [
            {
              "set": "publishAt",
              "to": "time + 8000"
            }
          ]
        },
        {
          "id": "sp-publish-i",
          "from": "sp-scheduled-i",
          "to": "sp-published-i",
          "on": "sp-job-run",
          "guard": "time >= publishAt",
          "effects": [
            {
              "set": "jobRuns",
              "to": "jobRuns + 1"
            },
            {
              "set": "publishedAt",
              "to": "time"
            },
            {
              "emit": "sp-record-published",
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "sp-job-early-i",
          "from": "sp-scheduled-i",
          "to": "sp-scheduled-i",
          "on": "sp-job-run",
          "otherwise": true,
          "effects": []
        }
      ],
      "refinement": {
        "states": {
          "sp-draft-i": "sp-draft",
          "sp-scheduled-i": "sp-scheduled",
          "sp-published-i": "sp-published"
        },
        "variables": {
          "publishAt": "publishAt / 1000",
          "jobRuns": "jobRuns",
          "publishedAt": "publishedAt / 1000"
        },
        "transitions": {
          "sp-schedule-i": "sp-schedule",
          "sp-publish-i": "sp-publish",
          "sp-job-early-i": "sp-job-early"
        },
        "timeScale": 1000
      },
      "storage": {
        "record": "rec-scheduled-publication",
        "key": "record-id",
        "fields": {
          "publishAt": "publish-at",
          "jobRuns": "job-runs",
          "publishedAt": "published-at"
        },
        "stateValues": {
          "sp-draft-i": "draft",
          "sp-scheduled-i": "scheduled",
          "sp-published-i": "published"
        },
        "creates": true
      },
      "realisation": "target"
    },
    {
      "id": "inbound-signature-flow",
      "name": "Inbound webhook signature",
      "subject": "automation-worker",
      "initial": "is-live",
      "description": "The inbound webhook of one endpoint. A delivery carries the result of checking its signature against the secret of the endpoint; a delivery whose signature does not match starts no run.",
      "variables": [
        {
          "name": "runs",
          "type": "number",
          "initial": 0
        },
        {
          "name": "rejected",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "is-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "is-start-forged",
          "from": "is-live",
          "to": "is-live",
          "on": "is-received",
          "description": "Defect: starts a run for a delivery whose signature does not match.",
          "guard": "!event.valid",
          "faultOnly": true,
          "effects": [
            {
              "set": "runs",
              "to": "runs + 1"
            },
            {
              "emit": "is-run-started"
            }
          ]
        },
        {
          "id": "is-start",
          "from": "is-live",
          "to": "is-live",
          "on": "is-received",
          "guard": "event.valid",
          "effects": [
            {
              "set": "runs",
              "to": "runs + 1"
            },
            {
              "emit": "is-run-started"
            }
          ]
        },
        {
          "id": "is-reject",
          "from": "is-live",
          "to": "is-live",
          "on": "is-received",
          "effects": [
            {
              "set": "rejected",
              "to": "rejected + 1"
            },
            {
              "emit": "is-rejected"
            }
          ]
        }
      ]
    },
    {
      "id": "inbound-signature-flow-impl",
      "name": "Inbound webhook signature (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "inbound-signature-flow",
      "description": "The inbound webhook of one endpoint. A delivery carries the result of checking its signature against the secret of the endpoint; a delivery whose signature does not match starts no run.",
      "initial": "is-live-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "runs",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "rejected",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        }
      ],
      "states": [
        {
          "id": "is-live-i",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "is-start-i",
          "from": "is-live-i",
          "to": "is-live-i",
          "on": "is-received",
          "guard": "event.valid",
          "effects": [
            {
              "set": "runs",
              "to": "runs + 1"
            },
            {
              "emit": "is-run-started",
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "is-reject-i",
          "from": "is-live-i",
          "to": "is-live-i",
          "on": "is-received",
          "otherwise": true,
          "effects": [
            {
              "set": "rejected",
              "to": "rejected + 1"
            },
            {
              "emit": "is-rejected",
              "to": "external-endpoint"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "is-live-i": "is-live"
        },
        "variables": {
          "runs": "runs",
          "rejected": "rejected"
        },
        "transitions": {
          "is-start-i": "is-start",
          "is-reject-i": "is-reject"
        }
      },
      "storage": {
        "record": "rec-inbound-delivery",
        "key": "delivery-id",
        "creates": true
      },
      "realisation": "target"
    },
    {
      "id": "mail-enqueue-flow",
      "name": "Mail job of a change",
      "subject": "mail-dispatcher",
      "initial": "me-live",
      "description": "One tenant whose changes request mail. Committing a change creates its mail job in the same step; a change whose transaction rolls back creates none.",
      "variables": [
        {
          "name": "committed",
          "type": "number",
          "initial": 0
        },
        {
          "name": "jobs",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "me-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "me-commit-split",
          "from": "me-live",
          "to": "me-live",
          "on": "me-commit",
          "description": "Defect: creates the mail job in a step after the commit.",
          "faultOnly": true,
          "effects": [
            {
              "set": "committed",
              "to": "committed + 1"
            },
            {
              "emit": "me-create-job",
              "after": 1
            }
          ]
        },
        {
          "id": "me-commit-t",
          "from": "me-live",
          "to": "me-live",
          "on": "me-commit",
          "effects": [
            {
              "set": "committed",
              "to": "committed + 1"
            },
            {
              "set": "jobs",
              "to": "jobs + 1"
            },
            {
              "emit": "me-job-created"
            }
          ]
        },
        {
          "id": "me-abort-enqueues",
          "from": "me-live",
          "to": "me-live",
          "on": "me-abort",
          "description": "Defect: creates the mail job before the outcome of the transaction is known.",
          "faultOnly": true,
          "effects": [
            {
              "set": "jobs",
              "to": "jobs + 1"
            }
          ]
        },
        {
          "id": "me-abort-t",
          "from": "me-live",
          "to": "me-live",
          "on": "me-abort",
          "effects": []
        },
        {
          "id": "me-create-job-late",
          "from": "me-live",
          "to": "me-live",
          "on": "me-create-job",
          "effects": [
            {
              "set": "jobs",
              "to": "jobs + 1"
            },
            {
              "emit": "me-job-created"
            }
          ]
        }
      ]
    },
    {
      "id": "mail-enqueue-flow-impl",
      "name": "Mail job of a change (implementation)",
      "level": "implementation",
      "subject": "mail-dispatcher",
      "refines": "mail-enqueue-flow",
      "description": "One tenant whose changes request mail. Committing a change creates its mail job in the same step; a change whose transaction rolls back creates none.",
      "initial": "me-live-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "committed",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "jobs",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        }
      ],
      "states": [
        {
          "id": "me-live-i",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "me-commit-t-i",
          "from": "me-live-i",
          "to": "me-live-i",
          "on": "me-commit",
          "otherwise": true,
          "effects": [
            {
              "set": "committed",
              "to": "committed + 1"
            },
            {
              "set": "jobs",
              "to": "jobs + 1"
            },
            {
              "emit": "me-job-created",
              "to": "mail-dispatcher"
            }
          ]
        },
        {
          "id": "me-abort-t-i",
          "from": "me-live-i",
          "to": "me-live-i",
          "on": "me-abort",
          "otherwise": true,
          "effects": []
        }
      ],
      "refinement": {
        "states": {
          "me-live-i": "me-live"
        },
        "variables": {
          "committed": "committed",
          "jobs": "jobs"
        },
        "transitions": {
          "me-commit-t-i": "me-commit-t",
          "me-abort-t-i": "me-abort-t"
        }
      },
      "storage": {
        "record": "rec-mail-request",
        "key": "change-id",
        "creates": true
      }
    },
    {
      "id": "mail-attempt-flow",
      "name": "Mail attempt",
      "subject": "mail-dispatcher",
      "initial": "mt-queued",
      "description": "One queued message. Each attempt reads the credential of the mail provider from the key service before it submits. A message that carries a sign-in link is discarded unsent when its link has expired by the time of the attempt. The provider then accepts the message, refuses it temporarily, which leaves it queued, or refuses it permanently, which records it as failed with the reason and ends its attempts.",
      "variables": [
        {
          "name": "attempts",
          "type": "number",
          "initial": 0
        },
        {
          "name": "credentialReads",
          "type": "number",
          "initial": 0
        },
        {
          "name": "failReason",
          "type": "string",
          "initial": ""
        },
        {
          "name": "attemptsAtFail",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "mt-queued",
          "name": "Queued"
        },
        {
          "id": "mt-sent",
          "name": "Sent"
        },
        {
          "id": "mt-failed",
          "name": "Failed"
        },
        {
          "id": "mt-discarded",
          "name": "Discarded"
        }
      ],
      "transitions": [
        {
          "id": "mt-send-expired-link",
          "from": "mt-queued",
          "to": "mt-sent",
          "on": "mt-attempt",
          "description": "Defect: sends a message whose sign-in link has expired.",
          "guard": "event.link && time > event.expiresAt",
          "faultOnly": true,
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "credentialReads",
              "to": "credentialReads + 1"
            },
            {
              "emit": "mt-message-sent"
            }
          ]
        },
        {
          "id": "mt-discard-expired-link",
          "from": "mt-queued",
          "to": "mt-discarded",
          "on": "mt-attempt",
          "guard": "event.link && time > event.expiresAt",
          "effects": [
            {
              "emit": "mt-message-discarded"
            }
          ]
        },
        {
          "id": "mt-submit-cached-credential",
          "from": "mt-queued",
          "to": "mt-sent",
          "on": "mt-attempt",
          "description": "Defect: submits with a credential kept from an earlier attempt, without reading the key service.",
          "guard": "event.result == 'accepted'",
          "faultOnly": true,
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "emit": "mt-message-sent"
            }
          ]
        },
        {
          "id": "mt-accepted",
          "from": "mt-queued",
          "to": "mt-sent",
          "on": "mt-attempt",
          "guard": "event.result == 'accepted'",
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "credentialReads",
              "to": "credentialReads + 1"
            },
            {
              "emit": "mt-credential-read"
            },
            {
              "emit": "mt-message-sent"
            }
          ]
        },
        {
          "id": "mt-temporary-fails",
          "from": "mt-queued",
          "to": "mt-failed",
          "on": "mt-attempt",
          "description": "Defect: a temporary refusal records the message as failed.",
          "guard": "event.result == 'temporary'",
          "faultOnly": true,
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "credentialReads",
              "to": "credentialReads + 1"
            },
            {
              "set": "failReason",
              "to": "event.result"
            },
            {
              "set": "attemptsAtFail",
              "to": "attempts"
            },
            {
              "emit": "mt-message-failed"
            }
          ]
        },
        {
          "id": "mt-temporary",
          "from": "mt-queued",
          "to": "mt-queued",
          "on": "mt-attempt",
          "guard": "event.result == 'temporary'",
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "credentialReads",
              "to": "credentialReads + 1"
            },
            {
              "emit": "mt-credential-read"
            }
          ]
        },
        {
          "id": "mt-permanent-without-reason",
          "from": "mt-queued",
          "to": "mt-failed",
          "on": "mt-attempt",
          "description": "Defect: a permanent refusal records the message as failed without its reason.",
          "guard": "event.result == 'permanent'",
          "faultOnly": true,
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "credentialReads",
              "to": "credentialReads + 1"
            },
            {
              "set": "attemptsAtFail",
              "to": "attempts"
            },
            {
              "emit": "mt-message-failed"
            }
          ]
        },
        {
          "id": "mt-permanent",
          "from": "mt-queued",
          "to": "mt-failed",
          "on": "mt-attempt",
          "guard": "event.result == 'permanent'",
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "credentialReads",
              "to": "credentialReads + 1"
            },
            {
              "set": "failReason",
              "to": "event.reason"
            },
            {
              "set": "attemptsAtFail",
              "to": "attempts"
            },
            {
              "emit": "mt-credential-read"
            },
            {
              "emit": "mt-message-failed"
            }
          ]
        },
        {
          "id": "mt-attempt-after-failure",
          "from": "mt-failed",
          "to": "mt-failed",
          "on": "mt-attempt",
          "description": "Defect: a message recorded as failed is attempted again.",
          "faultOnly": true,
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "credentialReads",
              "to": "credentialReads + 1"
            }
          ]
        }
      ]
    },
    {
      "id": "mail-attempt-flow-impl",
      "name": "Mail attempt (implementation)",
      "level": "implementation",
      "subject": "mail-dispatcher",
      "refines": "mail-attempt-flow",
      "description": "One message of the mail outbox (rec-mail-message, keyed by message-id) at an attempt. The attempt reads the credential from the key service, submits the message and counts the attempt. When the message carries a sign-in link and the time of the attempt is past the expiry of the link, the message is discarded and nothing is submitted. A temporary refusal leaves the message queued, a permanent one records it as failed with the reason given by the provider, and a message that is sent, failed or discarded takes no further attempt. Times are those of the link expiry, in milliseconds.",
      "initial": "mt-queued-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "attempts",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "credentialReads",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "failReason",
          "type": "string",
          "initial": "",
          "repr": "string"
        },
        {
          "name": "attemptsAtFail",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        }
      ],
      "states": [
        {
          "id": "mt-queued-i",
          "name": "Queued"
        },
        {
          "id": "mt-sent-i",
          "name": "Sent",
          "ignores": [
            "mt-attempt"
          ]
        },
        {
          "id": "mt-failed-i",
          "name": "Failed",
          "ignores": [
            "mt-attempt"
          ]
        },
        {
          "id": "mt-discarded-i",
          "name": "Discarded",
          "ignores": [
            "mt-attempt"
          ]
        }
      ],
      "transitions": [
        {
          "id": "mt-discard-expired-link-i",
          "from": "mt-queued-i",
          "to": "mt-discarded-i",
          "on": "mt-attempt",
          "guard": "event.link && time > event.expiresAt",
          "effects": [
            {
              "emit": "mt-message-discarded",
              "to": "mail-dispatcher"
            }
          ]
        },
        {
          "id": "mt-accepted-i",
          "from": "mt-queued-i",
          "to": "mt-sent-i",
          "on": "mt-attempt",
          "guard": "event.result == 'accepted'",
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "credentialReads",
              "to": "credentialReads + 1"
            },
            {
              "emit": "mt-credential-read",
              "to": "key-service"
            },
            {
              "emit": "mt-message-sent",
              "to": "mail-dispatcher"
            }
          ]
        },
        {
          "id": "mt-temporary-i",
          "from": "mt-queued-i",
          "to": "mt-queued-i",
          "on": "mt-attempt",
          "guard": "event.result == 'temporary'",
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "credentialReads",
              "to": "credentialReads + 1"
            },
            {
              "emit": "mt-credential-read",
              "to": "key-service"
            }
          ]
        },
        {
          "id": "mt-permanent-i",
          "from": "mt-queued-i",
          "to": "mt-failed-i",
          "on": "mt-attempt",
          "guard": "event.result == 'permanent'",
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "credentialReads",
              "to": "credentialReads + 1"
            },
            {
              "set": "failReason",
              "to": "event.reason"
            },
            {
              "set": "attemptsAtFail",
              "to": "attempts"
            },
            {
              "emit": "mt-credential-read",
              "to": "key-service"
            },
            {
              "emit": "mt-message-failed",
              "to": "mail-dispatcher"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "mt-queued-i": "mt-queued",
          "mt-sent-i": "mt-sent",
          "mt-failed-i": "mt-failed",
          "mt-discarded-i": "mt-discarded"
        },
        "variables": {
          "attempts": "attempts",
          "credentialReads": "credentialReads",
          "failReason": "failReason",
          "attemptsAtFail": "attemptsAtFail"
        },
        "transitions": {
          "mt-discard-expired-link-i": "mt-discard-expired-link",
          "mt-accepted-i": "mt-accepted",
          "mt-temporary-i": "mt-temporary",
          "mt-permanent-i": "mt-permanent"
        }
      },
      "storage": {
        "record": "rec-mail-message",
        "key": "message-id",
        "fields": {
          "credentialReads": "credential-reads",
          "failReason": "fail-reason",
          "attemptsAtFail": "attempts-at-fail"
        },
        "stateValues": {
          "mt-queued-i": "queued",
          "mt-sent-i": "sent",
          "mt-failed-i": "failed",
          "mt-discarded-i": "discarded"
        }
      }
    },
    {
      "id": "mail-quota-flow",
      "name": "Mail quota",
      "subject": "mail-dispatcher",
      "initial": "mq-live",
      "description": "The release of mail by the dispatcher for two tenants, a and b, each with a quota of two bulk messages. A message beyond the quota of its tenant is held. Sign-in mail is never held, and a tenant within its quota is not held because another tenant exceeded its own.",
      "variables": [
        {
          "name": "quota",
          "type": "number",
          "initial": 2
        },
        {
          "name": "usedA",
          "type": "number",
          "initial": 0
        },
        {
          "name": "usedB",
          "type": "number",
          "initial": 0
        },
        {
          "name": "heldA",
          "type": "number",
          "initial": 0
        },
        {
          "name": "heldB",
          "type": "number",
          "initial": 0
        },
        {
          "name": "signins",
          "type": "number",
          "initial": 0
        },
        {
          "name": "signinsSent",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "mq-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "mq-hold-signin",
          "from": "mq-live",
          "to": "mq-live",
          "on": "mq-release",
          "description": "Defect: holds sign-in mail while a tenant is over its quota.",
          "guard": "event.signin && usedA >= quota",
          "faultOnly": true,
          "effects": [
            {
              "set": "signins",
              "to": "signins + 1"
            },
            {
              "emit": "mq-held"
            }
          ]
        },
        {
          "id": "mq-hold-within-quota",
          "from": "mq-live",
          "to": "mq-live",
          "on": "mq-release",
          "description": "Defect: holds the mail of a tenant within its quota because another tenant is over its own.",
          "guard": "!event.signin && event.tenant == 'b' && usedA >= quota",
          "faultOnly": true,
          "effects": [
            {
              "set": "heldB",
              "to": "heldB + 1"
            },
            {
              "emit": "mq-held"
            }
          ]
        },
        {
          "id": "mq-send-over-quota",
          "from": "mq-live",
          "to": "mq-live",
          "on": "mq-release",
          "description": "Defect: releases mail beyond the quota of its tenant.",
          "guard": "!event.signin && event.tenant == 'a' && usedA >= quota",
          "faultOnly": true,
          "effects": [
            {
              "set": "usedA",
              "to": "usedA + 1"
            },
            {
              "emit": "mq-sent"
            }
          ]
        },
        {
          "id": "mq-send-signin",
          "from": "mq-live",
          "to": "mq-live",
          "on": "mq-release",
          "guard": "event.signin",
          "effects": [
            {
              "set": "signins",
              "to": "signins + 1"
            },
            {
              "set": "signinsSent",
              "to": "signinsSent + 1"
            },
            {
              "emit": "mq-sent"
            }
          ]
        },
        {
          "id": "mq-send-a",
          "from": "mq-live",
          "to": "mq-live",
          "on": "mq-release",
          "guard": "event.tenant == 'a' && usedA < quota",
          "effects": [
            {
              "set": "usedA",
              "to": "usedA + 1"
            },
            {
              "emit": "mq-sent"
            }
          ]
        },
        {
          "id": "mq-send-b",
          "from": "mq-live",
          "to": "mq-live",
          "on": "mq-release",
          "guard": "event.tenant == 'b' && usedB < quota",
          "effects": [
            {
              "set": "usedB",
              "to": "usedB + 1"
            },
            {
              "emit": "mq-sent"
            }
          ]
        },
        {
          "id": "mq-hold-a",
          "from": "mq-live",
          "to": "mq-live",
          "on": "mq-release",
          "guard": "event.tenant == 'a'",
          "effects": [
            {
              "set": "heldA",
              "to": "heldA + 1"
            },
            {
              "emit": "mq-held"
            }
          ]
        },
        {
          "id": "mq-hold-b",
          "from": "mq-live",
          "to": "mq-live",
          "on": "mq-release",
          "effects": [
            {
              "set": "heldB",
              "to": "heldB + 1"
            },
            {
              "emit": "mq-held"
            }
          ]
        }
      ]
    },
    {
      "id": "mail-quota-flow-impl",
      "name": "Mail quota (implementation)",
      "level": "implementation",
      "subject": "mail-dispatcher",
      "refines": "mail-quota-flow",
      "description": "The release of mail by the dispatcher for two tenants, a and b, each with a quota of two bulk messages. A message beyond the quota of its tenant is held. Sign-in mail is never held, and a tenant within its quota is not held because another tenant exceeded its own.",
      "initial": "mq-live-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "quota",
          "type": "number",
          "initial": 2,
          "repr": "u32"
        },
        {
          "name": "usedA",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "usedB",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "heldA",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "heldB",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "signins",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "signinsSent",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        }
      ],
      "states": [
        {
          "id": "mq-live-i",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "mq-send-signin-i",
          "from": "mq-live-i",
          "to": "mq-live-i",
          "on": "mq-release",
          "guard": "event.signin",
          "effects": [
            {
              "set": "signins",
              "to": "signins + 1"
            },
            {
              "set": "signinsSent",
              "to": "signinsSent + 1"
            },
            {
              "emit": "mq-sent",
              "to": "mail-dispatcher"
            }
          ]
        },
        {
          "id": "mq-send-a-i",
          "from": "mq-live-i",
          "to": "mq-live-i",
          "on": "mq-release",
          "guard": "event.tenant == 'a' && usedA < quota",
          "effects": [
            {
              "set": "usedA",
              "to": "usedA + 1"
            },
            {
              "emit": "mq-sent",
              "to": "mail-dispatcher"
            }
          ]
        },
        {
          "id": "mq-send-b-i",
          "from": "mq-live-i",
          "to": "mq-live-i",
          "on": "mq-release",
          "guard": "event.tenant == 'b' && usedB < quota",
          "effects": [
            {
              "set": "usedB",
              "to": "usedB + 1"
            },
            {
              "emit": "mq-sent",
              "to": "mail-dispatcher"
            }
          ]
        },
        {
          "id": "mq-hold-a-i",
          "from": "mq-live-i",
          "to": "mq-live-i",
          "on": "mq-release",
          "guard": "event.tenant == 'a'",
          "effects": [
            {
              "set": "heldA",
              "to": "heldA + 1"
            },
            {
              "emit": "mq-held",
              "to": "mail-dispatcher"
            }
          ]
        },
        {
          "id": "mq-hold-b-i",
          "from": "mq-live-i",
          "to": "mq-live-i",
          "on": "mq-release",
          "otherwise": true,
          "effects": [
            {
              "set": "heldB",
              "to": "heldB + 1"
            },
            {
              "emit": "mq-held",
              "to": "mail-dispatcher"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "mq-live-i": "mq-live"
        },
        "variables": {
          "quota": "quota",
          "usedA": "usedA",
          "usedB": "usedB",
          "heldA": "heldA",
          "heldB": "heldB",
          "signins": "signins",
          "signinsSent": "signinsSent"
        },
        "transitions": {
          "mq-send-signin-i": "mq-send-signin",
          "mq-send-a-i": "mq-send-a",
          "mq-send-b-i": "mq-send-b",
          "mq-hold-a-i": "mq-hold-a",
          "mq-hold-b-i": "mq-hold-b"
        }
      },
      "storage": {
        "record": "rec-mail-quota",
        "key": "tenant-id",
        "fields": {
          "usedA": "used-a",
          "usedB": "used-b",
          "heldA": "held-a",
          "heldB": "held-b",
          "signinsSent": "signins-sent"
        },
        "creates": true
      }
    },
    {
      "id": "mail-provider-flow",
      "name": "Mail provider selection",
      "subject": "mail-dispatcher",
      "initial": "mp-live",
      "description": "The dispatcher sends through the provider that the configuration names at the moment of the send. A change of the configured provider takes effect on the next send, with no restart and so no new image.",
      "variables": [
        {
          "name": "configured",
          "type": "string",
          "initial": "provider-1"
        },
        {
          "name": "startupProvider",
          "type": "string",
          "initial": "provider-1"
        },
        {
          "name": "usedProvider",
          "type": "string",
          "initial": ""
        },
        {
          "name": "configuredAtSend",
          "type": "string",
          "initial": ""
        },
        {
          "name": "sends",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "mp-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "mp-send-startup-provider",
          "from": "mp-live",
          "to": "mp-live",
          "on": "mp-send",
          "description": "Defect: the provider is fixed when the process starts, so a change needs a restart or a new image.",
          "faultOnly": true,
          "effects": [
            {
              "set": "sends",
              "to": "sends + 1"
            },
            {
              "set": "usedProvider",
              "to": "startupProvider"
            },
            {
              "set": "configuredAtSend",
              "to": "configured"
            },
            {
              "emit": "mp-posted"
            }
          ]
        },
        {
          "id": "mp-send-t",
          "from": "mp-live",
          "to": "mp-live",
          "on": "mp-send",
          "effects": [
            {
              "set": "sends",
              "to": "sends + 1"
            },
            {
              "set": "usedProvider",
              "to": "configured"
            },
            {
              "set": "configuredAtSend",
              "to": "configured"
            },
            {
              "emit": "mp-posted"
            }
          ]
        },
        {
          "id": "mp-configure-t",
          "from": "mp-live",
          "to": "mp-live",
          "on": "mp-configure",
          "effects": [
            {
              "set": "configured",
              "to": "event.provider"
            }
          ]
        }
      ]
    },
    {
      "id": "mail-provider-flow-impl",
      "name": "Mail provider selection (implementation)",
