      "name": "A write at a level the definition closed",
      "description": "The team level is closed, then a team override is written.",
      "behaviors": [
        "st-resolution-flow"
      ],
      "steps": [
        {
          "at": 0,
          "event": "st-write-asked",
          "payload": {
            "level": "tenant",
            "subject": "",
            "value": 3,
            "expected": 0
          }
        },
        {
          "at": 1,
          "event": "st-team-level-closed"
        },
        {
          "at": 2,
          "event": "st-write-asked",
          "payload": {
            "level": "team",
            "subject": "alpha",
            "value": 5,
            "expected": 1
          }
        },
        {
          "at": 3,
          "event": "st-read-asked"
        }
      ]
    },
    {
      "id": "st-locked-level",
      "name": "A tenant lock hides and keeps the person level",
      "description": "The person holds an override, the tenant locks the setting, a person write is refused and a read gives the tenant value, then the lock is lifted and the person value applies again.",
      "behaviors": [
        "st-resolution-flow"
      ],
      "steps": [
        {
          "at": 0,
          "event": "st-write-asked",
          "payload": {
            "level": "tenant",
            "subject": "",
            "value": 3,
            "expected": 0
          }
        },
        {
          "at": 1,
          "event": "st-write-asked",
          "payload": {
            "level": "person",
            "subject": "",
            "value": 7,
            "expected": 1
          }
        },
        {
          "at": 2,
          "event": "st-tenant-lock-set"
        },
        {
          "at": 3,
          "event": "st-write-asked",
          "payload": {
            "level": "person",
            "subject": "",
            "value": 8,
            "expected": 2
          }
        },
        {
          "at": 4,
          "event": "st-read-asked"
        },
        {
          "at": 5,
          "event": "st-tenant-lock-lifted"
        },
        {
          "at": 6,
          "event": "st-read-asked"
        }
      ]
    },
    {
      "id": "ag-repeat-ask",
      "name": "The same reader asks twice",
      "description": "Two requests of one audience class with no commit between them: the second is answered from the stored result.",
      "behaviors": [
        "ag-copy-flow"
      ],
      "steps": [
        {
          "at": 0,
          "event": "ag-asked",
          "payload": {
            "class": 1,
            "scan": 40
          }
        },
        {
          "at": 1,
          "event": "ag-asked",
          "payload": {
            "class": 1,
            "scan": 40
          }
        }
      ]
    },
    {
      "id": "ag-commit-between",
      "name": "A commit lands between two requests",
      "description": "The first request stores a result. A commit to an object type the aggregate reads lands at tick 2, and the second request arrives at tick 4.",
      "behaviors": [
        "ag-copy-flow"
      ],
      "faults": [
        "ag-concurrent-commit"
      ],
      "steps": [
        {
          "at": 0,
          "event": "ag-asked",
          "payload": {
            "class": 1,
            "scan": 40
          }
        },
        {
          "at": 4,
          "event": "ag-asked",
          "payload": {
            "class": 1,
            "scan": 40
          },
          "note": "After the commit."
        }
      ]
    },
    {
      "id": "ag-two-classes",
      "name": "Two audience classes ask",
      "description": "A reader of class 1 asks, then a reader of class 2.",
      "behaviors": [
        "ag-copy-flow"
      ],
      "steps": [
        {
          "at": 0,
          "event": "ag-asked",
          "payload": {
            "class": 1,
            "scan": 40
          }
        },
        {
          "at": 1,
          "event": "ag-asked",
          "payload": {
            "class": 2,
            "scan": 40
          }
        }
      ]
    },
    {
      "id": "ag-over-bound",
      "name": "An aggregate would examine more than its bound",
      "description": "The aggregate would examine 500 records against a bound of 100.",
      "behaviors": [
        "ag-copy-flow"
      ],
      "steps": [
        {
          "at": 0,
          "event": "ag-asked",
          "payload": {
            "class": 1,
            "scan": 500
          }
        }
      ]
    },
    {
      "id": "promotion-redeemed-and-retried",
      "name": "A promotion is redeemed, retried, redeemed again and tried by a non-member",
      "behaviors": [
        "promotion-redeem-flow"
      ],
      "description": "a redeems with a1 and retries a1; a tries again with a2 past the limit of one; b redeems with b1; a non-member tries with c1.",
      "steps": [
        {
          "at": 0,
          "event": "opr-redeem-requested",
          "payload": {
            "person": "a",
            "key": "a1",
            "member": true
          }
        },
        {
          "at": 1,
          "event": "opr-redeem-requested",
          "payload": {
            "person": "a",
            "key": "a1",
            "member": true
          },
          "note": "The retry."
        },
        {
          "at": 2,
          "event": "opr-redeem-requested",
          "payload": {
            "person": "a",
            "key": "a2",
            "member": true
          }
        },
        {
          "at": 3,
          "event": "opr-redeem-requested",
          "payload": {
            "person": "b",
            "key": "b1",
            "member": true
          }
        },
        {
          "at": 4,
          "event": "opr-redeem-requested",
          "payload": {
            "person": "a",
            "key": "c1",
            "member": false
          },
          "note": "Not in the segment."
        }
      ]
    },
    {
      "id": "promotion-redeem-delivered-twice",
      "name": "An invocation is delivered twice",
      "behaviors": [
        "promotion-redeem-flow"
      ],
      "faults": [
        "opr-redeem-delivered-twice"
      ],
      "description": "a redeems with a1 and the request reaches the decision twice; b redeems with b1.",
      "steps": [
        {
          "at": 0,
          "event": "opr-redeem-requested",
          "payload": {
            "person": "a",
            "key": "a1",
            "member": true
          }
        },
        {
          "at": 2,
          "event": "opr-redeem-requested",
          "payload": {
            "person": "b",
            "key": "b1",
            "member": true
          }
        }
      ]
    },
    {
      "id": "promotion-pool-exhausted",
      "name": "The stock of a promotion runs out",
      "behaviors": [
        "promotion-redeem-flow"
      ],
      "description": "a and b take the stock of two; d is refused because the pool would pass its floor, and the refusal leaves no redemption and no count.",
      "steps": [
        {
          "at": 0,
          "event": "opr-redeem-requested",
          "payload": {
            "person": "a",
            "key": "a1",
            "member": true
          }
        },
        {
          "at": 1,
          "event": "opr-redeem-requested",
          "payload": {
            "person": "b",
            "key": "b1",
            "member": true
          }
        },
        {
          "at": 2,
          "event": "opr-redeem-requested",
          "payload": {
            "person": "d",
            "key": "d1",
            "member": true
          }
        }
      ]
    },
    {
      "id": "promotion-window-closed",
      "name": "A promotion is redeemed after its window",
      "behaviors": [
        "promotion-redeem-flow"
      ],
      "description": "The window closes, then a tries to redeem.",
      "steps": [
        {
          "at": 0,
          "event": "opr-window-closed"
        },
        {
          "at": 1,
          "event": "opr-redeem-requested",
          "payload": {
            "person": "a",
            "key": "a1",
            "member": true
          }
        }
      ]
    },
    {
      "id": "automation-run-as-definer-demoted",
      "name": "The definer of an automation is demoted",
      "description": "A step runs at tick 1. At tick 2 the definer loses a role of the run-as and the automation is suspended. The step due at tick 3 is parked. At tick 4 a principal who lacks the role defines it again and is refused; at tick 5 an owner does, and the step at tick 6 runs.",
      "behaviors": [
        "automation-run-as-flow"
      ],
      "steps": [
        {
          "at": 1,
          "event": "ra-step"
        },
        {
          "at": 2,
          "event": "ra-authority",
          "payload": {
            "holds": false
          }
        },
        {
          "at": 3,
          "event": "ra-step"
        },
        {
          "at": 4,
          "event": "ra-redefine",
          "payload": {
            "holds": false
          }
        },
        {
          "at": 5,
          "event": "ra-redefine",
          "payload": {
            "holds": true
          }
        },
        {
          "at": 6,
          "event": "ra-step"
        }
      ]
    },
    {
      "id": "automation-run-as-unrelated-change",
      "name": "A change that keeps the definer's authority",
      "description": "At tick 1 the definer's roles change but the definer may still confer every role of the run-as; the step at tick 2 runs.",
      "behaviors": [
        "automation-run-as-flow"
      ],
      "steps": [
        {
          "at": 1,
          "event": "ra-authority",
          "payload": {
            "holds": true
          }
        },
        {
          "at": 2,
          "event": "ra-step"
        }
      ]
    },
    {
      "id": "automation-wait-loop-reaches-limit",
      "name": "A loop through a waiting automation reaches the hop limit",
      "description": "An event at hop 1 starts a run that waits five ticks and commits a change at hop 2, which starts the automation again. The ninth event, at hop 9 and tick 40, is declined with a record.",
      "behaviors": [
        "automation-wait-hop-flow"
      ],
      "steps": [
        {
          "at": 0,
          "event": "wh-event",
          "payload": {
            "hop": 1
          }
        }
      ]
    },
    {
      "id": "automation-wait-schedule-starts-fresh",
      "name": "An event of a schedule starts a fresh chain",
      "description": "An event at hop 9 is declined at tick 0; an event of an owner's schedule at tick 2, which carries hop 0, starts a run.",
      "behaviors": [
        "automation-wait-hop-flow"
      ],
      "steps": [
        {
          "at": 0,
          "event": "wh-event",
          "payload": {
            "hop": 9
          }
        },
        {
          "at": 2,
          "event": "wh-event",
          "payload": {
            "hop": 0
          },
          "note": "An event of a schedule carries hop count zero."
        }
      ]
    },
    {
      "id": "automation-job-quota-burst",
      "name": "Three commits against a quota of two",
      "description": "Three commits at ticks 1 to 3 all commit: two jobs are created and the third is held. The quota day ends at tick 4 and the held job counts against the new day; a commit at tick 5 creates its job.",
      "behaviors": [
        "automation-job-quota-flow"
      ],
      "steps": [
        {
          "at": 1,
          "event": "jq-commit"
        },
        {
          "at": 2,
          "event": "jq-commit"
        },
        {
          "at": 3,
          "event": "jq-commit"
        },
        {
          "at": 4,
          "event": "jq-day"
        },
        {
          "at": 5,
          "event": "jq-commit"
        }
      ]
    },
    {
      "id": "automation-step-retried-after-lost-result",
      "name": "A step is retried after its result was lost",
      "description": "The first attempt at tick 1 applies the effect and its result is lost; the attempts at ticks 3 and 5 are answered from the key.",
      "behaviors": [
        "automation-step-key-flow"
      ],
      "steps": [
        {
          "at": 1,
          "event": "sk-attempt"
        },
        {
          "at": 3,
          "event": "sk-attempt"
        },
        {
          "at": 5,
          "event": "sk-attempt"
        }
      ]
    },
    {
      "id": "automation-activation-step-outside-catalogue",
      "name": "An automation names a step kind outside the catalogue",
      "description": "A projection runs at tick 1; activation of an automation with an action that is not a variant of automation-step is asked for at tick 2 and refused; the corrected automation is activated at tick 3 (INT-1522).",
      "behaviors": [
        "workflow-activation-flow"
      ],
      "steps": [
        {
          "at": 1,
          "event": "wa-project"
        },
        {
          "at": 2,
          "event": "wa-activate",
          "payload": {
            "inCatalogue": false
          }
        },
        {
          "at": 3,
          "event": "wa-activate",
          "payload": {
            "inCatalogue": true
          }
        }
      ]
    },
    {
      "id": "author-invokes-delete-tenant",
      "name": "An author invokes the catalogue entry of delete-tenant",
      "description": "The author holds the operation-invoke capability and none of the capabilities of delete-tenant, so the invocation is refused.",
      "behaviors": [
        "catalogue-invocation-flow"
      ],
      "steps": [
        {
          "at": 0,
          "event": "ci-invoked",
          "payload": {
            "capability": "missing"
          },
          "note": "The author invokes delete-tenant through the catalogue."
        }
      ]
    },
    {
      "id": "author-invokes-export-tenant",
      "name": "An author invokes the catalogue entry of export-tenant",
      "description": "The author holds the operation-invoke capability and none of the capabilities of export-tenant, so the invocation is refused.",
      "behaviors": [
        "catalogue-invocation-flow"
      ],
      "steps": [
        {
          "at": 0,
          "event": "ci-invoked",
          "payload": {
            "capability": "missing"
          },
          "note": "The author invokes export-tenant through the catalogue."
        }
      ]
    },
    {
      "id": "author-invokes-issue-access-grant",
      "name": "An author invokes the catalogue entry of issue-access-grant",
      "description": "The author holds the operation-invoke capability and none of the capabilities of issue-access-grant, so the invocation is refused.",
      "behaviors": [
        "catalogue-invocation-flow"
      ],
      "steps": [
        {
          "at": 0,
          "event": "ci-invoked",
          "payload": {
            "capability": "missing"
          },
          "note": "The author invokes issue-access-grant through the catalogue."
        }
      ]
    }
