          "from": "fedp-open",
          "to": "fedp-open",
          "on": "fedp-presented",
          "faultOnly": true,
          "guard": "(!(!event.domainBound || event.method == 'federated'))",
          "description": "Defect: accepts although the condition \"is not a password or emailed-link sign-in for a bound domain\" does not hold.",
          "effects": [
            {
              "emit": "fedp-accepted"
            }
          ]
        },
        {
          "id": "fedp-accept",
          "from": "fedp-open",
          "to": "fedp-open",
          "on": "fedp-presented",
          "guard": "(!event.domainBound || event.method == 'federated')",
          "effects": [
            {
              "emit": "fedp-accepted"
