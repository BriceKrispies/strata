    {"id":"password-spray-one-source","name":"A password sprayed across accounts from one source","description":"Source a fails on three different accounts and is then refused on a fourth; source b is not affected. A concurrent connection of a tries one more account at tick 5.","behaviors":["source-throttle-flow"],"faults":["spray-continues"],"steps":[{"at":0,"event":"src-attempt","payload":{"source":"a","account":"x","guess":"wrong"}},{"at":1,"event":"src-attempt","payload":{"source":"a","account":"y","guess":"wrong"}},{"at":2,"event":"src-attempt","payload":{"source":"a","account":"z","guess":"wrong"}},{"at":3,"event":"src-attempt","payload":{"source":"a","account":"w","guess":"right"}},{"at":4,"event":"src-attempt","payload":{"source":"b","account":"x","guess":"right"}}]},
    {"id":"password-spray-one-source-impl","name":"A password sprayed across accounts from one source (implementation)","description":"Source a fails on three different accounts and is then refused on a fourth; source b is not affected. A concurrent connection of a tries one more account at tick 5.","behaviors":["source-throttle-flow-impl"],"faults":["spray-continues"],"steps":[{"at":0,"event":"src-attempt","payload":{"source":"a","account":"x","guess":"wrong"}},{"at":1,"event":"src-attempt","payload":{"source":"a","account":"y","guess":"wrong"}},{"at":2,"event":"src-attempt","payload":{"source":"a","account":"z","guess":"wrong"}},{"at":3,"event":"src-attempt","payload":{"source":"a","account":"w","guess":"right"}},{"at":4,"event":"src-attempt","payload":{"source":"b","account":"x","guess":"right"}}]},
    {"id":"session-ends-and-person-signs-in-again","name":"A session ends while the page is open","description":"The page starts signed in, a session frame ends the session, the read confirms it, and the person signs in and out again.","behaviors":["client-session-flow"],"steps":[{"at":0,"event":"ui-session-read","payload":{"authenticated":1},"note":"The page was served with a session."},{"at":1,"event":"ui-session-ended","note":"A session frame says the session expired."},{"at":2,"event":"ui-session-read","payload":{"authenticated":0},"note":"The session read says the visit is signed out."},{"at":3,"event":"ui-signed-in","note":"The person signs in again."},{"at":4,"event":"ui-signed-out","note":"The person signs out."}]},
    {"id":"session-ends-and-person-signs-in-again-impl","name":"A session ends while the page is open (implementation)","description":"The same journey on the implementation machine.","behaviors":["client-session-flow-impl"],"steps":[{"at":0,"event":"ui-session-read","payload":{"authenticated":1},"note":"The page was served with a session."},{"at":1,"event":"ui-session-ended","note":"A session frame says the session expired."},{"at":2,"event":"ui-session-read","payload":{"authenticated":0},"note":"The session read says the visit is signed out."},{"at":3,"event":"ui-signed-in","note":"The person signs in again."},{"at":4,"event":"ui-signed-out","note":"The person signs out."}]},
    {"id":"live-catch-up-after-reconnect","name":"The live connection resumes from the last sequence","description":"A first connection, a dropped socket and a reconnect that subscribes after the last sequence, then an event frame that goes missing.","behaviors":["client-live-flow"],"steps":[{"at":0,"event":"ui-live-start"},{"at":1,"event":"ui-live-welcome","payload":{"head":40,"heartbeat-ms":10000},"note":"First connection: subscribes with no position and takes the head."},{"at":2,"event":"ui-live-frame","payload":{"n":1,"seq":41}},{"at":3,"event":"ui-live-closed","note":"The socket drops."},{"at":4,"event":"ui-live-reconnect-due"},{"at":5,"event":"ui-live-welcome","payload":{"head":45,"heartbeat-ms":10000},"note":"Second connection: subscribes after sequence 41, so nothing between 41 and 45 is missed."},{"at":6,"event":"ui-live-frame","payload":{"n":1,"seq":42}},{"at":7,"event":"ui-live-frame","payload":{"n":3,"seq":44},"note":"Frame 2 never arrived: the client forgets its position and closes."},{"at":8,"event":"ui-live-closed"},{"at":9,"event":"ui-live-reconnect-due"}]},
    {"id":"live-catch-up-after-reconnect-impl","name":"The live connection resumes from the last sequence (implementation)","description":"The same journey on the implementation machine. Times are in milliseconds; the reconnect timers fire by themselves.","behaviors":["client-live-flow-impl"],"steps":[{"at":0,"event":"ui-live-start"},{"at":5,"event":"ui-live-welcome","payload":{"head":40,"heartbeat-ms":10000},"note":"First connection: subscribes with no position and takes the head."},{"at":100,"event":"ui-live-frame","payload":{"n":1,"seq":41}},{"at":150,"event":"ui-live-closed","note":"The socket drops; the reconnect timer of 500 ms fires at 650."},{"at":700,"event":"ui-live-welcome","payload":{"head":45,"heartbeat-ms":10000},"note":"Second connection: subscribes after sequence 41, so nothing between 41 and 45 is missed."},{"at":800,"event":"ui-live-frame","payload":{"n":1,"seq":42}},{"at":900,"event":"ui-live-frame","payload":{"n":3,"seq":44},"note":"Frame 2 never arrived: the client forgets its position and closes."},{"at":950,"event":"ui-live-closed","note":"The reconnect timer of 500 ms fires at 1450."}],"timeUnit":"ms"},
    {"id":"live-silent-server","name":"A server that stops answering pings","description":"The client pings on the heartbeat, hears one pong, then hears none and closes the socket.","behaviors":["client-live-flow"],"steps":[{"at":0,"event":"ui-live-start"},{"at":1,"event":"ui-live-welcome","payload":{"head":10,"heartbeat-ms":10000}},{"at":2,"event":"ui-live-heartbeat-due","note":"First ping."},{"at":3,"event":"ui-live-pong","payload":{"head":10},"note":"Answered: the count of missed pongs returns to 0."},{"at":4,"event":"ui-live-heartbeat-due"},{"at":5,"event":"ui-live-heartbeat-due"},{"at":6,"event":"ui-live-heartbeat-due","note":"Two pings without a pong: the client closes the socket."},{"at":7,"event":"ui-live-closed"},{"at":8,"event":"ui-live-reconnect-due"}]},
    {"id":"live-silent-server-impl","name":"A server that stops answering pings (implementation)","description":"The same journey on the implementation machine. Times are in milliseconds; the heartbeat and reconnect timers fire by themselves.","behaviors":["client-live-flow-impl"],"steps":[{"at":0,"event":"ui-live-start"},{"at":5,"event":"ui-live-welcome","payload":{"head":10,"heartbeat-ms":10000},"note":"The heartbeat timer of 10 s starts; it pings at 10005."},{"at":10010,"event":"ui-live-pong","payload":{"head":10},"note":"Answered: the count of missed pongs returns to 0."},{"at":40010,"event":"ui-live-closed","note":"Pings at 20005 and 30005 went unanswered, and the client closed the socket at 40005. The reconnect timer of 500 ms fires at 40510."}],"timeUnit":"ms"},
    {"id":"submit-refused-then-accepted","name":"A form is refused, then accepted","description":"An incomplete submit, a complete one that the gateway refuses, and one more that it accepts.","behaviors":["client-submit-flow"],"steps":[{"at":0,"event":"ui-form-submitted","payload":{"complete":0},"note":"A required field is empty: refused where it stands, no request."},{"at":1,"event":"ui-form-submitted","payload":{"complete":1}},{"at":2,"event":"ui-form-submitted","payload":{"complete":1},"note":"Pressed again while busy: nothing changes."},{"at":3,"event":"ui-form-refused","note":"The gateway refuses the request."},{"at":4,"event":"ui-form-submitted","payload":{"complete":1}},{"at":5,"event":"ui-form-accepted"}]},
    {"id":"submit-refused-then-accepted-impl","name":"A form is refused, then accepted (implementation)","description":"The same journey on the implementation machine.","behaviors":["client-submit-flow-impl"],"steps":[{"at":0,"event":"ui-form-submitted","payload":{"complete":0},"note":"A required field is empty: refused where it stands, no request."},{"at":1,"event":"ui-form-submitted","payload":{"complete":1}},{"at":2,"event":"ui-form-submitted","payload":{"complete":1},"note":"Pressed again while busy: nothing changes."},{"at":3,"event":"ui-form-refused","note":"The gateway refuses the request."},{"at":4,"event":"ui-form-submitted","payload":{"complete":1}},{"at":5,"event":"ui-form-accepted"}]},
    {
      "id": "job-run-poll-before-due",
      "name": "A worker polls before the job is due",
      "description": "The job is due at tick 10. A poll at tick 4 finds nothing due, and a poll at tick 12 offers the job.",
      "behaviors": [
        "job-run-flow"
      ],
      "steps": [
        {
          "at": 0,
          "event": "jr-created"
        },
        {
          "at": 4,
          "event": "jr-poll"
        },
        {
          "at": 12,
          "event": "jr-poll"
        }
      ]
    },
