          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "itemsNamed",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "itemsOther",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        }
      ],
      "states": [
        {
          "id": "ni-live-i",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "ni-deliver-i",
          "from": "ni-live-i",
          "to": "ni-live-i",
          "on": "ni-evaluate",
          "guard": "event.named",
          "effects": [
            {
              "set": "namedEvaluated",
