    {
      "id": "policy-problems",
      "description": "schema.rs TenantSchema::problems, one policy: an unknown role, a policy for the owner, an unknown object type, an action that does not fit the resource (Manage exactly on Schema and Members), a condition of a policy on every object that reads a field (mentions-field, the kernel's mentions_field), and otherwise a condition that does not check against the object's fields (no fields for a policy that names no object type).",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "roles",
          "type": "list<role-id>"
        },
        {
          "name": "policy",
          "type": "policy-def"
        }
      ],
      "returns": "list<string>",
      "let": [
        {
          "name": "at",
          "expr": "format('policy {}', policy.id)"
        },
        {
          "name": "p1",
          "expr": "concat(if any(r in roles, r == policy.role) then [] else [format('{}: unknown role {}', at, policy.role)], if policy.role == 'owner' then [format('{}: the owner role needs no policy', at)] else [])"
        },
        {
          "name": "p2",
          "expr": "match policy.resource { object(id) => if get(schema.objects, id) == null then [format('{}: unknown object type {}', at, id)] else [], _ => [] }"
        },
        {
          "name": "manage",
          "expr": "match policy.resource { schema => true, members => true, _ => false }"
        },
        {
          "name": "p3",
          "expr": "fold(a in policy.actions, ps = [], if manage != (a == action.manage) then concat(ps, [format('{}: action {} does not fit the resource', at, call action-debug(a))]) else ps)"
        },
        {
          "name": "shapes",
          "expr": "match policy.resource { object(id) => match get(schema.objects, id) { Some(o) => call field-shapes(o.fields), None => {} }, _ => {} }"
        },
        {
          "name": "p4",
          "expr": "match policy.condition { Some(c) => if (match policy.resource { any-object => true, _ => false }) && call mentions-field(c) then [format('{}: a policy on every object cannot read fields', at)] else match check(tenant-rule-language, c, expr-check-env{fields: shapes, params: [], roles}) { Ok(_) => [], Err(e) => [format('{}: {}', at, e)] }, None => [] }"
        }
      ],
      "body": "concat(concat(concat(p1, p2), p3), p4)",
      "examples": [
        {
          "description": "testkit.rs notes_schema writers_edit_own",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-4"
            },
            "roles": [
              "editor",
              "owner",
              "public",
              "writer"
            ],
            "policy": {
              "id": "writers_edit_own",
              "role": "writer",
              "resource": {
                "object": "note"
              },
              "actions": [
                "update",
                "delete"
              ],
              "condition": {
                "cmp": {
                  "op": "eq",
                  "left": {
                    "var": {
                      "scope": "record",
                      "field": "$created_by"
                    }
                  },
                  "right": "principal"
                }
              }
            }
          },
          "result": []
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-4"
            },
            "roles": [
              "editor",
              "owner",
              "public",
              "writer"
            ],
            "policy": {
              "id": "odd",
              "role": "guest",
              "resource": {
                "object": "tag"
              },
              "actions": [
                "read",
                "manage"
              ]
            }
          },
          "result": [
            "policy odd: unknown role guest",
            "policy odd: unknown object type tag",
            "policy odd: action Manage does not fit the resource"
          ]
