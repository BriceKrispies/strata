      "id": "jr-attempt-failed",
      "name": "Attempt failed",
      "description": "The worker reports that the attempt failed, with its error.",
      "payload": [
        {
          "name": "error",
          "type": "string"
        }
      ],
      "delivery": "at-least-once"
    },
    {
      "id": "jr-attempt-succeeded",
      "name": "Attempt succeeded",
      "description": "The worker reports that the attempt succeeded.",
      "delivery": "at-least-once"
    },
    {
      "id": "jr-cancel",
