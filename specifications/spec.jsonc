        },
        {
          "name": "automation",
          "type": "workflow-id"
        },
        {
          "name": "state",
          "type": "run-state"
        },
        {
          "name": "data",
          "type": "json",
          "personal": "other",
          "description": "The whole run as canonical JSON: its trigger, hop, current step, the automation principal its steps act as, the parameters of its event and the outputs of its steps (WFL-1530, WFL-1531)."
        }
      ],
      "retention": "Ninety days after the run ended (rec-workflow-run): the janitor removes an ended run past it (D-7703). A run that has not ended stays until the tenant file is deleted.",
      "erasure": {
        "point": "the deletion of the tenant file"
      },
      "description": "Table automation_runs of a tenant file: one row per run of an automation (rec-workflow-run, WFL-1531), replaced as the run moves."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-automation-steps",
      "name": "Automation run steps (tenant file)",
