          "type": "string",
          "initial": "provider-1",
          "repr": "string"
        },
        {
          "name": "usedProvider",
          "type": "string",
          "initial": "",
          "repr": "string"
        },
        {
          "name": "configuredAtSend",
          "type": "string",
          "initial": "",
          "repr": "string"
        },
        {
          "name": "sends",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        }
      ],
      "states": [
        {
