      "id": "tokint-flow",
      "name": "Token introspection",
      "subject": "identity-service",
      "initial": "tokint-open",
      "description": "A caller asks the introspection endpoint about a token. A permitted caller receives the scopes, the subject and the expiry of the token; another caller receives nothing.",
      "states": [
        {
          "id": "tokint-open",
          "name": "Deciding"
