    {
      "id": "view-section-step",
      "description": "crates/backend/src/ops.rs view, one section: its named read (section-request), then for each included field the records it names that the principal may read (included-refs, a records read). The rows and included records sent lose another principal's authorship (without-others-authorship); a single section's first row, authorship included, is kept for the sections that read it.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "state",
          "type": "state"
        },
        {
          "name": "texts",
          "type": "intent-texts"
        },
        {
          "name": "context",
          "type": "context"
        },
        {
          "name": "route",
          "type": "map<string, string>"
        },
        {
          "name": "request",
          "type": "map<string, string>"
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "section",
          "type": "view-section"
        },
        {
          "name": "acc",
          "type": "view-progress"
        }
      ],
      "returns": "view-progress",
      "errors": "api-failure",
      "let": [
        {
          "name": "result",
          "expr": "try call view-read(state, call section-request(section, route, request, acc.done), context, texts)"
        },
        {
          "name": "object",
          "expr": "match get(tenant.schema.queries, section.query) { Some(q) => q.object, None => '' }"
        },
        {
          "name": "refs",
          "expr": "call included-refs(tenant.schema, object, section, result.rows)"
        },
        {
          "name": "included",
          "expr": "fold(f in keys(refs), m = {}, match get(refs, f) { None => m, Some(tg) => insert(m, f, fold(r in (try call view-read(state, read-request.records{object: tg.object, ids: tg.ids}, context, texts)).rows, rs = {}, insert(rs, r.id, call without-others-authorship(context.principal, r)))) })"
        }
      ],
      "body": "view-progress{done: if section.single then insert(acc.done, name, get(result.rows, 0)) else acc.done, sections: insert(acc.sections, name, section-data{single: section.single, rows: map(r in result.rows, call without-others-authorship(context.principal, r)), included, markdown: section.markdown}), revision: result.revision}",
      "examples": [
