        "doc": "The requirements that say what must happen under this fault."
      },
      {
        "entity": "claim",
        "name": "models",
        "type": "ref",
        "ref": [
          "claim"
        ],
        "label": "Checks requirement",
        "doc": "For a check over the behavior model (not a requirement itself): the requirement it restates as a condition on simulated traces."
      }
    ],
    "verificationMethods": {
      "conformance": {
        "label": "Conformance",
        "description": "When: An umbrella whose detail is a case table (see spec-format.md). Proof: One table-driven test through the boundary. It reads the `Cases:` files, runs every row, and fails with every failing row named, never only the first. Adding a row adds a case without touching the test. (docs/agents/verification.md)"
      },
      "property": {
        "label": "Property",
        "description": "When: \"For every\", \"never\", \"always\", and invariants. Proof: A property-based test through the boundary, with generated inputs and shrinking. A fixed seed and case count are recorded in the test. (docs/agents/verification.md)"
      },
      "scenario": {
        "label": "Scenario",
        "description": "When: A workflow of several steps, or a failure and recovery. Proof: An end-to-end test that drives the boundary as a user would: run the CLI, call the API, read the files. (docs/agents/verification.md)"
      },
      "example": {
        "label": "Example",
        "description": "When: One concrete input decides it. Proof: One case through the boundary: input in, observed output compared with the expected output. Golden files for formats. (docs/agents/verification.md)"
      },
      "proof": {
        "label": "Proof",
        "description": "When: A mathematical property of an algorithm or model (Lean 4). Proof: A Lean `theorem` whose doc comment declares `Verifies: ID`. It must build with no `sorry`. (docs/agents/verification.md)"
      },
      "budget": {
        "label": "Budget",
        "description": "When: A time, size, memory or count limit. Proof: A measurement that records the number and fails above the limit, at the measurement point, clock and machine class its row in `specifications/21-verification/cases/budget-measurement.md` names. A protocol timer, retention period or alert deadline is measured on the simulator's virtual clock and needs no machine; a latency or throughput limit is measured in the benchmark harness on the named machine class. (docs/agents/verification.md)"
      }
    }
  },

  // ---- Components (C-n) and the relationships between them ---------------------------------------
  "components": [
    {"id":"kernel","name":"Kernel","category":"logical","purpose":"Pure decision functions: decide an intent, answer a read, plan the state a decision needs.","responsibilities":["Decide transitions","Authorise by policy","Validate records and schema changes","Describe effects as data"],"trustZone":"core","ref":"C-1","implementation":{"status":"manual","notes":"crates/kernel"}},
    {"id":"substrate","name":"Substrate","category":"logical","purpose":"Pure interpreters around kernel data: bundles, expressions as text, view projection, constrained Markdown, themes.","responsibilities":["Install tenant bundles as intents","Project views","Parse rich text into blocks"],"trustZone":"core","ref":"C-2","implementation":{"status":"manual","notes":"crates/substrate"}},
    {"id":"store-contract","name":"Store contract","category":"logical","purpose":"The persistence contract and its conformance suite.","responsibilities":["State what a store guarantees","Run the conformance suite"],"trustZone":"core","ref":"C-3","implementation":{"status":"manual","notes":"crates/storage-api"}},
    {"id":"sqlite-adapter","name":"SQLite adapter","category":"storage","purpose":"The store contract on a SQLite file, for one process, tests and simulation.","responsibilities":["Atomic commits","Durable event log and outbox"],"trustZone":"data","ref":"C-4","implementation":{"status":"manual","notes":"crates/storage-sqlite"}},
    {"id":"postgres-adapter","name":"PostgreSQL adapter","category":"storage","purpose":"The store contract on one PostgreSQL database per tenant.","responsibilities":["Open a tenant database from its placement","Hold connections within the tenant quota"],"trustZone":"data","ref":"C-5","implementation":{"status":"not-implemented"}},
    {"id":"tenant-database","name":"Tenant database","category":"storage","purpose":"One PostgreSQL database per tenant holding everything the tenant owns.","responsibilities":["Hold schema, records, events, journal, jobs, realm and audit log of one tenant"],"trustZone":"data","ref":"C-6","implementation":{"status":"not-implemented"}},
    {"id":"control-plane","name":"Control plane","category":"computational","purpose":"Owns the tenant directory and carries out tenant lifecycle operations.","responsibilities":["Provision, suspend, export, move and delete tenants","Bind domains","Keep the wake index"],"trustZone":"control","ref":"C-7","implementation":{"status":"not-implemented"}},
    {"id":"control-database","name":"Control database","category":"storage","purpose":"Holds the tenant directory, placements, domain bindings and the wake index, and no tenant content.","responsibilities":["Hold identifiers, states and addresses"],"trustZone":"control","ref":"C-8","implementation":{"status":"not-implemented"}},
    {"id":"identity-service","name":"Identity service","category":"computational","purpose":"The only component that handles credentials: sign-in methods, sessions, factors, federation, tokens.","responsibilities":["Authenticate people","Issue and revoke sessions","Sign assertions and access tokens","Record every authentication decision"],"trustZone":"identity","ref":"C-9","implementation":{"status":"not-implemented","notes":"Sign-in and sessions exist today inside the runtime (crates/backend/src/auth.rs) and move here."}},
    {"id":"runtime","name":"Runtime","category":"computational","purpose":"Runs the kernel for a tenant: loads state through the store contract, decides, commits, publishes events.","responsibilities":["Execute intents and reads","Publish committed events from the outbox","Maintain stored view copies"],"trustZone":"tenant","ref":"C-10","implementation":{"status":"manual","notes":"crates/backend"}},
    {"id":"gateway","name":"Gateway","category":"computational","purpose":"The only component a browser reaches: resolves the tenant from the host, carries the session, projects views.","responsibilities":["Resolve tenant by host","Guard state-changing requests","Relay the event stream","Apply request limits"],"trustZone":"edge","ref":"C-11","implementation":{"status":"manual","notes":"crates/bff"}},
    {"id":"scheduler","name":"Scheduler","category":"computational","purpose":"Finds due work through the wake index and hands jobs to workers under leases.","responsibilities":["Grant and expire leases","Retry failed attempts","Record outcomes"],"trustZone":"tenant","ref":"C-12","implementation":{"status":"not-implemented"}},
    {"id":"workflow-engine","name":"Workflow engine","category":"computational","purpose":"Advances workflow runs by asking the kernel to decide each step.","responsibilities":["Advance runs","Run compensations","Wait for approvals"],"trustZone":"tenant","ref":"C-13","implementation":{"status":"not-implemented"}},
    {"id":"connector-runner","name":"Connector runner","category":"computational","purpose":"Carries out external effects after commit: HTTP calls, webhooks, mail.","responsibilities":["Call external addresses","Refuse private addresses","Record idempotency keys with outcomes"],"trustZone":"egress","ref":"C-14","implementation":{"status":"not-implemented"}},
    {"id":"copy-store","name":"Copy store","category":"storage","purpose":"Holds stored view copies keyed by the versions they were computed from.","responsibilities":["Store and serve copies by key","Remove copies by tag"],"trustZone":"data","ref":"C-15","implementation":{"status":"not-implemented"}},
    {"id":"file-store","name":"File store","category":"storage","purpose":"Holds tenant files addressed by content hash in a namespace per tenant.","responsibilities":["Store and serve objects","Sign addresses for private objects"],"trustZone":"data","ref":"C-16","implementation":{"status":"not-implemented"}},
    {"id":"delivery-network","name":"Content delivery network","category":"external","purpose":"Holds edge copies of public responses close to readers.","responsibilities":["Serve stored responses by host and path","Purge by surrogate key","Terminate TLS for tenant domains"],"trustZone":"public","ref":"C-17","implementation":{"status":"not-implemented"}},
    {"id":"agent-gateway","name":"Agent gateway","category":"computational","purpose":"Serves the operation catalogue, dry runs and proposals to agents and operators.","responsibilities":["List operations per principal","Run dry runs and projections","Hold proposals and approvals","Apply operation budgets"],"trustZone":"edge","ref":"C-18","implementation":{"status":"not-implemented"}},
    {"id":"telemetry-pipeline","name":"Telemetry pipeline","category":"infrastructure","purpose":"Collects traces, metrics and logs from every component.","responsibilities":["Receive telemetry","Export to a backend"],"trustZone":"operations","ref":"C-19","implementation":{"status":"not-implemented"}},
    {"id":"audit-log","name":"Audit log","category":"storage","purpose":"The append-only, hash-chained record of security-relevant actions. Each tenant's entries are held in that tenant's database; platform operations are held in the control database.","responsibilities":["Append entries","Verify the chain"],"trustZone":"data","ref":"C-20","implementation":{"status":"not-implemented"}},
    {"id":"key-service","name":"Key service","category":"external","purpose":"Holds the wrapping keys of tenant data keys.","responsibilities":["Wrap and unwrap data keys","Destroy a key"],"trustZone":"operations","ref":"C-21","implementation":{"status":"not-implemented"}},
    {"id":"mail-service","name":"Mail service","category":"external","purpose":"Delivers mail.","responsibilities":["Deliver a templated message to one address"],"trustZone":"egress","ref":"C-22","implementation":{"status":"not-implemented"}},
    {"id":"external-identity-provider","name":"External identity provider","category":"external","purpose":"An OpenID Connect or SAML provider that a tenant configured.","responsibilities":["Authenticate the tenant's people","Provision and deprovision through SCIM"],"trustZone":"public","ref":"C-23","implementation":{"status":"not-implemented"}},
    {"id":"web-application","name":"Web application","category":"client","purpose":"The reader site, the authoring application and the sign-in pages in the browser.","responsibilities":["Render view models","Send intents through the worker kernel"],"trustZone":"public","ref":"C-24","implementation":{"status":"manual","notes":"web"}},
    {"id":"simulator","name":"Simulator","category":"logical","purpose":"Runs the kernel under a schedule with logical time and injected faults, and compares executions.","responsibilities":["Run scenarios","Project proposed changes","Replay journals"],"trustZone":"core","ref":"C-25","implementation":{"status":"manual","notes":"crates/simulation"}},
    {"id":"verification","name":"Verification","category":"logical","purpose":"State invariants, the Lean model and its correspondence with the kernel.","responsibilities":["Evaluate invariants","Check the Lean proofs","Compare model and kernel"],"trustZone":"core","ref":"C-26","implementation":{"status":"manual","notes":"crates/verification, lean"}},
    {"id":"agent","name":"Agent","category":"client","purpose":"A program acting through the operation catalogue, for itself or for a person.","responsibilities":["Discover operations","Propose and apply changes"],"trustZone":"public","ref":"C-27","implementation":{"status":"not-implemented"}},
    {"id":"limit-store","name":"Limit store","category":"storage","purpose":"Holds shared counters for request rates and agent operation budgets, so that every instance of a component enforces one limit.","responsibilities":["Count requests by key within a window","Expire windows"],"trustZone":"data","ref":"C-100","implementation":{"status":"not-implemented"}},
    {"id":"backup-archive","name":"Backup archive","category":"storage","purpose":"Holds point-in-time copies of each tenant database, encrypted under the key of that tenant.","responsibilities":["Store copies of one tenant database","Restore one tenant to a point in time","Expire copies by retention"],"trustZone":"data","ref":"C-101","implementation":{"status":"not-implemented"}},
    {"id":"fleet-reporting","name":"Fleet reporting","category":"storage","purpose":"Holds telemetry and the summaries tenants publish, for reports that span tenants.","responsibilities":["Hold summaries keyed by tenant identifier","Answer operator reports across tenants"],"trustZone":"operations","ref":"C-102","implementation":{"status":"not-implemented"}},
    {"id":"product-module","name":"Product module","category":"logical","purpose":"A product feature: tenant metadata and any platform code it registers.","responsibilities":["Declare record types, views, workflows and operations","Reach tenant data through the runtime"],"trustZone":"tenant","ref":"C-103","implementation":{"status":"not-implemented"}},
    {"id":"external-endpoint","name":"External endpoint","category":"external","purpose":"An external address that a connector calls, such as a customer's webhook receiver or an HTTP interface.","responsibilities":["Receive signed requests","Answer with an outcome"],"trustZone":"public","ref":"C-104","implementation":{"status":"not-implemented"}},
    {"id":"wake-queue","name":"Notice queue","category":"transport","purpose":"Carries tenant-scoped notices: due-work wake notices, session revocations and domain events. Each notice is delivered until its subscriber acknowledges it.","responsibilities":["Deliver each notice until its subscriber acknowledges it","Carry tenant identifiers and sequence numbers, not record content"],"trustZone":"control","ref":"C-28","implementation":{"status":"not-implemented"}}
    {"id":"search-index","name":"Search index","category":"storage","purpose":"Holds the search entries of each tenant, built from the tenant's own records and read through the search index contract.","responsibilities":["Store entries per tenant","Answer queries limited to an audience class"],"trustZone":"data","ref":"C-150","implementation":{"status":"not-implemented"}},
    {"id":"notification-service","name":"Notification service","category":"computational","purpose":"Turns subscriptions and workflow tasks into email and inbox notices, filtered by what each recipient may read.","responsibilities":["Match events to subscriptions","Write inbox items","Send email through the mail service"],"trustZone":"tenant","ref":"C-151","implementation":{"status":"not-implemented"}},
    {"id":"conversation-service","name":"Conversation service","category":"computational","purpose":"Runs the assistant for one person: keeps conversations and pending actions as tenant data, asks the model provider for replies, and runs each change through the operation catalogue with the person's delegated token.","responsibilities":["Stream replies to the gateway","Keep turns and pending actions as records","Run operations with the delegated token of the person","Explain refusals from the failed checks"],"trustZone":"tenant","ref":"C-200","implementation":{"status":"not-implemented"}},
    {"id":"model-provider","name":"Model provider","category":"external","purpose":"A hosted model that generates replies and tool requests for the conversation service, under the tenant's policy.","responsibilities":["Generate a reply from messages and operation descriptions","Stream the output","Report usage"],"trustZone":"egress","ref":"C-201","implementation":{"status":"not-implemented"}},
    {"id":"local-model-adapter","name":"Local model adapter","category":"infrastructure","purpose":"The model provider contract served from a container with no cloud account, for the local stack and for tests.","responsibilities":["Serve the model provider contract locally","Replay fixed replies for the conformance suite"],"trustZone":"operations","ref":"C-202","implementation":{"status":"not-implemented"}},
    {"id":"operator-console","name":"Operator console","category":"client","purpose":"The operator and support interface. Reachable only from the operations network, and asks for a tenant grant before it reads tenant content.","responsibilities":["Show platform state to operators","Request and use support grants"],"trustZone":"operations","ref":"C-250","implementation":{"status":"not-implemented"}},
    {"id":"outbound-gate","name":"Outbound gate","category":"computational","purpose":"The one path from the platform to external addresses. It judges each address under the outbound rule and connects only to the address it judged.","responsibilities":["Resolve and judge addresses","Refuse redirects to addresses the rule forbids","Limit response size and time"],"trustZone":"egress","ref":"C-251","implementation":{"status":"not-implemented"}},
    {"id":"upload-scanner","name":"Upload scanner and rendition sandbox","category":"computational","purpose":"Scans uploaded files, confirms their media types from content and produces renditions in a process that holds no credential and no network access.","responsibilities":["Scan uploads before release","Confirm media types from content","Produce renditions"],"trustZone":"data","ref":"C-252","implementation":{"status":"not-implemented"}},
    {"id":"wake-queue","name":"Wake queue","category":"transport","purpose":"Carries notices that a tenant has due work.","responsibilities":["Deliver wake notices at least once"],"trustZone":"control","ref":"C-28","implementation":{"status":"not-implemented"}}
  ],
  "relationships": [
    {"id":"browser-calls-gateway","kind":"calls","from":"web-application","to":"gateway","description":"Every request of the browser goes to the gateway."},
    {"id":"network-calls-gateway","kind":"calls","from":"delivery-network","to":"gateway","description":"The content delivery network fetches from the gateway as its origin."},
    {"id":"browser-calls-network","kind":"calls","from":"web-application","to":"delivery-network","description":"Readers reach public pages through the content delivery network."},
    {"id":"agent-calls-agent-gateway","kind":"calls","from":"agent","to":"agent-gateway","description":"An agent calls operations through the agent gateway."},
    {"id":"gateway-calls-identity","kind":"calls","from":"gateway","to":"identity-service","description":"The gateway asks who a session belongs to and starts sign-in flows."},
    {"id":"gateway-calls-runtime","kind":"calls","from":"gateway","to":"runtime","description":"The gateway forwards reads and intents."},
    {"id":"gateway-calls-control-plane","kind":"calls","from":"gateway","to":"control-plane","description":"The gateway resolves hosts to tenants from the directory."},
    {"id":"gateway-reads-copy-store","kind":"reads","from":"gateway","to":"copy-store","description":"The gateway answers from stored view copies."},
    {"id":"agent-gateway-calls-identity","kind":"calls","from":"agent-gateway","to":"identity-service","description":"The agent gateway verifies tokens and reads grants."},
    {"id":"agent-gateway-calls-runtime","kind":"calls","from":"agent-gateway","to":"runtime","description":"Operations over tenant data are kernel decisions in the runtime."},
    {"id":"agent-gateway-calls-control-plane","kind":"calls","from":"agent-gateway","to":"control-plane","description":"Operations over tenants are carried out by the control plane."},
    {"id":"agent-gateway-calls-simulator","kind":"calls","from":"agent-gateway","to":"simulator","description":"Dry runs and projections are run by the simulator."},
    {"id":"agent-gateway-writes-audit","kind":"writes","from":"agent-gateway","to":"audit-log","description":"Every operation of an agent is recorded."},
    {"id":"identity-uses-store","kind":"depends-on","from":"identity-service","to":"store-contract","description":"The realm is tenant data, reached through the store contract."},
    {"id":"identity-uses-kernel","kind":"depends-on","from":"identity-service","to":"kernel","description":"Realm policies are decided by the kernel."},
    {"id":"identity-calls-provider","kind":"calls","from":"identity-service","to":"external-identity-provider","description":"Token exchange and metadata refresh."},
    {"id":"provider-calls-identity","kind":"calls","from":"external-identity-provider","to":"identity-service","description":"SAML responses and SCIM provisioning arrive from the provider."},
    {"id":"identity-calls-mail","kind":"calls","from":"identity-service","to":"mail-service","description":"Emailed links and notices."},
    {"id":"identity-calls-keys","kind":"calls","from":"identity-service","to":"key-service","description":"Signing keys and tenant data keys are wrapped by the key service."},
    {"id":"identity-writes-audit","kind":"writes","from":"identity-service","to":"audit-log","description":"Every authentication decision is recorded."},
    {"id":"runtime-uses-kernel","kind":"depends-on","from":"runtime","to":"kernel","description":"The runtime decides nothing itself."},
    {"id":"runtime-uses-substrate","kind":"depends-on","from":"runtime","to":"substrate","description":"View projection and bundle installation."},
    {"id":"runtime-uses-store","kind":"depends-on","from":"runtime","to":"store-contract","description":"Tenant state is reached only through the store contract."},
    {"id":"runtime-calls-control-plane","kind":"calls","from":"runtime","to":"control-plane","description":"The runtime reads placements from the directory."},
    {"id":"runtime-writes-copy-store","kind":"writes","from":"runtime","to":"copy-store","description":"The runtime stores view copies it computed."},
    {"id":"runtime-calls-network","kind":"calls","from":"runtime","to":"delivery-network","description":"The outbox consumer purges surrogate keys."},
    {"id":"runtime-publishes-wake","kind":"publishes","from":"runtime","to":"wake-queue","description":"A commit that creates due work, or a domain event, announces it."},
    {"id":"runtime-writes-audit","kind":"writes","from":"runtime","to":"audit-log","description":"Security-relevant changes are recorded."},
    {"id":"runtime-calls-keys","kind":"calls","from":"runtime","to":"key-service","description":"Tenant data keys are unwrapped by the key service."},
    {"id":"runtime-writes-files","kind":"writes","from":"runtime","to":"file-store","description":"Uploaded files are stored per tenant."},
    {"id":"postgres-implements-store","kind":"depends-on","from":"postgres-adapter","to":"store-contract","description":"An adapter of the store contract."},
    {"id":"sqlite-implements-store","kind":"depends-on","from":"sqlite-adapter","to":"store-contract","description":"An adapter of the store contract."},
    {"id":"store-uses-kernel","kind":"depends-on","from":"store-contract","to":"kernel","description":"The contract is written in kernel types."},
    {"id":"substrate-uses-kernel","kind":"depends-on","from":"substrate","to":"kernel","description":"Interpreters over kernel data."},
    {"id":"postgres-writes-tenant-database","kind":"writes","from":"postgres-adapter","to":"tenant-database","description":"The adapter is the only writer of a tenant database."},
    {"id":"store-reaches-postgres","kind":"data-flow","from":"store-contract","to":"postgres-adapter","description":"Calls through the contract are carried out by the adapter chosen for the deployment."},
    {"id":"control-plane-writes-control-database","kind":"writes","from":"control-plane","to":"control-database","description":"The directory and the wake index."},
    {"id":"control-plane-uses-store","kind":"depends-on","from":"control-plane","to":"store-contract","description":"Provisioning creates a tenant through the store contract."},
    {"id":"control-plane-calls-keys","kind":"calls","from":"control-plane","to":"key-service","description":"A tenant's key is created and destroyed with the tenant."},
    {"id":"control-plane-calls-network","kind":"calls","from":"control-plane","to":"delivery-network","description":"Domains and certificates are registered at the edge."},
    {"id":"control-plane-writes-audit","kind":"writes","from":"control-plane","to":"audit-log","description":"Lifecycle operations are recorded."},
    {"id":"scheduler-calls-control-plane","kind":"calls","from":"scheduler","to":"control-plane","description":"The scheduler reads the wake index."},
    {"id":"scheduler-subscribes-wake","kind":"subscribes","from":"scheduler","to":"wake-queue","description":"A wake notice prompts the scheduler before its next poll."},
    {"id":"scheduler-uses-store","kind":"depends-on","from":"scheduler","to":"store-contract","description":"Jobs are tenant data."},
    {"id":"scheduler-uses-kernel","kind":"depends-on","from":"scheduler","to":"kernel","description":"Lease and retry decisions are kernel decisions."},
    {"id":"scheduler-calls-workflow-engine","kind":"calls","from":"scheduler","to":"workflow-engine","description":"A due workflow step is handed to the engine."},
    {"id":"workflow-engine-uses-kernel","kind":"depends-on","from":"workflow-engine","to":"kernel","description":"Each step is a kernel decision."},
    {"id":"workflow-engine-uses-store","kind":"depends-on","from":"workflow-engine","to":"store-contract","description":"Runs are tenant data."},
    {"id":"workflow-engine-calls-connectors","kind":"calls","from":"workflow-engine","to":"connector-runner","description":"Effects of a committed step are handed to the connector runner."},
    {"id":"connectors-call-mail","kind":"calls","from":"connector-runner","to":"mail-service","description":"Mail steps."},
    {"id":"connectors-call-keys","kind":"calls","from":"connector-runner","to":"key-service","description":"Connector secrets are unwrapped at the time of the call."},
    {"id":"simulator-uses-kernel","kind":"depends-on","from":"simulator","to":"kernel","description":"The simulator runs the production kernel."},
    {"id":"simulator-uses-verification","kind":"depends-on","from":"simulator","to":"verification","description":"Invariants are evaluated on simulated states."},
    {"id":"verification-uses-kernel","kind":"depends-on","from":"verification","to":"kernel","description":"Invariants are evaluated with the kernel's own validation."},
    {"id":"telemetry-observes-gateway","kind":"observes","from":"telemetry-pipeline","to":"gateway","description":"Telemetry of the gateway."},
    {"id":"telemetry-observes-runtime","kind":"observes","from":"telemetry-pipeline","to":"runtime","description":"Telemetry of the runtime."},
    {"id":"telemetry-observes-identity","kind":"observes","from":"telemetry-pipeline","to":"identity-service","description":"Telemetry of the identity service."},
    {"id":"telemetry-observes-control-plane","kind":"observes","from":"telemetry-pipeline","to":"control-plane","description":"Telemetry of the control plane."},
    {"id":"telemetry-observes-scheduler","kind":"observes","from":"telemetry-pipeline","to":"scheduler","description":"Telemetry of the scheduler."},
    {"id":"arc-gateway-writes-limits","kind":"writes","from":"gateway","to":"limit-store","description":"Request rates are counted in the shared limit store."},
    {"id":"arc-agent-gateway-writes-limits","kind":"writes","from":"agent-gateway","to":"limit-store","description":"Operation budgets are counted in the shared limit store."},
    {"id":"arc-tenant-database-backed-up","kind":"data-flow","from":"tenant-database","to":"backup-archive","description":"Point-in-time copies of each tenant database."},
    {"id":"arc-control-plane-schedules-backup","kind":"calls","from":"control-plane","to":"backup-archive","description":"The control plane schedules backups and asks for restores."},
    {"id":"arc-identity-publishes-revocation","kind":"publishes","from":"identity-service","to":"wake-queue","description":"A session revocation is announced to gateways."},
    {"id":"arc-gateway-subscribes-notices","kind":"subscribes","from":"gateway","to":"wake-queue","description":"Each gateway instance receives revocations until it acknowledges them."},
    {"id":"arc-agent-gateway-subscribes-notices","kind":"subscribes","from":"agent-gateway","to":"wake-queue","description":"Domain events that the policies of the subscribing principal permit it to read."},
    {"id":"arc-telemetry-feeds-fleet","kind":"data-flow","from":"telemetry-pipeline","to":"fleet-reporting","description":"Telemetry exported for reports that span tenants."},
    {"id":"arc-runtime-publishes-summaries","kind":"publishes","from":"runtime","to":"fleet-reporting","description":"Summaries that a tenant publishes about itself, with no record content."},
    {"id":"arc-product-module-calls-runtime","kind":"calls","from":"product-module","to":"runtime","description":"A module that needs platform code calls the runtime, and reaches no store of its own."},
    {"id":"arc-connector-calls-endpoint","kind":"calls","from":"connector-runner","to":"external-endpoint","description":"Effects of a committed step are sent to external addresses."},
    {"id":"gateway-reads-search-index","kind":"reads","from":"gateway","to":"search-index","description":"Search requests are answered from the tenant's search entries."},
    {"id":"runtime-writes-search-index","kind":"writes","from":"runtime","to":"search-index","description":"A commit that changes a record updates its search entries."},
    {"id":"runtime-calls-notification-service","kind":"calls","from":"runtime","to":"notification-service","description":"A committed event that has subscribers is handed to the notification service."},
    {"id":"notification-service-uses-store","kind":"depends-on","from":"notification-service","to":"store-contract","description":"Subscriptions and inbox items are tenant data."},
    {"id":"notification-service-uses-kernel","kind":"depends-on","from":"notification-service","to":"kernel","description":"Which recipients may read a record is a kernel decision."},
    {"id":"notification-service-calls-mail","kind":"calls","from":"notification-service","to":"mail-service","description":"Email notices."},
    {"id":"cnv-gateway-calls-conversation","kind":"calls","from":"gateway","to":"conversation-service","description":"Conversation requests and the reply stream go through the gateway, which carries the person's session."},
    {"id":"cnv-conversation-calls-agent-gateway","kind":"calls","from":"conversation-service","to":"agent-gateway","description":"Every operation of the assistant is run through the agent gateway with the delegated token of the person."},
    {"id":"cnv-conversation-calls-identity","kind":"calls","from":"conversation-service","to":"identity-service","description":"Obtains the delegated token of a person's session."},
    {"id":"cnv-conversation-uses-store","kind":"depends-on","from":"conversation-service","to":"store-contract","description":"Conversations, turns and pending actions are tenant data."},
    {"id":"cnv-conversation-writes-audit","kind":"writes","from":"conversation-service","to":"audit-log","description":"Changes the assistant makes are recorded with the person it acted for."},
    {"id":"cnv-conversation-sends-model","kind":"data-flow","from":"conversation-service","to":"model-provider","description":"Model requests carry tenant content as far as the tenant policy permits."},
    {"id":"cnv-local-adapter-serves-model","kind":"depends-on","from":"local-model-adapter","to":"model-provider","description":"The local adapter is one implementation of the model provider contract."},
    {"id":"cnv-telemetry-observes-conversation","kind":"observes","from":"telemetry-pipeline","to":"conversation-service","description":"Telemetry of the conversation service."},
    {"id":"operator-console-calls-control-plane","kind":"calls","from":"operator-console","to":"control-plane","description":"Operators carry out tenant lifecycle operations."},
    {"id":"operator-console-calls-identity","kind":"calls","from":"operator-console","to":"identity-service","description":"Operators sign in and request support grants."},
    {"id":"operator-console-calls-runtime","kind":"calls","from":"operator-console","to":"runtime","description":"Support reads of tenant content, made under a grant."},
    {"id":"connector-runner-calls-outbound-gate","kind":"calls","from":"connector-runner","to":"outbound-gate","description":"Every external call leaves through the outbound gate."},
    {"id":"runtime-calls-upload-scanner","kind":"calls","from":"runtime","to":"upload-scanner","description":"Uploaded files are scanned before they are released."},
    {"id":"upload-scanner-reads-file-store","kind":"reads","from":"upload-scanner","to":"file-store","description":"The scanner reads an uploaded object and records its verdict."},
    {"id":"telemetry-observes-agent-gateway","kind":"observes","from":"telemetry-pipeline","to":"agent-gateway","description":"Telemetry of the agent gateway."}
  ],

  // ---- White paper: goals, non-goals, boundaries, decisions, constraints, open questions ---------
  "goals": [
    {"id":"g-1","statement":"Each tenant has a database of its own, so a tenant can be backed up, restored, moved, exported and deleted as one unit.","stage":"R0","group":"Tenancy","ref":"G-1"},
    {"id":"g-2","statement":"A tenant is provisioned from a template with no manual step and is usable as soon as provisioning reports success.","stage":"R0","group":"Tenancy","ref":"G-2"},
    {"id":"g-3","statement":"A tenant can be placed in a chosen region and moved between database clusters without a change of address.","stage":"R0","group":"Tenancy","ref":"G-3"},
    {"id":"g-4","statement":"The load of one tenant cannot exhaust capacity that another tenant depends on.","stage":"R0","group":"Tenancy","ref":"G-4"},
    {"id":"g-5","statement":"Tenant structure stays versioned data interpreted by one deterministic kernel, as in the prototype.","stage":"R0","group":"Tenancy","ref":"G-5"},
    {"id":"g-6","statement":"A person can sign in with a password, a passkey, an emailed link, an OpenID Connect provider or a SAML provider, as the tenant configures.","stage":"R1","group":"Identity","ref":"G-6"},
    {"id":"g-7","statement":"An organisation can require its own identity provider for its people and have them provisioned and deprovisioned from it.","stage":"R1","group":"Identity","ref":"G-7"},
    {"id":"g-8","statement":"A tenant can require a second factor, and sensitive operations can require a recent authentication.","stage":"R1","group":"Identity","ref":"G-8"},
    {"id":"g-9","statement":"Sessions can be listed and revoked, and a revocation takes effect everywhere within a stated bound.","stage":"R1","group":"Identity","ref":"G-9"},
    {"id":"g-10","statement":"Services and agents have identities of their own, with scoped credentials that expire.","stage":"R1","group":"Identity","ref":"G-10"},
    {"id":"g-11","statement":"Every authentication decision is recorded with enough evidence to explain it afterwards.","stage":"R1","group":"Identity","ref":"G-11"},
    {"id":"g-12","statement":"One identity service is the only component that handles credentials, and every other component learns who is calling from what it signs.","stage":"R1","group":"Identity","ref":"G-12"},
    {"id":"g-13","statement":"A tenant can schedule work at a time, on a recurring rule or in response to an event.","stage":"R2","group":"Automation","ref":"G-13"},
    {"id":"g-14","statement":"Scheduled work survives the failure of a process or a host and ends in a recorded outcome.","stage":"R2","group":"Automation","ref":"G-14"},
    {"id":"g-15","statement":"An external effect is applied once even when the job that causes it is attempted more than once.","stage":"R2","group":"Automation","ref":"G-15"},
    {"id":"g-16","statement":"Workflows are tenant metadata and are projected against history before activation, like any schema change.","stage":"R2","group":"Automation","ref":"G-16"},
    {"id":"g-17","statement":"Content can be published and withdrawn at a scheduled time.","stage":"R2","group":"Automation","ref":"G-17"},
    {"id":"g-18","statement":"Published content is served from stored copies near readers without a query to the tenant database on each request.","stage":"R2","group":"Delivery","ref":"G-18"},
    {"id":"g-19","statement":"A committed change is visible to readers within a stated bound.","stage":"R2","group":"Delivery","ref":"G-19"},
    {"id":"g-20","statement":"No reader receives another tenant's content, or content their role may not read, from any stored copy or any interface.","stage":"R2","group":"Delivery","ref":"G-20"},
    {"id":"g-21","statement":"A tenant can serve its site from its own domain names, with certificates the platform manages.","stage":"R2","group":"Delivery","ref":"G-21"},
    {"id":"g-22","statement":"Deleting data removes it from every stored copy within a stated bound.","stage":"R2","group":"Delivery","ref":"G-22"},
    {"id":"g-23","statement":"Everything an operator can observe or change, an agent can observe or change through a documented, typed interface.","stage":"R3","group":"Agents","ref":"G-23"},
    {"id":"g-24","statement":"An agent can find out what it may do, what an operation needs and what it would change, before doing it.","stage":"R3","group":"Agents","ref":"G-24"},
    {"id":"g-25","statement":"Every change made by an agent is attributable to the agent and to the person it acted for, and is reversible where the operation allows.","stage":"R3","group":"Agents","ref":"G-25"},
    {"id":"g-26","statement":"A risky change passes through a proposal that is projected and then approved under the tenant's policy.","stage":"R3","group":"Agents","ref":"G-26"},
    {"id":"g-27","statement":"The platform describes its own state (health, configuration, topology, recent failures) in machine-readable form.","stage":"R3","group":"Agents","ref":"G-27"},
    {"id":"g-28","statement":"The reach of an agent can be limited in scope and in volume, and cut off at once.","stage":"R3","group":"Agents","ref":"G-28"},
    {"id":"g-29","statement":"One request can be followed through every component by one identifier.","stage":"R3","group":"Observability","ref":"G-29"},
    {"id":"g-30","statement":"Security-relevant actions are kept in an append-only record that reveals tampering.","stage":"R3","group":"Observability","ref":"G-30"},
    {"id":"g-31","statement":"Content types, relationships, workflows, queries and views are defined by tenants as data.","stage":"R4","group":"Content","ref":"G-31"},
    {"id":"g-32","statement":"Every published version of a record can be retrieved, compared and restored.","stage":"R4","group":"Content","ref":"G-32"},
    {"id":"g-33","statement":"Media files are stored, turned into renditions and delivered with the same isolation as records.","stage":"R4","group":"Content","ref":"G-33"},
    {"id":"g-34","statement":"Content can exist in several languages, with a fallback.","stage":"R4","group":"Content","ref":"G-34"},
    {"id":"g-35","statement":"An author can preview unpublished content exactly as it would be delivered.","stage":"R4","group":"Content","ref":"G-35"},
    {"id":"g-36","statement":"The whole platform runs on one machine in containers, with no cloud account.","stage":"R0","group":"Platform","ref":"G-36"},
    {"id":"g-37","statement":"The same component images deploy to a cloud provider through adapters, Amazon Web Services first.","stage":"R4","group":"Platform","ref":"G-37"},
    {"id":"g-38","statement":"Every dependency on infrastructure sits behind a contract with a conformance suite and at least two adapters.","stage":"R0","group":"Platform","ref":"G-38"},
    {"id":"g-39","statement":"The platform recovers from the loss of a zone within stated objectives, and any tenant can be restored to a point in time.","stage":"R4","group":"Platform","ref":"G-39"},
    {"id":"g-40","statement":"Tenant data and secrets are encrypted under a key held for that tenant, and destroying the key makes them unreadable.","stage":"R1","group":"Platform","ref":"G-40"},
    {"id":"g-41","statement":"Every requirement is tied to a proof whose recorded result Concordance checks.","stage":"R0","group":"Assurance","ref":"G-41"},
    {"id":"g-42","statement":"Behaviour that matters under failure is modelled and checked in Exegra before it is built.","stage":"R0","group":"Assurance","ref":"G-42"},
    {"id":"g-43","statement":"The core properties of the kernel stay machine-checked as it grows.","stage":"R0","group":"Assurance","ref":"G-43"},
    {"id":"g-44","statement":"A proposed change to tenant metadata can be projected against recorded history before it is made.","stage":"R0","group":"Assurance","ref":"G-44"},
    {"id":"g-45","statement":"The sign-in pages and the authoring application meet WCAG 2.2 level AA.","stage":"R4","group":"Assurance","ref":"G-45"},
    {"id":"g-46","statement":"Sign-in resists enumeration of accounts, guessing of credentials, replay of one-time material and takeover through federation.","stage":"R1","group":"Identity","ref":"G-46"},
    {"id":"g-100","statement":"Operators can answer questions that span tenants without reading the data of any tenant.","stage":"R3","group":"Observability","ref":"G-100"},
    {"id":"g-101","statement":"Reads of a tenant's directory entry and published content keep working through the loss of the control plane.","stage":"R2","group":"Delivery","ref":"G-101"},
    {"id":"g-102","statement":"Adding a tenant adds no load to a shared component that grows with the number of tenants.","stage":"R2","group":"Tenancy","ref":"G-102"},
    {"id":"g-103","statement":"A product feature is added as tenant metadata and modules, with no change to the kernel.","stage":"R0","group":"Platform","ref":"G-103"},
    {"id":"g-104","statement":"Stored formats and layouts change while the versions that read them run together.","stage":"R4","group":"Platform","ref":"G-104"},
    {"id":"g-150","statement":"An author can create and edit records of tenant-defined content types in the authoring application, and an edit reaches readers only when it is published.","stage":"R2","group":"Content","ref":"G-150"},
    {"id":"g-151","statement":"A tenant can require that the people it names review a record before it is published.","stage":"R2","group":"Content","ref":"G-151"},
    {"id":"g-152","statement":"A tenant's application can read published content through a documented delivery interface with field selection, paging and filtering.","stage":"R2","group":"Delivery","ref":"G-152"},
    {"id":"g-153","statement":"A tenant can define roles and teams, and each person can do only what the roles that reach them allow.","stage":"R1","group":"Identity","ref":"G-153"},
    {"id":"g-154","statement":"A new organisation can start a sandbox tenant from a template without contacting the platform operator, and keep it or let it expire.","stage":"R1","group":"Tenancy","ref":"G-154"},
    {"id":"g-155","statement":"People receive the tasks and notices that concern them in an inbox or by email, and no notice shows a record its recipient cannot read.","stage":"R2","group":"Automation","ref":"G-155"},
    {"id":"g-156","statement":"Other systems can start a tenant's workflows through signed webhooks, and a tenant can see the outcome of each webhook it sends.","stage":"R2","group":"Automation","ref":"G-156"},
    {"id":"g-157","statement":"Each tenant has a plan whose quotas are enforced, its metered use is counted, and the counts can be sent to its billing system.","stage":"R2","group":"Business","ref":"G-157"},
    {"id":"g-158","statement":"A reviewer without an account can see a draft exactly as it would be delivered, through a link that expires.","stage":"R2","group":"Content","ref":"G-158"},
    {"id":"g-159","statement":"The addresses of published pages keep working when a page moves, and search engines can find every published page of a site.","stage":"R2","group":"Delivery","ref":"G-159"},
    {"id":"g-160","statement":"A tenant owner can export all of the tenant's data, and can delete the tenant after a grace period during which the deletion can be cancelled.","stage":"R2","group":"Tenancy","ref":"G-160"},
    {"id":"g-161","statement":"Visitors can search a tenant's published content, and editors can search the drafts they are permitted to read.","stage":"R4","group":"Content","ref":"G-161"},
    {"id":"g-162","statement":"A tenant can collect submissions from a form on its site, and each submission is stored, notified and exportable.","stage":"R4","group":"Content","ref":"G-162"},
    {"id":"g-163","statement":"Records can be exported and imported as documents in the tenant's own format, and a copy imported elsewhere keeps the identifiers and versions of its records.","stage":"R4","group":"Content","ref":"G-163"},
    {"id":"g-164","statement":"A tenant's configuration can be promoted from a staging tenant to its production tenant through a proposal that production approves, with content kept apart.","stage":"R3","group":"Platform","ref":"G-164"},
    {"id":"g-165","statement":"Platform operators act in a tenant only under a support grant that the tenant owner issued, and every act they make is recorded.","stage":"R1","group":"Identity","ref":"G-165"},
    {"id":"g-166","statement":"Customers can see the limits that apply to them and the changes to the delivery interface, and an old delivery version stays served for a stated period.","stage":"R2","group":"Delivery","ref":"G-166"},
    {"id":"g-167","statement":"A tenant can install a template or an integration that the platform publishes, after seeing what it changes.","stage":"R3","group":"Platform","ref":"G-167"},
    {"id":"g-168","statement":"The platform publishes, for each plan, the objectives it measures and the results measured each month.","stage":"R4","group":"Business","ref":"G-168"},
    {"id":"g-200","statement":"A person can do in conversation everything they can do in the authoring application, and the assistant acts with that person's permissions and no more.","stage":"R3","group":"Conversation","ref":"G-200"},
    {"id":"g-201","statement":"Every change an assistant makes is previewed, and is applied only when the person confirms it.","stage":"R3","group":"Conversation","ref":"G-201"},
    {"id":"g-202","statement":"A person can ask why an action was refused, what it would do, what changed and who changed it, and the answer names its sources.","stage":"R3","group":"Conversation","ref":"G-202"},
    {"id":"g-203","statement":"The conversation and the direct interface are one interface: a person can move between them at any point and sees the effect of each in the other.","stage":"R3","group":"Conversation","ref":"G-203"},
    {"id":"g-204","statement":"The conversation works with a keyboard, a screen reader, reduced motion, a small screen and a poor network connection.","stage":"R3","group":"Conversation","ref":"G-204"},
    {"id":"g-205","statement":"A tenant can turn the assistant off, and tenant content reaches a model provider only under the tenant's policy.","stage":"R3","group":"Conversation","ref":"G-205"},
    {"id":"g-206","statement":"Editing in the authoring application keeps unsaved and conflicting work from being lost, and shows who else is editing.","stage":"R4","group":"Authoring","ref":"G-206"},
    {"id":"g-207","statement":"A new tenant is set up through the conversation, with a template, its content types and its people.","stage":"R4","group":"Authoring","ref":"G-207"},
    {"id":"g-250","statement":"A page of a tenant cannot run script, load a frame or submit a form that the tenant did not publish.","stage":"R2","group":"Security","ref":"G-250"},
    {"id":"g-251","statement":"Attempts to guess a password are limited by the account, by the source and by the platform as a whole.","stage":"R1","group":"Security","ref":"G-251"},
    {"id":"g-252","statement":"Sign-in, sign-up, recovery and provisioning reveal nothing about which accounts exist.","stage":"R1","group":"Security","ref":"G-252"},
    {"id":"g-253","statement":"A person whose account is attacked is told, and can end every session that the attacker holds.","stage":"R1","group":"Security","ref":"G-253"},
    {"id":"g-254","statement":"A session cookie reaches only the host that set it.","stage":"R1","group":"Security","ref":"G-254"},
    {"id":"g-255","statement":"Federation accepts a provider's message only after every field that binds it to this tenant, this client and this request has been checked.","stage":"R1","group":"Security","ref":"G-255"},
    {"id":"g-256","statement":"Each component accepts a connection only from the components the architecture names as its callers, and the operator console is reachable only from the operations network.","stage":"R0","group":"Security","ref":"G-256"},
    {"id":"g-257","statement":"A tenant cannot make the platform contact an address that the outbound rule forbids, by any name, encoding or redirect.","stage":"R2","group":"Security","ref":"G-257"},
    {"id":"g-258","statement":"An operator or a support person reads tenant content only under a grant that the tenant gave and that ends.","stage":"R1","group":"Security","ref":"G-258"},
    {"id":"g-259","statement":"Every component image that runs can be traced to the source and the build that produced it, and to the dependencies it contains.","stage":"R0","group":"Security","ref":"G-259"},
    {"id":"g-260","statement":"A tenant's upload is stored, scanned and delivered without being run and without exhausting the platform.","stage":"R2","group":"Security","ref":"G-260"},
    {"id":"g-261","statement":"A tenant's keys can be rotated while the tenant is in service, and a compromised key can be retired at once.","stage":"R1","group":"Security","ref":"G-261"},
    {"id":"g-262","statement":"Abuse by one tenant or one source does not degrade the platform for others, and a tenant domain used for abuse can be taken down.","stage":"R2","group":"Security","ref":"G-262"},
    {"id":"g-263","statement":"No principal widens its own authority through an operation, an approval, an export or a change to roles and policies.","stage":"R3","group":"Security","ref":"G-263"},
    {"id":"g-264","statement":"An export or a generated file contains no formula or markup that a reader's application would run.","stage":"R2","group":"Security","ref":"G-264"},
    {"id":"g-265","statement":"Security problems reported to the platform are received, fixed and disclosed to the tenants they affect.","stage":"R0","group":"Security","ref":"G-265"},
    {"id":"g-266","statement":"A tenant's database credentials reach only that tenant's database, and a compromised runtime instance reaches no other tenant.","stage":"R1","group":"Security","ref":"G-266"},
    {"id":"g-267","statement":"The edge serves a copy of a page only to the requests that the copy was made for.","stage":"R2","group":"Security","ref":"G-267"},
    {"id":"g-47","statement":"Tenant automation cannot reach the platform's own network or another tenant.","stage":"R2","group":"Automation","ref":"G-47"}
  ],
  "nonGoals": [
    {"id":"ng-1","statement":"No tenancy mode in which tenants share one database. Isolation by database is the product, not an option (D-1).","horizon":"Not planned.","ref":"NG-1"},
    {"id":"ng-2","statement":"No general identity provider for third-party applications. The identity service signs assertions for the platform's own components and tokens for a tenant's own service accounts and agents (D-4).","horizon":"Not at launch.","ref":"NG-2"},
    {"id":"ng-3","statement":"No execution of tenant-supplied code inside platform processes. Automation is workflows over declared steps and calls to external addresses (Q-7).","horizon":"Not planned.","ref":"NG-3"},
    {"id":"ng-4","statement":"No active-active operation across regions. One region is primary for a tenant, and recovery in another region is a restore (D-23).","horizon":"Not at launch.","ref":"NG-4"},
    {"id":"ng-5","statement":"No visual page builder. Pages are view definitions and templates held as metadata.","horizon":"Not at launch.","ref":"NG-5"},
    {"id":"ng-6","statement":"No query of tenant data spans tenants. Reports across tenants read telemetry, published summaries and the tenant directory (ARC-110), and operations over tenants are operations of the control plane.","horizon":"Not planned.","ref":"NG-6"},
    {"id":"ng-7","statement":"No GraphQL interface. Delivery is HTTP with JSON over named queries and view definitions (Q-8).","horizon":"Not at launch.","ref":"NG-7"},
    {"id":"ng-8","statement":"No built-in web analytics, email marketing or commerce.","horizon":"Not planned.","ref":"NG-8"},
    {"id":"ng-9","statement":"No installer for customer-operated sites. The local container stack is for development and proof, not a supported production form.","horizon":"Not at launch.","ref":"NG-9"},
    {"id":"ng-150","statement":"No marketplace where third parties publish code. Templates and integrations are platform-authored declarative bundles (INT-155, NG-3).","horizon":"Not at launch.","ref":"NG-150"},
    {"id":"ng-151","statement":"No reader comments on published content. Review notes live on the draft version under review.","horizon":"Not planned.","ref":"NG-151"},
    {"id":"ng-152","statement":"No payment processing, invoicing or tax calculation inside the platform. Usage leaves through the billing export (BIL-153).","horizon":"Not planned.","ref":"NG-152"},
    {"id":"ng-153","statement":"No client libraries in the first releases. The delivery interface is described in a machine-readable document from which clients can be generated (CMS-169).","horizon":"Not at launch.","ref":"NG-153"},
    {"id":"ng-154","statement":"No importers for named third-party content systems in the first releases. Records move as documents in the tenant's own export format (CMS-172).","horizon":"Not at launch.","ref":"NG-154"},
    {"id":"ng-155","statement":"No contractual service credits in the platform. The objectives are published as data (BIL-155).","horizon":"Not planned.","ref":"NG-155"},
    {"id":"ng-10","statement":"No search across tenants, and no search over the text of files. Search is per tenant over its published and draft content, as the audience of the reader permits (SRH-150, SRH-151).","horizon":"Not at launch.","ref":"NG-10"}
    {"id":"ng-200","statement":"No assistant with more authority than the person it serves. The assistant holds no credential of its own, and no conversation grants a permission that the person lacks (D-18, TOK-004).","horizon":"Never.","ref":"NG-200"},
    {"id":"ng-201","statement":"No change applied by the assistant without the person's confirmation, except steps of a workflow that the tenant declared, which run under that workflow's own approvals (WFL-006).","horizon":"Not planned.","ref":"NG-201"},
    {"id":"ng-202","statement":"No voice-only interface at launch. Speech may be added later through the same operations, previews and confirmations.","horizon":"Not at launch.","ref":"NG-202"},
    {"id":"ng-10","statement":"No full-text search service. Search stays a named query over the tenant database until a search seam is specified (Q-5).","horizon":"Not at launch.","ref":"NG-10"}
  ],
  "boundaries": [
    {"id":"b-1","name":"Kernel interface: decide an intent, answer a read, plan the state a decision needs","interfaceKind":"Rust library","usedBy":"runtime, identity service, scheduler, simulator, verification","ref":"B-1"},
    {"id":"b-2","name":"Store contract: tenant-scoped snapshots, atomic commits guarded by a revision, ordered events, journal","interfaceKind":"Rust trait with a conformance suite","usedBy":"runtime, identity service, scheduler, control plane","ref":"B-2"},
    {"id":"b-3","name":"Tenant directory: tenants, placements, domain bindings, lifecycle operations","interfaceKind":"HTTP with JSON","usedBy":"gateway, runtime, scheduler, operators, agents","ref":"B-3"},
    {"id":"b-4","name":"Identity interface: sign-in methods, sessions, factors, recovery, realm configuration","interfaceKind":"HTTP with JSON","usedBy":"gateway, authoring application, agents","ref":"B-4"},
    {"id":"b-5","name":"Federation endpoints: OpenID Connect redirect and callback, SAML metadata and assertion consumer, SCIM provisioning","interfaceKind":"HTTP (OpenID Connect, SAML 2.0, SCIM 2.0)","usedBy":"external identity providers, browsers","ref":"B-5"},
    {"id":"b-6","name":"Token endpoint: client credentials, token exchange, introspection, signing keys","interfaceKind":"HTTP (OAuth 2.1)","usedBy":"service accounts, agents, platform components","ref":"B-6"},
    {"id":"b-7","name":"Scheduling interface: jobs, schedules, triggers, leases","interfaceKind":"HTTP with JSON, kernel intents","usedBy":"runtime, workflow engine, workers, agents","ref":"B-7"},
    {"id":"b-8","name":"Workflow definitions: steps, waits, compensations, approvals","interfaceKind":"tenant metadata","usedBy":"tenant owners, agents","ref":"B-8"},
    {"id":"b-9","name":"Delivery interface: views and named queries over published content","interfaceKind":"HTTP with JSON","usedBy":"browsers, content delivery network, tenant applications","ref":"B-9"},
    {"id":"b-10","name":"Edge contract: storability directives, surrogate keys, purge, signed addresses, domain routing","interfaceKind":"HTTP headers and a purge call","usedBy":"content delivery network, gateway","ref":"B-10"},
    {"id":"b-11","name":"Operation catalogue and change proposals","interfaceKind":"HTTP with JSON, Model Context Protocol","usedBy":"agents, operators, authoring application","ref":"B-11"},
    {"id":"b-12","name":"Telemetry export and audit log","interfaceKind":"OpenTelemetry protocol, HTTP with JSON","usedBy":"operators, agents, tenant owners","ref":"B-12"},
    {"id":"b-13","name":"Authoring application and sign-in pages","interfaceKind":"UI (semantic HTML, layered CSS, vanilla JavaScript)","usedBy":"authors, editors, tenant owners","ref":"B-13"},
    {"id":"b-14","name":"File store contract: tenant-scoped objects addressed by content hash","interfaceKind":"Rust trait with a conformance suite","usedBy":"runtime, connector runner","ref":"B-14"},
    {"id":"b-15","name":"Copy store contract: keyed stored copies with tags and removal by tag","interfaceKind":"Rust trait with a conformance suite","usedBy":"runtime, gateway","ref":"B-15"},
    {"id":"b-16","name":"Notice contract: tenant-scoped notices of due work, revocations and domain events, delivered until acknowledged","interfaceKind":"Rust trait with a conformance suite","usedBy":"runtime, scheduler, identity service, gateway, agent gateway","ref":"B-16"},
    {"id":"b-17","name":"Key service contract: per-tenant data keys, wrapping, destruction","interfaceKind":"Rust trait with a conformance suite","usedBy":"identity service, runtime, control plane","ref":"B-17"},
    {"id":"b-18","name":"Mail contract: delivery of a templated message to one address","interfaceKind":"Rust trait with a conformance suite","usedBy":"identity service, connector runner","ref":"B-18"},
    {"id":"b-19","name":"Deployment descriptors: the local container stack and the cloud profile","interfaceKind":"compose file, infrastructure modules, command line","usedBy":"developers, operators, agents","ref":"B-19"},
    {"id":"b-20","name":"Projection interface: fork a tenant, apply a proposed change, replay, compare","interfaceKind":"HTTP with JSON","usedBy":"tenant owners, agents","ref":"B-20"},
    {"id":"b-100","name":"Limit contract: shared counters for request rates and agent operation budgets","interfaceKind":"Rust trait with a conformance suite","usedBy":"gateway, agent gateway","ref":"B-100"},
    {"id":"b-101","name":"Backup archive contract: point-in-time copies of one tenant database, encrypted under its key","interfaceKind":"Rust trait with a conformance suite","usedBy":"control plane, runtime","ref":"B-101"},
    {"id":"b-150","name":"Webhook endpoints: signed inbound deliveries that start runs, and the log of outbound deliveries","interfaceKind":"HTTP with JSON, signed bodies","usedBy":"external systems, tenant owners","ref":"B-150"},
    {"id":"b-151","name":"Search index contract: entries per tenant, updated from commits, queried by audience class","interfaceKind":"Rust trait with a conformance suite","usedBy":"runtime, gateway","ref":"B-151"},
    {"id":"b-152","name":"Form intake: submissions with submission tokens, stored and notified","interfaceKind":"HTTP with JSON","usedBy":"readers, tenant owners","ref":"B-152"},
    {"id":"b-153","name":"Archive documents: tenant archives, record exports and form exports","interfaceKind":"JSON documents with a manifest","usedBy":"tenant owners, agents","ref":"B-153"},
    {"id":"b-154","name":"Notification subscriptions and inbox: email and in-platform notices","interfaceKind":"HTTP with JSON, mail","usedBy":"people, tenant owners","ref":"B-154"},
    {"id":"b-155","name":"Usage export: signed usage documents to the billing system the tenant configures","interfaceKind":"HTTP with JSON, signed documents","usedBy":"billing systems, tenant owners","ref":"B-155"},
    {"id":"b-156","name":"Status page and changelog","interfaceKind":"HTML and HTTP with JSON","usedBy":"operators, tenant owners, the public","ref":"B-156"},
    {"id":"b-200","name":"Conversation interface: turns, reply streams, pending actions and their confirmation","interfaceKind":"HTTP with JSON and server-sent events","usedBy":"authoring application, tenant owners, editors","ref":"B-200"},
    {"id":"b-201","name":"Model provider contract: generate a reply from messages and operation descriptions, stream it, report usage","interfaceKind":"Rust trait with a conformance suite","usedBy":"conversation service","ref":"B-201"},
    {"id":"b-202","name":"Collaboration channel: presence, saved drafts and conflicts on one record","interfaceKind":"HTTP with JSON and server-sent events","usedBy":"authoring application, editors","ref":"B-202"},
    {"id":"b-250","name":"Operator console and support grants","interfaceKind":"HTTP with JSON","usedBy":"operators, support staff","ref":"B-250"},
    {"id":"b-251","name":"Tenant file upload: intake, scanning and file-domain delivery","interfaceKind":"HTTP multipart and HTTP","usedBy":"authors, tenant applications, the upload scanner","ref":"B-251"},
    {"id":"b-252","name":"Outbound gate: the one path from connectors to external addresses","interfaceKind":"HTTP and HTTPS client under the outbound rule","usedBy":"connector runner","ref":"B-252"},
    {"id":"b-21","name":"Tenant bundle: a tenant or a template written as one document","interfaceKind":"JSON document","usedBy":"control plane, developers, agents","ref":"B-21"}
  ],
  "decisions": [
    {"id":"d-1","title":"One PostgreSQL database per tenant","statement":"**One PostgreSQL database per tenant.** Each tenant has one PostgreSQL database, grouped in clusters. The SQLite adapter stays for single-process local use, tests and simulation. A tenant is the unit of backup, restore, move, export, key and deletion.","group":"Tenancy","decided":"2026-11-18","ref":"D-1"},
    {"id":"d-2","title":"A control plane with its own database","statement":"**A control plane with its own database.** A control plane owns the tenant directory (tenants, placements, domain bindings), provisioning, moves and the wake index. Its database holds identifiers, states and addresses, and no tenant content (K-2).","group":"Tenancy","decided":"2026-11-18","ref":"D-2"},
    {"id":"d-3","title":"An identity realm per tenant, stored in the tenant database","statement":"**An identity realm per tenant, stored in the tenant database.** A tenant's principals, credentials, provider configurations, sessions and audit entries live in that tenant's database, so isolation, residency, export and deletion of identity follow the tenant. Platform operators have a realm of their own in the control database. A person who works in two tenants has two principals, which a shared identity provider may link (Q-1).","group":"Identity","decided":"2026-11-18","ref":"D-3"},
    {"id":"d-4","title":"The identity service signs, everything else verifies","statement":"**The identity service signs, everything else verifies.** The identity service is the only holder of credentials. It gives the gateway a short-lived signed assertion for each request's session, and gives service accounts and agents signed access tokens. Other components verify signatures against published keys and never see a credential.","group":"Identity","decided":"2026-11-18","ref":"D-4"},
    {"id":"d-5","title":"Sessions are opaque and held by the platform","statement":"**Sessions are opaque and held by the platform.** A browser session is a random secret in an HttpOnly cookie (K-16). The session itself is a record that can be listed and revoked. Signed tokens are used only between components and for non-browser callers, with lifetimes short enough that revocation needs no list.","group":"Identity","decided":"2026-11-18","ref":"D-5"},
    {"id":"d-6","title":"The address selects the realm, the email domain selects the provider","statement":"**The address selects the realm, the email domain selects the provider.** The host name of a request selects the tenant and so the realm. Within a realm an email domain can be bound to an identity provider, and then that provider is the only way in for addresses in the domain.","group":"Identity","decided":"2026-11-18","ref":"D-6"},
    {"id":"d-7","title":"OpenID Connect by authorization code with a proof key","statement":"**OpenID Connect by authorization code with a proof key.** As a relying party the identity service uses the authorization code flow with a proof key, a state value and a nonce, and verifies issuer, audience, signature and nonce of the identity token.","group":"Identity","decided":"2026-11-18","ref":"D-7"},
    {"id":"d-8","title":"SAML started by the service provider","statement":"**SAML started by the service provider.** SAML sign-in starts at the platform. A response is accepted when it answers a pending request and its assertion is signed by a certificate the tenant configured. Sign-in started by the provider is off unless a tenant turns it on.","group":"Identity","decided":"2026-11-18","ref":"D-8"},
    {"id":"d-9","title":"Emailed links are single-use and bound to the requesting browser","statement":"**Emailed links are single-use and bound to the requesting browser.** A sign-in link carries a random token stored as a hash, is accepted once, expires after a short lifetime and is accepted only in the browser that asked for it. The answer to a request for a link is the same whether or not the address has an account.","group":"Identity","decided":"2026-11-18","ref":"D-9"},
    {"id":"d-10","title":"Job state lives with the tenant, a wake index lives with the control plane","statement":"**Job state lives with the tenant, a wake index lives with the control plane.** Jobs, schedules and workflow runs are records in the tenant database, written in the same transaction as the change that caused them. The control database holds only a wake index: tenant and next due time. Workers read the index to find tenants with due work, so idle tenants cost nothing.","group":"Automation","decided":"2026-11-18","ref":"D-10"},
    {"id":"d-11","title":"Leases with fencing tokens","statement":"**Leases with fencing tokens.** A worker takes a job under a lease with a token that rises on every grant. The tenant database refuses a result that carries a superseded token (K-17), so a stalled worker cannot overwrite the work of its replacement.","group":"Automation","decided":"2026-11-18","ref":"D-11"},
    {"id":"d-12","title":"At least once, made once by idempotency keys","statement":"**At least once, made once by idempotency keys.** Jobs are attempted at least once. Each external effect carries an idempotency key derived from the job and step, and the adapter that carries it out records the key with the outcome.","group":"Automation","decided":"2026-11-18","ref":"D-12"},
    {"id":"d-13","title":"Workflow steps are kernel decisions","statement":"**Workflow steps are kernel decisions.** A workflow is a state machine held as tenant metadata. Each step is decided by the kernel from the run's recorded state and returns effect descriptions (K-9), so a run is replayable and a workflow can be projected before it is activated.","group":"Automation","decided":"2026-11-18","ref":"D-13"},
    {"id":"d-14","title":"A copy is keyed by the versions it was computed from","statement":"**A copy is keyed by the versions it was computed from.** The key of a stored copy contains the tenant, what was asked, the audience class, the schema version and the revision of each object type the answer depends on. A change makes a new key instead of racing an old entry. A lifetime is kept only as a backstop.","group":"Delivery","decided":"2026-11-18","ref":"D-14"},
    {"id":"d-15","title":"Audience classes come from the kernel","statement":"**Audience classes come from the kernel.** The kernel derives from a tenant's policies which principals are indistinguishable for a read: the audience class. Copies are stored per class, never per person unless the policy itself reads the principal.","group":"Delivery","decided":"2026-11-18","ref":"D-15"},
    {"id":"d-16","title":"The content delivery network is keyed by host and purged by surrogate key","statement":"**The content delivery network is keyed by host and purged by surrogate key.** Every response for a tenant is keyed by its host name. Published pages carry surrogate keys naming the tenant and the records they were rendered from, and an outbox consumer purges those keys when a change commits.","group":"Delivery","decided":"2026-11-18","ref":"D-16"},
    {"id":"d-17","title":"Three tiers of copy","statement":"**Three tiers of copy.** Schema and compiled expressions are kept in process, keyed by schema version. View results are kept in a shared copy store. Public pages and media are kept at the content delivery network. Each tier is described in the copy class table.","group":"Delivery","decided":"2026-11-18","ref":"D-17"},
    {"id":"d-18","title":"One operation catalogue for people and agents","statement":"**One operation catalogue for people and agents.** Every capability is an operation with a name, an input schema and a description, generated from platform code and tenant metadata. The authoring application, the command line and the Model Context Protocol server are all clients of the same catalogue.","group":"Agents","decided":"2026-11-18","ref":"D-18"},
    {"id":"d-19","title":"Risky changes go through proposals","statement":"**Risky changes go through proposals.** A change that tenant policy classes as risky is made as a proposal: the change, its projection against recorded history, and an approval. A proposal is applied only at the revision it was projected against.","group":"Agents","decided":"2026-11-18","ref":"D-19"},
    {"id":"d-20","title":"An audit log chained by hash, per tenant","statement":"**An audit log chained by hash, per tenant.** Each tenant database holds an append-only audit log in which every entry contains the hash of the one before. The control database holds the same for platform operations. Operational telemetry is separate and carries no record content.","group":"Observability","decided":"2026-11-18","ref":"D-20"},
    {"id":"d-21","title":"OpenTelemetry everywhere","statement":"**OpenTelemetry everywhere.** Every component exports traces, metrics and logs through the OpenTelemetry protocol with the correlation identifier of the request and the tenant identifier.","group":"Observability","decided":"2026-11-18","ref":"D-21"},
    {"id":"d-22","title":"Containers locally","statement":"**Containers locally.** The local stack is a compose file: the platform components, PostgreSQL, an object store, a copy store, a mail catcher, a test identity provider and a telemetry collector. This replaces the prototype's rule against containers.","group":"Platform","decided":"2026-11-18","ref":"D-22"},
    {"id":"d-23","title":"Amazon Web Services first, one region per tenant","statement":"**Amazon Web Services first, one region per tenant.** The first cloud profile uses managed containers, managed PostgreSQL, object storage, a managed copy store, a content delivery network, a key service and a mail service, created from version-controlled infrastructure definitions. A tenant has one primary region.","group":"Platform","decided":"2026-11-18","ref":"D-23"},
    {"id":"d-24","title":"Seams are traits with conformance suites","statement":"**Seams are traits with conformance suites.** Each infrastructure dependency is a Rust trait written in the platform's terms, with a conformance suite, a local adapter and a cloud adapter, as the store contract already is.","group":"Platform","decided":"2026-11-18","ref":"D-24"},
    {"id":"d-25","title":"Envelope encryption per tenant","statement":"**Envelope encryption per tenant.** Each tenant has a data key wrapped by the key service. Destroying the wrapped key is how a deleted tenant's backups become unreadable.","group":"Platform","decided":"2026-11-18","ref":"D-25"},
    {"id":"d-26","title":"One specification, two tools","statement":"**One specification, two tools.** The specification is one Exegra JSONC file. Exegra validates it, evaluates structural and data claims, and runs the behaviour models. Concordance renders its requirements, lints them and reconciles them with code and recorded test results. A milestone is started in the gate when work on it begins.","group":"Assurance","decided":"2026-11-18","ref":"D-26"},
    {"id":"d-27","title":"The prototype's services become the gateway and the runtime","statement":"**The prototype's services become the gateway and the runtime.** The backend-for-frontend becomes the gateway. The backend becomes the runtime. Sign-in, sessions and password handling move out of the runtime into the identity service.","group":"Platform","decided":"2026-11-18","ref":"D-27"},
    {"id":"d-100","title":"Directory reads survive a control plane outage","statement":"**Directory reads survive a control plane outage.** Gateways and runtimes hold directory entries and answer reads for a tenant from them while the control plane cannot be reached. State changes wait for the control plane. The age of the entry served is stated, so a reader can tell how old the answer is (ARC-100).","group":"Tenancy","decided":"proposed in architecture review","ref":"D-100"},
    {"id":"d-101","title":"Cross-tenant reporting is fed, not queried","statement":"**Cross-tenant reporting is fed, not queried.** Operator reports over many tenants read telemetry, summaries that tenants publish, and the tenant directory. Nothing reaches into a tenant database from outside it (ARC-110).","group":"Observability","decided":"proposed in architecture review","ref":"D-101"},
    {"id":"d-102","title":"Outbox delivery is a job","statement":"**Outbox delivery is a job.** Events that a commit leaves unpublished are published by a job in the tenant database. A runtime that stops after its commit therefore does not strand them (ARC-105).","group":"Automation","decided":"proposed in architecture review","ref":"D-102"},
    {"id":"d-103","title":"Modules extend the platform as tenant metadata","statement":"**Modules extend the platform as tenant metadata.** A product feature is a module: record types, views, workflows and operations written as tenant metadata and installed through kernel intents. A module that needs platform code reaches tenant data through the runtime alone (ARC-112, ARC-113).","group":"Platform","decided":"proposed in architecture review","ref":"D-103"},
    {"id":"d-150","title":"Environments are tenants","statement":"**Environments are tenants.** A staging environment and a sandbox are tenants of their own, each with its own database, identity realm and key. A tenant records its kind, and a staging tenant names the production tenant it serves (ADM-157).","group":"Tenancy","decided":"2026-11-18","ref":"D-150"},
    {"id":"d-151","title":"Staging promotes configuration, not content","statement":"**Staging promotes configuration, not content.** A promotion carries tenant metadata through a proposal to production. Records of content stay with the tenant they were written in, and move by export and import (CMS-172).","group":"Platform","decided":"2026-11-18","ref":"D-151"},
    {"id":"d-152","title":"Delivery keys are service accounts with a delivery scope","statement":"**Delivery keys are service accounts with a delivery scope.** A headless application reads published content with a service account that names one site and one audience class, and the identity service revokes it like any other grant.","group":"Identity","decided":"2026-11-18","ref":"D-152"},
    {"id":"d-153","title":"Search and forms live in the tenant's own storage","statement":"**Search and forms live in the tenant's own storage.** The search index of a tenant is built from its own records, and a form submission is a record of its tenant. Neither is a shared service that holds several tenants.","group":"Tenancy","decided":"2026-11-18","ref":"D-153"},
    {"id":"d-154","title":"Billing exports usage and charges nothing","statement":"**Billing exports usage and charges nothing.** The platform counts metered quantities per tenant and sends signed usage documents to the billing system the tenant names. Prices, invoices and payment stay outside the platform (NG-152).","group":"Platform","decided":"2026-11-18","ref":"D-154"},
    {"id":"d-200","title":"The assistant is a client of the operation catalogue","statement":"**The assistant is a client of the operation catalogue.** The conversation service runs every change through the operations that a direct edit calls, with a delegated token that names the person (TOK-003). It holds no operation of its own, and its token grants no permission that the person lacks (TOK-004).","group":"Agents","decided":"draft, 2026-11-18","ref":"D-200"},
    {"id":"d-201","title":"Every change is previewed and confirmed","statement":"**Every change is previewed and confirmed.** The assistant shows each change as a preview and applies it only when the person confirms that preview. A risky change becomes a proposal (D-19). Undo is the inverse operation, previewed and confirmed in the same way.","group":"Agents","decided":"draft, 2026-11-18","ref":"D-201"},
    {"id":"d-202","title":"The model provider is a seam","statement":"**The model provider is a seam.** Model calls go through a contract with a conformance suite (D-24) and a local adapter that runs without cloud credentials (K-10). Which provider a tenant uses, and what tenant content it may receive, is set by the tenant's policy.","group":"Agents","decided":"draft, 2026-11-18","ref":"D-202"},
    {"id":"d-203","title":"The conversation is tenant data","statement":"**The conversation is tenant data.** Turns, pending actions and their evidence are records in the tenant database (K-2), read and written through the store contract. The browser holds no transcript.","group":"Agents","decided":"draft, 2026-11-18","ref":"D-203"},
    {"id":"d-204","title":"Interfaces are rendered from definitions","statement":"**Interfaces are rendered from definitions.** A reply shows an interface by naming a view definition and structured blocks. The model writes no markup, script or style (K-12).","group":"Content","decided":"draft, 2026-11-18","ref":"D-204"},
    {"id":"d-205","title":"The browser reaches the assistant through the gateway","statement":"**The browser reaches the assistant through the gateway.** Conversation requests and their streams pass through the gateway, which carries the person's session (K-6). The conversation service has no address that a browser can reach.","group":"Platform","decided":"draft, 2026-11-18","ref":"D-205"},
    {"id":"d-250","title":"Session cookies are host-only","statement":"**Session cookies are host-only.** The session cookie is set without a domain attribute, carries the host name prefix and the attribute that limits it to encrypted connections, and is read only by the host that set it. A tenant host cannot give a cookie to a parent domain or to a sibling host.","group":"Identity","decided":"draft, security review","ref":"D-250"},
    {"id":"d-251","title":"Tenant files come from the file domain","statement":"**Tenant files come from the file domain.** Uploaded files are delivered from the file domain of the platform under a sandboxed policy, and not from a tenant host name.","group":"Content","decided":"draft, security review","ref":"D-251"},
    {"id":"d-252","title":"Throttles at three levels","statement":"**Throttles at three levels.** Password attempts are throttled per account, per source and per realm, and across the platform, each level with its own counter.","group":"Identity","decided":"draft, security review","ref":"D-252"},
    {"id":"d-253","title":"Break-glass access is time-limited and consented","statement":"**Break-glass access is time-limited and consented.** An operator reads tenant content in an emergency only under a grant that names the tenant, the purpose and the person, and that ends at its own expiry.","group":"Platform","decided":"draft, security review","ref":"D-253"},
    {"id":"d-254","title":"Outbound addresses are judged where they are used","statement":"**Outbound addresses are judged where they are used.** A connector resolves the address it calls, judges the resolved address under the outbound rule, and connects to that address and to no other.","group":"Platform","decided":"draft, security review","ref":"D-254"},
    {"id":"d-28","title":"Rust for components, vanilla JavaScript in the browser","statement":"**Rust for components, vanilla JavaScript in the browser.** Platform components are written in Rust. Browser code stays framework-free JavaScript run by a kernel in a worker.","group":"Platform","decided":"2026-11-18","ref":"D-28"}
  ],
  "constraints": [
    {"id":"k-1","statement":"The kernel performs no input or output and reads no clock and no source of randomness.","group":"Kernel","ref":"K-1"},
    {"id":"k-2","statement":"Tenant content is stored only in that tenant's database and file namespace. The control database holds no tenant content.","group":"Tenancy","ref":"K-2"},
    {"id":"k-3","statement":"A component reaches a tenant database only through the store contract (B-2).","group":"Tenancy","ref":"K-3"},
    {"id":"k-4","statement":"Passwords, session secrets, tokens and one-time codes are handled only by the identity service and appear in no log.","group":"Identity","ref":"K-4"},
    {"id":"k-5","statement":"A network-facing component keeps no state between requests that another instance could not serve from.","group":"Platform","ref":"K-5"},
    {"id":"k-6","statement":"A browser reaches only the gateway, and calls between components carry a credential issued to the calling component.","group":"Platform","ref":"K-6"},
    {"id":"k-7","statement":"No shared copy holds personal data or anything that depends on who is asking.","group":"Delivery","ref":"K-7"},
    {"id":"k-8","statement":"Every stored copy has a stated owner, key, freshness bound and erasure point.","group":"Delivery","ref":"K-8"},
    {"id":"k-9","statement":"Every external effect is described as data by the kernel and carried out by an adapter after the transaction that produced it commits.","group":"Kernel","ref":"K-9"},
    {"id":"k-10","statement":"Every infrastructure dependency has an adapter that runs in a container without a cloud account.","group":"Platform","ref":"K-10"},
    {"id":"k-11","statement":"Time and randomness enter decisions as explicit inputs, so every decision can be simulated and replayed.","group":"Kernel","ref":"K-11"},
    {"id":"k-12","statement":"Tenant-authored content cannot inject script, markup or style into a page.","group":"Content","ref":"K-12"},
    {"id":"k-13","statement":"An agent is authorised by the same policies as a person, through the same kernel decision.","group":"Agents","ref":"K-13"},
    {"id":"k-14","statement":"Where a standard protocol exists the platform uses it: OAuth 2.1 and OpenID Connect, SAML 2.0, SCIM 2.0, WebAuthn, the OpenTelemetry protocol, the Model Context Protocol.","group":"Platform","ref":"K-14"},
    {"id":"k-15","statement":"No requirement counts as met without a recorded passing proof.","group":"Assurance","ref":"K-15"},
    {"id":"k-16","statement":"A session secret is an opaque random value, held by the browser in an HttpOnly cookie and by the platform only as a hash.","group":"Identity","ref":"K-16"},
    {"id":"k-100","statement":"A decision loads only the records that its plan names.","group":"Kernel","ref":"K-100"},
    {"id":"k-200","statement":"Tenant content leaves the platform only in a model request that the tenant policy permits, to a model provider that the tenant names.","group":"Platform","ref":"K-200"},
    {"id":"k-250","statement":"Credentials, session secrets, tokens and one-time codes appear in no address, referrer or query string.","group":"Identity","ref":"K-250"},
    {"id":"k-251","statement":"Tenant files and tenant templates are data, and no platform process runs them.","group":"Content","ref":"K-251"},
    {"id":"k-252","statement":"Every outbound connection of the platform leaves through one gate that applies the outbound rule.","group":"Platform","ref":"K-252"},
    {"id":"k-17","statement":"A lease on work carries a fencing token that the tenant database checks when the work is recorded.","group":"Automation","ref":"K-17"}
  ],
  "openQuestions": [
    {"id":"q-1","statement":"Do people who work in several tenants need one account across them? Working answer: no. Each tenant has its own principals (D-3), and a shared identity provider links them. A platform-wide account would put personal data in the control database, against K-2.","ref":"Q-1"},
    {"id":"q-2","statement":"Which region is first, and which regions follow? The answer fixes the first placement of D-23.","ref":"Q-2"},
    {"id":"q-3","statement":"Managed containers or a managed Kubernetes for the cloud profile? Working answer: managed containers, because nothing in the specification needs more.","ref":"Q-3"},
    {"id":"q-4","statement":"Is there a tier with a dedicated database instance per tenant, in addition to a database per tenant on shared clusters? The placement record already allows it (D-2).","ref":"Q-4"},
    {"id":"q-5","statement":"Which engine sits behind the search index contract in the cloud profile? Working answer: a managed search service per region, fed from each tenant's own records (SRH, B-151).","ref":"Q-5"},
    {"id":"q-6","statement":"Do tenants bring their own keys? D-25 leaves room: the wrapping key would be the tenant's.","ref":"Q-6"},
    {"id":"q-7","statement":"How far does automation go beyond declared steps and calls to external addresses? Running tenant code in a sandbox is excluded for now (NG-3).","ref":"Q-7"},
    {"id":"q-8","statement":"Is a GraphQL interface wanted over the delivery interface (NG-7)?","ref":"Q-8"},
    {"id":"q-9","statement":"What are the tenant plans and their quotas? G-4 needs numbers for connections, request rates, storage and jobs.","ref":"Q-9"},
    {"id":"q-100","statement":"How is the first owner of a new tenant admitted before the identity service exists? G-2 asks for a usable tenant at the second milestone, but sign-in is built at the third. Options: move a bootstrap credential, held by the identity service, into the second milestone, or admit the first owner through the operator's service credential until the third.","ref":"Q-100"},
    {"id":"q-101","statement":"Are platform feature flags read from the environment, or held as tenant metadata? Working answer: environment for platform flags and tenant metadata for features a tenant chooses.","ref":"Q-101"},
    {"id":"q-102","statement":"Does each database cluster run a connection pooler in front of its tenant databases, or does each tenant hold direct connections within its quota? The answer decides how ARC-114 is met.","ref":"Q-102"},
    {"id":"q-150","statement":"Does the first paying customer need reader-facing site search before the first sellable slice? Working answer: no. Search is milestone 8 (SRH), and the sellable slice ends with delivery and billing usage at milestone 6.","ref":"Q-150"},
    {"id":"q-151","statement":"Which billing system receives the first signed usage documents? The export is generic (BIL-153), so the answer decides only the first adapter.","ref":"Q-151"},
    {"id":"q-200","statement":"Which model providers are offered at launch, and may a tenant bring its own model key? Working answer: one provider behind the seam, chosen by the platform, with a tenant key left for later (Q-6 applies).","ref":"Q-200"},
    {"id":"q-201","statement":"Which language does the assistant answer in when the person's language and the tenant's default differ? Working answer: the language of the message it answers (CNV-246).","ref":"Q-201"},
    {"id":"q-202","statement":"How long is a preview valid before the person must confirm it again? The answer would be a freshness bound on the pending action record.","ref":"Q-202"},
    {"id":"q-10","statement":"May a tenant turn passwords off entirely and allow only passkeys and federation?","ref":"Q-10"}
  ],

  // ---- Roadmap -----------------------------------------------------------------------------------
  "releaseStages": [
    {"id":"r0","name":"Foundation","purpose":"The specification gates the code, and a tenant is a database behind clean seams, running locally in containers","milestones":"1, 2","exitEvidence":"Every goal tagged R0 verified. Both tools pass on every commit of the main line.","ref":"R0"},
    {"id":"r1","name":"Identity","purpose":"The identity service carries every sign-in method, sessions, tokens and audit","milestones":"3, 4","exitEvidence":"Every goal tagged R1 verified, with the behaviour models of sign-in checked in Exegra and a security review of the federation endpoints.","ref":"R1"},
    {"id":"r2","name":"Automation and delivery","purpose":"Tenants schedule work, are notified and approve content, and a first site is authored, reviewed and served from stored copies and the edge","milestones":"5, 6","exitEvidence":"Every goal tagged R2 verified, with the freshness and start budgets measured on the local stack, and a first site taken through authoring, review, preview and delivery there.","ref":"R2"},
    {"id":"r3","name":"Agent operation","purpose":"Agents observe, explain, propose and apply changes under policy, with a tamper-evident record","milestones":"7","exitEvidence":"Every goal tagged R3 verified, including an agent carrying out a schema change through a proposal end to end.","ref":"R3"},
    {"id":"r4","name":"Enterprise readiness","purpose":"The content features are complete and the platform is deployed and recovered in the cloud","milestones":"8, 9","exitEvidence":"Every goal tagged R4 verified, with a zone-loss drill and a tenant point-in-time restore measured against their objectives.","ref":"R4"}
  ],
  "milestones": [
    {"id":"rm-1","name":"Gate","number":1,"proves":"the specification and the two tools hold the code that already exists to account.","stage":"R0","stageRef":"r0","detail":"**Proves:** the specification and the two tools hold the code that already exists to account.\n\nThe requirements of the prototype's kernel, store, runtime, gateway and simulator are written, each tied to an existing test, and Concordance reports them verified from a recorded run. Exegra validates the specification and its structural, data and behaviour claims.","ref":"RM-1"},
    {"id":"rm-2","name":"Tenant databases and seams","number":2,"proves":"a tenant is a PostgreSQL database behind the store contract, found through a directory, in a local container stack.","stage":"R0","stageRef":"r0","detail":"**Proves:** a tenant is a PostgreSQL database behind the store contract, found through a directory, in a local container stack.\n\nThe PostgreSQL adapter passes the conformance suite. The control plane provisions, suspends, exports and deletes tenants. Every other seam (files, copies, wake, keys, mail, limits, backup) has its trait, suite and local adapter. Each tenant database is backed up to the backup archive. Component-to-component credentials replace the shared service token.","ref":"RM-2"},
    {"id":"rm-3","name":"Identity core","number":3,"proves":"sign-in, sessions and their revocation live in one service with an audit record.","stage":"R1","stageRef":"r1","detail":"**Proves:** sign-in, sessions and their revocation live in one service with an audit record.\n\nRealms per tenant, passwords, passkeys, emailed links, second factors, step-up, recovery, session listing and revocation, per-tenant keys. Sign-in code is removed from the runtime.","ref":"RM-3"},
    {"id":"rm-4","name":"Federation and tokens","number":4,"proves":"organisations bring their identity providers, and services and agents get identities.","stage":"R1","stageRef":"r1","detail":"**Proves:** organisations bring their identity providers, and services and agents get identities.\n\nOpenID Connect and SAML sign-in, SCIM provisioning, domains bound to a provider, service accounts, delegated tokens for agents, key rotation.","ref":"RM-4"},
    {"id":"rm-5","name":"Scheduling and workflows","number":5,"proves":"tenants schedule work that survives failure and applies effects once.","stage":"R2","stageRef":"r2","detail":"**Proves:** tenants schedule work that survives failure and applies effects once.\n\nJobs, schedules, triggers, leases with fencing, retries, the wake index, workflows as metadata, the connector runner, scheduled publication.","ref":"RM-5"},
    {"id":"rm-6","name":"Copies and the edge","number":6,"proves":"published content is served from stored copies with bounded staleness and no leakage.","stage":"R2","stageRef":"r2","detail":"**Proves:** published content is served from stored copies with bounded staleness and no leakage.\n\nVersion-keyed view copies, audience classes, tags and removal, the content delivery network contract, purge from the outbox, custom domains and certificates.","ref":"RM-6"},
    {"id":"rm-7","name":"Agent plane","number":7,"proves":"agents operate the platform through the catalogue, under policy, on the record.","stage":"R3","stageRef":"r3","detail":"**Proves:** agents operate the platform through the catalogue, under policy, on the record.\n\nThe operation catalogue, dry runs, proposals with projections and approvals, the Model Context Protocol server, budgets and the kill switch, the hash-chained audit log, telemetry export, self-description.","ref":"RM-7"},
    {"id":"rm-8","name":"Content features","number":8,"proves":"the content model is complete for editorial work.","stage":"R4","stageRef":"r4","detail":"**Proves:** the content model is complete for editorial work.\n\nVersion history and restore, media with renditions, languages with fallback, preview, accessibility conformance of the authoring application.","ref":"RM-8"},
    {"id":"rm-2","name":"Tenant databases and seams","number":2,"proves":"a tenant is a PostgreSQL database behind the store contract, found through a directory, in a local container stack.","stage":"R0","stageRef":"r0","detail":"**Proves:** a tenant is a PostgreSQL database behind the store contract, found through a directory, in a local container stack.\n\nThe PostgreSQL adapter passes the conformance suite. The control plane provisions, suspends, exports and deletes tenants. Every other seam (files, copies, wake, keys, mail) has its trait, suite and local adapter. Component-to-component credentials replace the shared service token. Tenants have a kind (production, staging or sandbox), and a tenant can be archived, exported and deleted after a grace period.","ref":"RM-2"},
    {"id":"rm-3","name":"Identity core","number":3,"proves":"sign-in, sessions and their revocation live in one service with an audit record.","stage":"R1","stageRef":"r1","detail":"**Proves:** sign-in, sessions and their revocation live in one service with an audit record.\n\nRealms per tenant, passwords, passkeys, emailed links, second factors, step-up, recovery, session listing and revocation, per-tenant keys. Sign-in code is removed from the runtime. Roles and teams, invitations and sandbox tenants started from a template.","ref":"RM-3"},
    {"id":"rm-4","name":"Federation and tokens","number":4,"proves":"organisations bring their identity providers, and services and agents get identities.","stage":"R1","stageRef":"r1","detail":"**Proves:** organisations bring their identity providers, and services and agents get identities.\n\nOpenID Connect and SAML sign-in, SCIM provisioning, domains bound to a provider, service accounts, delegated tokens for agents, key rotation. Support grants that a tenant owner issues to platform operators, with every act recorded.","ref":"RM-4"},
    {"id":"rm-5","name":"Scheduling and workflows","number":5,"proves":"tenants schedule work that survives failure and applies effects once.","stage":"R2","stageRef":"r2","detail":"**Proves:** tenants schedule work that survives failure and applies effects once.\n\nJobs, schedules, triggers, leases with fencing, retries, the wake index, workflows as metadata, the connector runner, scheduled publication. Notices and the inbox, inbound and outbound webhooks, bulk jobs, and the trigger and action catalogue.","ref":"RM-5"},
    {"id":"rm-6","name":"Copies, the edge and the first site","number":6,"proves":"published content is served from stored copies with bounded staleness and no leakage.","stage":"R2","stageRef":"r2","detail":"**Proves:** published content is served from stored copies with bounded staleness and no leakage.\n\nVersion-keyed view copies, audience classes, tags and removal, the content delivery network contract, purge from the outbox, custom domains and certificates. Authoring of records of tenant-defined content types, review by named approvers, preview links, redirects, sitemaps and feeds, the delivery interface with field selection, paging and filtering, delivery keys, plan quotas and metering with the billing export.","ref":"RM-6"},
    {"id":"rm-7","name":"Agent plane","number":7,"proves":"agents operate the platform through the catalogue, under policy, on the record.","stage":"R3","stageRef":"r3","detail":"**Proves:** agents operate the platform through the catalogue, under policy, on the record.\n\nThe operation catalogue, dry runs, proposals with projections and approvals, the Model Context Protocol server, budgets and the kill switch, the hash-chained audit log, telemetry export, self-description. Promotion of configuration from a staging tenant through a proposal, installation of platform templates after a projection, and the status page.","ref":"RM-7"},
    {"id":"rm-8","name":"Content features","number":8,"proves":"the content model is complete for editorial work.","stage":"R4","stageRef":"r4","detail":"**Proves:** the content model is complete for editorial work.\n\nVersion history and restore, media with renditions, languages with fallback, preview, accessibility conformance of the authoring application. Search by audience, form submissions, import and export of records, and the review diff.","ref":"RM-8"},
    {"id":"rm-9","name":"Cloud profile","number":9,"proves":"the same images run in the cloud and recover from failure.","stage":"R4","stageRef":"r4","detail":"**Proves:** the same images run in the cloud and recover from failure.\n\nInfrastructure definitions, cloud adapters for every seam, deployments without refused requests, zone-loss and restore drills.","ref":"RM-9"}
  ],

  // ---- Requirements (kind "requirement") and the claims Exegra evaluates itself (m-...) ----------
  "claims": [
    {"id":"krn-001","kind":"requirement","statement":"For every snapshot, intent and context, two evaluations of the transition function SHALL return equal results.","rationale":"Replay, simulation and projection all rest on this.","evaluate":{"method":"property"},"ref":"KRN-001","area":"01-core","section":"Decisions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["k-11","g-5"],"milestone":1,"inSection":"sec-kernel-2"},
    {"id":"krn-002","kind":"requirement","statement":"An accepted transition SHALL produce a state delta addressed only to the tenant named in its context.","rationale":"Isolation starts at the decision: a delta for another tenant cannot be expressed.","evaluate":{"method":"property"},"ref":"KRN-002","area":"01-core","section":"Decisions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::World::step`","traces":["g-1","k-2"],"milestone":1,"inSection":"sec-kernel-2"},
    {"id":"krn-003","kind":"requirement","statement":"A transition requested by a principal that no policy authorises SHALL be rejected without a state delta.","rationale":"Authorisation is default deny and has no side door.","evaluate":{"method":"property"},"ref":"KRN-003","area":"01-core","section":"Decisions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["k-13","g-20"],"milestone":1,"inSection":"sec-kernel-2"},
    {"id":"krn-004","kind":"requirement","statement":"A read SHALL return only records that the policies of the requesting principal permit.","rationale":"Reads are filtered by the same decision that guards writes.","evaluate":{"method":"property"},"ref":"KRN-004","area":"01-core","section":"Decisions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::read`","traces":["g-20"],"milestone":1,"inSection":"sec-kernel-2"},
    {"id":"krn-005","kind":"requirement","statement":"A transition evaluated on a partial snapshot SHALL return the result of the complete snapshot or a rejection naming the state it lacks.","rationale":"A store may load only part of a tenant. A missing record must not turn into a wrong acceptance.","evaluate":{"method":"property"},"ref":"KRN-005","area":"01-core","section":"Decisions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::needs`","traces":["k-3","g-5"],"milestone":1,"inSection":"sec-kernel-2"},
    {"id":"krn-006","kind":"requirement","statement":"Each accepted transition SHALL advance the tenant revision by exactly one step.","rationale":"Revisions are the versions that stored copies and optimistic commits are keyed by.","evaluate":{"method":"property"},"ref":"KRN-006","area":"01-core","section":"Decisions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::apply_delta`","traces":["g-5"],"milestone":1,"inSection":"sec-kernel-2"},
    {"id":"krn-007","kind":"requirement","statement":"A rejected transition SHALL list the checks that failed.","rationale":"People and agents act on the reason, not on the fact of a refusal.","evaluate":{"method":"example"},"ref":"KRN-007","area":"01-core","section":"Decisions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::DomainError`","traces":["g-24","g-11"],"milestone":1,"inSection":"sec-kernel-2"},
    {"id":"krn-008","kind":"requirement","statement":"A change to a workflow field SHALL be rejected unless a declared workflow transition permits it.","rationale":"Workflows are data, and the kernel is what enforces them.","evaluate":{"method":"example"},"ref":"KRN-008","area":"01-core","section":"Decisions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["g-31"],"milestone":1,"inSection":"sec-kernel-2"},
    {"id":"krn-009","kind":"requirement","statement":"A schema change applied in strict mode SHALL be rejected while an existing record would not conform to the new schema.","rationale":"A strict change either leaves every record valid or does not happen.","evaluate":{"method":"example"},"ref":"KRN-009","area":"01-core","section":"Schema changes","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::plan_migration`","traces":["g-44"],"milestone":1,"inSection":"sec-kernel-3"},
    {"id":"krn-010","kind":"requirement","statement":"A schema change applied in grandfather mode SHALL be accepted with the non-conforming records listed in its evidence.","rationale":"The other honest option: accept, and say exactly what is now out of line.","evaluate":{"method":"example"},"ref":"KRN-010","area":"01-core","section":"Schema changes","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::plan_migration`","traces":["g-44"],"milestone":1,"inSection":"sec-kernel-3"},
    {"id":"krn-011","kind":"requirement","statement":"Every state accepted by the transition function without a grandfathered change SHALL satisfy every state invariant.","rationale":"This is the invariant the abstract model proves for its fragment, checked on the real kernel.","evaluate":{"method":"property"},"ref":"KRN-011","area":"01-core","section":"Schema changes","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_verification::invariants::check_world`","traces":["g-43"],"milestone":1,"inSection":"sec-kernel-3"},
    {"id":"krn-012","kind":"requirement","statement":"The kernel crate SHALL contain no reference to file, network, clock, randomness, environment or process facilities.","rationale":"Purity is what makes the kernel simulable. It is kept by a scan, not by intention.","evaluate":{"method":"example"},"ref":"KRN-012","area":"01-core","section":"Purity and proof","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel`","traces":["k-1"],"milestone":1,"inSection":"sec-kernel-4"},
    {"id":"krn-013","kind":"requirement","statement":"The step function of the abstract model SHALL leave every tenant other than the addressed one unchanged.","rationale":"Tenant isolation, machine-checked for the model.","evaluate":{"method":"proof"},"ref":"KRN-013","area":"01-core","section":"Purity and proof","lifecycle":"active","boundary":"b-1","boundaryDetail":"`Strata.step`","traces":["g-43"],"milestone":1,"inSection":"sec-kernel-4"},
    {"id":"krn-014","kind":"requirement","statement":"An accepted strict step of the abstract model SHALL preserve the well-formedness of every tenant.","rationale":"Invariant preservation, machine-checked for the model.","evaluate":{"method":"proof"},"ref":"KRN-014","area":"01-core","section":"Purity and proof","lifecycle":"active","boundary":"b-1","boundaryDetail":"`Strata.step`","traces":["g-43"],"milestone":1,"inSection":"sec-kernel-4"},
    {"id":"krn-015","kind":"requirement","statement":"A step of the abstract model requested by an unauthorised principal SHALL yield no new world.","rationale":"Authorisation, machine-checked for the model.","evaluate":{"method":"proof"},"ref":"KRN-015","area":"01-core","section":"Purity and proof","lifecycle":"active","boundary":"b-1","boundaryDetail":"`Strata.step`","traces":["g-43","k-13"],"milestone":1,"inSection":"sec-kernel-4"},
    {"id":"krn-016","kind":"requirement","statement":"The kernel and the abstract model SHALL produce identical outcomes for every scenario of the correspondence fixtures.","rationale":"The proofs are about the model. This is what ties the model to the code.","evaluate":{"method":"property"},"ref":"KRN-016","area":"01-core","section":"Purity and proof","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_verification::lean::kernel_output`","traces":["g-43"],"milestone":1,"inSection":"sec-kernel-4"},
    {"id":"sto-001","kind":"requirement","statement":"The memory adapter SHALL pass every check of the storage conformance table.","rationale":"The reference adapter states the contract in the simplest code.","evaluate":{"method":"conformance"},"ref":"STO-001","area":"01-core","section":"Adapters","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["g-38"],"milestone":1,"cases":["cases-storage-conformance"],"inSection":"sec-storage-2"},
    {"id":"sto-002","kind":"requirement","statement":"The SQLite adapter SHALL pass every check of the storage conformance table on a database file.","rationale":"The adapter used for single-process local work and for simulation.","evaluate":{"method":"conformance"},"ref":"STO-002","area":"01-core","section":"Adapters","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["g-38","g-36"],"milestone":1,"cases":["cases-storage-conformance"],"inSection":"sec-storage-2"},
    {"id":"sto-003","kind":"requirement","statement":"Data acknowledged by the SQLite adapter SHALL be readable after the database file is reopened.","rationale":"Durability is claimed by the adapter and checked.","evaluate":{"method":"example"},"ref":"STO-003","area":"01-core","section":"Adapters","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["g-39"],"milestone":1,"inSection":"sec-storage-2"},
    {"id":"sto-004","kind":"requirement","statement":"The PostgreSQL adapter SHALL pass every check of the storage conformance table against a database of one tenant.","rationale":"The production adapter is accepted on the same terms as the others.","evaluate":{"method":"conformance"},"ref":"STO-004","area":"01-core","section":"Adapters","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["g-38","g-1","d-1"],"milestone":2,"cases":["cases-storage-conformance"],"inSection":"sec-storage-2"},
    {"id":"sto-005","kind":"requirement","statement":"An adapter SHALL open a tenant database using only the placement that the tenant directory returns for that tenant.","rationale":"A move changes the placement and nothing else.","evaluate":{"method":"scenario"},"ref":"STO-005","area":"01-core","section":"Adapters","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["k-3","g-3"],"milestone":2,"inSection":"sec-storage-2"},
    {"id":"sto-006","kind":"requirement","statement":"The connections an adapter holds open for one tenant SHALL stay within that tenant's connection quota.","rationale":"A database per tenant makes connections the first shared resource to run out.","evaluate":{"method":"property"},"ref":"STO-006","area":"01-core","section":"Adapters","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["g-4"],"milestone":2,"inSection":"sec-storage-2"},
    {"id":"run-001","kind":"requirement","statement":"A subscriber SHALL receive a notice about a record only when the policies of its principal permit reading that record.","rationale":"Live updates go through the same read decision as queries.","evaluate":{"method":"scenario"},"ref":"RUN-001","area":"01-core","section":"Runtime","lifecycle":"active","boundary":"b-9","boundaryDetail":"`event stream`","traces":["g-20"],"milestone":1,"inSection":"sec-runtime-2"},
    {"id":"run-002","kind":"requirement","statement":"A session issued for one tenant SHALL carry no identity when presented at the address of another tenant.","rationale":"A session belongs to a realm, and a realm to a tenant.","evaluate":{"method":"scenario"},"ref":"RUN-002","area":"01-core","section":"Runtime","lifecycle":"active","boundary":"b-4","boundaryDetail":"`session`","traces":["g-20","k-2"],"milestone":1,"inSection":"sec-runtime-2"},
    {"id":"run-003","kind":"requirement","statement":"The runtime SHALL refuse a request that lacks the service credential.","rationale":"Only platform components call the runtime.","evaluate":{"method":"scenario"},"ref":"RUN-003","area":"01-core","section":"Runtime","lifecycle":"active","boundary":"b-3","boundaryDetail":"`service credential`","traces":["k-6"],"milestone":1,"inSection":"sec-runtime-2"},
    {"id":"run-004","kind":"requirement","statement":"Installing the same tenant bundles into an empty store SHALL produce the same tenant state.","rationale":"Provisioning from a template is a deterministic sequence of kernel intents.","evaluate":{"method":"scenario"},"ref":"RUN-004","area":"01-core","section":"Runtime","lifecycle":"active","boundary":"b-21","boundaryDetail":"`tenant bundle`","traces":["k-11","g-2"],"milestone":1,"inSection":"sec-runtime-2"},
    {"id":"run-005","kind":"requirement","statement":"The runtime SHALL publish a domain event only after the transaction that produced it has committed.","rationale":"Subscribers, triggers and purges all act on events, so an event for a change that did not happen is a defect everywhere at once.","evaluate":{"method":"scenario"},"ref":"RUN-005","area":"01-core","section":"Runtime","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["k-9"],"milestone":2,"inSection":"sec-runtime-2"},
    {"id":"gwy-001","kind":"requirement","statement":"The gateway SHALL resolve the tenant of a request from its host name alone.","rationale":"Nothing a client sends in a header, a parameter or a body can name a tenant.","evaluate":{"method":"scenario"},"ref":"GWY-001","area":"01-core","section":"Gateway","lifecycle":"active","boundary":"b-9","boundaryDetail":"`Host`","traces":["g-20","d-6"],"milestone":1,"inSection":"sec-runtime-3"},
    {"id":"gwy-002","kind":"requirement","statement":"The gateway SHALL refuse a state-changing request that lacks the request token of its session.","rationale":"A cross-site request carries the cookie and not the token.","evaluate":{"method":"scenario"},"ref":"GWY-002","area":"01-core","section":"Gateway","lifecycle":"active","boundary":"b-9","boundaryDetail":"`x-csrf-token`","traces":["g-46"],"milestone":1,"inSection":"sec-runtime-3"},
    {"id":"gwy-003","kind":"requirement","statement":"The gateway SHALL set the session cookie with the HttpOnly and SameSite=Strict attributes.","rationale":"Page script cannot read the secret and other sites cannot send it.","evaluate":{"method":"scenario"},"ref":"GWY-003","area":"01-core","section":"Gateway","lifecycle":"active","boundary":"b-4","boundaryDetail":"`strata_sid`","traces":["k-16"],"milestone":1,"inSection":"sec-runtime-3"},
    {"id":"gwy-004","kind":"requirement","statement":"The gateway SHALL refuse a WebSocket upgrade whose origin is not an allowed origin.","rationale":"A socket opened from another site would carry the cookie.","evaluate":{"method":"scenario"},"ref":"GWY-004","area":"01-core","section":"Gateway","lifecycle":"active","boundary":"b-9","boundaryDetail":"`Origin`","traces":["g-46"],"milestone":1,"inSection":"sec-runtime-3"},
    {"id":"gwy-005","kind":"requirement","statement":"A page response SHALL carry a content security policy that allows no inline script.","rationale":"The second line of defence behind structured content.","evaluate":{"method":"example"},"ref":"GWY-005","area":"01-core","section":"Gateway","lifecycle":"active","boundary":"b-13","boundaryDetail":"`Content-Security-Policy`","traces":["k-12"],"milestone":1,"inSection":"sec-runtime-3"},
    {"id":"sim-001","kind":"requirement","statement":"Two runs of one scenario SHALL produce traces with equal hashes.","rationale":"A simulation that cannot be repeated proves nothing.","evaluate":{"method":"example"},"ref":"SIM-001","area":"01-core","section":"Simulator","lifecycle":"active","boundary":"b-20","boundaryDetail":"`strata_simulation::engine::run`","traces":["k-11","g-42"],"milestone":1,"inSection":"sec-runtime-4"},
    {"id":"sim-002","kind":"requirement","statement":"A projection of a change that alters no behaviour SHALL report no divergence.","rationale":"The comparison has no false positives on an empty change.","evaluate":{"method":"example"},"ref":"SIM-002","area":"01-core","section":"Simulator","lifecycle":"active","boundary":"b-20","boundaryDetail":"`strata_simulation::project::project`","traces":["g-44"],"milestone":1,"inSection":"sec-runtime-4"},
    {"id":"sim-003","kind":"requirement","statement":"A projection SHALL report the first scheduled operation whose outcome differs under the proposed change.","rationale":"The first divergence is the one certainly caused by the change.","evaluate":{"method":"example"},"ref":"SIM-003","area":"01-core","section":"Simulator","lifecycle":"active","boundary":"b-20","boundaryDetail":"`strata_simulation::project::project`","traces":["g-44","g-26"],"milestone":1,"inSection":"sec-runtime-4"},
    {"id":"sim-004","kind":"requirement","statement":"A replay of a tenant journal SHALL reproduce the recorded state delta of each entry.","rationale":"Production and simulation run the same kernel, and this is the check that they agree.","evaluate":{"method":"example"},"ref":"SIM-004","area":"01-core","section":"Simulator","lifecycle":"active","boundary":"b-20","boundaryDetail":"`strata_simulation::journal::replay_journal`","traces":["g-42","k-11"],"milestone":1,"inSection":"sec-runtime-4"},
    {"id":"ten-001","kind":"requirement","statement":"Provisioning a tenant SHALL create a database that holds the data of that tenant alone.","rationale":"The database is the isolation boundary.","evaluate":{"method":"scenario"},"ref":"TEN-001","area":"02-tenancy","section":"Provisioning","lifecycle":"active","boundary":"b-3","boundaryDetail":"`POST /tenants`","traces":["g-1"],"milestone":2,"inSection":"sec-tenancy-2"},
    {"id":"ten-002","kind":"requirement","statement":"The tenant directory SHALL report a tenant as active only after its database layout and its template have been installed.","rationale":"Active means usable. Modelled as the provisioning flow.","evaluate":{"method":"scenario"},"ref":"TEN-002","area":"02-tenancy","section":"Provisioning","lifecycle":"active","boundary":"b-3","boundaryDetail":"`tenant state`","traces":["g-2"],"milestone":2,"inSection":"sec-tenancy-2"},
    {"id":"ten-003","kind":"requirement","statement":"A provisioning run that fails SHALL leave no tenant reported as active.","rationale":"A half-made tenant is removed or retried, and is not offered to anyone meanwhile.","evaluate":{"method":"scenario"},"ref":"TEN-003","area":"02-tenancy","section":"Provisioning","lifecycle":"active","boundary":"b-3","boundaryDetail":"`tenant state`","traces":["g-2"],"milestone":2,"inSection":"sec-tenancy-2"},
    {"id":"ten-004","kind":"requirement","statement":"Provisioning a tenant from the publication template SHALL complete within 30 seconds at the 95th percentile.","rationale":"Sign-up waits for this.","evaluate":{"method":"budget"},"ref":"TEN-004","area":"02-tenancy","section":"Provisioning","lifecycle":"active","boundary":"b-3","boundaryDetail":"`POST /tenants`","traces":["g-2"],"milestone":2,"inSection":"sec-tenancy-2"},
    {"id":"ten-005","kind":"requirement","statement":"A tenant created with a region SHALL have its database and its stored files placed in that region.","rationale":"Residency is a property of the placement.","evaluate":{"method":"scenario"},"ref":"TEN-005","area":"02-tenancy","section":"Provisioning","lifecycle":"active","boundary":"b-3","boundaryDetail":"`placement`","traces":["g-3"],"milestone":2,"inSection":"sec-tenancy-2"},
    {"id":"ten-006","kind":"requirement","statement":"The control database SHALL hold no field of a tenant record.","rationale":"Identifiers, states and addresses only, so that a tenant can be deleted by deleting its own things.","evaluate":{"method":"property"},"ref":"TEN-006","area":"02-tenancy","section":"Isolation","lifecycle":"active","boundary":"b-3","boundaryDetail":"`control database`","traces":["k-2"],"milestone":2,"inSection":"sec-tenancy-3"},
    {"id":"ten-007","kind":"requirement","statement":"A request for one tenant SHALL be served using a database connection opened for that tenant alone.","rationale":"No pooled connection is ever switched between tenants.","evaluate":{"method":"property"},"ref":"TEN-007","area":"02-tenancy","section":"Isolation","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["g-20","k-3"],"milestone":2,"inSection":"sec-tenancy-3"},
    {"id":"ten-008","kind":"requirement","statement":"A tenant that exceeds its connection quota SHALL receive a throttling response while other tenants are served.","rationale":"The noisy tenant is the one that waits.","evaluate":{"method":"scenario"},"ref":"TEN-008","area":"02-tenancy","section":"Isolation","lifecycle":"active","boundary":"b-9","boundaryDetail":"`429`","traces":["g-4"],"milestone":2,"inSection":"sec-tenancy-3"},
    {"id":"ten-009","kind":"requirement","statement":"A suspended tenant SHALL refuse state-changing requests.","rationale":"Suspension is reversible and loses nothing.","evaluate":{"method":"scenario"},"ref":"TEN-009","area":"02-tenancy","section":"Life cycle","lifecycle":"active","boundary":"b-3","boundaryDetail":"`POST /tenants/{id}/suspend`","traces":["g-1"],"milestone":2,"inSection":"sec-tenancy-4"},
    {"id":"ten-010","kind":"requirement","statement":"An export of a tenant SHALL restore into an empty installation as a state with the same canonical hash.","rationale":"The tenant is portable, and the hash is the proof.","evaluate":{"method":"scenario"},"ref":"TEN-010","area":"02-tenancy","section":"Life cycle","lifecycle":"active","boundary":"b-3","boundaryDetail":"`POST /tenants/{id}/export`","traces":["g-1"],"milestone":2,"inSection":"sec-tenancy-4"},
    {"id":"ten-011","kind":"requirement","statement":"Deleting a tenant SHALL remove its database, its stored files and its encryption key.","rationale":"Deletion is the removal of three things that belong to nobody else.","evaluate":{"method":"scenario"},"ref":"TEN-011","area":"02-tenancy","section":"Life cycle","lifecycle":"active","boundary":"b-3","boundaryDetail":"`DELETE /tenants/{id}`","traces":["g-1","g-40"],"milestone":2,"inSection":"sec-tenancy-4"},
    {"id":"ten-012","kind":"requirement","statement":"Moving a tenant to another database cluster SHALL preserve the canonical hash of its state.","rationale":"A move is a copy that can be checked.","evaluate":{"method":"scenario"},"ref":"TEN-012","area":"02-tenancy","section":"Life cycle","lifecycle":"active","boundary":"b-3","boundaryDetail":"`POST /tenants/{id}/move`","traces":["g-3"],"milestone":2,"inSection":"sec-tenancy-4"},
    {"id":"ten-013","kind":"requirement","statement":"The address of a tenant SHALL resolve to the same tenant before and after a move.","rationale":"Addresses belong to the directory, not to a cluster.","evaluate":{"method":"scenario"},"ref":"TEN-013","area":"02-tenancy","section":"Life cycle","lifecycle":"active","boundary":"b-3","boundaryDetail":"`domain binding`","traces":["g-3"],"milestone":2,"inSection":"sec-tenancy-4"},
    {"id":"ten-014","kind":"requirement","statement":"A change to the storage layout SHALL be applied to each tenant database separately with its outcome recorded per tenant.","rationale":"With a database per tenant, a layout change is many small changes, and some will lag.","evaluate":{"method":"scenario"},"ref":"TEN-014","area":"02-tenancy","section":"Life cycle","lifecycle":"active","boundary":"b-3","boundaryDetail":"`layout version`","traces":["g-1"],"milestone":2,"inSection":"sec-tenancy-4"},
    {"id":"ten-015","kind":"requirement","statement":"A tenant restored to a point in time SHALL have the state hash that its journal records at that point.","rationale":"Restore is checked the same way as replay.","evaluate":{"method":"scenario"},"ref":"TEN-015","area":"02-tenancy","section":"Life cycle","lifecycle":"active","boundary":"b-3","boundaryDetail":"`POST /tenants/{id}/restore`","traces":["g-39"],"milestone":9,"inSection":"sec-tenancy-4"},
    {"id":"idn-001","kind":"requirement","statement":"Each sign-in method SHALL issue a session only for the outcomes that the sign-in method table marks as accepted.","rationale":"One table states, per method, what is accepted and what is refused.","evaluate":{"method":"conformance"},"ref":"IDN-001","area":"03-identity","section":"Sign-in methods","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/{method}`","traces":["g-6"],"milestone":3,"cases":["cases-sign-in-methods"],"inSection":"sec-identity-2"},
    {"id":"idn-002","kind":"requirement","statement":"A stored password SHALL be an Argon2id hash with a salt drawn for that password.","rationale":"A stolen database yields no passwords.","evaluate":{"method":"property"},"ref":"IDN-002","area":"03-identity","section":"Sign-in methods","lifecycle":"active","boundary":"b-4","boundaryDetail":"`credential`","traces":["k-4","g-46"],"milestone":3,"inSection":"sec-identity-2"},
    {"id":"idn-003","kind":"requirement","statement":"An emailed sign-in link SHALL be accepted once.","rationale":"Modelled as the emailed link flow, with replay as its negative.","evaluate":{"method":"scenario"},"ref":"IDN-003","area":"03-identity","section":"Sign-in methods","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/link`","traces":["g-6","d-9"],"milestone":3,"inSection":"sec-identity-2"},
    {"id":"idn-004","kind":"requirement","statement":"An emailed sign-in link SHALL be refused after its lifetime has passed.","rationale":"A link in an old mailbox is not a credential.","evaluate":{"method":"scenario"},"ref":"IDN-004","area":"03-identity","section":"Sign-in methods","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/link`","traces":["g-46","d-9"],"milestone":3,"inSection":"sec-identity-2"},
    {"id":"idn-005","kind":"requirement","statement":"An emailed sign-in link SHALL be accepted only in the browser that requested it.","rationale":"A forwarded or intercepted link does not sign anyone else in.","evaluate":{"method":"scenario"},"ref":"IDN-005","area":"03-identity","section":"Sign-in methods","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/link`","traces":["g-46","d-9"],"milestone":3,"inSection":"sec-identity-2"},
    {"id":"idn-006","kind":"requirement","statement":"The response to a request for a sign-in link SHALL be the same whether or not the address belongs to an account.","rationale":"The endpoint does not tell an attacker who has an account.","evaluate":{"method":"property"},"ref":"IDN-006","area":"03-identity","section":"Sign-in methods","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/link/request`","traces":["g-46"],"milestone":3,"inSection":"sec-identity-2"},
    {"id":"idn-007","kind":"requirement","statement":"A passkey registration SHALL bind the credential to the address of the tenant as the relying party.","rationale":"A passkey for one tenant is useless at another.","evaluate":{"method":"scenario"},"ref":"IDN-007","area":"03-identity","section":"Sign-in methods","lifecycle":"active","boundary":"b-4","boundaryDetail":"`WebAuthn relying party`","traces":["g-6","k-14"],"milestone":3,"inSection":"sec-identity-2"},
    {"id":"idn-008","kind":"requirement","statement":"Repeated failed sign-in attempts for one account SHALL delay further attempts for that account.","rationale":"Guessing is slowed without locking the owner out for good.","evaluate":{"method":"scenario"},"ref":"IDN-008","area":"03-identity","section":"Sign-in methods","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/password`","traces":["g-46"],"milestone":3,"inSection":"sec-identity-2"},
    {"id":"idn-009","kind":"requirement","statement":"A principal of one tenant SHALL be unknown to the sign-in of every other tenant.","rationale":"Realms do not overlap.","evaluate":{"method":"property"},"ref":"IDN-009","area":"03-identity","section":"Sign-in methods","lifecycle":"active","boundary":"b-4","boundaryDetail":"`realm`","traces":["g-20","d-3"],"milestone":3,"inSection":"sec-identity-2"},
    {"id":"idn-010","kind":"requirement","statement":"A session secret SHALL be stored only as a hash.","rationale":"A stolen database yields no sessions.","evaluate":{"method":"property"},"ref":"IDN-010","area":"03-identity","section":"Sessions","lifecycle":"active","boundary":"b-4","boundaryDetail":"`sign-in session`","traces":["k-16"],"milestone":3,"inSection":"sec-identity-3"},
    {"id":"idn-011","kind":"requirement","statement":"A successful authentication SHALL end the session that the same browser held before it.","rationale":"The secret changes at every authentication, so one planted beforehand is worthless.","evaluate":{"method":"scenario"},"ref":"IDN-011","area":"03-identity","section":"Sessions","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/{method}`","traces":["g-46"],"milestone":3,"inSection":"sec-identity-3"},
    {"id":"idn-012","kind":"requirement","statement":"A person SHALL be able to list and revoke each of their own sessions.","rationale":"The person is the one who knows which devices are theirs.","evaluate":{"method":"scenario"},"ref":"IDN-012","area":"03-identity","section":"Sessions","lifecycle":"active","boundary":"b-4","boundaryDetail":"`GET /sessions`","traces":["g-9"],"milestone":3,"inSection":"sec-identity-3"},
    {"id":"idn-013","kind":"requirement","statement":"A revoked session SHALL be refused by the gateway once the revocation bound has passed, including when the revocation notice is lost.","rationale":"Modelled as the session revocation flow: the notice is the quick path and a recheck is the backstop.","evaluate":{"method":"scenario"},"ref":"IDN-013","area":"03-identity","section":"Sessions","lifecycle":"active","boundary":"b-4","boundaryDetail":"`assertion`","traces":["g-9"],"milestone":3,"inSection":"sec-identity-3"},
    {"id":"idn-014","kind":"requirement","statement":"A session revocation SHALL be honoured by every gateway instance within 5 seconds.","rationale":"The bound the model's recheck interval stands for.","evaluate":{"method":"budget"},"ref":"IDN-014","area":"03-identity","section":"Sessions","lifecycle":"active","boundary":"b-4","boundaryDetail":"`assertion`","traces":["g-9"],"milestone":3,"inSection":"sec-identity-3"},
    {"id":"idn-015","kind":"requirement","statement":"The identity service SHALL answer a session lookup within 20 ms at the 99th percentile.","rationale":"Every authenticated request pays this once per freshness interval.","evaluate":{"method":"budget"},"ref":"IDN-015","area":"03-identity","section":"Sessions","lifecycle":"active","boundary":"b-4","boundaryDetail":"`assertion`","traces":["g-18","g-12"],"milestone":3,"inSection":"sec-identity-3"},
    {"id":"idn-016","kind":"requirement","statement":"Changing a password SHALL revoke the other sessions of the account.","rationale":"Whoever knew the old password is signed out.","evaluate":{"method":"scenario"},"ref":"IDN-016","area":"03-identity","section":"Sessions","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /password`","traces":["g-9"],"milestone":3,"inSection":"sec-identity-3"},
    {"id":"idn-017","kind":"requirement","statement":"A component other than the identity service SHALL accept a caller identity only from an assertion that the identity service signed.","rationale":"One issuer, many verifiers.","evaluate":{"method":"scenario"},"ref":"IDN-017","area":"03-identity","section":"Sessions","lifecycle":"active","boundary":"b-4","boundaryDetail":"`assertion`","traces":["g-12","d-4"],"milestone":3,"inSection":"sec-identity-3"},
    {"id":"idn-018","kind":"requirement","statement":"A realm policy that asks for a second factor SHALL withhold the session until a second factor has been verified.","rationale":"The first factor alone yields nothing usable.","evaluate":{"method":"scenario"},"ref":"IDN-018","area":"03-identity","section":"Factors, step-up and recovery","lifecycle":"active","boundary":"b-4","boundaryDetail":"`realm policy`","traces":["g-8"],"milestone":3,"inSection":"sec-identity-4"},
    {"id":"idn-019","kind":"requirement","statement":"An operation marked sensitive SHALL be refused when the last authentication of the session is older than the step-up age of the realm.","rationale":"An unattended browser cannot change a password or a key.","evaluate":{"method":"scenario"},"ref":"IDN-019","area":"03-identity","section":"Factors, step-up and recovery","lifecycle":"active","boundary":"b-4","boundaryDetail":"`authentication age`","traces":["g-8"],"milestone":3,"inSection":"sec-identity-4"},
    {"id":"idn-020","kind":"requirement","statement":"Account recovery SHALL revoke every existing session of the account.","rationale":"Recovery is used when control was lost, so it takes control back everywhere.","evaluate":{"method":"scenario"},"ref":"IDN-020","area":"03-identity","section":"Factors, step-up and recovery","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /recovery`","traces":["g-46"],"milestone":3,"inSection":"sec-identity-4"},
    {"id":"idn-021","kind":"requirement","statement":"Every authentication decision SHALL append an audit entry naming the method, the outcome and the checks evaluated.","rationale":"A refused sign-in can be explained to the person and to their administrator.","evaluate":{"method":"property"},"ref":"IDN-021","area":"03-identity","section":"Record and presentation","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit entry`","traces":["g-11"],"milestone":3,"seam":2,"inSection":"sec-identity-5"},
    {"id":"idn-022","kind":"requirement","statement":"A log line or audit entry SHALL contain no password, session secret, token or one-time code.","rationale":"Checked by scanning real output for the secrets of a test run.","evaluate":{"method":"property"},"ref":"IDN-022","area":"03-identity","section":"Record and presentation","lifecycle":"active","boundary":"b-12","boundaryDetail":"`log line`","traces":["k-4"],"milestone":3,"seam":1,"inSection":"sec-identity-5"},
    {"id":"idn-023","kind":"requirement","statement":"The sign-in pages SHALL meet WCAG 2.2 level AA.","rationale":"Signing in is the one flow nobody can skip.","evaluate":{"method":"example"},"ref":"IDN-023","area":"03-identity","section":"Record and presentation","lifecycle":"active","boundary":"b-13","boundaryDetail":"`sign-in pages`","traces":["g-45"],"milestone":3,"inSection":"sec-identity-5"},
    {"id":"fed-001","kind":"requirement","statement":"An OpenID Connect callback whose state value matches no pending request of that browser SHALL be refused.","rationale":"Modelled as the callback flow, with a forged callback as its negative.","evaluate":{"method":"scenario"},"ref":"FED-001","area":"03-identity","section":"OpenID Connect","lifecycle":"active","boundary":"b-5","boundaryDetail":"`GET /federation/oidc/callback`","traces":["g-46","d-7"],"milestone":4,"inSection":"sec-federation-2"},
    {"id":"fed-002","kind":"requirement","statement":"An OpenID Connect sign-in SHALL use the authorization code flow with a proof key.","rationale":"An intercepted code cannot be redeemed.","evaluate":{"method":"scenario"},"ref":"FED-002","area":"03-identity","section":"OpenID Connect","lifecycle":"active","boundary":"b-5","boundaryDetail":"`GET /federation/oidc/start`","traces":["k-14","d-7"],"milestone":4,"inSection":"sec-federation-2"},
    {"id":"fed-003","kind":"requirement","statement":"An identity token whose issuer, audience, signature or nonce fails verification SHALL be refused.","rationale":"A token for another client, or from another issuer, signs nobody in.","evaluate":{"method":"scenario"},"ref":"FED-003","area":"03-identity","section":"OpenID Connect","lifecycle":"active","boundary":"b-5","boundaryDetail":"`identity token`","traces":["g-46"],"milestone":4,"inSection":"sec-federation-2"},
    {"id":"fed-004","kind":"requirement","statement":"Provider signing keys SHALL be refreshed from the provider metadata when a token names an unknown key.","rationale":"Providers rotate keys without notice.","evaluate":{"method":"scenario"},"ref":"FED-004","area":"03-identity","section":"OpenID Connect","lifecycle":"active","boundary":"b-5","boundaryDetail":"`provider metadata`","traces":["g-6"],"milestone":4,"inSection":"sec-federation-2"},
    {"id":"fed-005","kind":"requirement","statement":"A SAML response SHALL be accepted only when its assertion is signed by a certificate that the tenant configured.","rationale":"An unsigned or wrongly signed assertion is just text.","evaluate":{"method":"scenario"},"ref":"FED-005","area":"03-identity","section":"SAML","lifecycle":"active","boundary":"b-5","boundaryDetail":"`POST /federation/saml/acs`","traces":["g-6","d-8"],"milestone":4,"inSection":"sec-federation-3"},
    {"id":"fed-006","kind":"requirement","statement":"A SAML assertion presented a second time SHALL be refused.","rationale":"Assertions are bearer material until their identifier is remembered.","evaluate":{"method":"scenario"},"ref":"FED-006","area":"03-identity","section":"SAML","lifecycle":"active","boundary":"b-5","boundaryDetail":"`POST /federation/saml/acs`","traces":["g-46"],"milestone":4,"inSection":"sec-federation-3"},
    {"id":"fed-007","kind":"requirement","statement":"A SAML response that answers no pending request SHALL be refused unless the tenant enabled sign-in started by the provider.","rationale":"The unsolicited form is the one attackers inject into.","evaluate":{"method":"scenario"},"ref":"FED-007","area":"03-identity","section":"SAML","lifecycle":"active","boundary":"b-5","boundaryDetail":"`POST /federation/saml/acs`","traces":["d-8","g-46"],"milestone":4,"inSection":"sec-federation-3"},
    {"id":"fed-008","kind":"requirement","statement":"A SAML response whose audience or recipient names another service SHALL be refused.","rationale":"An assertion issued for a different service provider is not for this one.","evaluate":{"method":"scenario"},"ref":"FED-008","area":"03-identity","section":"SAML","lifecycle":"active","boundary":"b-5","boundaryDetail":"`POST /federation/saml/acs`","traces":["g-46"],"milestone":4,"inSection":"sec-federation-3"},
    {"id":"fed-009","kind":"requirement","statement":"A realm that binds an email domain to an identity provider SHALL refuse password and emailed-link sign-in for addresses in that domain.","rationale":"When the organisation says its provider decides, nothing else does.","evaluate":{"method":"scenario"},"ref":"FED-009","area":"03-identity","section":"Policy and linking","lifecycle":"active","boundary":"b-4","boundaryDetail":"`realm policy`","traces":["g-7","d-6"],"milestone":4,"inSection":"sec-federation-4"},
    {"id":"fed-010","kind":"requirement","statement":"The sign-in page SHALL offer the identity providers configured for the realm of the address it is served at.","rationale":"The address selects the realm before anyone types anything.","evaluate":{"method":"scenario"},"ref":"FED-010","area":"03-identity","section":"Policy and linking","lifecycle":"active","boundary":"b-4","boundaryDetail":"`sign-in page`","traces":["g-6","d-6"],"milestone":4,"inSection":"sec-federation-4"},
    {"id":"fed-011","kind":"requirement","statement":"A first federated sign-in SHALL create a principal only when the realm enabled creation on first sign-in.","rationale":"Otherwise people are admitted by provisioning or invitation.","evaluate":{"method":"scenario"},"ref":"FED-011","area":"03-identity","section":"Policy and linking","lifecycle":"active","boundary":"b-5","boundaryDetail":"`first federated sign-in`","traces":["g-7"],"milestone":4,"inSection":"sec-federation-4"},
    {"id":"fed-012","kind":"requirement","statement":"A federated identity SHALL be linked to an existing principal only after that principal has authenticated.","rationale":"A matching email address at a provider is not proof of owning the account.","evaluate":{"method":"scenario"},"ref":"FED-012","area":"03-identity","section":"Policy and linking","lifecycle":"active","boundary":"b-5","boundaryDetail":"`identity link`","traces":["g-46"],"milestone":4,"inSection":"sec-federation-4"},
    {"id":"fed-013","kind":"requirement","statement":"An outage of an external identity provider SHALL leave the other sign-in methods of the realm usable.","rationale":"One provider failing does not take the tenant down.","evaluate":{"method":"scenario"},"ref":"FED-013","area":"03-identity","section":"Policy and linking","lifecycle":"active","boundary":"b-4","boundaryDetail":"`sign-in methods`","traces":["g-6"],"milestone":4,"inSection":"sec-federation-4"},
    {"id":"fed-014","kind":"requirement","statement":"The provisioning endpoint SHALL behave as the provisioning case table states for each listed operation.","rationale":"SCIM is a standard, and conformance to it is a table.","evaluate":{"method":"conformance"},"ref":"FED-014","area":"03-identity","section":"Provisioning","lifecycle":"active","boundary":"b-5","boundaryDetail":"`/scim/v2`","traces":["g-7","k-14"],"milestone":4,"cases":["cases-provisioning-operations"],"inSection":"sec-federation-5"},
    {"id":"fed-015","kind":"requirement","statement":"Deactivating a person through provisioning SHALL revoke the sessions of that person.","rationale":"Leaving the organisation ends access now, not at the next sign-in.","evaluate":{"method":"scenario"},"ref":"FED-015","area":"03-identity","section":"Provisioning","lifecycle":"active","boundary":"b-5","boundaryDetail":"`/scim/v2/Users`","traces":["g-7","g-9"],"milestone":4,"inSection":"sec-federation-5"},
    {"id":"tok-001","kind":"requirement","statement":"A service account SHALL obtain an access token through the client credentials grant.","rationale":"The standard grant for a caller that is itself.","evaluate":{"method":"scenario"},"ref":"TOK-001","area":"03-identity","section":"Issue","lifecycle":"active","boundary":"b-6","boundaryDetail":"`POST /token`","traces":["g-10"],"milestone":4,"inSection":"sec-tokens-2"},
    {"id":"tok-002","kind":"requirement","statement":"An access token SHALL grant no scope beyond those of the grant it was issued from.","rationale":"A token is a subset of a grant.","evaluate":{"method":"property"},"ref":"TOK-002","area":"03-identity","section":"Issue","lifecycle":"active","boundary":"b-6","boundaryDetail":"`access token`","traces":["g-10"],"milestone":4,"inSection":"sec-tokens-2"},
    {"id":"tok-003","kind":"requirement","statement":"An agent acting for a person SHALL present a token that names both the agent and the person.","rationale":"Attribution needs both names on the request itself.","evaluate":{"method":"scenario"},"ref":"TOK-003","area":"03-identity","section":"Issue","lifecycle":"active","boundary":"b-6","boundaryDetail":"`POST /token`","traces":["g-25"],"milestone":4,"inSection":"sec-tokens-2"},
    {"id":"tok-004","kind":"requirement","statement":"A delegated token SHALL grant no permission that the delegating person lacks.","rationale":"Delegation narrows and cannot widen.","evaluate":{"method":"property"},"ref":"TOK-004","area":"03-identity","section":"Issue","lifecycle":"active","boundary":"b-6","boundaryDetail":"`delegated token`","traces":["k-13","g-28"],"milestone":4,"inSection":"sec-tokens-2"},
    {"id":"tok-005","kind":"requirement","statement":"An access token SHALL be valid for at most 10 minutes.","rationale":"Short enough that revoking the grant is enough.","evaluate":{"method":"budget"},"ref":"TOK-005","area":"03-identity","section":"Issue","lifecycle":"active","boundary":"b-6","boundaryDetail":"`access token`","traces":["g-28"],"milestone":4,"inSection":"sec-tokens-2"},
    {"id":"tok-006","kind":"requirement","statement":"An access token issued for one tenant SHALL be refused by every other tenant.","rationale":"The audience of a token is a tenant.","evaluate":{"method":"property"},"ref":"TOK-006","area":"03-identity","section":"Verify and revoke","lifecycle":"active","boundary":"b-6","boundaryDetail":"`access token`","traces":["g-20"],"milestone":4,"inSection":"sec-tokens-3"},
    {"id":"tok-007","kind":"requirement","statement":"Revoking a grant SHALL cause tokens issued from it to be refused once the token lifetime has passed.","rationale":"With the lifetime budget this bounds how long a cut-off takes.","evaluate":{"method":"scenario"},"ref":"TOK-007","area":"03-identity","section":"Verify and revoke","lifecycle":"active","boundary":"b-6","boundaryDetail":"`grant`","traces":["g-28"],"milestone":4,"inSection":"sec-tokens-3"},
    {"id":"tok-008","kind":"requirement","statement":"Rotation of a signing key SHALL leave tokens signed by the previous key verifiable until they expire.","rationale":"Rotation is routine and breaks nobody.","evaluate":{"method":"scenario"},"ref":"TOK-008","area":"03-identity","section":"Verify and revoke","lifecycle":"active","boundary":"b-6","boundaryDetail":"`GET /keys`","traces":["g-10"],"milestone":4,"inSection":"sec-tokens-3"},
    {"id":"tok-009","kind":"requirement","statement":"Token introspection SHALL report the scopes, the subject and the expiry of a token to a caller permitted to ask.","rationale":"An agent can find out what its own token allows.","evaluate":{"method":"scenario"},"ref":"TOK-009","area":"03-identity","section":"Verify and revoke","lifecycle":"active","boundary":"b-6","boundaryDetail":"`POST /introspect`","traces":["g-24"],"milestone":4,"inSection":"sec-tokens-3"},
    {"id":"sch-001","kind":"requirement","statement":"A job scheduled for a time SHALL be offered to a worker no earlier than that time.","rationale":"The due time is a promise in one direction.","evaluate":{"method":"scenario"},"ref":"SCH-001","area":"04-automation","section":"Due work","lifecycle":"active","boundary":"b-7","boundaryDetail":"`job`","traces":["g-13"],"milestone":5,"inSection":"sec-scheduling-2"},
    {"id":"sch-002","kind":"requirement","statement":"A due job SHALL start within 5 seconds of its due time at the 99th percentile.","rationale":"The other direction, as a measured bound.","evaluate":{"method":"budget"},"ref":"SCH-002","area":"04-automation","section":"Due work","lifecycle":"active","boundary":"b-7","boundaryDetail":"`job`","traces":["g-13"],"milestone":5,"inSection":"sec-scheduling-2"},
    {"id":"sch-003","kind":"requirement","statement":"A recurring schedule SHALL create its next job in the transaction that completes the current one.","rationale":"A crash between the two cannot lose the recurrence.","evaluate":{"method":"scenario"},"ref":"SCH-003","area":"04-automation","section":"Due work","lifecycle":"active","boundary":"b-7","boundaryDetail":"`schedule`","traces":["g-13"],"milestone":5,"inSection":"sec-scheduling-2"},
    {"id":"sch-004","kind":"requirement","statement":"A committed domain event SHALL create the jobs of the triggers subscribed to it in the transaction that commits the event.","rationale":"An event and its consequences are one fact.","evaluate":{"method":"scenario"},"ref":"SCH-004","area":"04-automation","section":"Due work","lifecycle":"active","boundary":"b-7","boundaryDetail":"`trigger`","traces":["g-13"],"milestone":5,"inSection":"sec-scheduling-2"},
    {"id":"sch-005","kind":"requirement","statement":"A paused schedule SHALL create no job.","rationale":"Pausing is the safe way to stop automation while looking at it.","evaluate":{"method":"scenario"},"ref":"SCH-005","area":"04-automation","section":"Due work","lifecycle":"active","boundary":"b-7","boundaryDetail":"`schedule`","traces":["g-13"],"milestone":5,"inSection":"sec-scheduling-2"},
    {"id":"sch-006","kind":"requirement","statement":"Cancelling a job SHALL prevent every later attempt of it.","rationale":"Cancel is final.","evaluate":{"method":"scenario"},"ref":"SCH-006","area":"04-automation","section":"Due work","lifecycle":"active","boundary":"b-7","boundaryDetail":"`job`","traces":["g-13"],"milestone":5,"inSection":"sec-scheduling-2"},
    {"id":"sch-007","kind":"requirement","statement":"The scheduler SHALL find due work without a query to the database of a tenant that has none.","rationale":"Thousands of idle tenants cost nothing.","evaluate":{"method":"scenario"},"ref":"SCH-007","area":"04-automation","section":"Finding work","lifecycle":"active","boundary":"b-16","boundaryDetail":"`wake index`","traces":["g-4","d-10"],"milestone":5,"inSection":"sec-scheduling-3"},
    {"id":"sch-008","kind":"requirement","statement":"A wake index entry SHALL hold a tenant identifier and a due time and no content of a job.","rationale":"The control database learns when, not what.","evaluate":{"method":"property"},"ref":"SCH-008","area":"04-automation","section":"Finding work","lifecycle":"active","boundary":"b-3","boundaryDetail":"`wake index`","traces":["k-2"],"milestone":5,"seam":2,"inSection":"sec-scheduling-3"},
    {"id":"sch-009","kind":"requirement","statement":"The queued work of one tenant SHALL leave the due jobs of other tenants within the start budget.","rationale":"Fairness between tenants is part of the schedule.","evaluate":{"method":"scenario"},"ref":"SCH-009","area":"04-automation","section":"Finding work","lifecycle":"active","boundary":"b-7","boundaryDetail":"`job`","traces":["g-4"],"milestone":5,"inSection":"sec-scheduling-3"},
    {"id":"sch-010","kind":"requirement","statement":"A job whose worker stops responding SHALL be offered to another worker after its lease expires.","rationale":"Modelled as the lease flow.","evaluate":{"method":"scenario"},"ref":"SCH-010","area":"04-automation","section":"Failure","lifecycle":"active","boundary":"b-7","boundaryDetail":"`lease`","traces":["g-14"],"milestone":5,"inSection":"sec-scheduling-4"},
    {"id":"sch-011","kind":"requirement","statement":"A result presented with a superseded lease token SHALL be refused.","rationale":"The stalled worker that wakes up cannot overwrite its replacement.","evaluate":{"method":"property"},"ref":"SCH-011","area":"04-automation","section":"Failure","lifecycle":"active","boundary":"b-7","boundaryDetail":"`fencing token`","traces":["k-17","d-11"],"milestone":5,"inSection":"sec-scheduling-4"},
    {"id":"sch-012","kind":"requirement","statement":"A job SHALL end in exactly one recorded outcome.","rationale":"Completed, failed or cancelled: one of them, once.","evaluate":{"method":"property"},"ref":"SCH-012","area":"04-automation","section":"Failure","lifecycle":"active","boundary":"b-7","boundaryDetail":"`job`","traces":["g-14"],"milestone":5,"inSection":"sec-scheduling-4"},
    {"id":"sch-013","kind":"requirement","statement":"A failed attempt SHALL be retried after a delay that grows with the number of attempts.","rationale":"A struggling dependency is given room.","evaluate":{"method":"scenario"},"ref":"SCH-013","area":"04-automation","section":"Failure","lifecycle":"active","boundary":"b-7","boundaryDetail":"`job`","traces":["g-14"],"milestone":5,"inSection":"sec-scheduling-4"},
    {"id":"sch-014","kind":"requirement","statement":"A job that exhausts its attempts SHALL be recorded as failed with the error of each attempt.","rationale":"Dead work is visible and explained, not silently dropped.","evaluate":{"method":"scenario"},"ref":"SCH-014","area":"04-automation","section":"Failure","lifecycle":"active","boundary":"b-7","boundaryDetail":"`job`","traces":["g-14","g-27"],"milestone":5,"inSection":"sec-scheduling-4"},
    {"id":"sch-015","kind":"requirement","statement":"An effect that carries an idempotency key SHALL be applied once however many times its job is attempted.","rationale":"At least once in, exactly once out.","evaluate":{"method":"property"},"ref":"SCH-015","area":"04-automation","section":"Failure","lifecycle":"active","boundary":"b-7","boundaryDetail":"`idempotency key`","traces":["g-15","d-12"],"milestone":5,"inSection":"sec-scheduling-4"},
    {"id":"sch-016","kind":"requirement","statement":"Two simulations of the scheduler with one seed SHALL produce equal traces.","rationale":"Scheduling decisions are kernel decisions, so they are simulable like the rest.","evaluate":{"method":"property"},"ref":"SCH-016","area":"04-automation","section":"Failure","lifecycle":"active","boundary":"b-20","boundaryDetail":"`strata_simulation::engine::run`","traces":["k-11","g-42"],"milestone":5,"inSection":"sec-scheduling-4"},
    {"id":"wfl-001","kind":"requirement","statement":"A workflow definition SHALL be stored as tenant metadata under the schema version.","rationale":"Workflows are versioned, migrated and inspected like the rest of the schema.","evaluate":{"method":"scenario"},"ref":"WFL-001","area":"04-automation","section":"Definition and activation","lifecycle":"active","boundary":"b-8","boundaryDetail":"`workflow definition`","traces":["g-16","g-31"],"milestone":5,"inSection":"sec-workflows-2"},
    {"id":"wfl-002","kind":"requirement","statement":"Activation of a workflow definition SHALL be refused until a projection of it has run.","rationale":"Automation is tried on history before it runs on the present.","evaluate":{"method":"scenario"},"ref":"WFL-002","area":"04-automation","section":"Definition and activation","lifecycle":"active","boundary":"b-20","boundaryDetail":"`projection`","traces":["g-16"],"milestone":5,"inSection":"sec-workflows-2"},
    {"id":"wfl-003","kind":"requirement","statement":"Each workflow step SHALL be decided by the kernel from the recorded state of the run.","rationale":"A run can be replayed, and a step cannot depend on anything unrecorded.","evaluate":{"method":"property"},"ref":"WFL-003","area":"04-automation","section":"Definition and activation","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["k-9","k-11","d-13"],"milestone":5,"inSection":"sec-workflows-2"},
    {"id":"wfl-004","kind":"requirement","statement":"A workflow run SHALL continue from its last recorded step after a process restart.","rationale":"The run is a record, not a thread.","evaluate":{"method":"scenario"},"ref":"WFL-004","area":"04-automation","section":"Definition and activation","lifecycle":"active","boundary":"b-8","boundaryDetail":"`workflow run`","traces":["g-14"],"milestone":5,"inSection":"sec-workflows-2"},
    {"id":"wfl-005","kind":"requirement","statement":"A failed step SHALL run the declared compensation steps of the completed steps in reverse order.","rationale":"A workflow that cannot finish undoes what it can.","evaluate":{"method":"scenario"},"ref":"WFL-005","area":"04-automation","section":"Definition and activation","lifecycle":"active","boundary":"b-8","boundaryDetail":"`compensation`","traces":["g-14"],"milestone":5,"inSection":"sec-workflows-2"},
    {"id":"wfl-006","kind":"requirement","statement":"A workflow waiting for approval SHALL continue only after a principal permitted by its policy approves.","rationale":"People stay in the loop where the tenant puts them.","evaluate":{"method":"scenario"},"ref":"WFL-006","area":"04-automation","section":"Definition and activation","lifecycle":"active","boundary":"b-8","boundaryDetail":"`approval step`","traces":["g-26"],"milestone":5,"inSection":"sec-workflows-2"},
    {"id":"wfl-007","kind":"requirement","statement":"A step that calls an external address SHALL be carried out by the connector runner after the transaction of the step commits.","rationale":"No call is made for a step that did not happen.","evaluate":{"method":"scenario"},"ref":"WFL-007","area":"04-automation","section":"External effects","lifecycle":"active","boundary":"b-8","boundaryDetail":"`call step`","traces":["k-9"],"milestone":5,"inSection":"sec-workflows-3"},
    {"id":"wfl-008","kind":"requirement","statement":"An external call SHALL be refused when its address resolves to a private, link-local or loopback network.","rationale":"Tenant automation is not a way into the platform's network.","evaluate":{"method":"scenario"},"ref":"WFL-008","area":"04-automation","section":"External effects","lifecycle":"active","boundary":"b-8","boundaryDetail":"`call step`","traces":["g-47"],"milestone":5,"inSection":"sec-workflows-3"},
    {"id":"wfl-009","kind":"requirement","statement":"A connector secret SHALL be readable only by the connector runner at the time of the call.","rationale":"Secrets are write-only to everyone else, agents included.","evaluate":{"method":"property"},"ref":"WFL-009","area":"04-automation","section":"External effects","lifecycle":"active","boundary":"b-17","boundaryDetail":"`connector secret`","traces":["g-40","g-47"],"milestone":5,"inSection":"sec-workflows-3"},
    {"id":"wfl-010","kind":"requirement","statement":"A webhook delivery SHALL carry a signature over its body made with the secret of its subscription.","rationale":"The receiver can tell the platform sent it.","evaluate":{"method":"scenario"},"ref":"WFL-010","area":"04-automation","section":"External effects","lifecycle":"active","boundary":"b-8","boundaryDetail":"`webhook`","traces":["g-13"],"milestone":5,"inSection":"sec-workflows-3"},
    {"id":"wfl-011","kind":"requirement","statement":"A content record with a publication time SHALL be published by a job at that time.","rationale":"Scheduled publication is the first workflow every publication needs.","evaluate":{"method":"scenario"},"ref":"WFL-011","area":"04-automation","section":"External effects","lifecycle":"active","boundary":"b-7","boundaryDetail":"`publication time`","traces":["g-17"],"milestone":5,"inSection":"sec-workflows-3"},
    {"id":"cpy-001","kind":"requirement","statement":"Each stored copy class SHALL have the owner, key, freshness bound and erasure point that the copy class table states.","rationale":"The table is the design. The data model in this specification is checked against the same rules.","evaluate":{"method":"conformance"},"ref":"CPY-001","area":"05-delivery","section":"Classes and keys","lifecycle":"active","boundary":"b-15","boundaryDetail":"`copy class`","traces":["k-8"],"milestone":6,"cases":["cases-copy-classes"],"inSection":"sec-copies-2"},
    {"id":"cpy-002","kind":"requirement","statement":"The key of a stored view copy SHALL contain the tenant, the view, its arguments, the audience class, the schema version and the revision of each object type it depends on.","rationale":"A change produces a new key, so a stale entry cannot be read by mistake.","evaluate":{"method":"property"},"ref":"CPY-002","area":"05-delivery","section":"Classes and keys","lifecycle":"active","boundary":"b-15","boundaryDetail":"`copy key`","traces":["d-14","g-19"],"milestone":6,"inSection":"sec-copies-2"},
    {"id":"cpy-003","kind":"requirement","statement":"A stored copy key SHALL begin with the tenant identifier.","rationale":"No two tenants can ever address the same entry.","evaluate":{"method":"property"},"ref":"CPY-003","area":"05-delivery","section":"Classes and keys","lifecycle":"active","boundary":"b-15","boundaryDetail":"`copy key`","traces":["g-20"],"milestone":6,"inSection":"sec-copies-2"},
    {"id":"cpy-004","kind":"requirement","statement":"Every read result SHALL name the object types and records it depends on.","rationale":"Invalidation is exact because the kernel says what an answer was made from.","evaluate":{"method":"property"},"ref":"CPY-004","area":"05-delivery","section":"Classes and keys","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::read`","traces":["d-14","g-19"],"milestone":6,"seam":2,"inSection":"sec-copies-2"},
    {"id":"cpy-005","kind":"requirement","statement":"The audience class of a principal for a read SHALL be derived by the kernel from the policies of the tenant.","rationale":"Who may share a copy is an authorisation question and has one answer.","evaluate":{"method":"property"},"ref":"CPY-005","area":"05-delivery","section":"Classes and keys","lifecycle":"active","boundary":"b-1","boundaryDetail":"`audience class`","traces":["d-15","k-13"],"milestone":6,"seam":3,"inSection":"sec-copies-2"},
    {"id":"cpy-006","kind":"requirement","statement":"A view copy stored for one audience class SHALL be served only to principals of that class.","rationale":"A draft stored for editors is not an answer for readers.","evaluate":{"method":"property"},"ref":"CPY-006","area":"05-delivery","section":"Isolation","lifecycle":"active","boundary":"b-15","boundaryDetail":"`audience class`","traces":["g-20"],"milestone":6,"inSection":"sec-copies-3"},
    {"id":"cpy-007","kind":"requirement","statement":"A shared copy SHALL contain no personal field and no field that depends on the requesting principal.","rationale":"Also evaluated by Exegra on the data model of this specification.","evaluate":{"method":"property"},"ref":"CPY-007","area":"05-delivery","section":"Isolation","lifecycle":"active","boundary":"b-15","boundaryDetail":"`shared copy`","traces":["k-7"],"milestone":6,"inSection":"sec-copies-3"},
    {"id":"cpy-008","kind":"requirement","statement":"A committed change SHALL supersede every stored copy that depends on a record it changed.","rationale":"Version keys do this for view copies, and tags do it where a key cannot.","evaluate":{"method":"scenario"},"ref":"CPY-008","area":"05-delivery","section":"Freshness and failure","lifecycle":"active","boundary":"b-15","boundaryDetail":"`remove by tag`","traces":["g-19"],"milestone":6,"inSection":"sec-copies-4"},
    {"id":"cpy-009","kind":"requirement","statement":"A committed change SHALL be visible through the delivery interface within 2 seconds at the 99th percentile.","rationale":"The freshness bound of the shared copy tier.","evaluate":{"method":"budget"},"ref":"CPY-009","area":"05-delivery","section":"Freshness and failure","lifecycle":"active","boundary":"b-9","boundaryDetail":"`delivery interface`","traces":["g-19"],"milestone":6,"inSection":"sec-copies-4"},
    {"id":"cpy-010","kind":"requirement","statement":"At least 95 percent of delivery requests for published content SHALL be answered without a query to the tenant database.","rationale":"The point of the design, measured.","evaluate":{"method":"budget"},"ref":"CPY-010","area":"05-delivery","section":"Freshness and failure","lifecycle":"active","boundary":"b-9","boundaryDetail":"`delivery interface`","traces":["g-18"],"milestone":6,"inSection":"sec-copies-4"},
    {"id":"cpy-011","kind":"requirement","statement":"An outage of the copy store SHALL be answered by reads from the tenant database without an error to the reader.","rationale":"A copy store is an optimisation and its loss is a slowdown.","evaluate":{"method":"scenario"},"ref":"CPY-011","area":"05-delivery","section":"Freshness and failure","lifecycle":"active","boundary":"b-15","boundaryDetail":"`copy store`","traces":["g-18"],"milestone":6,"inSection":"sec-copies-4"},
    {"id":"cpy-012","kind":"requirement","statement":"Simultaneous requests for one missing copy SHALL cause one computation of it.","rationale":"A popular page expiring does not become a stampede on one tenant database.","evaluate":{"method":"scenario"},"ref":"CPY-012","area":"05-delivery","section":"Freshness and failure","lifecycle":"active","boundary":"b-15","boundaryDetail":"`copy store`","traces":["g-4"],"milestone":6,"inSection":"sec-copies-4"},
    {"id":"cpy-013","kind":"requirement","statement":"Deleting a record SHALL remove every stored copy that holds a field of it within the erasure bound of its class.","rationale":"Erasure reaches copies by design.","evaluate":{"method":"scenario"},"ref":"CPY-013","area":"05-delivery","section":"Freshness and failure","lifecycle":"active","boundary":"b-15","boundaryDetail":"`remove by tag`","traces":["g-22"],"milestone":6,"inSection":"sec-copies-4"},
    {"id":"cpy-014","kind":"requirement","statement":"A compiled schema SHALL be reused across requests while the schema version of the tenant is unchanged.","rationale":"The cheapest copy is the one keyed by a version that rarely moves.","evaluate":{"method":"scenario"},"ref":"CPY-014","area":"05-delivery","section":"Freshness and failure","lifecycle":"active","boundary":"b-1","boundaryDetail":"`schema version`","traces":["g-18","d-17"],"milestone":6,"inSection":"sec-copies-4"},
    {"id":"edg-001","kind":"requirement","statement":"The edge key of a response SHALL include the host name of its request.","rationale":"Two tenants with the same path are two entries.","evaluate":{"method":"property"},"ref":"EDG-001","area":"05-delivery","section":"Storability","lifecycle":"active","boundary":"b-10","boundaryDetail":"`Host`","traces":["g-20","d-16"],"milestone":6,"inSection":"sec-edge-2"},
    {"id":"edg-002","kind":"requirement","statement":"A response that depends on the requesting principal SHALL be marked as not storable by shared intermediaries.","rationale":"Only what is the same for everyone is kept at the edge.","evaluate":{"method":"property"},"ref":"EDG-002","area":"05-delivery","section":"Storability","lifecycle":"active","boundary":"b-10","boundaryDetail":"`Cache-Control`","traces":["k-7"],"milestone":6,"inSection":"sec-edge-2"},
    {"id":"edg-003","kind":"requirement","statement":"A published page SHALL carry surrogate keys naming the tenant and each record it was rendered from.","rationale":"The page says what would make it wrong.","evaluate":{"method":"scenario"},"ref":"EDG-003","area":"05-delivery","section":"Storability","lifecycle":"active","boundary":"b-10","boundaryDetail":"`Surrogate-Key`","traces":["g-19","d-16"],"milestone":6,"inSection":"sec-edge-2"},
    {"id":"edg-004","kind":"requirement","statement":"Static assets SHALL be served at addresses derived from their content.","rationale":"An asset can be kept at the edge indefinitely because its address changes when it does.","evaluate":{"method":"property"},"ref":"EDG-004","area":"05-delivery","section":"Storability","lifecycle":"active","boundary":"b-10","boundaryDetail":"`asset address`","traces":["g-18"],"milestone":6,"inSection":"sec-edge-2"},
    {"id":"edg-005","kind":"requirement","statement":"A committed change SHALL purge the surrogate keys of the records it changed.","rationale":"Driven from the outbox, so a purge follows a commit and nothing else.","evaluate":{"method":"scenario"},"ref":"EDG-005","area":"05-delivery","section":"Purge","lifecycle":"active","boundary":"b-10","boundaryDetail":"`purge`","traces":["g-19"],"milestone":6,"inSection":"sec-edge-3"},
    {"id":"edg-006","kind":"requirement","statement":"An edge copy older than its lifetime SHALL be revalidated with the origin before it is served.","rationale":"Modelled as the edge copy flow: the purge is the quick path and the lifetime is the backstop when a purge is lost.","evaluate":{"method":"scenario"},"ref":"EDG-006","area":"05-delivery","section":"Purge","lifecycle":"active","boundary":"b-10","boundaryDetail":"`s-maxage`","traces":["g-19"],"milestone":6,"inSection":"sec-edge-3"},
    {"id":"edg-007","kind":"requirement","statement":"A purge SHALL take effect at the edge within 5 seconds at the 99th percentile.","rationale":"The freshness bound of the edge tier.","evaluate":{"method":"budget"},"ref":"EDG-007","area":"05-delivery","section":"Purge","lifecycle":"active","boundary":"b-10","boundaryDetail":"`purge`","traces":["g-19"],"milestone":6,"inSection":"sec-edge-3"},
    {"id":"edg-008","kind":"requirement","statement":"Removing a domain binding SHALL purge every edge copy stored under that host name.","rationale":"A domain that leaves takes its copies with it.","evaluate":{"method":"scenario"},"ref":"EDG-008","area":"05-delivery","section":"Purge","lifecycle":"active","boundary":"b-10","boundaryDetail":"`purge`","traces":["g-22"],"milestone":6,"inSection":"sec-edge-3"},
    {"id":"edg-009","kind":"requirement","statement":"A tenant SHALL be able to serve its site from a domain name after proving control of that name.","rationale":"Proof first, so one tenant cannot claim another's name.","evaluate":{"method":"scenario"},"ref":"EDG-009","area":"05-delivery","section":"Domains and limits","lifecycle":"active","boundary":"b-3","boundaryDetail":"`domain binding`","traces":["g-21"],"milestone":6,"inSection":"sec-edge-4"},
    {"id":"edg-010","kind":"requirement","statement":"The certificate of a tenant domain SHALL be renewed before it expires.","rationale":"Certificates are the platform's job.","evaluate":{"method":"scenario"},"ref":"EDG-010","area":"05-delivery","section":"Domains and limits","lifecycle":"active","boundary":"b-3","boundaryDetail":"`certificate`","traces":["g-21"],"milestone":6,"inSection":"sec-edge-4"},
    {"id":"edg-011","kind":"requirement","statement":"A host name bound to no tenant SHALL receive a not-found response without contact with a tenant database.","rationale":"Unknown hosts are answered from the directory copy alone.","evaluate":{"method":"scenario"},"ref":"EDG-011","area":"05-delivery","section":"Domains and limits","lifecycle":"active","boundary":"b-9","boundaryDetail":"`Host`","traces":["g-20"],"milestone":6,"inSection":"sec-edge-4"},
    {"id":"edg-012","kind":"requirement","statement":"A private media file SHALL be delivered only through an address signed for the requesting principal with an expiry.","rationale":"Private files use the edge without becoming public.","evaluate":{"method":"scenario"},"ref":"EDG-012","area":"05-delivery","section":"Domains and limits","lifecycle":"active","boundary":"b-10","boundaryDetail":"`signed address`","traces":["g-33","g-20"],"milestone":6,"inSection":"sec-edge-4"},
    {"id":"edg-013","kind":"requirement","statement":"A request rate above the limit of a tenant SHALL receive a throttling response at the gateway.","rationale":"Limits are applied before work is done.","evaluate":{"method":"scenario"},"ref":"EDG-013","area":"05-delivery","section":"Domains and limits","lifecycle":"active","boundary":"b-9","boundaryDetail":"`429`","traces":["g-4"],"milestone":6,"inSection":"sec-edge-4"},
    {"id":"agt-001","kind":"requirement","statement":"Every operation available through the authoring application SHALL be listed in the operation catalogue with its input schema.","rationale":"There is no capability reachable only through a screen.","evaluate":{"method":"property"},"ref":"AGT-001","area":"06-agents","section":"Discover","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /operations`","traces":["g-23","d-18"],"milestone":7,"inSection":"sec-agents-2"},
    {"id":"agt-002","kind":"requirement","statement":"The operation catalogue SHALL mark for the requesting principal each operation that its policies permit it to attempt.","rationale":"An agent plans with what it can do, not with everything that exists.","evaluate":{"method":"scenario"},"ref":"AGT-002","area":"06-agents","section":"Discover","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /operations`","traces":["g-24"],"milestone":7,"inSection":"sec-agents-2"},
    {"id":"agt-003","kind":"requirement","statement":"The operation catalogue of a tenant SHALL reflect a change of its schema version without a deployment.","rationale":"Operations over tenant objects come from tenant metadata.","evaluate":{"method":"scenario"},"ref":"AGT-003","area":"06-agents","section":"Discover","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /operations`","traces":["g-23","g-31"],"milestone":7,"inSection":"sec-agents-2"},
    {"id":"agt-004","kind":"requirement","statement":"The agent gateway SHALL expose the operation catalogue through the Model Context Protocol.","rationale":"The standard way for agents to find and call tools.","evaluate":{"method":"scenario"},"ref":"AGT-004","area":"06-agents","section":"Discover","lifecycle":"active","boundary":"b-11","boundaryDetail":"`Model Context Protocol`","traces":["g-23","k-14"],"milestone":7,"inSection":"sec-agents-2"},
    {"id":"agt-005","kind":"requirement","statement":"The catalogue entry of an operation SHALL name the requirements of this specification that it implements.","rationale":"An agent can ask what an operation is supposed to guarantee.","evaluate":{"method":"scenario"},"ref":"AGT-005","area":"06-agents","section":"Discover","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /operations/{name}`","traces":["g-41"],"milestone":7,"inSection":"sec-agents-2"},
    {"id":"agt-006","kind":"requirement","statement":"The platform SHALL publish its component topology, configuration and health in machine-readable form.","rationale":"Self-description is what lets an agent diagnose instead of guess.","evaluate":{"method":"scenario"},"ref":"AGT-006","area":"06-agents","section":"Discover","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /platform`","traces":["g-27"],"milestone":7,"inSection":"sec-agents-2"},
    {"id":"agt-007","kind":"requirement","statement":"The agent gateway SHALL deliver to a subscribed agent the domain events that the policies of its principal permit it to read.","rationale":"Watching is the other half of operating.","evaluate":{"method":"scenario"},"ref":"AGT-007","area":"06-agents","section":"Discover","lifecycle":"active","boundary":"b-11","boundaryDetail":"`event stream`","traces":["g-23"],"milestone":7,"inSection":"sec-agents-2"},
    {"id":"agt-008","kind":"requirement","statement":"An operation invoked as a dry run SHALL return the state changes it would make without committing them.","rationale":"The kernel already separates deciding from committing.","evaluate":{"method":"scenario"},"ref":"AGT-008","area":"06-agents","section":"Try and explain","lifecycle":"active","boundary":"b-11","boundaryDetail":"`dry run`","traces":["g-24"],"milestone":7,"seam":2,"inSection":"sec-agents-3"},
    {"id":"agt-009","kind":"requirement","statement":"A rejected operation SHALL return the checks that failed in machine-readable form.","rationale":"The same evidence a form shows a person.","evaluate":{"method":"scenario"},"ref":"AGT-009","area":"06-agents","section":"Try and explain","lifecycle":"active","boundary":"b-11","boundaryDetail":"`error`","traces":["g-24"],"milestone":7,"inSection":"sec-agents-3"},
    {"id":"agt-010","kind":"requirement","statement":"The result of an applied change SHALL name an inverse operation or state that none exists.","rationale":"Reversibility is declared per operation.","evaluate":{"method":"scenario"},"ref":"AGT-010","area":"06-agents","section":"Try and explain","lifecycle":"active","boundary":"b-11","boundaryDetail":"`inverse`","traces":["g-25"],"milestone":7,"inSection":"sec-agents-3"},
    {"id":"agt-011","kind":"requirement","statement":"A change classed as risky by tenant policy SHALL be applied only from an approved proposal.","rationale":"Modelled as the proposal flow, with an unapproved apply as its negative.","evaluate":{"method":"scenario"},"ref":"AGT-011","area":"06-agents","section":"Propose and approve","lifecycle":"active","boundary":"b-11","boundaryDetail":"`proposal`","traces":["g-26","d-19"],"milestone":7,"inSection":"sec-agents-4"},
    {"id":"agt-012","kind":"requirement","statement":"A proposal SHALL carry the projection of its change against the recorded history of the tenant.","rationale":"The approver sees consequences, not intentions.","evaluate":{"method":"scenario"},"ref":"AGT-012","area":"06-agents","section":"Propose and approve","lifecycle":"active","boundary":"b-20","boundaryDetail":"`proposal`","traces":["g-26","g-44"],"milestone":7,"inSection":"sec-agents-4"},
    {"id":"agt-013","kind":"requirement","statement":"An approved proposal SHALL be refused when the revision of the tenant differs from the revision it was projected against.","rationale":"An approval is for one state of the world.","evaluate":{"method":"property"},"ref":"AGT-013","area":"06-agents","section":"Propose and approve","lifecycle":"active","boundary":"b-11","boundaryDetail":"`proposal`","traces":["g-26"],"milestone":7,"inSection":"sec-agents-4"},
    {"id":"agt-014","kind":"requirement","statement":"An operation performed by an agent SHALL be authorised by the same policies as that operation performed by a person.","rationale":"There is one authorisation path.","evaluate":{"method":"property"},"ref":"AGT-014","area":"06-agents","section":"Authorise, attribute and limit","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["k-13"],"milestone":7,"inSection":"sec-agents-5"},
    {"id":"agt-015","kind":"requirement","statement":"Every operation performed by an agent SHALL be recorded with the agent, the person it acted for and the correlation identifier.","rationale":"Who, for whom, and which request.","evaluate":{"method":"property"},"ref":"AGT-015","area":"06-agents","section":"Authorise, attribute and limit","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit entry`","traces":["g-25"],"milestone":7,"inSection":"sec-agents-5"},
    {"id":"agt-016","kind":"requirement","statement":"The requests of a disabled agent SHALL be refused by the agent gateway.","rationale":"The kill switch does not wait for a token to expire.","evaluate":{"method":"scenario"},"ref":"AGT-016","area":"06-agents","section":"Authorise, attribute and limit","lifecycle":"active","boundary":"b-11","boundaryDetail":"`agent state`","traces":["g-28"],"milestone":7,"inSection":"sec-agents-5"},
    {"id":"agt-017","kind":"requirement","statement":"An agent that exceeds its operation budget SHALL be refused until the budget window ends.","rationale":"A runaway loop is bounded by volume.","evaluate":{"method":"scenario"},"ref":"AGT-017","area":"06-agents","section":"Authorise, attribute and limit","lifecycle":"active","boundary":"b-11","boundaryDetail":"`operation budget`","traces":["g-28"],"milestone":7,"inSection":"sec-agents-5"},
    {"id":"obs-001","kind":"requirement","statement":"Every log line, span and audit entry produced for a request SHALL carry the correlation identifier of that request.","rationale":"One search finds the whole story.","evaluate":{"method":"property"},"ref":"OBS-001","area":"06-agents","section":"Telemetry","lifecycle":"active","boundary":"b-12","boundaryDetail":"`correlation identifier`","traces":["g-29"],"milestone":7,"seam":1,"inSection":"sec-observability-2"},
    {"id":"obs-002","kind":"requirement","statement":"Each component SHALL export traces, metrics and logs through the OpenTelemetry protocol.","rationale":"One collector, any backend.","evaluate":{"method":"scenario"},"ref":"OBS-002","area":"06-agents","section":"Telemetry","lifecycle":"active","boundary":"b-12","boundaryDetail":"`OpenTelemetry protocol`","traces":["k-14","g-27"],"milestone":7,"seam":2,"inSection":"sec-observability-2"},
    {"id":"obs-003","kind":"requirement","statement":"Telemetry SHALL carry the tenant identifier and no content of a tenant record.","rationale":"Operational data can be shared with operators and agents that may not read tenant data.","evaluate":{"method":"property"},"ref":"OBS-003","area":"06-agents","section":"Telemetry","lifecycle":"active","boundary":"b-12","boundaryDetail":"`telemetry`","traces":["k-2","g-29"],"milestone":7,"inSection":"sec-observability-2"},
    {"id":"obs-004","kind":"requirement","statement":"A component SHALL report readiness only while its dependencies answer.","rationale":"Health that can be trusted for routing and for diagnosis.","evaluate":{"method":"scenario"},"ref":"OBS-004","area":"06-agents","section":"Telemetry","lifecycle":"active","boundary":"b-12","boundaryDetail":"`readiness`","traces":["g-27"],"milestone":7,"seam":2,"inSection":"sec-observability-2"},
    {"id":"obs-005","kind":"requirement","statement":"A service level objective SHALL be stored as data with the query that measures it.","rationale":"Objectives are inspectable and changeable by the same means as everything else.","evaluate":{"method":"scenario"},"ref":"OBS-005","area":"06-agents","section":"Telemetry","lifecycle":"active","boundary":"b-12","boundaryDetail":"`service level objective`","traces":["g-27"],"milestone":7,"inSection":"sec-observability-2"},
    {"id":"obs-006","kind":"requirement","statement":"An audit entry SHALL contain the hash of the entry before it.","rationale":"The chain is what makes a removal visible.","evaluate":{"method":"property"},"ref":"OBS-006","area":"06-agents","section":"Audit","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit entry`","traces":["g-30","d-20"],"milestone":7,"seam":3,"inSection":"sec-observability-3"},
    {"id":"obs-007","kind":"requirement","statement":"Verification of an audit log from which an entry was removed SHALL report the break.","rationale":"The negative case of the chain.","evaluate":{"method":"scenario"},"ref":"OBS-007","area":"06-agents","section":"Audit","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit verification`","traces":["g-30"],"milestone":7,"inSection":"sec-observability-3"},
    {"id":"obs-008","kind":"requirement","statement":"The audit log of a tenant SHALL be exportable by the owner of that tenant.","rationale":"The record belongs to the tenant.","evaluate":{"method":"scenario"},"ref":"OBS-008","area":"06-agents","section":"Audit","lifecycle":"active","boundary":"b-12","boundaryDetail":"`GET /audit`","traces":["g-30","g-11"],"milestone":7,"inSection":"sec-observability-3"},
    {"id":"cms-001","kind":"requirement","statement":"The publication template SHALL install as tenant metadata through kernel intents.","rationale":"The blog is data, and installing it exercises the kernel like any other change.","evaluate":{"method":"scenario"},"ref":"CMS-001","area":"07-content","section":"Model","lifecycle":"active","boundary":"b-21","boundaryDetail":"`tenant bundle`","traces":["g-31"],"milestone":1,"inSection":"sec-content-2"},
    {"id":"cms-002","kind":"requirement","statement":"A delivery response SHALL be produced from named queries and view definitions held as tenant metadata.","rationale":"No page is written into platform code.","evaluate":{"method":"scenario"},"ref":"CMS-002","area":"07-content","section":"Model","lifecycle":"active","boundary":"b-9","boundaryDetail":"`view`","traces":["g-31"],"milestone":1,"inSection":"sec-content-2"},
    {"id":"cms-003","kind":"requirement","statement":"A draft SHALL be invisible to principals whose policies permit published content alone.","rationale":"Visibility is policy, evaluated by the kernel.","evaluate":{"method":"scenario"},"ref":"CMS-003","area":"07-content","section":"Model","lifecycle":"active","boundary":"b-9","boundaryDetail":"`view`","traces":["g-20"],"milestone":1,"inSection":"sec-content-2"},
    {"id":"cms-004","kind":"requirement","statement":"Tenant-authored rich text SHALL reach the browser as structured blocks with markup left as text.","rationale":"Nothing a tenant writes is parsed as HTML.","evaluate":{"method":"example"},"ref":"CMS-004","area":"07-content","section":"Model","lifecycle":"active","boundary":"b-9","boundaryDetail":"`strata_substrate::markdown::parse`","traces":["k-12"],"milestone":1,"inSection":"sec-content-2"},
    {"id":"cms-005","kind":"requirement","statement":"A theme value outside the token schema SHALL be rejected by the constraints of the tenant.","rationale":"A tenant selects tokens and supplies no style.","evaluate":{"method":"example"},"ref":"CMS-005","area":"07-content","section":"Model","lifecycle":"active","boundary":"b-21","boundaryDetail":"`theme tokens`","traces":["k-12"],"milestone":1,"inSection":"sec-content-2"},
    {"id":"cms-006","kind":"requirement","statement":"Each published version of a record SHALL be retrievable.","rationale":"History is kept, not reconstructed.","evaluate":{"method":"scenario"},"ref":"CMS-006","area":"07-content","section":"Versions, media and languages","lifecycle":"active","boundary":"b-9","boundaryDetail":"`GET /records/{id}/versions`","traces":["g-32"],"milestone":8,"inSection":"sec-content-3"},
    {"id":"cms-007","kind":"requirement","statement":"Restoring an earlier version SHALL create a new version with the earlier content.","rationale":"Restore moves forward, so history stays linear.","evaluate":{"method":"scenario"},"ref":"CMS-007","area":"07-content","section":"Versions, media and languages","lifecycle":"active","boundary":"b-9","boundaryDetail":"`POST /records/{id}/restore`","traces":["g-32"],"milestone":8,"inSection":"sec-content-3"},
    {"id":"cms-008","kind":"requirement","statement":"An uploaded file SHALL be stored in the file namespace of its tenant under its content hash.","rationale":"Files follow the tenant like records do.","evaluate":{"method":"scenario"},"ref":"CMS-008","area":"07-content","section":"Versions, media and languages","lifecycle":"active","boundary":"b-14","boundaryDetail":"`file store`","traces":["g-33"],"milestone":8,"seam":2,"inSection":"sec-content-3"},
    {"id":"cms-009","kind":"requirement","statement":"A rendition SHALL be produced from a stored file by a job.","rationale":"Slow work is scheduled work.","evaluate":{"method":"scenario"},"ref":"CMS-009","area":"07-content","section":"Versions, media and languages","lifecycle":"active","boundary":"b-7","boundaryDetail":"`rendition job`","traces":["g-33"],"milestone":8,"inSection":"sec-content-3"},
    {"id":"cms-010","kind":"requirement","statement":"A record requested in a language it lacks SHALL be answered in the fallback language of the tenant.","rationale":"A missing translation is not a missing page.","evaluate":{"method":"scenario"},"ref":"CMS-010","area":"07-content","section":"Versions, media and languages","lifecycle":"active","boundary":"b-9","boundaryDetail":"`Accept-Language`","traces":["g-34"],"milestone":8,"inSection":"sec-content-3"},
    {"id":"cms-011","kind":"requirement","statement":"A preview SHALL render unpublished content through the view definitions that delivery uses.","rationale":"What the author sees is what readers will get.","evaluate":{"method":"scenario"},"ref":"CMS-011","area":"07-content","section":"Versions, media and languages","lifecycle":"active","boundary":"b-9","boundaryDetail":"`preview`","traces":["g-35"],"milestone":8,"inSection":"sec-content-3"},
    {"id":"cms-012","kind":"requirement","statement":"The authoring application SHALL meet WCAG 2.2 level AA.","rationale":"Authors are users too.","evaluate":{"method":"example"},"ref":"CMS-012","area":"07-content","section":"Versions, media and languages","lifecycle":"active","boundary":"b-13","boundaryDetail":"`authoring application`","traces":["g-45"],"milestone":8,"inSection":"sec-content-3"},
    {"id":"dep-001","kind":"requirement","statement":"A single command SHALL start every platform component and its dependencies in containers on one machine.","rationale":"The whole system is something a developer or an agent can hold.","evaluate":{"method":"scenario"},"ref":"DEP-001","area":"08-platform","section":"Local stack and seams","lifecycle":"active","boundary":"b-19","boundaryDetail":"`compose file`","traces":["g-36","d-22"],"milestone":2,"inSection":"sec-platform-2"},
    {"id":"dep-002","kind":"requirement","statement":"The local stack SHALL start without credentials for a cloud provider.","rationale":"No account, no bill, no network.","evaluate":{"method":"scenario"},"ref":"DEP-002","area":"08-platform","section":"Local stack and seams","lifecycle":"active","boundary":"b-19","boundaryDetail":"`compose file`","traces":["k-10"],"milestone":2,"inSection":"sec-platform-2"},
    {"id":"dep-003","kind":"requirement","statement":"Each infrastructure seam SHALL have the contract, the local adapter and the cloud adapter that the seam table names.","rationale":"The table is the list of everything that may differ between local and cloud.","evaluate":{"method":"conformance"},"ref":"DEP-003","area":"08-platform","section":"Local stack and seams","lifecycle":"active","boundary":"b-19","boundaryDetail":"`seam`","traces":["g-38","d-24"],"milestone":2,"cases":["cases-seams"],"inSection":"sec-platform-2"},
    {"id":"dep-004","kind":"requirement","statement":"Each adapter of a seam SHALL pass the conformance suite of that seam.","rationale":"An adapter is accepted by behaviour, as the store adapters already are.","evaluate":{"method":"scenario"},"ref":"DEP-004","area":"08-platform","section":"Local stack and seams","lifecycle":"active","boundary":"b-19","boundaryDetail":"`conformance suite`","traces":["g-38"],"milestone":2,"inSection":"sec-platform-2"},
    {"id":"dep-005","kind":"requirement","statement":"A request SHALL be answerable by every running instance of the component it is addressed to.","rationale":"Instances are interchangeable, so they can be added, removed and replaced.","evaluate":{"method":"scenario"},"ref":"DEP-005","area":"08-platform","section":"Local stack and seams","lifecycle":"active","boundary":"b-19","boundaryDetail":"`instance`","traces":["k-5"],"milestone":2,"inSection":"sec-platform-2"},
    {"id":"dep-006","kind":"requirement","statement":"A component SHALL read its configuration from its environment.","rationale":"The image is the same everywhere and only the environment differs.","evaluate":{"method":"scenario"},"ref":"DEP-006","area":"08-platform","section":"Local stack and seams","lifecycle":"active","boundary":"b-19","boundaryDetail":"`environment`","traces":["g-37"],"milestone":2,"inSection":"sec-platform-2"},
    {"id":"dep-007","kind":"requirement","statement":"The cloud profile SHALL be created from version-controlled infrastructure definitions without a manual step.","rationale":"An environment is reproducible, and an agent can read what it is made of.","evaluate":{"method":"scenario"},"ref":"DEP-007","area":"08-platform","section":"Cloud profile","lifecycle":"active","boundary":"b-19","boundaryDetail":"`infrastructure modules`","traces":["g-37","d-23"],"milestone":9,"inSection":"sec-platform-3"},
    {"id":"dep-008","kind":"requirement","statement":"A component image SHALL run unchanged in the local stack and in the cloud profile.","rationale":"What was tested is what is deployed.","evaluate":{"method":"scenario"},"ref":"DEP-008","area":"08-platform","section":"Cloud profile","lifecycle":"active","boundary":"b-19","boundaryDetail":"`image`","traces":["g-37"],"milestone":9,"inSection":"sec-platform-3"},
    {"id":"dep-009","kind":"requirement","statement":"A deployment SHALL replace instances without refusing requests.","rationale":"Releases are routine.","evaluate":{"method":"scenario"},"ref":"DEP-009","area":"08-platform","section":"Cloud profile","lifecycle":"active","boundary":"b-19","boundaryDetail":"`deployment`","traces":["g-37"],"milestone":9,"inSection":"sec-platform-3"},
    {"id":"dep-010","kind":"requirement","statement":"After the loss of one zone the platform SHALL serve requests again within 15 minutes.","rationale":"The recovery time objective.","evaluate":{"method":"budget"},"ref":"DEP-010","area":"08-platform","section":"Cloud profile","lifecycle":"active","boundary":"b-19","boundaryDetail":"`zone loss`","traces":["g-39"],"milestone":9,"inSection":"sec-platform-3"},
    {"id":"dep-011","kind":"requirement","statement":"A restored tenant SHALL lose at most 5 minutes of committed changes.","rationale":"The recovery point objective.","evaluate":{"method":"budget"},"ref":"DEP-011","area":"08-platform","section":"Cloud profile","lifecycle":"active","boundary":"b-19","boundaryDetail":"`restore`","traces":["g-39"],"milestone":9,"inSection":"sec-platform-3"},
    {"id":"sec-001","kind":"requirement","statement":"The stored data of each tenant SHALL be encrypted under a key held for that tenant alone.","rationale":"One tenant's key opens nothing else.","evaluate":{"method":"property"},"ref":"SEC-001","area":"08-platform","section":"Keys and credentials","lifecycle":"active","boundary":"b-17","boundaryDetail":"`data key`","traces":["g-40","d-25"],"milestone":3,"seam":2,"inSection":"sec-platform-4"},
    {"id":"sec-002","kind":"requirement","statement":"Destroying the key of a tenant SHALL make the stored data and the backups of that tenant unreadable.","rationale":"Deletion that reaches backups.","evaluate":{"method":"scenario"},"ref":"SEC-002","area":"08-platform","section":"Keys and credentials","lifecycle":"active","boundary":"b-17","boundaryDetail":"`destroy key`","traces":["g-40"],"milestone":3,"inSection":"sec-platform-4"},
    {"id":"sec-003","kind":"requirement","statement":"A secret SHALL be stored only in encrypted form, with its wrapping key held by the key service.","rationale":"The database alone is not enough to read a secret.","evaluate":{"method":"scenario"},"ref":"SEC-003","area":"08-platform","section":"Keys and credentials","lifecycle":"active","boundary":"b-17","boundaryDetail":"`wrap`","traces":["g-40"],"milestone":3,"inSection":"sec-platform-4"},
    {"id":"sec-004","kind":"requirement","statement":"A call between platform components SHALL carry a credential issued to the calling component.","rationale":"Replaces the single shared service token of the prototype.","evaluate":{"method":"scenario"},"ref":"SEC-004","area":"08-platform","section":"Keys and credentials","lifecycle":"active","boundary":"b-6","boundaryDetail":"`component credential`","traces":["k-6","g-12"],"milestone":2,"inSection":"sec-platform-4"},
    {"id":"sec-005","kind":"requirement","statement":"A platform component SHALL reach a tenant database only through the store contract.","rationale":"Checked structurally by Exegra on the component model and by Concordance on the code.","evaluate":{"method":"property"},"ref":"SEC-005","area":"08-platform","section":"Keys and credentials","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["k-3"],"milestone":2,"inSection":"sec-platform-4"},
    {"id":"asr-001","kind":"requirement","statement":"The gate SHALL fail while a requirement of a started milestone has no proof with a recorded passing result.","rationale":"Done is something the tools say, not something a person says.","evaluate":{"method":"scenario"},"ref":"ASR-001","area":"08-platform","section":"Assurance","lifecycle":"active","boundary":"b-19","boundaryDetail":"`gate`","traces":["g-41","k-15","d-26"],"milestone":2,"inSection":"sec-platform-5"},
    {"id":"asr-002","kind":"requirement","statement":"Each behaviour claim that Exegra evaluates in this specification SHALL declare a run that violates it.","rationale":"A check that cannot fail shows nothing.","evaluate":{"method":"scenario"},"ref":"ASR-002","area":"08-platform","section":"Assurance","lifecycle":"active","boundary":"b-20","boundaryDetail":"`behaviour claim`","traces":["g-42"],"milestone":2,"inSection":"sec-platform-5"},
    {"id":"m-link-accepted-once","kind":"invariant","models":"idn-003","statement":"In the emailed link scenarios, one link yields at most one session.","evaluate":{"method":"state-invariant","scenarios":["link-used-twice","link-presented-late","link-presented-elsewhere"],"expr":"emailed-link-flow.sessions <= 1","negatives":[{"scenario":"link-used-twice","faults":["defect-link-replay"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-link-accepted-in-time","kind":"temporal","models":"idn-003","statement":"A link presented in the requesting browser within its lifetime yields a session.","evaluate":{"method":"eventually","scenarios":["link-used-twice"],"occurs":{"event":"ml-session-issued"},"negatives":[{"scenario":"link-used-twice","faults":["link-acceptance-disabled"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-late-link-refused","kind":"temporal","models":"idn-004","statement":"A link presented after its lifetime yields no session.","evaluate":{"method":"never","scenarios":["link-presented-late"],"occurs":{"event":"ml-session-issued"},"negatives":[{"scenario":"link-presented-late","faults":["defect-link-unchecked"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-foreign-browser-refused","kind":"temporal","models":"idn-005","statement":"A link presented in a browser that did not request it yields no session.","evaluate":{"method":"never","scenarios":["link-presented-elsewhere"],"occurs":{"event":"ml-session-issued"},"negatives":[{"scenario":"link-presented-elsewhere","faults":["defect-link-unchecked"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-forged-callback-refused","kind":"temporal","models":"fed-001","statement":"A callback whose state matches no pending request yields no session.","evaluate":{"method":"never","scenarios":["oidc-forged-callback"],"occurs":{"event":"oidc-session-issued"},"negatives":[{"scenario":"oidc-forged-callback","faults":["defect-oidc-state-unchecked"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-provider-signatures"]},
    {"id":"m-matching-callback-accepted","kind":"temporal","models":"fed-001","statement":"A callback that carries the pending state yields a session.","evaluate":{"method":"eventually","scenarios":["oidc-sign-in"],"occurs":{"event":"oidc-session-issued"},"negatives":[{"scenario":"oidc-sign-in","faults":["oidc-acceptance-disabled"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-provider-signatures"]},
    {"id":"m-revocation-bounded","kind":"invariant","models":"idn-013","statement":"The gateway never accepts a session 5 ticks or more after it was revoked, whether or not the revocation notice arrives.","evaluate":{"method":"state-invariant","scenarios":["revocation-heard","revocation-notice-lost"],"expr":"!gateway-session-flow.staleAccept","negatives":[{"scenario":"revocation-notice-lost","faults":["defect-gateway-no-recheck"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-clock-skew"]},
    {"id":"m-revoked-session-refused","kind":"temporal","models":"idn-013","statement":"When the revocation notice is lost, a request after the bound is still refused.","evaluate":{"method":"eventually","scenarios":["revocation-notice-lost"],"occurs":{"event":"sr-refused"},"negatives":[{"scenario":"revocation-notice-lost","faults":["defect-gateway-no-recheck"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-clock-skew"]},
    {"id":"m-result-carries-current-token","kind":"invariant","models":"sch-011","statement":"A recorded result carries the token of the current lease.","evaluate":{"method":"state-invariant","scenarios":["lease-takeover"],"expr":"job-lease-flow.completions > 0 => job-lease-flow.acceptedToken == job-lease-flow.token","negatives":[{"scenario":"lease-takeover","faults":["defect-result-token-unchecked"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-database-commit"]},
    {"id":"m-job-completes-after-takeover","kind":"temporal","models":"sch-010","statement":"A job whose first worker stalls is completed by its replacement.","evaluate":{"method":"eventually","scenarios":["lease-takeover"],"occurs":{"event":"job-completed"},"negatives":[{"scenario":"lease-takeover","faults":["completion-disabled"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-database-commit"]},
    {"id":"m-edge-staleness-bounded","kind":"invariant","models":"edg-006","statement":"The edge never serves a version 10 ticks or more after it was superseded, whether or not the purge arrives.","evaluate":{"method":"state-invariant","scenarios":["page-purged","page-purge-lost"],"expr":"!edge-copy-flow.staleServed","negatives":[{"scenario":"page-purge-lost","faults":["defect-edge-ignores-lifetime"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-active-means-ready","kind":"invariant","models":"ten-002","statement":"A tenant reported as active has its layout applied and its template installed.","evaluate":{"method":"state-invariant","scenarios":["tenant-provisioned","tenant-provisioning-fails"],"expr":"provisioning-flow.active => provisioning-flow.layout && provisioning-flow.template","negatives":[{"scenario":"tenant-provisioned","faults":["defect-early-activation"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-failed-provisioning-not-active","kind":"temporal","models":"ten-003","statement":"A provisioning run that fails never reports the tenant as active.","evaluate":{"method":"never","scenarios":["tenant-provisioning-fails"],"occurs":{"event":"pv-activated"},"negatives":[{"scenario":"tenant-provisioning-fails","faults":["defect-early-activation"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-applied-means-cleared","kind":"invariant","models":"agt-011","statement":"An applied change was projected, and was either classed as safe or approved.","evaluate":{"method":"state-invariant","scenarios":["safe-change-applied","risky-change-approved","risky-change-rejected"],"expr":"proposal-flow.applied => proposal-flow.projected && proposal-flow.cleared","negatives":[{"scenario":"risky-change-approved","faults":["defect-apply-unapproved"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-rejected-change-not-applied","kind":"temporal","models":"agt-011","statement":"A rejected change is never applied.","evaluate":{"method":"never","scenarios":["risky-change-rejected"],"occurs":{"event":"cp-applied"},"negatives":[{"scenario":"risky-change-rejected","faults":["defect-apply-rejected"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-commit-precedes-publication","kind":"temporal","models":"run-005","statement":"Every published event is preceded by the confirmation of its commit.","evaluate":{"method":"precedes","scenarios":["intent-committed"],"first":{"event":"rt-committed"},"then":{"event":"rt-published"},"negatives":[{"scenario":"intent-committed","faults":["defect-publish-before-commit"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-database-commit"]},
    {"id":"m-browser-reaches-data-through-gateway","kind":"structural","models":"sec-005","statement":"Every path from the web application to a tenant database passes through the gateway.","evaluate":{"method":"only-via","from":"web-application","to":"tenant-database","via":"gateway"},"assumptions":["a-model-abstraction"]},
    {"id":"m-agents-reach-data-through-agent-gateway","kind":"structural","models":"agt-014","statement":"Every path from an agent to a tenant database passes through the agent gateway.","evaluate":{"method":"only-via","from":"agent","to":"tenant-database","via":"agent-gateway"},"assumptions":["a-model-abstraction"]},
    {"id":"m-tenant-database-through-store-contract","kind":"structural","models":"sec-005","statement":"Every path from the runtime, the identity service, the scheduler, the workflow engine or the control plane to a tenant database passes through the store contract.","evaluate":{"method":"only-via","from":["runtime","identity-service","scheduler","workflow-engine","control-plane"],"to":"tenant-database","via":"store-contract"},"assumptions":["a-model-abstraction"]},
    {"id":"m-kernel-reaches-nothing","kind":"structural","models":"krn-012","statement":"The kernel has no path to any store, service or external component.","evaluate":{"method":"no-relationship","from":"kernel","to":{"all":true},"transitive":true},"assumptions":["a-model-abstraction"]},
    {"id":"m-control-database-private","kind":"structural","models":"ten-006","statement":"The control plane alone reaches the control database.","evaluate":{"method":"no-relationship","from":["gateway","runtime","identity-service","scheduler","workflow-engine","connector-runner","agent-gateway"],"to":"control-database","transitive":false},"assumptions":["a-model-abstraction"]},
    {"id":"m-dependencies-acyclic","kind":"structural","models":"krn-012","statement":"The depends-on relationships between components have no cycle.","evaluate":{"method":"acyclic","kinds":["depends-on"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-copies-designed","kind":"structural","models":"cpy-001","statement":"Every stored copy states a freshness bound, is reachable from its owner, and states an erasure point where it holds personal data or a principal.","evaluate":{"method":"data-model","rules":["freshness-bound","holder-reaches-owner","erasure-point"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-shared-copies-impersonal","kind":"structural","models":"cpy-007","statement":"No shared copy holds a personal field or a principal, and none depends on who is asking.","evaluate":{"method":"data-model","rules":["no-principal-in-shared"]},"assumptions":["a-model-abstraction"]},
    {"id":"arc-100","kind":"requirement","statement":"While the control plane cannot be reached, the gateway SHALL answer reads for a tenant from the directory entry it holds, stating the age of that entry, and refuse every state-changing request for that tenant.","rationale":"Without this, every request depends on the control plane, so an outage of the directory becomes an outage of every tenant.","evaluate":{"method":"scenario"},"ref":"ARC-100","area":"09-architecture","section":"Control plane and wake index","lifecycle":"active","boundary":"b-3","boundaryDetail":"`directory entry`","traces":["g-101","d-100"],"milestone":2,"inSection":"sec-arch-2"},
    {"id":"arc-101","kind":"requirement","statement":"The wake index SHALL be rebuildable from the tenant databases, so that losing it delays due work and loses none of it.","rationale":"The index is a convenience of the control plane. Due work lives in the tenant databases, so the index can be lost without losing a job.","evaluate":{"method":"scenario"},"ref":"ARC-101","area":"09-architecture","section":"Control plane and wake index","lifecycle":"active","boundary":"b-3","boundaryDetail":"`wake index`","traces":["g-14","g-102","d-10"],"milestone":5,"inSection":"sec-arch-2"},
    {"id":"arc-102","kind":"requirement","statement":"A domain event SHALL reach the notice queue as a reference that names its tenant and sequence number, with no content of the record it changed.","rationale":"The queue sits in the control zone. Record content stays in the tenant database, which subscribers read when they need it.","evaluate":{"method":"property"},"ref":"ARC-102","area":"09-architecture","section":"Notices and outbox","lifecycle":"active","boundary":"b-16","boundaryDetail":"`notice`","traces":["k-2","d-10"],"milestone":3,"inSection":"sec-arch-3"},
    {"id":"arc-103","kind":"requirement","statement":"The notice queue SHALL redeliver a notice to each subscriber until that subscriber acknowledges it, so that every notice reaches every subscriber it names.","rationale":"Delivery repeats until acknowledged, so a lost notice is a delay and not a loss. The revocation bound depends on this.","evaluate":{"method":"scenario"},"ref":"ARC-103","area":"09-architecture","section":"Notices and outbox","lifecycle":"active","boundary":"b-16","boundaryDetail":"`notice delivery`","traces":["d-12","g-19"],"milestone":3,"inSection":"sec-arch-3"},
    {"id":"arc-104","kind":"requirement","statement":"A subscriber that receives a domain event a second time SHALL make no further effect from it.","rationale":"Redelivery is what makes delivery reliable, so the subscriber is the one that makes each effect once.","evaluate":{"method":"property"},"ref":"ARC-104","area":"09-architecture","section":"Notices and outbox","lifecycle":"active","boundary":"b-16","boundaryDetail":"`notice subscriber`","traces":["d-12","g-15"],"milestone":3,"inSection":"sec-arch-3"},
    {"id":"arc-105","kind":"requirement","statement":"An event that a commit left unpublished SHALL reach its subscribers after the process that made the commit has stopped.","rationale":"Without this, a crash between the commit and the publication strands the event until someone next writes to the tenant.","evaluate":{"method":"scenario"},"ref":"ARC-105","area":"09-architecture","section":"Notices and outbox","lifecycle":"active","boundary":"b-7","boundaryDetail":"`outbox job`","traces":["g-14","d-102"],"milestone":5,"inSection":"sec-arch-3"},
    {"id":"arc-106","kind":"requirement","statement":"While two versions of the platform run together, a commit SHALL be written in a format that both versions read.","rationale":"A rolling deployment has an old process and a new process serving the same tenant database at once.","evaluate":{"method":"scenario"},"ref":"ARC-106","area":"09-architecture","section":"Change across versions","lifecycle":"active","boundary":"b-2","boundaryDetail":"`commit format`","traces":["g-104","g-5"],"milestone":9,"inSection":"sec-arch-4"},
    {"id":"arc-107","kind":"requirement","statement":"A layout change SHALL reach every tenant database before code that needs the new layout serves that tenant.","rationale":"Layouts change one tenant database at a time, so the code that depends on a layout waits for its tenant.","evaluate":{"method":"scenario"},"ref":"ARC-107","area":"09-architecture","section":"Change across versions","lifecycle":"active","boundary":"b-3","boundaryDetail":"`layout version`","traces":["g-104","g-1"],"milestone":2,"inSection":"sec-arch-4"},
    {"id":"arc-108","kind":"requirement","statement":"A decision SHALL load only the records that its plan names.","rationale":"A tenant holds a great many records. A decision that loads its whole tenant makes the kernel's memory and latency a function of tenant size rather than of the decision.","evaluate":{"method":"property"},"ref":"ARC-108","area":"09-architecture","section":"Kernel load, limits and connections","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::needs`","traces":["k-100","g-4"],"milestone":1,"inSection":"sec-arch-5"},
    {"id":"arc-109","kind":"requirement","statement":"Request rates and agent operation budgets SHALL be counted in one store that every gateway and agent gateway instance reads and writes.","rationale":"A limit counted separately in each instance is a limit that grows with the number of instances.","evaluate":{"method":"scenario"},"ref":"ARC-109","area":"09-architecture","section":"Kernel load, limits and connections","lifecycle":"active","boundary":"b-100","boundaryDetail":"`request limit`","traces":["g-4","g-28","g-102"],"milestone":6,"inSection":"sec-arch-5"},
    {"id":"arc-110","kind":"requirement","statement":"An operator report that spans tenants SHALL be answered from telemetry, published summaries and the tenant directory alone.","rationale":"Operators need the fleet view, and the data of a tenant stays with that tenant.","evaluate":{"method":"property"},"ref":"ARC-110","area":"09-architecture","section":"Reporting and backup","lifecycle":"active","boundary":"b-12","boundaryDetail":"`fleet report`","traces":["g-100","ng-6"],"milestone":7,"inSection":"sec-arch-6"},
    {"id":"arc-111","kind":"requirement","statement":"Each tenant database SHALL be backed up to the backup archive on a schedule, with every copy encrypted under the key of that tenant.","rationale":"A backup that no schedule produces, or that another tenant's key can open, is not a backup of that tenant.","evaluate":{"method":"scenario"},"ref":"ARC-111","area":"09-architecture","section":"Reporting and backup","lifecycle":"active","boundary":"b-101","boundaryDetail":"`backup archive`","traces":["g-1","g-40"],"milestone":2,"inSection":"sec-arch-6"},
    {"id":"arc-112","kind":"requirement","statement":"A product module SHALL reach tenant data only through the runtime.","rationale":"A module with its own path to a tenant database would bypass the authorisation and the copies that the runtime applies.","evaluate":{"method":"property"},"ref":"ARC-112","area":"09-architecture","section":"Extension","lifecycle":"active","boundary":"b-21","boundaryDetail":"`product module`","traces":["k-3","g-31"],"milestone":2,"inSection":"sec-arch-7"},
    {"id":"arc-113","kind":"requirement","statement":"A product module SHALL add its record types, views, workflows and operations as tenant metadata, with no change to the kernel.","rationale":"A feature that changes the kernel changes every tenant at once, and cannot be installed, removed or projected on its own.","evaluate":{"method":"scenario"},"ref":"ARC-113","area":"09-architecture","section":"Extension","lifecycle":"active","boundary":"b-21","boundaryDetail":"`module bundle`","traces":["g-103","k-1"],"milestone":2,"inSection":"sec-arch-7"},
    {"id":"arc-114","kind":"requirement","statement":"The total of connections that one database cluster holds open SHALL stay within the configured ceiling of that cluster, whatever the number of tenants on it.","rationale":"With a database per tenant, connections are the first shared resource that runs out as tenants are added.","evaluate":{"method":"property"},"ref":"ARC-114","area":"09-architecture","section":"Kernel load, limits and connections","lifecycle":"active","boundary":"b-2","boundaryDetail":"`cluster connection ceiling`","traces":["g-102","d-1"],"milestone":2,"inSection":"sec-arch-5"},
    {"id":"arc-115","kind":"requirement","statement":"A stored event SHALL name the version of its format, so that a reader refuses a version that it does not support.","rationale":"Old and new readers meet during a rolling change, and a reader that guesses at a format writes a wrong state.","evaluate":{"method":"property"},"ref":"ARC-115","area":"09-architecture","section":"Change across versions","lifecycle":"active","boundary":"b-2","boundaryDetail":"`event format`","traces":["g-5","g-104"],"milestone":2,"inSection":"sec-arch-4"},
    {"id":"m-outbox-effect-once","kind":"invariant","models":"arc-104","statement":"A subscriber that receives one notice twice makes one effect from it.","evaluate":{"method":"state-invariant","scenarios":["arc-outbox-duplicate-delivery"],"expr":"arc-outbox-consumer-flow.effects <= 1","negatives":[{"scenario":"arc-outbox-duplicate-delivery","faults":["arc-defect-outbox-duplicate-applied"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-outbox-published-after-crash","kind":"temporal","models":"arc-105","statement":"An event that a stopped runtime left unpublished is published by the outbox job.","evaluate":{"method":"eventually","scenarios":["arc-publisher-crashed-after-commit"],"occurs":{"event":"arc-ob-published"},"negatives":[{"scenario":"arc-publisher-crashed-after-commit","faults":["arc-recovery-disabled"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-database-commit"]},
    {"id":"m-old-format-while-old-runs","kind":"invariant","models":"arc-106","statement":"Once a commit is written in the newer format, no older version is still running.","evaluate":{"method":"state-invariant","scenarios":["arc-rolling-deploy-with-commit"],"expr":"arc-rolling-change-flow.newFormat => !arc-rolling-change-flow.oldRunning","negatives":[{"scenario":"arc-rolling-deploy-with-commit","faults":["arc-defect-new-format-early"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-module-through-runtime","kind":"structural","models":"arc-112","statement":"Every path from a product module to a tenant database passes through the runtime.","evaluate":{"method":"only-via","from":"product-module","to":"tenant-database","via":"runtime"},"assumptions":["a-model-abstraction"]},
    {"id":"m-fleet-reads-no-tenant-database","kind":"structural","models":"arc-110","statement":"Fleet reporting has no path to any tenant database.","evaluate":{"method":"no-relationship","from":"fleet-reporting","to":"tenant-database","transitive":true},"assumptions":["a-model-abstraction"]},
    {"id":"m-backup-archive-private","kind":"structural","models":"arc-111","statement":"No component other than the tenant database and the control plane reaches the backup archive directly.","evaluate":{"method":"no-relationship","from":["gateway","agent-gateway","web-application","agent","scheduler","workflow-engine","connector-runner","identity-service","telemetry-pipeline"],"to":"backup-archive","transitive":false},"assumptions":["a-model-abstraction"]},
    {"id":"adm-150","kind":"requirement","statement":"A tenant SHALL define roles as named sets of permissions over the operations and object types of its schema, and assign each role to people, services, agents and teams.","rationale":"Custom roles fit a tenant's own organisation into the one policy model.","evaluate":{"method":"scenario"},"ref":"ADM-150","area":"09-administration","section":"Roles and teams","lifecycle":"active","boundary":"b-4","boundaryDetail":"`role assignment`","traces":["g-153","k-13"],"milestone":3,"inSection":"sec-administration-2"},
    {"id":"adm-151","kind":"requirement","statement":"A principal SHALL hold the permissions of each role assigned to it directly and of each role of each team it belongs to, and no other permission.","rationale":"Team membership grants roles through the same decision as a direct assignment.","evaluate":{"method":"property"},"ref":"ADM-151","area":"09-administration","section":"Roles and teams","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["g-153"],"milestone":3,"inSection":"sec-administration-2"},
    {"id":"adm-152","kind":"requirement","statement":"Assigning a role SHALL be refused when the assigning principal holds none of the permissions that the role grants.","rationale":"Nobody raises their own reach by handing out a role they could not use.","evaluate":{"method":"scenario"},"ref":"ADM-152","area":"09-administration","section":"Roles and teams","lifecycle":"active","boundary":"b-4","boundaryDetail":"`role assignment`","traces":["g-153","k-13"],"milestone":3,"inSection":"sec-administration-2"},
    {"id":"adm-153","kind":"requirement","statement":"An invitation SHALL grant its roles to the one person who redeems it with the address it names, and to no one else.","rationale":"An invitation is a grant of roles, so it binds to one address and one redemption.","evaluate":{"method":"scenario"},"ref":"ADM-153","area":"09-administration","section":"Invitations and onboarding","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /invitations/accept`","traces":["g-153"],"milestone":3,"inSection":"sec-administration-3"},
    {"id":"adm-154","kind":"requirement","statement":"A person SHALL start a sandbox tenant from a published template and become its owner, with no step taken by the platform operator.","rationale":"A buyer who has to wait for a sales call does not try the product first.","evaluate":{"method":"scenario"},"ref":"ADM-154","area":"09-administration","section":"Invitations and onboarding","lifecycle":"active","boundary":"b-3","boundaryDetail":"`POST /sandboxes`","traces":["g-154"],"milestone":3,"inSection":"sec-administration-3"},
    {"id":"adm-155","kind":"requirement","statement":"A sandbox tenant SHALL be deleted at the end of the period that its plan states, unless its owner has kept it.","rationale":"An abandoned sandbox holds personal data and storage that nobody uses.","evaluate":{"method":"scenario"},"ref":"ADM-155","area":"09-administration","section":"Invitations and onboarding","lifecycle":"active","boundary":"b-3","boundaryDetail":"`sandbox expiry`","traces":["g-154","g-157"],"milestone":3,"inSection":"sec-administration-3"},
    {"id":"adm-156","kind":"requirement","statement":"Keeping a sandbox tenant SHALL change its kind to production without copying its records.","rationale":"The kept tenant is the one the customer keeps using, so nothing has to move.","evaluate":{"method":"scenario"},"ref":"ADM-156","area":"09-administration","section":"Invitations and onboarding","lifecycle":"active","boundary":"b-3","boundaryDetail":"`keep sandbox`","traces":["g-154"],"milestone":3,"inSection":"sec-administration-3"},
    {"id":"adm-157","kind":"requirement","statement":"Each tenant SHALL record whether it is production, staging or sandbox, and the production tenant that a staging tenant serves.","rationale":"Environments are tenants, so their kind and their link are directory data.","evaluate":{"method":"example"},"ref":"ADM-157","area":"09-administration","section":"Tenant kinds and environments","lifecycle":"active","boundary":"b-3","boundaryDetail":"`tenant kind`","traces":["g-1"],"milestone":2,"inSection":"sec-administration-4"},
    {"id":"adm-158","kind":"requirement","statement":"A change to the configuration of a staging tenant SHALL reach its production tenant only through a proposal that the production policies approve.","rationale":"A promotion changes production, so it takes the route of any other risky change.","evaluate":{"method":"scenario"},"ref":"ADM-158","area":"09-administration","section":"Tenant kinds and environments","lifecycle":"active","boundary":"b-11","boundaryDetail":"`proposal`","traces":["g-164","g-26"],"milestone":7,"inSection":"sec-administration-4"},
    {"id":"adm-159","kind":"requirement","statement":"A promotion SHALL carry the tenant metadata of the staging tenant and leave the records of its content where they are.","rationale":"Content is written by people in the tenant that holds it, and a promotion moves configuration only.","evaluate":{"method":"scenario"},"ref":"ADM-159","area":"09-administration","section":"Tenant kinds and environments","lifecycle":"active","boundary":"b-11","boundaryDetail":"`promotion`","traces":["g-164","d-151"],"milestone":7,"inSection":"sec-administration-4"},
    {"id":"adm-160","kind":"requirement","statement":"A tenant deletion requested by its owner SHALL stay cancellable until the grace period that its plan states has ended.","rationale":"A deletion made by mistake is the costliest mistake a customer can make.","evaluate":{"method":"scenario"},"ref":"ADM-160","area":"09-administration","section":"Offboarding","lifecycle":"active","boundary":"b-3","boundaryDetail":"`DELETE /tenants/{id}`","traces":["g-160"],"milestone":2,"inSection":"sec-administration-5"},
    {"id":"adm-161","kind":"requirement","statement":"A tenant owner SHALL receive, on request, an archive of the tenant's records, files, configuration and audit entries in documented formats.","rationale":"The customer leaves with the data in a format that another system reads.","evaluate":{"method":"scenario"},"ref":"ADM-161","area":"09-administration","section":"Offboarding","lifecycle":"active","boundary":"b-153","boundaryDetail":"`GET /tenants/{id}/archive`","traces":["g-160","g-1"],"milestone":2,"inSection":"sec-administration-5"},
    {"id":"adm-162","kind":"requirement","statement":"Every archive SHALL hold a manifest that names the hash of each file the archive includes.","rationale":"A customer can check an archive without trusting the platform that produced it.","evaluate":{"method":"property"},"ref":"ADM-162","area":"09-administration","section":"Offboarding","lifecycle":"active","boundary":"b-153","boundaryDetail":"`archive manifest`","traces":["g-160"],"milestone":2,"inSection":"sec-administration-5"},
    {"id":"adm-163","kind":"requirement","statement":"A platform operator SHALL act in a tenant only under a support grant that the tenant owner issued and that names its end time.","rationale":"The tenant owner decides who may look, and until when.","evaluate":{"method":"scenario"},"ref":"ADM-163","area":"09-administration","section":"Support access","lifecycle":"active","boundary":"b-6","boundaryDetail":"`POST /token`","traces":["g-165"],"milestone":4,"inSection":"sec-administration-6"},
    {"id":"adm-164","kind":"requirement","statement":"An act of a platform operator in a tenant SHALL leave an audit entry that names the operator, the support grant and the request.","rationale":"The tenant can read back every look that the platform took.","evaluate":{"method":"property"},"ref":"ADM-164","area":"09-administration","section":"Support access","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit entry`","traces":["g-165","g-30"],"milestone":4,"inSection":"sec-administration-6"},
    {"id":"adm-165","kind":"requirement","statement":"Withdrawing a support grant SHALL refuse every later request made under that grant.","rationale":"Withdrawal takes effect without waiting for a token to expire.","evaluate":{"method":"scenario"},"ref":"ADM-165","area":"09-administration","section":"Support access","lifecycle":"active","boundary":"b-6","boundaryDetail":"`support grant`","traces":["g-165","g-28"],"milestone":4,"inSection":"sec-administration-6"},
    {"id":"bil-150","kind":"requirement","statement":"A tenant SHALL hold one plan that states the quotas of its connections, requests, stored bytes, jobs and emails.","rationale":"Without a plan a tenant has no bound on its own heavy use.","evaluate":{"method":"example"},"ref":"BIL-150","area":"02-tenancy","section":"Plans and quotas","lifecycle":"active","boundary":"b-3","boundaryDetail":"`tenant plan`","traces":["g-157","q-9"],"milestone":2,"inSection":"sec-billing-2"},
    {"id":"bil-151","kind":"requirement","statement":"A write that would exceed a quota of the tenant's plan SHALL be refused, with the quota it would exceed named in the refusal.","rationale":"A refused write tells the customer which limit to raise.","evaluate":{"method":"scenario"},"ref":"BIL-151","area":"02-tenancy","section":"Plans and quotas","lifecycle":"active","boundary":"b-11","boundaryDetail":"`operation`","traces":["g-157","g-4"],"milestone":6,"inSection":"sec-billing-2"},
    {"id":"bil-152","kind":"requirement","statement":"The platform SHALL count the metered quantities of each tenant for each billing period from the records that carry them.","rationale":"Counts that come from the records can be checked against the records.","evaluate":{"method":"property"},"ref":"BIL-152","area":"02-tenancy","section":"Metering and export","lifecycle":"active","boundary":"b-155","boundaryDetail":"`usage count`","traces":["g-157"],"milestone":6,"inSection":"sec-billing-4"},
    {"id":"bil-153","kind":"requirement","statement":"The usage of each billing period SHALL be delivered to the billing system that the tenant configures as a signed document that carries an idempotency key.","rationale":"A billing system that receives the same usage twice counts it once.","evaluate":{"method":"scenario"},"ref":"BIL-153","area":"02-tenancy","section":"Metering and export","lifecycle":"active","boundary":"b-155","boundaryDetail":"`usage export`","traces":["g-157"],"milestone":6,"inSection":"sec-billing-4"},
    {"id":"bil-154","kind":"requirement","statement":"A trial that ends without a chosen plan SHALL suspend the tenant with all of its data kept.","rationale":"A lapsed trial is a pause, and the buyer can still choose a plan.","evaluate":{"method":"scenario"},"ref":"BIL-154","area":"02-tenancy","section":"Trials","lifecycle":"active","boundary":"b-3","boundaryDetail":"`trial end`","traces":["g-157"],"milestone":2,"inSection":"sec-billing-3"},
    {"id":"bil-155","kind":"requirement","statement":"The platform SHALL publish the objectives of each plan and the result measured in each calendar month.","rationale":"A published objective is one that the customer can hold the platform to.","evaluate":{"method":"example"},"ref":"BIL-155","area":"02-tenancy","section":"Published objectives","lifecycle":"active","boundary":"b-156","boundaryDetail":"`service objectives`","traces":["g-168","g-27"],"milestone":9,"inSection":"sec-billing-5"},
    {"id":"ntf-150","kind":"requirement","statement":"An email notice SHALL omit the field values of each record that its recipient has no right to read.","rationale":"Email leaves the platform, and what it carries leaves with it.","evaluate":{"method":"property"},"ref":"NTF-150","area":"04-automation","section":"Notices and inbox","lifecycle":"active","boundary":"b-154","boundaryDetail":"`email notice`","traces":["g-155","g-20"],"milestone":5,"inSection":"sec-notifications-2"},
    {"id":"ntf-151","kind":"requirement","statement":"Each subscription SHALL choose delivery by email, by the inbox of its recipient, or by both.","rationale":"Some notices belong in the inbox alone, and others are also sent by mail.","evaluate":{"method":"example"},"ref":"NTF-151","area":"04-automation","section":"Notices and inbox","lifecycle":"active","boundary":"b-154","boundaryDetail":"`subscription`","traces":["g-155"],"milestone":5,"inSection":"sec-notifications-2"},
    {"id":"ntf-152","kind":"requirement","statement":"An approval step SHALL appear in the inbox of each principal that its policy names, and in no other inbox.","rationale":"The approver sees the task where the approver works, and nobody else sees it.","evaluate":{"method":"scenario"},"ref":"NTF-152","area":"04-automation","section":"Notices and inbox","lifecycle":"active","boundary":"b-154","boundaryDetail":"`approval task`","traces":["g-155","g-151"],"milestone":5,"inSection":"sec-notifications-2"},
    {"id":"int-150","kind":"requirement","statement":"An inbound webhook delivery SHALL start a workflow run only when its signature matches the secret of its endpoint.","rationale":"A caller without the secret cannot start work in the tenant.","evaluate":{"method":"scenario"},"ref":"INT-150","area":"04-automation","section":"Inbound webhooks","lifecycle":"active","boundary":"b-150","boundaryDetail":"`inbound webhook`","traces":["g-156"],"milestone":5,"inSection":"sec-integrations-2"},
    {"id":"int-151","kind":"requirement","statement":"A repeated inbound delivery of one event SHALL leave the number of runs that it started unchanged.","rationale":"Senders retry, and a retry does not run the workflow twice.","evaluate":{"method":"scenario"},"ref":"INT-151","area":"04-automation","section":"Inbound webhooks","lifecycle":"active","boundary":"b-150","boundaryDetail":"`inbound webhook`","traces":["g-156"],"milestone":5,"inSection":"sec-integrations-2"},
    {"id":"int-152","kind":"requirement","statement":"The tenant SHALL see the response status and the attempt count of each outbound webhook delivery that it sent.","rationale":"A failing receiver is diagnosed from the log rather than from guesses.","evaluate":{"method":"scenario"},"ref":"INT-152","area":"04-automation","section":"Outbound deliveries and the catalogue","lifecycle":"active","boundary":"b-150","boundaryDetail":"`webhook log`","traces":["g-156"],"milestone":5,"inSection":"sec-integrations-3"},
    {"id":"int-153","kind":"requirement","statement":"A workflow definition that names a trigger or an action outside the published catalogue SHALL be refused at activation.","rationale":"A workflow uses only what the platform describes and can check.","evaluate":{"method":"scenario"},"ref":"INT-153","area":"04-automation","section":"Outbound deliveries and the catalogue","lifecycle":"active","boundary":"b-8","boundaryDetail":"`activation`","traces":["g-156","g-16"],"milestone":5,"inSection":"sec-integrations-3"},
    {"id":"int-154","kind":"requirement","statement":"A tenant SHALL install a platform template or integration only after reviewing the projection of the changes it makes.","rationale":"Installing a template is a change, so it is projected like one.","evaluate":{"method":"scenario"},"ref":"INT-154","area":"04-automation","section":"Installed templates and integrations","lifecycle":"active","boundary":"b-21","boundaryDetail":"`template install`","traces":["g-167","g-44"],"milestone":7,"inSection":"sec-integrations-4"},
    {"id":"int-155","kind":"requirement","statement":"A bundle installed from the platform catalogue SHALL contain declared metadata and no executable code.","rationale":"Installing a bundle runs no code of its author, so review means reading what the bundle says.","evaluate":{"method":"property"},"ref":"INT-155","area":"04-automation","section":"Installed templates and integrations","lifecycle":"active","boundary":"b-21","boundaryDetail":"`tenant bundle`","traces":["g-167","ng-150"],"milestone":7,"inSection":"sec-integrations-4"},
    {"id":"sch-150","kind":"requirement","statement":"A bulk change to many records SHALL run as jobs that record the outcome of every record they change.","rationale":"A bulk change that stops halfway has a known extent.","evaluate":{"method":"scenario"},"ref":"SCH-150","area":"04-automation","section":"Bulk work","lifecycle":"active","boundary":"b-7","boundaryDetail":"`bulk job`","traces":["g-14"],"milestone":5,"inSection":"sec-scheduling-150"},
    {"id":"cms-150","kind":"requirement","statement":"A record SHALL be refused when one of its fields does not hold a value of the field type that its content type declares.","rationale":"The field types are the schema of the content, and every write is checked against them.","evaluate":{"method":"property"},"ref":"CMS-150","area":"07-content","section":"Authoring","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["g-31","g-150"],"milestone":6,"inSection":"sec-content-150"},
    {"id":"cms-151","kind":"requirement","statement":"A reference field SHALL name only a record of the content type that the field declares.","rationale":"A reference to the wrong kind of record breaks every page that follows it.","evaluate":{"method":"property"},"ref":"CMS-151","area":"07-content","section":"Authoring","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["g-31"],"milestone":6,"inSection":"sec-content-150"},
    {"id":"cms-152","kind":"requirement","statement":"Deleting a record that another record refers to SHALL be refused until the referring field is changed.","rationale":"A deletion leaves no dangling reference on a published page.","evaluate":{"method":"scenario"},"ref":"CMS-152","area":"07-content","section":"Authoring","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["g-31"],"milestone":6,"inSection":"sec-content-150"},
    {"id":"cms-153","kind":"requirement","statement":"Saving an edit to a published record SHALL leave its published version unchanged until the draft is published.","rationale":"Readers see a change when it is published, not when it is typed.","evaluate":{"method":"scenario"},"ref":"CMS-153","area":"07-content","section":"Authoring","lifecycle":"active","boundary":"b-1","boundaryDetail":"`draft save`","traces":["g-150"],"milestone":6,"inSection":"sec-content-150"},
    {"id":"cms-154","kind":"requirement","statement":"A record created in the authoring application SHALL start as a draft.","rationale":"Nothing a new record holds reaches readers before someone publishes it.","evaluate":{"method":"example"},"ref":"CMS-154","area":"07-content","section":"Authoring","lifecycle":"active","boundary":"b-13","boundaryDetail":"`authoring application`","traces":["g-150"],"milestone":6,"inSection":"sec-content-150"},
    {"id":"cms-155","kind":"requirement","statement":"A save from a copy of a draft that is older than the stored draft SHALL be refused, with the current version named.","rationale":"Two editors cannot overwrite each other without a trace.","evaluate":{"method":"scenario"},"ref":"CMS-155","area":"07-content","section":"Authoring","lifecycle":"active","boundary":"b-13","boundaryDetail":"`draft save`","traces":["g-150"],"milestone":6,"inSection":"sec-content-150"},
    {"id":"cms-156","kind":"requirement","statement":"A record of a content type that the tenant marks for review SHALL be published only after an approval by a principal that the review policy names.","rationale":"Review is a workflow step with a named approver, so it can be audited.","evaluate":{"method":"scenario"},"ref":"CMS-156","area":"07-content","section":"Review and publication","lifecycle":"active","boundary":"b-8","boundaryDetail":"`review step`","traces":["g-151","g-17"],"milestone":6,"inSection":"sec-content-151"},
    {"id":"cms-157","kind":"requirement","statement":"A reviewer SHALL see the differences between a draft and the published version of its record before approving it.","rationale":"A reviewer approves the change itself, not a summary of it.","evaluate":{"method":"scenario"},"ref":"CMS-157","area":"07-content","section":"Review and publication","lifecycle":"active","boundary":"b-13","boundaryDetail":"`review diff`","traces":["g-32"],"milestone":8,"inSection":"sec-content-151"},
    {"id":"cms-158","kind":"requirement","statement":"Scheduling a publication SHALL remain cancellable until the publication time.","rationale":"A scheduled change is a plan, and a plan changes until it runs.","evaluate":{"method":"scenario"},"ref":"CMS-158","area":"07-content","section":"Review and publication","lifecycle":"active","boundary":"b-7","boundaryDetail":"`publication time`","traces":["g-17"],"milestone":6,"inSection":"sec-content-151"},
    {"id":"cms-159","kind":"requirement","statement":"A preview link SHALL show one stated draft version of one record to a reader without an account, and stop showing it at the expiry that the link states.","rationale":"The reviewer sees what delivery would show, for as long as the review lasts.","evaluate":{"method":"scenario"},"ref":"CMS-159","area":"07-content","section":"Preview links","lifecycle":"active","boundary":"b-9","boundaryDetail":"`preview link`","traces":["g-158","g-20"],"milestone":6,"inSection":"sec-content-152"},
    {"id":"cms-160","kind":"requirement","statement":"A preview link SHALL grant access to no record and no screen of the authoring application other than its own draft version.","rationale":"A link sent to a reviewer opens one draft and nothing else.","evaluate":{"method":"scenario"},"ref":"CMS-160","area":"07-content","section":"Preview links","lifecycle":"active","boundary":"b-9","boundaryDetail":"`preview link`","traces":["g-158","g-20"],"milestone":6,"inSection":"sec-content-152"},
    {"id":"cms-161","kind":"requirement","statement":"Changing the address of a published page SHALL keep the former address answering with a redirect to the new address.","rationale":"Links from outside the site keep working after a page moves.","evaluate":{"method":"scenario"},"ref":"CMS-161","area":"07-content","section":"Addresses and redirects","lifecycle":"active","boundary":"b-9","boundaryDetail":"`address`","traces":["g-159"],"milestone":6,"inSection":"sec-content-153"},
    {"id":"cms-162","kind":"requirement","statement":"A redirect SHALL be refused when it would form a loop with the redirects of the same site.","rationale":"A loop is a page that no reader can reach.","evaluate":{"method":"scenario"},"ref":"CMS-162","area":"07-content","section":"Addresses and redirects","lifecycle":"active","boundary":"b-9","boundaryDetail":"`redirect`","traces":["g-159"],"milestone":6,"inSection":"sec-content-153"},
    {"id":"cms-163","kind":"requirement","statement":"A delivery query SHALL return only the fields that the request names in its field selection.","rationale":"Readers take the fields they ask for and no others, so responses stay small and private fields stay private.","evaluate":{"method":"property"},"ref":"CMS-163","area":"07-content","section":"Delivery interface","lifecycle":"active","boundary":"b-9","boundaryDetail":"`field selection`","traces":["g-152"],"milestone":6,"inSection":"sec-content-154"},
    {"id":"cms-164","kind":"requirement","statement":"A delivery list SHALL return one page of results together with the cursor that fetches the next page.","rationale":"Lists of any length arrive in pages that a client can finish.","evaluate":{"method":"scenario"},"ref":"CMS-164","area":"07-content","section":"Delivery interface","lifecycle":"active","boundary":"b-9","boundaryDetail":"`cursor`","traces":["g-152"],"milestone":6,"inSection":"sec-content-154"},
    {"id":"cms-165","kind":"requirement","statement":"A delivery list SHALL filter only on the fields that its named query declares as filterable.","rationale":"The filters a client can use are the ones the tenant chose to publish.","evaluate":{"method":"property"},"ref":"CMS-165","area":"07-content","section":"Delivery interface","lifecycle":"active","boundary":"b-9","boundaryDetail":"`named query`","traces":["g-152","g-31"],"milestone":6,"inSection":"sec-content-154"},
    {"id":"cms-166","kind":"requirement","statement":"A delivery key SHALL read only the site and the audience class that the key names.","rationale":"A key for one site cannot read another site of the same tenant.","evaluate":{"method":"scenario"},"ref":"CMS-166","area":"07-content","section":"Delivery interface","lifecycle":"active","boundary":"b-6","boundaryDetail":"`delivery key`","traces":["g-152","g-20"],"milestone":6,"inSection":"sec-content-154"},
    {"id":"cms-167","kind":"requirement","statement":"A delivery key that its owner revokes SHALL be refused by the delivery interface on the same terms as a revoked session.","rationale":"One revocation rule covers both kinds of credential.","evaluate":{"method":"scenario"},"ref":"CMS-167","area":"07-content","section":"Delivery interface","lifecycle":"active","boundary":"b-6","boundaryDetail":"`delivery key`","traces":["g-152","g-9"],"milestone":6,"inSection":"sec-content-154"},
    {"id":"cms-168","kind":"requirement","statement":"A throttled delivery response SHALL name the limit that applied and the time after which the next request is permitted.","rationale":"A client that is told the limit can back off without guessing.","evaluate":{"method":"scenario"},"ref":"CMS-168","area":"07-content","section":"Delivery interface","lifecycle":"active","boundary":"b-9","boundaryDetail":"`429`","traces":["g-166","g-4"],"milestone":6,"inSection":"sec-content-154"},
    {"id":"cms-169","kind":"requirement","statement":"The delivery interface SHALL be described in a machine-readable document that names each operation with its input and output schema and its version.","rationale":"Clients and tools read the description instead of the documentation.","evaluate":{"method":"example"},"ref":"CMS-169","area":"07-content","section":"Delivery interface","lifecycle":"active","boundary":"b-9","boundaryDetail":"`description document`","traces":["g-152","g-166"],"milestone":6,"inSection":"sec-content-154"},
    {"id":"cms-170","kind":"requirement","statement":"A delivery version SHALL remain served for the deprecation period that its notice states, after its replacement is published.","rationale":"A client gets the time it was promised to move.","evaluate":{"method":"scenario"},"ref":"CMS-170","area":"07-content","section":"Delivery interface","lifecycle":"active","boundary":"b-9","boundaryDetail":"`delivery version`","traces":["g-166"],"milestone":6,"inSection":"sec-content-154"},
    {"id":"cms-171","kind":"requirement","statement":"A change to the delivery interface SHALL appear in a changelog that names the version it introduced.","rationale":"Customers find changes where they already look.","evaluate":{"method":"example"},"ref":"CMS-171","area":"07-content","section":"Delivery interface","lifecycle":"active","boundary":"b-156","boundaryDetail":"`changelog`","traces":["g-166"],"milestone":6,"inSection":"sec-content-154"},
    {"id":"cms-172","kind":"requirement","statement":"An import of records SHALL refuse a record whose fields its content type does not declare.","rationale":"An import cannot add fields that the schema does not have.","evaluate":{"method":"scenario"},"ref":"CMS-172","area":"07-content","section":"Import and export","lifecycle":"active","boundary":"b-153","boundaryDetail":"`record import`","traces":["g-163","g-31"],"milestone":8,"inSection":"sec-content-155"},
    {"id":"edg-150","kind":"requirement","statement":"A published site SHALL serve a sitemap that lists the address of each published page of that site.","rationale":"Search engines find the pages that the site lists, so the list is the site's own statement.","evaluate":{"method":"scenario"},"ref":"EDG-150","area":"05-delivery","section":"Discovery","lifecycle":"active","boundary":"b-9","boundaryDetail":"`sitemap`","traces":["g-159"],"milestone":6,"inSection":"sec-edge-150"},
    {"id":"edg-151","kind":"requirement","statement":"A collection of published records SHALL be served as a syndication feed that names the address and the publication time of each record.","rationale":"Readers who subscribe get each new record with its time.","evaluate":{"method":"scenario"},"ref":"EDG-151","area":"05-delivery","section":"Discovery","lifecycle":"active","boundary":"b-9","boundaryDetail":"`feed`","traces":["g-159"],"milestone":6,"inSection":"sec-edge-150"},
    {"id":"obs-150","kind":"requirement","statement":"A status page SHALL name the state of each component and of each open incident, for readers who hold no account.","rationale":"Customers check status without signing in, and tools read the same page.","evaluate":{"method":"scenario"},"ref":"OBS-150","area":"06-agents","section":"Status","lifecycle":"active","boundary":"b-156","boundaryDetail":"`status page`","traces":["g-27"],"milestone":7,"inSection":"sec-observability-150"},
    {"id":"frm-150","kind":"requirement","statement":"A form submission SHALL be stored in the tenant database before the reader is told that it was received.","rationale":"A reader is not told that a message arrived which the tenant cannot see.","evaluate":{"method":"scenario"},"ref":"FRM-150","area":"07-content","section":"Submissions","lifecycle":"active","boundary":"b-152","boundaryDetail":"`form submission`","traces":["g-162"],"milestone":8,"inSection":"sec-forms-2"},
    {"id":"frm-151","kind":"requirement","statement":"A form submission SHALL be refused when it carries no submission token that the form issued to the browser that sent it.","rationale":"Automated posts that did not load the form are refused.","evaluate":{"method":"scenario"},"ref":"FRM-151","area":"07-content","section":"Submissions","lifecycle":"active","boundary":"b-152","boundaryDetail":"`submission token`","traces":["g-162","g-20"],"milestone":8,"inSection":"sec-forms-2"},
    {"id":"frm-152","kind":"requirement","statement":"The notice of a submission SHALL be sent through the notification subscriptions that the form names.","rationale":"Submissions reach the people who handle them, by the channels they chose.","evaluate":{"method":"scenario"},"ref":"FRM-152","area":"07-content","section":"Submissions","lifecycle":"active","boundary":"b-154","boundaryDetail":"`submission notice`","traces":["g-162","g-155"],"milestone":8,"inSection":"sec-forms-2"},
    {"id":"frm-153","kind":"requirement","statement":"A submission SHALL be erased when the retention period that its form states has ended.","rationale":"Personal data in a submission does not outlive the reason for keeping it.","evaluate":{"method":"scenario"},"ref":"FRM-153","area":"07-content","section":"Submissions","lifecycle":"active","boundary":"b-152","boundaryDetail":"`retention`","traces":["g-162","g-22"],"milestone":8,"inSection":"sec-forms-2"},
    {"id":"frm-154","kind":"requirement","statement":"A person with the role that reads submissions SHALL export the submissions of a form as a document of their declared fields.","rationale":"The people who handle submissions can take them out of the platform.","evaluate":{"method":"scenario"},"ref":"FRM-154","area":"07-content","section":"Submissions","lifecycle":"active","boundary":"b-153","boundaryDetail":"`form export`","traces":["g-162"],"milestone":8,"inSection":"sec-forms-2"},
    {"id":"srh-150","kind":"requirement","statement":"A search over a site SHALL return only the published records that the audience class of the reader permits.","rationale":"Search is a read like any other, decided by the same policies.","evaluate":{"method":"property"},"ref":"SRH-150","area":"07-content","section":"Queries","lifecycle":"active","boundary":"b-151","boundaryDetail":"`search query`","traces":["g-161","g-20"],"milestone":8,"inSection":"sec-search-2"},
    {"id":"srh-151","kind":"requirement","statement":"A search by an editor SHALL return the drafts that the editor's roles permit reading, each with its status.","rationale":"An editor finds unpublished work without seeing work the roles do not permit reading.","evaluate":{"method":"scenario"},"ref":"SRH-151","area":"07-content","section":"Queries","lifecycle":"active","boundary":"b-151","boundaryDetail":"`search query`","traces":["g-161"],"milestone":8,"inSection":"sec-search-2"},
    {"id":"srh-152","kind":"requirement","statement":"A search entry SHALL follow the commit of the record it was made from, including the commit of its deletion.","rationale":"A deleted record is not found, and an edited one is found by its new words.","evaluate":{"method":"scenario"},"ref":"SRH-152","area":"07-content","section":"Queries","lifecycle":"active","boundary":"b-151","boundaryDetail":"`search entry`","traces":["g-161","g-22"],"milestone":8,"inSection":"sec-search-2"},
    {"id":"m-inbound-repeat-single-run","kind":"invariant","models":"int-151","statement":"In the repeated inbound delivery scenario, a repeated delivery of one event starts no second run.","evaluate":{"method":"state-invariant","scenarios":["inbound-repeated-delivery"],"expr":"inbound-run-flow.runs <= 1","negatives":[{"scenario":"inbound-repeated-delivery","faults":["defect-webhook-no-dedupe"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-preview-expired-refused","kind":"temporal","models":"cms-159","statement":"A preview link presented after its expiry shows no draft.","evaluate":{"method":"never","scenarios":["preview-presented-late"],"occurs":{"event":"pl-shown"},"negatives":[{"scenario":"preview-presented-late","faults":["defect-preview-unchecked"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"cnv-200","kind":"requirement","statement":"For every operation that the assistant proposes, the same operation with the same input SHALL be available to the person in the authoring application.","rationale":"The assistant is a client of the catalogue, not a second way to change the platform.","evaluate":{"method":"property"},"ref":"CNV-200","area":"09-conversation","section":"Operations and authority","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /operations`","traces":["g-200","d-200"],"milestone":7,"inSection":"sec-conversation-2"},
    {"id":"cnv-201","kind":"requirement","statement":"The assistant SHALL call each operation only with the delegated token of the person it acts for.","rationale":"The token names both the assistant and the person, so every request carries its own attribution.","evaluate":{"method":"scenario"},"ref":"CNV-201","area":"09-conversation","section":"Operations and authority","lifecycle":"active","boundary":"b-11","boundaryDetail":"`POST /operations/{name}`","traces":["g-200","d-200","k-13"],"milestone":7,"inSection":"sec-conversation-2"},
    {"id":"cnv-202","kind":"requirement","statement":"The operation catalogue SHALL refuse a call by the assistant for each operation that the person it acts for lacks permission to attempt.","rationale":"The assistant is held to the person's permissions at the one place every call passes.","evaluate":{"method":"property"},"ref":"CNV-202","area":"09-conversation","section":"Operations and authority","lifecycle":"active","boundary":"b-11","boundaryDetail":"`POST /operations/{name}`","traces":["g-200","k-13"],"milestone":7,"inSection":"sec-conversation-2"},
    {"id":"cnv-203","kind":"requirement","statement":"When the permissions of a person change during a conversation, the assistant SHALL use the permissions that person holds when each operation runs.","rationale":"A permission withdrawn in the middle of a conversation stops the work, including work already previewed.","evaluate":{"method":"scenario"},"ref":"CNV-203","area":"09-conversation","section":"Operations and authority","lifecycle":"active","boundary":"b-11","boundaryDetail":"`POST /operations/{name}`","traces":["g-200","k-13"],"milestone":7,"inSection":"sec-conversation-2"},
    {"id":"cnv-204","kind":"requirement","statement":"For every change that the assistant makes, the change SHALL be shown to the person as a preview before it is applied.","rationale":"A preview is the only place a person sees what a change will do before it happens.","evaluate":{"method":"property"},"ref":"CNV-204","area":"09-conversation","section":"Preview and confirmation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /conversations/{id}/turns`","traces":["g-201","d-201"],"milestone":7,"inSection":"sec-conversation-3"},
    {"id":"cnv-205","kind":"requirement","statement":"A preview SHALL list the records that the change creates, changes and removes, and the views that the change alters.","rationale":"The preview is the projection the person confirms, so it names what changes.","evaluate":{"method":"example"},"ref":"CNV-205","area":"09-conversation","section":"Preview and confirmation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`GET /pending-actions/{id}`","traces":["g-201"],"milestone":7,"inSection":"sec-conversation-3"},
    {"id":"cnv-206","kind":"requirement","statement":"A change SHALL be applied only after the person confirms the preview that shows it.","rationale":"Confirmation is the step that turns a suggestion into a change.","evaluate":{"method":"scenario"},"ref":"CNV-206","area":"09-conversation","section":"Preview and confirmation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /pending-actions/{id}/confirm`","traces":["g-201","d-201"],"milestone":7,"inSection":"sec-conversation-3"},
    {"id":"cnv-207","kind":"requirement","statement":"A confirmation SHALL bind to the preview it answers, so that an edited or replaced preview needs a new confirmation.","rationale":"A yes to one preview is not a yes to a different change.","evaluate":{"method":"scenario"},"ref":"CNV-207","area":"09-conversation","section":"Preview and confirmation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /pending-actions/{id}/confirm`","traces":["g-201","d-201"],"milestone":7,"inSection":"sec-conversation-3"},
    {"id":"cnv-208","kind":"requirement","statement":"A change that tenant policy classes as risky SHALL reach the person as a proposal with its projection, and no control in the conversation applies it directly.","rationale":"Risky changes keep the proposal flow of the agent plane (D-19) whichever interface asks for them.","evaluate":{"method":"scenario"},"ref":"CNV-208","area":"09-conversation","section":"Preview and confirmation","lifecycle":"active","boundary":"b-11","boundaryDetail":"`POST /proposals`","traces":["g-26","d-19","g-201"],"milestone":7,"inSection":"sec-conversation-3"},
    {"id":"cnv-209","kind":"requirement","statement":"Undoing a change SHALL preview its inverse operation and apply that inverse only after the person confirms.","rationale":"Undo is a change in its own right, so it is previewed and confirmed like any other.","evaluate":{"method":"scenario"},"ref":"CNV-209","area":"09-conversation","section":"Preview and confirmation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /turns/{id}/undo`","traces":["g-25","g-201"],"milestone":7,"inSection":"sec-conversation-3"},
    {"id":"cnv-210","kind":"requirement","statement":"A preview that the person cancels SHALL apply no change to any record.","rationale":"Cancelling stops the proposal it belongs to.","evaluate":{"method":"scenario"},"ref":"CNV-210","area":"09-conversation","section":"Preview and confirmation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /pending-actions/{id}/cancel`","traces":["g-201"],"milestone":7,"inSection":"sec-conversation-3"},
    {"id":"cnv-211","kind":"requirement","statement":"A preview SHALL be shown within 3 seconds at the 95th percentile for a tenant of one hundred thousand records.","rationale":"A person waits for the preview before deciding, so the wait is bounded.","evaluate":{"method":"budget"},"ref":"CNV-211","area":"09-conversation","section":"Preview and confirmation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`GET /pending-actions/{id}`","traces":["g-201"],"milestone":7,"inSection":"sec-conversation-3"},
    {"id":"cnv-212","kind":"requirement","statement":"A refusal shown in the conversation SHALL name the policy that refused the person and the next step open to the person.","rationale":"A person acts on the reason for a refusal, which the kernel returns as failed checks.","evaluate":{"method":"scenario"},"ref":"CNV-212","area":"09-conversation","section":"Explanation and evidence","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /conversations/{id}/turns`","traces":["g-202","g-24"],"milestone":7,"inSection":"sec-conversation-4"},
    {"id":"cnv-213","kind":"requirement","statement":"An answer about what an action would do SHALL come from a dry run of that action, named in the answer.","rationale":"Predictions come from the decision the platform would make, not from the model.","evaluate":{"method":"scenario"},"ref":"CNV-213","area":"09-conversation","section":"Explanation and evidence","lifecycle":"active","boundary":"b-11","boundaryDetail":"`dry run`","traces":["g-202","g-24"],"milestone":7,"inSection":"sec-conversation-4"},
    {"id":"cnv-214","kind":"requirement","statement":"For every statement about tenant data that a conversation reply makes, the reply SHALL cite the operation, projection or audit entry that the statement was read from.","rationale":"A statement the reply did not read is a guess, and the person needs to tell the two apart.","evaluate":{"method":"property"},"ref":"CNV-214","area":"09-conversation","section":"Explanation and evidence","lifecycle":"active","boundary":"b-200","boundaryDetail":"`reply`","traces":["g-202","k-2"],"milestone":7,"inSection":"sec-conversation-4"},
    {"id":"cnv-215","kind":"requirement","statement":"A reply that has no source for an answer SHALL say so in place of the answer.","rationale":"Silence about the source is not an answer.","evaluate":{"method":"scenario"},"ref":"CNV-215","area":"09-conversation","section":"Explanation and evidence","lifecycle":"active","boundary":"b-200","boundaryDetail":"`reply`","traces":["g-202"],"milestone":7,"inSection":"sec-conversation-4"},
    {"id":"cnv-216","kind":"requirement","statement":"A reply SHALL open, point at or fill a view of the authoring application using the view definition that the person would open directly.","rationale":"The conversation and the direct interface show the same screen.","evaluate":{"method":"scenario"},"ref":"CNV-216","area":"09-conversation","section":"One interface","lifecycle":"active","boundary":"b-13","boundaryDetail":"`view definition`","traces":["g-203","d-204"],"milestone":7,"inSection":"sec-conversation-5"},
    {"id":"cnv-217","kind":"requirement","statement":"The authoring application SHALL send the current selection to the conversation as context, and show the person that context before the next turn is sent.","rationale":"The selection is what the person is pointing at, so the assistant receives it without a copy step.","evaluate":{"method":"scenario"},"ref":"CNV-217","area":"09-conversation","section":"One interface","lifecycle":"active","boundary":"b-13","boundaryDetail":"`selection`","traces":["g-203"],"milestone":7,"inSection":"sec-conversation-5"},
    {"id":"cnv-218","kind":"requirement","statement":"A direct edit in the authoring application SHALL take effect while a reply is in progress, without waiting for that reply.","rationale":"The person can take over at any point.","evaluate":{"method":"scenario"},"ref":"CNV-218","area":"09-conversation","section":"One interface","lifecycle":"active","boundary":"b-13","boundaryDetail":"`edit`","traces":["g-203"],"milestone":7,"inSection":"sec-conversation-5"},
    {"id":"cnv-219","kind":"requirement","statement":"For every interface that a reply generates, the interface SHALL be rendered from a view definition and structured blocks, not from markup that a model produced.","rationale":"Generated interfaces are data the platform renders, so a model cannot inject script or style.","evaluate":{"method":"property"},"ref":"CNV-219","area":"09-conversation","section":"One interface","lifecycle":"active","boundary":"b-200","boundaryDetail":"`reply blocks`","traces":["k-12","d-204"],"milestone":7,"inSection":"sec-conversation-5"},
    {"id":"cnv-220","kind":"requirement","statement":"A reply SHALL stream as it is produced and end in one recorded state: complete, interrupted or failed.","rationale":"A stream that ends without a state cannot be resumed or explained.","evaluate":{"method":"scenario"},"ref":"CNV-220","area":"09-conversation","section":"Replies, streams and cancellation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`GET /conversations/{id}/stream`","traces":["g-203"],"milestone":7,"inSection":"sec-conversation-6"},
    {"id":"cnv-221","kind":"requirement","statement":"Cancelling a reply SHALL stop the model output and every operation of that reply that has not committed.","rationale":"The person's stop applies to the work as well as the words.","evaluate":{"method":"scenario"},"ref":"CNV-221","area":"09-conversation","section":"Replies, streams and cancellation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /turns/{id}/cancel`","traces":["g-201"],"milestone":7,"inSection":"sec-conversation-6"},
    {"id":"cnv-222","kind":"requirement","statement":"For every operation of a reply that is cancelled before its commit, the operation SHALL commit no change to any record.","rationale":"An operation that commits after a cancel is the defect cancellation exists to prevent.","evaluate":{"method":"property"},"ref":"CNV-222","area":"09-conversation","section":"Replies, streams and cancellation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /turns/{id}/cancel`","traces":["g-201"],"milestone":7,"inSection":"sec-conversation-6"},
    {"id":"cnv-223","kind":"requirement","statement":"A browser that reloads during a reply SHALL resume the reply from its last recorded part, with no part shown twice.","rationale":"A reload must neither lose the reply nor repeat it.","evaluate":{"method":"scenario"},"ref":"CNV-223","area":"09-conversation","section":"Replies, streams and cancellation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`GET /conversations/{id}/stream`","traces":["g-203"],"milestone":7,"inSection":"sec-conversation-6"},
    {"id":"cnv-224","kind":"requirement","statement":"The conversation service SHALL send the first part of a reply within 1 second at the 95th percentile after it accepts the person's message.","rationale":"Measures the platform time to the first part, with the model adapter replying from a fixed script.","evaluate":{"method":"budget"},"ref":"CNV-224","area":"09-conversation","section":"Replies, streams and cancellation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`GET /conversations/{id}/stream`","traces":["g-204"],"milestone":7,"inSection":"sec-conversation-6"},
    {"id":"cnv-225","kind":"requirement","statement":"A cancellation SHALL take effect within 1 second at the 99th percentile after the person cancels.","rationale":"A stop that arrives late is not a stop.","evaluate":{"method":"budget"},"ref":"CNV-225","area":"09-conversation","section":"Replies, streams and cancellation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /turns/{id}/cancel`","traces":["g-201"],"milestone":7,"inSection":"sec-conversation-6"},
    {"id":"cnv-226","kind":"requirement","statement":"The conversation service SHALL keep every turn of a conversation as tenant data in the tenant database and no transcript in the browser.","rationale":"Conversations follow the tenant, so they are exported and deleted with it (K-2).","evaluate":{"method":"property"},"ref":"CNV-226","area":"09-conversation","section":"Records, retention and visibility","lifecycle":"active","boundary":"b-200","boundaryDetail":"`conversation record`","traces":["k-2","g-200"],"milestone":7,"inSection":"sec-conversation-7"},
    {"id":"cnv-227","kind":"requirement","statement":"Each change that the assistant makes SHALL appear in the audit log with the person it acted for, and in the history of the record it changed, visible to each member permitted to read that record.","rationale":"Several people can see what an assistant did on someone's behalf, and the record says whom it acted for.","evaluate":{"method":"scenario"},"ref":"CNV-227","area":"09-conversation","section":"Records, retention and visibility","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit entry`","traces":["g-25","g-30"],"milestone":7,"inSection":"sec-conversation-7"},
    {"id":"cnv-228","kind":"requirement","statement":"For every turn of a conversation, the turn SHALL name by principal identifier the principal that wrote it.","rationale":"Assistant turns and person turns are attributed the same way as other records.","evaluate":{"method":"property"},"ref":"CNV-228","area":"09-conversation","section":"Records, retention and visibility","lifecycle":"active","boundary":"b-200","boundaryDetail":"`turn record`","traces":["g-25","g-200"],"milestone":7,"inSection":"sec-conversation-7"},
    {"id":"cnv-229","kind":"requirement","statement":"Deleting a conversation SHALL remove its turns, its pending actions and its model request context within the erasure bound of its class.","rationale":"Conversation history has retention and erasure like any other tenant data.","evaluate":{"method":"scenario"},"ref":"CNV-229","area":"09-conversation","section":"Records, retention and visibility","lifecycle":"active","boundary":"b-200","boundaryDetail":"`DELETE /conversations/{id}`","traces":["g-22","k-8"],"milestone":7,"inSection":"sec-conversation-7"},
    {"id":"cnv-230","kind":"requirement","statement":"A conversation SHALL be readable only by the principal that started it and by holders of the tenant's audit permission.","rationale":"Other members see the effects of the assistant in records and in the audit log, not the private conversation.","evaluate":{"method":"scenario"},"ref":"CNV-230","area":"09-conversation","section":"Records, retention and visibility","lifecycle":"active","boundary":"b-200","boundaryDetail":"`GET /conversations/{id}`","traces":["g-20"],"milestone":7,"inSection":"sec-conversation-7"},
    {"id":"cnv-231","kind":"requirement","statement":"The model provider adapters SHALL pass every check of the model provider conformance table.","rationale":"An adapter is accepted by behaviour, as the store adapters are.","evaluate":{"method":"conformance"},"ref":"CNV-231","area":"09-conversation","section":"Model provider","lifecycle":"active","boundary":"b-201","boundaryDetail":"`model provider contract`","traces":["g-38","d-202"],"milestone":7,"inSection":"sec-conversation-8","cases":["cases-model-provider-conformance"]},
    {"id":"cnv-232","kind":"requirement","statement":"The local stack SHALL answer a conversation turn through the local model adapter without any cloud credential.","rationale":"The conversation runs in containers with no account, as the rest of the platform does.","evaluate":{"method":"scenario"},"ref":"CNV-232","area":"09-conversation","section":"Model provider","lifecycle":"active","boundary":"b-19","boundaryDetail":"`compose file`","traces":["g-36","k-10"],"milestone":7,"inSection":"sec-conversation-8"},
    {"id":"cnv-233","kind":"requirement","statement":"For every model request, the content sent to the model provider SHALL be only the content that the tenant policy permits for the read of the person the request serves.","rationale":"Tenant content reaches a model only as far as a read by that person would reach.","evaluate":{"method":"property"},"ref":"CNV-233","area":"09-conversation","section":"Model provider","lifecycle":"active","boundary":"b-201","boundaryDetail":"`model request`","traces":["k-200","g-205"],"milestone":7,"inSection":"sec-conversation-8"},
    {"id":"cnv-234","kind":"requirement","statement":"A tenant that turns the assistant off SHALL have every conversation refused and no model request made, while its records stay readable.","rationale":"Turning the assistant off stops the disclosure and loses nothing.","evaluate":{"method":"scenario"},"ref":"CNV-234","area":"09-conversation","section":"Model provider","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /conversations/{id}/turns`","traces":["g-205"],"milestone":7,"inSection":"sec-conversation-8"},
    {"id":"cnv-235","kind":"requirement","statement":"The conversation service SHALL send tenant content to a model provider only under a contract that forbids the provider to train a model on that content.","rationale":"Tenant content is not training material unless the tenant contract says so.","evaluate":{"method":"property"},"ref":"CNV-235","area":"09-conversation","section":"Model provider","lifecycle":"active","boundary":"b-201","boundaryDetail":"`model request`","traces":["g-205"],"milestone":7,"inSection":"sec-conversation-8"},
    {"id":"cnv-236","kind":"requirement","statement":"Each reply SHALL name the model provider and the model that produced it.","rationale":"A person can see which system answered.","evaluate":{"method":"example"},"ref":"CNV-236","area":"09-conversation","section":"Model provider","lifecycle":"active","boundary":"b-200","boundaryDetail":"`reply`","traces":["g-205"],"milestone":7,"inSection":"sec-conversation-8"},
    {"id":"cnv-237","kind":"requirement","statement":"The conversation SHALL announce a streamed reply in a live region that receives one message when the reply starts and one when it ends.","rationale":"A reply that announces every part floods a screen reader.","evaluate":{"method":"example"},"ref":"CNV-237","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`live region`","traces":["g-204"],"milestone":7,"inSection":"sec-conversation-9"},
    {"id":"cnv-238","kind":"requirement","statement":"Every control of the conversation SHALL be operable with the keyboard alone.","rationale":"A conversation that needs a pointer is not usable by everyone.","evaluate":{"method":"example"},"ref":"CNV-238","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`conversation controls`","traces":["g-204"],"milestone":7,"inSection":"sec-conversation-9"},
    {"id":"cnv-239","kind":"requirement","statement":"When a preview appears in answer to a message the person sent, focus SHALL move to it, and an unasked preview is announced without moving focus.","rationale":"Focus moves only when the person asked for the result.","evaluate":{"method":"scenario"},"ref":"CNV-239","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`preview`","traces":["g-204"],"milestone":7,"inSection":"sec-conversation-9"},
    {"id":"cnv-240","kind":"requirement","statement":"The live region of the conversation SHALL announce no more than one message per 10 seconds while a reply streams.","rationale":"A bounded announcement rate keeps a screen reader usable during a long reply.","evaluate":{"method":"budget"},"ref":"CNV-240","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`live region`","traces":["g-204"],"milestone":7,"inSection":"sec-conversation-9"},
    {"id":"cnv-241","kind":"requirement","statement":"Motion in the conversation SHALL stop while the person prefers reduced motion.","rationale":"Reduced motion is a setting the platform honours.","evaluate":{"method":"example"},"ref":"CNV-241","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`conversation`","traces":["g-204"],"milestone":7,"inSection":"sec-conversation-9"},
    {"id":"cnv-242","kind":"requirement","statement":"A stream SHALL resume within 3 seconds at the 95th percentile after a dropped connection is restored.","rationale":"Poor networks drop connections, and the reply should carry on from where it stopped.","evaluate":{"method":"budget"},"ref":"CNV-242","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`GET /conversations/{id}/stream`","traces":["g-204"],"milestone":7,"inSection":"sec-conversation-9"},
    {"id":"cnv-243","kind":"requirement","statement":"Every control of the conversation SHALL have a target of at least 24 CSS pixels in each direction at a width of 360 CSS pixels.","rationale":"The minimum target size of WCAG 2.2 at the narrowest phone width the platform supports.","evaluate":{"method":"budget"},"ref":"CNV-243","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`conversation controls`","traces":["g-204"],"milestone":7,"inSection":"sec-conversation-9"},
    {"id":"cnv-244","kind":"requirement","statement":"A reply SHALL reflow without horizontal scrolling at a width of 360 CSS pixels.","rationale":"A long reply does not need sideways scrolling on a phone.","evaluate":{"method":"budget"},"ref":"CNV-244","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`reply`","traces":["g-204"],"milestone":7,"inSection":"sec-conversation-9"},
    {"id":"cnv-245","kind":"requirement","statement":"While the connection is lost, the conversation SHALL keep the drafted message and send it once when the connection returns, with no duplicate turn.","rationale":"A message written on a train arrives once.","evaluate":{"method":"scenario"},"ref":"CNV-245","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`draft`","traces":["g-204"],"milestone":7,"inSection":"sec-conversation-9"},
    {"id":"cnv-246","kind":"requirement","statement":"A reply SHALL follow the language of the message it answers, and the interface text of the conversation follows the language the person chose.","rationale":"Localisation of the conversation follows the localisation of content (G-34).","evaluate":{"method":"example"},"ref":"CNV-246","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`reply`","traces":["g-34","g-204"],"milestone":8,"inSection":"sec-conversation-9"},
    {"id":"cnv-247","kind":"requirement","statement":"A new tenant SHALL be set up through the conversation by choosing a template, defining its content types and inviting people, with each step applied only after the person confirms it.","rationale":"Onboarding uses the same previews and confirmations as every other change.","evaluate":{"method":"scenario"},"ref":"CNV-247","area":"09-conversation","section":"Onboarding","lifecycle":"active","boundary":"b-200","boundaryDetail":"`conversation`","traces":["g-207","g-2"],"milestone":8,"inSection":"sec-conversation-10"},
    {"id":"cnv-248","kind":"requirement","statement":"Text from a source outside the tenant, such as a received email or a fetched web page, SHALL be shown with a label that names its source wherever the conversation presents it.","rationale":"The person sees that text came from outside the tenant. This is the interface half of the defence against injected instructions.","evaluate":{"method":"example"},"ref":"CNV-248","area":"09-conversation","section":"Untrusted content","lifecycle":"active","boundary":"b-200","boundaryDetail":"`reply`","traces":["k-12","g-200"],"milestone":7,"inSection":"sec-conversation-11"},
    {"id":"uxa-200","kind":"requirement","statement":"An empty list in the authoring application SHALL name what it will hold and offer the action that fills it.","rationale":"An empty list that says nothing tells a person nothing.","evaluate":{"method":"example"},"ref":"UXA-200","area":"09-conversation","section":"Empty states, errors and sign-in","lifecycle":"active","boundary":"b-13","boundaryDetail":"`authoring application list`","traces":["g-206"],"milestone":8,"inSection":"sec-authoring-2"},
    {"id":"uxa-201","kind":"requirement","statement":"An error in the authoring application SHALL name the field or record it concerns and say how to correct it.","rationale":"An error that names no field sends the person looking for the problem.","evaluate":{"method":"example"},"ref":"UXA-201","area":"09-conversation","section":"Empty states, errors and sign-in","lifecycle":"active","boundary":"b-13","boundaryDetail":"`authoring application error`","traces":["g-206"],"milestone":8,"inSection":"sec-authoring-2"},
    {"id":"uxa-202","kind":"requirement","statement":"A sign-in error SHALL state the next step in words that do not depend on whether the address has an account.","rationale":"The person learns what to do without learning who has an account.","evaluate":{"method":"example"},"ref":"UXA-202","area":"09-conversation","section":"Empty states, errors and sign-in","lifecycle":"active","boundary":"b-13","boundaryDetail":"`POST /sign-in/{method}`","traces":["g-46","g-206"],"milestone":3,"inSection":"sec-authoring-2"},
    {"id":"uxa-203","kind":"requirement","statement":"The sign-in page SHALL offer recovery beside every sign-in method it offers, so that a person who has lost every method reaches recovery from the same page.","rationale":"A locked-out person needs recovery on the page they are already on.","evaluate":{"method":"example"},"ref":"UXA-203","area":"09-conversation","section":"Empty states, errors and sign-in","lifecycle":"active","boundary":"b-13","boundaryDetail":"`sign-in page`","traces":["g-46","g-206"],"milestone":3,"inSection":"sec-authoring-2"},
    {"id":"uxa-204","kind":"requirement","statement":"The authoring application SHALL save a draft within 2 seconds after the person's last edit.","rationale":"Autosave removes the fear of losing work without a save control.","evaluate":{"method":"budget"},"ref":"UXA-204","area":"09-conversation","section":"Drafts, saves and conflicts","lifecycle":"active","boundary":"b-13","boundaryDetail":"`draft`","traces":["g-206"],"milestone":8,"inSection":"sec-authoring-3"},
    {"id":"uxa-205","kind":"requirement","statement":"A draft not yet saved SHALL stay on screen through a connection loss and be sent when the connection returns.","rationale":"A dropped connection does not discard typed work.","evaluate":{"method":"scenario"},"ref":"UXA-205","area":"09-conversation","section":"Drafts, saves and conflicts","lifecycle":"active","boundary":"b-13","boundaryDetail":"`draft`","traces":["g-206"],"milestone":8,"inSection":"sec-authoring-3"},
    {"id":"uxa-206","kind":"requirement","statement":"When two people save changes to one record from the same version, the second save SHALL be refused with both versions shown.","rationale":"A silent overwrite is the defect that collaborative editing exists to prevent.","evaluate":{"method":"scenario"},"ref":"UXA-206","area":"09-conversation","section":"Drafts, saves and conflicts","lifecycle":"active","boundary":"b-202","boundaryDetail":"`PUT /records/{id}`","traces":["g-206","g-32"],"milestone":8,"inSection":"sec-authoring-3"},
    {"id":"uxa-207","kind":"requirement","statement":"A resolved conflict SHALL become a new version in which the person chose the value of each field that conflicted.","rationale":"The history records the decision and keeps the earlier versions.","evaluate":{"method":"scenario"},"ref":"UXA-207","area":"09-conversation","section":"Drafts, saves and conflicts","lifecycle":"active","boundary":"b-202","boundaryDetail":"`PUT /records/{id}`","traces":["g-206","g-32"],"milestone":8,"inSection":"sec-authoring-3"},
    {"id":"uxa-208","kind":"requirement","statement":"A change of another editor's presence SHALL appear in the authoring application within 3 seconds at the 95th percentile.","rationale":"Presence that lags says nothing about who is editing now.","evaluate":{"method":"budget"},"ref":"UXA-208","area":"09-conversation","section":"Drafts, saves and conflicts","lifecycle":"active","boundary":"b-202","boundaryDetail":"`presence`","traces":["g-206"],"milestone":8,"inSection":"sec-authoring-3"},
    {"id":"uxa-209","kind":"requirement","statement":"The authoring application SHALL show by display name each other person editing a record before the person starts editing it.","rationale":"Two people on one field are found before the second one types.","evaluate":{"method":"example"},"ref":"UXA-209","area":"09-conversation","section":"Drafts, saves and conflicts","lifecycle":"active","boundary":"b-202","boundaryDetail":"`presence`","traces":["g-206"],"milestone":8,"inSection":"sec-authoring-3"},
    {"id":"uxa-210","kind":"requirement","statement":"The authoring application SHALL mark a change shown before the server confirms it as pending, and withdraw it with its reason when the server refuses it.","rationale":"An optimistic change that is reverted without a reason teaches people not to trust the screen.","evaluate":{"method":"scenario"},"ref":"UXA-210","area":"09-conversation","section":"Drafts, saves and conflicts","lifecycle":"active","boundary":"b-13","boundaryDetail":"`save`","traces":["g-206"],"milestone":8,"inSection":"sec-authoring-3"},
    {"id":"uxa-211","kind":"requirement","statement":"A session that ends during editing SHALL keep the unsaved changes on screen and offer sign-in again without losing them.","rationale":"Revocation or expiry does not take unsaved work with it.","evaluate":{"method":"scenario"},"ref":"UXA-211","area":"09-conversation","section":"Sessions, destructive actions and layout","lifecycle":"active","boundary":"b-13","boundaryDetail":"`session`","traces":["g-9","g-206"],"milestone":8,"inSection":"sec-authoring-4"},
    {"id":"uxa-212","kind":"requirement","statement":"A destructive action SHALL name what it removes and require a confirmation that repeats that name.","rationale":"Deleting the wrong record is the most expensive mistake an author can make.","evaluate":{"method":"example"},"ref":"UXA-212","area":"09-conversation","section":"Sessions, destructive actions and layout","lifecycle":"active","boundary":"b-13","boundaryDetail":"`destructive action`","traces":["g-206"],"milestone":8,"inSection":"sec-authoring-4"},
    {"id":"uxa-213","kind":"requirement","statement":"The sign-in page SHALL show its first content within 1 second at the 95th percentile.","rationale":"Signing in is the one flow nobody can skip.","evaluate":{"method":"budget"},"ref":"UXA-213","area":"09-conversation","section":"Empty states, errors and sign-in","lifecycle":"active","boundary":"b-13","boundaryDetail":"`GET /sign-in`","traces":["g-45"],"milestone":3,"inSection":"sec-authoring-2"},
    {"id":"uxa-214","kind":"requirement","statement":"Each view of the authoring application SHALL reflow without horizontal scrolling at a width of 360 CSS pixels.","rationale":"Authors on a phone can read and edit every view.","evaluate":{"method":"budget"},"ref":"UXA-214","area":"09-conversation","section":"Sessions, destructive actions and layout","lifecycle":"active","boundary":"b-13","boundaryDetail":"`view`","traces":["g-45","g-206"],"milestone":8,"inSection":"sec-authoring-4"},
    {"id":"uxa-215","kind":"requirement","statement":"A throttling response to a reader SHALL carry a Retry-After value in seconds.","rationale":"A reader told when to try again does not reload in a loop.","evaluate":{"method":"example"},"ref":"UXA-215","area":"09-conversation","section":"Reader states","lifecycle":"active","boundary":"b-9","boundaryDetail":"`429`","traces":["g-4","g-204"],"milestone":6,"inSection":"sec-authoring-5"},
    {"id":"m-cv-applied-after-confirmation","kind":"invariant","models":"cnv-206","statement":"A change the assistant applied was confirmed by the person first.","evaluate":{"method":"state-invariant","scenarios":["cv-confirmed-apply","cv-unconfirmed-apply","cv-cancelled-preview"],"expr":"cv-change-flow.applied => cv-change-flow.confirmed","negatives":[{"scenario":"cv-unconfirmed-apply","faults":["defect-cv-apply-unconfirmed"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-cv-unconfirmed-never-applied","kind":"temporal","models":"cnv-206","statement":"A change applied before the person confirmed it never commits.","evaluate":{"method":"never","scenarios":["cv-unconfirmed-apply"],"occurs":{"event":"cv-applied"},"negatives":[{"scenario":"cv-unconfirmed-apply","faults":["defect-cv-apply-unconfirmed"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-cv-stale-authority-refused","kind":"temporal","models":"cnv-203","statement":"An operation whose permission was withdrawn before it runs never commits.","evaluate":{"method":"never","scenarios":["cv-withdrawn-before-run"],"occurs":{"event":"cv-operation-committed"},"negatives":[{"scenario":"cv-withdrawn-before-run","faults":["defect-cv-apply-stale"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-cv-permitted-operation-commits","kind":"temporal","models":"cnv-203","statement":"An operation run while its permission holds commits.","evaluate":{"method":"eventually","scenarios":["cv-permitted-run"],"occurs":{"event":"cv-operation-committed"},"negatives":[{"scenario":"cv-permitted-run","faults":["cv-run-disabled"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-conversation-reaches-data-through-store","kind":"structural","models":"cnv-226","statement":"Every path from the conversation service to a tenant database passes through the store contract.","evaluate":{"method":"only-via","from":"conversation-service","to":"tenant-database","via":"store-contract"},"assumptions":["a-model-abstraction"]},
    {"id":"m-browser-reaches-conversation-through-gateway","kind":"structural","models":"cnv-226","statement":"Every path from the web application to the conversation service passes through the gateway.","evaluate":{"method":"only-via","from":"web-application","to":"conversation-service","via":"gateway"},"assumptions":["a-model-abstraction"]},
    {"id":"m-model-provider-no-tenant-database","kind":"structural","models":"cnv-233","statement":"The model provider has no path to any tenant database.","evaluate":{"method":"no-relationship","from":"model-provider","to":"tenant-database","transitive":true},"assumptions":["a-model-abstraction"]},
    {"id":"idn-250","kind":"requirement","statement":"Password attempts from one source SHALL be refused across all accounts once the failures from that source reach the threshold the platform sets.","rationale":"A password sprayed across many accounts from one source is refused at the source.","evaluate":{"method":"scenario"},"ref":"IDN-250","area":"03-identity","section":"Guessing and enumeration","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/password`","traces":["g-251","d-252"],"milestone":3,"inSection":"sec-identity-250"},
    {"id":"idn-251","kind":"requirement","statement":"Password attempts across the accounts of one realm SHALL be slowed while their failure rate stays above the rate that the realm sets.","rationale":"Spraying is slowed for the whole realm, whichever source it comes from.","evaluate":{"method":"scenario"},"ref":"IDN-251","area":"03-identity","section":"Guessing and enumeration","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/password`","traces":["g-251","d-252"],"milestone":3,"inSection":"sec-identity-250"},
    {"id":"idn-252","kind":"requirement","statement":"A password chosen at sign-up or at a change SHALL be refused when it appears on the breached-password list that the realm uses.","rationale":"Passwords taken from other breaches are the ones guessing starts with.","evaluate":{"method":"example"},"ref":"IDN-252","area":"03-identity","section":"Guessing and enumeration","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-up`","traces":["g-251"],"milestone":3,"inSection":"sec-identity-250"},
    {"id":"idn-253","kind":"requirement","statement":"A one-time code SHALL be spent when its failed presentations reach the limit that the realm sets.","rationale":"A code that can be tried without end is a password with a short alphabet.","evaluate":{"method":"scenario"},"ref":"IDN-253","area":"03-identity","section":"Guessing and enumeration","lifecycle":"active","boundary":"b-4","boundaryDetail":"`one-time code`","traces":["g-251","k-4"],"milestone":3,"inSection":"sec-identity-250"},
    {"id":"idn-254","kind":"requirement","statement":"A one-time code SHALL be drawn at random for each challenge, so that a code of one challenge opens no other challenge.","rationale":"Codes drawn in sequence, or shared across challenges, can be predicted.","evaluate":{"method":"property"},"ref":"IDN-254","area":"03-identity","section":"Guessing and enumeration","lifecycle":"active","boundary":"b-4","boundaryDetail":"`one-time code`","traces":["g-251"],"milestone":3,"inSection":"sec-identity-250"},
    {"id":"idn-255","kind":"requirement","statement":"A password sign-in for an account that does not exist SHALL take as long to answer as a wrong password for an account that does exist.","rationale":"A difference in answer time tells an attacker which accounts exist.","evaluate":{"method":"scenario"},"ref":"IDN-255","area":"03-identity","section":"Guessing and enumeration","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/password`","traces":["g-252"],"milestone":3,"inSection":"sec-identity-250"},
    {"id":"idn-256","kind":"requirement","statement":"A sign-up request for an address that already has an account SHALL receive the response that a new address receives.","rationale":"Sign-up does not confirm which addresses hold accounts.","evaluate":{"method":"scenario"},"ref":"IDN-256","area":"03-identity","section":"Guessing and enumeration","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-up`","traces":["g-252"],"milestone":3,"inSection":"sec-identity-250"},
    {"id":"idn-257","kind":"requirement","statement":"The owner of an address SHALL be sent a notice when a sign-up or a recovery request names that address.","rationale":"The owner learns of the attempt even though the attacker learns nothing.","evaluate":{"method":"scenario"},"ref":"IDN-257","area":"03-identity","section":"Guessing and enumeration","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-up`","traces":["g-252","g-253"],"milestone":3,"inSection":"sec-identity-250"},
    {"id":"idn-258","kind":"requirement","statement":"A sign-in that succeeds from a source or a device the account has not used before SHALL send the account owner a notice.","rationale":"Credential stuffing that succeeds is visible to the owner at once.","evaluate":{"method":"scenario"},"ref":"IDN-258","area":"03-identity","section":"Guessing and enumeration","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/password`","traces":["g-253"],"milestone":3,"inSection":"sec-identity-250"},
    {"id":"idn-259","kind":"requirement","statement":"A session SHALL end when its idle lifetime or its absolute lifetime, whichever the realm sets shorter, has passed.","rationale":"A session left open on a shared machine is a session that someone else can use.","evaluate":{"method":"scenario"},"ref":"IDN-259","area":"03-identity","section":"Sessions, cookies and passkeys","lifecycle":"active","boundary":"b-4","boundaryDetail":"`sign-in session`","traces":["g-9","k-16"],"milestone":3,"inSection":"sec-identity-251"},
    {"id":"idn-260","kind":"requirement","statement":"A sensitive operation SHALL require a fresh authentication when its session appears from a network context that differs from the one that authenticated it.","rationale":"A session moved to another network is treated as a new arrival.","evaluate":{"method":"scenario"},"ref":"IDN-260","area":"03-identity","section":"Sessions, cookies and passkeys","lifecycle":"active","boundary":"b-4","boundaryDetail":"`realm policy`","traces":["g-8","g-253"],"milestone":3,"inSection":"sec-identity-251"},
    {"id":"idn-261","kind":"requirement","statement":"A session cookie SHALL be set without a domain attribute, so that the browser returns it only to the host that set it.","rationale":"A cookie with a parent domain reaches every sibling tenant and every host under it, and public suffix rules do not protect a platform's own tenants.","evaluate":{"method":"example"},"ref":"IDN-261","area":"03-identity","section":"Sessions, cookies and passkeys","lifecycle":"active","boundary":"b-4","boundaryDetail":"`strata_sid`","traces":["g-254","d-250","k-16"],"milestone":3,"inSection":"sec-identity-251"},
    {"id":"idn-262","kind":"requirement","statement":"A session cookie SHALL carry the host name prefix and the attribute that limits it to encrypted connections.","rationale":"The prefix stops another host from setting a cookie of the same name, and the attribute keeps it off plain connections.","evaluate":{"method":"example"},"ref":"IDN-262","area":"03-identity","section":"Sessions, cookies and passkeys","lifecycle":"active","boundary":"b-4","boundaryDetail":"`strata_sid`","traces":["g-254","k-16"],"milestone":3,"inSection":"sec-identity-251"},
    {"id":"idn-263","kind":"requirement","statement":"Sign-out SHALL revoke the session at the identity service, and not only the cookie in the browser.","rationale":"A copied cookie does not outlive the sign-out of its owner.","evaluate":{"method":"scenario"},"ref":"IDN-263","area":"03-identity","section":"Sessions, cookies and passkeys","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-out`","traces":["g-9","g-253"],"milestone":3,"inSection":"sec-identity-251"},
    {"id":"idn-264","kind":"requirement","statement":"A passkey assertion SHALL carry a challenge issued for that sign-in and bound to the address that the sign-in was requested at.","rationale":"A replayed assertion from another sign-in or another address is refused.","evaluate":{"method":"scenario"},"ref":"IDN-264","area":"03-identity","section":"Sessions, cookies and passkeys","lifecycle":"active","boundary":"b-4","boundaryDetail":"`WebAuthn relying party`","traces":["g-6","k-14"],"milestone":3,"inSection":"sec-identity-251"},
    {"id":"idn-265","kind":"requirement","statement":"Account recovery SHALL notify every registered contact of the account before it completes, after the delay that the realm sets.","rationale":"Recovery is the weakest factor, so the owner is told and given time to object.","evaluate":{"method":"scenario"},"ref":"IDN-265","area":"03-identity","section":"Recovery, factors and prompts","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /recovery`","traces":["g-253","g-46"],"milestone":3,"inSection":"sec-identity-252"},
    {"id":"idn-266","kind":"requirement","statement":"Account recovery SHALL leave the second factor of the realm in force at the next sign-in.","rationale":"Recovery of a password does not switch off the second factor.","evaluate":{"method":"scenario"},"ref":"IDN-266","area":"03-identity","section":"Recovery, factors and prompts","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /recovery`","traces":["g-8"],"milestone":3,"inSection":"sec-identity-252"},
    {"id":"idn-267","kind":"requirement","statement":"A realm that requires a second factor SHALL refuse a sign-in method that proves only one factor.","rationale":"A sign-in through a provider or an emailed link is not a way around the second factor.","evaluate":{"method":"scenario"},"ref":"IDN-267","area":"03-identity","section":"Recovery, factors and prompts","lifecycle":"active","boundary":"b-4","boundaryDetail":"`realm policy`","traces":["g-8"],"milestone":3,"inSection":"sec-identity-252"},
    {"id":"idn-268","kind":"requirement","statement":"The number of second-factor prompts sent to one account SHALL be limited by the realm within the window that the realm sets.","rationale":"Prompt flooding wears a person down until they approve one.","evaluate":{"method":"scenario"},"ref":"IDN-268","area":"03-identity","section":"Recovery, factors and prompts","lifecycle":"active","boundary":"b-4","boundaryDetail":"`second factor prompt`","traces":["g-253","g-8"],"milestone":3,"inSection":"sec-identity-252"},
    {"id":"idn-269","kind":"requirement","statement":"The emailed sign-in links requested for one address and those requested from one browser SHALL each be limited by the platform.","rationale":"Limits on both keys stop email bombing and the use of the link endpoint to flood a mailbox.","evaluate":{"method":"scenario"},"ref":"IDN-269","area":"03-identity","section":"Recovery, factors and prompts","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/link/request`","traces":["g-251","d-9"],"milestone":3,"inSection":"sec-identity-252"},
    {"id":"idn-270","kind":"requirement","statement":"Sign-up requests from one source SHALL be limited by the platform within a window.","rationale":"Sign-up is an abuse path for mail and for account creation.","evaluate":{"method":"scenario"},"ref":"IDN-270","area":"03-identity","section":"Recovery, factors and prompts","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-up`","traces":["g-251","g-262"],"milestone":3,"inSection":"sec-identity-252"},
    {"id":"fed-250","kind":"requirement","statement":"The return address of a federated sign-in SHALL name a path on the host of the tenant that started it, whichever protocol carried the sign-in.","rationale":"A return address that leaves the tenant turns a sign-in into an open redirect.","evaluate":{"method":"property"},"ref":"FED-250","area":"03-identity","section":"Messages and return addresses","lifecycle":"active","boundary":"b-5","boundaryDetail":"`return address`","traces":["g-255"],"milestone":4,"inSection":"sec-federation-250"},
    {"id":"fed-251","kind":"requirement","statement":"A SAML message SHALL be read with external entity and document type processing turned off.","rationale":"A message that names an external entity can read files of the platform or reach its network.","evaluate":{"method":"example"},"ref":"FED-251","area":"03-identity","section":"Messages and return addresses","lifecycle":"active","boundary":"b-5","boundaryDetail":"`POST /federation/saml/acs`","traces":["g-255"],"milestone":4,"inSection":"sec-federation-250"},
    {"id":"fed-252","kind":"requirement","statement":"A SAML sign-in SHALL take the subject and the attributes only from the assertion whose signature covers them.","rationale":"A signed assertion with an unsigned copy wrapped around it is the signature wrapping attack.","evaluate":{"method":"scenario"},"ref":"FED-252","area":"03-identity","section":"Messages and return addresses","lifecycle":"active","boundary":"b-5","boundaryDetail":"`POST /federation/saml/acs`","traces":["g-255"],"milestone":4,"inSection":"sec-federation-250"},
    {"id":"fed-253","kind":"requirement","statement":"The subject identifier of a SAML assertion SHALL be the complete text of its name identifier, with markup comments excluded.","rationale":"A comment inside the identifier does not split it into a name that another person holds.","evaluate":{"method":"example"},"ref":"FED-253","area":"03-identity","section":"Messages and return addresses","lifecycle":"active","boundary":"b-5","boundaryDetail":"`POST /federation/saml/acs`","traces":["g-255"],"milestone":4,"inSection":"sec-federation-250"},
    {"id":"fed-254","kind":"requirement","statement":"A SAML assertion SHALL be accepted only from the issuer that the provider configuration of the realm names.","rationale":"An assertion from a second provider that a tenant once trusted is not accepted for the first.","evaluate":{"method":"scenario"},"ref":"FED-254","area":"03-identity","section":"Messages and return addresses","lifecycle":"active","boundary":"b-5","boundaryDetail":"`POST /federation/saml/acs`","traces":["g-255"],"milestone":4,"inSection":"sec-federation-250"},
    {"id":"fed-255","kind":"requirement","statement":"An identity token SHALL be verified only with the signature method that the provider configuration names.","rationale":"A token that names a weaker or no signature method is the algorithm confusion attack.","evaluate":{"method":"scenario"},"ref":"FED-255","area":"03-identity","section":"Assertions and tokens checked","lifecycle":"active","boundary":"b-5","boundaryDetail":"`identity token`","traces":["g-255"],"milestone":4,"inSection":"sec-federation-251"},
    {"id":"fed-256","kind":"requirement","statement":"A signing key of one provider SHALL verify the tokens of that provider only.","rationale":"A key of one provider that verified another provider's tokens would let one tenant's provider sign in as another's.","evaluate":{"method":"scenario"},"ref":"FED-256","area":"03-identity","section":"Assertions and tokens checked","lifecycle":"active","boundary":"b-5","boundaryDetail":"`provider metadata`","traces":["g-255","g-20"],"milestone":4,"inSection":"sec-federation-251"},
    {"id":"fed-257","kind":"requirement","statement":"An email address that a provider asserts SHALL link to an existing principal only when the provider marks the address as verified.","rationale":"A provider that lets a person type any address into a claim can take over the account of that address.","evaluate":{"method":"scenario"},"ref":"FED-257","area":"03-identity","section":"Binding, provisioning and metadata","lifecycle":"active","boundary":"b-5","boundaryDetail":"`identity link`","traces":["g-255","g-46"],"milestone":4,"inSection":"sec-federation-252"},
    {"id":"fed-258","kind":"requirement","statement":"A principal created at a first federated sign-in SHALL receive only the default role that the realm names.","rationale":"Just-in-time creation does not grant the roles of an administrator.","evaluate":{"method":"scenario"},"ref":"FED-258","area":"03-identity","section":"Binding, provisioning and metadata","lifecycle":"active","boundary":"b-5","boundaryDetail":"`first federated sign-in`","traces":["g-7"],"milestone":4,"inSection":"sec-federation-252"},
    {"id":"fed-259","kind":"requirement","statement":"A provisioning token SHALL grant access to the provisioning endpoint of one realm and to no other endpoint.","rationale":"A token that provisions users can also read the realm's configuration if its scope is wider than provisioning.","evaluate":{"method":"scenario"},"ref":"FED-259","area":"03-identity","section":"Binding, provisioning and metadata","lifecycle":"active","boundary":"b-5","boundaryDetail":"`/scim/v2`","traces":["g-7"],"milestone":4,"inSection":"sec-federation-252"},
    {"id":"fed-260","kind":"requirement","statement":"A provisioning request SHALL change the roles of a principal only through the group mapping that the realm declares.","rationale":"A provisioning client cannot grant a role that no group of the realm maps to.","evaluate":{"method":"scenario"},"ref":"FED-260","area":"03-identity","section":"Binding, provisioning and metadata","lifecycle":"active","boundary":"b-5","boundaryDetail":"`/scim/v2/Groups`","traces":["g-7","g-263"],"milestone":4,"inSection":"sec-federation-252"},
    {"id":"fed-261","kind":"requirement","statement":"The metadata and the keys of a provider SHALL be fetched only from the address that the provider configuration names, through the outbound gate.","rationale":"A tenant that names an address on the platform's own network as its provider's metadata address would make the platform fetch from that network.","evaluate":{"method":"scenario"},"ref":"FED-261","area":"03-identity","section":"Binding, provisioning and metadata","lifecycle":"active","boundary":"b-252","boundaryDetail":"`provider metadata`","traces":["g-257","k-252"],"milestone":4,"inSection":"sec-federation-252"},
    {"id":"tok-250","kind":"requirement","statement":"A resource SHALL refuse an access token whose audience names a client other than the one presenting it.","rationale":"A token issued to one client is worthless to another client that holds it.","evaluate":{"method":"property"},"ref":"TOK-250","area":"03-identity","section":"Audience, compromise and clients","lifecycle":"active","boundary":"b-6","boundaryDetail":"`access token`","traces":["g-10","g-20"],"milestone":4,"inSection":"sec-tokens-250"},
    {"id":"tok-251","kind":"requirement","statement":"A compromised signing key SHALL be retired at once, so that the tokens it signed are refused from the moment of retirement.","rationale":"Rotation is for routine change; a compromised key needs an immediate cut.","evaluate":{"method":"scenario"},"ref":"TOK-251","area":"03-identity","section":"Audience, compromise and clients","lifecycle":"active","boundary":"b-6","boundaryDetail":"`GET /keys`","traces":["g-261","g-10"],"milestone":4,"inSection":"sec-tokens-250"},
    {"id":"tok-252","kind":"requirement","statement":"A client secret of a service account SHALL be stored only as a hash and shown once, when it is created.","rationale":"A stolen database yields no client secret, and a secret that is shown again is one more place it can leak.","evaluate":{"method":"example"},"ref":"TOK-252","area":"03-identity","section":"Audience, compromise and clients","lifecycle":"active","boundary":"b-6","boundaryDetail":"`POST /token`","traces":["g-10","k-4"],"milestone":4,"inSection":"sec-tokens-250"},
    {"id":"tok-253","kind":"requirement","statement":"The token endpoint SHALL limit the credential requests of each client within the window that the realm sets.","rationale":"Client credentials are guessed at the token endpoint as much as at sign-in.","evaluate":{"method":"scenario"},"ref":"TOK-253","area":"03-identity","section":"Audience, compromise and clients","lifecycle":"active","boundary":"b-6","boundaryDetail":"`POST /token`","traces":["g-251","g-10"],"milestone":4,"inSection":"sec-tokens-250"},
    {"id":"ten-250","kind":"requirement","statement":"A control plane operation that acts on one tenant SHALL be authorised by a grant that names that tenant.","rationale":"Lifecycle operations run by the platform are scoped to the tenant they touch.","evaluate":{"method":"scenario"},"ref":"TEN-250","area":"02-tenancy","section":"Operator access and tenant identifiers","lifecycle":"active","boundary":"b-3","boundaryDetail":"`tenant operation`","traces":["g-258","k-2"],"milestone":2,"inSection":"sec-tenancy-250"},
    {"id":"ten-251","kind":"requirement","statement":"A job, a wake notice or a file address carries the tenant identifier of the tenant it acts for, and its receiver SHALL refuse one that names another tenant.","rationale":"A tenant identifier that is only implied is one that a shared component can mix up.","evaluate":{"method":"property"},"ref":"TEN-251","area":"02-tenancy","section":"Operator access and tenant identifiers","lifecycle":"active","boundary":"b-16","boundaryDetail":"`wake notice`","traces":["g-20","k-2"],"milestone":2,"inSection":"sec-tenancy-250"},
    {"id":"ten-252","kind":"requirement","statement":"A backup of one tenant SHALL be unreadable with the key of any other tenant.","rationale":"Backups follow the tenant, and so do their keys.","evaluate":{"method":"scenario"},"ref":"TEN-252","area":"02-tenancy","section":"Operator access and tenant identifiers","lifecycle":"active","boundary":"b-3","boundaryDetail":"`POST /tenants/{id}/restore`","traces":["g-1","g-40","g-266"],"milestone":2,"inSection":"sec-tenancy-250"},
    {"id":"ten-253","kind":"requirement","statement":"A support or operator action that reads tenant content SHALL carry a grant from that tenant, with its use recorded in the audit log of that tenant.","rationale":"Support access is the most common way a tenant's content leaves its tenant.","evaluate":{"method":"scenario"},"ref":"TEN-253","area":"02-tenancy","section":"Operator access and tenant identifiers","lifecycle":"active","boundary":"b-250","boundaryDetail":"`support grant`","traces":["g-258","g-30","d-253"],"milestone":2,"inSection":"sec-tenancy-250"},
    {"id":"ten-254","kind":"requirement","statement":"A break-glass grant SHALL name the tenant, the purpose and the person, and it ends at its own expiry.","rationale":"An emergency grant without a name, a purpose and an end becomes standing access.","evaluate":{"method":"scenario"},"ref":"TEN-254","area":"02-tenancy","section":"Operator access and tenant identifiers","lifecycle":"active","boundary":"b-250","boundaryDetail":"`break-glass grant`","traces":["d-253","g-258"],"milestone":2,"inSection":"sec-tenancy-250"},
    {"id":"ten-255","kind":"requirement","statement":"A runtime instance SHALL hold database credentials only for the tenant databases of the placements it serves, issued for a lifetime that ends when it stops serving them.","rationale":"A compromised instance reaches only the tenants it was serving, and only while it serves them.","evaluate":{"method":"scenario"},"ref":"TEN-255","area":"02-tenancy","section":"Credentials and reach","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["g-266","k-3"],"milestone":2,"inSection":"sec-tenancy-251"},
    {"id":"ten-256","kind":"requirement","statement":"Each database credential SHALL open one tenant database and no other database of its cluster.","rationale":"A credential that opens a cluster opens every tenant on it.","evaluate":{"method":"property"},"ref":"TEN-256","area":"02-tenancy","section":"Credentials and reach","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["g-266","k-3"],"milestone":2,"inSection":"sec-tenancy-251"},
    {"id":"ten-257","kind":"requirement","statement":"A platform component acting for a tenant SHALL act only on the tenant that the credential authorising the call names.","rationale":"The confused deputy is a component that holds more authority than the call it is making.","evaluate":{"method":"property"},"ref":"TEN-257","area":"02-tenancy","section":"Credentials and reach","lifecycle":"active","boundary":"b-6","boundaryDetail":"`component credential`","traces":["g-266","k-6"],"milestone":2,"inSection":"sec-tenancy-251"},
    {"id":"sec-250","kind":"requirement","statement":"When the key service does not answer, the platform SHALL refuse each request that needs a data key and answer requests that need none.","rationale":"A key outage slows secret reads and blocks the reads that need a key, and nothing else.","evaluate":{"method":"scenario"},"ref":"SEC-250","area":"08-platform","section":"Keys under stress","lifecycle":"active","boundary":"b-17","boundaryDetail":"`data key`","traces":["g-261","g-4"],"milestone":3,"inSection":"sec-platform-250"},
    {"id":"sec-251","kind":"requirement","statement":"A tenant data key SHALL be rotated while the tenant reads and writes its records.","rationale":"Rotation that needs a pause is rotation that is not done.","evaluate":{"method":"scenario"},"ref":"SEC-251","area":"08-platform","section":"Keys under stress","lifecycle":"active","boundary":"b-17","boundaryDetail":"`data key`","traces":["g-261","g-40"],"milestone":3,"inSection":"sec-platform-250"},
    {"id":"sec-252","kind":"requirement","statement":"A compromised tenant data key SHALL be replaced by a key that protects every record the old key protected.","rationale":"A replacement that leaves some records under the compromised key leaves them open.","evaluate":{"method":"scenario"},"ref":"SEC-252","area":"08-platform","section":"Keys under stress","lifecycle":"active","boundary":"b-17","boundaryDetail":"`destroy key`","traces":["g-261","g-40"],"milestone":3,"inSection":"sec-platform-250"},
    {"id":"sec-253","kind":"requirement","statement":"A request whose address carries a session secret, a token or a one-time code SHALL be refused.","rationale":"Addresses are written to logs, histories and referrers, so a secret in one is a secret in all of them.","evaluate":{"method":"example"},"ref":"SEC-253","area":"08-platform","section":"Secrets in addresses","lifecycle":"active","boundary":"b-4","boundaryDetail":"`request address`","traces":["k-250"],"milestone":3,"inSection":"sec-platform-251"},
    {"id":"cms-250","kind":"requirement","statement":"A link in tenant rich text SHALL carry only the web and mail schemes.","rationale":"A link with a script scheme runs script in the reader's page when it is followed.","evaluate":{"method":"example"},"ref":"CMS-250","area":"07-content","section":"Markup and expressions","lifecycle":"active","boundary":"b-9","boundaryDetail":"`strata_substrate::markdown::parse`","traces":["k-12"],"milestone":2,"inSection":"sec-content-250"},
    {"id":"cms-251","kind":"requirement","statement":"A tenant expression, constraint or workflow guard SHALL read only the fields of the record it is evaluated on and the values that the kernel passes to it.","rationale":"Tenant expressions are data reach: they read no other record and no platform state.","evaluate":{"method":"property"},"ref":"CMS-251","area":"07-content","section":"Markup and expressions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["g-20","g-31"],"milestone":2,"inSection":"sec-content-250"},
    {"id":"cms-252","kind":"requirement","statement":"A tenant expression SHALL be evaluated under a step budget, and an evaluation that exhausts the budget is refused.","rationale":"A loop written by a tenant is bounded by steps, so one expression cannot hold a worker.","evaluate":{"method":"scenario"},"ref":"CMS-252","area":"07-content","section":"Markup and expressions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["g-4","g-31"],"milestone":2,"inSection":"sec-content-250"},
    {"id":"cms-253","kind":"requirement","statement":"Tenant template text SHALL be rendered only by the substrate expression interpreter, and no tenant text reaches the evaluator of the host language.","rationale":"Template text that reaches the host language's evaluator runs code from the tenant.","evaluate":{"method":"property"},"ref":"CMS-253","area":"07-content","section":"Markup and expressions","lifecycle":"active","boundary":"b-9","boundaryDetail":"`view`","traces":["k-251","g-31"],"milestone":2,"inSection":"sec-content-250"},
    {"id":"cms-254","kind":"requirement","statement":"A query over tenant records SHALL bind each value it receives as data, so that no value becomes part of the query text.","rationale":"A value that becomes query text changes what the query reads.","evaluate":{"method":"property"},"ref":"CMS-254","area":"07-content","section":"Queries and patterns","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["g-31","g-20"],"milestone":2,"inSection":"sec-content-251"},
    {"id":"cms-255","kind":"requirement","statement":"A query that would read more records than its plan allows SHALL be refused before it reads them.","rationale":"Expensive queries are refused by their plan before they cost the platform anything.","evaluate":{"method":"scenario"},"ref":"CMS-255","area":"07-content","section":"Queries and patterns","lifecycle":"active","boundary":"b-9","boundaryDetail":"`named query`","traces":["g-4"],"milestone":2,"inSection":"sec-content-251"},
    {"id":"cms-256","kind":"requirement","statement":"A pattern that a tenant supplies SHALL be evaluated by an engine whose running time grows linearly with the length of its input.","rationale":"A pattern with exponential backtracking holds a worker for as long as the pattern is written to.","evaluate":{"method":"property"},"ref":"CMS-256","area":"07-content","section":"Queries and patterns","lifecycle":"active","boundary":"b-9","boundaryDetail":"`named query`","traces":["g-4"],"milestone":2,"inSection":"sec-content-251"},
    {"id":"cms-257","kind":"requirement","statement":"A file name that a tenant supplies SHALL be stored as data and escaped wherever the platform shows it.","rationale":"A file name is tenant text, so it is treated like any other tenant text.","evaluate":{"method":"example"},"ref":"CMS-257","area":"07-content","section":"Uploads","lifecycle":"active","boundary":"b-14","boundaryDetail":"`file store`","traces":["g-260"],"milestone":8,"inSection":"sec-content-252"},
    {"id":"cms-258","kind":"requirement","statement":"A file of a markup or script capable media type SHALL be delivered only from the file domain of the platform, under a sandboxed policy.","rationale":"A script in an uploaded SVG or HTML file runs with the authority of the host that serves it.","evaluate":{"method":"scenario"},"ref":"CMS-258","area":"07-content","section":"Uploads","lifecycle":"active","boundary":"b-251","boundaryDetail":"`file-domain delivery`","traces":["g-260","d-251","k-251"],"milestone":8,"inSection":"sec-content-252"},
    {"id":"cms-259","kind":"requirement","statement":"A tenant host name SHALL serve no file that a tenant uploaded.","rationale":"A tenant host carries the tenant's cookies, so an upload served there is a stored attack on its readers.","evaluate":{"method":"property"},"ref":"CMS-259","area":"07-content","section":"Uploads","lifecycle":"active","boundary":"b-251","boundaryDetail":"`file-domain delivery`","traces":["g-260","d-251"],"milestone":8,"inSection":"sec-content-252"},
    {"id":"cms-260","kind":"requirement","statement":"An uploaded file SHALL be released for delivery only after the upload scanner records a clean result for it.","rationale":"A file is untrusted until a scan has looked at it.","evaluate":{"method":"scenario"},"ref":"CMS-260","area":"07-content","section":"Uploads","lifecycle":"active","boundary":"b-251","boundaryDetail":"`release`","traces":["g-260"],"milestone":8,"inSection":"sec-content-252"},
    {"id":"cms-261","kind":"requirement","statement":"An upload SHALL be accepted only for a media type that its content confirms, and not only for the type it declares.","rationale":"A file declared as an image and carrying markup is refused on what it is.","evaluate":{"method":"example"},"ref":"CMS-261","area":"07-content","section":"Uploads","lifecycle":"active","boundary":"b-251","boundaryDetail":"`upload intake`","traces":["g-260"],"milestone":8,"inSection":"sec-content-252"},
    {"id":"cms-262","kind":"requirement","statement":"A rendition SHALL be produced by a process that holds no connector secret and no network access.","rationale":"A process that parses hostile images holds nothing worth taking.","evaluate":{"method":"scenario"},"ref":"CMS-262","area":"07-content","section":"Uploads","lifecycle":"active","boundary":"b-7","boundaryDetail":"`rendition job`","traces":["g-260","g-40"],"milestone":8,"inSection":"sec-content-252"},
    {"id":"cms-263","kind":"requirement","statement":"An archive or an image whose decompressed size exceeds the limit of the tenant plan SHALL be refused before it is fully expanded.","rationale":"A decompression bomb is refused by its declared size before it fills the disk.","evaluate":{"method":"scenario"},"ref":"CMS-263","area":"07-content","section":"Uploads","lifecycle":"active","boundary":"b-251","boundaryDetail":"`upload intake`","traces":["g-260","g-4"],"milestone":8,"inSection":"sec-content-252"},
    {"id":"gwy-250","kind":"requirement","statement":"A page response SHALL allow script only from the scripts whose hash or nonce the response declares.","rationale":"Structured content is the first defence; this is the second, and it stops script that a template or a reflected value adds.","evaluate":{"method":"example"},"ref":"GWY-250","area":"01-core","section":"Pages and browser requests","lifecycle":"active","boundary":"b-13","boundaryDetail":"`Content-Security-Policy`","traces":["k-12","g-250"],"milestone":2,"inSection":"sec-runtime-250"},
    {"id":"gwy-251","kind":"requirement","statement":"A page response SHALL forbid framing by other origins through the frame-ancestors directive.","rationale":"A framed sign-in page lets another site click for the reader.","evaluate":{"method":"example"},"ref":"GWY-251","area":"01-core","section":"Pages and browser requests","lifecycle":"active","boundary":"b-13","boundaryDetail":"`frame-ancestors`","traces":["g-250"],"milestone":2,"inSection":"sec-runtime-250"},
    {"id":"gwy-252","kind":"requirement","statement":"A page response SHALL restrict the base-uri, object-src and form-action directives to the page's own origin or to none.","rationale":"A base element or a form target on another origin moves the page's relative addresses or its submissions.","evaluate":{"method":"example"},"ref":"GWY-252","area":"01-core","section":"Pages and browser requests","lifecycle":"active","boundary":"b-13","boundaryDetail":"`base-uri`","traces":["g-250","k-12"],"milestone":2,"inSection":"sec-runtime-250"},
    {"id":"gwy-253","kind":"requirement","statement":"A page response SHALL require Trusted Types for script sinks.","rationale":"A string that reaches a script sink without a typed wrapper is the DOM cross-site scripting path.","evaluate":{"method":"example"},"ref":"GWY-253","area":"01-core","section":"Pages and browser requests","lifecycle":"active","boundary":"b-13","boundaryDetail":"`Trusted Types`","traces":["g-250"],"milestone":2,"inSection":"sec-runtime-250"},
    {"id":"gwy-254","kind":"requirement","statement":"A response SHALL state its media type and carry the header that forbids content sniffing.","rationale":"A browser that guesses a type runs an upload as a page.","evaluate":{"method":"example"},"ref":"GWY-254","area":"01-core","section":"Pages and browser requests","lifecycle":"active","boundary":"b-9","boundaryDetail":"`response`","traces":["g-250","g-260"],"milestone":2,"inSection":"sec-runtime-250"},
    {"id":"gwy-255","kind":"requirement","statement":"Each value reflected into a response SHALL be escaped for the place in the response where it appears.","rationale":"Escaping for the wrong place, such as HTML text inside a script, is still cross-site scripting.","evaluate":{"method":"property"},"ref":"GWY-255","area":"01-core","section":"Pages and browser requests","lifecycle":"active","boundary":"b-9","boundaryDetail":"`reflected value`","traces":["g-250"],"milestone":2,"inSection":"sec-runtime-250"},
    {"id":"gwy-256","kind":"requirement","statement":"A WebSocket upgrade SHALL be refused unless it carries the request token of the session.","rationale":"A socket opened from another site carries the cookie, and only the token proves the request came from the page.","evaluate":{"method":"scenario"},"ref":"GWY-256","area":"01-core","section":"Pages and browser requests","lifecycle":"active","boundary":"b-9","boundaryDetail":"`Origin`","traces":["g-46","g-250"],"milestone":2,"inSection":"sec-runtime-250"},
    {"id":"gwy-257","kind":"requirement","statement":"A sign-in request and a sign-out request SHALL carry a request token that the gateway issued to the browser.","rationale":"Login CSRF plants an attacker's session in the victim's browser, and forced sign-out is a nuisance attack.","evaluate":{"method":"scenario"},"ref":"GWY-257","area":"01-core","section":"Pages and browser requests","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-out`","traces":["g-46","g-253"],"milestone":2,"inSection":"sec-runtime-250"},
    {"id":"gwy-258","kind":"requirement","statement":"A delivery response SHALL allow cross-origin reads only from the origins that the tenant lists.","rationale":"A tenant's content read from an origin the tenant did not list is a copy made outside its control.","evaluate":{"method":"scenario"},"ref":"GWY-258","area":"01-core","section":"Requests, exports and limits","lifecycle":"active","boundary":"b-9","boundaryDetail":"`Access-Control-Allow-Origin`","traces":["g-20"],"milestone":2,"inSection":"sec-runtime-251"},
    {"id":"gwy-259","kind":"requirement","statement":"A request whose body exceeds the limit of its route SHALL be refused before the body is processed.","rationale":"Limits are applied before work is done, not after the body is read.","evaluate":{"method":"scenario"},"ref":"GWY-259","area":"01-core","section":"Requests, exports and limits","lifecycle":"active","boundary":"b-9","boundaryDetail":"`request body`","traces":["g-4","g-262"],"milestone":2,"inSection":"sec-runtime-251"},
    {"id":"gwy-260","kind":"requirement","statement":"Each absolute address that the gateway emits SHALL be built from the configured host of the tenant alone.","rationale":"A host header that the gateway echoes into a link is a way to poison the links of the next reader.","evaluate":{"method":"property"},"ref":"GWY-260","area":"01-core","section":"Requests, exports and limits","lifecycle":"active","boundary":"b-9","boundaryDetail":"`Host`","traces":["g-20","g-267"],"milestone":2,"inSection":"sec-runtime-251"},
    {"id":"gwy-261","kind":"requirement","statement":"The gateway SHALL refuse a request whose message framing the edge and the gateway read differently.","rationale":"Request smuggling depends on two components disagreeing about where one request ends.","evaluate":{"method":"scenario"},"ref":"GWY-261","area":"01-core","section":"Requests, exports and limits","lifecycle":"active","boundary":"b-9","boundaryDetail":"`request framing`","traces":["g-250","g-267"],"milestone":2,"inSection":"sec-runtime-251"},
    {"id":"gwy-262","kind":"requirement","statement":"An export file SHALL prefix each cell that begins with a formula character, so that a spreadsheet reads the cell as text.","rationale":"A cell that begins with an equals sign is run by the spreadsheet of the person who opens the export.","evaluate":{"method":"example"},"ref":"GWY-262","area":"01-core","section":"Requests, exports and limits","lifecycle":"active","boundary":"b-9","boundaryDetail":"`export`","traces":["g-264"],"milestone":2,"inSection":"sec-runtime-251"},
    {"id":"gwy-263","kind":"requirement","statement":"A client SHALL be refused a new WebSocket connection when it already holds the connections that the gateway allows it.","rationale":"Connection limits keep one client from holding the gateway's sockets.","evaluate":{"method":"scenario"},"ref":"GWY-263","area":"01-core","section":"Requests, exports and limits","lifecycle":"active","boundary":"b-9","boundaryDetail":"`WebSocket`","traces":["g-262","g-4"],"milestone":2,"inSection":"sec-runtime-251"},
    {"id":"edg-250","kind":"requirement","statement":"The edge key of a response SHALL include every request header that changes the response and no other request header.","rationale":"A header that changes the response but is not in the key lets one reader's response serve another.","evaluate":{"method":"property"},"ref":"EDG-250","area":"05-delivery","section":"Keys and paths","lifecycle":"active","boundary":"b-10","boundaryDetail":"`Vary`","traces":["g-267","d-16"],"milestone":6,"inSection":"sec-edge-250"},
    {"id":"edg-251","kind":"requirement","statement":"The edge key of a response SHALL be formed from the normalised path of the request that produced it.","rationale":"Two spellings of one path that get two keys let a private page be cached under a public name.","evaluate":{"method":"property"},"ref":"EDG-251","area":"05-delivery","section":"Keys and paths","lifecycle":"active","boundary":"b-10","boundaryDetail":"`edge key`","traces":["g-267","g-20"],"milestone":6,"inSection":"sec-edge-250"},
    {"id":"edg-252","kind":"requirement","statement":"A tenant domain binding SHALL be removed when its name stops resolving to the platform.","rationale":"A binding left behind after its name moves elsewhere serves the next owner's traffic.","evaluate":{"method":"scenario"},"ref":"EDG-252","area":"05-delivery","section":"Domains and headers","lifecycle":"active","boundary":"b-3","boundaryDetail":"`domain binding`","traces":["g-21","g-262"],"milestone":6,"inSection":"sec-edge-251"},
    {"id":"edg-253","kind":"requirement","statement":"A name that a removed tenant held SHALL be bound to another tenant only after proof of control is given again.","rationale":"A name that a departed tenant left is a name a new tenant can take over.","evaluate":{"method":"scenario"},"ref":"EDG-253","area":"05-delivery","section":"Domains and headers","lifecycle":"active","boundary":"b-3","boundaryDetail":"`domain binding`","traces":["g-21"],"milestone":6,"inSection":"sec-edge-251"},
    {"id":"edg-254","kind":"requirement","statement":"The platform SHALL issue a certificate for a tenant domain only when the certificate authority record of that domain permits it.","rationale":"A certificate issued against a record that does not name the platform is one the platform would not have issued.","evaluate":{"method":"scenario"},"ref":"EDG-254","area":"05-delivery","section":"Domains and headers","lifecycle":"active","boundary":"b-10","boundaryDetail":"`certificate`","traces":["g-21"],"milestone":6,"inSection":"sec-edge-251"},
    {"id":"edg-255","kind":"requirement","statement":"A response header value that a tenant supplies SHALL be refused when it contains a line break.","rationale":"A line break in a header value starts a second header, or a second response.","evaluate":{"method":"example"},"ref":"EDG-255","area":"05-delivery","section":"Domains and headers","lifecycle":"active","boundary":"b-10","boundaryDetail":"`response header`","traces":["k-12","g-250"],"milestone":6,"inSection":"sec-edge-251"},
    {"id":"agt-250","kind":"requirement","statement":"The agent gateway SHALL accept cross-origin requests only from the origins that the operator lists.","rationale":"An agent interface readable from any site is one a visited page can drive with the operator's credentials.","evaluate":{"method":"scenario"},"ref":"AGT-250","area":"06-agents","section":"Interfaces and inputs","lifecycle":"active","boundary":"b-11","boundaryDetail":"`Access-Control-Allow-Origin`","traces":["g-28","g-23"],"milestone":7,"inSection":"sec-agents-250"},
    {"id":"agt-251","kind":"requirement","statement":"An operation SHALL accept only the input fields that its input schema declares.","rationale":"A field the schema does not declare, set through JSON coercion, is a way to set what the operation was not meant to set.","evaluate":{"method":"property"},"ref":"AGT-251","area":"06-agents","section":"Interfaces and inputs","lifecycle":"active","boundary":"b-11","boundaryDetail":"`operation input`","traces":["g-263","g-24"],"milestone":7,"inSection":"sec-agents-250"},
    {"id":"agt-252","kind":"requirement","statement":"An approval SHALL be refused when the principal that gives it is the author of the proposal.","rationale":"Separation of duties: the author cannot clear their own change.","evaluate":{"method":"scenario"},"ref":"AGT-252","area":"06-agents","section":"Separation and reach","lifecycle":"active","boundary":"b-11","boundaryDetail":"`proposal`","traces":["g-263","g-26"],"milestone":7,"inSection":"sec-agents-251"},
    {"id":"agt-253","kind":"requirement","statement":"A change to a role, a policy or a schema SHALL be authorised only for a principal whose policies permit administering that object.","rationale":"A principal that can change its own policy has no limit on its authority.","evaluate":{"method":"scenario"},"ref":"AGT-253","area":"06-agents","section":"Separation and reach","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["g-263","k-13"],"milestone":7,"inSection":"sec-agents-251"},
    {"id":"agt-254","kind":"requirement","statement":"An export, a search result and a subscription SHALL include only the records that the policies of the requester permit reading.","rationale":"The read decision guards queries; exports, searches and subscriptions are reads too.","evaluate":{"method":"property"},"ref":"AGT-254","area":"06-agents","section":"Separation and reach","lifecycle":"active","boundary":"b-11","boundaryDetail":"`export`","traces":["g-263","g-20"],"milestone":7,"inSection":"sec-agents-251"},
    {"id":"wfl-250","kind":"requirement","statement":"A connector call SHALL connect only to the address that the outbound gate resolved and judged, so that a later resolution cannot change the target.","rationale":"A name that resolves to a private address on the second lookup defeats a check made on the first.","evaluate":{"method":"scenario"},"ref":"WFL-250","area":"04-automation","section":"Outbound calls","lifecycle":"active","boundary":"b-252","boundaryDetail":"`outbound gate`","traces":["g-257","k-252","d-254"],"milestone":5,"inSection":"sec-workflows-250"},
    {"id":"wfl-251","kind":"requirement","statement":"A connector SHALL refuse a redirect whose address the outbound rule does not allow.","rationale":"A permitted address that redirects to a forbidden one is the redirect bypass.","evaluate":{"method":"scenario"},"ref":"WFL-251","area":"04-automation","section":"Outbound calls","lifecycle":"active","boundary":"b-252","boundaryDetail":"`redirect`","traces":["g-257"],"milestone":5,"inSection":"sec-workflows-250"},
    {"id":"wfl-252","kind":"requirement","statement":"The outbound gate SHALL judge an address in its canonical numeric form, including mapped, encoded and cloud metadata forms.","rationale":"Alternate spellings of a private or metadata address are the usual way past a text check.","evaluate":{"method":"example"},"ref":"WFL-252","area":"04-automation","section":"Outbound calls","lifecycle":"active","boundary":"b-252","boundaryDetail":"`outbound rule`","traces":["g-257"],"milestone":5,"inSection":"sec-workflows-250"},
    {"id":"wfl-253","kind":"requirement","statement":"A connector call SHALL end when its response exceeds the size that the connector policy names or when the time that the policy names has passed.","rationale":"An external server that answers slowly or without end holds a worker.","evaluate":{"method":"scenario"},"ref":"WFL-253","area":"04-automation","section":"Outbound calls","lifecycle":"active","boundary":"b-252","boundaryDetail":"`response`","traces":["g-257","g-14"],"milestone":5,"inSection":"sec-workflows-250"},
    {"id":"wfl-254","kind":"requirement","statement":"A connector log entry SHALL omit the query and the userinfo of the address called, and every connector secret.","rationale":"Addresses carry tokens in their queries and passwords in their userinfo.","evaluate":{"method":"property"},"ref":"WFL-254","area":"04-automation","section":"Outbound calls","lifecycle":"active","boundary":"b-12","boundaryDetail":"`log line`","traces":["g-40","k-4"],"milestone":5,"inSection":"sec-workflows-250"},
    {"id":"wfl-255","kind":"requirement","statement":"A webhook delivery SHALL carry a timestamp by which the receiver refuses a repeat of an old delivery.","rationale":"A captured signed delivery replayed later is accepted unless the receiver has a time to compare against.","evaluate":{"method":"example"},"ref":"WFL-255","area":"04-automation","section":"Outbound calls","lifecycle":"active","boundary":"b-8","boundaryDetail":"`webhook`","traces":["g-13"],"milestone":5,"inSection":"sec-workflows-250"},
    {"id":"wfl-256","kind":"requirement","statement":"The connector runner SHALL reach no platform component other than the outbound gate, the key service and the mail service.","rationale":"A connector that reaches the platform's own components is a route from tenant automation into the platform.","evaluate":{"method":"scenario"},"ref":"WFL-256","area":"04-automation","section":"Reach","lifecycle":"active","boundary":"b-252","boundaryDetail":"`connector runner`","traces":["g-47","k-252"],"milestone":5,"inSection":"sec-workflows-251"},
    {"id":"thr-250","kind":"requirement","statement":"Every HTTP response of a platform component SHALL carry the security header set of its response class, including error and redirect responses.","rationale":"Headers left off error pages are headers an attacker can find.","evaluate":{"method":"property"},"ref":"THR-250","area":"09-threat","section":"Responses and transport","lifecycle":"active","boundary":"b-9","boundaryDetail":"`HTTP response`","traces":["g-250","g-256"],"milestone":2,"inSection":"sec-threat-251"},
    {"id":"thr-251","kind":"requirement","statement":"A connection to a platform endpoint SHALL negotiate only the protocol versions of TLS that the platform policy lists.","rationale":"An older protocol version is a downgrade that the endpoint refuses.","evaluate":{"method":"example"},"ref":"THR-251","area":"09-threat","section":"Responses and transport","lifecycle":"active","boundary":"b-10","boundaryDetail":"`TLS`","traces":["g-21","g-256"],"milestone":6,"inSection":"sec-threat-251"},
    {"id":"thr-252","kind":"requirement","statement":"The strict transport security header of a custom domain SHALL omit the preload and subdomain directives unless the tenant owner requests them in writing.","rationale":"A preloaded directive applies to every name under the domain, including the ones the tenant does not run.","evaluate":{"method":"example"},"ref":"THR-252","area":"09-threat","section":"Responses and transport","lifecycle":"active","boundary":"b-10","boundaryDetail":"`Strict-Transport-Security`","traces":["g-21"],"milestone":6,"inSection":"sec-threat-251"},
    {"id":"thr-253","kind":"requirement","statement":"The operator console SHALL accept connections only from the operations network.","rationale":"An administration interface on the public network is found by scanning.","evaluate":{"method":"scenario"},"ref":"THR-253","area":"09-threat","section":"Reachability","lifecycle":"active","boundary":"b-250","boundaryDetail":"`operator console`","traces":["g-256"],"milestone":7,"inSection":"sec-threat-252"},
    {"id":"thr-254","kind":"requirement","statement":"A deployment SHALL refuse a network connection from a component that the architecture does not name as a caller of the receiving component.","rationale":"Network policy is the architecture enforced, so an unnamed caller is refused at the network.","evaluate":{"method":"scenario"},"ref":"THR-254","area":"09-threat","section":"Reachability","lifecycle":"active","boundary":"b-19","boundaryDetail":"`network policy`","traces":["g-256"],"milestone":2,"inSection":"sec-threat-252"},
    {"id":"thr-255","kind":"requirement","statement":"A component image SHALL run only when its signature and its build provenance verify against the release key.","rationale":"An image that cannot be traced to its build is one that nobody can vouch for.","evaluate":{"method":"scenario"},"ref":"THR-255","area":"09-threat","section":"Supply chain","lifecycle":"active","boundary":"b-19","boundaryDetail":"`image`","traces":["g-259"],"milestone":2,"inSection":"sec-threat-253"},
    {"id":"thr-256","kind":"requirement","statement":"Each component image SHALL carry a software bill of materials that lists every package the image contains.","rationale":"A vulnerability in a package is found in the images that contain it only if the images say what they contain.","evaluate":{"method":"example"},"ref":"THR-256","area":"09-threat","section":"Supply chain","lifecycle":"active","boundary":"b-19","boundaryDetail":"`image`","traces":["g-259"],"milestone":2,"inSection":"sec-threat-253"},
    {"id":"thr-257","kind":"requirement","statement":"A release build SHALL fail when a dependency of the build carries a published vulnerability of a severity that the release policy blocks.","rationale":"The gate is in the build, so a known vulnerability cannot ship by default.","evaluate":{"method":"scenario"},"ref":"THR-257","area":"09-threat","section":"Supply chain","lifecycle":"active","boundary":"b-19","boundaryDetail":"`release build`","traces":["g-259"],"milestone":2,"inSection":"sec-threat-253"},
    {"id":"thr-258","kind":"requirement","statement":"A component SHALL run under a cloud identity that grants only the actions its deployment descriptor lists.","rationale":"A component that holds the whole account's rights is the reach of its worst bug.","evaluate":{"method":"scenario"},"ref":"THR-258","area":"09-threat","section":"Supply chain","lifecycle":"active","boundary":"b-19","boundaryDetail":"`infrastructure modules`","traces":["g-256","d-23"],"milestone":9,"inSection":"sec-threat-253"},
    {"id":"thr-259","kind":"requirement","statement":"An attempt to cross a tenant boundary SHALL raise an alert to the platform operators and be recorded as an audit entry.","rationale":"A boundary attempt is the earliest sign of a breach and needs a person watching for it.","evaluate":{"method":"scenario"},"ref":"THR-259","area":"09-threat","section":"Incidents and disclosure","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit entry`","traces":["g-30","g-266"],"milestone":7,"inSection":"sec-threat-254"},
    {"id":"thr-260","kind":"requirement","statement":"A security incident SHALL open an audit record that names the affected tenants and that the owner of each affected tenant is shown.","rationale":"A tenant hears of an incident from the record of it, not from a rumour.","evaluate":{"method":"scenario"},"ref":"THR-260","area":"09-threat","section":"Incidents and disclosure","lifecycle":"active","boundary":"b-12","boundaryDetail":"`GET /audit`","traces":["g-30","g-265"],"milestone":7,"inSection":"sec-threat-254"},
    {"id":"thr-261","kind":"requirement","statement":"The platform SHALL publish a disclosure policy that names a reporting address and the steps taken for affected tenants.","rationale":"A reporter who finds no address reports to a public forum instead.","evaluate":{"method":"example"},"ref":"THR-261","area":"09-threat","section":"Incidents and disclosure","lifecycle":"active","boundary":"b-13","boundaryDetail":"`disclosure policy`","traces":["g-265"],"milestone":2,"inSection":"sec-threat-254"},
    {"id":"thr-262","kind":"requirement","statement":"A tenant domain named in a takedown SHALL stop serving content and have its edge copies purged.","rationale":"A takedown that leaves the edge serving the content is not a takedown.","evaluate":{"method":"scenario"},"ref":"THR-262","area":"09-threat","section":"Abuse and takedown","lifecycle":"active","boundary":"b-10","boundaryDetail":"`purge`","traces":["g-262"],"milestone":6,"inSection":"sec-threat-255"},
    {"id":"thr-263","kind":"requirement","statement":"The published content of a tenant SHALL occupy none of the paths that the platform reserves for sign-in and federation.","rationale":"A tenant page at the sign-in path is a phishing page on the platform's own domain.","evaluate":{"method":"property"},"ref":"THR-263","area":"09-threat","section":"Abuse and takedown","lifecycle":"active","boundary":"b-9","boundaryDetail":"`reserved paths`","traces":["g-6","g-262"],"milestone":6,"inSection":"sec-threat-255"},
    {"id":"m-saml-assertion-single-use","kind":"invariant","models":"fed-006","statement":"A SAML assertion yields at most one session.","evaluate":{"method":"state-invariant","scenarios":["saml-replayed"],"expr":"saml-assertion-flow.sessions <= 1","negatives":[{"scenario":"saml-replayed","faults":["defect-saml-replay-accepted"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-provider-signatures"]},
    {"id":"m-guessing-throttled","kind":"invariant","models":"idn-250","statement":"A password guess is evaluated by no realm after its throttle has closed.","evaluate":{"method":"state-invariant","scenarios":["distributed-guessing"],"expr":"guess-throttle-flow.throttled == 0","negatives":[{"scenario":"distributed-guessing","faults":["defect-throttle-ignored"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-operator-console-private","kind":"structural","models":"thr-253","statement":"No public component and no gateway has a path to the operator console.","evaluate":{"method":"no-relationship","from":["web-application","agent","external-identity-provider","delivery-network","gateway","agent-gateway"],"to":"operator-console","transitive":true},"assumptions":["a-model-abstraction"]},
    {"id":"m-connector-runner-isolated","kind":"structural","models":"wfl-256","statement":"The connector runner has no path to a platform component other than the outbound gate, the key service and the mail service.","evaluate":{"method":"no-relationship","from":"connector-runner","to":["gateway","runtime","identity-service","control-plane","control-database","tenant-database","scheduler","workflow-engine","copy-store","file-store","audit-log","agent-gateway","operator-console","upload-scanner"],"transitive":true},"assumptions":["a-model-abstraction"]},
    {"id":"m-parties-by-identifier","kind":"structural","models":"agt-015","statement":"Every record that names a party to an act names it by principal identifier.","evaluate":{"method":"data-model","rules":["party-by-id"]},"assumptions":["a-model-abstraction"]}
  ],

  // ---- Glossary ----------------------------------------------------------------------------------
  "terms": [
    {"id":"term-tenant","term":"Tenant","definition":"an organisation's isolated installation: one database, one file namespace, one identity realm, one key."},
    {"id":"term-tenant-database","term":"Tenant database","definition":"the PostgreSQL database that holds everything a tenant owns: schema, records, events, journal, jobs, identity realm and audit log."},
    {"id":"term-control-plane","term":"Control plane","definition":"the component that owns the tenant directory and carries out tenant lifecycle operations."},
    {"id":"term-tenant-directory","term":"Tenant directory","definition":"the control plane's list of tenants with their state, placement and domain bindings."},
    {"id":"term-placement","term":"Placement","definition":"where a tenant's database and files are: cluster, region and database name."},
    {"id":"term-realm","term":"Realm","definition":"the set of principals, credentials and identity provider configurations of one tenant."},
    {"id":"term-principal","term":"Principal","definition":"an identity that can act: a person, a service account or an agent."},
    {"id":"term-sign-in-session","term":"Sign-in session","definition":"the record that says a browser has authenticated as a principal, identified by a secret the browser holds."},
    {"id":"term-assertion","term":"Assertion","definition":"a short-lived statement signed by the identity service saying which principal and session a request belongs to."},
    {"id":"term-access-token","term":"Access token","definition":"a signed, expiring statement of scopes issued to a service account or an agent."},
    {"id":"term-delegation","term":"Delegation","definition":"an agent acting for a person, with a token that names both and grants no more than the person holds."},
    {"id":"term-emailed-link","term":"Emailed link","definition":"a single-use sign-in link sent to an address."},
    {"id":"term-step-up","term":"Step-up","definition":"a fresh authentication asked for before a sensitive operation."},
    {"id":"term-job","term":"Job","definition":"one unit of scheduled work with a due time, a state and a recorded outcome."},
    {"id":"term-schedule","term":"Schedule","definition":"a rule that creates jobs: once at a time, or repeatedly."},
    {"id":"term-trigger","term":"Trigger","definition":"a subscription that creates a job when a matching domain event commits."},
    {"id":"term-lease","term":"Lease","definition":"a worker's time-limited claim on a job."},
    {"id":"term-fencing-token","term":"Fencing token","definition":"a number that rises with every lease on a job and is checked when a result is recorded."},
    {"id":"term-idempotency-key","term":"Idempotency key","definition":"a value that lets the receiver of an effect recognise a repeat."},
    {"id":"term-wake-index","term":"Wake index","definition":"the control plane's list of tenants with their next due time."},
    {"id":"term-workflow","term":"Workflow","definition":"a state machine held as tenant metadata whose steps the kernel decides."},
    {"id":"term-connector","term":"Connector","definition":"an adapter that carries out one kind of external effect, such as an HTTP call or a mail."},
    {"id":"term-stored-copy","term":"Stored copy","definition":"data kept outside the record that owns it so that reads are cheaper."},
    {"id":"term-shared-copy","term":"Shared copy","definition":"a stored copy served as stored to more than one reader."},
    {"id":"term-audience-class","term":"Audience class","definition":"the set of principals that a tenant's policies cannot tell apart for a given read."},
    {"id":"term-freshness-bound","term":"Freshness bound","definition":"the longest time a stored copy may differ from its source."},
    {"id":"term-erasure-point","term":"Erasure point","definition":"the moment by which a deletion has reached a stored copy."},
    {"id":"term-surrogate-key","term":"Surrogate key","definition":"a label on an edge copy by which it can be purged."},
    {"id":"term-edge-copy","term":"Edge copy","definition":"a stored copy held by the content delivery network."},
    {"id":"term-operation","term":"Operation","definition":"a named capability with an input schema, listed in the operation catalogue."},
    {"id":"term-operation-catalogue","term":"Operation catalogue","definition":"the machine-readable list of every operation, generated from platform code and tenant metadata."},
    {"id":"term-proposal","term":"Proposal","definition":"a change submitted for approval together with its projection."},
    {"id":"term-projection","term":"Projection","definition":"the result of replaying recorded or generated activity with and without a proposed change, and comparing."},
    {"id":"term-audit-log","term":"Audit log","definition":"the append-only, hash-chained record of security-relevant actions."},
    {"id":"term-correlation-identifier","term":"Correlation identifier","definition":"the value that ties together every record of one request."},
    {"id":"term-seam","term":"Seam","definition":"a boundary to infrastructure expressed as a contract with a conformance suite and adapters."},
    {"id":"term-adapter","term":"Adapter","definition":"an implementation of a seam for one piece of infrastructure."},
    {"id":"term-sandbox-tenant","term":"Sandbox tenant","definition":"a tenant started from a template by a new organisation, which its owner keeps or lets expire."},
    {"id":"term-staging-tenant","term":"Staging tenant","definition":"a tenant where configuration is prepared before it is promoted to its production tenant."},
    {"id":"term-environment","term":"Environment","definition":"a tenant of one kind within a set of tenants: production, staging or sandbox."},
    {"id":"term-draft","term":"Draft","definition":"a version of a record that is not yet published and that readers do not see."},
    {"id":"term-preview-link","term":"Preview link","definition":"an expiring address that shows one draft version of one record to a reader without an account."},
    {"id":"term-delivery-key","term":"Delivery key","definition":"a service account whose only permission is to read the published content of one site for one audience class."},
    {"id":"term-support-grant","term":"Support grant","definition":"a time-limited permission that a tenant owner issues to a platform operator for work in the tenant."},
    {"id":"term-notice","term":"Notice","definition":"a message about an event, sent by email or placed in an inbox, to a person who subscribed to it."},
    {"id":"term-inbox","term":"Inbox","definition":"the list of tasks and notices shown to one person in the platform."},
    {"id":"term-plan","term":"Plan","definition":"the set of quotas, trial terms and objectives that apply to a tenant."},
    {"id":"term-quota","term":"Quota","definition":"a limit on one metered quantity of a tenant, stated by its plan."},
    {"id":"term-webhook","term":"Webhook","definition":"an HTTP delivery of an event to an address, signed with a shared secret."},
    {"id":"term-redirect","term":"Redirect","definition":"a stored answer that sends a request for a former address to the current address of a page."},
    {"id":"term-submission","term":"Submission","definition":"the data a reader sends through a form on a site, stored as a record of the tenant."},
    {"id":"term-search-index","term":"Search index","definition":"the entries of one tenant from which its search queries are answered."},
    {"id":"term-archive","term":"Archive","definition":"a document with a manifest that holds the records, files or configuration of a tenant for export."},
    {"id":"term-assistant","term":"Assistant","definition":"a program that proposes changes and answers questions in a conversation, acting for one person with that person's delegated token."},
    {"id":"term-conversation","term":"Conversation","definition":"an ordered set of turns between one person and the assistant, kept as tenant data."},
    {"id":"term-turn","term":"Turn","definition":"one message of a conversation, from the person or from the assistant, with the replies and operations it produced."},
    {"id":"term-preview","term":"Preview","definition":"the projection of a proposed change, shown before the change is applied."},
    {"id":"term-confirmation","term":"Confirmation","definition":"the person's explicit answer to a preview, bound to that preview."},
    {"id":"term-pending-action","term":"Pending action","definition":"a proposed change waiting for a preview, a confirmation or an approval."},
    {"id":"term-model-provider","term":"Model provider","definition":"the service that generates a reply from messages and operation descriptions, reached through the model provider contract."},
    {"id":"term-evidence-class","term":"Evidence class","definition":"one of proven, reproduced, sound approximation, estimated or unknown: what stands behind a claim."}
  ],

