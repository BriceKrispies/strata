        },
        {
          "name": "htmlParts",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "textParts",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "rawMarkup",
          "type": "number",
          "initial": 0,
