// The Strata specification. One file, the authority for what the platform is to do.
// Exegra validates it, evaluates the m-... claims and runs the behaviour models.
// Concordance renders the documents below, lints the requirements and reconciles them with
// the code and with recorded test results. See specifications/README.md.
{
  "exegra": "0.1",

  "system": {
    "id": "strata",
    "name": "Strata",
    "version": "0.2-draft",
    "description": "Strata is a multi-tenant automation and content platform in which every tenant has a database of its own. Tenant structure is versioned data interpreted by one pure kernel. The platform is built so that agents can observe, explain and change it through the same typed, authorised operations people use, with every change simulated before it is applied and recorded after.",
    "generation": {
      "target": "rust",
      "wireCase": "snake_case",
      "errorKinds": {
        "unauthenticated": 401,
        "forbidden": 403,
        "not_found": 404,
        "conflict": 409,
        "invalid": 422,
        "throttled": 429,
        "unavailable": 503,
        "internal": 500
      },
      "errorBody": {
        "type": "api-error",
        "code": "code",
        "message": "message",
        "correlation": "correlation",
        "runtime": {
          "unauthenticated": "unauthenticated",
          "forbidden": "forbidden",
          "invalid-request": "invalid",
          "timeout": "unavailable",
          "unavailable": "unavailable",
          "internal": "internal"
        }
      },
      "gateway": {
        "prefix": "/api"
      },
      "developmentConditions": [
        "STRATA_DEV"
      ],
      "functionBranches": "gap"
    },
    "telemetry": {
      "format": "json-lines",
      "services": [
        {
          "id": "backend",
          "component": "runtime",
          "log": "var/logs/backend.jsonl"
        },
        {
          "id": "bff",
          "component": "gateway",
          "log": "var/logs/bff.jsonl"
        }
      ]
    }
  },

  "vocabulary": {
    "entityKinds": {
      "document": {
        "label": "Document",
        "section": "documents",
        "shape": "box",
        "color": "slate",
        "doc": "One Markdown file of the specification.",
        "properties": {
          "path": {
            "type": "string",
            "required": true,
            "label": "Path",
            "doc": "Relative to the repository root."
          },
          "title": {
            "type": "string",
            "label": "Title",
            "doc": "The first heading of the file."
          },
          "role": {
            "type": "enum",
            "values": [
              "whitepaper",
              "roadmap",
              "requirements",
              "cases",
              "glossary",
              "index"
            ],
            "required": true,
            "label": "Role"
          },
          "source": {
            "type": "string",
            "label": "Source",
            "doc": "File and line in the repository where this was imported from."
          }
        }
      },
      "section": {
        "label": "Section",
        "section": "sections",
        "shape": "chamfer",
        "color": "neutral",
        "doc": "One heading of a document and the Markdown under it, up to the next heading. Level 0 is the text before the first heading of a file.",
        "properties": {
          "title": {
            "type": "string",
            "label": "Title"
          },
          "level": {
            "type": "number",
            "required": true,
            "label": "Heading level"
          },
          "document": {
            "type": "ref",
            "ref": [
              "document"
            ],
            "required": true,
            "label": "Document"
          },
          "parent": {
            "type": "ref",
            "ref": [
              "section"
            ],
            "label": "Parent section"
          },
          "order": {
            "type": "number",
            "required": true,
            "label": "Order",
            "doc": "Position within the document."
          },
          "body": {
            "type": "text",
            "label": "Body",
            "doc": "The own Markdown of the section, verbatim. Lines imported as separate entities are replaced by one {{entity:<id>}} marker line each, which stands for that entity rendered from its properties."
          },
          "mentions": {
            "type": "list",
            "items": {
              "type": "ref",
              "ref": [
                "goal",
                "nonGoal",
                "boundary",
                "decision",
                "constraint",
                "openQuestion",
                "component",
                "releaseStage",
                "milestone",
                "claim"
              ]
            },
            "label": "Mentions",
            "doc": "Entities named in the body."
          },
          "source": {
            "type": "string",
            "label": "Source",
            "doc": "File and line in the repository where this was imported from."
          }
        }
      },
      "caseTable": {
        "label": "Case table",
        "section": "caseTables",
        "shape": "cylinder",
        "color": "teal",
        "doc": "A file under specifications/*/cases/: the table a conformance requirement reads.",
        "properties": {
          "path": {
            "type": "string",
            "required": true,
            "label": "Path"
          },
          "title": {
            "type": "string",
            "label": "Title"
          },
          "document": {
            "type": "ref",
            "ref": [
              "document"
            ],
            "required": true,
            "label": "Document"
          },
          "body": {
            "type": "text",
            "required": true,
            "label": "Body",
            "doc": "The whole file, verbatim."
          },
          "columns": {
            "type": "list",
            "items": {
              "type": "string"
            },
            "label": "Columns",
            "doc": "Header cells of the first table of the file."
          },
          "rowCount": {
            "type": "number",
            "label": "Rows",
            "doc": "Data rows of the first table of the file."
          },
          "source": {
            "type": "string",
            "label": "Source",
            "doc": "File and line in the repository where this was imported from."
          }
        }
      },
      "term": {
        "label": "Term",
        "section": "terms",
        "shape": "capsule",
        "color": "blue",
        "doc": "A glossary entry, from the glossary document (doc-glossary) of the specification or the Glossary section of the white paper.",
