      "value": [
        {
          "define-automation": {
            "id": "award",
            "label": "Award",
            "run-as": {
              "roles": [
                "editor"
              ]
            },
            "start": "make",
            "steps": {
              "make": {
                "action": {
                  "create-record": {
                    "object": "note",
                    "fields": {
                      "title": {
                        "param": "owner"
                      },
                      "status": {
                        "lit": {
                          "str": "draft"
                        }
                      }
                    }
                  }
                },
                "next": "check"
              },
              "check": {
                "action": {
                  "branch": {
                    "condition": {
                      "cmp": {
                        "op": "eq",
                        "left": {
                          "var": {
                            "scope": "record",
                            "field": "status"
                          }
                        },
                        "right": {
                          "lit": {
                            "str": "draft"
                          }
                        }
                      }
                    },
                    "object": "note",
                    "record": {
                      "param": "make_record"
                    },
                    "then": "done",
                    "else": "done"
                  }
                }
              },
              "done": {
                "action": "end"
              }
            }
          }
        }
      ],
