    {
      "id": "create-tenant",
      "description": "transition.rs create_tenant: only the system creates a tenant (policy:builtin_system); a blank name (blank, the caller's str::trim().is_empty(), see intent-texts) is InvalidIntent intent:tenant_has_name; otherwise revision 1 and event 1: the tenant, the genesis schema and the owner holding the owner role.",
      "params": [
        {
          "name": "c",
          "type": "context"
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "owner",
          "type": "principal-id"
        },
        {
          "name": "blank",
          "type": "bool"
        }
      ],
      "returns": "transition-result",
      "errors": "rejection",
      "body": "match c.principal { system => if blank then fail(rejection.rejected(call refuse(error-kind.invalid-intent, 'intent:tenant_has_name', 'a tenant needs a name'))) else transition-result{delta: state-delta{tenant: c.tenant, new-revision: 1, next-record: 1, event-seq: 1, ops: [delta-op.create-tenant{name}, delta-op.put-schema(call genesis-schema()), delta-op.put-member{principal: owner, roles: ['owner']}]}, events: [domain-event{tenant: c.tenant, seq: 1, revision: 1, at: c.now, principal: c.principal, correlation: c.correlation, body: event-body.tenant-created{name}}], effects: [effect.publish{seq: 1}], evidence: [check{rule: 'policy:builtin_system', passed: true, detail: 'CreateTenant'}], output: output.tenant}, _ => fail(rejection.rejected(domain-error{kind: error-kind.unauthorized, message: 'only the system creates tenants', evidence: [check{rule: 'policy:builtin_system', passed: false, detail: 'CreateTenant'}]})) }",
      "examples": [
        {
          "description": "behaviour.rs only_the_system_creates_tenants_and_a_tenant_is_created_once.",
          "args": {
            "c": {
              "tenant": "gamma",
              "principal": "system",
              "session": null,
              "now": 5001,
              "correlation": "test-5001"
            },
            "name": "Gamma",
            "owner": "gamma:owner",
            "blank": false
          },
          "result": {
            "delta": {
              "tenant": "gamma",
              "base-revision": null,
              "new-revision": 1,
              "next-record": 1,
              "event-seq": 1,
              "ops": [
                {
                  "create-tenant": {
                    "name": "Gamma"
                  }
                },
                {
                  "put-schema": {
                    "version": 1,
                    "objects": {},
                    "roles": {
                      "owner": {
                        "id": "owner",
                        "label": "Owner"
                      },
                      "public": {
                        "id": "public",
                        "label": "Everyone"
                      }
                    },
                    "policies": {},
                    "workflows": {},
                    "queries": {},
                    "views": {}
                  }
                },
                {
                  "put-member": {
                    "principal": "gamma:owner",
                    "roles": [
                      "owner"
                    ]
                  }
                }
              ]
            },
            "events": [
              {
                "tenant": "gamma",
                "seq": 1,
                "revision": 1,
                "at": 5001,
                "principal": "system",
                "correlation": "test-5001",
                "body": {
                  "tenant-created": {
                    "name": "Gamma"
                  }
                }
              }
            ],
            "effects": [
              {
                "publish": {
                  "seq": 1
                }
              }
            ],
            "evidence": [
              {
                "rule": "policy:builtin_system",
                "passed": true,
                "detail": "CreateTenant"
              }
            ],
            "output": "tenant"
          }
        },
        {
          "description": "behaviour.rs only_the_system_creates_tenants_and_a_tenant_is_created_once: refused to a user, the owner of another tenant.",
          "args": {
            "c": {
              "tenant": "gamma",
              "principal": {
                "user": "alpha:owner"
              },
              "session": null,
              "now": 1,
              "correlation": "test-1"
            },
            "name": "Gamma",
            "owner": "gamma:owner",
            "blank": false
          },
          "error": {
            "rejected": {
              "kind": "unauthorized",
              "message": "only the system creates tenants",
              "evidence": [
                {
                  "rule": "policy:builtin_system",
                  "passed": false,
                  "detail": "CreateTenant"
                }
              ],
              "missing": null
            }
          }
        },
        {
          "description": "behaviour.rs every_rejection_lists_at_least_one_failed_check: tenant without a name (\" \").",
          "args": {
            "c": {
              "tenant": "gamma",
              "principal": "system",
              "session": null,
              "now": 5001,
              "correlation": "test-5001"
            },
            "name": " ",
            "owner": "gamma:owner",
            "blank": true
          },
          "error": {
            "rejected": {
              "kind": "invalid-intent",
              "message": "a tenant needs a name",
              "evidence": [
                {
                  "rule": "intent:tenant_has_name",
                  "passed": false,
                  "detail": "a tenant needs a name"
                }
              ],
              "missing": null
            }
          }
        }
      ]
    },
    {
