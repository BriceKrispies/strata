    {
      "id": "workflow-has-state",
      "description": "schema.rs WorkflowDef::states contains a state: an initial state, or the source or target of a transition.",
      "params": [
        {
          "name": "workflow",
          "type": "workflow-def"
        },
        {
          "name": "state",
          "type": "string"
        }
      ],
      "returns": "bool",
      "body": "any(s in workflow.initial, s == state) || any(t in workflow.transitions, t.from == state || t.to == state)",
      "examples": [
        {
          "args": {
            "workflow": {
              "id": "note_status",
              "object": "note",
              "field": "status",
              "initial": [
                "draft"
              ],
              "transitions": [
                {
                  "name": "publish",
                  "from": "draft",
                  "to": "published",
                  "guard": {
                    "cmp": {
                      "op": "eq",
                      "left": {
                        "var": {
                          "scope": "old",
                          "field": "$created_by"
                        }
                      },
                      "right": "principal"
                    }
                  },
                  "set": {
                    "published_at": "now"
                  }
                },
                {
                  "name": "unpublish",
                  "from": "published",
                  "to": "draft",
                  "set": {
                    "published_at": {
                      "lit": "null"
                    }
                  }
                }
              ]
            },
            "state": "published"
          },
          "result": true
        },
        {
          "args": {
            "workflow": {
              "id": "note_status",
              "object": "note",
              "field": "status",
              "initial": [
                "draft"
              ],
              "transitions": [
                {
                  "name": "publish",
                  "from": "draft",
                  "to": "published",
                  "guard": {
                    "cmp": {
                      "op": "eq",
                      "left": {
                        "var": {
                          "scope": "old",
                          "field": "$created_by"
                        }
                      },
                      "right": "principal"
                    }
                  },
                  "set": {
                    "published_at": "now"
                  }
                },
                {
                  "name": "unpublish",
                  "from": "published",
                  "to": "draft",
                  "set": {
                    "published_at": {
                      "lit": "null"
                    }
                  }
                }
              ]
            },
            "state": "archived"
          },
          "result": false
        }
      ]
    },
    {
      "id": "principal-value",
      "description": "expr.rs eval, Expr::Principal: the acting principal's id as a string for a user; null for an anonymous or system principal.",
      "params": [
        {
          "name": "who",
          "type": "principal"
        }
      ],
      "returns": "value",
      "body": "match who { user(id) => value.str(id), _ => call null-value() }",
      "examples": [
        {
          "args": {
            "who": {
              "user": "alpha:writer1"
            }
          },
          "result": {
            "str": "alpha:writer1"
          }
        },
        {
          "args": {
            "who": "anonymous"
          },
          "result": "null"
        }
      ]
    },
    {
      "id": "outcome-pass",
      "description": "rules.rs Validation::pass.",
      "params": [
        {
          "name": "acc",
          "type": "validation-outcome"
        },
        {
          "name": "rule",
          "type": "string"
        },
        {
          "name": "detail",
          "type": "string"
        }
      ],
      "returns": "validation-outcome",
      "body": "validation-outcome{passed: concat(acc.passed, [check{rule, passed: true, detail}]), failed: acc.failed}",
      "examples": [
        {
          "args": {
            "acc": {
              "passed": [],
              "failed": []
            },
            "rule": "type:note.title",
            "detail": "string"
          },
          "result": {
            "passed": [
              {
                "rule": "type:note.title",
                "passed": true,
                "detail": "string"
              }
            ],
            "failed": []
          }
        }
      ]
    },
    {
      "id": "outcome-fail",
      "description": "rules.rs Validation::fail.",
      "params": [
        {
          "name": "acc",
          "type": "validation-outcome"
        },
        {
          "name": "kind",
          "type": "error-kind"
        },
        {
          "name": "rule",
          "type": "string"
        },
        {
          "name": "detail",
          "type": "string"
        }
      ],
      "returns": "validation-outcome",
      "body": "validation-outcome{passed: acc.passed, failed: concat(acc.failed, [validation-failure{check: check{rule, passed: false, detail}, kind}])}",
      "examples": [
        {
          "args": {
            "acc": {
              "passed": [],
              "failed": []
            },
            "kind": "unknown-field",
            "rule": "field:note.nope",
            "detail": "no such field"
          },
          "result": {
            "passed": [],
            "failed": [
              {
                "check": {
                  "rule": "field:note.nope",
                  "passed": false,
                  "detail": "no such field"
                },
                "kind": "unknown-field"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "unknown-field-checks",
      "description": "rules.rs validate_record, first loop: a candidate field the object type does not declare is field:<object>.<field>, UnknownField.",
      "params": [
        {
          "name": "object",
          "type": "object-type-def"
        },
        {
          "name": "candidate",
          "type": "record"
        }
      ],
      "returns": "validation-outcome",
      "body": "fold(f in keys(candidate.fields), acc = validation-outcome{passed: [], failed: []}, if get(object.fields, f) == null then call outcome-fail(acc, error-kind.unknown-field, format('field:{}.{}', object.id, f), 'no such field') else acc)",
      "examples": [
        {
          "args": {
