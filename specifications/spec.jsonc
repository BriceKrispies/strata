              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "sc-pause-t-i",
          "from": "sc-live-i",
          "to": "sc-live-i",
          "on": "sc-pause",
          "otherwise": true,
          "effects": [
            {
              "set": "paused",
              "to": true
            },
            {
              "set": "createdAtPause",
              "to": "created"
            }
          ]
        },
        {
          "id": "sc-resume-without-job-i",
          "from": "sc-live-i",
          "to": "sc-live-i",
          "on": "sc-resume",
          "guard": "paused && created == completions",
          "effects": [
            {
              "set": "paused",
              "to": false
            },
            {
              "set": "created",
              "to": "created + 1"
            },
            {
              "emit": "sc-job-created",
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "sc-resume-with-job-i",
          "from": "sc-live-i",
          "to": "sc-live-i",
          "on": "sc-resume",
          "guard": "paused && created > completions",
          "effects": [
            {
              "set": "paused",
              "to": false
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "sc-live-i": "sc-live"
        },
        "variables": {
          "paused": "paused",
          "created": "created",
          "completions": "completions",
          "createdAtPause": "createdAtPause"
        },
        "transitions": {
          "sc-complete-paused-i": "sc-complete-paused",
          "sc-complete-i": "sc-complete",
          "sc-pause-t-i": "sc-pause-t",
          "sc-resume-without-job-i": "sc-resume-without-job",
          "sc-resume-with-job-i": "sc-resume-with-job"
        }
      },
      "storage": {
        "record": "rec-schedule",
        "key": "schedule-id",
        "fields": {
          "createdAtPause": "created-at-pause"
        }
      }
    },
    {
      "id": "trigger-commit-flow",
      "name": "Trigger jobs of a committed event",
      "subject": "automation-worker",
      "initial": "tg-live",
      "description": "One tenant with two triggers subscribed to its domain events. Committing an event creates the jobs of both triggers in the same step; an event whose transaction rolls back creates none.",
      "variables": [
        {
          "name": "committed",
          "type": "number",
          "initial": 0
        },
        {
          "name": "jobs",
          "type": "number",
          "initial": 0
        },
        {
          "name": "subscribers",
          "type": "number",
          "initial": 2
        }
      ],
      "states": [
        {
          "id": "tg-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "tg-commit-split",
          "from": "tg-live",
          "to": "tg-live",
          "on": "tg-commit",
          "description": "Defect: creates the jobs in a step after the commit.",
          "faultOnly": true,
          "effects": [
            {
              "set": "committed",
              "to": "committed + 1"
            },
            {
              "emit": "tg-create-jobs",
              "after": 1
            }
          ]
        },
        {
          "id": "tg-commit-t",
          "from": "tg-live",
          "to": "tg-live",
          "on": "tg-commit",
          "effects": [
            {
              "set": "committed",
              "to": "committed + 1"
            },
            {
              "set": "jobs",
              "to": "jobs + subscribers"
            },
            {
              "emit": "tg-jobs-created"
            }
          ]
        },
        {
          "id": "tg-abort-enqueues",
          "from": "tg-live",
          "to": "tg-live",
          "on": "tg-abort",
          "description": "Defect: creates the jobs before the outcome of the transaction is known.",
          "faultOnly": true,
          "effects": [
            {
              "set": "jobs",
              "to": "jobs + subscribers"
            }
          ]
        },
        {
          "id": "tg-abort-t",
          "from": "tg-live",
          "to": "tg-live",
          "on": "tg-abort",
          "effects": []
        },
        {
          "id": "tg-create-jobs-late",
          "from": "tg-live",
          "to": "tg-live",
          "on": "tg-create-jobs",
          "effects": [
            {
              "set": "jobs",
              "to": "jobs + subscribers"
            },
            {
              "emit": "tg-jobs-created"
            }
          ]
        }
      ]
    },
    {
