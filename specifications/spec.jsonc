    {"id":"ui-tenants-share-nothing","name":"A second tenant on the same substrate shares nothing with the first","verifies":["idn-009","run-002","run-001","cms-003"],"browsers":["visitor","owner","thief"],"description":"Journey of tests/e2e/site.spec.js, test 20: \"a second tenant on the same substrate shares nothing with the first\". Hand-written test keeps: the screenshot.","steps":[{"goto":{"screen":"screen-front-page","host":"tidewater.localhost:4200"}},{"expectTitle":{"text":"Tidewater Review"}},{"expectRole":{"role":"heading","level":2,"name":"High Water at Six"}},{"expectAttribute":{"attribute":"data-accent","value":"ink"}},{"expectAttribute":{"attribute":"data-paper","value":"stone"}},{"expectNoText":{"text":"The Jig Is the Work"}},{"goto":{"screen":"screen-sign-in","host":"tidewater.localhost:4200"}},{"fill":{"form":"form-sign-in","field":"login","value":"ines"}},{"fill":{"form":"form-sign-in","field":"password","value":"strata-dev-ines"}},{"submit":{"form":"form-sign-in"}},{"expectText":{"text":"The name or password is not right.","within":{"role":"alert"}}},{"switchBrowser":"owner"},{"goto":{"screen":"screen-sign-in"}},{"fill":{"form":"form-sign-in","field":"login","value":"admin"}},{"fill":{"form":"form-sign-in","field":"password","value":"strata-dev-admin"}},{"submit":{"form":"form-sign-in"}},{"expectRole":{"role":"heading","level":1,"name":"Writing desk"}},{"capture":{"name":"ownerSession","from":"cookie","cookie":"__Host-strata_sid"}},{"switchBrowser":"thief"},{"setCookie":{"name":"__Host-strata_sid","value":"${ownerSession}","host":"tidewater.localhost:4200","attributes":{"httpOnly":true,"secure":true,"sameSite":"Strict","path":"/"}}},{"goto":{"screen":"screen-desk","host":"tidewater.localhost:4200"}},{"expectRole":{"role":"heading","level":1,"name":"Sign in to continue"}},{"apiCall":{"method":"GET","host":"tidewater.localhost:4200","path":"/api/session","expectJson":{"session.authenticated":false}}},{"apiCall":{"method":"GET","host":"tidewater.localhost:4200","path":"/api/view?path=/desk","expectJson":{"data.posts":[]}}},{"apiCall":{"method":"GET","host":"tidewater.localhost:4200","path":"/api/view?path=/posts/tidewater-private-draft","expectJson":{"data.post":null}}},{"switchBrowser":"owner"},{"apiCall":{"method":"GET","path":"/api/view?path=/desk","expectBodyIncludes":["Notes Toward a Workbench"],"expectBodyExcludes":["Tidewater","High Water"]}},{"switchBrowser":"visitor"},{"goto":{"screen":"screen-front-page","host":"tidewater.localhost:4200"}},{"mark":"loaded"},{"expectAttribute":{"role":"status","name":"Live connection","attribute":"data-connection","value":"open"}},{"recordRequests":"tide"},{"switchBrowser":"owner"},{"click":{"role":"link","name":"Write a new article"}},{"fill":{"form":"form-new-article-publish","field":"title","value":"A Fieldnotes Secret"}},{"fill":{"form":"form-new-article-publish","field":"body","value":"Only for Fieldnotes."}},{"submit":{"form":"form-new-article-publish"}},{"expectText":{"text":"Published.","within":{"role":"region","name":"Messages"}}},{"switchBrowser":"visitor"},{"expectNoEvent":{"event":"rt-published","forMs":1200}},{"expectNoRequest":{"log":"tide","path":"/api/view"}},{"expectNoText":{"text":"A Fieldnotes Secret"}},{"expectNoReload":"loaded"},{"switchBrowser":"owner"},{"submit":{"form":"form-edit-article-unpublish"}},{"expectText":{"text":"Moved back to drafts.","within":{"role":"region","name":"Messages"}}}]},
    {"id":"ui-impact-lab","name":"The Impact Lab projects a schema change, explains the differences, and leaves live data alone","verifies":["sim-003","sim-004","krn-009","krn-010","idn-022"],"description":"Journey of tests/e2e/site.spec.js, test 21: \"the Impact Lab projects a schema change, explains the differences, and leaves live data alone\". Hand-written test keeps: that the diagnostics report lists at least four recent backend runs (numeric comparison on an API reply); that the first verdict read \"accepts the change\" before the re-run (asserted once, at the first run, instead); the screenshot.","steps":[{"goto":{"screen":"screen-sign-in"}},{"fill":{"form":"form-sign-in","field":"login","value":"tomasz"}},{"fill":{"form":"form-sign-in","field":"password","value":"strata-dev-tomasz"}},{"submit":{"form":"form-sign-in"}},{"expectRole":{"role":"heading","level":1,"name":"Writing desk"}},{"goto":{"screen":"screen-lab"}},{"expectRole":{"role":"heading","level":1,"name":"Your account cannot open this page"}},{"click":{"role":"button","name":"Sign out"}},{"expectText":{"text":"Signed out.","within":{"role":"region","name":"Messages"}}},{"goto":{"screen":"screen-sign-in"}},{"fill":{"form":"form-sign-in","field":"login","value":"admin"}},{"fill":{"form":"form-sign-in","field":"password","value":"strata-dev-admin"}},{"submit":{"form":"form-sign-in"}},{"expectRole":{"role":"heading","level":1,"name":"Writing desk"}},{"click":{"role":"link","name":"Impact Lab"}},{"expectRole":{"role":"heading","level":1,"name":"Impact Lab"}},{"expectText":{"pattern":"Fieldnotes at revision \\d+: schema version 2","within":{"role":"region","name":"Snapshot"}}},{"capture":{"name":"snapshot","from":"text","element":{"role":"region","name":"Snapshot"}}},{"click":{"role":"button","name":"Metadata"}},{"expectRole":{"role":"heading","level":2,"namePattern":"Post"}},{"expectRole":{"role":"row","namePattern":"post\\.excerpt string no no"}},{"expectText":{"text":"public_reads_published"}},{"axeScan":{}},{"click":{"role":"button","name":"Projection"}},{"fill":{"role":"textbox","name":"Proposed change","value":"require post.nonsense"}},{"click":{"role":"button","name":"Run the projection"}},{"expectText":{"text":"line 1: post has no field nonsense","within":{"role":"alert"}}},{"click":{"role":"button","name":"Require an excerpt on every article"}},{"expectAttribute":{"role":"textbox","name":"Proposed change","attribute":"value","value":"require post.excerpt"}},{"click":{"role":"checkbox","name":"Inject faults: lost commit races and dropped event deliveries"}},{"click":{"role":"button","name":"Run the projection"}},{"expectRole":{"role":"heading","level":2,"name":"What would change","timeoutMs":60000}},{"expectText":{"pattern":"The kernel accepts the change\\. \\d+ of 60 replayed operations then end differently\\.","within":{"role":"region","name":"What would change"}}},{"expectText":{"text":"Proven","within":{"role":"region","name":"What would change"}}},{"expectText":{"text":"Reproduced","within":{"role":"region","name":"What would change"}}},{"expectText":{"text":"Sound approximation","within":{"role":"region","name":"What would change"}}},{"expectText":{"text":"Estimated","within":{"role":"region","name":"What would change"}}},{"expectText":{"text":"Unknown","within":{"role":"region","name":"What would change"}}},{"expectRole":{"role":"row","namePattern":"post \\d+ Slow Software required:post\\.excerpt"}},{"expectText":{"text":"Rejected: MissingRequired","within":{"role":"row","namePattern":"first divergence"}}},{"expectText":{"text":"Smallest schedule found that still shows the first divergence"}},{"expectText":{"text":"Fails","within":{"role":"row","namePattern":"Every record has only known fields"}}},{"expectText":{"text":"Tenant isolation: every other tenant in the simulated world is identical in both executions."}},{"expectText":{"pattern":"60 of 6\\d steps agree when re-run against the bare kernel"}},{"expectText":{"pattern":"event deliveries dropped and retried; every event still arrived once, in order"}},{"axeScan":{}},{"click":{"role":"button","name":"Run the projection"}},{"expectText":{"text":"Projection finished","within":{"role":"region","name":"Messages"},"timeoutMs":60000}},{"click":{"role":"radio","name":"Refuse the change"}},{"click":{"role":"button","name":"Run the projection"}},{"expectText":{"pattern":"The kernel refuses the change: \\d+ existing record\\(s\\) would not conform to the new schema\\.","within":{"role":"region","name":"What would change"},"timeoutMs":60000}},{"click":{"role":"radio","name":"Leave them as they are"}},{"click":{"role":"radio","name":"What actually happened"}},{"click":{"role":"button","name":"Run the projection"}},{"expectText":{"pattern":"replayed operations then end differently","within":{"role":"region","name":"What would change"},"timeoutMs":60000}},{"expectText":{"text":"create record","within":{"role":"row","namePattern":"first divergence"}}},{"click":{"role":"button","name":"Evidence"}},{"click":{"role":"button","name":"Replay the journal"}},{"expectText":{"pattern":"committed operations replay to exactly the recorded result, and the replayed state is the live state\\."}},{"click":{"role":"button","name":"Diagnostics"}},{"expectRole":{"role":"heading","level":2,"name":"Kernel transitions"}},{"expectRole":{"role":"row","namePattern":"change_schema"}},{"capture":{"name":"sid","from":"cookie","cookie":"__Host-strata_sid"}},{"apiCall":{"method":"GET","path":"/api/diagnostics","expectStatus":200,"expectBodyExcludes":["${sid}","strata-dev-"]}},{"axeScan":{}},{"reload":{}},{"expectText":{"text":"${snapshot}","within":{"role":"region","name":"Snapshot"}}},{"click":{"role":"button","name":"Metadata"}},{"expectRole":{"role":"row","namePattern":"post\\.excerpt string no no"}}]},
    {"id":"ui-logs-hold-no-secrets","name":"No log line holds a password, a session token or a CSRF token","verifies":["idn-022","obs-001"],"description":"Journey of tests/e2e/site.spec.js, test 23: \"no log line holds a password, a session token or a CSRF token\". Hand-written test keeps: that the logs are longer than 1000 characters and that one correlation id appears in both the backend and the BFF log (cross-service log correlation).","steps":[{"goto":{"screen":"screen-sign-in"}},{"fill":{"form":"form-sign-in","field":"login","value":"ines"}},{"fill":{"form":"form-sign-in","field":"password","value":"strata-dev-ines"}},{"submit":{"form":"form-sign-in"}},{"expectRole":{"role":"heading","level":1,"name":"Writing desk"}},{"capture":{"name":"sid","from":"cookie","cookie":"__Host-strata_sid"}},{"apiCall":{"method":"GET","path":"/api/session","expectStatus":200,"capture":{"csrfToken":"session.csrf_token"}}},{"logScan":{"forbid":["${sid}","${csrfToken}","strata-dev-ines","strata-dev-admin","not-the-password"]}}]}
  ],

