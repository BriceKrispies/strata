          "mfp-open-i": "mfp-open"
        },
        "variables": {
          "count": "count",
          "windowStart": "windowStart / 60000",
          "limit": "limit",
          "windowOpen": "windowOpen"
        },
        "transitions": {
          "mfp-new-window-i": "mfp-new-window",
          "mfp-accept-i": "mfp-accept",
          "mfp-refuse-i": "mfp-refuse",
          "mfp-tighten-i": "mfp-tighten"
        },
        "timeScale": 60000
      },
      "storage": {
        "record": "rec-identity-limit",
        "key": "limit-key",
        "fields": {
          "windowStart": "window-started-at",
          "windowOpen": "window-open"
        },
        "creates": true
      },
      "realisation": "target"
    },
