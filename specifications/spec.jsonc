      ]
    },
    {
      "id": "schema-with-automations",
      "description": "The tenant schema with its automations replaced (the other members as they were).",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "automations",
          "type": "map<workflow-id, automation-def>"
        }
      ],
      "returns": "tenant-schema",
      "body": "tenant-schema{version: schema.version, objects: schema.objects, roles: schema.roles, role-permissions: schema.role-permissions, teams: schema.teams, invitations: schema.invitations, policies: schema.policies, workflows: schema.workflows, queries: schema.queries, views: schema.views, triggers: schema.triggers, automations: automations, operations: schema.operations, settings: schema.settings, capabilities: schema.capabilities, ledger: schema.ledger, mail-templates: schema.mail-templates, notice-templates: schema.notice-templates, tokens: schema.tokens, products: schema.products}",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-6"
            },
            "automations": {
              "award": {
                "id": "award",
                "label": "award",
                "run-as": {
                  "roles": [
                    "editor"
                  ]
                },
                "start": "done",
                "steps": {
                  "done": {
                    "action": "end"
                  }
                }
              }
            }
          },
          "result": {
            "version": 2,
            "objects": {
              "note": {
                "id": "note",
                "label": "Note",
                "fields": {
                  "author": {
                    "id": "author",
                    "label": "Author",
                    "ty": {
                      "ref": {
                        "target": "person",
                        "on-delete": "set-null"
                      }
                    },
                    "required": false,
                    "unique": false
                  },
                  "body": {
                    "id": "body",
                    "label": "body",
                    "ty": "str",
                    "required": false,
                    "unique": false
                  },
                  "published_at": {
                    "id": "published_at",
                    "label": "published_at",
                    "ty": "time",
                    "required": false,
                    "unique": false
                  },
                  "rank": {
                    "id": "rank",
                    "label": "rank",
                    "ty": "int",
                    "required": false,
                    "unique": false
                  },
                  "slug": {
                    "id": "slug",
                    "label": "slug",
                    "ty": "str",
                    "required": true,
                    "unique": true
                  },
                  "status": {
                    "id": "status",
                    "label": "status",
                    "ty": "str",
                    "required": true,
                    "unique": false,
                    "default": {
                      "lit": {
                        "str": "draft"
                      }
                    }
                  },
                  "title": {
                    "id": "title",
                    "label": "title",
                    "ty": "str",
                    "required": true,
                    "unique": false
                  }
                },
                "constraints": {
                  "title_length": {
                    "id": "title_length",
                    "expr": {
                      "cmp": {
                        "op": "le",
                        "left": {
                          "len": {
                            "var": {
                              "scope": "new",
                              "field": "title"
                            }
                          }
                        },
                        "right": {
                          "lit": {
                            "int": 24
                          }
                        }
                      }
                    },
                    "message": "A title has at most 24 characters"
                  }
                }
              },
              "person": {
                "id": "person",
                "label": "Person",
                "fields": {
                  "name": {
                    "id": "name",
                    "label": "name",
                    "ty": "str",
                    "required": true,
                    "unique": false
                  }
                },
                "constraints": {}
              }
            },
            "roles": {
              "editor": {
                "id": "editor",
                "label": "Editor"
              },
              "owner": {
                "id": "owner",
                "label": "Owner"
              },
              "public": {
                "id": "public",
                "label": "Everyone"
              },
              "writer": {
                "id": "writer",
                "label": "Writer"
              }
            },
            "policies": {
              "editors_manage_notes": {
                "id": "editors_manage_notes",
                "role": "editor",
                "resource": {
                  "object": "note"
                },
                "actions": [
                  "read",
                  "create",
                  "update",
                  "delete"
                ],
                "condition": null
              },
              "editors_manage_people": {
                "id": "editors_manage_people",
                "role": "editor",
                "resource": {
                  "object": "person"
                },
                "actions": [
                  "read",
                  "create",
                  "update",
                  "delete"
                ],
                "condition": null
              },
              "public_reads_people": {
                "id": "public_reads_people",
                "role": "public",
                "resource": {
                  "object": "person"
                },
                "actions": [
                  "read"
                ],
                "condition": null
              },
              "public_reads_published": {
                "id": "public_reads_published",
                "role": "public",
                "resource": {
                  "object": "note"
                },
                "actions": [
                  "read"
                ],
                "condition": {
                  "cmp": {
                    "op": "eq",
                    "left": {
                      "var": {
                        "scope": "record",
                        "field": "status"
                      }
                    },
                    "right": {
                      "lit": {
                        "str": "published"
                      }
                    }
                  }
                }
              },
              "writers_add_people": {
                "id": "writers_add_people",
                "role": "writer",
                "resource": {
                  "object": "person"
                },
                "actions": [
                  "create"
                ],
                "condition": null
              },
              "writers_edit_own": {
                "id": "writers_edit_own",
                "role": "writer",
                "resource": {
                  "object": "note"
                },
                "actions": [
                  "update",
                  "delete"
                ],
                "condition": {
                  "cmp": {
                    "op": "eq",
                    "left": {
                      "var": {
                        "scope": "record",
                        "field": "$created_by"
                      }
                    },
                    "right": "principal"
                  }
                }
              },
              "writers_read_notes": {
                "id": "writers_read_notes",
                "role": "writer",
                "resource": {
                  "object": "note"
                },
                "actions": [
                  "read",
                  "create"
                ],
                "condition": null
              }
            },
            "workflows": {
              "note_status": {
                "id": "note_status",
                "object": "note",
                "field": "status",
                "initial": [
                  "draft"
                ],
                "transitions": [
                  {
                    "name": "publish",
                    "from": "draft",
                    "to": "published",
                    "guard": {
                      "cmp": {
                        "op": "eq",
                        "left": "principal",
                        "right": {
                          "lit": {
                            "str": "alpha:editor"
                          }
                        }
                      }
                    },
                    "set": {
                      "published_at": "now"
                    }
                  },
                  {
                    "name": "unpublish",
                    "from": "published",
                    "to": "draft",
                    "guard": null,
                    "set": {
                      "published_at": {
                        "lit": "null"
                      }
                    }
                  }
                ]
              }
            },
            "queries": {},
            "views": {},
            "automations": {
              "award": {
                "id": "award",
                "label": "award",
                "run-as": {
                  "roles": [
                    "editor"
                  ]
                },
                "start": "done",
                "steps": {
                  "done": {
                    "action": "end"
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "id": "lost-authorities",
      "description": "triggers.rs lost_authority: the automations of a tenant (a state after a change) whose definer may no longer confer a role of their run-as under ADM-152, in id order (WFL-1529, CT-798): for each, the first role of the run-as, in id order, that may-confer refuses, and its detail. An automation that is already suspended, or that has no definer, is not checked.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        }
      ],
      "returns": "list<lost-authority>",
      "body": "fold(def in values(call automations-of(tenant.schema)), acc = [], match def.suspended-for { Some(_) => acc, None => match def.defined-by { None => acc, Some(definer) => match find(r in def.run-as.roles, !(call may-confer(tenant, principal.user(definer), r)).passed) { None => acc, Some(role) => concat(acc, [lost-authority{automation: def.id, definer, role, detail: (call may-confer(tenant, principal.user(definer), role)).detail}]) } } })",
      "examples": [
        {
          "description": "A definer who is the owner may confer every role: nothing is lost.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-28",
              "with": {
                "schema.automations.award.run-as.roles": [
                  "editor",
                  "writer"
                ]
              }
            }
          },
          "result": []
        },
        {
          "description": "A definer who holds none of the powers of editor has lost the authority.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-28",
              "with": {
                "schema.automations.award.defined-by": "alpha:writer1"
              }
            }
          },
          "result": [
            {
              "automation": "award",
              "definer": "alpha:writer1",
              "role": "editor",
              "detail": "lacks 4 of the 8 permissions that role editor grants: policy editors_manage_notes: Update on Object(ObjectTypeId(\"note\")), policy editors_manage_notes: Delete on Object(ObjectTypeId(\"note\")), policy editors_manage_people: Update on Object(ObjectTypeId(\"person\")), policy editors_manage_people: Delete on Object(ObjectTypeId(\"person\"))"
            }
          ]
        },
        {
          "description": "The first role in id order the definer may not confer is the one named.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-28",
              "with": {
                "schema.automations.award.run-as.roles": [
                  "editor",
                  "owner",
                  "writer"
                ],
                "schema.automations.award.defined-by": "alpha:editor"
              }
            }
          },
          "result": [
            {
              "automation": "award",
              "definer": "alpha:editor",
              "role": "owner",
              "detail": "only an owner confers the owner role"
            }
          ]
        },
        {
          "description": "An automation that is already suspended is not checked again.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-28",
              "with": {
                "schema.automations.award.defined-by": "alpha:writer1",
                "schema.automations.award.suspended-for": "editor"
              }
            }
          },
          "result": []
        },
        {
          "description": "An automation the system defined has no definer to check.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-28",
              "with": {
                "schema.automations.award": {
                  "id": "award",
                  "label": "award",
                  "run-as": {
                    "roles": [
                      "editor"
                    ]
                  },
                  "start": "done",
                  "steps": {
                    "done": {
                      "action": "end"
                    }
                  }
                }
              }
            }
          },
          "result": []
        },
        {
          "description": "A tenant without automations loses none.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-9"
            }
          },
          "result": []
        }
      ]
    },
    {
      "id": "split-publishes",
      "description": "The leading Publish effects of a list of effects, and the others: triggers.rs append_events places the Publish effect of an event it appends after the Publish effects already there.",
      "params": [
        {
          "name": "effects",
          "type": "list<effect>"
        }
      ],
      "returns": "lead-effects",
      "body": "fold(e in effects, acc = lead-effects{lead: [], rest: [], open: true}, if acc.open then match e { publish => lead-effects{lead: concat(acc.lead, [e]), rest: [], open: true}, _ => lead-effects{lead: acc.lead, rest: [e], open: false} } else lead-effects{lead: acc.lead, rest: concat(acc.rest, [e]), open: false})",
      "examples": [
        {
          "args": {
            "effects": []
          },
          "result": {
            "lead": [],
            "rest": [],
            "open": true
          }
        },
        {
          "args": {
            "effects": [
              {
                "publish": {
                  "seq": 1
                }
              },
              {
                "revoke-sessions": {
                  "principal": "alpha:ed"
                }
              },
              {
                "publish": {
                  "seq": 2
                }
              }
            ]
          },
          "result": {
            "lead": [
              {
                "publish": {
                  "seq": 1
                }
              }
            ],
            "rest": [
              {
                "revoke-sessions": {
                  "principal": "alpha:ed"
                }
              },
              {
                "publish": {
                  "seq": 2
                }
              }
            ],
            "open": false
          }
        },
        {
          "args": {
            "effects": [
              {
                "publish": {
                  "seq": 1
                }
              },
              {
                "publish": {
                  "seq": 2
                }
              }
            ]
          },
          "result": {
            "lead": [
              {
                "publish": {
                  "seq": 1
                }
              },
              {
                "publish": {
                  "seq": 2
                }
              }
            ],
            "rest": [],
            "open": true
          }
        }
      ]
    },
    {
      "id": "suspend-lost",
      "description": "triggers.rs suspend_lost: for every automation whose definer lost the authority to confer a role of its run-as (lost-authority), in the state after the change and in the transition (D-7204, WFL-1529): the automation is marked suspended-for the role; a PutSchema op with the schema, an AutomationSuspended event numbered after the last event of the transition (stamped with the new revision, the time, principal and correlation of the context) and its Publish effect placed after the Publish effects already there, and a passing automation:<id>:suspended check naming the definer, the role and the conferral check. Without a loss it changes nothing.",
      "params": [
        {
          "name": "after",
          "type": "tenant-state"
        },
        {
          "name": "ctx",
          "type": "context"
        },
        {
          "name": "result",
          "type": "transition-result"
        },
        {
          "name": "lost",
          "type": "list<lost-authority>"
        }
      ],
      "returns": "trigger-suspension",
      "body": "if lost == [] then trigger-suspension{after, result} else let schema2 = call schema-with-automations(after.schema, fold(def in values(call automations-of(after.schema)), m = {}, insert(m, def.id, match find(l in lost, l.automation == def.id) { Some(l) => automation-def{id: def.id, label: def.label, run-as: def.run-as, run-key: def.run-key, start: def.start, steps: def.steps, defined-by: def.defined-by, defined-at: def.defined-at, suspended-for: l.role}, None => def }))) in let numbered = fold(l in lost, acc = event-numbering{events: result.events, next: result.delta.event-seq + 1}, event-numbering{events: concat(acc.events, [domain-event{tenant: result.delta.tenant, seq: acc.next, revision: result.delta.new-revision, at: ctx.now, principal: ctx.principal, correlation: ctx.correlation, body: event-body.automation-suspended{automation: l.automation, definer: l.definer, role: l.role}}]), next: acc.next + 1}) in let split = call split-publishes(result.effects) in trigger-suspension{after: tenant-state{id: after.id, name: after.name, revision: after.revision, next-record: after.next-record, event-seq: after.event-seq, schema: schema2, members: after.members, records: after.records, setting-values: after.setting-values, ledger: after.ledger}, result: transition-result{delta: state-delta{tenant: result.delta.tenant, base-revision: result.delta.base-revision, new-revision: result.delta.new-revision, next-record: result.delta.next-record, event-seq: numbered.next - 1, ops: concat(result.delta.ops, [delta-op.put-schema(schema2)])}, events: numbered.events, effects: concat(concat(split.lead, map(e in filter(e in numbered.events, e.seq > result.delta.event-seq), effect.publish{seq: e.seq})), split.rest), evidence: concat(result.evidence, map(l in lost, check{rule: format('automation:{}:suspended', l.automation), passed: true, detail: call trigger-detail(format('definer {} may no longer confer role {}: {}', l.definer, l.role, l.detail))})), output: result.output}}",
      "examples": [
        {
          "description": "Without a loss nothing changes.",
          "args": {
            "after": {
              "fixture": "fx-tenant-state-27"
            },
            "ctx": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:owner"
              },
              "session": null,
              "now": 6000,
              "correlation": "test-6000"
            },
            "result": {
              "fixture": "fx-transition-result-1"
            },
            "lost": []
          },
          "result": {
            "after": {
