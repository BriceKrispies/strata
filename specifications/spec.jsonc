              "author": {
                "id": "author",
                "label": "Author",
                "ty": {
                  "ref": {
                    "target": "person",
                    "on-delete": "set-null"
                  }
                },
                "required": false,
                "unique": false
              },
              "body": {
                "id": "body",
                "label": "body",
                "ty": "str",
                "required": false,
                "unique": false
              },
              "published_at": {
                "id": "published_at",
                "label": "published_at",
                "ty": "time",
                "required": false,
                "unique": false
              },
              "rank": {
                "id": "rank",
                "label": "rank",
                "ty": "int",
                "required": false,
                "unique": false
              },
              "slug": {
                "id": "slug",
                "label": "slug",
                "ty": "str",
                "required": true,
                "unique": true
              },
              "status": {
                "id": "status",
                "label": "status",
                "ty": "str",
                "required": true,
                "unique": false,
                "default": {
                  "lit": {
                    "str": "draft"
                  }
                }
              },
              "title": {
                "id": "title",
                "label": "title",
                "ty": "str",
                "required": true,
                "unique": false
              }
            },
            "constraints": {
              "title_length": {
                "id": "title_length",
                "expr": {
                  "cmp": {
                    "op": "le",
                    "left": {
                      "len": {
                        "var": {
                          "scope": "new",
                          "field": "title"
                        }
                      }
                    },
                    "right": {
                      "lit": {
                        "int": 24
                      }
                    }
                  }
                },
                "message": "A title has at most 24 characters"
              }
            },
            "publication": {
              "state-field": "status",
              "draft": "draft",
              "published": "published",
              "withdrawn": "withdrawn"
            },
            "language-field": "title",
            "translation-group": "status"
          }
        }
      ]
    },
    {
      "id": "apply-meta-change",
      "description": "transition.rs apply_change through object_meta::apply, templates::apply and products::apply: the declarations of an object type (set and clear its retention, publication, language field and translation group), the removal of an object type or a role, the templates and tokens, and the ownership record of a product, each applied to a working copy with the line that describes it. A define is define-or-replace; clearing a declaration that is not there, removing what does not exist and removing a built-in role are refused with the problem. A table left empty is none, so the schema hashes as one that never held it (D-7340, D-7341). The records of a removed object type and the principals that hold a removed role are the transition's to look at (change-schema).",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "change",
          "type": "schema-change"
        }
      ],
      "returns": "schema-step",
      "errors": "schema-problem",
      "body": "match change { set-retention{object, retention} => match get(schema.objects, object) { None => fail(schema-problem.problem(format('no object type {}', object))), Some(o) => schema-step{schema: call schema-with-objects(schema, insert(schema.objects, object, call object-with(o, retention, o.publication, o.language-field, o.translation-group))), line: format('set retention of {}', object)} }, clear-retention{object} => match get(schema.objects, object) { None => fail(schema-problem.problem(format('no object type {}', object))), Some(o) => if o.retention == null then fail(schema-problem.problem(format('{} declares no retention', object))) else schema-step{schema: call schema-with-objects(schema, insert(schema.objects, object, call object-with(o, null, o.publication, o.language-field, o.translation-group))), line: format('clear retention of {}', object)} }, set-publication{object, publication} => match get(schema.objects, object) { None => fail(schema-problem.problem(format('no object type {}', object))), Some(o) => schema-step{schema: call schema-with-objects(schema, insert(schema.objects, object, call object-with(o, o.retention, publication, o.language-field, o.translation-group))), line: format('set publication of {}', object)} }, clear-publication{object} => match get(schema.objects, object) { None => fail(schema-problem.problem(format('no object type {}', object))), Some(o) => if o.publication == null then fail(schema-problem.problem(format('{} declares no publication', object))) else schema-step{schema: call schema-with-objects(schema, insert(schema.objects, object, call object-with(o, o.retention, null, o.language-field, o.translation-group))), line: format('clear publication of {}', object)} }, set-language-field{object, field} => match get(schema.objects, object) { None => fail(schema-problem.problem(format('no object type {}', object))), Some(o) => schema-step{schema: call schema-with-objects(schema, insert(schema.objects, object, call object-with(o, o.retention, o.publication, field, o.translation-group))), line: format('set language field of {} to {}', object, field)} }, clear-language-field{object} => match get(schema.objects, object) { None => fail(schema-problem.problem(format('no object type {}', object))), Some(o) => if o.language-field == null then fail(schema-problem.problem(format('{} declares no language field', object))) else schema-step{schema: call schema-with-objects(schema, insert(schema.objects, object, call object-with(o, o.retention, o.publication, null, o.translation-group))), line: format('clear language field of {}', object)} }, set-translation-group{object, field} => match get(schema.objects, object) { None => fail(schema-problem.problem(format('no object type {}', object))), Some(o) => schema-step{schema: call schema-with-objects(schema, insert(schema.objects, object, call object-with(o, o.retention, o.publication, o.language-field, field))), line: format('set translation group of {} to {}', object, field)} }, clear-translation-group{object} => match get(schema.objects, object) { None => fail(schema-problem.problem(format('no object type {}', object))), Some(o) => if o.translation-group == null then fail(schema-problem.problem(format('{} declares no translation group', object))) else schema-step{schema: call schema-with-objects(schema, insert(schema.objects, object, call object-with(o, o.retention, o.publication, o.language-field, null))), line: format('clear translation group of {}', object)} }, remove-object{id} => match get(schema.objects, id) { None => fail(schema-problem.problem(format('no object type {}', id))), Some(_) => schema-step{schema: call schema-with-objects(schema, remove(schema.objects, id)), line: format('remove object {}', id)} }, remove-role(role) => if role == 'public' || role == 'owner' then fail(schema-problem.problem(format('{} is built in', role))) else match get(schema.roles, role) { None => fail(schema-problem.problem(format('no role {}', role))), Some(_) => schema-step{schema: tenant-schema{version: schema.version, settings: schema.settings, capabilities: schema.capabilities, ledger: schema.ledger, objects: schema.objects, roles: remove(schema.roles, role), role-permissions: call role-permissions-with(schema, role, []), teams: schema.teams, invitations: schema.invitations, policies: schema.policies, workflows: schema.workflows, queries: schema.queries, views: schema.views, triggers: schema.triggers, automations: schema.automations, operations: schema.operations, mail-templates: schema.mail-templates, notice-templates: schema.notice-templates, tokens: schema.tokens, products: schema.products}, line: format('remove role {}', role)} }, define-mail-template(d) => schema-step{schema: call schema-with-tables(schema, insert(call mail-templates-of(schema), d.template, d), call notice-templates-of(schema), call tokens-of(schema), call products-of(schema)), line: format('define mail template {}', d.template)}, remove-mail-template(id) => if get(call mail-templates-of(schema), id) == null then fail(schema-problem.problem(format('no mail template {}', id))) else schema-step{schema: call schema-with-tables(schema, remove(call mail-templates-of(schema), id), call notice-templates-of(schema), call tokens-of(schema), call products-of(schema)), line: format('remove mail template {}', id)}, define-notice-template(d) => schema-step{schema: call schema-with-tables(schema, call mail-templates-of(schema), insert(call notice-templates-of(schema), d.template, d), call tokens-of(schema), call products-of(schema)), line: format('define notice template {}', d.template)}, remove-notice-template(id) => if get(call notice-templates-of(schema), id) == null then fail(schema-problem.problem(format('no notice template {}', id))) else schema-step{schema: call schema-with-tables(schema, call mail-templates-of(schema), remove(call notice-templates-of(schema), id), call tokens-of(schema), call products-of(schema)), line: format('remove notice template {}', id)}, define-token(d) => schema-step{schema: call schema-with-tables(schema, call mail-templates-of(schema), call notice-templates-of(schema), insert(call tokens-of(schema), d.name, d), call products-of(schema)), line: format('define token {}', d.name)}, remove-token(id) => if get(call tokens-of(schema), id) == null then fail(schema-problem.problem(format('no token {}', id))) else schema-step{schema: call schema-with-tables(schema, call mail-templates-of(schema), call notice-templates-of(schema), remove(call tokens-of(schema), id), call products-of(schema)), line: format('remove token {}', id)}, record-product(p) => schema-step{schema: call schema-with-tables(schema, call mail-templates-of(schema), call notice-templates-of(schema), call tokens-of(schema), insert(call products-of(schema), p.product, p)), line: format('record product {} {}', p.product, p.version)}, remove-product(id) => if get(call products-of(schema), id) == null then fail(schema-problem.problem(format('no product {}', id))) else schema-step{schema: call schema-with-tables(schema, call mail-templates-of(schema), call notice-templates-of(schema), call tokens-of(schema), remove(call products-of(schema), id)), line: format('remove product {}', id)}, _ => fail(schema-problem.problem('not a change of a declaration, a template, a token or a product')) }",
      "examples": [
