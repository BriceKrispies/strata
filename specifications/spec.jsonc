    {
      "id": "string-at-least",
      "description": "Whether the string a is not below the string b in the order of Unicode scalar values, which is the order of the bytes of their UTF-8 encoding (the body language orders strings only through sortBy).",
      "params": [
        {
          "name": "a",
          "type": "string"
        },
        {
          "name": "b",
          "type": "string"
        }
      ],
      "returns": "bool",
      "body": "get(sortBy(x in [a, b], x), 0) == b",
      "examples": [
        {
          "args": {
            "a": "b",
            "b": "a"
          },
          "result": true
        },
        {
          "args": {
            "a": "a",
            "b": "a"
          },
          "result": true
        },
        {
          "args": {
            "a": "a",
            "b": "b"
          },
          "result": false
        }
      ]
    },
    {
      "id": "utf8-char-len",
      "description": "The number of bytes of the UTF-8 encoding of one character: 1 below U+0080, 2 below U+0800, 3 below U+10000, 4 above. The body language has no byte length, so it is found by comparing the character with the three bounds (Rust str::len, which limits.rs counts).",
      "params": [
        {
          "name": "c",
          "type": "string"
        }
      ],
      "returns": "u64",
      "body": "if call string-at-least(c, '') then (if call string-at-least(c, 'ࠀ') then (if call string-at-least(c, '𐀀') then 4 else 3) else 2) else 1",
      "examples": [
        {
          "args": {
            "c": "a"
          },
          "result": 1
        },
        {
          "args": {
            "c": ""
          },
          "result": 1
        },
        {
          "args": {
            "c": ""
          },
          "result": 2
        },
        {
          "args": {
            "c": "é"
          },
          "result": 2
        },
        {
          "args": {
            "c": "߿"
          },
          "result": 2
        },
        {
          "args": {
            "c": "ࠀ"
          },
          "result": 3
        },
        {
          "args": {
            "c": "€"
          },
          "result": 3
        },
        {
          "args": {
            "c": "￿"
          },
          "result": 3
        },
        {
          "args": {
            "c": "𐀀"
          },
          "result": 4
        },
        {
          "args": {
            "c": "😀"
          },
          "result": 4
        }
      ]
    },
    {
      "id": "utf8-length",
      "description": "The number of bytes of the UTF-8 encoding of a string: Rust str::len, which limits.rs counts, where length(s) counts characters.",
      "params": [
        {
          "name": "s",
          "type": "string"
        }
      ],
      "returns": "u64",
      "body": "fold(c in chars(s), n = 0, n + call utf8-char-len(c))",
      "examples": [
        {
          "args": {
            "s": ""
          },
          "result": 0
        },
        {
          "args": {
            "s": "abc"
          },
          "result": 3
        },
        {
          "args": {
            "s": "aé€😀"
          },
          "result": 10
        }
      ]
    },
    {
      "id": "json-string-bytes",
      "description": "The bytes of a string written as serde_json writes it (compact, in double quotes, with the escapes of the {:json} placeholder).",
      "params": [
        {
          "name": "s",
          "type": "string"
        }
      ],
      "returns": "u64",
      "body": "call utf8-length(format('{:json}', s))",
      "examples": [
        {
          "args": {
            "s": "ab"
          },
          "result": 4
        },
        {
          "args": {
            "s": "a\"b\\c"
          },
          "result": 9
        },
        {
          "args": {
            "s": "a\nb"
          },
          "result": 6
        },
        {
          "args": {
            "s": "a\u0001"
          },
          "result": 9
        },
        {
          "args": {
            "s": "é"
          },
          "result": 4
        }
      ]
    },
    {
      "id": "value-json-bytes-inner",
      "description": "The bytes of the serde_json encoding of a value that is not a list (strata_kernel::Value is externally tagged: {\"Int\":5}, {\"Str\":\"x\"}, \"Null\"); a list gives 0 here, value-json-bytes counts lists.",
      "params": [
        {
          "name": "x",
          "type": "value"
        }
      ],
      "returns": "u64",
      "body": "match x { bool(b) => if b then 13 else 14, int(n) => 8 + length(format('{}', n)), str(s) => 8 + call json-string-bytes(s), time(t) => 9 + length(format('{}', t)), ref(r) => 8 + length(format('{}', r)), list(_) => 0, _ => 6 }",
      "examples": [
        {
          "args": {
            "x": {
              "bool": true
            }
          },
          "result": 13
        },
        {
          "args": {
            "x": {
              "bool": false
            }
          },
          "result": 14
        },
        {
          "args": {
            "x": {
              "int": -12
            }
          },
          "result": 11
        },
        {
          "args": {
            "x": {
              "str": "ab"
            }
          },
          "result": 12
        },
        {
          "args": {
            "x": {
              "time": 1000
            }
          },
          "result": 13
        },
        {
          "args": {
            "x": {
              "ref": 7
            }
          },
          "result": 9
        },
        {
          "args": {
            "x": {
              "list": [
                {
                  "int": 1
                }
              ]
            }
          },
          "result": 0
        },
        {
          "args": {
            "x": "null"
          },
          "result": 6
        }
      ]
    },
    {
      "id": "value-json-bytes",
      "description": "The bytes of the serde_json encoding of a value ({\"List\":[..]} for a list; limits.rs encoded_len, and the size of a record), at any depth: structural recursion, every call of itself on an item of the list matched from x (WG-5133).",
      "params": [
        {
          "name": "x",
          "type": "value"
        }
      ],
      "returns": "u64",
      "body": "match x { list(items) => 11 + fold(i in items, n = 0, n + call value-json-bytes(i)) + (if length(items) > 0 then length(items) - 1 else 0), _ => call value-json-bytes-inner(x) }",
      "examples": [
        {
          "args": {
            "x": {
              "list": []
            }
          },
          "result": 11
        },
        {
          "args": {
            "x": {
              "list": [
                {
                  "int": 1
                },
                {
                  "str": "a"
                }
              ]
            }
          },
          "result": 32
        },
        {
          "args": {
            "x": {
              "str": "a"
            }
          },
          "result": 11
        },
        {
          "description": "A list in a list: {\"List\":[{\"List\":[{\"Int\":1}]}]} is 31 bytes.",
          "args": {
            "x": {
              "list": [
                {
                  "list": [
                    {
                      "int": 1
                    }
                  ]
                }
              ]
            }
          },
          "result": 31
        },
        {
          "description": "Three lists deep: {\"List\":[{\"List\":[{\"List\":[{\"Int\":1}]}]}]} is 42 bytes.",
          "args": {
            "x": {
              "list": [
                {
                  "list": [
                    {
                      "list": [
                        {
                          "int": 1
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          },
          "result": 42
        }
      ]
    },
    {
      "id": "record-json-bytes",
      "description": "The bytes of the serde_json encoding of a record, as rules.rs validate_record measures it: {\"id\":1,\"object\":\"note\",\"version\":1,\"created_by\":null,\"created_at\":0,\"updated_at\":0,\"fields\":{\"title\":{\"Str\":\"x\"}}}. 82 are the fixed text of the seven members.",
      "params": [
        {
          "name": "r",
          "type": "record"
        }
      ],
      "returns": "u64",
      "body": "82 + length(format('{}', r.id)) + call json-string-bytes(r.object) + length(format('{}', r.version)) + (match r.created-by { Some(p) => call json-string-bytes(p), None => 4 }) + length(format('{}', r.created-at)) + length(format('{}', r.updated-at)) + fold(k in keys(r.fields), n = 0, n + call json-string-bytes(k) + 1) + fold(v in values(r.fields), n = 0, n + call value-json-bytes(v)) + (if length(keys(r.fields)) > 0 then length(keys(r.fields)) - 1 else 0)",
      "examples": [
        {
          "description": "A record with a string, an integer, a list and a null, written by a principal.",
          "args": {
            "r": {
              "id": 1,
              "object": "note",
              "version": 1,
              "created-by": "alpha:writer1",
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "title": {
                  "str": "First"
                },
                "rank": {
                  "int": -3
                },
                "tags": {
                  "list": [
                    {
                      "str": "a"
                    },
                    {
                      "str": "b"
                    }
                  ]
                },
                "nothing": "null"
              }
            }
          },
          "result": 213
        },
        {
          "description": "A record of no fields and no author.",
          "args": {
            "r": {
              "id": 12,
              "object": "person",
              "version": 20,
              "created-at": -1,
              "updated-at": 0,
              "fields": {}
            }
          },
          "result": 101
        }
      ]
    },
    {
      "id": "limit-problem-scalar",
      "description": "limits.rs value_problem for a value that is not a list: a string of more than max-string bytes. A list gives none here; value-limit-problem searches lists.",
      "params": [
        {
          "name": "x",
          "type": "value"
        },
        {
          "name": "max-string",
          "type": "u64"
        },
        {
          "name": "max-list",
          "type": "u64"
        }
      ],
      "returns": "string",
      "body": "match x { str(s) => let n = call utf8-length(s) in if n > max-string then format('a string of {} bytes is longer than the maximum of {}', n, max-string) else '', _ => '' }",
      "examples": [
        {
          "args": {
            "x": {
              "str": "abc"
            },
            "max-string": 3,
            "max-list": 2
          },
          "result": ""
        },
        {
          "args": {
            "x": {
              "str": "abcd"
            },
            "max-string": 3,
            "max-list": 2
          },
          "result": "a string of 4 bytes is longer than the maximum of 3"
        },
        {
          "args": {
            "x": {
              "str": "éé"
            },
            "max-string": 3,
            "max-list": 2
          },
          "result": "a string of 4 bytes is longer than the maximum of 3"
        },
        {
          "args": {
            "x": {
              "int": 5
            },
            "max-string": 3,
            "max-list": 2
          },
          "result": ""
        }
      ]
    },
    {
      "id": "value-limit-problem",
      "description": "limits.rs value_problem: the first limit a value breaks, as its description, or the empty string (the kernel gives none). The maximum of a string is in bytes, the maximum of a list in items. A list is searched as deep as there are lists: structural recursion, every call of itself on an item of the list matched from x (WG-5133).",
      "params": [
        {
          "name": "x",
          "type": "value"
        },
        {
          "name": "max-string",
          "type": "u64"
        },
        {
          "name": "max-list",
          "type": "u64"
        }
      ],
      "returns": "string",
      "body": "match x { list(items) => if length(items) > max-list then format('a list of {} items is longer than the maximum of {}', length(items), max-list) else fold(i in items, a = '', if a != '' then a else call value-limit-problem(i, max-string, max-list)), _ => call limit-problem-scalar(x, max-string, max-list) }",
      "examples": [
        {
          "args": {
            "x": {
              "list": [
                {
                  "list": [
                    {
                      "int": 1
                    },
                    {
                      "int": 2
                    },
                    {
                      "int": 3
                    }
                  ]
                }
              ]
            },
            "max-string": 3,
            "max-list": 2
          },
          "result": "a list of 3 items is longer than the maximum of 2"
        },
        {
          "args": {
            "x": {
              "list": [
                {
                  "str": "ab"
                },
                {
                  "str": "abcd"
                }
              ]
            },
            "max-string": 3,
            "max-list": 2
          },
          "result": "a string of 4 bytes is longer than the maximum of 3"
        },
        {
          "args": {
            "x": {
              "list": [
                {
                  "str": "abcd"
                },
                {
                  "str": "abcde"
                }
              ]
            },
            "max-string": 3,
            "max-list": 2
          },
          "result": "a string of 4 bytes is longer than the maximum of 3"
        },
        {
          "args": {
            "x": {
              "list": [
                {
                  "int": 1
                },
                {
                  "int": 2
                },
                {
                  "int": 3
                }
              ]
            },
            "max-string": 3,
            "max-list": 2
          },
          "result": "a list of 3 items is longer than the maximum of 2"
        },
        {
          "args": {
            "x": {
              "list": [
                {
                  "str": "ab"
                }
              ]
            },
            "max-string": 3,
            "max-list": 2
          },
          "result": ""
        },
        {
          "args": {
            "x": {
              "str": "abcd"
            },
            "max-string": 3,
            "max-list": 2
          },
          "result": "a string of 4 bytes is longer than the maximum of 3"
        },
        {
          "description": "A string too long three lists deep is found (limits.rs value_problem recurses into every list).",
          "args": {
            "x": {
              "list": [
                {
                  "list": [
                    {
                      "list": [
                        {
                          "str": "abcd"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "max-string": 3,
            "max-list": 2
          },
          "result": "a string of 4 bytes is longer than the maximum of 3"
        },
        {
          "description": "A list too long three lists deep is found.",
          "args": {
            "x": {
              "list": [
                {
                  "list": [
                    {
                      "list": [
                        {
                          "int": 1
                        },
                        {
                          "int": 2
                        },
                        {
                          "int": 3
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "max-string": 3,
            "max-list": 2
          },
          "result": "a list of 3 items is longer than the maximum of 2"
        },
        {
          "description": "Lists nested three deep within the limits give no problem.",
          "args": {
            "x": {
              "list": [
                {
                  "list": [
                    {
                      "list": [
                        {
                          "str": "ab"
                        }
                      ]
                    }
                  ]
                },
                {
                  "str": "abc"
                }
              ]
            },
            "max-string": 3,
            "max-list": 2
          },
          "result": ""
        }
      ]
    },
    {
      "id": "record-limit-check",
      "description": "rules.rs validate_record, the first check: a record whose JSON encoding is longer than max bytes (262144) is limit:record:<object>, LimitExceeded, before any field is looked at.",
      "params": [
        {
          "name": "acc",
          "type": "validation-outcome"
        },
        {
          "name": "object",
          "type": "object-type-def"
        },
        {
          "name": "candidate",
          "type": "record"
        },
        {
          "name": "max",
          "type": "u64"
        }
      ],
      "returns": "validation-outcome",
      "body": "let n = call record-json-bytes(candidate) in if n > max then call outcome-fail(acc, error-kind.limit-exceeded, format('limit:record:{}', object.id), format('a record of {} bytes is larger than the maximum of {}', n, max)) else acc",
      "examples": [
        {
          "description": "A record at the maximum is within it.",
          "args": {
            "acc": {
              "passed": [],
              "failed": []
            },
            "object": {
              "id": "note",
              "label": "Note",
              "fields": {},
              "constraints": {}
            },
            "candidate": {
              "id": 1,
              "object": "note",
              "version": 1,
              "created-by": "u",
              "created-at": 1,
              "updated-at": 1,
              "fields": {
                "a": {
                  "str": "x"
                }
              }
            },
            "max": 110
          },
          "result": {
            "passed": [],
            "failed": []
          }
        },
        {
          "description": "A record one byte over the maximum fails.",
          "args": {
            "acc": {
              "passed": [],
              "failed": []
            },
            "object": {
              "id": "note",
              "label": "Note",
              "fields": {},
              "constraints": {}
            },
            "candidate": {
              "id": 1,
              "object": "note",
              "version": 1,
              "created-by": "u",
              "created-at": 1,
              "updated-at": 1,
              "fields": {
                "a": {
                  "str": "x"
                }
              }
            },
            "max": 109
          },
          "result": {
            "passed": [],
            "failed": [
              {
                "check": {
                  "rule": "limit:record:note",
                  "passed": false,
                  "detail": "a record of 110 bytes is larger than the maximum of 109"
                },
                "kind": "limit-exceeded"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "limit-step",
      "description": "rules.rs validate_record, second loop, the limits of one field value that is present: the first limit the value breaks (value-limit-problem) is limit:<object>.<field>; a value of a unique field of more than max-unique encoded bytes is limit:unique:<object>.<field>. Both are LimitExceeded.",
      "params": [
        {
          "name": "acc",
          "type": "validation-outcome"
        },
        {
          "name": "at",
          "type": "string"
        },
        {
          "name": "field",
          "type": "field-def"
        },
        {
          "name": "x",
          "type": "value"
        },
        {
          "name": "max-string",
          "type": "u64"
        },
        {
          "name": "max-list",
          "type": "u64"
        },
        {
          "name": "max-unique",
          "type": "u64"
        }
      ],
      "returns": "validation-outcome",
      "body": "let p = call value-limit-problem(x, max-string, max-list) in if p != '' then call outcome-fail(acc, error-kind.limit-exceeded, format('limit:{}', at), p) else if field.unique && call value-json-bytes(x) > max-unique then call outcome-fail(acc, error-kind.limit-exceeded, format('limit:unique:{}', at), format('a value in a unique field is at most {} bytes encoded', max-unique)) else acc",
      "examples": [
        {
          "args": {
            "acc": {
              "passed": [],
              "failed": []
            },
            "at": "note.slug",
            "field": {
              "id": "slug",
              "label": "Slug",
              "ty": "str",
              "required": false,
              "unique": true
            },
            "x": {
              "str": "ab"
            },
            "max-string": 5,
            "max-list": 2,
            "max-unique": 12
          },
          "result": {
            "passed": [],
            "failed": []
          }
        },
        {
          "description": "A string over the maximum.",
          "args": {
            "acc": {
              "passed": [],
              "failed": []
            },
            "at": "note.slug",
            "field": {
              "id": "slug",
              "label": "Slug",
              "ty": "str",
              "required": false,
              "unique": true
            },
            "x": {
              "str": "abcdef"
            },
            "max-string": 5,
            "max-list": 2,
            "max-unique": 99
          },
          "result": {
            "passed": [],
            "failed": [
              {
                "check": {
                  "rule": "limit:note.slug",
                  "passed": false,
                  "detail": "a string of 6 bytes is longer than the maximum of 5"
                },
                "kind": "limit-exceeded"
              }
            ]
          }
        },
        {
          "description": "A value of a unique field one byte over its maximum encoded (the encoding {\"Str\":\"abc\"} is 13 bytes; the maximum is 12).",
          "args": {
            "acc": {
              "passed": [],
              "failed": []
            },
            "at": "note.slug",
            "field": {
              "id": "slug",
              "label": "Slug",
              "ty": "str",
              "required": false,
              "unique": true
            },
            "x": {
              "str": "abc"
            },
            "max-string": 5,
            "max-list": 2,
            "max-unique": 12
          },
          "result": {
            "passed": [],
            "failed": [
              {
                "check": {
                  "rule": "limit:unique:note.slug",
                  "passed": false,
                  "detail": "a value in a unique field is at most 12 bytes encoded"
                },
                "kind": "limit-exceeded"
              }
            ]
          }
        },
        {
          "description": "The same value in a field that is not unique.",
