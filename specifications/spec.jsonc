                            "len": {
                              "var": {
                                "scope": "new",
                                "field": "title"
                              }
                            }
                          },
                          "right": {
                            "lit": {
                              "int": 24
                            }
                          }
                        }
                      },
                      "message": "A title has at most 24 characters"
                    }
                  }
                },
                "person": {
                  "id": "person",
                  "label": "Person",
                  "fields": {
                    "name": {
                      "id": "name",
                      "label": "name",
                      "ty": "str",
                      "required": true,
                      "unique": false
                    }
                  },
                  "constraints": {}
