    {
      "id": "mail-log-read-flow",
      "name": "Mail log read",
      "subject": "mail-dispatcher",
      "initial": "mr-live",
      "description": "A read of the mail log. The read carries the decision of the policies of the tenant on the principal who asks. A permitted read returns the state of the message; a read that is not permitted is refused and returns none.",
      "variables": [
        {
          "name": "returned",
          "type": "number",
          "initial": 0
        },
        {
          "name": "denied",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "mr-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "mr-return-to-unpermitted",
          "from": "mr-live",
          "to": "mr-live",
          "on": "mr-read",
          "description": "Defect: returns the state of a message to a principal the policies do not permit.",
          "guard": "!event.permitted",
          "faultOnly": true,
          "effects": [
            {
              "set": "returned",
              "to": "returned + 1"
            },
            {
              "emit": "mr-state-returned"
            }
          ]
        },
        {
          "id": "mr-return",
          "from": "mr-live",
          "to": "mr-live",
          "on": "mr-read",
          "guard": "event.permitted",
          "effects": [
            {
              "set": "returned",
              "to": "returned + 1"
            },
            {
              "emit": "mr-state-returned"
            }
          ]
        },
        {
          "id": "mr-deny",
          "from": "mr-live",
          "to": "mr-live",
          "on": "mr-read",
          "effects": [
            {
              "set": "denied",
              "to": "denied + 1"
            },
            {
              "emit": "mr-denied"
            }
          ]
        }
      ]
    },
    {
      "id": "mail-log-read-flow-impl",
      "name": "Mail log read (implementation)",
      "level": "implementation",
      "subject": "mail-dispatcher",
      "refines": "mail-log-read-flow",
      "description": "A read of the mail log. The read carries the decision of the policies of the tenant on the principal who asks. A permitted read returns the state of the message; a read that is not permitted is refused and returns none.",
      "initial": "mr-live-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "returned",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "denied",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        }
      ],
      "states": [
        {
          "id": "mr-live-i",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "mr-return-i",
          "from": "mr-live-i",
          "to": "mr-live-i",
          "on": "mr-read",
          "guard": "event.permitted",
          "effects": [
            {
              "set": "returned",
              "to": "returned + 1"
            },
            {
              "emit": "mr-state-returned",
              "to": "mail-dispatcher"
            }
          ]
        },
        {
          "id": "mr-deny-i",
          "from": "mr-live-i",
          "to": "mr-live-i",
          "on": "mr-read",
          "otherwise": true,
          "effects": [
            {
              "set": "denied",
