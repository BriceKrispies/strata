            },
            "object": "post",
            "field": "title"
          },
          "result": null
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-29"
            },
            "object": "note",
            "field": "author"
          },
          "result": null
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-29"
            },
            "object": "post",
            "field": "editor"
          },
          "result": null
        }
      ]
    },
    {
      "id": "reference-held",
      "description": "The record id a field of a record holds when it holds a reference; none for no record, a missing field or another value.",
      "params": [
        {
          "name": "scoped",
          "type": "option<record>"
        },
        {
          "name": "field",
          "type": "field-id"
        }
      ],
      "returns": "list<record-id>",
      "body": "match scoped { None => [], Some(r) => match get(r.fields, field) { None => [], Some(v) => match v { ref(i) => [i], _ => [] } } }",
      "examples": [
        {
          "args": {
            "scoped": {
              "id": 7,
              "object": "post",
              "version": 1,
              "created-by": "user:ann",
              "created-at": 1800000000000,
              "updated-at": 1800000000000,
              "fields": {
                "author": {
                  "ref": 2
                },
                "title": {
                  "str": "Hello"
                }
              }
            },
            "field": "author"
          },
          "result": [
            2
          ]
        },
        {
          "args": {
            "scoped": {
              "id": 7,
              "object": "post",
              "version": 1,
              "created-by": "user:ann",
              "created-at": 1800000000000,
              "updated-at": 1800000000000,
              "fields": {
                "author": {
                  "ref": 2
                },
                "title": {
                  "str": "Hello"
                }
              }
            },
            "field": "title"
          },
          "result": []
        },
        {
          "args": {
            "field": "author"
          },
          "result": []
        }
      ]
    },
    {
      "id": "rule-lookup",
      "description": "The lookup of eval for a rule of rules.rs authorize (crates/kernel/src/expr.rs Env::follow over a Lookup): for each single reference field of the record's object type whose targets in the old and new records the snapshot covers, the targets that exist, by the decimal text of their id, each as a record scope. A field one of whose targets the snapshot does not cover is left out, so following it is an evaluation error, as Lookup::record refuses a record the snapshot does not cover; a covered target that does not exist is absent, so following it is null, as in the kernel.",
      "params": [
        {
          "name": "reach",
          "type": "rule-reach"
        }
      ],
      "returns": "map<string, map<string, map<string, value>>>",
      "let": [
        {
          "name": "scoped",
          "expr": "if reach.subject.old == null then reach.subject.new else reach.subject.old"
        }
      ],
      "body": "match scoped { None => {}, Some(r) => match get(reach.tenant.schema.objects, r.object) { None => {}, Some(o) => fold(f in values(o.fields), acc = {}, match f.ty { ref{target} => let ids = concat(call reference-held(reach.subject.old, f.id), call reference-held(reach.subject.new, f.id)) in if all(i in ids, call covers(reach.coverage, need.record{object: target, id: i})) then insert(acc, format('{}', f.id), fold(i in ids, held = {}, match get(reach.tenant.records, target) { Some(rs) => match get(rs, i) { Some(t) => insert(held, format('{}', i), call record-scope(t)), None => held }, None => held })) else acc, _ => acc }) } }",
      "examples": [
        {
          "description": "A complete snapshot: the author of the post, as a record scope, under the reference field.",
          "args": {
            "reach": {
              "tenant": {
                "id": "gazette",
                "name": "Gazette",
                "revision": 3,
                "next-record": 7,
                "event-seq": 3,
                "schema": {
                  "version": 1,
                  "objects": {
                    "author": {
                      "id": "author",
                      "label": "Author",
                      "fields": {
                        "principal": {
                          "id": "principal",
                          "label": "principal",
                          "ty": "str",
                          "required": true,
                          "unique": false
                        }
                      },
                      "constraints": {}
                    },
                    "post": {
                      "id": "post",
                      "label": "Post",
                      "fields": {
                        "author": {
                          "id": "author",
                          "label": "author",
                          "ty": {
                            "ref": {
                              "target": "author",
                              "on-delete": "restrict"
                            }
                          },
                          "required": false,
                          "unique": false
                        },
                        "title": {
                          "id": "title",
                          "label": "title",
                          "ty": "str",
                          "required": true,
                          "unique": false
                        }
                      },
                      "constraints": {}
                    }
                  },
                  "roles": {},
                  "policies": {
                    "authors_write_posts": {
                      "id": "authors_write_posts",
                      "role": "author",
                      "resource": {
                        "object": "post"
                      },
                      "actions": [
                        "create"
                      ],
                      "condition": {
                        "cmp": {
