    {
      "id": "identity-unreachable-public",
      "name": "Published content while the identity service does not answer",
      "description": "The gateway asks the identity service and gets no answer; a reader asks for published content, which needs no session.",
      "behaviors": [
        "gateway-outage-flow",
        "session-authority-flow"
      ],
      "steps": [
        {
          "at": 6,
          "event": "sr-request",
          "payload": {
            "session-id": "s_1"
          },
          "note": "The copy is older than its bound, so the gateway asks."
        },
        {
          "at": 8,
          "event": "sr-public-request",
          "payload": {
            "session-id": "s_1"
          },
          "note": "A reader asks for published content while the lookup is unanswered."
        }
      ],
      "faults": [
        "identity-answer-dropped"
      ]
    },
    {
      "id": "identity-unreachable-public-impl",
      "name": "Published content while the identity service does not answer (implementation)",
      "description": "The gateway asks the identity service and gets no answer; a reader asks for published content, which needs no session. The same scenario run on the implementation machine. Times are in milliseconds.",
      "behaviors": [
        "gateway-outage-flow-impl",
        "session-authority-flow"
      ],
      "steps": [
        {
          "at": 6000,
          "event": "sr-request",
          "payload": {
            "session-id": "s_1"
          },
          "note": "The copy is older than its bound, so the gateway asks."
        },
        {
          "at": 8000,
          "event": "sr-public-request",
          "payload": {
            "session-id": "s_1"
          },
          "note": "A reader asks for published content while the lookup is unanswered."
        }
      ],
      "faults": [
        "identity-answer-dropped"
      ],
      "timeUnit": "ms",
      "routes": [
        {
          "event": "sr-request",
          "behavior": "gateway-outage-flow-impl",
          "by": "key",
          "field": "session-id"
        },
        {
          "event": "sr-public-request",
          "behavior": "gateway-outage-flow-impl",
          "by": "key",
          "field": "session-id"
        }
      ]
    },
    {
      "id": "live-backoff-step-1-impl",
      "name": "The first failed reconnect waits 500 ms (implementation)",
      "description": "Failed connections in a row, never opened: each close counts one attempt and waits as long as the back-off says. Times are in milliseconds; the reconnect timers fire by themselves.",
      "behaviors": [
        "client-live-flow-impl"
      ],
      "steps": [
        {
          "at": 0,
          "event": "ui-live-start"
        },
        {
          "at": 10,
          "event": "ui-live-closed",
          "note": "Failed connection 1 (the socket closes before the welcome): the reconnect timer of 500 ms fires at 510."
        }
