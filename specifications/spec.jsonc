      "description": "Assign and revoke the roles of people, add people to teams and remove them, and invite people to hold roles. Conferring a role also needs every permission and capability the role grants (ADM-152).",
      "core": true
    },
    {
      "id": "ledger-post",
      "name": "Post to a ledger",
      "description": "Post an entry to an account of the tenant ledger.",
      "core": true,
      "source": "ldg-006"
    },
    {
      "id": "ledger-read",
      "name": "Read a ledger",
      "description": "Read the balance and the entries of an account of the tenant ledger that the policies of the reader permit.",
      "core": true,
      "source": "ldg-024"
    },
    {
      "id": "ledger-configure",
      "name": "Configure the ledger",
      "description": "Declare units and pools of the tenant ledger and set their limits.",
      "core": true,
      "source": "ldg-011"
    },
    {
      "id": "segments-define",
      "name": "Define segments",
      "description": "Define, change, remove and test segments.",
      "core": true
    },
    {
      "id": "segments-read",
      "name": "Read segment members",
      "description": "List the members of a segment.",
      "core": true
    },
    {
      "id": "setting-read",
      "name": "Read settings",
      "description": "Read the resolved value of the settings for oneself (SET-010).",
      "core": true
    },
    {
      "id": "setting-define",
      "name": "Define settings",
      "description": "Define, change and lock the settings of the tenant (SET-001).",
      "core": true
    },
    {
      "id": "setting-write-platform",
      "name": "Write platform settings",
      "description": "Set and remove the platform level of a setting (SET-030).",
      "core": true
    },
    {
      "id": "setting-write-tenant",
      "name": "Write tenant settings",
      "description": "Set and remove the tenant level of a setting (SET-031).",
      "core": true
    },
    {
      "id": "setting-write-team",
      "name": "Write team settings",
      "description": "Set and remove the team level of a setting (SET-032).",
      "core": true
    },
    {
      "id": "setting-write-person",
      "name": "Write own settings",
      "description": "Set and remove the person level of a setting for oneself (SET-033, SET-034).",
      "core": true
    },
    {
      "id": "aggregate-read",
      "name": "Read aggregates",
      "description": "Read the aggregates that named queries declare, as the audience class of the reader allows (AGG-010).",
      "core": true
    },
    {
      "id": "platform-flags-manage",
      "name": "Manage platform flags and quotas",
      "description": "Change a feature flag or a quota of any tenant. No tenant role holds it (D-6202).",
      "core": true
    },
    {
      "id": "plan-contract-record",
      "name": "Record an enterprise contract",
      "description": "Record the contract that lets a tenant hold the Enterprise plan (D-6202).",
      "core": true
    },
    {
      "id": "session-end",
      "name": "End the sessions of a principal",
      "description": "End every session of a principal. Looking a session up is session-verify (D-6203).",
      "core": true
    },
    {
      "id": "takedown-issue",
      "name": "Take down a tenant or a host",
      "description": "Take a tenant or one host down for abuse, a legal order or a security incident, and release that takedown. Held by the platform operator only (THR-1226).",
      "core": true
    },
    {
      "id": "messages-send",
      "name": "Send messages",
      "description": "Send a templated message or inbox notice to a principal, an address or a segment (EML-1560).",
      "core": true
    },
    {
      "id": "notifications-manage",
      "name": "Manage own notifications",
      "description": "Mark one's own notices read, unread or removed, and set one's own notification preferences (NTF-1569, NTF-1571).",
      "core": true
    },
    {
      "id": "webhooks-manage",
      "name": "Manage webhook endpoints",
      "description": "Create inbound webhook endpoints and rotate their secrets (INT-1578).",
      "core": true
    },
    {
      "id": "events-declare",
      "name": "Declare event kinds",
      "description": "Declare and emit the event kinds of the tenant (SCH-1576).",
      "core": true
    },
    {
      "id": "subscription-link",
      "name": "Follow a subscription link",
      "description": "Follow a signed link to unsubscribe or resubscribe without a sign-in (EML-1562).",
      "core": true
    },
    {
      "id": "self-record-write",
      "name": "Write own records",
      "description": "Create and change records that the policies permit the principal to write and that the principal created or that name the principal as their data subject (D-6591). Grants no draft, article or publication operation.",
      "core": true
    },
    {
      "id": "self-file-upload",
      "name": "Upload own files",
      "description": "Upload a file into a file field that a policy lets the principal write, within that field's size cap (D-6591). Grants no other upload and no publication.",
      "core": true
    },
    {
      "id": "self-events-read",
      "name": "Read own events",
      "description": "Subscribe to the events of records the principal may read, and to no others (D-6591).",
      "core": true
    },
    {
      "id": "tenant-configure",
      "name": "Configure the tenant",
      "description": "Change the tenant settings: audit retention, the outbound allow-list, file limits, default and fallback language, and the other values of tenant-settings (D-6594).",
      "core": true
    },
    {
      "id": "tenant-operation-invoke",
      "name": "Invoke tenant operations",
      "description": "Invoke a tenant operation whose invokers name the caller (OPR-1546).",
      "core": true
    },
    {
      "id": "ledger-read-own",
      "name": "Read one's own ledger accounts",
      "description": "Read the balance and the entries of the ledger accounts that the caller owns, and of no other account (LDG-1541).",
      "core": true
    },
    {
      "id": "segments-read-own",
      "name": "Read one's own segments",
      "description": "List the segments marked visible to members that the caller belongs to (SEG-1540).",
      "core": true
    },
    {
      "id": "setting-resolve-for",
      "name": "Resolve a setting for another principal",
      "description": "Resolve the setting of a recipient inside the platform, for the mail dispatcher and the notification service (SET-1541).",
      "core": true
    },
    {
      "id": "automations-define",
      "name": "Define automations",
      "description": "Define and remove triggers and automations, and release or drop their exceptions (WFL-1520).",
      "core": true
    },
    {
      "id": "automations-read",
      "name": "Read automations",
      "description": "List automation runs, their steps and their exception records (WFL-1531, SCH-1532).",
      "core": true
    }
  ]
,
