      "id": "after-decision",
      "description": "triggers.rs after_decision: what the kernel adds to an accepted transition once its events are final (D-7200, D-7204): the suspensions of automations whose definer lost authority and the effect of each trigger that matches an event of the transition (after-decision-run). A transition that changed neither members nor the schema and matches no trigger that is not paused is returned as it is.",
      "params": [
        {
          "name": "t",
          "type": "tenant-state"
        },
        {
          "name": "ctx",
          "type": "context"
        },
        {
          "name": "result",
          "type": "transition-result"
        }
      ],
      "returns": "transition-result",
      "errors": "rejection",
      "let": [
        {
          "name": "authority-changed",
          "expr": "any(op in result.delta.ops, match op { put-schema => true, put-member => true, _ => false })"
        },
        {
          "name": "triggered",
          "expr": "any(tr in values(call triggers-of(t.schema)), (match tr.paused { Some(p) => !p, None => true }) && any(e in result.events, call trigger-matches(tr.on, e.body)))"
        }
      ],
      "body": "if !authority-changed && !triggered then result else try call after-decision-run(t, ctx, result, authority-changed)",
