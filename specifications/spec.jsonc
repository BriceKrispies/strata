      ],
      "errors": [],
      "exposure": "local"
    },
    {
      "id": "seal-field",
      "name": "Encrypt under a data key",
      "ref": "H-019",
      "realisation": "hand",
      "milestone": 3,
      "implementedBy": "key-service",
      "auth": {
        "scheme": "in-process",
