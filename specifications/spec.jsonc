      "id": "session-idle-lapsed",
      "name": "A session used after its idle lifetime",
      "description": "The session is used 13 hours after sign-in, and the realm lets an unused session live 12 hours.",
      "behaviors": [
        "session-lifetime-flow"
      ],
      "steps": [
        {
          "at": 0,
          "event": "sl-issued"
        },
        {
