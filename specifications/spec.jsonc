      },
      {
        "entity": "component",
        "name": "trustLevel",
        "type": "number",
        "label": "Trust level",
        "doc": "Position (1 least trusted to 6 most trusted) of the white paper's \"Trust boundaries\" item that names this component."
      },
      {
        "entity": "component",
        "name": "mentions",
        "type": "list",
        "items": {
          "type": "ref",
          "ref": [
            "goal",
