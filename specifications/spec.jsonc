    {"id":"ui-session-requested","name":"Session read requested","description":"The web application asks the gateway for the session again.","delivery":"at-least-once"},
    {"id":"ui-notice-received","name":"Notice received","description":"A notice frame arrives on the live connection. kind is upsert or remove (a record of the object type object changed), schema or membership (object is empty).","payload":[{"name":"kind","type":"string"},{"name":"object","type":"string"}]},
    {"id":"ui-live-start","name":"Live connection started","description":"The page starts and opens the socket."},
