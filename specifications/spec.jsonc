        }
      ]
    },
    {
      "id": "automation-roles",
      "description": "automation.rs automation_roles: the roles of the principal automation:<workflow-id> under a schema: exactly the run-as roles of its automation, and none when the schema holds no such automation or the automation is suspended (WFL-1527, WFL-1529). The principal id is compared with the text automation:<id> of each automation the schema holds, because the body language has no substring; the automation principal holds no public role and none of the table of members.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "id",
          "type": "principal-id"
        }
      ],
      "returns": "set<role-id>",
      "body": "fold(def in values(call automations-of(schema)), acc = [], if format('automation:{}', def.id) == id && def.suspended-for == null then def.run-as.roles else acc)",
      "examples": [
        {
          "description": "The run-as roles of the automation, and no public.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-30"
            },
            "id": "automation:award"
          },
          "result": [
            "editor"
          ]
        },
        {
          "description": "Every run-as role, in order.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-30"
            },
            "id": "automation:both"
          },
          "result": [
            "editor",
            "writer"
          ]
        },
        {
          "description": "An automation that acts with no role holds none.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-30"
            },
            "id": "automation:none"
          },
          "result": []
        },
        {
          "description": "A suspended automation holds none (WFL-1529).",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-30"
            },
            "id": "automation:frozen"
          },
          "result": []
        },
        {
          "description": "An automation the schema does not hold, whose principal holds no role.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-30"
            },
            "id": "automation:gone"
          },
          "result": []
        },
        {
          "description": "A schema without automations holds none.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-6"
            },
            "id": "automation:award"
          },
          "result": []
        }
      ]
    },
    {
      "id": "trigger-detail",
      "description": "triggers.rs detail: a detail of at most 256 characters (rec-automation-exception.detail).",
      "params": [
        {
          "name": "text",
          "type": "string"
        }
      ],
      "returns": "string",
      "body": "if length(text) <= 256 then text else fold(c in take(chars(text), 256), a = '', a + c)",
      "examples": [
        {
          "args": {
            "text": "short"
          },
          "result": "short"
        },
        {
          "args": {
            "text": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          },
          "result": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        {
          "args": {
            "text": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          },
          "result": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        {
          "args": {
            "text": "éééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééé"
          },
