    {
      "id": "constraint-checks",
      "description": "rules.rs validate_record, constraint loop: each constraint of the object type (in id order) is evaluated with record and new the candidate, old the stored record, no parameters; false fails with ConstraintViolated, an evaluation error with Evaluation, anything else passes. texts holds the printed form of each constraint expression (the kernel writes it with Display); see the report of WG-4937.",
      "params": [
        {
          "name": "object",
          "type": "object-type-def"
        },
        {
          "name": "candidate",
          "type": "record"
        },
        {
          "name": "old",
          "type": "option<record>"
        },
        {
          "name": "who",
          "type": "principal"
        },
        {
          "name": "now",
          "type": "timestamp"
        },
        {
          "name": "roles",
          "type": "set<role-id>"
        },
        {
          "name": "texts",
          "type": "map<constraint-id, string>"
        },
        {
          "name": "acc",
          "type": "validation-outcome"
        }
      ],
      "returns": "validation-outcome",
      "let": [
        {
          "name": "scope-new",
          "expr": "call record-scope(candidate)"
        },
        {
          "name": "env",
          "expr": "expr-env{record: scope-new, old: match old { Some(o) => call record-scope(o), None => null }, new: scope-new, param: {}, now: value.time(now), principal: call principal-value(who), has_role: roles}"
        }
      ],
      "body": "fold(c in values(object.constraints), a = acc, let rule = format('constraint:{}.{}', object.id, c.id) in let text = match get(texts, c.id) { Some(t) => t, None => '' } in match eval(tenant-rule-language, c.expr, env) { Ok(r) => match r { bool(b) => if b then call outcome-pass(a, rule, text) else call outcome-fail(a, error-kind.constraint-violated, rule, format('{} [{}]', c.message, text)), _ => call outcome-pass(a, rule, text) }, Err(e) => call outcome-fail(a, error-kind.evaluation, rule, format('{}: {}', text, e)) })",
      "examples": [
        {
          "description": "behaviour.rs a_rejection_explains_itself",
