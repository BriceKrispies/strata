    {
      "id": "setting-effects-step",
      "description": "settings.rs schema_change_effects, one change: a defined setting whose type differs from the one it has (the definition of the tenant, or that of an earlier change) while overrides of it exist is the problem \"setting <id>: the type changes from <a> to <b> while overrides of it exist (SET-004)\"; a removed setting's overrides are deleted (once, in key order); each change raises the revision of its setting at the tenant by one (from the revision of an earlier change, else the tenant's) and is an event that names the setting, the tenant level and the tenant (SET-051, D-5048). A removal leaves the setting with no type, written as the empty text.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "acc",
          "type": "setting-effects-acc"
        },
        {
          "name": "id",
          "type": "setting-id"
        },
        {
          "name": "after",
          "type": "string"
        },
        {
          "name": "removal",
          "type": "bool"
        }
      ],
      "returns": "setting-effects-acc",
      "let": [
        {
          "name": "before",
          "expr": "match get(acc.types, id) { Some(t) => t, None => match get(call settings-of(tenant.schema), id) { Some(d) => d.type, None => '' } }"
        },
        {
          "name": "overrides",
          "expr": "filter(o in values(call setting-overrides-of(tenant)), o.setting == id)"
        },
        {
          "name": "held",
          "expr": "!any(e in acc.emptied, e == id) && overrides != []"
        }
      ],
      "body": "if !removal && held && before != '' && before != after then setting-effects-acc{ops: acc.ops, events: acc.events, revisions: acc.revisions, types: acc.types, emptied: acc.emptied, problem: format('setting {}: the type changes from {} to {} while overrides of it exist (SET-004)', id, before, after)} else let first = removal && !any(e in acc.emptied, e == id) in setting-effects-acc{ops: if first then concat(acc.ops, map(o in overrides, delta-op.delete-setting-override{setting: o.setting, level: o.level, subject: o.subject})) else acc.ops, events: concat(acc.events, [event-body.setting-changed{setting: id, level: setting-level.tenant, subject: tenant.id}]), revisions: insert(acc.revisions, id, (match get(acc.revisions, id) { Some(r) => r, None => call setting-revision-of(tenant, id) }) + 1), types: insert(acc.types, id, if removal then '' else after), emptied: if first then concat(acc.emptied, [id]) else acc.emptied, problem: null}",
      "examples": [
        {
          "description": "A setting defined for the first time: its revision is the first and an event names it.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-36"
            },
            "acc": {
              "ops": [],
              "events": [],
              "revisions": {},
              "types": {},
              "emptied": [],
              "problem": null
            },
            "id": "mode",
            "after": "string",
            "removal": false
          },
          "result": {
            "ops": [],
            "events": [
              {
                "setting-changed": {
                  "setting": "mode",
                  "level": "tenant",
                  "subject": "alpha"
                }
              }
            ],
            "revisions": {
              "mode": 1
            },
            "types": {
              "mode": "string"
            },
            "emptied": [],
            "problem": null
          }
        },
        {
          "description": "A definition replaced with the same type keeps the overrides and raises the revision from the tenant's.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-37"
            },
            "acc": {
              "ops": [],
              "events": [],
              "revisions": {},
              "types": {},
              "emptied": [],
              "problem": null
            },
            "id": "theme",
            "after": "string",
            "removal": false
          },
          "result": {
            "ops": [],
            "events": [
              {
                "setting-changed": {
                  "setting": "theme",
                  "level": "tenant",
                  "subject": "alpha"
                }
              }
            ],
            "revisions": {
              "theme": 3
            },
            "types": {
              "theme": "string"
            },
            "emptied": [],
            "problem": null
          }
        },
        {
          "description": "A type that changes while overrides exist is the problem (SET-004).",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-37"
            },
            "acc": {
              "ops": [],
              "events": [],
              "revisions": {},
              "types": {},
              "emptied": [],
              "problem": null
            },
            "id": "theme",
            "after": "bool",
            "removal": false
          },
          "result": {
            "ops": [],
            "events": [],
            "revisions": {},
            "types": {},
            "emptied": [],
            "problem": "setting theme: the type changes from string to bool while overrides of it exist (SET-004)"
          }
        },
        {
          "description": "A type that changes when no override exists is accepted.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-36"
            },
            "acc": {
              "ops": [],
              "events": [],
              "revisions": {},
              "types": {},
              "emptied": [],
              "problem": null
            },
            "id": "theme",
            "after": "bool",
            "removal": false
          },
          "result": {
            "ops": [],
            "events": [
              {
                "setting-changed": {
                  "setting": "theme",
                  "level": "tenant",
                  "subject": "alpha"
                }
              }
            ],
