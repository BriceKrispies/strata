    {
      "id": "plan-migration",
      "description": "transition.rs plan_migration, the body of contract plan-schema-migration (CT-007) through kernel-plan-migration, which calls it with a complete snapshot: apply the changes in order to a working copy of the tenant's schema (a refused change is InvalidSchema with the schema:change checks so far and the failed one); a working copy with problems (schema-problems) is InvalidSchema with the first problem as message and one schema:consistency check per problem; otherwise the version is one higher and every record of each touched object type that already existed is re-validated as the system against the new schema, after its fields the new schema no longer declares are stripped (such a record is rewritten, its version unchanged). Each failed check of a record is a violation. texts.constraints holds the printed constraints of the new schema.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "coverage",
          "type": "coverage"
        },
        {
          "name": "changes",
          "type": "list<schema-change>"
        },
        {
          "name": "now",
          "type": "timestamp"
        },
        {
          "name": "texts",
          "type": "intent-texts"
        }
      ],
      "returns": "migration-plan",
      "errors": "rejection",
      "let": [
        {
          "name": "current",
          "expr": "tenant.schema"
        },
        {
          "name": "applied",
          "expr": "fold(c in changes, acc = migration-progress{schema: current, summary: [], evidence: []}, match call apply-change(acc.schema, c) { Ok(st) => migration-progress{schema: st.schema, summary: concat(acc.summary, [st.line]), evidence: concat(acc.evidence, [check{rule: 'schema:change', passed: true, detail: st.line}])}, Err(e) => match e { problem(p) => fail(rejection.rejected(domain-error{kind: error-kind.invalid-schema, message: p, evidence: concat(acc.evidence, [check{rule: 'schema:change', passed: false, detail: p}])})) } })"
        },
        {
          "name": "problems",
          "expr": "call schema-problems(applied.schema)"
        },
        {
          "name": "schema",
          "expr": "tenant-schema{version: current.version + 1, objects: applied.schema.objects, roles: applied.schema.roles, policies: applied.schema.policies, workflows: applied.schema.workflows, queries: applied.schema.queries, views: applied.schema.views}"
        }
      ],
      "body": "match get(problems, 0) { Some(first) => fail(rejection.rejected(domain-error{kind: error-kind.invalid-schema, message: first, evidence: concat(applied.evidence, map(p in problems, check{rule: 'schema:consistency', passed: false, detail: p}))})), None => fold(o in call touched-objects(changes), acc = migration-plan{schema, summary: applied.summary, rewritten: [], violations: []}, match get(schema.objects, o) { None => acc, Some(def) => if get(current.objects, o) == null then acc else fold(r in try call lookup-all(tenant, coverage, o), a = acc, let stripped = fold(k in keys(r.fields), m = {}, if get(def.fields, k) == null then m else match get(r.fields, k) { Some(x) => insert(m, k, x), None => m }) in let same = keys(stripped) == keys(r.fields) in let candidate = if same then r else record{id: r.id, object: r.object, version: r.version, created-by: r.created-by, created-at: r.created-at, updated-at: r.updated-at, fields: stripped} in let outcome = try call validate-record(tenant, coverage, schema, def, candidate, null, principal.system, now, match get(texts.constraints, o) { Some(m) => m, None => {} }) in migration-plan{schema: a.schema, summary: a.summary, rewritten: if same then a.rewritten else concat(a.rewritten, [candidate]), violations: concat(a.violations, map(f in outcome.failed, violation{object: o, id: r.id, check: f.check, kind: f.kind}))}) }) }",
      "examples": [
