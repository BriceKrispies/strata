    {
      "id": "automation-def-problems",
      "description": "definitions.rs automation_problems, one automation: an id taken by a field workflow, more than fifty steps, an unknown start step, each run-as role the schema does not declare or that is public, a run key that does not check, the problems of each step in name order (automation-step-problems), and, when the start step exists, each step that cannot be reached from it.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "roles",
          "type": "list<role-id>"
        },
        {
          "name": "a",
          "type": "automation-def"
        }
      ],
      "returns": "list<string>",
      "let": [
        {
          "name": "at",
          "expr": "format('automation {}', a.id)"
        },
        {
          "name": "p1",
          "expr": "if get(schema.workflows, a.id) == null then [] else [format('{}: the id is taken by a field workflow', at)]"
        },
        {
          "name": "p2",
          "expr": "if length(keys(a.steps)) > 50 then [format('{}: {} steps is more than the maximum of 50', at, length(keys(a.steps)))] else []"
        },
        {
          "name": "has-start",
          "expr": "get(a.steps, a.start) != null"
        },
        {
          "name": "p3",
          "expr": "if has-start then [] else [format('{}: unknown start step {}', at, a.start)]"
        },
        {
          "name": "p4",
          "expr": "fold(r in a.run-as.roles, ps = [], concat(concat(ps, if any(k in roles, k == r) then [] else [format('{}: unknown role {}', at, r)]), if r == 'public' then [format('{}: everyone already holds public', at)] else []))"
        },
        {
          "name": "env",
          "expr": "expr-check-env{fields: {}, params: call automation-params(a), roles}"
        },
        {
          "name": "p5",
          "expr": "match a.run-key { Some(k) => call expr-problem(at, 'run key', k, env), None => [] }"
        },
        {
          "name": "p6",
          "expr": "fold(n in keys(a.steps), ps = [], match get(a.steps, n) { Some(s) => concat(ps, call automation-step-problems(schema, a, format('{}.{}', at, n), s, env)), None => ps })"
        },
        {
          "name": "reached",
          "expr": "call reachable-steps(a)"
        },
        {
          "name": "p7",
          "expr": "if has-start then fold(n in keys(a.steps), ps = [], if any(r in reached, r == n) then ps else concat(ps, [format('{}.{}: cannot be reached from the start step', at, n)])) else []"
        }
      ],
      "body": "concat(concat(concat(concat(concat(concat(p1, p2), p3), p4), p5), p6), p7)",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-10"
            },
            "roles": [
              "editor",
              "owner",
              "public"
            ],
            "a": {
              "fixture": "fx-automation-def-1"
            }
          },
          "result": []
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-10"
            },
            "roles": [
              "editor",
              "owner",
              "public"
            ],
            "a": {
              "fixture": "fx-automation-def-1",
              "with": {
                "id": "note_status",
                "run-as.roles": [
                  "ghost",
                  "public"
                ],
                "start": "begin",
                "steps.lost": {
                  "action": "end"
                },
                "run-key": {
                  "param": "nope"
                }
              }
            }
          },
          "result": [
            "automation note_status: the id is taken by a field workflow",
            "automation note_status: unknown start step begin",
            "automation note_status: unknown role ghost",
            "automation note_status: everyone already holds public",
            "automation note_status: run key: undeclared parameter nope"
          ]
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-10"
            },
            "roles": [
              "editor",
              "owner",
              "public"
            ],
            "a": {
              "fixture": "fx-automation-def-1",
              "with": {
                "steps.lost": {
                  "action": "end"
                }
              }
            }
          },
          "result": [
            "automation award.lost: cannot be reached from the start step"
          ]
        }
      ]
    },
    {
      "id": "automation-problems",
      "description": "definitions.rs automation_problems (D-6520 to D-6535, INT-1522, CT-792): the problems of each automation in id order.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "roles",
          "type": "list<role-id>"
        }
      ],
      "returns": "list<string>",
      "body": "fold(a in values(call automations-of(schema)), ps = [], concat(ps, call automation-def-problems(schema, roles, a)))",
      "examples": [
        {
          "args": {
