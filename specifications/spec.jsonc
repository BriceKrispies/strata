    {
      "id": "order-rows",
      "description": "read.rs read, the order of a named query: the rows (in id order) sorted by each order key in turn, the first key most significant, equal keys in id order. A stable sort per key from the last to the first gives the lexicographic order the kernel's comparator gives.",
      "params": [
        {
          "name": "rows",
          "type": "list<record>"
        },
        {
          "name": "order",
          "type": "list<order-key>"
        }
      ],
      "returns": "list<record>",
      "body": "fold(k in fold(k in order, acc = [], concat([k], acc)), xs = rows, call order-pass(xs, k))",
      "examples": [
