      ]
    },
    {
      "id": "expr-problem",
      "description": "definitions.rs check_expr without truth: the problem of an expression of a definition at a place, named what, that does not check.",
      "params": [
        {
          "name": "at",
          "type": "string"
        },
        {
          "name": "what",
          "type": "string"
        },
        {
          "name": "e",
          "type": "expr"
        },
        {
          "name": "env",
          "type": "expr-check-env"
        }
      ],
      "returns": "list<string>",
      "body": "match check(tenant-rule-language, e, env) { Ok(_) => [], Err(err) => [format('{}: {}: {}', at, what, err)] }",
      "examples": [
        {
          "args": {
            "at": "automation a.s",
            "what": "to",
            "e": {
              "param": "owner"
            },
            "env": {
              "fields": {},
              "params": [
                "owner"
              ],
              "roles": [
                "editor",
                "owner",
                "public"
              ]
            }
          },
          "result": []
        },
        {
          "args": {
            "at": "automation a.s",
            "what": "to",
            "e": {
              "param": "who"
            },
            "env": {
              "fields": {},
              "params": [
                "owner"
              ],
              "roles": [
                "editor",
                "owner",
                "public"
              ]
            }
          },
          "result": [
            "automation a.s: to: undeclared parameter who"
          ]
        }
      ]
    },
    {
      "id": "truth-problem",
      "description": "definitions.rs check_expr with truth: the problem of a condition of a definition that does not check, or checks as a shape other than bool or any.",
      "params": [
        {
          "name": "at",
          "type": "string"
        },
        {
          "name": "what",
          "type": "string"
        },
        {
          "name": "e",
          "type": "expr"
        },
        {
          "name": "env",
          "type": "expr-check-env"
        }
      ],
      "returns": "list<string>",
      "body": "match check(tenant-rule-language, e, env) { Ok(s) => if s == 'bool' || s == 'any' then [] else [format('{}: {} is {}, not a truth value', at, what, call shape-debug(s))], Err(err) => [format('{}: {}: {}', at, what, err)] }",
      "examples": [
        {
          "args": {
            "at": "trigger t",
            "what": "condition",
            "e": {
              "cmp": {
                "op": "ge",
                "left": {
                  "param": "balance"
                },
                "right": {
                  "lit": {
                    "int": 5
                  }
                }
              }
            },
            "env": {
              "fields": {},
              "params": [
                "balance"
              ],
              "roles": [
                "editor",
                "owner",
                "public"
              ]
            }
          },
          "result": []
        },
        {
          "args": {
            "at": "trigger t",
            "what": "condition",
            "e": {
              "lit": {
                "str": "x"
              }
            },
            "env": {
              "fields": {},
              "params": [],
              "roles": [
                "editor",
                "owner",
                "public"
              ]
            }
          },
          "result": [
            "trigger t: condition is Str, not a truth value"
          ]
        },
        {
          "args": {
            "at": "trigger t",
            "what": "condition",
            "e": {
              "param": "nope"
            },
            "env": {
              "fields": {},
              "params": [],
              "roles": [
                "editor",
                "owner",
                "public"
              ]
            }
          },
          "result": [
            "trigger t: condition: undeclared parameter nope"
          ]
        }
      ]
    },
    {
      "id": "is-param-name",
      "description": "definitions.rs is_param_name: whether a name can be read as param.<name>: [a-z][a-z0-9_]*.",
      "params": [
        {
          "name": "name",
          "type": "string"
        }
      ],
      "returns": "bool",
      "let": [
        {
          "name": "cs",
          "expr": "chars(name)"
        }
      ],
      "body": "match get(cs, 0) { Some(c0) => isAsciiLowercase(c0) && all(c in cs, isAsciiLowercase(c) || isAsciiDigit(c) || c == '_'), None => false }",
      "examples": [
        {
          "args": {
            "name": "note"
          },
          "result": true
        },
        {
          "args": {
            "name": "a_1"
          },
          "result": true
        },
        {
          "args": {
            "name": "1a"
          },
          "result": false
        },
        {
          "args": {
            "name": ""
          },
          "result": false
        },
        {
          "args": {
            "name": "Big"
          },
          "result": false
        }
      ]
    },
    {
      "id": "repeated-names",
      "description": "definitions.rs repeated: the names that occur more than once, each once, in the order of their first occurrence.",
      "params": [
        {
          "name": "names",
          "type": "list<string>"
        }
      ],
      "returns": "list<string>",
      "let": [
        {
          "name": "distinct",
          "expr": "fold(n in names, acc = [], if any(a in acc, a == n) then acc else concat(acc, [n]))"
        }
      ],
      "body": "filter(n in distinct, length(filter(m in names, m == n)) > 1)",
      "examples": [
        {
          "args": {
            "names": [
              "a",
              "b",
              "a",
              "c",
              "b",
              "a"
            ]
          },
          "result": [
            "a",
            "b"
          ]
        },
        {
          "args": {
            "names": [
              "a"
            ]
          },
          "result": []
        }
      ]
    },
    {
      "id": "unique-problems",
      "description": "definitions.rs unique_problems (D-6558, CMS-1556): per composite unique constraint of an object type, in id order: a count of fields other than two to four, each field that the type does not declare or that is a list field (in the order named), a field named twice, and a blank message.",
      "params": [
        {
          "name": "object",
          "type": "object-type-def"
        }
      ],
      "returns": "list<string>",
      "body": "fold(u in values(call uniques-of(object)), ps = [], let at = format('{}.{}', object.id, u.id) in let n = length(u.fields) in concat(concat(concat(concat(ps, if n < 2 || n > 4 then [format('{}: a unique constraint names {} fields, not two to four', at, n)] else []), fold(f in u.fields, qs = [], concat(qs, match get(object.fields, f) { None => [format('{}: unknown field {}', at, f)], Some(d) => match d.ty { list(_) => [format('{}: {} is a list field', at, f)], _ => [] } }))), if length(fold(f in u.fields, acc = [], if any(a in acc, a == f) then acc else concat(acc, [f]))) < n then [format('{}: names a field twice', at)] else []), if trim(u.message) == '' then [format('{}: a unique constraint needs a message', at)] else []))",
      "examples": [
        {
          "args": {
            "object": {
              "fixture": "fx-object-type-def-4"
            }
          },
          "result": []
        },
        {
          "args": {
            "object": {
              "fixture": "fx-object-type-def-4",
              "with": {
                "unique": {
                  "bad": {
                    "id": "bad",
                    "fields": [
                      "tags",
                      "colour",
                      "tags"
                    ],
                    "message": " "
                  }
                }
              }
            }
          },
          "result": [
            "note.bad: tags is a list field",
            "note.bad: unknown field colour",
            "note.bad: tags is a list field",
            "note.bad: names a field twice",
            "note.bad: a unique constraint needs a message"
          ]
        },
        {
          "args": {
            "object": {
              "fixture": "fx-object-type-def-4",
              "with": {
                "unique": {
                  "one": {
                    "id": "one",
                    "fields": [
                      "title"
                    ],
                    "message": "m"
                  }
                }
              }
            }
          },
          "result": [
            "note.one: a unique constraint names 1 fields, not two to four"
          ]
        }
      ]
    },
    {
      "id": "lookup-by-fields",
      "description": "rules.rs Lookup::by_fields (D-6558): the records of an object type whose every named field equals its value, in id order; refused when the snapshot does not cover the question (one by-fields need, CMS-1557).",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "coverage",
          "type": "coverage"
        },
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "wanted-fields",
          "type": "map<field-id, value>"
        }
      ],
      "returns": "list<record>",
      "errors": "rejection",
      "let": [
        {
          "name": "wanted",
          "expr": "need.by-fields{object, fields: wanted-fields}"
        }
      ],
      "body": "if call covers(coverage, wanted) then match get(tenant.records, object) { Some(rs) => filter(r in values(rs), all(k in keys(wanted-fields), get(r.fields, k) == get(wanted-fields, k))), None => [] } else fail(rejection.rejected(call insufficient(wanted)))",
      "examples": [
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-21"
            },
            "coverage": "complete",
            "object": "note",
            "wanted-fields": {
              "status": {
                "str": "draft"
              },
              "title": {
                "str": "First"
              }
            }
          },
          "result": [
            {
              "id": 1,
              "object": "note",
              "version": 1,
              "created-by": "alpha:writer1",
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "status": {
                  "str": "draft"
                },
                "title": {
                  "str": "First"
                }
              }
            }
          ]
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-21"
            },
            "coverage": {
              "partial": [
                {
                  "by-fields": {
                    "object": "note",
                    "fields": {
                      "status": {
                        "str": "draft"
                      },
                      "title": {
                        "str": "First"
                      }
                    }
                  }
                }
              ]
            },
            "object": "note",
            "wanted-fields": {
              "status": {
                "str": "draft"
              },
              "title": {
                "str": "Third"
              }
            }
          },
          "error": {
            "rejected": {
              "kind": "insufficient-state",
              "message": "the snapshot does not cover ByFields { object: ObjectTypeId(\"note\"), fields: {FieldId(\"status\"): Str(\"draft\"), FieldId(\"title\"): Str(\"Third\")} }",
              "evidence": [
                {
                  "rule": "coverage",
