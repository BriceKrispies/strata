        {
          "description": "behaviour.rs a policy that follows a reference on a partial snapshot: writers_edit_attributed reads record.author.name, and the snapshot covers note 1 but not person 1 it refers to, so the update is InsufficientState naming person 1 (transition.rs Draft::require), not a denial.",
          "args": {
            "d": {
              "fixture": "fx-draft-2",
              "with": {
                "tenant.schema.policies.writers_edit_attributed": {
                  "id": "writers_edit_attributed",
                  "role": "writer",
                  "resource": {
                    "object": "note"
                  },
                  "actions": [
                    "update"
                  ],
                  "condition": {
                    "not": {
                      "is-null": {
                        "through": {
                          "scope": "record",
                          "reference": "author",
                          "field": "name"
                        }
                      }
                    }
                  }
                },
                "tenant.records.note.1.fields.author": {
                  "ref": 1
                },
                "coverage": {
                  "partial": [
                    {
                      "record": {
                        "object": "note",
                        "id": 1
                      }
                    }
                  ]
                }
              }
            },
            "action": "update",
            "resource": {
              "object": "note"
            },
            "subject": {
              "old": {
                "id": 1,
                "object": "note",
                "version": 1,
                "created-by": "alpha:writer1",
                "created-at": 5000,
                "updated-at": 5000,
                "fields": {
                  "slug": {
                    "str": "first"
                  },
                  "status": {
                    "str": "draft"
                  },
                  "title": {
                    "str": "First"
                  },
                  "author": {
                    "ref": 1
                  }
                }
              },
              "new": {
                "id": 1,
                "object": "note",
                "version": 1,
                "created-by": "alpha:writer1",
                "created-at": 5000,
                "updated-at": 5000,
                "fields": {
                  "slug": {
                    "str": "first"
                  },
                  "status": {
                    "str": "draft"
                  },
                  "title": {
                    "str": "First"
                  },
                  "author": {
                    "ref": 1
                  }
                }
              }
            }
          },
          "error": {
            "rejected": {
              "kind": "insufficient-state",
              "message": "the snapshot does not cover Record { object: ObjectTypeId(\"person\"), id: RecordId(1) }",
              "evidence": [
                {
                  "rule": "coverage",
                  "passed": false,
                  "detail": "Record { object: ObjectTypeId(\"person\"), id: RecordId(1) }"
                }
              ],
              "missing": {
                "record": {
                  "object": "person",
                  "id": 1
                }
              }
            }
          }
        }
      ]
