    {
      "id": "match-route",
      "description": "crates/substrate/src/project.rs match_route: the view (in id order) whose route has as many segments as the path and matches it segment by segment, a literal exactly and a :name taking the path's segment as its parameter; of several, the first with the most literal segments. wanted is the path split at / without empty segments, and routes each view's route so split and read (route-segment): stand-ins until the function language has string operations (WG-4957).",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "wanted",
          "type": "list<string>"
        },
        {
          "name": "routes",
          "type": "map<view-id, list<route-segment>>"
        }
      ],
      "returns": "option<route-match>",
      "let": [
        {
          "name": "picked",
          "expr": "fold(v in values(schema.views), best = route-pick{literal: 0, found: null}, let pattern = match get(routes, v.id) { Some(p) => p, None => [] } in if fold(s in pattern, n = 0, n + 1) != fold(w in wanted, n = 0, n + 1) then best else let tried = fold(seg in pattern, acc = route-try{at: 0, ok: true, literal: 0, params: {}}, match seg { param(name) => route-try{at: acc.at + 1, ok: acc.ok, literal: acc.literal, params: if acc.ok then insert(acc.params, name, match get(wanted, acc.at) { Some(w) => w, None => '' }) else acc.params}, literal(text) => route-try{at: acc.at + 1, ok: acc.ok && get(wanted, acc.at) == text, literal: if acc.ok then acc.literal + 1 else acc.literal, params: acc.params} }) in if tried.ok && (best.found == null || tried.literal > best.literal) then route-pick{literal: tried.literal, found: route-match{view: v, params: tried.params}} else best)"
        }
      ],
      "body": "picked.found",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-18"
            },
            "wanted": [
              "posts",
              "B"
            ],
            "routes": {
              "home": [],
              "one": [
                {
                  "literal": "posts"
                },
                {
                  "param": "title"
                }
              ]
            }
          },
          "result": {
            "view": {
              "id": "one",
              "route": "/posts/:title",
              "title": "Post",
              "sections": {
                "post": {
                  "query": "by_title",
                  "args": {
                    "title": {
                      "route": "title"
                    }
                  },
                  "include": [],
                  "markdown": [],
                  "single": true
                }
              }
            },
            "params": {
              "title": "B"
            }
          }
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-18"
            },
            "wanted": [],
            "routes": {
              "home": [],
              "one": [
                {
                  "literal": "posts"
                },
                {
                  "param": "title"
                }
              ]
            }
          },
          "result": {
            "view": {
              "id": "home",
              "route": "/",
              "title": "Home",
              "sections": {
                "posts": {
                  "query": "published",
                  "args": {},
                  "include": [
                    "author"
                  ],
                  "markdown": [],
                  "single": false
                }
              }
            },
            "params": {}
          }
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-18"
            },
            "wanted": [
              "pages",
              "B"
            ],
            "routes": {
              "home": [],
              "one": [
                {
                  "literal": "posts"
                },
                {
                  "param": "title"
                }
              ]
            }
          },
          "result": null
        },
        {
          "description": "The match with the most literal segments wins.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-18"
            },
            "wanted": [
              "posts",
              "new"
            ],
            "routes": {
              "home": [
                {
                  "literal": "posts"
                },
                {
                  "literal": "new"
                }
              ],
              "one": [
                {
                  "literal": "posts"
                },
                {
                  "param": "title"
                }
              ]
            }
          },
          "result": {
            "view": {
              "id": "home",
              "route": "/",
              "title": "Home",
              "sections": {
                "posts": {
                  "query": "published",
                  "args": {},
                  "include": [
                    "author"
                  ],
                  "markdown": [],
                  "single": false
                }
              }
            },
            "params": {}
          }
        }
      ]
    },
    {
      "id": "section-depends",
      "description": "project.rs section_order, depends: whether a section reads an attribute of another section's row.",
      "params": [
        {
          "name": "section",
          "type": "view-section"
        }
      ],
      "returns": "bool",
      "body": "any(a in values(section.args), match a { section => true, _ => false })",
      "examples": [
