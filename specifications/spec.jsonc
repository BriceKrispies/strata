    {
      "id": "policy-problems",
      "description": "schema.rs TenantSchema::problems, one policy: an unknown role, a policy for the owner, an unknown object type, an action that does not fit the resource (Manage exactly on Schema and Members), and a condition that does not check against the object's fields. A condition of a policy on every object that reads a field is approximated: see the report of WG-4937.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "roles",
          "type": "list<role-id>"
        },
        {
          "name": "policy",
          "type": "policy-def"
        }
      ],
      "returns": "list<string>",
      "let": [
        {
          "name": "at",
          "expr": "format('policy {}', policy.id)"
        },
        {
          "name": "p1",
          "expr": "concat(if any(r in roles, r == policy.role) then [] else [format('{}: unknown role {}', at, policy.role)], if policy.role == 'owner' then [format('{}: the owner role needs no policy', at)] else [])"
        },
        {
          "name": "p2",
          "expr": "match policy.resource { object(id) => if get(schema.objects, id) == null then [format('{}: unknown object type {}', at, id)] else [], _ => [] }"
        },
        {
          "name": "manage",
          "expr": "match policy.resource { schema => true, members => true, _ => false }"
        },
        {
          "name": "p3",
          "expr": "fold(a in policy.actions, ps = [], if manage != (a == action.manage) then concat(ps, [format('{}: action {} does not fit the resource', at, call action-debug(a))]) else ps)"
        },
        {
          "name": "shapes",
          "expr": "match policy.resource { object(id) => match get(schema.objects, id) { Some(o) => call field-shapes(o.fields), None => {} }, _ => {} }"
        },
        {
          "name": "p4",
          "expr": "match policy.condition { Some(c) => match policy.resource { any-object => match check(tenant-rule-language, c, expr-check-env{fields: {}, params: [], roles}) { Ok(_) => [], Err(e) => [format('{}: a policy on every object cannot read fields', at)] }, _ => match check(tenant-rule-language, c, expr-check-env{fields: shapes, params: [], roles}) { Ok(_) => [], Err(e) => [format('{}: {}', at, e)] } }, None => [] }"
        }
      ],
      "body": "concat(concat(concat(p1, p2), p3), p4)",
