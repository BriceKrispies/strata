    {
      "id": "constraint-checks",
      "description": "rules.rs validate_record, constraint loop: each constraint of the object type (in id order) is evaluated with record and new the candidate, old the stored record, no parameters; false fails with ConstraintViolated, an evaluation error with Evaluation, anything else passes. texts holds the printed form of each constraint expression (the kernel writes it with Display); see the report of WG-4937.",
      "params": [
        {
          "name": "object",
          "type": "object-type-def"
        },
        {
          "name": "candidate",
          "type": "record"
        },
        {
          "name": "old",
          "type": "option<record>"
        },
        {
          "name": "who",
          "type": "principal"
        },
        {
          "name": "now",
          "type": "timestamp"
        },
        {
          "name": "roles",
          "type": "set<role-id>"
        },
        {
          "name": "acc",
          "type": "validation-outcome"
        }
      ],
      "returns": "validation-outcome",
      "let": [
        {
          "name": "scope-new",
          "expr": "call record-scope(candidate)"
        },
        {
          "name": "env",
          "expr": "expr-env{record: scope-new, old: match old { Some(o) => call record-scope(o), None => null }, new: scope-new, param: {}, now: value.time(now), principal: call principal-value(who), has_role: roles}"
        }
      ],
      "body": "fold(c in values(object.constraints), a = acc, let rule = format('constraint:{}.{}', object.id, c.id) in let text = print(tenant-rule-language, c.expr) in match eval(tenant-rule-language, c.expr, env) { Ok(r) => match r { bool(b) => if b then call outcome-pass(a, rule, text) else call outcome-fail(a, error-kind.constraint-violated, rule, format('{} [{}]', c.message, text)), _ => call outcome-pass(a, rule, text) }, Err(e) => call outcome-fail(a, error-kind.evaluation, rule, format('{}: {}', text, e)) })",
      "examples": [
        {
          "description": "behaviour.rs a_rejection_explains_itself",
          "args": {
            "object": {
              "fixture": "fx-object-type-def-1"
            },
            "candidate": {
              "fixture": "fx-record-3"
            },
            "who": {
              "user": "alpha:writer1"
            },
            "now": 5000,
            "roles": [
              "public",
              "writer"
            ],
            "acc": {
              "passed": [],
              "failed": []
            }
          },
          "result": {
            "passed": [],
            "failed": [
              {
                "check": {
                  "rule": "constraint:note.title_length",
                  "passed": false,
                  "detail": "A title has at most 24 characters [(len(new.title) <= 24)]"
                },
                "kind": "constraint-violated"
              }
            ]
          }
        },
        {
          "description": "An unset excerpt makes len null, which does not violate.",
          "args": {
            "object": {
              "fixture": "fx-object-type-def-2",
              "with": {
                "constraints": {
                  "excerpt_length": {
                    "id": "excerpt_length",
                    "expr": {
                      "cmp": {
                        "op": "le",
                        "left": {
                          "len": {
                            "var": {
                              "scope": "new",
                              "field": "excerpt"
                            }
                          }
                        },
                        "right": {
                          "lit": {
                            "int": 280
                          }
                        }
                      }
                    },
                    "message": "An excerpt has at most 280 characters"
                  }
                }
              }
            },
            "candidate": {
              "id": 5,
              "object": "post",
              "version": 1,
              "created-by": "site:ann",
              "created-at": 1005,
              "updated-at": 1005,
              "fields": {
                "title": {
                  "str": "Draft"
                },
                "slug": {
                  "str": "draft"
                },
                "body": {
                  "str": "Text."
                },
                "author": {
                  "ref": 2
                },
                "status": {
                  "str": "draft"
                }
              }
            },
            "who": {
              "user": "site:ann"
            },
            "now": 6000,
            "roles": [
              "author",
              "public"
            ],
            "acc": {
              "passed": [],
              "failed": []
            }
          },
          "result": {
            "passed": [
              {
                "rule": "constraint:post.excerpt_length",
                "passed": true,
                "detail": "(len(new.excerpt) <= 280)"
              }
            ],
            "failed": []
          }
        },
        {
          "description": "A constraint with no rendered text reports an empty text.",
          "args": {
            "object": {
              "fixture": "fx-object-type-def-1"
            },
            "candidate": {
              "fixture": "fx-record-3"
            },
            "who": {
              "user": "alpha:writer1"
            },
            "now": 5000,
            "roles": [
              "public",
              "writer"
            ],
            "acc": {
              "passed": [],
              "failed": []
            }
          },
          "result": {
            "passed": [],
            "failed": [
              {
                "check": {
                  "rule": "constraint:note.title_length",
                  "passed": false,
                  "detail": "A title has at most 24 characters [(len(new.title) <= 24)]"
                },
                "kind": "constraint-violated"
              }
            ]
          }
        },
        {
          "description": "A constraint whose expression cannot be evaluated fails with the evaluation error.",
          "args": {
            "object": {
              "fixture": "fx-object-type-def-1",
              "with": {
                "constraints.title_length.expr.cmp.op": "eq",
                "constraints.title_length.expr.cmp.left": {
                  "lit": {
                    "str": "a"
                  }
                },
                "constraints.title_length.expr.cmp.right.lit.int": 1
              }
            },
            "candidate": {
              "fixture": "fx-record-3"
            },
            "who": {
              "user": "alpha:writer1"
            },
            "now": 5000,
            "roles": [
              "public",
              "writer"
            ],
            "acc": {
              "passed": [],
              "failed": []
            }
          },
          "result": {
            "passed": [],
            "failed": [
              {
                "check": {
                  "rule": "constraint:note.title_length",
                  "passed": false,
                  "detail": "('a' == 1): cannot compare a string with a int"
                },
                "kind": "evaluation"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "validate-record",
      "description": "rules.rs validate_record: validate a whole candidate record (of the schema it reads only the workflows, so the examples give no others): unknown fields, then per declared field (in id order) required, type, unique and reference, then each composite unique constraint (unique-step, in id order), then workflow states, and the constraints only when nothing failed. old is the stored record on update. The roles are rules.rs roles_of(lookup.tenant, principal); a unique clash names the other record only when read.rs visible lets the principal read it. texts holds the printed constraint expressions (the print gap of WG-4957). Before everything the size of the record (limits.rs, record-limit-check: 262144 bytes of JSON); per field after required, the limits of the value (limit-step: a string of 65536 bytes, a list of 1000 items, a value of a unique field of 200 encoded bytes), which skip the rest of the field.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "coverage",
          "type": "coverage"
        },
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "object",
          "type": "object-type-def"
        },
        {
          "name": "candidate",
          "type": "record"
        },
        {
          "name": "old",
          "type": "option<record>"
        },
        {
          "name": "principal",
          "type": "principal"
        },
        {
          "name": "now",
          "type": "timestamp"
        }
      ],
      "returns": "validation-outcome",
      "errors": "rejection",
      "let": [
        {
          "name": "roles",
          "expr": "call roles-of(tenant, principal)"
        },
        {
          "name": "unknown",
          "expr": "call unknown-field-checks(object, candidate, call record-limit-check(validation-outcome{passed: [], failed: []}, object, candidate, 262144))"
        },
        {
          "name": "checked",
          "expr": "fold(f in values(object.fields), a = unknown, try call field-step(tenant, coverage, object, candidate, principal, now, a, f))"
        },
        {
          "name": "uniques",
          "expr": "fold(u in values(call uniques-of(object)), a = checked, try call unique-step(tenant, coverage, object, candidate, principal, now, a, u))"
        },
        {
          "name": "flows",
          "expr": "call workflow-checks(schema, object, candidate, uniques)"
        }
      ],
      "body": "if flows.failed == [] then call constraint-checks(object, candidate, old, principal, now, roles, flows) else flows",
      "examples": [
        {
          "description": "behaviour.rs create_applies_defaults_and_allocates_the_next_id: a valid note.",
