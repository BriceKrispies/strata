    {
      "id": "field-step",
      "description": "rules.rs validate_record, second loop, one declared field: required:, then type: (a wrong type skips the rest of the field), unique: (the clashing record is named only to a principal who may read it: read.rs visible, against the tenant's own schema), and reference: per referenced id.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "coverage",
          "type": "coverage"
        },
        {
          "name": "object",
          "type": "object-type-def"
        },
        {
          "name": "candidate",
          "type": "record"
        },
        {
          "name": "principal",
          "type": "principal"
        },
        {
          "name": "now",
          "type": "timestamp"
        },
        {
          "name": "acc",
          "type": "validation-outcome"
        },
        {
          "name": "field",
          "type": "field-def"
        }
      ],
      "returns": "validation-outcome",
      "errors": "rejection",
      "let": [
        {
          "name": "x",
          "expr": "match get(candidate.fields, field.id) { Some(y) => y, None => call null-value() }"
        },
        {
          "name": "at",
          "expr": "format('{}.{}', object.id, field.id)"
        }
      ],
      "body": "if call value-is-null(x) then (if field.required then call outcome-fail(acc, error-kind.missing-required, format('required:{}', at), 'a value is required') else acc) else let a1 = if field.required then call outcome-pass(acc, format('required:{}', at), 'present') else acc in if !call field-type-admits(field.ty, x) then call outcome-fail(a1, error-kind.type-mismatch, format('type:{}', at), format('expected {}, found {}', call field-type-name(field.ty), call value-kind(x))) else let a2 = call outcome-pass(a1, format('type:{}', at), call field-type-name(field.ty)) in let a3 = if field.unique then (match find(o in try call lookup-by-field(tenant, coverage, object.id, field.id, x), o.id != candidate.id) { Some(o) => if call visible(tenant, principal, o, now) then call outcome-fail(a2, error-kind.unique-violated, format('unique:{}', at), format('record {} already has this value', o.id)) else call outcome-fail(a2, error-kind.unique-violated, format('unique:{}', at), 'another record already has this value'), None => call outcome-pass(a2, format('unique:{}', at), 'no other record has this value') }) else a2 in match call ref-target(field.ty) { Some(target) => fold(id in call refs-in(x), a = a3, match try call lookup-record(tenant, coverage, target, id) { Some(_) => call outcome-pass(a, format('reference:{}', at), format('{} {} exists', target, id)), None => call outcome-fail(a, error-kind.dangling-reference, format('reference:{}', at), format('{} {} does not exist', target, id)) }), None => a3 }",
      "examples": [
        {
          "args": {
            "tenant": {
              "id": "alpha",
              "name": "alpha",
              "revision": 10,
              "next-record": 2,
              "event-seq": 10,
              "schema": {
                "version": 1,
                "objects": {},
                "roles": {
                  "owner": {
                    "id": "owner",
                    "label": "Owner"
                  },
                  "public": {
                    "id": "public",
                    "label": "Everyone"
                  }
                },
                "policies": {},
                "workflows": {},
                "queries": {},
                "views": {}
              },
              "members": {
                "alpha:editor": [
                  "editor"
                ],
                "alpha:writer1": [
                  "writer"
                ],
                "alpha:writer2": [
                  "writer"
                ],
                "alpha:stranger": [
                  "guest"
                ]
              },
              "records": {
                "person": {
                  "1": {
