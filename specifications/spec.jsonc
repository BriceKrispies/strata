    },
    {
      "id": "m-recovery-revokes-sessions",
      "kind": "temporal",
      "models": "idn-020",
      "statement": "After an account recovery no existing session of the account is valid.",
      "evaluate": {
        "method": "never",
        "scenarios": [
          "session-after-recovery"
        ],
        "occurs": {
