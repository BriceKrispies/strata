    {
      "id": "job-run-attempts-exhausted",
      "name": "Every attempt of a job fails",
      "description": "The job is offered at tick 10 and its attempt fails at tick 11; the retry comes 5 ticks later and fails at tick 17; the second retry comes 10 ticks later and fails at tick 28.",
      "behaviors": [
        "job-run-flow"
      ],
      "steps": [
        {
          "at": 0,
          "event": "jr-created"
        },
        {
          "at": 10,
