    {
      "id": "live-backoff-reset-impl",
      "name": "A connection that opens starts the back-off over (implementation)",
      "description": "A failed connection, then one that opens and drops: the welcome resets the attempts, so the wait is 500 ms again, not 1 second. Times are in milliseconds.",
      "behaviors": [
        "client-live-flow-impl"
      ],
      "steps": [
        {
          "at": 0,
          "event": "ui-live-start"
        },
        {
          "at": 10,
          "event": "ui-live-closed",
          "note": "First failure: waits 500 ms, fires at 510."
        },
        {
          "at": 600,
          "event": "ui-live-welcome",
          "payload": {
            "head": 5,
            "heartbeat-ms": 10000
          },
          "note": "The connection opens; attempts return to 0."
        },
        {
          "at": 700,
          "event": "ui-live-closed",
          "note": "The open socket drops: 500 ms again, fires at 1200."
        }
      ],
      "timeUnit": "ms"
    },
