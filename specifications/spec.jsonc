      "id": "layout-change-fails-for-one-tenant",
      "name": "A layout change fails for one tenant",
      "description": "The change fails for tenant a and succeeds for tenant b.",
      "behaviors": [
        "layout-rollout-flow"
      ],
      "steps": [
        {
          "at": 0,
          "event": "lr-apply-requested",
          "payload": {
            "tenant": "a",
            "ok": false
          }
        },
        {
          "at": 1,
          "event": "lr-apply-requested",
          "payload": {
            "tenant": "b",
            "ok": true
          }
