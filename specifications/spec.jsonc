    {
      "id": "decide-mutation",
      "description": "backend ops.rs mutate, one decision, the decide of contract mutate-record (CT-263): the mutation as an intent (coerce-mutation), its needs asked for first, then the kernel's decision (intent-decision). An InsufficientState rejection naming a need asks for it; any other rejection is answered as the error body (api-error-of, after hide-unreadable). An accepted transition is handed to the commit with its intent and the record reply.",
      "params": [
        {
          "name": "mutation",
          "type": "mutation"
        },
        {
          "name": "context",
          "type": "context"
        },
        {
          "name": "state",
          "type": "state"
        },
        {
          "name": "times",
          "type": "map<string, i64>"
        }
      ],
      "returns": "accepted-intent",
      "errors": "api-failure",
      "let": [
        {
          "name": "intent",
          "expr": "try call coerce-mutation(mutation, state, context, times)"
        }
      ],
      "body": "match call first-missing(state.coverage, call needs(match state.tenant { Some(t) => t.schema, None => null }, intent)) { Some(n) => fail(api-failure.insufficient-state(n)), None => match call intent-decision(state, intent, context) { Ok(tr) => accepted-intent{intent, transition: tr, reply: call mutation-reply-of(tr)}, Err(e) => match e { rejected(d) => match d.missing { Some(n) => if d.kind == error-kind.insufficient-state then fail(api-failure.insufficient-state(n)) else fail(api-failure.refused(call api-error-of(call hide-unreadable(d, state, intent, context), context))), None => fail(api-failure.refused(call api-error-of(call hide-unreadable(d, state, intent, context), context))) } } } }",
      "examples": [
        {
          "description": "The owner deletes a draft.",
          "args": {
            "mutation": {
              "delete": {
                "object": "post",
                "id": 3,
                "expected-version": 1
              }
            },
            "context": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:owner"
              },
              "session": "s-1",
              "now": 3000,
              "correlation": "c-1"
            },
            "state": {
              "fixture": "fx-state-5"
            },
            "times": {}
          },
          "result": {
            "intent": {
              "delete-record": {
                "object": "post",
                "id": 3,
                "expected-version": 1
              }
            },
            "transition": {
              "delta": {
                "tenant": "alpha",
                "base-revision": 5,
                "new-revision": 6,
                "next-record": 5,
                "event-seq": 6,
                "ops": [
                  {
                    "delete-record": {
                      "object": "post",
                      "id": 3
                    }
                  }
                ]
              },
              "events": [
                {
                  "tenant": "alpha",
                  "seq": 6,
                  "revision": 6,
                  "at": 3000,
                  "principal": {
                    "user": "alpha:owner"
                  },
                  "correlation": "c-1",
                  "body": {
                    "record-deleted": {
                      "before": {
                        "id": 3,
                        "object": "post",
                        "version": 1,
                        "created-by": "alpha:writer",
                        "created-at": 2001,
                        "updated-at": 2001,
                        "fields": {
                          "status": {
                            "str": "draft"
                          },
                          "title": {
                            "str": "A"
                          }
                        }
                      }
                    }
                  }
                }
              ],
              "effects": [
                {
                  "publish": {
                    "seq": 6
                  }
                }
              ],
              "evidence": [
                {
                  "rule": "policy:builtin_owner",
                  "passed": true,
                  "detail": "Delete on Object(ObjectTypeId(\"post\"))"
                }
              ],
              "output": {
                "deleted": {
                  "object": "post",
                  "id": 3
                }
              }
            },
            "reply": {
              "object": "post",
              "id": 3,
              "version": null,
              "revision": 6,
              "event-seq": 6,
              "checks-passed": 1
            }
          }
        },
        {
          "description": "ops.rs a refused change to a record the caller cannot read answers as a missing record.",
          "args": {
            "mutation": {
              "delete": {
                "object": "post",
                "id": 3,
                "expected-version": null
              }
            },
            "context": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:writer"
              },
              "session": "s-2",
              "now": 3000,
              "correlation": "c-1"
            },
            "state": {
              "fixture": "fx-state-5"
            },
            "times": {}
          },
          "error": {
            "refused": {
              "code": "not_found",
              "message": "no post 3",
              "kind": "UnknownRecord",
              "failed": [
                {
                  "rule": "intent:unknown_record",
                  "passed": false,
                  "detail": "no post 3"
                }
              ],
              "correlation": "c-1"
            }
          }
        },
        {
          "description": "The records that refer to a deleted record are needed too.",
          "args": {
            "mutation": {
              "delete": {
                "object": "person",
                "id": 1,
                "expected-version": null
              }
            },
            "context": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:owner"
              },
              "session": "s-1",
              "now": 3000,
              "correlation": "c-1"
            },
            "state": {
              "fixture": "fx-state-7",
              "with": {
                "coverage.partial": [
                  {
                    "record": {
                      "object": "person",
                      "id": 1
                    }
                  }
                ]
              }
            },
            "times": {}
          },
          "error": {
            "insufficient-state": {
              "by-field": {
                "object": "post",
                "field": "author",
                "value": {
                  "ref": 1
                }
              }
            }
          }
        }
      ]
    },
    {
      "id": "execute-read-decide",
      "description": "crates/storage-api/src/lib.rs query, the decide of contract execute-read (CT-032): the needs read-needs names for the snapshot's schema (none without a tenant) are asked for first, then the kernel answers (kernel-read); a rejection is the contract's domain error.",
      "params": [
        {
          "name": "state",
          "type": "state"
        },
        {
          "name": "request",
          "type": "read-request"
        },
        {
          "name": "context",
          "type": "context"
        }
      ],
      "returns": "read-result",
      "errors": "execute-failure",
      "body": "match call first-missing(state.coverage, match state.tenant { Some(t) => call read-needs(t.schema, request), None => [] }) { Some(n) => fail(execute-failure.insufficient-state(n)), None => match call kernel-read(state, request, context) { Ok(r) => r, Err(e) => match e { rejected(d) => match d.missing { Some(n) => if d.kind == error-kind.insufficient-state then fail(execute-failure.insufficient-state(n)) else fail(execute-failure.domain(d)), None => fail(execute-failure.domain(d)) } } } }",
      "examples": [
        {
          "args": {
