ymous":true,"headers":{"Authorization":"Bearer ${scimToken}","content-type":"application/scim+json"},"body":{"Operations":[{"op":"add","path":"members","value":[{"value":"${scimUser}"}]}]},"expectStatus":400}},{"apiCall":{"method":"PATCH","path":"/scim/v2/Users/${scimUser}","anonymous":true,"headers":{"Authorization":"Bearer ${scimToken}","content-type":"application/scim+json"},"body":{"Operations":[{"op":"replace","path":"active","value":false}]},"expectStatus":200,"expectJson":{"active":false}}},{"apiCall":{"method":"DELETE","path":"/scim/v2/Users/${scimUser}","anonymous":true,"headers":{"Authorization":"Bearer ${scimToken}","content-type":"application/scim+json"},"expectStatus":204}},{"apiCall":{"method":"GET","path":"/api/identity/clients","anonymous":true,"headers":{"Cookie":"__Host-strata_sid=${scimToken}"},"expectStatus":401}}]},
    {"id":"ui-dev-fixtures-refuse-visitor","name":"The development fixtures refuse a visitor who holds only the request token","verifies":["run-1382"],"description":"Journey of tests/e2e/site.spec.js, the test named \"the development fixtures refuse a visitor who holds only the request token\".","steps":[{"goto":{"screen":"screen-sign-in"}},{"apiCall":{"method":"GET","path":"/api/session","expectStatus":200,"capture":{"visitorCsrf":"session.csrf_token"}}},{"apiCall":{"method":"POST","path":"/api/dev/reset","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"${visitorCsrf}"},"expectStatus":401}},{"apiCall":{"method":"POST","path":"/api/dev/expire-session","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"${visitorCsrf}"},"expectStatus":401}}]},
    {"id":"ui-step-up-refusal","name":"A sensitive operation is refused when the sign-in is old, and the page asks the person to confirm it is them","verifies":["idn-019"],"description":"Journey of tests/e2e/site.spec.js, the test named \"a person without an authenticator steps up with the password before a sensitive operation\". Hand-written test keeps: typing the password into the confirmation and the operation that then goes through (a password field has no WAI-ARIA role to fill it by, and the journey has no step that fills a control by its label inside a dialog).","steps":[{"goto":{"screen":"screen-sign-in"}},{"fill":{"form":"form-sign-in","field":"login","value":"tomasz"}},{"fill":{"form":"form-sign-in","field":"password","value":"strata-dev-tomasz"}},{"submit":{"form":"form-sign-in"}},{"expectRole":{"role":"heading","level":1,"name":"Writing desk"}},{"apiCall":{"method":"GET","path":"/api/session","expectStatus":200,"capture":{"tomaszCsrf":"session.csrf_token"}}},{"apiCall":{"method":"POST","path":"/api/dev/age-authentication","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"${tomaszCsrf}"},"expectJson":{"aged":true}}},{"apiCall":{"method":"POST","path":"/api/sessions/revoke-others","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"${tomaszCsrf}"},"body":{},"expectStatus":403,"expectJson":{"kind":"step_up_required"}}},{"expectRole":{"role":"region","name":"Where you are signed in"}},{"click":{"role":"button","name":"Set up an authenticator","within":{"role":"region","name":"Second factor"}}},{"expectRole":{"role":"alertdialog","name":"Confirm that it is you"}}]},
    {"id":"ui-author-cannot-forge-byline","name":"An author cannot write under another byline, feature a post or choose when it was published","verifies":["krn-003"],"description":"Journey of tests/e2e/site.spec.js, the test named \"an author cannot write under another byline, feature a post or choose when it was published\". Hand-written test keeps: the numeric ids are those of the fixture tenant (authors 2 and 3, the draft 15), as in ui-author-cannot-edit-others, where the hand-written test reads them from the desk view.","steps":[{"goto":{"screen":"screen-sign-in"}},{"fill":{"form":"form-sign-in","field":"login","value":"tomasz"}},{"fill":{"form":"form-sign-in","field":"password","value":"strata-dev-tomasz"}},{"submit":{"form":"form-sign-in"}},{"expectRole":{"role":"heading","level":1,"name":"Writing desk"}},{"apiCall":{"method":"GET","path":"/api/session","expectStatus":200,"capture":{"authorCsrf":"session.csrf_token"}}},{"apiCall":{"method":"POST","path":"/api/records","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"${authorCsrf}"},"body":{"op":"create","object":"post","fields":{"title":"Forged","slug":"forged-byline","body":"Text.","author":2}},"expectBodyIncludes":["policy:authors_write_posts"]}},{"apiCall":{"method":"POST","path":"/api/records","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"${authorCsrf}"},"body":{"op":"create","object":"post","fields":{"title":"Forged","slug":"forged-byline","body":"Text.","author":3,"featured":true}},"expectBodyIncludes":["constraint:post.featured_by_editors"]}},{"apiCall":{"method":"POST","path":"/api/records","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"${authorCsrf}"},"body":{"op":"create","object":"post","fields":{"title":"Forged","slug":"forged-byline","body":"Text.","author":3,"published_at":4070908800000}},"expectBodyIncludes":["constraint:post.published_at_by_editors"]}},{"apiCall":{"method":"POST","path":"/api/records","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"${authorCsrf}"},"body":{"op":"update","object":"post","id":15,"fields":{"author":2}},"expectBodyIncludes":["constraint:post.author_fixed"]}},{"apiCall":{"method":"POST","path":"/api/records","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"${authorCsrf}"},"body":{"op":"update","object":"post","id":15,"fields":{"featured":true}},"expectBodyIncludes":["constraint:post.featured_by_editors"]}},{"apiCall":{"method":"POST","path":"/api/records","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"${authorCsrf}"},"body":{"op":"update","object":"post","id":15,"fields":{"published_at":4070908800000}},"expectBodyIncludes":["constraint:post.published_at_by_editors"]}},{"goto":{"screen":"screen-front-page"}},{"expectRole":{"role":"heading","level":2,"name":"The Jig Is the Work"}},{"goto":{"screen":"screen-desk"}},{"expectText":{"text":"Draft","within":{"role":"row","namePattern":"Notes Toward a Workbench"}}}]},
    {"id":"ui-delete-needs-confirmation","name":"A delete names what it removes, asks again before it removes it, and the question does not survive leaving the desk","verifies":["uxa-212"],"description":"Journey of tests/e2e/site.spec.js, the test named \"a delete confirmation does not survive leaving the desk and coming back\". Hand-written test keeps: the browser's forward button (there is no forward step), so the journey leaves by a link and returns by back.","steps":[{"goto":{"screen":"screen-sign-in"}},{"fill":{"form":"form-sign-in","field":"login","value":"tomasz"}},{"fill":{"form":"form-sign-in","field":"password","value":"strata-dev-tomasz"}},{"submit":{"form":"form-sign-in"}},{"expectRole":{"role":"heading","level":1,"name":"Writing desk"}},{"click":{"role":"link","name":"Write a new article"}},{"expectRole":{"role":"heading","level":1,"name":"New article"}},{"fill":{"form":"form-new-article-save","field":"title","value":"Left Armed"}},{"fill":{"form":"form-new-article-save","field":"body","value":"A first paragraph written by a test."}},{"submit":{"form":"form-new-article-save"}},{"expectText":{"text":"Draft saved.","within":{"role":"region","name":"Messages"}}},{"expectRole":{"role":"heading","level":1,"name":"Edit article"}},{"click":{"role":"link","name":"Back to the desk"}},{"clickAction":{"action":"act-desk-delete","item":{"title":"Left Armed"}}},{"expectRole":{"role":"button","name":"Confirm deleting Left Armed"}},{"expectCount":{"role":"row","namePattern":"Left Armed","count":1}},{"click":{"role":"link","name":"Write a new article"}},{"expectRole":{"role":"heading","level":1,"name":"New article"}},{"back":{}},{"expectCount":{"role":"button","name":"Confirm deleting Left Armed","count":0}},{"clickAction":{"action":"act-desk-delete","item":{"title":"Left Armed"}}},{"click":{"role":"button","name":"Confirm deleting Left Armed"}},{"expectText":{"text":"Deleted.","within":{"role":"region","name":"Messages"}}},{"expectCount":{"role":"row","namePattern":"Left Armed","count":0}}]},
    {"id":"ui-search-excludes-drafts","name":"A search finds no draft: a word only a draft holds matches nothing","verifies":["srh-150"],"description":"The draft \"Notes Toward a Workbench\" is the only record of the fixture tenant that holds the word \"workbench\"; a reader searching for it is told that nothing mentions it, and the draft is not listed.","steps":[{"goto":{"screen":"screen-search","params":{"q":"workbench"}}},{"expectText":{"text":"Nothing mentions “workbench”."}},{"expectNoText":{"text":"Notes Toward a Workbench"}},{"expectCount":{"role":"article","count":0}}]}
  ],

