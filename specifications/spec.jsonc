          "at": 0,
          "event": "rt-committed"
        },
        {
          "at": 1,
          "event": "arc-ob-publish-now"
        }
      ],
      "timeUnit": "ms"
    },
    {"id":"arc-rolling-deploy-with-commit","name":"A commit during a rolling deployment","description":"The newer version starts and commits, the older version stops, and the newer version commits again.","behaviors":["arc-rolling-change-flow"],"steps":[{"at":0,"event":"arc-rl-deploy-started"},{"at":1,"event":"arc-rl-commit"},{"at":3,"event":"arc-rl-deploy-finished"},{"at":4,"event":"arc-rl-commit"}]},
    {"id":"arc-rolling-deploy-with-commit-impl","name":"A commit during a rolling deployment (implementation)","description":"The newer version starts and commits, the older version stops, and the newer version commits again. The same scenario run on the implementation machines.","behaviors":["arc-rolling-change-flow-impl"],"steps":[{"at":0,"event":"arc-rl-deploy-started"},{"at":1,"event":"arc-rl-commit"},{"at":3,"event":"arc-rl-deploy-finished"},{"at":4,"event":"arc-rl-commit"}]},
    {"id":"inbound-repeated-delivery","name":"An inbound delivery repeated","description":"The same event arrives twice, and the second arrival starts nothing.","behaviors":["inbound-run-flow"],"steps":[{"at":0,"event":"iw-received","payload":{"key":"d1"}},{"at":2,"event":"iw-received","payload":{"key":"d1"},"note":"The sender retries."}]},
    {"id":"inbound-repeated-delivery-impl","name":"An inbound delivery repeated (implementation)","description":"The same event arrives twice, and the second arrival starts nothing. The same scenario run on the implementation machines.","behaviors":["inbound-run-flow-impl"],"steps":[{"at":0,"event":"iw-received","payload":{"key":"d1"}},{"at":2,"event":"iw-received","payload":{"key":"d1"},"note":"The sender retries."}]},
    {"id":"preview-presented-late","name":"A preview link presented after its expiry","description":"The link is presented 30 ticks after it was linked, past its 15-tick lifetime.","behaviors":["preview-link-flow"],"steps":[{"at":0,"event":"pl-issue"},{"at":30,"event":"pl-presented"}]},
    {"id":"preview-presented-late-impl","name":"A preview link presented after its expiry (implementation)","description":"The link is presented 30 minutes after it was linked, past its 15-minute lifetime. Times are in milliseconds. The same scenario run on the implementation machines.","behaviors":["preview-link-flow-impl"],"steps":[{"at":0,"event":"pl-issue"},{"at":1800000,"event":"pl-presented"}],"timeUnit":"ms"},
    {"id":"cv-confirmed-apply","name":"A change is confirmed, then applied","description":"The apply follows the confirmation.","behaviors":["cv-change-flow"],"steps":[{"at":0,"event":"cv-proposed"},{"at":1,"event":"cv-confirmed"},{"at":2,"event":"cv-apply-requested"}]},
    {"id":"cv-confirmed-apply-impl","name":"A change is confirmed, then applied (implementation)","description":"The apply follows the confirmation. The same scenario run on the implementation machines.","behaviors":["cv-change-flow-impl"],"steps":[{"at":0,"event":"cv-proposed"},{"at":1,"event":"cv-confirmed"},{"at":2,"event":"cv-apply-requested"}]},
    {"id":"cv-unconfirmed-apply","name":"A change is applied before confirmation","description":"The apply is refused unless the change was confirmed.","behaviors":["cv-change-flow"],"steps":[{"at":0,"event":"cv-proposed"},{"at":1,"event":"cv-apply-requested","note":"Applied before the person confirmed."}]},
    {"id":"cv-unconfirmed-apply-impl","name":"A change is applied before confirmation (implementation)","description":"The apply is refused unless the change was confirmed. The same scenario run on the implementation machines.","behaviors":["cv-change-flow-impl"],"steps":[{"at":0,"event":"cv-proposed"},{"at":1,"event":"cv-apply-requested","note":"Applied before the person confirmed."}]},
    {"id":"cv-cancelled-preview","name":"A preview is cancelled, then applied","description":"A cancelled change is refused.","behaviors":["cv-change-flow"],"steps":[{"at":0,"event":"cv-proposed"},{"at":1,"event":"cv-cancel"},{"at":2,"event":"cv-apply-requested"}]},
    {"id":"cv-cancelled-preview-impl","name":"A preview is cancelled, then applied (implementation)","description":"A cancelled change is refused. The same scenario run on the implementation machines.","behaviors":["cv-change-flow-impl"],"steps":[{"at":0,"event":"cv-proposed"},{"at":1,"event":"cv-cancel"},{"at":2,"event":"cv-apply-requested"}]},
    {"id":"cv-withdrawn-before-run","name":"A permission is withdrawn before the operation runs","description":"The operation is refused after the permission is withdrawn.","behaviors":["cv-authority-flow"],"steps":[{"at":1,"event":"cv-permission-withdrawn"},{"at":2,"event":"cv-operation-run"}]},
    {"id":"cv-withdrawn-before-run-impl","name":"A permission is withdrawn before the operation runs (implementation)","description":"The operation is refused after the permission is withdrawn. The same scenario run on the implementation machines.","behaviors":["cv-authority-flow-impl"],"steps":[{"at":1,"event":"cv-permission-withdrawn"},{"at":2,"event":"cv-operation-run"}]},
    {"id":"cv-permitted-run","name":"An operation runs with its permission","description":"The operation commits.","behaviors":["cv-authority-flow"],"steps":[{"at":1,"event":"cv-operation-run"}]},
    {"id":"cv-permitted-run-impl","name":"An operation runs with its permission (implementation)","description":"The operation commits. The same scenario run on the implementation machines.","behaviors":["cv-authority-flow-impl"],"steps":[{"at":1,"event":"cv-operation-run"}]},
    {"id":"saml-replayed","name":"An assertion is presented twice","description":"The second presentation is refused.","behaviors":["saml-assertion-flow"],"steps":[{"at":0,"event":"saml-response"},{"at":2,"event":"saml-response","note":"The same assertion again."}]},
    {"id":"saml-replayed-impl","name":"An assertion is presented twice (implementation)","description":"The second presentation is refused. The same scenario run on the implementation machines.","behaviors":["saml-assertion-flow-impl"],"steps":[{"at":0,"event":"saml-response"},{"at":2,"event":"saml-response","note":"The same assertion again."}]},
    {
      "id": "guesses-from-one-source",
      "name": "Guesses from one source",
      "description": "Wrong guesses arrive until the throttle closes, and then a right guess arrives.",
      "behaviors": [
        "guess-throttle-flow"
      ],
      "steps": [
        {
          "at": 0,
          "event": "pw-attempt",
          "payload": {
            "guess": "wrong",
            "limit-key": "account-1"
          }
        },
        {
          "at": 1,
          "event": "pw-attempt",
          "payload": {
            "guess": "wrong",
            "limit-key": "account-1"
          }
        },
        {
          "at": 2,
          "event": "pw-attempt",
          "payload": {
            "guess": "wrong",
            "limit-key": "account-1"
          }
        },
        {
          "at": 3,
          "event": "pw-attempt",
          "payload": {
            "guess": "wrong",
            "limit-key": "account-1"
          },
          "note": "The fourth guess, after the throttle has closed."
        },
        {
          "at": 4,
          "event": "pw-attempt",
          "payload": {
            "guess": "right",
            "limit-key": "account-1"
          }
        }
      ]
    },
    {
      "id": "guesses-from-one-source-impl",
      "name": "Guesses from one source (implementation)",
