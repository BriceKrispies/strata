    {"id":"link-presented-after-delay","name":"A link presented in transit after its lifetime","description":"The link is presented at tick 2, but the presentation reaches the identity service 20 ticks later, after its lifetime.","behaviors":["emailed-link-flow"],"faults":["link-presentation-in-transit"],"steps":[{"at":0,"event":"ml-requested"},{"at":2,"event":"ml-presented","payload":{"token":"good","browser":"requester"},"note":"Sent at tick 2, delivered at tick 22."}]},
    {"id":"link-presented-after-delay-impl","name":"A link presented in transit after its lifetime (implementation)","description":"The link is presented 2 minutes after it was requested, but the presentation reaches the identity service 30 minutes later, after its lifetime of 15 minutes. Times are in milliseconds. The same scenario run on the implementation machines.","behaviors":["emailed-link-flow-impl"],"faults":["link-presentation-in-transit-impl"],"steps":[{"at":0,"event":"ml-requested"},{"at":120000,"event":"ml-presented","payload":{"token":"good","browser":"requester"},"note":"Sent after 2 minutes, delivered 30 minutes later."}],"timeUnit":"ms"},
