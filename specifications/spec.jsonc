      "describedBy": "tenant-schema",
      "key": [
        "version"
      ],
      "fields": [
        {
          "name": "version",
          "type": "u64"
        },
        {
          "name": "revision",
          "type": "u64"
        },
        {
          "name": "schema",
          "type": "tenant-schema"
        }
      ],
      "retention": "Every version is kept in the schema history.",
      "description": "Table schema_history of a tenant file: every version of the tenant schema, with the revision that introduced it."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-records",
      "name": "Records (tenant file)",
