        {
          "name": "limit",
          "type": "number",
          "initial": 20
        },
        {
          "name": "windowOpen",
          "type": "boolean",
          "initial": false
        }
      ],
      "states": [
        {
          "id": "sus-open",
          "name": "Counting"
        }
      ],
      "transitions": [
        {
          "id": "sus-accept-over",
          "from": "sus-open",
          "to": "sus-open",
          "on": "sus-requested",
          "guard": "count >= limit && windowOpen && windowStart <= time && time - windowStart < 60",
          "effects": [
            {
              "set": "count",
              "to": "count + 1"
            },
            {
              "emit": "sus-accepted"
            }
