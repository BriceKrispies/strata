            "ledger limit of credits: a cap per period needs its period, and a period its cap"
          ]
        },
        {
          "description": "A period without its cap.",
          "args": {
            "ledger": {
              "units": {
                "credits": {
                  "unit": "credits",
                  "description": "credits"
                }
              },
              "pools": {
                "promo": {
                  "pool": "promo",
                  "description": "promo"
                }
              },
              "limits": []
            },
            "l": {
              "unit": "credits",
              "cap": 3,
              "period": "week"
            }
          },
          "result": [
            "ledger limit of credits: a cap per period needs its period, and a period its cap"
          ]
        },
        {
          "description": "A limit that sets nothing.",
          "args": {
            "ledger": {
              "units": {
                "credits": {
                  "unit": "credits",
                  "description": "credits"
                }
              },
              "pools": {
                "promo": {
                  "pool": "promo",
                  "description": "promo"
                }
              },
              "limits": []
            },
            "l": {
              "unit": "credits"
            }
          },
          "result": [
            "ledger limit of credits: sets no limit"
          ]
        },
        {
          "description": "Every problem, in order.",
          "args": {
            "ledger": {
              "units": {
                "credits": {
                  "unit": "credits",
                  "description": "credits"
                }
              },
              "pools": {
                "promo": {
                  "pool": "promo",
                  "description": "promo"
                }
              },
              "limits": []
            },
            "l": {
              "unit": "points",
              "owner": {
                "pool": {
                  "pool": "ghost"
                }
              },
              "floor": 5,
              "cap": 2,
              "period-cap": 1
            }
          },
          "result": [
            "ledger limit of points: unknown ledger unit points",
            "ledger limit of points: unknown ledger pool ghost",
            "ledger limit of points: the floor 5 is above the cap 2",
            "ledger limit of points: a cap per period needs its period, and a period its cap"
          ]
        }
      ]
    },
    {
      "id": "ledger-problems",
      "description": "ledger.rs declaration_problems: the problems of the ledger declarations of a schema, in a fixed order: the ceilings of LDG-1550 (64 units, 64 pools and 10000 limits of one account), a unit or a pool declared under another name (in id order), then each limit in the order held (ledger-limit-problems).",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        }
      ],
      "returns": "list<string>",
      "body": "match schema.ledger { None => [], Some(l) => concat(concat(concat(concat(concat(call limit-count-problem('ledger units', length(keys(l.units)), 64), call limit-count-problem('ledger pools', length(keys(l.pools)), 64)), call limit-count-problem('ledger account limits', length(filter(x in l.limits, x.owner != null)), 10000)), fold(k in keys(l.units), ps = [], concat(ps, fold(d in values(l.units), qs = [], if get(l.units, k) == d && d.unit != k then [format('ledger unit {}: declared under another name', k)] else qs)))), fold(k in keys(l.pools), ps = [], concat(ps, fold(d in values(l.pools), qs = [], if get(l.pools, k) == d && d.pool != k then [format('ledger pool {}: declared under another name', k)] else qs)))), fold(x in l.limits, ps = [], concat(ps, call ledger-limit-problems(l, x)))) }",
      "examples": [
        {
