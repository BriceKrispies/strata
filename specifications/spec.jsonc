                "passed": true,
                "detail": "0"
              }
            ],
            "output": {
              "setting": {
                "setting": "theme",
                "revision": 1
              }
            }
          }
        }
      ]
    },
    {
      "id": "need-order",
      "description": "A BTreeSet<Need> as needs returns it: each need once, in the derived order of Need (Record, then ByField, then AllOf; then the object type, the id, the field and the value in Value's order). Stable sorts from the least to the most significant key; a list value is not ordered by its items (unique list fields are refused by schema-problems, so needs never holds one). ByFields comes last, ordered by its object type; two ByFields of one object type keep the order they were given (a schema whose one object type has two composite unique constraints given values in one intent is ordered by its constraints, not by the derived order of the map). The ledger needs a schema change names are ordered among themselves, unit-used before pool-used and then by the unit or the pool; the other ledger needs (an account, an entry by key, entries, ranked) come before them in no order of their own: they are the needs of a posting or a read, which refine-needs names and the function language does not state, since an account id is a uuid and the language has no hash to derive it.",
      "params": [
        {
          "name": "xs",
          "type": "list<need>"
        }
      ],
      "returns": "list<need>",
      "let": [
        {
          "name": "sorted",
          "expr": "sortBy(n in sortBy(n in sortBy(n in sortBy(n in sortBy(n in sortBy(n in sortBy(n in sortBy(n in sortBy(n in sortBy(n in sortBy(n in xs, match n { ledger(l) => match l { unit-used{unit} => unit, pool-used{pool} => pool, _ => '' }, _ => '' }), match n { ledger(l) => match l { unit-used => 4, pool-used => 5, _ => 0 }, _ => 0 }), match n { page-of{limit} => limit, _ => 0 }), match n { page-of{after} => match after { Some(a) => a, None => 0 }, _ => 0 }), match n { page-of{after} => match after { Some(_) => 1, None => 0 }, _ => 0 }), match n { record{id} => id, by-field{value} => match value { int(i) => i, time(t) => t, ref(r) => r, bool(b) => if b then 1 else 0, _ => 0 }, _ => 0 }), match n { by-field{value} => match value { str(s) => s, _ => '' }, _ => '' }), match n { by-field{value} => match value { bool(_) => 1, int(_) => 2, str(_) => 3, time(_) => 4, ref(_) => 5, list(_) => 6, _ => 0 }, _ => 0 }), match n { by-field{field} => field, _ => '' }), match n { record{object} => object, by-field{object} => object, all-of(o) => o, page-of{object} => object, by-fields{object} => object, _ => '' }), match n { record => 0, by-field => 1, all-of => 2, page-of => 3, by-fields => 4, ledger => 5, index-page => 6, pair-page => 7 })"
        }
      ],
      "body": "fold(n in sorted, acc = [], if any(a in acc, a == n) then acc else concat(acc, [n]))",
      "examples": [
        {
          "args": {
            "xs": [
              {
                "all-of": "person"
              },
              {
                "by-field": {
                  "object": "note",
                  "field": "slug",
                  "value": {
                    "str": "b"
                  }
                }
              },
              {
                "record": {
                  "object": "person",
                  "id": 2
                }
              },
              {
                "by-field": {
                  "object": "note",
                  "field": "slug",
                  "value": {
                    "str": "a"
                  }
                }
              },
              {
                "record": {
                  "object": "note",
                  "id": 10
                }
              },
              {
                "record": {
                  "object": "note",
                  "id": 9
                }
              },
              {
                "all-of": "note"
              },
              {
                "record": {
                  "object": "person",
                  "id": 2
                }
              },
              {
                "by-field": {
                  "object": "note",
                  "field": "rank",
                  "value": {
                    "int": 3
                  }
                }
              }
            ]
          },
          "result": [
            {
              "record": {
                "object": "note",
                "id": 9
              }
            },
            {
              "record": {
                "object": "note",
                "id": 10
              }
            },
            {
              "record": {
                "object": "person",
                "id": 2
              }
            },
            {
              "by-field": {
                "object": "note",
                "field": "rank",
                "value": {
                  "int": 3
                }
              }
            },
            {
              "by-field": {
                "object": "note",
                "field": "slug",
                "value": {
                  "str": "a"
                }
              }
            },
            {
              "by-field": {
                "object": "note",
                "field": "slug",
                "value": {
                  "str": "b"
                }
              }
            },
            {
              "all-of": "note"
            },
            {
              "all-of": "person"
            }
          ]
        },
        {
          "description": "The ledger needs come after the records, once each, unit-used before pool-used and by name.",
          "args": {
            "xs": [
              {
                "ledger": {
                  "pool-used": {
                    "pool": "promo"
                  }
                }
              },
              {
                "ledger": {
                  "unit-used": {
                    "unit": "points"
                  }
                }
              },
              {
                "all-of": "note"
              },
              {
                "ledger": {
                  "unit-used": {
                    "unit": "credits"
                  }
                }
              },
              {
                "ledger": {
                  "unit-used": {
                    "unit": "points"
                  }
                }
              }
            ]
          },
          "result": [
            {
              "all-of": "note"
            },
            {
              "ledger": {
                "unit-used": {
                  "unit": "credits"
                }
              }
            },
            {
              "ledger": {
                "unit-used": {
                  "unit": "points"
                }
              }
            },
            {
              "ledger": {
                "pool-used": {
                  "pool": "promo"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "field-needs",
      "description": "transition.rs needs, field_needs: for each given field (in id order) the object type declares, a ByField need for a unique field with a value, and a Record need for each record a reference field refers to. Then, per composite unique constraint of the type in id order whose every field is given a value, one ByFields need for those values (CMS-1557).",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "fields",
          "type": "map<field-id, value>"
        }
      ],
      "returns": "list<need>",
      "body": "match get(schema.objects, object) { None => [], Some(def) => concat(fold(k in keys(fields), acc = [], match get(def.fields, k) { None => acc, Some(f) => match get(fields, k) { None => acc, Some(x) => concat(concat(acc, if f.unique && !call value-is-null(x) then [need.by-field{object, field: k, value: x}] else []), match call ref-target(f.ty) { Some(t) => map(i in call refs-in(x), need.record{object: t, id: i}), None => [] }) } }), fold(u in values(call uniques-of(def)), acc = [], let w = fold(f in u.fields, m = {}, match get(fields, f) { Some(x) => if call value-is-null(x) then m else insert(m, f, x), None => m }) in if length(keys(w)) == length(u.fields) then concat(acc, [need.by-fields{object, fields: w}]) else acc)) }",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-6"
            },
            "object": "note",
            "fields": {
              "title": {
                "str": "T"
              },
              "slug": {
                "str": "first"
              },
              "author": {
                "ref": 1
              },
              "nope": {
                "str": "x"
              }
            }
          },
          "result": [
            {
              "record": {
                "object": "person",
                "id": 1
              }
            },
            {
              "by-field": {
                "object": "note",
                "field": "slug",
                "value": {
                  "str": "first"
                }
              }
            }
          ]
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-6"
            },
            "object": "note",
            "fields": {
              "slug": "null"
            }
          },
          "result": []
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-6"
            },
            "object": "tag",
            "fields": {
              "slug": {
                "str": "x"
              }
            }
          },
          "result": []
        }
      ]
    },
    {
      "id": "needs",
      "description": "transition.rs needs, the pure body of contract plan-intent-needs (CT-002): the state an intent is expected to need, which the shell loads before deciding it (a plan; decide-intent guards every lookup itself). None without a schema; nothing for CreateTenant, the role, team and invitation intents (including the revocation of an invitation); the field needs of a create; the record and its field needs for an update; the record and every referrer's ByField of a reference to it for a delete; every record of each touched object type for a schema change, and of the target of each reference field the touched object type has, in the schema as it is and as the changes make it (ref-needs; a change that cannot be applied is left out of the second). Each once, in order (need-order). The needs of the ledger changes follow (ledger-change-needs): whether an account names a unit or a pool a change removes.",
      "params": [
        {
          "name": "schema",
          "type": "option<tenant-schema>"
        },
        {
          "name": "intent",
          "type": "intent"
        }
      ],
      "returns": "list<need>",
      "body": "match schema { None => [], Some(s) => call need-order(match intent { create-tenant => [], assign-role => [], revoke-role => [], define-team => [], assign-team-role => [], revoke-team-role => [], add-team-member => [], remove-team-member => [], create-invitation => [], redeem-invitation => [], revoke-invitation => [], post-ledger => [], expire-ledger => [], expire-records => [], erase-subject => [], write-setting => [], invoke-operation => [], create-record{object, fields} => call field-needs(s, object, fields), update-record{object, id, fields} => concat([need.record{object, id}], call field-needs(s, object, fields)), delete-record{object, id} => concat([need.record{object, id}], map(rf in call referrers(s, object), need.by-field{object: rf.object.id, field: rf.field.id, value: value.ref(id)})), change-schema{changes} => let changed = fold(c in changes, acc = s, match call apply-change(acc, c) { Ok(st) => st.schema, Err(_) => acc }) in concat(fold(o in call touched-objects(changes), acc = [], concat(concat(concat(acc, call ref-needs(s, o)), call ref-needs(changed, o)), [need.all-of(o)])), call ledger-change-needs(changes)) }) }",
      "examples": [
        {
          "description": "behaviour.rs a_thin_snapshot_is_refused_with_the_missing_need: the uniqueness lookup.",
          "args": {
            "schema": {
              "fixture": "fx-option-tenant-schema-1"
            },
            "intent": {
              "create-record": {
                "object": "note",
                "fields": {
                  "title": {
                    "str": "Second"
                  },
                  "slug": {
                    "str": "first"
                  }
                }
              }
            }
          },
          "result": [
            {
              "by-field": {
                "object": "note",
                "field": "slug",
                "value": {
                  "str": "first"
                }
              }
            }
          ]
        },
        {
          "args": {
