    {
      "id": "guesses-on-parallel-connections",
      "name": "A parallel connection adds a failure",
      "description": "Two scripted wrong guesses and one on a parallel connection reach the threshold before the right guess at tick 4.",
      "behaviors": [
        "guess-throttle-flow"
      ],
      "faults": [
        "parallel-connection-guess"
      ],
      "steps": [
        {
          "at": 0,
          "event": "pw-attempt",
          "payload": {
            "guess": "wrong",
            "limit-key": "account-1"
          }
        },
        {
          "at": 2,
          "event": "pw-attempt",
          "payload": {
            "guess": "wrong",
            "limit-key": "account-1"
          }
        },
        {
          "at": 4,
          "event": "pw-attempt",
          "payload": {
            "guess": "right",
            "limit-key": "account-1"
          }
        }
      ]
    },
    {
      "id": "guesses-on-parallel-connections-impl",
      "name": "A parallel connection adds a failure (implementation)",
      "description": "Two scripted wrong guesses and one on a parallel connection reach the threshold before the right guess at tick 4.",
      "behaviors": [
        "guess-throttle-flow-impl"
      ],
      "faults": [
        "parallel-connection-guess"
      ],
      "steps": [
        {
          "at": 0,
          "event": "pw-attempt",
          "payload": {
            "guess": "wrong",
            "limit-key": "account-1"
          }
        },
        {
          "at": 2,
          "event": "pw-attempt",
          "payload": {
            "guess": "wrong",
            "limit-key": "account-1"
          }
        },
        {
          "at": 4,
          "event": "pw-attempt",
          "payload": {
            "guess": "right",
            "limit-key": "account-1"
          }
        }
      ],
      "routes": [
        {
          "event": "pw-attempt",
          "behavior": "guess-throttle-flow-impl",
          "by": "key",
          "field": "limit-key"
        }
      ]
    },
