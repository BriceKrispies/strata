    {
      "id": "session-authority-flow-impl",
      "name": "Session authority (implementation)",
      "subject": "identity-service",
      "level": "implementation",
      "initial": "sa-live-i",
      "description": "The identity service record of one session (rec-session, keyed by session-id): revoked-at is set at the revocation and a lookup answers from it. The revocation notice to the gateways may be lost; a lookup is never answered from a copy. The refinement reads one model tick as one second (timeScale 1000, as for the gateway copy whose model compares with it), and the mapping gives the model the revocation in seconds.",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "revoked",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "revokedAt",
          "type": "number",
          "initial": 0,
          "repr": "timestamp"
        }
      ],
      "states": [
        {
          "id": "sa-live-i",
          "name": "Session live"
        },
        {
          "id": "sa-revoked-i",
          "name": "Session revoked",
          "ignores": [
            "sr-revoked",
            "sr-authenticated",
            "sr-password-changed",
            "sr-recovered",
            "sr-signed-out",
            "sr-deactivated",
            "sr-owner-revoked",
            "sr-list"
          ]
        }
      ],
      "transitions": [
        {
          "id": "sa-revoke-i",
          "from": "sa-live-i",
          "to": "sa-revoked-i",
          "on": "sr-revoked",
          "otherwise": true,
          "effects": [
            {
              "set": "revoked",
              "to": true
            },
            {
              "set": "revokedAt",
              "to": "time"
            },
            {
              "emit": "sr-notice",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "sa-answer-live-i",
          "from": "sa-live-i",
          "to": "sa-live-i",
          "on": "sr-lookup",
          "otherwise": true,
          "effects": [
            {
              "emit": "sr-lookup-answer",
              "to": "gateway",
              "payload": {
                "valid": true
              }
            },
            {
              "emit": "sr-session-valid",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "sa-answer-revoked-i",
          "from": "sa-revoked-i",
          "to": "sa-revoked-i",
          "on": "sr-lookup",
          "otherwise": true,
          "effects": [
            {
              "emit": "sr-lookup-answer",
              "to": "gateway",
              "payload": {
                "valid": false
              }
            },
            {
              "emit": "sr-session-invalid",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "sa-end-on-auth-i",
          "from": "sa-live-i",
          "to": "sa-revoked-i",
          "on": "sr-authenticated",
          "guard": "event.sameBrowser",
          "effects": [
            {
              "set": "revoked",
              "to": true
            },
            {
              "set": "revokedAt",
              "to": "time"
            },
            {
              "emit": "sr-notice",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "sa-end-on-password-i",
          "from": "sa-live-i",
          "to": "sa-revoked-i",
          "on": "sr-password-changed",
          "guard": "event.initiator == 'other'",
          "effects": [
            {
              "set": "revoked",
              "to": true
            },
            {
              "set": "revokedAt",
              "to": "time"
            },
            {
              "emit": "sr-notice",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "sa-end-on-recovery-i",
          "from": "sa-live-i",
          "to": "sa-revoked-i",
          "on": "sr-recovered",
          "effects": [
            {
              "set": "revoked",
              "to": true
            },
            {
              "set": "revokedAt",
              "to": "time"
            },
            {
              "emit": "sr-notice",
              "to": "gateway"
            }
          ],
          "otherwise": true
        },
        {
          "id": "sa-end-on-signout-i",
          "from": "sa-live-i",
          "to": "sa-revoked-i",
          "on": "sr-signed-out",
          "effects": [
            {
              "set": "revoked",
              "to": true
            },
            {
              "set": "revokedAt",
              "to": "time"
            },
            {
              "emit": "sr-notice",
              "to": "gateway"
            }
          ],
          "otherwise": true
        },
        {
          "id": "sa-end-on-deactivation-i",
          "from": "sa-live-i",
          "to": "sa-revoked-i",
          "on": "sr-deactivated",
          "effects": [
            {
              "set": "revoked",
              "to": true
            },
            {
              "set": "revokedAt",
              "to": "time"
            },
            {
              "emit": "sr-notice",
              "to": "gateway"
            }
          ],
          "otherwise": true
        },
        {
          "id": "sa-end-on-owner-i",
          "from": "sa-live-i",
          "to": "sa-revoked-i",
          "on": "sr-owner-revoked",
          "guard": "event.target == 'this'",
          "effects": [
            {
              "set": "revoked",
              "to": true
            },
            {
              "set": "revokedAt",
              "to": "time"
            },
            {
              "emit": "sr-notice",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "sa-list-i",
          "from": "sa-live-i",
          "to": "sa-live-i",
          "on": "sr-list",
          "effects": [
            {
              "emit": "sr-listed",
              "to": "web-application"
            }
          ],
          "otherwise": true
        }
      ],
      "refines": "session-authority-flow",
      "refinement": {
        "states": {
          "sa-live-i": "sa-live",
          "sa-revoked-i": "sa-revoked"
        },
        "variables": {
          "revoked": "revoked",
          "revokedAt": "revokedAt / 1000"
        },
        "transitions": {
          "sa-revoke-i": "sa-revoke",
          "sa-answer-live-i": "sa-answer-live",
          "sa-answer-revoked-i": "sa-answer-revoked",
          "sa-end-on-auth-i": "sa-end-on-auth",
          "sa-end-on-password-i": "sa-end-on-password",
          "sa-end-on-recovery-i": "sa-end-on-recovery",
          "sa-end-on-signout-i": "sa-end-on-signout",
          "sa-end-on-deactivation-i": "sa-end-on-deactivation",
          "sa-end-on-owner-i": "sa-end-on-owner",
          "sa-list-i": "sa-list"
        },
        "timeScale": 1000
      },
      "storage": {
        "record": "rec-session",
        "key": "session-id",
        "fields": {
          "revokedAt": "revoked-at"
        }
      }
    },
    {"id":"gateway-session-flow","name":"Gateway session copy","subject":"gateway","initial":"gs-ready","description":"The gateway's copy of the session. It trusts the copy for 5 ticks, then asks again.","variables":[
        {
          "name": "valid",
          "type": "boolean",
          "initial": true
        },
        {
          "name": "checkedAt",
          "type": "number",
          "initial": 0
        },
        {
          "name": "staleAccept",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "checked",
          "type": "boolean",
          "initial": false
        }
      ],"states":[{"id":"gs-ready","name":"Ready"},{"id":"gs-checking","name":"Asking the identity service"}],"transitions":[
        {
          "id": "gs-hear-revocation",
          "from": "gs-ready",
          "to": "gs-ready",
          "on": "sr-notice",
          "effects": [
            {
              "set": "valid",
              "to": false
            }
          ]
        },
        {
          "id": "gs-accept-without-recheck",
          "from": "gs-ready",
          "to": "gs-ready",
          "on": "sr-request",
          "faultOnly": true,
          "guard": "valid",
          "description": "Defect: trusts the copy however old it is.",
          "effects": [
            {
              "set": "staleAccept",
              "to": "staleAccept || (session-authority-flow.revoked && time - session-authority-flow.revokedAt >= 5)"
            },
            {
              "emit": "sr-accepted"
            }
          ]
        },
        {
          "id": "gs-accept-fresh",
          "from": "gs-ready",
          "to": "gs-ready",
          "on": "sr-request",
          "guard": "valid && checked && checkedAt <= time && time - checkedAt < 5",
          "effects": [
            {
              "set": "staleAccept",
              "to": "staleAccept || (session-authority-flow.revoked && time - session-authority-flow.revokedAt >= 5)"
            },
            {
              "emit": "sr-accepted"
            }
          ]
        },
        {
          "id": "gs-refuse-known",
          "from": "gs-ready",
          "to": "gs-ready",
          "on": "sr-request",
          "guard": "!valid",
          "effects": [
            {
              "emit": "sr-refused"
            }
          ]
        },
        {
          "id": "gs-recheck",
          "from": "gs-ready",
          "to": "gs-checking",
          "on": "sr-request",
          "guard": "valid && !(checked && checkedAt <= time && time - checkedAt < 5)",
          "effects": [
            {
              "emit": "sr-lookup"
            }
          ]
        },
        {
          "id": "gs-recheck-live",
          "from": "gs-checking",
          "to": "gs-ready",
          "on": "sr-lookup-answer",
          "guard": "event.valid == true",
          "effects": [
            {
              "set": "checked",
              "to": true
            },
            {
              "set": "checkedAt",
              "to": "time"
            },
            {
              "set": "staleAccept",
              "to": "staleAccept || (session-authority-flow.revoked && time - session-authority-flow.revokedAt >= 5)"
            },
            {
              "emit": "sr-accepted"
            }
          ]
        },
        {
          "id": "gs-recheck-revoked",
          "from": "gs-checking",
          "to": "gs-ready",
          "on": "sr-lookup-answer",
          "guard": "event.valid == false",
          "effects": [
            {
              "set": "valid",
              "to": false
            },
            {
              "emit": "sr-refused"
            }
          ]
        }
      ]},
    {
      "id": "gateway-session-flow-impl",
      "name": "Gateway session copy (implementation)",
      "subject": "gateway",
      "level": "implementation",
      "initial": "gs-ready-i",
      "description": "The gateway copy of one session, held in the gateway process. It trusts the copy for 5 seconds (5000 ms, IDN-014) after the last check, then asks the identity service again; a revocation notice marks the copy invalid at once. The observation of the revocation bound belongs to the model: the identity service state it compares with is not visible to the gateway, so the mapping gives the model staleAccept as false. The refinement reads one model tick as one second (timeScale 1000), so the model bound of 5 ticks is the 5 seconds here.",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "valid",
          "type": "boolean",
          "initial": true,
          "repr": "bool"
        },
        {
          "name": "checkedAt",
          "type": "number",
          "initial": 0,
          "repr": "timestamp"
        },
        {
          "name": "checked",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        }
      ],
      "states": [
        {
          "id": "gs-ready-i",
          "name": "Copy held",
          "ignores": [
            "sr-lookup-answer"
          ]
        },
        {
          "id": "gs-checking-i",
          "name": "Asking the identity service",
          "ignores": [
            "sr-notice",
            "sr-request"
          ]
        }
      ],
      "transitions": [
        {
          "id": "gs-hear-revocation-i",
          "from": "gs-ready-i",
          "to": "gs-ready-i",
          "on": "sr-notice",
          "otherwise": true,
          "effects": [
            {
              "set": "valid",
              "to": false
            }
          ]
        },
        {
          "id": "gs-accept-fresh-i",
          "from": "gs-ready-i",
          "to": "gs-ready-i",
          "on": "sr-request",
          "guard": "valid && checked && checkedAt <= time && time - checkedAt < 5000",
          "effects": [
            {
              "emit": "sr-accepted",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "gs-refuse-known-i",
          "from": "gs-ready-i",
          "to": "gs-ready-i",
          "on": "sr-request",
          "guard": "!valid",
          "effects": [
            {
              "emit": "sr-refused",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "gs-recheck-i",
          "from": "gs-ready-i",
          "to": "gs-checking-i",
          "on": "sr-request",
          "guard": "valid && !(checked && checkedAt <= time && time - checkedAt < 5000)",
          "effects": [
            {
              "emit": "sr-lookup",
              "to": "identity-service"
            }
          ]
        },
        {
          "id": "gs-recheck-live-i",
          "from": "gs-checking-i",
          "to": "gs-ready-i",
          "on": "sr-lookup-answer",
          "guard": "event.valid == true",
          "effects": [
            {
              "set": "checked",
              "to": true
            },
            {
              "set": "checkedAt",
              "to": "time"
            },
            {
              "emit": "sr-accepted",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "gs-recheck-revoked-i",
          "from": "gs-checking-i",
          "to": "gs-ready-i",
          "on": "sr-lookup-answer",
          "guard": "event.valid == false",
          "effects": [
            {
              "set": "valid",
              "to": false
            },
            {
              "emit": "sr-refused",
              "to": "web-application"
            }
          ]
        }
      ],
      "refines": "gateway-session-flow",
      "refinement": {
        "states": {
          "gs-ready-i": "gs-ready",
          "gs-checking-i": "gs-checking"
        },
        "variables": {
          "valid": "valid",
          "checkedAt": "checkedAt / 1000",
          "staleAccept": "false",
          "checked": "checked"
        },
        "transitions": {
          "gs-hear-revocation-i": "gs-hear-revocation",
          "gs-accept-fresh-i": "gs-accept-fresh",
          "gs-refuse-known-i": "gs-refuse-known",
          "gs-recheck-i": "gs-recheck",
          "gs-recheck-live-i": "gs-recheck-live",
          "gs-recheck-revoked-i": "gs-recheck-revoked"
        },
        "timeScale": 1000
      },
      "storage": {
        "record": "rec-session-copy",
        "key": "session-id",
        "fields": {
          "checkedAt": "checked-at"
        },
        "state": "session-state",
        "createdBy": "look-up-session"
      }
    },
    {"id":"job-lease-flow","name":"Job lease","subject":"automation-worker","initial":"jl-waiting","description":"One job. Every grant raises the token, and a result is recorded only with the current token.","variables":[{"name":"token","type":"number","initial":0},{"name":"completions","type":"number","initial":0},{"name":"acceptedToken","type":"number","initial":0}],"states":[{"id":"jl-waiting","name":"Waiting"},{"id":"jl-leased","name":"Leased"},{"id":"jl-done","name":"Completed"}],"transitions":[{"id":"jl-grant","from":"jl-waiting","to":"jl-leased","on":"job-due","effects":[{"set":"token","to":"token + 1"},{"emit":"lease-granted"}]},{"id":"jl-regrant","from":"jl-leased","to":"jl-leased","on":"lease-expired","effects":[{"set":"token","to":"token + 1"},{"emit":"lease-granted"}]},{"id":"jl-complete-any-token","from":"jl-leased","to":"jl-done","on":"work-reported","faultOnly":true,"description":"Defect: records a result without checking its token.","effects":[{"set":"completions","to":"completions + 1"},{"set":"acceptedToken","to":"event.token"},{"emit":"job-completed"}]},{"id":"jl-complete","from":"jl-leased","to":"jl-done","on":"work-reported","guard":"event.token == token","effects":[{"set":"completions","to":"completions + 1"},{"set":"acceptedToken","to":"event.token"},{"emit":"job-completed"}]},{"id":"jl-refuse-stale","from":"jl-leased","to":"jl-leased","on":"work-reported","effects":[{"emit":"result-refused"}]},{"id":"jl-refuse-after-done","from":"jl-done","to":"jl-done","on":"work-reported","effects":[{"emit":"result-refused"}]}]},
    {
      "id": "job-lease-flow-impl",
      "name": "Job lease (implementation)",
      "subject": "automation-worker",
      "level": "implementation",
      "initial": "jl-waiting-i",
      "description": "One job as the automation worker keeps it (rec-job, keyed by job-id): lease-token is raised at every grant and a reported result is recorded only when it carries the current token. A lease runs for 60 seconds (60000 ms, default) and a timer then raises lease-expired. A result with another token, or one that arrives after the job is done, is refused.",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "token",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "completions",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "acceptedToken",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        }
      ],
      "states": [
        {
          "id": "jl-waiting-i",
          "name": "Waiting for a worker",
          "ignores": [
            "lease-expired",
            "work-reported"
          ]
        },
        {
          "id": "jl-leased-i",
          "name": "Leased",
          "ignores": [
            "job-due"
          ]
        },
        {
          "id": "jl-done-i",
          "name": "Done",
          "ignores": [
            "job-due",
            "lease-expired"
          ]
        }
      ],
      "transitions": [
        {
          "id": "jl-grant-i",
          "from": "jl-waiting-i",
          "to": "jl-leased-i",
          "on": "job-due",
          "otherwise": true,
          "effects": [
            {
              "set": "token",
              "to": "token + 1"
            },
            {
              "emit": "lease-granted",
              "to": "automation-worker"
            },
            {
              "timer": "lease",
              "after": 60000,
              "emit": "lease-expired"
            }
          ]
        },
        {
          "id": "jl-regrant-i",
          "from": "jl-leased-i",
          "to": "jl-leased-i",
          "on": "lease-expired",
          "otherwise": true,
          "effects": [
            {
              "set": "token",
              "to": "token + 1"
            },
            {
              "emit": "lease-granted",
              "to": "automation-worker"
            },
            {
              "timer": "lease",
              "after": 60000,
              "emit": "lease-expired"
            }
          ]
        },
        {
          "id": "jl-complete-i",
          "from": "jl-leased-i",
          "to": "jl-done-i",
          "on": "work-reported",
          "guard": "event.token == token",
          "effects": [
            {
              "set": "completions",
              "to": "completions + 1"
            },
            {
              "set": "acceptedToken",
              "to": "event.token"
            },
            {
              "emit": "job-completed",
              "to": "automation-worker"
            },
            {
              "cancel": "lease"
            }
          ]
        },
        {
          "id": "jl-refuse-stale-i",
          "from": "jl-leased-i",
          "to": "jl-leased-i",
          "on": "work-reported",
          "otherwise": true,
          "effects": [
            {
              "emit": "result-refused",
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "jl-refuse-after-done-i",
          "from": "jl-done-i",
          "to": "jl-done-i",
          "on": "work-reported",
          "otherwise": true,
          "effects": [
            {
              "emit": "result-refused",
              "to": "automation-worker"
            }
          ]
        }
      ],
      "refines": "job-lease-flow",
      "refinement": {
        "states": {
          "jl-waiting-i": "jl-waiting",
          "jl-leased-i": "jl-leased",
          "jl-done-i": "jl-done"
        },
        "variables": {
          "token": "token",
          "completions": "completions",
          "acceptedToken": "acceptedToken"
        },
        "transitions": {
          "jl-grant-i": "jl-grant",
          "jl-regrant-i": "jl-regrant",
          "jl-complete-i": "jl-complete",
          "jl-refuse-stale-i": "jl-refuse-stale",
          "jl-refuse-after-done-i": "jl-refuse-after-done"
        }
      },
      "storage": {
        "record": "rec-job",
        "key": "job-id",
        "fields": {
          "token": "lease-token",
          "acceptedToken": "accepted-token"
        },
        "stateValues": {
          "jl-waiting-i": "waiting",
          "jl-leased-i": "leased",
          "jl-done-i": "completed"
        }
      }
    },
    {"id":"origin-content-flow","name":"Origin content","subject":"runtime","initial":"oc-live","description":"The published version of one page at the origin.","variables":[{"name":"version","type":"number","initial":1},{"name":"changedAt","type":"number","initial":0}],"states":[{"id":"oc-live","name":"Live"}],"transitions":[{"id":"oc-publish","from":"oc-live","to":"oc-live","on":"ec-published","effects":[{"set":"version","to":"version + 1"},{"set":"changedAt","to":"time"},{"emit":"ec-purge"}]},{"id":"oc-answer","from":"oc-live","to":"oc-live","on":"ec-origin-fetch","effects":[{"emit":"ec-origin-answer","payload":{"version":"version"}}]}]},
    {
      "id": "origin-content-flow-impl",
      "name": "Origin content (implementation)",
      "subject": "runtime",
      "level": "implementation",
      "initial": "oc-live-i",
      "description": "The published version of one page at the origin, held in its published-page record (rec-published-page, keyed by record-id; the page content is a tenant record in tbl-records). A publication raises the version, notes the time in milliseconds and asks the content delivery network, through its control interface, to purge; a fetch is answered with the current version. The refinement reads one model tick as one second (timeScale 1000, as for the edge copy whose model compares with it), and the mapping gives the model the time of the change in seconds.",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "version",
          "type": "number",
          "initial": 1,
          "repr": "u64"
        },
        {
          "name": "changedAt",
          "type": "number",
          "initial": 0,
          "repr": "timestamp"
        }
      ],
      "states": [
        {
          "id": "oc-live-i",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "oc-publish-i",
          "from": "oc-live-i",
          "to": "oc-live-i",
          "on": "ec-published",
          "otherwise": true,
          "effects": [
            {
              "set": "version",
              "to": "version + 1"
            },
            {
              "set": "changedAt",
              "to": "time"
            },
            {
              "emit": "ec-purge",
              "to": "delivery-network-control"
            }
          ]
        },
        {
          "id": "oc-answer-i",
          "from": "oc-live-i",
          "to": "oc-live-i",
          "on": "ec-origin-fetch",
          "otherwise": true,
          "effects": [
            {
              "emit": "ec-origin-answer",
              "to": "delivery-network",
              "payload": {
                "version": "version"
              }
            }
          ]
        }
      ],
      "refines": "origin-content-flow",
      "refinement": {
        "states": {
          "oc-live-i": "oc-live"
        },
        "variables": {
          "version": "version",
          "changedAt": "changedAt / 1000"
        },
        "transitions": {
          "oc-publish-i": "oc-publish",
          "oc-answer-i": "oc-answer"
        },
        "timeScale": 1000
      },
      "storage": {
        "record": "rec-published-page",
        "key": [
          "record-id"
        ],
        "fields": {
          "changedAt": "changed-at"
        },
        "createdBy": "commit-transition"
      }
    },
    {"id":"edge-copy-flow","name":"Edge copy","subject":"delivery-network","initial":"eg-ready","description":"The edge copy of the page. It is dropped by a purge and revalidated after a lifetime of 5 ticks.","variables":[
        {
          "name": "held",
          "type": "number",
          "initial": 1
        },
        {
          "name": "storedAt",
          "type": "number",
          "initial": 0
        },
        {
          "name": "staleServed",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "stored",
          "type": "boolean",
          "initial": false
        }
      ],"states":[{"id":"eg-ready","name":"Ready"},{"id":"eg-fetching","name":"Fetching from the origin"}],"transitions":[
        {
          "id": "eg-purge",
          "from": "eg-ready",
          "to": "eg-ready",
          "on": "ec-purge",
          "effects": [
            {
              "set": "held",
              "to": 0
            }
          ]
        },
        {
          "id": "eg-serve-past-lifetime",
          "from": "eg-ready",
          "to": "eg-ready",
          "on": "ec-request",
          "faultOnly": true,
          "guard": "held > 0",
          "description": "Defect: serves the copy however old it is.",
          "effects": [
            {
              "set": "staleServed",
              "to": "staleServed || (held != origin-content-flow.version && time - origin-content-flow.changedAt >= 5)"
            },
            {
              "emit": "ec-served"
            }
          ]
        },
        {
          "id": "eg-serve",
          "from": "eg-ready",
          "to": "eg-ready",
          "on": "ec-request",
          "guard": "held > 0 && stored && storedAt <= time && time - storedAt < 5",
          "effects": [
            {
              "set": "staleServed",
              "to": "staleServed || (held != origin-content-flow.version && time - origin-content-flow.changedAt >= 5)"
            },
            {
              "emit": "ec-served"
            }
          ]
        },
        {
          "id": "eg-fetch",
          "from": "eg-ready",
          "to": "eg-fetching",
          "on": "ec-request",
          "effects": [
            {
              "emit": "ec-origin-fetch"
            }
          ]
        },
        {
          "id": "eg-store",
          "from": "eg-fetching",
          "to": "eg-ready",
          "on": "ec-origin-answer",
          "effects": [
            {
              "set": "stored",
              "to": true
            },
            {
              "set": "held",
              "to": "event.version"
            },
            {
              "set": "storedAt",
              "to": "time"
            },
            {
              "emit": "ec-served"
            }
          ]
        }
      ]},
    {
      "id": "edge-copy-flow-impl",
      "name": "Edge copy (implementation)",
      "subject": "delivery-network",
      "level": "implementation",
      "initial": "eg-ready-i",
      "description": "The copy of one page in the edge cache of the content delivery network, kept in its cache memory and not in a record of the platform. held is the version of the copy and 0 when it has been purged; a copy is served for 5 seconds (5000 ms, EDG-007) after it was stored and revalidated at the origin after that. The observation of the staleness bound belongs to the model: the origin state it compares with is not visible to the edge, so the mapping gives the model staleServed as false. The refinement reads one model tick as one second (timeScale 1000), so the model lifetime of 5 ticks is the 5 seconds here.",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "held",
          "type": "number",
          "initial": 1,
          "repr": "u64"
        },
        {
          "name": "storedAt",
          "type": "number",
          "initial": 0,
          "repr": "timestamp"
        },
        {
          "name": "stored",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        }
      ],
      "states": [
        {
          "id": "eg-ready-i",
          "name": "Ready",
          "ignores": [
            "ec-origin-answer"
          ]
        },
        {
          "id": "eg-fetching-i",
          "name": "Fetching from the origin",
          "ignores": [
            "ec-purge",
            "ec-request"
          ]
        }
      ],
      "transitions": [
        {
          "id": "eg-purge-i",
          "from": "eg-ready-i",
          "to": "eg-ready-i",
          "on": "ec-purge",
          "otherwise": true,
          "effects": [
            {
              "set": "held",
              "to": 0
            }
          ]
        },
        {
          "id": "eg-serve-i",
          "from": "eg-ready-i",
          "to": "eg-ready-i",
          "on": "ec-request",
          "guard": "held > 0 && stored && storedAt <= time && time - storedAt < 5000",
          "effects": [
            {
              "emit": "ec-served",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "eg-fetch-i",
          "from": "eg-ready-i",
          "to": "eg-fetching-i",
          "on": "ec-request",
          "otherwise": true,
          "effects": [
            {
              "emit": "ec-origin-fetch",
              "to": "traffic-switch"
            }
          ]
        },
        {
          "id": "eg-store-i",
          "from": "eg-fetching-i",
          "to": "eg-ready-i",
          "on": "ec-origin-answer",
          "otherwise": true,
          "effects": [
            {
              "set": "stored",
              "to": true
            },
            {
              "set": "held",
              "to": "event.version"
            },
            {
              "set": "storedAt",
              "to": "time"
            },
            {
              "emit": "ec-served",
              "to": "web-application"
            }
          ]
        }
      ],
      "refines": "edge-copy-flow",
      "refinement": {
        "states": {
          "eg-ready-i": "eg-ready",
          "eg-fetching-i": "eg-fetching"
        },
        "variables": {
          "held": "held",
          "storedAt": "storedAt / 1000",
          "staleServed": "false",
          "stored": "stored"
        },
        "transitions": {
          "eg-purge-i": "eg-purge",
          "eg-serve-i": "eg-serve",
          "eg-fetch-i": "eg-fetch",
          "eg-store-i": "eg-store"
        },
        "timeScale": 1000
      },
      "storage": {
        "record": "rec-published-page",
        "key": [
          "record-id"
        ],
        "fields": {
          "storedAt": "stored-at"
        },
        "state": "copy-state"
      }
    },
    {"id":"provisioning-flow","name":"Tenant provisioning","subject":"control-plane","initial":"pv-idle","description":"Create the database, apply the layout, install the template, then report the tenant as active.","variables":[{"name":"database","type":"boolean","initial":false},{"name":"layout","type":"boolean","initial":false},{"name":"template","type":"boolean","initial":false},{"name":"active","type":"boolean","initial":false}],"states":[{"id":"pv-idle","name":"Idle"},{"id":"pv-creating","name":"Creating the database"},{"id":"pv-laying","name":"Applying the layout"},{"id":"pv-installing","name":"Installing the template"},{"id":"pv-active","name":"Active","terminal":true},{"id":"pv-failed","name":"Rolled back","terminal":true}],"transitions":[{"id":"pv-start","from":"pv-idle","to":"pv-creating","on":"pv-requested","effects":[{"emit":"pv-database-created"}]},{"id":"pv-activate-early","from":"pv-creating","to":"pv-active","on":"pv-database-created","faultOnly":true,"description":"Defect: reports the tenant active as soon as its database exists.","effects":[{"set":"database","to":true},{"set":"active","to":true},{"emit":"pv-activated"}]},{"id":"pv-created","from":"pv-creating","to":"pv-laying","on":"pv-database-created","effects":[{"set":"database","to":true},{"emit":"pv-layout-applied","after":2}]},{"id":"pv-laid","from":"pv-laying","to":"pv-installing","on":"pv-layout-applied","effects":[{"set":"layout","to":true},{"emit":"pv-template-installed","after":2}]},{"id":"pv-installed","from":"pv-installing","to":"pv-active","on":"pv-template-installed","effects":[{"set":"template","to":true},{"set":"active","to":true},{"emit":"pv-activated"}]},{"id":"pv-fail-laying","from":"pv-laying","to":"pv-failed","on":"pv-step-failed","effects":[{"set":"database","to":false},{"emit":"pv-rolled-back"}]},{"id":"pv-fail-installing","from":"pv-installing","to":"pv-failed","on":"pv-step-failed","effects":[{"set":"database","to":false},{"set":"layout","to":false},{"emit":"pv-rolled-back"}]}]},
    {
      "id": "provisioning-flow-impl",
      "name": "Tenant provisioning (implementation)",
      "subject": "control-plane",
      "level": "implementation",
      "initial": "pv-idle-i",
      "description": "Creation of one tenant by the control plane (rec-tenant, keyed by tenant-id; the state of this machine is held in its flow-state field): create the database, apply the layout 5 seconds later (5000 ms, default), install the template 5 seconds after that (5000 ms, default), then report the tenant as active. A failed step undoes what was done and ends in failure; the tenant is never reported active before the layout and the template are in place. One model tick is 2.5 seconds here (timeScale 2500), so the model delay of two ticks is the 5 seconds.",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "database",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "layout",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "template",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "active",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        }
      ],
      "states": [
        {
          "id": "pv-idle-i",
          "name": "Requested nothing",
          "ignores": [
            "pv-database-created",
            "pv-layout-applied",
            "pv-template-installed",
            "pv-step-failed"
          ]
        },
        {
          "id": "pv-creating-i",
          "name": "Creating the database",
          "ignores": [
            "pv-requested",
            "pv-layout-applied",
            "pv-template-installed",
            "pv-step-failed"
          ]
        },
        {
          "id": "pv-laying-i",
          "name": "Applying the layout",
          "ignores": [
            "pv-requested",
            "pv-database-created",
            "pv-template-installed"
          ]
        },
        {
          "id": "pv-installing-i",
          "name": "Installing the template",
          "ignores": [
            "pv-requested",
            "pv-database-created",
            "pv-layout-applied"
          ]
        },
        {
          "id": "pv-active-i",
          "name": "Active",
          "terminal": true
        },
        {
          "id": "pv-failed-i",
          "name": "Failed",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "pv-start-i",
          "from": "pv-idle-i",
          "to": "pv-creating-i",
          "on": "pv-requested",
          "otherwise": true,
          "effects": [
            {
              "emit": "pv-database-created",
              "to": "control-plane"
            }
          ]
        },
        {
          "id": "pv-created-i",
          "from": "pv-creating-i",
          "to": "pv-laying-i",
          "on": "pv-database-created",
          "otherwise": true,
          "effects": [
            {
              "set": "database",
              "to": true
            },
            {
              "emit": "pv-layout-applied",
              "to": "control-plane",
              "after": 5000
            }
          ]
        },
        {
          "id": "pv-laid-i",
          "from": "pv-laying-i",
          "to": "pv-installing-i",
          "on": "pv-layout-applied",
          "otherwise": true,
          "effects": [
            {
              "set": "layout",
              "to": true
            },
            {
              "emit": "pv-template-installed",
              "to": "control-plane",
              "after": 5000
            }
          ]
        },
        {
          "id": "pv-installed-i",
          "from": "pv-installing-i",
          "to": "pv-active-i",
          "on": "pv-template-installed",
          "otherwise": true,
          "effects": [
            {
              "set": "template",
              "to": true
            },
            {
              "set": "active",
              "to": true
            },
            {
              "emit": "pv-activated",
              "to": "control-plane"
            }
          ]
        },
        {
          "id": "pv-fail-laying-i",
          "from": "pv-laying-i",
          "to": "pv-failed-i",
          "on": "pv-step-failed",
          "otherwise": true,
          "effects": [
            {
              "set": "database",
              "to": false
            },
            {
              "emit": "pv-rolled-back",
              "to": "control-plane"
            }
          ]
        },
        {
          "id": "pv-fail-installing-i",
          "from": "pv-installing-i",
          "to": "pv-failed-i",
          "on": "pv-step-failed",
          "otherwise": true,
          "effects": [
            {
              "set": "database",
              "to": false
            },
            {
              "set": "layout",
              "to": false
            },
            {
              "emit": "pv-rolled-back",
              "to": "control-plane"
            }
          ]
        }
      ],
      "refines": "provisioning-flow",
      "refinement": {
        "states": {
          "pv-idle-i": "pv-idle",
          "pv-creating-i": "pv-creating",
          "pv-laying-i": "pv-laying",
          "pv-installing-i": "pv-installing",
          "pv-active-i": "pv-active",
          "pv-failed-i": "pv-failed"
        },
        "variables": {
          "database": "database",
          "layout": "layout",
          "template": "template",
          "active": "active"
        },
        "transitions": {
          "pv-start-i": "pv-start",
          "pv-created-i": "pv-created",
          "pv-laid-i": "pv-laid",
          "pv-installed-i": "pv-installed",
          "pv-fail-laying-i": "pv-fail-laying",
          "pv-fail-installing-i": "pv-fail-installing"
        },
        "timeScale": 2500
      },
      "storage": {
        "record": "rec-tenant",
        "key": "tenant-id",
        "fields": {
          "database": "database-created",
          "layout": "layout-applied",
          "template": "template-installed",
          "active": "activated"
        },
        "state": "flow-state"
      }
    },
    {"id":"proposal-flow","name":"Change proposal","subject":"agent-gateway","initial":"cp-idle","description":"A change is projected, then applied directly when policy classes it as safe, or after approval when it is risky.","variables":[{"name":"risky","type":"boolean","initial":false},{"name":"projected","type":"boolean","initial":false},{"name":"cleared","type":"boolean","initial":false},{"name":"applied","type":"boolean","initial":false}],"states":[{"id":"cp-idle","name":"No proposal"},{"id":"cp-projecting","name":"Projecting"},{"id":"cp-awaiting","name":"Awaiting approval"},{"id":"cp-ready","name":"Cleared"},{"id":"cp-closed","name":"Rejected"},{"id":"cp-done","name":"Applied","terminal":true}],"transitions":[{"id":"cp-open","from":"cp-idle","to":"cp-projecting","on":"cp-proposed","effects":[{"set":"risky","to":"event.risky"},{"emit":"cp-projected"}]},{"id":"cp-clear-safe","from":"cp-projecting","to":"cp-ready","on":"cp-projected","guard":"!risky","effects":[{"set":"projected","to":true},{"set":"cleared","to":true}]},{"id":"cp-hold-risky","from":"cp-projecting","to":"cp-awaiting","on":"cp-projected","guard":"risky","effects":[{"set":"projected","to":true}]},{"id":"cp-approve","from":"cp-awaiting","to":"cp-ready","on":"cp-approved","effects":[{"set":"cleared","to":true}]},{"id":"cp-reject","from":"cp-awaiting","to":"cp-closed","on":"cp-rejected"},{"id":"cp-apply-unapproved","from":"cp-awaiting","to":"cp-done","on":"cp-apply-requested","faultOnly":true,"description":"Defect: applies a risky change that nobody approved.","effects":[{"set":"applied","to":true},{"emit":"cp-applied"}]},{"id":"cp-refuse-awaiting","from":"cp-awaiting","to":"cp-awaiting","on":"cp-apply-requested","effects":[{"emit":"cp-refused"}]},{"id":"cp-apply-rejected","from":"cp-closed","to":"cp-done","on":"cp-apply-requested","faultOnly":true,"description":"Defect: applies a change that was rejected.","effects":[{"set":"applied","to":true},{"emit":"cp-applied"}]},{"id":"cp-refuse-closed","from":"cp-closed","to":"cp-closed","on":"cp-apply-requested","effects":[{"emit":"cp-refused"}]},{"id":"cp-apply","from":"cp-ready","to":"cp-done","on":"cp-apply-requested","effects":[{"set":"applied","to":true},{"emit":"cp-applied"}]}]},
    {
      "id": "proposal-flow-impl",
      "name": "Change proposal (implementation)",
      "subject": "agent-gateway",
      "level": "implementation",
      "initial": "cp-idle-i",
      "description": "One change proposal as the agent gateway keeps it (rec-proposal, keyed by proposal-id; its state follows this machine). The change is projected first; a safe change is cleared at once, a risky one waits for an approver. An apply request is honoured only for a cleared proposal and is refused while it waits for approval or after a rejection.",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "risky",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "projected",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "cleared",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "applied",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        }
      ],
      "states": [
        {
          "id": "cp-idle-i",
          "name": "No proposal",
          "ignores": [
            "cp-projected",
            "cp-approved",
            "cp-rejected",
            "cp-apply-requested"
          ]
        },
        {
          "id": "cp-projecting-i",
          "name": "Projecting",
          "ignores": [
            "cp-proposed",
            "cp-approved",
            "cp-rejected",
            "cp-apply-requested"
          ]
        },
        {
          "id": "cp-awaiting-i",
          "name": "Awaiting approval",
          "ignores": [
            "cp-proposed",
            "cp-projected"
          ]
        },
        {
          "id": "cp-ready-i",
          "name": "Cleared to apply",
          "ignores": [
            "cp-proposed",
            "cp-projected",
            "cp-approved",
            "cp-rejected"
          ]
        },
        {
          "id": "cp-closed-i",
          "name": "Rejected",
          "ignores": [
            "cp-proposed",
            "cp-projected",
            "cp-approved",
            "cp-rejected"
          ]
        },
        {
          "id": "cp-done-i",
          "name": "Applied",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "cp-open-i",
          "from": "cp-idle-i",
          "to": "cp-projecting-i",
          "on": "cp-proposed",
          "otherwise": true,
          "effects": [
            {
              "set": "risky",
              "to": "event.risky"
            },
            {
              "emit": "cp-projected",
              "to": "agent-gateway"
            }
          ]
        },
        {
          "id": "cp-clear-safe-i",
          "from": "cp-projecting-i",
          "to": "cp-ready-i",
          "on": "cp-projected",
          "guard": "!risky",
          "effects": [
            {
              "set": "projected",
              "to": true
            },
            {
              "set": "cleared",
              "to": true
            }
          ]
        },
        {
          "id": "cp-hold-risky-i",
          "from": "cp-projecting-i",
          "to": "cp-awaiting-i",
          "on": "cp-projected",
          "guard": "risky",
          "effects": [
            {
              "set": "projected",
              "to": true
            }
          ]
        },
        {
          "id": "cp-approve-i",
          "from": "cp-awaiting-i",
          "to": "cp-ready-i",
          "on": "cp-approved",
          "otherwise": true,
          "effects": [
            {
              "set": "cleared",
              "to": true
            }
          ]
        },
        {
          "id": "cp-reject-i",
          "from": "cp-awaiting-i",
          "to": "cp-closed-i",
          "on": "cp-rejected",
          "otherwise": true
        },
        {
          "id": "cp-refuse-awaiting-i",
          "from": "cp-awaiting-i",
          "to": "cp-awaiting-i",
          "on": "cp-apply-requested",
          "otherwise": true,
          "effects": [
            {
              "emit": "cp-refused",
              "to": "agent"
            }
          ]
        },
        {
          "id": "cp-refuse-closed-i",
          "from": "cp-closed-i",
          "to": "cp-closed-i",
          "on": "cp-apply-requested",
          "otherwise": true,
          "effects": [
            {
              "emit": "cp-refused",
              "to": "agent"
            }
          ]
        },
        {
          "id": "cp-apply-i",
          "from": "cp-ready-i",
          "to": "cp-done-i",
          "on": "cp-apply-requested",
          "otherwise": true,
          "effects": [
            {
              "set": "applied",
              "to": true
            },
            {
              "emit": "cp-applied",
              "to": "runtime"
            }
          ]
        }
      ],
      "refines": "proposal-flow",
      "refinement": {
        "states": {
          "cp-idle-i": "cp-idle",
          "cp-projecting-i": "cp-projecting",
          "cp-awaiting-i": "cp-awaiting",
          "cp-ready-i": "cp-ready",
          "cp-closed-i": "cp-closed",
          "cp-done-i": "cp-done"
        },
        "variables": {
          "risky": "risky",
          "projected": "projected",
          "cleared": "cleared",
          "applied": "applied"
        },
        "transitions": {
          "cp-open-i": "cp-open",
          "cp-clear-safe-i": "cp-clear-safe",
          "cp-hold-risky-i": "cp-hold-risky",
          "cp-approve-i": "cp-approve",
          "cp-reject-i": "cp-reject",
          "cp-refuse-awaiting-i": "cp-refuse-awaiting",
          "cp-refuse-closed-i": "cp-refuse-closed",
          "cp-apply-i": "cp-apply"
        }
      },
      "storage": {
        "record": "rec-proposal",
        "key": "proposal-id",
        "state": "flow-state"
      }
    },
    {"id":"arc-outbox-consumer-flow","name":"Notice subscriber","subject":"connector-runner","initial":"arc-oc-ready","description":"One subscriber receiving notices of one tenant. A notice whose sequence number is already applied is acknowledged and makes no further effect.","variables":[{"name":"applied","type":"number","initial":0},{"name":"effects","type":"number","initial":0}],"states":[{"id":"arc-oc-ready","name":"Ready"}],"transitions":[{"id":"arc-ob-apply","from":"arc-oc-ready","to":"arc-oc-ready","on":"arc-ob-delivered","guard":"event.seq > applied","effects":[{"set":"applied","to":"event.seq"},{"set":"effects","to":"effects + 1"},{"emit":"arc-ob-acknowledged"}]},{"id":"arc-ob-apply-again","from":"arc-oc-ready","to":"arc-oc-ready","on":"arc-ob-delivered","guard":"event.seq <= applied","faultOnly":true,"description":"Defect: makes the effect of a notice it has already applied.","effects":[{"set":"effects","to":"effects + 1"},{"emit":"arc-ob-acknowledged"}]},{"id":"arc-ob-skip-seen","from":"arc-oc-ready","to":"arc-oc-ready","on":"arc-ob-delivered","guard":"event.seq <= applied","effects":[{"emit":"arc-ob-acknowledged"}]}]},
    {
      "id": "arc-outbox-consumer-flow-impl",
      "name": "Notice subscriber (implementation)",
      "subject": "connector-runner",
      "level": "implementation",
      "initial": "arc-oc-ready-i",
      "description": "One subscriber receiving the notices of one tenant, held by the connector runner. A notice is applied only when its sequence number is above the last one applied; any other is acknowledged without an effect. The outbox delivers at least once, so a repeated notice is expected.",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "applied",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "effects",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        }
      ],
      "states": [
        {
          "id": "arc-oc-ready-i",
          "name": "Ready"
        }
      ],
      "transitions": [
        {
          "id": "arc-ob-apply-i",
          "from": "arc-oc-ready-i",
          "to": "arc-oc-ready-i",
          "on": "arc-ob-delivered",
          "guard": "event.seq > applied",
          "effects": [
            {
              "set": "applied",
              "to": "event.seq"
            },
            {
              "set": "effects",
              "to": "effects + 1"
            },
            {
              "emit": "arc-ob-acknowledged",
              "to": "runtime"
            }
          ]
        },
        {
          "id": "arc-ob-skip-seen-i",
          "from": "arc-oc-ready-i",
          "to": "arc-oc-ready-i",
          "on": "arc-ob-delivered",
          "guard": "event.seq <= applied",
          "effects": [
            {
              "emit": "arc-ob-acknowledged",
              "to": "runtime"
            }
          ]
        }
      ],
      "refines": "arc-outbox-consumer-flow",
      "refinement": {
        "states": {
          "arc-oc-ready-i": "arc-oc-ready"
        },
        "variables": {
          "applied": "applied",
          "effects": "effects"
        },
        "transitions": {
          "arc-ob-apply-i": "arc-ob-apply",
          "arc-ob-skip-seen-i": "arc-ob-skip-seen"
        }
      },
      "storage": {
        "record": "rec-notice-subscriber",
        "key": "subscriber-id",
        "creates": true
      }
    },
    {"id":"arc-outbox-delivery-flow","name":"Outbox delivery after a stop","subject":"runtime","initial":"arc-od-idle","description":"A commit leaves events unpublished. The runtime that committed publishes them, or else the outbox job does.","variables":[{"name":"pending","type":"boolean","initial":false}],"states":[{"id":"arc-od-idle","name":"Nothing pending"},{"id":"arc-od-pending","name":"Events pending"},{"id":"arc-od-done","name":"Published","terminal":true}],"transitions":[{"id":"arc-od-commit","from":"arc-od-idle","to":"arc-od-pending","on":"rt-committed","effects":[{"set":"pending","to":true}]},{"id":"arc-od-publish-now","from":"arc-od-pending","to":"arc-od-done","on":"arc-ob-publish-now","effects":[{"set":"pending","to":false},{"emit":"arc-ob-published"}]},{"id":"arc-od-sweep","from":"arc-od-pending","to":"arc-od-done","on":"arc-ob-sweep-due","effects":[{"set":"pending","to":false},{"emit":"arc-ob-published"}]}]},
    {
      "id": "arc-outbox-delivery-flow-impl",
      "name": "Outbox delivery after a stop (implementation)",
      "subject": "runtime",
      "level": "implementation",
      "initial": "arc-od-idle-i",
      "description": "A commit leaves its domain events (rec-event, keyed by seq) unpublished. The runtime that committed publishes them at once, or else the outbox job finds them on its next sweep, 10 seconds after the commit (10000 ms, default), and publishes them. Publication is at least once; the consumer discards what it has seen.",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "pending",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        }
      ],
      "states": [
        {
          "id": "arc-od-idle-i",
          "name": "Nothing unpublished",
          "ignores": [
            "arc-ob-publish-now",
            "arc-ob-sweep-due"
          ]
        },
        {
          "id": "arc-od-pending-i",
          "name": "Events unpublished",
          "ignores": [
            "rt-committed"
          ]
        },
        {
          "id": "arc-od-done-i",
          "name": "Published",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "arc-od-commit-i",
          "from": "arc-od-idle-i",
          "to": "arc-od-pending-i",
          "on": "rt-committed",
          "otherwise": true,
          "effects": [
            {
              "set": "pending",
              "to": true
            },
            {
              "timer": "sweep",
              "after": 10000,
              "emit": "arc-ob-sweep-due"
            }
          ]
        },
        {
          "id": "arc-od-publish-now-i",
          "from": "arc-od-pending-i",
          "to": "arc-od-done-i",
          "on": "arc-ob-publish-now",
          "otherwise": true,
          "effects": [
            {
              "set": "pending",
              "to": false
            },
            {
              "emit": "arc-ob-published",
              "to": "notice-queue"
            },
            {
              "cancel": "sweep"
            }
          ]
        },
        {
          "id": "arc-od-sweep-i",
          "from": "arc-od-pending-i",
          "to": "arc-od-done-i",
          "on": "arc-ob-sweep-due",
          "otherwise": true,
          "effects": [
            {
              "set": "pending",
              "to": false
            },
            {
              "emit": "arc-ob-published",
              "to": "notice-queue"
            }
          ]
        }
      ],
      "refines": "arc-outbox-delivery-flow",
      "refinement": {
        "states": {
          "arc-od-idle-i": "arc-od-idle",
          "arc-od-pending-i": "arc-od-pending",
          "arc-od-done-i": "arc-od-done"
        },
        "variables": {
          "pending": "pending"
        },
        "transitions": {
          "arc-od-commit-i": "arc-od-commit",
          "arc-od-publish-now-i": "arc-od-publish-now",
          "arc-od-sweep-i": "arc-od-sweep"
        }
      },
      "storage": {
        "record": "rec-event",
        "key": "seq",
        "createdBy": "commit-transition"
      }
    },
    {"id":"arc-rolling-change-flow","name":"Rolling change of format","subject":"runtime","initial":"arc-rc-old","description":"Two versions run together while a deployment replaces the older one. Commits are written in the older format until the older version has stopped.","variables":[{"name":"oldRunning","type":"boolean","initial":true},{"name":"newFormat","type":"boolean","initial":false}],"states":[{"id":"arc-rc-old","name":"Older version only"},{"id":"arc-rc-mixed","name":"Both versions running"},{"id":"arc-rc-new","name":"Newer version only"}],"transitions":[{"id":"arc-rl-start","from":"arc-rc-old","to":"arc-rc-mixed","on":"arc-rl-deploy-started"},{"id":"arc-rl-commit-early","from":"arc-rc-mixed","to":"arc-rc-mixed","on":"arc-rl-commit","faultOnly":true,"description":"Defect: writes the newer format while the older version still runs.","effects":[{"set":"newFormat","to":true},{"emit":"arc-rl-committed"}]},{"id":"arc-rl-commit-old","from":"arc-rc-mixed","to":"arc-rc-mixed","on":"arc-rl-commit","effects":[{"emit":"arc-rl-committed"}]},{"id":"arc-rl-finish","from":"arc-rc-mixed","to":"arc-rc-new","on":"arc-rl-deploy-finished","effects":[{"set":"oldRunning","to":false}]},{"id":"arc-rl-commit-new","from":"arc-rc-new","to":"arc-rc-new","on":"arc-rl-commit","effects":[{"set":"newFormat","to":true},{"emit":"arc-rl-committed"}]}]},
    {
      "id": "arc-rolling-change-flow-impl",
      "name": "Rolling change of format (implementation)",
      "subject": "runtime",
      "level": "implementation",
      "initial": "arc-rc-old-i",
      "description": "Two versions of the runtime run together while a deployment replaces the older one. A commit is written in the older format until the deployment has finished and the older version has stopped; only then is the newer format written.",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "oldRunning",
          "type": "boolean",
          "initial": true,
          "repr": "bool"
        },
        {
          "name": "newFormat",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        }
      ],
      "states": [
        {
          "id": "arc-rc-old-i",
          "name": "Only the older version",
          "ignores": [
            "arc-rl-commit",
            "arc-rl-deploy-finished"
          ]
        },
        {
          "id": "arc-rc-mixed-i",
          "name": "Both versions",
          "ignores": [
            "arc-rl-deploy-started"
          ]
        },
        {
          "id": "arc-rc-new-i",
          "name": "Only the newer version",
          "ignores": [
            "arc-rl-deploy-started",
            "arc-rl-deploy-finished"
          ]
        }
      ],
      "transitions": [
        {
          "id": "arc-rl-start-i",
          "from": "arc-rc-old-i",
          "to": "arc-rc-mixed-i",
          "on": "arc-rl-deploy-started",
          "otherwise": true
        },
        {
          "id": "arc-rl-commit-old-i",
          "from": "arc-rc-mixed-i",
          "to": "arc-rc-mixed-i",
          "on": "arc-rl-commit",
          "otherwise": true,
          "effects": [
            {
              "emit": "arc-rl-committed",
              "to": "tenant-database"
            }
          ]
        },
        {
          "id": "arc-rl-finish-i",
          "from": "arc-rc-mixed-i",
          "to": "arc-rc-new-i",
          "on": "arc-rl-deploy-finished",
          "otherwise": true,
          "effects": [
            {
              "set": "oldRunning",
              "to": false
            }
          ]
        },
        {
          "id": "arc-rl-commit-new-i",
          "from": "arc-rc-new-i",
          "to": "arc-rc-new-i",
          "on": "arc-rl-commit",
          "otherwise": true,
          "effects": [
            {
              "set": "newFormat",
              "to": true
            },
            {
              "emit": "arc-rl-committed",
              "to": "tenant-database"
            }
          ]
        }
      ],
      "refines": "arc-rolling-change-flow",
      "refinement": {
        "states": {
          "arc-rc-old-i": "arc-rc-old",
          "arc-rc-mixed-i": "arc-rc-mixed",
          "arc-rc-new-i": "arc-rc-new"
        },
        "variables": {
          "oldRunning": "oldRunning",
          "newFormat": "newFormat"
        },
        "transitions": {
          "arc-rl-start-i": "arc-rl-start",
          "arc-rl-commit-old-i": "arc-rl-commit-old",
          "arc-rl-finish-i": "arc-rl-finish",
          "arc-rl-commit-new-i": "arc-rl-commit-new"
        }
      },
      "storage": {
        "record": "rec-rolling-change",
        "key": "release-id",
        "creates": true
      }
    },
    {"id":"preview-link-flow","name":"Preview link","subject":"gateway","initial":"pl-idle","description":"One preview link, valid for 15 ticks from the tick of its pl-issue event (the tick its link is issued).","variables":[{"name":"issuedAt","type":"number","initial":0},{"name":"shown","type":"number","initial":0}],"states":[{"id":"pl-idle","name":"Not issued"},{"id":"pl-issued","name":"Issued"}],"transitions":[{"id":"pl-link-issued","from":"pl-idle","to":"pl-issued","on":"pl-issue","effects":[{"set":"issuedAt","to":"time"}],"faultOnly":false},{"id":"pl-show-expired","from":"pl-issued","to":"pl-issued","on":"pl-presented","faultOnly":true,"description":"Defect: shows the draft after its expiry.","effects":[{"set":"shown","to":"shown + 1"},{"emit":"pl-shown"}]},{"id":"pl-show","from":"pl-issued","to":"pl-issued","on":"pl-presented","guard":"time - issuedAt < 15","effects":[{"set":"shown","to":"shown + 1"},{"emit":"pl-shown"}]},{"id":"pl-refuse","from":"pl-issued","to":"pl-issued","on":"pl-presented","effects":[{"emit":"pl-refused"}]}]},
    {
      "id": "preview-link-flow-impl",
      "name": "Preview link (implementation)",
      "subject": "gateway",
      "level": "implementation",
      "initial": "pl-idle-i",
      "description": "One preview link as the gateway checks it. The expiry is the time of issue plus the lifetime of 15 minutes (900000 ms, a default: no requirement states the lifetime), and the link is shown only before that time; at and after it every presentation is refused. The refinement reads one model tick as one minute (timeScale 60000), so the model lifetime of 15 ticks is the 15 minutes here, and the mapping gives the model its issue tick.",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "expiresAt",
          "type": "number",
          "initial": 900000,
          "repr": "timestamp"
        },
        {
          "name": "shown",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        }
      ],
      "states": [
        {
          "id": "pl-idle-i",
          "name": "No link",
          "ignores": [
            "pl-presented"
          ]
        },
        {
          "id": "pl-issued-i",
          "name": "Link issued",
          "ignores": [
            "pl-issue"
          ]
        }
      ],
      "transitions": [
        {
          "id": "pl-link-issued-i",
          "from": "pl-idle-i",
          "to": "pl-issued-i",
          "on": "pl-issue",
          "otherwise": true,
          "effects": [
            {
              "set": "expiresAt",
              "to": "time + 900000"
            }
          ]
        },
        {
          "id": "pl-show-i",
          "from": "pl-issued-i",
          "to": "pl-issued-i",
          "on": "pl-presented",
          "guard": "time < expiresAt",
          "effects": [
            {
              "set": "shown",
              "to": "shown + 1"
            },
            {
              "emit": "pl-shown",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "pl-refuse-i",
          "from": "pl-issued-i",
          "to": "pl-issued-i",
          "on": "pl-presented",
          "otherwise": true,
          "effects": [
            {
              "emit": "pl-refused",
              "to": "web-application"
            }
          ]
        }
      ],
      "refines": "preview-link-flow",
      "refinement": {
        "states": {
          "pl-idle-i": "pl-idle",
          "pl-issued-i": "pl-issued"
        },
        "variables": {
          "issuedAt": "(expiresAt - 900000) / 60000",
          "shown": "shown"
        },
        "transitions": {
          "pl-link-issued-i": "pl-link-issued",
          "pl-show-i": "pl-show",
          "pl-refuse-i": "pl-refuse"
        },
        "timeScale": 60000
      },
      "storage": {
        "record": "rec-preview-link",
        "key": "link-id",
        "creates": true
      }
    },
    {"id":"inbound-run-flow","name":"Inbound delivery","subject":"automation-worker","initial":"iw-idle","description":"One event key. The first delivery starts a run and a repeated delivery of the same event starts nothing.","variables":[{"name":"runs","type":"number","initial":0}],"states":[{"id":"iw-idle","name":"No delivery"},{"id":"iw-accepted","name":"Run started"}],"transitions":[{"id":"iw-first","from":"iw-idle","to":"iw-accepted","on":"iw-received","effects":[{"set":"runs","to":"runs + 1"},{"emit":"iw-run-started"}]},{"id":"iw-accept-again","from":"iw-accepted","to":"iw-accepted","on":"iw-received","faultOnly":true,"description":"Defect: starts a second run for a repeated delivery.","effects":[{"set":"runs","to":"runs + 1"},{"emit":"iw-run-started"}]},{"id":"iw-repeat","from":"iw-accepted","to":"iw-accepted","on":"iw-received","effects":[{"emit":"iw-ignored"}]}]},
    {
      "id": "inbound-run-flow-impl",
      "name": "Inbound delivery (implementation)",
      "subject": "automation-worker",
      "level": "implementation",
      "initial": "iw-idle-i",
      "description": "One inbound event key as the automation worker handles it, keyed in the effect record by its idempotency key (rec-effect-record). The first delivery starts a run; a repeated delivery of the same key starts nothing and is reported as ignored. The sender may deliver the same event more than once.",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "runs",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        }
      ],
      "states": [
        {
          "id": "iw-idle-i",
          "name": "Not seen"
        },
        {
          "id": "iw-accepted-i",
          "name": "Run started"
        }
      ],
      "transitions": [
        {
          "id": "iw-first-i",
          "from": "iw-idle-i",
          "to": "iw-accepted-i",
          "on": "iw-received",
          "otherwise": true,
          "effects": [
            {
              "set": "runs",
              "to": "runs + 1"
            },
            {
              "emit": "iw-run-started",
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "iw-repeat-i",
          "from": "iw-accepted-i",
          "to": "iw-accepted-i",
          "on": "iw-received",
          "otherwise": true,
          "effects": [
            {
              "emit": "iw-ignored",
              "to": "external-endpoint"
            }
          ]
        }
      ],
      "refines": "inbound-run-flow",
      "refinement": {
        "states": {
          "iw-idle-i": "iw-idle",
          "iw-accepted-i": "iw-accepted"
        },
        "variables": {
          "runs": "runs"
        },
        "transitions": {
          "iw-first-i": "iw-first",
          "iw-repeat-i": "iw-repeat"
        }
      },
      "storage": {
        "record": "rec-effect-record",
        "key": "idempotency-key",
        "state": "run-state"
      }
    },
    {"id":"cv-change-flow","name":"Confirmed change","subject":"conversation-service","initial":"cf-idle","description":"One change proposed by the assistant: previewed, then applied only after the person confirms it.","variables":[{"name":"previewed","type":"boolean","initial":false},{"name":"confirmed","type":"boolean","initial":false},{"name":"applied","type":"boolean","initial":false}],"states":[{"id":"cf-idle","name":"No change"},{"id":"cf-previewed","name":"Preview shown"},{"id":"cf-confirmed","name":"Confirmed"},{"id":"cf-applied","name":"Applied","terminal":true},{"id":"cf-cancelled","name":"Cancelled","terminal":true}],"transitions":[{"id":"cf-propose","from":"cf-idle","to":"cf-previewed","on":"cv-proposed","effects":[{"set":"previewed","to":true},{"emit":"cv-previewed"}]},{"id":"cf-confirm","from":"cf-previewed","to":"cf-confirmed","on":"cv-confirmed","effects":[{"set":"confirmed","to":true}]},{"id":"cf-apply","from":"cf-confirmed","to":"cf-applied","on":"cv-apply-requested","effects":[{"set":"applied","to":true},{"emit":"cv-applied"}]},{"id":"cf-apply-unconfirmed","from":"cf-previewed","to":"cf-applied","on":"cv-apply-requested","faultOnly":true,"description":"Defect: applies a previewed change that the person has not confirmed.","effects":[{"set":"applied","to":true},{"emit":"cv-applied"}]},{"id":"cf-refuse-unconfirmed","from":"cf-previewed","to":"cf-previewed","on":"cv-apply-requested","effects":[{"emit":"cv-refused"}]},{"id":"cf-cancel","from":"cf-previewed","to":"cf-cancelled","on":"cv-cancel","effects":[{"emit":"cv-cancelled"}]},{"id":"cf-refuse-cancelled","from":"cf-cancelled","to":"cf-cancelled","on":"cv-apply-requested","effects":[{"emit":"cv-refused"}]}]},
    {
      "id": "cv-change-flow-impl",
      "name": "Confirmed change (implementation)",
      "subject": "conversation-service",
      "level": "implementation",
      "initial": "cf-idle-i",
      "description": "One change the assistant proposes, held as a pending action (rec-cnv-pending-action, keyed by pending-id; its state follows this machine). The change is previewed to the person first; it is applied only after the person confirms it, and a request to apply an unconfirmed or cancelled change is refused.",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "previewed",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "confirmed",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "applied",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        }
      ],
      "states": [
        {
          "id": "cf-idle-i",
          "name": "No change",
          "ignores": [
            "cv-confirmed",
            "cv-apply-requested",
            "cv-cancel"
          ]
        },
        {
          "id": "cf-previewed-i",
          "name": "Previewed",
          "ignores": [
            "cv-proposed"
          ]
        },
        {
          "id": "cf-confirmed-i",
          "name": "Confirmed",
          "ignores": [
            "cv-proposed",
            "cv-confirmed",
            "cv-cancel"
          ]
        },
        {
          "id": "cf-applied-i",
          "name": "Applied",
          "terminal": true
        },
        {
          "id": "cf-cancelled-i",
          "name": "Cancelled",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "cf-propose-i",
          "from": "cf-idle-i",
          "to": "cf-previewed-i",
          "on": "cv-proposed",
          "otherwise": true,
          "effects": [
            {
              "set": "previewed",
              "to": true
            },
            {
              "emit": "cv-previewed",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "cf-confirm-i",
          "from": "cf-previewed-i",
          "to": "cf-confirmed-i",
          "on": "cv-confirmed",
          "otherwise": true,
          "effects": [
            {
              "set": "confirmed",
              "to": true
            }
          ]
        },
        {
          "id": "cf-apply-i",
          "from": "cf-confirmed-i",
          "to": "cf-applied-i",
          "on": "cv-apply-requested",
          "otherwise": true,
          "effects": [
            {
              "set": "applied",
              "to": true
            },
            {
              "emit": "cv-applied",
              "to": "runtime"
            }
          ]
        },
        {
          "id": "cf-refuse-unconfirmed-i",
          "from": "cf-previewed-i",
          "to": "cf-previewed-i",
          "on": "cv-apply-requested",
          "otherwise": true,
          "effects": [
            {
              "emit": "cv-refused",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "cf-cancel-i",
          "from": "cf-previewed-i",
          "to": "cf-cancelled-i",
          "on": "cv-cancel",
          "otherwise": true,
          "effects": [
            {
              "emit": "cv-cancelled",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "cf-refuse-cancelled-i",
          "from": "cf-cancelled-i",
          "to": "cf-cancelled-i",
          "on": "cv-apply-requested",
          "otherwise": true,
          "effects": [
            {
              "emit": "cv-refused",
              "to": "web-application"
            }
          ]
        }
      ],
      "refines": "cv-change-flow",
      "refinement": {
        "states": {
          "cf-idle-i": "cf-idle",
          "cf-previewed-i": "cf-previewed",
          "cf-confirmed-i": "cf-confirmed",
          "cf-applied-i": "cf-applied",
          "cf-cancelled-i": "cf-cancelled"
        },
        "variables": {
          "previewed": "previewed",
          "confirmed": "confirmed",
          "applied": "applied"
        },
        "transitions": {
          "cf-propose-i": "cf-propose",
          "cf-confirm-i": "cf-confirm",
          "cf-apply-i": "cf-apply",
          "cf-refuse-unconfirmed-i": "cf-refuse-unconfirmed",
          "cf-cancel-i": "cf-cancel",
          "cf-refuse-cancelled-i": "cf-refuse-cancelled"
        }
      },
      "storage": {
        "record": "rec-cnv-pending-action",
        "key": "pending-id",
        "state": "flow-state"
      }
    },
    {"id":"cv-authority-flow","name":"Operation under withdrawable permission","subject":"conversation-service","initial":"ca-waiting","description":"One operation the assistant runs for a person. It commits only while the permission the person holds at that moment allows it.","variables":[{"name":"permitted","type":"boolean","initial":true},{"name":"applied","type":"boolean","initial":false}],"states":[{"id":"ca-waiting","name":"Awaiting run"},{"id":"ca-done","name":"Committed","terminal":true}],"transitions":[{"id":"ca-withdraw","from":"ca-waiting","to":"ca-waiting","on":"cv-permission-withdrawn","effects":[{"set":"permitted","to":false}]},{"id":"ca-run","from":"ca-waiting","to":"ca-done","on":"cv-operation-run","guard":"permitted","effects":[{"set":"applied","to":true},{"emit":"cv-operation-committed"}]},{"id":"ca-run-stale","from":"ca-waiting","to":"ca-done","on":"cv-operation-run","faultOnly":true,"description":"Defect: runs the operation on the permission held when the preview was made.","effects":[{"set":"applied","to":true},{"emit":"cv-operation-committed"}]},{"id":"ca-refuse","from":"ca-waiting","to":"ca-waiting","on":"cv-operation-run","guard":"!permitted","effects":[{"emit":"cv-operation-refused"}]}]},
    {
      "id": "cv-authority-flow-impl",
      "name": "Operation under withdrawable permission (implementation)",
      "subject": "conversation-service",
      "level": "implementation",
      "initial": "ca-waiting-i",
      "description": "One operation the assistant runs for a person, as the conversation service decides it. The permission the person holds is read at the moment of commit: a withdrawal that arrives before the run refuses it, and a run that arrives after the permission is withdrawn is refused too.",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "permitted",
          "type": "boolean",
          "initial": true,
          "repr": "bool"
        },
        {
          "name": "applied",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        }
      ],
      "states": [
        {
          "id": "ca-waiting-i",
          "name": "Waiting to run"
        },
        {
          "id": "ca-done-i",
          "name": "Committed",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "ca-withdraw-i",
          "from": "ca-waiting-i",
          "to": "ca-waiting-i",
          "on": "cv-permission-withdrawn",
          "otherwise": true,
          "effects": [
            {
              "set": "permitted",
              "to": false
            }
          ]
        },
        {
          "id": "ca-run-i",
          "from": "ca-waiting-i",
          "to": "ca-done-i",
          "on": "cv-operation-run",
          "guard": "permitted",
          "effects": [
            {
              "set": "applied",
              "to": true
            },
            {
              "emit": "cv-operation-committed",
              "to": "runtime"
            }
          ]
        },
        {
          "id": "ca-refuse-i",
          "from": "ca-waiting-i",
          "to": "ca-waiting-i",
          "on": "cv-operation-run",
          "guard": "!permitted",
          "effects": [
            {
              "emit": "cv-operation-refused",
              "to": "web-application"
            }
          ]
        }
      ],
      "refines": "cv-authority-flow",
      "refinement": {
        "states": {
          "ca-waiting-i": "ca-waiting",
          "ca-done-i": "ca-done"
        },
        "variables": {
          "permitted": "permitted",
          "applied": "applied"
        },
        "transitions": {
          "ca-withdraw-i": "ca-withdraw",
          "ca-run-i": "ca-run",
          "ca-refuse-i": "ca-refuse"
        }
      },
      "storage": {
        "record": "rec-cnv-operation",
        "key": "operation-id",
        "creates": true
      }
    },
    {"id":"saml-assertion-flow","name":"SAML assertion use","subject":"identity-service","initial":"sa-fresh","description":"One SAML assertion. The first presentation yields a session, and a presentation after it is refused.","variables":[{"name":"sessions","type":"number","initial":0}],"states":[{"id":"sa-fresh","name":"Not presented"},{"id":"sa-spent","name":"Presented"}],"transitions":[{"id":"sam-accept-replay","from":"sa-spent","to":"sa-spent","on":"saml-response","faultOnly":true,"description":"Defect: accepts an assertion that was already used.","effects":[{"set":"sessions","to":"sessions + 1"},{"emit":"saml-session-issued"}]},{"id":"sam-accept","from":"sa-fresh","to":"sa-spent","on":"saml-response","effects":[{"set":"sessions","to":"sessions + 1"},{"emit":"saml-session-issued"}]},{"id":"sam-refuse","from":"sa-spent","to":"sa-spent","on":"saml-response","effects":[{"emit":"saml-refused"}]}]},
    {
      "id": "saml-assertion-flow-impl",
      "name": "SAML assertion use (implementation)",
      "subject": "identity-service",
      "level": "implementation",
      "initial": "sa-fresh-i",
      "description": "One SAML assertion as the identity service records it: the assertion identifier is stored as consumed (rec-challenge, keyed by challenge-id) when its first presentation yields a session, and any later presentation is refused. The browser or the network may deliver the response more than once.",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "sessions",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        }
      ],
      "states": [
        {
          "id": "sa-fresh-i",
          "name": "Not yet presented"
        },
        {
          "id": "sa-spent-i",
          "name": "Presented"
        }
      ],
      "transitions": [
        {
          "id": "sam-accept-i",
          "from": "sa-fresh-i",
          "to": "sa-spent-i",
          "on": "saml-response",
          "otherwise": true,
          "effects": [
            {
              "set": "sessions",
              "to": "sessions + 1"
            },
            {
              "emit": "saml-session-issued",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "sam-refuse-i",
          "from": "sa-spent-i",
          "to": "sa-spent-i",
          "on": "saml-response",
          "otherwise": true,
          "effects": [
            {
              "emit": "saml-refused",
              "to": "web-application"
            }
          ]
        }
      ],
      "refines": "saml-assertion-flow",
      "refinement": {
        "states": {
          "sa-fresh-i": "sa-fresh",
          "sa-spent-i": "sa-spent"
        },
        "variables": {
          "sessions": "sessions"
        },
        "transitions": {
          "sam-accept-i": "sam-accept",
          "sam-refuse-i": "sam-refuse"
        }
      },
      "storage": {
        "record": "rec-challenge",
        "key": "challenge-id"
      }
    },
    {
      "id": "guess-throttle-flow",
      "name": "Password guessing throttle",
      "subject": "identity-service",
      "initial": "gt-open",
      "description": "Password attempts for one realm. Three failures close the throttle, and an attempt evaluated while it is closed is counted. The three stands for the ten failures of D-700; the lockout of thirty seconds after which the account counts again from none is time, which the model does not measure.",
      "variables": [
        {
          "name": "failures",
          "type": "number",
          "initial": 0
        },
        {
          "name": "throttled",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "gt-open",
          "name": "Accepting attempts"
        }
      ],
      "transitions": [
        {
          "id": "gt-ignore-throttle",
          "from": "gt-open",
          "to": "gt-open",
          "on": "pw-attempt",
          "faultOnly": true,
          "guard": "failures >= 3",
          "description": "Defect: evaluates an attempt after the throttle has closed.",
          "effects": [
            {
              "set": "throttled",
              "to": "throttled + 1"
            },
            {
              "emit": "pw-refused"
            }
          ]
        },
        {
          "id": "gt-refuse",
          "from": "gt-open",
          "to": "gt-open",
          "on": "pw-attempt",
          "guard": "failures >= 3",
          "effects": [
            {
              "emit": "pw-refused"
            }
          ]
        },
        {
          "id": "gt-wrong",
          "from": "gt-open",
          "to": "gt-open",
          "on": "pw-attempt",
          "guard": "failures < 3 && event.guess == 'wrong'",
          "effects": [
            {
              "set": "failures",
              "to": "failures + 1"
            },
            {
              "emit": "pw-refused"
            }
          ]
        },
        {
          "id": "gt-right",
          "from": "gt-open",
          "to": "gt-open",
          "on": "pw-attempt",
          "guard": "failures < 3 && event.guess == 'right'",
          "effects": [
            {
              "emit": "pw-accepted"
            }
          ]
        }
      ]
    },
    {
      "id": "guess-throttle-flow-impl",
      "name": "Password guessing throttle (implementation)",
      "level": "implementation",
      "subject": "identity-service",
      "refines": "guess-throttle-flow",
      "description": "The counter of failed password attempts for one account, held in the limit store. Three failures close it, and a closed counter refuses every attempt without evaluating it. The three stands for the ten failures of D-700; an attempt is counted before it is evaluated, and the counter opens again after the lockout of thirty seconds, which the model does not measure.",
      "initial": "gti-open",
      "instances": {
        "key": "limit-key",
        "storedIn": "rec-limit-counter",
        "max": 16
      },
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "failures",
          "type": "number",
          "repr": "u64",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "gti-open",
          "name": "Accepting attempts"
        },
        {
          "id": "gti-closed",
          "name": "Closed"
        }
      ],
      "transitions": [
        {
          "id": "gti-wrong",
          "from": "gti-open",
          "to": "gti-open",
          "on": "pw-attempt",
          "guard": "failures < 2 && event.guess == 'wrong'",
          "effects": [
            {
              "set": "failures",
              "to": "failures + 1"
            },
            {
              "emit": "pw-refused",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "gti-wrong-last",
          "from": "gti-open",
          "to": "gti-closed",
          "on": "pw-attempt",
          "guard": "failures == 2 && event.guess == 'wrong'",
          "effects": [
            {
              "set": "failures",
              "to": "failures + 1"
            },
            {
              "emit": "pw-refused",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "gti-right",
          "from": "gti-open",
          "to": "gti-open",
          "on": "pw-attempt",
          "guard": "event.guess == 'right'",
          "effects": [
            {
              "emit": "pw-accepted",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "gti-refuse",
          "from": "gti-closed",
          "to": "gti-closed",
          "on": "pw-attempt",
          "otherwise": true,
          "effects": [
            {
              "emit": "pw-refused",
              "to": "gateway"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "gti-open": "gt-open",
          "gti-closed": "gt-open"
        },
        "variables": {
          "failures": "failures",
          "throttled": "0"
        },
        "transitions": {
          "gti-wrong": "gt-wrong",
          "gti-wrong-last": "gt-wrong",
          "gti-right": "gt-right",
          "gti-refuse": "gt-refuse"
        }
      },
      "storage": {
        "record": "rec-limit-counter",
        "key": "limit-key",
        "state": "throttle-state",
        "creates": true
      }
    },
    {"id":"trigger-chain-flow","name":"Trigger chain","subject":"automation-worker","initial":"tc-live","description":"Each change that starts a chain carries its hop count. A trigger creates a job while the hop count is within the hop limit of eight that D-700 states, and refuses the rest of the chain.","variables":[{"name":"accepted","type":"number","initial":0}],"states":[{"id":"tc-live","name":"Live"}],"transitions":[{"id":"tc-accept-unbounded","from":"tc-live","to":"tc-live","on":"tc-change","faultOnly":true,"description":"Defect: creates a job for every hop, so a loop of triggers never ends.","effects":[{"set":"accepted","to":"accepted + 1"},{"emit":"tc-job-created"},{"emit":"tc-change","after":1,"payload":{"hop":"event.hop + 1"}}]},{"id":"tc-accept","from":"tc-live","to":"tc-live","on":"tc-change","guard":"event.hop <= 8","effects":[{"set":"accepted","to":"accepted + 1"},{"emit":"tc-job-created"},{"emit":"tc-change","after":1,"payload":{"hop":"event.hop + 1"}}]},{"id":"tc-refuse-deep","from":"tc-live","to":"tc-live","on":"tc-change","guard":"event.hop > 8","effects":[{"emit":"tc-cut"}]}]},
    {
      "id": "trigger-chain-flow-impl",
      "name": "Trigger chain (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "trigger-chain-flow",
      "description": "One chain of triggers, identified by the correlation of the change that started it. The chain keeps the number of jobs it created. Every change carries its hop count, and the next change of the chain carries the count raised by one. The next change of the chain follows 100 ms after the one before (default). One model tick is 100 ms here (timeScale 100), so the model delay of one tick is the 100 ms.",
      "initial": "tci-live",
      "instances": {
        "key": "correlation",
        "storedIn": "rec-trigger-chain",
        "max": 16
      },
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "accepted",
          "type": "number",
          "repr": "u64",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "tci-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "tci-accept",
          "from": "tci-live",
          "to": "tci-live",
          "on": "tc-change",
          "guard": "event.hop <= 8",
          "effects": [
            {
              "set": "accepted",
              "to": "accepted + 1"
            },
            {
              "emit": "tc-job-created",
              "to": "automation-worker"
            },
            {
              "emit": "tc-change",
              "after": 100,
              "to": "automation-worker",
              "payload": {
                "hop": "event.hop + 1",
                "correlation": "event.correlation"
              }
            }
          ]
        },
        {
          "id": "tci-cut",
          "from": "tci-live",
          "to": "tci-live",
          "on": "tc-change",
          "otherwise": true,
          "effects": [
            {
              "emit": "tc-cut",
              "to": "automation-worker"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "tci-live": "tc-live"
        },
        "variables": {
          "accepted": "accepted"
        },
        "transitions": {
          "tci-accept": "tc-accept",
          "tci-cut": "tc-refuse-deep"
        },
        "timeScale": 100
      },
      "storage": {
        "record": "rec-trigger-chain",
        "key": "correlation",
        "creates": true
      }
    },
    {"id":"gateway-outage-flow","name":"Gateway during identity outage","subject":"gateway","initial":"go-ready","description":"The gateway's copy of a session is refreshed from the identity service once it is 5 ticks old. While a lookup is unanswered, a request that needs a session is refused with the outage named, and is not accepted.","variables":[
        {
          "name": "checkedAt",
          "type": "number",
          "initial": 0
        },
        {
          "name": "checked",
          "type": "boolean",
          "initial": false
        }
      ],"states":[{"id":"go-ready","name":"Ready"},{"id":"go-checking","name":"Waiting for the identity service"}],"transitions":[
        {
          "id": "go-accept-fresh",
          "from": "go-ready",
          "to": "go-ready",
          "on": "sr-request",
          "guard": "checked && checkedAt <= time && time - checkedAt < 5",
          "effects": [
            {
              "emit": "sr-accepted"
            }
          ]
        },
        {
          "id": "go-recheck",
          "from": "go-ready",
          "to": "go-checking",
          "on": "sr-request",
          "guard": "!(checked && checkedAt <= time && time - checkedAt < 5)",
          "effects": [
            {
              "emit": "sr-lookup"
            }
          ]
        },
        {
          "id": "go-answer",
          "from": "go-checking",
          "to": "go-ready",
          "on": "sr-lookup-answer",
          "guard": "event.valid == true",
          "effects": [
            {
              "set": "checked",
              "to": true
            },
            {
              "set": "checkedAt",
              "to": "time"
            },
            {
              "emit": "sr-accepted"
            }
          ]
        },
        {
          "id": "go-answer-revoked",
          "from": "go-checking",
          "to": "go-ready",
          "on": "sr-lookup-answer",
          "guard": "event.valid == false",
          "effects": [
            {
              "emit": "sr-refused"
            }
          ]
        },
        {
          "id": "go-accept-unanswered",
          "from": "go-checking",
          "to": "go-checking",
          "on": "sr-request",
          "faultOnly": true,
          "description": "Defect: accepts a request while the identity service has not answered.",
          "effects": [
            {
              "emit": "sr-accepted"
            }
          ]
        },
        {
          "id": "go-refuse-outage",
          "from": "go-checking",
          "to": "go-checking",
          "on": "sr-request",
          "effects": [
            {
              "emit": "sr-unavailable"
            }
          ]
        },
        {
          "id": "go-refuse-public-outage",
          "from": "go-checking",
          "to": "go-checking",
          "on": "sr-public-request",
          "effects": [
            {
              "emit": "sr-unavailable"
            }
          ],
          "faultOnly": true,
          "description": "Defect: refuses published content while the identity service has not answered."
        },
        {
          "id": "go-serve-public-ready",
          "from": "go-ready",
          "to": "go-ready",
          "on": "sr-public-request",
          "effects": [
            {
              "emit": "sr-public-served"
            }
          ]
        },
        {
          "id": "go-serve-public-checking",
          "from": "go-checking",
          "to": "go-checking",
          "on": "sr-public-request",
          "effects": [
            {
              "emit": "sr-public-served"
            }
          ]
        }
      ]},
    {
      "id": "gateway-outage-flow-impl",
      "name": "Gateway during identity outage (implementation)",
      "level": "implementation",
      "subject": "gateway",
      "refines": "gateway-outage-flow",
      "description": "The copy of one session at the gateway. It is checked at the identity service once it is 5 seconds (5000 ms, IDN-014) old. While a lookup is unanswered, a request that needs the session is refused with the outage named. The refinement reads one model tick as one second (timeScale 1000), so the model bound of 5 ticks is the 5 seconds here.",
      "initial": "gwi-ready",
      "instances": {
        "key": "session-id",
        "storedIn": "rec-session-copy",
        "max": 16
      },
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "checkedAt",
          "type": "number",
          "repr": "timestamp",
          "initial": 0
        },
        {
          "name": "checked",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        }
      ],
      "states": [
        {
          "id": "gwi-ready",
          "name": "Ready",
          "ignores": [
            "sr-lookup-answer"
          ]
        },
        {
          "id": "gwi-checking",
          "name": "Waiting for the identity service"
        }
      ],
      "transitions": [
        {
          "id": "gwi-accept-fresh",
          "from": "gwi-ready",
          "to": "gwi-ready",
          "on": "sr-request",
          "guard": "checked && checkedAt <= time && time - checkedAt < 5000",
          "effects": [
            {
              "emit": "sr-accepted",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "gwi-recheck",
          "from": "gwi-ready",
          "to": "gwi-checking",
          "on": "sr-request",
          "otherwise": true,
          "effects": [
            {
              "emit": "sr-lookup",
              "to": "identity-service"
            }
          ]
        },
        {
          "id": "gwi-answer",
          "from": "gwi-checking",
          "to": "gwi-ready",
          "on": "sr-lookup-answer",
          "guard": "event.valid == true",
          "effects": [
            {
              "set": "checked",
              "to": true
            },
            {
              "set": "checkedAt",
              "to": "time"
            },
            {
              "emit": "sr-accepted",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "gwi-answer-revoked",
          "from": "gwi-checking",
          "to": "gwi-ready",
          "on": "sr-lookup-answer",
          "guard": "event.valid == false",
          "effects": [
            {
              "emit": "sr-refused",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "gwi-refuse-outage",
          "from": "gwi-checking",
          "to": "gwi-checking",
          "on": "sr-request",
          "otherwise": true,
          "effects": [
            {
              "emit": "sr-unavailable",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "gwi-serve-public-ready",
          "from": "gwi-ready",
          "to": "gwi-ready",
          "on": "sr-public-request",
          "effects": [
            {
              "emit": "sr-public-served",
              "to": "web-application"
            }
          ],
          "otherwise": true
        },
        {
          "id": "gwi-serve-public-checking",
          "from": "gwi-checking",
          "to": "gwi-checking",
          "on": "sr-public-request",
          "effects": [
            {
              "emit": "sr-public-served",
              "to": "web-application"
            }
          ],
          "otherwise": true
        }
      ],
      "refinement": {
        "states": {
          "gwi-ready": "go-ready",
          "gwi-checking": "go-checking"
        },
        "variables": {
          "checkedAt": "checkedAt / 1000",
          "checked": "checked"
        },
        "transitions": {
          "gwi-accept-fresh": "go-accept-fresh",
          "gwi-recheck": "go-recheck",
          "gwi-answer": "go-answer",
          "gwi-answer-revoked": "go-answer-revoked",
          "gwi-refuse-outage": "go-refuse-outage",
          "gwi-serve-public-ready": "go-serve-public-ready",
          "gwi-serve-public-checking": "go-serve-public-checking"
        },
        "timeScale": 1000
      },
      "storage": {
        "record": "rec-session-copy",
        "key": "session-id",
        "fields": {
          "checkedAt": "checked-at"
        },
        "state": "outage-state",
        "createdBy": "look-up-session"
      }
    },
    {"id":"erasure-copy-flow","name":"Erased copy","subject":"copy-store","initial":"er-holding","description":"One copy of the personal data of an erased principal. A purge drops it. Once the lifetime of 5 ticks has passed after the erasure committed, a read revalidates the copy and drops it before it answers. Every answer states whether it carried the held personal data after that bound: the flag leak.","variables":[{"name":"erased","type":"boolean","initial":false},{"name":"erasedAt","type":"number","initial":0},{"name":"held","type":"boolean","initial":true},{"name":"leak","type":"boolean","initial":false}],"states":[{"id":"er-holding","name":"Copy holds the data"},{"id":"er-dropped","name":"Copy dropped"}],"transitions":[{"id":"er-commit","from":"er-holding","to":"er-holding","on":"er-erase-committed","effects":[{"set":"erased","to":true},{"set":"erasedAt","to":"time"}]},{"id":"er-purge","from":"er-holding","to":"er-dropped","on":"er-purge-sent","effects":[{"set":"held","to":false}]},{"id":"er-serve-stale","from":"er-holding","to":"er-holding","on":"er-read","faultOnly":true,"guard":"erased && time - erasedAt >= 5","effects":[{"set":"leak","to":"leak || (held && erased && time - erasedAt >= 5)"},{"emit":"er-served"}]},{"id":"er-serve-fresh","from":"er-holding","to":"er-holding","on":"er-read","guard":"!(erased && time - erasedAt >= 5)","effects":[{"set":"leak","to":"leak || (held && erased && time - erasedAt >= 5)"},{"emit":"er-served"}]},{"id":"er-revalidate","from":"er-holding","to":"er-dropped","on":"er-read","guard":"erased && time - erasedAt >= 5","effects":[{"set":"held","to":false},{"set":"leak","to":"leak || (held && erased && time - erasedAt >= 5)"},{"emit":"er-served"}]},{"id":"er-serve-dropped","from":"er-dropped","to":"er-dropped","on":"er-read","effects":[{"set":"leak","to":"leak || (held && erased && time - erasedAt >= 5)"},{"emit":"er-served"}]}]},
    {
      "id": "erasure-copy-flow-impl",
      "name": "Erased copy (implementation)",
      "level": "implementation",
      "subject": "copy-store",
      "refines": "erasure-copy-flow",
      "description": "One copy entry in the copy store. After the erasure commits, a read made once the erasure bound of 2 seconds (2000 ms, CPY-009, audience view class) has passed revalidates the copy and drops it before it answers; a purge drops it at once. The refinement reads one model tick as 400 ms (timeScale 400), so the model erasure bound of 5 ticks is the 2 seconds here.",
      "initial": "eri-holding",
      "instances": {
        "key": "copy-ref",
        "storedIn": "rec-copy-entry",
        "max": 16
      },
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "erased",
          "type": "boolean",
          "repr": "bool",
          "initial": false
        },
        {
          "name": "erasedAt",
          "type": "number",
          "repr": "timestamp",
          "initial": 0
        },
        {
          "name": "held",
          "type": "boolean",
          "repr": "bool",
          "initial": true
        }
      ],
      "states": [
        {
          "id": "eri-holding",
          "name": "Copy holds the data"
        },
        {
          "id": "eri-dropped",
          "name": "Copy dropped",
          "ignores": [
            "er-erase-committed",
            "er-purge-sent"
          ]
        }
      ],
      "transitions": [
        {
          "id": "eri-commit",
          "from": "eri-holding",
          "to": "eri-holding",
          "on": "er-erase-committed",
          "otherwise": true,
          "effects": [
            {
              "set": "erased",
              "to": true
            },
            {
              "set": "erasedAt",
              "to": "time"
            }
          ]
        },
        {
          "id": "eri-purge",
          "from": "eri-holding",
          "to": "eri-dropped",
          "on": "er-purge-sent",
          "otherwise": true,
          "effects": [
            {
              "set": "held",
              "to": false
            }
          ]
        },
        {
          "id": "eri-revalidate",
          "from": "eri-holding",
          "to": "eri-dropped",
          "on": "er-read",
          "guard": "erased && erasedAt <= time && time - erasedAt >= 2000",
          "effects": [
            {
              "set": "held",
              "to": false
            },
            {
              "emit": "er-served",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "eri-serve",
          "from": "eri-holding",
          "to": "eri-holding",
          "on": "er-read",
          "otherwise": true,
          "effects": [
            {
              "emit": "er-served",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "eri-serve-dropped",
          "from": "eri-dropped",
          "to": "eri-dropped",
          "on": "er-read",
          "otherwise": true,
          "effects": [
            {
              "emit": "er-served",
              "to": "gateway"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "eri-holding": "er-holding",
          "eri-dropped": "er-dropped"
        },
        "variables": {
          "erased": "erased",
          "erasedAt": "erasedAt / 400",
          "held": "held",
          "leak": "false"
        },
        "transitions": {
          "eri-commit": "er-commit",
          "eri-purge": "er-purge",
          "eri-revalidate": "er-revalidate",
          "eri-serve": "er-serve-fresh",
          "eri-serve-dropped": "er-serve-dropped"
        },
        "timeScale": 400
      },
      "storage": {
        "record": "rec-copy-entry",
        "key": "copy-ref",
        "fields": {
          "erasedAt": "erased-at"
        },
        "creates": true
      }
    },
    {"id":"subject-key-flow","name":"Subject key","subject":"key-service","initial":"sk-live","description":"The sealed personal fields of one subject. Destroying the subject key makes them unreadable, so a read after destruction returns only the sealed form.","variables":[{"name":"shredRequested","type":"boolean","initial":false},{"name":"plainAfterShred","type":"boolean","initial":false}],"states":[{"id":"sk-live","name":"Key held"},{"id":"sk-shredded","name":"Key destroyed","terminal":true}],"transitions":[{"id":"sk-destroy-ignored","from":"sk-live","to":"sk-live","on":"sk-shred","faultOnly":true,"description":"Defect: reports the key destroyed and keeps it.","effects":[{"set":"shredRequested","to":true},{"emit":"sk-destroyed"}]},{"id":"sk-destroy","from":"sk-live","to":"sk-shredded","on":"sk-shred","effects":[{"set":"shredRequested","to":true},{"emit":"sk-destroyed"}]},{"id":"sk-read-plain","from":"sk-live","to":"sk-live","on":"sk-read","effects":[{"set":"plainAfterShred","to":"plainAfterShred || shredRequested"},{"emit":"sk-plain"}]},{"id":"sk-read-sealed","from":"sk-shredded","to":"sk-shredded","on":"sk-read","effects":[{"emit":"sk-sealed"}]}]},
    {
      "id": "subject-key-flow-impl",
      "name": "Subject key (implementation)",
      "level": "implementation",
      "subject": "key-service",
      "refines": "subject-key-flow",
      "description": "The key of one subject, held wrapped in the key service. Destroying it overwrites the wrapped key and records the time, and a read after that returns only the sealed form.",
      "initial": "ski-live",
      "instances": {
        "key": "key-id",
        "storedIn": "rec-subject-key",
        "max": 16
      },
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "keyState",
          "type": "string",
          "repr": "string",
          "initial": "live"
        },
        {
          "name": "destroyedAt",
          "type": "number",
          "repr": "timestamp",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "ski-live",
          "name": "Key held"
        },
        {
          "id": "ski-shredded",
          "name": "Key destroyed",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "ski-destroy",
          "from": "ski-live",
          "to": "ski-shredded",
          "on": "sk-shred",
          "otherwise": true,
          "effects": [
            {
              "set": "keyState",
              "to": "'destroyed'"
            },
            {
              "set": "destroyedAt",
              "to": "time"
            },
            {
              "emit": "sk-destroyed",
              "to": "subject-rights-service"
            }
          ]
        },
        {
          "id": "ski-read-plain",
          "from": "ski-live",
          "to": "ski-live",
          "on": "sk-read",
          "otherwise": true,
          "effects": [
            {
              "emit": "sk-plain",
              "to": "runtime"
            }
          ]
        },
        {
          "id": "ski-read-sealed",
          "from": "ski-shredded",
          "to": "ski-shredded",
          "on": "sk-read",
          "otherwise": true,
          "effects": [
            {
              "emit": "sk-sealed",
              "to": "runtime"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "ski-live": "sk-live",
          "ski-shredded": "sk-shredded"
        },
        "variables": {
          "shredRequested": "keyState == 'destroyed'",
          "plainAfterShred": "false"
        },
        "transitions": {
          "ski-destroy": "sk-destroy",
          "ski-read-plain": "sk-read-plain",
          "ski-read-sealed": "sk-read-sealed"
        }
      },
      "storage": {
        "record": "rec-subject-key",
        "key": "key-id",
        "fields": {
          "keyState": "key-state",
          "destroyedAt": "destroyed-at"
        },
        "stateValues": {
          "ski-live": "live",
          "ski-shredded": "destroyed"
        }
      }
    },
    {"id":"audit-chain-flow","name":"Audit chain under erasure","subject":"audit-log","initial":"ac-open","description":"An append-only chain. Erasing a principal seals its entries, and the hash of each entry is computed over the sealed form, so the chain stays valid.","variables":[{"name":"chainOk","type":"boolean","initial":true},{"name":"sealed","type":"number","initial":0}],"states":[{"id":"ac-open","name":"Open"}],"transitions":[{"id":"ac-append","from":"ac-open","to":"ac-open","on":"au-append","effects":[{"emit":"au-appended"}]},{"id":"ac-rewrite","from":"ac-open","to":"ac-open","on":"au-erase","faultOnly":true,"description":"Defect: rewrites the entry in place, so the link of the next entry no longer matches.","effects":[{"set":"chainOk","to":false},{"emit":"au-sealed"}]},{"id":"ac-seal","from":"ac-open","to":"ac-open","on":"au-erase","effects":[{"set":"sealed","to":"sealed + 1"},{"emit":"au-sealed"}]}]},
    {
      "id": "audit-chain-flow-impl",
      "name": "Audit chain under erasure (implementation)",
      "level": "implementation",
      "subject": "audit-log",
      "refines": "audit-chain-flow",
      "description": "The audit chain of one tenant. An append takes the next sequence number and links to the hash of the previous entry. An erasure seals the entries of the principal and never rewrites one, so every link still matches.",
      "initial": "aci-open",
      "instances": {
        "key": "tenant-id",
        "storedIn": "rec-audit-chain",
        "max": 16
      },
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "headSeq",
          "type": "number",
          "repr": "u64",
          "initial": 0
        },
        {
          "name": "sealed",
          "type": "number",
          "repr": "u64",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "aci-open",
          "name": "Open"
        }
      ],
      "transitions": [
        {
          "id": "aci-append",
          "from": "aci-open",
          "to": "aci-open",
          "on": "au-append",
          "otherwise": true,
          "effects": [
            {
              "set": "headSeq",
              "to": "headSeq + 1"
            },
            {
              "emit": "au-appended",
              "to": "runtime"
            }
          ]
        },
        {
          "id": "aci-seal",
          "from": "aci-open",
          "to": "aci-open",
          "on": "au-erase",
          "otherwise": true,
          "effects": [
            {
              "set": "sealed",
              "to": "sealed + 1"
            },
            {
              "emit": "au-sealed",
              "to": "subject-rights-service"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "aci-open": "ac-open"
        },
        "variables": {
          "chainOk": "true",
          "sealed": "sealed"
        },
        "transitions": {
          "aci-append": "ac-append",
          "aci-seal": "ac-seal"
        }
      },
      "storage": {
        "record": "rec-audit-chain",
        "key": "tenant-id",
        "fields": {
          "headSeq": "head-seq"
        },
        "creates": true
      }
    },
    {"id":"agent-halt-flow","name":"Agent halt","subject":"agent-gateway","initial":"ah-running","description":"One agent: an anomaly halts it, and a halted agent applies nothing until a principal other than the agent resumes it.","variables":[],"states":[{"id":"ah-running","name":"Running"},{"id":"ah-stopped","name":"Halted"}],"transitions":[{"id":"ah-trip","from":"ah-running","to":"ah-stopped","on":"ah-anomaly","effects":[{"emit":"ah-halted"}]},{"id":"ah-apply","from":"ah-running","to":"ah-running","on":"ah-operation","effects":[{"emit":"ah-applied"}]},{"id":"ah-apply-halted","from":"ah-stopped","to":"ah-stopped","on":"ah-operation","faultOnly":true,"description":"Defect: applies an operation while the agent is halted.","effects":[{"emit":"ah-applied"}]},{"id":"ah-refuse-halted","from":"ah-stopped","to":"ah-stopped","on":"ah-operation","effects":[{"emit":"ah-refused"}]},{"id":"ah-resume-agent","from":"ah-stopped","to":"ah-running","on":"ah-resume"}]},
    {
      "id": "agent-halt-flow-impl",
      "name": "Agent halt (implementation)",
      "level": "implementation",
      "subject": "agent-gateway",
      "refines": "agent-halt-flow",
      "description": "One agent principal. The state of the principal record is active while the agent runs and suspended while it is halted; an operation of a suspended agent is refused before anything is applied.",
      "initial": "ahi-running",
      "instances": {
        "key": "principal-id",
        "storedIn": "rec-principal",
        "max": 16
      },
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [],
      "states": [
        {
          "id": "ahi-running",
          "name": "Running (principal active)",
          "ignores": [
            "ah-resume"
          ]
        },
        {
          "id": "ahi-stopped",
          "name": "Halted (principal suspended)",
          "ignores": [
            "ah-anomaly"
          ]
        }
      ],
      "transitions": [
        {
          "id": "ahi-trip",
          "from": "ahi-running",
          "to": "ahi-stopped",
          "on": "ah-anomaly",
          "otherwise": true,
          "effects": [
            {
              "emit": "ah-halted",
              "to": "notification-service"
            }
          ]
        },
        {
          "id": "ahi-apply",
          "from": "ahi-running",
          "to": "ahi-running",
          "on": "ah-operation",
          "otherwise": true,
          "effects": [
            {
              "emit": "ah-applied",
              "to": "agent"
            }
          ]
        },
        {
          "id": "ahi-refuse-halted",
          "from": "ahi-stopped",
          "to": "ahi-stopped",
          "on": "ah-operation",
          "otherwise": true,
          "effects": [
            {
              "emit": "ah-refused",
              "to": "agent"
            }
          ]
        },
        {
          "id": "ahi-resume",
          "from": "ahi-stopped",
          "to": "ahi-running",
          "on": "ah-resume",
          "otherwise": true
        }
      ],
      "refinement": {
        "states": {
          "ahi-running": "ah-running",
          "ahi-stopped": "ah-stopped"
        },
        "variables": {},
        "transitions": {
          "ahi-trip": "ah-trip",
          "ahi-apply": "ah-apply",
          "ahi-refuse-halted": "ah-refuse-halted",
          "ahi-resume": "ah-resume-agent"
        }
      },
      "storage": {
        "record": "rec-principal",
        "key": "principal-id",
        "stateValues": {
          "ahi-running": "active",
          "ahi-stopped": "suspended"
        }
      }
    },
    {"id":"approval-separation-flow","name":"Approval separation","subject":"agent-gateway","initial":"sp-idle","description":"A proposal is cleared only by an approval from a principal other than its author.","variables":[{"name":"author","type":"string","initial":""}],"states":[{"id":"sp-idle","name":"No proposal"},{"id":"sp-open","name":"Awaiting approval"},{"id":"sp-done","name":"Cleared","terminal":true}],"transitions":[{"id":"sp-open-proposal","from":"sp-idle","to":"sp-open","on":"sp-proposed","effects":[{"set":"author","to":"event.author"}]},{"id":"sp-accept-self","from":"sp-open","to":"sp-done","on":"sp-approve","guard":"event.by == author","faultOnly":true,"description":"Defect: lets the author of a proposal approve it.","effects":[{"emit":"sp-cleared"}]},{"id":"sp-approve-other","from":"sp-open","to":"sp-done","on":"sp-approve","guard":"event.by != author","effects":[{"emit":"sp-cleared"}]},{"id":"sp-refuse-self","from":"sp-open","to":"sp-open","on":"sp-approve","guard":"event.by == author","effects":[{"emit":"sp-refused"}]}]},
    {
      "id": "approval-separation-flow-impl",
      "name": "Approval separation (implementation)",
      "level": "implementation",
      "subject": "agent-gateway",
      "refines": "approval-separation-flow",
      "description": "One proposal. Opening it records its author; an approval clears it only when the approving principal is not the author. The stored proposal is awaiting approval while it is open and cleared afterwards.",
      "initial": "spi-idle",
      "instances": {
        "key": "proposal-id",
        "storedIn": "rec-proposal",
        "max": 16
      },
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "author",
          "type": "string",
          "repr": "principal-id",
          "initial": ""
        }
      ],
      "states": [
        {
          "id": "spi-idle",
          "name": "No proposal",
          "ignores": [
            "sp-approve"
          ]
        },
        {
          "id": "spi-open",
          "name": "Awaiting approval",
          "ignores": [
            "sp-proposed"
          ]
        },
        {
          "id": "spi-done",
          "name": "Cleared",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "spi-open-proposal",
          "from": "spi-idle",
          "to": "spi-open",
          "on": "sp-proposed",
          "otherwise": true,
          "effects": [
            {
              "set": "author",
              "to": "event.author"
            }
          ]
        },
        {
          "id": "spi-approve-other",
          "from": "spi-open",
          "to": "spi-done",
          "on": "sp-approve",
          "guard": "event.by != author",
          "effects": [
            {
              "emit": "sp-cleared",
              "to": "runtime"
            }
          ]
        },
        {
          "id": "spi-refuse-self",
          "from": "spi-open",
          "to": "spi-open",
          "on": "sp-approve",
          "guard": "event.by == author",
          "effects": [
            {
              "emit": "sp-refused",
              "to": "agent"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "spi-idle": "sp-idle",
          "spi-open": "sp-open",
          "spi-done": "sp-done"
        },
        "variables": {
          "author": "author"
        },
        "transitions": {
          "spi-open-proposal": "sp-open-proposal",
          "spi-approve-other": "sp-approve-other",
          "spi-refuse-self": "sp-refuse-self"
        }
      },
      "storage": {
        "record": "rec-proposal",
        "key": "proposal-id",
        "state": "approval-state"
      }
    },
    {"id":"token-render-flow","name":"Rendering a page with a reader-dependent token","subject":"runtime","initial":"tk-ready","description":"A page holds a token whose value depends on the reader. The design renders it for each reader and stores no shared copy.","variables":[{"name":"stored","type":"boolean","initial":false},{"name":"storedFor","type":"string","initial":""},{"name":"leak","type":"boolean","initial":false}],"states":[{"id":"tk-ready","name":"Ready"}],"transitions":[{"id":"tk-store-shared","from":"tk-ready","to":"tk-ready","on":"tk-request","faultOnly":true,"guard":"!stored","description":"Defect: stores the rendered page as a shared copy.","effects":[{"set":"stored","to":true},{"set":"storedFor","to":"event.reader"},{"emit":"tk-rendered"}]},{"id":"tk-serve-stored","from":"tk-ready","to":"tk-ready","on":"tk-request","guard":"stored","effects":[{"set":"leak","to":"leak || event.reader != storedFor"},{"emit":"tk-rendered"}]},{"id":"tk-render","from":"tk-ready","to":"tk-ready","on":"tk-request","effects":[{"emit":"tk-rendered"}]}]},
    {"id":"mail-dispatch-flow","name":"Mail dispatch","subject":"mail-dispatcher","initial":"md-idle","description":"One message with its idempotency key. The dispatcher submits it, and submits it again with the same key when no acknowledgement comes.","variables":[{"name":"submissions","type":"number","initial":0},{"name":"key","type":"string","initial":""}],"states":[{"id":"md-idle","name":"Idle"},{"id":"md-waiting","name":"Waiting for an acknowledgement"},{"id":"md-sent","name":"Recorded as sent"}],"transitions":[{"id":"md-submit","from":"md-idle","to":"md-waiting","on":"em-due","effects":[{"set":"submissions","to":"submissions + 1"},{"set":"key","to":"event.key"},{"emit":"em-submit","payload":{"key":"key"}}]},{"id":"md-resubmit","from":"md-waiting","to":"md-waiting","on":"em-timeout","effects":[{"set":"submissions","to":"submissions + 1"},{"emit":"em-submit","payload":{"key":"key"}}]},{"id":"md-record","from":"md-waiting","to":"md-sent","on":"em-ack","effects":[{"emit":"em-recorded"}]},{"id":"md-ignore-late-ack","from":"md-sent","to":"md-sent","on":"em-ack","effects":[]}]},
    {
      "id": "mail-dispatch-flow-impl",
      "name": "Mail dispatch (implementation)",
      "level": "implementation",
      "subject": "mail-dispatcher",
      "refines": "mail-dispatch-flow",
      "description": "One message of the mail outbox. The dispatcher submits it with its idempotency key and counts the submission; when no acknowledgement comes within 30 seconds (30000 ms, default) a timer raises em-timeout and it submits it again with the same key, and an acknowledgement records the message as sent.",
      "initial": "mdi-idle",
      "instances": {
        "key": "message-id",
        "storedIn": "rec-mail-message",
        "max": 16
      },
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "attempts",
          "type": "number",
          "repr": "u64",
          "initial": 0
        },
        {
          "name": "key",
          "type": "string",
          "repr": "string",
          "initial": ""
        }
      ],
      "states": [
        {
          "id": "mdi-idle",
          "name": "Queued",
          "ignores": [
            "em-timeout",
            "em-ack"
          ]
        },
        {
          "id": "mdi-waiting",
          "name": "Submitted, waiting for an acknowledgement",
          "ignores": [
            "em-due"
          ]
        },
        {
          "id": "mdi-sent",
          "name": "Recorded as sent",
          "ignores": [
            "em-due",
            "em-timeout"
          ]
        }
      ],
      "transitions": [
        {
          "id": "mdi-submit",
          "from": "mdi-idle",
          "to": "mdi-waiting",
          "on": "em-due",
          "otherwise": true,
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "key",
              "to": "event.key"
            },
            {
              "emit": "em-submit",
              "to": "mail-service",
              "payload": {
                "key": "key"
              }
            },
            {
              "timer": "ack-timeout",
              "after": 30000,
              "emit": "em-timeout",
              "payload": {
                "message-id": "event.message-id"
              }
            }
          ]
        },
        {
          "id": "mdi-resubmit",
          "from": "mdi-waiting",
          "to": "mdi-waiting",
          "on": "em-timeout",
          "otherwise": true,
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "emit": "em-submit",
              "to": "mail-service",
              "payload": {
                "key": "key"
              }
            },
            {
              "timer": "ack-timeout",
              "after": 30000,
              "emit": "em-timeout",
              "payload": {
                "message-id": "event.message-id"
              }
            }
          ]
        },
        {
          "id": "mdi-record",
          "from": "mdi-waiting",
          "to": "mdi-sent",
          "on": "em-ack",
          "otherwise": true,
          "effects": [
            {
              "emit": "em-recorded",
              "to": "automation-worker"
            },
            {
              "cancel": "ack-timeout"
            }
          ]
        },
        {
          "id": "mdi-ignore-late-ack",
          "from": "mdi-sent",
          "to": "mdi-sent",
          "on": "em-ack",
          "otherwise": true,
          "effects": []
        }
      ],
      "refinement": {
        "states": {
          "mdi-idle": "md-idle",
          "mdi-waiting": "md-waiting",
          "mdi-sent": "md-sent"
        },
        "variables": {
          "submissions": "attempts",
          "key": "key"
        },
        "transitions": {
          "mdi-submit": "md-submit",
          "mdi-resubmit": "md-resubmit",
          "mdi-record": "md-record",
          "mdi-ignore-late-ack": "md-ignore-late-ack"
        }
      },
      "storage": {
        "record": "rec-mail-message",
        "key": "message-id",
        "fields": {
          "key": "idempotency-key"
        },
        "stateValues": {
          "mdi-idle": "queued",
          "mdi-waiting": "submitted",
          "mdi-sent": "sent"
        }
      }
    },
    {"id":"mail-adapter-flow","name":"Mail adapter","subject":"mail-service","initial":"ma-ready","description":"The adapter of the mail contract. It keeps a table of idempotency keys with two slots, k1 and k2. It delivers a key once and acknowledges every submission of it; a submission with the other key is a different message.","variables":[{"name":"seenK1","type":"boolean","initial":false},{"name":"seenK2","type":"boolean","initial":false},{"name":"delivered","type":"number","initial":0},{"name":"deliveredK1","type":"number","initial":0},{"name":"deliveredK2","type":"number","initial":0}],"states":[{"id":"ma-ready","name":"Ready"}],"transitions":[{"id":"ma-deliver-again","from":"ma-ready","to":"ma-ready","on":"em-submit","faultOnly":true,"guard":"event.key == 'k1' && seenK1","effects":[{"set":"delivered","to":"delivered + 1"},{"set":"deliveredK1","to":"deliveredK1 + 1"},{"emit":"em-ack"}]},{"id":"ma-deliver-again-k2","from":"ma-ready","to":"ma-ready","on":"em-submit","faultOnly":true,"guard":"event.key == 'k2' && seenK2","effects":[{"set":"delivered","to":"delivered + 1"},{"set":"deliveredK2","to":"deliveredK2 + 1"},{"emit":"em-ack"}]},{"id":"ma-treat-keys-alike","from":"ma-ready","to":"ma-ready","on":"em-submit","faultOnly":true,"guard":"event.key == 'k2' && seenK1 && !seenK2","effects":[{"set":"seenK2","to":true},{"emit":"em-ack","after":2}]},{"id":"ma-deliver-k1","from":"ma-ready","to":"ma-ready","on":"em-submit","guard":"event.key == 'k1' && !seenK1","effects":[{"set":"seenK1","to":true},{"set":"delivered","to":"delivered + 1"},{"set":"deliveredK1","to":"deliveredK1 + 1"},{"emit":"em-ack","after":2}]},{"id":"ma-deliver-k2","from":"ma-ready","to":"ma-ready","on":"em-submit","guard":"event.key == 'k2' && !seenK2","effects":[{"set":"seenK2","to":true},{"set":"delivered","to":"delivered + 1"},{"set":"deliveredK2","to":"deliveredK2 + 1"},{"emit":"em-ack","after":2}]},{"id":"ma-acknowledge-repeat","from":"ma-ready","to":"ma-ready","on":"em-submit","guard":"(event.key == 'k1' && seenK1) || (event.key == 'k2' && seenK2)","effects":[{"emit":"em-ack","after":2}]}]},
    {"id":"colour-switch-flow","name":"Colour switch","subject":"traffic-switch","initial":"cs-blue","description":"One component at the traffic switch. Blue is live. A release deploys green, green is verified, and a switch makes green live. A switch back returns to blue, which is still running. A withdrawn colour serves nothing.","variables":[{"name":"verified","type":"boolean","initial":false},{"name":"withdrawn","type":"boolean","initial":false}],"states":[{"id":"cs-blue","name":"Blue serves"},{"id":"cs-verifying","name":"Green deployed and verifying"},{"id":"cs-green","name":"Green serves"}],"transitions":[{"id":"cs-switch-unverified","from":"cs-verifying","to":"cs-green","on":"cs-switch-requested","guard":"!verified","faultOnly":true,"description":"Defect: moves public traffic to green before its verification has passed.","effects":[{"emit":"cs-traffic-green"}]},{"id":"cs-serve-withdrawn","from":"cs-blue","to":"cs-blue","on":"cs-request","guard":"withdrawn","faultOnly":true,"description":"Defect: serves a request from the withdrawn green colour after a switch back.","effects":[{"emit":"cs-served-withdrawn"}]},{"id":"cs-deploy","from":"cs-blue","to":"cs-verifying","on":"cs-green-deployed","effects":[]},{"id":"cs-verify","from":"cs-verifying","to":"cs-verifying","on":"cs-green-verified","effects":[{"set":"verified","to":true}]},{"id":"cs-refuse-unverified","from":"cs-verifying","to":"cs-verifying","on":"cs-switch-requested","guard":"!verified","effects":[{"emit":"cs-switch-refused"}]},{"id":"cs-switch","from":"cs-verifying","to":"cs-green","on":"cs-switch-requested","guard":"verified","effects":[{"emit":"cs-traffic-green"}]},{"id":"cs-serve-blue","from":"cs-blue","to":"cs-blue","on":"cs-request","effects":[{"emit":"cs-served-blue"}]},{"id":"cs-serve-verifying","from":"cs-verifying","to":"cs-verifying","on":"cs-request","effects":[{"emit":"cs-served-blue"}]},{"id":"cs-serve-green","from":"cs-green","to":"cs-green","on":"cs-request","effects":[{"emit":"cs-served-green"}]},{"id":"cs-rollback","from":"cs-green","to":"cs-blue","on":"cs-rollback-requested","effects":[{"set":"withdrawn","to":true},{"emit":"cs-traffic-blue"}]}]},
    {
      "id": "colour-switch-flow-impl",
      "name": "Colour switch (implementation)",
      "level": "implementation",
      "subject": "traffic-switch",
      "refines": "colour-switch-flow",
      "description": "The routing of one environment at the traffic switch. The live colour is stored on the environment record, with whether green passed verification and whether a switch back withdrew it. Public traffic goes to the live colour only.",
      "initial": "csi-blue",
      "instances": {
        "key": "environment-id",
        "storedIn": "rec-platform-environment",
        "max": 16
      },
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "verified",
          "type": "boolean",
          "repr": "bool",
          "initial": false
        },
        {
          "name": "withdrawn",
          "type": "boolean",
          "repr": "bool",
          "initial": false
        },
        {
          "name": "liveColour",
          "type": "string",
          "repr": "colour-id",
          "initial": "blue"
        }
      ],
      "states": [
        {
          "id": "csi-blue",
          "name": "Blue serves",
          "ignores": [
            "cs-green-verified",
            "cs-switch-requested",
            "cs-rollback-requested"
          ]
        },
        {
          "id": "csi-verifying",
          "name": "Green deployed and verifying",
          "ignores": [
            "cs-green-deployed",
            "cs-rollback-requested"
          ]
        },
        {
          "id": "csi-green",
          "name": "Green serves",
          "ignores": [
            "cs-green-deployed",
            "cs-green-verified",
            "cs-switch-requested"
          ]
        }
      ],
      "transitions": [
        {
          "id": "csi-deploy",
          "from": "csi-blue",
          "to": "csi-verifying",
          "on": "cs-green-deployed",
          "otherwise": true,
          "effects": []
        },
        {
          "id": "csi-verify",
          "from": "csi-verifying",
          "to": "csi-verifying",
          "on": "cs-green-verified",
          "otherwise": true,
          "effects": [
            {
              "set": "verified",
              "to": true
            }
          ]
        },
        {
          "id": "csi-refuse-unverified",
          "from": "csi-verifying",
          "to": "csi-verifying",
          "on": "cs-switch-requested",
          "guard": "!verified",
          "effects": [
            {
              "emit": "cs-switch-refused",
              "to": "release-controller"
            }
          ]
        },
        {
          "id": "csi-switch",
          "from": "csi-verifying",
          "to": "csi-green",
          "on": "cs-switch-requested",
          "guard": "verified",
          "effects": [
            {
              "set": "liveColour",
              "to": "'green'"
            },
            {
              "emit": "cs-traffic-green",
              "to": "release-controller"
            }
          ]
        },
        {
          "id": "csi-serve-blue",
          "from": "csi-blue",
          "to": "csi-blue",
          "on": "cs-request",
          "otherwise": true,
          "effects": [
            {
              "emit": "cs-served-blue",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "csi-serve-verifying",
          "from": "csi-verifying",
          "to": "csi-verifying",
          "on": "cs-request",
          "otherwise": true,
          "effects": [
            {
              "emit": "cs-served-blue",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "csi-serve-green",
          "from": "csi-green",
          "to": "csi-green",
          "on": "cs-request",
          "otherwise": true,
          "effects": [
            {
              "emit": "cs-served-green",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "csi-rollback",
          "from": "csi-green",
          "to": "csi-blue",
          "on": "cs-rollback-requested",
          "otherwise": true,
          "effects": [
            {
              "set": "withdrawn",
              "to": true
            },
            {
              "set": "liveColour",
              "to": "'blue'"
            },
            {
              "emit": "cs-traffic-blue",
              "to": "release-controller"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "csi-blue": "cs-blue",
          "csi-verifying": "cs-verifying",
          "csi-green": "cs-green"
        },
        "variables": {
          "verified": "verified",
          "withdrawn": "withdrawn"
        },
        "transitions": {
          "csi-deploy": "cs-deploy",
          "csi-verify": "cs-verify",
          "csi-refuse-unverified": "cs-refuse-unverified",
          "csi-switch": "cs-switch",
          "csi-serve-blue": "cs-serve-blue",
          "csi-serve-verifying": "cs-serve-verifying",
          "csi-serve-green": "cs-serve-green",
          "csi-rollback": "cs-rollback"
        }
      },
      "storage": {
        "record": "rec-platform-environment",
        "key": "environment-id",
        "fields": {
          "verified": "green-verified",
          "withdrawn": "green-withdrawn",
          "liveColour": "live-colour"
        }
      }
    },
    {"id":"release-promotion-flow","name":"Release promotion","subject":"release-controller","initial":"rp-idle","description":"One release on its way to production. It is gated in stage, approved by two principals, and promoted. Production receives it only when both conditions hold.","variables":[{"name":"gated","type":"boolean","initial":false},{"name":"approvals","type":"number","initial":0},{"name":"live","type":"boolean","initial":false},{"name":"approver","type":"string","initial":""}],"states":[{"id":"rp-idle","name":"Not gated"},{"id":"rp-staged","name":"Gated in stage"},{"id":"rp-live","name":"Production live"}],"transitions":[{"id":"rp-promote-ungated","from":"rp-idle","to":"rp-live","on":"rp-promote-requested","guard":"approvals >= 2","faultOnly":true,"description":"Defect: promotes a release that has not passed its gate.","effects":[{"set":"live","to":true},{"emit":"rp-production-received"}]},{"id":"rp-promote-unapproved","from":"rp-staged","to":"rp-live","on":"rp-promote-requested","guard":"approvals < 2","faultOnly":true,"description":"Defect: promotes a release with fewer than two approvals.","effects":[{"set":"live","to":true},{"emit":"rp-production-received"}]},{"id":"rp-stage","from":"rp-idle","to":"rp-staged","on":"rp-stage-gated","effects":[{"set":"gated","to":true}]},{"id":"rp-approve-idle-first","from":"rp-idle","to":"rp-idle","on":"rp-approved","effects":[{"set":"approvals","to":"approvals + 1"},{"set":"approver","to":"event.by"}],"guard":"approvals == 0"},{"id":"rp-approve-idle-second","from":"rp-idle","to":"rp-idle","on":"rp-approved","effects":[{"set":"approvals","to":"approvals + 1"}],"guard":"approvals == 1 && event.by != approver"},{"id":"rp-approve-staged-first","from":"rp-staged","to":"rp-staged","on":"rp-approved","effects":[{"set":"approvals","to":"approvals + 1"},{"set":"approver","to":"event.by"}],"guard":"approvals == 0"},{"id":"rp-approve-staged-second","from":"rp-staged","to":"rp-staged","on":"rp-approved","effects":[{"set":"approvals","to":"approvals + 1"}],"guard":"approvals == 1 && event.by != approver"},{"id":"rp-refuse-idle","from":"rp-idle","to":"rp-idle","on":"rp-promote-requested","effects":[{"emit":"rp-promotion-refused"}]},{"id":"rp-refuse-staged","from":"rp-staged","to":"rp-staged","on":"rp-promote-requested","guard":"approvals < 2","effects":[{"emit":"rp-promotion-refused"}]},{"id":"rp-promote","from":"rp-staged","to":"rp-live","on":"rp-promote-requested","guard":"gated && approvals >= 2","effects":[{"set":"live","to":true},{"emit":"rp-production-received"}]}]},
    {
      "id": "release-promotion-flow-impl",
      "name": "Release promotion (implementation)",
      "level": "implementation",
      "subject": "release-controller",
      "refines": "release-promotion-flow",
      "description": "One release record on its way to production. Its gate result is recorded in stage, two approvals from different principals are recorded, and a promotion makes it live only when both are present.",
      "initial": "rpi-idle",
      "instances": {
        "key": "release-id",
        "storedIn": "rec-release-record",
        "max": 16
      },
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "gated",
          "type": "boolean",
          "repr": "bool",
          "initial": false
        },
        {
          "name": "approvals",
          "type": "number",
          "repr": "u32",
          "initial": 0
        },
        {
          "name": "live",
          "type": "boolean",
          "repr": "bool",
          "initial": false
        },
        {
          "name": "approver",
          "type": "string",
          "repr": "principal-id",
          "initial": ""
        }
      ],
      "states": [
        {
          "id": "rpi-idle",
          "name": "Not gated"
        },
        {
          "id": "rpi-staged",
          "name": "Gated in stage",
          "ignores": [
            "rp-stage-gated"
          ]
        },
        {
          "id": "rpi-live",
          "name": "Production live",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "rpi-stage",
          "from": "rpi-idle",
          "to": "rpi-staged",
          "on": "rp-stage-gated",
          "otherwise": true,
          "effects": [
            {
              "set": "gated",
              "to": true
            }
          ]
        },
        {
          "id": "rpi-approve-idle-first",
          "from": "rpi-idle",
          "to": "rpi-idle",
          "on": "rp-approved",
          "guard": "approvals == 0",
          "effects": [
            {
              "set": "approvals",
              "to": "approvals + 1"
            },
            {
              "set": "approver",
              "to": "event.by"
            }
          ]
        },
        {
          "id": "rpi-approve-idle-second",
          "from": "rpi-idle",
          "to": "rpi-idle",
          "on": "rp-approved",
          "guard": "approvals == 1 && event.by != approver",
          "effects": [
            {
              "set": "approvals",
              "to": "approvals + 1"
            }
          ]
        },
        {
          "id": "rpi-approve-staged-first",
          "from": "rpi-staged",
          "to": "rpi-staged",
          "on": "rp-approved",
          "guard": "approvals == 0",
          "effects": [
            {
              "set": "approvals",
              "to": "approvals + 1"
            },
            {
              "set": "approver",
              "to": "event.by"
            }
          ]
        },
        {
          "id": "rpi-approve-staged-second",
          "from": "rpi-staged",
          "to": "rpi-staged",
          "on": "rp-approved",
          "guard": "approvals == 1 && event.by != approver",
          "effects": [
            {
              "set": "approvals",
              "to": "approvals + 1"
            }
          ]
        },
        {
          "id": "rpi-refuse-idle",
          "from": "rpi-idle",
          "to": "rpi-idle",
          "on": "rp-promote-requested",
          "otherwise": true,
          "effects": [
            {
              "emit": "rp-promotion-refused",
              "to": "operator-console"
            }
          ]
        },
        {
          "id": "rpi-refuse-staged",
          "from": "rpi-staged",
          "to": "rpi-staged",
          "on": "rp-promote-requested",
          "guard": "approvals < 2",
          "effects": [
            {
              "emit": "rp-promotion-refused",
              "to": "operator-console"
            }
          ]
        },
        {
          "id": "rpi-promote",
          "from": "rpi-staged",
          "to": "rpi-live",
          "on": "rp-promote-requested",
          "guard": "gated && approvals >= 2",
          "effects": [
            {
              "set": "live",
              "to": true
            },
            {
              "emit": "rp-production-received",
              "to": "traffic-switch"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "rpi-idle": "rp-idle",
          "rpi-staged": "rp-staged",
          "rpi-live": "rp-live"
        },
        "variables": {
          "gated": "gated",
          "approvals": "approvals",
          "live": "live",
          "approver": "approver"
        },
        "transitions": {
          "rpi-stage": "rp-stage",
          "rpi-approve-idle-first": "rp-approve-idle-first",
          "rpi-approve-idle-second": "rp-approve-idle-second",
          "rpi-approve-staged-first": "rp-approve-staged-first",
          "rpi-approve-staged-second": "rp-approve-staged-second",
          "rpi-refuse-idle": "rp-refuse-idle",
          "rpi-refuse-staged": "rp-refuse-staged",
          "rpi-promote": "rp-promote"
        }
      },
      "storage": {
        "record": "rec-release-record",
        "key": "release-id",
        "fields": {
          "approvals": "approval-count"
        },
        "stateValues": {
          "rpi-idle": "candidate",
          "rpi-staged": "staged",
          "rpi-live": "live"
        }
      }
    },
    {"id":"migration-batch-flow","name":"Migration run in batches","subject":"automation-worker","initial":"mg-idle","description":"One migration run over three records. Each batch converts one record and commits the cursor with it. A run that stops resumes from its cursor.","variables":[{"name":"cursor","type":"number","initial":0},{"name":"converted","type":"number","initial":0}],"states":[{"id":"mg-idle","name":"Not started"},{"id":"mg-running","name":"Running"},{"id":"mg-stopped","name":"Stopped"},{"id":"mg-complete","name":"Complete"}],"transitions":[{"id":"mg-resume-restart","from":"mg-stopped","to":"mg-running","on":"mg-resumed","faultOnly":true,"description":"Defect: resumes from the first record, so records already converted are converted again.","effects":[{"set":"cursor","to":0}]},{"id":"mg-start","from":"mg-idle","to":"mg-running","on":"mg-started","effects":[]},{"id":"mg-batch-unsaved","from":"mg-running","to":"mg-stopped","on":"mg-batch-run","guard":"cursor == 1 && converted == 1","effects":[{"set":"converted","to":"converted + 1"}],"faultOnly":true},{"id":"mg-batch","from":"mg-running","to":"mg-running","on":"mg-batch-run","guard":"cursor < 3","effects":[{"set":"cursor","to":"cursor + 1"},{"set":"converted","to":"converted + 1"}]},{"id":"mg-finish","from":"mg-running","to":"mg-complete","on":"mg-batch-run","guard":"cursor >= 3","effects":[{"emit":"mg-done"}]},{"id":"mg-interrupt","from":"mg-running","to":"mg-stopped","on":"mg-interrupted","effects":[]},{"id":"mg-resume","from":"mg-stopped","to":"mg-running","on":"mg-resumed","effects":[]}]},
    {
      "id": "migration-batch-flow-impl",
      "name": "Migration run in batches (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "migration-batch-flow",
      "description": "One migration run over three records. A batch converts one record and moves the cursor in the same transaction, so the stored cursor is always the number of records converted. A run that stops resumes from its stored cursor.",
      "initial": "mgi-idle",
      "instances": {
        "key": "run-id",
        "storedIn": "rec-migration-run",
        "max": 16
      },
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "cursor",
          "type": "number",
          "repr": "u64",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "mgi-idle",
          "name": "Not started",
          "ignores": [
            "mg-batch-run",
            "mg-interrupted",
            "mg-resumed"
          ]
        },
        {
          "id": "mgi-running",
          "name": "Running",
          "ignores": [
            "mg-started",
            "mg-resumed"
          ]
        },
        {
          "id": "mgi-stopped",
          "name": "Stopped",
          "ignores": [
            "mg-started",
            "mg-batch-run",
            "mg-interrupted"
          ]
        },
        {
          "id": "mgi-complete",
          "name": "Complete",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "mgi-start",
          "from": "mgi-idle",
          "to": "mgi-running",
          "on": "mg-started",
          "otherwise": true,
          "effects": []
        },
        {
          "id": "mgi-batch",
          "from": "mgi-running",
          "to": "mgi-running",
          "on": "mg-batch-run",
          "guard": "cursor < 3",
          "effects": [
            {
              "set": "cursor",
              "to": "cursor + 1"
            }
          ]
        },
        {
          "id": "mgi-finish",
          "from": "mgi-running",
          "to": "mgi-complete",
          "on": "mg-batch-run",
          "guard": "cursor >= 3",
          "effects": [
            {
              "emit": "mg-done",
              "to": "control-plane"
            }
          ]
        },
        {
          "id": "mgi-interrupt",
          "from": "mgi-running",
          "to": "mgi-stopped",
          "on": "mg-interrupted",
          "otherwise": true,
          "effects": []
        },
        {
          "id": "mgi-resume",
          "from": "mgi-stopped",
          "to": "mgi-running",
          "on": "mg-resumed",
          "otherwise": true,
          "effects": []
        }
      ],
      "refinement": {
        "states": {
          "mgi-idle": "mg-idle",
          "mgi-running": "mg-running",
          "mgi-stopped": "mg-stopped",
          "mgi-complete": "mg-complete"
        },
        "variables": {
          "cursor": "cursor",
          "converted": "cursor"
        },
        "transitions": {
          "mgi-start": "mg-start",
          "mgi-batch": "mg-batch",
          "mgi-finish": "mg-finish",
          "mgi-interrupt": "mg-interrupt",
          "mgi-resume": "mg-resume"
        }
      },
      "storage": {
        "record": "rec-migration-run",
        "key": "run-id",
        "stateValues": {
          "mgi-idle": "not-started",
          "mgi-running": "running",
          "mgi-stopped": "stopped",
          "mgi-complete": "complete"
        }
      }
    },
    {"id":"tenant-move-flow","name":"Tenant move","subject":"control-plane","initial":"tm-source","description":"One tenant moving between placements. The source serves while the copy runs, and a writer may write while it does. The source is frozen, the writes the copy missed are applied to the target (the final synchronisation), and the two state hashes are compared. A hash is modelled as the number of writes a side holds. The directory switches only when the comparison finds them equal.","variables":[{"name":"frozen","type":"boolean","initial":false},{"name":"sourceVersion","type":"number","initial":0},{"name":"targetVersion","type":"number","initial":0},{"name":"matched","type":"boolean","initial":false},{"name":"switched","type":"boolean","initial":false}],"states":[{"id":"tm-source","name":"Source serves"},{"id":"tm-copying","name":"Copying"},{"id":"tm-frozen","name":"Source frozen"},{"id":"tm-verified","name":"Hashes equal"},{"id":"tm-target","name":"Target serves"}],"transitions":[{"id":"tm-write-while-frozen","from":"tm-frozen","to":"tm-frozen","on":"tm-write-requested","faultOnly":true,"effects":[{"set":"sourceVersion","to":"sourceVersion + 1"},{"emit":"tm-write-accepted"}]},{"id":"tm-switch-unverified","from":"tm-frozen","to":"tm-target","on":"tm-switch-requested","faultOnly":true,"effects":[{"set":"switched","to":true},{"emit":"tm-directory-switched"}]},{"id":"tm-switch-on-failure","from":"tm-copying","to":"tm-target","on":"tm-copy-failed","faultOnly":true,"effects":[{"set":"switched","to":true},{"emit":"tm-directory-switched"}]},{"id":"tm-begin","from":"tm-source","to":"tm-copying","on":"tm-move-requested","effects":[{"set":"targetVersion","to":"sourceVersion"}]},{"id":"tm-write-source","from":"tm-source","to":"tm-source","on":"tm-write-requested","effects":[{"set":"sourceVersion","to":"sourceVersion + 1"},{"emit":"tm-write-accepted"}]},{"id":"tm-write-copying","from":"tm-copying","to":"tm-copying","on":"tm-write-requested","effects":[{"set":"sourceVersion","to":"sourceVersion + 1"},{"emit":"tm-write-accepted"}]},{"id":"tm-write-frozen","from":"tm-frozen","to":"tm-frozen","on":"tm-write-requested","effects":[{"emit":"tm-write-refused"}]},{"id":"tm-write-verified","from":"tm-verified","to":"tm-verified","on":"tm-write-requested","effects":[{"emit":"tm-write-refused"}]},{"id":"tm-freeze","from":"tm-copying","to":"tm-frozen","on":"tm-freeze-requested","effects":[{"set":"frozen","to":true}]},{"id":"tm-reconcile","from":"tm-frozen","to":"tm-frozen","on":"tm-reconcile-requested","effects":[{"set":"targetVersion","to":"sourceVersion"}]},{"id":"tm-hash-match","from":"tm-frozen","to":"tm-verified","on":"tm-hash-checked","guard":"sourceVersion == targetVersion","effects":[{"set":"matched","to":true}]},{"id":"tm-hash-mismatch","from":"tm-frozen","to":"tm-source","on":"tm-hash-checked","guard":"sourceVersion != targetVersion","effects":[{"set":"frozen","to":false},{"emit":"tm-move-failed"}]},{"id":"tm-abandon-copy","from":"tm-copying","to":"tm-source","on":"tm-copy-failed","effects":[{"emit":"tm-move-failed"}]},{"id":"tm-switch","from":"tm-verified","to":"tm-target","on":"tm-switch-requested","guard":"matched","effects":[{"set":"switched","to":true},{"emit":"tm-directory-switched"}]}]},
    {
      "id": "tenant-move-flow-impl",
      "name": "Tenant move (implementation)",
      "level": "implementation",
      "subject": "control-plane",
      "refines": "tenant-move-flow",
      "description": "One move of a tenant to another placement. The move record holds its stage, and the two state hashes are modelled as the number of writes each side holds. The source serves while the copy runs, is frozen for the final synchronisation, and the directory switches only when the hashes are equal.",
      "initial": "tmi-source",
      "instances": {
        "key": "move-id",
        "storedIn": "rec-tenant-move",
        "max": 16
      },
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "frozen",
          "type": "boolean",
          "repr": "bool",
          "initial": false
        },
        {
          "name": "sourceVersion",
          "type": "number",
          "repr": "u64",
          "initial": 0
        },
        {
          "name": "targetVersion",
          "type": "number",
          "repr": "u64",
          "initial": 0
        },
        {
          "name": "matched",
          "type": "boolean",
          "repr": "bool",
          "initial": false
        },
        {
          "name": "switched",
          "type": "boolean",
          "repr": "bool",
          "initial": false
        }
      ],
      "states": [
        {
          "id": "tmi-source",
          "name": "Source serves",
          "ignores": [
            "tm-freeze-requested",
            "tm-hash-checked",
            "tm-switch-requested",
            "tm-copy-failed",
            "tm-reconcile-requested"
          ]
        },
        {
          "id": "tmi-copying",
          "name": "Copying",
          "ignores": [
            "tm-move-requested",
            "tm-hash-checked",
            "tm-switch-requested",
            "tm-reconcile-requested"
          ]
        },
        {
          "id": "tmi-frozen",
          "name": "Source frozen",
          "ignores": [
            "tm-move-requested",
            "tm-freeze-requested",
            "tm-switch-requested",
            "tm-copy-failed"
          ]
        },
        {
          "id": "tmi-verified",
          "name": "Hashes equal",
          "ignores": [
            "tm-move-requested",
            "tm-freeze-requested",
            "tm-hash-checked",
            "tm-copy-failed",
            "tm-reconcile-requested"
          ]
        },
        {
          "id": "tmi-target",
          "name": "Target serves",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "tmi-begin",
          "from": "tmi-source",
          "to": "tmi-copying",
          "on": "tm-move-requested",
          "otherwise": true,
          "effects": [
            {
              "set": "targetVersion",
              "to": "sourceVersion"
            }
          ]
        },
        {
          "id": "tmi-write-source",
          "from": "tmi-source",
          "to": "tmi-source",
          "on": "tm-write-requested",
          "otherwise": true,
          "effects": [
            {
              "set": "sourceVersion",
              "to": "sourceVersion + 1"
            },
            {
              "emit": "tm-write-accepted",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "tmi-write-copying",
          "from": "tmi-copying",
          "to": "tmi-copying",
          "on": "tm-write-requested",
          "otherwise": true,
          "effects": [
            {
              "set": "sourceVersion",
              "to": "sourceVersion + 1"
            },
            {
              "emit": "tm-write-accepted",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "tmi-freeze",
          "from": "tmi-copying",
          "to": "tmi-frozen",
          "on": "tm-freeze-requested",
          "otherwise": true,
          "effects": [
            {
              "set": "frozen",
              "to": true
            }
          ]
        },
        {
          "id": "tmi-abandon-copy",
          "from": "tmi-copying",
          "to": "tmi-source",
          "on": "tm-copy-failed",
          "otherwise": true,
          "effects": [
            {
              "emit": "tm-move-failed",
              "to": "operator-console"
            }
          ]
        },
        {
          "id": "tmi-write-frozen",
          "from": "tmi-frozen",
          "to": "tmi-frozen",
          "on": "tm-write-requested",
          "otherwise": true,
          "effects": [
            {
              "emit": "tm-write-refused",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "tmi-reconcile",
          "from": "tmi-frozen",
          "to": "tmi-frozen",
          "on": "tm-reconcile-requested",
          "otherwise": true,
          "effects": [
            {
              "set": "targetVersion",
              "to": "sourceVersion"
            }
          ]
        },
        {
          "id": "tmi-hash-match",
          "from": "tmi-frozen",
          "to": "tmi-verified",
          "on": "tm-hash-checked",
          "guard": "sourceVersion == targetVersion",
          "effects": [
            {
              "set": "matched",
              "to": true
            }
          ]
        },
        {
          "id": "tmi-hash-mismatch",
          "from": "tmi-frozen",
          "to": "tmi-source",
          "on": "tm-hash-checked",
          "guard": "sourceVersion != targetVersion",
          "effects": [
            {
              "set": "frozen",
              "to": false
            },
            {
              "emit": "tm-move-failed",
              "to": "operator-console"
            }
          ]
        },
        {
          "id": "tmi-write-verified",
          "from": "tmi-verified",
          "to": "tmi-verified",
          "on": "tm-write-requested",
          "otherwise": true,
          "effects": [
            {
              "emit": "tm-write-refused",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "tmi-switch",
          "from": "tmi-verified",
          "to": "tmi-target",
          "on": "tm-switch-requested",
          "guard": "matched",
          "effects": [
            {
              "set": "switched",
              "to": true
            },
            {
              "emit": "tm-directory-switched",
              "to": "gateway"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "tmi-source": "tm-source",
          "tmi-copying": "tm-copying",
          "tmi-frozen": "tm-frozen",
          "tmi-verified": "tm-verified",
          "tmi-target": "tm-target"
        },
        "variables": {
          "frozen": "frozen",
          "sourceVersion": "sourceVersion",
          "targetVersion": "targetVersion",
          "matched": "matched",
          "switched": "switched"
        },
        "transitions": {
          "tmi-begin": "tm-begin",
          "tmi-write-source": "tm-write-source",
          "tmi-write-copying": "tm-write-copying",
          "tmi-freeze": "tm-freeze",
          "tmi-abandon-copy": "tm-abandon-copy",
          "tmi-write-frozen": "tm-write-frozen",
          "tmi-reconcile": "tm-reconcile",
          "tmi-hash-match": "tm-hash-match",
          "tmi-hash-mismatch": "tm-hash-mismatch",
          "tmi-write-verified": "tm-write-verified",
          "tmi-switch": "tm-switch"
        }
      },
      "storage": {
        "record": "rec-tenant-move",
        "key": "move-id",
        "fields": {
          "sourceVersion": "source-version",
          "targetVersion": "target-version"
        },
        "stateValues": {
          "tmi-source": "source-serves",
          "tmi-copying": "copying",
          "tmi-frozen": "frozen",
          "tmi-verified": "verified",
          "tmi-target": "target-serves"
        }
      }
    },
    {"id":"commit-flow","name":"Commit and publication","subject":"runtime","initial":"rc-idle","description":"An accepted intent is committed, and only then is its event published.","variables":[{"name":"committed","type":"boolean","initial":false},{"name":"published","type":"boolean","initial":false}],"states":[{"id":"rc-idle","name":"Idle"},{"id":"rc-deciding","name":"Deciding"},{"id":"rc-committing","name":"Committing"},{"id":"rc-done","name":"Published","terminal":true}],"transitions":[{"id":"rc-decide","from":"rc-idle","to":"rc-deciding","on":"rt-intent","effects":[{"emit":"rt-decided"}]},{"id":"rc-publish-early","from":"rc-deciding","to":"rc-committing","on":"rt-decided","faultOnly":true,"description":"Defect: publishes the event before the commit is confirmed.","effects":[{"set":"published","to":true},{"emit":"rt-published"},{"emit":"rt-committed","after":1}]},{"id":"rc-commit","from":"rc-deciding","to":"rc-committing","on":"rt-decided","effects":[{"emit":"rt-committed","after":1}]},{"id":"rc-publish","from":"rc-committing","to":"rc-done","on":"rt-committed","effects":[{"set":"committed","to":true},{"set":"published","to":true},{"emit":"rt-published"}]}]},
    {"id":"source-throttle-flow","name":"Per-source sign-in throttle","subject":"identity-service","initial":"st-open","description":"Password attempts from two sources, a and b, across many accounts. Once the failures from one source reach the threshold of 3, an attempt from that source is refused whatever its account. The threshold of 3 stands for the 100 failures of D-700, and the window of fifteen minutes is not modelled.","variables":[{"name":"failuresA","type":"number","initial":0},{"name":"failuresB","type":"number","initial":0},{"name":"evaluatedWhileThrottled","type":"number","initial":0}],"states":[{"id":"st-open","name":"Open"}],"transitions":[{"id":"st-evaluate-throttled","from":"st-open","to":"st-open","on":"src-attempt","faultOnly":true,"guard":"(event.source == 'a' && failuresA >= 3) || (event.source == 'b' && failuresB >= 3)","effects":[{"set":"evaluatedWhileThrottled","to":"evaluatedWhileThrottled + 1"},{"emit":"src-accepted"}]},{"id":"st-refuse-throttled","from":"st-open","to":"st-open","on":"src-attempt","guard":"(event.source == 'a' && failuresA >= 3) || (event.source == 'b' && failuresB >= 3)","effects":[{"emit":"src-refused"}]},{"id":"st-fail-a","from":"st-open","to":"st-open","on":"src-attempt","guard":"event.source == 'a' && event.guess == 'wrong'","effects":[{"set":"failuresA","to":"failuresA + 1"},{"emit":"src-refused"}]},{"id":"st-fail-b","from":"st-open","to":"st-open","on":"src-attempt","guard":"event.source == 'b' && event.guess == 'wrong'","effects":[{"set":"failuresB","to":"failuresB + 1"},{"emit":"src-refused"}]},{"id":"st-accept","from":"st-open","to":"st-open","on":"src-attempt","guard":"event.guess == 'right'","effects":[{"emit":"src-accepted"}]}]},
    {
      "id": "source-throttle-flow-impl",
      "name": "Per-source sign-in throttle (implementation)",
      "level": "implementation",
      "subject": "identity-service",
      "refines": "source-throttle-flow",
      "description": "The per-source failure counters of the sign-in throttle, for the two sources a and b. Once the failures of a source reach the threshold of 3, every attempt from it is refused without being evaluated, whatever its account. The counters are rows of the limit counter record; the model puts both sources in one machine, so this one is a single unit and has no keyed instances.",
      "initial": "sti-open",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "failuresA",
          "type": "number",
          "repr": "u64",
          "initial": 0
        },
        {
          "name": "failuresB",
          "type": "number",
          "repr": "u64",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "sti-open",
          "name": "Open"
        }
      ],
      "transitions": [
        {
          "id": "sti-refuse-throttled",
          "from": "sti-open",
          "to": "sti-open",
          "on": "src-attempt",
          "guard": "(event.source == 'a' && failuresA >= 3) || (event.source == 'b' && failuresB >= 3)",
          "effects": [
            {
              "emit": "src-refused",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "sti-fail-a",
          "from": "sti-open",
          "to": "sti-open",
          "on": "src-attempt",
          "guard": "event.source == 'a' && event.guess == 'wrong'",
          "effects": [
            {
              "set": "failuresA",
              "to": "failuresA + 1"
            },
            {
              "emit": "src-refused",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "sti-fail-b",
          "from": "sti-open",
          "to": "sti-open",
          "on": "src-attempt",
          "guard": "event.source == 'b' && event.guess == 'wrong'",
          "effects": [
            {
              "set": "failuresB",
              "to": "failuresB + 1"
            },
            {
              "emit": "src-refused",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "sti-accept",
          "from": "sti-open",
          "to": "sti-open",
          "on": "src-attempt",
          "guard": "event.guess == 'right'",
          "effects": [
            {
              "emit": "src-accepted",
              "to": "gateway"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "sti-open": "st-open"
        },
        "variables": {
          "failuresA": "failuresA",
          "failuresB": "failuresB",
          "evaluatedWhileThrottled": "0"
        },
        "transitions": {
          "sti-refuse-throttled": "st-refuse-throttled",
          "sti-fail-a": "st-fail-a",
          "sti-fail-b": "st-fail-b",
          "sti-accept": "st-accept"
        }
      },
      "storage": {
        "record": "rec-limit-counter",
        "key": "limit-key",
        "fields": {
          "failuresA": "failures-a",
          "failuresB": "failures-b"
        }
      }
    },
    {"id":"client-session-flow","name":"Client session","subject":"web-application","initial":"cs-unknown","description":"The session the web application believes it holds. It is unknown until the first read; signing in and out move it; a session frame that says the session ended clears the request token at once and asks for the session again.","variables":[{"name":"holdsToken","type":"number","initial":0},{"name":"warnings","type":"number","initial":0}],"states":[{"id":"cs-unknown","name":"Not read yet"},{"id":"cs-out","name":"Signed out"},{"id":"cs-in","name":"Signed in"},{"id":"cs-ended","name":"Ended, read pending"}],"transitions":[{"id":"cs-read-in","from":"cs-unknown","to":"cs-in","on":"ui-session-read","guard":"event.authenticated == 1","effects":[{"set":"holdsToken","to":"1"}]},{"id":"cs-read-out","from":"cs-unknown","to":"cs-out","on":"ui-session-read","effects":[{"set":"holdsToken","to":"0"}]},{"id":"cs-sign-in","from":"cs-out","to":"cs-in","on":"ui-signed-in","effects":[{"set":"holdsToken","to":"1"}]},{"id":"cs-sign-out","from":"cs-in","to":"cs-out","on":"ui-signed-out","effects":[{"set":"holdsToken","to":"0"}]},{"id":"cs-end","from":"cs-in","to":"cs-ended","on":"ui-session-ended","effects":[{"set":"holdsToken","to":"0"},{"set":"warnings","to":"warnings + 1"},{"emit":"ui-session-requested"}]},{"id":"cs-confirm-end","from":"cs-ended","to":"cs-out","on":"ui-session-read","guard":"event.authenticated == 0"},{"id":"cs-resign","from":"cs-ended","to":"cs-in","on":"ui-signed-in","effects":[{"set":"holdsToken","to":"1"}]}]},
    {
      "id": "client-session-flow-impl",
      "name": "Client session (implementation)",
      "subject": "web-application",
      "level": "implementation",
      "initial": "cs-unknown-i",
      "description": "The session in the kernel state of the web application (state.session, with its csrf_token). A session frame that says the session ended sets authenticated to false and drops the token in the same transition, then reads the session and the page again. The state is kept in memory for the life of the tab.",
      "variables": [
        {
          "name": "holdsToken",
          "type": "number",
          "initial": 0,
          "repr": "u8"
        },
        {
          "name": "warnings",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        }
      ],
      "states": [
        {
          "id": "cs-unknown-i",
          "name": "Not read yet",
          "ignores": [
            "ui-signed-in",
            "ui-signed-out",
            "ui-session-ended"
          ]
        },
        {
          "id": "cs-out-i",
          "name": "Signed out",
          "ignores": [
            "ui-session-read",
            "ui-signed-out",
            "ui-session-ended"
          ]
        },
        {
          "id": "cs-in-i",
          "name": "Signed in",
          "ignores": [
            "ui-session-read",
            "ui-signed-in"
          ]
        },
        {
          "id": "cs-ended-i",
          "name": "Ended, read pending",
          "ignores": [
            "ui-signed-out",
            "ui-session-ended"
          ]
        }
      ],
      "transitions": [
        {
          "id": "cs-read-in-i",
          "from": "cs-unknown-i",
          "to": "cs-in-i",
          "on": "ui-session-read",
          "guard": "event.authenticated == 1",
          "effects": [
            {
              "set": "holdsToken",
              "to": "1"
            }
          ]
        },
        {
          "id": "cs-read-out-i",
          "from": "cs-unknown-i",
          "to": "cs-out-i",
          "on": "ui-session-read",
          "otherwise": true,
          "effects": [
            {
              "set": "holdsToken",
              "to": "0"
            }
          ]
        },
        {
          "id": "cs-sign-in-i",
          "from": "cs-out-i",
          "to": "cs-in-i",
          "on": "ui-signed-in",
          "otherwise": true,
          "effects": [
            {
              "set": "holdsToken",
              "to": "1"
            }
          ]
        },
        {
          "id": "cs-sign-out-i",
          "from": "cs-in-i",
          "to": "cs-out-i",
          "on": "ui-signed-out",
          "otherwise": true,
          "effects": [
            {
              "set": "holdsToken",
              "to": "0"
            }
          ]
        },
        {
          "id": "cs-end-i",
          "from": "cs-in-i",
          "to": "cs-ended-i",
          "on": "ui-session-ended",
          "otherwise": true,
          "effects": [
            {
              "set": "holdsToken",
              "to": "0"
            },
            {
              "set": "warnings",
              "to": "warnings + 1"
            },
            {
              "emit": "ui-session-requested",
              "to": "read-session-view"
            }
          ]
        },
        {
          "id": "cs-confirm-end-i",
          "from": "cs-ended-i",
          "to": "cs-out-i",
          "on": "ui-session-read",
          "guard": "event.authenticated == 0"
        },
        {
          "id": "cs-resign-i",
          "from": "cs-ended-i",
          "to": "cs-in-i",
          "on": "ui-signed-in",
          "otherwise": true,
          "effects": [
            {
              "set": "holdsToken",
              "to": "1"
            }
          ]
        }
      ],
      "refines": "client-session-flow",
      "refinement": {
        "states": {
          "cs-unknown-i": "cs-unknown",
          "cs-out-i": "cs-out",
          "cs-in-i": "cs-in",
          "cs-ended-i": "cs-ended"
        },
        "variables": {
          "holdsToken": "holdsToken",
          "warnings": "warnings"
        },
        "transitions": {
          "cs-read-in-i": "cs-read-in",
          "cs-read-out-i": "cs-read-out",
          "cs-sign-in-i": "cs-sign-in",
          "cs-sign-out-i": "cs-sign-out",
          "cs-end-i": "cs-end",
          "cs-confirm-end-i": "cs-confirm-end",
          "cs-resign-i": "cs-resign"
        }
      },
      "storage": {
        "durability": "memory"
      }
    },
    {"id":"client-live-flow","name":"Live connection","subject":"web-application","initial":"lv-idle","description":"The WebSocket of the web application. It opens, subscribes after the last sequence it saw (nothing on the first connection), acknowledges each event frame by its number and starts over when a number is missing, pings on the heartbeat and closes after two pings without an answer; a closed socket waits and reconnects, and the next welcome resumes from the last sequence.","variables":[{"name":"attempts","type":"number","initial":0},{"name":"lastSeq","type":"number","initial":0},{"name":"lastN","type":"number","initial":0},{"name":"missedPongs","type":"number","initial":0}],"states":[{"id":"lv-idle","name":"Not started"},{"id":"lv-connecting","name":"Connecting"},{"id":"lv-open","name":"Open"},{"id":"lv-waiting","name":"Waiting to reconnect"}],"transitions":[{"id":"lv-start","from":"lv-idle","to":"lv-connecting","on":"ui-live-start"},{"id":"lv-first-welcome","from":"lv-connecting","to":"lv-open","on":"ui-live-welcome","guard":"lastSeq == 0","effects":[{"set":"attempts","to":"0"},{"set":"lastN","to":"0"},{"set":"missedPongs","to":"0"},{"emit":"ui-live-subscribe","payload":{"after":"lastSeq"}},{"set":"lastSeq","to":"event.head"}]},{"id":"lv-resume-welcome","from":"lv-connecting","to":"lv-open","on":"ui-live-welcome","effects":[{"set":"attempts","to":"0"},{"set":"lastN","to":"0"},{"set":"missedPongs","to":"0"},{"emit":"ui-live-subscribe","payload":{"after":"lastSeq"}}]},{"id":"lv-frame-advance","from":"lv-open","to":"lv-open","on":"ui-live-frame","guard":"event.n == lastN + 1 && event.seq > lastSeq","effects":[{"set":"lastN","to":"event.n"},{"set":"lastSeq","to":"event.seq"},{"emit":"ui-live-ack","payload":{"n":"event.n"}}]},{"id":"lv-frame-same","from":"lv-open","to":"lv-open","on":"ui-live-frame","guard":"event.n == lastN + 1","effects":[{"set":"lastN","to":"event.n"},{"emit":"ui-live-ack","payload":{"n":"event.n"}}]},{"id":"lv-frame-gap","from":"lv-open","to":"lv-open","on":"ui-live-frame","effects":[{"set":"lastSeq","to":"0"},{"emit":"ui-live-close-requested"}]},{"id":"lv-pong-advance","from":"lv-open","to":"lv-open","on":"ui-live-pong","guard":"event.head > lastSeq","effects":[{"set":"missedPongs","to":"0"},{"set":"lastSeq","to":"event.head"}]},{"id":"lv-pong-same","from":"lv-open","to":"lv-open","on":"ui-live-pong","effects":[{"set":"missedPongs","to":"0"}]},{"id":"lv-give-up","from":"lv-open","to":"lv-open","on":"ui-live-heartbeat-due","guard":"missedPongs >= 2","effects":[{"emit":"ui-live-close-requested"}]},{"id":"lv-ping","from":"lv-open","to":"lv-open","on":"ui-live-heartbeat-due","effects":[{"set":"missedPongs","to":"missedPongs + 1"},{"emit":"ui-live-ping"}]},{"id":"lv-closed-connecting","from":"lv-connecting","to":"lv-waiting","on":"ui-live-closed","effects":[{"set":"attempts","to":"attempts + 1"}]},{"id":"lv-closed-open","from":"lv-open","to":"lv-waiting","on":"ui-live-closed","effects":[{"set":"attempts","to":"attempts + 1"}]},{"id":"lv-reconnect","from":"lv-waiting","to":"lv-connecting","on":"ui-live-reconnect-due"},{"id":"lv-reset-connecting","from":"lv-connecting","to":"lv-connecting","on":"ui-live-reset","effects":[{"set":"lastSeq","to":"0"},{"emit":"ui-live-close-requested"}]},{"id":"lv-reset-open","from":"lv-open","to":"lv-open","on":"ui-live-reset","effects":[{"set":"lastSeq","to":"0"},{"emit":"ui-live-close-requested"}]},{"id":"lv-reset-waiting","from":"lv-waiting","to":"lv-waiting","on":"ui-live-reset","effects":[{"set":"lastSeq","to":"0"}]},
      {
        "id": "lv-resync",
        "from": "lv-open",
        "to": "lv-open",
        "on": "ui-live-resync",
        "effects": [
          {
            "set": "lastSeq",
            "to": "event.head"
          }
        ]
      }]},
    {
      "id": "client-live-flow-impl",
      "name": "Live connection (implementation)",
      "subject": "web-application",
      "level": "implementation",
      "initial": "lv-idle-i",
      "description": "The ws state of the kernel (status, attempts, lastSeq, lastN, missedPongs). A heartbeat timer whose interval the welcome frame announces (heartbeatMs; 10 seconds until the first welcome) pings and gives up after two pings without a pong. A closed socket waits 0.5, 1, 2, 4 seconds and then 8 seconds, the cap of the back-off (a reconnect after the fifth failure waits 8 seconds; the wait is exact, with no random jitter in the specification or in the browser). The state is kept in memory for the life of the tab.",
      "variables": [
        {
          "name": "attempts",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "lastSeq",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "lastN",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "missedPongs",
          "type": "number",
          "initial": 0,
          "repr": "u8"
        },
        {
          "name": "heartbeatMs",
          "type": "number",
          "initial": 10000,
          "repr": "u32"
        }
      ],
      "states": [
        {
          "id": "lv-idle-i",
          "name": "Not started",
          "ignores": [
            "ui-live-welcome",
            "ui-live-frame",
            "ui-live-pong",
            "ui-live-heartbeat-due",
            "ui-live-closed",
            "ui-live-reconnect-due",
            "ui-live-reset",
            "ui-live-resync"
          ]
        },
        {
          "id": "lv-connecting-i",
          "name": "Connecting",
          "ignores": [
            "ui-live-start",
            "ui-live-frame",
            "ui-live-pong",
            "ui-live-heartbeat-due",
            "ui-live-reconnect-due",
            "ui-live-resync"
          ]
        },
        {
          "id": "lv-open-i",
          "name": "Open",
          "ignores": [
            "ui-live-start",
            "ui-live-welcome",
            "ui-live-reconnect-due"
          ]
        },
        {
          "id": "lv-waiting-i",
          "name": "Waiting to reconnect",
          "ignores": [
            "ui-live-start",
            "ui-live-welcome",
            "ui-live-frame",
            "ui-live-pong",
            "ui-live-heartbeat-due",
            "ui-live-closed",
            "ui-live-resync"
          ]
        }
      ],
      "transitions": [
        {
          "id": "lv-start-i",
          "from": "lv-idle-i",
          "to": "lv-connecting-i",
          "on": "ui-live-start",
          "otherwise": true
        },
        {
          "id": "lv-first-welcome-i",
          "from": "lv-connecting-i",
          "to": "lv-open-i",
          "on": "ui-live-welcome",
          "guard": "lastSeq == 0",
          "effects": [
            {
              "set": "attempts",
              "to": "0"
            },
            {
              "set": "lastN",
              "to": "0"
            },
            {
              "set": "missedPongs",
              "to": "0"
            },
            {
              "emit": "ui-live-subscribe",
              "payload": {
                "after": "lastSeq"
              },
              "to": "subscribe-events"
            },
            {
              "set": "lastSeq",
              "to": "event.head"
            },
            {
              "set": "heartbeatMs",
              "to": "event.heartbeat-ms"
            },
            {
              "timer": "heartbeat",
              "after": {
                "expr": "event.heartbeat-ms",
                "simulate": 10000
              },
              "emit": "ui-live-heartbeat-due"
            }
          ]
        },
        {
          "id": "lv-resume-welcome-i",
          "from": "lv-connecting-i",
          "to": "lv-open-i",
          "on": "ui-live-welcome",
          "otherwise": true,
          "effects": [
            {
              "set": "attempts",
              "to": "0"
            },
            {
              "set": "lastN",
              "to": "0"
            },
            {
              "set": "missedPongs",
              "to": "0"
            },
            {
              "emit": "ui-live-subscribe",
              "payload": {
                "after": "lastSeq"
              },
              "to": "subscribe-events"
            },
            {
              "set": "heartbeatMs",
              "to": "event.heartbeat-ms"
            },
            {
              "timer": "heartbeat",
              "after": {
                "expr": "event.heartbeat-ms",
                "simulate": 10000
              },
              "emit": "ui-live-heartbeat-due"
            }
          ]
        },
        {
          "id": "lv-frame-advance-i",
          "from": "lv-open-i",
          "to": "lv-open-i",
          "on": "ui-live-frame",
          "guard": "event.n == lastN + 1 && event.seq > lastSeq",
          "effects": [
            {
              "set": "lastN",
              "to": "event.n"
            },
            {
              "set": "lastSeq",
              "to": "event.seq"
            },
            {
              "emit": "ui-live-ack",
              "payload": {
                "n": "event.n"
              },
              "to": "subscribe-events"
            }
          ]
        },
        {
          "id": "lv-frame-same-i",
          "from": "lv-open-i",
          "to": "lv-open-i",
          "on": "ui-live-frame",
          "guard": "event.n == lastN + 1",
          "effects": [
            {
              "set": "lastN",
              "to": "event.n"
            },
            {
              "emit": "ui-live-ack",
              "payload": {
                "n": "event.n"
              },
              "to": "subscribe-events"
            }
          ]
        },
        {
          "id": "lv-frame-gap-i",
          "from": "lv-open-i",
          "to": "lv-open-i",
          "on": "ui-live-frame",
          "otherwise": true,
          "effects": [
            {
              "set": "lastSeq",
              "to": "0"
            },
            {
              "emit": "ui-live-close-requested",
              "to": "subscribe-events"
            }
          ]
        },
        {
          "id": "lv-pong-advance-i",
          "from": "lv-open-i",
          "to": "lv-open-i",
          "on": "ui-live-pong",
          "guard": "event.head > lastSeq",
          "effects": [
            {
              "set": "missedPongs",
              "to": "0"
            },
            {
              "set": "lastSeq",
              "to": "event.head"
            }
          ]
        },
        {
          "id": "lv-pong-same-i",
          "from": "lv-open-i",
          "to": "lv-open-i",
          "on": "ui-live-pong",
          "otherwise": true,
          "effects": [
            {
              "set": "missedPongs",
              "to": "0"
            }
          ]
        },
        {
          "id": "lv-give-up-i",
          "from": "lv-open-i",
          "to": "lv-open-i",
          "on": "ui-live-heartbeat-due",
          "guard": "missedPongs >= 2",
          "effects": [
            {
              "emit": "ui-live-close-requested",
              "to": "subscribe-events"
            }
          ]
        },
        {
          "id": "lv-ping-i",
          "from": "lv-open-i",
          "to": "lv-open-i",
          "on": "ui-live-heartbeat-due",
          "otherwise": true,
          "effects": [
            {
              "set": "missedPongs",
              "to": "missedPongs + 1"
            },
            {
              "emit": "ui-live-ping",
              "to": "subscribe-events"
            },
            {
              "timer": "heartbeat",
              "after": {
                "expr": "heartbeatMs",
                "simulate": 10000
              },
              "emit": "ui-live-heartbeat-due"
            }
          ]
        },
        {
          "id": "lv-closed-connecting-1-i",
          "from": "lv-connecting-i",
          "to": "lv-waiting-i",
          "on": "ui-live-closed",
          "guard": "attempts == 0",
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "cancel": "heartbeat"
            },
            {
              "timer": "reconnect",
              "after": 500,
              "emit": "ui-live-reconnect-due"
            }
          ]
        },
        {
          "id": "lv-closed-connecting-2-i",
          "from": "lv-connecting-i",
          "to": "lv-waiting-i",
          "on": "ui-live-closed",
          "guard": "attempts == 1",
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "cancel": "heartbeat"
            },
            {
              "timer": "reconnect",
              "after": 1000,
              "emit": "ui-live-reconnect-due"
            }
          ]
        },
        {
          "id": "lv-closed-connecting-3-i",
          "from": "lv-connecting-i",
          "to": "lv-waiting-i",
          "on": "ui-live-closed",
          "guard": "attempts == 2",
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "cancel": "heartbeat"
            },
            {
              "timer": "reconnect",
              "after": 2000,
              "emit": "ui-live-reconnect-due"
            }
          ]
        },
        {
          "id": "lv-closed-connecting-4-i",
          "from": "lv-connecting-i",
          "to": "lv-waiting-i",
          "on": "ui-live-closed",
          "guard": "attempts == 3",
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "cancel": "heartbeat"
            },
            {
              "timer": "reconnect",
              "after": 4000,
              "emit": "ui-live-reconnect-due"
            }
          ]
        },
        {
          "id": "lv-closed-connecting-5-i",
          "from": "lv-connecting-i",
          "to": "lv-waiting-i",
          "on": "ui-live-closed",
          "otherwise": true,
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "cancel": "heartbeat"
            },
            {
              "timer": "reconnect",
              "after": 8000,
              "emit": "ui-live-reconnect-due"
            }
          ]
        },
        {
          "id": "lv-closed-open-1-i",
          "from": "lv-open-i",
          "to": "lv-waiting-i",
          "on": "ui-live-closed",
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "cancel": "heartbeat"
            },
            {
              "timer": "reconnect",
              "after": 500,
              "emit": "ui-live-reconnect-due"
            }
          ],
          "otherwise": true
        },
        {
          "id": "lv-reconnect-i",
          "from": "lv-waiting-i",
          "to": "lv-connecting-i",
          "on": "ui-live-reconnect-due",
          "otherwise": true
        },
        {
          "id": "lv-reset-connecting-i",
          "from": "lv-connecting-i",
          "to": "lv-connecting-i",
          "on": "ui-live-reset",
          "otherwise": true,
          "effects": [
            {
              "set": "lastSeq",
              "to": "0"
            },
            {
              "emit": "ui-live-close-requested",
              "to": "subscribe-events"
            }
          ]
        },
        {
          "id": "lv-reset-open-i",
          "from": "lv-open-i",
          "to": "lv-open-i",
          "on": "ui-live-reset",
          "otherwise": true,
          "effects": [
            {
              "set": "lastSeq",
              "to": "0"
            },
            {
              "emit": "ui-live-close-requested",
              "to": "subscribe-events"
            }
          ]
        },
        {
          "id": "lv-reset-waiting-i",
          "from": "lv-waiting-i",
          "to": "lv-waiting-i",
          "on": "ui-live-reset",
          "otherwise": true,
          "effects": [
            {
              "set": "lastSeq",
              "to": "0"
            }
          ]
        },
        {
          "id": "lv-resync-i",
          "from": "lv-open-i",
          "to": "lv-open-i",
          "on": "ui-live-resync",
          "otherwise": true,
          "effects": [
            {
              "set": "lastSeq",
              "to": "event.head"
            }
          ]
        }
      ],
      "refines": "client-live-flow",
      "refinement": {
        "states": {
          "lv-idle-i": "lv-idle",
          "lv-connecting-i": "lv-connecting",
          "lv-open-i": "lv-open",
          "lv-waiting-i": "lv-waiting"
        },
        "variables": {
          "attempts": "attempts",
          "lastSeq": "lastSeq",
          "lastN": "lastN",
          "missedPongs": "missedPongs"
        },
        "transitions": {
          "lv-start-i": "lv-start",
          "lv-first-welcome-i": "lv-first-welcome",
          "lv-resume-welcome-i": "lv-resume-welcome",
          "lv-frame-advance-i": "lv-frame-advance",
          "lv-frame-same-i": "lv-frame-same",
          "lv-frame-gap-i": "lv-frame-gap",
          "lv-pong-advance-i": "lv-pong-advance",
          "lv-pong-same-i": "lv-pong-same",
          "lv-give-up-i": "lv-give-up",
          "lv-ping-i": "lv-ping",
          "lv-reconnect-i": "lv-reconnect",
          "lv-reset-connecting-i": "lv-reset-connecting",
          "lv-reset-open-i": "lv-reset-open",
          "lv-reset-waiting-i": "lv-reset-waiting",
          "lv-closed-connecting-1-i": "lv-closed-connecting",
          "lv-closed-open-1-i": "lv-closed-open",
          "lv-closed-connecting-2-i": "lv-closed-connecting",
          "lv-closed-connecting-3-i": "lv-closed-connecting",
          "lv-closed-connecting-4-i": "lv-closed-connecting",
          "lv-closed-connecting-5-i": "lv-closed-connecting",
          "lv-resync-i": "lv-resync"
        }
      },
      "storage": {
        "durability": "memory"
      }
    },
    {"id":"client-submit-flow","name":"Form submission","subject":"web-application","initial":"fs-idle","description":"One form being submitted. A form with a required field empty is refused where it stands, with no request; a complete form sends one request and shows busy; a second submit while busy changes nothing; the reply ends busy, with the form clear when it is accepted and with its error shown when it is refused.","variables":[{"name":"requests","type":"number","initial":0},{"name":"answers","type":"number","initial":0}],"states":[{"id":"fs-idle","name":"Idle"},{"id":"fs-busy","name":"Waiting for the reply"},{"id":"fs-failed","name":"Error shown"}],"transitions":[{"id":"fs-submit-idle","from":"fs-idle","to":"fs-busy","on":"ui-form-submitted","guard":"event.complete == 1","effects":[{"set":"requests","to":"requests + 1"},{"emit":"ui-request-sent"}]},{"id":"fs-incomplete-idle","from":"fs-idle","to":"fs-failed","on":"ui-form-submitted"},{"id":"fs-submit-busy","from":"fs-busy","to":"fs-busy","on":"ui-form-submitted"},{"id":"fs-accepted","from":"fs-busy","to":"fs-idle","on":"ui-form-accepted","effects":[{"set":"answers","to":"answers + 1"}]},{"id":"fs-refused","from":"fs-busy","to":"fs-failed","on":"ui-form-refused","effects":[{"set":"answers","to":"answers + 1"}]},{"id":"fs-submit-failed","from":"fs-failed","to":"fs-busy","on":"ui-form-submitted","guard":"event.complete == 1","effects":[{"set":"requests","to":"requests + 1"},{"emit":"ui-request-sent"}]},{"id":"fs-incomplete-failed","from":"fs-failed","to":"fs-failed","on":"ui-form-submitted"}]},
    {
      "id": "client-submit-flow-impl",
      "name": "Form submission (implementation)",
      "subject": "web-application",
      "level": "implementation",
      "initial": "fs-idle-i",
      "description": "The busy and error fields of one form of the kernel state (forms.login, forms.editor, forms.settings). The login form checks its two fields itself; the editor and the settings form leave every check to the gateway and ignore a submit while busy. The state is kept in memory for the life of the tab.",
      "variables": [
        {
          "name": "requests",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "answers",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        }
      ],
      "states": [
        {
          "id": "fs-idle-i",
          "name": "Idle",
          "ignores": [
            "ui-form-accepted",
            "ui-form-refused"
          ]
        },
        {
          "id": "fs-busy-i",
          "name": "Waiting for the reply"
        },
        {
          "id": "fs-failed-i",
          "name": "Error shown",
          "ignores": [
            "ui-form-accepted",
            "ui-form-refused"
          ]
        }
      ],
      "transitions": [
        {
          "id": "fs-submit-idle-i",
          "from": "fs-idle-i",
          "to": "fs-busy-i",
          "on": "ui-form-submitted",
          "guard": "event.complete == 1",
          "effects": [
            {
              "set": "requests",
              "to": "requests + 1"
            },
            {
              "emit": "ui-request-sent",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "fs-incomplete-idle-i",
          "from": "fs-idle-i",
          "to": "fs-failed-i",
          "on": "ui-form-submitted",
          "otherwise": true
        },
        {
          "id": "fs-submit-busy-i",
          "from": "fs-busy-i",
          "to": "fs-busy-i",
          "on": "ui-form-submitted",
          "otherwise": true
        },
        {
          "id": "fs-accepted-i",
          "from": "fs-busy-i",
          "to": "fs-idle-i",
          "on": "ui-form-accepted",
          "otherwise": true,
          "effects": [
            {
              "set": "answers",
              "to": "answers + 1"
            }
          ]
        },
        {
          "id": "fs-refused-i",
          "from": "fs-busy-i",
          "to": "fs-failed-i",
          "on": "ui-form-refused",
          "otherwise": true,
          "effects": [
            {
              "set": "answers",
              "to": "answers + 1"
            }
          ]
        },
        {
          "id": "fs-submit-failed-i",
          "from": "fs-failed-i",
          "to": "fs-busy-i",
          "on": "ui-form-submitted",
          "guard": "event.complete == 1",
          "effects": [
            {
              "set": "requests",
              "to": "requests + 1"
            },
            {
              "emit": "ui-request-sent",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "fs-incomplete-failed-i",
          "from": "fs-failed-i",
          "to": "fs-failed-i",
          "on": "ui-form-submitted",
          "otherwise": true
        }
      ],
      "refines": "client-submit-flow",
      "refinement": {
        "states": {
          "fs-idle-i": "fs-idle",
          "fs-busy-i": "fs-busy",
          "fs-failed-i": "fs-failed"
        },
        "variables": {
          "requests": "requests",
          "answers": "answers"
        },
        "transitions": {
          "fs-submit-idle-i": "fs-submit-idle",
          "fs-incomplete-idle-i": "fs-incomplete-idle",
          "fs-submit-busy-i": "fs-submit-busy",
          "fs-accepted-i": "fs-accepted",
          "fs-refused-i": "fs-refused",
          "fs-submit-failed-i": "fs-submit-failed",
          "fs-incomplete-failed-i": "fs-incomplete-failed"
        }
      },
      "storage": {
        "durability": "memory"
      }
    },
    {
      "id": "job-run-flow",
      "name": "Job run",
      "subject": "automation-worker",
      "initial": "jr-new",
      "description": "One job, from its creation to its end. Creating the job sets its due time ten ticks ahead. A worker poll offers the job only at or after its due time. A failed attempt reschedules the job: the first retry follows after 5 ticks and the second after 10, and the third failure ends the job as failed with an error recorded for every attempt. A cancelled job takes no further attempt. A tick is a second.",
      "variables": [
        {
          "name": "dueAt",
          "type": "number",
          "initial": 0
        },
        {
          "name": "attempts",
          "type": "number",
          "initial": 0
        },
        {
          "name": "errors",
          "type": "number",
          "initial": 0
        },
        {
          "name": "failedAt",
          "type": "number",
          "initial": 0
        },
        {
          "name": "gap",
          "type": "number",
          "initial": 0
        },
        {
          "name": "prevGap",
          "type": "number",
          "initial": 0
        },
        {
          "name": "offeredAt",
          "type": "number",
          "initial": 0
        },
        {
          "name": "cancelled",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "attemptsAtCancel",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "jr-new",
          "name": "Not yet created"
        },
        {
          "id": "jr-waiting",
          "name": "Waiting for its due time"
        },
        {
          "id": "jr-leased",
          "name": "Offered to a worker"
        },
        {
          "id": "jr-completed",
          "name": "Completed"
        },
        {
          "id": "jr-failed",
          "name": "Failed"
        },
        {
          "id": "jr-cancelled",
          "name": "Cancelled"
        }
      ],
      "transitions": [
        {
          "id": "jr-create",
          "from": "jr-new",
          "to": "jr-waiting",
          "on": "jr-created",
          "description": "The job is created and falls due 10 ticks later.",
          "effects": [
            {
              "set": "dueAt",
              "to": "time + 10"
            }
          ]
        },
        {
          "id": "jr-offer-early",
          "from": "jr-waiting",
          "to": "jr-leased",
          "on": "jr-poll",
          "description": "Defect: offers the job before its due time.",
          "guard": "time < dueAt",
          "faultOnly": true,
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "offeredAt",
              "to": "time"
            },
            {
              "emit": "jr-offered"
            }
          ]
        },
        {
          "id": "jr-offer-first",
          "from": "jr-waiting",
          "to": "jr-leased",
          "on": "jr-poll",
          "guard": "time >= dueAt && attempts == 0",
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "offeredAt",
              "to": "time"
            },
            {
              "emit": "jr-offered"
            }
          ]
        },
        {
          "id": "jr-offer-retry",
          "from": "jr-waiting",
          "to": "jr-leased",
          "on": "jr-poll",
          "guard": "time >= dueAt && attempts > 0",
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "offeredAt",
              "to": "time"
            },
            {
              "set": "prevGap",
              "to": "gap"
            },
            {
              "set": "gap",
              "to": "time - failedAt"
            },
            {
              "emit": "jr-offered"
            }
          ]
        },
        {
          "id": "jr-not-yet-due",
          "from": "jr-waiting",
          "to": "jr-waiting",
          "on": "jr-poll",
          "effects": []
        },
        {
          "id": "jr-retry-same-delay",
          "from": "jr-leased",
          "to": "jr-waiting",
          "on": "jr-attempt-failed",
          "description": "Defect: the second retry waits as long as the first.",
          "guard": "attempts == 2",
          "faultOnly": true,
          "effects": [
            {
              "set": "errors",
              "to": "errors + 1"
            },
            {
              "set": "failedAt",
              "to": "time"
            },
            {
              "set": "dueAt",
              "to": "time + 5"
            },
            {
              "emit": "jr-poll",
              "after": 5
            }
          ]
        },
        {
          "id": "jr-retry-first",
          "from": "jr-leased",
          "to": "jr-waiting",
          "on": "jr-attempt-failed",
          "guard": "attempts == 1",
          "effects": [
            {
              "set": "errors",
              "to": "errors + 1"
            },
            {
              "set": "failedAt",
              "to": "time"
            },
            {
              "set": "dueAt",
              "to": "time + 5"
            },
            {
              "emit": "jr-poll",
              "after": 5
            }
          ]
        },
        {
          "id": "jr-retry-second",
          "from": "jr-leased",
          "to": "jr-waiting",
          "on": "jr-attempt-failed",
          "guard": "attempts == 2",
          "effects": [
            {
              "set": "errors",
              "to": "errors + 1"
            },
            {
              "set": "failedAt",
              "to": "time"
            },
            {
              "set": "dueAt",
              "to": "time + 10"
            },
            {
              "emit": "jr-poll",
              "after": 10
            }
          ]
        },
        {
          "id": "jr-exhaust-unrecorded",
          "from": "jr-leased",
          "to": "jr-failed",
          "on": "jr-attempt-failed",
          "description": "Defect: the last error is not recorded.",
          "guard": "attempts >= 3",
          "faultOnly": true,
          "effects": [
            {
              "emit": "jr-job-failed"
            }
          ]
        },
        {
          "id": "jr-exhaust",
          "from": "jr-leased",
          "to": "jr-failed",
          "on": "jr-attempt-failed",
          "guard": "attempts >= 3",
          "effects": [
            {
              "set": "errors",
              "to": "errors + 1"
            },
            {
              "emit": "jr-job-failed"
            }
          ]
        },
        {
          "id": "jr-complete",
          "from": "jr-leased",
          "to": "jr-completed",
          "on": "jr-attempt-succeeded",
          "effects": []
        },
        {
          "id": "jr-cancel-leased",
          "from": "jr-leased",
          "to": "jr-cancelled",
          "on": "jr-cancel",
          "effects": [
            {
              "set": "cancelled",
              "to": true
            },
            {
              "set": "attemptsAtCancel",
              "to": "attempts"
            }
          ]
        },
        {
          "id": "jr-cancel-waiting",
          "from": "jr-waiting",
          "to": "jr-cancelled",
          "on": "jr-cancel",
          "effects": [
            {
              "set": "cancelled",
              "to": true
            },
            {
              "set": "attemptsAtCancel",
              "to": "attempts"
            }
          ]
        },
        {
          "id": "jr-offer-cancelled",
          "from": "jr-cancelled",
          "to": "jr-leased",
          "on": "jr-poll",
          "description": "Defect: a cancelled job is offered again.",
          "faultOnly": true,
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "emit": "jr-offered"
            }
          ]
        }
      ]
    },
    {
      "id": "job-run-flow-impl",
      "name": "Job run (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "job-run-flow",
      "description": "One job as the automation worker keeps it (rec-job, keyed by job-id). Creating the job sets its due time ten seconds ahead of the clock. The job is offered to a worker only when the time of the poll is at or after its due time (due-at). A failed attempt records its error, moves due-at ahead by 5 seconds after the first failure and 10 seconds after the second, and schedules a poll for then; the third failure ends the job as failed. A cancel ends the job as cancelled and a cancelled job takes no attempt. Times are in milliseconds.",
      "initial": "jr-new-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "dueAt",
          "type": "number",
          "initial": 0,
          "repr": "timestamp"
        },
        {
          "name": "attempts",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "errors",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "failedAt",
          "type": "number",
          "initial": 0,
          "repr": "timestamp"
        },
        {
          "name": "gap",
          "type": "number",
          "initial": 0,
          "repr": "i64"
        },
        {
          "name": "prevGap",
          "type": "number",
          "initial": 0,
          "repr": "i64"
        },
        {
          "name": "offeredAt",
          "type": "number",
          "initial": 0,
          "repr": "timestamp"
        },
        {
          "name": "cancelled",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "attemptsAtCancel",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "failed",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        }
      ],
      "states": [
        {
          "id": "jr-new-i",
          "name": "Not yet created",
          "ignores": [
            "jr-poll",
            "jr-attempt-failed",
            "jr-attempt-succeeded",
            "jr-cancel"
          ]
        },
        {
          "id": "jr-waiting-i",
          "name": "Waiting for its due time",
          "ignores": [
            "jr-attempt-failed",
            "jr-attempt-succeeded",
            "jr-created"
          ]
        },
        {
          "id": "jr-leased-i",
          "name": "Offered to a worker",
          "ignores": [
            "jr-poll",
            "jr-created"
          ]
        },
        {
          "id": "jr-completed-i",
          "name": "Completed",
          "ignores": [
            "jr-poll",
            "jr-attempt-failed",
            "jr-attempt-succeeded",
            "jr-cancel",
            "jr-created"
          ]
        },
        {
          "id": "jr-failed-i",
          "name": "Failed",
          "ignores": [
            "jr-poll",
            "jr-attempt-failed",
            "jr-attempt-succeeded",
            "jr-cancel",
            "jr-created"
          ]
        },
        {
          "id": "jr-cancelled-i",
          "name": "Cancelled",
          "ignores": [
            "jr-poll",
            "jr-attempt-failed",
            "jr-attempt-succeeded",
            "jr-cancel",
            "jr-created"
          ]
        }
      ],
      "transitions": [
        {
          "id": "jr-create-i",
          "from": "jr-new-i",
          "to": "jr-waiting-i",
          "on": "jr-created",
          "otherwise": true,
          "effects": [
            {
              "set": "dueAt",
              "to": "time + 10000"
            }
          ]
        },
        {
          "id": "jr-offer-first-i",
          "from": "jr-waiting-i",
          "to": "jr-leased-i",
          "on": "jr-poll",
          "guard": "time >= dueAt && attempts == 0",
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "offeredAt",
              "to": "time"
            },
            {
              "emit": "jr-offered",
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "jr-offer-retry-i",
          "from": "jr-waiting-i",
          "to": "jr-leased-i",
          "on": "jr-poll",
          "guard": "failed && failedAt <= time && time >= dueAt && attempts > 0",
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "offeredAt",
              "to": "time"
            },
            {
              "set": "prevGap",
              "to": "gap"
            },
            {
              "set": "gap",
              "to": "time - failedAt"
            },
            {
              "emit": "jr-offered",
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "jr-not-yet-due-i",
          "from": "jr-waiting-i",
          "to": "jr-waiting-i",
          "on": "jr-poll",
          "otherwise": true,
          "effects": []
        },
        {
          "id": "jr-retry-first-i",
          "from": "jr-leased-i",
          "to": "jr-waiting-i",
          "on": "jr-attempt-failed",
          "guard": "attempts == 1",
          "effects": [
            {
              "set": "errors",
              "to": "errors + 1"
            },
            {
              "set": "failedAt",
              "to": "time"
            },
            {
              "set": "failed",
              "to": true
            },
            {
              "set": "dueAt",
              "to": "time + 5000"
            },
            {
              "emit": "jr-poll",
              "after": 5000,
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "jr-retry-second-i",
          "from": "jr-leased-i",
          "to": "jr-waiting-i",
          "on": "jr-attempt-failed",
          "guard": "attempts == 2",
          "effects": [
            {
              "set": "errors",
              "to": "errors + 1"
            },
            {
              "set": "failedAt",
              "to": "time"
            },
            {
              "set": "failed",
              "to": true
            },
            {
              "set": "dueAt",
              "to": "time + 10000"
            },
            {
              "emit": "jr-poll",
              "after": 10000,
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "jr-exhaust-i",
          "from": "jr-leased-i",
          "to": "jr-failed-i",
          "on": "jr-attempt-failed",
          "guard": "attempts >= 3",
          "effects": [
            {
              "set": "errors",
              "to": "errors + 1"
            },
            {
              "emit": "jr-job-failed",
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "jr-complete-i",
          "from": "jr-leased-i",
          "to": "jr-completed-i",
          "on": "jr-attempt-succeeded",
          "otherwise": true,
          "effects": []
        },
        {
          "id": "jr-cancel-leased-i",
          "from": "jr-leased-i",
          "to": "jr-cancelled-i",
          "on": "jr-cancel",
          "otherwise": true,
          "effects": [
            {
              "set": "cancelled",
              "to": true
            },
            {
              "set": "attemptsAtCancel",
              "to": "attempts"
            }
          ]
        },
        {
          "id": "jr-cancel-waiting-i",
          "from": "jr-waiting-i",
          "to": "jr-cancelled-i",
          "on": "jr-cancel",
          "otherwise": true,
          "effects": [
            {
              "set": "cancelled",
              "to": true
            },
            {
              "set": "attemptsAtCancel",
              "to": "attempts"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "jr-waiting-i": "jr-waiting",
          "jr-leased-i": "jr-leased",
          "jr-completed-i": "jr-completed",
          "jr-failed-i": "jr-failed",
          "jr-cancelled-i": "jr-cancelled",
          "jr-new-i": "jr-new"
        },
        "variables": {
          "dueAt": "dueAt / 1000",
          "attempts": "attempts",
          "errors": "errors",
          "failedAt": "failedAt / 1000",
          "gap": "gap / 1000",
          "prevGap": "prevGap / 1000",
          "offeredAt": "offeredAt / 1000",
          "cancelled": "cancelled",
          "attemptsAtCancel": "attemptsAtCancel"
        },
        "transitions": {
          "jr-offer-first-i": "jr-offer-first",
          "jr-offer-retry-i": "jr-offer-retry",
          "jr-not-yet-due-i": "jr-not-yet-due",
          "jr-retry-first-i": "jr-retry-first",
          "jr-retry-second-i": "jr-retry-second",
          "jr-exhaust-i": "jr-exhaust",
          "jr-complete-i": "jr-complete",
          "jr-cancel-leased-i": "jr-cancel-leased",
          "jr-cancel-waiting-i": "jr-cancel-waiting",
          "jr-create-i": "jr-create"
        },
        "timeScale": 1000
      },
      "storage": {
        "record": "rec-job",
        "key": "job-id",
        "fields": {
          "dueAt": "due-at",
          "attempts": "attempt",
          "failedAt": "failed-at",
          "prevGap": "prev-gap",
          "offeredAt": "offered-at",
          "attemptsAtCancel": "attempts-at-cancel",
          "failed": "failed"
        },
        "stateValues": {
          "jr-waiting-i": "waiting",
          "jr-leased-i": "leased",
          "jr-completed-i": "completed",
          "jr-failed-i": "failed",
          "jr-cancelled-i": "cancelled",
          "jr-new-i": "unscheduled"
        }
      }
    },
    {
      "id": "schedule-flow",
      "name": "Recurring schedule",
      "subject": "automation-worker",
      "initial": "sc-live",
      "description": "One recurring schedule. Completing a job creates the next job in the same step, so a schedule that is not paused always has an open job. A paused schedule creates no job, whether a job completes or the schedule is resumed while the job is still open; resuming a schedule whose job completed while it was paused creates the next job.",
      "variables": [
        {
          "name": "paused",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "created",
          "type": "number",
          "initial": 1
        },
        {
          "name": "completions",
          "type": "number",
          "initial": 0
        },
        {
          "name": "createdAtPause",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "sc-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "sc-complete-paused-creates",
          "from": "sc-live",
          "to": "sc-live",
          "on": "sc-job-completed",
          "description": "Defect: creates the next job although the schedule is paused.",
          "guard": "paused",
          "faultOnly": true,
          "effects": [
            {
              "set": "completions",
              "to": "completions + 1"
            },
            {
              "set": "created",
              "to": "created + 1"
            },
            {
              "emit": "sc-job-created"
            }
          ]
        },
        {
          "id": "sc-complete-paused",
          "from": "sc-live",
          "to": "sc-live",
          "on": "sc-job-completed",
          "guard": "paused",
          "effects": [
            {
              "set": "completions",
              "to": "completions + 1"
            }
          ]
        },
        {
          "id": "sc-complete-split",
          "from": "sc-live",
          "to": "sc-live",
          "on": "sc-job-completed",
          "description": "Defect: records the completion and creates the next job in a later step.",
          "guard": "!paused",
          "faultOnly": true,
          "effects": [
            {
              "set": "completions",
              "to": "completions + 1"
            },
            {
              "emit": "sc-create-next",
              "after": 1
            }
          ]
        },
        {
          "id": "sc-complete",
          "from": "sc-live",
          "to": "sc-live",
          "on": "sc-job-completed",
          "guard": "!paused",
          "effects": [
            {
              "set": "completions",
              "to": "completions + 1"
            },
            {
              "set": "created",
              "to": "created + 1"
            },
            {
              "emit": "sc-job-created"
            }
          ]
        },
        {
          "id": "sc-pause-t",
          "from": "sc-live",
          "to": "sc-live",
          "on": "sc-pause",
          "effects": [
            {
              "set": "paused",
              "to": true
            },
            {
              "set": "createdAtPause",
              "to": "created"
            }
          ]
        },
        {
          "id": "sc-resume-without-job",
          "from": "sc-live",
          "to": "sc-live",
          "on": "sc-resume",
          "guard": "paused && created == completions",
          "effects": [
            {
              "set": "paused",
              "to": false
            },
            {
              "set": "created",
              "to": "created + 1"
            },
            {
              "emit": "sc-job-created"
            }
          ]
        },
        {
          "id": "sc-resume-with-job",
          "from": "sc-live",
          "to": "sc-live",
          "on": "sc-resume",
          "guard": "paused && created > completions",
          "effects": [
            {
              "set": "paused",
              "to": false
            }
          ]
        },
        {
          "id": "sc-create-next-job",
          "from": "sc-live",
          "to": "sc-live",
          "on": "sc-create-next",
          "effects": [
            {
              "set": "created",
              "to": "created + 1"
            },
            {
              "emit": "sc-job-created"
            }
          ]
        }
      ]
    },
    {
      "id": "schedule-flow-impl",
      "name": "Recurring schedule (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "schedule-flow",
      "description": "One recurring schedule. Completing a job creates the next job in the same step, so a schedule that is not paused always has an open job. A paused schedule creates no job, whether a job completes or the schedule is resumed while the job is still open; resuming a schedule whose job completed while it was paused creates the next job.",
      "initial": "sc-live-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "paused",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "created",
          "type": "number",
          "initial": 1,
          "repr": "u64"
        },
        {
          "name": "completions",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "createdAtPause",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        }
      ],
      "states": [
        {
          "id": "sc-live-i",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "sc-complete-paused-i",
          "from": "sc-live-i",
