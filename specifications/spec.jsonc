                    }
                  },
                  "constraints": {
                    "title_length": {
                      "id": "title_length",
                      "expr": {
                        "cmp": {
                          "op": "le",
                          "left": {
                            "len": {
                              "var": {
                                "scope": "new",
                                "field": "title"
                              }
                            }
                          },
                          "right": {
                            "lit": {
                              "int": 24
                            }
                          }
                        }
                      },
                      "message": "A title has at most 24 characters"
                    }
                  }
                },
