          }
        },
        {
          "args": {
            "ty": "int",
            "j": {
              "bool": true
            },
            "refs": {},
            "times": {}
          },
          "error": {
            "message": "expected int, got true"
          }
        },
        {
          "args": {
            "ty": {
              "ref": {
                "target": "person",
                "on-delete": "set-null"
              }
            },
            "j": {
              "number": {
                "float": 1.5
              }
            },
            "refs": {},
            "times": {}
          },
          "error": {
            "message": "expected reference<person>, got 1.5"
          }
        }
      ]
    },
    {
      "id": "coerce",
      "description": "plain.rs coerce: turn plain JSON into a value of a field type; a list type takes an array whose items are coerced to its element type.",
      "params": [
        {
          "name": "ty",
          "type": "field-type"
        },
        {
          "name": "j",
          "type": "plain-json"
        },
        {
          "name": "refs",
          "type": "map<string, record-id>"
        },
        {
          "name": "times",
          "type": "map<string, i64>"
        }
      ],
      "returns": "value",
      "errors": "plain-error",
      "body": "match ty { list(inner) => match j { array(items) => value.list(map(i in items, try call coerce-scalar(inner, i, refs, times))), _ => try call coerce-scalar(ty, j, refs, times) }, _ => try call coerce-scalar(ty, j, refs, times) }",
      "examples": [
        {
          "description": "plain.rs coerces_by_field_type: a list of strings.",
          "args": {
            "ty": {
              "list": "str"
            },
            "j": {
              "array": [
                {
                  "string": "a"
                },
                {
                  "string": "b"
                }
              ]
            },
            "refs": {},
            "times": {}
          },
          "result": {
            "list": [
              {
                "str": "a"
              },
              {
                "str": "b"
              }
            ]
          }
        },
        {
          "args": {
            "ty": {
              "list": "str"
            },
            "j": {
              "array": [
                {
                  "string": "a"
                },
                {
                  "number": {
                    "pos-int": 1
                  }
                }
              ]
            },
            "refs": {},
            "times": {}
          },
          "error": {
            "message": "expected string, got 1"
          }
        },
        {
          "args": {
            "ty": {
              "list": "str"
            },
            "j": {
              "string": "a"
            },
            "refs": {},
            "times": {}
          },
          "error": {
            "message": "expected list<string>, got \"a\""
          }
        },
        {
          "args": {
            "ty": {
              "list": "str"
            },
            "j": "null",
            "refs": {},
            "times": {}
          },
          "result": "null"
        },
        {
          "args": {
            "ty": "int",
            "j": {
              "array": []
            },
            "refs": {},
            "times": {}
          },
          "error": {
            "message": "expected int, got []"
          }
        },
        {
          "args": {
            "ty": "int",
            "j": {
              "number": {
                "pos-int": 3
              }
            },
            "refs": {},
            "times": {}
          },
          "result": {
            "int": 3
          }
        }
      ]
    },
    {
      "id": "coerce-fields",
      "description": "plain.rs coerce_fields: a plain JSON object as field values of an object type, in name order; a name the type does not declare is <object> has no field <name>, and a value that does not coerce is <name>: <error>.",
      "params": [
        {
          "name": "object",
          "type": "object-type-def"
        },
        {
          "name": "fields",
          "type": "map<string, plain-json>"
        },
        {
          "name": "refs",
          "type": "map<string, record-id>"
        },
        {
          "name": "times",
          "type": "map<string, i64>"
        }
      ],
      "returns": "map<field-id, value>",
      "errors": "plain-error",
      "body": "fold(name in keys(fields), out = {}, match get(object.fields, name) { None => fail(plain-error.message(format('{} has no field {}', object.id, name))), Some(def) => match get(fields, name) { Some(j) => match call coerce(def.ty, j, refs, times) { Ok(x) => insert(out, name, x), Err(e) => match e { message(m) => fail(plain-error.message(format('{}: {}', name, m))) } }, None => out } })",
      "examples": [
        {
          "description": "bundle.rs: a seeded post with a symbolic author, tags and a date.",
          "args": {
            "object": {
              "fixture": "fx-object-type-def-3"
            },
            "fields": {
              "title": {
                "string": "Kiln"
              },
              "author": {
                "string": "@ines"
              },
              "tags": {
                "array": [
                  {
                    "string": "clay"
                  }
                ]
              },
              "published_at": {
                "string": "2026-11-18T09:30Z"
              }
            },
            "refs": {
              "@ines": 2
            },
            "times": {
              "2026-11-18T09:30Z": 1794994200000
            }
          },
          "result": {
            "author": {
              "ref": 2
            },
            "published_at": {
              "time": 1794994200000
            },
            "tags": {
              "list": [
                {
                  "str": "clay"
                }
              ]
            },
            "title": {
              "str": "Kiln"
            }
          }
        },
        {
          "args": {
            "object": {
              "fixture": "fx-object-type-def-3"
            },
            "fields": {
              "title": {
                "string": "Kiln"
              },
              "mood": {
                "string": "x"
              }
            },
            "refs": {},
            "times": {}
          },
          "error": {
            "message": "post has no field mood"
          }
        },
        {
          "args": {
            "object": {
              "fixture": "fx-object-type-def-3"
            },
            "fields": {
              "title": {
                "number": {
                  "pos-int": 3
                }
              }
            },
            "refs": {},
            "times": {}
          },
          "error": {
            "message": "title: expected string, got 3"
          }
        },
        {
          "args": {
            "object": {
              "fixture": "fx-object-type-def-3"
            },
            "fields": {
              "title": "null"
            },
            "refs": {},
            "times": {}
          },
          "result": {
            "title": "null"
          }
        }
      ]
    },
    {
      "id": "refuse",
      "description": "transition.rs refuse: a rejection made before any rule of the tenant is consulted; it names the failed check.",
      "params": [
        {
          "name": "kind",
          "type": "error-kind"
        },
        {
          "name": "rule",
          "type": "string"
        },
        {
          "name": "message",
          "type": "string"
        }
      ],
      "returns": "domain-error",
      "body": "domain-error{kind, message, evidence: [check{rule, passed: false, detail: message}]}",
      "examples": [
        {
          "args": {
            "kind": "tenant-not-found",
            "rule": "tenant:exists",
            "message": "no such tenant"
          },
          "result": {
            "kind": "tenant-not-found",
            "message": "no such tenant",
            "evidence": [
              {
                "rule": "tenant:exists",
                "passed": false,
                "detail": "no such tenant"
              }
            ],
            "missing": null
          }
        }
      ]
    },
    {
      "id": "principal-debug",
      "description": "The Rust Debug text of a Principal ({:?}).",
      "params": [
        {
          "name": "p",
          "type": "principal"
        }
      ],
      "returns": "string",
      "body": "match p { system => 'System', anonymous => 'Anonymous', user(id) => format('User(PrincipalId(\"{}\"))', id) }",
      "examples": [
        {
          "args": {
            "p": {
              "user": "alpha:writer2"
            }
          },
          "result": "User(PrincipalId(\"alpha:writer2\"))"
        },
        {
          "args": {
            "p": "anonymous"
          },
          "result": "Anonymous"
        },
        {
          "args": {
            "p": "system"
          },
          "result": "System"
        }
      ]
    },
    {
      "id": "resource-debug",
      "description": "The Rust Debug text of a Resource ({resource:?}).",
      "params": [
        {
          "name": "r",
          "type": "resource"
        }
      ],
      "returns": "string",
      "body": "match r { object(o) => format('Object(ObjectTypeId(\"{}\"))', o), any-object => 'AnyObject', schema => 'Schema', members => 'Members', ledger{unit} => format('Ledger { unit: {} }', match unit { Some(u) => format('Some(LedgerUnit(\"{}\"))', u), None => 'None' }) }",
      "examples": [
        {
          "args": {
            "r": {
              "object": "note"
            }
          },
          "result": "Object(ObjectTypeId(\"note\"))"
        },
        {
          "args": {
            "r": "members"
          },
          "result": "Members"
        },
        {
          "args": {
            "r": "any-object"
          },
          "result": "AnyObject"
        },
        {
          "args": {
            "r": "schema"
          },
          "result": "Schema"
        },
        {
          "args": {
            "r": {
              "ledger": {
                "unit": "points"
              }
            }
          },
          "result": "Ledger { unit: Some(LedgerUnit(\"points\")) }"
        }
      ]
    },
    {
      "id": "revision-debug",
      "description": "The Rust Debug text of an Option<StateRevision>.",
      "params": [
        {
          "name": "r",
          "type": "option<state-revision>"
        }
      ],
      "returns": "string",
      "body": "match r { Some(n) => format('Some(StateRevision({}))', n), None => 'None' }",
      "examples": [
        {
          "args": {
            "r": 3
          },
          "result": "Some(StateRevision(3))"
        },
        {
          "args": {
            "r": null
          },
          "result": "None"
        }
      ]
    },
    {
      "id": "string-set-debug",
      "description": "The Rust Debug text of a BTreeSet<String> ({:?}): the items quoted, in order, between braces. Quotes and backslashes inside an item are not escaped (the body language has no string operations).",
      "params": [
        {
          "name": "items",
          "type": "set<string>"
        }
      ],
      "returns": "string",
      "body": "'{' + fold(s in items, acc = '', if acc == '' then format('\"{}\"', s) else acc + ', ' + format('\"{}\"', s)) + '}'",
      "examples": [
        {
          "args": {
            "items": [
              "draft"
            ]
          },
          "result": "{\"draft\"}"
        },
        {
          "args": {
            "items": [
              "a",
              "b"
            ]
          },
          "result": "{\"a\", \"b\"}"
        },
        {
          "args": {
            "items": []
          },
          "result": "{}"
        }
      ]
    },
    {
      "id": "join-semicolon",
      "description": "Vec<String>::join(\"; \") for the refusals of a workflow step, which are never empty.",
      "params": [
        {
          "name": "items",
          "type": "list<string>"
        }
      ],
      "returns": "string",
      "body": "fold(s in items, acc = '', if acc == '' then s else acc + '; ' + s)",
      "examples": [
        {
          "args": {
            "items": [
              "publish: guard is not true",
              "publish2: guard is not true"
            ]
          },
          "result": "publish: guard is not true; publish2: guard is not true"
        },
        {
          "args": {
            "items": [
              "x: y"
            ]
          },
          "result": "x: y"
        }
      ]
    },
    {
      "id": "genesis-schema",
      "description": "schema.rs TenantSchema::genesis: version 1, the built-in roles public (Everyone) and owner (Owner), nothing else.",
      "params": [],
      "returns": "tenant-schema",
      "body": "tenant-schema{version: 1, objects: {}, roles: insert(insert({}, 'owner', role-def{id: 'owner', label: 'Owner'}), 'public', role-def{id: 'public', label: 'Everyone'}), policies: {}, workflows: {}, queries: {}, views: {}}",
      "examples": [
        {
          "args": {},
          "result": {
            "version": 1,
            "objects": {},
            "roles": {
              "owner": {
                "id": "owner",
                "label": "Owner"
              },
              "public": {
                "id": "public",
                "label": "Everyone"
              }
            },
            "policies": {},
            "workflows": {},
            "queries": {},
            "views": {}
          }
        }
      ]
    },
    {
      "id": "policy-check-text",
      "description": "A check of rules.rs authorize as the kernel writes it: the detail printed from the outcome, the request and the condition the check carries, printed as the kernel's Display of Expr writes it (print of the tenant rule language, WG-4966). For a condition that failed to evaluate the kernel writes \"<condition>: <evaluation error>\"; policy-check does not carry the error, so the detail is \"<condition>: evaluation failed\" (a gap of WG-4938).",
      "params": [
        {
          "name": "c",
          "type": "policy-check"
        }
      ],
      "returns": "check",
      "let": [
        {
          "name": "text",
          "expr": "match c.condition { Some(e) => print(tenant-rule-language, e), None => '' }"
        }
      ],
      "body": "check{rule: c.rule, passed: c.passed, detail: match c.outcome { owner => c.what, unconditional => c.what, held => format('{} where {}', c.what, text), is-false => format('{} is false', text), is-null => format('{} is null', text), failed => format('{}: evaluation failed', text), no-policy => format('no policy grants {}', c.what) }}",
      "examples": [
        {
          "args": {
            "c": {
              "rule": "policy:writers_edit_own",
              "passed": true,
              "what": "Update on Object(ObjectTypeId(\"note\"))",
              "outcome": "held",
              "condition": {
                "cmp": {
                  "op": "eq",
                  "left": {
                    "var": {
                      "scope": "record",
                      "field": "$created_by"
                    }
                  },
                  "right": "principal"
                }
              }
            }
          },
          "result": {
            "rule": "policy:writers_edit_own",
            "passed": true,
            "detail": "Update on Object(ObjectTypeId(\"note\")) where (record.$created_by == principal)"
          }
        },
        {
          "args": {
            "c": {
              "rule": "policy:writers_edit_own",
              "passed": false,
              "what": "Update on Object(ObjectTypeId(\"note\"))",
              "outcome": "is-false",
              "condition": {
                "cmp": {
                  "op": "eq",
                  "left": {
                    "var": {
                      "scope": "record",
                      "field": "$created_by"
                    }
                  },
                  "right": "principal"
                }
              }
            }
          },
          "result": {
            "rule": "policy:writers_edit_own",
            "passed": false,
            "detail": "(record.$created_by == principal) is false"
          }
        },
        {
          "args": {
            "c": {
              "rule": "policy:public_reads_published",
              "passed": false,
              "what": "Read on Object(ObjectTypeId(\"note\"))",
              "outcome": "is-null",
              "condition": {
                "cmp": {
                  "op": "eq",
                  "left": {
                    "var": {
                      "scope": "record",
                      "field": "status"
                    }
                  },
                  "right": {
                    "lit": {
                      "str": "published"
                    }
                  }
                }
              }
            }
          },
          "result": {
            "rule": "policy:public_reads_published",
            "passed": false,
            "detail": "(record.status == 'published') is null"
          }
        },
        {
          "args": {
            "c": {
              "rule": "policy:none",
              "passed": false,
              "what": "Manage on Members",
              "outcome": "no-policy",
              "condition": null
            }
          },
          "result": {
            "rule": "policy:none",
            "passed": false,
            "detail": "no policy grants Manage on Members"
          }
        },
        {
          "args": {
            "c": {
              "rule": "policy:builtin_owner",
              "passed": true,
              "what": "Manage on Schema",
              "outcome": "owner",
              "condition": null
            }
          },
          "result": {
            "rule": "policy:builtin_owner",
            "passed": true,
            "detail": "Manage on Schema"
          }
        },
        {
          "description": "A condition that could not be evaluated reads as an evaluation failure.",
          "args": {
            "c": {
              "rule": "policy:writers_edit_own",
              "passed": false,
              "what": "Update on Object(ObjectTypeId(\"note\"))",
              "outcome": "failed",
              "condition": {
                "cmp": {
                  "op": "eq",
                  "left": {
                    "var": {
                      "scope": "record",
                      "field": "$created_by"
                    }
                  },
                  "right": "principal"
                }
              }
            }
          },
          "result": {
            "rule": "policy:writers_edit_own",
            "passed": false,
            "detail": "(record.$created_by == principal): evaluation failed"
          }
        }
      ]
    },
    {
      "id": "require",
      "description": "transition.rs Draft::require: authorize the action on the resource against the tenant's own schema with the snapshot's lookup (rules.rs authorize_needing: authorize-needing with the draft's coverage), and add its checks to the evidence as the kernel writes them; when it is not allowed, answer InsufficientState for the record a failed condition needs and the snapshot does not cover, and otherwise refuse with Unauthorized \"<principal:?> may not <action:?> <resource:?>\".",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "action",
          "type": "action"
        },
        {
          "name": "resource",
          "type": "resource"
        },
        {
          "name": "subject",
          "type": "subject"
        }
      ],
      "returns": "draft",
      "errors": "rejection",
      "let": [
        {
          "name": "decision",
          "expr": "call authorize-needing(d.tenant, d.tenant.schema, d.ctx.principal, d.ctx.now, action, resource, subject, d.coverage)"
        },
        {
          "name": "evidence",
          "expr": "concat(d.evidence, map(c in decision.checks, call policy-check-text(c)))"
        }
      ],
      "body": "if decision.allowed then draft{tenant: d.tenant, ctx: d.ctx, coverage: d.coverage, ops: d.ops, events: d.events, effects: d.effects, evidence: evidence, next-record: d.next-record} else match decision.needed { Some(n) => fail(rejection.rejected(call insufficient(n))), None => fail(call draft-reject(evidence, error-kind.unauthorized, format('{} may not {} {}', call principal-debug(d.ctx.principal), call action-debug(action), call resource-debug(resource)))) }",
      "examples": [
        {
          "description": "behaviour.rs create_applies_defaults_and_allocates_the_next_id: writers_read_notes lets writer1 create a note.",
          "args": {
            "d": {
              "fixture": "fx-draft-1"
            },
            "action": "create",
            "resource": {
              "object": "note"
            },
            "subject": {
              "fixture": "fx-subject-4"
            }
          },
          "result": {
            "tenant": {
              "id": "alpha",
              "name": "alpha",
              "revision": 5,
              "next-record": 1,
              "event-seq": 5,
              "schema": {
                "version": 2,
                "objects": {
                  "note": {
                    "id": "note",
                    "label": "Note",
                    "fields": {
                      "author": {
                        "id": "author",
                        "label": "Author",
                        "ty": {
                          "ref": {
                            "target": "person",
                            "on-delete": "set-null"
                          }
                        },
                        "required": false,
                        "unique": false
                      },
                      "body": {
                        "id": "body",
                        "label": "body",
                        "ty": "str",
                        "required": false,
                        "unique": false
                      },
                      "published_at": {
                        "id": "published_at",
                        "label": "published_at",
                        "ty": "time",
                        "required": false,
                        "unique": false
                      },
                      "rank": {
                        "id": "rank",
                        "label": "rank",
                        "ty": "int",
                        "required": false,
                        "unique": false
                      },
                      "slug": {
                        "id": "slug",
                        "label": "slug",
                        "ty": "str",
                        "required": true,
                        "unique": true
                      },
                      "status": {
                        "id": "status",
                        "label": "status",
