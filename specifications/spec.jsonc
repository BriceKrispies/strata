    },
    {
      "id": "request-text",
      "description": "The \"what\" of rules.rs authorize: format!(\"{action:?} on {resource:?}\"), the Debug forms of Action and Resource.",
      "params": [
        {
          "name": "action",
          "type": "action"
        },
        {
          "name": "resource",
          "type": "resource"
        }
      ],
      "returns": "string",
      "body": "format('{} on {}', match action { read => 'Read', create => 'Create', update => 'Update', delete => 'Delete', manage => 'Manage' }, match resource { object(o) => format('Object(ObjectTypeId(\"{}\"))', o), any-object => 'AnyObject', schema => 'Schema', members => 'Members' })",
      "examples": [
        {
          "args": {
            "action": "update",
            "resource": {
              "object": "post"
            }
          },
          "result": "Update on Object(ObjectTypeId(\"post\"))"
        },
        {
          "args": {
            "action": "manage",
            "resource": "schema"
          },
          "result": "Manage on Schema"
        },
        {
          "args": {
            "action": "read",
            "resource": "any-object"
          },
          "result": "Read on AnyObject"
        },
        {
          "args": {
            "action": "delete",
            "resource": "members"
          },
          "result": "Delete on Members"
        }
      ]
    },
    {
      "id": "record-scope",
      "description": "A record as a record scope of expr-env: its fields and its system attributes, as expr.rs attribute reads them ($created_by only when the record has a creator).",
      "params": [
        {
          "name": "record",
          "type": "record"
        },
        {
          "name": "r",
          "type": "record"
        }
      ],
      "returns": "map<string, value>",
      "body": "match r.created-by { Some(p) => insert(base, '$created_by', value.str(p)), None => base }",
      "examples": [
        {
          "args": {
            "record": {
              "id": 3,
              "object": "category",
              "version": 1,
              "created-by": "user:ed",
              "created-at": 1767312000000,
              "updated-at": 1767312000000,
              "fields": {
                "name": {
                  "str": "Craft"
                },
                "slug": {
                  "str": "craft"
                }
              }
            }
          },
          "result": {
            "$created_at": {
              "time": 1767312000000
            },
            "$created_by": {
              "str": "user:ed"
            },
            "$id": {
              "ref": 3
            },
            "$updated_at": {
              "time": 1767312000000
            },
            "$version": {
              "int": 1
            },
            "name": {
              "str": "Craft"
            },
            "slug": {
              "str": "craft"
            }
          }
        },
        {
          "description": "A record the system created has no creator: $created_by is Null.",
          "args": {
            "record": {
              "id": 3,
              "object": "category",
              "version": 1,
              "created-by": null,
              "created-at": 1767312000000,
              "updated-at": 1767312000000,
              "fields": {}
            }
          },
          "result": {
            "$created_at": {
              "time": 1767312000000
            },
            "$created_by": "null",
            "$id": {
              "ref": 3
            },
            "$updated_at": {
              "time": 1767312000000
            },
            "$version": {
              "int": 1
            }
          }
        },
        {
          "args": {
            "r": {
              "id": 1,
              "object": "note",
              "version": 1,
              "created-by": "alpha:writer1",
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "title": {
                  "str": "First"
                },
                "slug": {
                  "str": "first"
                },
                "status": {
                  "str": "draft"
                }
              }
            }
          },
          "result": {
            "$created_at": {
              "time": 5000
            },
            "$created_by": {
              "str": "alpha:writer1"
            },
            "$id": {
              "ref": 1
            },
            "$updated_at": {
              "time": 5000
            },
            "$version": {
              "int": 1
            },
            "slug": {
              "str": "first"
            },
            "status": {
              "str": "draft"
            },
            "title": {
              "str": "First"
            }
          }
        },
        {
          "args": {
            "r": {
              "id": 2,
              "object": "note",
              "version": 1,
              "created-at": 7,
              "updated-at": 7,
              "fields": {
                "title": {
                  "str": "T"
                }
              }
            }
          },
          "result": {
            "$created_at": {
              "time": 7
            },
            "$id": {
              "ref": 2
            },
            "$updated_at": {
              "time": 7
            },
            "$version": {
              "int": 1
            },
            "title": {
              "str": "T"
            }
          }
        }
      ],
      "let": [
        {
          "name": "base",
          "expr": "insert(insert(insert(insert(r.fields, '$id', value.ref(r.id)), '$version', value.int(r.version)), '$created_at', value.time(r.created-at)), '$updated_at', value.time(r.updated-at))"
        }
      ]
    },
    {
      "id": "scope-of",
      "description": "A record scope of the rule environment: no record is null, a record is record-scope of it.",
      "params": [
        {
          "name": "record",
          "type": "option<record>"
        }
      ],
      "returns": "option<map<string, value>>",
      "body": "match record { None => null, Some(r) => call record-scope(r) }",
      "examples": [
        {
          "args": {
            "record": null
          },
          "result": null
        },
        {
          "args": {
            "record": {
              "id": 3,
              "object": "category",
              "version": 1,
              "created-by": "user:ed",
              "created-at": 1767312000000,
              "updated-at": 1767312000000,
              "fields": {}
            }
          },
          "result": {
            "$created_at": {
              "time": 1767312000000
            },
            "$created_by": {
              "str": "user:ed"
            },
            "$id": {
              "ref": 3
            },
            "$updated_at": {
              "time": 1767312000000
            },
            "$version": {
              "int": 1
            }
          }
        }
      ]
    },
    {
      "id": "null-value",
      "description": "Value::Null. The null variant of value is named null, a keyword of the body language, so a body cannot write value.null; it is read as an absent parameter, which the language evaluates to null.",
      "params": [],
      "returns": "value",
      "body": "match eval(tenant-rule-language, expr.param('absent'), expr-env{record: null, old: null, new: null, param: {}, now: value.int(0), principal: value.int(0), has_role: []}) { Ok(x) => x, Err(e) => value.int(0) }",
      "examples": [
        {
          "args": {},
          "result": "null"
        }
      ]
    },
    {
      "id": "deny",
      "description": "A failed check of a policy whose condition did not give true, added to the checks of the policy loop.",
      "params": [
        {
          "name": "acc",
          "type": "policy-progress"
        },
        {
          "name": "rule",
          "type": "string"
        },
        {
          "name": "what",
          "type": "string"
        },
        {
          "name": "outcome",
          "type": "policy-outcome"
        },
        {
          "name": "condition",
          "type": "expr"
        }
      ],
      "returns": "policy-progress",
      "body": "policy-progress{granted: acc.granted, checks: concat(acc.checks, [policy-check{rule, passed: false, what, outcome, condition}])}",
      "examples": [
        {
          "args": {
            "acc": {
              "checks": []
            },
            "rule": "policy:authors_own_posts",
            "what": "Update on Object(ObjectTypeId(\"post\"))",
            "outcome": "is-false",
            "condition": {
              "cmp": {
                "op": "eq",
                "left": {
                  "var": {
                    "scope": "record",
                    "field": "$created_by"
                  }
                },
                "right": "principal"
              }
            }
          },
          "result": {
            "checks": [
              {
                "rule": "policy:authors_own_posts",
                "passed": false,
                "what": "Update on Object(ObjectTypeId(\"post\"))",
                "outcome": "is-false",
                "condition": {
                  "cmp": {
                    "op": "eq",
                    "left": {
                      "var": {
                        "scope": "record",
                        "field": "$created_by"
                      }
                    },
                    "right": "principal"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "policy-step",
      "description": "One applicable policy in the loop of rules.rs authorize: no condition grants; a condition grants when it evaluates to Bool(true); Null fails the check as \"is null\", any other value as \"is false\", an evaluation error as failed.",
      "params": [
        {
          "name": "policy",
          "type": "policy-def"
        },
        {
          "name": "env",
          "type": "rule-env"
        },
        {
          "name": "acc",
          "type": "policy-progress"
        },
        {
          "name": "what",
          "type": "string"
        },
        {
          "name": "env",
          "type": "expr-env"
        }
      ],
      "returns": "policy-progress",
      "let": [
        {
          "name": "rule",
          "expr": "format('policy:{}', policy.id)"
        }
      ],
      "body": "match policy.condition { None => policy-progress{granted: policy-check{rule, passed: true, what, outcome: policy-outcome.unconditional}, checks: acc.checks}, Some(c) => match eval(tenant-rule-language, c, env) { Ok(v) => match v { bool(b) => if b then policy-progress{granted: policy-check{rule, passed: true, what, outcome: policy-outcome.held, condition: c}, checks: acc.checks} else call deny(acc, rule, what, policy-outcome.is-false, c), int(_) => call deny(acc, rule, what, policy-outcome.is-false, c), str(_) => call deny(acc, rule, what, policy-outcome.is-false, c), time(_) => call deny(acc, rule, what, policy-outcome.is-false, c), ref(_) => call deny(acc, rule, what, policy-outcome.is-false, c), list(_) => call deny(acc, rule, what, policy-outcome.is-false, c), _ => call deny(acc, rule, what, policy-outcome.is-null, c) }, Err(_) => call deny(acc, rule, what, policy-outcome.failed, c) } }",
      "examples": [
        {
          "description": "A policy without a condition grants.",
          "args": {
            "policy": {
              "id": "editors_run_posts",
              "role": "editor",
              "resource": {
