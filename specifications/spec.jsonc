          "guard": "(!(event.caller == 'permitted'))",
          "description": "Defect: accepts although the condition \"is asked by a permitted caller\" does not hold.",
          "effects": [
            {
              "emit": "tokint-accepted",
              "payload": {
                "scopes": "event.scopes",
                "subject": "event.subject",
                "expiry": "event.expiry"
              }
            }
          ]
        },
        {
          "id": "tokint-accept",
          "from": "tokint-open",
          "to": "tokint-open",
          "on": "tokint-presented",
          "guard": "(event.caller == 'permitted')",
          "effects": [
            {
              "emit": "tokint-accepted",
              "payload": {
                "scopes": "event.scopes",
                "subject": "event.subject",
                "expiry": "event.expiry"
              }
