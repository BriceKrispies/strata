          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "rejected",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        }
      ],
      "states": [
        {
          "id": "dr-live-i",
          "name": "Live"
