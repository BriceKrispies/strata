    {"id":"sec-tenancy-1","title":"Tenancy","level":1,"document":"doc-tenancy","order":1,"body":"\nA tenant is a database, a file namespace, a realm and a key. The control plane creates, places, moves and removes them and holds nothing of their content.\n\n"},
    {"id":"sec-tenancy-2","title":"Provisioning","level":2,"document":"doc-tenancy","order":2,"body":"\n{{entity:ten-001}}\n\n{{entity:ten-002}}\n\n{{entity:ten-003}}\n\n{{entity:ten-004}}\n\n{{entity:ten-005}}\n\n"},
