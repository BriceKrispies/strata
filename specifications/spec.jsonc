            }
          ]
        },
        {
          "name": "object",
          "newtype": true,
          "fields": [
            {
              "name": "value",
              "type": "map<string, plain-json>"
            }
          ]
        }
      ],
      "encoding": {
        "tag": "external",
        "variantCase": "PascalCase"
      }
    },
