    {"id":"tm-copy-failed","name":"Copy failed","description":"The copy of the tenant database to the target stops.","payload":[{"name":"move-id","type":"move-id"}]},
    {"id":"tm-move-failed","name":"Move failed","description":"The move ends and the tenant stays on its source placement.","delivery":"at-most-once"},
