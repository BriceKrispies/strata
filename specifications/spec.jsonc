    {
      "id": "schema-problems",
      "description": "schema.rs TenantSchema::problems: every problem of a schema in a fixed order: object types, policies, workflows, queries, then views, each in id order; the roles known are the schema's declared roles (genesis declares public and owner).",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        }
      ],
      "returns": "list<string>",
      "let": [
        {
          "name": "roles",
          "expr": "keys(schema.roles)"
        },
        {
          "name": "p-objects",
          "expr": "fold(o in values(schema.objects), ps = [], concat(ps, call object-problems(schema, roles, o)))"
        },
        {
          "name": "p-policies",
          "expr": "fold(p in values(schema.policies), ps = [], concat(ps, call policy-problems(schema, roles, p)))"
        },
        {
          "name": "p-workflows",
          "expr": "fold(w in values(schema.workflows), ps = [], concat(ps, call workflow-problems(schema, roles, w)))"
        },
        {
          "name": "p-queries",
          "expr": "fold(q in values(schema.queries), ps = [], concat(ps, call query-problems(schema, roles, q)))"
        },
        {
          "name": "scan",
          "expr": "fold(w in values(schema.views), acc = route-scan{problems: [], routes: []}, route-scan{problems: concat(acc.problems, call view-problems(schema, w, acc.routes)), routes: concat(acc.routes, [w.route])})"
        }
      ],
      "body": "concat(concat(concat(concat(p-objects, p-policies), p-workflows), p-queries), scan.problems)",
      "examples": [
