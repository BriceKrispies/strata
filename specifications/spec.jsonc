              "session": null,
              "now": 5001,
              "correlation": "test-5001"
            }
          },
          "result": {
            "delta": {
              "tenant": "gamma",
              "base-revision": null,
              "new-revision": 1,
              "next-record": 1,
              "event-seq": 1,
              "ops": [
                {
                  "create-tenant": {
                    "name": "Gamma"
                  }
                },
                {
                  "put-schema": {
                    "version": 1,
                    "objects": {},
                    "roles": {
                      "owner": {
                        "id": "owner",
                        "label": "Owner"
                      },
                      "public": {
                        "id": "public",
                        "label": "Everyone"
                      }
                    },
                    "policies": {},
                    "workflows": {},
                    "queries": {},
                    "views": {}
                  }
                },
                {
                  "put-member": {
                    "principal": "gamma:owner",
                    "roles": [
