          "on": "fedl-presented",
          "faultOnly": true,
          "guard": "(event.emailVerified) && (!(event.authenticated))",
          "description": "Defect: accepts although the condition \"links a principal that has authenticated\" does not hold.",
          "effects": [
            {
              "emit": "fedl-accepted"
            }
          ]
        },
        {
          "id": "fedl-accept-without-verified",
          "from": "fedl-open",
          "to": "fedl-open",
          "on": "fedl-presented",
          "faultOnly": true,
          "guard": "(event.authenticated) && (!(event.emailVerified))",
          "description": "Defect: accepts although the condition \"links an address that the provider marks verified\" does not hold.",
          "effects": [
            {
              "emit": "fedl-accepted"
            }
          ]
        },
        {
          "id": "fedl-accept",
          "from": "fedl-open",
          "to": "fedl-open",
          "on": "fedl-presented",
          "guard": "(event.authenticated) && (event.emailVerified)",
          "effects": [
            {
              "emit": "fedl-accepted"
            }
          ]
        },
        {
          "id": "fedl-refuse",
          "from": "fedl-open",
          "to": "fedl-open",
          "on": "fedl-presented",
          "effects": [
            {
              "emit": "fedl-refused"
            }
          ]
        }
      ]
