    {
      "id": "uniques-of",
      "description": "definitions.rs uniques: the composite unique constraints of an object type by id, none when it declares none (ObjectTypeDef.unique, an optional map).",
      "params": [
        {
          "name": "object",
          "type": "object-type-def"
        }
      ],
      "returns": "map<constraint-id, unique-def>",
      "body": "match object.unique { Some(m) => m, None => {} }",
      "examples": [
        {
