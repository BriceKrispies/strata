                  "role": "editor",
                  "resource": {
                    "object": "person"
                  },
                  "actions": [
                    "read",
                    "create",
                    "update",
                    "delete"
                  ],
                  "condition": null
                },
                "public_reads_people": {
                  "id": "public_reads_people",
                  "role": "public",
                  "resource": {
                    "object": "person"
                  },
                  "actions": [
                    "read"
                  ],
                  "condition": null
                },
                "public_reads_published": {
                  "id": "public_reads_published",
                  "role": "public",
                  "resource": {
                    "object": "note"
                  },
                  "actions": [
                    "read"
                  ],
                  "condition": {
                    "cmp": {
                      "op": "eq",
                      "left": {
                        "var": {
                          "scope": "record",
                          "field": "status"
                        }
                      },
                      "right": {
                        "lit": {
                          "str": "published"
                        }
                      }
                    }
                  }
                },
                "writers_add_people": {
                  "id": "writers_add_people",
                  "role": "writer",
                  "resource": {
                    "object": "person"
                  },
                  "actions": [
                    "create"
                  ],
                  "condition": null
                },
                "writers_edit_own": {
                  "id": "writers_edit_own",
                  "role": "writer",
                  "resource": {
                    "object": "note"
                  },
                  "actions": [
                    "update",
                    "delete"
                  ],
                  "condition": {
                    "cmp": {
                      "op": "eq",
                      "left": {
                        "var": {
                          "scope": "record",
                          "field": "$created_by"
                        }
                      },
                      "right": "principal"
                    }
                  }
                },
                "writers_read_notes": {
                  "id": "writers_read_notes",
                  "role": "writer",
                  "resource": {
                    "object": "note"
                  },
                  "actions": [
                    "read",
                    "create"
                  ],
                  "condition": null
                }
              },
              "workflows": {
                "note_status": {
                  "id": "note_status",
                  "object": "note",
                  "field": "status",
                  "initial": [
                    "draft"
                  ],
                  "transitions": [
                    {
                      "name": "publish",
                      "from": "draft",
                      "to": "published",
                      "guard": {
                        "cmp": {
                          "op": "eq",
                          "left": "principal",
                          "right": {
                            "lit": {
                              "str": "alpha:editor"
                            }
                          }
                        }
                      },
                      "set": {
                        "published_at": "now"
                      }
                    },
                    {
                      "name": "unpublish",
                      "from": "published",
                      "to": "draft",
                      "guard": null,
                      "set": {
                        "published_at": {
                          "lit": "null"
                        }
                      }
                    }
                  ]
                }
              },
              "queries": {},
              "views": {},
              "settings": {
                "theme": {
                  "id": "theme",
                  "label": "theme",
                  "type": "string",
                  "default": {
                    "str": "light"
                  },
                  "levels": [
                    "tenant",
                    "team",
                    "person"
                  ]
                }
              }
            },
            "members": {
              "alpha:editor": [
                "editor"
              ],
              "alpha:owner": [
                "owner"
              ],
              "alpha:writer1": [
                "writer"
              ],
              "alpha:writer2": [
                "writer"
              ]
            },
            "records": {
              "note": {
                "1": {
                  "id": 1,
                  "object": "note",
                  "version": 1,
                  "created-by": "alpha:writer1",
                  "created-at": 5000,
                  "updated-at": 5000,
                  "fields": {
                    "slug": {
                      "str": "first"
                    },
                    "status": {
                      "str": "draft"
                    },
                    "title": {
                      "str": "First"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "id": "error-kind-debug",
      "description": "The Rust Debug name of an ErrorKind ({:?}), as backend app.rs ApiError::domain writes it into the error body's kind.",
      "params": [
        {
          "name": "kind",
          "type": "error-kind"
        }
      ],
      "returns": "string",
      "body": "match kind { tenant-mismatch => 'TenantMismatch', tenant-exists => 'TenantExists', tenant-not-found => 'TenantNotFound', unauthorized => 'Unauthorized', unknown-object => 'UnknownObject', unknown-field => 'UnknownField', unknown-record => 'UnknownRecord', unknown-role => 'UnknownRole', unknown-query => 'UnknownQuery', type-mismatch => 'TypeMismatch', missing-required => 'MissingRequired', constraint-violated => 'ConstraintViolated', unique-violated => 'UniqueViolated', dangling-reference => 'DanglingReference', still-referenced => 'StillReferenced', workflow-violation => 'WorkflowViolation', version-conflict => 'VersionConflict', schema-conflict => 'SchemaConflict', invalid-schema => 'InvalidSchema', migration-rejected => 'MigrationRejected', insufficient-state => 'InsufficientState', evaluation => 'Evaluation', invalid-intent => 'InvalidIntent', limit-exceeded => 'LimitExceeded', idempotency-mismatch => 'IdempotencyMismatch' }",
      "examples": [
        {
          "args": {
            "kind": "unauthorized"
          },
          "result": "Unauthorized"
        },
        {
          "args": {
            "kind": "version-conflict"
          },
