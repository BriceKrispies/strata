            "type": "string",
            "label": "Group",
            "doc": "The subject heading the goal is listed under."
          },
          "ref": {
            "type": "string",
            "label": "Specification id",
            "doc": "The identifier as written in the the project specification.",
            "required": true
          },
          "source": {
            "type": "string",
            "label": "Source",
            "doc": "File and line in the repository where this was imported from."
          },
          "mentions": {
            "type": "list",
            "items": {
              "type": "ref",
              "ref": [
                "goal",
                "nonGoal",
                "boundary",
                "decision",
                "constraint",
                "openQuestion",
                "component"
              ]
            },
            "label": "Mentions",
            "doc": "Goals, non-goals, boundaries, decisions, constraints, open questions and components named in the text."
          }
        }
      },
      "nonGoal": {
        "label": "Non-goal",
        "section": "nonGoals",
        "shape": "sphere",
