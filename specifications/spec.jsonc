        }
      ]
    },
    {
      "id": "mutation",
      "name": "Mutation",
      "kind": "union",
      "encoding": {
        "tag": "internal",
        "tagField": "op",
        "variantCase": "snake_case"
      },
      "description": "strata_protocol::api::Mutation: a record mutation with plain JSON field values, the body of POST /api/records ({\"op\": \"create\" | \"update\" | \"delete\", object, id, fields, expected_version}); the backend coerces the fields by field type. The fields are plain-json, which the function language can take apart; on the wire they are raw JSON, which plain-json's external encoding is not (a gap of WG-4939: plain-json needs an untagged encoding).",
      "variants": [
        {
          "name": "create",
          "fields": [
            {
              "name": "object",
              "type": "string"
            },
            {
              "name": "fields",
              "type": "map<string, plain-json>"
            }
          ]
        },
        {
          "name": "update",
          "fields": [
            {
              "name": "object",
              "type": "string"
            },
            {
              "name": "id",
              "type": "u64"
            },
            {
              "name": "fields",
              "type": "map<string, plain-json>"
            },
            {
              "name": "expected-version",
              "type": "u64",
              "optional": true
            }
          ]
        },
        {
          "name": "delete",
          "fields": [
            {
              "name": "object",
              "type": "string"
            },
            {
              "name": "id",
              "type": "u64"
            },
            {
              "name": "expected-version",
              "type": "u64",
              "optional": true
            }
          ]
        }
      ]
    },
    {
      "id": "mutation-reply",
      "name": "Mutation Reply",
      "kind": "struct",
      "description": "strata_protocol::api::MutationReply: what an accepted record mutation answers. version is absent after a delete; event-seq is the tenant event sequence after the change; checks-passed counts the evidence of the transition.",
      "fields": [
        {
          "name": "object",
          "type": "string"
        },
        {
          "name": "id",
          "type": "u64"
        },
        {
          "name": "version",
          "type": "u64",
          "optional": true
        },
        {
          "name": "revision",
          "type": "u64"
        },
        {
          "name": "event-seq",
          "type": "u64"
        },
        {
          "name": "checks-passed",
          "type": "u64"
        }
      ]
    },
    {
      "id": "accepted-intent",
      "name": "Accepted Intent",
      "kind": "struct",
      "description": "What a decision of execute-intent and mutate-record hands its commit (commit-accepted, CT-262): the intent and the transition the kernel accepted, which storage-api Commit::of turns into the commit, and the record reply when the transition changed a record.",
      "fields": [
        {
          "name": "intent",
          "type": "intent"
        },
        {
          "name": "transition",
          "type": "transition-result"
        },
        {
          "name": "reply",
          "type": "mutation-reply",
          "optional": true
        }
      ]
    },
    {
      "id": "execute-failure",
      "name": "Execute Failure",
      "kind": "union",
      "encoding": {
        "tag": "external",
        "variantCase": "PascalCase"
      },
      "description": "Why a decision of execute-intent or execute-read did not go through: the kernel rejected it, or the snapshot lacked a need, which the derivation loads before deciding again (storage-api execute and query).",
      "variants": [
        {
          "name": "domain",
          "newtype": true,
          "fields": [
            {
              "name": "value",
              "type": "domain-error"
            }
          ]
        },
        {
          "name": "insufficient-state",
          "newtype": true,
          "fields": [
            {
              "name": "value",
              "type": "need"
            }
          ]
        }
      ]
    },
    {
      "id": "api-failure",
      "name": "Api Failure",
      "kind": "union",
      "encoding": {
        "tag": "external",
        "variantCase": "PascalCase"
      },
      "description": "Why a decision of mutate-record or read-view did not go through: a refusal answered with the error body (backend ApiError), or the snapshot lacked a need, which the derivation loads before deciding again.",
      "variants": [
        {
          "name": "rejected",
          "newtype": true,
          "fields": [
            {
              "name": "value",
              "type": "api-error"
            }
          ]
        },
        {
          "name": "insufficient-state",
          "newtype": true,
          "fields": [
            {
              "name": "value",
              "type": "need"
            }
          ]
        }
      ]
    },
    {
      "id": "route-segment",
      "name": "Route Segment",
      "kind": "union",
      "encoding": {
        "tag": "external",
        "variantCase": "PascalCase"
      },
      "description": "One segment of a view route as substrate project.rs match_route reads it: a literal, or :name, a parameter. The stand-in of splitting a route at / and stripping the :, which the function language cannot do yet (WG-4957).",
