          }
        },
        {
          "description": "An unknown object type is Unauthorized for a caller no policy could allow, not UnknownObject.",
          "args": {
            "d": {
              "fixture": "fx-draft-5"
            },
            "object": "nothing",
            "id": 42,
            "fields": {
              "title": {
                "str": "x"
              }
            },
            "expected-version": null
          },
          "error": {
            "rejected": {
              "kind": "unauthorized",
              "message": "User(PrincipalId(\"alpha:writer1\")) may not Update Object(ObjectTypeId(\"nothing\"))",
              "evidence": [
                {
                  "rule": "policy:none",
                  "passed": false,
                  "detail": "no policy grants Update on Object(ObjectTypeId(\"nothing\"))"
                }
              ],
              "missing": null
            }
          }
        },
        {
          "description": "A step cannot write what the caller could not write directly: the editor may update a note only while its published_at is unset; the publish step sets it, so the candidate the update becomes is refused when Update is authorised again after the assignments.",
          "args": {
            "d": {
              "fixture": "fx-draft-11",
              "with": {
                "tenant.schema.policies.editors_manage_notes.condition": {
                  "is-null": {
                    "var": {
                      "scope": "new",
                      "field": "published_at"
                    }
                  }
                }
              }
            },
            "object": "note",
            "id": 1,
            "fields": {
              "status": {
                "str": "published"
              }
            },
            "expected-version": null
          },
          "error": {
            "rejected": {
              "kind": "unauthorized",
              "message": "User(PrincipalId(\"alpha:editor\")) may not Update Object(ObjectTypeId(\"note\"))",
              "evidence": [
                {
                  "rule": "policy:editors_manage_notes",
                  "passed": true,
                  "detail": "Update on Object(ObjectTypeId(\"note\")) where is_null(new.published_at)"
                },
                {
                  "rule": "workflow:note_status:publish",
                  "passed": true,
                  "detail": "draft -> published"
                },
                {
                  "rule": "policy:editors_manage_notes",
                  "passed": false,
                  "detail": "is_null(new.published_at) is false"
                }
              ],
              "missing": null
            }
          }
        }
      ]
    },
    {
      "id": "ref-on-delete",
      "description": "The on_delete of value.rs FieldType::ref_target: of a reference, or of a list of references. Called only on reference fields; anything else is Restrict.",
      "params": [
        {
          "name": "ty",
          "type": "field-type"
        }
      ],
      "returns": "on-delete",
      "body": "match ty { ref{on-delete} => on-delete, list(inner) => match inner { ref{on-delete} => on-delete, _ => on-delete.restrict }, _ => on-delete.restrict }",
      "examples": [
        {
          "args": {
            "ty": {
              "ref": {
                "target": "person",
                "on-delete": "set-null"
              }
            }
          },
          "result": "set-null"
        },
        {
          "args": {
            "ty": {
              "list": {
                "ref": {
                  "target": "tag",
                  "on-delete": "restrict"
                }
              }
            }
          },
          "result": "restrict"
        }
      ]
    },
    {
      "id": "referrers",
      "description": "schema.rs TenantSchema::referrers: every field of every object type (both in id order) that refers to the target, directly or as a list.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "target",
          "type": "object-type-id"
        }
      ],
      "returns": "list<referrer>",
      "body": "fold(o in values(schema.objects), acc = [], concat(acc, fold(f in values(o.fields), fs = [], match call ref-target(f.ty) { Some(t) => if t == target then concat(fs, [referrer{object: o, field: f, is-list: match f.ty { list(_) => true, _ => false }, on-delete: call ref-on-delete(f.ty)}]) else fs, None => fs })))",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-6"
            },
            "target": "person"
          },
          "result": [
            {
              "object": {
                "id": "note",
                "label": "Note",
                "fields": {
                  "author": {
                    "id": "author",
                    "label": "Author",
                    "ty": {
                      "ref": {
                        "target": "person",
                        "on-delete": "set-null"
                      }
                    },
                    "required": false,
                    "unique": false
                  },
                  "body": {
                    "id": "body",
                    "label": "body",
                    "ty": "str",
                    "required": false,
                    "unique": false
                  },
                  "published_at": {
                    "id": "published_at",
                    "label": "published_at",
                    "ty": "time",
                    "required": false,
                    "unique": false
                  },
                  "rank": {
                    "id": "rank",
                    "label": "rank",
                    "ty": "int",
                    "required": false,
                    "unique": false
                  },
                  "slug": {
                    "id": "slug",
                    "label": "slug",
                    "ty": "str",
                    "required": true,
                    "unique": true
                  },
                  "status": {
                    "id": "status",
                    "label": "status",
                    "ty": "str",
                    "required": true,
                    "unique": false,
                    "default": {
                      "lit": {
                        "str": "draft"
                      }
                    }
                  },
                  "title": {
                    "id": "title",
                    "label": "title",
                    "ty": "str",
                    "required": true,
                    "unique": false
                  }
                },
                "constraints": {
                  "title_length": {
                    "id": "title_length",
                    "expr": {
                      "cmp": {
                        "op": "le",
                        "left": {
                          "len": {
                            "var": {
                              "scope": "new",
                              "field": "title"
                            }
                          }
                        },
                        "right": {
                          "lit": {
                            "int": 24
                          }
                        }
                      }
                    },
                    "message": "A title has at most 24 characters"
                  }
                }
              },
              "field": {
                "id": "author",
                "label": "Author",
                "ty": {
                  "ref": {
                    "target": "person",
                    "on-delete": "set-null"
                  }
                },
                "required": false,
                "unique": false
              },
              "is-list": false,
              "on-delete": "set-null"
            }
          ]
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-6"
            },
            "target": "note"
          },
          "result": []
        }
      ]
    },
    {
      "id": "delete-record",
      "description": "transition.rs delete_record: the object type and the stored record, Delete authorised (the record as old and new) before the version check; then for each referrer (schema referrers, in order) every record whose field refers to this one (rules.rs Lookup::by_field), except the record itself: a Restrict reference, or a required single reference, blocks the delete with StillReferenced (the lookup of a referrer comes before the block of the one before it is looked for, as in the loop of the kernel); any other adds reference:<object>.<field> \"cleared on ...\" to the evidence. Then each record that refers to this one, in the order of object type and record id, is rewritten once with every field that refers to this one cleared (removed from a list, unset otherwise; version one higher, updated now): a PutRecord and a RecordUpdated event per record, not per field; last the DeleteRecord and a RecordDeleted event. (WG-5094)",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "id",
          "type": "record-id"
        },
        {
          "name": "expected-version",
          "type": "option<u64>"
        }
      ],
      "returns": "decided",
      "errors": "rejection",
      "let": [
        {
          "name": "def",
          "expr": "try call object-def(d, object, action.delete)"
        },
        {
          "name": "old",
          "expr": "try call stored(d, object, id, action.delete)"
        },
        {
          "name": "d1",
          "expr": "try call require(d, action.delete, resource.object(object), subject{old, new: old})"
        },
        {
          "name": "d2",
          "expr": "try call check-version(d1, old, expected-version)"
        },
        {
          "name": "target",
          "expr": "value.ref(id)"
        },
        {
          "name": "scan",
          "expr": "fold(rf in call referrers(d2.tenant.schema, object), sc = delete-scan{draft: d2, hits: []}, fold(r in filter(r in try call lookup-by-field(sc.draft.tenant, sc.draft.coverage, rf.object.id, rf.field.id, target), !(r.id == id && rf.object.id == object)), s2 = sc, let rule = format('reference:{}.{}', rf.object.id, rf.field.id) in if rf.on-delete == on-delete.restrict || (rf.field.required && !rf.is-list) then fail(call draft-reject(concat(s2.draft.evidence, [check{rule, passed: false, detail: format('{} {} still refers to this record', rf.object.id, r.id)}]), error-kind.still-referenced, format('{} {} refers to {} {}', rf.object.id, r.id, object, id))) else delete-scan{draft: draft{tenant: s2.draft.tenant, ctx: s2.draft.ctx, coverage: s2.draft.coverage, ops: s2.draft.ops, events: s2.draft.events, effects: s2.draft.effects, evidence: concat(s2.draft.evidence, [check{rule, passed: true, detail: format('cleared on {} {}', rf.object.id, r.id)}]), next-record: s2.draft.next-record}, hits: concat(s2.hits, [referrer-hit{referrer: rf, record: r}])}))"
        },
        {
          "name": "firsts",
          "expr": "fold(h in sortBy(h2 in sortBy(h1 in scan.hits, h1.record.id), h2.record.object), acc = [], if any(a in acc, a.record.object == h.record.object && a.record.id == h.record.id) then acc else concat(acc, [h]))"
        }
      ],
      "body": "let d3 = scan.draft in decided{draft: draft{tenant: d3.tenant, ctx: d3.ctx, coverage: d3.coverage, ops: concat(concat(d3.ops, map(h in firsts, delta-op.put-record(call cleared-record(h.record, scan.hits, target, d3.ctx.now)))), [delta-op.delete-record{object, id}]), events: concat(concat(d3.events, map(h in firsts, event-body.record-updated{before: h.record, after: call cleared-record(h.record, scan.hits, target, d3.ctx.now)})), [event-body.record-deleted{before: old}]), effects: d3.effects, evidence: d3.evidence, next-record: d3.next-record}, output: output.deleted{object, id}}",
      "examples": [
        {
          "description": "behaviour.rs deleting_a_referenced_record_clears_set_null_references: one update for the cleared note, one delete.",
          "args": {
            "d": {
              "fixture": "fx-draft-12"
            },
            "object": "person",
            "id": 1,
            "expected-version": null
          },
          "result": {
