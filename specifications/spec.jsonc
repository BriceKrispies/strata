        {
          "description": "A condition that fails to evaluate (len of a reference) hides the field.",
          "args": {
            "t": {
              "fixture": "fx-tenant-state-13",
              "with": {
                "schema.objects.post.fields.author.read": {
                  "len": {
                    "var": {
                      "scope": "record",
                      "field": "author"
                    }
                  }
                }
              }
            },
            "coverage": "complete",
            "principal": {
              "user": "alpha:owner"
            },
            "now": 3000,
            "r": {
              "id": 2,
              "object": "post",
              "version": 1,
              "created-by": "alpha:writer",
              "created-at": 2000,
              "updated-at": 2000,
              "fields": {
                "author": {
                  "ref": 1
                },
