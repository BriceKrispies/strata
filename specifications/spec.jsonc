                    },
                    {
                      "name": "unpublish",
                      "from": "published",
                      "to": "draft",
                      "guard": null,
                      "set": {
                        "published_at": {
                          "lit": "null"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "define-field": {
                  "object": "tag",
                  "field": {
                    "id": "who",
                    "label": "who",
                    "ty": {
                      "list": {
                        "ref": {
                          "target": "person",
                          "on-delete": "restrict"
                        }
                      }
                    },
                    "required": false,
                    "unique": false
                  }
                }
              }
            ]
          },
          "result": [
            "note",
            "person",
            "tag"
          ]
        },
