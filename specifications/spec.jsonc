          "type": "draft"
        },
        {
          "name": "candidate",
          "type": "record"
        }
      ]
    },
    {
      "id": "referrer",
      "name": "Referrer",
      "kind": "struct",
      "description": "schema.rs TenantSchema::referrers: a reference field that points at an object type, with whether it is a list and what deleting the target does.",
      "fields": [
        {
          "name": "object",
          "type": "object-type-def"
        },
