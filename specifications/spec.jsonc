      "transitions": [
        {
          "id": "rd-render-t-i",
          "from": "rd-live-i",
          "to": "rd-live-i",
          "on": "rd-render",
          "otherwise": true,
          "effects": [
            {
              "set": "messages",
              "to": "messages + 1"
            },
            {
              "set": "htmlParts",
              "to": "htmlParts + 1"
            },
            {
              "set": "textParts",
              "to": "textParts + 1"
            },
            {
              "emit": "rd-rendered",
              "to": "runtime"
            }
          ]
