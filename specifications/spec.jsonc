      "behaviors": [
        "code-spend-flow-impl"
      ],
      "steps": [
        {
          "at": 0,
          "event": "cs-presented",
          "payload": {
            "guess": "wrong"
          }
        },
        {
          "at": 1,
          "event": "cs-presented",
          "payload": {
            "guess": "right"
          }
        }
      ]
    },
