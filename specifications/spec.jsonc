    {"id":"preview-presentation-in-transit-impl","name":"A preview presented in transit after its expiry (implementation)","description":"The link is issued at 0 and presented 2 minutes later, but the presentation reaches the gateway 30 minutes after that, past its expiry of 15 minutes. Times are in milliseconds. The same scenario run on the implementation machines.","behaviors":["preview-link-flow-impl"],"faults":["preview-presentation-delayed-impl"],"steps":[{"at":0,"event":"pl-issue"},{"at":120000,"event":"pl-presented","note":"Sent after 2 minutes, delivered 30 minutes later."}],"timeUnit":"ms"},
