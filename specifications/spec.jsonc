    {"id":"agent-traffic-switch-calls-agent-gateway","kind":"calls","from":"agent-traffic-switch","to":"agent-gateway","description":"Agent requests of the live colour reach its agent gateway instances."},
    {"id":"str-runtime-reads-copy-store","kind":"reads","from":"runtime","to":"copy-store","description":"The runtime answers from its stored view copies, and from the tenant database while the copy store is out."},
    {"id":"str-agent-gateway-reads-audit","kind":"reads","from":"agent-gateway","to":"audit-log","description":"An audit query by an agent reads the entries that the policies of its principal permit it to read."},
    {"id":"str-mail-service-reports-to-dispatcher","kind":"data-flow","from":"mail-service","to":"mail-dispatcher","description":"Delivery reports, bounces and complaints, signed by the provider, return to the dispatcher."},
    {"id":"str-gateway-reads-file-store","kind":"reads","from":"gateway","to":"file-store","description":"The gateway serves tenant files from the file domain of the platform."},
    {"id":"str-gateway-calls-notification-service","kind":"calls","from":"gateway","to":"notification-service","description":"A principal reads its inbox through the gateway, which the notification service answers."},
    {"id":"str-agent-gateway-reads-search-index","kind":"reads","from":"agent-gateway","to":"search-index","description":"Search requests of agents are answered from the search entries, filtered by the policies of the requester."},
    {"id":"str-gateway-calls-subject-rights-service","kind":"calls","from":"gateway","to":"subject-rights-service","description":"An export, rectification, restriction or erasure request for one data subject is carried out through the subject rights service."},
    {"id":"str-release-pipeline-calls-release-controller","kind":"calls","from":"release-pipeline","to":"release-controller","description":"A built and signed release, named by its commit, is handed to the release controller, which runs its promotion gates."},
    {"id":"str-identity-writes-limit-store","kind":"writes","from":"identity-service","to":"limit-store","description":"Emailed sign-in links and sign-up requests are counted in the shared limit store."},
    {"id":"str-automation-worker-calls-notification-service","kind":"calls","from":"automation-worker","to":"notification-service","description":"Workflow tasks are handed to the notification service, which turns them into notices."},
    {"id":"str-identity-calls-outbound-gate","kind":"calls","from":"identity-service","to":"outbound-gate","description":"Federation metadata and keys are fetched through the outbound gate."},
    {"id":"str-upload-scanner-writes-file-store","kind":"writes","from":"upload-scanner","to":"file-store","description":"Renditions produced from a stored file are written to the file namespace of its tenant."},
    {"id":"str-subject-rights-writes-copy-store","kind":"writes","from":"subject-rights-service","to":"copy-store","description":"Erasure reaches each stored copy that holds a field of the principal, and removes it within its bound."},
    {"id":"str-subject-rights-writes-search-index","kind":"writes","from":"subject-rights-service","to":"search-index","description":"Erasure reaches each search entry built from a record of the principal."},
    {"id":"str-subject-rights-reads-file-store","kind":"reads","from":"subject-rights-service","to":"file-store","description":"An export for one principal includes the files that name the principal."},
    {"id":"str-operator-console-reads-fleet-reporting","kind":"reads","from":"operator-console","to":"fleet-reporting","description":"An operator report that spans tenants is answered from telemetry and published summaries."},
    {"id":"str-postgres-adapter-reads-backups","kind":"reads","from":"postgres-adapter","to":"backup-archive","description":"A restore reads an encrypted backup image of a tenant database or of the control database."},
    {"id":"str-store-contract-reaches-sqlite","kind":"data-flow","from":"store-contract","to":"sqlite-adapter","description":"Calls through the contract are carried out by the SQLite adapter in tests and simulation."},
    {"id":"str-telemetry-observes-connector-runner","kind":"observes","from":"telemetry-pipeline","to":"connector-runner","description":"Telemetry of the connector runner."},
    {"id":"str-telemetry-observes-outbound-gate","kind":"observes","from":"telemetry-pipeline","to":"outbound-gate","description":"Telemetry of the outbound gate."},
    {"id":"str-telemetry-observes-upload-scanner","kind":"observes","from":"telemetry-pipeline","to":"upload-scanner","description":"Telemetry of the upload scanner."},
    {"id":"str-telemetry-observes-notification-service","kind":"observes","from":"telemetry-pipeline","to":"notification-service","description":"Telemetry of the notification service."},
    {"id":"str-telemetry-observes-subject-rights-service","kind":"observes","from":"telemetry-pipeline","to":"subject-rights-service","description":"Telemetry of the subject rights service."},
    {"id":"str-telemetry-observes-operator-console","kind":"observes","from":"telemetry-pipeline","to":"operator-console","description":"Telemetry of the operator console."},
    {"id":"str-telemetry-observes-limit-store","kind":"observes","from":"telemetry-pipeline","to":"limit-store","description":"Telemetry of the limit store."},
    {"id":"str-telemetry-observes-wake-queue","kind":"observes","from":"telemetry-pipeline","to":"notice-queue","description":"Telemetry of the notice queue."},
    {"id":"str-telemetry-observes-key-service","kind":"observes","from":"telemetry-pipeline","to":"key-service","description":"Telemetry of the key service."},
    {"id":"str-telemetry-observes-release-controller","kind":"observes","from":"telemetry-pipeline","to":"release-controller","description":"Telemetry of the release controller."},
    {"id":"str-telemetry-observes-traffic-switch","kind":"observes","from":"telemetry-pipeline","to":"traffic-switch","description":"Telemetry of the traffic switch."},
    {"id":"str-telemetry-observes-release-pipeline","kind":"observes","from":"telemetry-pipeline","to":"release-pipeline","description":"Telemetry of the release pipeline."},
    {"id":"str-telemetry-observes-image-registry","kind":"observes","from":"telemetry-pipeline","to":"image-registry","description":"Telemetry of the image registry."},
    {"id":"str-telemetry-observes-agent-traffic-switch","kind":"observes","from":"telemetry-pipeline","to":"agent-traffic-switch","description":"Telemetry of the agent listener of the traffic switch."},
    {"id":"str-telemetry-observes-migration-job","kind":"observes","from":"telemetry-pipeline","to":"migration-job","description":"Telemetry of the migration job."},
    {"id":"str-telemetry-observes-platform-audit-store","kind":"observes","from":"telemetry-pipeline","to":"platform-audit-store","description":"Telemetry of the platform audit store."},
    {"id":"str-telemetry-observes-backup-archive","kind":"observes","from":"telemetry-pipeline","to":"backup-archive","description":"Metrics, traces and logs of the backup archive."},
    {"id":"str-telemetry-observes-search-index","kind":"observes","from":"telemetry-pipeline","to":"search-index","description":"Metrics, traces and logs of the search index."},
    {"id":"str-telemetry-observes-file-store","kind":"observes","from":"telemetry-pipeline","to":"file-store","description":"Metrics, traces and logs of the file store."},
    {"id":"str-telemetry-observes-copy-store","kind":"observes","from":"telemetry-pipeline","to":"copy-store","description":"Metrics, traces and logs of the copy store."},
    {"id":"str-telemetry-observes-tenant-database","kind":"observes","from":"telemetry-pipeline","to":"tenant-database","description":"Metrics, traces and logs of the tenant databases."},
    {"id":"str-telemetry-observes-local-model-adapter","kind":"observes","from":"telemetry-pipeline","to":"local-model-adapter","description":"Telemetry of the local model adapter."},
    {"id":"telemetry-observes-agent-gateway","kind":"observes","from":"telemetry-pipeline","to":"agent-gateway","description":"Telemetry of the agent gateway."},
    {"id":"sqlite-records-to-runtime","kind":"data-flow","from":"sqlite-adapter","to":"runtime","description":"Tenant records, read from the tenant file through the store contract, reach the runtime, which builds the views and search entries it copies from them."},
    {"id":"sqlite-records-to-conversation","kind":"data-flow","from":"sqlite-adapter","to":"conversation-service","description":"Tenant records, read from the tenant file through the store contract, reach the conversation service, which puts what the tenant policy permits into a model request."}
  ],

  // ---- White paper: goals, non-goals, boundaries, decisions, constraints, open questions ---------
  "goals": [
    {"id":"g-1","statement":"Each tenant has a database of its own, so a tenant can be backed up, restored, moved, exported and deleted as one unit.","stage":"R0","group":"Tenancy","ref":"G-1"},
    {"id":"g-2","statement":"A tenant is provisioned from a template with no manual step and is usable as soon as provisioning reports success.","stage":"R0","group":"Tenancy","ref":"G-2"},
    {"id":"g-3","statement":"A tenant can be placed in a chosen region and moved between database clusters without a change of address.","stage":"R0","group":"Tenancy","ref":"G-3"},
    {"id":"g-4","statement":"The load of one tenant cannot exhaust capacity that another tenant depends on.","stage":"R0","group":"Tenancy","ref":"G-4"},
    {"id":"g-5","statement":"Tenant structure stays versioned data interpreted by one deterministic kernel, as in the prototype.","stage":"R0","group":"Tenancy","ref":"G-5"},
    {"id":"g-6","statement":"A person can sign in with a password, a passkey, an emailed link, an OpenID Connect provider or a SAML provider, as the tenant configures.","stage":"R1","group":"Identity","ref":"G-6"},
    {"id":"g-7","statement":"An organisation can require its own identity provider for its people and have them provisioned and deprovisioned from it.","stage":"R1","group":"Identity","ref":"G-7"},
    {"id":"g-8","statement":"A tenant can require a second factor, and sensitive operations can require a recent authentication.","stage":"R1","group":"Identity","ref":"G-8"},
    {"id":"g-9","statement":"Sessions can be listed and revoked, and a revocation takes effect everywhere within a stated bound.","stage":"R1","group":"Identity","ref":"G-9"},
    {"id":"g-10","statement":"Services and agents have identities of their own, with scoped credentials that expire.","stage":"R1","group":"Identity","ref":"G-10"},
    {"id":"g-11","statement":"Every authentication decision is recorded with enough evidence to explain it afterwards.","stage":"R1","group":"Identity","ref":"G-11"},
    {"id":"g-12","statement":"One identity service is the only component that handles credentials, and every other component learns who is calling from what it signs.","stage":"R1","group":"Identity","ref":"G-12"},
    {"id":"g-13","statement":"A tenant can schedule work at a time, on a recurring rule or in response to an event.","stage":"R2","group":"Automation","ref":"G-13"},
    {"id":"g-14","statement":"Scheduled work survives the failure of a process or a host and ends in a recorded outcome.","stage":"R2","group":"Automation","ref":"G-14"},
    {"id":"g-15","statement":"An external effect is applied once even when the job that causes it is attempted more than once.","stage":"R2","group":"Automation","ref":"G-15"},
    {"id":"g-16","statement":"Workflows are tenant metadata and are projected against history before activation, like any schema change.","stage":"R2","group":"Automation","ref":"G-16"},
    {"id":"g-17","statement":"Content can be published and withdrawn at a scheduled time.","stage":"R2","group":"Automation","ref":"G-17"},
    {"id":"g-18","statement":"Published content is served from stored copies near readers without a query to the tenant database on each request.","stage":"R2","group":"Delivery","ref":"G-18"},
    {"id":"g-19","statement":"A committed change is visible to readers within a stated bound.","stage":"R2","group":"Delivery","ref":"G-19"},
    {"id":"g-20","statement":"No reader receives another tenant's content, or content their role may not read, from any stored copy or any interface.","stage":"R2","group":"Delivery","ref":"G-20"},
    {"id":"g-21","statement":"A tenant can serve its site from its own domain names, with certificates the platform manages.","stage":"R2","group":"Delivery","ref":"G-21"},
    {"id":"g-22","statement":"Deleting data removes it from every stored copy within a stated bound.","stage":"R2","group":"Delivery","ref":"G-22"},
    {"id":"g-23","statement":"Everything an operator can observe or change, an agent can observe or change through a documented, typed interface.","stage":"R3","group":"Agents","ref":"G-23"},
    {"id":"g-24","statement":"An agent can find out what it may do, what an operation needs and what it would change, before doing it.","stage":"R3","group":"Agents","ref":"G-24"},
    {"id":"g-25","statement":"Every change made by an agent is attributable to the agent and to the person it acted for, and is reversible where the operation allows.","stage":"R3","group":"Agents","ref":"G-25"},
    {"id":"g-26","statement":"A risky change passes through a proposal that is projected and then approved under the tenant's policy.","stage":"R3","group":"Agents","ref":"G-26"},
    {"id":"g-27","statement":"The platform describes its own state (health, configuration, topology, recent failures) in machine-readable form.","stage":"R3","group":"Agents","ref":"G-27"},
    {"id":"g-28","statement":"The reach of an agent can be limited in scope and in volume, and cut off at once.","stage":"R3","group":"Agents","ref":"G-28"},
    {"id":"g-29","statement":"One request can be followed through every component by one identifier.","stage":"R3","group":"Observability","ref":"G-29"},
    {"id":"g-30","statement":"Security-relevant actions are kept in an append-only record that reveals tampering.","stage":"R3","group":"Observability","ref":"G-30"},
    {"id":"g-31","statement":"Content types, relationships, workflows, queries and views are defined by tenants as data.","stage":"R4","group":"Content","ref":"G-31"},
    {"id":"g-32","statement":"Every published version of a record can be retrieved, compared and restored.","stage":"R4","group":"Content","ref":"G-32"},
    {"id":"g-33","statement":"Media files are stored, turned into renditions and delivered with the same isolation as records.","stage":"R4","group":"Content","ref":"G-33"},
    {"id":"g-34","statement":"Content can exist in several languages, with a fallback.","stage":"R4","group":"Content","ref":"G-34"},
    {"id":"g-35","statement":"An author can preview unpublished content exactly as it would be delivered.","stage":"R4","group":"Content","ref":"G-35"},
    {"id":"g-36","statement":"The whole platform runs on one machine in containers, with no cloud account.","stage":"R0","group":"Platform","ref":"G-36"},
    {"id":"g-37","statement":"The same component images deploy to a cloud provider through adapters, Amazon Web Services first.","stage":"R4","group":"Platform","ref":"G-37"},
    {"id":"g-38","statement":"Every dependency on infrastructure sits behind a contract with a conformance suite and at least two adapters.","stage":"R0","group":"Platform","ref":"G-38"},
    {"id":"g-39","statement":"The platform recovers from the loss of a zone within stated objectives, and any tenant can be restored to a point in time.","stage":"R4","group":"Platform","ref":"G-39"},
    {"id":"g-40","statement":"Tenant data and secrets are encrypted under a key held for that tenant, and destroying the key makes them unreadable.","stage":"R1","group":"Platform","ref":"G-40"},
    {"id":"g-41","statement":"Every requirement is tied to a proof whose recorded result Concordance checks.","stage":"R0","group":"Assurance","ref":"G-41"},
    {"id":"g-42","statement":"Behaviour that matters under failure is modelled and checked in Exegra before it is built.","stage":"R0","group":"Assurance","ref":"G-42"},
    {"id":"g-43","statement":"The core properties of the kernel stay machine-checked as it grows.","stage":"R0","group":"Assurance","ref":"G-43"},
    {"id":"g-44","statement":"A proposed change to tenant metadata can be projected against recorded history before it is made.","stage":"R0","group":"Assurance","ref":"G-44"},
    {"id":"g-45","statement":"The sign-in pages and the authoring application meet WCAG 2.2 level AA.","stage":"R4","group":"Assurance","ref":"G-45"},
    {"id":"g-46","statement":"Sign-in resists enumeration of accounts, guessing of credentials, replay of one-time material and takeover through federation.","stage":"R1","group":"Identity","ref":"G-46"},
    {"id":"g-100","statement":"Operators can answer questions that span tenants without reading the data of any tenant.","stage":"R3","group":"Observability","ref":"G-100"},
    {"id":"g-101","statement":"Reads of a tenant's directory entry and published content keep working through the loss of the control plane.","stage":"R2","group":"Delivery","ref":"G-101"},
    {"id":"g-102","statement":"Adding a tenant adds no load to a shared component that grows with the number of tenants.","stage":"R2","group":"Tenancy","ref":"G-102"},
    {"id":"g-103","statement":"A product feature is added as tenant metadata and modules, with no change to the kernel.","stage":"R0","group":"Platform","ref":"G-103"},
    {"id":"g-104","statement":"Stored formats and layouts change while the versions that read them run together.","stage":"R4","group":"Platform","ref":"G-104"},
    {"id":"g-150","statement":"An author can create and edit records of tenant-defined content types in the authoring application, and an edit reaches readers only when it is published.","stage":"R2","group":"Content","ref":"G-150"},
    {"id":"g-151","statement":"A tenant can require that the people it names review a record before it is published.","stage":"R2","group":"Content","ref":"G-151"},
    {"id":"g-152","statement":"A tenant's application can read published content through a documented delivery interface with field selection, paging and filtering.","stage":"R2","group":"Delivery","ref":"G-152"},
    {"id":"g-153","statement":"A tenant can define roles and teams, and each person can do only what the roles that reach them allow.","stage":"R1","group":"Identity","ref":"G-153"},
    {"id":"g-154","statement":"A new organisation can start a sandbox tenant from a template without contacting the platform operator, and keep it or let it expire.","stage":"R1","group":"Tenancy","ref":"G-154"},
    {"id":"g-155","statement":"People receive the tasks and notices that concern them in an inbox or by email, and no notice shows a record its recipient cannot read.","stage":"R2","group":"Automation","ref":"G-155"},
    {"id":"g-156","statement":"Other systems can start a tenant's workflows through signed webhooks, and a tenant can see the outcome of each webhook it sends.","stage":"R2","group":"Automation","ref":"G-156"},
    {"id":"g-157","statement":"Each tenant has a plan whose quotas are enforced, its metered use is counted, and the counts can be sent to its billing system.","stage":"R2","group":"Business","ref":"G-157"},
    {"id":"g-158","statement":"A reviewer without an account can see a draft exactly as it would be delivered, through a link that expires.","stage":"R2","group":"Content","ref":"G-158"},
    {"id":"g-159","statement":"The addresses of published pages keep working when a page moves, and search engines can find every published page of a site.","stage":"R2","group":"Delivery","ref":"G-159"},
    {"id":"g-160","statement":"A tenant owner can export all of the tenant's data, and can delete the tenant after a grace period during which the deletion can be cancelled.","stage":"R2","group":"Tenancy","ref":"G-160"},
    {"id":"g-161","statement":"Visitors can search a tenant's published content, and editors can search the drafts they are permitted to read.","stage":"R4","group":"Content","ref":"G-161"},
    {"id":"g-162","statement":"A tenant can collect submissions from a form on its site, and each submission is stored, notified and exportable.","stage":"R4","group":"Content","ref":"G-162"},
    {"id":"g-163","statement":"Records can be exported and imported as documents in the tenant's own format, and a copy imported elsewhere keeps the identifiers and versions of its records.","stage":"R4","group":"Content","ref":"G-163"},
    {"id":"g-164","statement":"A tenant's configuration can be promoted from a staging tenant to its production tenant through a proposal that production approves, with content kept apart.","stage":"R3","group":"Platform","ref":"G-164"},
    {"id":"g-165","statement":"Platform operators act in a tenant only under a support grant that the tenant owner issued, and every act they make is recorded.","stage":"R1","group":"Identity","ref":"G-165"},
    {"id":"g-166","statement":"Customers can see the limits that apply to them and the changes to the delivery interface, and an old delivery version stays served for a stated period.","stage":"R2","group":"Delivery","ref":"G-166"},
    {"id":"g-167","statement":"A tenant can install a template or an integration that the platform publishes, after seeing what it changes.","stage":"R3","group":"Platform","ref":"G-167"},
    {"id":"g-168","statement":"The platform publishes, for each plan, the objectives it measures and the results measured each month.","stage":"R4","group":"Business","ref":"G-168"},
    {"id":"g-200","statement":"A person can do in conversation everything they can do in the authoring application, and the assistant acts with that person's permissions and no more.","stage":"R3","group":"Conversation","ref":"G-200"},
    {"id":"g-201","statement":"Every change an assistant makes is previewed, and is applied only when the person confirms it.","stage":"R3","group":"Conversation","ref":"G-201"},
    {"id":"g-202","statement":"A person can ask why an action was refused, what it would do, what changed and who changed it, and the answer names its sources.","stage":"R3","group":"Conversation","ref":"G-202"},
    {"id":"g-203","statement":"The conversation and the direct interface are one interface: a person can move between them at any point and sees the effect of each in the other.","stage":"R3","group":"Conversation","ref":"G-203"},
    {"id":"g-204","statement":"The conversation works with a keyboard, a screen reader, reduced motion, a small screen and a poor network connection.","stage":"R3","group":"Conversation","ref":"G-204"},
    {"id":"g-205","statement":"A tenant can turn the assistant off, and tenant content reaches a model provider only under the tenant's policy.","stage":"R3","group":"Conversation","ref":"G-205"},
    {"id":"g-206","statement":"Editing in the authoring application keeps unsaved and conflicting work from being lost, and shows who else is editing.","stage":"R4","group":"Authoring","ref":"G-206"},
    {"id":"g-207","statement":"A new tenant is set up through the conversation, with a template, its content types and its people.","stage":"R4","group":"Authoring","ref":"G-207"},
    {"id":"g-250","statement":"A page of a tenant cannot run script, load a frame or submit a form that the tenant did not publish.","stage":"R2","group":"Security","ref":"G-250"},
    {"id":"g-251","statement":"Attempts to guess a password are limited by the account, by the source and by the platform as a whole.","stage":"R1","group":"Security","ref":"G-251"},
    {"id":"g-252","statement":"Sign-in, sign-up, recovery and provisioning reveal nothing about which accounts exist.","stage":"R1","group":"Security","ref":"G-252"},
    {"id":"g-253","statement":"A person whose account is attacked is told, and can end every session that the attacker holds.","stage":"R1","group":"Security","ref":"G-253"},
    {"id":"g-254","statement":"A session cookie reaches only the host that set it.","stage":"R1","group":"Security","ref":"G-254"},
    {"id":"g-255","statement":"Federation accepts a provider's message only after every field that binds it to this tenant, this client and this request has been checked.","stage":"R1","group":"Security","ref":"G-255"},
    {"id":"g-256","statement":"Each component accepts a connection only from the components the architecture names as its callers, and the operator console is reachable only from the operations network.","stage":"R0","group":"Security","ref":"G-256"},
    {"id":"g-257","statement":"A tenant cannot make the platform contact an address that the outbound rule forbids, by any name, encoding or redirect.","stage":"R2","group":"Security","ref":"G-257"},
    {"id":"g-258","statement":"An operator or a support person reads tenant content only under a grant that the tenant gave and that ends.","stage":"R1","group":"Security","ref":"G-258"},
    {"id":"g-259","statement":"Every component image that runs can be traced to the source and the build that produced it, and to the dependencies it contains.","stage":"R0","group":"Security","ref":"G-259"},
    {"id":"g-260","statement":"A tenant's upload is stored, scanned and delivered without being run and without exhausting the platform.","stage":"R4","group":"Security","ref":"G-260"},
    {"id":"g-261","statement":"A tenant's keys can be rotated while the tenant is in service, and a compromised key can be retired at once.","stage":"R1","group":"Security","ref":"G-261"},
    {"id":"g-262","statement":"Abuse by one tenant or one source does not degrade the platform for others, and a tenant domain used for abuse can be taken down.","stage":"R2","group":"Security","ref":"G-262"},
    {"id":"g-263","statement":"No principal widens its own authority through an operation, an approval, an export or a change to roles and policies.","stage":"R3","group":"Security","ref":"G-263"},
    {"id":"g-264","statement":"An export or a generated file contains no formula or markup that a reader's application would run.","stage":"R2","group":"Security","ref":"G-264"},
    {"id":"g-265","statement":"Security problems reported to the platform are received, fixed and disclosed to the tenants they affect.","stage":"R0","group":"Security","ref":"G-265"},
    {"id":"g-266","statement":"A tenant's database credentials reach only that tenant's database, and a compromised runtime instance reaches no other tenant.","stage":"R1","group":"Security","ref":"G-266"},
    {"id":"g-267","statement":"The edge serves a copy of a page only to the requests that the copy was made for.","stage":"R2","group":"Security","ref":"G-267"},
    {"id":"g-300","statement":"Each tenant-facing surface has a stated availability objective and latency objectives for its reads and writes, and its alerts come from the error budget those objectives leave.","stage":"R3","group":"Operations","ref":"G-300"},
    {"id":"g-301","statement":"The failure of one dependency or one tenant leaves the work that does not need it answering, and overload is refused early rather than answered late.","stage":"R2","group":"Resilience","ref":"G-301"},
    {"id":"g-302","statement":"Each tenant database can be restored to a moment within a stated window, and corruption is found by the platform before a reader finds it.","stage":"R4","group":"Data safety","ref":"G-302"},
    {"id":"g-303","statement":"A release or a layout change reaches tenants in stages, can be undone, and stops itself when its own criteria fail.","stage":"R2","group":"Change","ref":"G-303"},
    {"id":"g-304","statement":"An operator or an agent can diagnose one tenant and act on an alert from the platform's own description, without reading the code.","stage":"R3","group":"Operations","ref":"G-304"},
    {"id":"g-350","statement":"A person whose personal data a tenant holds can obtain it, have it corrected or restricted, and have it erased, with each request ending in a recorded answer.","stage":"R2","group":"Privacy","ref":"G-350"},
    {"id":"g-351","statement":"Every place that holds personal data is declared in the data model with its owner, its personal fields and its retention.","stage":"R0","group":"Privacy","ref":"G-351"},
    {"id":"g-352","statement":"Erasing a person leaves the tamper-evident audit record intact and records what was erased.","stage":"R3","group":"Privacy","ref":"G-352"},
    {"id":"g-353","statement":"A tenant's personal data is stored, copied, backed up and sent only within the region of its placement, and each transfer out of it is named.","stage":"R4","group":"Privacy","ref":"G-353"},
    {"id":"g-354","statement":"Access by platform staff to a tenant's data is granted for a stated purpose, expires, is visible to the tenant and is refused where the tenant forbids it.","stage":"R3","group":"Privacy","ref":"G-354"},
    {"id":"g-355","statement":"Retention is set per record type by the tenant, and a legal hold suspends the erasure and the expiry of the records it names.","stage":"R2","group":"Privacy","ref":"G-355"},
    {"id":"g-356","statement":"The platform produces the compliance evidence an auditor asks for: processing records, change approvals, encryption statements and access reports.","stage":"R3","group":"Privacy","ref":"G-356"},
    {"id":"g-400","statement":"A run of an agent can be explained afterwards from its recorded inputs, operations and outcomes, by the owner of each tenant the run touched.","stage":"R3","group":"Agents","ref":"G-400"},
    {"id":"g-401","statement":"An agent is held to the authority of the person it acts for, and it cannot widen that authority, change the rules that constrain it, or switch off its own record or its own halt.","stage":"R3","group":"Agents","ref":"G-401"},
    {"id":"g-402","statement":"Text that an agent reads from a tenant, a file, a webhook, an error, another agent or a log line cannot direct the agent beyond the authority of the person it acts for.","stage":"R3","group":"Agents","ref":"G-402"},
    {"id":"g-403","statement":"The reach of change made by an agent is bounded in volume, in time and in reversibility, and it stops when an anomaly appears.","stage":"R3","group":"Agents","ref":"G-403"},
    {"id":"g-404","statement":"Agents that operate the platform itself have identities of their own and pass stricter approval than agents that serve a tenant.","stage":"R3","group":"Agents","ref":"G-404"},
    {"id":"g-405","statement":"An agent cannot take data out of the platform to an address that the tenant has not allowed.","stage":"R3","group":"Agents","ref":"G-405"},
    {"id":"g-450","statement":"A tenant defines named tokens whose values are computed by expressions, and uses them in any content a reader sees and in email.","stage":"R2","group":"Content","ref":"G-450"},
    {"id":"g-451","statement":"A token shows each reader only what that reader is permitted to read, and its value arrives as text, not as markup.","stage":"R2","group":"Content","ref":"G-451"},
    {"id":"g-452","statement":"The platform sends email through one contract, and the provider behind it is a matter of configuration.","stage":"R1","group":"Platform","ref":"G-452"},
    {"id":"g-453","statement":"Mail of a tenant comes from the tenant's own proved domain, respects bounces, complaints and unsubscription, and is delivered once.","stage":"R2","group":"Automation","ref":"G-453"},
    {"id":"g-550","statement":"Each component image is built once, is addressed by its digest, and runs unchanged in every environment that runs it.","stage":"R0","group":"Platform","ref":"G-550"},
    {"id":"g-551","statement":"The image that passes the gate in the stage environment is the image that production runs.","stage":"R4","group":"Platform","ref":"G-551"},
    {"id":"g-552","statement":"Production changes without refusing a request, and the previous colour stays available so that switching back is a single operation.","stage":"R4","group":"Platform","ref":"G-552"},
    {"id":"g-553","statement":"A release that changes stored data or stored formats is either undone within a stated window or marked roll-forward only before it starts.","stage":"R4","group":"Platform","ref":"G-553"},
    {"id":"g-554","statement":"Production changes only through release records and audited operations, and the platform reports every difference between its definitions and what runs.","stage":"R4","group":"Platform","ref":"G-554"},
    {"id":"g-555","statement":"The stage environment holds no personal data of a production tenant.","stage":"R4","group":"Privacy","ref":"G-555"},
    {"id":"g-556","statement":"A change to a tenant's content model is previewed, recorded and attributable, and a change that fails leaves the tenant as it was.","stage":"R2","group":"Tenancy","ref":"G-556"},
    {"id":"g-557","statement":"No committed data of a tenant is lost, and no reader sees a partly converted record, when the platform or the tenant changes stored data.","stage":"R2","group":"Tenancy","ref":"G-557"},
    {"id":"g-558","statement":"A tenant can move to another database cluster or a dedicated instance with a bounded write freeze, and its source keeps serving until the target is verified.","stage":"R2","group":"Tenancy","ref":"G-558"},
    {"id":"g-47","statement":"Tenant automation cannot reach the platform's own network or another tenant.","stage":"R2","group":"Automation","ref":"G-47"},
    {"id":"g-600","statement":"A product feature that counts something a person earns or spends, such as points, badge progress, redemption limits or a promotion budget, keeps it in a ledger of its tenant, and every balance can be explained entry by entry.","stage":"R4","group":"Platform","ref":"G-600"},
    {"id":"g-601","statement":"No person and no operation sets a ledger balance: the balance is what the entries add up to, and a tenant can replay its journal to check it.","stage":"R4","group":"Platform","ref":"G-601"},
    {"id":"g-602","statement":"A tenant states a floor, a cap and a cap per period for an account or a unit, and no sequence of requests, however many at once, takes an account past them.","stage":"R4","group":"Platform","ref":"G-602"},
    {"id":"g-603","statement":"A posting that arrives again, from a retry, a redelivered message or a double click, changes the balance once.","stage":"R4","group":"Platform","ref":"G-603"},
    {"id":"g-604","statement":"A posting is an event that automation can react to, a read of a ledger shows each reader only what their policies permit, and erasing a person leaves the totals of the tenant explainable.","stage":"R4","group":"Platform","ref":"G-604"},
    {"id":"g-605","statement":"A tenant can save a predicate over its people as a named segment, and the platform keeps the membership of the segment current without tenant code.","stage":"R2","group":"Automation","ref":"G-605"},
    {"id":"g-606","statement":"A person entering or leaving a segment is a fact in the journal, written in the transaction of the change that caused it, so that workflows and notices react to it without polling.","stage":"R2","group":"Automation","ref":"G-606"},
    {"id":"g-607","statement":"A segment predicate reads only what its definer may read, and the members of a segment are shown only to readers whose policies permit it.","stage":"R2","group":"Automation","ref":"G-607"},
    {"id":"g-608","statement":"The cost of keeping a segment current is bounded by what its plan names, however many people the tenant has.","stage":"R2","group":"Automation","ref":"G-608"},
    {"id":"g-609","statement":"A person who is erased is in no segment, and no later change puts the person back.","stage":"R2","group":"Automation","ref":"G-609"},
    {"id":"g-610","statement":"A tenant, a team and a person can each set the typed settings that the platform lets them set, and every read answers with the most specific permitted value.","stage":"R2","group":"Tenancy","ref":"G-610"},
    {"id":"g-611","statement":"A setting accepts only a value of its own type at the levels its definition allows, and the platform or the tenant can lock a setting against the levels below.","stage":"R2","group":"Tenancy","ref":"G-611"},
    {"id":"g-612","statement":"Who may change a setting at each level is a capability, and nobody changes another person's own settings.","stage":"R2","group":"Security","ref":"G-612"},
    {"id":"g-613","statement":"A change of a setting is recorded with its previous and new value, and every open page and stored copy that depends on it follows the change.","stage":"R2","group":"Tenancy","ref":"G-613"},
    {"id":"g-614","statement":"A value that belongs to one person never reaches another person or a shared copy.","stage":"R2","group":"Delivery","ref":"G-614"},
    {"id":"g-615","statement":"A named query of a tenant can answer counts, sums, minimums, maximums and top lists, grouped by a field it declares, so that leaderboards, progress, results and unread counts need no counting by the client.","stage":"R2","group":"Content","ref":"G-615"},
    {"id":"g-616","statement":"An aggregate counts only what its reader may read, and gives the answer that adding up the readable records one at a time would give.","stage":"R2","group":"Delivery","ref":"G-616"},
    {"id":"g-617","statement":"An aggregate that would cost more than its declared bound is refused by name and never answered in part.","stage":"R2","group":"Platform","ref":"G-617"},
    {"id":"g-618","statement":"A stored aggregate result is never older than the last commit that could change it, and never reaches a reader of another audience class.","stage":"R2","group":"Delivery","ref":"G-618"},
    {"id":"g-619","statement":"No aggregate reads the data of more than one tenant.","stage":"R2","group":"Tenancy","ref":"G-619"}
  ],
  "nonGoals": [
    {"id":"ng-1","statement":"No tenancy mode in which tenants share one database. Isolation by database is the product, not an option (D-1).","horizon":"Not planned.","ref":"NG-1"},
    {"id":"ng-2","statement":"No general identity provider for third-party applications. The identity service signs assertions for the platform's own components and tokens for a tenant's own service accounts and agents (D-4).","horizon":"Not at launch.","ref":"NG-2"},
    {"id":"ng-3","statement":"No execution of tenant-supplied code inside platform processes. Automation is workflows over declared steps and calls to external addresses (D-506).","horizon":"Not planned.","ref":"NG-3"},
    {"id":"ng-4","statement":"No active-active operation across regions. One region is primary for a tenant, and recovery in another region is a restore (D-23).","horizon":"Not at launch.","ref":"NG-4"},
    {"id":"ng-5","statement":"No visual page builder. Pages are view definitions and templates held as metadata.","horizon":"Not at launch.","ref":"NG-5"},
    {"id":"ng-6","statement":"No query of tenant data spans tenants. Reports across tenants read telemetry, published summaries and the tenant directory (ARC-110), and operations over tenants are operations of the control plane.","horizon":"Not planned.","ref":"NG-6"},
    {"id":"ng-7","statement":"No GraphQL interface. Delivery is HTTP with JSON over named queries and view definitions (D-507).","horizon":"Not at launch.","ref":"NG-7"},
    {"id":"ng-8","statement":"No built-in web analytics or commerce: the platform takes no payment, holds no cart or order, and follows no visitor from one site to another. Campaigns, promotions and messages to an audience are product modules built from the platform's primitives (D-5080).","horizon":"Not planned.","ref":"NG-8"},
    {"id":"ng-9","statement":"No installer for customer-operated sites. The local container stack is for development and proof, not a supported production form.","horizon":"Not at launch.","ref":"NG-9"},
    {"id":"ng-150","statement":"No marketplace where third parties publish code. Templates and integrations are platform-authored declarative bundles (INT-155, NG-3).","horizon":"Not at launch.","ref":"NG-150"},
    {"id":"ng-151","statement":"No reader comments on published content. Review notes live on the draft version under review.","horizon":"Not planned.","ref":"NG-151"},
    {"id":"ng-152","statement":"No payment processing, invoicing or tax calculation inside the platform. Usage leaves through the billing export (BIL-153).","horizon":"Not planned.","ref":"NG-152"},
    {"id":"ng-153","statement":"No client libraries in the first releases. The delivery interface is described in a machine-readable document from which clients can be generated (CMS-169).","horizon":"Not at launch.","ref":"NG-153"},
    {"id":"ng-154","statement":"No importers for named third-party content systems in the first releases. Records move as documents in the tenant's own export format (CMS-172).","horizon":"Not at launch.","ref":"NG-154"},
    {"id":"ng-155","statement":"No contractual service credits in the platform. The objectives are published as data (BIL-155).","horizon":"Not planned.","ref":"NG-155"},
    {"id":"ng-10","statement":"No search across tenants, and no search over the text of files. Search is per tenant over its published and draft content, as the audience of the reader permits (SRH-150, SRH-151).","horizon":"Not at launch.","ref":"NG-10"},
    {"id":"ng-200","statement":"No assistant with more authority than the person it serves. The assistant holds no credential of its own, and no conversation grants a permission that the person lacks (D-18, TOK-004).","horizon":"Never.","ref":"NG-200"},
    {"id":"ng-201","statement":"No change applied by the assistant without the person's confirmation, except steps of a workflow that the tenant declared, which run under that workflow's own approvals (WFL-006).","horizon":"Not planned.","ref":"NG-201"},
    {"id":"ng-202","statement":"No voice-only interface at launch. Speech may be added later through the same operations, previews and confirmations.","horizon":"Not at launch.","ref":"NG-202"},
    {"id":"ng-350","statement":"No tenant content reaches a model provider unless the tenant has turned the assistant on and the provider is listed among its subprocessors. A tenant that turns the assistant off has no model request made (CNV-234).","horizon":"Standing rule.","ref":"NG-350"},
    {"id":"ng-351","statement":"No purpose built around the personal data of children or the special categories of personal data. A tenant that collects such data is its controller, and the platform offers it no feature made for that purpose.","horizon":"Not planned.","ref":"NG-351"},
    {"id":"ng-550","statement":"No zero-downtime move of a tenant between regions. A move has a bounded write freeze (D-576), and a move across regions is a restore (NG-4).","horizon":"Not planned.","ref":"NG-550"},
    {"id":"ng-551","statement":"No automatic reversal of a tenant's schema change once later writes depend on it. The recovery for such a change is a restore to a point in time (TEN-015).","horizon":"Not planned.","ref":"NG-551"},
    {"id":"ng-552","statement":"No guarantee that grandfathered records conform to a later schema. Only strict mode guarantees conformance (KRN-009, KRN-010).","horizon":"Not planned.","ref":"NG-552"},
    {"id":"ng-553","statement":"No ephemeral environment for each change or branch. The local stack and the stage environment are the two non-production environments (D-552).","horizon":"Not planned.","ref":"NG-553"},
    {"id":"ng-554","statement":"No automatic promotion of a release to production. Each production release waits for its approvals (REL-560).","horizon":"Not planned.","ref":"NG-554"},
    {"id":"ng-555","statement":"No reversal of committed tenant data by replaying changes backwards. Lost data comes back from a restore to a point in time (OPS-320, TEN-015).","horizon":"Not planned.","ref":"NG-555"},
    {"id":"ng-556","statement":"No delivery shape is served after the window that its notice states has ended. A client that has not moved by then loses the old shape (CMS-170).","horizon":"Not planned.","ref":"NG-556"},
    {"id":"ng-400","statement":"No promise about the reasoning of a third-party agent's model. The platform records what such an agent reads, calls and decides at its own boundary and enforces the authority it holds, but it makes no promise about what the model computes or why.","horizon":"Not promised.","ref":"NG-400"}
  ],
  "boundaries": [
    {"id":"b-1","name":"Kernel interface: decide an intent, answer a read, plan the state a decision needs","interfaceKind":"Rust library","usedBy":"runtime, identity service, automation worker, simulator, verification","ref":"B-1","contracts":["decide-intent","plan-intent-needs","answer-read","plan-read-needs","check-record-visibility","apply-state-delta","plan-schema-migration","evaluate-segment-predicate","plan-segment-needs","decide-segment-membership"]},
    {"id":"b-2","name":"Store contract: tenant-scoped snapshots, atomic commits guarded by a revision, ordered events, journal","interfaceKind":"Rust trait with a conformance suite","usedBy":"runtime, identity service, automation worker, control plane","ref":"B-2","contracts":["store-capabilities","store-health","list-storage-migrations","list-store-tenants","load-tenant","load-complete-tenant","commit-transition","list-events-after","list-outbox","mark-outbox-published","list-journal-after","put-session","find-session-by-token","find-session-by-id","list-live-sessions","purge-ended-sessions","put-account","find-account","create-snapshot","list-snapshots","load-snapshot","restore-snapshot","reset-store","execute-intent","execute-read"]},
    {"id":"b-3","name":"Tenant directory: tenants, placements, domain bindings, lifecycle operations","interfaceKind":"HTTP with JSON","usedBy":"gateway, runtime, automation worker, operators, agents","ref":"B-3","contracts":["provision-tenant","get-tenant","resolve-host","suspend-tenant","resume-tenant","export-tenant","delete-tenant","cancel-tenant-deletion","restore-tenant","start-sandbox","keep-sandbox","bind-domain","remove-domain-binding","change-plan","find-due-tenants","record-next-due","apply-layout-change","health-check"]},
    {"id":"b-4","name":"Identity interface: sign-in methods, sessions, factors, recovery, realm configuration","interfaceKind":"HTTP with JSON","usedBy":"gateway, authoring application, agents","ref":"B-4","contracts":["sign-in-with-password","request-sign-in-link","sign-in-with-link","sign-in-with-passkey","register-passkey","verify-second-factor","sign-up","sign-out","look-up-session","list-sessions","revoke-session","change-password","recover-account","accept-invitation","configure-realm","end-principal-sessions"]},
    {"id":"b-5","name":"Federation endpoints: OpenID Connect redirect and callback, SAML metadata and assertion consumer, SCIM provisioning","interfaceKind":"HTTP (OpenID Connect, SAML 2.0, SCIM 2.0)","usedBy":"external identity providers, browsers","ref":"B-5","contracts":["start-oidc-sign-in","complete-oidc-sign-in","serve-saml-metadata","consume-saml-assertion","provision-user","deprovision-user","map-group"]},
    {"id":"b-6","name":"Token endpoint: client credentials, token exchange, introspection, signing keys","interfaceKind":"HTTP (OAuth 2.1)","usedBy":"service accounts, agents, platform components","ref":"B-6","contracts":["issue-access-token","exchange-token","introspect-token","list-signing-keys","revoke-grant","create-grant","rotate-client-secret"]},
    {"id":"b-7","name":"Scheduling interface: jobs, schedules, triggers, leases","interfaceKind":"HTTP with JSON, kernel intents","usedBy":"runtime, workflow engine, workers, agents","ref":"B-7","contracts":["schedule-job","lease-job","report-job-result","cancel-job","retry-job","list-jobs","define-schedule","fire-trigger","define-segment","remove-segment","list-segment-members","test-segment-predicate","run-segment-batch","declare-event-kind","emit-event"]},
    {"id":"b-8","name":"Workflow definitions: steps, waits, compensations, approvals","interfaceKind":"tenant metadata","usedBy":"tenant owners, agents","ref":"B-8","contracts":["activate-workflow","start-workflow-run","advance-workflow-run","approve-workflow-step"]},
    {"id":"b-9","name":"Delivery interface: views and named queries over published content","interfaceKind":"HTTP with JSON","usedBy":"browsers, content delivery network, tenant applications","ref":"B-9","contracts":["deliver-view","run-named-query","list-record-versions","restore-record-version","show-preview","subscribe-events","serve-sitemap","serve-feed","record-consent","describe-delivery","read-front-page","read-article-page","read-topics-page","read-topic-page","read-authors-page","read-author-page","read-search-page","read-about-page","read-missing-page","read-sign-in-view","aggregate-run","aggregate-run-signed-in"]},
    {"id":"b-10","name":"Edge contract: storability directives, surrogate keys, purge, signed addresses, domain routing","interfaceKind":"HTTP headers and a purge call","usedBy":"content delivery network, gateway","ref":"B-10","contracts":["purge-by-surrogate-key","purge-host","register-edge-domain","sign-media-address","set-storability-directives"]},
    {"id":"b-11","name":"Operation catalogue and change proposals","interfaceKind":"HTTP with JSON, Model Context Protocol","usedBy":"agents, operators, authoring application","ref":"B-11","contracts":["list-operations","describe-operation","invoke-operation","get-operation-handle","propose-change","approve-proposal","subscribe-agent-events","get-platform-description","list-records","set-agent-state","undo-change","list-agents","report-agent-spend","get-requirement-status","set-feature-flag","run-diagnostic","list-releases"]},
    {"id":"b-12","name":"Telemetry export and audit log","interfaceKind":"OpenTelemetry protocol, HTTP with JSON","usedBy":"operators, agents, tenant owners","ref":"B-12","contracts":["append-audit-entry","query-audit-log","export-audit-log","verify-audit-chain","export-telemetry","query-telemetry","raise-alert","get-access-report","get-run-trace","report-fleet","notify-breach"]},
    {"id":"b-13","name":"Authoring application and sign-in pages","interfaceKind":"UI (semantic HTML, layered CSS, vanilla JavaScript)","usedBy":"authors, editors, tenant owners","ref":"B-13","contracts":["show-sign-in-page","show-authoring-view","save-draft","show-review-diff","preview-tokens","read-desk-view","read-new-article-view","read-edit-article-view","read-settings-view","read-lab-view","sign-in-at-site","sign-out-of-site","read-session-view","create-article","update-article","delete-article","save-site-settings","preview-markdown","setting-save-definition","setting-resolve","setting-resolve-all","setting-set-platform","setting-set-tenant","setting-set-team","setting-set-person"]},
    {"id":"b-14","name":"File store contract: tenant-scoped objects addressed by content hash","interfaceKind":"Rust trait with a conformance suite","usedBy":"runtime, connector runner","ref":"B-14","contracts":["put-file","get-file","delete-file","sign-file-address"]},
    {"id":"b-15","name":"Copy store contract: keyed stored copies with tags and removal by tag","interfaceKind":"Rust trait with a conformance suite","usedBy":"runtime, gateway","ref":"B-15","contracts":["put-copy","get-copy","remove-copies-by-tag"]},
    {"id":"b-16","name":"Notice contract: tenant-scoped notices of due work, revocations and domain events, delivered until acknowledged","interfaceKind":"Rust trait with a conformance suite","usedBy":"runtime, automation worker, identity service, gateway, agent gateway","ref":"B-16","contracts":["publish-notice","receive-notices","acknowledge-notice"]},
    {"id":"b-17","name":"Key service contract: per-tenant data keys, wrapping, destruction","interfaceKind":"Rust trait with a conformance suite","usedBy":"identity service, runtime, control plane","ref":"B-17","contracts":["create-data-key","wrap-key","unwrap-key","rotate-data-key","destroy-key"]},
    {"id":"b-18","name":"Mail contract: submission of one rendered message with an idempotency key, and delivery reports","interfaceKind":"Rust trait with a conformance suite","usedBy":"mail dispatcher","ref":"B-18","contracts":["submit-message","receive-delivery-report"]},
    {"id":"b-19","name":"Deployment descriptors: the local container stack and the cloud profile","interfaceKind":"compose file, infrastructure modules, command line","usedBy":"developers, operators, agents","ref":"B-19","contracts":["start-local-stack","build-component-image","apply-deployment-descriptor","declare-change-freeze","inject-fault"]},
    {"id":"b-20","name":"Projection interface: fork a tenant, apply a proposed change, replay, compare","interfaceKind":"HTTP with JSON","usedBy":"tenant owners, agents","ref":"B-20","contracts":["run-scenario","project-change","replay-journal","fork-tenant"]},
    {"id":"b-100","name":"Limit contract: shared counters for request rates and agent operation budgets","interfaceKind":"Rust trait with a conformance suite","usedBy":"gateway, agent gateway","ref":"B-100","contracts":["count-request","count-agent-operation"]},
    {"id":"b-101","name":"Backup archive contract: point-in-time copies of one tenant database, encrypted under its key","interfaceKind":"Rust trait with a conformance suite","usedBy":"control plane, runtime","ref":"B-101","contracts":["write-backup","read-backup","remove-expired-backups"]},
    {"id":"b-150","name":"Webhook endpoints: signed inbound deliveries that start runs, and the log of outbound deliveries","interfaceKind":"HTTP with JSON, signed bodies","usedBy":"external systems, tenant owners","ref":"B-150","contracts":["receive-inbound-webhook","list-webhook-deliveries","create-webhook-endpoint","rotate-webhook-secret"]},
    {"id":"b-151","name":"Search index contract: entries per tenant, updated from commits, queried by audience class","interfaceKind":"Rust trait with a conformance suite","usedBy":"runtime, gateway","ref":"B-151","contracts":["index-record","search"]},
    {"id":"b-152","name":"Form intake: submissions with submission tokens, stored and notified","interfaceKind":"HTTP with JSON","usedBy":"readers, tenant owners","ref":"B-152","contracts":["issue-submission-token","submit-form"]},
    {"id":"b-153","name":"Archive documents: tenant archives, record exports and form exports","interfaceKind":"JSON documents with a manifest","usedBy":"tenant owners, agents","ref":"B-153","contracts":["import-records","export-form-submissions","build-archive-manifest"]},
    {"id":"b-154","name":"Notification subscriptions and inbox: email and in-platform notices","interfaceKind":"HTTP with JSON, mail","usedBy":"people, tenant owners","ref":"B-154","contracts":["subscribe-notifications","list-inbox","send-notice","set-notice-read","remove-notices","count-unread-notices","define-notice-template","set-notification-preference","send-digest","resolve-recipient-setting"]},
    {"id":"b-155","name":"Usage export: signed usage documents to the billing system the tenant configures","interfaceKind":"HTTP with JSON, signed documents","usedBy":"billing systems, tenant owners","ref":"B-155","contracts":["count-usage","export-usage"]},
    {"id":"b-156","name":"Status page and changelog","interfaceKind":"HTML and HTTP with JSON","usedBy":"operators, tenant owners, the public","ref":"B-156","contracts":["show-status","show-changelog","show-service-objectives"]},
    {"id":"b-200","name":"Conversation interface: turns, reply streams, pending actions and their confirmation","interfaceKind":"HTTP with JSON and server-sent events","usedBy":"authoring application, tenant owners, editors","ref":"B-200","contracts":["post-turn","stream-reply","cancel-turn","get-pending-action","confirm-pending-action","cancel-pending-action","undo-turn","get-conversation","delete-conversation"]},
    {"id":"b-201","name":"Model provider contract: generate a reply from messages and operation descriptions, stream it, report usage","interfaceKind":"Rust trait with a conformance suite","usedBy":"conversation service","ref":"B-201","contracts":["generate-reply","report-model-usage"]},
    {"id":"b-202","name":"Collaboration channel: presence, saved drafts and conflicts on one record","interfaceKind":"HTTP with JSON and server-sent events","usedBy":"authoring application, editors","ref":"B-202","contracts":["save-record-edit","announce-presence"]},
    {"id":"b-250","name":"Operator console and support grants","interfaceKind":"HTTP with JSON","usedBy":"operators, support staff","ref":"B-250","contracts":["open-operator-console"]},
    {"id":"b-251","name":"Tenant file upload: intake, scanning and file-domain delivery","interfaceKind":"HTTP multipart and HTTP","usedBy":"authors, tenant applications, the upload scanner","ref":"B-251","contracts":["upload-file","scan-upload","deliver-file"]},
    {"id":"b-252","name":"Outbound gate: the one path from connectors to external addresses","interfaceKind":"HTTP and HTTPS client under the outbound rule","usedBy":"connector runner","ref":"B-252","contracts":["call-external-address","fetch-provider-metadata"]},
    {"id":"b-350","name":"Subject rights and access grants: export, rectification, restriction and erasure of one principal's records, and grants of platform access to a tenant","interfaceKind":"HTTP with JSON","usedBy":"tenant owners, platform operators, the operator console","ref":"B-350","contracts":["issue-access-grant","withdraw-access-grant","export-subject-data","rectify-subject-field","restrict-subject","erase-subject","get-processing-record","place-legal-hold","list-erasure-receipts","fetch-subject-export","lift-subject-restriction","release-legal-hold","list-legal-holds"]},
    {"id":"b-450","name":"Content token definitions and the token reference in content","interfaceKind":"Tenant metadata (JSON) and a node of the structured blocks","usedBy":"authors, tenant owners, agents","ref":"B-450","contracts":["define-token","remove-token","evaluate-token"]},
    {"id":"b-451","name":"Mail interface: templates, sender domains, the suppression list and the mail log","interfaceKind":"HTTP and catalogue operations","usedBy":"tenant owners, authors, agents","ref":"B-451","contracts":["define-mail-template","render-message","prove-sender-domain","list-mail-messages","manage-suppression-list","send-message","define-message-category","change-subscription-by-link","count-mail-messages"]},
    {"id":"b-550","name":"Release controller interface: release records, promotions, colour switches, switches back and freezes","interfaceKind":"HTTP with JSON and catalogue operations","usedBy":"release engineers, operators, agents of the platform, the release pipeline","ref":"B-550","contracts":["create-release","promote-release","switch-colour","switch-back","report-drift"]},
    {"id":"b-551","name":"Traffic switch: the listener rule that sends public requests to the live colour of a component","interfaceKind":"load balancer listener configuration","usedBy":"release controller, delivery network origin","ref":"B-551","contracts":["set-listener-rule"]},
    {"id":"b-552","name":"Tenant migration run: the cursor, the batches and the preview a run is applied from","interfaceKind":"HTTP with JSON and catalogue operations","usedBy":"tenant owners, agents, automation worker","ref":"B-552","contracts":["preview-migration","start-migration-run","run-migration-batch","stop-migration-run"]},
    {"id":"b-553","name":"Tenant move: the move record, the read-only window and the placement switch","interfaceKind":"HTTP with JSON","usedBy":"control plane, operators, tenant owners","ref":"B-553","contracts":["move-tenant","switch-placement"]},
    {"id":"b-21","name":"Tenant bundle: a tenant or a template written as one document","interfaceKind":"JSON document","usedBy":"control plane, developers, agents","ref":"B-21","contracts":["install-bundle","parse-bundle","propose-template-upgrade"]},
    {"id":"b-product-lifecycle","name":"Product lifecycle: upgrade and remove an installed product, list what is installed","interfaceKind":"HTTP with JSON","usedBy":"tenant owners, authoring application, products","ref":"B-2901","contracts":["upgrade-bundle","remove-bundle","list-installed-products"]},
    {"id":"b-chunked-upload","name":"Chunked upload: start, send chunks, finish","interfaceKind":"HTTP with JSON","usedBy":"tenant owners, authoring application, products","ref":"B-2902","contracts":["start-upload","put-upload-chunk","finish-upload"]},
    {"id":"b-content-publication","name":"Content publication: publish, withdraw, submit for review, schedule","interfaceKind":"HTTP with JSON","usedBy":"tenant owners, authoring application, products","ref":"B-2903","contracts":["publish-content","withdraw-content","submit-for-review","schedule-publication"]},
    {"id":"b-tenant-configuration","name":"Tenant configuration: tenant settings and their bounds","interfaceKind":"HTTP with JSON","usedBy":"tenant owners, authoring application, products","ref":"B-2904","contracts":["configure-tenant-settings","read-tenant-settings"]}
  ],
  "contracts": [
    {"id":"decide-intent","name":"Decide an intent","ref":"CT-001","realisation":"derived","implementedBy":"kernel","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"state","type":"state"},{"name":"intent","type":"intent"},{"name":"context","type":"context"}],"outputs":[{"name":"result","type":"transition-result"}],"preconditions":["The state is a snapshot of the tenant that the context names, complete or covering the needs of the intent."],"postconditions":["Equal state, intent and context give equal results (KRN-001).","An accepted result holds a state delta addressed only to the tenant of the context and advancing its revision by one (KRN-002, KRN-006).","A rejected result changes nothing and lists the checks that failed (KRN-007).","A snapshot that lacks needed state is answered with insufficient-state naming the need, never with a different decision (KRN-005)."],"errors":[{"name":"tenant-mismatch","condition":"The snapshot is of a tenant other than the one the context names.","type":"domain-error","kind":"internal"},{"name":"tenant-exists","condition":"A create-tenant intent names a tenant that already exists.","type":"domain-error","kind":"invalid"},{"name":"tenant-not-found","condition":"The intent needs a tenant that has no state.","type":"domain-error","kind":"not_found"},{"name":"unauthorized","condition":"No policy of the principal authorises the intent.","type":"domain-error","kind":"forbidden"},{"name":"unknown-object","condition":"The intent names an object type the schema does not declare.","type":"domain-error","kind":"not_found"},{"name":"unknown-field","condition":"The intent names a field the object type does not declare.","type":"domain-error","kind":"invalid"},{"name":"unknown-record","condition":"The intent names a record that does not exist.","type":"domain-error","kind":"not_found"},{"name":"unknown-role","condition":"The intent names a role the tenant does not define.","type":"domain-error","kind":"invalid"},{"name":"type-mismatch","condition":"A field value is not of the declared field type.","type":"domain-error","kind":"invalid"},{"name":"missing-required","condition":"A required field has no value.","type":"domain-error","kind":"invalid"},{"name":"constraint-violated","condition":"A declared constraint of the object type fails.","type":"domain-error","kind":"invalid"},{"name":"unique-violated","condition":"A unique field repeats a value.","type":"domain-error","kind":"invalid"},{"name":"dangling-reference","condition":"A reference field names no record of its target type.","type":"domain-error","kind":"invalid"},{"name":"still-referenced","condition":"The record to delete is referred to by another record.","type":"domain-error","kind":"invalid"},{"name":"workflow-violation","condition":"A workflow field changes in a way no declared transition permits.","type":"domain-error","kind":"invalid"},{"name":"version-conflict","condition":"The expected version differs from the stored version.","type":"domain-error","kind":"conflict"},{"name":"schema-conflict","condition":"The expected schema version differs from the current one.","type":"domain-error","kind":"conflict"},{"name":"invalid-schema","condition":"The schema changes do not produce a consistent schema.","type":"domain-error","kind":"invalid"},{"name":"migration-rejected","condition":"Strict mode and an existing record would not conform.","type":"domain-error","kind":"invalid"},{"name":"insufficient-state","condition":"The snapshot lacks state the decision needs; the error names the missing need.","type":"domain-error","kind":"internal"},{"name":"evaluation","condition":"A tenant expression fails or exhausts its step budget.","type":"domain-error","kind":"invalid"},{"name":"invalid-intent","condition":"The intent is malformed.","type":"domain-error","kind":"invalid"},{"name":"rejected","condition":"The kernel rejected the intent: a DomainError of kind tenant-mismatch, tenant-exists, tenant-not-found, unauthorized, unknown-object, unknown-field, unknown-record, unknown-role, type-mismatch, missing-required, constraint-violated, unique-violated, dangling-reference, still-referenced, workflow-violation, version-conflict, schema-conflict, invalid-schema, migration-rejected, insufficient-state, evaluation, invalid-intent, with the checks that led to it; insufficient-state names the need the snapshot lacked. Its HTTP status, where one is served, is error-code-of of its kind (backend ApiError::domain).","type":"domain-error","kind":"invalid"},{"name":"fault","condition":"An integer overflow in the decision (a revision, an event sequence, a version or a record id past its type); never in practice.","kind":"internal"}],"exposure":"local","derivation":{"kind":"pure","function":"kernel-transition","fault":"fault"},"deployment":"shipped"},
    {"id":"plan-intent-needs","name":"Plan the state an intent needs","ref":"CT-002","realisation":"derived","implementedBy":"kernel","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"schema","type":"tenant-schema","optional":true},{"name":"intent","type":"intent"}],"outputs":[{"name":"needs","type":"list<need>"}],"postconditions":["The needs name the records the decision is expected to read; deciding on a snapshot that holds them gives the result of the complete snapshot (KRN-005, ARC-108)."],"errors":[],"exposure":"local","derivation":{"kind":"pure","function":"needs"},"deployment":"shipped"},
    {"id":"answer-read","name":"Answer a read against a snapshot","ref":"CT-003","realisation":"derived","implementedBy":"kernel","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"state","type":"state"},{"name":"request","type":"read-request"},{"name":"context","type":"context"}],"outputs":[{"name":"result","type":"read-result"}],"postconditions":["Only records that the policies of the requesting principal permit are returned (KRN-004).","The result names the revision and schema version it answers at."],"errors":[{"name":"tenant-mismatch","condition":"The snapshot is of a tenant other than the one the context names.","type":"domain-error","kind":"internal"},{"name":"tenant-not-found","condition":"The intent needs a tenant that has no state.","type":"domain-error","kind":"not_found"},{"name":"unknown-object","condition":"The intent names an object type the schema does not declare.","type":"domain-error","kind":"not_found"},{"name":"insufficient-state","condition":"The snapshot lacks state the decision needs; the error names the missing need.","type":"domain-error","kind":"internal"},{"name":"evaluation","condition":"A tenant expression fails or exhausts its step budget.","type":"domain-error","kind":"invalid"},{"name":"invalid-intent","condition":"The intent is malformed.","type":"domain-error","kind":"invalid"},{"name":"rejected","condition":"The kernel refused the read: a DomainError of kind tenant-mismatch, tenant-not-found, unknown-object, unknown-query, invalid-intent, insufficient-state or evaluation, with the checks that led to it; insufficient-state names the need the snapshot lacked. Its HTTP status, where one is served, is error-code-of of its kind (backend ApiError::domain).","type":"domain-error","kind":"invalid"},{"name":"fault","condition":"A checked conversion or integer operation inside the derivation overflowed or broke a type constraint; nothing was changed.","kind":"internal"}],"exposure":"local","derivation":{"kind":"pure","function":"kernel-read","fault":"fault"},"deployment":"shipped"},
    {"id":"plan-read-needs","name":"Plan the state a read needs","ref":"CT-004","realisation":"derived","implementedBy":"kernel","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"schema","type":"tenant-schema"},{"name":"request","type":"read-request"}],"outputs":[{"name":"needs","type":"list<need>"}],"postconditions":["The needs name the records the read is expected to look at."],"errors":[],"exposure":"local","derivation":{"kind":"pure","function":"read-needs"},"deployment":"shipped"},
    {"id":"check-record-visibility","name":"Decide whether a principal may read a record","ref":"CT-005","realisation":"derived","implementedBy":"kernel","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-state"},{"name":"principal","type":"principal"},{"name":"record","type":"record"},{"name":"now","type":"timestamp"}],"outputs":[{"name":"visible","type":"bool"}],"postconditions":["The answer is the one answer that a read makes for each row; the runtime uses it to decide who receives an event about the record."],"errors":[{"name":"fault","condition":"A checked conversion or integer operation inside the derivation overflowed or broke a type constraint; nothing was changed.","kind":"internal"}],"exposure":"local","derivation":{"kind":"pure","function":"visible","fault":"fault"},"deployment":"shipped"},
    {"id":"apply-state-delta","name":"Apply an accepted state delta","ref":"CT-006","realisation":"derived","implementedBy":"kernel","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":false,"inputs":[{"name":"tenant","type":"tenant-state","optional":true},{"name":"delta","type":"state-delta"}],"outputs":[{"name":"tenant","type":"tenant-state"}],"preconditions":["The state is at the base revision of the delta, or absent when the base is none."],"postconditions":["The revision of the result is the new revision of the delta, one step beyond its base (KRN-006)."],"errors":[{"name":"version-conflict","condition":"The expected version differs from the stored version.","type":"domain-error","kind":"conflict"},{"name":"rejected","condition":"The delta does not apply: a DomainError of kind version-conflict (the state is not at the delta's base revision) or invalid-intent (a delta without a base creates no tenant), without evidence, with the checks that led to it. Its HTTP status, where one is served, is error-code-of of its kind (backend ApiError::domain).","type":"domain-error","kind":"invalid"}],"exposure":"local","derivation":{"kind":"pure","function":"apply-delta"},"deployment":"shipped"},
    {"id":"plan-schema-migration","name":"Plan a schema migration","ref":"CT-007","realisation":"derived","implementedBy":"kernel","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-state"},{"name":"changes","type":"list<schema-change>"},{"name":"now","type":"timestamp"}],"outputs":[{"name":"plan","type":"migration-plan"}],"postconditions":["The plan holds the new schema, a summary of each change, the records rewritten and the existing records that do not conform (KRN-009, KRN-010).","Nothing is changed; the plan is the preview of the change (MIG-550)."],"errors":[{"name":"invalid-schema","condition":"The schema changes do not produce a consistent schema.","type":"domain-error","kind":"invalid"},{"name":"rejected","condition":"The changes do not produce a consistent schema: a DomainError of kind invalid-schema, with the checks that led to it. Its HTTP status, where one is served, is error-code-of of its kind (backend ApiError::domain).","type":"domain-error","kind":"invalid"},{"name":"fault","condition":"An integer overflow in the plan (a revision, an event sequence, a version or a record id past its type); never in practice.","kind":"internal"}],"exposure":"local","derivation":{"kind":"pure","function":"kernel-plan-migration","fault":"fault"},"deployment":"shipped"},
    {"id":"store-capabilities","name":"Report the capabilities of an adapter","ref":"CT-008","realisation":"generated","implementedBy":"store-contract","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[],"outputs":[{"name":"capabilities","type":"adapter-capabilities"}],"postconditions":["The adapter states whether acknowledged commits survive a restart, how it orders concurrent commits and what a reader sees during a commit."],"errors":[],"exposure":"local","deployment":"shipped"},
    {"id":"store-health","name":"Report store health","ref":"CT-009","realisation":"generated","implementedBy":"store-contract","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[],"outputs":[{"name":"health","type":"adapter-health"}],"errors":[{"name":"unavailable","condition":"The store could not do the work right now (busy, I/O); safe to retry.","type":"store-error","kind":"unavailable"}],"exposure":"local","deployment":"shipped"},
    {"id":"list-storage-migrations","name":"List the storage layout history","ref":"CT-010","realisation":"generated","implementedBy":"store-contract","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[],"outputs":[{"name":"migrations","type":"list<storage-migration>"}],"errors":[{"name":"unavailable","condition":"The store could not do the work right now (busy, I/O); safe to retry.","type":"store-error","kind":"unavailable"},{"name":"corrupt","condition":"Stored data could not be read back; not safe to ignore.","type":"store-error","kind":"internal"}],"exposure":"local","deployment":"shipped"},
    {"id":"list-store-tenants","name":"List the tenants a store holds","ref":"CT-011","realisation":"generated","implementedBy":"store-contract","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[],"outputs":[{"name":"tenants","type":"list<tenant-summary>"}],"errors":[{"name":"unavailable","condition":"The store could not do the work right now (busy, I/O); safe to retry.","type":"store-error","kind":"unavailable"},{"name":"corrupt","condition":"Stored data could not be read back; not safe to ignore.","type":"store-error","kind":"internal"}],"exposure":"local","deployment":"shipped"},
    {"id":"load-tenant","name":"Load a snapshot of one tenant","ref":"CT-012","realisation":"generated","implementedBy":"store-contract","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"needs","type":"list<need>"}],"outputs":[{"name":"state","type":"state"}],"postconditions":["The snapshot holds at least the records that answer the needs, with partial coverage stating exactly the needs; schema, members and counters are always included.","The tenant of the snapshot is absent when the tenant does not exist.","A load returns a state that some commit produced, never a mixture (isolation)."],"errors":[{"name":"unavailable","condition":"The store could not do the work right now (busy, I/O); safe to retry.","type":"store-error","kind":"unavailable"},{"name":"corrupt","condition":"Stored data could not be read back; not safe to ignore.","type":"store-error","kind":"internal"}],"exposure":"local","deployment":"shipped"},
    {"id":"load-complete-tenant","name":"Load a complete snapshot of one tenant","ref":"CT-013","realisation":"generated","implementedBy":"store-contract","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"}],"outputs":[{"name":"state","type":"state"}],"postconditions":["Every record of the tenant is present."],"errors":[{"name":"unavailable","condition":"The store could not do the work right now (busy, I/O); safe to retry.","type":"store-error","kind":"unavailable"},{"name":"corrupt","condition":"Stored data could not be read back; not safe to ignore.","type":"store-error","kind":"internal"}],"exposure":"local","deployment":"shipped"},
    {"id":"commit-transition","name":"Commit an accepted transition","ref":"CT-014","realisation":"generated","implementedBy":"store-contract","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":false,"timeoutMs":300,"inputs":[{"name":"commit","type":"commit"}],"outputs":[{"name":"receipt","type":"receipt"}],"preconditions":["The base revision of the delta is the revision the tenant is stored at, or the tenant is absent and the base is none."],"postconditions":["The state delta, events, journal entry, counters and session revocations are all applied or none is (atomicity).","Events continue the per-tenant sequence without gaps and receive an outbox position of their tenant, increasing in that tenant's commit order; an event is in the outbox only once its commit is.","Commits to one tenant are serialisable.","The caller learns that the commit happened or did not, never both (OPS-317)."],"errors":[{"name":"conflict","condition":"The stored revision of the tenant differs from the base revision of the delta; nothing is changed.","type":"store-error","kind":"conflict"},{"name":"invalid","condition":"The commit is malformed, or its events do not continue the tenant event sequence without a gap; nothing is changed.","type":"store-error","kind":"invalid"},{"name":"unavailable","condition":"The store could not do the work right now (busy, I/O); safe to retry.","type":"store-error","kind":"unavailable"},{"name":"corrupt","condition":"Stored data could not be read back; not safe to ignore.","type":"store-error","kind":"internal"}],"exposure":"local","deployment":"shipped"},
    {"id":"list-events-after","name":"List events of a tenant after a sequence number","ref":"CT-015","realisation":"generated","implementedBy":"store-contract","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"after","type":"u64"},{"name":"limit","type":"u32"}],"outputs":[{"name":"events","type":"list<domain-event>"}],"postconditions":["Events are in sequence order, oldest first, and all have a sequence above the given one."],"errors":[{"name":"unavailable","condition":"The store could not do the work right now (busy, I/O); safe to retry.","type":"store-error","kind":"unavailable"},{"name":"corrupt","condition":"Stored data could not be read back; not safe to ignore.","type":"store-error","kind":"internal"}],"exposure":"local","deployment":"shipped"},
    {"id":"list-outbox","name":"List unpublished events","ref":"CT-016","realisation":"generated","implementedBy":"store-contract","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"limit","type":"u32"}],"outputs":[{"name":"entries","type":"list<outbox-entry>"}],"postconditions":["Each tenant's entries are in that tenant's commit order, by outbox position; the entries of different tenants are not ordered against each other."],"errors":[{"name":"unavailable","condition":"The store could not do the work right now (busy, I/O); safe to retry.","type":"store-error","kind":"unavailable"},{"name":"corrupt","condition":"Stored data could not be read back; not safe to ignore.","type":"store-error","kind":"internal"}],"exposure":"local","deployment":"shipped"},
    {"id":"mark-outbox-published","name":"Mark outbox entries published","ref":"CT-017","realisation":"generated","implementedBy":"store-contract","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"position","type":"u64"}],"outputs":[],"postconditions":["Every outbox entry up to and including the position is marked published.","An event is published only after the transaction that produced it has committed (RUN-005)."],"errors":[{"name":"unavailable","condition":"The store could not do the work right now (busy, I/O); safe to retry.","type":"store-error","kind":"unavailable"}],"exposure":"local","deployment":"shipped"},
    {"id":"list-journal-after","name":"List journal entries of a tenant after a revision","ref":"CT-018","realisation":"generated","implementedBy":"store-contract","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"after","type":"u64"},{"name":"limit","type":"u32"}],"outputs":[{"name":"entries","type":"list<journal-entry>"}],"postconditions":["Entries are in revision order, oldest first, each with enough to run its transition again."],"errors":[{"name":"unavailable","condition":"The store could not do the work right now (busy, I/O); safe to retry.","type":"store-error","kind":"unavailable"},{"name":"corrupt","condition":"Stored data could not be read back; not safe to ignore.","type":"store-error","kind":"internal"}],"exposure":"local","deployment":"shipped"},
    {"id":"put-session","name":"Store a session","ref":"CT-019","realisation":"generated","implementedBy":"store-contract","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"session","type":"session-record"}],"outputs":[],"postconditions":["Only the hash of the session token is stored (IDN-010)."],"errors":[{"name":"unavailable","condition":"The store could not do the work right now (busy, I/O); safe to retry.","type":"store-error","kind":"unavailable"}],"exposure":"local","deployment":"shipped"},
    {"id":"find-session-by-token","name":"Find a session by token hash","ref":"CT-020","realisation":"generated","implementedBy":"store-contract","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"token-hash","type":"hash"}],"outputs":[{"name":"session","type":"session-record","optional":true}],"errors":[{"name":"unavailable","condition":"The store could not do the work right now (busy, I/O); safe to retry.","type":"store-error","kind":"unavailable"},{"name":"corrupt","condition":"Stored data could not be read back; not safe to ignore.","type":"store-error","kind":"internal"}],"exposure":"local","deployment":"shipped"},
    {"id":"find-session-by-id","name":"Find a session by identifier","ref":"CT-021","realisation":"generated","implementedBy":"store-contract","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"session-id","type":"session-id"}],"outputs":[{"name":"session","type":"session-record","optional":true}],"errors":[{"name":"unavailable","condition":"The store could not do the work right now (busy, I/O); safe to retry.","type":"store-error","kind":"unavailable"},{"name":"corrupt","condition":"Stored data could not be read back; not safe to ignore.","type":"store-error","kind":"internal"}],"exposure":"local","deployment":"shipped"},
    {"id":"list-live-sessions","name":"List sessions that are neither revoked nor ended","ref":"CT-022","realisation":"generated","implementedBy":"store-contract","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"now","type":"timestamp"}],"outputs":[{"name":"sessions","type":"list<session-record>"}],"errors":[{"name":"unavailable","condition":"The store could not do the work right now (busy, I/O); safe to retry.","type":"store-error","kind":"unavailable"},{"name":"corrupt","condition":"Stored data could not be read back; not safe to ignore.","type":"store-error","kind":"internal"}],"exposure":"local","deployment":"shipped"},
    {"id":"purge-ended-sessions","name":"Remove sessions that ended before a time","ref":"CT-023","realisation":"generated","implementedBy":"store-contract","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"before","type":"timestamp"}],"outputs":[{"name":"removed","type":"u64"}],"errors":[{"name":"unavailable","condition":"The store could not do the work right now (busy, I/O); safe to retry.","type":"store-error","kind":"unavailable"}],"exposure":"local","deployment":"shipped"},
    {"id":"put-account","name":"Store a local account","ref":"CT-024","realisation":"generated","implementedBy":"store-contract","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"account","type":"account"}],"outputs":[],"postconditions":["The password is held only as an Argon2id hash (IDN-002)."],"errors":[{"name":"unavailable","condition":"The store could not do the work right now (busy, I/O); safe to retry.","type":"store-error","kind":"unavailable"}],"exposure":"local","deployment":"shipped"},
    {"id":"find-account","name":"Find a local account by login","ref":"CT-025","realisation":"generated","implementedBy":"store-contract","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"login","type":"string"}],"outputs":[{"name":"account","type":"account","optional":true}],"errors":[{"name":"unavailable","condition":"The store could not do the work right now (busy, I/O); safe to retry.","type":"store-error","kind":"unavailable"},{"name":"corrupt","condition":"Stored data could not be read back; not safe to ignore.","type":"store-error","kind":"internal"}],"exposure":"local","deployment":"shipped"},
    {"id":"create-snapshot","name":"Keep a copy of the complete state of a tenant","ref":"CT-026","realisation":"generated","implementedBy":"store-contract","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":false,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"label","type":"string"},{"name":"at","type":"timestamp"}],"outputs":[{"name":"snapshot","type":"snapshot-info"}],"postconditions":["The snapshot names the canonical hash of the state it holds."],"errors":[{"name":"not-found","condition":"The tenant does not exist.","type":"store-error","kind":"not_found"},{"name":"unavailable","condition":"The store could not do the work right now (busy, I/O); safe to retry.","type":"store-error","kind":"unavailable"}],"exposure":"local","deployment":"shipped"},
    {"id":"list-snapshots","name":"List the snapshots of a tenant","ref":"CT-027","realisation":"generated","implementedBy":"store-contract","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"}],"outputs":[{"name":"snapshots","type":"list<snapshot-info>"}],"errors":[{"name":"unavailable","condition":"The store could not do the work right now (busy, I/O); safe to retry.","type":"store-error","kind":"unavailable"},{"name":"corrupt","condition":"Stored data could not be read back; not safe to ignore.","type":"store-error","kind":"internal"}],"exposure":"local","deployment":"shipped"},
    {"id":"load-snapshot","name":"Load the state a snapshot holds","ref":"CT-028","realisation":"generated","implementedBy":"store-contract","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"id","type":"u64"}],"outputs":[{"name":"tenant","type":"tenant-state"}],"errors":[{"name":"not-found","condition":"The snapshot does not exist.","type":"store-error","kind":"not_found"},{"name":"unavailable","condition":"The store could not do the work right now (busy, I/O); safe to retry.","type":"store-error","kind":"unavailable"},{"name":"corrupt","condition":"Stored data could not be read back; not safe to ignore.","type":"store-error","kind":"internal"}],"exposure":"local","deployment":"shipped"},
    {"id":"restore-snapshot","name":"Put a tenant back as a snapshot holds it","ref":"CT-029","realisation":"generated","implementedBy":"store-contract","auth":{"scheme":"in-process","roles":["platform-operator"],"description":"A platform operator"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"id","type":"u64"}],"outputs":[],"postconditions":["The tenant is exactly as the snapshot holds it; events and journal entries newer than the snapshot are discarded."],"errors":[{"name":"not-found","condition":"The snapshot does not exist.","type":"store-error","kind":"not_found"},{"name":"unavailable","condition":"The store could not do the work right now (busy, I/O); safe to retry.","type":"store-error","kind":"unavailable"}],"exposure":"local","deployment":"shipped"},
    {"id":"reset-store","name":"Remove everything from a store","ref":"CT-030","realisation":"generated","implementedBy":"store-contract","auth":{"scheme":"in-process","description":"Development fixtures only; refused outside development"},"idempotent":true,"inputs":[],"outputs":[],"errors":[{"name":"unavailable","condition":"The store could not do the work right now (busy, I/O); safe to retry.","type":"store-error","kind":"unavailable"}],"exposure":"local","development":"STRATA_DEV","deployment":"shipped"},
    {"id":"execute-intent","name":"Decide an intent and commit it","ref":"CT-031","realisation":"derived","implementedBy":"store-contract","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":false,"timeoutMs":300,"inputs":[{"name":"tenant","type":"tenant-id","description":"The tenant to load: the context's."},{"name":"intent","type":"intent"},{"name":"context","type":"context"}],"outputs":[{"name":"transition","type":"transition-result"},{"name":"receipt","type":"receipt"}],"postconditions":["The needs the kernel names are loaded, the intent is decided and the commit is applied atomically (storage-api execute): at most 32 needs beyond the first load are asked for (MAX_NEED_ROUNDS), and a commit that lost a race is decided again on the new state at most 8 times (MAX_CONFLICT_RETRIES).","A state-changing intent is confirmed as committed within 300 ms at the 99th percentile (OPS-334).","The number of retried commits, which storage-api Executed reports as conflicts, is not an output of the derivation."],"errors":[{"name":"domain","condition":"The kernel rejected the intent; the store is unchanged. Its HTTP status, where one is served, is error-code-of of its kind.","type":"domain-error","kind":"invalid"},{"name":"store","condition":"The store failed.","type":"store-error","kind":"unavailable"},{"name":"insufficient-state","condition":"The decision asked for more needs than needRounds allows, or for one it was already given.","type":"need","kind":"internal"},{"name":"conflict","condition":"Every commit lost its race to another one, retries times over; nothing is changed.","type":"store-error","kind":"conflict"},{"name":"invalid","condition":"The commit is malformed, or its events do not continue the tenant event sequence without a gap; nothing is changed.","type":"store-error","kind":"invalid"},{"name":"unavailable","condition":"The store could not do the work right now (busy, I/O); safe to retry.","type":"store-error","kind":"unavailable"},{"name":"corrupt","condition":"Stored data could not be read back; not safe to ignore.","type":"store-error","kind":"internal"},{"name":"fault","condition":"An integer overflow in the decision (a revision, an event sequence, a version or a record id past its type); never in practice.","kind":"internal"}],"exposure":"local","derivation":{"kind":"command","needs":"header-needs","load":"load-decision-snapshot","decide":"execute-decide","commit":"commit-accepted","conflict":"conflict","insufficient":"insufficient-state","needRounds":32,"retries":8,"fault":"fault"},"deployment":"shipped"},
    {"id":"execute-read","name":"Answer a read from the store","ref":"CT-032","realisation":"derived","implementedBy":"store-contract","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id","description":"The tenant to load: the context's."},{"name":"request","type":"read-request"},{"name":"context","type":"context"}],"outputs":[{"name":"result","type":"read-result"}],"postconditions":["Only the records the read needs are loaded (storage-api query: the schema, then read_needs); a decision asks for at most 32 needs beyond the first load."],"errors":[{"name":"domain","condition":"The kernel rejected the read.","type":"domain-error","kind":"invalid"},{"name":"store","condition":"The store failed.","type":"store-error","kind":"unavailable"},{"name":"insufficient-state","condition":"The decision asked for more needs than needRounds allows, or for one it was already given.","type":"need","kind":"internal"},{"name":"unavailable","condition":"The store could not do the work right now (busy, I/O); safe to retry.","type":"store-error","kind":"unavailable"},{"name":"corrupt","condition":"Stored data could not be read back; not safe to ignore.","type":"store-error","kind":"internal"},{"name":"fault","condition":"A checked conversion or integer operation inside the derivation overflowed or broke a type constraint; nothing was changed.","kind":"internal"}],"exposure":"local","derivation":{"kind":"read","needs":"header-needs","load":"load-decision-snapshot","decide":"execute-read-decide","insufficient":"insufficient-state","needRounds":32,"fault":"fault"},"deployment":"shipped"},
    {"id":"provision-tenant","name":"Provision a tenant","ref":"CT-033","realisation":"generated","implementedBy":"control-plane","auth":{"scheme":"session","roles":["platform-operator"],"csrf":true,"origin":true,"description":"Platform operator, or a person starting a sandbox (see start-sandbox)","requires":["tenant-provision"]},"idempotent":false,"timeoutMs":30000,"inputs":[{"name":"name","type":"string"},{"name":"template","type":"template-id"},{"name":"plan","type":"plan-id"},{"name":"region","type":"region-id","optional":true},{"name":"owner-address","type":"email-address","description":"The mail address that receives the first credential (TEN-1230)."}],"outputs":[{"name":"tenant","type":"tenant-id"},{"name":"state","type":"tenant-lifecycle"}],"postconditions":["A database that holds the data of this tenant alone exists (TEN-001), in the region asked for (TEN-005).","The tenant is recorded as provisioning from the first commit and reported as active only in the last, after its layout, template and first owner credential are in place; a failed run is resumed or rolled back, and leaves no active tenant (TEN-002, TEN-003, TEN-1232).","One bootstrap credential for the first owner is mailed to the owner address and to nobody else; it is not returned, logged or shown to the caller, and it is refused after its first use and after its expiry (TEN-500, TEN-1230).","The tenant is reachable by host name with no restart of any component (TEN-1231).","An audit entry is written and a dry run is offered (AGT-415)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The template, plan or region is unknown.","type":"api-error","kind":"invalid"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"internal","deployment":"target","tenantScope":"platform"},
    {"id":"get-tenant","name":"Read a tenant directory entry","ref":"CT-034","realisation":"generated","implementedBy":"control-plane","auth":{"scheme":"service","description":"Service credential of a platform component","requires":["tenant-resolve"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"}],"outputs":[{"name":"tenant","type":"tenant-directory-entry"}],"postconditions":["The entry is served for at most 15 minutes after the control plane was last reached (ARC-500).","The control database holds no field of a tenant record (TEN-006)."],"errors":[{"name":"not-found","condition":"The tenant named by the input does not exist.","type":"api-error","kind":"not_found"},{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"}],"exposure":"internal","readOnly":true,"deployment":"target","tenantScope":"platform"},
    {"id":"resolve-host","name":"Resolve a host name to a tenant and placement","ref":"CT-035","realisation":"generated","implementedBy":"control-plane","auth":{"scheme":"service","description":"Service credential of a platform component","requires":["tenant-resolve"]},"idempotent":true,"inputs":[{"name":"host","type":"host"}],"outputs":[{"name":"tenant","type":"tenant-id"},{"name":"placement","type":"placement-id"}],"postconditions":["The same name resolves to the same tenant before and after a move (TEN-013)."],"errors":[{"name":"not-found","condition":"The host name is bound to no tenant; no tenant database is contacted (EDG-011).","type":"api-error","kind":"not_found"}],"exposure":"internal","readOnly":true,"deployment":"target","tenantScope":"platform"},
    {"id":"suspend-tenant","name":"Suspend a tenant","ref":"CT-036","realisation":"generated","implementedBy":"control-plane","auth":{"scheme":"session","roles":["platform-operator"],"csrf":true,"origin":true,"description":"A platform operator","requires":["tenant-suspend"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"reason","type":"tenant-suspension-reason"}],"outputs":[{"name":"state","type":"tenant-lifecycle"}],"postconditions":["A suspended tenant refuses state-changing requests (TEN-009, TEN-1222) and runs no background work (TEN-1223).","A tenant suspended for a commercial reason serves its published content (TEN-1221).","All of its data is kept (BIL-154)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The tenant named by the input does not exist.","type":"api-error","kind":"not_found"},{"name":"invalid","condition":"The reason is a takedown reason.","type":"api-error","kind":"invalid"}],"exposure":"internal","deployment":"target","preconditions":["The reason is payment-overdue, trial-ended or owner-request; a takedown reason is given to take-down-tenant (THR-1226)."],"tenantScope":"platform"},
    {"id":"resume-tenant","name":"Resume a suspended tenant","ref":"CT-037","realisation":"generated","implementedBy":"control-plane","auth":{"scheme":"session","roles":["platform-operator"],"csrf":true,"origin":true,"description":"A platform operator","requires":["tenant-suspend"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"}],"outputs":[{"name":"state","type":"tenant-lifecycle"}],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The tenant named by the input does not exist.","type":"api-error","kind":"not_found"},{"name":"conflict","condition":"The tenant is not suspended, or is suspended with a takedown reason, which release-takedown ends (CT-567).","type":"api-error","kind":"conflict"}],"exposure":"internal","deployment":"target","tenantScope":"platform"},
    {"id":"export-tenant","name":"Export a tenant","ref":"CT-038","realisation":"generated","implementedBy":"control-plane","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["tenant-export"],"stepUp":"15 min"},"idempotent":false,"inputs":[{"name":"tenant","type":"tenant-id"}],"outputs":[{"name":"archive","type":"archive-ref"}],"postconditions":["The export restores into an empty installation as a state with the same canonical hash (TEN-010).","The archive holds no credential, session, challenge, API grant, provider secret, connector secret or delivery key (TEN-1200, D-6200).","The export is recorded in the audit log with the principal, the tenant and the outcome (OBS-1217)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The tenant named by the input does not exist.","type":"api-error","kind":"not_found"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"delete-tenant","name":"Delete a tenant","ref":"CT-039","realisation":"generated","implementedBy":"control-plane","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["tenant-delete"],"stepUp":"15 min"},"idempotent":false,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"confirm-tenant","type":"tenant-id"}],"outputs":[{"name":"certificate","type":"deletion-certificate"}],"preconditions":["A deletion request of an owner exists for the tenant and the grace period that the plan states has ended since it was made (D-705, ADM-160, D-6207)."],"postconditions":["The database, stored files and encryption key of the tenant are removed (TEN-011).","The certificate states when the key was destroyed and when each backup image and export was removed (PRV-354).","The certificate also states when each export, the retained source database of a move (MIG-572), each fork and the state of the key service for the tenant were removed (PRV-1214, D-6207).","The execution is recorded in the audit log of the platform and every owner is told (PRV-1214)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The tenant named by the input does not exist.","type":"api-error","kind":"not_found"},{"name":"invalid","condition":"The request does not repeat the identifier of the tenant it destroys (OPS-325).","type":"api-error","kind":"invalid"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"conflict","condition":"No deletion request exists for the tenant, or the grace period has not ended (D-6207).","type":"api-error","kind":"conflict"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"cancel-tenant-deletion","name":"Cancel a pending tenant deletion","ref":"CT-040","realisation":"generated","implementedBy":"control-plane","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["tenant-delete"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"}],"outputs":[{"name":"state","type":"tenant-lifecycle"}],"postconditions":["A deletion requested by the owner stays cancellable until the grace period ends (ADM-160).","Every owner of the tenant is told of the cancellation (PRV-1214, D-6207).","The cancellation is recorded in the audit log (OBS-1217)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The tenant named by the input does not exist.","type":"api-error","kind":"not_found"},{"name":"conflict","condition":"The grace period has ended.","type":"api-error","kind":"conflict"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"restore-tenant","name":"Restore a tenant to a point in time","ref":"CT-041","realisation":"generated","implementedBy":"control-plane","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["tenant-restore"],"stepUp":"15 min"},"idempotent":false,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"at","type":"timestamp"}],"outputs":[{"name":"revision","type":"u64"},{"name":"first-lost-change","type":"u64","optional":true},{"name":"last-lost-change","type":"u64","optional":true}],"postconditions":["The restored state has the hash that the journal records at that point (TEN-015).","The first and last committed change that was not restored are reported (MIG-573).","A backup of one tenant is unreadable with the key of any other tenant (TEN-252).","Every session, challenge, API grant and support grant of the tenant is ended, and each removal of access after the restore point is applied again before the tenant serves a request (TEN-1212, D-6206).","The restore is recorded in the audit log, which the restore does not roll back (OBS-1217)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The tenant named by the input does not exist.","type":"api-error","kind":"not_found"},{"name":"invalid","condition":"The point lies outside the restorable window, which is 30 days unless the tenant chose another and never under 14 days (OPS-1213, D-6205).","type":"api-error","kind":"invalid"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"start-sandbox","name":"Start a sandbox tenant","ref":"CT-042","realisation":"generated","implementedBy":"control-plane","auth":{"scheme":"anonymous","csrf":true,"origin":true,"justification":"The starter is a visitor with no principal, since principals belong to one tenant (D-500); control of a mail address is proved by a single-use code (TEN-1237).","description":"A visitor who proves control of a mail address","requires":["sandbox-start"]},"idempotent":false,"timeoutMs":30000,"inputs":[{"name":"template","type":"template-id"},{"name":"owner-address","type":"email-address"},{"name":"verification-code","type":"secret"}],"outputs":[{"name":"tenant","type":"tenant-id"}],"postconditions":["The visitor becomes the owner with no step by a platform operator (ADM-154), and receives the first credential at the verified address (TEN-1230).","The sandbox is deleted at the end of the period its plan states unless kept (ADM-155).","At most one live sandbox exists for the address, and at most 3 are started from one source address in 24 hours (TEN-1238)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"invalid","condition":"The template is not published.","type":"api-error","kind":"invalid"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"},{"name":"conflict","condition":"A live sandbox exists for this address (TEN-1238).","type":"api-error","kind":"conflict"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"keep-sandbox","name":"Keep a sandbox tenant","ref":"CT-043","realisation":"generated","implementedBy":"control-plane","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["sandbox-keep"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"}],"outputs":[{"name":"kind","type":"tenant-kind"}],"postconditions":["The kind changes to production without copying records (ADM-156)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The tenant named by the input does not exist.","type":"api-error","kind":"not_found"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"bind-domain","name":"Bind a domain name to a tenant","ref":"CT-044","realisation":"generated","implementedBy":"control-plane","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["domain-manage"],"stepUp":"15 min"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"host","type":"host"}],"outputs":[{"name":"binding","type":"domain-binding"}],"postconditions":["The tenant serves its site from the name only after proof of control (EDG-009).","A name that a removed tenant held is bound to another tenant only after proof is given again (EDG-253)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"Control of the name is not proved.","type":"api-error","kind":"invalid"},{"name":"conflict","condition":"The name is bound to another tenant.","type":"api-error","kind":"conflict"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"remove-domain-binding","name":"Remove a domain binding","ref":"CT-045","realisation":"generated","implementedBy":"control-plane","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["domain-manage"],"stepUp":"15 min"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"host","type":"host"}],"outputs":[],"postconditions":["Every edge copy stored under the host name is purged (EDG-008)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The binding does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"change-plan","name":"Change the plan of a tenant","ref":"CT-046","realisation":"generated","implementedBy":"control-plane","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["plan-change"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"plan","type":"plan-id"}],"outputs":[{"name":"plan","type":"plan-id"}],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The tenant holds more of a metered quantity than the new plan allows; the quantity is named (MIG-583).","type":"api-error","kind":"invalid"},{"name":"billing-standing","condition":"The billing account of the tenant is not in good standing: an invoice is past its due date, or a paid plan has no payment method (BIL-1204).","type":"api-error","kind":"conflict"},{"name":"contract-required","condition":"The change is to or from Enterprise and no contract is recorded for the tenant (BIL-1204, CT-551).","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The tenant does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"target","postconditions":["The change is recorded in the audit log with the previous plan, the new plan, the principal and the correlation (D-508, OPS-329, OBS-1217).","A change to or from Enterprise takes effect only when the platform operator has recorded a contract for the tenant (BIL-1204, D-6202)."]},
    {"id":"find-due-tenants","name":"Find tenants that have due work","ref":"CT-047","realisation":"generated","implementedBy":"control-plane","auth":{"scheme":"service","description":"Service credential of a platform component","requires":["tenant-resolve"]},"idempotent":true,"inputs":[{"name":"now","type":"timestamp"},{"name":"limit","type":"u32"}],"outputs":[{"name":"tenants","type":"list<wake-entry>"}],"postconditions":["Each entry holds a tenant identifier and a due time and no content of a job (SCH-008).","The index is rebuildable from the tenant databases (ARC-101)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"}],"exposure":"internal","readOnly":true,"deployment":"target","tenantScope":"platform"},
    {"id":"record-next-due","name":"Record when a tenant next has work","ref":"CT-048","realisation":"generated","implementedBy":"control-plane","auth":{"scheme":"service","description":"Service credential of a platform component","requires":["tenant-resolve"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"due-at","type":"timestamp","optional":true}],"outputs":[],"postconditions":["The previous entry of the tenant is replaced."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"not-found","condition":"The tenant named by the input does not exist.","type":"api-error","kind":"not_found"}],"exposure":"internal","deployment":"target","tenantScope":"platform"},
    {"id":"apply-layout-change","name":"Apply a storage layout change to one tenant database","ref":"CT-049","realisation":"generated","implementedBy":"control-plane","auth":{"scheme":"session","roles":["platform-operator"],"csrf":true,"origin":true,"description":"A platform operator","requires":["layout-apply"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"layout-version","type":"u32"},{"name":"phase","type":"layout-phase"}],"outputs":[{"name":"outcome","type":"layout-outcome"}],"postconditions":["The outcome is recorded per tenant (TEN-014).","A tenant whose change fails stays on its previous layout and keeps serving (MIG-565).","The expanding phase runs on all tenants before any tenant runs the contracting phase (OPS-324)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"conflict","condition":"The wave stopped because its failure limit was exceeded (OPS-323).","type":"api-error","kind":"conflict"}],"exposure":"internal","deployment":"target","tenantScope":"platform"},
    {"id":"health-check","name":"Report the health of a component","ref":"CT-050","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"anonymous","justification":"Health probes reach it before any credential exists (RUN-003); it reports only liveness.","description":"Anyone with network reach; the only call that needs no service credential (RUN-003)","requires":["health-read"]},"idempotent":true,"inputs":[],"outputs":[{"name":"ok","type":"bool"},{"name":"detail","type":"string"}],"postconditions":["A component reports ready only while its dependencies answer (OBS-004)."],"errors":[{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"internal","readOnly":true,"deployment":"shipped","tenantScope":"none"},
    {"id":"sign-in-with-password","name":"Sign in with a password","ref":"CT-051","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"anonymous","csrf":true,"origin":true,"justification":"Signing in is how a visitor gets a session.","description":"Anyone; no session is needed","requires":["identity-sign-in"]},"idempotent":false,"timeoutMs":2000,"inputs":[{"name":"login","type":"string"},{"name":"password","type":"secret"}],"outputs":[{"name":"token","type":"secret"},{"name":"session","type":"session-view"}],"preconditions":["The request carries the request token that the gateway issued to the browser (GWY-257)."],"postconditions":["A session is issued for this tenant only; the session the browser held before ends (IDN-011).","Repeated failures for one account delay further attempts (IDN-008); failures from one source are refused across accounts at the threshold (IDN-250).","A login that does not exist costs as long to answer as a wrong password (IDN-255).","An audit entry names the method, outcome and checks (IDN-021).","A realm policy asking for a second factor withholds the session until one is verified (IDN-018)."],"errors":[{"name":"unauthenticated","condition":"The credentials do not match, the account does not exist or the factor is missing; the response does not say which (IDN-255, UXA-202).","type":"api-error","kind":"unauthenticated"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"request-sign-in-link","name":"Request an emailed sign-in link","ref":"CT-052","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"anonymous","csrf":true,"origin":true,"justification":"A visitor without a session asks for a sign-in link.","description":"Anyone; no session is needed","requires":["identity-sign-in"]},"idempotent":false,"inputs":[{"name":"email","type":"email-address"}],"outputs":[],"postconditions":["The response is the same whether or not the address belongs to an account (IDN-006).","Requests per address and per browser are limited (IDN-269).","The challenge holds the principal identifier and no email address (PRV-365)."],"errors":[{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"}],"exposure":"public","tenantScope":"request","bffRoute":"POST /api/sign-in/link/request","deployment":"target"},
    {"id":"sign-in-with-link","name":"Sign in with an emailed link","ref":"CT-053","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"anonymous","csrf":true,"origin":true,"justification":"Signing in is how a visitor gets a session; the emailed token proves the address.","description":"Anyone; no session is needed","requires":["identity-sign-in"]},"idempotent":false,"inputs":[{"name":"challenge","type":"challenge-id"},{"name":"token","type":"secret"}],"outputs":[{"name":"token","type":"secret"},{"name":"session","type":"session-view"}],"postconditions":["The link is accepted once, within its lifetime and only in the browser that requested it (IDN-003, IDN-004, IDN-005)."],"errors":[{"name":"unauthenticated","condition":"The credentials do not match, the account does not exist or the factor is missing; the response does not say which (IDN-255, UXA-202).","type":"api-error","kind":"unauthenticated"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"sign-in-with-passkey","name":"Sign in with a passkey","ref":"CT-054","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"anonymous","csrf":true,"origin":true,"justification":"Signing in is how a visitor gets a session; the passkey assertion proves the account.","description":"Anyone; no session is needed","requires":["identity-sign-in"]},"idempotent":false,"inputs":[{"name":"challenge","type":"challenge-id"},{"name":"assertion","type":"bytes"}],"outputs":[{"name":"token","type":"secret"},{"name":"session","type":"session-view"}],"postconditions":["The assertion carries a challenge issued for this sign-in and bound to the address it was requested at (IDN-264)."],"errors":[{"name":"unauthenticated","condition":"The credentials do not match, the account does not exist or the factor is missing; the response does not say which (IDN-255, UXA-202).","type":"api-error","kind":"unauthenticated"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"register-passkey","name":"Register a passkey","ref":"CT-055","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"session","csrf":true,"origin":true,"stepUp":"15 min","description":"A signed-in principal","requires":["account-manage"]},"idempotent":false,"inputs":[{"name":"challenge","type":"challenge-id","description":"The challenge that start-passkey-registration answered, of this session."},{"name":"credential","type":"json","description":"The attestation the authenticator made, as the browser serialises it."},{"name":"name","type":"string","optional":true,"description":"A label for the passkey, at most 64 bytes; \"Passkey\" when absent or empty."}],"outputs":[{"name":"passkey","type":"json","description":"The passkey that was added: id, name, created_at and last_used_at."}],"postconditions":["The credential is bound to the address of the tenant as the relying party (IDN-007)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"invalid","condition":"The challenge is unknown, used, lapsed or another session's, the attestation does not verify, or the credential is already registered; the answer does not say which.","type":"api-error","kind":"invalid"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"target","bffRoute":"POST /api/passkeys/register/finish"},
    {"id":"verify-second-factor","name":"Verify a second factor","ref":"CT-056","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"anonymous","csrf":true,"origin":true,"justification":"The second step of signing in, before a session exists.","description":"Anyone; no session is needed","requires":["identity-sign-in"]},"idempotent":false,"inputs":[{"name":"challenge","type":"challenge-id"},{"name":"code","type":"secret"}],"outputs":[{"name":"token","type":"secret"},{"name":"session","type":"session-view"}],"postconditions":["A one-time code is spent when its failed presentations reach the limit (IDN-253).","Prompts sent to one account are limited within the window (IDN-268)."],"errors":[{"name":"unauthenticated","condition":"The credentials do not match, the account does not exist or the factor is missing; the response does not say which (IDN-255, UXA-202).","type":"api-error","kind":"unauthenticated"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"}],"exposure":"public","tenantScope":"request","bffRoute":"POST /api/sign-in/second-factor","deployment":"target"},
    {"id":"sign-up","name":"Sign up with a password","ref":"CT-057","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"anonymous","csrf":true,"origin":true,"justification":"Signing up is how a visitor gets an account.","description":"Anyone; no session is needed","requires":["identity-sign-in"]},"idempotent":false,"inputs":[{"name":"email","type":"email-address"},{"name":"password","type":"secret"},{"name":"display-name","type":"display-name"}],"outputs":[],"postconditions":["An address that already has an account receives the response that a new address receives (IDN-256).","The owner of the address is sent a notice (IDN-257)."],"errors":[{"name":"invalid","condition":"The password appears on the breached-password list of the realm (IDN-252).","type":"api-error","kind":"invalid"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"sign-out","name":"Sign out","ref":"CT-058","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"session","csrf":true,"origin":true,"description":"A signed-in principal","requires":["session-manage"]},"idempotent":true,"inputs":[{"name":"session-id","type":"session-id"}],"outputs":[],"preconditions":["The request carries the request token that the gateway issued (GWY-257)."],"postconditions":["The session is revoked at the identity service, not only the cookie in the browser (IDN-263)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"look-up-session","name":"Look up a session","ref":"CT-059","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"service","description":"Service credential of a platform component","requires":["session-verify"]},"idempotent":true,"timeoutMs":2000,"inputs":[{"name":"token","type":"secret"},{"name":"host","type":"host"}],"outputs":[{"name":"assertion","type":"identity-assertion"}],"postconditions":["A session issued for one tenant carries no identity at the address of another (RUN-002).","The answer is a signed assertion; a component accepts a caller identity only from one (IDN-017).","A revoked session is refused within 5 seconds by every gateway instance (IDN-014).","The session ends at the shorter of its idle and absolute lifetimes (IDN-259)."],"errors":[{"name":"unauthenticated","condition":"The session is unknown, ended or revoked.","type":"api-error","kind":"unauthenticated"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"internal","readOnly":true,"deployment":"target","tenantScope":"platform"},
    {"id":"list-sessions","name":"List the sessions of the caller","ref":"CT-060","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"session","description":"A signed-in principal","requires":["session-manage"]},"idempotent":true,"inputs":[],"outputs":[{"name":"sessions","type":"list<session-summary>"}],"postconditions":["A session record holds no user agent string and no network address except as a keyed hash (PRV-364)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"}],"exposure":"public","readOnly":true,"tenantScope":"request","bffRoute":"GET /api/sessions","deployment":"target"},
    {"id":"revoke-session","name":"Revoke a session","ref":"CT-061","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"session","csrf":true,"origin":true,"description":"A signed-in principal","requires":["session-manage"],"stepUp":"15 min"},"idempotent":true,"inputs":[{"name":"session-id","type":"session-id"}],"outputs":[],"postconditions":["The session is refused from then on (IDN-012)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"not-found","condition":"The session does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","bffRoute":"POST /api/sessions/revoke","deployment":"target"},
    {"id":"change-password","name":"Change a password","ref":"CT-062","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"session","csrf":true,"origin":true,"stepUp":"15 min","description":"A signed-in principal","requires":["account-manage"]},"idempotent":false,"inputs":[{"name":"current","type":"secret"},{"name":"new","type":"secret"}],"outputs":[],"postconditions":["The other sessions of the account are revoked (IDN-016)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"invalid","condition":"The new password appears on the breached-password list.","type":"api-error","kind":"invalid"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"recover-account","name":"Recover an account","ref":"CT-063","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"anonymous","csrf":true,"origin":true,"justification":"Recovery is for a person who cannot sign in.","description":"Anyone; no session is needed","requires":["identity-sign-in"]},"idempotent":false,"inputs":[{"name":"email","type":"email-address"}],"outputs":[{"name":"requested","type":"bool","description":"True for every well-formed request, whether or not the address has a recoverable account."}],"postconditions":["Nothing of the account changes when a recovery is asked for: the request is stored and every registered contact of an account that has one is told before the recovery can complete, after the delay the platform states (IDN-265).","The answer and the work done are the same for an address that has no recoverable account.","Every existing session of the account is revoked and the second factor stays in force when the recovery completes, not here (complete-recovery, IDN-020, IDN-266)."],"errors":[{"name":"forbidden","condition":"The request did not come from one of the site's own pages.","type":"api-error","kind":"forbidden"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"}],"exposure":"public","tenantScope":"request","deployment":"target","bffRoute":"POST /api/recovery/request"},
    {"id":"accept-invitation","name":"Accept an invitation","ref":"CT-064","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"anonymous","csrf":true,"origin":true,"justification":"An invited person has no account yet; the invitation token names them.","description":"Anyone; no session is needed","requires":["invitation-redeem"]},"idempotent":false,"inputs":[{"name":"invitation","type":"secret"},{"name":"email","type":"email-address"}],"outputs":[{"name":"principal","type":"principal-id"}],"postconditions":["The invitation grants its roles to the one person who redeems it with the address it names and to no one else (ADM-153)."],"errors":[{"name":"invalid","condition":"The invitation is unknown, used or names another address.","type":"api-error","kind":"invalid"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"configure-realm","name":"Change the realm configuration","ref":"CT-065","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["realm-configure"],"stepUp":"15 min"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"policy","type":"realm-policy"},{"name":"dry-run","type":"bool","optional":true}],"outputs":[{"name":"projection","type":"projection-summary"}],"postconditions":["Each change is projected before it applies (AGT-425)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The policy turns password sign-in off while an owner has no other method and no recovery path (IDN-700).","type":"api-error","kind":"invalid"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"end-principal-sessions","name":"End every session of a principal","ref":"CT-066","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"service","description":"Service credential of a platform component","requires":["session-end"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"principal","type":"principal-id"}],"outputs":[{"name":"ended","type":"u64"}],"postconditions":["A principal that no longer holds a role in the tenant has no session (kernel effect RevokeSessions).","Only a credential whose service role holds session-end ends the sessions of a principal (SEC-1208, D-6203)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The calling component does not hold the capability session-end, or the tenant is not the tenant that its credential names (SEC-1208, TEN-257).","type":"api-error","kind":"forbidden"}],"exposure":"internal","deployment":"target","tenantScope":"platform"},
    {"id":"start-oidc-sign-in","name":"Start an OpenID Connect sign-in","ref":"CT-067","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"anonymous","csrf":true,"origin":true,"justification":"Signing in with a provider starts before any session exists.","description":"Anyone; no session is needed","requires":["identity-sign-in"]},"idempotent":false,"inputs":[{"name":"provider","type":"provider-id"},{"name":"return-to","type":"string","optional":true}],"outputs":[{"name":"redirect","type":"url"}],"postconditions":["The authorization code flow with a proof key is used (FED-002).","A pending request is bound to the browser."],"errors":[{"name":"invalid","condition":"The provider is unknown or the return address is not a path on the host of the tenant (FED-250).","type":"api-error","kind":"invalid"}],"exposure":"public","tenantScope":"request","bffRoute":"POST /api/sign-in/oidc/start","deployment":"target"},
    {"id":"complete-oidc-sign-in","name":"Complete an OpenID Connect sign-in","ref":"CT-068","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"signature","secret":"oidc-provider-signing-keys","description":"Anyone; no session is needed","requires":["identity-federate"]},"idempotent":false,"inputs":[{"name":"state","type":"secret"},{"name":"code","type":"secret"}],"outputs":[{"name":"token","type":"secret"},{"name":"return-to","type":"string"}],"postconditions":["An identity token whose issuer, audience, signature or nonce fails verification is refused (FED-003).","Provider signing keys refresh from the metadata when a token names an unknown key (FED-004).","A first sign-in creates a principal only when the realm enabled it, with only the default role (FED-011, FED-258).","An asserted address links to an existing principal only when the provider marks it verified (FED-257)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"invalid","condition":"The state value matches no pending request of this browser (FED-001).","type":"api-error","kind":"invalid"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","tenantScope":"request","bffRoute":"GET /federation/oidc/callback","deployment":"target"},
    {"id":"serve-saml-metadata","name":"Serve SAML service provider metadata","ref":"CT-069","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"anonymous","description":"Anyone; no session is needed","requires":["identity-sign-in"]},"idempotent":true,"inputs":[{"name":"provider","type":"string","description":"The identifier of an enabled SAML provider of this tenant, at most 32 bytes, as the last segment of the address."}],"outputs":[{"name":"metadata","type":"bytes","description":"The service provider metadata as XML, served as application/samlmetadata+xml: the entity identifier and the assertion consumer address of the site's published origin."}],"errors":[{"name":"not-found","condition":"The provider does not exist, is not enabled for this tenant, or the site has no published origin to name.","type":"api-error","kind":"not_found"},{"name":"unavailable","condition":"The gateway has no published origin for the site, or the backend did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target","bffRoute":"GET /federation/saml/metadata/:provider"},
    {"id":"consume-saml-assertion","name":"Consume a SAML assertion","ref":"CT-070","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"signature","secret":"saml-provider-certificate","description":"Anyone; no session is needed","requires":["identity-federate"]},"idempotent":false,"inputs":[{"name":"response","type":"bytes"},{"name":"relay-state","type":"secret","optional":true}],"outputs":[{"name":"token","type":"secret"},{"name":"return-to","type":"string"}],"postconditions":["The assertion is accepted only when signed by the certificate the tenant configured (FED-005).","A repeated assertion is refused (FED-006).","The message is read with external entities and document type processing off (FED-251).","The subject is the complete text of the name identifier (FED-253)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"invalid","condition":"The signature, issuer, audience or recipient is wrong, the assertion was presented before, or the response answers no pending request.","type":"api-error","kind":"invalid"}],"exposure":"public","tenantScope":"request","bffRoute":"POST /federation/saml/acs","deployment":"target"},
    {"id":"provision-user","name":"Provision a person by SCIM","ref":"CT-071","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"provisioning-token","description":"A provisioning token of one realm (FED-259)","requires":["directory-provision"]},"idempotent":false,"inputs":[{"name":"user-name","type":"string","description":"The login of the person (userName of the SCIM resource), at most 254 characters; the account is made under it."},{"name":"external-id","type":"string","optional":true,"description":"The provider's identifier of the person (externalId), at most 255 characters; the identity is tied under it."},{"name":"display-name","type":"string","optional":true,"description":"The name shown (displayName), at most 80 characters; the user name when absent."},{"name":"active","type":"bool","optional":true,"description":"False makes the account at once deactivated; true when absent."}],"outputs":[{"name":"principal","type":"principal-id","description":"The id of the SCIM resource that answers 201."}],"postconditions":["Deactivating a person revokes that person's sessions (FED-015).","A POST makes one person: a repeat with a user name or an external id already in use answers 409 with the SCIM type uniqueness and changes nothing; a person is changed by PUT or PATCH on the resource.","The provisioning token of the Authorization header is the credential; the answer is the SCIM resource or a SCIM error, as the SCIM 2.0 protocol states."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"invalid","condition":"The SCIM resource is malformed.","type":"api-error","kind":"invalid"},{"name":"conflict","condition":"The user name or the external id is already in use (SCIM type uniqueness).","type":"api-error","kind":"conflict"},{"name":"throttled","condition":"Too many requests with a wrong provisioning token came from this source.","type":"api-error","kind":"throttled"}],"exposure":"public","tenantScope":"request","deployment":"target","bffRoute":"POST /scim/v2/Users"},
    {"id":"deprovision-user","name":"Deactivate a person by SCIM","ref":"CT-072","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"provisioning-token","description":"A provisioning token of one realm","requires":["directory-provision"]},"idempotent":true,"inputs":[{"name":"principal","type":"principal-id"}],"outputs":[],"postconditions":["Every session of the person is revoked (FED-015)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"not-found","condition":"The person does not exist for this tenant.","type":"api-error","kind":"not_found"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"map-group","name":"Change the roles of a principal through a SCIM group","ref":"CT-073","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"provisioning-token","description":"A provisioning token of one realm","requires":["directory-provision"]},"idempotent":true,"inputs":[{"name":"group","type":"string"},{"name":"members","type":"list<principal-id>"}],"outputs":[],"postconditions":["Roles change only through the group mapping the realm declares (FED-260)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"invalid","condition":"The realm declares no mapping for the group.","type":"api-error","kind":"invalid"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"issue-access-token","name":"Issue an access token by client credentials","ref":"CT-074","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"signature","secret":"client-secret","description":"A service account presenting its client secret","requires":["token-issue"]},"idempotent":false,"inputs":[{"name":"client","type":"principal-id"},{"name":"secret","type":"secret"},{"name":"scope","type":"list<string>","optional":true},{"name":"audience","type":"string"}],"outputs":[{"name":"access-token","type":"secret"},{"name":"expires-at","type":"timestamp"},{"name":"scope","type":"list<string>"}],"postconditions":["The token grants no scope beyond those of the grant (TOK-002) and is valid for at most 5 minutes (TOK-005).","The token is for one tenant and refused by every other (TOK-006)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"}],"exposure":"public","tenantScope":"request","bffRoute":"POST /token","deployment":"target"},
    {"id":"exchange-token","name":"Exchange a token for a delegated token","ref":"CT-075","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"delegation","description":"An agent holding a delegation from a person","requires":["token-exchange"]},"idempotent":false,"inputs":[{"name":"subject-token","type":"secret"},{"name":"agent","type":"principal-id"},{"name":"purpose","type":"string"},{"name":"expires-at","type":"timestamp"}],"outputs":[{"name":"access-token","type":"secret"},{"name":"expires-at","type":"timestamp"}],"postconditions":["The token names both the agent and the person (TOK-003).","It grants no permission the person lacks (TOK-004).","It is refused for an operation outside its purpose (AGS-408)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The scopes exceed those of the presented token, or the expiry is later than its expiry (AGS-406, AGS-407).","type":"api-error","kind":"invalid"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"introspect-token","name":"Introspect a token","ref":"CT-076","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"service","description":"A caller permitted to ask","requires":["session-verify"]},"idempotent":true,"inputs":[{"name":"token","type":"secret"}],"outputs":[{"name":"active","type":"bool"},{"name":"scope","type":"list<string>","optional":true},{"name":"subject","type":"principal-id","optional":true},{"name":"expires-at","type":"timestamp","optional":true}],"postconditions":["A revoked grant makes tokens issued from it inactive within the revocation bound of sessions (TOK-007)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"}],"exposure":"internal","readOnly":true,"deployment":"target","tenantScope":"platform"},
    {"id":"list-signing-keys","name":"Publish the signing keys","ref":"CT-077","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"anonymous","description":"Anyone; no session is needed","requires":["identity-sign-in"]},"idempotent":true,"inputs":[],"outputs":[{"name":"keys","type":"list<public-key>"}],"postconditions":["After a rotation, tokens signed by the previous key stay verifiable until they expire (TOK-008).","A key retired for compromise is absent from the moment of retirement (TOK-251)."],"errors":[],"exposure":"public","readOnly":true,"tenantScope":"request","bffRoute":"GET /keys","deployment":"target"},
    {"id":"revoke-grant","name":"Revoke a grant","ref":"CT-078","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"session","csrf":true,"origin":true,"description":"The person who made the delegation, or an owner of the tenant","requires":["grant-manage"]},"idempotent":true,"inputs":[{"name":"grant","type":"string","description":"The identifier of the delegation, at most 96 bytes."}],"outputs":[{"name":"grant","type":"string"},{"name":"revoked","type":"bool","description":"True; a delegation that was revoked already stays so and nothing is written again."}],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The delegation does not exist for this tenant, or it is another person's and the caller is not an owner; the answer does not say which.","type":"api-error","kind":"not_found"}],"exposure":"public","tenantScope":"request","deployment":"target","bffRoute":"POST /api/identity/grants/revoke"},
    {"id":"create-grant","name":"Create a grant","ref":"CT-079","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"session","csrf":true,"origin":true,"description":"A signed-in person; the person delegates only scopes they hold themselves (TOK-004)","requires":["grant-manage"]},"idempotent":false,"inputs":[{"name":"agent","type":"string","description":"The identifier of a live service account of the tenant that is to hold the delegation, at most 96 bytes. The principal that delegates is the signed-in caller; the body does not name one."},{"name":"scope","type":"list<string>","description":"The scopes to delegate, 1 to 32 of at most 96 bytes each, every one a scope of the tenant that the caller holds; the route also takes them as one space-separated text."},{"name":"expires-at","type":"timestamp","optional":true,"description":"When the delegation ends, in milliseconds; one hour from now when absent, and at most 30 days from now."},{"name":"purpose","type":"string","optional":true,"description":"Why, at most 200 characters."}],"outputs":[{"name":"grant","type":"string","description":"The identifier of the delegation (grt_ and 16 hexadecimal digits)."},{"name":"expires-at","type":"timestamp"},{"name":"scopes","type":"list<string>"}],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"No scope is named, a scope is not one the granting principal holds or the tenant has (AGS-412), the agent is not a live service account, or the end is not within 30 days from now.","type":"api-error","kind":"invalid"}],"exposure":"public","tenantScope":"request","deployment":"target","bffRoute":"POST /api/identity/grants/create"},
    {"id":"rotate-client-secret","name":"Rotate a client secret","ref":"CT-080","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"session","csrf":true,"origin":true,"stepUp":"15 min","description":"An owner of the tenant, who has authenticated within the step-up age","requires":["grant-manage"],"roles":["owner"]},"idempotent":false,"inputs":[{"name":"id","type":"string","description":"The identifier of the service account (svc: and 16 hexadecimal digits), at most 96 bytes."}],"outputs":[{"name":"secret","type":"secret","description":"The new secret, in this answer only."},{"name":"id","type":"string"},{"name":"name","type":"string"},{"name":"scopes","type":"list<string>"},{"name":"secret-set-at","type":"timestamp"}],"postconditions":["The secret is stored only as a hash and shown once, when created (TOK-252)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The tenant has no such service account.","type":"api-error","kind":"not_found"},{"name":"invalid","condition":"The service account is revoked.","type":"api-error","kind":"invalid"}],"exposure":"public","tenantScope":"request","deployment":"target","bffRoute":"POST /api/identity/clients/rotate-secret"},
    {"id":"schedule-job","name":"Schedule a job","ref":"CT-081","realisation":"generated","implementedBy":"automation-worker","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the operation","requires":["jobs-manage"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"kind","type":"string"},{"name":"due-at","type":"timestamp"},{"name":"idempotency-key","type":"string"},{"name":"payload","type":"value-map"}],"outputs":[{"name":"job","type":"job-id"}],"postconditions":["The job is offered to a worker no earlier than its time (SCH-001).","An effect with an idempotency key is applied once however many times its job is attempted (SCH-015).","A request to send mail becomes a job in the transaction that commits its change (EML-005)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The job is malformed.","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The payload names an automation the tenant does not have.","type":"api-error","kind":"not_found"},{"name":"conflict","condition":"The idempotency key made a job with other work, or the automation is suspended.","type":"api-error","kind":"conflict"}],"exposure":"public","tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/jobs/schedule","description":"Schedules a job of the kind start-run: a run of one of the tenant's automations at a time, with its parameters (D-7706). The idempotency key makes the job once; the same key with other work is a conflict."},
    {"id":"lease-job","name":"Take a lease on a due job","ref":"CT-082","realisation":"generated","implementedBy":"automation-worker","auth":{"scheme":"service","description":"Service credential of a platform component","requires":["jobs-run"]},"idempotent":false,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"worker","type":"string"}],"outputs":[{"name":"job","type":"job-id","optional":true},{"name":"lease-token","type":"u64","optional":true},{"name":"expires-at","type":"timestamp","optional":true}],"postconditions":["A due job starts within 5 seconds of its due time at the 99th percentile (SCH-002).","A worker that cannot reach the tenant database takes no lease (SCH-301).","A job whose worker stops responding is offered to another worker after the lease expires (SCH-010)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"internal","deployment":"shipped","tenantScope":"platform","description":"In this deployment the automation worker takes the lease in process (worker::leases::drain_tenant over Store::job_lease, D-7706): no route serves it and no service credential crosses a network. A worker that cannot reach the tenant file takes no lease (SCH-301)."},
    {"id":"report-job-result","name":"Report the result of a job attempt","ref":"CT-083","realisation":"generated","implementedBy":"automation-worker","auth":{"scheme":"service","description":"Service credential of a platform component","requires":["jobs-run"]},"idempotent":true,"inputs":[{"name":"job","type":"job-id"},{"name":"lease-token","type":"u64"},{"name":"outcome","type":"job-outcome"},{"name":"error","type":"string","optional":true}],"outputs":[{"name":"state","type":"job-state"}],"postconditions":["A job ends in exactly one recorded outcome (SCH-012).","A failed attempt is retried after a delay that grows with the attempt count; a job that exhausts its attempts is recorded as failed with each error (SCH-013, SCH-014).","A recurring schedule creates its next job in the transaction that completes the current one (SCH-003)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"conflict","condition":"The lease token is superseded (SCH-011).","type":"api-error","kind":"conflict"}],"exposure":"internal","deployment":"shipped","tenantScope":"platform","description":"In this deployment the automation worker reports the result in process (worker::leases::run_leased over Store::job_report, D-7706): no route serves it. The report, the records it writes and the next job of a schedule are one transaction."},
    {"id":"cancel-job","name":"Cancel a job","ref":"CT-084","realisation":"generated","implementedBy":"automation-worker","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the operation","requires":["jobs-manage"]},"idempotent":true,"inputs":[{"name":"job","type":"job-id"},{"name":"reason","type":"string"}],"outputs":[],"postconditions":["No later attempt happens (SCH-006).","The requester and the reason are recorded (AGT-417)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The job does not exist for this tenant.","type":"api-error","kind":"not_found"}],"exposure":"public","tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/jobs/cancel"},
    {"id":"retry-job","name":"Retry a failed job","ref":"CT-085","realisation":"generated","implementedBy":"automation-worker","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the operation","requires":["jobs-manage"]},"idempotent":false,"inputs":[{"name":"job","type":"job-id"}],"outputs":[{"name":"attempt","type":"u32"}],"postconditions":["A new attempt is created and the outcomes of earlier attempts are unchanged (AGT-418)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The job does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"conflict","condition":"The job has not failed.","type":"api-error","kind":"conflict"}],"exposure":"public","tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/jobs/retry"},
    {"id":"list-jobs","name":"List jobs and schedules","ref":"CT-086","realisation":"generated","implementedBy":"automation-worker","auth":{"scheme":"session","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["jobs-read"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"cursor","type":"string","optional":true},{"name":"limit","type":"u32","optional":true,"description":"At most 100; 50 when absent."}],"outputs":[{"name":"jobs","type":"list<job-summary>"},{"name":"next","type":"string","optional":true},{"name":"schedules","type":"list<schedule-summary>","optional":true,"description":"The schedules of the tenant, on the first page only."}],"postconditions":["Each entry shows its state, attempts and the error of each (AGT-416)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped","bffRoute":"GET /api/jobs"},
    {"id":"define-schedule","name":"Create or change a schedule","ref":"CT-087","realisation":"generated","implementedBy":"automation-worker","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the operation","requires":["jobs-manage"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"schedule","type":"schedule-id"},{"name":"rule","type":"recurrence"},{"name":"paused","type":"bool","optional":true}],"outputs":[{"name":"next-due","type":"timestamp"}],"postconditions":["A paused schedule creates no job (SCH-005)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The recurrence rule is outside the subset of SCH-1574 or is malformed.","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/schedules/define"},
    {"id":"fire-trigger","name":"Create the jobs of the triggers subscribed to an event","ref":"CT-088","realisation":"generated","implementedBy":"automation-worker","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":false,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"event","type":"domain-event"},{"name":"hop","type":"u32"}],"outputs":[{"name":"jobs","type":"list<job-id>"}],"postconditions":["The jobs are created in the transaction that commits the event (SCH-004).","No job is created beyond the hop limit of the tenant (SCH-300).","A job is created only for a trigger whose event matches and whose condition is true on the event (WFL-1521).","Every job the trigger declines or holds writes an exception record with its reason in the same transaction (SCH-1532, SCH-1535).","Jobs past the daily job quota are held, and the transaction of the event is never refused for the quota (SCH-1535)."],"errors":[],"exposure":"local","deployment":"target"},
    {"id":"activate-workflow","name":"Activate a workflow definition","ref":"CT-089","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["workflow-activate"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"workflow","type":"workflow-id"},{"name":"projection","type":"projection-summary"}],"outputs":[{"name":"version","type":"u64"}],"postconditions":["The definition is stored as tenant metadata under the schema version (WFL-001).","An automation is activated only when every action is a variant of automation-step, every trigger naming it subscribes to a variant of trigger-event, and every role of its run-as is still one its activating principal may confer (INT-1522, WFL-1528).","Activation is the definition of the automation made again with the state active; an automation that is active already answers its version and changes nothing (WFL-2684)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The workflow does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"conflict","condition":"The automation is suspended because its definer may no longer confer a role of its run-as (WFL-1529).","type":"api-error","kind":"conflict"},{"name":"invalid","condition":"A step kind is not a variant of automation-step or a trigger event is not a variant of trigger-event (INT-153, INT-1522), the run-as names a role the activating principal may not confer (WFL-1528), or no projection has run (WFL-002).","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/automation/commands/activate"},
    {"id":"start-workflow-run","name":"Start a workflow run","ref":"CT-090","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","csrf":true,"origin":true,"description":"A person holding the permission to run workflows","requires":["jobs-run"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"workflow","type":"workflow-id"},{"name":"input","type":"value-map","optional":true},{"name":"idempotency-key","type":"string","optional":true}],"outputs":[{"name":"run","type":"run-id"},{"name":"replayed","type":"bool"}],"postconditions":["The run continues under the definition version that started it (MIG-562).","The person who started the run is recorded on it and may not approve its approval steps (WFL-2681).","Starting with the same key and the same inputs names the same run and starts nothing more; the same key with other inputs is refused (WFL-2687)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The workflow does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"conflict","condition":"The automation is not active (WFL-2684), or the key started a run with other inputs.","type":"api-error","kind":"conflict"},{"name":"invalid","condition":"An input names something an automation does not read or is not a value (D-6523).","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","deployment":"shipped","tenantScope":"request","bffRoute":"POST /api/automation/commands/start-run"},
    {"id":"advance-workflow-run","name":"Advance a workflow run by one step","ref":"CT-091","realisation":"generated","implementedBy":"automation-worker","auth":{"scheme":"service","description":"Service credential of a platform component","requires":["jobs-run"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"run","type":"run-id"}],"outputs":[{"name":"state","type":"run-state"},{"name":"step","type":"u32"}],"postconditions":["The step is decided by the kernel from the recorded state of the run (WFL-003).","After a restart the run continues from its last recorded step (WFL-004).","A failed step runs the declared compensations of the completed steps in reverse order (WFL-005).","A step runs as a job under the lease and retry rules (ARC-700)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"not-found","condition":"The run does not exist for this tenant.","type":"api-error","kind":"not_found"}],"exposure":"internal","deployment":"target","tenantScope":"platform"},
    {"id":"approve-workflow-step","name":"Approve a waiting workflow step","ref":"CT-092","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal that the policy of the step names","requires":["workflow-approve"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"run","type":"run-id"},{"name":"approved","type":"bool"},{"name":"comment","type":"string","optional":true}],"outputs":[{"name":"run","type":"run-id"},{"name":"state","type":"run-state"},{"name":"approved","type":"bool"}],"postconditions":["The run continues only after a principal that holds workflow-approve and a role the policy of the step names decides (WFL-006, WFL-2680).","The principal whose action started the run is refused (WFL-2681); a decision after the deadline is refused (WFL-2682).","The run goes on down the approved step or the refused step the decision selects, and a second decision on the same step is refused (WFL-2683)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The run does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"conflict","condition":"The run is not waiting for an approval, the step is decided already or its deadline has passed (WFL-2682, WFL-2683).","type":"api-error","kind":"conflict"},{"name":"invalid","condition":"The decision is missing or the comment is longer than 500 characters.","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/automation/commands/approve"},
    {"id":"deliver-view","name":"Deliver a view of published content","ref":"CT-093","realisation":"facade","auth":{"scheme":"anonymous","description":"Anyone; no session is needed","requires":["content-read"]},"idempotent":true,"timeoutMs":10000,"inputs":[{"name":"host","type":"host"},{"name":"path","type":"string"},{"name":"request","type":"value-map","optional":true},{"name":"fields","type":"list<string>","optional":true,"description":"The fields to keep of every record and included record of the view, each a field the view declares (CMS-163). A name the view does not declare, or an empty list, is refused. Absent: every field the reader may read."},{"name":"cursor","type":"string","optional":true,"description":"Continues one list section: the text `<section>:<position>` that an earlier answer gave in next (CMS-164). The other sections answer their first page."},{"name":"limit","type":"u32","optional":true,"description":"At most 100; 50 when absent."},{"name":"language","type":"string","optional":true}],"outputs":[{"name":"view","type":"string"},{"name":"title","type":"string"},{"name":"path","type":"string"},{"name":"params","type":"json"},{"name":"data","type":"json","description":"The sections of the view, each a row or a list of rows, as the view model of the BFF holds them."},{"name":"depends-on","type":"list<string>"},{"name":"revision","type":"state-revision"},{"name":"schema-version","type":"schema-version"},{"name":"theme","type":"view-theme"},{"name":"next","type":"value-map","optional":true,"description":"For each list section that has more rows, the cursor of its next page; a section at its end has no entry (CMS-164)."}],"postconditions":["The tenant is resolved from the host name alone (GWY-001).","The response is produced from named queries and view definitions held as tenant metadata (CMS-002).","Only the fields named in the field selection are returned, in each record and each included record, and never a field the reader may not read: the selection narrows what the kernel returns and cannot reveal a field it redacted; a name the view does not declare is refused as invalid (CMS-163).","Drafts are invisible to principals whose policies permit published content alone (CMS-003).","A committed change is visible within 2 seconds at the 99th percentile (CPY-009).","A request answered from a stored copy completes within 100 ms at the 99th percentile (OPS-333).","Each list section loads and answers one page of its query, at most limit rows (the size of the query when limit is absent, else 50), in the order of the query; the page after is the one the cursor of its next entry fetches, with no row missing and none repeated (CMS-164)."],"errors":[{"name":"not-found","condition":"The host or the page does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"invalid","condition":"The field selection is empty or names a field the view does not declare, the limit is 0 or above 100, or the cursor is not one this view issued for a list section.","type":"api-error","kind":"invalid"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped","description":"A facade (D-8140): the target change of this contract was to stop being a gateway operation of its own and become the address of the generic view contract read-view (CT-264). The browser reads a view with GET /api/view, which takes the path, the fields, cursor and limit parameters and the language beside it; the backend view operation (ops.rs view, assemble-view) reads each section as one page of its query and narrows the rows after the kernel has redacted them. The gateway resolves the tenant from the host name and passes it on, so host is not a parameter of the route. Every page read (CT-239..CT-253) is a facade onto the same contract.","bffRoute":"GET /api/view view"},
    {"id":"run-named-query","name":"Run a named query","ref":"CT-094","realisation":"generated","implementedBy":"gateway","auth":{"scheme":"anonymous","description":"Anyone; no session is needed","requires":["content-read"]},"idempotent":true,"inputs":[{"name":"host","type":"host"},{"name":"query","type":"string"},{"name":"filter","type":"value-map","optional":true},{"name":"fields","type":"list<string>","optional":true},{"name":"cursor","type":"string","optional":true},{"name":"limit","type":"u32","optional":true,"description":"At most 100; 50 when absent."}],"outputs":[{"name":"rows","type":"list<value-map>"},{"name":"next","type":"string","optional":true}],"postconditions":["The throttled response names the limit and the time after which the next request is permitted (CMS-168)."],"errors":[{"name":"not-found","condition":"The query does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"invalid","condition":"The filter names a field the query does not declare filterable (CMS-165), or the query would read more records than its plan allows (CMS-255).","type":"api-error","kind":"invalid"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target"},
    {"id":"list-record-versions","name":"List the published versions of a record","ref":"CT-095","realisation":"generated","implementedBy":"gateway","auth":{"scheme":"session","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["content-draft-read"]},"idempotent":true,"inputs":[{"name":"record","type":"record-id"}],"outputs":[{"name":"versions","type":"list<record-version>"}],"postconditions":["Each published version is retrievable (CMS-006)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The record does not exist for this tenant.","type":"api-error","kind":"not_found"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target"},
    {"id":"restore-record-version","name":"Restore an earlier version of a record","ref":"CT-096","realisation":"generated","implementedBy":"gateway","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the operation","requires":["content-restore"]},"idempotent":false,"inputs":[{"name":"record","type":"record-id"},{"name":"version","type":"u64"}],"outputs":[{"name":"version","type":"u64"}],"postconditions":["A new version with the earlier content is created (CMS-007)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The version does not exist for this tenant.","type":"api-error","kind":"not_found"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"show-preview","name":"Show a preview of unpublished content","ref":"CT-097","realisation":"generated","implementedBy":"gateway","auth":{"scheme":"session","tenantPolicies":true,"description":"A principal that may read the draft, or a holder of a preview link","requires":["content-draft-read"]},"idempotent":true,"inputs":[{"name":"host","type":"host"},{"name":"path","type":"string"},{"name":"preview-token","type":"secret","optional":true}],"outputs":[{"name":"view","type":"view-data"}],"postconditions":["A preview link shows one stated draft version of one record and no other record or screen (CMS-159, CMS-160)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"not-found","condition":"The draft does not exist for this tenant.","type":"api-error","kind":"not_found"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target"},
    {"id":"subscribe-events","name":"Subscribe to the events a principal may read","ref":"CT-098","realisation":"generated","implementedBy":"gateway","auth":{"scheme":"session","description":"A signed-in principal; either capability suffices, and self-events-read reaches only events about records the principal may read (D-6591)","requires":["events-subscribe","self-events-read"]},"idempotent":true,"inputs":[{"name":"selector","type":"selector"},{"name":"after","type":"u64","optional":true}],"outputs":[{"name":"stream","type":"event-stream"}],"preconditions":["The WebSocket upgrade comes from an allowed origin and carries the request token of the session (GWY-004, GWY-256).","The upgrade address carries the request token as the csrf query parameter (a browser cannot set a header on a socket); selector and after are not read at the upgrade but from the subscribe message that follows it, which also names req and sub, the member names of the selector being its fields, and replays the visible events after the given sequence."],"postconditions":["A notice about a record reaches a subscriber only when its principal may read the record (RUN-001).","A slow subscriber does not delay the others (OPS-311)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped","bffRoute":"GET /ws"},
    {"id":"serve-sitemap","name":"Serve the sitemap of a site","ref":"CT-099","realisation":"generated","implementedBy":"gateway","auth":{"scheme":"anonymous","description":"Anyone; no session is needed","requires":["content-read"]},"idempotent":true,"inputs":[{"name":"host","type":"host"}],"outputs":[{"name":"sitemap","type":"bytes"}],"postconditions":["It lists the address of each published page (EDG-150)."],"errors":[{"name":"not-found","condition":"The site does not exist for this tenant.","type":"api-error","kind":"not_found"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target"},
    {"id":"serve-feed","name":"Serve a syndication feed of a collection","ref":"CT-100","realisation":"generated","implementedBy":"gateway","auth":{"scheme":"anonymous","description":"Anyone; no session is needed","requires":["content-read"]},"idempotent":true,"inputs":[{"name":"host","type":"host"},{"name":"collection","type":"string"}],"outputs":[{"name":"feed","type":"bytes"}],"postconditions":["It names the address and publication time of each entry (EDG-151)."],"errors":[{"name":"not-found","condition":"The collection does not exist for this tenant.","type":"api-error","kind":"not_found"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target"},
    {"id":"record-consent","name":"Record a consent decision of a visitor","ref":"CT-101","realisation":"generated","implementedBy":"gateway","auth":{"scheme":"anonymous","csrf":true,"origin":true,"justification":"A visitor records cookie consent before any session exists.","description":"Anyone; no session is needed","requires":["consent-record"]},"idempotent":false,"inputs":[{"name":"host","type":"host"},{"name":"visitor","type":"visitor-id"},{"name":"purpose","type":"string"},{"name":"decision","type":"string"},{"name":"text","type":"string"}],"outputs":[{"name":"consent","type":"consent-id"}],"postconditions":["The decision is recorded with its purpose, time and the text the visitor was shown (PRV-375)."],"errors":[{"name":"invalid","condition":"The purpose is unknown.","type":"api-error","kind":"invalid"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"describe-delivery","name":"Describe the delivery interface","ref":"CT-102","realisation":"generated","implementedBy":"gateway","auth":{"scheme":"anonymous","description":"Anyone; no session is needed","requires":["content-read"]},"idempotent":true,"inputs":[{"name":"version","type":"string","optional":true}],"outputs":[{"name":"description","type":"bytes"}],"postconditions":["The document names each operation with its input and output (CMS-169)."],"errors":[],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target"},
    {"id":"purge-by-surrogate-key","name":"Purge edge copies by surrogate key","ref":"CT-103","realisation":"generated","implementedBy":"delivery-network-control","auth":{"scheme":"service","description":"Service credential of a platform component","requires":["edge-control"]},"idempotent":true,"timeoutMs":5000,"inputs":[{"name":"keys","type":"list<string>"}],"outputs":[],"postconditions":["The purge takes effect at the edge within 5 seconds at the 99th percentile (EDG-007).","A committed change purges the surrogate keys of the records it changed (EDG-005)."],"errors":[{"name":"unavailable","condition":"The control interface of the network did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"internal","deployment":"target","tenantScope":"platform"},
    {"id":"purge-host","name":"Purge every edge copy of a host","ref":"CT-104","realisation":"generated","implementedBy":"delivery-network-control","auth":{"scheme":"service","description":"Service credential of a platform component","requires":["edge-control"]},"idempotent":true,"timeoutMs":5000,"inputs":[{"name":"host","type":"host"}],"outputs":[],"postconditions":["Every edge copy stored under the host name is purged (EDG-008, THR-262)."],"errors":[{"name":"unavailable","condition":"The control interface of the network did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"internal","deployment":"target","tenantScope":"platform"},
    {"id":"register-edge-domain","name":"Register or remove a tenant domain at the edge","ref":"CT-105","realisation":"generated","implementedBy":"delivery-network-control","auth":{"scheme":"service","description":"Service credential of a platform component","requires":["edge-control"]},"idempotent":true,"inputs":[{"name":"host","type":"host"},{"name":"action","type":"string"}],"outputs":[{"name":"certificate-state","type":"certificate-state"}],"postconditions":["The certificate is renewed before it expires (EDG-010)."],"errors":[{"name":"invalid","condition":"The certificate authority record of the domain does not permit issuing (EDG-254).","type":"api-error","kind":"invalid"}],"exposure":"internal","deployment":"target","tenantScope":"platform"},
    {"id":"sign-media-address","name":"Sign an address for a private media file","ref":"CT-106","realisation":"generated","implementedBy":"gateway","auth":{"scheme":"session","csrf":true,"origin":true,"description":"A signed-in principal who may read the file","requires":["media-sign"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"file","type":"hash"},{"name":"principal","type":"principal-id"},{"name":"expires-at","type":"timestamp"},{"name":"record","type":"record-id","optional":true,"description":"A record that refers to the file and that the caller may read; the readability of the file is decided from it (D-6587)."}],"outputs":[{"name":"address","type":"url"}],"postconditions":["A private media file is delivered only through an address signed for the principal with an expiry (EDG-012).","The address is signed only when the caller may read the file as D-6587 states, and the signed principal may read it too; otherwise the call is refused (EDG-1592).","expires-at is at most the address-max-seconds of the tenant, at most 3600 seconds, after now (EDG-1592)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The file does not exist for this tenant, or the caller may not read it; the two are not told apart.","type":"api-error","kind":"not_found"},{"name":"invalid","condition":"expires-at is in the past or later than the maximum.","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/files/sign"},
    {"id":"set-storability-directives","name":"Set the storability directives of a response","ref":"CT-107","realisation":"generated","implementedBy":"gateway","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"principal-dependent","type":"bool"},{"name":"record-keys","type":"list<string>"}],"outputs":[{"name":"cache-control","type":"string"},{"name":"surrogate-key","type":"string"},{"name":"vary","type":"string"}],"postconditions":["A response that depends on the principal is not storable by shared intermediaries (EDG-002).","A published page carries surrogate keys naming the tenant and each record it was rendered from (EDG-003).","The edge key includes the host name and every request header that changes the response, and no other (EDG-001, EDG-250)."],"errors":[{"name":"invalid","condition":"A header value that a tenant supplies contains a line break (EDG-255).","type":"api-error","kind":"invalid"}],"exposure":"local","deployment":"target"},
    {"id":"list-operations","name":"List the operations of the catalogue","ref":"CT-108","realisation":"generated","implementedBy":"agent-gateway","auth":{"scheme":"delegation","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["catalogue-read"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"cursor","type":"string","optional":true},{"name":"limit","type":"u32","optional":true,"description":"At most 100; 50 when absent."}],"outputs":[{"name":"operations","type":"list<operation-entry>"},{"name":"next","type":"string","optional":true}],"postconditions":["Every operation of the authoring application is listed with a stable name, a version and a deprecation state (AGT-001, AGT-400).","Each operation is marked as permitted or not for the requesting principal (AGT-002).","A change of schema version shows without a deployment (AGT-003).","Tenant-defined names appear only as quoted data inside a description (AGS-405)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target"},
    {"id":"describe-operation","name":"Describe one operation","ref":"CT-109","realisation":"generated","implementedBy":"agent-gateway","auth":{"scheme":"delegation","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["catalogue-read"]},"idempotent":true,"inputs":[{"name":"name","type":"string"},{"name":"version","type":"string","optional":true}],"outputs":[{"name":"operation","type":"operation-entry"}],"postconditions":["The entry names the requirements it implements (AGT-005).","The meaning of an operation at one version stays unchanged in every later release (AGT-401).","A deprecated operation keeps answering until its removal date (AGT-402)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"not-found","condition":"The operation does not exist for this tenant.","type":"api-error","kind":"not_found"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target"},
    {"id":"invoke-operation","name":"Invoke an operation","ref":"CT-110","realisation":"generated","implementedBy":"agent-gateway","auth":{"scheme":"delegation","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["operation-invoke"]},"idempotent":true,"inputs":[{"name":"name","type":"string"},{"name":"input","type":"value-map"},{"name":"idempotency-key","type":"string","optional":true},{"name":"dry-run","type":"bool","optional":true},{"name":"expected-version","type":"u64","optional":true}],"outputs":[{"name":"result","type":"operation-result"}],"postconditions":["A dry run returns the state changes without committing them (AGT-008).","A rejected operation returns the failed checks in machine-readable form with a stable error code and a flag that says whether repeating is safe (AGT-009, AGT-407).","The result of an applied change names an inverse operation or states that none exists (AGT-010).","An operation by an agent is authorised by the same policies as the same operation by a person (AGT-014).","A repeat with the same idempotency key has the effect of one call (AGT-403).","A write that would exceed a quota is refused with the quota named (BIL-151).","An operation that runs a contract needs every capability and one of the roles that the authorisation of that contract states, as a direct call does; the catalogue is not a way round it (AGT-1209, D-6210)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation, or lacks a capability or role that the underlying contract of the operation requires; the failed check names it (AGT-1209).","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The input has a field its schema does not declare (AGT-251), or a bulk operation has no projection against the current revision (AGS-415).","type":"api-error","kind":"invalid"},{"name":"conflict","condition":"The named revision is older than the current revision of the record (AGS-433).","type":"api-error","kind":"conflict"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"},{"name":"unavailable","condition":"The agent is disabled or halted (AGT-016, AGS-419).","type":"api-error","kind":"unavailable"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"get-operation-handle","name":"Read the state of a long operation","ref":"CT-111","realisation":"generated","implementedBy":"agent-gateway","auth":{"scheme":"delegation","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["catalogue-read"]},"idempotent":true,"inputs":[{"name":"handle","type":"string"}],"outputs":[{"name":"state","type":"string"},{"name":"result","type":"operation-result","optional":true}],"postconditions":["The state of an operation whose work outlasts its request stays readable (AGT-406)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"not-found","condition":"The handle does not exist for this tenant.","type":"api-error","kind":"not_found"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target"},
    {"id":"propose-change","name":"Propose a change","ref":"CT-112","realisation":"generated","implementedBy":"agent-gateway","auth":{"scheme":"delegation","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["change-propose"]},"idempotent":false,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"change","type":"change-set"}],"outputs":[{"name":"proposal","type":"proposal-id"},{"name":"projection","type":"projection-summary"}],"postconditions":["The proposal carries the projection of the change against the recorded history (AGT-012).","A change that tenant policy classes as risky is applied only from an approved proposal (AGT-011)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"approve-proposal","name":"Approve a proposal","ref":"CT-113","realisation":"generated","implementedBy":"agent-gateway","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal other than its author, and a person where policy assigns human approval","requires":["change-approve"]},"idempotent":false,"inputs":[{"name":"proposal","type":"proposal-id"}],"outputs":[{"name":"state","type":"proposal-state"}],"postconditions":["The approvals that count toward a quorum come from distinct principals the policy names (AGS-411)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"conflict","condition":"The revision of the tenant differs from the revision the proposal was projected at (AGT-013).","type":"api-error","kind":"conflict"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"subscribe-agent-events","name":"Subscribe to domain events as an agent","ref":"CT-114","realisation":"generated","implementedBy":"agent-gateway","auth":{"scheme":"delegation","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["events-subscribe"]},"idempotent":true,"inputs":[{"name":"selector","type":"selector"},{"name":"after","type":"u64","optional":true}],"outputs":[{"name":"stream","type":"event-stream"}],"postconditions":["Only events the principal may read are delivered, in the commit order of the tenant (AGT-007, AGT-409).","A subscription resumes from the last acknowledged position after a disconnect (AGT-408)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target"},
    {"id":"get-platform-description","name":"Describe the platform topology and health","ref":"CT-115","realisation":"generated","implementedBy":"agent-gateway","auth":{"scheme":"delegation","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["platform-describe"]},"idempotent":true,"inputs":[],"outputs":[{"name":"description","type":"platform-description"}],"postconditions":["Component topology, configuration and health are published in machine-readable form (AGT-006)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target"},
    {"id":"list-records","name":"List records in pages","ref":"CT-116","realisation":"generated","implementedBy":"agent-gateway","auth":{"scheme":"delegation","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["records-read"]},"idempotent":true,"inputs":[{"name":"object","type":"object-type-id"},{"name":"cursor","type":"string","optional":true},{"name":"limit","type":"u32","optional":true}],"outputs":[{"name":"rows","type":"list<value-map>"},{"name":"next","type":"string","optional":true}],"postconditions":["Each page has a cursor that resumes the same listing (AGT-405).","Only records the principal may read are returned (AGT-254)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target"},
    {"id":"set-agent-state","name":"Disable, enable, halt or resume an agent","ref":"CT-117","realisation":"generated","implementedBy":"agent-gateway","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal other than the agent concerned (AGS-413, AGS-419)","requires":["agent-manage"]},"idempotent":true,"inputs":[{"name":"agent","type":"principal-id"},{"name":"state","type":"string"}],"outputs":[],"postconditions":["A disabled agent is refused by every gateway instance within 5 seconds (AGT-500).","A tripped anomaly rule halts the agent automatically (AGS-418)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"undo-change","name":"Undo an applied agent change","ref":"CT-118","realisation":"generated","implementedBy":"agent-gateway","auth":{"scheme":"delegation","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["change-undo"]},"idempotent":false,"inputs":[{"name":"change","type":"string"}],"outputs":[{"name":"result","type":"operation-result"}],"postconditions":["A change whose operation declares a reversal is reversible within the undo window (AGS-421)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"conflict","condition":"The undo window has passed or the operation declares no reversal.","type":"api-error","kind":"conflict"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"list-agents","name":"List the agent registry","ref":"CT-119","realisation":"generated","implementedBy":"agent-gateway","auth":{"scheme":"delegation","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["agents-read"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"}],"outputs":[{"name":"agents","type":"list<agent-entry>"}],"postconditions":["Each agent is listed with its owner, purpose, scopes and tier (OBS-406)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target"},
    {"id":"report-agent-spend","name":"Report spend by agent and tenant","ref":"CT-120","realisation":"generated","implementedBy":"agent-gateway","auth":{"scheme":"delegation","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["agent-spend-report"]},"idempotent":true,"inputs":[{"name":"period","type":"string"}],"outputs":[{"name":"spend","type":"list<spend-entry>"}],"postconditions":["Spend is attributed to each agent and each tenant (AGT-423)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"get-requirement-status","name":"Read the verification status of requirements","ref":"CT-121","realisation":"generated","implementedBy":"agent-gateway","auth":{"scheme":"delegation","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["requirements-read"]},"idempotent":true,"inputs":[{"name":"ref","type":"string","optional":true}],"outputs":[{"name":"statuses","type":"list<requirement-status>"}],"postconditions":["The verification status of each requirement is readable (AGT-414)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target"},
    {"id":"set-feature-flag","name":"Read or change a tenant switch of a feature flag","ref":"CT-122","realisation":"generated","implementedBy":"agent-gateway","auth":{"scheme":"delegation","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["flags-manage"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"name","type":"string"},{"name":"value","type":"string"}],"outputs":[],"postconditions":["A flag is off for a tenant unless the release record enables it for that tenant (OPS-328).","The call changes only a tenant switch of a flag. A platform flag or a quota is changed only by set-platform-flag (OPS-1203, D-6202).","The change is recorded in the audit log with the previous value, the new value, the principal and the correlation (OPS-329, OBS-1217)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The name is not a tenant switch that the release record of a flag defines, or it is a platform flag or a quota, or the value is not on or off (OPS-1203).","type":"api-error","kind":"invalid"},{"name":"not-found","condition":"The tenant does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"conflict","condition":"The release record has not enabled the flag for the tenant, so its tenant switch cannot be turned on (OPS-328, CNV-1205).","type":"api-error","kind":"conflict"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"run-diagnostic","name":"Run a read-only diagnostic operation for one tenant","ref":"CT-123","realisation":"generated","implementedBy":"agent-gateway","auth":{"scheme":"delegation","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["diagnostics-run"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"name","type":"string"}],"outputs":[{"name":"report","type":"value-map"}],"postconditions":["The operation reads health, configuration and the like and changes nothing (OPS-342).","An alert names the operation that carries its runbook, and that runs as a dry run first (OPS-341).","A diagnostic run by platform staff or by the platform operating agent in a tenant is audited with the grant under which it ran, and reads health and configuration and no tenant content (PRV-1211, AGS-424)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"grant-required","condition":"The caller is platform staff or the platform operating agent and no live support grant of the tenant covers the diagnostic (PRV-1211, G-165, D-6204).","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"list-releases","name":"List production releases","ref":"CT-124","realisation":"generated","implementedBy":"agent-gateway","auth":{"scheme":"delegation","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["releases-read"]},"idempotent":true,"inputs":[],"outputs":[{"name":"releases","type":"list<release-id>"}],"postconditions":["Each release record is listed with its digests and gate results (REL-581)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target"},
    {"id":"append-audit-entry","name":"Append an audit entry","ref":"CT-125","realisation":"generated","implementedBy":"audit-log","auth":{"scheme":"service","description":"Service credential of a platform component","requires":["audit-append"]},"idempotent":false,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"on-behalf-of","type":"principal-id","optional":true},{"name":"target","type":"string"},{"name":"action","type":"string"},{"name":"outcome","type":"string"},{"name":"correlation","type":"correlation-id"},{"name":"checks","type":"list<check>"}],"outputs":[{"name":"seq","type":"u64"},{"name":"hash","type":"hash"}],"postconditions":["The entry contains the hash of the entry before it, computed over the sealed form (OBS-006, PRV-360).","It contains no password, session secret, token or one-time code (IDN-022).","An erasure of a principal leaves the chain verifiable (PRV-359).","No agent may write to the audit log (AGS-425).","The actor of the entry is derived by the audit log from the credential of the calling component and is never taken from the request (SEC-1207, D-6203).","The entry names its target and holds its own hash, and the hash of the entry before it (OBS-1216, D-6208)."],"errors":[{"name":"unavailable","condition":"The audit log could not be written.","type":"store-error","kind":"unavailable"},{"name":"forbidden","condition":"The tenant is not the tenant that the credential names, or the role of the calling component does not hold audit-append (TEN-257, SEC-1206).","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The principal that the entry is on behalf of is not a principal of the tenant, or the target is empty.","type":"api-error","kind":"invalid"}],"exposure":"internal","deployment":"target","tenantScope":"platform"},
    {"id":"query-audit-log","name":"Query the audit log","ref":"CT-126","realisation":"generated","implementedBy":"audit-log","auth":{"scheme":"session","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["audit-read"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"cursor","type":"string","optional":true,"description":"Opaque; the next output of the previous call. The entries after the one it names are returned."},{"name":"limit","type":"u32","optional":true,"description":"At most 100; 50 when absent."}],"outputs":[{"name":"entries","type":"list<audit-entry>"},{"name":"next","type":"string","optional":true},{"name":"withheld","type":"bool"}],"postconditions":["An agent receives only entries its principal may read, and a result that withholds entries says so (AGT-412, AGT-413).","A page holds at most limit entries; next is the cursor of the following page and is absent at the end of the list."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target"},
    {"id":"export-audit-log","name":"Export the audit log of a tenant","ref":"CT-127","realisation":"generated","implementedBy":"audit-log","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["audit-export"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"}],"outputs":[{"name":"archive","type":"archive-ref"}],"postconditions":["The owner can export the audit log (OBS-008)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"verify-audit-chain","name":"Verify the audit chain","ref":"CT-128","realisation":"generated","implementedBy":"audit-log","auth":{"scheme":"session","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["audit-read"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"}],"outputs":[{"name":"intact","type":"bool"},{"name":"first-break","type":"u64","optional":true},{"name":"reason","type":"string","optional":true},{"name":"entries","type":"u64"},{"name":"verified","type":"u64"},{"name":"unchained","type":"u64"}],"postconditions":["A log from which an entry was removed, or in which an entry was altered, is reported as broken, with the sequence number of the first line that no longer chains (OBS-007).","The route answers a principal that holds the capability audit-read and no other; it checks the chain from the first line of the tenant's audit trail and reports how many lines it read, how many chained and how many were written before the chain existed.","The head of the chain is not yet anchored in the platform audit store and expiry keeps no checkpoint, so a chain shortened at its newest end is not reported as broken (OBS-1216, D-6208, WG-5247)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped","description":"The route GET /api/audit/verify takes an optional tenant, which must be the tenant resolved from the host and session: any other is refused as tenant-mismatch and recorded as an audit entry (TEN-1140). It answers intact, and when the chain is broken first-break, the sequence number of the first line that no longer chains, and reason. The caller needs the capability audit-read, which the owner holds.","bffRoute":"GET /api/audit/verify"},
    {"id":"export-telemetry","name":"Export telemetry","ref":"CT-129","realisation":"generated","implementedBy":"telemetry-pipeline","auth":{"scheme":"service","description":"Service credential of a platform component","requires":["telemetry-export"]},"idempotent":false,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"signal","type":"string"},{"name":"batch","type":"bytes"}],"outputs":[],"postconditions":["Telemetry carries the tenant identifier and no content of a tenant record (OBS-003).","Every log line, span and audit entry carries the correlation identifier (OBS-001).","No sampling rule discards an error record, an alert or an audit entry (OPS-347)."],"errors":[{"name":"unavailable","condition":"The pipeline did not accept the batch.","type":"api-error","kind":"unavailable"}],"exposure":"internal","deployment":"target","tenantScope":"platform"},
    {"id":"query-telemetry","name":"Query metrics, logs and traces","ref":"CT-130","realisation":"generated","implementedBy":"telemetry-pipeline","auth":{"scheme":"session","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["telemetry-read"]},"idempotent":true,"inputs":[{"name":"query","type":"string"},{"name":"tenant","type":"tenant-id","optional":true}],"outputs":[{"name":"series","type":"list<value-map>"}],"postconditions":["Only series, lines and spans the principal may read are returned (AGT-411)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target"},
    {"id":"raise-alert","name":"Raise an alert","ref":"CT-131","realisation":"generated","implementedBy":"telemetry-pipeline","auth":{"scheme":"service","description":"Service credential of a platform component","requires":["telemetry-export"]},"idempotent":true,"inputs":[{"name":"name","type":"string"},{"name":"surface","type":"string"},{"name":"runbook","type":"string"}],"outputs":[{"name":"alert","type":"log-id"}],"postconditions":["An outage of a tenant-facing surface raises an alert within 5 minutes (OPS-338)."],"errors":[],"exposure":"internal","deployment":"target","tenantScope":"none"},
    {"id":"get-access-report","name":"Receive the access report of a tenant","ref":"CT-132","realisation":"generated","implementedBy":"audit-log","auth":{"scheme":"session","roles":["owner"],"description":"An owner of the tenant","requires":["audit-read"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"}],"outputs":[{"name":"report","type":"access-report"}],"postconditions":["The report lists each grant made to the data of the tenant (PRV-370)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target"},
    {"id":"get-run-trace","name":"Read a run trace of an agent","ref":"CT-133","realisation":"generated","implementedBy":"audit-log","auth":{"scheme":"session","roles":["owner"],"description":"An owner of the tenant","requires":["audit-read"]},"idempotent":true,"inputs":[{"name":"run","type":"request-id"}],"outputs":[{"name":"trace","type":"run-trace"}],"postconditions":["The trace names each input read and each operation called (OBS-400).","It is visible to the owner of each tenant the run touched and to no principal that lacks the right (OBS-403).","The platform-side steps are replayable from the recorded inputs (OBS-402)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The run does not exist for this tenant.","type":"api-error","kind":"not_found"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target"},
    {"id":"report-fleet","name":"Report across tenants","ref":"CT-134","realisation":"generated","implementedBy":"fleet-reporting","auth":{"scheme":"session","roles":["platform-operator"],"description":"A platform operator","requires":["fleet-report"]},"idempotent":true,"inputs":[{"name":"report","type":"string"}],"outputs":[{"name":"report","type":"value-map"}],"postconditions":["A report spanning tenants is answered from telemetry, published summaries and the directory only (ARC-110)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"}],"exposure":"internal","readOnly":true,"deployment":"target","tenantScope":"platform"},
    {"id":"notify-breach","name":"Report a breach of personal data to the owner","ref":"CT-135","realisation":"generated","implementedBy":"audit-log","auth":{"scheme":"session","roles":["platform-operator"],"csrf":true,"origin":true,"description":"A platform operator","requires":["breach-notify"]},"idempotent":false,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"records","type":"list<record-id>"}],"outputs":[],"postconditions":["The owner receives a report naming the records and categories concerned (PRV-380)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"}],"exposure":"internal","deployment":"target","tenantScope":"platform"},
    {"id":"show-sign-in-page","name":"Show the sign-in page","ref":"CT-136","realisation":"generated","implementedBy":"web-application","auth":{"scheme":"anonymous","description":"Anyone; no session is needed","requires":["identity-sign-in"]},"idempotent":true,"timeoutMs":1000,"inputs":[{"name":"host","type":"host"}],"outputs":[{"name":"page","type":"html-page"}],"postconditions":["It offers the identity providers configured for the realm of the address, and recovery beside every method (FED-010, UXA-203).","The first content shows within 1 second at the 95th percentile (UXA-213).","The page response carries a content security policy that allows no inline script and requires Trusted Types (GWY-005, GWY-253)."],"errors":[{"name":"not-found","condition":"The host is bound to no tenant.","type":"api-error","kind":"not_found"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped"},
    {"id":"show-authoring-view","name":"Show a view of the authoring application","ref":"CT-137","realisation":"generated","implementedBy":"web-application","auth":{"scheme":"session","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["content-draft-read"]},"idempotent":true,"inputs":[{"name":"view","type":"string"},{"name":"selection","type":"string","optional":true}],"outputs":[{"name":"page","type":"html-page"}],"postconditions":["The view reflows without horizontal scrolling at 360 CSS pixels (UXA-214)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped"},
    {"id":"save-draft","name":"Save a draft","ref":"CT-138","realisation":"generated","implementedBy":"web-application","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the operation","requires":["content-write"]},"idempotent":true,"inputs":[{"name":"record","type":"record-id"},{"name":"expected-version","type":"u64"},{"name":"fields","type":"value-map"},{"name":"schema-version","type":"u64"}],"outputs":[{"name":"version","type":"u64"}],"postconditions":["A record created in the application starts as a draft (CMS-154).","A draft is saved within 2 seconds after the last edit (UXA-204)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"conflict","condition":"The draft the save started from is older than the stored draft, or was made under a prior schema version; the current version is named (CMS-155, MIG-561).","type":"api-error","kind":"conflict"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"show-review-diff","name":"Show the differences between a draft and the published version","ref":"CT-139","realisation":"generated","implementedBy":"web-application","auth":{"scheme":"session","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["content-draft-read"]},"idempotent":true,"inputs":[{"name":"record","type":"record-id"}],"outputs":[{"name":"diff","type":"list<field-difference>"}],"postconditions":["A reviewer sees the differences before approving (CMS-157)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The record does not exist for this tenant.","type":"api-error","kind":"not_found"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target"},
    {"id":"preview-tokens","name":"Preview the tokens of a draft","ref":"CT-140","realisation":"generated","implementedBy":"web-application","auth":{"scheme":"session","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["content-draft-read"]},"idempotent":true,"inputs":[{"name":"record","type":"record-id"},{"name":"as-reader","type":"principal-id"}],"outputs":[{"name":"values","type":"value-map"}],"postconditions":["The values are the ones the chosen reader would see (CTK-016)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target"},
    {"id":"put-file","name":"Store a file","ref":"CT-141","realisation":"generated","implementedBy":"file-store","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"content","type":"bytes"},{"name":"media-type","type":"string"}],"outputs":[{"name":"hash","type":"hash"}],"postconditions":["The file is stored in the namespace of its tenant under its content hash (CMS-008)."],"errors":[{"name":"invalid","condition":"The content is rejected.","type":"store-error","kind":"invalid"},{"name":"unavailable","condition":"The store could not do the work right now; safe to retry.","type":"store-error","kind":"unavailable"}],"exposure":"local","deployment":"shipped"},
    {"id":"get-file","name":"Read a file","ref":"CT-142","realisation":"generated","implementedBy":"file-store","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"hash","type":"hash"}],"outputs":[{"name":"content","type":"bytes"},{"name":"media-type","type":"string"}],"postconditions":["A hash held under another tenant is not found."],"errors":[{"name":"not-found","condition":"No file of this tenant has the hash.","type":"store-error","kind":"not_found"},{"name":"unavailable","condition":"The store could not do the work right now; safe to retry.","type":"store-error","kind":"unavailable"}],"exposure":"local","deployment":"shipped"},
    {"id":"delete-file","name":"Remove a file","ref":"CT-143","realisation":"generated","implementedBy":"file-store","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"hash","type":"hash"}],"outputs":[],"errors":[{"name":"unavailable","condition":"The store could not do the work right now; safe to retry.","type":"store-error","kind":"unavailable"}],"exposure":"local","deployment":"shipped"},
    {"id":"sign-file-address","name":"Sign an address for a file","ref":"CT-144","realisation":"generated","implementedBy":"file-store","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"hash","type":"hash"},{"name":"expires-at","type":"timestamp"},{"name":"principal","type":"principal-id","optional":true}],"outputs":[{"name":"address","type":"url"}],"errors":[{"name":"not-found","condition":"No file of this tenant has the hash.","type":"store-error","kind":"not_found"}],"exposure":"local","deployment":"shipped"},
    {"id":"put-copy","name":"Store a view copy","ref":"CT-145","realisation":"generated","implementedBy":"copy-store","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"key","type":"copy-key"},{"name":"body","type":"bytes"},{"name":"tags","type":"list<string>"},{"name":"fresh-for","type":"duration"}],"outputs":[],"preconditions":["The key begins with the tenant identifier (CPY-003) and holds the view, arguments, audience class, schema version and object-type revisions (CPY-002)."],"postconditions":["A shared copy contains no personal field and nothing that depends on the requesting principal (CPY-007).","The copy carries the release identifier of the colour that computed it (REL-573)."],"errors":[{"name":"unavailable","condition":"The store could not do the work right now; safe to retry.","type":"store-error","kind":"unavailable"}],"exposure":"local","deployment":"target"},
    {"id":"get-copy","name":"Read a view copy","ref":"CT-146","realisation":"generated","implementedBy":"copy-store","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"key","type":"copy-key"}],"outputs":[{"name":"body","type":"bytes","optional":true},{"name":"age","type":"duration"}],"postconditions":["A copy stored for one audience class is served only to that class (CPY-006).","An outage is answered by reads from the tenant database without error to the reader (CPY-011)."],"errors":[{"name":"unavailable","condition":"The store could not do the work right now; safe to retry.","type":"store-error","kind":"unavailable"}],"exposure":"local","deployment":"target"},
    {"id":"remove-copies-by-tag","name":"Remove copies by tag","ref":"CT-147","realisation":"generated","implementedBy":"copy-store","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"tag","type":"string"}],"outputs":[{"name":"removed","type":"u64"}],"postconditions":["A committed change supersedes every copy that depends on a record it changed (CPY-008).","Deleting a record removes every copy that holds a field of it within the erasure bound (CPY-013).","A purge by tag records the tag, requester and outcome (AGT-419)."],"errors":[{"name":"unavailable","condition":"The store could not do the work right now; safe to retry.","type":"store-error","kind":"unavailable"}],"exposure":"local","deployment":"target"},
    {"id":"publish-notice","name":"Publish a notice","ref":"CT-148","realisation":"generated","implementedBy":"notice-queue","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":false,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"kind","type":"string"},{"name":"seq","type":"u64","optional":true}],"outputs":[{"name":"notice","type":"string"}],"postconditions":["A domain event reaches the queue as a reference naming its tenant and sequence number, with no content of the record (ARC-102)."],"errors":[{"name":"unavailable","condition":"The store could not do the work right now; safe to retry.","type":"store-error","kind":"unavailable"}],"exposure":"local","deployment":"target"},
    {"id":"receive-notices","name":"Receive notices","ref":"CT-149","realisation":"generated","implementedBy":"notice-queue","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"subscriber","type":"string"},{"name":"limit","type":"u32"}],"outputs":[{"name":"notices","type":"list<notice>"}],"postconditions":["A notice is redelivered until its subscriber acknowledges it (ARC-103).","A receiver refuses a notice that names another tenant (TEN-251)."],"errors":[{"name":"unavailable","condition":"The store could not do the work right now; safe to retry.","type":"store-error","kind":"unavailable"}],"exposure":"local","deployment":"target"},
    {"id":"acknowledge-notice","name":"Acknowledge a notice","ref":"CT-150","realisation":"generated","implementedBy":"notice-queue","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"subscriber","type":"string"},{"name":"notice","type":"string"}],"outputs":[],"postconditions":["A subscriber that receives an event a second time makes no further effect from it (ARC-104)."],"errors":[{"name":"unavailable","condition":"The store could not do the work right now; safe to retry.","type":"store-error","kind":"unavailable"}],"exposure":"local","deployment":"target"},
    {"id":"create-data-key","name":"Create a data key for a tenant","ref":"CT-151","realisation":"generated","implementedBy":"key-service","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"}],"outputs":[{"name":"key","type":"key-id"}],"postconditions":["The stored data of the tenant is encrypted under a key held for that tenant alone (SEC-001)."],"errors":[{"name":"unavailable","condition":"The key service does not answer; requests that need a data key are refused (SEC-250).","type":"store-error","kind":"unavailable"}],"exposure":"local","deployment":"target"},
    {"id":"wrap-key","name":"Wrap a data key","ref":"CT-152","realisation":"generated","implementedBy":"key-service","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":false,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"key","type":"bytes"}],"outputs":[{"name":"wrapped","type":"wrapped-secret"}],"postconditions":["A secret is stored only in encrypted form with its wrapping key held by the key service (SEC-003)."],"errors":[{"name":"unavailable","condition":"The key service does not answer.","type":"store-error","kind":"unavailable"}],"exposure":"local","deployment":"target"},
    {"id":"unwrap-key","name":"Unwrap a data key","ref":"CT-153","realisation":"generated","implementedBy":"key-service","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"wrapped","type":"wrapped-secret"}],"outputs":[{"name":"key","type":"bytes"}],"postconditions":["A connector secret is readable only by the connector runner at the time of the call (WFL-009)."],"errors":[{"name":"unavailable","condition":"The key service does not answer.","type":"store-error","kind":"unavailable"},{"name":"destroyed","condition":"The key of the tenant was destroyed.","type":"store-error","kind":"not_found"}],"exposure":"local","deployment":"target"},
    {"id":"rotate-data-key","name":"Rotate a tenant data key","ref":"CT-154","realisation":"generated","implementedBy":"key-service","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":false,"inputs":[{"name":"tenant","type":"tenant-id"}],"outputs":[{"name":"key","type":"key-id"}],"postconditions":["The tenant reads and writes during rotation (SEC-251).","A replacement for a compromised key protects every record the old key protected (SEC-252)."],"errors":[{"name":"unavailable","condition":"The key service does not answer.","type":"store-error","kind":"unavailable"}],"exposure":"local","deployment":"target"},
    {"id":"destroy-key","name":"Destroy a key","ref":"CT-155","realisation":"generated","implementedBy":"key-service","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"key","type":"key-id"}],"outputs":[{"name":"destroyed-at","type":"timestamp"}],"postconditions":["The stored data and backups of the tenant become unreadable (SEC-002).","Destroying the key of a principal makes its sealed personal fields unreadable in every copy and backup (PRV-358)."],"errors":[{"name":"unavailable","condition":"The key service does not answer.","type":"store-error","kind":"unavailable"}],"exposure":"local","deployment":"target"},
    {"id":"submit-message","name":"Submit one rendered message","ref":"CT-156","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"message","type":"message-id"},{"name":"idempotency-key","type":"string"},{"name":"to","type":"email-address"},{"name":"from","type":"email-address"},{"name":"subject","type":"string"},{"name":"html","type":"string"},{"name":"text","type":"string"},{"name":"category","type":"message-category-id","optional":true},{"name":"allowance-class","type":"allowance-class","optional":true},{"name":"send","type":"send-id","optional":true},{"name":"reference","type":"send-reference","optional":true}],"outputs":[{"name":"state","type":"message-state"}],"postconditions":["A message whose job is attempted again after it reached its outcome is not sent again: its id is derived from the idempotency key of its send, and the log records its outcome (EML-006).","A temporary refusal leaves the message queued, retried by the policy of its job with a doubling delay; the attempt that spends the policy records the message as failed with the reason and dead-letters the job (EML-007, EML-008).","A message is checked against the suppression of its category (EML-1562), counted once in its allowance class (EML-1563) and held while the complaint breaker is open (EML-1564); a held message is attempted again when its hold ends.","A message is not yet signed with a key published under a tenant domain (EML-015), and messages do not leave in a guaranteed order (OPS-314)."],"errors":[{"name":"temporary-refusal","condition":"The provider refused for a temporary reason; the message stays queued (EML-007).","kind":"unavailable"},{"name":"permanent-refusal","condition":"The provider refused for a permanent reason; the message is recorded as failed with the reason (EML-008).","kind":"invalid"},{"name":"suppressed","condition":"The address is on the suppression list of the tenant; the message is recorded as suppressed and left unsent (EML-018).","kind":"forbidden"},{"name":"invalid","condition":"The subject, an address or a name holds a carriage return, a line feed or a NUL byte, or an address field holds more than one address (EML-1566).","type":"api-error","kind":"invalid"},{"name":"held","condition":"The allowance class is used up or the complaint breaker is open; the message is recorded as held (EML-1563, EML-1564).","type":"api-error","kind":"unavailable"}],"exposure":"local","deployment":"shipped"},
    {"id":"receive-delivery-report","name":"Receive a delivery report","ref":"CT-157","realisation":"generated","implementedBy":"mail-dispatcher","auth":{"scheme":"signature","secret":"mail-provider-signing-key","description":"The mail provider, proved by its signature (EML-019)","requires":["mail-report"]},"idempotent":true,"inputs":[{"name":"report","type":"bytes"},{"name":"signature","type":"bytes"},{"name":"timestamp","type":"timestamp"}],"outputs":[],"postconditions":["A permanent bounce adds the address to the suppression list of the tenant for the whole address, and a complaint adds it for the category of the message (EML-017, EML-1562).","The report is mapped to its tenant and message by the provider reference recorded at submission, and an unknown reference changes nothing (EML-1567).","A report produces the domain event mail-delivered, mail-bounced or mail-complained (SCH-1575).","A report within the replay window and not seen within seven days is applied once (EML-1567)."],"errors":[{"name":"unauthenticated","condition":"The report carries no signature of the configured provider.","type":"api-error","kind":"unauthenticated"},{"name":"stale-report","condition":"The timestamp differs from the receipt time by more than five minutes (EML-1567).","type":"api-error","kind":"invalid"},{"name":"malformed","condition":"The report cannot be read as a report of the configured provider.","type":"api-error","kind":"invalid"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"start-local-stack","name":"Start the local stack","ref":"CT-158","realisation":"generated","implementedBy":"release-pipeline","auth":{"scheme":"in-process","description":"A developer on one machine; no cloud credentials (DEP-002)"},"idempotent":true,"inputs":[],"outputs":[{"name":"components","type":"list<string>"}],"postconditions":["One command starts every platform component and its dependencies in containers (DEP-001).","The local stack answers a conversation turn through the local model adapter (CNV-232)."],"errors":[{"name":"start-failed","condition":"A component or a dependency does not start.","kind":"internal"}],"exposure":"local","development":"STRATA_DEV","deployment":"target"},
    {"id":"build-component-image","name":"Build a component image","ref":"CT-159","realisation":"generated","implementedBy":"release-pipeline","auth":{"scheme":"service","description":"Service credential of a platform component","requires":["release-build"]},"idempotent":true,"inputs":[{"name":"commit","type":"string"},{"name":"component","type":"string"}],"outputs":[{"name":"digest","type":"hash"},{"name":"sbom","type":"bytes"},{"name":"signature","type":"bytes"}],"postconditions":["The image is addressed by its content digest (REL-550), signed, with a software bill of materials (THR-255, THR-256)."],"errors":[{"name":"vulnerable-dependency","condition":"A dependency of the build carries a published vulnerability above the threshold (THR-257).","kind":"invalid"},{"name":"gate-failed","condition":"The specification gate has not passed the commit (REL-583).","kind":"invalid"}],"exposure":"internal","deployment":"target","tenantScope":"none"},
    {"id":"apply-deployment-descriptor","name":"Apply a deployment descriptor","ref":"CT-160","realisation":"generated","implementedBy":"release-controller","auth":{"scheme":"session","roles":["release-engineer","platform-operating-agent"],"csrf":true,"origin":true,"description":"Release engineer or platform-operating agent with approval (AGS-426)","requires":["release-deploy"]},"idempotent":true,"inputs":[{"name":"environment","type":"environment-id"},{"name":"descriptor","type":"bytes"},{"name":"dry-run","type":"bool","optional":true}],"outputs":[{"name":"drift","type":"list<string>"}],"postconditions":["A dry run is offered and an audit entry written (AGT-424).","A component runs under a cloud identity that grants only the actions its descriptor needs (THR-258)."],"errors":[{"name":"forbidden","condition":"A change freeze is in force (AGS-427).","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The descriptor names an image that does not verify (THR-255).","type":"api-error","kind":"invalid"}],"exposure":"internal","deployment":"target","tenantScope":"platform"},
    {"id":"declare-change-freeze","name":"Declare a change freeze","ref":"CT-161","realisation":"generated","implementedBy":"release-controller","auth":{"scheme":"session","roles":["platform-owner"],"csrf":true,"origin":true,"description":"A platform owner","requires":["release-freeze"]},"idempotent":true,"inputs":[{"name":"from","type":"timestamp"},{"name":"to","type":"timestamp"}],"outputs":[],"postconditions":["Every deployment and configuration change is refused while it lasts (AGS-427)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"}],"exposure":"internal","deployment":"target","tenantScope":"platform"},
    {"id":"inject-fault","name":"Inject a failure of the operations fault model","ref":"CT-162","realisation":"generated","implementedBy":"release-pipeline","auth":{"scheme":"in-process","description":"Local stack only"},"idempotent":true,"inputs":[{"name":"failure","type":"string"}],"outputs":[],"postconditions":["Every failure mode of the fault model has a hook in the local stack (OPS-349)."],"errors":[{"name":"unknown-failure","condition":"The failure mode has no hook.","kind":"invalid"}],"exposure":"local","development":"STRATA_DEV","deployment":"target"},
    {"id":"run-scenario","name":"Run a scenario","ref":"CT-163","realisation":"generated","implementedBy":"simulator","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"scenario","type":"scenario"}],"outputs":[{"name":"trace","type":"trace"}],"postconditions":["Two runs of one scenario produce traces with equal hashes (SIM-001, SCH-016)."],"errors":[{"name":"cancelled","condition":"The run was cancelled by the caller.","kind":"conflict"}],"exposure":"local","deployment":"shipped"},
    {"id":"project-change","name":"Project a proposed change","ref":"CT-164","realisation":"generated","implementedBy":"simulator","auth":{"scheme":"session","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["change-project"]},"idempotent":true,"inputs":[{"name":"scenario","type":"scenario"},{"name":"proposal","type":"projection-proposal"}],"outputs":[{"name":"projection","type":"projection"}],"postconditions":["A change that alters no behaviour reports no divergence (SIM-002).","The first scheduled operation whose outcome differs is reported (SIM-003).","A projection is requestable through the catalogue against the history of a tenant at a revision (AGT-422)."],"errors":[{"name":"cancelled","condition":"The run was cancelled by the caller.","kind":"conflict"},{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped"},
    {"id":"replay-journal","name":"Replay the journal of a tenant","ref":"CT-165","realisation":"generated","implementedBy":"simulator","auth":{"scheme":"session","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["change-project"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"entries","type":"list<journal-entry>"},{"name":"live","type":"tenant-state","optional":true}],"outputs":[{"name":"replay","type":"journal-replay"}],"postconditions":["The replay reproduces the recorded state delta of each entry (SIM-004).","A tenant is served by a newer kernel version only after its journal replays under it to the recorded state hash (MIG-566)."],"errors":[{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped"},
    {"id":"fork-tenant","name":"Fork a tenant for a projection","ref":"CT-166","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["tenant-fork"]},"idempotent":false,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"at-revision","type":"u64","optional":true}],"outputs":[{"name":"fork","type":"tenant-id"},{"name":"expires-at","type":"u64"}],"postconditions":["The fork is a copy on which a change is previewed before it is applied (MIG-550).","The fork has its own identifier, database and key, in the region of the source, and nothing of the source that is live outside the platform (TEN-1234).","The fork ends after 7 days, with its projection, or with its source (TEN-1235).","A subject erasure in the source reaches the fork (TEN-1236)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The tenant named by the input does not exist.","type":"api-error","kind":"not_found"},{"name":"throttled","condition":"The tenant already made 2 forks in 7 days (q-fork-tenant).","type":"api-error","kind":"throttled"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"count-request","name":"Count a request against a limit","ref":"CT-167","realisation":"generated","implementedBy":"limit-store","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":false,"inputs":[{"name":"key","type":"string"},{"name":"window","type":"duration"},{"name":"limit","type":"u64"}],"outputs":[{"name":"allowed","type":"bool"},{"name":"remaining","type":"u64"},{"name":"retry-after","type":"duration","optional":true}],"postconditions":["Request rates are counted in one store that every gateway instance reads and writes (ARC-109)."],"errors":[{"name":"unavailable","condition":"The store could not do the work right now; safe to retry.","type":"store-error","kind":"unavailable"}],"exposure":"local","deployment":"target"},
    {"id":"count-agent-operation","name":"Count an agent operation against its budget","ref":"CT-168","realisation":"generated","implementedBy":"limit-store","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":false,"inputs":[{"name":"agent","type":"principal-id"},{"name":"kind","type":"string"},{"name":"amount","type":"u64"}],"outputs":[{"name":"allowed","type":"bool"}],"postconditions":["An agent that exceeds its budget is refused until the window ends (AGT-017)."],"errors":[{"name":"unavailable","condition":"The store could not do the work right now; safe to retry.","type":"store-error","kind":"unavailable"}],"exposure":"local","deployment":"target"},
    {"id":"write-backup","name":"Write a backup of a tenant database","ref":"CT-169","realisation":"generated","implementedBy":"backup-archive","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":false,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"at","type":"timestamp"}],"outputs":[{"name":"image","type":"hash"}],"postconditions":["The copy is encrypted under the key of that tenant (ARC-111).","Backups are stored in the region of the primary placement (PRV-371)."],"errors":[{"name":"unavailable","condition":"The store could not do the work right now; safe to retry.","type":"store-error","kind":"unavailable"}],"exposure":"local","deployment":"target"},
    {"id":"read-backup","name":"Read a backup","ref":"CT-170","realisation":"generated","implementedBy":"backup-archive","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"image","type":"hash"}],"outputs":[{"name":"content","type":"bytes"}],"postconditions":["A backup of one tenant is unreadable with the key of any other tenant (TEN-252)."],"errors":[{"name":"not-found","condition":"No such image for this tenant.","type":"store-error","kind":"not_found"},{"name":"unavailable","condition":"The store could not do the work right now; safe to retry.","type":"store-error","kind":"unavailable"}],"exposure":"local","deployment":"target"},
    {"id":"remove-expired-backups","name":"Remove backups past their retention","ref":"CT-171","realisation":"generated","implementedBy":"backup-archive","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"now","type":"timestamp"}],"outputs":[{"name":"removed","type":"u64"}],"postconditions":["A backup image or export is removed when its retention period has ended (PRV-700)."],"errors":[{"name":"unavailable","condition":"The store could not do the work right now; safe to retry.","type":"store-error","kind":"unavailable"}],"exposure":"local","deployment":"target"},
    {"id":"receive-inbound-webhook","name":"Receive an inbound webhook delivery","ref":"CT-172","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"signature","secret":"webhook-endpoint-secret","description":"The external system, proved by the signature of its endpoint secret","requires":["webhook-receive"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"endpoint","type":"string"},{"name":"body","type":"bytes"},{"name":"signature","type":"bytes"},{"name":"event-id","type":"string"},{"name":"timestamp","type":"timestamp"}],"outputs":[{"name":"run","type":"run-id","optional":true}],"postconditions":["A delivery starts a workflow run only when the signature, which covers the event identifier, the timestamp and the body (INT-2640), matches a secret of the endpoint (INT-150, INT-1577).","A repeated delivery of one event leaves the number of runs unchanged and answers the run the first delivery started, and the event identifier is kept for seven days (INT-151, INT-1577).","During the overlap after a rotation the signature of either secret matches (INT-1578).","Deliveries are limited to 600 a minute for each endpoint and 600 a minute for each source address (INT-1577, q-receive-inbound-webhook).","The run is handed to the automation worker as a start job with the parameters webhook_event, webhook_endpoint and, when the body is UTF-8 text, webhook_body."],"errors":[{"name":"unauthenticated","condition":"The signature does not match a secret of the endpoint, or the endpoint does not exist; the answer is the same for both (INT-1577).","type":"api-error","kind":"unauthenticated"},{"name":"stale-delivery","condition":"The timestamp differs from the receipt time by more than five minutes (INT-1577).","type":"api-error","kind":"invalid"},{"name":"too-large","condition":"The body exceeds one mebibyte (INT-1577).","type":"api-error","kind":"invalid"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"shipped","bffRoute":"POST /webhooks/inbound/:endpoint"},
    {"id":"list-webhook-deliveries","name":"List outbound webhook deliveries","ref":"CT-173","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","roles":["owner"],"description":"An owner of the tenant","requires":["webhooks-read"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"cursor","type":"string","optional":true},{"name":"limit","type":"u32","optional":true,"description":"At most 100; 50 when absent."}],"outputs":[{"name":"deliveries","type":"list<webhook-delivery>"},{"name":"next","type":"string","optional":true}],"postconditions":["Each entry shows the response status and attempt count (INT-152).","Each entry shows its target without query, user name or password (WFL-254), its subscription and its state (queued, retrying, delivered or failed), and no body.","Entries come newest first; the cursor is the creation time and the id of the last entry of the page."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped","bffRoute":"GET /api/webhooks/deliveries"},
    {"id":"index-record","name":"Update the index from a commit","ref":"CT-174","realisation":"generated","implementedBy":"search-index","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"event","type":"domain-event"}],"outputs":[],"postconditions":["An entry follows the commit of its record, including the commit of its deletion (SRH-152)."],"errors":[{"name":"unavailable","condition":"The store could not do the work right now; safe to retry.","type":"store-error","kind":"unavailable"}],"exposure":"local","deployment":"target"},
    {"id":"search","name":"Search a tenant","ref":"CT-175","realisation":"generated","implementedBy":"search-index","auth":{"scheme":"anonymous","description":"Anyone; no session is needed","requires":["content-read"]},"idempotent":true,"inputs":[{"name":"host","type":"host"},{"name":"query","type":"string"},{"name":"objects","type":"string","optional":true},{"name":"cursor","type":"string","optional":true},{"name":"limit","type":"u32","optional":true}],"outputs":[{"name":"hits","type":"list<search-found>"},{"name":"next","type":"string","optional":true},{"name":"examined","type":"u32"},{"name":"revision","type":"state-revision"},{"name":"schema-version","type":"schema-version"}],"postconditions":["The reader is the principal of the session, and the anonymous reader when there is none; the caller supplies no audience class (CPY-005).","Only records the reader may read are returned, each without the fields the reader may not read; an anonymous reader finds published records only (SRH-150).","An editor also finds the drafts the roles permit, each with its status (SRH-151).","A word that only a field the reader may not read holds is not a hit for that reader (SRH-1590, SRH-2785).","The records of one tenant only are read (NG-10, SRH-2789).","The throttled response names the limit and the time after which the next request is permitted (CMS-168, SRH-2790)."],"errors":[{"name":"not-found","condition":"The request names an object type that does not exist for this tenant (SRH-2788).","type":"api-error","kind":"not_found"},{"name":"invalid","condition":"The query has no word, more than 8 different words or more than 200 bytes, the page size is not from 1 to 200, or the cursor is not one a search issued (SRH-2788).","type":"api-error","kind":"invalid"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"},{"name":"unavailable","condition":"The store could not do the work right now; safe to retry.","type":"store-error","kind":"unavailable"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped","timeoutMs":10000,"bffRoute":"GET /api/search","description":"The route GET /api/search takes the words as q, the object types to search as objects (names separated by commas; all that declare a searchable field when absent), the cursor an earlier answer gave as cursor and the size of a page as limit. It answers as the principal of the session, and as the anonymous reader without one. The store answers the candidates of its search index and the kernel decides each one for the reader (D-7781); a request examines at most 1000 candidates. The route is counted against the per-source request rate of the gateway, as a page or a view is."},
    {"id":"issue-submission-token","name":"Issue a submission token for a form","ref":"CT-176","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"anonymous","justification":"It issues a signed submission token for a public form and stores nothing.","description":"Anyone; no session is needed","requires":["form-submit"]},"idempotent":false,"inputs":[{"name":"host","type":"host"},{"name":"form","type":"form-id"}],"outputs":[{"name":"token","type":"secret"}],"errors":[{"name":"not-found","condition":"The form does not exist for this tenant.","type":"api-error","kind":"not_found"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target"},
    {"id":"submit-form","name":"Submit a form","ref":"CT-177","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"anonymous","csrf":true,"origin":true,"justification":"Public forms are for visitors; the submission token is the request token.","description":"Anyone; no session is needed","requires":["form-submit"]},"idempotent":false,"inputs":[{"name":"host","type":"host"},{"name":"form","type":"form-id"},{"name":"token","type":"secret"},{"name":"values","type":"value-map"}],"outputs":[{"name":"submission","type":"submission-id"}],"postconditions":["The submission is stored in the tenant database before the reader is told it was received (FRM-150).","The notice goes through the subscriptions the form names (FRM-152)."],"errors":[{"name":"invalid","condition":"The submission token was not issued to this browser, or the values do not match the form.","type":"api-error","kind":"invalid"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"import-records","name":"Import records from an archive","ref":"CT-178","realisation":"generated","implementedBy":"migration-job","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["records-import"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"archive","type":"archive-ref"}],"outputs":[{"name":"report","type":"mapping-report"}],"postconditions":["An import updates a record the tenant already holds, so that it can be run again (MIG-574).","It keeps the identifiers, versions, timestamps and authors the archive names (MIG-576).","It produces a mapping report naming each source field, its target and each unmapped value (MIG-575).","A redirect is created from each former page address (MIG-577)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"A record has fields its content type does not declare (CMS-172).","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"export-form-submissions","name":"Export the submissions of a form","ref":"CT-179","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","roles":["submissions-reader"],"description":"A person with the role that reads submissions","requires":["submissions-export"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"form","type":"form-id"}],"outputs":[{"name":"document","type":"bytes"}],"postconditions":["A cell that begins with a formula character is prefixed so a spreadsheet reads it as text (GWY-262)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target"},
    {"id":"build-archive-manifest","name":"Build the manifest of an archive","ref":"CT-180","realisation":"generated","implementedBy":"control-plane","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"}],"outputs":[{"name":"manifest","type":"archive-manifest"}],"postconditions":["The manifest names the hash of each file included and each kind of content not carried (ADM-162, MIG-578)."],"errors":[],"exposure":"local","deployment":"target"},
    {"id":"subscribe-notifications","name":"Subscribe to notifications","ref":"CT-181","realisation":"generated","implementedBy":"notification-service","auth":{"scheme":"session","description":"A signed-in principal","requires":["notifications-read"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"topic","type":"string","description":"An inbox topic or a prefix that ends in .* (NTF-1568)."},{"name":"delivery","type":"string"}],"outputs":[{"name":"subscription","type":"string"}],"postconditions":["Delivery is by email, by inbox or by both (NTF-151).","The topic follows the grammar of NTF-1568; a topic outside it is refused."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target"},
    {"id":"list-inbox","name":"List the inbox of the caller","ref":"CT-182","realisation":"generated","implementedBy":"notification-service","auth":{"scheme":"session","description":"A signed-in principal","requires":["notifications-read"]},"idempotent":true,"inputs":[{"name":"cursor","type":"string","optional":true},{"name":"state","type":"notice-state","optional":true},{"name":"topic","type":"string","optional":true,"description":"A topic, or a prefix that ends in .*."},{"name":"limit","type":"u32","optional":true}],"outputs":[{"name":"notices","type":"list<inbox-notice>"},{"name":"next","type":"string","optional":true},{"name":"unread","type":"u32"}],"postconditions":["An approval step is in the inbox of each principal its policy names and in no other (NTF-152).","The list filters by state and by topic, and unread is the number of unread notices of the caller for the same topic (NTF-1569)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/inbox/list"},
    {"id":"send-notice","name":"Send a notice to a recipient","ref":"CT-183","realisation":"generated","implementedBy":"notification-service","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":false,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"recipient","type":"principal-id"},{"name":"topic","type":"inbox-topic"},{"name":"category","type":"message-category-id"},{"name":"template","type":"template-id"},{"name":"values","type":"value-map","optional":true},{"name":"idempotency-key","type":"string"},{"name":"reference","type":"send-reference","optional":true}],"outputs":[],"postconditions":["An email notice omits the field values of each record its recipient has no right to read (NTF-150).","The notice is rendered from its notice template for this recipient (NTF-1570) and respects the preference of the recipient (NTF-1571).","This operation is the inbox half of send-message (EML-1560)."],"errors":[],"exposure":"local","deployment":"shipped"},
    {"id":"count-usage","name":"Count the usage of a billing period","ref":"CT-184","realisation":"generated","implementedBy":"control-plane","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"period","type":"string"}],"outputs":[{"name":"usage","type":"list<usage-count>"}],"postconditions":["Metered quantities are counted from the records that carry them (BIL-152)."],"errors":[],"exposure":"local","deployment":"target"},
    {"id":"export-usage","name":"Export usage to the billing system","ref":"CT-185","realisation":"generated","implementedBy":"control-plane","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"period","type":"string"}],"outputs":[{"name":"document","type":"bytes"},{"name":"signature","type":"bytes"}],"postconditions":["The usage of each period is delivered as a signed document (BIL-153)."],"errors":[{"name":"unavailable","condition":"The billing system did not accept the document.","type":"api-error","kind":"unavailable"}],"exposure":"local","deployment":"target"},
    {"id":"show-status","name":"Show the status page","ref":"CT-186","realisation":"generated","implementedBy":"web-application","auth":{"scheme":"anonymous","description":"Anyone; no session is needed","requires":["content-read"]},"idempotent":true,"inputs":[],"outputs":[{"name":"page","type":"html-page"}],"postconditions":["The page names the state of each component and each open incident, for readers with no account (OBS-150)."],"errors":[],"exposure":"public","readOnly":true,"tenantScope":"none","deployment":"target"},
    {"id":"show-changelog","name":"Show the changelog","ref":"CT-187","realisation":"generated","implementedBy":"web-application","auth":{"scheme":"anonymous","description":"Anyone; no session is needed","requires":["content-read"]},"idempotent":true,"inputs":[],"outputs":[{"name":"entries","type":"list<changelog-entry>"}],"postconditions":["A change to the delivery interface appears with the version it introduced (CMS-171)."],"errors":[],"exposure":"public","readOnly":true,"tenantScope":"none","deployment":"target"},
    {"id":"show-service-objectives","name":"Show service objectives and results","ref":"CT-188","realisation":"generated","implementedBy":"web-application","auth":{"scheme":"anonymous","description":"Anyone; no session is needed","requires":["content-read"]},"idempotent":true,"inputs":[{"name":"month","type":"string","optional":true}],"outputs":[{"name":"objectives","type":"list<value-map>"}],"postconditions":["The objectives of each plan and the result measured in each calendar month are published (BIL-155)."],"errors":[],"exposure":"public","readOnly":true,"tenantScope":"none","deployment":"target"},
    {"id":"post-turn","name":"Post a turn to a conversation","ref":"CT-189","realisation":"generated","implementedBy":"conversation-service","auth":{"scheme":"session","csrf":true,"origin":true,"description":"A signed-in principal","requires":["assistant-converse"]},"idempotent":false,"inputs":[{"name":"conversation","type":"conversation-id"},{"name":"message","type":"string"},{"name":"context","type":"value-map","optional":true}],"outputs":[{"name":"turn","type":"turn-id"}],"postconditions":["A new tenant has the assistant off until an owner turns it on (CNV-500).","A refusal names the policy that refused and the next step (CNV-212)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"unavailable","condition":"The tenant turned the assistant off, or the model provider did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"stream-reply","name":"Stream a reply","ref":"CT-190","realisation":"generated","implementedBy":"conversation-service","auth":{"scheme":"session","description":"A signed-in principal","requires":["assistant-converse"]},"idempotent":true,"inputs":[{"name":"conversation","type":"conversation-id"},{"name":"after","type":"u64","optional":true}],"outputs":[{"name":"stream","type":"event-stream"}],"postconditions":["A reply streams as produced and ends in one recorded state: complete, interrupted or failed (CNV-220).","The first part is sent within 1 second at the 95th percentile (CNV-224).","A reload resumes from the last recorded part (CNV-223)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"not-found","condition":"The conversation does not exist for this tenant.","type":"api-error","kind":"not_found"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target"},
    {"id":"cancel-turn","name":"Cancel a turn","ref":"CT-191","realisation":"generated","implementedBy":"conversation-service","auth":{"scheme":"session","csrf":true,"origin":true,"description":"A signed-in principal","requires":["assistant-converse"]},"idempotent":true,"timeoutMs":1000,"inputs":[{"name":"turn","type":"turn-id"}],"outputs":[],"postconditions":["Model output and every operation not yet committed stop within 1 second at the 99th percentile (CNV-221, CNV-225)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"not-found","condition":"The turn does not exist for this tenant.","type":"api-error","kind":"not_found"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"get-pending-action","name":"Preview a pending action","ref":"CT-192","realisation":"generated","implementedBy":"conversation-service","auth":{"scheme":"session","description":"A signed-in principal","requires":["assistant-converse"]},"idempotent":true,"timeoutMs":3000,"inputs":[{"name":"pending","type":"pending-id"}],"outputs":[{"name":"preview","type":"action-preview"}],"postconditions":["The preview lists the records the change creates, changes and removes and the views it affects (CNV-205)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"not-found","condition":"The pending action does not exist for this tenant.","type":"api-error","kind":"not_found"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target"},
    {"id":"confirm-pending-action","name":"Confirm a pending action","ref":"CT-193","realisation":"generated","implementedBy":"conversation-service","auth":{"scheme":"session","csrf":true,"origin":true,"description":"A signed-in principal","requires":["assistant-converse"]},"idempotent":false,"inputs":[{"name":"pending","type":"pending-id"},{"name":"preview-hash","type":"hash"}],"outputs":[{"name":"result","type":"operation-result"}],"postconditions":["A change is applied only after the person confirms the preview that shows it (CNV-206).","The confirmation binds to the preview it answers (CNV-207)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"conflict","condition":"The preview changed or the revision of the tenant changed, or 15 minutes have passed (CNV-701).","type":"api-error","kind":"conflict"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"cancel-pending-action","name":"Cancel a pending action","ref":"CT-194","realisation":"generated","implementedBy":"conversation-service","auth":{"scheme":"session","csrf":true,"origin":true,"description":"A signed-in principal","requires":["assistant-converse"]},"idempotent":true,"inputs":[{"name":"pending","type":"pending-id"}],"outputs":[],"postconditions":["No change is applied to any record (CNV-210)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"not-found","condition":"The pending action does not exist for this tenant.","type":"api-error","kind":"not_found"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"undo-turn","name":"Undo the change of a turn","ref":"CT-195","realisation":"generated","implementedBy":"conversation-service","auth":{"scheme":"session","csrf":true,"origin":true,"description":"A signed-in principal","requires":["assistant-converse"]},"idempotent":false,"inputs":[{"name":"turn","type":"turn-id"}],"outputs":[{"name":"pending","type":"pending-id"}],"postconditions":["The inverse operation is previewed and applied only after confirmation (CNV-209)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"not-found","condition":"The turn does not exist for this tenant.","type":"api-error","kind":"not_found"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"get-conversation","name":"Read a conversation","ref":"CT-196","realisation":"generated","implementedBy":"conversation-service","auth":{"scheme":"session","tenantPolicies":true,"description":"The principal that started it, and holders of the tenant right","requires":["assistant-converse"]},"idempotent":true,"inputs":[{"name":"conversation","type":"conversation-id"}],"outputs":[{"name":"turns","type":"list<turn-id>"}],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The conversation does not exist for this tenant.","type":"api-error","kind":"not_found"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target"},
    {"id":"delete-conversation","name":"Delete a conversation","ref":"CT-197","realisation":"generated","implementedBy":"conversation-service","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"The principal that started it, or the tenant","requires":["assistant-converse"]},"idempotent":true,"inputs":[{"name":"conversation","type":"conversation-id"}],"outputs":[],"postconditions":["Its turns, pending actions and model request content are removed (CNV-229)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"generate-reply","name":"Generate a reply","ref":"CT-198","realisation":"generated","implementedBy":"model-provider","auth":{"scheme":"service","description":"Service credential of a platform component","requires":["model-generate"]},"idempotent":false,"inputs":[{"name":"messages","type":"list<string>"},{"name":"operations","type":"list<operation-entry>"},{"name":"stream","type":"bool"}],"outputs":[{"name":"reply","type":"string"},{"name":"usage","type":"model-usage"}],"postconditions":["The content sent is only what the tenant policy permits for the read of the person served (CNV-233).","Each reply names the provider and model that produced it (CNV-236).","Content is sent only under a contract that forbids training on it (CNV-235)."],"errors":[{"name":"provider-unavailable","condition":"The provider did not answer.","kind":"unavailable"},{"name":"refused","condition":"The provider refused the request.","kind":"forbidden"}],"exposure":"internal","deployment":"target","tenantScope":"none"},
    {"id":"report-model-usage","name":"Report the usage of a request","ref":"CT-199","realisation":"generated","implementedBy":"model-provider","auth":{"scheme":"service","description":"Service credential of a platform component","requires":["model-generate"]},"idempotent":true,"inputs":[{"name":"request","type":"request-id"}],"outputs":[{"name":"usage","type":"model-usage"}],"errors":[{"name":"unknown-request","condition":"No such request.","kind":"not_found"}],"exposure":"internal","deployment":"target","tenantScope":"platform"},
    {"id":"save-record-edit","name":"Save an edit of a record","ref":"CT-200","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the operation","requires":["content-write"]},"idempotent":false,"inputs":[{"name":"record","type":"record-id"},{"name":"expected-version","type":"u64"},{"name":"fields","type":"value-map"}],"outputs":[{"name":"version","type":"u64"}],"postconditions":["A resolved conflict becomes a new version in which the person chose the value of each field (UXA-207)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"conflict","condition":"Another save from the same version won; the conflicting fields are returned (UXA-206).","type":"api-error","kind":"conflict"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"announce-presence","name":"Announce presence on a record","ref":"CT-201","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","csrf":true,"origin":true,"description":"A signed-in principal","requires":["content-write"]},"idempotent":true,"timeoutMs":3000,"inputs":[{"name":"record","type":"record-id"}],"outputs":[{"name":"others","type":"list<display-name>"}],"postconditions":["Each other person editing a record shows by display name before the person saves (UXA-209).","A change of presence appears within 3 seconds (UXA-208)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"open-operator-console","name":"Open the operator console for a tenant","ref":"CT-202","realisation":"generated","implementedBy":"operator-console","auth":{"scheme":"session","roles":["platform-operator","support"],"tenantPolicies":true,"description":"An operator or support member on the operations network, holding a grant for the tenant (THR-253)","requires":["tenant-support-read"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"grant","type":"grant-id"}],"outputs":[{"name":"session","type":"session-id"}],"postconditions":["An act of the operator in a tenant leaves an audit entry naming the operator and the grant (ADM-164).","A request refused for want of a valid grant leaves an audit entry in the audit log of the tenant (OBS-1217)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"grant-invalid","condition":"The grant is expired, withdrawn, issued for another tenant or issued to another operator, or the tenant forbids platform access (PRV-1210, ADM-165, D-6204).","type":"api-error","kind":"forbidden"}],"exposure":"internal","readOnly":true,"deployment":"target","tenantScope":"platform"},
    {"id":"upload-file","name":"Upload a file","ref":"CT-203","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the operation; either capability suffices (D-6591)","requires":["content-write","self-file-upload"]},"idempotent":false,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"content","type":"bytes"},{"name":"declared-type","type":"string"},{"name":"name","type":"string"}],"outputs":[{"name":"file","type":"hash"},{"name":"state","type":"string"}],"postconditions":["The file name is stored as data and escaped wherever shown (CMS-257).","The content is at most 1048576 bytes; a larger file is sent with start-upload, put-upload-chunk and finish-upload (CMS-1593).","Until a record refers to the file it is readable only by the principal that uploaded it (CMS-1591)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The content does not confirm the media type (CMS-261), or the decompressed size exceeds the plan limit (CMS-263).","type":"api-error","kind":"invalid"},{"name":"too-large","condition":"The content exceeds 1048576 bytes or a limit of the tenant (CMS-1593).","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/files/upload"},
    {"id":"scan-upload","name":"Scan an uploaded file","ref":"CT-204","realisation":"generated","implementedBy":"upload-scanner","auth":{"scheme":"service","description":"Service credential of a platform component","requires":["upload-scan"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"file","type":"hash"}],"outputs":[{"name":"clean","type":"bool"},{"name":"media-type","type":"string"},{"name":"renditions","type":"list<hash>"}],"postconditions":["A file is released for delivery only after a clean result (CMS-260).","Renditions are produced by a process with no connector secret and no network access (CMS-262)."],"errors":[{"name":"unavailable","condition":"The scanner did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"internal","deployment":"shipped","tenantScope":"platform"},
    {"id":"deliver-file","name":"Deliver an uploaded file","ref":"CT-205","realisation":"generated","implementedBy":"gateway","auth":{"scheme":"signed-address","secret":"file-address-key","description":"The principal named in a signed address, signed in","requires":["media-deliver"]},"idempotent":true,"inputs":[{"name":"file-host","type":"host"},{"name":"file","type":"string","description":"The content hash of the file (CMS-1591)."},{"name":"expires","type":"string","description":"The time the signed address stops working, in milliseconds since the epoch."},{"name":"scope","type":"string","description":"Whom the address serves: public, or the principal it was signed for."},{"name":"signature","type":"string","description":"The signature over the file, the expiry and the scope, under the tenant's address key."}],"outputs":[{"name":"content","type":"bytes"},{"name":"media-type","type":"string"}],"postconditions":["A file of a markup- or script-capable type is delivered only from the file domain (CMS-258).","A tenant host name serves no uploaded file (CMS-259).","A private file is delivered only when the session of the request is of the principal the address names, the address has not expired, and that principal may still read the file; a failed check answers not-found (EDG-1592).","A file that no record refers to and that is not the upload of the requester is not delivered (CMS-1591)."],"errors":[{"name":"not-found","condition":"The file does not exist for this tenant, the address has expired or is not for the principal of the session, or the principal may no longer read the file.","type":"api-error","kind":"not_found"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped","bffRoute":"GET /files/:file/:expires/:scope/:signature"},
    {"id":"call-external-address","name":"Call an external address","ref":"CT-206","realisation":"generated","implementedBy":"outbound-gate","auth":{"scheme":"service","description":"The connector runner","requires":["outbound-call"]},"idempotent":false,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"method","type":"string"},{"name":"target","type":"url"},{"name":"headers","type":"value-map"},{"name":"body","type":"bytes","optional":true},{"name":"idempotency-key","type":"string","optional":true},{"name":"max-bytes","type":"u64"}],"outputs":[{"name":"status","type":"u16"},{"name":"headers","type":"value-map"},{"name":"body","type":"bytes"}],"postconditions":["The call connects only to the address the gate resolved and judged (WFL-250).","The call is recorded with target address, outcome and idempotency key and no body (PRV-366).","A slow call occupies connector capacity only for its tenant (OPS-304)."],"errors":[{"name":"address-refused","condition":"The address resolves to a private, link-local or loopback network, or is outside the outbound rule (WFL-008, WFL-252).","kind":"forbidden"},{"name":"redirect-refused","condition":"A redirect names an address the rule does not allow (WFL-251).","kind":"forbidden"},{"name":"too-large","condition":"The response exceeds the size the connector policy names (WFL-253).","kind":"invalid"},{"name":"unreachable","condition":"The address did not answer.","kind":"unavailable"}],"exposure":"internal","deployment":"target","tenantScope":"platform"},
    {"id":"fetch-provider-metadata","name":"Fetch identity provider metadata","ref":"CT-207","realisation":"generated","implementedBy":"outbound-gate","auth":{"scheme":"service","description":"Service credential of a platform component","requires":["outbound-call"]},"idempotent":true,"inputs":[{"name":"provider","type":"provider-id"}],"outputs":[{"name":"metadata","type":"bytes"}],"errors":[{"name":"address-refused","condition":"The address is not the one the provider configuration names (FED-261).","kind":"forbidden"}],"exposure":"internal","deployment":"target","tenantScope":"platform"},
    {"id":"issue-access-grant","name":"Issue a support grant","ref":"CT-208","realisation":"generated","implementedBy":"subject-rights-service","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["support-grant-issue"],"stepUp":"15 min"},"idempotent":false,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"grantee","type":"principal-id"},{"name":"scope","type":"list<string>"},{"name":"expires-at","type":"timestamp"},{"name":"purpose","type":"string"}],"outputs":[{"name":"grant","type":"grant-id"}],"postconditions":["The grant appears in the audit log before the first read made under it (PRV-368).","Platform staff reach personal data only through a grant that names them (PRV-367).","The grant records its purpose and its scope, and it confers tenant-support-read on its grantee for this tenant alone until its expiry or withdrawal (PRV-1210, D-6204)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The tenant forbids platform access (PRV-369).","type":"api-error","kind":"invalid"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"expiry-invalid","condition":"The expiry is not after the time of issue, or is more than 72 hours after it (PRV-1210, D-6204).","type":"api-error","kind":"invalid"},{"name":"grantee-not-staff","condition":"The grantee does not hold the role support or platform-operator (PRV-1210).","type":"api-error","kind":"invalid"},{"name":"purpose-missing","condition":"The purpose or the scope is empty (PRV-367, PRV-1210).","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"withdraw-access-grant","name":"Withdraw a support grant","ref":"CT-209","realisation":"generated","implementedBy":"subject-rights-service","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["support-grant-issue"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"grant","type":"grant-id"}],"outputs":[],"postconditions":["Every later request made under the grant is refused (ADM-165).","The withdrawal is recorded in the audit log with the principal and the grant (OBS-1217)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The grant does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"export-subject-data","name":"Export the data of one principal","ref":"CT-210","realisation":"generated","implementedBy":"subject-rights-service","auth":{"scheme":"session","csrf":true,"origin":true,"description":"The person the data concerns, or an owner of the tenant","requires":["subject-rights"],"stepUp":"15 min"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"principal","type":"principal-id","optional":true,"description":"The person whose data is exported; the signed-in person when absent. Only an owner names another person."}],"outputs":[{"name":"archive","type":"archive-ref","description":"The id of the export. The result is fetched with fetch-subject-export once its job has ended."},{"name":"expires-at","type":"timestamp"}],"postconditions":["The request starts a job that reads the records of the principal in batches of at most 100 through the enumeration the erasure uses, so the export holds every personal field erasure would clear and no field of another subject (PRV-350, PRV-1586, PRV-2740).","The result is one deterministic JSON document of the format strata-subject-export/1 whose members, in this order, are: format; tenant; subject; generated_at (milliseconds); restriction (null, or since and reason); account (login, display_name and verified_email, or null, never a password hash); credentials (passkeys with id, label, created_at and last_used_at; authenticator with confirmed and created_at, or null; recovery_codes_left; never a secret, a public key or a code); sessions (the live sessions with id and times, never a token); membership (roles; teams with id and roles; invitations_issued with id, roles, redeemed and revoked and never the address; invitations_redeemed with id, roles and address); records (each record the erasure would change, ordered by object and id, with object, id, version, created_at, updated_at, created_by only when a field is personal to the creator and the principal is the creator, and fields holding only the personal fields whose subject is the principal as plain JSON, timestamps in milliseconds and references as ids); ledger (accounts the principal owns with their entries, and entries_caused on other accounts, caused_by shown only when it is the principal); segments (segment and since); settings (setting, value and set_at of the values set for the person); inbox (null, no inbox exists); not_included (what the export lacks and why). Every list has a fixed order and every object its members in a fixed order, so the same state and request time give the same bytes (PRV-2740).","The request is an audit entry that names the tenant and the export, never the person (PRV-2741)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller is neither the person nor an owner of the tenant.","type":"api-error","kind":"forbidden"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The principal does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/subject-rights/export"},
    {"id":"rectify-subject-field","name":"Rectify one personal field","ref":"CT-211","realisation":"generated","implementedBy":"subject-rights-service","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["subject-rights"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"principal","type":"principal-id"},{"name":"record","type":"record-id"},{"name":"field","type":"string"},{"name":"value","type":"string"}],"outputs":[{"name":"version","type":"u64"}],"postconditions":["The field is replaced in its record, in every copy and in the search index (PRV-351)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The record does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"restrict-subject","name":"Restrict the processing of one principal","ref":"CT-212","realisation":"generated","implementedBy":"subject-rights-service","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["subject-rights"],"stepUp":"15 min"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"principal","type":"principal-id"},{"name":"reason","type":"string"}],"outputs":[],"postconditions":["The restriction is kept with its reason, the time and the owner who placed it; placing it again changes nothing (PRV-352).","A view returns no personal field whose subject is a restricted principal, the records of a restricted principal are kept from the retention sweep, and the erasure and the export of the principal are not blocked; the receipt of an erasure names the restriction and the restriction ends with the erasure (PRV-2742).","Automations, segments, mail and exports to a third party do not take a restriction yet; the follow-up tasks are WG-5200, WG-5201 and WG-5202 (D-7741)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller does not own the tenant.","type":"api-error","kind":"forbidden"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The principal does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"invalid","condition":"No reason is given.","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/subject-rights/restrict"},
    {"id":"erase-subject","name":"Erase one principal","ref":"CT-213","realisation":"generated","implementedBy":"subject-rights-service","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["subject-rights"],"stepUp":"15 min"},"idempotent":false,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"principal","type":"principal-id"}],"outputs":[{"name":"receipt","type":"erasure-receipt"}],"postconditions":["The receipt names each record changed and the fields cleared, never a value, and each copy reached with the erasure point it reached (PRV-353).","Every field of a tenant record type that declares the principal as its data subject, by the creator of the record or by a text field that holds the principal id, is cleared in its record in a batch of at most 100 records, and the index rows of the record are rewritten in the same commit; a required field takes the empty value of its type, and a required reference or language is reported as not erased; a record of a held record type is left unchanged and reported as held (PRV-355, PRV-1586, PRV-1588).","Every login and credential of the principal is removed through Store::remove_principal in the same erasure, the sessions of the principal end, and the roles, the places in teams, the invitations the principal issued and nobody redeemed, and the invitations addressed to the verified address of the principal and not redeemed (revoked, their address cleared) are removed; the call is refused when it would leave the tenant without an owner (WG-5117).","The audit log is never rewritten, so the audit chain stays verifiable (PRV-359).","A repeated call changes nothing that was erased and returns a new receipt; the receipts are kept and an owner reads them with list-erasure-receipts.","The receipt states the restriction of processing in force on the principal, which ends with the erasure, and each legal hold that kept a record unchanged (PRV-352, PRV-355, PRV-2463). The records past their retention are deleted by the retention sweep, not by the erasure (PRV-357).","The receipt lists each copy not reached, why, and the task that closes it: the copies written before the tenant was first sealed (D-7724), fields whose subject the store cannot resolve, journal intents other than record field values, backup images until they expire, the members, teams and invitations in snapshots, and audit lines that name the person outside the sealed members; complete is false while any remains.","After the records are cleared, every live subject key of the principal is destroyed, which makes every value sealed under it unreadable in the records, the index, the events and the outbox, the journal, the snapshots and the audit lines; no stored copy is rewritten, so the journal hashes and the audit chain still verify, and the destruction is an audit entry naming the tenant and the key ids (PRV-2724, PRV-362)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"conflict","condition":"A legal hold on the principal suspends the erasure; the reply names the hold and nothing is changed (PRV-355). The commits of the erasure may also keep losing to other changes of the tenant; repeating the call carries on.","type":"api-error","kind":"conflict"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The principal does not exist for this tenant, or belongs to another tenant; the two are not told apart (PRV-1588).","type":"api-error","kind":"not_found"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The erasure would leave the tenant without an owner.","type":"api-error","kind":"invalid"}],"exposure":"public","tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/subject-rights/erase"},
    {"id":"get-processing-record","name":"Export the processing record of a tenant","ref":"CT-214","realisation":"generated","implementedBy":"subject-rights-service","auth":{"scheme":"session","roles":["owner"],"description":"An owner of the tenant","requires":["subject-rights"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"}],"outputs":[{"name":"record","type":"value-map"}],"postconditions":["The record lists each record type that holds personal data and the subprocessors that receive it (PRV-378, PRV-373)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target"},
    {"id":"place-legal-hold","name":"Place a legal hold","ref":"CT-215","realisation":"generated","implementedBy":"subject-rights-service","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["subject-rights"],"stepUp":"15 min"},"idempotent":false,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"subject","type":"principal-id","optional":true,"description":"The person the hold covers. Exactly one of subject and object is given."},{"name":"object","type":"object-type-id","optional":true,"description":"The record type the hold covers."},{"name":"reason","type":"string"}],"outputs":[{"name":"hold","type":"hold-id"}],"postconditions":["The erasure of a held subject is refused with conflict naming the hold, before any record is changed; the erasure of any other person leaves every record of a held record type unchanged and the receipt names each (PRV-355, PRV-2743).","The retention sweep deletes no record of a held record type or of a held person until the hold is released (PRV-355, PRV-2743).","The hold is kept with its reason, its time and the owner; releasing it keeps it as the record of the hold (rec-legal-hold)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller does not own the tenant.","type":"api-error","kind":"forbidden"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"Neither or both of subject and object are given, the record type does not exist, or no reason is given.","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/subject-rights/place-hold"},
    {"id":"define-token","name":"Define a content token","ref":"CT-216","realisation":"generated","implementedBy":"kernel","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["tokens-define"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"name","type":"string"},{"name":"expression","type":"expression"},{"name":"fallback","type":"string"}],"outputs":[{"name":"version","type":"u64"}],"postconditions":["The token is stored as tenant metadata under the schema version (CTK-001).","A change is offered with a projection listing the content whose rendered text differs (CTK-006)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The expression fails to parse (the error carries its position), or refers to itself through other tokens (CTK-002, CTK-003).","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"remove-token","name":"Remove a content token","ref":"CT-217","realisation":"generated","implementedBy":"kernel","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["tokens-define"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"name","type":"string"}],"outputs":[],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"Stored content refers to the token; the referrers are named (CTK-004).","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"evaluate-token","name":"Evaluate a token for a reader","ref":"CT-218","realisation":"generated","implementedBy":"kernel","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"state","type":"state"},{"name":"name","type":"string"},{"name":"record","type":"record"},{"name":"context","type":"context"}],"outputs":[{"name":"value","type":"string"},{"name":"reads","type":"list<record-id>"}],"postconditions":["Two evaluations give equal values (CTK-008).","The token reads only fields the reader may read (CTK-010).","An empty or budget-exhausting evaluation renders the fallback text (CTK-011, CTK-012).","The result names the records the expression read (CTK-018)."],"errors":[],"exposure":"local","deployment":"target"},
    {"id":"define-mail-template","name":"Define a mail template","ref":"CT-219","realisation":"generated","implementedBy":"mail-dispatcher","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the operation","requires":["mail-configure"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"template","type":"template-id"},{"name":"subject","type":"string"},{"name":"body","type":"structured-blocks"}],"outputs":[{"name":"version","type":"u64"}],"postconditions":["The template is stored as tenant metadata (EML-012)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"A token in the template is undefined.","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"render-message","name":"Render a message for a recipient","ref":"CT-220","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"template","type":"template-id"},{"name":"recipient","type":"email-address"}],"outputs":[{"name":"html","type":"string"},{"name":"text","type":"string"}],"postconditions":["A message renders into an HTML part and a plain text part (EML-016).","Until the block schema and the token syntax are stated (WG-5177), a block that is a string, or an object with a string member text, renders as a paragraph of that text, any other block renders nothing, and a value of the send is placed where the subject or a paragraph writes {{name}}; tenant tokens are not evaluated yet (CTK-019).","Every paragraph is escaped in the HTML part, so neither a value nor the template places markup in a message (k-450).","A rendered subject that holds a carriage return, a line feed or a NUL byte is refused (EML-1566)."],"errors":[{"name":"invalid","condition":"The rendered subject holds a carriage return, a line feed or a NUL byte (EML-1566).","type":"api-error","kind":"invalid"}],"exposure":"local","deployment":"shipped"},
    {"id":"prove-sender-domain","name":"Prove a sender domain","ref":"CT-221","realisation":"generated","implementedBy":"mail-dispatcher","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["mail-configure"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"domain","type":"domain"}],"outputs":[{"name":"state","type":"domain-state"}],"postconditions":["Mail carries a sender address on a tenant domain only after its proof (EML-013).","Without proof, mail is sent from a platform address (EML-014)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"list-mail-messages","name":"List the mail log","ref":"CT-222","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["mail-read"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"cursor","type":"string","optional":true},{"name":"limit","type":"u32","optional":true,"description":"At most 100; 50 when absent."},{"name":"state","type":"message-state","optional":true},{"name":"category","type":"message-category-id","optional":true},{"name":"template","type":"template-id","optional":true},{"name":"reference","type":"send-reference","optional":true},{"name":"from","type":"timestamp","optional":true},{"name":"until","type":"timestamp","optional":true}],"outputs":[{"name":"messages","type":"list<mail-log-entry>"},{"name":"next","type":"string","optional":true}],"postconditions":["The log keeps state and recipient and never holds the body of a message (EML-011).","The log filters by state, category, template, reference and period, and each entry carries its category, template, send and reference (EML-1565).","Entries are listed newest first, and next is the cursor of the page after."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped","bffRoute":"GET /api/mail/messages"},
    {"id":"manage-suppression-list","name":"Add or remove a suppression","ref":"CT-223","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the operation","requires":["mail-configure"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"address","type":"email-address"},{"name":"action","type":"string","description":"add or remove."},{"name":"category","type":"string","optional":true,"description":"A category name, * or *promotional; * when absent (D-6562)."}],"outputs":[],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"shipped","postconditions":["The entry is for one category, for the whole address or for every promotional category (EML-1562); the whole address when no category is named.","Removing a bounce or complaint entry is the owner only; a recipient removes only an unsubscribe entry, by the link of change-subscription-by-link (EML-1562).","An entry the site adds has the reason unsubscribe; a link removes it only when its category is promotional or *promotional."],"bffRoute":"POST /api/mail/suppressions"},
    {"id":"create-release","name":"Create a release record","ref":"CT-224","realisation":"generated","implementedBy":"release-controller","auth":{"scheme":"service","description":"The release pipeline","requires":["release-build"]},"idempotent":true,"inputs":[{"name":"commit","type":"string"},{"name":"digests","type":"list<hash>"},{"name":"classification","type":"string"}],"outputs":[{"name":"release","type":"release-id"}],"postconditions":["The record names each configuration value and holds no secret value (REL-553).","It classifies the release as rollback-safe or roll-forward-only (REL-575)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"invalid","condition":"The commit has not passed the specification gate (REL-583).","type":"api-error","kind":"invalid"}],"exposure":"internal","deployment":"target","tenantScope":"platform"},
    {"id":"promote-release","name":"Promote a release","ref":"CT-225","realisation":"generated","implementedBy":"release-controller","auth":{"scheme":"session","roles":["release-approver"],"stepUp":"15 min","csrf":true,"origin":true,"description":"Two distinct approving principals, neither its author (REL-560)","requires":["release-promote"]},"idempotent":false,"inputs":[{"name":"release","type":"release-id"},{"name":"to","type":"environment-id"}],"outputs":[{"name":"state","type":"release-state"}],"postconditions":["The image that passes the gate in stage is the one that reaches production (REL-551).","The stage soak lasts at least 24 hours (REL-559)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"conflict","condition":"A gate of the promotion path has not passed, or a freeze window is in force (REL-557, REL-563).","type":"api-error","kind":"conflict"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"}],"exposure":"internal","deployment":"target","tenantScope":"platform"},
    {"id":"switch-colour","name":"Switch the live colour of a component","ref":"CT-226","realisation":"generated","implementedBy":"release-controller","auth":{"scheme":"session","roles":["release-engineer"],"csrf":true,"origin":true,"description":"A release engineer","requires":["release-switch"]},"idempotent":false,"timeoutMs":30000,"inputs":[{"name":"release","type":"release-id"},{"name":"component","type":"string"}],"outputs":[{"name":"live","type":"colour-id"}],"postconditions":["A colour switch first sends at most 5 percent of requests to the new colour for a period (REL-565).","It takes effect at the traffic switch within 30 seconds (REL-567)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"conflict","condition":"The release is not recorded as verified against the stage environment (REL-566).","type":"api-error","kind":"conflict"}],"exposure":"internal","deployment":"target","tenantScope":"platform"},
    {"id":"switch-back","name":"Switch back to the previous colour","ref":"CT-227","realisation":"generated","implementedBy":"release-controller","auth":{"scheme":"session","roles":["release-engineer"],"csrf":true,"origin":true,"description":"A release engineer","requires":["release-switch"]},"idempotent":true,"timeoutMs":30000,"inputs":[{"name":"component","type":"string"}],"outputs":[{"name":"live","type":"colour-id"}],"postconditions":["It deploys nothing (REL-568).","The traffic switch sends no public request to the withdrawn colour afterwards (REL-577)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"}],"exposure":"internal","deployment":"target","tenantScope":"platform"},
    {"id":"report-drift","name":"Report drift of an environment","ref":"CT-228","realisation":"generated","implementedBy":"release-controller","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the operation","requires":["release-drift-report"]},"idempotent":true,"inputs":[{"name":"environment","type":"environment-id"}],"outputs":[{"name":"differences","type":"list<string>"}],"postconditions":["Each difference between the definitions and the live environment is reported (REL-562)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"}],"exposure":"internal","deployment":"target","tenantScope":"platform"},
    {"id":"set-listener-rule","name":"Set the listener rule of a component","ref":"CT-229","realisation":"generated","implementedBy":"traffic-switch","auth":{"scheme":"service","description":"The release controller","requires":["listener-rule-set"]},"idempotent":true,"timeoutMs":30000,"inputs":[{"name":"component","type":"string"},{"name":"live","type":"colour-id"},{"name":"canary-share","type":"u8"}],"outputs":[],"postconditions":["A new colour takes no public traffic until its release record names it verified (REL-566).","The previous colour keeps running for at least 24 hours (REL-569)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"internal","deployment":"target","tenantScope":"platform"},
    {"id":"preview-migration","name":"Preview a migration run","ref":"CT-230","realisation":"generated","implementedBy":"migration-job","auth":{"scheme":"session","roles":["owner"],"description":"An owner of the tenant","requires":["migration-run"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"changes","type":"list<schema-change>"}],"outputs":[{"name":"plan","type":"migration-plan"}],"postconditions":["A change that removes a field or a constraint is marked irreversible (MIG-557)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"target"},
    {"id":"start-migration-run","name":"Start a migration run","ref":"CT-231","realisation":"generated","implementedBy":"migration-job","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["migration-run"]},"idempotent":false,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"preview","type":"hash"}],"outputs":[{"name":"run","type":"migration-id"}],"postconditions":["The run records the preview it was applied from, its batches and its outcome (MIG-556)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"conflict","condition":"The preview no longer matches the tenant.","type":"api-error","kind":"conflict"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"run-migration-batch","name":"Run one batch of a migration run","ref":"CT-232","realisation":"generated","implementedBy":"migration-job","auth":{"scheme":"service","description":"Service credential of a platform component","requires":["migration-batch"]},"idempotent":true,"timeoutMs":1000,"inputs":[{"name":"run","type":"migration-id"}],"outputs":[{"name":"cursor","type":"string"},{"name":"state","type":"migration-state"}],"postconditions":["A batch reads and writes records of its own tenant only (MIG-580).","A batch holds the writes of its tenant for no longer than 1 second at the 99th percentile (MIG-553).","A run that stops resumes from its last committed cursor, so each record is converted once (MIG-554).","A reader sees each record in its prior or migrated form and in no mixture (MIG-552)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"}],"exposure":"internal","deployment":"target","tenantScope":"platform"},
    {"id":"stop-migration-run","name":"Stop a migration run","ref":"CT-233","realisation":"generated","implementedBy":"migration-job","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["migration-run"]},"idempotent":true,"inputs":[{"name":"run","type":"migration-id"}],"outputs":[{"name":"cursor","type":"string"}],"postconditions":["The cursor is recorded and the tenant stays in a form that serves its readers (MIG-581, MIG-555)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"move-tenant","name":"Move a tenant to another placement","ref":"CT-234","realisation":"generated","implementedBy":"control-plane","auth":{"scheme":"session","roles":["platform-operator"],"csrf":true,"origin":true,"description":"A platform operator","requires":["tenant-move"]},"idempotent":false,"timeoutMs":60000,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"target","type":"placement-id"}],"outputs":[{"name":"move","type":"move-id"}],"postconditions":["The canonical hash of the state is preserved (TEN-012).","Writes are refused for no longer than 60 seconds at the 99th percentile (MIG-568).","The owner is told of the read-only window at least 48 hours ahead (MIG-569).","A move whose copy fails leaves the source serving and the directory unchanged (MIG-571)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"conflict","condition":"A move of this tenant is already running, or the tenant is not active.","type":"api-error","kind":"conflict"},{"name":"invalid","condition":"The target is in a region other than the primary region of the tenant (TEN-1239).","type":"api-error","kind":"invalid"}],"exposure":"internal","deployment":"target","preconditions":["The tenant is active, and the target is in the primary region of the tenant (TEN-1239)."],"tenantScope":"platform"},
    {"id":"switch-placement","name":"Switch a tenant to its target placement","ref":"CT-235","realisation":"generated","implementedBy":"control-plane","auth":{"scheme":"service","description":"Service credential of a platform component","requires":["tenant-move"]},"idempotent":true,"inputs":[{"name":"move","type":"move-id"}],"outputs":[{"name":"placement","type":"placement-id"}],"postconditions":["A request that began before the switch completes on the source (MIG-586).","Stored and edge copies stay valid (MIG-587).","After the switch the backups and files are those of the target (MIG-588).","The source database is kept for at least 7 days (MIG-572)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"conflict","condition":"The target state does not match the source hash (MIG-570).","type":"api-error","kind":"conflict"}],"exposure":"internal","deployment":"target","tenantScope":"platform"},
    {"id":"install-bundle","name":"Install a tenant bundle","ref":"CT-236","realisation":"generated","implementedBy":"substrate","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["bundle-install"],"stepUp":"15 min"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"bundle","type":"tenant-bundle"},{"name":"dry-run","type":"bool","optional":true,"description":"Return the projection and change nothing (INT-154)."},{"name":"idempotency-key","type":"string","optional":true,"description":"A repeat with the same key and the same input returns the stored result and changes nothing; the same key with other input is refused with idempotency-mismatch (D-6595)."}],"outputs":[{"name":"schema-version","type":"u64"},{"name":"projection","type":"projection-summary","optional":true}],"postconditions":["Installing the same bundles into an empty store produces the same state (RUN-004).","The bundle installs as tenant metadata through kernel intents (CMS-001).","Every section of the bundle installs in one product change, applied together or not at all, and every entity it creates is owned by the product (INT-1581, INT-1582).","Installing a bundle of the same product and version again changes nothing and returns the schema version of the first install (INT-1583)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid-bundle","condition":"The bundle is malformed, holds executable code or a theme value outside the token schema (CMS-005, INT-155), fills a section the kernel has no intent for yet (capabilities, segments, settings, ledger units, ledger pools or ledger limits), or has an automation that sends a template that neither the bundle nor the tenant declares; the error names each (INT-1921).","kind":"invalid"},{"name":"install-refused","condition":"A kernel intent of the installation was refused.","type":"domain-error","kind":"invalid"},{"name":"invalid","condition":"The platform release is outside the platform range the bundle declares, or an id of the bundle is not in the namespace of its product (INT-1582, INT-1583).","type":"api-error","kind":"invalid"},{"name":"conflict","condition":"An entity with an id of the bundle exists and is not owned by this product, or a different version of this product is installed (use upgrade-bundle).","type":"api-error","kind":"conflict"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"shipped","description":"Installs the bundle of a product into the tenant of the session: one change-schema intent carries the entities of the bundle and the ownership record of the product, so both are one commit under one schema version. A dry run returns the projection (the entities created and the lines the kernel describes the change with) and changes nothing; a repeat of the same product and version, or of the same idempotency key, changes nothing. Served by crates/backend/src/products.rs (POST /internal/products/install) and the gateway route of crates/bff/src/routes.rs.","bffRoute":"POST /api/products/install"},
    {"id":"parse-bundle","name":"Parse a bundle document","ref":"CT-237","realisation":"generated","implementedBy":"substrate","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"document","type":"string"}],"outputs":[{"name":"bundle","type":"tenant-bundle"}],"errors":[{"name":"invalid-bundle","condition":"The document is not a valid bundle.","kind":"invalid"}],"exposure":"local","deployment":"shipped"},
    {"id":"propose-template-upgrade","name":"Offer a newer template version","ref":"CT-238","realisation":"generated","implementedBy":"substrate","auth":{"scheme":"session","roles":["platform-operator"],"csrf":true,"origin":true,"description":"A platform operator","requires":["template-upgrade-offer"]},"idempotent":false,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"template","type":"template-id"},{"name":"version","type":"string"}],"outputs":[{"name":"proposal","type":"proposal-id"}],"postconditions":["The upgrade reaches a tenant only as a proposal carrying its projection that the tenant approves (MIG-564)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"}],"exposure":"internal","deployment":"target","tenantScope":"platform"},
    {"id":"hash-password","name":"Hash a password","ref":"H-001","realisation":"hand","milestone":1,"implementedBy":"identity-service","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":false,"inputs":[{"name":"password","type":"secret"}],"outputs":[{"name":"hash","type":"hash"}],"postconditions":["The result is an Argon2id hash in PHC string form with a salt drawn for this password (IDN-002).","Two hashes of one password differ."],"errors":[{"name":"unavailable","condition":"The operating system supplies no randomness.","type":"api-error","kind":"unavailable"},{"name":"internal","condition":"The hashing function fails.","type":"api-error","kind":"internal"}],"exposure":"local","deployment":"target"},
    {"id":"verify-password","name":"Verify a password against its hash","ref":"H-002","realisation":"hand","milestone":1,"implementedBy":"identity-service","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"password","type":"secret"},{"name":"stored","type":"hash"}],"outputs":[{"name":"matches","type":"bool"}],"postconditions":["The result is true exactly when the password hashes to the stored value.","A stored value that is not a valid hash gives false, not an error."],"errors":[],"exposure":"local","deployment":"target"},
    {"id":"draw-random-secret","name":"Draw a random secret","ref":"H-003","realisation":"hand","milestone":1,"implementedBy":"identity-service","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":false,"inputs":[{"name":"bytes","type":"u32"}],"outputs":[{"name":"secret","type":"secret"}],"postconditions":["The result is lower-case hex of the requested number of bytes drawn from the operating system source of randomness.","A secret drawn for one challenge opens no other challenge (IDN-254)."],"errors":[{"name":"unavailable","condition":"The operating system supplies no randomness.","type":"api-error","kind":"unavailable"}],"exposure":"local","deployment":"target"},
    {"id":"issue-request-token","name":"Issue a request token","ref":"H-004","realisation":"hand","milestone":1,"implementedBy":"gateway","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":false,"inputs":[{"name":"site","type":"string"},{"name":"now","type":"timestamp"}],"outputs":[{"name":"token","type":"secret"}],"postconditions":["The token carries its expiry, a nonce and a message authentication code over the site, bound to a key held only by the issuing process.","The token is good for its lifetime and for the site it was issued for, and for nothing else (GWY-257)."],"errors":[],"exposure":"local","deployment":"shipped"},
    {"id":"check-request-token","name":"Check a request token","ref":"H-005","realisation":"hand","milestone":1,"implementedBy":"gateway","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"site","type":"string"},{"name":"token","type":"secret"},{"name":"now","type":"timestamp"}],"outputs":[{"name":"valid","type":"bool"}],"postconditions":["The result is true exactly when this process issued the token for this site and it has not expired.","The code is compared without stopping at the first difference.","A malformed token gives false."],"errors":[],"exposure":"local","deployment":"shipped"},
    {"id":"set-session-cookie","name":"Build the session cookie header","ref":"H-006","realisation":"hand","milestone":1,"implementedBy":"gateway","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"token","type":"secret"},{"name":"max-age","type":"i64"}],"outputs":[{"name":"header","type":"string"}],"postconditions":["The cookie carries the host-name prefix, Secure, HttpOnly and SameSite=Strict, and no Domain attribute (IDN-261, IDN-262, GWY-003).","An empty token with a max age of zero ends the cookie."],"errors":[],"exposure":"local","deployment":"shipped"},
    {"id":"call-internal-service","name":"Call an internal service over HTTP","ref":"H-007","realisation":"hand","milestone":1,"implementedBy":"gateway","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":false,"inputs":[{"name":"path","type":"string"},{"name":"body","type":"value-map"},{"name":"site","type":"tenant-id"},{"name":"correlation","type":"correlation-id"},{"name":"session","type":"secret","optional":true}],"outputs":[{"name":"reply","type":"value-map"}],"postconditions":["The call carries the service credential, the site and the correlation identifier (SEC-004, OBS-001).","A failure to reach the service is logged with the correlation identifier and shown to the browser as unavailable."],"errors":[{"name":"unavailable","condition":"The service did not answer or its answer could not be read.","type":"api-error","kind":"unavailable"},{"name":"service-error","condition":"The service answered with an error reply, which is passed on.","type":"api-error","kind":"unavailable"}],"exposure":"local","deployment":"shipped"},
    {"id":"open-sqlite-store","name":"Open the SQLite store","ref":"H-008","realisation":"hand","milestone":1,"implementedBy":"sqlite-adapter","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"path","type":"string"},{"name":"now","type":"timestamp"}],"outputs":[{"name":"store","type":"store-handle"}],"postconditions":["The returned store passes every check of the storage conformance table (STO-002).","Data acknowledged by a commit is readable after the file is reopened (STO-003).","The layout of the file is brought up to date on open.","Every value of a query is bound as data (CMS-254)."],"errors":[{"name":"unavailable","condition":"The database file cannot be opened.","type":"store-error","kind":"unavailable"},{"name":"corrupt","condition":"The layout in the file cannot be read.","type":"store-error","kind":"internal"}],"exposure":"local","deployment":"shipped"},
    {"id":"parse-markdown","name":"Parse constrained Markdown","ref":"H-009","realisation":"hand","milestone":1,"implementedBy":"substrate","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"source","type":"string"}],"outputs":[{"name":"blocks","type":"structured-blocks"}],"postconditions":["Tenant-authored rich text becomes structured blocks with markup left as text (CMS-004).","A link carries only the web and mail schemes (CMS-250).","Equal sources give equal blocks."],"errors":[],"exposure":"local","deployment":"shipped"},
    {"id":"hash-bytes","name":"Hash bytes canonically","ref":"H-010","realisation":"hand","milestone":1,"implementedBy":"kernel","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"bytes","type":"bytes"}],"outputs":[{"name":"hash","type":"hash"}],"postconditions":["The result is the lower-case hex SHA-256 digest of the bytes.","Canonical state, delta and event hashes are this function over their canonical JSON form."],"errors":[],"exposure":"local","deployment":"shipped"},
    {"id":"terminate-tls","name":"Terminate TLS","ref":"H-011","realisation":"hand","milestone":6,"implementedBy":"gateway","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"connection","type":"bytes"}],"outputs":[{"name":"stream","type":"bytes"}],"postconditions":["Only the protocol versions of TLS that the platform policy lists are negotiated (THR-251).","The certificate presented is the one for the host name asked for."],"errors":[{"name":"handshake-failed","condition":"No allowed protocol version or certificate matches.","type":"api-error","kind":"unauthenticated"}],"exposure":"local","deployment":"target"},
    {"id":"render-page","name":"Render a page to HTML","ref":"H-012","realisation":"hand","milestone":2,"implementedBy":"web-application","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"view","type":"view-data"}],"outputs":[{"name":"page","type":"html-page"}],"postconditions":["Each value reflected into the page is escaped for the place where it appears (GWY-255).","The page carries no inline script and declares the hash or nonce of each script it allows (GWY-005, GWY-250).","Equal view data gives an equal page."],"errors":[],"exposure":"local","deployment":"target"},
    {"id":"sign-access-token","name":"Sign an access token","ref":"H-013","realisation":"hand","milestone":4,"implementedBy":"identity-service","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":false,"inputs":[{"name":"claims","type":"value-map"},{"name":"key","type":"key-id"}],"outputs":[{"name":"token","type":"secret"}],"postconditions":["The token verifies with the published public key that carries the key identifier (TOK-008).","It is valid for at most 5 minutes (TOK-005)."],"errors":[],"exposure":"local","deployment":"target"},
    {"id":"verify-access-token","name":"Verify an access token","ref":"H-014","realisation":"hand","milestone":4,"implementedBy":"identity-service","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"token","type":"secret"},{"name":"audience","type":"string"},{"name":"now","type":"timestamp"}],"outputs":[{"name":"claims","type":"value-map"}],"postconditions":["A token whose audience names another client is refused (TOK-250).","A token issued for one tenant is refused by every other (TOK-006).","A token signed by a retired key is refused (TOK-251)."],"errors":[{"name":"invalid","condition":"The signature, audience, tenant or expiry is wrong.","type":"api-error","kind":"invalid"}],"exposure":"local","deployment":"target"},
    {"id":"verify-identity-token","name":"Verify an OpenID Connect identity token","ref":"H-015","realisation":"hand","milestone":4,"implementedBy":"identity-service","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"token","type":"secret"},{"name":"provider","type":"provider-id"},{"name":"nonce","type":"secret"},{"name":"now","type":"timestamp"}],"outputs":[{"name":"subject","type":"external-subject"},{"name":"email","type":"email-address","optional":true},{"name":"email-verified","type":"bool"}],"postconditions":["Only the signature method that the provider configuration names is accepted (FED-255).","A signing key of one provider verifies the tokens of that provider only (FED-256)."],"errors":[{"name":"invalid","condition":"The issuer, audience, signature or nonce fails verification.","type":"api-error","kind":"invalid"}],"exposure":"local","deployment":"target"},
    {"id":"verify-saml-assertion","name":"Verify a SAML assertion","ref":"H-016","realisation":"hand","milestone":4,"implementedBy":"identity-service","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"response","type":"bytes"},{"name":"provider","type":"provider-id"}],"outputs":[{"name":"subject","type":"external-subject"},{"name":"attributes","type":"value-map"}],"postconditions":["The subject and attributes come only from the assertion whose signature covers them (FED-252). The response holds exactly one assertion, a direct child of the response, with a signature of its own whose one reference is that assertion's identifier and resolves to that very element; a signed response around an unsigned assertion, a second assertion, an assertion moved elsewhere, a signature over another element and an assertion changed after it was signed are refused.","The signature is checked by an XML-DSig implementation that is maintained and not written here, with the certificates of the provider's configuration only: a key or certificate that the message brings is never used, duplicate identifiers are refused and every reference digest is computed here (FED-005).","The message is read with external entity and document type processing off (FED-251), at a bounded size, and an encrypted assertion, which this service cannot read, is refused and not taken for a signed one.","The subject is the complete text of the name identifier, comments excluded (FED-253); an identifier that holds an element, a second identifier, an empty one or one past 255 bytes is refused.","The issuer, on the assertion and on the response where it names one, is the entity identifier of the provider's configuration (FED-254).","The audience of every audience restriction names this service's entity identifier at the host the sign-in started at, and the recipient of a bearer confirmation and the destination of the response, where it names one, are this host's assertion consumer address (FED-008). A condition this service does not understand is not met.","The assertion is inside its validity with a skew that the configuration names (60 seconds by default): its conditions and its confirmation have an end, it is not valid before its beginning and it was not issued in the future.","The response reports success, and its assertion answers the request that was made (FED-007)."],"errors":[{"name":"invalid","condition":"The signature, issuer, audience, recipient, destination, time or request is wrong, or the message is not one that is read.","type":"api-error","kind":"invalid"}],"exposure":"local","deployment":"target"},
    {"id":"verify-passkey-assertion","name":"Verify a passkey assertion","ref":"H-017","realisation":"hand","milestone":3,"implementedBy":"identity-service","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"assertion","type":"bytes"},{"name":"challenge","type":"challenge-id"},{"name":"host","type":"host"}],"outputs":[{"name":"credential","type":"credential-id"}],"postconditions":["The assertion carries a challenge issued for this sign-in and bound to the address of the request (IDN-264).","The relying party is the address of the tenant (IDN-007).","A challenge answers once and lapses (IDN-264).","An assertion whose signature counter does not go forward is refused and audited, and the credential is not used again until the person has removed it (case passkey-counter-regress).","A credential is used at the address it was registered for, by the person it names."],"errors":[{"name":"invalid","condition":"The signature, challenge or relying party is wrong.","type":"api-error","kind":"invalid"}],"exposure":"local","deployment":"target"},
    {"id":"verify-one-time-code","name":"Verify a time-based one-time code","ref":"H-018","realisation":"hand","milestone":3,"implementedBy":"identity-service","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"code","type":"secret"},{"name":"credential","type":"credential-id"},{"name":"now","type":"timestamp"}],"outputs":[{"name":"matches","type":"bool"}],"postconditions":["The result is true exactly when the code is the one the secret of the credential gives for the time window of now."],"errors":[],"exposure":"local","deployment":"target"},
    {"id":"seal-field","name":"Encrypt under a data key","ref":"H-019","realisation":"hand","milestone":3,"implementedBy":"key-service","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":false,"inputs":[{"name":"plaintext","type":"bytes"},{"name":"key","type":"key-id"}],"outputs":[{"name":"sealed","type":"bytes"}],"postconditions":["The result opens only with the same key and fails to open if changed.","A personal field stored sealed under the key of its principal is unreadable once that key is destroyed (PRV-358)."],"errors":[{"name":"key-destroyed","condition":"The key was destroyed.","type":"store-error","kind":"not_found"}],"exposure":"local","deployment":"target"},
    {"id":"open-field","name":"Decrypt under a data key","ref":"H-020","realisation":"hand","milestone":3,"implementedBy":"key-service","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"sealed","type":"bytes"},{"name":"key","type":"key-id"}],"outputs":[{"name":"plaintext","type":"bytes"}],"postconditions":["Opening what seal-field produced under the same key returns the original bytes."],"errors":[{"name":"key-destroyed","condition":"The key was destroyed.","type":"store-error","kind":"not_found"},{"name":"tampered","condition":"The sealed bytes fail authentication.","type":"store-error","kind":"internal"}],"exposure":"local","deployment":"target"},
    {"id":"sign-webhook-body","name":"Sign an outbound webhook body","ref":"H-021","realisation":"hand","milestone":5,"implementedBy":"connector-runner","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"body","type":"bytes"},{"name":"secret","type":"secret"},{"name":"timestamp","type":"timestamp"}],"outputs":[{"name":"signature","type":"bytes"}],"postconditions":["The signature is HMAC-SHA256 over the event identifier, the timestamp and the body made with the secret of the subscription (WFL-010, WFL-255, INT-2640)."],"errors":[],"exposure":"local","deployment":"shipped"},
    {"id":"verify-webhook-signature","name":"Verify an inbound webhook signature","ref":"H-022","realisation":"hand","milestone":5,"implementedBy":"runtime","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"body","type":"bytes"},{"name":"signature","type":"bytes"},{"name":"secret","type":"secret"}],"outputs":[{"name":"valid","type":"bool"}],"postconditions":["The result is true exactly when the signature matches the secret of the endpoint (INT-150).","The comparison does not stop at the first difference."],"errors":[],"exposure":"local","deployment":"shipped"},
    {"id":"send-through-mail-provider","name":"Hand a message to the mail provider","ref":"H-023","realisation":"hand","milestone":3,"implementedBy":"mail-dispatcher","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"message","type":"bytes"},{"name":"idempotency-key","type":"string"}],"outputs":[{"name":"accepted","type":"bool"}],"postconditions":["The provider is the one the deployment is configured for, with no change to a component (EML-002).","The credential of the provider is read from the key service at the time of sending (EML-004)."],"errors":[{"name":"temporary-refusal","condition":"The provider refused for a temporary reason.","kind":"unavailable"},{"name":"permanent-refusal","condition":"The provider refused for a permanent reason.","kind":"invalid"}],"exposure":"local","deployment":"target"},
    {"id":"sign-mail-dkim","name":"Sign a message with DKIM","ref":"H-024","realisation":"hand","milestone":5,"implementedBy":"mail-dispatcher","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"message","type":"bytes"},{"name":"domain","type":"domain"}],"outputs":[{"name":"signed","type":"bytes"}],"postconditions":["A message from a tenant domain is signed with a key published under that domain (EML-015)."],"errors":[],"exposure":"local","deployment":"target"},
    {"id":"open-postgres-store","name":"Open the PostgreSQL store","ref":"H-025","realisation":"hand","milestone":2,"implementedBy":"postgres-adapter","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"placement","type":"placement-id"},{"name":"tenant","type":"tenant-id"}],"outputs":[{"name":"store","type":"store-handle"}],"postconditions":["The store passes every check of the storage conformance table (STO-004).","It opens a tenant database using only the placement the directory returns for the tenant (STO-005).","The connections held for one tenant stay within its quota (STO-006)."],"errors":[{"name":"unavailable","condition":"The database cannot be reached.","type":"store-error","kind":"unavailable"}],"exposure":"local","deployment":"target"},
    {"id":"judge-outbound-address","name":"Resolve and judge an outbound address","ref":"H-026","realisation":"hand","milestone":4,"implementedBy":"outbound-gate","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"target","type":"url"}],"outputs":[{"name":"address","type":"ip-address"}],"postconditions":["The address is judged in its canonical numeric form, including mapped and encoded forms (WFL-252).","A private, link-local or loopback network is refused (WFL-008)."],"errors":[{"name":"refused","condition":"The address is not allowed by the outbound rule.","kind":"forbidden"}],"exposure":"local","deployment":"shipped"},
    {"id":"perform-outbound-http","name":"Perform an outbound HTTP call","ref":"H-027","realisation":"hand","milestone":4,"implementedBy":"outbound-gate","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":false,"inputs":[{"name":"address","type":"ip-address"},{"name":"request","type":"bytes"},{"name":"max-bytes","type":"u64"}],"outputs":[{"name":"response","type":"bytes"}],"postconditions":["The call connects only to the address that was judged (WFL-250).","A redirect is followed only to an address the rule allows (WFL-251).","The call ends when the response exceeds the size limit (WFL-253)."],"errors":[{"name":"too-large","condition":"The response exceeds the size the connector policy names.","kind":"invalid"},{"name":"unreachable","condition":"The address did not answer.","kind":"unavailable"}],"exposure":"local","deployment":"shipped"},
    {"id":"scan-content","name":"Scan the content of an upload","ref":"H-028","realisation":"hand","milestone":11,"implementedBy":"upload-scanner","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"content","type":"bytes"}],"outputs":[{"name":"clean","type":"bool"},{"name":"media-type","type":"string"}],"postconditions":["The media type is confirmed from the content and not only from the declared type (CMS-261).","A file is reported clean only if the scanner found nothing."],"errors":[],"exposure":"local","deployment":"target"},
    {"id":"produce-rendition","name":"Produce a rendition of a file","ref":"H-029","realisation":"hand","milestone":11,"implementedBy":"upload-scanner","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"content","type":"bytes"},{"name":"rendition","type":"string"}],"outputs":[{"name":"result","type":"bytes"}],"postconditions":["The rendition is produced by a process with no connector secret and no network access (CMS-262)."],"errors":[{"name":"too-large","condition":"The decompressed size exceeds the limit of the plan (CMS-263).","kind":"invalid"}],"exposure":"local","deployment":"target"},
    {"id":"issue-domain-certificate","name":"Issue a certificate for a tenant domain","ref":"H-030","realisation":"hand","milestone":6,"implementedBy":"delivery-network-control","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"host","type":"host"}],"outputs":[{"name":"certificate-state","type":"certificate-state"}],"postconditions":["The certificate is renewed before it expires (EDG-010)."],"errors":[{"name":"refused","condition":"The certificate authority record of the domain does not permit issuing (EDG-254).","kind":"forbidden"}],"exposure":"local","deployment":"target"},
    {"id":"read-front-page","name":"Read the front page view","ref":"CT-239","realisation":"facade","bffRoute":"GET /api/view view","auth":{"scheme":"anonymous","description":"Anyone; no session is needed","requires":["content-read"]},"idempotent":true,"timeoutMs":10000,"inputs":[],"outputs":[{"name":"view","type":"string"},{"name":"title","type":"string"},{"name":"path","type":"string"},{"name":"params","type":"json"},{"name":"data","type":"front-page-data"},{"name":"depends-on","type":"list<string>"},{"name":"revision","type":"state-revision"},{"name":"schema-version","type":"schema-version"},{"name":"theme","type":"view-theme"}],"postconditions":["The view is the one the tenant's view definition for this page names (CMS-002); it holds the publication, the featured article, the recent articles and the topics.","The outputs are the members of the view model the BFF answers as JSON, under the names it uses: view (the view definition), title, path (the address asked for), params, data (the sections of the view, each a row or a list of rows, as the type of data says), depends_on (the object types whose changes alter the view), revision, schema_version and theme."],"errors":[{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped"},
    {"id":"read-article-page","name":"Read the view of one article","ref":"CT-240","realisation":"facade","bffRoute":"GET /api/view view","auth":{"scheme":"anonymous","description":"Anyone; no session is needed","requires":["content-read"]},"idempotent":true,"timeoutMs":10000,"inputs":[{"name":"slug","type":"string"}],"outputs":[{"name":"view","type":"string"},{"name":"title","type":"string"},{"name":"path","type":"string"},{"name":"params","type":"json"},{"name":"data","type":"article-page-data"},{"name":"depends-on","type":"list<string>"},{"name":"revision","type":"state-revision"},{"name":"schema-version","type":"schema-version"},{"name":"theme","type":"view-theme"}],"postconditions":["The view is the one the tenant's view definition for this page names (CMS-002); it holds the article with this address and the recent articles.","A draft is invisible to principals whose policies permit published content alone (CMS-003).","The outputs are the members of the view model the BFF answers as JSON, under the names it uses: view (the view definition), title, path (the address asked for), params, data (the sections of the view, each a row or a list of rows, as the type of data says), depends_on (the object types whose changes alter the view), revision, schema_version and theme."],"errors":[{"name":"not-found","condition":"The page or the record it names does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped","conformanceExample":"{\"slug\": \"slow-software\"}"},
    {"id":"read-topics-page","name":"Read the view of the topic index","ref":"CT-241","realisation":"facade","bffRoute":"GET /api/view view","auth":{"scheme":"anonymous","description":"Anyone; no session is needed","requires":["content-read"]},"idempotent":true,"timeoutMs":10000,"inputs":[],"outputs":[{"name":"view","type":"string"},{"name":"title","type":"string"},{"name":"path","type":"string"},{"name":"params","type":"json"},{"name":"data","type":"topics-page-data"},{"name":"depends-on","type":"list<string>"},{"name":"revision","type":"state-revision"},{"name":"schema-version","type":"schema-version"},{"name":"theme","type":"view-theme"}],"postconditions":["The view is the one the tenant's view definition for this page names (CMS-002); it holds every topic and the recent articles, from which the page counts the articles of each topic.","The outputs are the members of the view model the BFF answers as JSON, under the names it uses: view (the view definition), title, path (the address asked for), params, data (the sections of the view, each a row or a list of rows, as the type of data says), depends_on (the object types whose changes alter the view), revision, schema_version and theme."],"errors":[{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped"},
    {"id":"read-topic-page","name":"Read the view of one topic","ref":"CT-242","realisation":"facade","bffRoute":"GET /api/view view","auth":{"scheme":"anonymous","description":"Anyone; no session is needed","requires":["content-read"]},"idempotent":true,"timeoutMs":10000,"inputs":[{"name":"slug","type":"string"}],"outputs":[{"name":"view","type":"string"},{"name":"title","type":"string"},{"name":"path","type":"string"},{"name":"params","type":"json"},{"name":"data","type":"topic-page-data"},{"name":"depends-on","type":"list<string>"},{"name":"revision","type":"state-revision"},{"name":"schema-version","type":"schema-version"},{"name":"theme","type":"view-theme"}],"postconditions":["The view is the one the tenant's view definition for this page names (CMS-002); it holds the topic with this address, its published articles and every topic.","The outputs are the members of the view model the BFF answers as JSON, under the names it uses: view (the view definition), title, path (the address asked for), params, data (the sections of the view, each a row or a list of rows, as the type of data says), depends_on (the object types whose changes alter the view), revision, schema_version and theme."],"errors":[{"name":"not-found","condition":"The page or the record it names does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped","conformanceExample":"{\"slug\": \"craft\"}"},
    {"id":"read-authors-page","name":"Read the view of the author index","ref":"CT-243","realisation":"facade","bffRoute":"GET /api/view view","auth":{"scheme":"anonymous","description":"Anyone; no session is needed","requires":["content-read"]},"idempotent":true,"timeoutMs":10000,"inputs":[],"outputs":[{"name":"view","type":"string"},{"name":"title","type":"string"},{"name":"path","type":"string"},{"name":"params","type":"json"},{"name":"data","type":"authors-page-data"},{"name":"depends-on","type":"list<string>"},{"name":"revision","type":"state-revision"},{"name":"schema-version","type":"schema-version"},{"name":"theme","type":"view-theme"}],"postconditions":["The view is the one the tenant's view definition for this page names (CMS-002); it holds every author.","The outputs are the members of the view model the BFF answers as JSON, under the names it uses: view (the view definition), title, path (the address asked for), params, data (the sections of the view, each a row or a list of rows, as the type of data says), depends_on (the object types whose changes alter the view), revision, schema_version and theme."],"errors":[{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped"},
    {"id":"read-author-page","name":"Read the view of one author","ref":"CT-244","realisation":"facade","bffRoute":"GET /api/view view","auth":{"scheme":"anonymous","description":"Anyone; no session is needed","requires":["content-read"]},"idempotent":true,"timeoutMs":10000,"inputs":[{"name":"slug","type":"string"}],"outputs":[{"name":"view","type":"string"},{"name":"title","type":"string"},{"name":"path","type":"string"},{"name":"params","type":"json"},{"name":"data","type":"author-page-data"},{"name":"depends-on","type":"list<string>"},{"name":"revision","type":"state-revision"},{"name":"schema-version","type":"schema-version"},{"name":"theme","type":"view-theme"}],"postconditions":["The view is the one the tenant's view definition for this page names (CMS-002); it holds the author with this address and the author's published articles.","The outputs are the members of the view model the BFF answers as JSON, under the names it uses: view (the view definition), title, path (the address asked for), params, data (the sections of the view, each a row or a list of rows, as the type of data says), depends_on (the object types whose changes alter the view), revision, schema_version and theme."],"errors":[{"name":"not-found","condition":"The page or the record it names does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped","conformanceExample":"{\"slug\": \"ines-okafor\"}"},
    {"id":"read-search-page","name":"Read the view of the search results","ref":"CT-245","realisation":"facade","bffRoute":"GET /api/view view","auth":{"scheme":"anonymous","description":"Anyone; no session is needed","requires":["content-read"]},"idempotent":true,"timeoutMs":10000,"inputs":[{"name":"q","type":"string","optional":true}],"outputs":[{"name":"view","type":"string"},{"name":"title","type":"string"},{"name":"path","type":"string"},{"name":"params","type":"json"},{"name":"data","type":"search-page-data"},{"name":"depends-on","type":"list<string>"},{"name":"revision","type":"state-revision"},{"name":"schema-version","type":"schema-version"},{"name":"theme","type":"view-theme"},{"name":"q","type":"string"}],"postconditions":["The view is the one the tenant's view definition for this page names (CMS-002); it holds the published articles whose title, excerpt or text contain the query, when the query has at least two characters.","The output q repeats the query, so that a search form can address the results page.","The outputs are the members of the view model the BFF answers as JSON, under the names it uses: view (the view definition), title, path (the address asked for), params, data (the sections of the view, each a row or a list of rows, as the type of data says), depends_on (the object types whose changes alter the view), revision, schema_version and theme."],"errors":[{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped"},
    {"id":"read-about-page","name":"Read the view of the about page","ref":"CT-246","realisation":"facade","bffRoute":"GET /api/view view","auth":{"scheme":"anonymous","description":"Anyone; no session is needed","requires":["content-read"]},"idempotent":true,"timeoutMs":10000,"inputs":[],"outputs":[{"name":"view","type":"string"},{"name":"title","type":"string"},{"name":"path","type":"string"},{"name":"params","type":"json"},{"name":"data","type":"about-page-data"},{"name":"depends-on","type":"list<string>"},{"name":"revision","type":"state-revision"},{"name":"schema-version","type":"schema-version"},{"name":"theme","type":"view-theme"}],"postconditions":["The view is the one the tenant's view definition for this page names (CMS-002); it holds the publication with its about and colophon text, and every author.","The outputs are the members of the view model the BFF answers as JSON, under the names it uses: view (the view definition), title, path (the address asked for), params, data (the sections of the view, each a row or a list of rows, as the type of data says), depends_on (the object types whose changes alter the view), revision, schema_version and theme."],"errors":[{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped"},
    {"id":"read-missing-page","name":"Read the view of an address no page answers","ref":"CT-247","realisation":"facade","bffRoute":"GET /api/view view","auth":{"scheme":"anonymous","description":"Anyone; no session is needed","requires":["content-read"]},"idempotent":true,"timeoutMs":10000,"inputs":[{"name":"missing","type":"string"}],"outputs":[{"name":"path","type":"string"}],"postconditions":["No page of the tenant answers this address: the answer is not-found, and the web application shows the page \"There is nothing at this address\" for the path it asked for."],"errors":[{"name":"not-found","condition":"The page or the record it names does not exist for this tenant.","type":"api-error","kind":"not_found"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped"},
    {"id":"read-sign-in-view","name":"Read the view of the sign-in page","ref":"CT-248","realisation":"facade","bffRoute":"GET /api/view view","auth":{"scheme":"anonymous","description":"Anyone; no session is needed","requires":["identity-sign-in"]},"idempotent":true,"timeoutMs":10000,"inputs":[{"name":"next","type":"string","optional":true}],"outputs":[{"name":"view","type":"string"},{"name":"title","type":"string"},{"name":"path","type":"string"},{"name":"params","type":"json"},{"name":"data","type":"site-page-data"},{"name":"depends-on","type":"list<string>"},{"name":"revision","type":"state-revision"},{"name":"schema-version","type":"schema-version"},{"name":"theme","type":"view-theme"}],"postconditions":["The view is the one the tenant's view definition for this page names (CMS-002); it holds the publication.","The query parameter next names the address to open after signing in; the web application follows it only when it starts with one \"/\" (it refuses \"//\").","The outputs are the members of the view model the BFF answers as JSON, under the names it uses: view (the view definition), title, path (the address asked for), params, data (the sections of the view, each a row or a list of rows, as the type of data says), depends_on (the object types whose changes alter the view), revision, schema_version and theme."],"errors":[{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped"},
    {"id":"read-desk-view","name":"Read the view of the writing desk","ref":"CT-249","realisation":"facade","bffRoute":"GET /api/view view","auth":{"scheme":"session","tenantPolicies":true,"description":"A signed-in principal whose policies permit the operation","requires":["content-draft-read"]},"idempotent":true,"timeoutMs":10000,"inputs":[],"outputs":[{"name":"view","type":"string"},{"name":"title","type":"string"},{"name":"path","type":"string"},{"name":"params","type":"json"},{"name":"data","type":"desk-page-data"},{"name":"depends-on","type":"list<string>"},{"name":"revision","type":"state-revision"},{"name":"schema-version","type":"schema-version"},{"name":"theme","type":"view-theme"},{"name":"articles","type":"list<desk-article>"}],"postconditions":["The view holds the publication and the articles the principal wrote, or every article for an editor or the owner (CMS-003).","The output articles lists the articles of the view, each with its identifier, its version, its title, its address, its text and its status, so that a change made from the list names the version it started from.","The outputs are the members of the view model the BFF answers as JSON, under the names it uses: view (the view definition), title, path (the address asked for), params, data (the sections of the view, each a row or a list of rows, as the type of data says), depends_on (the object types whose changes alter the view), revision, schema_version and theme."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped"},
    {"id":"read-new-article-view","name":"Read the view for a new article","ref":"CT-250","realisation":"facade","bffRoute":"GET /api/view view","auth":{"scheme":"session","tenantPolicies":true,"description":"A signed-in principal whose policies permit the operation","requires":["content-draft-read"]},"idempotent":true,"timeoutMs":10000,"inputs":[{"name":"rules","type":"string","optional":true,"description":"The object types, separated by commas and at most 8, whose rules the editor asks for; the page asks for post. A signed-in reader only (CMS-2960)."}],"outputs":[{"name":"view","type":"string"},{"name":"title","type":"string"},{"name":"path","type":"string"},{"name":"params","type":"json"},{"name":"data","type":"new-article-page-data"},{"name":"depends-on","type":"list<string>"},{"name":"revision","type":"state-revision"},{"name":"schema-version","type":"schema-version"},{"name":"theme","type":"view-theme"},{"name":"topics","type":"list<option-choice>"},{"name":"authors","type":"list<option-choice>"},{"name":"record-rules","type":"map<string, editor-record-rules>","optional":true,"description":"For each object type named in rules, what the kernel will check on a record of it, for this reader: the readable fields with their shapes, the size limits, the constraints with their rule text and message, and the workflow transitions out of the current state with their guards. Absent when rules is absent or the reader is anonymous. The page parses each rule with the tenant rule language module, checks it against the shapes and evaluates it on the form before sending, and shows the message of a constraint that does not hold; the server refuses the same record with the same constraint (CMS-2960)."}],"postconditions":["The view holds the publication, every topic and every author.","The outputs are the members of the view model the BFF answers as JSON, under the names it uses: view (the view definition), title, path (the address asked for), params, data (the sections of the view, each a row or a list of rows, as the type of data says), depends_on (the object types whose changes alter the view), revision, schema_version and theme.","The outputs topics and authors list the choices of the topic and author controls: one entry per topic (its identifier as text, its name), led by an entry with an empty value and the label \"No topic\", and one per author (its identifier as text, its name). The BFF builds them from the data of the same view, as it projects the desk's articles.","The output record-rules is a member of the view model beside data, not a section of it; it is decided by the kernel with the redaction a read makes, so it carries nothing about a field the reader may not read, and a constraint or guard that reads such a field or follows a reference is left to the server (backend ops.rs view, kernel editor_rules.rs)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped"},
    {"id":"read-edit-article-view","name":"Read the view for editing an article","ref":"CT-251","realisation":"facade","bffRoute":"GET /api/view view","auth":{"scheme":"session","tenantPolicies":true,"description":"A signed-in principal whose policies permit the operation","requires":["content-draft-read"]},"idempotent":true,"timeoutMs":10000,"inputs":[{"name":"slug","type":"string"},{"name":"rules","type":"string","optional":true,"description":"The object types, separated by commas and at most 8, whose rules the editor asks for; the page asks for post. A signed-in reader only (CMS-2960)."}],"outputs":[{"name":"view","type":"string"},{"name":"title","type":"string"},{"name":"path","type":"string"},{"name":"params","type":"json"},{"name":"data","type":"edit-article-page-data"},{"name":"depends-on","type":"list<string>"},{"name":"revision","type":"state-revision"},{"name":"schema-version","type":"schema-version"},{"name":"theme","type":"view-theme"},{"name":"article-id","type":"record-id"},{"name":"article-version","type":"u64"},{"name":"topics","type":"list<option-choice>"},{"name":"authors","type":"list<option-choice>"},{"name":"record-rules","type":"map<string, editor-record-rules>","optional":true,"description":"For each object type named in rules, what the kernel will check on a record of it, for this reader: the readable fields with their shapes, the size limits, the constraints with their rule text and message, and the workflow transitions out of the current state with their guards. Absent when rules is absent or the reader is anonymous. The page parses each rule with the tenant rule language module, checks it against the shapes and evaluates it on the form before sending, and shows the message of a constraint that does not hold; the server refuses the same record with the same constraint (CMS-2960)."}],"postconditions":["The view holds the publication, the article with this address, every topic and every author.","The outputs article-id and article-version repeat the identifier and the version of the article held in the view, so that a save names the version it started from.","The outputs are the members of the view model the BFF answers as JSON, under the names it uses: view (the view definition), title, path (the address asked for), params, data (the sections of the view, each a row or a list of rows, as the type of data says), depends_on (the object types whose changes alter the view), revision, schema_version and theme.","The outputs topics and authors list the choices of the topic and author controls, as for a new article. The BFF builds them from the data of the same view.","The output record-rules is a member of the view model beside data, not a section of it; it is decided by the kernel with the redaction a read makes, so it carries nothing about a field the reader may not read, and a constraint or guard that reads such a field or follows a reference is left to the server (backend ops.rs view, kernel editor_rules.rs)."],"errors":[{"name":"not-found","condition":"The page or the record it names does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped","conformanceExample":"{\"slug\": \"slow-software\"}"},
    {"id":"read-settings-view","name":"Read the view of the publication settings","ref":"CT-252","realisation":"facade","bffRoute":"GET /api/view view","auth":{"scheme":"session","tenantPolicies":true,"description":"A signed-in principal whose policies permit the operation","requires":["site-configure"]},"idempotent":true,"timeoutMs":10000,"inputs":[],"outputs":[{"name":"view","type":"string"},{"name":"title","type":"string"},{"name":"path","type":"string"},{"name":"params","type":"json"},{"name":"data","type":"site-page-data"},{"name":"depends-on","type":"list<string>"},{"name":"revision","type":"state-revision"},{"name":"schema-version","type":"schema-version"},{"name":"theme","type":"view-theme"},{"name":"publication-id","type":"record-id"},{"name":"publication-version","type":"u64"},{"name":"accents","type":"list<string>"},{"name":"papers","type":"list<string>"}],"postconditions":["The view holds the publication record.","The outputs publication-id and publication-version repeat the identifier and the version of the publication record held in the view, so that a save names the version it started from.","The outputs are the members of the view model the BFF answers as JSON, under the names it uses: view (the view definition), title, path (the address asked for), params, data (the sections of the view, each a row or a list of rows, as the type of data says), depends_on (the object types whose changes alter the view), revision, schema_version and theme.","The outputs accents and papers list the names a swatch can take (the accent tokens moss, clay, ink, ochre and plum; the paper tokens linen, stone and chalk). The BFF puts them in the view model from the theme schema."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped"},
    {"id":"read-lab-view","name":"Read the view of the impact lab","ref":"CT-253","realisation":"facade","bffRoute":"GET /api/view view","auth":{"scheme":"session","tenantPolicies":true,"description":"A signed-in principal whose policies permit the operation","requires":["content-draft-read"]},"idempotent":true,"timeoutMs":10000,"inputs":[],"outputs":[{"name":"view","type":"string"},{"name":"title","type":"string"},{"name":"path","type":"string"},{"name":"params","type":"json"},{"name":"data","type":"site-page-data"},{"name":"depends-on","type":"list<string>"},{"name":"revision","type":"state-revision"},{"name":"schema-version","type":"schema-version"},{"name":"theme","type":"view-theme"}],"postconditions":["The view holds the publication. The page itself is drawn only for a principal who may manage the schema.","The outputs are the members of the view model the BFF answers as JSON, under the names it uses: view (the view definition), title, path (the address asked for), params, data (the sections of the view, each a row or a list of rows, as the type of data says), depends_on (the object types whose changes alter the view), revision, schema_version and theme."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped"},
    {"id":"sign-in-at-site","name":"Sign in from the site","ref":"CT-254","realisation":"generated","implementedBy":"gateway","bffRoute":"POST /api/login","auth":{"scheme":"anonymous","csrf":true,"origin":true,"justification":"Signing in is how a visitor gets a session.","description":"Anyone; no session is needed","requires":["identity-sign-in"]},"idempotent":false,"timeoutMs":2000,"inputs":[{"name":"login","type":"string"},{"name":"password","type":"string"}],"outputs":[{"name":"session","type":"session-view"}],"preconditions":["The request carries the request token that the gateway issued to the browser (GWY-257)."],"postconditions":["It signs in through sign-in-with-password and answers the session as the browser may see it; the secret token travels only in the session cookie."],"errors":[{"name":"unauthenticated","condition":"The credentials do not match, the account does not exist or the factor is missing; the response does not say which (IDN-255, UXA-202).","type":"api-error","kind":"unauthenticated"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","tenantScope":"request","deployment":"shipped","conformanceExample":"{\"login\": \"ines\", \"password\": \"strata-dev-ines\"}","description":"A contract of the gateway itself, not a facade (D-8140). It signs in through sign-in-with-password (CT-051) and sets the session cookie. The route is not the address of a generic served contract that a client could lower it onto: the gateway holds the session cookie and the request token, so it answers the route with a contract of its own, and a facade needs exactly one other served contract that states the same bffRoute (contract.facade-route)."},
    {"id":"sign-out-of-site","name":"Sign out from the site","ref":"CT-255","realisation":"generated","implementedBy":"gateway","bffRoute":"POST /api/logout","auth":{"scheme":"session","csrf":true,"origin":true,"description":"A signed-in principal","requires":["session-manage"]},"idempotent":true,"timeoutMs":2000,"inputs":[],"outputs":[{"name":"session","type":"session-view"}],"preconditions":["The request carries the request token of the session (GWY-257)."],"postconditions":["The session named by the cookie is revoked through sign-out, and the answer is the session of an anonymous visitor."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"}],"exposure":"public","tenantScope":"request","deployment":"shipped","description":"A contract of the gateway itself, not a facade (D-8140). It revokes the session through sign-out (CT-058) and clears the session cookie. The route is not the address of a generic served contract that a client could lower it onto: the gateway holds the session cookie and the request token, so it answers the route with a contract of its own, and a facade needs exactly one other served contract that states the same bffRoute (contract.facade-route)."},
    {"id":"read-session-view","name":"Read the session of the visit","ref":"CT-256","realisation":"generated","implementedBy":"gateway","bffRoute":"GET /api/session","auth":{"scheme":"anonymous","description":"Anyone; no session is needed","requires":["identity-sign-in"]},"idempotent":true,"timeoutMs":2000,"inputs":[],"outputs":[{"name":"session","type":"session-view"}],"postconditions":["The answer is the session the cookie names as the browser may see it, with the request token while it is signed in, or the session of an anonymous visitor."],"errors":[{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped","description":"A contract of the gateway itself, not a facade (D-8140). It reads the session the cookie names. The route is not the address of a generic served contract that a client could lower it onto: the gateway holds the session cookie and the request token, so it answers the route with a contract of its own, and a facade needs exactly one other served contract that states the same bffRoute (contract.facade-route)."},
    {
      "id": "create-article",
      "name": "Create an article",
      "ref": "CT-257",
      "realisation": "facade",
      "bffRoute": "POST /api/records records create post",
      "auth": {
        "scheme": "session",
        "tenantPolicies": true,
        "csrf": true,
        "origin": true,
        "description": "A signed-in principal whose policies permit the operation",
        "requires": [
          "content-write"
        ]
      },
      "idempotent": false,
      "timeoutMs": 10000,
      "inputs": [
        {
          "name": "title",
          "type": "string",
          "encode": {
            "trim": true
          }
        },
        {
          "name": "slug",
          "type": "string",
          "encode": {
            "trim": true
          }
        },
        {
          "name": "excerpt",
          "type": "string",
          "optional": true,
          "encode": {
            "trim": true,
            "empty": "omit"
          }
        },
        {
          "name": "body",
          "type": "string"
        },
        {
          "name": "category",
          "type": "string",
          "optional": true,
          "encode": {
            "as": "number",
            "empty": "omit"
          }
        },
        {
          "name": "author",
          "type": "string",
          "optional": true,
          "encode": {
            "as": "number",
            "empty": "omit"
          }
        },
        {
          "name": "tags",
          "type": "string",
          "optional": true,
          "encode": {
            "split": ",",
            "empty": "omit"
          }
        },
        {
          "name": "cover",
          "type": "string",
          "optional": true,
          "encode": {
            "empty": "omit"
          }
        },
        {
          "name": "cover-alt",
          "type": "string",
          "optional": true,
          "encode": {
            "trim": true,
            "empty": "omit"
          }
        },
        {
          "name": "featured",
          "type": "bool",
          "optional": true,
          "encode": {
            "empty": "omit"
          }
        },
        {
          "name": "status",
          "type": "string",
          "optional": true
        }
      ],
      "outputs": [
        {
          "name": "article-id",
          "type": "record-id"
        },
        {
          "name": "version",
          "type": "u64"
        },
        {
          "name": "slug",
          "type": "string"
        }
      ],
      "preconditions": [
        "The request carries the request token of the session (GWY-002)."
      ],
      "postconditions": [
        "The article is created as a draft whatever status is asked (CMS-154); a status of published is applied as a second step that the post workflow allows, so that a refusal of publishing leaves the draft saved.",
        "The input category and author hold a record identifier as text, or are empty; tags are separated by commas; an empty optional input leaves the field unset.",
        "The output slug repeats the address that was saved."
      ],
      "errors": [
        {
          "name": "unauthenticated",
          "condition": "No valid session or credential accompanies the request.",
          "type": "api-error",
          "kind": "unauthenticated"
        },
        {
          "name": "forbidden",
          "condition": "The caller holds no permission for the operation.",
          "type": "api-error",
          "kind": "forbidden"
        },
        {
          "name": "invalid",
          "condition": "A field fails a check of the tenant schema; the failed checks name the field.",
          "type": "api-error",
          "kind": "invalid"
        },
        {
          "name": "throttled",
          "condition": "The caller exceeded a limit that applies to it.",
          "type": "api-error",
          "kind": "throttled"
        },
        {
          "name": "unavailable",
          "condition": "A dependency of the operation did not answer.",
          "type": "api-error",
          "kind": "unavailable"
        }
      ],
      "exposure": "public",
      "tenantScope": "request",
      "deployment": "shipped"
    },
    {
      "id": "update-article",
      "name": "Update an article",
      "ref": "CT-258",
      "realisation": "facade",
      "bffRoute": "POST /api/records records update post",
      "auth": {
        "scheme": "session",
        "tenantPolicies": true,
        "csrf": true,
        "origin": true,
        "description": "A signed-in principal whose policies permit the operation",
        "requires": [
          "content-write"
        ]
      },
      "idempotent": false,
      "timeoutMs": 10000,
      "inputs": [
        {
          "name": "article",
          "type": "record-id"
        },
        {
          "name": "expected-version",
          "type": "u64"
        },
        {
          "name": "title",
          "type": "string",
          "encode": {
            "trim": true
          }
        },
        {
          "name": "slug",
          "type": "string",
          "encode": {
            "trim": true
          }
        },
        {
          "name": "excerpt",
          "type": "string",
          "optional": true,
          "encode": {
            "trim": true,
            "empty": "null"
          }
        },
        {
          "name": "body",
          "type": "string"
        },
        {
          "name": "category",
          "type": "string",
          "optional": true,
          "encode": {
            "as": "number",
            "empty": "null"
          }
        },
        {
          "name": "author",
          "type": "string",
          "optional": true,
          "encode": {
            "as": "number",
            "empty": "null"
          }
        },
        {
          "name": "tags",
          "type": "string",
          "optional": true,
          "encode": {
            "split": ",",
            "empty": "null"
          }
        },
        {
          "name": "cover",
          "type": "string",
          "optional": true,
          "encode": {
            "empty": "null"
          }
        },
        {
          "name": "cover-alt",
          "type": "string",
          "optional": true,
          "encode": {
            "trim": true,
            "empty": "null"
          }
        },
        {
          "name": "featured",
          "type": "bool",
          "optional": true,
          "encode": {
            "empty": "null"
          }
        },
        {
          "name": "status",
          "type": "string",
          "optional": true
        }
      ],
      "outputs": [
        {
          "name": "article-id",
          "type": "record-id"
        },
        {
          "name": "version",
          "type": "u64"
        },
        {
          "name": "slug",
          "type": "string"
        }
      ],
      "preconditions": [
        "The request carries the request token of the session (GWY-002)."
      ],
      "postconditions": [
        "The change is applied only when expected-version is the stored version of the article; otherwise it is refused with conflict.",
        "A status of published or draft moves the article through the post workflow in the same request.",
        "The output slug repeats the address that was saved."
      ],
      "errors": [
        {
          "name": "unauthenticated",
          "condition": "No valid session or credential accompanies the request.",
          "type": "api-error",
          "kind": "unauthenticated"
        },
        {
          "name": "forbidden",
          "condition": "The caller holds no permission for the operation.",
          "type": "api-error",
          "kind": "forbidden"
        },
        {
          "name": "invalid",
          "condition": "A field fails a check of the tenant schema; the failed checks name the field.",
          "type": "api-error",
          "kind": "invalid"
        },
        {
          "name": "throttled",
          "condition": "The caller exceeded a limit that applies to it.",
          "type": "api-error",
          "kind": "throttled"
        },
        {
          "name": "unavailable",
          "condition": "A dependency of the operation did not answer.",
          "type": "api-error",
          "kind": "unavailable"
        },
        {
          "name": "conflict",
          "condition": "The record was changed since the version the caller saw; the current version is named.",
          "type": "api-error",
          "kind": "conflict"
        }
      ],
      "exposure": "public",
      "tenantScope": "request",
      "deployment": "shipped"
    },
    {"id":"delete-article","name":"Delete an article","ref":"CT-259","realisation":"facade","bffRoute":"POST /api/records records delete post","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A signed-in principal whose policies permit the operation","requires":["content-delete"]},"idempotent":false,"timeoutMs":10000,"inputs":[{"name":"article","type":"record-id"},{"name":"expected-version","type":"u64"}],"outputs":[],"preconditions":["The request carries the request token of the session (GWY-002)."],"postconditions":["The article is removed only when expected-version is its stored version; otherwise the delete is refused with conflict."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"conflict","condition":"The record was changed since the version the caller saw; the current version is named.","type":"api-error","kind":"conflict"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","tenantScope":"request","deployment":"shipped"},
    {
      "id": "save-site-settings",
      "name": "Save the publication settings",
      "ref": "CT-260",
      "realisation": "facade",
      "bffRoute": "POST /api/records records update publication",
      "auth": {
        "scheme": "session",
        "tenantPolicies": true,
        "csrf": true,
        "origin": true,
        "description": "A signed-in principal whose policies permit the operation",
        "requires": [
          "site-configure"
        ]
      },
      "idempotent": false,
      "timeoutMs": 10000,
      "inputs": [
        {
          "name": "publication",
          "type": "record-id"
        },
        {
          "name": "expected-version",
          "type": "u64"
        },
        {
          "name": "name",
          "type": "string",
          "encode": {
            "trim": true
          }
        },
        {
          "name": "tagline",
          "type": "string",
          "optional": true,
          "encode": {
            "trim": true,
            "empty": "null"
          }
        },
        {
          "name": "accent",
          "type": "string"
        },
        {
          "name": "paper",
          "type": "string"
        }
      ],
      "outputs": [
        {
          "name": "version",
          "type": "u64"
        }
      ],
      "preconditions": [
        "The request carries the request token of the session (GWY-002)."
      ],
      "postconditions": [
        "The change is applied only when expected-version is the stored version of the publication record; otherwise it is refused with conflict.",
        "Every open page of the tenant refreshes from the committed change."
      ],
      "errors": [
        {
          "name": "unauthenticated",
          "condition": "No valid session or credential accompanies the request.",
          "type": "api-error",
          "kind": "unauthenticated"
        },
        {
          "name": "forbidden",
          "condition": "The caller holds no permission for the operation.",
          "type": "api-error",
          "kind": "forbidden"
        },
        {
          "name": "invalid",
          "condition": "A field fails a check of the tenant schema; the failed checks name the field.",
          "type": "api-error",
          "kind": "invalid"
        },
        {
          "name": "throttled",
          "condition": "The caller exceeded a limit that applies to it.",
          "type": "api-error",
          "kind": "throttled"
        },
        {
          "name": "unavailable",
          "condition": "A dependency of the operation did not answer.",
          "type": "api-error",
          "kind": "unavailable"
        },
        {
          "name": "conflict",
          "condition": "The record was changed since the version the caller saw; the current version is named.",
          "type": "api-error",
          "kind": "conflict"
        }
      ],
      "exposure": "public",
      "tenantScope": "request",
      "deployment": "shipped"
    },
    {"id":"preview-markdown","name":"Preview constrained Markdown","ref":"CT-261","realisation":"generated","implementedBy":"gateway","bffRoute":"POST /api/preview","auth":{"scheme":"session","tenantPolicies":true,"origin":true,"description":"A signed-in principal whose policies permit the operation","requires":["content-draft-read"]},"idempotent":true,"timeoutMs":2000,"inputs":[{"name":"markdown","type":"string"}],"outputs":[{"name":"blocks","type":"json"}],"preconditions":["The request carries an allowed origin."],"postconditions":["The blocks are a pure function of the text through parse-markdown; nothing is stored."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped"},
    {"id":"load-decision-snapshot","name":"Load a snapshot with the path and time parts functions cannot compute yet","ref":"H-054","realisation":"hand","implementedBy":"store-contract","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"needs","type":"list<need>"},{"name":"intent","type":"intent","optional":true},{"name":"mutation","type":"mutation","optional":true},{"name":"path","type":"string","optional":true}],"outputs":[{"name":"state","type":"state"},{"name":"segments","type":"list<string>"},{"name":"routes","type":"map<view-id, list<route-segment>>"},{"name":"times","type":"map<string, i64>"}],"postconditions":["state is what load-tenant (CT-012) gives for the tenant and the needs.","segments is the path split at / without empty segments; routes is the route of each view of the schema so split, a segment :name read as the parameter name; times holds each string of the mutation's fields that substrate plain.rs parse_time accepts, with its milliseconds.","The hole holds the string splitting and the date parsing the derivations do not do in functions yet; the printing of expressions is print of the tenant rule language in the functions (WG-4966). When the rest is computed in functions, the derivations load through load-tenant and this hole goes."],"errors":[{"name":"unavailable","condition":"The store could not do the work right now (busy, I/O); safe to retry.","type":"store-error","kind":"unavailable"},{"name":"corrupt","condition":"Stored data could not be read back; not safe to ignore.","type":"store-error","kind":"internal"}],"exposure":"local","deployment":"shipped"},
    {"id":"commit-accepted","name":"Commit an accepted intent","ref":"CT-262","realisation":"generated","implementedBy":"store-contract","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":false,"timeoutMs":300,"inputs":[{"name":"context","type":"context"},{"name":"accepted","type":"accepted-intent"}],"outputs":[{"name":"receipt","type":"receipt"}],"preconditions":["The base revision of the transition's delta is the revision the tenant is stored at, or the tenant is absent and the base is none."],"postconditions":["Commits storage-api Commit::of(intent, context, transition) as commit-transition (CT-014) does: the delta, the events, the journal entry (with the kernel version and the hashes of the delta and the events) and the session revocations of the transition's RevokeSessions effects, all or none."],"errors":[{"name":"conflict","condition":"The stored revision of the tenant differs from the base revision of the delta; nothing is changed.","type":"store-error","kind":"conflict"},{"name":"invalid","condition":"The commit is malformed, or its events do not continue the tenant event sequence without a gap; nothing is changed.","type":"store-error","kind":"invalid"},{"name":"unavailable","condition":"The store could not do the work right now (busy, I/O); safe to retry.","type":"store-error","kind":"unavailable"},{"name":"corrupt","condition":"Stored data could not be read back; not safe to ignore.","type":"store-error","kind":"internal"}],"exposure":"local","deployment":"shipped"},
    {"id":"mutate-record","name":"Change a record of the tenant","ref":"CT-263","realisation":"derived","implementedBy":"runtime","bffRoute":"POST /api/records records","derivation":{"kind":"command","needs":"header-needs","load":"load-decision-snapshot","decide":"decide-mutation","commit":"commit-accepted","conflict":"conflict","insufficient":"insufficient-state","needRounds":32,"retries":8,"fault":"fault"},"auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"requires":["content-write","self-record-write"],"description":"A principal whose policies permit the change; either capability suffices, and self-record-write reaches only the records its description names (D-6591); anonymous callers carry the request token (GWY-002)"},"idempotent":false,"timeoutMs":10000,"inputs":[{"name":"tenant","type":"tenant-id","description":"The tenant the host name serves, the context's."},{"name":"context","type":"context","description":"The caller's context, which the route builds from the session and the request (backend auth.rs Identity::context), not from the body."},{"name":"mutation","type":"mutation"}],"outputs":[{"name":"reply","type":"mutation-reply","optional":true,"description":"Present for every accepted mutation: each one creates, changes or deletes a record."}],"postconditions":["The generic records endpoint (backend ops.rs mutate): the mutation's fields are coerced by field type, the intent is decided by the kernel against what it needs and committed atomically, as execute-intent does, and the reply names the record, its new version (none after a delete), the revision, the event sequence and the checks passed.","Every publication write (create-article, update-article, delete-article, save-site-settings) is a facade lowered onto it."],"errors":[{"name":"refused","condition":"The request was refused; the body is the error reply, whose code says why: not_found for no site or no object type, invalid for a field that does not coerce, and for a kernel rejection error-code-of of its kind (a refused change to a record the caller cannot read answers as unknown-record).","type":"api-error","kind":"invalid"},{"name":"insufficient-state","condition":"The decision asked for more needs than needRounds allows, or for one it was already given.","type":"need","kind":"internal"},{"name":"conflict","condition":"Every commit lost its race to another one, retries times over; nothing is changed.","type":"store-error","kind":"conflict"},{"name":"invalid","condition":"The commit is malformed, or its events do not continue the tenant event sequence without a gap; nothing is changed.","type":"store-error","kind":"invalid"},{"name":"unavailable","condition":"The store could not do the work right now (busy, I/O); safe to retry.","type":"store-error","kind":"unavailable"},{"name":"corrupt","condition":"Stored data could not be read back; not safe to ignore.","type":"store-error","kind":"internal"},{"name":"fault","condition":"An integer overflow in the decision (a revision, an event sequence, a version or a record id past its type); never in practice.","kind":"internal"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"shipped"},
    {"id":"read-view","name":"Read a view of the tenant","ref":"CT-264","realisation":"derived","implementedBy":"runtime","bffRoute":"GET /api/view view","derivation":{"kind":"read","needs":"header-needs","load":"load-decision-snapshot","decide":"assemble-view","insufficient":"insufficient-state","needRounds":32,"fault":"fault"},"auth":{"scheme":"anonymous","justification":"Published views are for visitors; a session only widens what its policies let it read.","requires":["content-read"],"description":"Anyone; a session widens what its policies let it read"},"idempotent":true,"timeoutMs":10000,"inputs":[{"name":"tenant","type":"tenant-id","description":"The tenant the host name serves, the context's."},{"name":"context","type":"context","description":"The caller's context, which the route builds from the session and the request (backend auth.rs Identity::context), not from the body."},{"name":"path","type":"string"},{"name":"request","type":"map<string, string>"}],"outputs":[{"name":"view","type":"view-data"}],"postconditions":["The generic view endpoint (backend ops.rs view): the view whose route matches the path, every section read from one snapshot through the kernel's read authorization, the rows and included records without another principal's authorship.","The browser receives the view projected (project-view) by the BFF, which adds the path and, until WG-4942, the publication template's theme and desk fields.","Every publication page read (read-front-page to read-lab-view) is a facade lowered onto it."],"errors":[{"name":"refused","condition":"The request was refused; the body is the error reply, whose code says why: not_found for no site or no object type, invalid for a field that does not coerce, and for a kernel rejection error-code-of of its kind (a refused change to a record the caller cannot read answers as unknown-record).","type":"api-error","kind":"invalid"},{"name":"insufficient-state","condition":"The decision asked for more needs than needRounds allows, or for one it was already given.","type":"need","kind":"internal"},{"name":"unavailable","condition":"The store could not do the work right now (busy, I/O); safe to retry.","type":"store-error","kind":"unavailable"},{"name":"corrupt","condition":"Stored data could not be read back; not safe to ignore.","type":"store-error","kind":"internal"},{"name":"fault","condition":"An integer overflow in the route match (a revision, an event sequence, a version or a record id past its type); never in practice.","kind":"internal"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","readOnly":true,"deployment":"shipped"},
    {"id":"issue-passkey-challenge","name":"Issue a passkey challenge","ref":"H-031","realisation":"hand","milestone":3,"implementedBy":"identity-service","auth":{"scheme":"anonymous","csrf":true,"origin":true,"justification":"A sign-in challenge is asked for before any session exists; a registration challenge additionally needs the session.","requires":["identity-sign-in"],"description":"Anyone for a sign-in, a signed-in principal for a registration"},"idempotent":false,"inputs":[],"outputs":[{"name":"challenge","type":"challenge-id"},{"name":"options","type":"bytes"}],"postconditions":["The challenge is kept by the identity service with the address it was requested at and, for a registration, the session that asked; it answers once and lapses (IDN-264).","A request that does not come from a host name, an address that WebAuthn can bind a passkey to, is refused."],"errors":[{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"},{"name":"invalid","condition":"The site is not reached by a host name.","type":"api-error","kind":"invalid"},{"name":"unauthenticated","condition":"A registration was asked for without a valid session.","type":"api-error","kind":"unauthenticated"}],"exposure":"public","tenantScope":"request","bffRoute":"POST /api/passkeys/challenge","deployment":"target"},
    {"id":"list-passkeys","name":"List the passkeys of the caller","ref":"H-032","realisation":"hand","milestone":3,"implementedBy":"identity-service","auth":{"scheme":"session","requires":["account-manage"],"description":"A signed-in principal"},"idempotent":true,"inputs":[],"outputs":[{"name":"credentials","type":"list<credential-id>"}],"postconditions":["Only the passkeys of the caller in this tenant are listed, with their names and times; no key material is."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"}],"exposure":"public","tenantScope":"request","readOnly":true,"bffRoute":"GET /api/passkeys","deployment":"target"},
    {"id":"remove-passkey","name":"Remove a passkey","ref":"H-033","realisation":"hand","milestone":3,"implementedBy":"identity-service","auth":{"scheme":"session","csrf":true,"origin":true,"stepUp":"15 min","requires":["account-manage"],"description":"A signed-in principal"},"idempotent":true,"inputs":[{"name":"credential","type":"credential-id"}],"outputs":[],"postconditions":["The credential signs no one in from then on."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"not-found","condition":"The caller has no such passkey in this tenant.","type":"api-error","kind":"not_found"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","bffRoute":"POST /api/passkeys/remove","deployment":"target"},
    {"id":"deliver-sign-in-mail","name":"Deliver a sign-in message through the mail transport","ref":"H-034","realisation":"hand","milestone":3,"implementedBy":"identity-service","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":false,"inputs":[{"name":"to","type":"email-address"},{"name":"subject","type":"string"},{"name":"text","type":"string"}],"outputs":[],"postconditions":["The message goes to the mail transport, which is an SMTP server only when the operator configured one; otherwise it is the development sink, which keeps the message and sends nothing, so that no development or test run reaches a real address.","A transport that talks to a server delivers off the caller's thread and logs a delivery that fails, so that how long the call takes and whether it fails say nothing about whether the address has an account (IDN-006).","The message carries the sign-in link, whose token is in the fragment of its address (D-703) and whose challenge holds the principal and no email address (PRV-365)."],"errors":[{"name":"unavailable","condition":"The transport did not accept the message.","type":"api-error","kind":"unavailable"}],"exposure":"local","deployment":"target"},
    {"id":"check-return-address","name":"Check a return address","ref":"H-035","realisation":"hand","milestone":3,"implementedBy":"identity-service","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"next","type":"string"}],"outputs":[{"name":"path","type":"string","optional":true}],"postconditions":["The result is the address itself when it is a path on the host of the tenant: it starts with one slash, names no other host, holds no backslash and no control character, and is not longer than 512 bytes (FED-250).","Any other address gives no result, and the person lands on the default page instead of being sent on.","A sign-in link carries a return address only when this check passes, and the page that the link opens checks it again before it navigates."],"errors":[],"exposure":"local","deployment":"target"},
    {"id":"configure-identity-providers","name":"Configure the identity providers of a tenant","ref":"H-036","realisation":"hand","milestone":4,"implementedBy":"identity-service","auth":{"scheme":"in-process","roles":["platform-operator"],"description":"Platform operator, through the platform configuration file and the process environment"},"idempotent":true,"inputs":[{"name":"tenant","type":"string"},{"name":"provider","type":"provider-id"}],"outputs":[],"postconditions":["A tenant's identity providers are platform configuration and not tenant data: one file that the operator names (STRATA_OIDC_CONFIG) maps each tenant to its providers. A tenant's own people cannot change who is let in by a provider, and the operator, who holds the client secret, can.","A provider names an identifier of 1 to 32 lower-case letters, digits and hyphens, a label for the sign-in page, its issuer and client identifier, the signature methods its tokens may use (RS256, ES256 and EdDSA, and never none or a shared-secret method, FED-255), the email domains it decides for, whether a first sign-in creates a principal (FED-011) and the one default role that principal receives (FED-258).","The client secret is never in the file: the file names an environment variable that holds it. The secret is read when the process starts, kept in a value that does not print, sent only to the provider's token endpoint and written to no log, audit entry or reply. A name that is not set stops the process from starting.","A provider that is not enabled is offered on no sign-in page, cannot be started, accepts no callback and binds none of its domains (FED-011).","The sign-in page offers the enabled providers of the realm of the address it is served at, and no other realm's (FED-010).","Provider metadata and keys are held per provider of a tenant and never shared between providers (FED-256)."],"errors":[{"name":"invalid","condition":"The file does not parse, names a signature method that is not allowed, a provider twice, or an environment variable that is not set.","type":"api-error","kind":"invalid"}],"exposure":"local","deployment":"target"},
    {"id":"redeem-oidc-code","name":"Redeem an authorization code and check the identity token","ref":"H-037","realisation":"hand","milestone":4,"implementedBy":"identity-service","auth":{"scheme":"in-process","description":"Local call inside the platform process; the client secret goes to the provider's token endpoint only"},"idempotent":false,"inputs":[{"name":"state","type":"secret"},{"name":"code","type":"secret"},{"name":"binding","type":"secret"}],"outputs":[{"name":"subject","type":"external-subject"}],"postconditions":["A pending request holds the nonce, the proof-key verifier and the hash of the nonce kept in the starting browser's cookie, found by the hash of its state value. It is taken out of the store in the step that reads it, so a callback answers once, and it is accepted only through its lifetime, from the browser that started it and at the address it started at (FED-001).","The authorization request carries a state value, a nonce and the S256 challenge of a verifier, and the redirect address is the callback path of the host of the tenant (FED-002). The code is redeemed with that verifier.","Metadata that names another issuer than the one configured is not used, and neither is an address that is not HTTPS (HTTP is allowed in development only). A fetch follows no redirect, times out and reads a bounded answer.","The identity token is checked as verify-identity-token states, with the keys of that provider: algorithm allowlist, issuer, audience, authorised party, expiry and issue time with a skew of 60 seconds, subject and nonce (FED-003, FED-255).","A token that names a key that is not held makes the provider's keys be fetched once more and is checked again; a key that is still not there is a refusal, and a second fetch is not made within 30 seconds of the last, so that made-up key names cannot make this process fetch without end (FED-004).","A provider that does not answer refuses its own callbacks and its own starts, and leaves every other way in the realm has usable (FED-013).","Every refusal says the same to the person, whatever failed; the reason is in the log and holds no token, code, state or address."],"errors":[{"name":"unauthenticated","condition":"The state matches no pending request of this browser, the code does not redeem, or the token fails a check.","type":"api-error","kind":"unauthenticated"},{"name":"unavailable","condition":"The provider's metadata cannot be fetched when a sign-in starts.","type":"api-error","kind":"unavailable"}],"exposure":"local","deployment":"target"},
    {"id":"refuse-bound-domain-sign-in","name":"Refuse password and emailed-link sign-in in a provider-bound domain","ref":"H-038","realisation":"hand","milestone":4,"implementedBy":"identity-service","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"address","type":"email-address"}],"outputs":[{"name":"bound","type":"bool"}],"postconditions":["An address is in a bound domain when its part after the last @, in lower case, is one of the domains of an enabled provider of the realm, of either protocol (FED-009). A provider that is not enabled binds nothing, so that disabling it is how a realm lifts the binding.","A password for such an address is refused as a wrong password is, after the same work, so that neither the answer nor its time says that the domain is bound (IDN-255).","A request for an emailed link for such an address is answered as one for an address with no account is, and no message is sent (IDN-006).","A login with no @ is in no bound domain."],"errors":[],"exposure":"local","deployment":"target"},
    {"id":"resolve-federated-identity","name":"Decide whose account a verified identity is","ref":"H-039","realisation":"hand","milestone":4,"implementedBy":"identity-service","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":false,"inputs":[{"name":"provider","type":"provider-id"},{"name":"subject","type":"external-subject"},{"name":"email","type":"email-address","optional":true},{"name":"email-verified","type":"bool"}],"outputs":[{"name":"principal","type":"string"}],"postconditions":["An identity is a provider of the realm and the provider's subject identifier. It is tied to one principal, once; a subject of one provider is never another provider's (FED-256).","A known identity signs its principal in. A first sign-in never takes the account of another person: an identity is linked to an existing principal only after that principal has signed in and asked to link, and the callback of that request answers only to the session that asked (FED-012).","Where the realm decided to trust a provider that far, and only then, an address that the provider marks as verified links to the account whose login is that address. An address that is not marked verified links to nothing. By default no address links to anything (FED-257).","A first sign-in creates a principal only when the realm enabled creation (FED-011). A realm that restricted the provider to domains lets in only a verified address in one of them.","The principal created has a login that no password opens, holds the one default role that the realm names and no other, and its name is made from the realm, the provider and the subject, so that two first sign-ins that arrive together make one (FED-258).","A principal created and an identity linked are audit entries; the entry names the principal and the provider, and no address.","The same decision serves every protocol: a provider of the realm is an OpenID Connect or a SAML provider, a principal's name and login are made from the protocol as well as the realm, the provider and the subject, and the audit entries of a created principal and a linked identity name the protocol."],"errors":[{"name":"unauthenticated","condition":"The realm does not admit the identity.","type":"api-error","kind":"unauthenticated"}],"exposure":"local","deployment":"target"},
    {"id":"configure-saml-providers","name":"Configure the SAML providers of a tenant","ref":"H-050","realisation":"hand","milestone":4,"implementedBy":"identity-service","auth":{"scheme":"in-process","roles":["platform-operator"],"description":"Platform operator, through the platform configuration file"},"idempotent":true,"inputs":[{"name":"tenant","type":"string"},{"name":"provider","type":"provider-id"}],"outputs":[],"postconditions":["A tenant's SAML providers are platform configuration and not tenant data, as its OpenID Connect providers are: one file that the operator names (STRATA_SAML_CONFIG) maps each tenant to its providers. A tenant's own people cannot change who is let in by a provider, and the operator can.","A provider names an identifier of 1 to 32 lower-case letters, digits and hyphens, a label for the sign-in page, the entity identifier its assertions are issued under (FED-254), the address of its sign-on service, and one to four certificates in PEM that it signs with (FED-005), given inline or as files that are read when the process starts. Several certificates are for a rotation: an assertion signed by any one of them is the provider's.","A certificate that cannot be read, a sign-on address that is not HTTPS (HTTP is allowed in development only) or holds credentials, a skew outside 0 to 300 seconds and a provider named twice stop the process from starting. There is no secret in the file.","The entity identifier of this service for a provider is the one the file names, and otherwise the address of the provider's metadata at the host the sign-in started at, so that each host of the platform is a service provider of its own and an assertion issued for another host's is refused (FED-008).","A provider that is not enabled is offered on no sign-in page, cannot be started, accepts no response, has no metadata and binds none of its domains (FED-009, FED-011). Its domains, its first-sign-in creation, its default role and its link by address are those of an OpenID Connect provider and are decided in the same place (H-039).","An address the provider sends is treated as verified only where the operator says the provider checks addresses (email_verified): only then does it bind a domain at a first sign-in (FED-009) or link an account (FED-257)."],"errors":[{"name":"invalid","condition":"The file does not parse, a certificate or an address in it is not usable, or a provider appears twice.","type":"api-error","kind":"invalid"}],"exposure":"local","deployment":"target"},
    {"id":"start-saml-sign-in","name":"Start a sign-in at a SAML provider","ref":"H-051","realisation":"hand","milestone":4,"implementedBy":"identity-service","auth":{"scheme":"anonymous","csrf":true,"origin":true,"justification":"Signing in with a provider starts before any session exists.","requires":["identity-sign-in"],"description":"Anyone from one of the site's own pages, with the request token every sign-in carries; to link a provider to an account, the signed-in person"},"idempotent":false,"inputs":[{"name":"provider","type":"provider-id"},{"name":"next","type":"string","optional":true},{"name":"link","type":"bool","optional":true}],"outputs":[{"name":"redirect","type":"string"}],"postconditions":["A sign-in at a SAML provider starts at this service and only here: a response is accepted only for a request this service made (FED-007, D-8). Sign-in started by the provider is not offered; a tenant that has not turned it on has none, and none can be turned on in this release.","The authentication request names this service by its entity identifier, the provider's sign-on address as its destination, the assertion consumer address of the host the sign-in started at, and the POST binding for the response. It is sent as the HTTP-Redirect binding: raw DEFLATE, base64, and a relay state, in the query of the provider's sign-on address.","A pending request is kept, found by the hash of the relay state, holding the identifier of the authentication request, the provider, the hash of a binding nonce, the address the sign-in started at, and the principal that was signed in when the person asked to link. The relay state and the identifier are random, and the relay state is in no log, audit entry or reply but the one that goes to the provider.","The binding nonce goes to the starting browser as a `__Host-` cookie, `Strict`, that the page cannot read, and is in no address. The return address is kept only when it is a path on the site (FED-250).","Starting is counted against the source and the realm and not against the provider, so that a few clicks of anyone's do not close the provider's button for everyone.","Metadata for the provider is served at the host the person asked at: this service's entity identifier, the one assertion consumer address, the POST binding, and that assertions are to be signed. It holds nothing secret and is not found for a provider that does not exist, is not enabled or is another site's."],"errors":[{"name":"invalid","condition":"The provider does not exist or is not enabled.","type":"api-error","kind":"invalid"},{"name":"forbidden","condition":"The request did not come from one of the site's own pages.","type":"api-error","kind":"forbidden"},{"name":"unauthenticated","condition":"A request to link was made by no one who is signed in.","type":"api-error","kind":"unauthenticated"},{"name":"unavailable","condition":"The provider's sign-on address is not one the browser may be sent to.","type":"api-error","kind":"unavailable"}],"exposure":"public","tenantScope":"request","bffRoute":"POST /api/sign-in/saml/start","deployment":"target"},
    {"id":"carry-saml-response-to-sign-in-page","name":"Carry a SAML response from the provider's post to the sign-in page","ref":"H-053","realisation":"hand","milestone":4,"implementedBy":"identity-service","auth":{"scheme":"anonymous","justification":"The provider's page posts from another site and carries no session; it only carries the response on to the sign-in page, which checks it.","requires":["identity-sign-in"],"description":"Anyone: the provider's page posts from another site and carries no session"},"idempotent":true,"inputs":[{"name":"response","type":"secret"},{"name":"relay-state","type":"secret"}],"outputs":[{"name":"location","type":"string"}],"postconditions":["The assertion consumer address takes the provider's POST and signs no one in. It reads the form, moves the response and the relay state into the fragment of the sign-in page's address, which the browser sends nowhere, and answers with a redirect to it. The page takes them out of the address bar and sends them in the body of one request from the site's own origin, with the request token every sign-in carries and with the binding cookie, which is `Strict` and so does not accompany the provider's post.","A form that carries no base64 response, one past 48 KiB of base64, or a relay state that is not one this service makes sends the page to say that the provider did not sign the person in, and nothing else is read from it.","The return address of the sign-in is a cookie that holds a path on the site and nothing secret. It is `SameSite=None`, because the way back is a POST, which a `Lax` cookie does not accompany; it is read only as a path on the site (FED-250) and is cleared by this answer.","The address is answered at the hosts the platform serves and no other."],"errors":[{"name":"not-found","condition":"No site is served at the address.","type":"api-error","kind":"not_found"}],"exposure":"public","tenantScope":"request","readOnly":true,"deployment":"target"},
    {"id":"consume-saml-response","name":"Check a SAML response and its assertion, once","ref":"H-052","realisation":"hand","milestone":4,"implementedBy":"identity-service","auth":{"scheme":"anonymous","csrf":true,"origin":true,"justification":"Signing in with a provider happens before any session exists; the signed assertion proves the identity.","requires":["identity-federate"],"description":"Anyone from one of the site's own pages, with the request token every sign-in carries"},"idempotent":false,"inputs":[{"name":"relay-state","type":"secret"},{"name":"response","type":"secret"},{"name":"binding","type":"secret"}],"outputs":[{"name":"subject","type":"external-subject"}],"postconditions":["The pending request is taken out of the store in the step that reads it, so a response answers once whatever follows, and it is accepted only through its lifetime, from the browser whose cookie holds the binding nonce and at the address it started at (FED-007). A response that answers no pending request is refused.","The assertion is checked as verify-saml-assertion states, against the provider's certificates and this host's entity identifier and assertion consumer address, and it must answer the request that was made (InResponseTo, on the assertion's confirmation and on the response where it names one).","The identifier of an assertion that passed every check is remembered, by hash, for the provider of the tenant, until it would no longer be accepted anyway (its end plus the skew), in the one step that also says whether it was already there. A second presentation, in any browser and at any time inside that window, is refused (FED-006). A message that is refused does not use its identifier up.","What the verified identity means for the realm is decided by resolve-federated-identity: the same for a SAML provider as for an OpenID Connect one.","Every refusal says the same to the person, whatever failed; the reason is in the log and holds no response, assertion, relay state, address or identifier. The attempt is limited like every other sign-in method's."],"errors":[{"name":"unauthenticated","condition":"The response answers no pending request of this browser, or the assertion fails a check, or it was presented before.","type":"api-error","kind":"unauthenticated"}],"exposure":"public","tenantScope":"request","deployment":"target"},
    {"id":"assign-role","name":"Give a person a role","ref":"CT-265","realisation":"generated","implementedBy":"gateway","bffRoute":"POST /api/members/assign-role","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A signed-in person whose tenant policies let them manage members","requires":["members-manage"],"stepUp":"15 min"},"idempotent":false,"timeoutMs":10000,"inputs":[{"name":"principal","type":"principal-id"},{"name":"role","type":"role-id"},{"name":"idempotency-key","type":"string","optional":true,"description":"At most 128 bytes. A repeat with the same key and the same input returns the stored result and changes nothing; the same key with other input is refused with idempotency-mismatch (D-6595). Needs a signed-in caller; honoured for 24 hours."}],"outputs":[{"name":"revision","type":"u64"},{"name":"event-seq","type":"u64"}],"preconditions":["The request carries the request token of the session (GWY-002)."],"postconditions":["The person holds the role, directly, when the call is accepted (ADM-150).","The call is refused unless the caller holds every permission and capability the role grants; the owner holds all of them, and only an owner confers owner (ADM-152)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller may not manage members, or the role is one whose permissions and capabilities the caller does not hold in full; the failed check names the role (ADM-152).","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The role is unknown, or it is public, which everyone holds.","type":"api-error","kind":"invalid"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"idempotency-mismatch","condition":"The key was used by this caller for another request.","type":"api-error","kind":"invalid"}],"exposure":"public","tenantScope":"request","deployment":"shipped"},
    {"id":"revoke-role","name":"Take a role from a person","ref":"CT-266","realisation":"generated","implementedBy":"gateway","bffRoute":"POST /api/members/revoke-role","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A signed-in person whose tenant policies let them manage members","requires":["members-manage"]},"idempotent":false,"timeoutMs":10000,"inputs":[{"name":"principal","type":"principal-id"},{"name":"role","type":"role-id"},{"name":"idempotency-key","type":"string","optional":true,"description":"At most 128 bytes. A repeat with the same key and the same input returns the stored result and changes nothing; the same key with other input is refused with idempotency-mismatch (D-6595). Needs a signed-in caller; honoured for 24 hours."}],"outputs":[{"name":"revision","type":"u64"},{"name":"event-seq","type":"u64"}],"preconditions":["The request carries the request token of the session (GWY-002)."],"postconditions":["The person no longer holds the role directly; a person who then holds no role has its sessions ended.","The last owner of a tenant keeps the owner role."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller may not manage members, or the role is one whose permissions and capabilities the caller does not hold in full; the failed check names the role (ADM-152, ADM-1080).","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The role is unknown, or it is the owner role of the last owner.","type":"api-error","kind":"invalid"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"},{"name":"idempotency-mismatch","condition":"The key was used by this caller for another request.","type":"api-error","kind":"invalid"}],"exposure":"public","tenantScope":"request","deployment":"shipped"},
    {"id":"add-team-member","name":"Put a person in a team","ref":"CT-267","realisation":"generated","implementedBy":"gateway","bffRoute":"POST /api/members/add-team-member","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A signed-in person whose tenant policies let them manage members","requires":["members-manage"],"stepUp":"15 min"},"idempotent":false,"timeoutMs":10000,"inputs":[{"name":"team","type":"team-id"},{"name":"principal","type":"principal-id"},{"name":"idempotency-key","type":"string","optional":true,"description":"At most 128 bytes. A repeat with the same key and the same input returns the stored result and changes nothing; the same key with other input is refused with idempotency-mismatch (D-6595). Needs a signed-in caller; honoured for 24 hours."}],"outputs":[{"name":"revision","type":"u64"},{"name":"event-seq","type":"u64"}],"preconditions":["The request carries the request token of the session (GWY-002)."],"postconditions":["The person holds the roles of the team for as long as they belong to it, and no other (ADM-151).","The call is refused unless the caller holds every permission and capability of each role of the team (ADM-152)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller may not manage members, or the role is one whose permissions and capabilities the caller does not hold in full; the failed check names the role (ADM-152).","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The team is unknown.","type":"api-error","kind":"invalid"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"idempotency-mismatch","condition":"The key was used by this caller for another request.","type":"api-error","kind":"invalid"}],"exposure":"public","tenantScope":"request","deployment":"shipped"},
    {"id":"remove-team-member","name":"Take a person out of a team","ref":"CT-268","realisation":"generated","implementedBy":"gateway","bffRoute":"POST /api/members/remove-team-member","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A signed-in person whose tenant policies let them manage members","requires":["members-manage"]},"idempotent":false,"timeoutMs":10000,"inputs":[{"name":"team","type":"team-id"},{"name":"principal","type":"principal-id"},{"name":"idempotency-key","type":"string","optional":true,"description":"At most 128 bytes. A repeat with the same key and the same input returns the stored result and changes nothing; the same key with other input is refused with idempotency-mismatch (D-6595). Needs a signed-in caller; honoured for 24 hours."}],"outputs":[{"name":"revision","type":"u64"},{"name":"event-seq","type":"u64"}],"preconditions":["The request carries the request token of the session (GWY-002)."],"postconditions":["The person no longer holds the roles of the team through it; a person who then holds no role has its sessions ended."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller may not manage members, or a role of the team is one whose permissions and capabilities the caller does not hold in full; the failed check names the role (ADM-152, ADM-1080).","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The team is unknown.","type":"api-error","kind":"invalid"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"},{"name":"idempotency-mismatch","condition":"The key was used by this caller for another request.","type":"api-error","kind":"invalid"}],"exposure":"public","tenantScope":"request","deployment":"shipped"},
    {"id":"invite-person","name":"Invite a person to hold roles","ref":"CT-269","realisation":"generated","implementedBy":"gateway","bffRoute":"POST /api/members/invite","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A signed-in person whose tenant policies let them manage members","requires":["members-manage"],"stepUp":"15 min"},"idempotent":false,"timeoutMs":10000,"inputs":[{"name":"invitation","type":"invitation-id"},{"name":"address","type":"email-address"},{"name":"roles","type":"list<role-id>"},{"name":"idempotency-key","type":"string","optional":true,"description":"At most 128 bytes. A repeat with the same key and the same input returns the stored result and changes nothing; the same key with other input is refused with idempotency-mismatch (D-6595). Needs a signed-in caller; honoured for 24 hours."}],"outputs":[{"name":"revision","type":"u64"},{"name":"event-seq","type":"u64"}],"preconditions":["The request carries the request token of the session (GWY-002)."],"postconditions":["The invitation offers its roles to whoever redeems it with the address it names, once (ADM-153).","The call is refused unless the caller holds every permission and capability each role grants (ADM-152)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller may not manage members, or the role is one whose permissions and capabilities the caller does not hold in full; the failed check names the role (ADM-152).","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The invitation exists already, names no address or no role, or a role is unknown or public.","type":"api-error","kind":"invalid"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"idempotency-mismatch","condition":"The key was used by this caller for another request.","type":"api-error","kind":"invalid"}],"exposure":"public","tenantScope":"request","deployment":"shipped"},
    {"id":"redeem-invitation","name":"Redeem an invitation as the signed-in person","ref":"CT-270","realisation":"generated","implementedBy":"gateway","bffRoute":"POST /api/members/redeem","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A signed-in person","requires":["invitation-redeem"]},"idempotent":false,"timeoutMs":10000,"inputs":[{"name":"invitation","type":"invitation-id"},{"name":"idempotency-key","type":"string","optional":true,"description":"At most 128 bytes. A repeat with the same key and the same input returns the stored result and changes nothing; the same key with other input is refused with idempotency-mismatch (D-6595). Needs a signed-in caller; honoured for 24 hours."}],"outputs":[{"name":"revision","type":"u64"},{"name":"event-seq","type":"u64"}],"preconditions":["The request carries the request token of the session (GWY-002)."],"postconditions":["The invitation's roles go to the caller only when the verified address of the caller's account is the address the invitation names, and only once; the request names no address (ADM-153).","The refusal does not say which address the invitation names."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller's account has no verified address, or it is not the address the invitation names.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The invitation is unknown or was redeemed already.","type":"api-error","kind":"invalid"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"},{"name":"idempotency-mismatch","condition":"The key was used by this caller for another request.","type":"api-error","kind":"invalid"}],"exposure":"public","tenantScope":"request","deployment":"shipped"},
    {"id":"decide-ledger-posting","name":"Decide a posting to a ledger account","ref":"CT-280","realisation":"generated","implementedBy":"kernel","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"state","type":"state","description":"The snapshot the plan names: the account, its balance record, its limits, the unit, and the entry of the idempotency key when there is one (K-100)."},{"name":"posting","type":"ledger-posting-request"},{"name":"context","type":"context","description":"The caller of the change that causes the posting; it is recorded as caused-by."},{"name":"at","type":"timestamp","description":"The time of the entry, given by the runtime (K-11). The kernel reads no clock."}],"outputs":[{"name":"result","type":"ledger-posting-result"}],"postconditions":["The same snapshot, posting, context and time give the same result (LDG-008).","A posting that repeats an idempotency key of the account with the same content answers with the entry recorded and a state delta of nothing (LDG-006).","A refused posting yields no state delta and no event (LDG-013, LDG-014).","An accepted posting yields the entry, the new balance record and the event ledger-entry-posted in one state delta, to be committed with the change that causes it (LDG-009, LDG-010)."],"errors":[{"name":"unknown-unit","condition":"The unit is not one the tenant declared (LDG-002).","type":"domain-error","kind":"not_found"},{"name":"unknown-owner","condition":"The owner is a principal the tenant does not have or a pool it did not declare (LDG-004).","type":"domain-error","kind":"not_found"},{"name":"invalid-amount","condition":"The amount is zero, or the balance after it would be out of the range of an amount (LDG-003).","type":"domain-error","kind":"invalid"},{"name":"below-floor","condition":"The balance after the posting would be below the floor and the posting does not move it toward the floor (LDG-013).","type":"domain-error","kind":"invalid"},{"name":"above-cap","condition":"The balance after the posting would be above the cap and the posting does not move it toward the cap (LDG-013).","type":"domain-error","kind":"invalid"},{"name":"above-period-cap","condition":"The credits of the period of the entry would pass the cap per period (LDG-014).","type":"domain-error","kind":"invalid"},{"name":"idempotency-mismatch","condition":"The key was recorded with another amount, reason or correction (LDG-007).","type":"domain-error","kind":"conflict"},{"name":"bad-correction","condition":"The posting names an entry to correct that the account does not hold (LDG-023).","type":"domain-error","kind":"invalid"},{"name":"fault","condition":"A checked conversion or integer operation inside the decision overflowed; nothing was changed.","kind":"internal"}],"exposure":"local","deployment":"shipped"},
    {"id":"post-ledger-entry","name":"Post an entry to a ledger account","ref":"CT-281","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the posting","requires":["ledger-post"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"owner","type":"ledger-owner"},{"name":"unit","type":"ledger-unit"},{"name":"scope","type":"ledger-scope","optional":true,"description":"The scope of the account; empty when absent (D-6551)."},{"name":"amount","type":"ledger-amount"},{"name":"idempotency-key","type":"string"},{"name":"reason","type":"string"},{"name":"corrects","type":"u64","optional":true,"description":"The number of the entry this one corrects."}],"outputs":[{"name":"result","type":"ledger-posting-result"}],"postconditions":["The runtime reads its clock once, gives the time to the decision and commits the entry and its event in one transaction (LDG-009, D-5010).","Repeating the call with the same key and the same content answers with the first entry and changes nothing (LDG-006).","A commit that lost a race is decided again on the new state, as execute-intent does (LDG-018)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"refused","condition":"The kernel refused the posting; the body is the error reply, whose code names the refusal of decide-ledger-posting (unknown-unit, unknown-owner, invalid-amount, below-floor, above-cap, above-period-cap, bad-correction).","type":"api-error","kind":"invalid"},{"name":"idempotency-mismatch","condition":"The key was recorded with another amount, reason or correction.","type":"api-error","kind":"conflict"},{"name":"conflict","condition":"Every commit lost its race to another one, the retries of the store contract over; nothing is changed.","type":"store-error","kind":"conflict"},{"name":"unavailable","condition":"The store could not do the work right now; safe to retry with the same key.","type":"store-error","kind":"unavailable"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/ledger/post"},
    {"id":"read-ledger-balance","name":"Read the balance of a ledger account","ref":"CT-282","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the read","requires":["ledger-read"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"owner","type":"ledger-owner"},{"name":"unit","type":"ledger-unit"},{"name":"scope","type":"ledger-scope","optional":true,"description":"The scope of the account; empty when absent (D-6551)."}],"outputs":[{"name":"balance","type":"ledger-balance"}],"postconditions":["The balance counts only the entries that the policies of the reader permit (LDG-025).","A reader who may read every entry of the account is answered from the derived record, and the answer equals the sum of the entries (LDG-020)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The tenant has no such account, or the reader may read none of it; the two are not told apart.","type":"api-error","kind":"not_found"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/ledger/balance"},
    {"id":"list-ledger-entries","name":"List the entries of a ledger account","ref":"CT-283","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the read","requires":["ledger-read"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"owner","type":"ledger-owner"},{"name":"unit","type":"ledger-unit"},{"name":"scope","type":"ledger-scope","optional":true,"description":"The scope of the account; empty when absent (D-6551)."},{"name":"cursor","type":"string","optional":true,"description":"Opaque; the next output of the previous call. The entries after the one it names are returned."},{"name":"limit","type":"u32","optional":true,"description":"At most 100; 50 when absent."}],"outputs":[{"name":"entries","type":"list<ledger-entry>"},{"name":"next","type":"string","optional":true}],"postconditions":["Only the entries that the policies of the reader permit are returned (LDG-024).","The entries come in the order of their numbers.","A page holds at most limit entries; next is the cursor of the following page and is absent at the end of the list."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The tenant has no such account, or the reader may read none of it; the two are not told apart.","type":"api-error","kind":"not_found"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/ledger/entries"},
    {"id":"declare-ledger-unit","name":"Declare a unit of the ledger","ref":"CT-284","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["ledger-configure"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"unit","type":"ledger-unit"},{"name":"description","type":"string"},{"name":"expiry","type":"ledger-expiry","optional":true,"description":"How the credits of the unit expire (D-6553)."}],"outputs":[{"name":"unit","type":"ledger-unit"}],"postconditions":["Declaring a unit again with the same description changes nothing; with another description it replaces the description and touches no account or entry."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The name does not match the pattern of a unit.","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/ledger/declare-unit"},
    {"id":"declare-ledger-pool","name":"Declare a pool of the ledger","ref":"CT-285","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["ledger-configure"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"pool","type":"ledger-pool-name"},{"name":"description","type":"string"}],"outputs":[{"name":"pool","type":"ledger-pool-name"}],"postconditions":["Declaring a pool again with the same description changes nothing; with another description it replaces the description and touches no account or entry."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The name does not match the pattern of a pool.","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/ledger/declare-pool"},
    {"id":"set-ledger-limit","name":"Set the limits of a unit or of one account","ref":"CT-286","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["ledger-configure"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"limit","type":"ledger-limit","description":"With an owner, the limits of that account; without one, the limits of every account of the unit that has none of its own."}],"outputs":[{"name":"limit","type":"ledger-limit"}],"postconditions":["The limits apply to the postings committed after the call; no entry is changed and no balance is rewritten (LDG-016).","The limit of an account takes the place of the limit of its unit, limit by limit (LDG-012)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The floor is above the cap, a cap per period has no period, or the unit or the owner is not declared.","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/ledger/set-limit"},
    {"id":"verify-ledger-balance","name":"Compare a balance with the sum of its entries","ref":"CT-287","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"account","type":"ledger-account-id"}],"outputs":[{"name":"ok","type":"bool"},{"name":"stored","type":"ledger-amount"},{"name":"replayed","type":"ledger-amount"}],"postconditions":["The replayed balance is the sum of the amounts of every entry of the account, read from its journal in the order of their numbers, and ok is true when it equals the stored balance (LDG-020).","A gap in the numbers of the entries is reported, not summed over (LDG-019)."],"errors":[{"name":"unavailable","condition":"The store could not do the work right now; safe to retry.","type":"store-error","kind":"unavailable"}],"exposure":"local","readOnly":true,"deployment":"target"},
    {"id":"derive-ledger-balance","name":"Derive a balance from the entries a reader may read","ref":"CT-288","realisation":"generated","implementedBy":"kernel","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"state","type":"state"},{"name":"account","type":"ledger-account-id"},{"name":"context","type":"context"},{"name":"now","type":"timestamp"}],"outputs":[{"name":"balance","type":"ledger-balance"}],"postconditions":["The balance is the sum of the amounts of the entries that check-record-visibility lets the principal of the context read, and of no other (LDG-025).","When the principal may read every entry of the account, the balance equals the stored balance record (LDG-020)."],"errors":[{"name":"fault","condition":"A checked integer operation inside the derivation overflowed; nothing was changed.","kind":"internal"}],"exposure":"local","readOnly":true,"deployment":"target"},
    {"id":"define-segment","name":"Create or change a segment","ref":"CT-290","realisation":"generated","implementedBy":"gateway","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["segments-define"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"segment","type":"segment-id"},{"name":"name","type":"string"},{"name":"subject-type","type":"object-type-id"},{"name":"predicate","type":"expression"},{"name":"refresh-seconds","type":"u32","optional":true,"description":"Required when the predicate reads the time: at least 60 and at most 86400."},{"name":"principal-field","type":"field-id","description":"The required unique string field of the subject type that holds the principal (SEG-1548)."},{"name":"visible-to-members","type":"bool","optional":true,"description":"Whether its members may list it; false when absent (SEG-1540)."}],"outputs":[{"name":"version","type":"u64"},{"name":"batches","type":"u32","description":"The number of batches that apply a changed predicate to the persons of the subject type: the persons divided by one hundred, rounded up (SEG-023)."}],"postconditions":["The segment is stored as tenant metadata under the schema version (SEG-001).","Every field the predicate names is one that the policies of the caller permit the caller to read (SEG-005).","A changed predicate raises the version and is applied to the persons of the subject type in batches (SEG-022, SEG-023).","A segment whose predicate reads the time has a schedule at its refresh interval, and one that does not has none (SEG-018, SEG-020)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"field-forbidden","condition":"The predicate names a field that the policies of the caller do not permit the caller to read (SEG-005).","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The predicate fails to parse (the error carries its position) or uses a construct outside the tenant rule language (SEG-003), reads outside the context of SEG-002 or reaches further than its bounds (SEG-004), or the refresh interval is missing or out of range (SEG-017).","type":"api-error","kind":"invalid"},{"name":"limit-reached","condition":"The tenant already holds one hundred segments, or twenty-five that read an object type the predicate reads, or five time-dependent segments that are not indexable (SEG-029, SEG-1547).","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/segments/define"},
    {"id":"remove-segment","name":"Remove a segment","ref":"CT-291","realisation":"generated","implementedBy":"gateway","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["segments-define"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"segment","type":"segment-id"}],"outputs":[],"postconditions":["The memberships, the pending batches and the schedule of the segment are removed, and no exit event is written (SEG-026)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/segments/remove"},
    {"id":"list-segment-members","name":"List the members of a segment","ref":"CT-292","realisation":"generated","implementedBy":"gateway","auth":{"scheme":"session","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["segments-read"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"segment","type":"segment-id"},{"name":"cursor","type":"string","optional":true},{"name":"limit","type":"u32","optional":true}],"outputs":[{"name":"members","type":"list<segment-member>"},{"name":"next","type":"string","optional":true}],"postconditions":["Only persons whose subject records the policies of the caller permit the caller to read are listed (SEG-033).","Each entry names the version of the predicate that decided it (D-5027)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The tenant has no such segment.","type":"api-error","kind":"not_found"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/segments/members"},
    {"id":"test-segment-predicate","name":"Test a predicate against one person","ref":"CT-293","realisation":"generated","implementedBy":"gateway","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["segments-define"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"subject-type","type":"object-type-id"},{"name":"predicate","type":"expression"},{"name":"principal-field","type":"field-id","optional":true,"description":"The required unique string field of the subject type that holds the principal (SEG-1548); the field principal when absent."},{"name":"person","type":"principal-id"}],"outputs":[{"name":"result","type":"segment-test-result"}],"postconditions":["The call changes no state (SEG-035).","The value is the one that a change would give the same person at the same time (SEG-015).","The same refusals as a definition apply to the predicate (SEG-003, SEG-004, SEG-005)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The predicate fails to parse, uses a construct outside the language or reads outside the bounds (SEG-003, SEG-004).","type":"api-error","kind":"invalid"},{"name":"not-found","condition":"The person has no record of the subject type that the caller may read.","type":"api-error","kind":"not_found"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/segments/test"},
    {"id":"evaluate-segment-predicate","name":"Evaluate the predicate of a segment for one person","ref":"CT-294","realisation":"generated","implementedBy":"kernel","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"state","type":"state"},{"name":"segment","type":"segment-id"},{"name":"person","type":"principal-id"},{"name":"context","type":"context"}],"outputs":[{"name":"member","type":"bool"},{"name":"reads","type":"list<record-id>"}],"postconditions":["Equal state, segment, person and context give equal results (SEG-015).","The time is the one in the context and no clock is read (SEG-016).","The result names the records the predicate read, all of them among the records the plan named (SEG-027).","An evaluation that fails or exhausts its step budget gives no result and leaves membership as it was (SEG-030)."],"errors":[],"exposure":"local","deployment":"target"},
    {"id":"plan-segment-needs","name":"Plan the state that evaluating segments needs","ref":"CT-295","realisation":"generated","implementedBy":"kernel","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"schema","type":"tenant-schema","optional":true},{"name":"segments","type":"list<segment-id>"},{"name":"persons","type":"list<principal-id>"}],"outputs":[{"name":"needs","type":"list<need>"}],"postconditions":["The needs name the subject record of each person and the records its predicate reaches, and nothing else (SEG-027).","At most one hundred persons are named for one segment (SEG-028)."],"errors":[],"exposure":"local","deployment":"target"},
    {"id":"decide-segment-membership","name":"Decide the memberships that a change causes","ref":"CT-296","realisation":"generated","implementedBy":"kernel","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"state","type":"state"},{"name":"delta","type":"state-delta"},{"name":"context","type":"context"}],"outputs":[{"name":"events","type":"list<segment-membership-event>"},{"name":"deferred","type":"u64","description":"The persons left to batches because the change affects more than one hundred (SEG-028)."}],"postconditions":["One entry event is written for each person who starts to satisfy a predicate, and one exit event for each who stops, in the transaction of the change (SEG-008, SEG-009).","No event is written for a person whose membership is as it was (SEG-010).","Each event carries the hop count of the change plus one, also past the hop limit (SEG-031, SEG-032).","An erased person is entered into no segment (SEG-037)."],"errors":[],"exposure":"local","deployment":"target"},
    {"id":"run-segment-batch","name":"Evaluate one batch of persons for a segment","ref":"CT-297","realisation":"generated","implementedBy":"automation-worker","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"segment","type":"segment-id"},{"name":"version","type":"u64"},{"name":"cursor","type":"record-id","optional":true},{"name":"at","type":"timestamp"}],"outputs":[{"name":"next","type":"record-id","optional":true},{"name":"written","type":"u32"}],"postconditions":["At most one hundred persons are evaluated, at the time given, in one transaction (SEG-028).","A batch of a version that is no longer the version of the segment writes nothing (SEG-025).","The last batch of a refresh has evaluated every person of the subject type (SEG-019).","A repeated batch writes no second event (D-5026)."],"errors":[],"exposure":"local","deployment":"target"},
    {"realisation":"generated","id":"setting-save-definition","name":"Define or change a setting of the tenant","ref":"CT-300","implementedBy":"gateway","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A signed-in person whose tenant policies let them define settings","requires":["setting-define"]},"idempotent":false,"timeoutMs":10000,"inputs":[{"name":"definition","type":"setting-def"},{"name":"expected-version","type":"schema-version"}],"outputs":[{"name":"version","type":"schema-version"}],"preconditions":["The request carries the request token of the session (GWY-002)."],"postconditions":["A definition states a name, a type, a default of that type and the levels that may override it (SET-001).","The call is refused when the default is not a value of the type, when the name is that of a platform setting, or when the type changes while an override exists (SET-002, SET-003, SET-004).","A definition that is locked by the tenant leaves only the platform and tenant levels, and its overrides at the levels below are kept and not applied (SET-023, SET-024).","The change is a schema change: it is applied only when expected-version is the current version of the schema, and it raises the revision of the setting (SET-051)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The default is not a value of the type, the type is not a declared type, the set of levels is empty, or the name is that of a platform setting (SET-002, SET-003).","type":"api-error","kind":"invalid"},{"name":"type-locked","condition":"The type changes while an override of the setting exists (SET-004).","type":"api-error","kind":"invalid"},{"name":"conflict","condition":"The schema was changed since the version the caller names; the current version is named.","type":"api-error","kind":"conflict"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/settings/save-definition"},
    {"realisation":"generated","id":"setting-resolve","name":"Read a setting for the caller","ref":"CT-301","implementedBy":"gateway","auth":{"scheme":"session","tenantPolicies":true,"description":"A signed-in principal whose policies permit the operation","requires":["setting-read"]},"idempotent":true,"inputs":[{"name":"setting","type":"setting-id"}],"outputs":[{"name":"resolution","type":"setting-resolution"}],"postconditions":["The value is that of the most specific permitted override that reaches the caller, or the default (SET-010).","When several teams of the caller hold an override, the team whose identifier comes first applies (SET-011).","The answer names the level the value came from (SET-012)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The setting is not defined.","type":"api-error","kind":"not_found"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped","bffRoute":"GET /api/settings/:setting"},
    {"realisation":"generated","id":"setting-resolve-all","name":"List the settings for the caller","ref":"CT-302","implementedBy":"gateway","auth":{"scheme":"session","tenantPolicies":true,"description":"A signed-in principal whose policies permit the operation","requires":["setting-read"]},"idempotent":true,"inputs":[],"outputs":[{"name":"settings","type":"list<setting-resolution>"}],"postconditions":["Each entry is the answer that a read of that setting gives the caller (SET-010, SET-012)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped","bffRoute":"GET /api/settings"},
    {"realisation":"generated","id":"setting-set-platform","name":"Set or remove the platform level of a setting","ref":"CT-303","implementedBy":"control-plane","auth":{"scheme":"session","roles":["platform-operator"],"csrf":true,"origin":true,"description":"A platform operator","requires":["setting-write-platform"]},"idempotent":false,"timeoutMs":10000,"inputs":[{"name":"setting","type":"setting-id"},{"name":"value","type":"json","optional":true},{"name":"expected-version","type":"u64"}],"outputs":[{"name":"revision","type":"u64"}],"preconditions":["The request carries the request token of the session (GWY-002)."],"postconditions":["The call is refused unless the caller holds setting-write-platform (SET-030).","A call with a value sets the override at the level and a call without a value removes it, after which a read falls back to the next level (SET-022).","A change is refused with conflict when expected-version is not the current revision of the override, and then changes nothing (SET-025).","The change is committed with a domain event that names the setting, the level and the subject, and with an audit entry that holds the previous and the new value (SET-040, SET-042).","The revision of the setting is raised (SET-051)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The setting is not defined.","type":"api-error","kind":"not_found"},{"name":"level-not-allowed","condition":"The definition of the setting does not allow an override at this level, or a lock of the definition closes it (SET-020, SET-023).","type":"api-error","kind":"invalid"},{"name":"wrong-type","condition":"The value is not a value of the type of the setting (SET-021).","type":"api-error","kind":"invalid"},{"name":"conflict","condition":"The override was changed since the revision the caller names; the current revision is named (SET-025).","type":"api-error","kind":"conflict"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"internal","deployment":"target","tenantScope":"platform"},
    {"realisation":"generated","id":"setting-set-tenant","name":"Set or remove the tenant level of a setting","ref":"CT-304","implementedBy":"gateway","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A signed-in person whose tenant policies let them write tenant settings","requires":["setting-write-tenant"]},"idempotent":false,"timeoutMs":10000,"inputs":[{"name":"setting","type":"setting-id"},{"name":"value","type":"json","optional":true},{"name":"expected-version","type":"u64"}],"outputs":[{"name":"revision","type":"u64"},{"name":"event-seq","type":"u64"}],"preconditions":["The request carries the request token of the session (GWY-002)."],"postconditions":["The call is refused unless the caller holds setting-write-tenant (SET-031).","A call with a value sets the override at the level and a call without a value removes it, after which a read falls back to the next level (SET-022).","A change is refused with conflict when expected-version is not the current revision of the override, and then changes nothing (SET-025).","The change is committed with a domain event that names the setting, the level and the subject, and with an audit entry that holds the previous and the new value (SET-040, SET-042).","The revision of the setting is raised (SET-051)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The setting is not defined.","type":"api-error","kind":"not_found"},{"name":"level-not-allowed","condition":"The definition of the setting does not allow an override at this level, or a lock of the definition closes it (SET-020, SET-023).","type":"api-error","kind":"invalid"},{"name":"wrong-type","condition":"The value is not a value of the type of the setting (SET-021).","type":"api-error","kind":"invalid"},{"name":"conflict","condition":"The override was changed since the revision the caller names; the current revision is named (SET-025).","type":"api-error","kind":"conflict"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/settings/set-tenant"},
    {"realisation":"generated","id":"setting-set-team","name":"Set or remove the team level of a setting","ref":"CT-305","implementedBy":"gateway","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A signed-in person whose tenant policies let them write team settings","requires":["setting-write-team"]},"idempotent":false,"timeoutMs":10000,"inputs":[{"name":"setting","type":"setting-id"},{"name":"team","type":"team-id"},{"name":"value","type":"json","optional":true},{"name":"expected-version","type":"u64"}],"outputs":[{"name":"revision","type":"u64"},{"name":"event-seq","type":"u64"}],"preconditions":["The request carries the request token of the session (GWY-002)."],"postconditions":["The call is refused unless the caller holds setting-write-team (SET-032).","A call with a value sets the override at the level and a call without a value removes it, after which a read falls back to the next level (SET-022).","A change is refused with conflict when expected-version is not the current revision of the override, and then changes nothing (SET-025).","The change is committed with a domain event that names the setting, the level and the subject, and with an audit entry that holds the previous and the new value (SET-040, SET-042).","The revision of the setting is raised (SET-051)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The setting is not defined.","type":"api-error","kind":"not_found"},{"name":"level-not-allowed","condition":"The definition of the setting does not allow an override at this level, or a lock of the definition closes it (SET-020, SET-023).","type":"api-error","kind":"invalid"},{"name":"wrong-type","condition":"The value is not a value of the type of the setting (SET-021).","type":"api-error","kind":"invalid"},{"name":"invalid","condition":"The team is unknown.","type":"api-error","kind":"invalid"},{"name":"conflict","condition":"The override was changed since the revision the caller names; the current revision is named (SET-025).","type":"api-error","kind":"conflict"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/settings/set-team"},
    {"realisation":"generated","id":"setting-set-person","name":"Set or remove the person level of a setting for the caller","ref":"CT-306","implementedBy":"gateway","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A signed-in person","requires":["setting-write-person"]},"idempotent":false,"timeoutMs":10000,"inputs":[{"name":"setting","type":"setting-id"},{"name":"value","type":"json","optional":true},{"name":"expected-version","type":"u64"}],"outputs":[{"name":"revision","type":"u64"},{"name":"event-seq","type":"u64"}],"preconditions":["The request carries the request token of the session (GWY-002)."],"postconditions":["The call is refused unless the caller holds setting-write-person (SET-033).","The call is refused unless the override is the caller's own: it names no other person, and no role, the owner's included, changes that (SET-034).","A call with a value sets the override at the level and a call without a value removes it, after which a read falls back to the next level (SET-022).","A change is refused with conflict when expected-version is not the current revision of the override, and then changes nothing (SET-025).","The change is committed with a domain event that names the setting, the level and the subject, and with an audit entry that holds the previous and the new value (SET-040, SET-042).","The revision of the setting is raised (SET-051)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The setting is not defined.","type":"api-error","kind":"not_found"},{"name":"level-not-allowed","condition":"The definition of the setting does not allow an override at this level, or a lock of the definition closes it (SET-020, SET-023).","type":"api-error","kind":"invalid"},{"name":"wrong-type","condition":"The value is not a value of the type of the setting (SET-021).","type":"api-error","kind":"invalid"},{"name":"conflict","condition":"The override was changed since the revision the caller names; the current revision is named (SET-025).","type":"api-error","kind":"conflict"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/settings/set-person"},
    {"realisation":"generated","implementedBy":"gateway","id":"aggregate-run","name":"Run an aggregate of a named query","ref":"CT-310","auth":{"scheme":"anonymous","description":"Anyone; no session is needed","requires":["aggregate-read"]},"idempotent":true,"timeoutMs":10000,"inputs":[{"name":"host","type":"host"},{"name":"query","type":"string"},{"name":"aggregate","type":"string"},{"name":"filter","type":"value-map","optional":true}],"outputs":[{"name":"result","type":"aggregate-result"}],"postconditions":["The reader is the public audience class (AGG-033).","The result counts only records that the audience class of the reader permits (AGG-015) and equals the same aggregate computed one record at a time over them (AGG-016).","A record whose named field the reader may not read is left out (AGG-017).","The result names the object types it depends on (AGG-042) and is stored as a copy of the audience class of the reader (AGG-030, AGG-032).","The records of one tenant only are read (AGG-040).","The throttled response names the limit and the time after which the next request is permitted (CMS-168)."],"errors":[{"name":"not-found","condition":"The query or the aggregate does not exist for this tenant (AGG-003).","type":"api-error","kind":"not_found"},{"name":"invalid","condition":"The filter names a field the query does not declare (AGG-004).","type":"api-error","kind":"invalid"},{"name":"scan-bound-exceeded","condition":"The aggregate would examine more records than its declared scan bound; no result is returned (AGG-020, AGG-021).","type":"api-error","kind":"invalid"},{"name":"sum-overflow","condition":"A sum does not fit the type of its field; no result is returned (AGG-022).","type":"api-error","kind":"invalid"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped","bffRoute":"GET /api/aggregate","description":"The route GET /api/aggregate takes the query and the aggregate as query and aggregate, and the filter as filter, JSON text of an object. It answers as the principal of the session, and as the public audience class when there is none. The kernel derives the audience class of the caller from the policies of the tenant (AGG-033). When the class is shared by readers, the result is stored under a key that holds the tenant, the query, the aggregate, its arguments, the class, the schema version and the change counter of each object type it depends on, and the callers of that class are served it until a commit to one of those object types or a change of the schema makes a new key (AGG-030 to AGG-032, D-7860). A result for a caller whose class is that caller alone is computed on every request and stored nowhere (AGG-2861). A signed-in caller is served by the same route."},
    {"realisation":"generated","implementedBy":"gateway","id":"aggregate-run-signed-in","name":"Run an aggregate of a named query as a signed-in principal","ref":"CT-311","auth":{"scheme":"session","tenantPolicies":true,"description":"A signed-in principal whose policies permit the operation","requires":["aggregate-read"]},"idempotent":true,"timeoutMs":10000,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"query","type":"string"},{"name":"aggregate","type":"string"},{"name":"filter","type":"value-map","optional":true}],"outputs":[{"name":"result","type":"aggregate-result"}],"postconditions":["The reader is the audience class that the kernel derives for the caller from the policies of the tenant (AGG-033).","The result counts only records that the audience class of the reader permits (AGG-015) and equals the same aggregate computed one record at a time over them (AGG-016).","A record whose named field the reader may not read is left out (AGG-017).","The result names the object types it depends on (AGG-042) and is stored as a copy of the audience class of the reader (AGG-030, AGG-032).","The records of one tenant only are read (AGG-040)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The query or the aggregate does not exist for this tenant (AGG-003).","type":"api-error","kind":"not_found"},{"name":"invalid","condition":"The filter names a field the query does not declare (AGG-004).","type":"api-error","kind":"invalid"},{"name":"scan-bound-exceeded","condition":"The aggregate would examine more records than its declared scan bound; no result is returned (AGG-020, AGG-021).","type":"api-error","kind":"invalid"},{"name":"sum-overflow","condition":"A sum does not fit the type of its field; no result is returned (AGG-022).","type":"api-error","kind":"invalid"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped","description":"The route GET /api/aggregate takes the query and the aggregate as query and aggregate, and the filter as filter, JSON text of an object. It answers as the principal of the session. It takes an optional tenant, which must be the tenant resolved from the host and session: any other is refused as tenant-mismatch and recorded as an audit entry (TEN-1140). The kernel derives the audience class of the caller from the policies of the tenant (AGG-033). When the class is shared by readers, the result is stored under a key that holds the tenant, the query, the aggregate, its arguments, the class, the schema version and the change counter of each object type it depends on, and the callers of that class are served it until a commit to one of those object types or a change of the schema makes a new key (AGG-030 to AGG-032, D-7860). A result for a caller whose class is that caller alone is computed on every request and stored nowhere (AGG-2861).","bffRoute":"GET /api/aggregate"},
    {"id":"request-tenant-deletion","name":"Request the deletion of a tenant","ref":"CT-550","realisation":"generated","implementedBy":"control-plane","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"stepUp":"15 min","description":"An owner of the tenant","requires":["tenant-delete"]},"idempotent":false,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"confirm-tenant","type":"tenant-id"}],"outputs":[{"name":"executes-at","type":"timestamp"}],"postconditions":["A deletion request records the requesting owner and the time at which the grace period that the plan states ends (D-705, ADM-160).","Every owner of the tenant is told by mail, naming the requesting person and the time of execution (PRV-1214, D-6207).","The request is recorded in the audit log (OBS-1217).","Nothing is removed by the request itself (TEN-011)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The tenant does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"invalid","condition":"The request does not repeat the identifier of the tenant it will destroy (OPS-325).","type":"api-error","kind":"invalid"},{"name":"conflict","condition":"A deletion of this tenant is already requested.","type":"api-error","kind":"conflict"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request"},
    {"id":"record-enterprise-contract","name":"Record the enterprise contract of a tenant","ref":"CT-551","realisation":"generated","implementedBy":"control-plane","auth":{"scheme":"session","roles":["platform-operator"],"csrf":true,"origin":true,"stepUp":"15 min","description":"A platform operator","requires":["plan-contract-record"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"contract-reference","type":"string"}],"outputs":[],"postconditions":["An owner of the tenant may then change the plan to or from Enterprise (BIL-1204, D-6202).","The record is written to the platform audit store with the operator, the tenant and the contract reference (OBS-1218)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The tenant does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"invalid","condition":"The contract reference is empty.","type":"api-error","kind":"invalid"}],"exposure":"internal","tenantScope":"platform"},
    {"id":"set-platform-flag","name":"Set a platform flag or quota of a tenant","ref":"CT-552","realisation":"generated","implementedBy":"control-plane","auth":{"scheme":"session","roles":["platform-operator"],"csrf":true,"origin":true,"stepUp":"15 min","description":"A platform operator","requires":["platform-flags-manage"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"name","type":"string"},{"name":"value","type":"string"}],"outputs":[],"postconditions":["A flag is off for a tenant unless the release record enables it for that tenant (OPS-328).","The change is written to the platform audit store with the operator, the tenant, the name, the previous value and the new value (OPS-329, D-508, OBS-1218)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The tenant does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"invalid","condition":"The name is neither a platform flag nor a quota, or the value is not one the name takes.","type":"api-error","kind":"invalid"},{"name":"conflict","condition":"The tenant holds more of a metered quantity than the new quota allows; the quantity is named (MIG-583).","type":"api-error","kind":"conflict"}],"exposure":"internal","tenantScope":"platform"},
    {"id":"take-down-tenant","name":"Take a tenant down","ref":"CT-565","realisation":"generated","implementedBy":"control-plane","auth":{"scheme":"session","roles":["platform-operator"],"csrf":true,"origin":true,"description":"A platform operator who holds the capability takedown-issue","requires":["takedown-issue"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"reason","type":"tenant-suspension-reason"},{"name":"reference","type":"string"}],"outputs":[{"name":"state","type":"tenant-lifecycle"},{"name":"effective-by","type":"u64","description":"The time by which every gateway has stopped serving the tenant (ARC-1228)."}],"preconditions":["The reason is abuse, legal-order or security-incident.","The tenant is not provisioning or deleting."],"postconditions":["The tenant is suspended with that reason, and its background work, sessions and outbound effects stop as TEN-1221 to TEN-1224 state.","The edge copies of every host of the tenant are purged (CT-104, THR-1226).","No gateway serves the tenant later than 60 seconds after the record (ARC-1228).","An audit entry names the operator, the reason, the reference and the time."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The tenant does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"invalid","condition":"The reason is a commercial reason.","type":"api-error","kind":"invalid"},{"name":"conflict","condition":"The tenant is provisioning or deleting.","type":"api-error","kind":"conflict"},{"name":"unavailable","condition":"The control plane cannot record the takedown; nothing was changed (ARC-1228).","type":"api-error","kind":"unavailable"}],"exposure":"internal","tenantScope":"platform"},
    {"id":"take-down-host","name":"Take a host down","ref":"CT-566","realisation":"generated","implementedBy":"control-plane","auth":{"scheme":"session","roles":["platform-operator"],"csrf":true,"origin":true,"description":"A platform operator who holds the capability takedown-issue","requires":["takedown-issue"]},"idempotent":true,"inputs":[{"name":"host","type":"host"},{"name":"reason","type":"tenant-suspension-reason"},{"name":"reference","type":"string"}],"outputs":[{"name":"effective-by","type":"u64","description":"The time by which every gateway has stopped serving the host (ARC-1228)."}],"preconditions":["The reason is abuse, legal-order or security-incident."],"postconditions":["The domain binding is marked taken down, and the edge copies stored under the host are purged (CT-104, THR-262).","Every other host and the state of the tenant are unchanged (THR-1227).","An audit entry names the operator, the reason, the reference and the time."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The host is not bound to a tenant.","type":"api-error","kind":"not_found"},{"name":"invalid","condition":"The reason is a commercial reason.","type":"api-error","kind":"invalid"},{"name":"unavailable","condition":"The control plane cannot record the takedown; nothing was changed (ARC-1228).","type":"api-error","kind":"unavailable"}],"exposure":"internal","tenantScope":"platform"},
    {"id":"release-takedown","name":"Release a takedown","ref":"CT-567","realisation":"generated","implementedBy":"control-plane","auth":{"scheme":"session","roles":["platform-operator"],"csrf":true,"origin":true,"description":"A platform operator who holds the capability takedown-issue and did not issue the takedown","requires":["takedown-issue"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"host","type":"host","optional":true},{"name":"reference","type":"string"}],"outputs":[{"name":"state","type":"tenant-lifecycle"}],"preconditions":["A takedown of the tenant, or of the host when one is named, is in force.","The caller is not the operator who issued it (THR-1226)."],"postconditions":["The tenant returns to active, or the host binding is unmarked, and gateways serve it again within 60 seconds (ARC-1229).","Queued webhooks and mail discarded by the takedown are not sent (TEN-1223).","An audit entry names the operator and the reference."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The tenant does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"conflict","condition":"No takedown is in force, or the caller issued it.","type":"api-error","kind":"conflict"}],"exposure":"internal","tenantScope":"platform"},
    {"id":"send-message","name":"Send a templated message or inbox notice","ref":"CT-820","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the operation","requires":["messages-send"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"channel","type":"send-channel"},{"name":"template","type":"template-id"},{"name":"recipient","type":"send-recipient"},{"name":"category","type":"message-category-id"},{"name":"allowance-class","type":"allowance-class","optional":true,"description":"Absent means transactional for a required or transactional category and bulk for a promotional one. sign-in is refused."},{"name":"idempotency-key","type":"string"},{"name":"topic","type":"inbox-topic","optional":true,"description":"Required when the channel is inbox or both."},{"name":"values","type":"value-map","optional":true,"description":"Token values of the template, rendered as text in their output context (EML-016)."},{"name":"reference","type":"send-reference","optional":true},{"name":"deliver","type":"send-time","optional":true}],"outputs":[{"name":"progress","type":"send-progress"},{"name":"recipients","type":"u32","optional":true,"description":"The number of recipients, known at once for a principal or an address."}],"postconditions":["A send to a principal or an address becomes one mail job, created alone when the send is the change and in the commit of the change otherwise, once for its idempotency key, so a rolled-back change sends nothing (EML-1560, EML-005).","A repeat of an idempotency key gives the first result while the job of the key is kept, which is at least seven days, and a repeat with other inputs is refused (EML-1560).","A send to a segment is cut into batches of at most one hundred persons in ascending order of principal identifier, each batch a job that reads membership when it runs and creates one job for each of its persons, so no person gets two messages of one send; the sender is told the numbers of recipients and batches only (EML-1561, D-6561).","A message of a promotional category carries the unsubscribe header and link (EML-020), and mail is checked against the suppression of its category (EML-1562); preferences (NTF-1571) are not read yet.","A message is counted in its allowance class (EML-1563) and is held while the complaint breaker of the tenant is open (EML-1564).","The recipient address and the rendered subject are checked for line breaks before any job is created (EML-1566).","The reference is carried on every message of the send and in the mail log (EML-1565).","Only the channel mail is served: the channels inbox and both, and a delivery time, are refused as invalid until WG-5218.","The workflow step send-mail makes the same send as the automation principal, which must hold messages-send through its run-as roles, with the step key as the idempotency key, so a replayed step sends once (D-6560)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The template, the category or the segment does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"invalid","condition":"The class is sign-in, the topic breaks the grammar of NTF-1568, an address field or the subject holds a line break (EML-1566), a part the channel needs is missing from the template, a send names both at and local-time, or the recipient is an address and the channel is inbox.","type":"api-error","kind":"invalid"},{"name":"conflict","condition":"The idempotency key was used within seven days with other inputs (EML-1560).","type":"api-error","kind":"conflict"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/mail/send"},
    {"id":"set-notice-read","name":"Mark inbox notices read or unread","ref":"CT-821","realisation":"generated","implementedBy":"notification-service","auth":{"scheme":"session","csrf":true,"origin":true,"description":"A signed-in principal","requires":["notifications-manage"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"notices","type":"list<string>"},{"name":"read","type":"bool"}],"outputs":[{"name":"unread","type":"u32"}],"postconditions":["Only notices of the caller are changed (NTF-1569).","Reading a notice produces the domain event inbox-notice-read, and marking it unread produces none (SCH-1575).","The output is the unread count after the change."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"A named notice is not in the inbox of the caller; nothing is changed (NTF-1569).","type":"api-error","kind":"not_found"},{"name":"invalid","condition":"More than 100 notices are named.","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","bffRoute":"POST /api/inbox/read","deployment":"shipped"},
    {"id":"remove-notices","name":"Remove inbox notices","ref":"CT-822","realisation":"generated","implementedBy":"notification-service","auth":{"scheme":"session","csrf":true,"origin":true,"description":"A signed-in principal","requires":["notifications-manage"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"notices","type":"list<string>"}],"outputs":[{"name":"unread","type":"u32"}],"postconditions":["Only notices of the caller are removed, and each removal ends its inbox item and publishes ev-inbox-item-ended (NTF-1569)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"A named notice is not in the inbox of the caller; nothing is removed (NTF-1569).","type":"api-error","kind":"not_found"},{"name":"invalid","condition":"More than 100 notices are named.","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","bffRoute":"POST /api/inbox/remove","deployment":"shipped"},
    {"id":"count-unread-notices","name":"Count the unread notices of the caller","ref":"CT-823","realisation":"generated","implementedBy":"notification-service","auth":{"scheme":"session","description":"A signed-in principal","requires":["notifications-read"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"topic","type":"string","optional":true,"description":"A topic, or a prefix that ends in .*."}],"outputs":[{"name":"unread","type":"u32"}],"postconditions":["The count equals the number of unread notices that list-inbox returns for the same topic (NTF-1569)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","readOnly":true,"bffRoute":"POST /api/inbox/count","deployment":"shipped"},
    {"id":"define-notice-template","name":"Define a notice template","ref":"CT-824","realisation":"generated","implementedBy":"notification-service","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the operation","requires":["mail-configure"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"template","type":"template-id"},{"name":"title","type":"string"},{"name":"body","type":"structured-blocks"}],"outputs":[{"name":"version","type":"u64"}],"postconditions":["The template is stored as tenant metadata and is rendered for each recipient as text (NTF-1570)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"A token in the template is undefined.","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","bffRoute":"POST /api/inbox/templates","deployment":"shipped"},
    {"id":"define-message-category","name":"Declare a message category","ref":"CT-825","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the operation","requires":["mail-configure"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"category","type":"message-category-id"},{"name":"purpose","type":"message-category-purpose"},{"name":"name","type":"string"}],"outputs":[{"name":"version","type":"u64"}],"postconditions":["A category is kept by the mail dispatcher of the tenant with its purpose and a version raised by each change (D-6562); keeping it as tenant metadata under the schema version is WG-5217.","A category cannot be named all or promotional (EML-1562).","A category that holds suppressions or messages keeps its purpose; changing it is refused."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The name is reserved or the purpose of a category in use would change.","type":"api-error","kind":"invalid"},{"name":"limit-reached","condition":"The tenant already holds 50 categories.","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/mail/categories"},
    {"id":"set-notification-preference","name":"Set a notification preference of the caller","ref":"CT-826","realisation":"generated","implementedBy":"notification-service","auth":{"scheme":"session","csrf":true,"origin":true,"description":"A signed-in principal","requires":["notifications-manage"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"category","type":"message-category-id"},{"name":"channel","type":"notification-channel"},{"name":"mode","type":"notification-mode"},{"name":"period","type":"digest-period","optional":true}],"outputs":[],"postconditions":["The preference is written for the caller only (NTF-1571).","Off for a required category is refused, and sign-in mail has no preference (NTF-1571).","A recipient leaves every promotional category at once by the link of EML-1562, which is not a preference."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The category does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"invalid","condition":"The category is required and the mode is off.","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","bffRoute":"POST /api/inbox/preferences","deployment":"shipped"},
    {"id":"change-subscription-by-link","name":"Unsubscribe or resubscribe by a signed link","ref":"CT-827","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"signed-address","secret":"subscription-link-key","description":"Anyone holding a signed address that names the recipient, the category and the action","requires":["subscription-link"]},"idempotent":true,"inputs":[{"name":"host","type":"host"},{"name":"address","type":"url"}],"outputs":[{"name":"category","type":"string"},{"name":"state","type":"string"}],"postconditions":["The link takes effect without a sign-in (EML-020); it names the hash of the address, the category, the action and an HMAC-SHA-256 of the tenant and those three.","The action named in the link is unsubscribe or resubscribe; unsubscribe adds a suppression of reason unsubscribe for the category named in it, or for every promotional category (EML-1562).","Resubscribe removes a suppression of reason unsubscribe and leaves a bounce or a complaint in place (EML-1562).","An unsubscribe is recorded in the audit trail of the tenant; the domain event mail-unsubscribed (SCH-1575) is WG-5219.","A link for a required or transactional category is not issued, and a link that names one is not found, so no unsubscribe of them exists to follow."],"errors":[{"name":"not-found","condition":"The signature does not match or the category no longer exists; the response does not say which.","type":"api-error","kind":"not_found"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"}],"exposure":"public","tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/mail/subscription"},
    {"id":"send-digest","name":"Send one digest of the notices of a category","ref":"CT-828","realisation":"generated","implementedBy":"notification-service","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"category","type":"message-category-id"},{"name":"template","type":"template-id"},{"name":"since","type":"timestamp"},{"name":"until","type":"timestamp"},{"name":"recipient","type":"send-recipient","optional":true},{"name":"reference","type":"send-reference","optional":true},{"name":"idempotency-key","type":"string"}],"outputs":[{"name":"progress","type":"send-progress"}],"postconditions":["Each person with notices of the category in the window receives one message that lists them, and a person with none receives none (NTF-1572).","The same batches, limits and idempotency apply as to send-message (EML-1560, EML-1561).","The workflow step send-digest calls this operation with the fields of send-digest-step."],"errors":[{"name":"invalid","condition":"The window is empty or longer than 31 days.","type":"api-error","kind":"invalid"}],"exposure":"local","deployment":"target"},
    {"id":"resolve-recipient-setting","name":"Read a setting for a named recipient","ref":"CT-829","realisation":"generated","implementedBy":"gateway","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"recipient","type":"principal-id"},{"name":"setting","type":"setting-id"}],"outputs":[{"name":"value","type":"value"},{"name":"level","type":"setting-level"}],"postconditions":["The value is the one that setting-resolve would give the recipient as caller (SET-010), and no component outside the mail dispatcher, the notification service and the automation worker may call this operation.","Only the settings time-zone, quiet-hours and mute-until may be resolved this way (D-6565)."],"errors":[{"name":"forbidden","condition":"The setting is not one of the three.","type":"api-error","kind":"forbidden"}],"exposure":"local"},
    {"id":"declare-event-kind","name":"Declare an event kind of the tenant","ref":"CT-830","realisation":"generated","implementedBy":"kernel","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the operation","requires":["events-declare"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"kind","type":"event-kind"},{"name":"fields","type":"list<event-field-def>"},{"name":"readers","type":"list<role-id>"}],"outputs":[{"name":"version","type":"u64"}],"postconditions":["The kind is stored as tenant metadata (SCH-1576).","A kind outside the prefix app. is refused, and so is a thirty-third kind (SCH-1576)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The kind lacks the prefix app., breaks the grammar, has more than 16 fields or a field type outside the scalars.","type":"api-error","kind":"invalid"},{"name":"limit-reached","condition":"The tenant already holds 32 declared kinds.","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request"},
    {"id":"emit-event","name":"Emit a declared event","ref":"CT-831","realisation":"generated","implementedBy":"kernel","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the operation","requires":["events-declare"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"kind","type":"event-kind"},{"name":"payload","type":"value-map"},{"name":"idempotency-key","type":"string","optional":true}],"outputs":[{"name":"seq","type":"u64"}],"postconditions":["The event is a domain event recorded in the transaction of the change it belongs to and published from the outbox after it (SCH-004, SCH-1576).","The hop limit of the tenant bounds a chain of triggers that emit events (SCH-300).","The workflow step emit-event calls this operation with the fields of emit-event-step."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The kind is not declared for this tenant.","type":"api-error","kind":"not_found"},{"name":"invalid","condition":"The payload does not match the declaration, is over 4 KiB, or the kind is a platform kind.","type":"api-error","kind":"invalid"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request"},
    {"id":"create-webhook-endpoint","name":"Create an inbound webhook endpoint","ref":"CT-832","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the operation","requires":["webhooks-manage"]},"idempotent":false,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"endpoint","type":"string"},{"name":"workflow","type":"workflow-id"}],"outputs":[{"name":"secret","type":"secret"},{"name":"version","type":"u64"}],"postconditions":["The secret is whsec_ and 64 hexadecimal digits of 32 random bytes from the operating system's random source, is returned once, and is stored sealed under the platform's factor key, bound to the tenant and the endpoint (INT-1578, D-7641).","A delivery to the endpoint starts a run of the workflow (INT-150)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The workflow does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"conflict","condition":"The endpoint name is in use.","type":"api-error","kind":"conflict"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","bffRoute":"POST /api/webhooks/endpoints","deployment":"shipped"},
    {"id":"rotate-webhook-secret","name":"Rotate the secret of an inbound webhook endpoint","ref":"CT-833","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the operation","requires":["webhooks-manage"]},"idempotent":false,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"endpoint","type":"string"}],"outputs":[{"name":"secret","type":"secret"},{"name":"previous-valid-until","type":"timestamp"}],"postconditions":["The new secret is returned once; the previous secret verifies for 24 hours more and then no longer (INT-1578).","A second rotation inside the overlap retires the oldest secret at once, so at most two secrets verify."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The endpoint does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","bffRoute":"POST /api/webhooks/endpoints/rotate","deployment":"shipped"},
    {"id":"count-mail-messages","name":"Count mail messages by state","ref":"CT-834","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["mail-read"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"group-by","type":"mail-count-by"},{"name":"reference","type":"send-reference","optional":true},{"name":"category","type":"message-category-id","optional":true},{"name":"template","type":"template-id","optional":true},{"name":"from","type":"timestamp","optional":true},{"name":"until","type":"timestamp","optional":true}],"outputs":[{"name":"counts","type":"list<mail-count>"}],"postconditions":["One count for each state and each value of the grouping field, in ascending order of the value and then of the state (EML-1565).","Messages the log has dropped are not counted; the log keeps thirty days (D-6571).","The result has no count of opens or clicks (NG-8, EML-1565)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The period is longer than the log keeps or from is after until.","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","readOnly":true,"deployment":"shipped","bffRoute":"GET /api/mail/counts"},
    {"id":"upgrade-bundle","name":"Upgrade an installed product to a newer bundle","ref":"CT-835","realisation":"generated","implementedBy":"substrate","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["bundle-install"],"stepUp":"15 min"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"bundle","type":"tenant-bundle"},{"name":"expected-version","type":"schema-version","optional":true,"description":"The schema version the projection was shown against; a different current version refuses the upgrade (D-6595)."},{"name":"dry-run","type":"bool","optional":true,"description":"Return the projection and change nothing (INT-154)."},{"name":"idempotency-key","type":"string","optional":true,"description":"A repeat with the same key and the same input returns the stored result and changes nothing; the same key with other input is refused with idempotency-mismatch (D-6595)."}],"outputs":[{"name":"schema-version","type":"u64"},{"name":"projection","type":"projection-summary","optional":true}],"postconditions":["The upgrade is one product change: the entities the new version declares are created or changed, the entities the earlier version owned and the new one drops are removed, and the migration of the changed record types runs as the schema change that it is (INT-1581).","The projection names every entity created, changed and removed, and the number of records a migration touches; the upgrade applies only the projection that was shown (INT-154).","A bundle whose version is not greater than the installed version is refused (INT-1583)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The product is not installed in the tenant.","type":"api-error","kind":"not_found"},{"name":"invalid","condition":"The bundle is malformed, has a version not greater than the installed one, or declares a platform range the platform release is outside of.","type":"api-error","kind":"invalid"},{"name":"conflict","condition":"The schema version is not the one given, or the migration of a record type was rejected.","type":"api-error","kind":"conflict"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","bffRoute":"POST /api/products/upgrade","deployment":"shipped","description":"Upgrades an installed product to a later version of its bundle: the difference between the installed and the new version, found from the ownership record, is one change-schema intent. Served by crates/backend/src/products.rs (POST /internal/products/upgrade) and the gateway route of crates/bff/src/routes.rs."},
    {"id":"remove-bundle","name":"Remove an installed product","ref":"CT-836","realisation":"generated","implementedBy":"substrate","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["bundle-install"],"stepUp":"15 min"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"product","type":"product-id"},{"name":"delete-records","type":"bool"},{"name":"expected-version","type":"schema-version","optional":true,"description":"The version the caller read; a different current version refuses the call with a conflict that changes nothing (D-6595)."},{"name":"dry-run","type":"bool","optional":true,"description":"Return the projection and change nothing (INT-154)."},{"name":"idempotency-key","type":"string","optional":true,"description":"A repeat with the same key and the same input returns the stored result and changes nothing; the same key with other input is refused with idempotency-mismatch (D-6595)."}],"outputs":[{"name":"schema-version","type":"u64"},{"name":"projection","type":"projection-summary","optional":true}],"postconditions":["Removal deletes every entity the product owns, found from the ownership record of the tenant catalogue, and no entity that it does not own (INT-1582).","A record type of the product that still has records is refused unless delete-records is true; the projection counts those records (INT-1581).","Removing a product that is not installed returns the current schema version and changes nothing (INT-1583)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"A record type of the product has records and delete-records is false, or another product refers to an entity this product owns.","type":"api-error","kind":"invalid"},{"name":"conflict","condition":"The schema version is not the one given.","type":"api-error","kind":"conflict"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","bffRoute":"POST /api/products/remove","deployment":"shipped","description":"Removes an installed product: exactly the entities its ownership record owns are removed, with the record, in one change-schema intent; the records of a type of the product are deleted only when delete-records says so. Served by crates/backend/src/products.rs (POST /internal/products/remove) and the gateway route of crates/bff/src/routes.rs."},
    {"id":"list-installed-products","name":"List the products installed in a tenant","ref":"CT-837","realisation":"generated","implementedBy":"substrate","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the read","requires":["catalogue-read"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"cursor","type":"string","optional":true},{"name":"limit","type":"u32","optional":true,"description":"At most 100; the default is 50 (D-6595)."}],"outputs":[{"name":"products","type":"list<installed-product>"},{"name":"next","type":"string","optional":true}],"postconditions":["Each product lists every entity it owns (INT-1582)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","bffRoute":"GET /api/products","deployment":"shipped","description":"Lists the products installed in the tenant, each with the entities it owns, from the ownership records of the tenant schema. Served by crates/backend/src/products.rs (POST /internal/products) and the gateway route of crates/bff/src/routes.rs."},
    {"id":"start-upload","name":"Start a chunked upload","ref":"CT-838","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the upload; either capability suffices (D-6591)","requires":["content-write","self-file-upload"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"declared-type","type":"string"},{"name":"name","type":"string"},{"name":"size","type":"u64","description":"The total size in bytes, at most the file limit of the tenant (D-6589)."},{"name":"object","type":"object-type-id","optional":true},{"name":"field","type":"field-id","optional":true},{"name":"idempotency-key","type":"string","optional":true,"description":"A repeat with the same key and the same input returns the stored result and changes nothing; the same key with other input is refused with idempotency-mismatch (D-6595)."}],"outputs":[{"name":"upload","type":"string"},{"name":"chunk-bytes","type":"u32"}],"postconditions":["The size is checked against the smallest of the platform maximum, the limit of the tenant and the max-bytes of the field named, before any byte is accepted (CMS-1593).","With object and field, the principal must be allowed to write that field, and the media type must be one the field accepts.","An upload that is not finished within 24 hours is removed with its chunks."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"too-large","condition":"The size exceeds a limit that applies (CMS-1593).","type":"api-error","kind":"invalid"},{"name":"invalid","condition":"The declared type is not accepted by the field.","type":"api-error","kind":"invalid"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/files/uploads/start"},
    {"id":"put-upload-chunk","name":"Send one chunk of an upload","ref":"CT-839","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"The principal that started the upload","requires":["content-write","self-file-upload"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"upload","type":"string"},{"name":"index","type":"u32"},{"name":"content","type":"bytes"}],"outputs":[{"name":"received","type":"u64"}],"postconditions":["A chunk is at most chunk-bytes and is stored under its index; sending the same index again with the same content changes nothing, and with other content is refused (CMS-1593).","The bytes received never exceed the size given at the start."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The upload does not exist for this principal or has expired.","type":"api-error","kind":"not_found"},{"name":"too-large","condition":"The chunk exceeds chunk-bytes or the total exceeds the size given.","type":"api-error","kind":"invalid"},{"name":"conflict","condition":"The index was received with other content.","type":"api-error","kind":"conflict"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/files/uploads/:upload/chunks/:index"},
    {"id":"finish-upload","name":"Finish a chunked upload","ref":"CT-840","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"The principal that started the upload","requires":["content-write","self-file-upload"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"upload","type":"string"}],"outputs":[{"name":"file","type":"hash"},{"name":"state","type":"string"}],"postconditions":["The file is stored under its content hash (CMS-008), scanned (CMS-260) and checked against its content type (CMS-261) as an upload-file result is.","The file-scanned event follows the scan and a rendition-ready event follows each rendition the field declares (CMS-1593).","Until a record refers to the file it is readable only by the principal that uploaded it (CMS-1591)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The upload does not exist for this principal or has expired.","type":"api-error","kind":"not_found"},{"name":"invalid","condition":"A chunk is missing, the total differs from the size given, or the content does not confirm the media type (CMS-261, CMS-263).","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"shipped","bffRoute":"POST /api/files/uploads/:upload/finish"},
    {"id":"publish-content","name":"Publish a record","ref":"CT-841","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the transition","requires":["content-write"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"object","type":"object-type-id"},{"name":"record","type":"record-id"},{"name":"expected-version","type":"u64","optional":true,"description":"The version the caller read; a different current version refuses the call with a conflict that changes nothing (D-6595)."},{"name":"idempotency-key","type":"string","optional":true,"description":"A repeat with the same key and the same input returns the stored result and changes nothing; the same key with other input is refused with idempotency-mismatch (D-6595)."}],"outputs":[{"name":"version","type":"u64"},{"name":"state","type":"string"}],"postconditions":["The record moves from its draft state, or its approved state when the type is marked for review, to its published state through the workflow of the type, and an event record-updated names the transition publish (CMS-1596).","A type marked for review refuses publishing a record whose state is not approved (CMS-156).","The published version stays as it was until this call (CMS-153)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The record does not exist for this tenant, or the caller may not read it.","type":"api-error","kind":"not_found"},{"name":"invalid","condition":"The type declares no publication (D-6592), or the record is not in a state this transition leaves.","type":"api-error","kind":"invalid"},{"name":"conflict","condition":"The version is not the current version of the record.","type":"api-error","kind":"conflict"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request"},
    {"id":"withdraw-content","name":"Withdraw a published record","ref":"CT-842","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the transition","requires":["content-write"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"object","type":"object-type-id"},{"name":"record","type":"record-id"},{"name":"expected-version","type":"u64","optional":true,"description":"The version the caller read; a different current version refuses the call with a conflict that changes nothing (D-6595)."},{"name":"idempotency-key","type":"string","optional":true,"description":"A repeat with the same key and the same input returns the stored result and changes nothing; the same key with other input is refused with idempotency-mismatch (D-6595)."}],"outputs":[{"name":"version","type":"u64"},{"name":"state","type":"string"}],"postconditions":["The record moves from published to its withdrawn state; the shared copies that held it are superseded and the purge follows (CMS-1596).","A scheduled publication of the record is cancelled (CMS-158)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The record does not exist for this tenant, or the caller may not read it.","type":"api-error","kind":"not_found"},{"name":"invalid","condition":"The type declares no publication (D-6592), or the record is not published.","type":"api-error","kind":"invalid"},{"name":"conflict","condition":"The version is not the current version of the record.","type":"api-error","kind":"conflict"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request"},
    {"id":"submit-for-review","name":"Submit a record for review","ref":"CT-843","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the transition","requires":["content-write"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"object","type":"object-type-id"},{"name":"record","type":"record-id"},{"name":"expected-version","type":"u64","optional":true,"description":"The version the caller read; a different current version refuses the call with a conflict that changes nothing (D-6595)."},{"name":"idempotency-key","type":"string","optional":true,"description":"A repeat with the same key and the same input returns the stored result and changes nothing; the same key with other input is refused with idempotency-mismatch (D-6595)."}],"outputs":[{"name":"version","type":"u64"},{"name":"state","type":"string"},{"name":"run","type":"run-id"}],"postconditions":["The record moves to its in-review state and a run of the review workflow of the type starts; the run id is stored in the review-run field of the record (CMS-1596).","The approval of the last step of that run, through approve-workflow-step, moves the record to its approved state, and a refusal of the run moves it back to draft (CMS-1596)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The record does not exist for this tenant, or the caller may not read it.","type":"api-error","kind":"not_found"},{"name":"invalid","condition":"The type declares no publication (D-6592), declares no review workflow, or the record is not a draft.","type":"api-error","kind":"invalid"},{"name":"conflict","condition":"The version is not the current version of the record.","type":"api-error","kind":"conflict"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request"},
    {"id":"schedule-publication","name":"Schedule or cancel the publication of a record","ref":"CT-844","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the transition","requires":["content-write"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"object","type":"object-type-id"},{"name":"record","type":"record-id"},{"name":"expected-version","type":"u64","optional":true,"description":"The version the caller read; a different current version refuses the call with a conflict that changes nothing (D-6595)."},{"name":"publish-at","type":"timestamp","optional":true,"description":"The time to publish at, in the future; absent cancels the schedule (CMS-158)."},{"name":"idempotency-key","type":"string","optional":true,"description":"A repeat with the same key and the same input returns the stored result and changes nothing; the same key with other input is refused with idempotency-mismatch (D-6595)."}],"outputs":[{"name":"version","type":"u64"},{"name":"publish-at","type":"timestamp","optional":true}],"postconditions":["The publication time is stored in the time field of the type and the job of rec-scheduled-publication publishes the record at that time (WFL-011).","The job publishes as the principal that scheduled it, authorised again at that time; when that principal may no longer publish the record, the record stays unpublished and the job reports the refusal (CMS-1596).","A record of a type marked for review is published at the time only when it is approved by then."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The record does not exist for this tenant, or the caller may not read it.","type":"api-error","kind":"not_found"},{"name":"invalid","condition":"The type declares no publication (D-6592), or publish-at is not in the future.","type":"api-error","kind":"invalid"},{"name":"conflict","condition":"The version is not the current version of the record.","type":"api-error","kind":"conflict"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request"},
    {"id":"configure-tenant-settings","name":"Change the tenant settings","ref":"CT-845","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["tenant-configure"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"settings","type":"tenant-settings"},{"name":"expected-version","type":"u64","optional":true,"description":"The version the caller read; a different current version refuses the call with a conflict that changes nothing (D-6595)."},{"name":"dry-run","type":"bool","optional":true,"description":"Return the projection and change nothing."},{"name":"idempotency-key","type":"string","optional":true,"description":"A repeat with the same key and the same input returns the stored result and changes nothing; the same key with other input is refused with idempotency-mismatch (D-6595)."}],"outputs":[{"name":"version","type":"u64"},{"name":"projection","type":"projection-summary","optional":true}],"postconditions":["A value on the looser side of its platform default, or outside the floor and ceiling the platform holds, is refused; a platform-fixed value cannot be set (IDN-1598).","Each change is projected before it applies (AGT-425)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"A value is on the looser side of its default, outside its bounds, or names a value that is platform-fixed.","type":"api-error","kind":"invalid"},{"name":"conflict","condition":"The version is not the current one.","type":"api-error","kind":"conflict"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request"},
    {"id":"read-tenant-settings","name":"Read the tenant settings and their bounds","ref":"CT-846","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["tenant-configure"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"}],"outputs":[{"name":"settings","type":"tenant-settings"},{"name":"realm","type":"realm-settings"},{"name":"version","type":"u64"}],"postconditions":["The reply holds the value in force for each setting, the platform default where none is set (IDN-1598)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request"},
    {"id":"invoke-tenant-operation","name":"Invoke a tenant operation","ref":"CT-805","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A signed-in principal that the invokers of the operation name","requires":["tenant-operation-invoke"]},"idempotent":true,"timeoutMs":10000,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"context","type":"context","description":"The caller's context, built from the session and the request, not from the body."},{"name":"invocation","type":"tenant-operation-invocation"},{"name":"idempotency-key","type":"string","description":"The key the caller chose for this invocation, 1 to 128 visible ASCII characters, required: the ledger key of each posting is made from it (D-6548, OPR-1545). A repeat by the same caller with the same key and the same input answers with the first result and changes nothing; the same key with other input is refused with idempotency-mismatch (D-6595, OPR-1544)."}],"outputs":[{"name":"result","type":"tenant-operation-result"}],"postconditions":["The runtime reads its clock once, gives the time to the decision, and commits every record change, every posting and their events in one transaction, or nothing (OPR-1541).","A repeat with the same key and the same inputs answers with the recorded result and changes nothing (OPR-1544).","A commit that lost a race is decided again on the new state, as execute-intent does (CMS-1553).","A dry run returns the result without committing it (OPR-1552)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The invokers of the operation do not name the caller (OPR-1546).","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The tenant has no such operation, or its subject record does not exist or is not readable by the caller.","type":"api-error","kind":"not_found"},{"name":"invalid","condition":"An input is missing, undeclared or does not coerce to its field type.","type":"api-error","kind":"invalid"},{"name":"refused","condition":"A condition was false or null, or a step was refused; the body names the code of the condition or the refusal of the step (below-floor, above-cap, a unique constraint), and nothing is changed (OPR-1542).","type":"api-error","kind":"invalid"},{"name":"idempotency-mismatch","condition":"The key was used by the caller for this operation with other inputs (OPR-1544).","type":"api-error","kind":"conflict"},{"name":"conflict","condition":"Every commit lost its race to another one, the retries of the store contract over; nothing is changed.","type":"store-error","kind":"conflict"},{"name":"unavailable","condition":"The store could not do the work right now; safe to retry with the same key.","type":"store-error","kind":"unavailable"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","bffRoute":"POST /api/operations/invoke","deployment":"shipped"},
    {"id":"decide-tenant-operation","name":"Decide an invocation of a tenant operation","ref":"CT-806","realisation":"generated","implementedBy":"kernel","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"state","type":"state","description":"The snapshot the plan names: the subject record, the records the steps change, the balance records of the accounts the conditions read and the steps post to, the memberships and settings the conditions read, and the run record of the key (K-100)."},{"name":"invocation","type":"tenant-operation-invocation"},{"name":"idempotency-key","type":"string","description":"The idempotency-key input of invoke-tenant-operation (or of invoke-operation for an agent), carried by the intent invoke-operation; the ledger key of each posting is op:<operation id>:<invoker>:<key>:<step id> (OPR-1545)."},{"name":"context","type":"context"},{"name":"at","type":"timestamp","description":"The time of the decision, given by the runtime (K-11)."}],"outputs":[{"name":"result","type":"tenant-operation-result"}],"postconditions":["The same snapshot, invocation, context and time give the same result (KRN-001).","The conditions are evaluated on the snapshot before any step, and each step on the state the steps before it leave (OPR-1543).","A refused invocation yields no state delta and no event (OPR-1542).","An accepted invocation yields one state delta with every record change, entry, derived balance, run record and event (OPR-1541)."],"errors":[{"name":"unknown-operation","condition":"The tenant has no such operation.","type":"domain-error","kind":"not_found"},{"name":"condition-failed","condition":"A condition was false or null; the error carries the code and message of the condition (OPR-1542).","type":"domain-error","kind":"invalid"},{"name":"step-refused","condition":"A step was refused by a check of the record or of the ledger; the error names the step and the refusal.","type":"domain-error","kind":"invalid"},{"name":"idempotency-mismatch","condition":"The run record of the key holds another input hash (OPR-1544).","type":"domain-error","kind":"conflict"},{"name":"fault","condition":"A checked conversion or integer operation inside the decision overflowed; nothing was changed.","kind":"internal"}],"exposure":"local"},
    {"id":"read-my-ledger-balance","name":"Read the balance of one's own ledger account","ref":"CT-807","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A signed-in principal reading an account it owns","requires":["ledger-read-own"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"unit","type":"ledger-unit"},{"name":"scope","type":"ledger-scope","optional":true}],"outputs":[{"name":"balance","type":"ledger-balance"}],"postconditions":["The account read is the caller's own; the contract takes no owner (LDG-1541).","An account that does not exist reads as a balance of 0 at sequence 0."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","bffRoute":"POST /api/ledger/my-balance","deployment":"shipped"},
    {"id":"list-my-ledger-entries","name":"List the entries of one's own ledger account","ref":"CT-808","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A signed-in principal reading an account it owns","requires":["ledger-read-own"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"unit","type":"ledger-unit"},{"name":"scope","type":"ledger-scope","optional":true},{"name":"cursor","type":"string","optional":true,"description":"Opaque; the next output of the previous call. The entries after the one it names are returned."},{"name":"limit","type":"u32","optional":true,"description":"At most 100; 50 when absent."}],"outputs":[{"name":"entries","type":"list<ledger-entry>"},{"name":"next","type":"string","optional":true}],"postconditions":["Only entries of the caller's own account are returned (LDG-1541).","The entries come in the order of their numbers.","A page holds at most limit entries; next is the cursor of the following page and is absent at the end of the list."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","bffRoute":"POST /api/ledger/my-entries","deployment":"shipped"},
    {"id":"list-ledger-accounts","name":"List the accounts of a unit in order of balance","ref":"CT-809","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the read","requires":["ledger-read"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"unit","type":"ledger-unit"},{"name":"scope","type":"ledger-scope","optional":true},{"name":"order","type":"ledger-order"},{"name":"cursor","type":"string","optional":true},{"name":"limit","type":"u32","optional":true,"description":"At most 100; 20 when absent."}],"outputs":[{"name":"accounts","type":"list<ledger-account-rank>"},{"name":"next","type":"string","optional":true}],"postconditions":["Accounts come in the order asked, equal balances in ascending order of the owner (LDG-1543).","An account is listed only when the policies of the reader permit every entry of it (LDG-1544).","At most ten thousand accounts are examined for one request (LDG-1543)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"scan-bound-exceeded","condition":"The walk would examine more than ten thousand accounts; nothing is returned (LDG-1543).","type":"api-error","kind":"invalid"},{"name":"not-found","condition":"The unit is not declared.","type":"api-error","kind":"not_found"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","bffRoute":"POST /api/ledger/accounts","deployment":"shipped"},
    {"id":"list-ledger-definitions","name":"List the units, pools and limits of the ledger","ref":"CT-810","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the read","requires":["ledger-read"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"}],"outputs":[{"name":"definitions","type":"ledger-definitions"}],"postconditions":["Every unit, pool and limit the tenant has declared is listed (LDG-1548)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","bffRoute":"POST /api/ledger/definitions","deployment":"shipped"},
    {"id":"remove-ledger-definition","name":"Remove a unit, a pool or a limit of the ledger","ref":"CT-811","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["ledger-configure"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"definition","type":"ledger-definition-ref"}],"outputs":[],"postconditions":["A unit or a pool is removed only when no account names it (LDG-1549).","A removed limit no longer applies to postings committed after the removal, and no entry changes (LDG-016)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"in-use","condition":"An account names the unit or the pool (LDG-1549).","type":"api-error","kind":"conflict"},{"name":"not-found","condition":"No such unit, pool or limit is declared.","type":"api-error","kind":"not_found"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","bffRoute":"POST /api/ledger/remove-definition","deployment":"shipped"},
    {"id":"expire-ledger-credits","name":"Expire the credits of one bucket for a batch of accounts","ref":"CT-812","realisation":"generated","implementedBy":"automation-worker","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"unit","type":"ledger-unit"},{"name":"bucket","type":"timestamp","description":"The start of the period whose credits expire."},{"name":"cursor","type":"ledger-account-id","optional":true},{"name":"at","type":"timestamp"}],"outputs":[{"name":"next","type":"ledger-account-id","optional":true},{"name":"posted","type":"u32"}],"postconditions":["At most one hundred accounts are handled, in one transaction (LDG-1547).","Each account with credit remaining in the bucket receives one entry of minus that amount with the key expiry:<bucket start>, so a repeated batch posts nothing twice (LDG-006, LDG-1547)."],"errors":[],"exposure":"local"},
    {"id":"list-my-segments","name":"List the visible segments one belongs to","ref":"CT-813","realisation":"generated","implementedBy":"gateway","auth":{"scheme":"session","tenantPolicies":true,"description":"A signed-in principal","requires":["segments-read-own"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"}],"outputs":[{"name":"segments","type":"list<segment-summary>"}],"postconditions":["Only segments marked visible to members that hold a membership of the caller are listed (SEG-1540)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","bffRoute":"POST /api/segments/mine","deployment":"shipped"},
    {"id":"count-segment-members","name":"Count the members of a segment","ref":"CT-814","realisation":"generated","implementedBy":"gateway","auth":{"scheme":"session","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["segments-read"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"segment","type":"segment-id"}],"outputs":[{"name":"count","type":"segment-count"}],"postconditions":["The count is of the members whose subject records the reader may read (SEG-1541)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"scan-bound-exceeded","condition":"The reader may not read every subject record and the count would examine more than ten thousand memberships (SEG-1541).","type":"api-error","kind":"invalid"},{"name":"not-found","condition":"The tenant has no such segment.","type":"api-error","kind":"not_found"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","bffRoute":"POST /api/segments/count","deployment":"shipped"},
    {"id":"preview-segment-predicate","name":"Preview a draft segment predicate","ref":"CT-815","realisation":"generated","implementedBy":"gateway","auth":{"scheme":"session","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["segments-define"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"subject-type","type":"object-type-id"},{"name":"predicate","type":"expression"},{"name":"principal-field","type":"field-id","optional":true,"description":"The required unique string field of the subject type that holds the principal (SEG-1548); the field principal when absent."},{"name":"cursor","type":"string","optional":true,"description":"Opaque; the next output of the previous call. The persons after the one it names are evaluated."},{"name":"limit","type":"u32","optional":true,"description":"At most 1000 persons (SEG-1542, D-6555); 1000 when absent."}],"outputs":[{"name":"preview","type":"segment-preview"},{"name":"next","type":"string","optional":true,"description":"The cursor of the following persons; absent when every person has been examined."}],"postconditions":["No state changes (SEG-1542).","Only persons whose subject records the caller may read are evaluated or counted (SEG-1542).","The predicate is refused as define-segment refuses it (SEG-003, SEG-004, SEG-005)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The predicate fails to parse or reads outside what a segment predicate may read.","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","bffRoute":"POST /api/segments/preview","deployment":"shipped"},
    {"id":"resolve-setting-for","name":"Resolve a setting for a recipient","ref":"CT-816","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"service","description":"Service credential of a platform component","requires":["setting-resolve-for"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"principal","type":"principal-id"},{"name":"setting","type":"setting-id"}],"outputs":[{"name":"resolution","type":"setting-resolution"}],"postconditions":["The value is the one setting-resolve gives the principal itself (SET-010, SET-1541).","The value is written to no log, copy or event (SET-1542)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"not-found","condition":"The setting is not defined, or the tenant has no such principal.","type":"api-error","kind":"not_found"}],"exposure":"internal","readOnly":true,"tenantScope":"platform","deployment":"shipped"},
    {"id":"define-trigger","name":"Create or change a trigger","ref":"CT-790","realisation":"generated","implementedBy":"kernel","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["automations-define"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"trigger","type":"trigger-def"}],"outputs":[{"name":"version","type":"u64"}],"postconditions":["The trigger is stored as tenant metadata under the schema version (WFL-1520).","Its event is a variant of trigger-event and its condition parses in the tenant rule language over the parameters its event binds (INT-1522, D-6523).","Every field the condition names is one the policies of the caller permit the caller to read, as D-5028 states for a segment predicate."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"field-forbidden","condition":"The condition names a field that the policies of the caller do not permit the caller to read.","type":"api-error","kind":"forbidden"},{"name":"outside-catalogue","condition":"The event is not a variant of trigger-event (INT-1522).","type":"api-error","kind":"invalid"},{"name":"invalid","condition":"The condition fails to parse (the error carries its position) or names a parameter its event does not bind, or the automation it names does not exist.","type":"api-error","kind":"invalid"},{"name":"limit-reached","condition":"The tenant already holds one hundred triggers.","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request"},
    {"id":"remove-trigger","name":"Remove a trigger","ref":"CT-791","realisation":"generated","implementedBy":"kernel","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["automations-define"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"trigger","type":"trigger-id"}],"outputs":[],"postconditions":["No event committed after the removal starts a run through the trigger; runs it started before continue (D-6539)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request"},
    {"id":"define-automation","name":"Create or change an automation","ref":"CT-792","realisation":"generated","implementedBy":"kernel","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["automations-define"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"automation","type":"automation-def"}],"outputs":[{"name":"version","type":"u64"},{"name":"acting-as","type":"principal-id"}],"postconditions":["The automation is stored as tenant metadata under the schema version as a draft, and activate-workflow activates it after a projection (WFL-002).","Every action is a variant of automation-step and every step it names is a step of the automation (INT-1522).","Every role of its run-as is one the caller may confer under ADM-152, and its automation principal holds exactly those roles (WFL-1527, WFL-1528).","A suspended automation defined again by a caller who may confer every role of its run-as is a draft again (WFL-1529)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"outside-catalogue","condition":"An action is not a variant of automation-step (INT-1522).","type":"api-error","kind":"invalid"},{"name":"run-as-exceeds","condition":"The run-as names a role that the caller may not confer under ADM-152; the error names the role and what the caller lacks (WFL-1528).","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"A step names a step the automation does not declare, a step cannot be reached from start, an expression fails to parse, a retry, timeout, wait or batch is out of its range, the automation has more than 50 steps, or the id is taken by a field workflow.","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request"},
    {"id":"remove-automation","name":"Remove an automation","ref":"CT-793","realisation":"generated","implementedBy":"kernel","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["automations-define"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"automation","type":"workflow-id"}],"outputs":[{"name":"cancelled","type":"u32"}],"postconditions":["Its open runs are cancelled, each with an exception record of reason automation-removed, and its run keys are removed (D-6539)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"conflict","condition":"A trigger still names the automation.","type":"api-error","kind":"conflict"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request"},
    {"id":"list-automation-runs","name":"List automation runs","ref":"CT-794","realisation":"generated","implementedBy":"automation-worker","auth":{"scheme":"session","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["automations-read"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"automation","type":"workflow-id","optional":true},{"name":"state","type":"run-state","optional":true},{"name":"cursor","type":"string","optional":true},{"name":"limit","type":"u32","optional":true}],"outputs":[{"name":"runs","type":"list<automation-run-summary>"},{"name":"next","type":"string","optional":true}],"postconditions":["Each run names its trigger, its hop count, the principal its steps act as and the definer it acts for (WFL-1530, WFL-1531).","Runs come newest first."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","bffRoute":"GET /api/automation/runs","deployment":"shipped"},
    {"id":"list-automation-steps","name":"List the steps of an automation run","ref":"CT-795","realisation":"generated","implementedBy":"automation-worker","auth":{"scheme":"session","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["automations-read"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"run","type":"run-id"},{"name":"cursor","type":"string","optional":true},{"name":"limit","type":"u32","optional":true,"description":"At most 100; 50 when absent."}],"outputs":[{"name":"steps","type":"list<automation-step-summary>"},{"name":"next","type":"string","optional":true}],"postconditions":["Each step shows its state, its attempts, the error of each failed attempt and its typed result (WFL-1531)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The run does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","bffRoute":"GET /api/automation/runs/:run/steps","deployment":"shipped"},
    {"id":"list-automation-exceptions","name":"List declined, held, parked and dead-lettered automation work","ref":"CT-796","realisation":"generated","implementedBy":"automation-worker","auth":{"scheme":"session","tenantPolicies":true,"description":"A principal whose policies permit the operation","requires":["automations-read"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"kind","type":"automation-exception-kind","optional":true},{"name":"unsettled","type":"bool","optional":true},{"name":"cursor","type":"string","optional":true},{"name":"limit","type":"u32","optional":true,"description":"At most 100; 50 when absent."}],"outputs":[{"name":"exceptions","type":"list<automation-exception-summary>"},{"name":"next","type":"string","optional":true}],"postconditions":["Every exception record SCH-1532 requires is listed with its reason until its retention ends.","Entries come newest first."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","bffRoute":"GET /api/automation/exceptions","deployment":"shipped"},
    {"id":"settle-automation-exception","name":"Release or drop a parked or dead-lettered automation exception","ref":"CT-797","realisation":"generated","implementedBy":"automation-worker","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["automations-define"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"exception","type":"identifier"},{"name":"action","type":"exception-action"}],"outputs":[{"name":"job","type":"job-id","optional":true}],"postconditions":["Releasing a parked event offers it to its subscriber again; releasing a dead-lettered step gives it a new attempt with the same idempotency key (SCH-1524, AGT-418).","The exception is marked settled and stays listed until its retention ends (OPS-348)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The exception does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"conflict","condition":"The exception is declined or held, or already settled; or its automation is suspended or removed.","type":"api-error","kind":"conflict"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","bffRoute":"POST /api/automation/exceptions/settle","deployment":"shipped"},
    {"id":"recheck-automation-authority","name":"Check the run-as of the automations a principal defined","ref":"CT-798","realisation":"generated","implementedBy":"kernel","auth":{"scheme":"in-process","description":"Local call inside the platform process; no network credential"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"principal","type":"principal-id"}],"outputs":[{"name":"suspended","type":"list<workflow-id>"}],"postconditions":["Called in the transaction of every change of the roles of a principal, of a team it belongs to, or of the permissions of a role it holds, and of its erasure: every automation it defined whose run-as names a role it may no longer confer is suspended in that transaction (WFL-1529)."],"errors":[],"exposure":"local"},
    {"id":"list-sign-in-providers","name":"List the identity providers the sign-in page offers","ref":"CT-1015","realisation":"generated","implementedBy":"identity-service","bffRoute":"GET /api/sign-in/providers","auth":{"scheme":"anonymous","justification":"The sign-in page lists its providers before any session exists.","description":"Anyone; no session is needed","requires":["identity-sign-in"]},"idempotent":true,"inputs":[],"outputs":[{"name":"providers","type":"json"}],"postconditions":["Each provider is listed with its id, its label and the protocol it is signed in with, oidc or saml; the enabled providers of both protocols are listed and nothing else about them is."],"errors":[{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped"},
    {"id":"start-passkey-registration","name":"Begin adding a passkey","ref":"CT-1016","realisation":"generated","implementedBy":"identity-service","bffRoute":"POST /api/passkeys/register/start","auth":{"scheme":"session","csrf":true,"origin":true,"stepUp":"15 min","description":"A signed-in principal","requires":["account-manage"]},"idempotent":true,"inputs":[],"outputs":[{"name":"challenge","type":"challenge-id"},{"name":"options","type":"bytes"}],"preconditions":["The request carries the request token of the session (GWY-002)."],"postconditions":["The challenge is bound to the session that asked and to the address of the tenant as the relying party, answers once and lapses (IDN-007, IDN-264).","The credentials the person already holds are listed so that the same authenticator is not registered twice.","A repeat adds a challenge and leaves the earlier one to lapse unanswered; it changes no credential and no other state of the account, so repeating the call has the effect of making it once. The answer holds no secret, and no idempotency key is taken."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"conflict","condition":"The person already holds the most passkeys a person may; one must be removed first.","type":"api-error","kind":"conflict"},{"name":"invalid","condition":"The site is not reached by a host name that a passkey can be bound to.","type":"api-error","kind":"invalid"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","tenantScope":"request","deployment":"shipped"},
    {"id":"step-up-session","name":"Authenticate the session again before a sensitive operation","ref":"CT-1017","realisation":"generated","implementedBy":"identity-service","bffRoute":"POST /api/session/step-up","auth":{"scheme":"session","csrf":true,"origin":true,"description":"A signed-in principal","requires":["session-manage"]},"idempotent":true,"inputs":[{"name":"password","type":"secret","optional":true},{"name":"code","type":"secret","optional":true},{"name":"challenge","type":"challenge-id","optional":true},{"name":"assertion","type":"bytes","optional":true}],"outputs":[{"name":"authenticated-at","type":"timestamp"}],"preconditions":["The request carries the request token of the session (GWY-002)."],"postconditions":["Exactly one fresh factor is given: the password, a code of the authenticator or a recovery code, or the assertion of a passkey for the challenge; no other field of the body is passed on.","A factor that is accepted sets the time of the last authentication of the session to now, so that an operation marked sensitive is allowed again for the step-up age (IDN-019).","A password or a passkey assertion that is accepted sets the time of the last authentication to the time of the call, so a repeat leaves the session authenticated, at a later time; a code or a recovery code is spent by the first call, and a repeat with it is refused and changes nothing. Repeating the call has the effect of making it once, and no idempotency key is taken."],"errors":[{"name":"unauthenticated","condition":"No valid session accompanies the request, or the factor was not accepted; the response does not say which.","type":"api-error","kind":"unauthenticated"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"}],"exposure":"public","tenantScope":"request","deployment":"shipped"},
    {"id":"list-factors","name":"Read the second factors of the caller","ref":"CT-1018","realisation":"generated","implementedBy":"identity-service","bffRoute":"GET /api/factors","auth":{"scheme":"session","description":"A signed-in principal","requires":["account-manage"]},"idempotent":true,"inputs":[],"outputs":[{"name":"totp","type":"bool"},{"name":"passkeys","type":"u64"},{"name":"recovery-codes","type":"u64"},{"name":"realm-requires","type":"bool"},{"name":"step-up-age","type":"u64"},{"name":"authenticated-at","type":"timestamp"}],"postconditions":["The answer says whether an authenticator is confirmed, how many passkeys and unspent recovery codes the person holds, whether the tenant requires a second factor, the step-up age in seconds and when the session last authenticated, and holds no secret."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped"},
    {"id":"start-totp-enrolment","name":"Begin adding an authenticator","ref":"CT-1019","realisation":"generated","implementedBy":"identity-service","bffRoute":"POST /api/factors/totp/start","auth":{"scheme":"session","csrf":true,"origin":true,"stepUp":"15 min","description":"A signed-in principal","requires":["account-manage"]},"idempotent":true,"inputs":[],"outputs":[{"name":"secret","type":"secret"},{"name":"uri","type":"secret"},{"name":"digits","type":"u64"},{"name":"period","type":"u64"}],"preconditions":["The request carries the request token of the session (GWY-002)."],"postconditions":["The secret is kept sealed and unconfirmed, and is shown once, in this answer; it counts as a factor only after confirm-totp-enrolment (IDN-018).","While no authenticator is confirmed, a repeat replaces the unconfirmed secret with a new one, and the secret of the earlier answer can no longer be confirmed, so one unconfirmed enrolment exists however often the call is repeated and repeating it has the effect of making it once. The answer holds a secret that is shown once and is never stored to be replayed, so no idempotency key is taken."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"conflict","condition":"An authenticator is already set up; it must be removed before another is added.","type":"api-error","kind":"conflict"}],"exposure":"public","tenantScope":"request","deployment":"shipped"},
    {"id":"confirm-totp-enrolment","name":"Confirm an authenticator with a code","ref":"CT-1020","realisation":"generated","implementedBy":"identity-service","bffRoute":"POST /api/factors/totp/confirm","auth":{"scheme":"session","csrf":true,"origin":true,"stepUp":"15 min","description":"A signed-in principal","requires":["account-manage"]},"idempotent":true,"inputs":[{"name":"code","type":"secret"}],"outputs":[{"name":"enabled","type":"bool"}],"preconditions":["The request carries the request token of the session (GWY-002)."],"postconditions":["A code that matches the unconfirmed secret turns the authenticator on, and a code is accepted once (IDN-018).","The code is accepted once and the enrolment ends with it: a repeat is refused and changes nothing, so the authenticator is turned on once however often the call is repeated and repeating it has the effect of making it once. No idempotency key is taken."],"errors":[{"name":"unauthenticated","condition":"No valid session accompanies the request, or the code was not accepted.","type":"api-error","kind":"unauthenticated"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"}],"exposure":"public","tenantScope":"request","deployment":"shipped"},
    {"id":"remove-totp-factor","name":"Remove the authenticator","ref":"CT-1021","realisation":"generated","implementedBy":"identity-service","bffRoute":"POST /api/factors/totp/remove","auth":{"scheme":"session","csrf":true,"origin":true,"stepUp":"15 min","description":"A signed-in principal","requires":["account-manage"]},"idempotent":true,"inputs":[],"outputs":[{"name":"enabled","type":"bool"}],"preconditions":["The request carries the request token of the session (GWY-002)."],"postconditions":["The authenticator and the recovery codes that stand in for it no longer open a sign-in."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"shipped"},
    {"id":"regenerate-recovery-codes","name":"Issue a new set of recovery codes","ref":"CT-1022","realisation":"generated","implementedBy":"identity-service","bffRoute":"POST /api/factors/recovery-codes","auth":{"scheme":"session","csrf":true,"origin":true,"stepUp":"15 min","description":"A signed-in principal","requires":["account-manage"]},"idempotent":true,"inputs":[],"outputs":[{"name":"codes","type":"list<secret>"},{"name":"left","type":"u64"}],"preconditions":["The request carries the request token of the session (GWY-002)."],"postconditions":["The codes are shown once; only their hashes are kept, and the codes of an earlier set stop working.","A repeat replaces the set the first call made, and the codes of the earlier answer stop working, so one set is valid however often the call is repeated and repeating it has the effect of making it once. The answer holds codes that are shown once and are never stored to be replayed, so no idempotency key is taken."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"conflict","condition":"No authenticator is set up; recovery codes stand in for one.","type":"api-error","kind":"conflict"}],"exposure":"public","tenantScope":"request","deployment":"shipped"},
    {"id":"complete-recovery","name":"Complete an account recovery","ref":"CT-1023","realisation":"generated","implementedBy":"identity-service","bffRoute":"POST /api/recovery/complete","auth":{"scheme":"anonymous","csrf":true,"origin":true,"justification":"Recovery is for a person who cannot sign in; the link of the message is the credential.","description":"Anyone; no session is needed","requires":["identity-sign-in"]},"idempotent":true,"inputs":[{"name":"challenge","type":"challenge-id"},{"name":"token","type":"secret"},{"name":"password","type":"secret"}],"outputs":[{"name":"recovered","type":"bool"},{"name":"second-factor","type":"bool"}],"preconditions":["The request carries an allowed origin and a request token (GWY-002)."],"postconditions":["A recovery completes only after the delay the platform states, and changes the password and ends every session of the account (IDN-020).","The second factor of the account stays in force at the next sign-in (IDN-266); the answer says whether one is set up.","The link is the one-use credential of this change: a repeat after it was used is refused and changes nothing, so the password is changed once however often the call is repeated and repeating it has the effect of making it once. No idempotency key is taken."],"errors":[{"name":"unauthenticated","condition":"The recovery is unknown, not yet due, cancelled, expired or used, or the token does not match; the response does not say which.","type":"api-error","kind":"unauthenticated"},{"name":"invalid","condition":"The new password does not meet the password rules.","type":"api-error","kind":"invalid"},{"name":"conflict","condition":"The recovery was already completed or cancelled.","type":"api-error","kind":"conflict"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"}],"exposure":"public","tenantScope":"request","deployment":"shipped"},
    {"id":"cancel-recovery","name":"Cancel an account recovery","ref":"CT-1024","realisation":"generated","implementedBy":"identity-service","bffRoute":"POST /api/recovery/cancel","auth":{"scheme":"anonymous","csrf":true,"origin":true,"justification":"Whoever holds the notice of a recovery may cancel it, and that person need not be able to sign in.","description":"Anyone; no session is needed","requires":["identity-sign-in"]},"idempotent":true,"inputs":[{"name":"challenge","type":"challenge-id"},{"name":"cancel","type":"secret"}],"outputs":[{"name":"cancelled","type":"bool"}],"preconditions":["The request carries an allowed origin and a request token (GWY-002)."],"postconditions":["A recovery that is cancelled never completes."],"errors":[{"name":"unauthenticated","condition":"The recovery is unknown or the cancel token does not match; the response does not say which.","type":"api-error","kind":"unauthenticated"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"}],"exposure":"public","tenantScope":"request","deployment":"shipped"},
    {"id":"revoke-other-sessions","name":"End every other session of the caller","ref":"CT-1025","realisation":"generated","implementedBy":"identity-service","bffRoute":"POST /api/sessions/revoke-others","auth":{"scheme":"session","csrf":true,"origin":true,"stepUp":"15 min","description":"A signed-in principal","requires":["session-manage"]},"idempotent":true,"inputs":[],"outputs":[{"name":"revoked","type":"u64"}],"preconditions":["The request carries the request token of the session (GWY-002)."],"postconditions":["Every live session of the caller except the one that made the call is revoked at the identity service, and the answer counts them (IDN-012, IDN-019)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"shipped"},
    {"id":"list-identity-clients","name":"List the service accounts of the tenant","ref":"CT-1026","realisation":"generated","implementedBy":"identity-service","bffRoute":"GET /api/identity/clients","auth":{"scheme":"session","description":"The owner of the tenant","requires":["grant-manage"]},"idempotent":true,"inputs":[],"outputs":[{"name":"clients","type":"json"}],"postconditions":["The answer holds the summary of each service account of the tenant and no secret, not even its hash.","The router entry GET /api/identity/*action serves every read of the desk of the identity service; the other read it serves, provisioning/groups, has no contract of its own yet."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped"},
    {"id":"introspect-token-over-http","name":"Introspect a token at the address of the site","ref":"CT-1027","realisation":"generated","implementedBy":"identity-service","bffRoute":"POST /introspect","auth":{"scheme":"signature","secret":"client-secret","description":"A service account presenting its client secret, or the signed-in owner of the site","requires":["session-verify"]},"idempotent":true,"inputs":[{"name":"token","type":"secret"}],"outputs":[{"name":"active","type":"bool"},{"name":"scope","type":"list<string>","optional":true},{"name":"subject","type":"principal-id","optional":true},{"name":"expires-at","type":"timestamp","optional":true}],"postconditions":["The answer is the one of introspect-token, in the form of RFC 7662, and is never cached (TOK-009).","The caller is held to its own credentials; no cookie of a visitor opens it."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped"},
    {"id":"serve-jwks-document","name":"Publish the signing keys at the well-known address","ref":"CT-1028","realisation":"generated","implementedBy":"identity-service","bffRoute":"GET /.well-known/jwks.json","auth":{"scheme":"anonymous","justification":"Relying parties fetch the keys before they hold any credential.","description":"Anyone; no session is needed","requires":["identity-sign-in"]},"idempotent":true,"inputs":[],"outputs":[{"name":"keys","type":"list<public-key>"}],"postconditions":["The document is the one list-signing-keys answers at /keys, at the address that relying parties discover; after a rotation the previous key stays in it until its tokens expire (TOK-008)."],"errors":[{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped"},
    {"id":"accept-site-invitation","name":"Accept the invitation of a new site and choose the first password","ref":"CT-1029","realisation":"generated","implementedBy":"identity-service","bffRoute":"POST /api/invite/accept","auth":{"scheme":"anonymous","csrf":true,"origin":true,"justification":"The owner of a new site has no account yet; the link of the invitation names the account and is the credential.","description":"Anyone; no session is needed","requires":["invitation-redeem"]},"idempotent":true,"inputs":[{"name":"challenge","type":"challenge-id"},{"name":"token","type":"secret"},{"name":"password","type":"secret"}],"outputs":[{"name":"accepted","type":"bool"},{"name":"login","type":"string"}],"preconditions":["The request carries an allowed origin and the request token of a visitor; the link is not bound to a browser (GWY-002)."],"postconditions":["The invitation is used once and sets the password of the account it names; the person signs in with it afterwards.","The link is the one-use credential of this change: a repeat after it was used is refused and changes nothing, so the first password is set once however often the call is repeated and repeating it has the effect of making it once. No idempotency key is taken."],"errors":[{"name":"unauthenticated","condition":"The invitation is unknown, used or expired, or the token does not match; the response does not say which.","type":"api-error","kind":"unauthenticated"},{"name":"invalid","condition":"The password does not meet the password rules.","type":"api-error","kind":"invalid"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"}],"exposure":"public","tenantScope":"request","deployment":"shipped"},
    {"id":"read-lab-overview","name":"Read what the impact lab shows before anything is run","ref":"CT-390","realisation":"generated","implementedBy":"simulator","bffRoute":"GET /api/lab/overview","auth":{"scheme":"session","tenantPolicies":true,"description":"A signed-in person who may change the schema","requires":["change-project"]},"idempotent":true,"inputs":[],"outputs":[{"name":"overview","type":"json"}],"postconditions":["The answer holds the tenant metadata as data, its snapshots, the presets, the evidence classes and the last verification report of the tenant, and nothing of another tenant.","The length of the journal is read as a count without reading its entries, and the answer states how many runs of the tenant the process has dropped, the most it keeps for a tenant, and that runs are held in memory only."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped"},
    {"id":"run-lab-projection","name":"Run a projection of a proposed change in the impact lab","ref":"CT-391","realisation":"generated","implementedBy":"simulator","bffRoute":"POST /api/lab/run","auth":{"scheme":"session","csrf":true,"origin":true,"tenantPolicies":true,"description":"A signed-in person who may change the schema","requires":["change-project"]},"idempotent":false,"inputs":[{"name":"change","type":"string"},{"name":"existing","type":"string"},{"name":"source","type":"string"},{"name":"steps","type":"u64","optional":true},{"name":"seed","type":"u64","optional":true},{"name":"faults","type":"bool","optional":true},{"name":"apply-at","type":"u64","optional":true},{"name":"revision","type":"u64","optional":true,"description":"The revision of the tenant the projection is taken at; the current revision when absent (AGT-422)."},{"name":"require-current","type":"bool","optional":true,"description":"Refuse with a conflict naming the current revision when the tenant is not at the named revision."},{"name":"idempotency-key","type":"string","optional":true,"description":"At most 128 bytes. A repeat with the same key and the same input answers the first run and starts nothing; the same key with other input is refused with idempotency-mismatch (D-6595). Honoured for 24 hours, in the backend process that started the run."}],"outputs":[{"name":"run","type":"string"},{"name":"revision","type":"u64"},{"name":"current-revision","type":"u64"}],"preconditions":["The request carries the request token of the session (GWY-002)."],"postconditions":["The change is the proposal syntax; existing is reject or grandfather, and source is generated or journal.","The projection runs in the background on a copy of the tenant, nothing of the live tenant changes, and its result is read with read-lab-run; the run starts only while the tenant has fewer projections running or waiting than its limit and the queue has room.","The projection starts from the recorded history of the tenant at the revision the request names, or at the current revision when it names none: from the live state when that revision is the current one, otherwise from the journal replayed to it; the answer and the result state the revision it was computed at (AGT-422).","A request that sets require-current and names a revision other than the current one is refused with a conflict that names the current revision, and nothing runs (AGT-422).","Each call without an idempotency key starts a run of its own, limited by the runs the tenant already has; a call with one starts a run once for that key, tenant and person within 24 hours, a repeat with the same request answers the first answer without starting another run, and the same key with another request is refused as idempotency-mismatch (D-6595). The keys, like the runs, are held in the backend process: a restart forgets both."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The change does not parse, existing or source is not one of its values, or the revision is one the tenant has not reached.","type":"api-error","kind":"invalid"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"},{"name":"unavailable","condition":"A dependency of the operation did not answer, or the recorded history up to the named revision does not replay under this kernel.","type":"api-error","kind":"unavailable"},{"name":"conflict","condition":"The request sets require-current and the tenant is not at the revision it names; the answer names the current revision and nothing runs (AGT-422).","type":"api-error","kind":"conflict"},{"name":"not-found","condition":"The recorded history has no such revision.","type":"api-error","kind":"not_found"},{"name":"idempotency-mismatch","condition":"The key was used by this caller for another request.","type":"api-error","kind":"invalid"}],"exposure":"public","tenantScope":"request","deployment":"shipped"},
    {"id":"read-lab-run","name":"Read the state and result of a projection of the impact lab","ref":"CT-392","realisation":"generated","implementedBy":"simulator","bffRoute":"GET /api/lab/runs/:id","auth":{"scheme":"session","tenantPolicies":true,"description":"A signed-in person who may change the schema","requires":["change-project"]},"idempotent":true,"inputs":[{"name":"id","type":"string"}],"outputs":[{"name":"id","type":"string"},{"name":"status","type":"string"},{"name":"summary","type":"json"},{"name":"result","type":"json"},{"name":"retention","type":"string"}],"postconditions":["A run is found only by the tenant that started it; another tenant is told that there is no such run.","A result is held in the memory of the backend process only: the answer states so, a restart loses it, and a tenant keeps its last 12 runs."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"There is no such run for this tenant, or the backend process no longer holds it; the answer says that results are held in memory and how many are kept.","type":"api-error","kind":"not_found"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped"},
    {"id":"replay-lab-journal","name":"Replay the journal of the tenant against its live state","ref":"CT-393","realisation":"generated","implementedBy":"simulator","bffRoute":"POST /api/lab/replay","auth":{"scheme":"session","csrf":true,"origin":true,"tenantPolicies":true,"description":"A signed-in person who may change the schema","requires":["change-project"]},"idempotent":true,"inputs":[],"outputs":[{"name":"report","type":"json"},{"name":"live-revision","type":"u64"},{"name":"class","type":"string"},{"name":"establishes","type":"string"}],"preconditions":["The request carries the request token of the session (GWY-002)."],"postconditions":["Every committed transition of the tenant is run again through the kernel with its recorded context, and the report says whether each reproduces its recorded state delta and events and whether the result is the live state (SIM-004)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","tenantScope":"request","deployment":"shipped"},
    {"id":"verify-lab-proofs","name":"Build the Lean project and audit its proofs for the impact lab","ref":"CT-394","realisation":"generated","implementedBy":"simulator","bffRoute":"POST /api/lab/verify","auth":{"scheme":"session","csrf":true,"origin":true,"tenantPolicies":true,"roles":["owner"],"description":"The signed-in owner of the site who may change the schema, in a backend started for development","requires":["change-project"]},"idempotent":true,"inputs":[],"outputs":[{"name":"run","type":"string"}],"preconditions":["The request carries the request token of the session (GWY-002)."],"postconditions":["The backend answers not found unless it was started for development (RUN-1386).","The build runs in the background, one at a time on the whole backend and at most one per verification interval for each tenant; its report arrives over the socket and is kept for the overview.","The build changes nothing of the tenant: a repeat runs the same check again, within the interval that limits it, so no idempotency key is taken."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The backend was not started for development.","type":"api-error","kind":"not_found"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"}],"exposure":"public","tenantScope":"request","development":"STRATA_DEV","deployment":"shipped"},
    {"id":"read-diagnostics","name":"Read the diagnostics of the tenant","ref":"CT-395","realisation":"generated","implementedBy":"gateway","bffRoute":"GET /api/diagnostics","auth":{"scheme":"session","tenantPolicies":true,"description":"A signed-in person who may change the schema","requires":["diagnostics-run"]},"idempotent":true,"inputs":[],"outputs":[{"name":"backend","type":"json"}],"postconditions":["The answer holds the sessions, connections, outbox backlog and counters of the tenant of the request, and contains no other tenant's identifier and no count or health detail that spans tenants (RUN-1381).","The gateway adds none of its own socket or in-flight counts, which span every tenant."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"}],"exposure":"public","readOnly":true,"tenantScope":"request","deployment":"shipped"},
    {"id":"run-development-action","name":"Run a development fixture action","ref":"CT-396","realisation":"generated","implementedBy":"gateway","bffRoute":"POST /api/dev/:action","auth":{"scheme":"session","csrf":true,"origin":true,"roles":["owner"],"description":"The signed-in owner of the site; any signed-in person for age-authentication, which touches only that person's own session","requires":["site-configure"]},"idempotent":true,"inputs":[{"name":"action","type":"string"}],"outputs":[{"name":"result","type":"json"}],"preconditions":["The request carries the request token of the session of the caller; the token handed to a visitor without a session opens nothing here."],"postconditions":["The action is one of expire-session, age-authentication, reset and mail-outbox; any other is answered not found.","The route is served only by a gateway and a backend both started for development with STRATA_DEV set to 1, and the backend routes behind it exist only in a build made with the development cargo feature (RUN-1382).","A repeat of an action leaves the state the first one left (reset puts the fixtures back, expire-session and age-authentication set the session to a stated state, mail-outbox only reads), so no idempotency key is taken."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The service was not started for development, or the action is not one of those it offers.","type":"api-error","kind":"not_found"}],"exposure":"public","tenantScope":"request","development":"STRATA_DEV","deployment":"shipped","conformanceExample":"{\"action\": \"mail-outbox\"}"},
    {"id":"accept-owner-invitation","name":"Accept the invitation of a new tenant's owner","ref":"CT-1060","realisation":"generated","implementedBy":"identity-service","auth":{"scheme":"anonymous","csrf":true,"origin":true,"justification":"The owner of a new tenant has no password yet; the invitation link, which only the operator's message holds, names the account.","description":"Anyone who holds the link; no session is needed","requires":["identity-sign-in"]},"idempotent":false,"inputs":[{"name":"challenge","type":"string"},{"name":"token","type":"string"},{"name":"password","type":"string"}],"outputs":[{"name":"accepted","type":"bool"},{"name":"login","type":"string"}],"postconditions":["The invitation is accepted once, within seven days of its making, from the origin of the site it was made for, in whatever browser opens it (IDN-1680, IDN-1682).","Accepting replaces the password of the owner's account with the one chosen and signs nobody in (IDN-1680).","A refused attempt counts against the limits of the invitation, the source and the realm and does not spend the invitation (IDN-1682).","The answer is the same for an unknown, a used, an expired and a foreign-origin invitation, so it does not say which part was wrong."],"errors":[{"name":"unauthenticated","condition":"The invitation is unknown, used, expired, has another token or is presented from another origin; the response does not say which (IDN-1682).","type":"api-error","kind":"unauthenticated"},{"name":"invalid","condition":"The password is shorter than ten characters or longer than 256 bytes.","type":"api-error","kind":"invalid"},{"name":"throttled","condition":"The caller exceeded a limit that applies to it.","type":"api-error","kind":"throttled"}],"exposure":"public","tenantScope":"request","bffRoute":"POST /api/invite/accept","deployment":"target"},
    {"id":"withdraw-invitation","name":"Revoke an invitation","ref":"CT-1135","realisation":"generated","implementedBy":"gateway","bffRoute":"POST /api/members/revoke-invitation","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A signed-in person whose tenant policies let them manage members","requires":["members-manage"],"stepUp":"15 min"},"idempotent":false,"timeoutMs":10000,"inputs":[{"name":"invitation","type":"invitation-id"},{"name":"idempotency-key","type":"string","optional":true,"description":"At most 128 bytes. A repeat with the same key and the same input returns the stored result and changes nothing; the same key with other input is refused with idempotency-mismatch (D-6595). Needs a signed-in caller; honoured for 24 hours."}],"outputs":[{"name":"revision","type":"u64"},{"name":"event-seq","type":"u64"}],"preconditions":["The request carries the request token of the session (GWY-002)."],"postconditions":["The invitation is marked with the person who revoked it and is never redeemed afterwards; the roles it offered stay with nobody (ADM-1083).","The call is refused unless the caller holds every permission and capability each role of the invitation grants (ADM-152, ADM-1083).","An invitation that was redeemed or revoked already is not changed."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller may not manage members, or the invitation offers a role whose permissions and capabilities the caller does not hold in full; the failed check names the role (ADM-152).","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The invitation is unknown, was redeemed already or was revoked already.","type":"api-error","kind":"invalid"},{"name":"unavailable","condition":"A dependency of the operation did not answer.","type":"api-error","kind":"unavailable"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"idempotency-mismatch","condition":"The key was used by this caller for another request.","type":"api-error","kind":"invalid"}],"exposure":"public","tenantScope":"request","deployment":"shipped"},
    {"id":"list-erasure-receipts","name":"List the erasure receipts of a tenant","ref":"CT-1495","realisation":"generated","implementedBy":"subject-rights-service","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["subject-rights"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"}],"outputs":[{"name":"receipts","type":"list<erasure-receipt>"}],"postconditions":["The receipts of the erasures of the tenant are returned, newest first, at most one hundred, each as it was written when the erasure ended (PRV-353)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller does not own the tenant.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","bffRoute":"POST /api/subject-rights/erasure-receipts","deployment":"shipped"},
    {"id":"create-webhook-subscription","name":"Create an outbound webhook subscription","ref":"CT-1630","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the operation","requires":["webhooks-manage"]},"idempotent":false,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"target","type":"url"}],"outputs":[{"name":"subscription","type":"identifier"},{"name":"secret","type":"secret"}],"postconditions":["The target is an https address on port 443 with no user name, password or fragment and no host of the platform's own network (WFL-1579); the addresses it resolves to are judged at every delivery (WFL-250).","The secret is returned once and stored sealed, bound to the tenant and the subscription (WFL-010, D-7641).","A call-webhook step that names the subscription queues a signed delivery to the target (WFL-010)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The target is outside the outbound rule (WFL-1579).","type":"api-error","kind":"invalid"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","bffRoute":"POST /api/webhooks/subscriptions","deployment":"shipped"},
    {"id":"rotate-webhook-subscription-secret","name":"Rotate the secret of an outbound webhook subscription","ref":"CT-1631","realisation":"generated","implementedBy":"runtime","auth":{"scheme":"session","tenantPolicies":true,"csrf":true,"origin":true,"description":"A principal whose policies permit the operation","requires":["webhooks-manage"]},"idempotent":false,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"subscription","type":"identifier"}],"outputs":[{"name":"secret","type":"secret"},{"name":"previous-valid-until","type":"timestamp"}],"postconditions":["The new secret is returned once; for 24 hours each delivery carries a signature under the new and under the previous secret, and then under the new one only (INT-2640).","A second rotation inside the overlap retires the oldest secret at once."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller holds no permission for the operation.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"The subscription does not exist for this tenant.","type":"api-error","kind":"not_found"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","bffRoute":"POST /api/webhooks/subscriptions/rotate","deployment":"shipped"},
    {"id":"fetch-subject-export","name":"Fetch the export of one principal","ref":"CT-1708","realisation":"generated","implementedBy":"subject-rights-service","auth":{"scheme":"session","csrf":true,"origin":true,"description":"The person the data concerns, or an owner of the tenant","requires":["subject-rights"],"stepUp":"15 min"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"export","type":"archive-ref"}],"outputs":[{"name":"state","type":"string","description":"queued, ready or failed."},{"name":"expires-at","type":"timestamp"},{"name":"document","type":"value-map","optional":true,"description":"The export, once ready."}],"postconditions":["The document is delivered only to the person it concerns or to an owner of the tenant, each after a step-up, and each fetch is an audit entry that names the tenant and the export (PRV-2741).","After seven days from the request the export is removed and the call answers not-found (PRV-2741)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller is neither the person the export concerns nor an owner of the tenant.","type":"api-error","kind":"forbidden"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"No such export in this tenant, or it has expired.","type":"api-error","kind":"not_found"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","bffRoute":"POST /api/subject-rights/export-fetch","deployment":"shipped"},
    {"id":"lift-subject-restriction","name":"Lift the restriction of one principal","ref":"CT-1705","realisation":"generated","implementedBy":"subject-rights-service","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["subject-rights"],"stepUp":"15 min"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"principal","type":"principal-id"}],"outputs":[{"name":"lifted","type":"bool"}],"postconditions":["The restriction is removed; the personal fields of the principal are shown by views again and the retention sweep treats its records as any other (PRV-352, PRV-2742)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller does not own the tenant.","type":"api-error","kind":"forbidden"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","bffRoute":"POST /api/subject-rights/lift-restriction","deployment":"shipped"},
    {"id":"release-legal-hold","name":"Release a legal hold","ref":"CT-1706","realisation":"generated","implementedBy":"subject-rights-service","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["subject-rights"],"stepUp":"15 min"},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"},{"name":"hold","type":"hold-id"}],"outputs":[{"name":"released-at","type":"timestamp"}],"postconditions":["The hold no longer suspends erasure or retention; it stays listed with the time it was released (PRV-355, PRV-2743)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller does not own the tenant.","type":"api-error","kind":"forbidden"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"not-found","condition":"No such hold in this tenant.","type":"api-error","kind":"not_found"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","bffRoute":"POST /api/subject-rights/release-hold","deployment":"shipped"},
    {"id":"list-legal-holds","name":"List the legal holds of a tenant","ref":"CT-1707","realisation":"generated","implementedBy":"subject-rights-service","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"description":"An owner of the tenant","requires":["subject-rights"]},"idempotent":true,"inputs":[{"name":"tenant","type":"tenant-id"}],"outputs":[{"name":"holds","type":"value-map"}],"postconditions":["The holds of the tenant are returned, active and released, newest first, each with its scope, reason, time and the time it was released (PRV-355)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller does not own the tenant.","type":"api-error","kind":"forbidden"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","readOnly":true,"tenantScope":"request","bffRoute":"POST /api/subject-rights/holds","deployment":"shipped"},
    {"id":"apply-lab-change","name":"Apply the change a projection of the impact lab showed","ref":"CT-1855","realisation":"generated","implementedBy":"simulator","bffRoute":"POST /api/lab/apply","auth":{"scheme":"session","roles":["owner"],"csrf":true,"origin":true,"stepUp":"15 min","description":"An owner of the tenant","requires":["change-project"]},"idempotent":false,"inputs":[{"name":"run","type":"string","optional":true,"description":"The id of a finished projection of the impact lab; its change, its handling of existing records and the revision it was taken at are the ones applied."},{"name":"change","type":"string","optional":true,"description":"Instead of a run: the change in the proposal syntax."},{"name":"existing","type":"string","optional":true,"description":"With change: reject or grandfather."},{"name":"revision","type":"u64","optional":true,"description":"With change: the revision of the tenant the projection was taken at."},{"name":"schema-version","type":"schema-version","optional":true,"description":"With change: the schema version at that revision; the current one when absent."}],"outputs":[{"name":"version","type":"schema-version"},{"name":"revision","type":"u64"}],"preconditions":["The request carries the request token of the session (GWY-002)."],"postconditions":["The change of the projection is committed as one change of the schema with expected-version set to the schema version of the projection, and only while the tenant is still at the revision the projection was taken at (AGT-2940).","A tenant at another revision, whether when the request is read or when the commit is made, is refused with a conflict that names the revision it is at; nothing is committed, and the change is not decided again on the newer state (AGT-2940, D-7940).","A projection is applied once: after the first apply the tenant is at a newer revision, and a second apply of the same projection is refused as stale.","The call is an audit entry of the tenant that names the run, the revision of the projection, the new revision and the new schema version.","The call is refused unless the caller is an owner of the tenant with an authentication that is not older than the step-up age (D-6201, IDN-019)."],"errors":[{"name":"unauthenticated","condition":"No valid session or credential accompanies the request.","type":"api-error","kind":"unauthenticated"},{"name":"forbidden","condition":"The caller is not an owner of the tenant.","type":"api-error","kind":"forbidden"},{"name":"step-up-required","condition":"The last authentication of the session is older than the step-up age, or the session now appears from another network context than the one that authenticated it, and the person has not authenticated again (D-6201, IDN-019). The call changes nothing.","type":"api-error","kind":"forbidden"},{"name":"invalid","condition":"The change does not parse, existing is not reject or grandfather, or the request names neither a run nor a change with its revision.","type":"api-error","kind":"invalid"},{"name":"not-found","condition":"The run is not held by this backend process: its results are lost when it restarts.","type":"api-error","kind":"not_found"},{"name":"conflict","condition":"The tenant is not at the revision the projection was taken at, or the run has not finished; the answer names the current revision and the tenant is left unchanged (AGT-2940).","type":"api-error","kind":"conflict"},{"name":"tenant-mismatch","condition":"A tenant input names a tenant other than the one resolved from the host and session; the request is refused, recorded as an audit entry and raised as an alert to the platform operators (TEN-1140, THR-259).","type":"api-error","kind":"forbidden"}],"exposure":"public","tenantScope":"request","deployment":"shipped"}
  ],
  "decisions": [
    {"id":"d-1","title":"One PostgreSQL database per tenant","statement":"**One PostgreSQL database per tenant.** Each tenant has one PostgreSQL database, grouped in clusters. The SQLite adapter stays for single-process local use, tests and simulation, and keeps the same boundary: a control database holds the tenant directory, and each tenant has a database file of its own (TEN-001, WG-4950). A tenant is the unit of backup, restore, move, export, key and deletion.","group":"Tenancy","decided":"2026-11-18","ref":"D-1"},
    {"id":"d-2","title":"A control plane with its own database","statement":"**A control plane with its own database.** A control plane owns the tenant directory (tenants, placements, domain bindings), provisioning, moves and the wake index. Its database holds identifiers, states and addresses, and no tenant content (K-2).","group":"Tenancy","decided":"2026-11-18","ref":"D-2"},
    {"id":"d-3","title":"An identity realm per tenant, stored in the tenant database","statement":"**An identity realm per tenant, stored in the tenant database.** A tenant's principals, credentials, provider configurations, sessions and audit entries live in that tenant's database, so isolation, residency, export and deletion of identity follow the tenant. Platform operators have a realm of their own in the control database. A person who works in two tenants has two principals, which a shared identity provider may link (D-500).","group":"Identity","decided":"2026-11-18","ref":"D-3"},
    {"id":"d-4","title":"The identity service signs, everything else verifies","statement":"**The identity service signs, everything else verifies.** The identity service is the only holder of credentials. It gives the gateway a short-lived signed assertion for each request's session, and gives service accounts and agents signed access tokens. Other components verify signatures against published keys and never see a credential.","group":"Identity","decided":"2026-11-18","ref":"D-4"},
    {"id":"d-5","title":"Sessions are opaque and held by the platform","statement":"**Sessions are opaque and held by the platform.** A browser session is a random secret in an HttpOnly cookie (K-16). The session itself is a record that can be listed and revoked. Signed tokens are used only between components and for non-browser callers, with lifetimes short enough that revocation needs no list.","group":"Identity","decided":"2026-11-18","ref":"D-5"},
    {"id":"d-6","title":"The address selects the realm, the email domain selects the provider","statement":"**The address selects the realm, the email domain selects the provider.** The host name of a request selects the tenant and so the realm. Within a realm an email domain can be bound to an identity provider, and then that provider is the only way in for addresses in the domain.","group":"Identity","decided":"2026-11-18","ref":"D-6"},
    {"id":"d-7","title":"OpenID Connect by authorization code with a proof key","statement":"**OpenID Connect by authorization code with a proof key.** As a relying party the identity service uses the authorization code flow with a proof key, a state value and a nonce, and verifies issuer, audience, signature and nonce of the identity token.","group":"Identity","decided":"2026-11-18","ref":"D-7"},
    {"id":"d-8","title":"SAML started by the service provider","statement":"**SAML started by the service provider.** SAML sign-in starts at the platform. A response is accepted when it answers a pending request and its assertion is signed by a certificate the tenant configured. Sign-in started by the provider is off unless a tenant turns it on.","group":"Identity","decided":"2026-11-18","ref":"D-8"},
    {"id":"d-9","title":"Emailed links are single-use and bound to the requesting browser","statement":"**Emailed links are single-use and bound to the requesting browser.** A sign-in link carries a random token stored as a hash, is accepted once, expires fifteen minutes after it was sent and is accepted only in the browser that asked for it. The answer to a request for a link is the same whether or not the address has an account.","group":"Identity","decided":"2026-11-18","ref":"D-9"},
    {"id":"d-10","title":"Job state lives with the tenant, a wake index lives with the control plane","statement":"**Job state lives with the tenant, a wake index lives with the control plane.** Jobs, schedules and workflow runs are records in the tenant database, written in the same transaction as the change that caused them. The control database holds only a wake index: tenant and next due time. Workers read the index to find tenants with due work, so idle tenants cost nothing.","group":"Automation","decided":"2026-11-18","ref":"D-10"},
    {"id":"d-11","title":"Leases with fencing tokens","statement":"**Leases with fencing tokens.** A worker takes a job under a lease with a token that rises on every grant. The tenant database refuses a result that carries a superseded token (K-17), so a stalled worker cannot overwrite the work of its replacement.","group":"Automation","decided":"2026-11-18","ref":"D-11"},
    {"id":"d-12","title":"At least once, made once by idempotency keys","statement":"**At least once, made once by idempotency keys.** Jobs are attempted at least once. Each external effect carries an idempotency key derived from the job and step, and the adapter that carries it out records the key with the outcome.","group":"Automation","decided":"2026-11-18","ref":"D-12"},
    {"id":"d-13","title":"Workflow steps are kernel decisions","statement":"**Workflow steps are kernel decisions.** A workflow is a state machine held as tenant metadata. Each step is decided by the kernel from the run's recorded state and returns effect descriptions (K-9), so a run is replayable and a workflow can be projected before it is activated.","group":"Automation","decided":"2026-11-18","ref":"D-13"},
    {"id":"d-14","title":"A copy is keyed by the versions it was computed from","statement":"**A copy is keyed by the versions it was computed from.** The key of a stored copy contains the tenant, what was asked, the audience class, the schema version and the revision of each object type the answer depends on. A change makes a new key instead of racing an old entry. A lifetime is kept only as a backstop.","group":"Delivery","decided":"2026-11-18","ref":"D-14"},
    {"id":"d-15","title":"Audience classes come from the kernel","statement":"**Audience classes come from the kernel.** The kernel derives from a tenant's policies which principals are indistinguishable for a read: the audience class. Copies are stored per class, never per person unless the policy itself reads the principal.","group":"Delivery","decided":"2026-11-18","ref":"D-15"},
    {"id":"d-16","title":"The content delivery network is keyed by host and purged by surrogate key","statement":"**The content delivery network is keyed by host and purged by surrogate key.** Every response for a tenant is keyed by its host name. Published pages carry surrogate keys naming the tenant and the records they were rendered from, and an outbox consumer purges those keys when a change commits.","group":"Delivery","decided":"2026-11-18","ref":"D-16"},
    {"id":"d-17","title":"Three tiers of copy","statement":"**Three tiers of copy.** Schema and compiled expressions are kept in process, keyed by schema version. View results are kept in a shared copy store. Public pages and media are kept at the content delivery network. Each tier is described in the copy class table.","group":"Delivery","decided":"2026-11-18","ref":"D-17"},
    {"id":"d-18","title":"One operation catalogue for people and agents","statement":"**One operation catalogue for people and agents.** Every capability is an operation with a name, an input schema and a description, generated from platform code and tenant metadata. The authoring application, the command line and the Model Context Protocol server are all clients of the same catalogue.","group":"Agents","decided":"2026-11-18","ref":"D-18"},
    {"id":"d-19","title":"Risky changes go through proposals","statement":"**Risky changes go through proposals.** A change that tenant policy classes as risky is made as a proposal: the change, its projection against recorded history, and an approval. A proposal is applied only at the revision it was projected against.","group":"Agents","decided":"2026-11-18","ref":"D-19"},
    {"id":"d-20","title":"An audit log chained by hash, per tenant","statement":"**An audit log chained by hash, per tenant.** Each tenant database holds an append-only audit log in which every entry contains the hash of the one before. The control database holds the same for platform operations. Operational telemetry is separate and carries no record content.","group":"Observability","decided":"2026-11-18","ref":"D-20"},
    {"id":"d-21","title":"OpenTelemetry everywhere","statement":"**OpenTelemetry everywhere.** Every component exports traces, metrics and logs through the OpenTelemetry protocol with the correlation identifier of the request and the tenant identifier.","group":"Observability","decided":"2026-11-18","ref":"D-21"},
    {"id":"d-22","title":"Containers locally","statement":"**Containers locally.** The local stack is a compose file: the platform components, PostgreSQL, an object store, a copy store, a mail catcher, a test identity provider and a telemetry collector. This replaces the prototype's rule against containers.","group":"Platform","decided":"2026-11-18","ref":"D-22"},
    {"id":"d-23","title":"Amazon Web Services first, one region per tenant","statement":"**Amazon Web Services first, one region per tenant.** The first cloud profile uses managed containers, managed PostgreSQL, object storage, a managed copy store, a content delivery network, a key service and a mail service, created from version-controlled infrastructure definitions. A tenant has one primary region.","group":"Platform","decided":"2026-11-18","ref":"D-23"},
    {"id":"d-24","title":"Seams are traits with conformance suites","statement":"**Seams are traits with conformance suites.** Each infrastructure dependency is a Rust trait written in the platform's terms, with a conformance suite, a local adapter and a cloud adapter, as the store contract already is.","group":"Platform","decided":"2026-11-18","ref":"D-24"},
    {"id":"d-25","title":"Envelope encryption per tenant","statement":"**Envelope encryption per tenant.** Each tenant has a data key wrapped by the key service. Destroying the wrapped key is how a deleted tenant's backups become unreadable.","group":"Platform","decided":"2026-11-18","ref":"D-25"},
    {"id":"d-26","title":"One specification, two tools","statement":"**One specification, two tools.** The specification is one Exegra JSONC file. Exegra validates it, evaluates structural and data claims, and runs the behaviour models. Concordance renders its requirements, lints them and reconciles them with code and recorded test results. A milestone is started in the gate when work on it begins.","group":"Assurance","decided":"2026-11-18","ref":"D-26"},
    {"id":"d-27","title":"The prototype's services become the gateway and the runtime","statement":"**The prototype's services become the gateway and the runtime.** The backend-for-frontend becomes the gateway. The backend becomes the runtime. Sign-in, sessions and password handling move out of the runtime into the identity service.","group":"Platform","decided":"2026-11-18","ref":"D-27"},
    {"id":"d-100","title":"Directory reads survive a control plane outage","statement":"**Directory reads survive a control plane outage.** Gateways and runtimes hold directory entries and answer reads for a tenant from them while the control plane cannot be reached. State changes are refused while the control plane cannot be reached (ARC-100). The age of the entry served is stated, so a reader can tell how old the answer is (ARC-100).","group":"Tenancy","decided":"2026-11-18","ref":"D-100"},
    {"id":"d-101","title":"Cross-tenant reporting is fed, not queried","statement":"**Cross-tenant reporting is fed, not queried.** Operator reports over many tenants read telemetry, summaries that tenants publish, and the tenant directory. Nothing reaches into a tenant database from outside it (ARC-110).","group":"Observability","decided":"2026-11-18","ref":"D-101"},
    {"id":"d-102","title":"Outbox delivery is a job","statement":"**Outbox delivery is a job.** Events that a commit leaves unpublished are published by a job in the tenant database. A runtime that stops after its commit therefore does not strand them (ARC-105).","group":"Automation","decided":"2026-11-18","ref":"D-102"},
    {"id":"d-103","title":"Modules extend the platform as tenant metadata","statement":"**Modules extend the platform as tenant metadata.** A product feature is a module: record types, views, workflows and tenant operations written as tenant metadata and installed through kernel intents. A module brings no code of its own (NG-3); what it cannot express as metadata is a platform feature, added to the platform specification (D-6546). A module reaches tenant data through the runtime alone (ARC-112, ARC-113).","group":"Platform","decided":"2026-11-18","ref":"D-103"},
    {"id":"d-150","title":"Environments are tenants","statement":"**Environments are tenants.** A staging environment and a sandbox are tenants of their own, each with its own database, identity realm and key. A tenant records its kind, and a staging tenant names the production tenant it serves (ADM-157).","group":"Tenancy","decided":"2026-11-18","ref":"D-150"},
    {"id":"d-151","title":"Staging promotes configuration, not content","statement":"**Staging promotes configuration, not content.** A promotion carries tenant metadata through a proposal to production. Records of content stay with the tenant they were written in, and move by export and import (CMS-172).","group":"Platform","decided":"2026-11-18","ref":"D-151"},
    {"id":"d-152","title":"Delivery keys are service accounts with a delivery scope","statement":"**Delivery keys are service accounts with a delivery scope.** A headless application reads published content with a service account that names one site and one audience class, and the identity service revokes it like any other grant.","group":"Identity","decided":"2026-11-18","ref":"D-152"},
    {"id":"d-153","title":"Search and forms live in the tenant's own storage","statement":"**Search and forms live in the tenant's own storage.** The search index of a tenant is built from its own records, and a form submission is a record of its tenant. Neither is a shared service that holds several tenants.","group":"Tenancy","decided":"2026-11-18","ref":"D-153"},
    {"id":"d-154","title":"Billing exports usage and charges nothing","statement":"**Billing exports usage and charges nothing.** The platform counts metered quantities per tenant and sends signed usage documents to the billing system the tenant names. Prices, invoices and payment stay outside the platform (NG-152).","group":"Platform","decided":"2026-11-18","ref":"D-154"},
    {"id":"d-200","title":"The assistant is a client of the operation catalogue","statement":"**The assistant is a client of the operation catalogue.** The conversation service runs every change through the operations that a direct edit calls, with a delegated token that names the person (TOK-003). It holds no operation of its own, and its token grants no permission that the person lacks (TOK-004).","group":"Agents","decided":"2026-11-18","ref":"D-200"},
    {"id":"d-201","title":"Every change is previewed and confirmed","statement":"**Every change is previewed and confirmed.** The assistant shows each change as a preview and applies it only when the person confirms that preview. A risky change becomes a proposal (D-19). Undo is the inverse operation, previewed and confirmed in the same way.","group":"Agents","decided":"2026-11-18","ref":"D-201"},
    {"id":"d-202","title":"The model provider is a seam","statement":"**The model provider is a seam.** Model calls go through a contract with a conformance suite (D-24) and a local adapter that runs without cloud credentials (K-10). The platform offers one provider (D-514), and which tenant content it may receive is set by the tenant's policy and subprocessor list.","group":"Agents","decided":"2026-11-18","ref":"D-202"},
    {"id":"d-203","title":"The conversation is tenant data","statement":"**The conversation is tenant data.** Turns, pending actions and their evidence are records in the tenant database (K-2), read and written through the store contract. The browser holds no transcript.","group":"Agents","decided":"2026-11-18","ref":"D-203"},
    {"id":"d-204","title":"Interfaces are rendered from definitions","statement":"**Interfaces are rendered from definitions.** A reply shows an interface by naming a view definition and structured blocks. The model writes no markup, script or style (K-12).","group":"Content","decided":"2026-11-18","ref":"D-204"},
    {"id":"d-205","title":"The browser reaches the assistant through the gateway","statement":"**The browser reaches the assistant through the gateway.** Conversation requests and their streams pass through the gateway, which carries the person's session (K-6). The conversation service has no address that a browser can reach.","group":"Platform","decided":"2026-11-18","ref":"D-205"},
    {"id":"d-250","title":"Session cookies are host-only","statement":"**Session cookies are host-only.** The session cookie is set without a domain attribute, carries the host name prefix and the attribute that limits it to encrypted connections, and is read only by the host that set it. A tenant host cannot give a cookie to a parent domain or to a sibling host.","group":"Identity","decided":"2026-11-18","ref":"D-250"},
    {"id":"d-251","title":"Tenant files come from the file domain","statement":"**Tenant files come from the file domain.** Uploaded files are delivered from the file domain of the platform under a sandboxed policy, and not from a tenant host name.","group":"Content","decided":"2026-11-18","ref":"D-251"},
    {"id":"d-252","title":"Throttles at three levels","statement":"**Throttles at three levels.** Password attempts are throttled per account, per source and per realm, and across the platform, each level with its own counter.","group":"Identity","decided":"2026-11-18","ref":"D-252"},
    {"id":"d-253","title":"Break-glass access is time-limited and consented","statement":"**Break-glass access is time-limited and consented.** An operator reads tenant content in an emergency only under a grant that names the tenant, the purpose and the person, and that ends at its own expiry.","group":"Platform","decided":"2026-11-18","ref":"D-253"},
    {"id":"d-254","title":"Outbound addresses are judged where they are used","statement":"**Outbound addresses are judged where they are used.** A connector resolves the address it calls, judges the resolved address under the outbound rule, and connects to that address and to no other.","group":"Platform","decided":"2026-11-18","ref":"D-254"},
    {"id":"d-350","title":"Erasure by destroying the key of the subject","statement":"**Erasure by destroying the key of the subject.** Each personal field is sealed under a key held for its subject. Erasing the subject destroys that key, which makes every copy, backup and journal entry of the field unreadable without rewriting history. The audit chain and the event journal hash the sealed form, so a destroyed key breaks no link.","group":"Privacy","decided":"2026-11-18","ref":"D-350"},
    {"id":"d-351","title":"Backups and exports expire on a schedule","statement":"**Backups and exports expire on a schedule.** Backup images and tenant exports are encrypted under the tenant key and removed at the end of a retention period that the tenant policy sets. Erasure reaches them through the subject keys of D-350, so no image is edited to remove a person.","group":"Privacy","decided":"2026-11-18","ref":"D-351"},
    {"id":"d-352","title":"Platform staff read tenant data only under a grant","statement":"**Platform staff read tenant data only under a grant.** A grant names the operator, the tenant, the purpose and an expiry. The tenant sees each grant in its access report, and a tenant that forbids platform access has every grant refused.","group":"Privacy","decided":"2026-11-18","ref":"D-352"},
    {"id":"d-450","title":"Content tokens are tenant metadata evaluated by the kernel","statement":"**Content tokens are tenant metadata evaluated by the kernel.** A token is a name, an expression in the tenant expression language and a fallback text. It is stored under the schema version like every other definition. A reference to it in content is a node of the structured blocks, not a piece of text to substitute, so the value is placed as text by the renderer of each output context. The kernel evaluates the expression with the reader as the principal, which makes a token subject to the same read policies as a query, and makes its dependencies known for stored copies.","group":"Content","decided":"2026-11-18","ref":"D-450"},
    {"id":"d-451","title":"Mail is a job handled by one dispatcher behind the mail contract","statement":"**Mail is a job handled by one dispatcher behind the mail contract.** A component that wants mail sent commits a mail job with the change it belongs to. The mail dispatcher takes the job, renders the message for its recipient, checks the suppression list and the quota of the tenant, and hands the message to the adapter of the configured provider with an idempotency key. Providers differ in what they guarantee, so the contract states the guarantees and each adapter makes up the difference. Delivery reports come back through the same contract.","group":"Platform","decided":"2026-11-18","ref":"D-451"},
    {"id":"d-500","title":"No account spans tenants","statement":"**No account spans tenants.** A person who works in several tenants has a principal in each. A shared identity provider is what links them. A platform-wide account would put personal data in the control database, against K-2.","group":"Identity","decided":"2026-11-18","ref":"D-500"},
    {"id":"d-501","title":"The first region is US East, the second is EU West","statement":"**The first region is US East, the second is EU West.** The first cloud profile is built in the Amazon Web Services region us-east-1. The second region is eu-west-1, added when the first tenant needs residency in the European Union. A tenant is placed in one of them and stays there (D-23).","group":"Platform","decided":"2026-11-18","ref":"D-501"},
    {"id":"d-502","title":"Managed containers, not Kubernetes","statement":"**Managed containers, not Kubernetes.** The cloud profile runs the component images on the provider's managed container service. Nothing in the specification needs a cluster orchestrator, and one less system is one less thing to operate and patch.","group":"Platform","decided":"2026-11-18","ref":"D-502"},
    {"id":"d-503","title":"A dedicated database instance is a placement, offered on the top plan","statement":"**A dedicated database instance is a placement, offered on the top plan.** Every tenant has its own database. Most share a cluster. A tenant on the top plan can be placed on an instance of its own, which is the same placement record with a cluster of one (D-2).","group":"Tenancy","decided":"2026-11-18","ref":"D-503"},
    {"id":"d-504","title":"Search starts on PostgreSQL full-text search","statement":"**Search starts on PostgreSQL full-text search.** The search index contract is met in both profiles by full-text search in the tenant database. A separate search service is a second copy of tenant content to secure, place and erase, and it is added only when a measured need shows the first adapter is not enough.","group":"Content","decided":"2026-11-18","ref":"D-504"},
    {"id":"d-505","title":"Keys are managed by the platform at launch","statement":"**Keys are managed by the platform at launch.** Each tenant has its own data key, wrapped by the platform's key service (D-25). Keys held by the tenant are not offered at launch. The key service contract leaves room for them.","group":"Platform","decided":"2026-11-18","ref":"D-505"},
    {"id":"d-506","title":"Automation is declared steps and calls to external addresses","statement":"**Automation is declared steps and calls to external addresses.** A workflow is made of the step kinds the platform declares, and reaches anything else by calling an external address. Tenant code does not run on the platform (NG-3).","group":"Automation","decided":"2026-11-18","ref":"D-506"},
    {"id":"d-507","title":"The delivery interface is HTTP with JSON","statement":"**The delivery interface is HTTP with JSON.** There is no GraphQL interface (NG-7). Field selection, filtering and paging are part of the one interface.","group":"Delivery","decided":"2026-11-18","ref":"D-507"},
    {"id":"d-508","title":"Three plans, with quotas held as data","statement":"**Three plans, with quotas held as data.** There are three plans. Standard: 20 database connections, 50 requests a second, 10 GB stored, 10,000 jobs a day, 5,000 emails a month. Business: 50 connections, 200 requests a second, 100 GB, 100,000 jobs a day, 50,000 emails a month. Enterprise: quotas set by contract, with a dedicated database instance available (D-503). The numbers are starting values held as data, and changing them is an audited operation, not a release.","group":"Tenancy","decided":"2026-11-18","ref":"D-508"},
    {"id":"d-509","title":"The first owner is admitted by a single-use bootstrap credential","statement":"**The first owner is admitted by a single-use bootstrap credential.** Provisioning issues one bootstrap credential for the first owner of the tenant. It works once, expires, and is the only way in until that owner sets up a sign-in method. It is built with provisioning, at the second milestone (TEN-500).","group":"Tenancy","decided":"2026-11-18","ref":"D-509"},
    {"id":"d-510","title":"Platform flags come from the environment, tenant features are tenant metadata","statement":"**Platform flags come from the environment, tenant features are tenant metadata.** A flag that turns platform behaviour on or off is configuration of the deployment. A feature a tenant chooses is tenant metadata, changed through the kernel and audited like any other change.","group":"Platform","decided":"2026-11-18","ref":"D-510"},
    {"id":"d-511","title":"Each database cluster has a connection pooler","statement":"**Each database cluster has a connection pooler.** Components reach tenant databases through a pooler in front of each cluster, in transaction mode. The connection quota of a tenant is enforced at the pooler. This is the ordinary way to run many small databases on one cluster, and it is how ARC-114 is met.","group":"Tenancy","decided":"2026-11-18","ref":"D-511"},
    {"id":"d-512","title":"The first sellable slice has no site search","statement":"**The first sellable slice has no site search.** Search is built at the eleventh milestone. The first slice sold ends at the sixth, with authoring, delivery and usage metering.","group":"Content","decided":"2026-11-18","ref":"D-512"},
    {"id":"d-513","title":"The first billing adapter is Stripe","statement":"**The first billing adapter is Stripe.** The usage export is generic (BIL-153). The first system that receives it is Stripe.","group":"Tenancy","decided":"2026-11-18","ref":"D-513"},
    {"id":"d-514","title":"One model provider chosen by the platform, and the assistant is off until the tenant turns it on","statement":"**One model provider chosen by the platform, and the assistant is off until the tenant turns it on.** The platform offers one model provider behind the seam (D-202). A tenant does not bring its own model key at launch. The assistant is off in a new tenant, and an owner turns it on (CNV-500). Conversations are private to the person who started them and to readers of the audit log.","group":"Conversation","decided":"2026-11-18","ref":"D-514"},
    {"id":"d-515","title":"The assistant answers in the language of the message","statement":"**The assistant answers in the language of the message.** When the language of the person and the default of the tenant differ, the reply uses the language of the message it answers (CNV-246).","group":"Conversation","decided":"2026-11-18","ref":"D-515"},
    {"id":"d-516","title":"A preview is valid while nothing has changed, and for fifteen minutes","statement":"**A preview is valid while nothing has changed, and for fifteen minutes.** A preview stops being valid when the revision of the tenant differs from the one it was computed against, or fifteen minutes after it was shown, whichever comes first. The person is then shown a new preview.","group":"Conversation","decided":"2026-11-18","ref":"D-516"},
    {"id":"d-517","title":"An identity outage fails closed","statement":"**An identity outage fails closed.** While the identity service cannot be reached, requests that need a session are refused, with the outage named (IDN-300). Published content stays up. Honouring sessions through an outage would make a revocation unenforceable, and security outranks availability here.","group":"Identity","decided":"2026-11-18","ref":"D-517"},
    {"id":"d-518","title":"Planning values stand until a deployment measures them","statement":"**Planning values stand until a deployment measures them.** The reference load and the rates of the failure modes are planning values (a-reference-load, a-planning-rates). They are replaced by measured values after the first deployment, and the reference load is then tied to the plans of D-508.","group":"Platform","decided":"2026-11-18","ref":"D-518"},
    {"id":"d-519","title":"An event that keeps failing is parked","statement":"**An event that keeps failing is parked.** Parking keeps the tenant flowing. Subscribers that have not received the parked event see later events first, and the tenant owner sees the parked event listed and can release it (OPS-348).","group":"Automation","decided":"2026-11-18","ref":"D-519"},
    {"id":"d-520","title":"Processor for tenant data, controller for account data","statement":"**Processor for tenant data, controller for account data.** The platform is a processor of the personal data its tenants hold, and a controller only of its own account data. Each tenant states the lawful basis for each of its record types.","group":"Privacy","decided":"2026-11-18","ref":"D-520"},
    {"id":"d-521","title":"Only the tenant places a legal hold","statement":"**Only the tenant places a legal hold.** A legal hold is placed and lifted by the tenant. The platform does not stop an erasure that a tenant carries out.","group":"Privacy","decided":"2026-11-18","ref":"D-521"},
    {"id":"d-522","title":"The journal covers the restore window, thirty days by default","statement":"**The journal covers the restore window, thirty days by default.** The event journal reaches back as far as the restore window the tenant chose, thirty days unless changed, and a snapshot carrying the state hash stands at the start of the window.","group":"Privacy","decided":"2026-11-18","ref":"D-522"},
    {"id":"d-523","title":"One mail provider account, the platform's","statement":"**One mail provider account, the platform's.** Mail leaves through the platform's account with its provider, which is Amazon Simple Email Service in the first cloud profile. A tenant sends from its own proved domain (EML-013) and does not bring a provider account at launch.","group":"Platform","decided":"2026-11-18","ref":"D-523"},
    {"id":"d-524","title":"A content token takes no arguments","statement":"**A content token takes no arguments.** A token is a name and an expression. Formatting follows the language of the reader (CTK-013). A variation is a second token.","group":"Content","decided":"2026-11-18","ref":"D-524"},
    {"id":"d-525","title":"A tenant can turn passwords off","statement":"**A tenant can turn passwords off.** A realm policy can allow only passkeys and federation. It is accepted only while every owner of the tenant has another sign-in method and a recovery path.","group":"Identity","decided":"2026-11-18","ref":"D-525"},
    {"id":"d-526","title":"One automation worker runs schedules and workflows","statement":"**One automation worker runs schedules and workflows.** The scheduler and the workflow engine are one component, the automation worker. A workflow step is a job, so one lease path and one retry path serve both.","group":"Automation","decided":"2026-11-18","ref":"D-526"},
    {"id":"d-527","title":"Tenant audit entries live in the tenant database, platform entries in the control database","statement":"**Tenant audit entries live in the tenant database, platform entries in the control database.** The audit log of a tenant is part of that tenant and leaves with it. Entries about the platform itself, which name no tenant content, are held in the control database. Both are hash-chained (D-20).","group":"Observability","decided":"2026-11-18","ref":"D-527"},
    {"id":"d-528","title":"A directory entry is served for fifteen minutes through a control plane outage","statement":"**A directory entry is served for fifteen minutes through a control plane outage.** While the control plane cannot be reached, the gateway and the runtime answer reads from the directory entries they hold for up to fifteen minutes (ARC-500), and refuse changes (ARC-100). The bound applies to an entry of an active tenant. An entry in any other state is held for at most sixty seconds and is never served as active (D-6221).","group":"Tenancy","decided":"2026-11-18","ref":"D-528"},
    {"id":"d-529","title":"Outbox publication is one job per tenant","statement":"**Outbox publication is one job per tenant.** Committed events of a tenant are published by one job that takes them in order, not by a job per transaction.","group":"Automation","decided":"2026-11-18","ref":"D-529"},
    {"id":"d-530","title":"People operate the platform until the last release stage","statement":"**People operate the platform until the last release stage.** Agents that deploy, migrate or change infrastructure are not admitted before R4. When they are, they come through an operations gateway of their own that reaches the control plane and no tenant content (AGS-426).","group":"Agents","decided":"2026-11-18","ref":"D-530"},
    {"id":"d-531","title":"Agent limits have platform defaults and floors","statement":"**Agent limits have platform defaults and floors.** Every budget, delay window and undo window of an agent has a default set by the platform. A tenant can tighten a limit, and can loosen it only down to the floor the platform sets.","group":"Agents","decided":"2026-11-18","ref":"D-531"},
    {"id":"d-532","title":"Data handed to an agent carries one of three trust levels","statement":"**Data handed to an agent carries one of three trust levels.** Platform: written by the platform. Tenant-authored: written by a principal of the tenant. External: anything that arrived from outside, such as a webhook body, a fetched page or a received email.","group":"Agents","decided":"2026-11-18","ref":"D-532"},
    {"id":"d-533","title":"Verification status is readable by tenant owners and platform operators","statement":"**Verification status is readable by tenant owners and platform operators.** The requirements of this specification are readable by any principal. Their verification status is readable by owners of a tenant and by platform operators (AGT-414).","group":"Agents","decided":"2026-11-18","ref":"D-533"},
    {"id":"d-534","title":"The adversarial corpus runs in the gate","statement":"**The adversarial corpus runs in the gate.** The cases of the agent safety corpus (AGS-435) are run by the gate once the agent plane exists, like every other conformance table.","group":"Agents","decided":"2026-11-18","ref":"D-534"},
    {"id":"d-535","title":"Throttle thresholds are realm defaults set by the platform","statement":"**Throttle thresholds are realm defaults set by the platform.** The thresholds and windows of the three throttles (D-252) are defaults held as data, which a realm can tighten. The platform-wide counter holds a hash of the source address and no tenant content, so it does not cross the isolation rule (K-2).","group":"Identity","decided":"2026-11-18","ref":"D-535"},
    {"id":"d-536","title":"The session cookie takes a host-only name with the next gateway work","statement":"**The session cookie takes a host-only name with the next gateway work.** The cookie is renamed with the host prefix when the identity service of the third milestone is built (IDN-262). The prototype keeps its current name until then.","group":"Identity","decided":"2026-11-18","ref":"D-536"},
    {"id":"d-537","title":"Access tokens live five minutes","statement":"**Access tokens live five minutes.** An access token is valid for five minutes (TOK-005), and revoking its grant is also announced to the gateways, so a cut-off does not wait for the lifetime.","group":"Identity","decided":"2026-11-18","ref":"D-537"},
    {"id":"d-538","title":"Scope of the first product release","statement":"**Scope of the first product release.** Milestone six stays whole. A sandbox tenant is self-serve. A delivery key is a service account. Search waits for the last release stage. Promotion from staging to production waits for the proposal flow of the seventh milestone, and carries configuration and no content.","group":"Content","decided":"2026-11-18","ref":"D-538"},
    {"id":"d-539","title":"Audit entries and consent evidence are kept for one year by default","statement":"**Audit entries and consent evidence are kept for one year by default.** A tenant can lengthen the period. Client addresses in edge logs are truncated (PRV-363).","group":"Privacy","decided":"2026-11-18","ref":"D-539"},
    {"id":"d-550","title":"Images are addressed by digest and promoted, and rebuilt in no environment","statement":"**Images are addressed by digest and promoted, and rebuilt in no environment.** Each component image is addressed by its content digest. The image that the gate tested in stage is the image production runs. No environment rebuilds an image, because a second build is a second program that nobody tested.","group":"Platform","decided":"2026-11-18","ref":"D-550"},
    {"id":"d-551","title":"Stage and production are platform environments, not staging tenants","statement":"**Stage and production are platform environments, not staging tenants.** The stage environment and the production environment are the platform's own environments, made from the same definitions. They are not tenants. A staging tenant remains a tenant of a production tenant (ADM-157).","group":"Platform","decided":"2026-11-18","ref":"D-551"},
    {"id":"d-552","title":"No ephemeral review environments at launch","statement":"**No ephemeral review environments at launch.** There is one stage environment and one production environment in the cloud profile, and the local stack for development. A review environment per branch adds a third place that holds the platform and needs its own care, and no requirement is met by it that the stage environment does not meet.","group":"Platform","decided":"2026-11-18","ref":"D-552"},
    {"id":"d-553","title":"Stage and production share region and zones, and differ in accounts, networks, keys, databases and realms","statement":"**Stage and production share region and zones, and differ in accounts, networks, keys, databases and realms.** The two environments run in the same region and the same three zones, so that latency, zone behaviour and managed service versions match. They use separate cloud accounts, networks, key service keys, databases and identity realms (REL-556). The parity table states each allowed difference.","group":"Platform","decided":"2026-11-18","ref":"D-553"},
    {"id":"d-554","title":"The standard path includes a canary share before the full colour switch","statement":"**The standard path includes a canary share before the full colour switch.** A colour switch first sends a small share of public requests to the new colour for a stated period, then the full share. The canary is the cheapest evidence that the new colour works under real traffic before every reader reaches it.","group":"Platform","decided":"2026-11-18","ref":"D-554"},
    {"id":"d-555","title":"Automatic switch back on the criteria of OPS-327, and a manual switch back is one operation","statement":"**Automatic switch back on the criteria of OPS-327, and a manual switch back is one operation.** A breached criterion of the release record switches traffic back by itself (OPS-327). An operator who decides to switch back does so with one operation of the release controller that deploys nothing (REL-568).","group":"Platform","decided":"2026-11-18","ref":"D-555"},
    {"id":"d-556","title":"Blue and green for production, with the previous colour warm for 24 hours","statement":"**Blue and green for production, with the previous colour warm for 24 hours.** Production runs two complete colours of each component, one live and one warm. The warm colour keeps its instances running for the window of its release record, which is at least 24 hours (REL-569). A rolling update is not used for production, because it leaves no complete previous version to return to.","group":"Platform","decided":"2026-11-18","ref":"D-556"},
    {"id":"d-557","title":"Shared state is not duplicated between colours, and a colour writes only what the other colour reads","statement":"**Shared state is not duplicated between colours, and a colour writes only what the other colour reads.** Tenant databases, the control database, the copy store, the file store and the notice queue are shared by both colours (REL-572). The rule that keeps both colours readable is expand and contract (OPS-324), and a stored copy carries the release that computed it (REL-573).","group":"Platform","decided":"2026-11-18","ref":"D-557"},
    {"id":"d-558","title":"Long-lived streams close with a notice and resume by sequence number, with no sticky sessions","statement":"**Long-lived streams close with a notice and resume by sequence number, with no sticky sessions.** An event stream or a streamed reply on a withdrawn colour is closed with a notice that names its last sequence number, and the client resumes on the live colour. The traffic switch keeps no session affinity, so no session is pinned to a colour.","group":"Platform","decided":"2026-11-18","ref":"D-558"},
    {"id":"d-559","title":"Control plane lifecycle operations run in one active instance, elected through the control database","statement":"**Control plane lifecycle operations run in one active instance, elected through the control database.** Creating, moving and deleting tenants is done by one active instance of the control plane at a time, so that two colours cannot provision the same tenant twice. Reads of the directory run in every instance (D-100).","group":"Platform","decided":"2026-11-18","ref":"D-559"},
    {"id":"d-560","title":"The gateway and the identity service are stateless, so sessions survive a colour switch","statement":"**The gateway and the identity service are stateless, so sessions survive a colour switch.** Sessions live in the tenant databases and the gateway holds only copies with a bound (K-5). Both colours verify the same sessions and tokens, so a colour switch ends no sign-in (REL-579).","group":"Identity","decided":"2026-11-18","ref":"D-560"},
    {"id":"d-561","title":"The automation worker of both colours shares one wake index, and leases with fencing tokens hold one job at a time","statement":"**The automation worker of both colours shares one wake index, and leases with fencing tokens hold one job at a time.** Both colours read the wake index and lease jobs from the tenant databases (D-10, D-11). A withdrawn colour finishes or releases its leases before it stops (REL-570), so no job is held by two workers that both record a result.","group":"Automation","decided":"2026-11-18","ref":"D-561"},
    {"id":"d-562","title":"The emergency path is the same pipeline and the same gates, with a shortened soak of at least one hour","statement":"**The emergency path is the same pipeline and the same gates, with a shortened soak of at least one hour.** A hotfix passes every gate of the promotion path. Its stage soak is shortened to a stated minimum of one hour, and it needs the same two approvals as any production release (REL-564).","group":"Platform","decided":"2026-11-18","ref":"D-562"},
    {"id":"d-563","title":"Freeze windows are declared by a platform owner and enforced by the release controller","statement":"**Freeze windows are declared by a platform owner and enforced by the release controller.** A platform owner declares a freeze window in the release controller. Releases inside the window are refused, except a hotfix that the freeze names (REL-563). A freeze binds people and agents alike.","group":"Platform","decided":"2026-11-18","ref":"D-563"},
    {"id":"d-564","title":"Two approvals from distinct principals, neither the author, and no agent among them","statement":"**Two approvals from distinct principals, neither the author, and no agent among them.** The separation rule of AGS-409 and the two-principal rule of AGS-426 apply to every production release, and D-530 keeps agents out of the approvals before the last release stage. So a production release carries two approvals from two people, neither of whom wrote the change (REL-560).","group":"Platform","decided":"2026-11-18","ref":"D-564"},
    {"id":"d-565","title":"Release records and environment records are held in the control database, written through the control plane","statement":"**Release records and environment records are held in the control database, written through the control plane.** Release and environment records hold identifiers, digests and principal identifiers, and no tenant content. The control plane writes them, so the control database keeps the single writer it already has (K-2, ARC-110).","group":"Platform","decided":"2026-11-18","ref":"D-565"},
    {"id":"d-566","title":"Drift is reported and not silently corrected","statement":"**Drift is reported and not silently corrected.** When the definitions of an environment and what runs in it differ, the release controller reports the difference (REL-562). A person or an approved release brings them together, so that the record of what was changed stays complete.","group":"Platform","decided":"2026-11-18","ref":"D-566"},
    {"id":"d-567","title":"Production changes only through release records or audited operations","statement":"**Production changes only through release records or audited operations.** A change to production is a release, or an operation of the catalogue that is audited. No one changes production by hand (REL-561), so every change of production has a record with its approval.","group":"Platform","decided":"2026-11-18","ref":"D-567"},
    {"id":"d-568","title":"Migrations run as jobs of the automation worker, with no separate migration service","statement":"**Migrations run as jobs of the automation worker, with no separate migration service.** A migration run is a job with a lease, a cursor and a retry (D-10, D-11). The automation worker already carries those properties, so a second service that does the same work would add a second lease path.","group":"Tenancy","decided":"2026-11-18","ref":"D-568"},
    {"id":"d-569","title":"A schema change applies in one transition up to a record limit, and as a migration run above it","statement":"**A schema change applies in one transition up to a record limit, and as a migration run above it.** A change of at most 10000 records of one type applies in one transition (MIG-551), so the tenant never shows a partly changed state. A larger change runs in batches, and a reader sees each record in its prior form or its migrated form (MIG-552).","group":"Tenancy","decided":"2026-11-18","ref":"D-569"},
    {"id":"d-570","title":"Lossless type conversions apply, and the others apply only with a declared transformation","statement":"**Lossless type conversions apply, and the others apply only with a declared transformation.** The conversion table lists which pairs of field types convert without loss. A pair that loses information applies only with a transformation that the schema change declares, and where none is declared the change is refused (MIG-558).","group":"Tenancy","decided":"2026-11-18","ref":"D-570"},
    {"id":"d-571","title":"Every schema change is previewed on a copy, and an irreversible change is marked in its preview","statement":"**Every schema change is previewed on a copy, and an irreversible change is marked in its preview.** The preview runs the change against a copy of the tenant, so the owner sees what the change does to real records before it applies (MIG-550). A change that removes a field or a constraint is marked irreversible (MIG-557).","group":"Tenancy","decided":"2026-11-18","ref":"D-571"},
    {"id":"d-572","title":"A failed migration run leaves the tenant as it was, and a partly applied batch is not visible","statement":"**A failed migration run leaves the tenant as it was, and a partly applied batch is not visible.** A run commits each batch with its cursor. A failed run stops with the tenant in the form it had before the run, with the failure named in its record (MIG-555), and no reader sees a batch that did not commit (MIG-552).","group":"Tenancy","decided":"2026-11-18","ref":"D-572"},
    {"id":"d-573","title":"Strict is the default mode of a schema change, and grandfather mode lists the records that no longer conform","statement":"**Strict is the default mode of a schema change, and grandfather mode lists the records that no longer conform.** Strict mode refuses a change that would leave a record out of line (KRN-009). Grandfather mode applies the change and lists the non-conforming records in its evidence (KRN-010). The owner chooses the mode in the preview, and strict is the default.","group":"Tenancy","decided":"2026-11-18","ref":"D-573"},
    {"id":"d-574","title":"A changed delivery shape keeps the old shape for at least 90 days","statement":"**A changed delivery shape keeps the old shape for at least 90 days.** Integrators get a minimum window of 90 days, or the longer window that the notice states, in which the old shape is served (CMS-170). After the window the old shape is removed (NG-556).","group":"Delivery","decided":"2026-11-18","ref":"D-574"},
    {"id":"d-575","title":"A migration applied to a staging tenant is run again in its production tenant against production data","statement":"**A migration applied to a staging tenant is run again in its production tenant against production data.** A staging tenant is used to prepare a change, not to carry data. The production tenant runs the same migration as a migration run with its own preview, so the change is checked against the data it will change (MIG-567).","group":"Platform","decided":"2026-11-18","ref":"D-575"},
    {"id":"d-576","title":"A tenant move has a read-only window of at most 60 seconds, verified by state hash, and keeps its source until verified","statement":"**A tenant move has a read-only window of at most 60 seconds, verified by state hash, and keeps its source until verified.** The window is the final synchronisation of a move. The target state hash must equal the source hash before the directory switches (MIG-570), and a failed copy leaves the source serving (MIG-571). The source is kept for at least 7 days after the switch (MIG-572).","group":"Tenancy","decided":"2026-11-18","ref":"D-576"},
    {"id":"d-577","title":"Layout changes reach tenants in waves, and a tenant that lags holds the release back while it keeps serving","statement":"**Layout changes reach tenants in waves, and a tenant that lags holds the release back while it keeps serving.** A layout change runs in waves that can stop (OPS-323). A tenant whose change fails stays on its previous layout and keeps serving (MIG-565). The contracting phase of the release waits for every tenant (OPS-324).","group":"Data safety","decided":"2026-11-18","ref":"D-577"},
    {"id":"d-578","title":"An upgrade of an installed template is a proposal, and it is never applied automatically","statement":"**An upgrade of an installed template is a proposal, and it is never applied automatically.** A platform template or integration that a tenant installed changes only when the tenant approves the projection of the upgrade (MIG-564). The platform does not apply an upgrade to a tenant's records by itself.","group":"Platform","decided":"2026-11-18","ref":"D-578"},
    {"id":"d-579","title":"A point-in-time restore reports the window of committed changes that it did not restore","statement":"**A point-in-time restore reports the window of committed changes that it did not restore.** A restore names the first and the last change it does not carry (MIG-573). The journal keeps the window the tenant chose (D-522), so the report names what the tenant can recover by other means.","group":"Data safety","decided":"2026-11-18","ref":"D-579"},
    {"id":"d-580","title":"A tenant is served by a newer kernel version only after its journal replays under that version","statement":"**A tenant is served by a newer kernel version only after its journal replays under that version.** Before a tenant changes kernel version, its journal replays under the new version to the state hash the journal records (MIG-566). The check is the same one that restore uses (TEN-015).","group":"Tenancy","decided":"2026-11-18","ref":"D-580"},
    {"id":"d-700","ref":"D-700","title":"Platform defaults for throttles, retries, sessions and recovery","group":"Platform","decided":"2026-11-18","statement":"**Platform defaults for throttles, retries, sessions and recovery.** Password attempts are refused for an account for thirty seconds after ten failed attempts, and for a source until its window of fifteen minutes ends after one hundred failed attempts within it, and the attempts across one realm are slowed to one a second once the realm passes one thousand failures within fifteen minutes. An attempt is counted before its password is checked, so that attempts that arrive together are counted together, and a right password gives its place back; the counts are kept in the store, so that a restart does not clear them and every instance shares them. An account is counted by its login in Unicode compatibility normal form (NFKC), lower-cased and trimmed, so that one account has one count whatever the spelling. A one-time code is spent after five failed presentations. A realm sends at most five second-factor prompts to one account in an hour, issues at most five sign-in links to one address and twenty to one browser in an hour, and accepts at most twenty sign-up requests from one source in an hour. The token endpoint accepts at most thirty credential requests from one client in a minute. A session ends twelve hours after it was last used or fourteen days after sign-in, whichever comes first. Account recovery notifies the contacts of the account and completes after a delay of twenty-four hours. A component that sees its retries to one dependency exceed ten percent of its first attempts within sixty seconds makes no retry to that dependency for sixty seconds, and it stops calling a dependency for thirty seconds after five consecutive failures. After a restart, refills of stored copies are released at one hundred requests a second per cluster. Synthetic probes run every minute. A layout change stops when more than five percent of the tenants of one wave fail. A fresh authentication is one made within the step-up age of fifteen minutes. The hop limit of a trigger chain is eight events, and the job admission rate of a tenant is one hundred jobs a minute unless the tenant sets another. A realm may tighten any of these defaults (D-535)."},
    {"id":"d-701","ref":"D-701","title":"The tenant export is the owner's archive","group":"Tenancy","decided":"2026-11-18","statement":"**The tenant export is the owner's archive.** The export of a tenant (TEN-010) and the archive that a tenant owner receives (ADM-161) are one artifact: the archive, with the documented formats and the manifest of ADM-162, from which the tenant restores to the canonical hash of its state."},
    {"id":"d-702","ref":"D-702","title":"The outbound gate judges the addresses that tenants name","group":"Platform","decided":"2026-11-18","statement":"**The outbound gate judges the addresses that tenants name.** Every connection to an address that a tenant names, such as a webhook receiver, a connector endpoint, or the metadata, keys and token endpoint of a provider the tenant configured, leaves through the outbound gate (K-252). The platform's own fixed endpoints, the mail provider, the model provider, the content delivery network and the key service, are reached through their own adapters and are listed in the subprocessor register (PRV-373)."},
    {"id":"d-703","ref":"D-703","title":"An emailed sign-in link carries its token in the fragment","group":"Identity","decided":"2026-11-18","statement":"**An emailed sign-in link carries its token in the fragment of its address.** A browser does not send a fragment to the platform, so the token appears in no request address, referrer or query string (K-250). The page that the link opens sends the token in the body of a request to the sign-in link endpoint (IDN-003)."},
    {"id":"d-704","ref":"D-704","title":"A network context is kept as a keyed hash","group":"Identity","decided":"2026-11-18","statement":"**A network context is kept as a keyed hash.** A realm rule that compares the network context of a session (IDN-260) keeps only a keyed hash of that context in the session record, so the record holds no network address in clear form (PRV-364)."},
    {"id":"d-705","ref":"D-705","title":"Deletion grace is fourteen days and a sandbox lasts thirty days","group":"Tenancy","decided":"2026-11-18","statement":"**Deletion grace is fourteen days and a sandbox lasts thirty days.** An owner can cancel the deletion of a tenant for fourteen days after requesting it, and a sandbox that its owner does not keep is deleted thirty days after it was started. The plan states both periods (BIL-150)."},
    {"id":"d-28","title":"Rust for components, vanilla JavaScript in the browser","statement":"**Rust for components, vanilla JavaScript in the browser.** Platform components are written in Rust. Browser code stays framework-free JavaScript run by a kernel in a worker.","group":"Platform","decided":"2026-11-18","ref":"D-28"},
    {"id":"d-706","ref":"D-706","title":"Backup images are kept for thirty-five days","group":"Privacy","decided":"2026-11-18","statement":"**Backup images are kept for thirty-five days.** A backup image of a tenant database or of the control database is removed thirty-five days after it was taken. A tenant policy may shorten the period and the platform allows none longer, so the erasure bound of a backup image is thirty-five days at most (D-351, PRV-700)."},
    {"id":"d-707","ref":"D-707","title":"The platform audit store and the migration job are apart from tenant data","group":"Platform","decided":"2026-11-18","statement":"**The platform audit store and the migration job are apart from tenant data.** The operations of the platform itself are recorded in a platform audit store that holds no tenant data and is apart from every tenant database, and entries are kept seven years. A tenant migration run is a job of a component of its own, the migration job, which the release controller starts. The controller holds no access to tenant data: it writes the platform audit store and instructs the traffic switch, and the control plane and the migration job hold the access that provisioning and migration need."},
    {"id":"d-708","ref":"D-708","title":"Retention bounds and the notice of a breach","group":"Privacy","decided":"2026-11-18","statement":"**Retention bounds and the notice of a breach.** The retention rule of a record type may set a period from thirty days to ten years, and a record type with no tenant rule keeps the period that its class states. The platform reports a breach of personal data to the tenant owner within twenty-four hours of confirming it, and a tenant policy may shorten that notice period and may not extend it beyond forty-eight hours."},
    {"id":"d-709","ref":"D-709","title":"Windows and depth of agent safety","group":"Agents","decided":"2026-11-18","statement":"**Windows and depth of agent safety.** An irreversible operation of an agent takes effect after a delay window of twenty-four hours unless a person approved it, and a tenant may set a window from one hour to seven days. A declared reversal of an applied agent change is available for seven days, and a tenant may set an undo window from one hour to thirty days. A chain of events that starts the same agent again is stopped at a loop depth of five, and a tenant may set a depth from one to the hop limit of D-700."},
    {"id":"d-710","ref":"D-710","title":"Calls between platform components form no cycle","group":"Platform","decided":"2026-11-18","statement":"**Calls between platform components form no cycle.** A component of the platform calls only components below it: the edge calls the gateways, the gateways call the runtime and the control plane, and those call the stores and the outward services. A provider that the platform both receives requests from and instructs is modelled as two components, its request path and its control interface. The content delivery network is the first case: readers reach the platform through the network, and the runtime and the control plane instruct it through its control interface, which calls nothing of the platform."},
    {"id":"d-4915","ref":"D-4915","title":"The operations marked sensitive","group":"Identity","decided":"2026-11-19","statement":"**The operations marked sensitive.** An operation is sensitive when it changes how a person gets in or removes other people's access: adding or removing an authenticator, making new recovery codes, adding or removing a passkey, changing a password, ending every other session of the caller, changing the realm configuration, and the owner's reset of a fixture. A sensitive operation needs a fresh authentication (D-700: within fifteen minutes) and the network context that authenticated the session (IDN-019, IDN-260). A person who has a second factor gives the second factor again; a person who has none gives the password. The marking moves into the structured authorisation of each contract when that format states it."},
    {"id":"d-5080","ref":"D-5080","title":"Campaigns and promotions are product modules, not platform features","group":"Platform","decided":"2026-11-19","statement":"**Campaigns and promotions are product modules, not platform features.** NG-8 once excluded email marketing. It is narrowed: a product module may run campaigns and promotions, built from segments, the ledger, workflows, notifications and audience mail, as tenant metadata with no change to the kernel (D-103). The platform's own duties stay as they are: mail to an audience carries an unsubscribe that works without a sign-in (EML-020), sending is held to the tenant's allowance, and no payment is taken on the platform (NG-152). Web analytics and commerce remain non-goals."},
    {"id":"d-5000","ref":"D-5000","title":"The ledger is a platform primitive that modules use","group":"Platform","decided":"2026-11-19","statement":"**The ledger is a platform primitive that modules use.** Points, badge progress, redemption limits and promotion budgets are product features, and D-103 makes a feature a module of tenant metadata. What they share is a counter that must stay right under retries and concurrent requests, which metadata cannot promise, so the platform holds one append-only ledger per tenant, in the tenant database, and a module declares its units and limits as metadata and posts to the ledger through the kernel. A module never keeps a balance of its own in a record type."},
    {"id":"d-5001","ref":"D-5001","title":"An account is an owner and a unit","group":"Platform","decided":"2026-11-19","statement":"**An account is an owner and a unit.** An account is identified by its owner and its unit. The owner is a principal of the tenant or a named pool of the tenant, such as a promotion budget. The unit is a name the tenant declares as metadata, such as points or stamps; the platform gives it no meaning. An account exists from the first posting that names its owner and unit, and its identifier is derived from the tenant, the owner and the unit, so that deciding a posting needs no source of randomness (K-11). A unit and a pool are declared before they are posted to, so that a misspelt name is refused and does not open an account."},
    {"id":"d-5002","ref":"D-5002","title":"Entries are append-only and a correction is another entry","group":"Platform","decided":"2026-11-19","statement":"**Entries are append-only and a correction is another entry.** An entry is never changed or removed by any operation of the tenant. A mistake is corrected by a new entry of the opposite amount that names the entry it corrects, so the journal keeps both the error and its correction. The entries of an account are numbered 1, 2, 3 in the order they commit, with no gap, which lets a replay detect a missing entry."},
    {"id":"d-5003","ref":"D-5003","title":"A balance is derived and no operation writes it","group":"Platform","decided":"2026-11-19","statement":"**A balance is derived and no operation writes it.** The balance of an account is the sum of the amounts of its entries. The platform keeps the sum in a derived record that only the commit of a posting writes, in the same commit as the entry, so that a decision loads one small record and not the whole journal (K-100). No contract sets a balance, and replaying the journal of the tenant gives every balance again."},
    {"id":"d-5004","ref":"D-5004","title":"Amounts are non-zero whole numbers","group":"Platform","decided":"2026-11-19","statement":"**Amounts are non-zero whole numbers.** An amount is a signed whole number of the smallest step of its unit, from -(2^53-1) to 2^53-1, the range every evaluator of the specification holds exactly. A unit that needs a fraction declares a smaller step, such as cents. An amount of zero is refused, because it records nothing. A posting that would take a balance out of that range is refused."},
    {"id":"d-5005","ref":"D-5005","title":"Limits are a floor, a cap and a cap per period","group":"Platform","decided":"2026-11-19","statement":"**Limits are a floor, a cap and a cap per period.** A tenant may declare, for a unit and for one account of it, a floor (the balance never goes below it, for example zero), a cap (the balance never goes above it) and a cap per period (the credits posted in one period never exceed it). The limit of an account takes the place of the limit of its unit, limit by limit. A posting that would leave the balance outside the floor or the cap, or the credits of its period above the cap per period, is refused and changes nothing; a posting that moves a balance that is already outside a limit back toward it is allowed. A period is a calendar hour, day, week (starting Monday) or month in UTC, computed from the time the entry carries. A change of limit applies to the postings committed after it and rewrites no entry."},
    {"id":"d-5006","ref":"D-5006","title":"Posting is a kernel decision committed with its cause","group":"Platform","decided":"2026-11-19","statement":"**Posting is a kernel decision committed with its cause.** A posting is decided by the kernel from the snapshot its plan names, the posting and the time it is given (K-11, K-100), and is committed in the same transaction as the change that causes it, so that a rolled-back change leaves no entry and a committed change leaves exactly the entries it posts (K-9). A posting made directly by a person who holds the capability to post is the same decision with the posting as its only change."},
    {"id":"d-5007","ref":"D-5007","title":"A posting repeated with the same key is applied once","group":"Platform","decided":"2026-11-19","statement":"**A posting repeated with the same key is applied once.** An entry carries an idempotency key chosen by the poster, unique within its account. A posting that repeats a key of the account with the same amount, reason and correction answers with the entry already recorded and changes nothing; one that repeats the key with other content is refused, because a key that means two things would hide a defect in the poster. A refused posting records nothing, so its key stays free."},
    {"id":"d-5008","ref":"D-5008","title":"Posting emits a domain event","group":"Platform","decided":"2026-11-19","statement":"**Posting emits a domain event.** The commit that records an entry also records one domain event, ledger-entry-posted, which carries the account, the unit, the amount, the balance after and the number of the entry, and which triggers subscribe to like any domain event (SCH-004). The owner is a personal field of the event and is never logged."},
    {"id":"d-5009","ref":"D-5009","title":"Concurrent postings are serialised by the revision guard of the commit","group":"Platform","decided":"2026-11-19","statement":"**Concurrent postings are serialised by the revision guard of the commit.** Two postings to one account decide against the same snapshot and commit through the revision guard of the store contract (B-2). The one that loses the race is decided again on the new state, up to the retries of the store contract, so a posting that no longer fits after the winner is refused for the same reason as if it had arrived later, and one that still fits is applied. No lock and no counter outside the commit is used."},
    {"id":"d-5010","ref":"D-5010","title":"Time is an input of the posting","group":"Platform","decided":"2026-11-19","statement":"**Time is an input of the posting.** The time of an entry is given to the decision by the runtime, from the clock it reads, and a caller of the public contract cannot choose it. It fixes the period of a cap per period and is stored with the entry, so a journal replays to the same balances and the same period totals."},
    {"id":"d-5011","ref":"D-5011","title":"A read of a ledger is a read like any other","group":"Platform","decided":"2026-11-19","statement":"**A read of a ledger is a read like any other.** The records of the ledger are read under the policies of the reader, as KRN-004 states for every read, and under the capability to read the ledger. A balance answered to a reader who may read only some entries of an account counts only those entries, so a balance never discloses an entry that the reader cannot read. A reader who may read every entry of the account is answered from the derived record."},
    {"id":"d-5012","ref":"D-5012","title":"Erasure anonymises entries and keeps the totals","group":"Platform","decided":"2026-11-19","statement":"**Erasure anonymises entries and keeps the totals.** Erasing a principal clears that principal from the accounts it owns and from the entries it caused, keeps every entry with its amount, key, reason, number and time, and leaves every balance as it was, so that the totals of pools and the explanation of every balance survive. A tenant that needs the whole ledger gone reaches that by the deletion of the tenant. The fields that name the principal are sealed under the key of the principal (PRV-358) until they are cleared."},
    {"id":"d-5013","ref":"D-5013","title":"The ledger is not a book of money","group":"Platform","decided":"2026-11-19","statement":"**The ledger is not a book of money.** The ledger counts units a tenant defines. It has no currency, no double entry, no exchange between units and no settlement with an outside party. A transfer between two accounts is two postings, one for each account, committed together by one change, with a key each."},
    {"id":"d-5020","ref":"D-5020","title":"A segment is a name and a predicate over a person, stored as tenant metadata","group":"Automation","decided":"2026-11-19","statement":"**A segment is a name and a predicate over a person, stored as tenant metadata.** A segment is a name, the object type whose records stand for people (its subject type), and a predicate in the tenant rule language. It is stored under the schema version like every other definition, and no tenant code runs (D-103, D-506, NG-3). The word audience keeps its two meanings, the audience class of a read (CPY-005) and the recipients of audience mail (EML-020); a segment is neither. It never widens what a person may read, and audience mail may take a segment as its recipients."},
    {"id":"d-5021","ref":"D-5021","title":"A predicate sees one person, the records reached from the subject record, and the time it is given","group":"Automation","decided":"2026-11-19","statement":"**A predicate sees one person, the records reached from the subject record, and the time it is given.** The predicate of a segment is evaluated for one person at a time. It may read the principal and the roles of the person, the balances of the person's ledger accounts (D-6544), the fields of the person's record of the subject type, the fields of records reached from that record through at most two reference fields that each hold one record, and the time that the decision is given. It cannot read the `old`, `new` or `param` scopes, it cannot count or search the records that refer to a person, and it is at most 200 nodes long. A count or a total over many records that belongs to a person is kept in the ledger and read with balance(unit, scope) (D-6559); a field that a workflow maintains holds a property of the record itself, never a running total (D-5000). Every one of these limits is checked when the segment is defined, so that the cost of one evaluation is known before the first one runs."},
    {"id":"d-5022","ref":"D-5022","title":"The kernel decides membership in the transaction of the change","group":"Automation","decided":"2026-11-19","statement":"**The kernel decides membership in the transaction of the change.** When a committed change makes a person start or stop satisfying the predicate of a segment, the same decision writes the entry or exit event, and the new membership, in the transaction that commits the change. A change that leaves membership as it was writes nothing. The membership of a segment is a function of the journal and of the times given to the decisions, so that replaying the journal gives the members again (K-11). A transaction that rolls back writes no event and leaves every membership as it was."},
    {"id":"d-5023","ref":"D-5023","title":"Entry and exit are domain events that triggers subscribe to","group":"Automation","decided":"2026-11-19","statement":"**Entry and exit are domain events that triggers subscribe to.** An entry or exit event is a domain event that names the segment, the person, the version of the predicate, the revision of the change, the reason and the hop count. A trigger subscribes to the events of one segment like it subscribes to any domain event, and its job is created in the transaction that commits the event (SCH-004). The event body of the kernel gains two variants, one for entry and one for exit, when the kernel is built; the type segment-membership-event states what each carries."},
    {"id":"d-5024","ref":"D-5024","title":"A predicate that reads the time is refreshed by a schedule","group":"Automation","decided":"2026-11-19","statement":"**A predicate that reads the time is refreshed by a schedule.** The kernel reads no clock (K-1, K-11), so a person whose predicate turns true or false only because time has passed would never be re-evaluated by a change. A predicate that reads the time is called time-dependent. A time-dependent segment declares a refresh interval of at least one minute and at most one day, and defining it defines a schedule (CT-087) that creates one refresh job in each interval. The job gives the time to the decision as an input, evaluates every person of the subject type in batches, and writes the entries and exits that the time caused. A person therefore enters or leaves at the first refresh that starts after the predicate changed its value, so membership is at most one refresh interval, plus the run of the refresh, behind the predicate. A predicate that does not read the time has no schedule. A change still evaluates a time-dependent predicate at the time of its own decision."},
    {"id":"d-5025","ref":"D-5025","title":"A decision loads only the records that the plan of the segments names","group":"Automation","decided":"2026-11-19","statement":"**A decision loads only the records that the plan of the segments names.** The plan of a decision that evaluates segments (CT-295) names, for each person evaluated, the subject record and the records reached from it by the references that the predicate follows, and nothing else (K-100, ARC-108). A segment whose predicate would need a record that the plan cannot name, or that reaches further than two references, is refused when it is defined. An evaluation that fails or exhausts the step budget of tenant expressions (CMS-252) leaves the membership of the person as it was, and the failure names the person and the segment."},
    {"id":"d-5026","ref":"D-5026","title":"At most one hundred persons are evaluated in one transaction","group":"Automation","decided":"2026-11-19","statement":"**At most one hundred persons are evaluated in one transaction.** A transaction evaluates a segment for at most one hundred persons. A change that touches the subject records of more persons than that, or a record that more persons than that refer to, evaluates the first hundred in its own transaction and creates batch jobs for the rest in the same transaction. The same batches apply a changed predicate and a refresh. Each batch is its own transaction, it carries the version of the predicate and the position it reached, and a repeated batch writes no second event because membership already holds the result. A tenant holds at most one hundred segments, at most twenty-five of which read any one object type, so that one change evaluates a bounded number of predicates (D-6555)."},
    {"id":"d-5027","ref":"D-5027","title":"A changed predicate is applied in batches under a version","group":"Automation","decided":"2026-11-19","statement":"**A changed predicate is applied in batches under a version.** Changing the predicate raises the version of the segment and starts batches that evaluate every person of the subject type under the new predicate; the entries and exits that the change causes are written in the transactions of those batches, and all of them are written within as many batches as there are hundreds of persons at the time of the change. A change to a record that commits while the batches run is evaluated under the new predicate at once. A batch of a superseded version writes nothing. Until the batches end a person may still be a member under the old predicate; the segment says so by showing the version each membership was decided under."},
    {"id":"d-5028","ref":"D-5028","title":"A predicate reads only what its definer may read","group":"Automation","decided":"2026-11-19","statement":"**A predicate reads only what its definer may read.** When a segment is defined or changed, every field that the predicate names is checked against the policies of the defining principal, and a predicate that names a field the definer may not read is refused. A segment would otherwise let a person learn a hidden field by defining a predicate over it and listing the members. Evaluation is then done by the kernel for the tenant, with no principal of its own. A schema change that removes or retypes a field that a segment names is refused while the segment names it. Whether a later withdrawal of the definer's permission suspends the segment is an open question of this specification."},
    {"id":"d-5029","ref":"D-5029","title":"Reading the members of a segment is a policy-checked read","group":"Automation","decided":"2026-11-19","statement":"**Reading the members of a segment is a policy-checked read.** The members of a segment are listed to a principal who holds the capability to read them, and only the persons whose subject records that principal's policies permit it to read are shown (KRN-004). A membership holds the segment, the person, the version and the time of entry, and no field of the person, so that no second copy of personal data exists. The owner holds both capabilities, and an editor may read members."},
    {"id":"d-5030","ref":"D-5030","title":"A predicate can be tested against one person without writing anything","group":"Automation","decided":"2026-11-19","statement":"**A predicate can be tested against one person without writing anything.** A definer may test a predicate against one person before saving it. The test changes no state, returns the value and the names of the fields that the predicate read, and answers only for a person whose subject record the caller may read. It is the same evaluation that a change makes, so the answer is the one the segment would give."},
    {"id":"d-5031","ref":"D-5031","title":"Erasing a person removes the person from every segment","group":"Automation","decided":"2026-11-19","statement":"**Erasing a person removes the person from every segment.** The transaction that records the erasure of a person (PRV-353) removes every membership of the person and writes one exit event for each, with the reason erasure and the person named in sealed form (PRV-361, PRV-358). No later change enters an erased person into a segment, because the subject record has no readable field left to satisfy a predicate and the kernel does not evaluate an erased person. A trigger subscribed to the exit event receives a sealed person, which it cannot address."},
    {"id":"d-5032","ref":"D-5032","title":"Entry and exit events count toward the hop limit","group":"Automation","decided":"2026-11-19","statement":"**Entry and exit events count toward the hop limit.** An entry or exit event carries the hop count of the change that caused it, plus one. A trigger creates no job for an event past the hop limit that D-700 states (SCH-300), so a segment whose predicate reads a field that a workflow of the segment edits ends at the limit. A change past the limit still updates the membership and writes its event, so that membership stays equal to the evaluation; the trigger declines the job."},
    {"id":"d-5033","ref":"D-5033","title":"Removing a segment writes no exit event","group":"Automation","decided":"2026-11-19","statement":"**Removing a segment writes no exit event.** Removing a segment removes its memberships and its pending batches. It writes no exit event, because the persons did not stop satisfying a predicate: the segment ended. A trigger or workflow that names the removed segment is left to the owner to change; whether removal is refused while one does is an open question of this specification."},
    {"id":"d-5040","ref":"D-5040","title":"A setting is a definition and layered overrides","group":"Tenancy","decided":"2026-11-19","statement":"**A setting is a definition and layered overrides.** A setting has a definition, which is metadata, and any number of overrides, which are data. The definition states the name, the type, the default and the levels that may override it. The levels from the least to the most specific are the platform, the tenant, a team and a person. A setting that nobody has overridden has its default. Feature flags and quotas (D-510) stay what they are: a flag gates a release, and a setting is a value."},
    {"id":"d-5041","ref":"D-5041","title":"A read returns the most specific permitted override","group":"Tenancy","decided":"2026-11-19","statement":"**A read returns the most specific permitted override.** The value of a setting for a principal is the value of the override at the most specific level that the definition allows, that no lock closes and that reaches the principal: first the person's own override, then that of a team the person belongs to, then the tenant's, then the platform's, then the default. The answer names the level the value came from. An anonymous reader has no person and no team, so it is answered from the tenant, the platform and the default. Resolution is a pure function of the definition, the overrides and the teams, so the kernel decides it like any other read (D-15)."},
    {"id":"d-5042","ref":"D-5042","title":"Several teams of one person are ordered by team identifier","group":"Tenancy","decided":"2026-11-19","statement":"**Several teams of one person are ordered by team identifier.** When more than one team of the person holds an override of a setting, the override of the team whose identifier comes first, comparing the identifier text byte by byte in ascending order, is the one that applies. The order does not depend on the order in which the person joined the teams, on when the overrides were written or on which team is read first, so every reader and every copy computes the same answer. A tenant that wants one team to win names it so that its identifier sorts first."},
    {"id":"d-5043","ref":"D-5043","title":"A definition closes levels and a lock closes every level below one","group":"Tenancy","decided":"2026-11-19","statement":"**A definition closes levels and a lock closes every level below one.** The levels a definition allows are a non-empty set. A definition may be marked locked by the platform, which leaves only the platform level, or locked by the tenant, which leaves the platform and tenant levels. Only the platform marks a platform definition locked, and only the tenant marks one of its own definitions locked. A write at a closed level is refused. An override that exists at a level closed afterwards is kept and is not applied, and it applies again when the level is opened, so closing a level deletes nothing."},
    {"id":"d-5044","ref":"D-5044","title":"Who may write is a capability for each level, and a person writes only their own","group":"Security","decided":"2026-11-19","statement":"**Who may write is a capability for each level, and a person writes only their own.** Writing the platform level needs setting-write-platform, which platform operators hold. Writing the tenant level needs setting-write-tenant and writing the team level needs setting-write-team, which tenant owners hold. Writing the person level needs setting-write-person, which every signed-in person holds. A person-level override is written, changed and removed only by the person it belongs to, and no role changes that, the owner's included. Defining a tenant setting needs setting-define, and reading one's own settings needs setting-read."},
    {"id":"d-5045","ref":"D-5045","title":"An override is written against the revision it was read at","group":"Tenancy","decided":"2026-11-19","statement":"**An override is written against the revision it was read at.** Every override carries a revision, and a write names the revision it expects, as the publication settings do with the version of the record (CT-260). A write that names any other revision is refused with conflict and changes nothing, so two people who change the same override at the same time cannot overwrite each other. A first write expects revision zero. Removing an override is a write that carries no value."},
    {"id":"d-5046","ref":"D-5046","title":"A value has the type of its setting","group":"Tenancy","decided":"2026-11-19","statement":"**A value has the type of its setting.** The type of a setting is bool, i64, f64, string or timestamp, or the id of a declared type of kind id, scalar or enum. A default and an override are values of the kernel value algebra and are accepted only when they are of the type: for an enum one of its values, for an id or a scalar within its constraints. The type of a definition cannot change while any override of the setting exists, so no stored value is ever of another type than its definition; a different type is a different setting."},
    {"id":"d-5047","ref":"D-5047","title":"Platform definitions come with a release and a tenant setting never reuses their names","group":"Tenancy","decided":"2026-11-19","statement":"**Platform definitions come with a release and a tenant setting never reuses their names.** The platform's own definitions are released with the platform, as feature flags are (D-510), and a tenant's definitions are part of its schema and change through a schema change. A tenant definition that has the name of a platform definition is refused, so a name has one meaning in every tenant."},
    {"id":"d-5048","ref":"D-5048","title":"A change is an event that names what changed, and the audit log keeps the values","group":"Tenancy","decided":"2026-11-19","statement":"**A change is an event that names what changed, and the audit log keeps the values.** A committed change of an override, a definition or a lock is a domain event that names the setting, the level and the subject and carries no value, because a person-level value can be personal data. The previous and the new value are written to the audit log with the principal and the correlation identifier (OPS-329), where personal values are sealed (PRV-358). Open pages learn of the change through a live notice and read the settings again."},
    {"id":"d-5049","ref":"D-5049","title":"A copy depends on the revision of a setting, and a person's value never enters a shared copy","group":"Delivery","decided":"2026-11-19","statement":"**A copy depends on the revision of a setting, and a person's value never enters a shared copy.** A change of a definition, a lock or an override at the tenant, team or person level raises the tenant revision of the setting, and a change at the platform level raises its platform revision. The key of a view copy that depends on the setting contains both revisions (D-14), so a change makes a new key. The audience class of a principal for a read that depends on a setting is refined by where the value comes from: a value from a person-level override gives a class of that person alone, whose copies are never shared (K-7), a value from a team-level override gives the class of that team, and every other value leaves the class as the policies of the tenant derive it (D-15)."},
    {"id":"d-5060","ref":"D-5060","title":"An aggregate is declared by its named query over declared fields","group":"Content","decided":"2026-11-19","statement":"**An aggregate is declared by its named query over declared fields.** A named query may declare aggregates. An aggregate has a kind, which is count, sum, minimum, maximum or top, the field it reads, an optional field to group by and a scan bound. A top aggregate also states how many records it returns, from one to one hundred, and whether the greatest or the least value comes first. A named query declares the fields that a filter or an aggregate may name, and a declaration over any other field is refused when the query is defined, as a request that filters on one is refused (CMS-165). Aggregates are declared by a schema change like the rest of a named query, so they are tenant metadata (CMS-002); no GraphQL interface is added (NG-7)."},
    {"id":"d-5061","ref":"D-5061","title":"The input of an aggregate is the records the reader may read","group":"Content","decided":"2026-11-19","statement":"**The input of an aggregate is the records the reader may read.** A record enters an aggregate only when the policies of the reader's audience class permit the reader to read it and every field that the aggregate names: the field it reads, the field it groups by and the filter fields. A record that the reader may read in part is left out rather than counted with a hidden value, so the result is what the same computation gives when it is done one record at a time over what the reader may read. A reader never learns of a record it may not read from a count, a sum, a minimum, a maximum, a group or a place in a top list."},
    {"id":"d-5062","ref":"D-5062","title":"An aggregate declares a scan bound and is refused beyond it","group":"Platform","decided":"2026-11-19","statement":"**An aggregate declares a scan bound and is refused beyond it.** The scan bound of an aggregate is the number of records that it may examine, and it is at most ten thousand. The records counted against it are the records of the reader's audience class that the filter selects, so a refusal tells a reader nothing about records the reader may not read. When the plan of the aggregate would examine more, it is refused before any record is read, with the error scan-bound-exceeded and no result at all (K-100, CMS-255). An aggregate is never answered from part of the records."},
    {"id":"d-5063","ref":"D-5063","title":"An aggregate result is exact and its edges are fixed","group":"Content","decided":"2026-11-19","statement":"**An aggregate result is exact and its edges are fixed.** A count of no record is zero and a sum of no value is zero. A minimum or a maximum of no value is null. A record with no value in the field is left out of a sum, a minimum, a maximum and a top list, and the records of a group by a field with no value form one group of their own, which comes last. Groups come in ascending order of the group value. A top list orders equal values by ascending record identifier, so the same records always give the same list. A sum of integers is exact: a sum that does not fit the type of its field is refused with the error sum-overflow, never wrapped or rounded."},
    {"id":"d-5064","ref":"D-5064","title":"An aggregate result is a stored copy keyed by the versions it was computed from","group":"Delivery","decided":"2026-11-19","statement":"**An aggregate result is a stored copy keyed by the versions it was computed from.** A stored aggregate result has the key of a view copy (D-14): the tenant, the query, the aggregate, its arguments, the audience class, the schema version and the revision of each object type the aggregate reads. A commit to one of those object types makes a new key, so an answer computed before the commit is never found again; this is the whole of what stale means, and no lifetime is relied on except as a backstop. The result names the object types it depends on, as every read result does (CPY-004)."},
    {"id":"d-5065","ref":"D-5065","title":"An aggregate result is held for an audience class and never shared","group":"Delivery","decided":"2026-11-19","statement":"**An aggregate result is held for an audience class and never shared.** The audience class of the reader for an aggregate is derived by the kernel from the policies of the tenant (D-15), the key contains it, and a stored result is served only to principals of that class (CPY-006). A result can hold a principal, as a leaderboard does, so no aggregate result is a shared copy (K-7). A tenant whose policies treat every reader alike has one class and so one stored result per key."},
    {"id":"d-5066","ref":"D-5066","title":"No aggregate spans tenants","group":"Tenancy","decided":"2026-11-19","statement":"**No aggregate spans tenants.** An aggregate belongs to a named query of one tenant and reads the records of that tenant's database only (NG-6). A figure over several tenants is read from telemetry, published summaries and the tenant directory (ARC-110), not from an aggregate."},
    {"id":"d-5067","ref":"D-5067","title":"A view section may name an aggregate in place of rows","group":"Content","decided":"2026-11-19","statement":"**A view section may name an aggregate in place of rows.** A section of a view definition may name an aggregate of its query. The section then delivers the aggregate result for the reader in place of rows, and the view copy depends on the object types the aggregate reads, so a leaderboard or a progress figure is delivered, keyed and refreshed like any other part of a view."},
    {"id":"d-6200","ref":"D-6200","title":"The tenant export holds no credential material","group":"Tenancy","decided":"2026-11-20","statement":"**The tenant export holds no credential material.** The archive of a tenant export (TEN-010, D-701) holds records, files, configuration and audit entries, and it holds none of what proves who a person is or opens another system. The credentials, sessions, challenges and API grants of the identity service, the client secrets of identity providers, the connector secrets and the delivery keys of the tenant are not exported. An import creates each person without a credential and without a session. It issues one bootstrap credential for the first owner, as provisioning does (TEN-500), and every other person gets in by account recovery or a new invitation. Provider secrets, connector secrets, delivery keys and API grants are entered or issued again. The canonical hash that an export must reproduce (TEN-010) is the hash of the records the archive holds. Exporting needs a fresh authentication (D-6201), and the export is audited. Backup images keep their own protection (D-351, TEN-252) and are not readable by a tenant."},
    {"id":"d-6201","ref":"D-6201","title":"One authoritative list of the operations that need a fresh authentication","group":"Identity","decided":"2026-11-20","statement":"**One authoritative list of the operations that need a fresh authentication.** This list replaces the list in D-4915, and a contract on it states `stepUp` in its authorisation (D-700: fifteen minutes) and a `step-up-required` error of kind `forbidden`. The operations are: registering and removing a passkey (CT-055, H-033), changing a password (CT-062), rotating a client secret (CT-080), ending a session other than the current one (CT-061), changing the realm configuration (CT-065), exporting a tenant (CT-038), restoring a tenant (CT-041), requesting and executing the deletion of a tenant (CT-550, CT-039), issuing a support grant (CT-208), assigning a role or putting a person in a team or inviting a person, each of which can confer the owner role (CT-265, CT-267, CT-269), binding and removing a domain name (CT-044, CT-045), erasing a principal, which destroys the key of that principal (CT-213), promoting a release (CT-225), recording an enterprise contract and setting a platform flag or quota (CT-551, CT-552). The key operations of the key service (CT-151..155) are in-process and are reached only through contracts of this list: tenant deletion and subject erasure destroy keys, and no other contract reaches a key operation. The reset of a fixture and the recovery codes of D-4915 join the list when a contract for them exists. A new contract that changes how a person gets in, removes the access of other people, exposes or destroys the data of a whole tenant, or changes a platform control joins the list in the same change. A role assignment needs the fresh authentication whatever the role it assigns, because a contract states one authorisation, not one per input."},
    {"id":"d-6202","ref":"D-6202","title":"Flags, quotas and plans: platform control and tenant control are apart","group":"Tenancy","decided":"2026-11-20","statement":"**Flags, quotas and plans: platform control and tenant control are apart.** A feature flag and a quota are platform controls. The capability `platform-flags-manage` changes them, and only the platform operator holds it; no tenant role holds it. The capability `flags-manage` is the tenant capability, and it changes only a tenant switch: a switch that the release record of a flag defines for a tenant to turn on or off. Today the one tenant switch is `assistant`. A tenant switch can be turned on only for a tenant whose release record enables the flag (OPS-328) and can always be turned off. The assistant therefore needs two things: the release record enables it for the tenant (OPS-328, `assistant-flag`) and an owner turns it on (D-514, CNV-500). The text supports the release record as the gate: the flag record is owned by the release controller and lasts as long as its release (`rec-feature-flag`), and `assistant-flag` says the flag is off unless the release record enables it, so D-514 is read as the tenant switch inside what the release record enables, and an owner cannot enable a flag the release record has not. A quota is changed only through CT-552, as an audited operation (D-508). A change of plan by an owner needs the billing account of the tenant in good standing, and a change to or from Enterprise, whose quotas are set by contract (D-508), needs a contract that the platform operator has recorded for the tenant (CT-551)."},
    {"id":"d-6203","ref":"D-6203","title":"Each platform component holds a credential of its own with its own capabilities","group":"Security","decided":"2026-11-20","statement":"**Each platform component holds a credential of its own with its own capabilities.** A platform component calls with a credential that carries the service role of that component alone (SEC-004), and the role confers only the capabilities that the calls of that component need. The roles are `svc-gateway`, `svc-runtime`, `svc-agent-gateway`, `svc-identity-service`, `svc-control-plane`, `svc-automation-worker`, `svc-conversation-service`, `svc-connector-runner`, `svc-telemetry-pipeline`, `svc-release-pipeline`, `svc-release-controller`, `svc-migration-job`, `svc-operator-console` and `svc-subject-rights-service`. The role `platform-service` holds no capability from now on. The audit log derives the actor of an entry from the credential of the caller and takes no actor from the request (SEC-1207). Ending the sessions of a principal is a change of state and needs the capability `session-end`, which only the runtime holds, and not the capability `session-verify`, which looks sessions and tokens up."},
    {"id":"d-6204","ref":"D-6204","title":"A support grant has a purpose, a scope, a bound and a tenant veto","group":"Privacy","decided":"2026-11-20","statement":"**A support grant has a purpose, a scope, a bound and a tenant veto.** A support grant names the operator, the tenant, a purpose, a scope and an expiry (D-352, PRV-367). The expiry is at most seventy-two hours after the grant is issued, and a longer need is a new grant that the owner issues again. The grantee holds the role `support` or `platform-operator`. A tenant that sets `forbid-platform-access` in its realm configuration has every grant to platform staff refused, and an owner of such a tenant cannot issue one. The role `support` holds nothing of its own, and a live grant confers the capability `tenant-support-read` on its grantee for that one tenant (`support-grant`). A request made under a grant that is expired, withdrawn, issued for another tenant or issued to another operator is refused and audited in the tenant. A diagnostic run by platform staff or by the platform operating agent in a tenant is a platform act inside the tenant, so it needs a live grant for the tenant like any other (G-165). The platform operating agent reads no tenant content (D-530, AGS-424), so its diagnostics return health and configuration and never content. When no owner of a tenant can consent, no break-glass access exists: the operator does not act inside the tenant (D-253), and the tenant is brought back by account recovery of an owner (IDN-020)."},
    {"id":"d-6205","ref":"D-6205","title":"The restore window is thirty days by default and never under fourteen days; five minutes is the recovery point","group":"Data safety","decided":"2026-11-20","statement":"**The restore window is thirty days by default and never under fourteen days; five minutes is the recovery point.** The restorable window of a tenant database is the restore window of D-522: thirty days unless the tenant chose another, and a tenant cannot choose fewer than fourteen days (OPS-320). The five minutes of DEP-011 is not a window. It is the most committed change a restore inside the window may lose (the recovery point objective), and a restore reports what it lost (MIG-573, D-579). So the window is thirty days by default with a floor of fourteen, and the point objective is five minutes."},
    {"id":"d-6206","ref":"D-6206","title":"A restore never brings back access that was taken away","group":"Data safety","decided":"2026-11-20","statement":"**A restore never brings back access that was taken away.** A point-in-time restore replaces tenant state, so it could replace revoked access with the access of the restore point. It does not. When a restore completes and before the tenant serves a request, the identity service ends every session of the tenant, expires every challenge, revokes every API grant and every support grant, and refuses every delivery key that was live at the point until it is issued again. It then re-applies from the audit log, for the entries after the restore point, each removal of a role assignment or team membership, each deactivation of a principal, each removal or change of a credential, each rotation or removal of a client secret, connector secret or delivery key, and each withdrawal of a support grant. A legal hold that was placed after the point stays in place, and a hold that was lifted after the point is not lifted again by the restore. The audit log is not rolled back by the restore, and the restore itself is an audited operation."},
    {"id":"d-6207","ref":"D-6207","title":"Deleting a tenant is requested, noticed and then executed","group":"Tenancy","decided":"2026-11-20","statement":"**Deleting a tenant is requested, noticed and then executed.** Deleting a tenant has two steps. An owner requests it (CT-550) with a fresh authentication and the identifier of the tenant (OPS-325). The request records who asked and when the grace period that the plan states ends (D-705), and it tells every owner of the tenant by mail, naming the person who asked and the time of execution. An owner can cancel until then (CT-040), and the cancellation also tells every owner. After the grace period an owner executes the deletion (CT-039) with a fresh authentication. The platform operator holds no deletion capability: an operator ends abuse by suspension (CT-036) and not by deletion, so the words in CT-039 that let the platform operator delete a tenant are removed. The certificate names the key destruction, the removal of each backup image and of each export, the removal of the retained source database of a tenant that was moved (MIG-572), the removal of every fork of the tenant (CT-166) and the removal of the state that the key service held for the tenant."},
    {"id":"d-6208","ref":"D-6208","title":"The audit log has a retention floor, a head checkpoint, a target and an outside anchor","group":"Observability","decided":"2026-11-20","statement":"**The audit log has a retention floor, a head checkpoint, a target and an outside anchor.** The audit entries of a tenant are kept for one year at least, which is the platform default (D-539), and a tenant can lengthen the period up to ten years and cannot shorten it. The lower bound of thirty days in D-708 applies to the other record types and not to audit entries. Each entry names its actor, its target (the identifier of the thing acted on), its outcome and its own hash, and holds the hash of the entry before it. When expiry removes the oldest entries, it first records the sequence number and the hash of the newest entry it removes in the audit chain record of the tenant, as the checkpoint, and a verification starts at that checkpoint. The audit log also writes the head of each tenant chain to the platform audit store every fifteen minutes, outside the tenant database, as the anchor. A chain that stops short of the anchored head, or whose entries do not chain from the checkpoint, is broken, so a removal at the end of the log is found as well as a removal in the middle. Operator actions on the control plane are written to the platform audit store, which keeps them seven years (D-707)."},
    {"id":"d-6209","ref":"D-6209","title":"A token is revoked by a notice that every verifier receives within five seconds","group":"Identity","decided":"2026-11-20","statement":"**A token is revoked by a notice that every verifier receives within five seconds.** D-5 says that tokens are short-lived so that revocation needs no list, TOK-007 asks for the five-second bound of sessions, and local verification checks a signature and an expiry only. One rule replaces them. An access token lives at most five minutes (TOK-005). The identity service publishes each revocation of a grant, each revocation of a session and each retirement of a signing key to every verifier as a notice, and a verifier applies it within five seconds (IDN-014, TOK-007, TOK-251). A verifier checks the signature, the expiry and the notices it holds, and it does not introspect on each call. A verifier that has not received the notice feed for more than five seconds asks the identity service by introspection (CT-076) for each call or refuses the call, and it does not accept a token on signature and expiry alone. The lifetime of five minutes remains the bound of exposure when a notice is lost for good. D-5 is read with this rule: a list of revocations exists, and it is the notice feed."},
    {"id":"d-6210","ref":"D-6210","title":"A catalogue operation needs what its contract needs","group":"Agents","decided":"2026-11-20","statement":"**A catalogue operation needs what its contract needs.** Invoking an operation of the catalogue (CT-110) is a way to reach a contract, not a different door to it. The caller needs `operation-invoke` and also every capability that the authorisation of the underlying contract requires and one of its roles, and the policies of the tenant apply as they do to a direct call (AGT-014). The check uses the principal that the call acts for, and an agent never has more than the person it acts for (TOK-004). The operation `delete-tenant`, `export-tenant` and `issue-access-grant` are reached through the catalogue only by an owner with a fresh authentication."},
    {"id":"d-6220","ref":"D-6220","title":"A tenant has six lifecycle states, and a suspension has a commercial or a takedown reason","statement":"**A tenant has six lifecycle states, and a suspension has a commercial or a takedown reason.** The directory states are provisioning, active, suspended, moving, restoring and deleting. A suspension names one reason. Payment overdue, trial ended and owner request are commercial: the site stays readable and nothing else runs. Abuse, legal order and security incident are takedown reasons: the site is not served, no outbound effect leaves, and only the owner keeps deletion and, for abuse, export. Only a takedown reason needs the capability `takedown-issue` (TEN-1220, THR-1226).","group":"Tenancy","decided":"2026-11-20"},
    {"id":"d-6221","ref":"D-6221","title":"A takedown reaches gateways within 60 seconds, and within 15 minutes at the outer limit","statement":"**A takedown reaches gateways within 60 seconds, and within 15 minutes at the outer limit.** Directory entries of an active tenant keep the 15-minute bound of D-528. An entry whose state is not active, and a host marked taken down, is held for at most 60 seconds and is never aged back into active. A takedown is refused while the control plane cannot record it, and a gateway that loses the control plane stops serving 15 minutes after it last reached it (ARC-500). The stricter option was chosen over a break-glass path that bypasses the control plane (ARC-1228, ARC-1229).","group":"Tenancy","decided":"2026-11-20"},
    {"id":"d-6222","ref":"D-6222","title":"The first owner receives the first credential directly from the platform","statement":"**The first owner receives the first credential directly from the platform.** The bootstrap credential is mailed to the address of the first owner and is never returned to, logged for or shown to the operator who provisions the tenant. This tightens D-509 (TEN-1230).","group":"Tenancy","decided":"2026-11-20"},
    {"id":"d-6223","ref":"D-6223","title":"A fork is a tenant of its own that lives at most seven days","statement":"**A fork is a tenant of its own that lives at most seven days.** A fork has its own database and key in the region of its source, no credential of the source, nothing running outside the platform, and ends after 7 days, with the projection it serves, or with its source. A subject erasure in the source reaches every live fork before it is reported complete (TEN-1234, TEN-1235, TEN-1236).","group":"Tenancy","decided":"2026-11-20"},
    {"id":"d-6224","ref":"D-6224","title":"A sandbox is started by a verified mail address, and a move never changes region","statement":"**A sandbox is started by a verified mail address, and a move never changes region.** The starter of a sandbox is a visitor who proved control of a mail address, with one live sandbox per address. A move to a placement in another region is refused (TEN-1237, TEN-1238, TEN-1239).","group":"Tenancy","decided":"2026-11-20"},
    {"id":"d-6560","ref":"D-6560","title":"A product sends through one contract, and the workflow step is its in-process call","group":"Automation","decided":"2026-11-20","statement":"**A product sends through one contract, and the workflow step is its in-process call.** The contract send-message takes a template, a recipient (a principal, an address or a segment), a category, an allowance class, an idempotency key, a reference and an optional delivery time. A workflow step of the same name has the same fields and calls the contract; when the step names no idempotency key it uses the run and the step, so a replayed step sends once. The alternative is a separate contract for the step with its own fields, which lets the two drift."},
    {"id":"d-6561","ref":"D-6561","title":"A send to a segment reads membership batch by batch, and the sender sees counts only","group":"Automation","decided":"2026-11-20","statement":"**A send to a segment reads membership batch by batch, and the sender sees counts only.** The batches are at most one hundred persons in ascending order of principal identifier, as in SEG-028, and membership is read in the transaction of each batch, so a person who leaves the segment after the send began but before their batch is not sent to. The alternative is a snapshot of every member at the start, which fixes the audience but needs storage for each recipient."},
    {"id":"d-6562","ref":"D-6562","title":"Categories have one of three purposes, and a suppression names a category","group":"Automation","decided":"2026-11-20","statement":"**Categories have one of three purposes, and a suppression names a category.** The purposes are required, transactional and promotional. A suppression has a category, which is a category name, the whole address (*) or every promotional category (*promotional). A permanent bounce suppresses the whole address; a complaint and an unsubscribe suppress the category of the message and, for a promotional category, every promotional category. The alternative is one suppression list with a flag for marketing, which cannot tell a newsletter from a campaign the person wants."},
    {"id":"d-6563","ref":"D-6563","title":"Three allowance classes: sign-in, transactional and bulk, with bulk limited to eighty percent","group":"Automation","decided":"2026-11-20","statement":"**Three allowance classes: sign-in, transactional and bulk, with bulk limited to eighty percent.** Sign-in mail stays outside the allowance (EML-021). Bulk mail may use eighty percent of the monthly allowance of the plan, and transactional mail all of it, so a campaign cannot use up the allowance that receipts need. The release order is sign-in, transactional, bulk. The alternative is a reserved fixed number of transactional messages, which does not scale with the plan."},
    {"id":"d-6564","ref":"D-6564","title":"The complaint breaker uses the provider's published thresholds","group":"Automation","decided":"2026-11-20","statement":"**The complaint breaker uses the provider's published thresholds.** Warning at 0.1 percent complaints or 5 percent permanent bounces, bulk held at 0.5 and 10 percent, transactional held at 1 percent complaints, each over seven days and at least 1000 accepted messages. The owner receives the notices mail.sending-warning and mail.sending-held. The alternative is a platform-wide fixed rate with no warning, which holds a tenant without telling it first."},
    {"id":"d-6565","ref":"D-6565","title":"A person's preferences are a record, and quiet hours, mute and time zone are person settings","group":"Automation","decided":"2026-11-20","statement":"**A person's preferences are a record, and quiet hours, mute and time zone are person settings.** The mode for each category and channel is a record written by set-notification-preference. Quiet hours, the mute time and the person time zone are person-level settings (D-5044) that the dispatcher and the notification service read for a named recipient through resolve-recipient-setting, since setting-resolve answers for the caller only. The alternative is to put every category in a setting definition, which makes the number of definitions grow with the number of categories."},
    {"id":"d-6566","ref":"D-6566","title":"Topics are dotted names, the platform owns every topic outside app.","group":"Automation","decided":"2026-11-20","statement":"**Topics are dotted names, and the platform owns every topic outside app.** The platform produces approval.requested (an approval step waits, to the principals its policy names), approval.decided (the approval was decided, to the requester), form.submitted (a form was submitted, to subscribers who hold submissions-export), file.scan-finished (the scan of a file ended with a verdict other than clean, to the uploader), mail.sending-warning and mail.sending-held (the breaker or the allowance, to owners). A tenant produces topics that begin with app. only. The alternative is free strings, which cannot be filtered or checked."},
    {"id":"d-6567","ref":"D-6567","title":"Time zones are IANA names and recurrence is an RRULE subset with a TZID part","group":"Automation","decided":"2026-11-20","statement":"**Time zones are IANA names and recurrence is an RRULE subset with a TZID part.** A time zone is a name of the IANA time zone database in the version the release carries, held as a platform setting at the tenant and person levels. A recurrence is the RRULE value of RFC 5545 section 3.3.10 in the subset of SCH-1574 with the added part TZID. A wall-clock time that does not exist is read at the offset before the change, and one that happens twice is the first (RFC 5545 section 3.3.5). When the database changes, the next due time of each schedule is computed again. The alternative is a fixed UTC offset, which is wrong twice a year."},
    {"id":"d-6568","ref":"D-6568","title":"A product may declare its own domain event kinds in the app. namespace","group":"Automation","decided":"2026-11-20","statement":"**A product may declare its own domain event kinds in the app. namespace.** A declared kind has at most 16 scalar fields and a list of reader roles, is stored as tenant metadata, and is emitted by emit-event in the transaction of the change; it is delivered to triggers and to subscribers whose roles may read it. The alternative is that a product reacts only to record events on its own types, which cannot say that a badge was earned unless a record changes."},
    {"id":"d-6569","ref":"D-6569","title":"Inbound deliveries have a five minute window, seven days of deduplication and a twenty-four hour overlap","group":"Automation","decided":"2026-11-20","statement":"**Inbound deliveries have a five minute window, seven days of deduplication and a twenty-four hour overlap.** The signature of an inbound webhook delivery and of a mail delivery report covers a timestamp, and a delivery more than five minutes from the receipt time is refused. The event identifier is remembered for seven days. A rotated webhook secret overlaps the previous one for twenty-four hours. The alternative is a longer window, which gives a captured delivery longer to be replayed."},
    {"id":"d-6570","ref":"D-6570","title":"The outbound rule is HTTPS on port 443 only","group":"Automation","decided":"2026-11-20","statement":"**The outbound rule is HTTPS on port 443 only.** An outbound call uses https and port 443, with no user name or password in the address, and a redirect is held to the same rule. The alternative is an allow list of ports for each connector, which lets a tenant reach services on other ports of the public internet and adds a list to maintain."},
    {"id":"d-6571","ref":"D-6571","title":"Measurement is counts by state over the thirty day mail log","group":"Automation","decided":"2026-11-20","statement":"**Measurement is counts by state over the thirty day mail log.** count-mail-messages returns counts by state grouped by reference, category or template, over the messages the log still holds (rec-mail-message, thirty days). It offers no opens and no clicks (NG-8). The alternative is a longer-lived counter for each reference, which keeps data about people longer to answer a question the owner can ask within the month."},
    {"id":"d-6572","ref":"D-6572","title":"A line break in a header field is refused, not removed","group":"Automation","decided":"2026-11-20","statement":"**A line break in a header field is refused, not removed.** A subject or an address that contains a carriage return, a line feed or a NUL byte is refused with the error invalid before any job exists. The alternative is to strip the characters, which sends a message the author did not write."},
    {"id":"d-6573","ref":"D-6573","title":"A digest is delivered once a day or once a week at 09:00 in the person's zone","group":"Automation","decided":"2026-11-20","statement":"**A digest is delivered once a day or once a week at 09:00 in the person's zone.** A person whose mode is digest receives one message for each period at 09:00 in the zone of the person; a weekly digest is sent on Monday. A tenant may name another time by the step send-digest. The alternative is a digest at a time each person chooses, which needs another preference for every person."},
    {"id":"d-6580","ref":"D-6580","title":"A bundle has a section for every kind of tenant-declared entity","group":"Platform","decided":"2026-11-20","statement":"**A bundle has a section for every kind of tenant-declared entity.** The content of a tenant bundle is typed (bundle-sections): record types, roles, role permissions, capabilities, policies, queries, views, workflows, segments, setting definitions, ledger units, ledger pools, ledger limits, mail templates, notice templates and tokens. Triggers, automations and operations are sections of triggers, automations and operations, each a list of values of trigger-def, automation-def and tenant-operation-def. The sections correspond to the sections of a product file (objects, policies, segments, settings, ledgerUnits, ledgerPools, ledgerLimits, mailTemplates, noticeTemplates, tokens, triggers, automations and operations, D-6700), so specc turns a product file into a bundle without losing an entity. The session contracts for segments, ledger units, pools and limits, settings, mail templates and tokens stay, and lower onto the same edits (tenant-config-change)."},
    {"id":"d-6581","ref":"D-6581","title":"Install, upgrade and remove are product changes","group":"Platform","decided":"2026-11-20","statement":"**Install, upgrade and remove are product changes.** The three operations are variants of one change (product-change) that carries schema-change edits and catalogue edits. The edits of a bundle are applied together or not at all, as one commit of the tenant schema and catalogue, with one projection shown before it applies (INT-154). The tenant schema and schema-change themselves do not change: the catalogue is held beside the schema, so no schema hash changes and no kernel function over a schema change has to. An upgrade lists the entities of the earlier version that the new one drops and carries the migration of changed record types as the schema change that it is. A removal carries no edits: the kernel finds the entities the product owns. A record type with records is not removed unless the removal says the records are deleted. Alternative: one contract with a mode input; rejected because the three have different errors and different confirmations. Amended by D-7341: the entities and the ownership record are the changes of one change-schema intent, and the tenant schema holds the templates, tokens and product records."},
    {"id":"d-6582","ref":"D-6582","title":"Ids are namespaced by product and every installed entity records its owner","group":"Platform","decided":"2026-11-20","statement":"**Ids are namespaced by product and every installed entity records its owner.** A product id is lower-case words joined by hyphens; the namespace of its entities is that id with each hyphen replaced by an underscore, followed by two underscores, so an id such as badges__award fits the tenant id pattern. The tenant catalogue records, for each installed product, the entities it owns (installed-product.owns). An id with two underscores that is not in the namespace of the installing product is refused. A change from outside the product to an entity it owns is refused; the owner changes it by an upgrade. A segment id is derived from the tenant and the namespaced key, so an install gives the same segment-id every time. Alternative: an owner field on every entity, or the ownership map inside the tenant schema; rejected because either changes the hash of every schema."},
    {"id":"d-6583","ref":"D-6583","title":"A bundle declares its platform range and installs idempotently","group":"Platform","decided":"2026-11-20","statement":"**A bundle declares its platform range and installs idempotently.** A bundle may carry platform-compat: the first platform release it supports and the first it does not. An install on a release outside it is refused. Installing the same product and version again changes nothing and returns the first schema version, so a retry is safe without a key; the idempotency-key input of the convention (D-6595) is accepted as well. A version that is not greater than the installed one is refused by upgrade."},
    {"id":"d-6584","ref":"D-6584","title":"A tenant field declares its personal data and a record type its retention","group":"Privacy","decided":"2026-11-20","statement":"**A tenant field declares its personal data and a record type its retention.** A field-def may carry personal: the kind of personal data (personal-kind), whose data it is (data-subject: the creator of the record, or the principal named by another field) and whether the search index may hold it. A field with personal is sealed under the key of its subject (PRV-358). An object-type-def may carry retention: days and what they count from; a type with a personal field must carry it, and any other type takes the default of the tenant policy. A product whose records hold the data of a person other than the creator must say so in the declaration: the platform cannot infer it."},
    {"id":"d-6585","ref":"D-6585","title":"Subject rights reach tenant types, the search index, free text and files","group":"Privacy","decided":"2026-11-20","statement":"**Subject rights reach tenant types, the search index, free text and files.** Export includes each declared field of each tenant type whose subject is the principal, and the content of the files they refer to. Rectification replaces the field in the record, in the copies and in the search entry. Restriction withholds the declared fields from every read that is not the subject's own. Erasure destroys the subject key and, in the same commit, deletes the search entries that hold a field of the subject and the files referred to only by such fields; the receipt names them. Free text, rich text and file content are personal data only where a field declares it: they are then sealed whole, so erasing the key erases all of the prose or file with no search for names inside it. A field that is not declared is outside these rights, and the processing record (PRV-378) lists the declared fields, so the owner can see what is covered. Search: a personal field is matched only when its declaration says searchable, and then the index entry is deleted at erasure rather than relying on the key. Alternative: make every personal field searchable by default; rejected because it exposes sealed fields to the index."},
    {"id":"d-6586","ref":"D-6586","title":"The read expression of a field is a rule of every read path, evaluated by the kernel","group":"Kernel","decided":"2026-11-20","statement":"**The read expression of a field is a rule of every read path, evaluated by the kernel.** field-def.read, when present, is an expression over the reading principal and the record. If it is true the principal may read the field; if absent, whoever may read the record may read the field. A field the principal may not read is absent from a record read, a query result, a view, a delivery list, an event body, a search result and an export, and cannot be named by a filter, an order or a segment predicate of that principal (field-forbidden). Search matches only readable fields; an aggregate leaves out the record (D-5061). The kernel evaluates the rule once, in its read and event-filtering functions, and the runtime, the gateway and the search index call them rather than evaluate it themselves. The tenant export of an owner (tenant-export) is the owner's complete copy of the tenant and is not filtered; the subject export is the subject's own data. A missing rule on a read path is a defect, tested with a record that has a public and a private field."},
    {"id":"d-6587","ref":"D-6587","title":"A file is a field type and its readability follows the record that refers to it","group":"Content","decided":"2026-11-20","statement":"**A file is a field type and its readability follows the record that refers to it.** The file field type holds a content hash and declares the media types it accepts, its size cap and its renditions. A principal may read a file when the principal may read a record that refers to it through a field the principal may read. A file no record refers to is readable only by the uploader, and is removed after 24 hours. So a private avatar and a public cover image differ only in the policy of the records that refer to them. Alternative: a visibility flag on the file; rejected because it would be a second policy."},
    {"id":"d-6588","ref":"D-6588","title":"A signed address is checked at signing and at delivery","group":"Delivery","decided":"2026-11-20","statement":"**A signed address is checked at signing and at delivery.** Signing requires that the caller may read the file and that the principal named may read it. The expiry is at most 3600 seconds, and a tenant may set less (file-limits.address-max-seconds). Delivery requires that the session of the request is that of the principal named, that the address has not expired and that the principal may still read the file; the check is made at delivery, so a revoked right stops a live address. The private copy at the edge is per principal and is purged within its declared bound when the file or the right goes (copy-private-media)."},
    {"id":"d-6589","ref":"D-6589","title":"Uploads are bounded, chunked and announce completion","group":"Content","decided":"2026-11-20","statement":"**Uploads are bounded, chunked and announce completion.** The platform maximum is 104857600 bytes, a tenant may lower it and a field may lower it again. A file of at most 1048576 bytes goes in one upload-file call; a larger one uses start-upload (which refuses a size over the cap), put-upload-chunk (chunks of at most 8388608 bytes, idempotent by index) and finish-upload. The domain events file-scanned and rendition-ready follow the scan and each rendition, so a trigger can wait for them. Renditions are declared on the file field (name, largest width and height, format) and produced by the job of CMS-009."},
    {"id":"d-6590","ref":"D-6590","title":"A product may declare capabilities, confined to its own operations","group":"Identity","decided":"2026-11-20","statement":"**A product may declare capabilities, confined to its own operations.** A product file may declare capabilities. Each id begins with the namespace of the product, the capability confers nothing by itself, and a product operation may require it. A platform operation never requires it, and a role of the product may list it with platform capabilities. This is the one platform section a product may declare, because a capability is only a name that tenant roles grant; it adds no platform code. It needs a change to the product layer rules (the capabilities section and a check of the namespace). Alternative: no product capabilities and per-operation policy only; rejected because policies are per object type and action, so a feature that is not a record action cannot be granted alone."},
    {"id":"d-6591","ref":"D-6591","title":"Member capabilities cover self-service and not authoring","group":"Identity","decided":"2026-11-20","statement":"**Member capabilities cover self-service and not authoring.** Three platform capabilities exist: self-record-write (create and change records the principal created or that name the principal as subject, under the policies), self-file-upload (upload into a file field a policy lets the principal write) and self-events-read (subscribe to events about records the principal may read). mutate-record, upload-file, start-upload and subscribe-events accept either their authoring capability or the member one; when a contract lists more than one capability in requires, any one suffices. A member role holds the three. The draft, article and publication contracts need content-write only."},
    {"id":"d-6592","ref":"D-6592","title":"Publication is a contract set for any type that declares it","group":"Content","decided":"2026-11-20","statement":"**Publication is a contract set for any type that declares it.** An object-type-def may declare publication: the workflow field, the draft, published and withdrawn states, optionally the in-review and approved states, a publication time field, a review workflow and the field that holds the review run. publish-content, withdraw-content, submit-for-review and schedule-publication work for any such type. submit-for-review starts the review workflow and stores the run in the record; the approval of the last step moves the record to approved; publish-content accepts a type marked for review only from approved. A scheduled publication runs as the principal that scheduled it, and is refused at the time if that principal may no longer publish. Cancelling a schedule is schedule-publication without a time (CMS-158)."},
    {"id":"d-6593","ref":"D-6593","title":"Language is a field type, a record language and a request language","group":"Content","decided":"2026-11-20","statement":"**Language is a field type, a record language and a request language.** The language field type holds a language-tag. An object type names the field that holds the language of each record and, optionally, the field whose equal values group the translations of one record. The context of a request carries the language of the reader: the language the request names, else the language setting of the person, else Accept-Language, else the default language of the tenant. A record requested in a language it lacks is answered from the first fallback language of the tenant that it has, else the default language. Token formatting (CTK-013) uses the language of the context."},
    {"id":"d-6594","ref":"D-6594","title":"The settings schema marks each value platform-fixed or tightenable","group":"Tenancy","decided":"2026-11-20","statement":"**The settings schema marks each value platform-fixed or tightenable.** The realm numbers (lockout, throttles, session lifetimes, recovery delay), the allowed second factors, the password policy, registration, the audit retention, the outbound allow-list, the file limits, the webhook limit, the platform-access forbid flag and the breach notice period are typed values (realm-settings and tenant-settings). Each states its platform default (D-700 where it gives one), whether it is tightenable and in which direction, and every number has a floor and a ceiling that the platform holds as data. The platform-fixed values are the breached-password check and that password is never a second factor. A value on the looser side is refused. Realm values are set by configure-realm and tenant values by configure-tenant-settings, which needs the new capability tenant-configure. The platform defaults for values that D-700 does not give are held as data and set by release."},
    {"id":"d-6595","ref":"D-6595","title":"Contract conventions: one name and one shape for each","group":"Platform","decided":"2026-11-20","statement":"**Contract conventions: one name and one shape for each.** The input that guards against a concurrent change is expected-version (u64, or schema-version for a schema); the pagination inputs are cursor (opaque string) and limit (default 50, at most 100) and the output is next (absent at the end); the idempotency input is idempotency-key (a string of at most 128 bytes, optional, scoped to the tenant, the principal and the contract, honoured for 24 hours, the same key with other input answered idempotency-mismatch); the error kinds are unauthenticated, forbidden, not_found, invalid, conflict, throttled, unavailable and internal, and a contract may name an error more precisely if the kind is one of these. The rule (ARC-1599) applies to contracts with exposure public; internal sequence reads (list-events-after, list-journal-after, list-outbox) keep after because they read an ordered log. expected-version is the majority and matches the kernel error version-conflict; alternative: expected-revision, which the settings use. The contracts that must change: expected-version replaces based-on-version in save-draft and save-record-edit and expected-revision in invoke-operation and setting-set-platform, setting-set-tenant, setting-set-team and setting-set-person; cursor, limit and next replace after and next in list-ledger-entries and after in query-audit-log; limit is added to list-inbox, list-mail-messages, list-jobs, list-operations, run-named-query, deliver-view and list-webhook-deliveries; idempotency-key is added to mutate-record, create-article, update-article, delete-article, save-draft, save-site-settings and setting-set-*; field-not-readable, too-many and rejected become invalid or forbidden, and throttled is declared on mutate-record, post-ledger-entry and setting-set-*. The contracts that were listed follow these conventions in this specification, with the exceptions the exemption list of the rule names: the rejected, too-many and field-not-readable errors are now named refused, limit-reached and field-forbidden, preview-segment-predicate keeps a largest limit of 1000 (SEG-1542), and the idempotency-key of invoke-tenant-operation is an input of the contract, passed to decide-tenant-operation, and required rather than optional, because the ledger key of each posting the invocation makes is formed from it (D-6548, OPR-1545)."},
    {"id":"d-6596","ref":"D-6596","title":"A module contains no platform code and registers none","group":"Platform","decided":"2026-11-20","statement":"**A module contains no platform code and registers none.** D-103 is read with NG-3 and the product layer rules: a module is declared metadata and contains no platform code, and it does not register code with the platform. A feature that needs platform code is a component of the platform specification, released with the platform, and a module then reaches tenant data through the runtime (ARC-112, ARC-113). The one thing a product file may declare that is not tenant data is a capability name (D-6590), which holds no code."},
    {"id":"d-6597","ref":"D-6597","title":"Product layer rules that this slice needs changed","group":"Platform","decided":"2026-11-20","statement":"**Product layer rules that this slice needs changed.** The product layer rules in specc and Exegra need three changes, which D-6700 makes: the capabilities section becomes a product section whose ids must begin with the product namespace; the check that ids are prefixed by the product id becomes a rule that refuses any id without the namespace; and the sections that WG-5031 and WG-5032 add are listed beside the others. The kinds of the section list (records, types, screens, forms, actions, liveBindings, errorMessages, behaviors, events, contracts, roles, scenarios, uiScenarios, claims, evidence) are otherwise unchanged. A product file may not set the retention or personal declaration of a platform record type."},
    {"id":"d-6540","ref":"D-6540","title":"Rule arithmetic is checked integer arithmetic","group":"Platform","decided":"2026-11-20","statement":"**Rule arithmetic is checked integer arithmetic.** The tenant rule language gains addition, subtraction and multiplication of integers, written a + b, a - b and a * b. Multiplication binds tighter than addition and subtraction, both bind tighter than comparison, and both group to the left. An operand or a result outside -(2^53-1) to 2^53-1, the range that D-5004 gives every amount because every evaluator of the specification holds it exactly, fails the evaluation with the error integer-overflow, and a failed evaluation refuses the decision it belongs to as any evaluation error does (CMS-252). Using that range in Rust and in JavaScript is what lets the two evaluators agree without a big-integer type in either. Rejected: wrapping or saturating arithmetic, which turns a defect into a wrong balance or threshold without a trace; the full i64 range, which JavaScript numbers do not hold exactly; floating point, which the value algebra does not have and which makes equality of totals depend on the order of addition; division and remainder, which need a rounding rule and which no product rule of the composition audit needs, since a ratio is compared by multiplying the other side."},
    {"id":"d-6541","ref":"D-6541","title":"Time arithmetic counts milliseconds","group":"Platform","decided":"2026-11-20","statement":"**Time arithmetic counts milliseconds.** A timestamp of the rule language is a count of milliseconds since 1970-01-01T00:00:00Z (the kernel Value::Time). t + d and t - d, with t a timestamp and d an integer, give the timestamp d milliseconds after or before t. ms_between(a, b) gives b minus a in milliseconds. days(n), hours(n) and minutes(n) give n times 86,400,000, 3,600,000 and 60,000. All of them are checked as D-6540 states. So \"joined within a week\" is record.joined_at > now - days(7), and \"expires thirty days after it was earned\" is record.earned_at + days(30). The left operand of + and - may be a timestamp or an integer and the right operand is an integer, so the result has the shape of the left operand; int + time, time + time and time * n are refused when the rule is defined. Rejected: a duration shape and value, which adds a variant to the kernel value algebra and to every stored expression for what an integer of milliseconds already says; calendar arithmetic such as adding one month, which needs a time zone that the platform does not have (composition finding F22) and gives different instants in different zones."},
    {"id":"d-6542","ref":"D-6542","title":"Keys are built with concat and text","group":"Platform","decided":"2026-11-20","statement":"**Keys are built with concat and text.** concat(a, b) joins two strings, and text(v) writes an integer, a timestamp or a record reference as its decimal digits, a boolean as true or false and a string unchanged, so that a rule can build a key from several values, such as concat(principal, concat(':', text(param.badge))). A result longer than 4,096 bytes of UTF-8 fails with the error string-too-long, so a key cannot grow without bound. text of a list is refused when the rule is defined. Rejected: a string interpolation form, which needs a second lexical mode in the parser for what nested calls already write; implicit conversion inside concat, which would let a reference and an integer with the same digits build the same key by accident. A key that the platform must enforce is a composite unique constraint (D-6558), not a concatenated field."},
    {"id":"d-6543","ref":"D-6543","title":"The new operators, and the order in which they enter the language","group":"Platform","decided":"2026-11-20","statement":"**The new operators, and the order in which they enter the language.** Each operator below becomes an entry of the language tenant-rule-language with the syntax, operands, result, null rule and primitive stated here, and the type expr gains the AST variants they build. add: variant arith, case op = add, infix +, precedence 5, assoc left, operands [int or time, int], result operand:1, nulls propagate, primitive add-checked. sub: variant arith, case op = sub, infix -, precedence 5, assoc left, operands [int or time, int], result operand:1, nulls propagate, primitive sub-checked. mul: variant arith, case op = mul, infix *, precedence 6, assoc left, operands [int, int], result int, nulls propagate, primitive mul-checked. ms-between: variant ms-between (from, to), call ms_between, operands [time, time], result int, nulls propagate, primitive time-difference. days, hours, minutes: variant duration split on its unit, call days, hours and minutes, operands [int], result int, nulls propagate, primitives days-ms, hours-ms and minutes-ms. concat: variant concat, call concat, operands [str, str], result str, nulls propagate, primitive concat-checked. text: variant text, call text, operands [int, time, ref, bool or str], result str, nulls propagate, primitive to-text. balance: variant balance (unit, scope), call balance, operands [str, str] of which the first is a string literal naming a declared unit, result int, nulls propagate, primitive ledger-balance. in-segment: variant in-segment, call in_segment, operands [str], result bool, nulls propagate, primitive segment-member. setting: variant setting, call setting, operands [str], a string literal naming a defined setting, result any (the checker gives the shape of the type of the setting), nulls total, primitive setting-value. A negative integer literal stays a literal: a - 1 is a subtraction and -1 alone is a literal. Exegra's primitive catalogue (src/core/language.js LANGUAGE_PRIMITIVES) and specc's (crates/spec-compiler/src/language.rs PRIMITIVES) refuse a primitive they do not hold, so the change lands in this order: the primitives enter Exegra's catalogue, its evaluator (src/core/language-eval.js) and the shared case table (crates/spec-compiler-language-fixture/tests/kernel-cases.json); then specc's catalogue and the evaluator it generates; then the kernel (crates/kernel/src/expr.rs, the kernel Expr and Need); and only then do the entries above enter the language entity and the variants enter expr. Adding the entries earlier makes the specification invalid (language.primitive-unknown)."},
    {"id":"d-6544","ref":"D-6544","title":"Rules read a balance, a membership and a setting through declared needs","group":"Platform","decided":"2026-11-20","statement":"**Rules read a balance, a membership and a setting through declared needs.** Three reads join the rule language. balance(unit, scope) is the balance of the account of the acting principal for that unit and scope (D-6551), 0 when the account does not exist because an account never posted to holds nothing, and null for an anonymous or system principal. in_segment(name) is whether the acting principal holds a membership of the named segment; it is false for an anonymous principal, and the evaluation fails with unknown-segment when no segment has the name. setting(name) is the value of the setting resolved for the acting principal as SET-010 states. Each read is a need of the plan of its decision, so the kernel still loads only what the plan names (K-100): balance needs the derived balance record of the account, whose identifier is derived from the tenant, the owner, the unit and the scope (D-5001) and so is known before anything is loaded; in_segment needs one membership record, keyed by the segment and the principal; setting needs the overrides of the setting for the person and for each team of the person, the override of the tenant and the platform value. A read whose operand is not a literal, such as a scope taken from a parameter, is asked for in a further round of needs (needRounds of the command derivation). Inside one decision every read sees the one snapshot the decision was given: two reads of one name give one value. The commit of a decision that read any of these is guarded by the revision of each record it read (D-5009), so a posting, a membership change or an override committed in between makes the commit lose its race and be decided again on the new state; that is what makes a check of a balance followed by a posting safe under concurrent requests. A membership is read as committed: exact at the snapshot for a segment whose predicate does not read the time (D-5022), at most one refresh interval behind for a time-dependent one (D-5024), and during the batches of a predicate change the membership under the version that decided it (D-5027). Rejected: evaluating the predicate of a segment inside the reading rule, which makes the cost of a policy the cost of a segment; a balance read that sums the entries, which D-5003 already replaced with the derived record."},
    {"id":"d-6545","ref":"D-6545","title":"Where each read may appear, and what it costs","group":"Platform","decided":"2026-11-20","statement":"**Where each read may appear, and what it costs.** balance may appear in workflow guards, in the conditions and steps of tenant operations, in policy conditions and in segment predicates. in_segment may appear in workflow guards, in the conditions and steps of tenant operations, in policy conditions and in query filters. setting may appear in workflow guards, in the conditions and steps of tenant operations, in field defaults, in policy conditions, in query filters and in segment predicates. None of them may appear in a constraint, because a constraint states what a record is whoever writes it, and a value that depends on the writer would make one record valid for one writer and invalid for another. in_segment may not appear in a segment predicate, because segments would then depend on each other in an order that one transaction cannot settle. balance may not appear in a query filter or a field default, because a filter that differs per person makes every stored copy the copy of one person, and a default should not depend on who creates the record. Mail and notice tokens read balance and setting for the recipient through D-6557. Each read costs one need (setting: at most two plus one per team of the person) and one step of the evaluation budget (CMS-252). A policy condition or query filter that reads one of them refines the audience class of the read (D-15): balance gives a class of the acting person alone, whose copies are never shared (K-7); in_segment gives the class of the members and the class of the non-members of that segment, so members share copies; setting refines the class as D-5049 states. A rule that uses a read where it is not allowed is refused when it is defined, with the read and the place named."},
    {"id":"d-6546","ref":"D-6546","title":"A compound product operation is declared data, and no product registers code","group":"Platform","decided":"2026-11-20","statement":"**A compound product operation is declared data, and no product registers code.** A tenant operation is one named operation that a product declares as tenant metadata: typed inputs, the principals who may invoke it, a subject record it loads, conditions in the rule language, and steps of four kinds (create a record, change a record, delete a record, post to the ledger), committed together or not at all. It is stored in a new member of the tenant schema, operations, a map from operation id to its definition (type tenant-operation-def), and it changes through two new schema changes, define-operation and remove-operation, which raise the schema version like any other schema change and are refused when the definition names an object type, field, unit, pool, segment or setting that does not exist. As for the settings and aggregates of commit 3530957, the new members of tenant-schema, schema-change and intent are written when the kernel is built, since the hand-written kernel builds those types; this specification states them through tenant-operation-def and its parts. An invocation is an intent naming the operation, the inputs and the idempotency key, decided by decide-tenant-operation (CT-806). D-103 and the product-module component spoke of platform code that a module registers, while NG-3, NG-150, ARC-113 and the layer rules (layer.kind-not-allowed; PRODUCT_SECTIONS has no functions) forbid such code. NG-3 holds: a product brings tenant metadata and nothing that runs as code, and what it cannot express with the step kinds and the rule language is a platform feature, added to the platform specification and released with the platform. D-103 and product-module are changed to say so. Rejected: a registered extension point for module code, which puts tenant-supplied code in platform processes (NG-3) and makes the behaviour of a product depend on code that Exegra cannot read; a step language with loops, which makes the cost of one invocation unknown when it is defined; widening mutate-record to several records, which still leaves the ledger outside the transaction (LDG-009)."},
    {"id":"d-6547","ref":"D-6547","title":"An operation acts with the authority of its definition, capped by its definer","group":"Security","decided":"2026-11-20","statement":"**An operation acts with the authority of its definition, capped by its definer.** Who may invoke a tenant operation is part of its definition: any signed-in person of the tenant, the holders of named roles, or both. The invoker needs the capability tenant-operation-invoke, which every signed-in person holds, and nothing else: a member may redeem without ledger-post and without content-write, because the steps are decided as the operation and not as direct writes of the invoker. So that a definition grants no more than its author holds, defining or changing an operation is refused unless the defining principal holds every capability and object permission that its steps use (ledger-post for a posting step; create, update or delete on each object type a step writes), as ADM-152 does for roles; an operation installed by a bundle is checked against the principal that installs it. A record that a step creates names the invoker as its creator, and an entry that a step posts names the invoker as caused-by, so the journal says who acted. The conditions authorise the data of the invocation: they read the invoker, the subject record, the inputs, balances, memberships and settings. The run-as identity of automation that WG-5031 specifies follows the same rule: a step acts under its definition and never beyond what its definer holds. Rejected: requiring the invoker to hold the capabilities of every step, which hands members direct posting (composition finding F3); a service principal for every operation, which hides the person who acted from the journal; tenant capabilities per operation, which a product cannot declare (PRODUCT_SECTIONS) and which WG-5034 considers."},
    {"id":"d-6548","ref":"D-6548","title":"An invocation is atomic, checked before it acts, and applied once per key","group":"Platform","decided":"2026-11-20","statement":"**An invocation is atomic, checked before it acts, and applied once per key.** The conditions of an operation are evaluated on the state before any of its steps. The steps are then applied in order, each on the state that the steps before it leave, and every check that applies to a direct change applies to a step: field types, constraints, unique constraints, workflow transitions and policies of the object type are not re-checked against the invoker (D-6547), while the ledger's units, floors, caps and caps per period are. A false or null condition, or any refused step, refuses the whole invocation with the code it names and leaves no record, no entry and no event. An accepted invocation commits all its changes and their domain events in one transaction (LDG-009, K-9), each event with the hop count 0 of a change made by a person. Every invocation carries an idempotency key chosen by the caller. The tenant keeps a run record of each invocation for seven days, keyed by the operation, the invoker and the key, with a hash of the inputs and the result: a repeat with the same inputs within that time answers with the recorded result and changes nothing, and a repeat with other inputs is refused with idempotency-mismatch. The ledger key of each posting step is op:<operation id>:<invoker>:<key>:<step id>, so a repeat cannot post twice even after the run record is gone (LDG-006); a create step that must not be repeated later than that is protected by a composite unique constraint (D-6558). A later step reads the identifier of the record that an earlier create step made as the parameter named by that step's id, and a step id that equals an input name is refused. An operation has at most sixteen steps, at most eight of them postings, and each condition at most two hundred nodes, so its plan and its cost are known when it is defined. Rejected: running the steps as separate commits with compensation, which leaves a window in which half a redemption is visible; idempotency through the ledger keys alone, which does not cover record creation; run records kept forever, which grow a table per click."},
    {"id":"d-6549","ref":"D-6549","title":"A product declares an operation as a value of tenant-operation-def in the section operations, and the catalogue lists it","group":"Platform","decided":"2026-11-20","statement":"**A product declares an operation as a value of tenant-operation-def in the section operations, and the catalogue lists it.** In a product file a tenant operation is an item of the section operations: a value of tenant-operation-def (inputs, invokers, subject, conditions and steps) with an id in the namespace of the product. It is not a contract: the invoker needs the capability tenant-operation-invoke, which every signed-in person holds, and who may invoke it is its invokers; its errors are the codes of its conditions. The expressions are written in the authoring syntax of the tenant rule language (D-6700). The bundle install that WG-5034 specifies turns the item into a define-operation schema change. Every tenant operation appears in the operation catalogue (list-operations, describe-operation) under the name tenant.<operation id>, with its inputs as its input schema and the schema version as its version, marked permitted for the principals its invokers name (AGT-001, AGT-002); a schema change shows in the catalogue without a deployment (AGT-003). A person invokes it through invoke-tenant-operation (CT-805) and an agent through invoke-operation (CT-110) by that name, and both reach decide-tenant-operation, so an agent is authorised as a person is (AGT-014). The names and labels of an operation are tenant data and appear only as quoted data inside descriptions (AGS-405)."},
    {"id":"d-6550","ref":"D-6550","title":"Ledger reads have a policy resource and a read of one's own accounts","group":"Security","decided":"2026-11-20","statement":"**Ledger reads have a policy resource and a read of one's own accounts.** The policy resource union gains ledger, optionally of one unit. A policy over it permits read of accounts and entries, and its condition reads the account as its record: owner (the owning principal as a string, null for a pool), pool, unit and scope, and for an entry also amount, reason, caused_by and at. \"The owner reads their own\" is a policy with the resource ledger and the condition record.owner == principal, and a read of entries or balances under ledger-read returns only what such policies permit (LDG-024, LDG-025). A member needs no policy to see their own accounts: read-my-ledger-balance and list-my-ledger-entries answer only for accounts whose owner is the caller, under the capability ledger-read-own that every signed-in person holds, and they take no owner input. Rejected: giving members ledger-read, which exposes every account their policies reach; modelling accounts as tenant records, which would let a tenant write a balance (LDG-021)."},
    {"id":"d-6551","ref":"D-6551","title":"An account is an owner, a unit and a scope","group":"Platform","decided":"2026-11-20","statement":"**An account is an owner, a unit and a scope.** D-5001 identifies an account by its owner and its unit, which forces a unit per promotion, per badge or per campaign, declared by an owner before use (composition finding F13). An account now also has a scope: a string of at most 128 bytes that the poster chooses, empty by default. Points have one account per person in the empty scope; the redemptions of promotion 42 by a person are the account (that person, promo_redemptions, 42), and the stock of promotion 42 is the account (pool promotions, promo_stock, 42). The limits declared for a unit apply to each of its accounts separately, and an account limit names the owner, the unit and the scope. The identifier of an account is still derived, now from the tenant, the owner, the unit and the scope, so a need for it can be named before loading (D-6544). The scope has no meaning to the platform and must not hold personal data, as the reason must not. Rejected: a unit per promotion, which turns a routine action of a marketer into a metadata change by an owner and runs into the ceiling on units; a free-form account name, which loses the link between an account and its owner that erasure needs (LDG-027)."},
    {"id":"d-6552","ref":"D-6552","title":"Accounts can be ranked within a stated bound","group":"Content","decided":"2026-11-20","statement":"**Accounts can be ranked within a stated bound.** list-ledger-accounts lists the accounts of one unit and scope in order of balance, the greatest or the least first, equal balances in ascending order of the owner, at most one hundred per page with a cursor. It walks the derived balance records through an index on unit, scope and balance, examines at most ten thousand accounts for one request (the scan bound of an aggregate, D-5062), and is refused with scan-bound-exceeded before it reads when the walk would pass that bound, so a leaderboard of the top hundred costs at most the accounts it passes over. An account is listed only when the reader may read every entry of it, so a rank never discloses an entry the reader cannot read (D-5011, AGG-017). Rejected: ledger entries as tenant records that aggregates read, which puts the journal under the scan bound of every aggregate and within reach of record writes; a stored leaderboard updated by each posting, which makes every posting a write of one shared record."},
    {"id":"d-6553","ref":"D-6553","title":"Credits expire by period, through a posting","group":"Platform","decided":"2026-11-20","statement":"**Credits expire by period, through a posting.** A unit may declare an expiry: a calendar period (hour, day, week or month in UTC, as D-5005 counts them) and a number of periods from one to thirty-six. A credit belongs to the bucket of the period that contains its time, and a debit consumes the remaining credit of the buckets of its account oldest first. The derived balance record keeps the remaining amount of each bucket, at most thirty-six of them. When the last period of the life of a bucket ends, the expiry job (expire-ledger-credits, CT-812) posts, for each account with credit remaining in that bucket, one entry of minus the remaining amount with the key expiry:<bucket start> and the reason expiry, within one day after the end; it walks the accounts in batches of one hundred through an index of their oldest bucket, and its batches are jobs of the tenant like those of segments (D-6555). Expiry is an ordinary entry, so the balance is still the sum of the entries (LDG-020), the journal says when and why credit went, and a replay gives the same balances. Between the end of the life of a bucket and its expiry entry the remaining credit can still be spent, oldest first. Rejected: entries that carry their own expiry and a balance that leaves them out once they expire, which makes the balance depend on the clock and breaks LDG-020; a lot per credit, whose number per account has no bound."},
    {"id":"d-6554","ref":"D-6554","title":"Ledger definitions can be listed and removed, within per-tenant ceilings","group":"Platform","decided":"2026-11-20","statement":"**Ledger definitions can be listed and removed, within per-tenant ceilings.** list-ledger-definitions lists the units, pools and limits of the tenant to a holder of ledger-read. remove-ledger-definition removes a unit or a pool that has no account and is refused while one exists, since the entries of an account need their unit; it removes a limit, after which the limit of the unit applies to the postings committed after it (LDG-016). A tenant holds at most 64 units, 64 pools and 10,000 account limits, and the next declaration is refused with too-many. The basis: units and pools are names that rules, policies and operations write literally and that every decision touching them loads, so they are few; an account limit is one record per exception, and ten thousand is the bound the platform uses for any read that walks records (D-5062). Accounts have no ceiling of their own and are bounded by the storage quota of the plan (BIL-151)."},
    {"id":"d-6555","ref":"D-6555","title":"Segments: own membership, counts, previews, refresh on change, cost and caps","group":"Automation","decided":"2026-11-20","statement":"**Segments: own membership, counts, previews, refresh on change, cost and caps.** A segment may be marked visible to members. list-my-segments lists to a signed-in person the visible segments the person belongs to, under segments-read-own, which every signed-in person holds, and in_segment lets a rule test one (D-6544); a segment not so marked is not shown, because membership can disclose what a predicate computes about a person. count-segment-members counts the members whose subject records the reader may read: from a count kept with the segment when the audience class of the reader reads every subject record, otherwise by examining at most ten thousand memberships, refused with scan-bound-exceeded beyond. preview-segment-predicate evaluates a draft predicate for at most one thousand persons from a cursor, changes nothing, and returns how many matched and how many were examined. Segment batches and refreshes are jobs of the tenant: they count against the job admission rate (SCH-302) and against the daily job quota of the plan (D-508), because the definitions of the tenant cause them. A refresh for which the daily quota has no room is skipped and recorded on the segment with its time; it refuses no commit, and the next refresh catches up. Batches that a commit creates follow the outcome that WG-5031 states for jobs created at commit. A time-dependent predicate is indexable when every read of now is one side of a comparison whose other side does not read now, such as record.joined_at > now - days(7): each evaluation then also gives the next instant at which the value for the person can change, kept in a wake record, and a refresh evaluates only the persons whose wake time has passed. The person still enters or leaves at the first refresh after the change (SEG-021), and the cost of a refresh is the number of persons whose value changes, not the number of persons. A time-dependent predicate that is not indexable declares a refresh interval of at least fifteen minutes. A tenant holds at most one hundred segments, at most twenty-five of which read any one object type, and at most five time-dependent segments that are not indexable. The basis restates D-5026: the cost of a change is the predicates that read the changed object type, at most twenty-five of at most two hundred nodes for each of at most one hundred persons in one transaction (SEG-028); the total of one hundred bounds the segment metadata loaded for a tenant; five non-indexable segments over 10,000 persons at fifteen minutes make 500 batch jobs in fifteen minutes, about a third of the default admission rate of one hundred jobs a minute, and one of them alone makes 9,600 jobs a day against the 10,000 of the standard plan, which count-segment-members lets a tenant see before it chooses an interval. A segment names the field of its subject type that holds the principal of the person, a required unique string field, which D-5020 left unstated. Rejected: exempting segment jobs from the quota, which lets the definitions of one tenant occupy workers without bound; raising the flat cap alone, which leaves the cost of one change unbounded."},
    {"id":"d-6556","ref":"D-6556","title":"Segments and ledger accounts are for principals; contacts are records","group":"Automation","decided":"2026-11-20","statement":"**Segments and ledger accounts are for principals; contacts are records.** The members of a segment and the owners of ledger accounts are principals of the tenant. A contact without a principal, such as a form submitter, a visitor or an imported subscriber, is outside both: a product keeps contacts as records of its own contact type, selects an audience of them with a named query whose filter states the criteria and counts it with an aggregate (D-5060), and counts per contact with fields and composite unique constraints (D-6558) rather than ledger accounts. Rejected: segments over any record type, which needs memberships keyed by record, an erasure that follows a record rather than a principal, and a personal-data marking of tenant records that WG-5034 is specifying; it can be reconsidered once that marking exists."},
    {"id":"d-6557","ref":"D-6557","title":"Settings reach views, the dispatcher and triggers","group":"Tenancy","decided":"2026-11-20","statement":"**Settings reach views, the dispatcher and triggers.** The argument of a view section may come from a setting resolved for the reader (arg-source gains setting), and the view copy is keyed and classed as D-5049 states. The mail dispatcher and the notification service resolve the setting of a recipient through resolve-setting-for (CT-816), a local call that needs setting-resolve-for, which only platform-service holds; no tenant principal can resolve the setting of another person. A value resolved for a recipient decides and renders one message and is written to no log, no copy and no event. setting-changed keeps carrying no value (D-5048), because a person-level value can be personal data and an event is kept in the journal and delivered to subscribers; a step that reacts to it and needs the value reads the setting at its own decision, which gives the value at that decision and not at the change. Rejected: carrying the value at the tenant and team levels only, which makes the shape of an event depend on its level and still delivers the choice of a team to every subscriber of the event."},
    {"id":"d-6558","ref":"D-6558","title":"Tenant record types can declare composite unique constraints","group":"Content","decided":"2026-11-20","statement":"**Tenant record types can declare composite unique constraints.** An object type may declare unique constraints over two to four of its fields (type unique-def), each with an id and a message. A create or update that would give two records of the type equal values in every field of one constraint is refused, naming the constraint. A record with null in any field of a constraint is not constrained by it, as in SQL. Adding a constraint over records that already hold a duplicate is refused, naming one pair. The check is one need, the records of the type with those field values, answered from an index, so it does not load every record of the type. It is how a retried job or operation that creates an award or a redemption keeps one record per person and badge. The unique flag of a field stays the case of one field. Rejected: a key field that the writer fills with concat, which a writer can get wrong and which the platform cannot check against existing data."},
    {"id":"d-6559","ref":"D-6559","title":"Counts and totals over many records are kept in the ledger","group":"Platform","decided":"2026-11-20","statement":"**Counts and totals over many records are kept in the ledger.** D-5021 told a tenant to keep a count or a total that a predicate needs in a field that a workflow or a constraint maintains, while D-5000 says that a module never keeps a balance of its own in a record type; and the rule language could not add in any case. They are reconciled on the side of D-5000: a count or a total that belongs to a person, such as points, orders placed or redemptions, is posted to the ledger by the operation or workflow that makes the change, in its transaction, and a segment predicate or a rule reads it with balance(unit, scope) (D-6544). A field that a workflow maintains remains right for a property of the record itself, such as its state, and never holds a running total. D-5021 is changed to say so."},
    {"id":"d-6520","ref":"D-6520","title":"Automation is triggers and automations held as tenant metadata","group":"Automation","decided":"2026-11-20","statement":"**Automation is triggers and automations held as tenant metadata.** A tenant or a product reacts to events with two kinds of definition: a trigger (trigger-def), which names an event, a condition and an automation, and an automation (automation-def), which is a set of named steps from the published catalogue with a start step. Both are stored under the schema version, projected before activation and installed through kernel intents (D-103, WFL-001, WFL-002). No tenant or product code runs (D-506, NG-3). Rejected: handlers registered as platform code for a job kind (the escape hatch of D-103 that NG-3 and the product layer forbid); a general scripting language (not checkable, not projectable); free-text job kinds in schedule-job with no registry (the gap WG-5031 records)."},
    {"id":"d-6521","ref":"D-6521","title":"Field workflows and automations are two definitions on one run engine","group":"Automation","decided":"2026-11-20","statement":"**Field workflows and automations are two definitions on one run engine.** A field workflow (workflow-def) stays the state machine of one field of a record: the kernel decides each transition inside the change that requests it, under its guard. An automation is a run of steps over time that the automation worker carries out, one job per step attempt (D-526). The two meet at one event: a change that moves a workflow field writes record-updated with the transition, and a trigger on that transition starts an automation; an automation moves a field only through an update-record step, which the kernel decides against the guard like any update. Both share the workflow-id namespace, so start-workflow-run, advance-workflow-run, approve-workflow-step and activate-workflow address an automation by its id and the existing run machinery is the engine. Rejected: giving workflow-def steps, waits and calls (a transition would no longer be one synchronous decision, and every existing field workflow would change meaning); a second engine for automations (D-526 says one worker)."},
    {"id":"d-6522","ref":"D-6522","title":"The step catalogue and the trigger catalogue are typed unions","group":"Automation","decided":"2026-11-20","statement":"**The step catalogue and the trigger catalogue are typed unions.** The published catalogue of INT-153 is two unions of the platform specification: automation-step for actions, with typed inputs per variant and its outputs in automation-step-result, and trigger-event for the events a trigger subscribes to. A definition naming anything else is refused at definition, at activation and, for a product file, by specc. A step whose effect another primitive owns delegates to it: post-ledger uses the atomic operation form of WG-5032 and the ledger-post capability of the automation principal; send-mail and create-notice use the send of WG-5033; call-webhook uses the signed delivery of WFL-010 through the outbound gate (WFL-250 to WFL-256). Rejected: one entity per step kind (WG-5009 proposed entities a product refers to by id; a union is typed, generated and checked by the type checker with no new entity kind); a prose list (not checkable); letting a product declare step kinds (that would be code)."},
    {"id":"d-6523","ref":"D-6523","title":"An event binds named parameters, and a step binds its outputs","group":"Automation","decided":"2026-11-20","statement":"**An event binds named parameters, and a step binds its outputs.** A trigger condition and every expression of a run are tenant rule language text read with the param scope. Every event binds param.seq, param.at and param.hop. record-created binds the record in the scopes record and new; record-updated binds old and new and param.transition; record-deleted binds old; segment-entered and segment-exited bind param.person, param.segment and param.reason; ledger-posted binds param.owner (the principal, or null for a pool), param.unit, param.amount, param.balance, param.balance_before (the balance before the entry, which the platform computes so that crossing a threshold needs no arithmetic), param.entry_sequence and param.reason; setting-changed binds param.setting, param.level and param.subject; schedule-due binds param.schedule and param.due_at; inbound-webhook binds param.endpoint, param.event_id and param.body as text. A completed step adds each field of its result as param.<step>_<field>. Rejected: arithmetic in the condition (the language has none until WG-5032 adds it, and a crossing must be stable across both); a threshold variant of ledger-posted (one event per threshold would multiply events)."},
    {"id":"d-6524","ref":"D-6524","title":"A condition is decided in the transaction of the event","group":"Automation","decided":"2026-11-20","statement":"**A condition is decided in the transaction of the event.** The kernel evaluates the condition of each matching trigger in the transaction that commits the event, with the event's parameters, and creates a job only when it is true (SCH-004). A false condition writes nothing; a condition that cannot be evaluated writes a declined exception record. Every field a condition names must be readable by the definer, as D-5028 requires of a segment predicate. Rejected: evaluating the condition when the job runs (it would see a later state, and create a job for every event only to discard most)."},
    {"id":"d-6525","ref":"D-6525","title":"An automation acts as its own principal with roles its definer may confer","group":"Automation","decided":"2026-11-20","statement":"**An automation acts as its own principal with roles its definer may confer.** Each automation has an automation principal, automation:<workflow-id>, whose roles are the run-as of the definition. A role is accepted only when the definer may confer it under ADM-152, that is when the definer holds every permission the role grants; the owner may confer any role. Every intent of a step is decided by the kernel with that principal, so policies, field reads and ledger capabilities apply to it as to a person (K-13). Rejected: acting as the person the event concerns (a member lacks ledger-post, F3, and a schedule has no person); acting as the definer (the automation would gain whatever the definer gains later, and a change would be attributed to a person who did not act); acting as the system or platform-service principal (that exceeds any tenant authority)."},
    {"id":"d-6526","ref":"D-6526","title":"A definer who loses authority suspends the automation","group":"Automation","decided":"2026-11-20","statement":"**A definer who loses authority suspends the automation.** Every change of a principal's roles, of the roles of a team it belongs to, of the permissions of a role it holds, and its erasure, checks in its own transaction the automations it defined (recheck-automation-authority). An automation whose run-as names a role the definer can no longer confer is suspended: its triggers write declined records, its open runs stop before their next step with a parked record, and it resumes only when a principal who may confer every role defines it again. Rejected: continuing on the authority granted at definition (a removed owner's automations would keep acting); dropping the roles the definer lost (the automation would run with a smaller authority than its steps assume and fail in ways nobody chose); removing the automation (its history and runs would go with it)."},
    {"id":"d-6527","ref":"D-6527","title":"caused-by names the automation principal and the run names the definer","group":"Automation","decided":"2026-11-20","statement":"**caused-by names the automation principal and the run names the definer.** A change, posting, message or notice of a step names the automation principal as its causing principal and the run as its correlation; the run record names the definer as on-behalf-of. An agent change is attributed to the agent and the person it acts for in the same way (G-25). Rejected: naming the definer as the cause (the definer did nothing at that moment); naming the person whose event started the run (that person did not authorise the step)."},
    {"id":"d-6528","ref":"D-6528","title":"A step key is derived, not chosen","group":"Automation","decided":"2026-11-20","statement":"**A step key is derived, not chosen.** The idempotency key of a step is the SHA-256 of the tenant, the automation, the run, the step name, the member of a fan-out and the position of the step in the run (D-7700), and is the same on every attempt of one visit; a released dead-lettered step keeps it. Every effect of the step carries it: the record change, the posting key of D-5007, the mail key of EML-006 and the delivery key of an outbound call. Creation is exactly once by SCH-004 and effect is exactly once by SCH-015 with this key. Rejected: a key per attempt (a retry after a lost result would apply twice); a key the tenant writes (two steps could share one by mistake); no key (SCH-015 needs one)."},
    {"id":"d-6529","ref":"D-6529","title":"Retries and timeouts are bounded per step","group":"Automation","decided":"2026-11-20","statement":"**Retries and timeouts are bounded per step.** A step names at most 10 attempts (default 5), a first delay (default 10 seconds) that doubles up to a maximum delay (default one hour, at most one day), and a timeout for one attempt (default 60 seconds, at most 15 minutes). An attempt past its timeout is failed and its late result is refused by the fencing token (K-17). Waits and approvals have no attempt timeout; an approval has its own timeout after which it takes its refused step. Rejected: one policy for the whole platform (a webhook and a record change fail differently); unbounded retries (a dead step would never surface)."},
    {"id":"d-6530","ref":"D-6530","title":"Runs, steps and exceptions are records the tenant owner lists","group":"Automation","decided":"2026-11-20","statement":"**Runs, steps and exceptions are records the tenant owner lists.** Each run has a record (rec-workflow-run, extended), each step a record (rec-workflow-step-run), and every declined, held, parked or dead-lettered piece of work an exception record (rec-automation-exception) with one of the reasons of automation-exception-reason. A false condition writes no record, because most events match no trigger. Parked and dead-lettered entries stay until the owner releases or drops them (OPS-348); the others are kept ninety days. Rejected: recording every evaluation (volume far beyond the work done); counts only, as rec-trigger-run holds today (a count cannot say which award was missed)."},
    {"id":"d-6531","ref":"D-6531","title":"Waiting keeps the hop count and a schedule starts a chain","group":"Automation","decided":"2026-11-20","statement":"**Waiting keeps the hop count and a schedule starts a chain.** A run keeps the hop count of the event that started it through every wait and resumed job; every event a step commits carries that count plus one; an event of a schedule carries zero, because only an owner defines a schedule and no step does. A drip campaign of many steps is one run with waits, so it uses no hops; only a chain of events that start runs again counts toward the limit of eight (D-700, SCH-300). Rejected: a wait resetting the count (a loop through a delay would never end); counting each wait as a hop (an ordinary campaign would stop at eight steps, the F10 finding)."},
    {"id":"d-6532","ref":"D-6532","title":"Runs with one run key are ordered by event sequence","group":"Automation","decided":"2026-11-20","statement":"**Runs with one run key are ordered by event sequence.** For one trigger, the runs of events with the same run key start in the order of the events' sequence numbers, one at a time; runs with different keys run in parallel. A parked event is passed over so later events flow (D-519), and its run starts when the owner releases it, recorded out of order in its exception record. Rejected: no ordering (a level-up could be decided before the threshold it depends on); a total order per trigger (one person's parked event would block every other person)."},
    {"id":"d-6533","ref":"D-6533","title":"The job quota holds jobs and never refuses the change","group":"Automation","decided":"2026-11-20","statement":"**The job quota holds jobs and never refuses the change.** The daily job quota of a plan (D-508) is checked when a commit creates jobs. Jobs within it are created due as usual; jobs past it are created due at the start of the next quota day, count against that day, and each writes a held exception record. The change itself always commits; BIL-151 refuses writes that exceed a storage or record quota, and a job is not such a write. Rejected: refusing the change (a member's action would fail because of the tenant's automation volume); declining the job (an award would be lost, not delayed); exceeding the quota silently."},
    {"id":"d-6534","ref":"D-6534","title":"A run key makes a run happen once per value","group":"Automation","decided":"2026-11-20","statement":"**A run key makes a run happen once per value.** An automation may declare a run key, an expression over the starting event. The automation worker keeps the hash of every key it has started a run for while the automation exists (rec-automation-run-key), so a repeated key starts nothing and writes a declined record. Combined with the step key of D-6528 this gives once per person and exactly one effect per step. Rejected: a uniqueness constraint on the product's records (the platform has no composite unique constraint, and a record is not the only effect); a time window for keys (award once would expire)."},
    {"id":"d-6535","ref":"D-6535","title":"A wait is a due job and a fan-out works in batches of one hundred","group":"Automation","decided":"2026-11-20","statement":"**A wait is a due job and a fan-out works in batches of one hundred.** A wait step ends its job and creates the resuming job due at its time, so it holds no lease and survives restarts; a wait is at most 366 days. A fan-out reads the members of its segment when each batch runs, at most its batch size and never more than one hundred per batch, as D-5026 bounds evaluation, and runs its step once per member with the member as param.member. Rejected: snapshotting the members when the fan-out starts (it would store up to every person of the tenant); one job per member (it would spend the job quota on a single campaign step)."},
    {"id":"d-6536","ref":"D-6536","title":"A product file declares triggers and automations in sections of their own","group":"Automation","decided":"2026-11-20","statement":"**A product file declares triggers and automations in sections of their own.** A product file may declare the sections triggers and automations, whose entities are values of trigger-def and automation-def with an id; specc refuses a product whose action or trigger event is outside the catalogue with layer.outside-catalogue. Exegra reads them as specc does and type-checks each value against trigger-def and automation-def (D-6700). The object types, segments, ledger units and templates that an automation names are declared in product sections of their own (D-6700). Rejected: modelling an automation as a behavior (behaviors are verified model machines, and their effects are not the step catalogue); carrying the definitions in claims or scenarios as untyped text."},
    {"id":"d-6537","ref":"D-6537","title":"The tenant schema gains triggers and automations when the kernel is built","group":"Automation","decided":"2026-11-20","statement":"**The tenant schema gains triggers and automations when the kernel is built.** tenant-schema gains the maps triggers and automations, and schema-change gains define-trigger, remove-trigger, define-automation and remove-automation, when the kernel is built; until then rec-trigger and rec-automation state the stored shape and the contracts state the operations. The kernel builds these types by hand, so changing them here before the kernel would break its build, as D-5023 does for the segment events. Rejected: storing triggers and automations outside the tenant schema (they would escape schema versioning and projection)."},
    {"id":"d-6538","ref":"D-6538","title":"A product's automation is checked for its catalogue before it is installed","group":"Automation","decided":"2026-11-20","statement":"**A product's automation is checked for its catalogue before it is installed.** The same catalogue check runs in three places: specc on a product file, define-automation and define-trigger on the tenant, and activate-workflow before a run can start. A product therefore cannot ship an automation that a tenant would later refuse at activation. Rejected: checking at activation only (a product would learn of the error after installing)."},
    {"id":"d-6539","ref":"D-6539","title":"Removing a trigger stops new runs and removing an automation cancels its runs","group":"Automation","decided":"2026-11-20","statement":"**Removing a trigger stops new runs and removing an automation cancels its runs.** Removing a trigger stops new runs through it and leaves its open runs to finish. An automation cannot be removed while a trigger names it; removing it cancels its open runs, each with an exception record of reason automation-removed, and removes its run keys. A changed automation leaves its open runs on the version that started them (MIG-562). Rejected: letting the runs of a removed automation finish (the owner who removes an automation means it to stop); refusing removal while runs are open (a run waiting 366 days would block removal)."},
    {"id":"d-6680","ref":"D-6680","title":"Tenant hosts are documents of the tenant, bound to one tenant each","statement":"**Tenant hosts are documents of the tenant, bound to one tenant each.** The backend keeps a host binding as a small document of kind host under the tenant it serves, in the store's existing document table, so that no schema change is needed and a tenant's reset takes its hosts with it. One internal route lists every binding to the service and binds an origin to a tenant. The specification's domain-binding contracts (bind-domain, remove-domain-binding) stay unimplemented; this is the minimal store that lets a gateway learn tenant hosts without a restart, and the control plane replaces it when it owns the directory (TEN-1680, GWY-1680).","group":"Tenancy","decided":"2026-11-20"},
    {"id":"d-6681","ref":"D-6681","title":"The owner's invitation sets a password and signs nobody in","statement":"**The owner's invitation sets a password and signs nobody in.** The first sign-in of a new tenant's owner is an invitation link that is accepted once, in any browser, within seven days. Accepting it replaces the account's unknown password with the one the owner chooses; the owner then signs in as anyone does and enrols a second factor in the usual way. The link signs nobody in by itself, so a leaked link cannot yield a session, and the owner learns of a thief who got there first because their own use fails. The sign-in link of IDN-005 stays bound to the browser that asked, because that person has asked (D-6222, IDN-1680).","group":"Identity","decided":"2026-11-20"},
    {"id":"d-6700","ref":"D-6700","title":"A product file has typed sections, each conforming to a platform type","group":"Platform","decided":"2026-11-20","statement":"**A product file has typed sections, each conforming to a platform type.** Besides the sections of entities of the specification format, a product file has sixteen typed sections, each a list of values of a platform type with an id: objects (object-type-def), policies (policy-def), queries (query-def), views (view-def), workflows (workflow-def), segments (segment-decl), settings (setting-def), ledgerUnits (ledger-unit-decl), ledgerPools (ledger-pool-decl), ledgerLimits (ledger-limit), mailTemplates (mail-template-decl), noticeTemplates (notice-template-decl), tokens (token-decl), triggers (trigger-def), automations (automation-def) and operations (tenant-operation-def). They are the sections of the tenant bundle (bundle-sections, D-6580), so that a product installs from its file alone. One table in specc (layer_values.rs) and in Exegra (layer-values.js) maps a section to its type, and one generic check tests a value against a declared type: the fields of a struct, required and optional, with a field of type option optional; the variants of a union by tag, written as the platform writes them (externally tagged in the case of the union, or the tag alone for a variant without fields); the values of an enum; lists, sets and maps; ids by pattern and length; scalars by representation. Where the platform type is the expression AST (expr), the value is the text of the tenant rule language, not parsed by the check. The id of an item is the member of the value that names it (unit, pool, template, name; id for the others), taken from the id when left out; a segment and a ledger limit have no name and keep the id as the product name. A name in a value that is an object type, a ledger unit, a ledger pool, a role, a policy, an automation, a template or a setting must, when it is in the namespace of the product, be declared by the product file; a value that is not a conforming value is refused with layer.value-invalid, a variant the platform union lacks with layer.outside-catalogue, an undeclared name with layer.reference-unknown and a name another product declares with layer.cross-product-reference. A tenant operation is a section of operations, not a contract with a realisation (D-6549). Capabilities are the one section of the format that a product adds to (D-6590). Rejected: a table of checks per section (each new section would be code in both tools); declaring the values as untyped text (not checkable). Not covered by the check: the syntax of an expression, the block text of a template, and the rule that a type with a personal field carries a retention rule (D-6584)."},
    {"id":"d-6701","ref":"D-6701","title":"A product capability is entitled by installing its product and is never core","group":"Platform","decided":"2026-11-20","statement":"**A product capability is entitled by installing its product and is never core.** A capability that a product file declares is entitled to a tenant by installing the product; no plan has to entitle it, and a product file cannot add a plan. Exegra therefore reports a product capability as unreachable only when no role or grant confers it. A product capability marked core is refused with layer.platform-power, because a core capability is held by every tenant whatever its plan. A role of another product, or a platform entity, that names the capability is refused (layer.cross-product-reference, layer.platform-references-product), which makes the capability confined to its product (D-6590)."},
    {"id":"d-6920","ref":"D-6920","title":"specc writes the bundle of a product file, and the header of the file states its version and platform range","group":"Platform","decided":"2026-11-20","statement":"**specc writes the bundle of a product file, and the header of the file states its version and platform range.** The command specc bundle takes the platform specification and one product file and writes one deterministic file, <product id>.bundle.json: a tenant-bundle whose name, product id, version and platform range come from the product header and whose content is bundle-sections (D-6580). The header carries two members beyond those of D-6582: version, three whole numbers joined by dots, and platform, the platform-compat range (min, and below when a later release is excluded). A product with no version is refused with bundle.version-missing, a version that is not three numbers and a platform range that is not a platform-compat are refused by the layer checks with layer.header-invalid (D-7343). The ids of the product are already in its namespace, so the bundle copies them and states no namespace of its own; the namespace is a function of the product id (D-6582). Sections are written in alphabetical order, objects have sorted keys and list sections are ordered by id, so one product gives one byte sequence whatever the order of its file. A role of the product becomes an entry of roles (its id and its name as the label) and an entry of role-permissions (each capability as {\"Capability\": name}); the claims, scenarios, journeys and evidence of the file state facts about the product and are not tenant metadata, so they are not in the bundle. A section of a product file that bundle-sections has no place for (records, types, screens, forms, actions, liveBindings, errorMessages, behaviors, events, contracts) is refused with bundle.section-no-place, and two entities that would be one entity of the bundle with bundle.id-collision. The finished bundle is checked against tenant-bundle before it is written. The layer checks run first and their refusals (layer.*) are unchanged. Rejected: a version taken from the platform release or from a command-line flag, because the product file is the one source of what a product is; a bundle that restates the namespace, because it can only disagree with the product id."},
    {"id":"d-7320","ref":"D-7320","title":"The size of an aggregate declaration and of its answer is bounded","group":"Content","decided":"2026-11-20","statement":"**The size of an aggregate declaration and of its answer is bounded.** A named query declares at most 20 aggregates. A top aggregate returns at most 100 records. An aggregate answers with at most 1000 groups, and is refused with the error group-bound-exceeded when it has more. The kernel reads at most 10001 records of the object type of the query to answer an aggregate: it examines the records the reader may read and the filter selects, counts them against the scan bound of the aggregate (D-5062), and refuses an object type that holds more than 10000 records with the error scan-bound-exceeded, since the records beyond the window cannot be examined and not examining them would answer in part. That last refusal says only that the object type is larger than the platform maximum, as it does for a named query read (KRN-1288). A field that the reader may not read leaves the record out whether or not the record holds a value in it, so that no count tells a reader which records hold one (D-5061)."},
    {"id":"d-7440","ref":"D-7440","title":"An unkeyed machine that creates its records is one instance that exists from the start, under a fixed key","group":"Platform","decided":"2026-11-20","statement":"**An unkeyed machine that creates its records is one instance that exists from the start, under a fixed key.** Exegra starts the one instance of an implementation-level machine that has no instances.key at the beginning of a run. The runtime reaches an instance only through a record, and an event addressed to every instance names no key to create one under, so a machine that has no key and creates its own records (storage.creates) had no instance and every event for it was dropped. When the system host is built it now creates that instance, in its initial state, under a key fixed by the generator (Machine::SINGLETON_KEY), unless the store already holds a record under it, so two system hosts over one store share one instance and a host built later does not start it over. The key is derived from the id of the machine so that two machines in one record have two keys: a string key is the machine id with each hyphen written as an underscore, a uuid key is a version 8 uuid made from two FNV-1a hashes of the machine id, an integer key is 0 and a composite key is the array of its parts; specc refuses (specc.singleton-key) a key of another type. The purge never removes this instance. 63 implementation machines in 39 records are of this kind (the list is in the operations file w3rt-work/singletons.mjs); each describes one flow of one scenario, and no event any of them receives carries a key, so each is one instance by its model. Rejected: giving the 63 machines instances.key, because no event names the key and every scenario would have to be rewritten; seeding one instance under a placeholder key in the test, which hid the gap from the test and not from production; creating the instance on its first event, because a route to every instance names no key; a key chosen by each host, because two hosts would then hold two instances."},
    {"id":"d-7441","ref":"D-7441","title":"The runtime machine store bounds its outbox attempts, its dead letters and its finished records","group":"Platform","decided":"2026-11-20","statement":"**The runtime machine store bounds its outbox attempts, its dead letters and its finished records.** A message of the machine outbox is dispatched at most 10 times (RetryPolicy::max_attempts), after waits that double from 1 second to at most 300 seconds, 511 seconds in all with the defaults; the tenth failure moves the message to the dead letters with its receiver, the number of attempts and the last error, which is how OPS-305 bounds a retry in attempts and how SCH-014 and OPS-348 keep the error of a failing item visible. A dead letter is kept 90 days from the time it was set aside, and the record of an instance that is in a terminal state of its machine is kept 90 days from its last save, both within the thirty days to ten years that PRV-356 allows a record type. The purge (System::purge) deletes what is past these bounds in one transaction, the backend janitor calls it every 600 seconds, and the platform diagnostics report the records, the undelivered outbox messages and the dead letters the store holds (machine_store). Rejected: keeping dead letters until a tenant owner drops them (OPS-348), because these rows are the runtime's own and no list shows them to an owner; the owner-visible exceptions of D-6530 are separate records; counting the cap in elapsed time instead of attempts, because the retry policy already fixes the waits."},
    {"id":"d-7460","ref":"D-7460","title":"Erasure clears the personal fields in the records now and says which copies it did not reach","group":"Privacy","decided":"2026-11-20","statement":"**Erasure clears the personal fields in the records now and says which copies it did not reach.** D-350 reaches every copy by destroying a key of the subject; the key service is not built, so no field is sealed and no key can be destroyed. The erasure of a subject (the contract erase-subject) therefore does what can be done today: the kernel clears each field that declares the principal as its data subject, by the creator of the record or by a text field that holds the principal id, in batches of at most 100 records with a continuation, rewrites the index rows of those records in the same commit and writes events that carry none of the erased values; the backend then removes every login and credential through Store::remove_principal, ends the sessions, removes the roles, the places in teams and the invitations of the person, and removes the identity documents. It never rewrites the audit log (PRV-359). A required field takes the empty value of its type so the record still fits its declaration. The receipt names each record changed and each copy reached, and states each copy it did not reach with the task that closes the gap: earlier events, the journal, snapshots, backups, exports, the audit log and the schema history. It states that restrictions and legal holds are not built. Alternative: refuse to erase until the key service exists; rejected because a person asking to be erased is owed what can be done now and an honest account of the rest. Amended by D-7720 to D-7728: the store now seals every declared personal field under the key of its subject, the erasure destroys the subject keys after it has cleared the records, and the receipt names the copies that reaches and the ones it does not."},
    {"id":"d-7200","ref":"D-7200","title":"The kernel hands the outcome of each trigger to the automation worker as an effect","group":"Automation","decided":"2026-11-20","statement":"**The kernel hands the outcome of each trigger to the automation worker as an effect.** For each event of an accepted transition, in sequence order, and each trigger of the tenant whose event matches it, in trigger id order, the kernel decides the trigger inside the transition (D-6524) and appends one effect: start-automation, carrying automation-start, or decline-automation, carrying automation-decline. A false condition, a paused trigger and an event about a record the automation principal may not read append nothing. A trigger matches a kernel event by its kind, its object type and, for record-updated naming a transition, a transition the update fired; the other trigger events come from engines outside the kernel. A condition or run key that needs a record the snapshot does not hold refuses the transition with insufficient-state naming it, so the shell loads it and decides again; it is never taken as false. The automation worker creates the job or writes the exception record from the effect in the commit of the transition (SCH-004, SCH-1532), and itself refuses a repeated run key (D-6534) and holds jobs past the quota (D-6533), which the kernel does not hold. The work per commit is at most one decision for each pair of an event and a trigger matching it, so at most one hundred per event (the trigger limit). Rejected: the kernel writing jobs or exception records (they are platform records the kernel does not hold); the worker evaluating conditions after commit (D-6524 rejects it)."},
    {"id":"d-7201","ref":"D-7201","title":"A trigger condition is decided with the authority of the automation principal","group":"Automation","decided":"2026-11-20","statement":"**A trigger condition is decided with the authority of the automation principal.** The condition and the run key of a trigger are evaluated as the automation principal automation:<workflow-id> holding its run-as roles (D-6525). A trigger does not observe an event about a record that principal may not read (the record created, the record after an update, the record deleted); the scope old of an update is bound only when the principal may read the record as it was. A condition that names a field the principal may not read, or follows a reference into a record or a field it may not read, cannot be evaluated: the trigger writes a declined record with reason condition-failed. The run-as names only roles the definer may confer (WFL-1528), and is suspended when that stops being so (WFL-1529), so everything the principal reads its definer may read, as D-6524 requires. Rejected: the definer's authority (D-6525 rejects acting as the definer, whose authority grows and shrinks with roles the automation does not hold); system authority (a condition could observe what no tenant principal may read and reveal it by which runs start)."},
    {"id":"d-7202","ref":"D-7202","title":"The hop count of a transition arrives in its context","group":"Automation","decided":"2026-11-20","statement":"**The hop count of a transition arrives in its context.** context.hop is the hop count of the change: absent, read as zero, for a change of a person or a schedule, and the hop of the run plus one for a change an automated step commits, set by the automation worker and never by the intent or its caller (D-6531). Every event of the transition carries it, it is bound as param.hop, and it goes into automation-start. A trigger starts a run for an event whose hop count is at most eight and declines with reason hop-limit past it (D-700, SCH-300, SCH-1532). Rejected: a hop field on each domain event (every event of one transition has the same count, and the context is journalled with the transition)."},
    {"id":"d-7203","ref":"D-7203","title":"record-updated names the workflow transitions it fired","group":"Automation","decided":"2026-11-20","statement":"**record-updated names the workflow transitions it fired.** A record-updated event carries transitions: for each workflow of the record that fired a transition in the update, the name of that transition by workflow id, left out when none fired. A trigger on record-updated naming a transition, and a subscription selector naming transitions, match on it, and param.transition is bound from it. Rejected: inferring the transition from the value of the field before and after (two transitions between the same states with different guards could not be told apart, and both would match)."},
    {"id":"d-7204","ref":"D-7204","title":"The kernel records the definer of a definition and suspends an automation whose definer lost authority","group":"Automation","decided":"2026-11-20","statement":"**The kernel records the definer of a definition and suspends an automation whose definer lost authority.** define-trigger and define-automation write defined-by, the acting person (none for the system), and defined-at, the time of the context; a value the input supplies is replaced. After every transition that changes members or the schema, the kernel checks, in the same transition and on the state after the change, every automation that has a definer and is not suspended: one whose run-as names a role the definer may no longer confer under ADM-152 is marked suspended-for that role, with an automation-suspended event (D-6526, WFL-1529, CT-798). The principal of a suspended automation holds no run-as role and its triggers decline with run-as-suspended. Defining it again clears the suspension once the new definer is found to confer every run-as role (WFL-1528). An automation principal holds its run-as roles and no other, so a person, a team member or an owner cannot be assigned roles under a principal id that starts with automation:. Rejected: checking only the intents that change roles by name (a removed or changed policy, a team, the permissions of a role all change what a definer may confer; checking the state after the change catches every one); the erasure of the definer is a change of the shell and calls the same check (CT-798)."},
    {"id":"d-7300","ref":"D-7300","title":"Setting definitions and product capabilities are tenant metadata in the tenant schema","group":"Tenancy","decided":"2026-11-20","statement":"**Setting definitions and product capabilities are tenant metadata in the tenant schema.** The definitions of the settings of a tenant (D-5040, D-5047) and the capabilities that its products declare (D-6590) are held in the tenant schema (tenant-schema.settings and tenant-schema.capabilities) and change through the schema changes define-setting, remove-setting, define-capability and remove-capability, which raise the schema version, as the settings contracts state (CT-300). They are checked when the schema is checked, so a trigger that names a setting, and a role that grants a capability of the product form, are refused when the setting or the capability is not declared, and a removal that would leave one dangling is refused. The overrides are data and are held in the tenant state (tenant-state.setting-values), so the kernel decides a write against the revision it was read at and resolves a read as a pure function (D-5041, D-5045). The tenant catalogue of D-6581 stays for the entities that no definition names; a schema that declares no setting and no capability hashes as before. Alternative: hold both in the tenant catalogue, rejected because the checks of the schema (a trigger names a setting, a role grants a capability) would then need the catalogue as a second argument at every call. Open for the owner: whether D-6581 should move settings and capabilities back into the catalogue."},
    {"id":"d-7301","ref":"D-7301","title":"The platform level of a setting is read-only until the control plane holds its values","group":"Tenancy","decided":"2026-11-20","statement":"**The platform level of a setting is read-only until the control plane holds its values.** The platform keeps the values of its level and its own definitions in the control plane (CT-303, SET-005). The control database holds neither, so the kernel resolves a setting from the person, the team, the tenant and then the default of its definition, and refuses a write at the platform level with the reason that the control plane writes it. When the control plane holds the platform values, the step enters the resolution between the tenant and the default and the platform revision of the answer is read from it; no tenant data changes. Alternative: store the platform values in the tenant file, rejected because the platform level changes every tenant."},
    {"id":"d-7302","ref":"D-7302","title":"A capability of the product form must be declared, and a platform capability never has the form","group":"Security","decided":"2026-11-20","statement":"**A capability of the product form must be declared, and a platform capability never has the form.** The platform's capability ids contain no two consecutive underscores, and the id of a product capability is the namespace of its product, two underscores and a name (D-6582). The kernel holds no list of the platform's capabilities and treats them as opaque strings, so it decides by the form: a role-permissions entry that names a capability of the product form is refused unless the tenant declares it, and a role whose own id has a product namespace is refused a capability of another namespace (D-6701). A name of the platform form is not checked by the kernel; the gateway checks it against the generated list of capabilities."},
    {"id":"d-7303","ref":"D-7303","title":"The revision of a setting never falls and is never reused","group":"Tenancy","decided":"2026-11-20","statement":"**The revision of a setting never falls and is never reused.** Each setting has a revision at the tenant that rises by one at every change of its definition or of any of its overrides, and an override carries the revision that its write made. A write names the revision of the override it read, zero when there was none. Because a revision is not reused, an override that was removed and written again has a later revision than any a stale writer could hold, so no writer overwrites a change it did not read (D-5045, SET-025)."},
    {"id":"d-7360","ref":"D-7360","title":"specc writes the tenant rule language as JavaScript too, so the page evaluates a rule as the server does","group":"Platform","decided":"2026-11-20","statement":"**specc writes the tenant rule language as JavaScript too, so the page evaluates a rule as the server does.** The command specc web writes, for each language the specification declares, one module <language id>.js beside the generated client modules (tenant-rule-language.js for the tenant rule language): its parser (text to syntax tree), its printer, its static check and its evaluator, from the same declaration and the same primitive catalogue that give the Rust module. An expression and a value are the JSON the Rust types serialise to (a variant without fields is its name, a newtype variant {Name: payload}, a tuple variant {Name: [..]}, a variant with named fields {Name: {field: ..}}, each name written in the variantCase of its union), so a syntax tree the server sends is evaluated as it stands. The environment is an object with the methods the Rust trait has (record, follow, param, now, principal, hasRole; fieldShape, follow, hasParam, hasRole for the check), and the three errors are three classes, ParseError, EvalError and CheckError, whose messages are the Rust messages. Integers are JavaScript numbers held to the range of exact integers: every operand of checked arithmetic and every result must satisfy Number.isSafeInteger and lie within plus or minus (2^53 - 1), or the evaluation fails with integer-overflow; a product or sum of two such integers is exact when its magnitude is at most 2^53 - 1 and rounds to a magnitude of at least 2^53 when it is not, so the range test on the result finds every overflow, and negative zero is written as 0. BigInt is not used, because the values arrive and leave as JSON numbers and a BigInt is not one. len counts Unicode scalar values (Rust chars().count()), lower is the full Unicode lower-casing (to_lowercase()), strings are ordered by code point (Rust orders str by its bytes of UTF-8, which is code point order; a JavaScript comparison of UTF-16 units is not), and concat measures its result in bytes of UTF-8 against 4,096. A number literal in an expression's text beyond plus or minus (2^53 - 1) is refused when the text is parsed, where the Rust parser accepts the whole 64-bit range and refuses only at the first arithmetic on it; the page cannot hold such a number. A text id the language reads (a role) is checked by the JavaScript parser against the id's constraints in the order its constructor checks them. A language whose unions are not externally tagged, or whose text-id pattern JavaScript cannot read as the server does, is refused by specc web (specc.language-js-unsupported). The shared case table (kernel-cases.json) is run through the generated JavaScript under node by specc's tests, for the language fixture and for the platform's own language, and through the generated Rust by the language fixture's tests, so the two modules are held to one meaning. Rejected: BigInt for every integer, because a value would have to be converted at each border; a hand-written evaluator for the page, because nothing would hold it to the server's; evaluating the rule on the server for each keystroke, because that is the round trip this removes."},
    {"id":"d-7240","ref":"D-7240","title":"The automation principal holds its run-as roles and not public","group":"Automation","decided":"2026-11-20","statement":"**The automation principal holds its run-as roles and not public.** roles_of gives automation:<workflow-id> exactly the roles of the run-as of its automation, as WFL-1527 states, and not the role public that every other principal but the system holds; the principal of an automation the schema no longer holds holds no role. The prefix automation: is reserved: a person may not be the owner of a new tenant, be assigned a role or be added to a team under it, and a caller with a session may not act under it, because the automation worker acts without one. Rejected: adding public (the run would hold a grant the definer did not choose); a new variant of principal (every exhaustive match on principal in the kernel and the shell would change for one prefix)."},
    {"id":"d-7241","ref":"D-7241","title":"A step is evaluated at the time its job was created","group":"Automation","decided":"2026-11-20","statement":"**A step is evaluated at the time its job was created.** The expressions of an automation step are evaluated with now set to the creation time of the job of the step, which is the same on every attempt of the job, so a retried attempt asks the kernel for exactly the intent of the first and the idempotency record of its step key answers it (SCH-015, D-6528). Rejected: the time of each attempt (a retry after a lost result would be a different intent under the same key and be refused as a reused key)."},
    {"id":"d-7242","ref":"D-7242","title":"The wake index is kept in the control database under a write counter","group":"Automation","decided":"2026-11-20","statement":"**The wake index is kept in the control database under a write counter.** Each tenant with open jobs has one row in job_wake of the control database: its earliest due time and a counter. A job is woken for before and after the commit that creates it; after a lease, a report, a cancel or a retry the row is set to the earliest due time of the tenant file only if the counter is unchanged since it was read, so a time lowered by a job created meanwhile is never overwritten (SCH-007, SCH-008). A row that is too early costs one look at the tenant file and is put right by that look. Rejected: scanning every tenant file for due jobs, as the outbox does (SCH-007 forbids a query to a tenant that has none); a due time per job in the control database (SCH-008 allows a tenant id and a due time only)."},
    {"id":"d-7280","ref":"D-7280","title":"Entry and exit events are kept in the ordered log of the segment block","group":"Automation","decided":"2026-11-20","statement":"**Entry and exit events are kept in the ordered log of the segment block.** An entry or exit event (segment-membership-event) is written, in the transaction that changes the membership, to an ordered log of the tenant that belongs to the segment block (rec-segment-event), with the time, the principal and the correlation of the decision, and with the order and the published flag of an outbox; the job worker reads it as the outbox of entry and exit events and a trigger subscribes to it (SEG-014). It is not written to the event sequence of the kernel. Segment definitions, batches and refreshes are not transitions of the journal, so an event of theirs in the kernel sequence would make a replay of the journal disagree with the live state (K-11), and so would the shifted sequence of every later transition. Membership is still a function of the journal, the definitions and the times given to the decisions (SEG-011). This replaces the plan of D-5023 to add two variants to the event body of the kernel. Rejected: the two variants, which needs the journal to record segment definitions and batches and the replay to run them; it can be reconsidered when the catalogue of a tenant is journalled with its schema (D-6581)."},
    {"id":"d-7281","ref":"D-7281","title":"What a segment may name, and a definer whose permission is withdrawn","group":"Automation","decided":"2026-11-20","statement":"**What a segment may name, and a definer whose permission is withdrawn.** SEG-005 is read strictly. The definer must read, without a condition, every object type the predicate reads, because a conditional read would let the members of the segment show records the definer cannot see; and no field the predicate names, nor the principal field the members are listed by, may carry a read rule (D-6586), because whether such a field is visible depends on the reader and the record, which a definition cannot know. Listing or counting the members needs, beyond segments-read and the readability of each subject record (SEG-033), an unconditional read of every other object type the predicate reaches, since the membership of a person shows what the predicate computes from them. The question D-5028 leaves open is answered the strict way: while the definer of a segment would no longer be allowed to define it, the segment is suspended and nobody may list or count its members; its membership is still kept, so that it equals the evaluation again the moment the permission returns."},
    {"id":"d-7282","ref":"D-7282","title":"Segment writes rest on the rows they read, and continuations have a scope","group":"Automation","decided":"2026-11-20","statement":"**Segment writes rest on the rows they read, and continuations have a scope.** Every decision about segments carries the version of each segment it evaluated and the membership and wake rows of every person it decided, changed or not, and the store refuses the write as a conflict when one of them moved, so a decision never writes over, or keeps, a membership decided by a commit it did not see; the shell decides again. A write that no transition carries (a definition, a removal, a batch, a refresh, an erasure) is applied while the tenant is at the revision it was decided at and does not advance the revision, since no record changed. A continuation has one of three scopes: every person of the subject type (a changed predicate, a full refresh, and a change that touched more subject records than one transaction evaluates), the referrers of one record whose fields the predicate reads (the rest of a change to that record), or the persons whose wake time has passed (the refresh of an indexable predicate); a segment has at most one continuation for each scope, and a newer version replaces the one of an older version. The subject type and the principal field of a segment do not change; a segment over other people is another segment. A predicate that does not read the time declares no refresh interval (SEG-020)."},
    {"id":"d-7340","ref":"D-7340","title":"The declarations of an object type are schema changes of their own","group":"Platform","decided":"2026-11-20","statement":"**The declarations of an object type are schema changes of their own.** A schema change sets and clears each of the four declarations of an object type: set-retention and clear-retention, set-publication and clear-publication, set-language-field and clear-language-field, set-translation-group and clear-translation-group. The personal declaration of a field travels in the field-def of define-field, so it is stored with the field and read back with it. A type with a personal field is refused unless it declares retention in the same change (D-6584), so a change that defines the type, its personal field and its retention is accepted and the same change without the retention is refused. The declarations are optional members of object-type-def that are left out while absent, so a schema that declares none of them hashes as it did before, and clearing one returns the schema to the hash it had without it. The kernel checks, when the schema is checked: a retention lasts at least a day and counts from a timestamp field of the type; the language field is a field of the type with the language type; a translation group is a field of the type and needs a language field; a publication names a state field of the type that has a workflow, every state it names is a state of that workflow, in-review and approved come together, the time field is a timestamp field and the review workflow is a workflow or an automation of the schema (D-6592, D-6593). Alternative: one schema change per declaration with an optional payload; rejected because a clear and a set are different refusals. Alternative: more fields on define-object; rejected because define-object relabels an object type that exists and would then have to say what it does to each declaration."},
    {"id":"d-7341","ref":"D-7341","title":"Templates, tokens and the ownership record of a product are held in the tenant schema","group":"Platform","decided":"2026-11-20","statement":"**Templates, tokens and the ownership record of a product are held in the tenant schema.** The mail templates, notice templates and tokens of a tenant and the ownership record of each installed product (installed-product) are members of tenant-schema (mail-templates, notice-templates, tokens, products), each optional and left out while empty, and they change through schema changes (define-mail-template, remove-mail-template, define-notice-template, remove-notice-template, define-token, remove-token, record-product, remove-product). So the entities of a product and the record of what it owns are the changes of one change-schema intent: one commit, one schema version, all or none (D-6581), and a template or a token is stored under the schema version as the contracts define-mail-template, define-notice-template and define-token say. This amends D-6581: the schema and schema-change do change, and a schema that holds none of the four members hashes as before. The other sections of the tenant catalogue (capabilities, segments, settings, ledger units, pools and limits) are held by the schema changes of the module that holds each. A mail template and a notice template share one template-id space, so an id names one of them; a template has a one-line subject or title and a body that is JSON text; a token has a name and an expression that parses (CTK-002). The specification states no schema for the blocks of a template and no syntax that places a token in one, so the kernel checks neither the blocks nor that a template names only tokens that exist; a bundle is refused only for an automation that sends a template that neither the bundle nor the tenant declares. Alternative: the tenant-catalogue as a document beside the schema, written in a second commit; rejected because a failure between the two writes leaves entities that no product owns and a retry that is refused as a conflict."},
    {"id":"d-7342","ref":"D-7342","title":"A product is upgraded and removed from its ownership record, and an object type or a role is removed by a schema change","group":"Platform","decided":"2026-11-20","statement":"**A product is upgraded and removed from its ownership record, and an object type or a role is removed by a schema change.** An upgrade computes the difference between the installed and the new version from the ownership record of the product: an entity the bundle declares that the record does not own is created (and refused when the tenant has one by that id), one the record owns that differs from what the bundle declares is changed, and one the record owns that the bundle no longer declares is removed; a field, a constraint, a composite unique constraint or a declaration of a changed object type that the new version drops is removed with it. A version that is not greater than the installed one is refused by an upgrade, the equal version included. A removal deletes exactly the entities the record owns, and the record. The schema change remove-object removes an object type, and states with delete-records whether the records of the type are deleted: the change is refused while records exist unless it says so, and then deletes them in the commit of the schema change, each with its event. The schema change remove-role removes a role and its permissions, and is refused while a principal holds the role, so an upgrade or a removal that drops a role is refused until the assignments are revoked. A schema that still names a removed entity (a policy, a query, a view, a workflow, a trigger, a field of another type) is refused with the problem, which is how a removal refuses while another product refers to an entity this product owns."},
    {"id":"d-7343","ref":"D-7343","title":"A product header takes a version and a platform range, and a product file declares queries, views and workflows","group":"Platform","decided":"2026-11-20","statement":"**A product header takes a version and a platform range, and a product file declares queries, views and workflows.** The header of a product file takes version (three whole numbers joined by dots) and platform (min, a platform release, and below, a later release, optionally), and the layer checks of specc and Exegra refuse a malformed one with layer.header-invalid, so the bundle no longer reads them from a text with the keys taken out. A product with no version is still refused by specc bundle with bundle.version-missing. A product file declares queries (query-def), views (view-def) and workflows (workflow-def) as typed sections of D-6700, each a list of values with an id, which specc bundle writes into the sections queries, views and workflows of the bundle; a name in them that is in the namespace of the product is declared by the product file (query-id by queries, workflow-id by automations or workflows). The expressions of a query are checked against the fields of its object type and its parameters, those of a workflow against the fields of its object type. Alternative: the sections screens and behaviors of the specification format; rejected because they are entities of the platform format that describe a web interface and a simulation model, not tenant metadata."},
    {"id":"d-7520","ref":"D-7520","title":"Named queries are served from the record index where a plan is sound","group":"Kernel","decided":"2026-11-20","statement":"**Named queries are served from the record index where a plan is sound.** When a query is defined, its filter is analysed into an index plan: an equality or a list of values on one field (in record id order, or in the order of that field), or a range on an integer or time field ordered by that field. The kernel asks the store for pages of candidates from that field's index (need index-page), applies the whole filter, the read authorization and the field redaction to each, and pages on until its page is full, the candidates end or it has examined 1600, with a cursor that holds the index position. Every other query is a scan, refused above 10000 records, and the schema change that defines it says so and why. The record index gains an order key (the number of an integer or a time) and the variant of each single value, filled for existing files by a rebuild when tenant migration 16 runs. Filters and orders now see the record as the reader receives it, and a field with a read condition is never planned on, so neither the rows, their order nor the page boundaries reveal a hidden field. Strings are equality-only in the index, because a string longer than the 240-byte key limit has no key. A view loads only the pages its sections read. Rejected: a composite index per query (it needs a definition step and storage per query, and an equality on one field with an order on another stays a scan); a count in the cursor (it skips or repeats records when the table changes); evaluating filters on the whole record (it lets a filter on a hidden field reveal it)."},
    {"id":"d-7920","ref":"D-7920","title":"An equality ordered by another attribute is served by a pair index that the queries declare","group":"Kernel","decided":"2026-11-20","statement":"**An equality ordered by another attribute is served by a pair index that the queries declare.** When a named query has at the top level of its filter a condition field == value or field in list, on a field without a read condition, and orders by another attribute (an integer or time field without a read condition, $created_at or $updated_at), the planner derives at definition time the pair (field, attribute) and the query is served from need pair-page: the records of one value of the field in the order of the attribute and then the record id, after a position, at most 200 at a time, one stream per value of a list (at most 16), merged. Paging, the 1600-candidate bound, cursors that hold positions and the rule that a field with a read condition is never indexed are those of D-7520. A missing or null value of the attribute takes part in the order as the least value, as it does in a scan. A store keeps the index of exactly the pairs the plans of the defined queries read (strata_kernel::query_plan::index_pairs). The SQLite adapter lists them in record_pairs and holds the rows in record_pair_index, keyed by object type, field, attribute, the key of the value, the order key (kind and number) and the record id (tenant migration 17). It builds a pair from the records of the type in the commit of the schema change that defines the first query reading it, removes it in the commit of the change after which none reads it, and rewrites a record's rows in the commit that writes the record, so a write costs one row per pair the tenant queries. The order key holds null, integers and times; a record whose value of the attribute is of another kind (a value a schema change kept) has a marker row, and while one exists the store answers that pair from the records of the type, so the record is still found in its place. A value of the field longer than 240 bytes has no row, and no probe the index serves can equal it. When the rows of a read follow references into records the snapshot lacks, the kernel names every such record of the rows it examined, with the page of candidates it stopped at (strata_kernel::query_plan::read_missing), and the shell loads exactly those records, never their object type. A schema change that leaves a query a scan names in its warning the one change that would let an index serve it. This replaces the rejection of a composite index per query in D-7520. Rejected: widening record_index with every pair of fields of a record (its rows grow with the square of the fields of every record, for pairs no query reads); building a new pair by a job while the query is served by a scan (the plan would depend on the state of the store as well as on the schema, and the memory store and SQLite would answer differently while the job ran); a need for a set of records (one Need::Record per record already says it, and a new variant would have to be covered by every spec function that matches on need)."},
    {"id":"d-7780","ref":"D-7780","title":"A record type declares which text fields its search index holds, and search matches within one field","group":"Content","decided":"2026-11-20","statement":"**A record type declares which text fields its search index holds, and search matches within one field.** An object type lists its searchable fields in an optional member, searchable, set by set-searchable and cleared by clear-searchable; a schema that declares none hashes as before. A listed field is indexed when it has a text type (a string or a list of strings) and is not personal, or is personal and its personal declaration says searchable (D-6585); a listing that names a field the type lacks, a field that is not text, a personal field that is not declared searchable, the same field twice, or more than 20 fields is refused when it is made. Tokens: the text is split at every maximal run of characters that are not alphanumeric (Unicode letters, digits and numeric characters), each word is lowercased with the Unicode lowercase mapping and cut to 64 characters, a repeated token is kept once, and a field holds at most 1000 tokens, the first in reading order. This is a lowercase mapping, not full case folding, and the text is not normalised. The query is split in the same way, at most 8 different words and 200 bytes. A query word matches a field when it is the start of a token of the field; a field matches when every query word matches it; a record matches when one field matches. The words of a query never combine across fields, because a record returned on the strength of a field the reader may not read would confirm its content. Alternative: a full-text engine with ranking and stemming; rejected for the first release because every hit must be decided field by field by the kernel and a stemmer widens what a hidden field can confirm. Alternative: FTS5; not used, so that the index is a plain table in the tenant database and the memory store and the SQLite adapter answer the same by one definition of a token."},
    {"id":"d-7781","ref":"D-7781","title":"The search index offers candidates and the kernel decides every hit","group":"Content","decided":"2026-11-20","statement":"**The search index offers candidates and the kernel decides every hit.** A store holds, per tenant, one entry for each token of each searchable field of each record, written in the commit of the record and removed in the commit that deletes or rewrites it, and answers a probe: the records of one object type above a record id, in ascending id order, at most 200, each with the fields in which every query word is the start of a token. It authorizes nothing. The kernel decides each candidate for its reader: the record exists, the Read policies permit it, and at least one matched field is a field the reader may read (D-6586) and still matches the query in the record as the reader receives it. A hit carries the record without the fields the reader may not read and the readable fields that matched. A field whose read rule looks at the reader and not at the record, and is false for the reader, is not probed. Order: ascending object type, then record id; there is no relevance score. A request examines at most 1000 candidates whatever the reader may read of them; a page ends when it holds its hits or the bound is reached, and carries a cursor that names the last candidate examined, so that no record appears twice or is skipped across pages. A candidate that matches only on a field whose read rule looks at the record counts towards the bound and shows the reader that a page ended early, which is the one thing a reader learns of hidden content; the alternative, reading every candidate, has no bound. The index is a function of the records and the schema: a commit that changes which fields of a type are searchable rebuilds the entries of that type in the same transaction, and a file that is opened with records but no entries is rebuilt."},
    {"id":"d-7880","ref":"D-7880","title":"Policies over the ledger bound a reader, and a ranking is filtered","group":"Security","decided":"2026-11-20","statement":"**Policies over the ledger bound a reader, and a ranking is filtered.** A principal whose roles have a policy over the ledger resource that permits read reads exactly what those policies permit, whether or not it holds ledger-read: the policies are a grant (the first that holds permits, default deny) and they also bound a holder of ledger-read, which without such a policy reads every account as before (D-6550). Whoever owns an account reads it and its entries under ledger-read-own, with or without a policy. A balance and a place in a ranking answer for a whole account, so they are permitted only when the policies permit the account with the fields of an entry absent: a condition over amount, reason, caused_by or at is then null and does not permit, and such a reader reads entries, each judged on its own, and no balance of the account. Deriving a balance from the readable entries (CT-288) is not built. A ranking under a policy is filtered: the offset and the page count the accounts the reader may read, so neither the position nor the existence of any other account is disclosed (D-6552, LDG-1544); the scan bound counts the accounts examined, readable or not, the walk starts with the accounts it needs and doubles its window while the page is short, and it is refused with scan-bound-exceeded when it has examined the bound and the page is still short. An account the reader may not read is not told apart from one that does not exist. Rejected: a ranking that is unfiltered and hides only the rows, which discloses positions by the gaps in the offset; a bound that counts readable accounts only, which lets one reader make the platform scan the whole unit."},
    {"id":"d-7881","ref":"D-7881","title":"The limit of one account is kept in the ledger and loads by its own need","group":"Platform","decided":"2026-11-20","statement":"**The limit of one account is kept in the ledger and loads by its own need.** The limits of a unit stay in the tenant schema (D-5005). The limit of one account is one record per exception (D-6554) and there may be ten thousand, which would load with every read of the schema, so it is written to the ledger's own storage in the commit of the schema change that sets or removes it, and a posting loads the one limit of its account by the need limit with its header and the entry of its key. Setting one counts the limits of single accounts by the need limits and is refused with too-many past ten thousand; removing one that is not set is refused. A tenant file made before this change is migrated: its account limits move from the schema to the ledger's storage and the schema keeps only those of units. The limits of an account whose owner is erased are removed with the erasure. Rejected: a table of limits read through the schema, which keeps them in every load; a limit in the header of the account, which cannot exist before the account does."},
    {"id":"d-7882","ref":"D-7882","title":"Credits expire in buckets that the header keeps, and the expiry is an entry the kernel decides","group":"Platform","decided":"2026-11-20","statement":"**Credits expire in buckets that the header keeps, and the expiry is an entry the kernel decides.** Buckets count only the credits posted while the unit declares an expiry, so an account that held a balance before the declaration keeps it. A credit that arrives while the balance is negative first pays off the debt and only the rest enters a bucket, so the buckets add up to the balance when it is positive. An account holds at most thirty-six buckets; a credit that would open another merges the two oldest into the newer, so the oldest credit lives longer and never shorter. The expiry is the intent expire-ledger, decided by the kernel for the system or for a holder of ledger-configure; it posts, for each account whose oldest bucket starts at or before the cutoff, one entry per due bucket of minus its remaining amount with the key expiry:<bucket start in milliseconds>, the reason expiry and no person as its cause, for at most one hundred accounts in one transaction. It is not held to the floor of the account, because it removes credit the holder could no longer count on, and refusing it would keep the account in the index of due accounts for ever. The key prefix expiry: belongs to it: an ordinary posting that uses it is refused, so an expiry entry never collides with a key a poster chose. The cutoff is the start of the latest bucket whose life has ended, and a later cutoff is refused. The accounts are found through an index of the unit and the start of the oldest bucket, never by a walk of the accounts of the unit."},
    {"id":"d-7883","ref":"D-7883","title":"One job per tenant carries the expiry and creates the next","group":"Platform","decided":"2026-11-20","statement":"**One job per tenant carries the expiry and creates the next.** The job of expire-ledger-credits is created through the job store when a unit with an expiry is declared, under the key ledger-expiry:start so that a second declaration creates none, and each run creates the next in the transaction that reports it, due one hour after the job it follows under the key ledger-expiry:<due time in milliseconds>, so that an attempt that runs again creates the same next job once. Nothing depends on a schedule. A run decides at most twenty batches of one hundred accounts for each unit that declares an expiry and leaves the rest to the next run; a chain that fell behind catches up one run at a time. An attempt that ran and did not report is run again after its lease and posts nothing twice, because each entry has the key of its bucket (LDG-006)."},
    {"id":"d-7884","ref":"D-7884","title":"A socket notice of a posting goes to those the kernel lets read the account","group":"Security","decided":"2026-11-20","statement":"**A socket notice of a posting goes to those the kernel lets read the account.** A subscriber that selects units, or kinds, hears of the entry posted to an account when the read decision of the kernel for that account lets it read the account (D-6550): the owner of the account, a holder of ledger-read that no ledger policy bounds, or a reader whose policies permit the account. The notice names the account by its derived id, the unit, the scope and the number of the entry, and never the owner, the amount or the balance, which the subscriber reads again through the ordinary path (SCH-1575). An anonymous subscriber hears nothing."},
    {"id":"d-7860","ref":"D-7860","title":"An aggregate copy is versioned by a change counter per object type","group":"Delivery","decided":"2026-11-20","statement":"**An aggregate copy is versioned by a change counter per object type.** The store keeps, for each object type of a tenant, a counter that rises in the commit that writes or deletes a record of the type and when a snapshot of the tenant is restored. The key of a stored aggregate result holds the counters of the object types that the result names in depends-on (D-5064), read before the records are loaded, so a copy is never stored under a counter newer than the records it was computed from. A single counter for the whole tenant would be sound and would expire every copy at every commit; a counter per type expires a copy only on a commit to an object type it reads. A copy is also dropped after 60 seconds, which bounds memory and is no part of what makes it fresh. The audience class of a principal for a result is the set of its roles that the Read policies, the field read rules and the query filter of the result name, and is the principal alone when a condition that applies to the principal mentions the principal or the clock (D-15, D-5065)."},
    {"id":"d-7660","ref":"D-7660","title":"Segment events reach the triggers by a cursor committed with the jobs they start","group":"Automation","decided":"2026-11-20","statement":"**Segment events reach the triggers by a cursor committed with the jobs they start.** The job worker hands the entry and exit events of the segment log (D-7280) to the triggers in position order, at most one hundred events in a transaction, from a cursor of the tenant that the segment block keeps as the position of the newest event handed on. The jobs, the declined records and the new cursor of one batch of events are written in one transaction, and the write is refused as a conflict when the cursor is not where the decision read it, so an event is handed on once: a worker that stops before the commit leaves the cursor where it was, and two workers cannot both hand on a position. The key of each job is the trigger, the automation and the position of the event, so a decision made again creates nothing twice. A trigger on segment-entered or segment-exited is matched by the same rules as a trigger on a record event: the automation principal must be able to read the subject record of the person, the hop count of the event is the hop count of the change plus one, and an event past the hop limit declines with hop-limit and a declined record. An event about an erased person, whose record is gone, starts nothing. The job that runs a batch of a segment hands on the events the batch wrote, and a job of its own hands on the events of a commit. Rejected: a cursor kept in a job (a tenant with no events would need a job that never ends), and handing events on without a cursor (a restart would hand them on again)."},
    {"id":"d-7661","ref":"D-7661","title":"Restoring a snapshot re-evaluates every segment as if its predicate had changed","group":"Automation","decided":"2026-11-20","statement":"**Restoring a snapshot re-evaluates every segment as if its predicate had changed.** The membership and wake rows of a segment rest on the records of the tenant, so a restore that puts other records back leaves them stale. The restore clears the membership and wake rows of every segment, writes no event for it because a restore is not a transition (D-7280), raises the version of every segment, which supersedes every pending continuation (SEG-025), and leaves a continuation over every person at the new version (SEG-022), with its job, in the transaction of the restore. The persons are then entered again by the batches, with entry events, so that membership equals a fresh evaluation over the restored records. Rejected: keeping the rows and evaluating only the persons whose records changed (a person whose record the restore deleted would stay a member), and writing exit events for every member (a restore is a recovery, not a change a trigger should answer)."},
    {"id":"d-7662","ref":"D-7662","title":"A product bundle defines its segments around its one schema change","group":"Automation","decided":"2026-11-20","statement":"**A product bundle defines its segments around its one schema change.** A segment lives in the segment block and not in the schema, so the single change an owner approves cannot hold it in the same commit. The install, upgrade and removal of a bundle with segments is one operation made of the checks first, the schema change as one commit with the ownership record, which lists the segments by their namespaced keys, and the segment writes around it. Before anything is changed, the change is decided against the whole tenant and every segment is decided against the schema the change leaves, so a change or a segment that would be refused touches nothing. The segments a change removes are removed before the schema change, because a schema change that removes a field a segment names is refused (SEG-006), and are defined again when the schema change is refused after all. The segments a change defines are defined after it, because they name the object types it creates; a definition that changes nothing is a no-op, so the same bundle again gives the same segment id, derived from the tenant and the key (D-6582), at the same version. When a definition is refused after the schema change was committed, an install removes what it made and an upgrade reports it, and installing the same version again defines what is missing. Rejected: one commit for both (the segment block is not part of the transition), and defining segments before the schema change (their object types do not exist yet)."},
    {"id":"d-7663","ref":"D-7663","title":"A refresh job of a segment is skipped when the daily job quota has no room","group":"Automation","decided":"2026-11-20","statement":"**A refresh job of a segment is skipped when the daily job quota has no room.** A segment job counts against the job admission rate of its tenant by being a job of the worker, which releases the jobs of a tenant at its budget, and against the daily job quota of its plan (D-508, SEG-1543) by being counted with every other job the tenant created in the quota day, which runs from 00:00 UTC to 24:00 UTC. A scheduled refresh asks for the next refresh first and then checks the quota: with room it starts the refresh, and without room it records the time on the segment (SEG-1544) and starts nothing, so a missed refresh is caught up by the next. The due times of the refresh jobs of a segment are multiples of its refresh interval, so one schedule exists for a segment whatever number of times it is defined. Rejected: refusing the commit that finds no room (D-6533 never refuses a change for the volume of jobs)."},
    {"id":"d-7800","ref":"D-7800","title":"The limit store counts quotas from the specification; which counters are shared and which belong to one process","group":"Tenancy","decided":"2026-11-20","statement":"**The limit store counts quotas from the specification; which counters are shared and which belong to one process.** Every served contract that has a quota entry is limited by it, at the one point where the backend admits a request, keyed by the contract the route serves; the limit, the window, the scope and the error are read from the generated quota table and are written nowhere else, so a contract that gains a quota entry and a route is limited with no further code. A refusal is the error throttled, names the quota and its limit, and carries the number of seconds after which the next call is permitted. A quota that queues or throttles holds the call for at most one second when its window is about to end and refuses it otherwise. **Shared through the database** (every process that opens the store sees them): the plan of a tenant, which is a column of its row in the directory of the control database; the value of an allowance that a tenant or the platform operator set; the count of a quota whose window is longer than one minute, kept as documents of the tenant that was asked, as the throttle rows of a sign-in are; the jobs counted against a quota day and against a minute; the messages counted against a calendar month; the tenant switch of a flag and the decision of its release record; and the size of the database, which is the measure of stored bytes. **Per process, lost on a restart:** the count of a quota whose window is one minute or shorter, the rate of sign-in attempts of one source, the open sockets, the Argon2 places and the places of the blocking queue. A shared count is read, decided and written without a lock held by the database, so two processes that count one key at the same moment may let a call or two past the limit. The per-process counters matter for correctness in one way: a source that spreads its calls over several processes may make as many calls as the limit allows to each of them within a minute, so a short-window quota is exact only while one process serves. The quota of one source is counted in the tenant that was asked, so a source that asks many tenants has a count in each. A limit store shared by every process, with an atomic count for every window, is a task of its own. Rejected: counting every window in the database (a minute-long window written on every request makes the limit store a cost of every public read); counting every window in memory (a restart would give a locked-out source a fresh hour)."},
    {"id":"d-7801","ref":"D-7801","title":"The allowances of a plan are enforced where the bounded thing is made, and a tenant reads its use","group":"Tenancy","decided":"2026-11-20","statement":"**The allowances of a plan are enforced where the bounded thing is made, and a tenant reads its use.** The plan of a tenant is recorded in its row of the directory of the control database; a tenant that holds none holds standard. The allowances are the starting values of D-508 and D-700 held as data: stored bytes (standard 10 GB, business 100 GB, a gigabyte being 10^9 bytes), jobs a quota day (10,000 and 100,000), bulk messages a calendar month (5,000 and 50,000), jobs released a minute (100 on every plan) and segments (100 on every plan, SEG-029); Enterprise has none of the first three until a contract records them. A value set for one tenant by the platform operator replaces the plan's and takes effect on the next request, with no restart. **Stored bytes** are measured as the size of the tenant's database; a write that adds data (every intent but the deletion of a record, the erasure of a subject and the revocation of a role, a team role, a team member or an invitation) is refused when the bytes held plus the size of the write exceed the allowance, with the quota named in the refusal (BIL-151), while reads and deletions are served. **Jobs** follow D-6533: the commit that creates jobs always commits; a job past the allowance of the quota day is due at the start of the next UTC day, counts against that day and writes a held exception record with the reason job-quota, and a job past the rate of a minute is due at the start of the next minute that has room, so a burst is released at the rate (SCH-302) and none is lost. **Segments** are refused when a tenant holds as many as it may. **Mail** is counted by class: a bulk message past the allowance of the month is held to the start of the next month while sign-in mail and the mail of other tenants leave (EML-021). **Capabilities** a plan entitles are the plan's list beyond the core ones; the plan of the tenant is the input of the entitlement check of the generated authorizer. **A flag** is on for a tenant only when the release record enables it for the tenant and the tenant's own switch is on, each at the default of the flag when none was set (OPS-328, D-6202); an owner sets a switch that the release record of a flag defines, can always turn it off and can turn it on only when the release record has enabled the flag. An owner reads, in one reply, the plan and for each allowance what the tenant has used and what it may (BIL-150). A plan change is refused while the tenant holds more of a metered quantity than the new plan allows, naming the quantity (MIG-583). Not yet counted: requests a second and database connections of a plan, which belong to the gateway, and jobs created by the worker for the steps of a run. Rejected: refusing the change that creates a job (D-6533); measuring stored bytes by counting records (a file and a record of one byte would weigh the same)."},
    {"id":"d-7700","ref":"D-7700","title":"A step key includes the position of the step in its run","group":"Automation","decided":"2026-11-20","statement":"**A step key includes the position of the step in its run.** A run may go back to a step through a branch, and the definition allows it. The position of a step in its run, counted from one for each step that runs, tells the visits of one step apart: each visit has a key of its own, so the effect of each visit is applied once, and every attempt of one visit has the same key, so a retry of a visit applies nothing a second time. The key is the SHA-256 of the tenant, the automation, the run, the step name, the member of a fan-out and that position (strata/step-key/v2). Rejected: refusing a definition that goes back to a step (a loop through a branch is how a campaign repeats until a condition holds); a visit count the worker keeps beside the run (the position is already recorded on each step and on its job, so a second counter could disagree with it). A step in flight when the key changed, whose report was lost, takes the new key on its next attempt and so its effect is applied again once; this is bounded to the runs that were open at the release."},
    {"id":"d-7701","ref":"D-7701","title":"An idempotency entry states its own retention","group":"Automation","decided":"2026-11-20","statement":"**An idempotency entry states its own retention.** The entry of a key holds how long it is kept from its commit, as the request states it: twenty-four hours for a request of a person or service; seven days for an invocation of a tenant operation, which is its run record (D-6548), recorded under the invoker and the operation so that a key is another key for another operation; and, for the record change of an automation step, the longest the step can retry (at most ten attempts, a delay of at most one day before each after the first, an attempt of at most fifteen minutes: nine days and two and a half hours) plus the ninety days the run record is kept, so that every attempt that can still find its run finds its key (D-6528, SCH-1524). The store reads the retention from the entry; a lookup ignores an entry past it and the next commit of the tenant removes it. A key used again for the same operation with other inputs is refused with the error kind idempotency-mismatch, which the store decides, without a second read by the caller. Rejected: one retention for every entry (a step that retries over days would apply twice; an operation would forget its run before the seven days); a table of retentions by kind in the store (the store would learn the kinds of the runtime)."},
    {"id":"d-7702","ref":"D-7702","title":"A schedule counts from its definition, skips what it missed and runs nothing while paused","group":"Automation","decided":"2026-11-20","statement":"**A schedule counts from its definition, skips what it missed and runs nothing while paused.** The recurrence of a schedule is the subset of SCH-1574 with the zone of SCH-1573, and the time zone rules are those of the IANA database bundled with the release (the jiff library with its bundled database, so that every platform reads one version, D-6567). A rule does not carry DTSTART: the schedule keeps the time it was defined, or its rule last changed, as its anchor, and the wall-clock time of the anchor to the minute stands in for any BYHOUR or BYMINUTE the rule leaves out; no occurrence precedes the anchor and COUNT counts from it. The jobs of a schedule are numbered, one key for each number, so that a repeat creates the same job and a job that replaces a cancelled one is a new one. When a job falls due the worker emits the event of the schedule (hop zero, D-6531), reports the next occurrence, which is the first after the later of the occurrence and the time the job ran, and the store creates the next job in the transaction that records the completion (SCH-003). A schedule that is paused when its job falls due completes the job without emitting the event and creates no job (SCH-005); resuming creates a job only when none is open. A changed rule cancels the open job and creates one for the new rule. Rejected: counting occurrences missed while the worker was stopped (a long stop would release a burst of runs); running a paused schedule's open job (pausing is the safe way to stop automation while looking at it)."},
    {"id":"d-7703","ref":"D-7703","title":"Ended work is purged by the janitor after a stated retention","group":"Automation","decided":"2026-11-20","statement":"**Ended work is purged by the janitor after a stated retention.** An ended job is kept thirty days after its outcome (rec-job); an ended run is kept ninety days after it ended, and its steps with it (rec-workflow-run, rec-workflow-step-run); a declined or held exception record is kept ninety days from the time it was written; a parked or dead-lettered record is never removed before the tenant owner has settled it (OPS-348), and then after the same ninety days. The backend janitor makes one call, which reads each tenant file once and removes what is past its retention in one transaction per file (PRV-357). Nothing that has not ended and nothing unsettled is removed. Rejected: a purge for each table (four passes over every file for one rule of age); a retention counted from the settlement of a record (a settlement time the record does not hold; the record's own time is used)."},
    {"id":"d-7704","ref":"D-7704","title":"A run key is claimed with its run, and a start waits for the earlier events of its key","group":"Automation","decided":"2026-11-20","statement":"**A run key is claimed with its run, and a start waits for the earlier events of its key.** The run key (D-6534) is held in a row of the tenant file written in the transaction that records the run, so a key has a run and a run has its key together; a repeat, found at the start of the job of the later event, starts no run and writes a declined record with the reason run-key-repeated (SCH-1536). Every event of every trigger has its own start job, with a run key or without. A start whose trigger has an earlier event with the same run key whose start job has not ended is deferred: its job returns to waiting, due in five seconds, and the deferral is not an attempt, so that waiting does not spend the attempts of a job (SCH-1534, D-6532). Removing an automation releases its run keys (D-6539). Rejected: one job for each run key (a repeat would create nothing and leave no declined record); counting a wait as a failed attempt (a run behind a retrying earlier event would be dead-lettered)."},
    {"id":"d-7705","ref":"D-7705","title":"The automation worker is hand-written; each of its machines is shipped or a target","group":"Automation","decided":"2026-11-20","statement":"**The automation worker is hand-written; each of its machines is shipped or a target.** The worker is Rust written by hand (crates/backend/src/worker, over the job, schedule, run key and record operations of the Store trait), not generated from its machines, so its status is manual. A machine it follows is shipped and names the contract that creates its record: schedule-flow-impl (the schedule rows of the store apply its five transitions, created by define-schedule) and job-lease-flow-impl (the lease, the fencing token and the refusal of a stale or late result, created by schedule-job; the one difference is that the lease is found expired by the next lease or report, not by a timer that raises lease-expired). A machine it does not follow stays a target, with the difference stated in its description: job-run-flow-impl (the due time and the retry delays are those of the policy of the job, D-6529, not a fixed ten, five and ten seconds), workflow-run-flow-impl (a step and its record are two transactions, the effect once by its key), workflow-compensation-flow-impl (compensation is not built), approval-flow-impl (the step kind request-approval is not built), inbound-run-flow-impl (no inbound event reaches the worker) and migration-batch-flow-impl (the worker runs no migration). The other implementation machines of the component stay targets until each is read against the worker. Rejected: running the machines through the runtime as the outbox does (the worker is a loop over a store and the machines describe records, not a process); marking all of them shipped (six describe what is not built)."},
    {"id":"d-7706","ref":"D-7706","title":"A tenant schedules a start-run, and the worker leases and reports in process","group":"Automation","decided":"2026-11-20","statement":"**A tenant schedules a start-run, and the worker leases and reports in process.** The one kind of job a tenant may schedule through schedule-job is start-run, with a payload naming one of its automations and the parameters of the run (D-6520: the kinds of a job are the worker's, not free text); its idempotency key makes the job, and the same key with other work is a conflict. lease-job and report-job-result are the worker's own calls on the store, in the process that holds the store: no route serves them and no service credential crosses a network, which their contracts say. list-jobs, cancel-job, retry-job, schedule-job and define-schedule are routes of the tenant owner, behind the capabilities jobs-read and jobs-manage, answering for the caller's tenant only. Rejected: a route for lease-job and report-job-result in this deployment (a worker that is not in the process would need a credential that nothing issues yet)."},
    {"id":"d-7680","ref":"D-7680","title":"An approval is a record on the step and its decision is the kernel's","group":"Automation","decided":"2026-11-20","statement":"**An approval is a record on the step and its decision is the kernel's.** A request-approval step records, in its step record, the roles its policy names, its deadline and the person who started the run, stops its run in awaiting-approval and creates one job due at the deadline. approve-workflow-step is decided by strata_kernel::approvals::decide: the approver is a signed-in person (never an automation principal), holds workflow-approve, holds a role the policy names (the owner holds every power), is not the person whose action started the run, and decides before the deadline. The decision completes the step with the typed result request-approval, binds param.<step>_approved and param.<step>_by, and creates the job of the approved or the refused step. Separation applies to every approval whose run has a known starter, which is the person of the event a trigger matched or the person who started the run directly. Rejected: a flag on the step to switch separation off (it would change a variant of the catalogue every step kind shares, and an approval that the starter can give is not an approval); approvals as records of a table of their own (the step record already holds them once and is written in the same transaction as the run)."},
    {"id":"d-7681","ref":"D-7681","title":"Activation is a definition made again with the state active","group":"Automation","decided":"2026-11-20","statement":"**Activation is a definition made again with the state active.** An automation has the optional state draft, active or suspended (automation-state). A definition without a state is active, so the definitions that existed before the state did and the ones a product installs run unchanged; a definition that names draft starts no run until activate-workflow defines it again with the state active, by the owner holding workflow-activate, with a projection summary in the request, under the checks of defining (WFL-1528, D-6538). A trigger on a draft declines with automation-inactive. Rejected: making every new definition a draft now (it would stop every automation a tenant has until it is activated); a separate activation table (the state would escape schema versioning, D-6520). The platform does not yet record the projections it runs, so activation checks that a summary accompanies the request and not that it is true; recording projections is the follow-up."},
    {"id":"d-7682","ref":"D-7682","title":"invoke-operation is a step kind that invokes a tenant operation as the automation principal","group":"Automation","decided":"2026-11-20","statement":"**invoke-operation is a step kind that invokes a tenant operation as the automation principal.** The catalogue gains invoke-operation with an operation and the expressions of its inputs, and its result lists the records the operation created, changed and deleted as param.<step>_created, _changed and _deleted. The automation is refused when the operation does not exist, when its invokers name neither a role of the run-as nor every signed-in person, or when an input is undeclared, missing when required or of another shape than its type. The step is decided by the kernel as automation:<workflow-id> with the step key as the idempotency key, so the operation can do what its own definition allows and nothing more. Rejected: invoking as the definer (the automation would hold more than its run-as, D-6525)."},
    {"id":"d-7683","ref":"D-7683","title":"Compensation is a chain of jobs and a failed run stays failed","group":"Automation","decided":"2026-11-20","statement":"**Compensation is a chain of jobs and a failed run stays failed.** A step that fails for good puts its run in compensating when a completed step declares a compensating step, and creates the job of the last such step; each job runs one compensating step as the automation principal under a key derived from the run, the compensating step and the position of the step it undoes, marks the undone step compensated and creates the job of the next earlier one. The run ends in the state failed, as the workflow-compensation-flow machine states, with the dead-lettered record of the failed step already written. A compensation that fails for good leaves the run compensating with a dead-lettered record naming its job, and releasing it through settle-automation-exception gives it one more attempt under the same key. Rejected: a run state compensated (the machine ends in failed, and the step records say what was undone); compensating in one job (a crash between two compensations would repeat the first)."},
    {"id":"d-7684","ref":"D-7684","title":"A person starts a run with inputs through jobs-run, and listing runs is list-automation-runs","group":"Automation","decided":"2026-11-20","statement":"**A person starts a run with inputs through jobs-run, and listing runs is list-automation-runs.** start-workflow-run takes a person holding jobs-run, an active automation, inputs that are names any event binds (D-6523, except seq, at and hop, which the platform binds) and an optional idempotency key; the start job is keyed by the person, the automation and the key, so a repeat names the same run and another set of inputs under the same key is a conflict. list-workflow-runs is not a contract of its own: list-automation-runs lists the runs of every automation, those started directly included."},
    {"id":"d-7640","ref":"D-7640","title":"The outbound gate follows at most three redirects, each judged again","group":"Automation","decided":"2026-11-20","statement":"**The outbound gate follows at most three redirects, each judged again.** A redirect of an outbound call is not followed by the HTTP client: the gate parses the new address, resolves it, judges every address it resolves to under the outbound rule and connects to the judged one, as for the first address, and refuses the call at a fourth redirect. A 303, and a 301 or 302 after a POST, are followed with a GET and no body; credential headers are dropped when a redirect leaves the host. The metadata, keys and token endpoint of an identity provider follow no redirect, because only the address the configuration names is reached (FED-261). The alternative is to follow no redirect at all, which breaks receivers that moved their address."},
    {"id":"d-7641","ref":"D-7641","title":"Webhook signatures are HMAC-SHA256 over the event identifier, the timestamp and the body","group":"Automation","decided":"2026-11-20","statement":"**Webhook signatures are HMAC-SHA256 over the event identifier, the timestamp and the body.** A delivery, outbound or inbound, carries Strata-Event-Id, Strata-Timestamp (whole seconds since 1970) and Strata-Signature (v1= and the lower-case hexadecimal HMAC-SHA256 of the event identifier, a full stop, the timestamp, a full stop and the raw body, keyed with the bytes of the secret text). The identifier is covered so that a captured delivery cannot be sent again under a new identifier past the deduplication. During the twenty-four hour overlap after a rotation an outbound delivery carries one v1 entry for each live secret. The secret text is whsec_ and 64 hexadecimal digits of 32 random bytes. The alternative is a signature over the body and timestamp only, which leaves the identifier free to change on a replay."},
    {"id":"d-7740","ref":"D-7740","title":"The export of a subject is a job whose one document is delivered to the person or an owner and expires","group":"Privacy","decided":"2026-11-20","statement":"**The export of a subject is a job whose one document is delivered to the person or an owner and expires.** The export (CT-210) enumerates through the same declarations the erasure does (strata_kernel::subject_export shares them with strata_kernel::erasure), so an export cannot lack a field an erasure clears. A request starts a chain of jobs, one per batch of at most 100 records, each keeping a part; the last assembles one deterministic JSON document of the format strata-subject-export/1 and removes the parts. The result is fetched by id (CT-1708) only by the person it concerns or by an owner, each after a step-up (the owner is the controller; the person is the data subject, and a stolen session cookie alone does not release their data). It expires seven days after the request. Each request and fetch is an audit entry naming the tenant and the export. The final assembly loads the tenant once to read the ledger and the settings of the person; that step is not bounded by the batch size (WG-5203). Alternative: deliver the document as a download link outside the session; rejected, because the link would be a second credential for personal data."},
    {"id":"d-7741","ref":"D-7741","title":"A restriction hides personal fields in views and keeps records from retention","group":"Privacy","decided":"2026-11-20","statement":"**A restriction hides personal fields in views and keeps records from retention.** PRV-352 says every read that names the personal fields of a restricted principal is refused. A view mixes records of many people, so refusing the read would refuse the view of everyone; the restriction instead removes the personal fields of the restricted principal from each record a view returns (Rights::hide), keeps the records of the principal from the retention sweep, leaves the erasure and the export unblocked (erasure is the stronger measure and the export is the right of access), names the restriction in the erasure receipt and ends with the erasure. The restriction is a document of the tenant, set and lifted by an owner with a step-up and recorded with its reason and time. Not enforced because the point takes no restriction yet: automations, segments, mail, exports to a third party, aggregates and named queries that read a personal field (WG-5200, WG-5201, WG-5202)."},
    {"id":"d-7742","ref":"D-7742","title":"A legal hold names a subject or a record type","group":"Privacy","decided":"2026-11-20","statement":"**A legal hold names a subject or a record type.** A hold on a subject refuses the erasure of that subject with conflict naming the hold, before any change. A hold on a record type reaches the kernel in the erase-subject intent (held-objects): the decision leaves each record of a held type unchanged and lists it as held, so the rest of the subject is erased and the receipt says which records were kept. Both keep records from the retention sweep. A hold is set, released and listed by an owner; set and release need a step-up. A released hold stays as the record of the hold. A hold on a single record is not built (WG-5205): the contract names a subject or a record type."},
    {"id":"d-7743","ref":"D-7743","title":"Retention is a chain of jobs that deletes as the system principal through the kernel","group":"Privacy","decided":"2026-11-20","statement":"**Retention is a chain of jobs that deletes as the system principal through the kernel.** Each tenant has a chain of jobs (JobWork::Retention) in its own job store: one batch of one record type per job, the next job created in the report of the one before it, the next sweep a day after the last type. The janitor starts a chain for a tenant that has none, so no schedule is needed. A type whose rule counts from a timestamp field walks that field index oldest first; a type counted from the creation or the last change is paged in record id order. The kernel deletes through the intent expire-records, decided only for Principal::System, which re-checks that each record is past its period and that nothing refers to it; the event of each deletion carries the record without its personal fields. Records under a legal hold or concerning a restricted person are not offered. The type without a retention rule is never swept; the tenant default of PRV-356 is not read by the sweep yet (WG-5204)."},
    {"id":"d-7744","ref":"D-7744","title":"A personal field names its subject by text, and the invitations addressed to an erased person are named by the shell","group":"Privacy","decided":"2026-11-20","statement":"**A personal field names its subject by text, and the invitations addressed to an erased person are named by the shell.** A field that declares another field as its data subject must point at a field that holds text or a list of text (a principal id); a reference to the record of a person is refused at declaration, because the platform keeps no mapping from a principal to such a record. The kernel holds no address of a person, so the backend finds the pending invitations addressed to the verified address of the erased person before it removes the account, and the erase-subject intent carries only their ids (addressed-invitations): the kernel revokes each and clears its address."},
    {"id":"d-7900","ref":"D-7900","title":"A template body is the blocks of the Markdown model, a token is an inline node that names it, and a value is an inline node that declares its type","statement":"**A template body is the blocks of the Markdown model, a token is an inline node that names it, and a value is an inline node that declares its type.** The body of a mail template or a notice template (structured-blocks) is JSON text holding a list of template-block. The blocks are those that constrained Markdown parses into (heading of level 2 to 4, paragraph, quote, list, code, figure, rule; inlines text, em, strong, code and link), so a body written as Markdown and parsed is a body, and the bounds are the parser's: quotes nest at most 8 deep and inline elements at most 8, and a body holds at most 5000 nodes. A link carries a web or mail address, a path of the site or a fragment, and no space or control character (CMS-250). Two inline nodes belong to templates: token, {\"type\":\"token\",\"name\":\"<token>\"}, which names a content token the tenant defines and is replaced when the template is rendered by a text node holding the value of the token for the reader (CTK-015); and value, {\"type\":\"value\",\"name\":\"<value>\",\"value_type\":\"str\"|\"int\"|\"bool\"|\"time\"}, which names a value the sender of the message supplies and declares its type where it is placed, so that a template needs no list of its values apart from its body, and a name is placed with one type only. A node with a member its type does not name is refused, so a body means one thing. A template that places a token the tenant does not define is refused at definition, and a token that a template places is not removed (CTK-004, CTK-005). A token expression is in the tenant rule language, which reads record fields and event parameters and names no token, so no token refers to itself or to a cycle of tokens (CTK-003). Rendering is one pure function of the body, the values and the text of each token for the reader: the blocks with each token and value replaced by a text node, and the same blocks as plain text. Alternative: a list of values declared beside the body in the template; rejected because it adds a field to the template declaration that every bundle and every caller then carries, and the placement already names and types each value. Alternative: a new block format for templates; rejected because the Markdown parser, the browser and the delivery response already hold the model.","group":"Content","decided":"2026-11-20"},
    {"id":"d-7901","ref":"D-7901","title":"A setting names a declared type of kind enum, id or scalar from the platform's table, and holds no float","statement":"**A setting names a declared type of kind enum, id or scalar from the platform's table, and holds no float.** The type of a setting is bool, i64, string or timestamp, or the id of a declared type that the kernel's table holds (D-5046). The kernel has no registry of the specification's types at run time, and neither a tenant nor a product declares a type (a bundle has no section for one), so the table is the platform's own declared types that a setting can sensibly hold: the enumerations notification-mode, digest-period, ledger-period, send-channel, notification-channel, message-category-purpose, aggregate-kind, ledger-order, registration-mode, object-action and personal-kind; the identifiers role-id, object-type-id, capability-name, team-id, ledger-unit, ledger-pool-name, principal-id, product-id, setting-id, template-id, workflow-id and message-category-id; and the scalars display-name, domain, email-address and url. A value of such a type is text that decodes as the type: for an enum one of its values, for an id or a scalar a text within the pattern and the length its type states. Whether the role, object type or team an id names exists is not checked: removing it later would leave a stored value that is not of its type, and a stored value is of the type of its setting for as long as the override exists (SET-004). The name of a type has the characters of an id of a ledger unit, so a setting type may contain a hyphen. A float is not held: the value algebra (value) is compared, ordered and hashed, and the canonical hash of every tenant state is computed from it, and a float has no equality that a hash can follow (not-a-number differs from itself, minus zero equals zero and has other bits). A float would be a new variant of value, which changes every match on it, the hash of every state and the encoding in the browser. A setting of f64 stays refused, with that reason in the refusal. Rejected: a decimal held in an integer, which is a different type under the name of a float.","group":"Tenancy","decided":"2026-11-20"},
    {"id":"d-7902","ref":"D-7902","title":"A change from outside a product to an entity it owns is refused, and only a change that carries the record of the product comes through it","statement":"**A change from outside a product to an entity it owns is refused, and only a change that carries the record of the product comes through it.** A schema change that defines, redefines or removes an entity that installed-product.owns names, or alters it (a field, a constraint, a unique constraint, the retention, publication or language declaration of an object type are alterations of the object type), is refused when it does not carry, in the same change, the record-product of that product at a version other than the installed one (an upgrade) or its remove-product (a removal). The refusal names the entity and the product. A tenant therefore does not add a field to a record type of a product: D-6582 gives a product its entities whole, and a product that wants an extension point declares one. A change that carries a product record needs the capability bundle-install, which the owner holds and a principal that only manages the schema does not, so a schema editor cannot make its change look like an upgrade. An entity the change creates is not yet owned, so an install is not refused by it. A record of a product at the version already installed is refused, because it is no upgrade (D-6583).","group":"Platform","decided":"2026-11-20"},
    {"id":"d-7903","ref":"D-7903","title":"A ledger posting is an event that a trigger on the ledger subscribes to, and it binds its entry and the balance on both sides","statement":"**A ledger posting is an event that a trigger on the ledger subscribes to, and it binds its entry and the balance on both sides.** A trigger whose event is ledger-posted for a unit starts its automation for each entry posted to an account of that unit, and binds the parameters D-6523 lists: owner (the principal, or null for a pool), unit, amount, balance, balance_before, entry_sequence and reason. A posting reads no record, so the record scopes of the event are empty and a condition reads parameters only.","group":"Automation","decided":"2026-11-20"},
    {"id":"d-7940","ref":"D-7940","title":"An Impact Lab change is applied against the revision of its projection","group":"Agents","decided":"2026-11-20","statement":"**An Impact Lab change is applied against the revision of its projection.** The apply of a change a projection showed (the contract apply-lab-change) names the revision the projection was taken at, from the run or from the caller, and commits the change of the schema only while the tenant is still at that revision. The expected-version of a change of the schema compares the schema version, which a record edit leaves alone, so it does not prove that the tenant is the one the projection was shown; the commit itself is held to the revision (execute_at in the store contract), and a tenant at another revision is a conflict that names the revision it is at, with nothing committed. A lost race at the commit is not decided again on the newer state, as an ordinary commit is: the person was shown another state than the one the change would meet. Only an owner applies, with a fresh authentication (D-6201), and the apply is an audit entry of the tenant. Alternative: apply with the schema version only; rejected because a projection of a tenant that has since gained or lost records would be applied as if it still held."},
    {"id":"d-7720","ref":"D-7720","title":"Personal fields are sealed at the store boundary, and the kernel decides over plain values","group":"Privacy","decided":"2026-11-20","statement":"**Personal fields are sealed at the store boundary, and the kernel decides over plain values.** Every store the backend uses is wrapped in the sealed store (strata_storage_api::sealed::SealedStore). On every durable write it replaces the value of each field that declares personal data by a token, the value sealed under the key of its data subject: in the records of the delta, in the record images of the events and the outbox, and in the field values of create-record and update-record intents in the journal; a snapshot copies the stored rows, so it holds the tokens too. On every read it opens them. The kernel sees plain values only, so its rules, unique checks, searches, segments and read expressions are unchanged, and the Lean model, the generated-function comparison and the system differential stay over plain values. A field whose subject the store cannot resolve (no creator, or a subject field that refers to the record of a person) is stored plain. A field whose subject field names several principals is sealed under each of their keys in turn, so that destroying any one of them makes it unreadable. A tenant whose schema declares no personal field is written exactly as before. Alternative: seal in the shell before the kernel, so that the kernel only ever sees sealed values of personal fields; rejected because rules, unique checks, search, segments and read expressions over a personal field could then not read it, and D-6585 keeps a searchable personal field matchable."},
    {"id":"d-7721","ref":"D-7721","title":"The journal and event hashes cover the sealed form, and a replay seals again","group":"Privacy","decided":"2026-11-20","statement":"**The journal and event hashes cover the sealed form, and a replay seals again.** Sealing is deterministic: AES-256-GCM under a key derived from the subject key, with the nonce derived by HMAC-SHA-256 under a second derived key from the binding and the plain value, so equal values of one subject and field seal to the same token. The delta hash and the events hash of a journal entry are computed over the sealed delta and events (D-350); the hash a snapshot records is over its stored, sealed state; the audit chain is over the sealed lines (D-7725). A replay of the journal (the Impact Lab, replay_journal_with) decides each entry again over plain values, seals the result with the live keys without creating any, and accepts an entry whose plain or sealed hashes are the recorded ones, so entries written before sealing verify as before. After an erasure an entry keeps the erased values as tokens; the kernel decides over the token, and where it only copies the value the replay reproduces the sealed hash exactly. Where it cannot (a type other than text, a rule over the value), the entry is reported as redacted with its revision, never as a mismatch (PRV-361), and the Impact Lab refuses a projection from before a redacted revision. What a hash covers changes in three places only: the journal delta and events hashes (the sealed form, for a tenant whose schema declares a personal field), the snapshot hash (the stored form) and the audit chain (new, over the sealed form). The idempotency request hash stays over the plain intent and is kept 24 hours. The kernel state hash and the Lean correspondence are unchanged. Alternative: keep the hashes over the plain delta and events; rejected because every replay would fail after an erasure, and the hash would be a fingerprint against which a guess of an erased value can be checked."},
    {"id":"d-7722","ref":"D-7722","title":"Subject keys are kept in the tenant database under a tenant key that the key service wraps","group":"Privacy","decided":"2026-11-20","statement":"**Subject keys are kept in the tenant database under a tenant key that the key service wraps.** The key service (component key-service) holds the process key and only wraps and unwraps tenant keys. It is a trait, KeyService, with one in-process implementation that wraps under the platform sealing key (FactorPolicy::seal_key, with the previous keys of a rotation); the external key service replaces it. Each tenant has one tenant key, made at its first sealing and kept wrapped in the tenant database (identity document tenant-key); the blind hashes of searchable fields are keyed by a key derived from it. Each data subject of a tenant has one subject key, made when the first value is sealed for it and kept wrapped under the tenant key (identity documents subject-key, by key id, and subject-key-of, from the principal to its live key id). The binding of a sealed value names the tenant, the key id, the object type and the field (or the audit scope and the member) and its blind hashes, so a value moved to another tenant or another field does not open. The erasure of a subject destroys every live key of the subject after its records are cleared: the document keeps the key id, the state destroyed and the time, and loses the wrapped key and the principal (rec-subject-key), and the destruction is an audit line that names the tenant and the key ids and holds no key material (PRV-362). A value written later for the same principal gets a new key. Alternative: keep subject keys in the key service only; not possible while it is not built, and D-7727 states what the copy in the tenant database means for backups."},
    {"id":"d-7723","ref":"D-7723","title":"The record index holds blind hashes of searchable personal fields and nothing of the others","group":"Privacy","decided":"2026-11-20","statement":"**The record index holds blind hashes of searchable personal fields and nothing of the others.** The token of a searchable personal field carries the blind hashes of its plain value (of each item of a list): a keyed HMAC under a key derived from the tenant key. The record index holds a row for each blind hash, without an order key, so that no index page answers it, and no row for a personal field that is not searchable (PRV-1588). The sealed store translates the lookups of the kernel: a by-field or by-fields lookup of a searchable personal field asks the index for the blind hash and for the plain value (rows written before sealing); a lookup of a personal field that is not searchable, a lookup of null or of a list, and an index page over a personal field read the records of the type; the answer is cut to exactly the records the kernel asked for, judged on the opened values. A unique constraint on a searchable personal field is therefore checked through the blind hash, and on one that is not searchable by reading the type. The erasure rewrites the records it clears, which removes their rows in the same commit. Whoever holds the tenant key can tell from the index which records hold equal values of a searchable field; a record the erasure holds (a required reference) keeps its row until it is rewritten. Alternative: index the token; rejected because tokens differ per subject and could not answer a lookup across records."},
    {"id":"d-7724","ref":"D-7724","title":"Values written before sealing are not re-sealed in place","group":"Privacy","decided":"2026-11-20","statement":"**Values written before sealing are not re-sealed in place.** A stored value is sealed when its record is next written. The events, journal entries and snapshots written before a tenant was first sealed, or before a field was declared personal, keep the plain values they were written with; the live records are reached anyway, because the erasure clears the personal fields in them. The receipt states when sealing began for the tenant (the time its tenant key was made) and that the copies written before then are not reached by the key destruction. Alternative: a migration that re-seals every stored copy on upgrade; rejected because it rewrites the journal and the event stream, changes every recorded hash, which D-350 exists to avoid, and needs every subject key of a tenant at once."},
    {"id":"d-7725","ref":"D-7725","title":"Audit lines that name a person are sealed under that person's key and chained in their sealed form","group":"Privacy","decided":"2026-11-20","statement":"**Audit lines that name a person are sealed under that person's key and chained in their sealed form.** Before a line is appended to the audit trail of a tenant, each member that names a person (principal, actor, subject, by, owner) is sealed under the key of the principal it names, and each member that holds the data of a person (login, email, address, display_name, userName, previous, value) under the key of the first principal named. Each line is stored with a chain value, the hash of the chain value of the line before it and of the line as stored, so the chain covers the sealed form (PRV-360): destroying a key changes no stored byte and the chain verifies after an erasure (PRV-359). The check (App::verify_audit_chain) finds an altered line and a line removed from the middle; finding the removal of the newest lines needs the head anchored in the platform audit store (D-6208), which is not built. A line that names no principal is stored as it was written. Lines written before the chain existed have no chain value and are counted as before it. Alternative: leave the names out of the trail; rejected because the trail must name who acted while that person is not erased (OPS-329)."},
    {"id":"d-7726","ref":"D-7726","title":"The schema history keeps no teams and no invitations","group":"Privacy","decided":"2026-11-20","statement":"**The schema history keeps no teams and no invitations.** The history of a tenant schema keeps each version without its teams and invitations, which name people (the members of a team, the address of an invitation, who issued and who redeemed it) and change without a new version; nothing reads them from the history. The current schema keeps them, and the erasure removes the person there. A tenant migration removes them from the rows written before. Alternative: seal team members and invitation addresses in the history under subject keys; rejected because nothing needs them there, and the address of an invitation that nobody has redeemed has no subject whose key could seal it."},
    {"id":"d-7727","ref":"D-7727","title":"Backups, exports and restores do not undo a key destruction","group":"Privacy","decided":"2026-11-20","statement":"**Backups, exports and restores do not undo a key destruction.** A snapshot holds the stored rows, so its personal fields are sealed, and the subject keys are not part of it, so a snapshot restored after an erasure reads the person's fields as erased. A backup image of the tenant file holds the wrapped subject keys as they were when the image was taken: an image older than a destruction opens the person's sealed fields until it is removed at the end of its retention (D-351), and the receipt says so. A restore of a snapshot or an image, and an import of an export, re-apply before the tenant serves a request every subject key destruction the audit log records after the restore point (D-6206), and run again every erasure whose receipt is newer than that point, because the members, teams and invitations the copy held come back with it. An export (copy-tenant-export) holds the personal fields in their sealed form and the subject keys only as the key service wrapped them, never in clear and never a destroyed one, so an archive outside the platform opens nothing without the key service. Alternative: open every field into the export; not taken because an imported copy would bring back the values of an erased person; whether the owner's portable copy should carry plain values is left to the owner."},
    {"id":"d-7728","ref":"D-7728","title":"The erased form of a sealed value is its token","group":"Privacy","decided":"2026-11-20","statement":"**The erased form of a sealed value is its token.** A value whose key was destroyed, or that does not open for the tenant and the field it is read as, is returned as its token: a text value that begins with sealed:v1:, holds no plain value and names the key it was sealed under. A read, a query, an event delivery or a replay that meets it goes on, and a reader shows it as erased. The kernel meets a token only in a copy written before an erasure (an event, a journal entry, a snapshot) or in a field the erasure could not clear. Alternative: an error, or null; rejected because an error would stop a whole query or replay, and null cannot be told from a field that was never set."},
    {"id":"d-8020","ref":"D-8020","title":"A product keeps balances in the ledger and configuration in declared settings, and specc refuses one that does not","group":"Platform","decided":"2026-11-20","statement":"**A product keeps balances in the ledger and configuration in declared settings.** specc refuses a product file with layer.balance-outside-ledger when a step of an operation or automation, or a transition of a workflow, writes a field of a record from that field's own current value (points = record.points + 1): that is a mutable balance outside the ledger, with no journal, no idempotency key and no limit that holds under concurrent writes (LDG-001). A balance is a ledger unit that PostLedger steps change. specc refuses a product file with layer.configuration-outside-setting when an object type holds configuration as records, either because a word of its local name is config, configuration, setting, preference, flag, option or parameter, or because it has a key field and a value field. Configuration is a setting-def with a type, a default and the levels that may override it (SET-001). Each rule has a negative fixture under crates/spec-compiler/tests/fixtures/products/refused. Exegra does not yet have either rule, so the two fixtures are checked by specc only."},
    {"id":"d-8040","ref":"D-8040","title":"Contracts whose authorisation prose is ambiguous are listed for review","group":"Security","decided":"2026-11-20","statement":"**The contracts whose authorisation prose the structured authorisation does not settle are listed for review.** The script `scripts/list-ambiguous-auth.mjs` reads every contract and lists the ones where the sentence in `auth.description` and the structured `auth` and `exposure` beside it disagree or leave a caller open: the prose offers more than one kind of caller, says anyone may call under a scheme that is not anonymous, names a signed-in caller under the anonymous scheme, names the owner without the role in `roles`, says policies decide without `tenantPolicies`, names no capability or role for a caller that is not anonymous or in-process, or gives a public browser contract that changes state without a request token and origin check or an anonymous one without a justification. The structured `auth` is what the generated code enforces; the prose is read by people. A contract on this list is reviewed by a person, who either rewrites the prose to match the structure or changes the structure, and the list is run again. On 23 of 426 contracts the list is: change-subscription-by-link (CT-827): the prose says anyone may call and the scheme is signed-address; complete-oidc-sign-in (CT-068): the prose says anyone may call and the scheme is signature; consume-saml-assertion (CT-070): the prose says anyone may call and the scheme is signature; declare-change-freeze (CT-161): the prose names the owner and roles does not; declare-ledger-pool (CT-285): the prose names the owner and roles does not; declare-ledger-unit (CT-284): the prose names the owner and roles does not; export-subject-data (CT-210): the prose names the owner and roles does not; fetch-subject-export (CT-1708): the prose names the owner and roles does not; get-conversation (CT-196): the prose offers more than one kind of caller; introspect-token-over-http (CT-1027): the prose offers more than one kind of caller; issue-passkey-challenge (H-031): the prose offers more than one kind of caller, the scheme is anonymous and the prose names a signed-in caller; list-identity-clients (CT-1026): the prose names the owner and roles does not; mutate-record (CT-263): the prose offers more than one kind of caller; provision-tenant (CT-033): the prose offers more than one kind of caller; read-view (CT-264): the prose says policies decide and tenantPolicies is not set; remove-ledger-definition (CT-811): the prose names the owner and roles does not; revoke-grant (CT-078): the prose names the owner and roles does not; set-ledger-limit (CT-286): the prose names the owner and roles does not; show-preview (CT-097): the prose offers more than one kind of caller; start-saml-sign-in (H-051): the scheme is anonymous and the prose names a signed-in caller; start-upload (CT-838): the prose offers more than one kind of caller; subscribe-events (CT-098): the prose offers more than one kind of caller; upload-file (CT-203): the prose offers more than one kind of caller."},
    {"id":"d-8060","ref":"D-8060","title":"Plans bound the records a tenant stores as well as its bytes","group":"Tenancy","decided":"2026-11-20","statement":"**Plans bound the records a tenant stores as well as its bytes.** Standard holds 1,000,000 records, Business 10,000,000, and Enterprise is set by contract. Like the other numbers of D-508 they are starting values held as data: an operator's value for a tenant replaces the plan's, takes effect on the next request and is an audited operation. The quotas of contracts with a limit and a window (the per-source and per-principal entries of the quota table) are written in the specification and change by regeneration, not by data; the allowances of a plan are data."},
    {"id":"d-8100","ref":"D-8100","title":"A digest is made by a chain of hourly jobs and from templates named for the category and the channel","group":"Automation","decided":"2026-11-20","statement":"**A digest is made by a chain of hourly jobs and from templates named for the category and the channel.** A tenant that has a person whose mode is digest has one job of kind digest at a time; each run makes the digests whose period has ended and creates the next job an hour on, and the chain ends when no preference of mode digest remains. The digest of a category on the inbox channel is made from the notice template digest_ followed by the category, and on the mail channel from the mail template digest_mail_ followed by the category, each with the hyphens of the category written as underscores and each placing the values items and count; without the notice template the inbox digest is built in, and without the mail template no mail digest is made. The alternative is a schedule for each person, which makes the number of schedules grow with the number of people."},
    {"id":"d-8200","ref":"D-8200","title":"A mail or a notice step names one target, and a digest is a step","group":"Automation","decided":"2026-11-20","statement":"**A mail or a notice step names one target, and a digest is a step.** The step send-mail names exactly one of to, address and segment: to is an expression that gives a principal id (or an address, when the value holds an @, as before), address an expression that gives an address and segment a segment. The step create-notice names exactly one of to and segment, because an address has no inbox. A segment target is cut into batches of at most one hundred persons as a send to a segment is (EML-1561), keyed by the step key, and the step's output is the send. The step send-digest has the fields of send-digest-step (NTF-1572): one message for each person who holds notices of its category created in its window, listing them, keyed by the step key and the person, with none for a person who holds none; its recipient is a principal or a segment, and without one it is every member of the tenant. Rejected: changing to to a union of the three targets, which would change every product file that already writes to as an expression; and a separate step kind for each target, which multiplies the catalogue for one choice of recipient."},
    {"id":"d-8201","ref":"D-8201","title":"A trigger selects a declared event kind with the trigger event declared-event","group":"Automation","decided":"2026-11-20","statement":"**A trigger selects a declared event kind with the trigger event declared-event.** A trigger names the kind it subscribes to, an event kind a tenant declares (SCH-1576), and the event binds param.kind beside seq, at and hop. The kernel matches a trigger on a declared kind to no domain event until an event of that kind is recorded by emit-event, so the variant is in the catalogue before the event is produced. Rejected: a trigger event for each declared kind, which is a variant of the catalogue the tenant would have to extend; and matching the kind as free text in inbound-webhook, which is a webhook of another system and not an event of the tenant."},
    {"id":"d-8202","ref":"D-8202","title":"A product declares event kinds in the section eventKinds, and a bundle carries them in event-kinds","group":"Platform","decided":"2026-11-20","statement":"**A product declares event kinds in the section eventKinds, and a bundle carries them in event-kinds.** The section eventKinds of a product file is a list of values of event-kind-decl, the seventeenth typed section beside those of D-6700: kind, the payload fields and the roles that may read it. The id of an item is only the name the product gives the declaration, in its namespace; the kind itself begins with app. (SCH-1576), which the namespace separator of D-6582 cannot express, so the kind is checked by its own rule, layer.event-kind-invalid, and not by the reference check. specc writes the section as the bundle section event-kinds, a list ordered by the id of the item without the id. The bundle reader reads and checks the section; the kernel does not hold a tenant's declared kinds yet, so a bundle that fills it is refused at install with the section named, as a section the release does not take is. Exegra applies the same table (layer-values.js) and needs the same entry."},
    {"id":"d-8120","ref":"D-8120","title":"The change audit is written by the shell after the commit, with values read before and after","group":"Data safety","decided":"2026-11-20","statement":"**The change audit is written by the shell after the commit, with values read before and after.** Every change of a role, a team, an invitation, a setting or the schema is committed through one function of the backend (ops::run_intent_at). It reads the tenant header before the commit and after it and appends one audit line holding the previous and the new value of what the intent changes, the acting principal, the revision and the correlation identifier of the request. A line about a person (the roles of a person, a person-level setting) names the person as principal and holds the values as previous and value, which the sealed store seals under the person's key; every other line holds them as before and after in plain, because configuration is not personal data. A refused or replayed intent leaves no line, and the installation of a tenant leaves none (ops::run_intent_unaudited). The line is written after the commit, so a crash between the two loses the line and not the change, and the event and the journal line of the commit still carry the change. Alternative: write the line in the same commit as the change; not taken because the audit trail has its own chain and a transaction across both would reach into every store adapter."},
    {"id":"d-8140","ref":"D-8140","title":"Which contracts are facades, which stay with the gateway, and which take no idempotency key","group":"Platform","decided":"2026-11-20","statement":"**Which contracts are facades, which stay with the gateway, and which take no idempotency key.** deliver-view (CT-093) becomes a facade onto the generic view contract read-view (CT-264), at GET /api/view, with the other page reads (CT-239..CT-253); its target change was to stop being a gateway operation of its own, since the backend view operation already serves the route. sign-in-at-site, sign-out-of-site and read-session-view (CT-254..CT-256) stay gateway contracts, because the gateway holds the session cookie and the request token and no other served contract states their routes for a facade to be lowered onto. Of the BFF contracts that were idempotent false with no idempotency-key input, run-lab-projection takes the key and the backend honours it for 24 hours (the starts are held in the backend process, like the runs). Seven are idempotent true for the reason stated in their postconditions: a repeat changes nothing the first call did not already make, or is refused and changes nothing, or replaces what the first call made so that one of it exists; the two whose answer holds a secret or codes shown once are never answered from a stored copy, so a key would have nothing to replay."}
  ],
  "constraints": [
    {"id":"k-1","statement":"The kernel performs no input or output and reads no clock and no source of randomness.","group":"Kernel","ref":"K-1"},
    {"id":"k-2","statement":"Tenant content is stored only in that tenant's database and file namespace. The control database holds no tenant content.","group":"Tenancy","ref":"K-2"},
    {"id":"k-3","statement":"A component reaches a tenant database only through the store contract (B-2).","group":"Tenancy","ref":"K-3"},
    {"id":"k-4","statement":"Passwords, session secrets, tokens and one-time codes are handled only by the identity service and appear in no log.","group":"Identity","ref":"K-4"},
    {"id":"k-5","statement":"A network-facing component keeps no state between requests that another instance could not serve from.","group":"Platform","ref":"K-5"},
    {"id":"k-6","statement":"A browser reaches only the gateway and the content delivery network, and calls between components carry a credential issued to the calling component.","group":"Platform","ref":"K-6"},
    {"id":"k-7","statement":"No shared copy holds personal data or anything that depends on who is asking.","group":"Delivery","ref":"K-7"},
    {"id":"k-8","statement":"Every stored copy has a stated owner, key, freshness bound and erasure point.","group":"Delivery","ref":"K-8"},
    {"id":"k-9","statement":"Every external effect is described as data by the kernel and carried out by an adapter after the transaction that produced it commits.","group":"Kernel","ref":"K-9"},
    {"id":"k-10","statement":"Every infrastructure dependency has an adapter that runs in a container without a cloud account.","group":"Platform","ref":"K-10"},
    {"id":"k-11","statement":"Time and randomness enter decisions as explicit inputs, so every decision can be simulated and replayed.","group":"Kernel","ref":"K-11"},
    {"id":"k-12","statement":"Tenant-authored content cannot inject script, markup or style into a page.","group":"Content","ref":"K-12"},
    {"id":"k-13","statement":"An agent is authorised by the same policies as a person, through the same kernel decision.","group":"Agents","ref":"K-13"},
    {"id":"k-14","statement":"Where a standard protocol exists the platform uses it: OAuth 2.1 and OpenID Connect, SAML 2.0, SCIM 2.0, WebAuthn, the OpenTelemetry protocol, the Model Context Protocol.","group":"Platform","ref":"K-14"},
    {"id":"k-15","statement":"No requirement counts as met without a recorded passing proof.","group":"Assurance","ref":"K-15"},
    {"id":"k-16","statement":"A session secret is an opaque random value, held by the browser in an HttpOnly cookie and by the platform only as a hash.","group":"Identity","ref":"K-16"},
    {"id":"k-100","statement":"A decision loads only the records that its plan names.","group":"Kernel","ref":"K-100"},
    {"id":"k-200","statement":"Tenant content leaves the platform only in a model request that the tenant policy permits, to the model provider the platform offers, and only where the tenant's subprocessor list names that provider.","group":"Platform","ref":"K-200"},
    {"id":"k-250","statement":"Credentials, session secrets, tokens and one-time codes appear in no address, referrer or query string, except that an emailed sign-in link carries its single-use token in the fragment of its address (D-703).","group":"Identity","ref":"K-250"},
    {"id":"k-251","statement":"Tenant files and tenant templates are data, and no platform process runs them.","group":"Content","ref":"K-251"},
    {"id":"k-252","statement":"Every outbound connection of the platform to an address that a tenant names leaves through one gate that applies the outbound rule (D-702).","group":"Platform","ref":"K-252"},
    {"id":"k-300","statement":"Overload is refused at the boundary where it arrives, before the work is queued for a shared resource.","group":"Platform","ref":"K-300"},
    {"id":"k-301","statement":"Two versions of a component run together during every rollout.","group":"Change","ref":"K-301"},
    {"id":"k-302","statement":"An irreversible operation names the object it destroys in its request.","group":"Data safety","ref":"K-302"},
    {"id":"k-350","statement":"Personal data is held only in a record or a copy that declares its owner, its personal fields, its retention and its erasure point.","group":"Privacy","ref":"K-350"},
    {"id":"k-351","statement":"Personal data reaches a log, a metric, a trace, a backup, an export, a mail or a file only through a declared record or copy.","group":"Privacy","ref":"K-351"},
    {"id":"k-352","statement":"A personal field is sealed under the key of its subject, and that key is destroyed when the subject is erased.","group":"Privacy","ref":"K-352"},
    {"id":"k-400","statement":"Data that the platform returns to an agent is marked with the origin and the trust level of each text it contains.","group":"Agents","ref":"K-400"},
    {"id":"k-401","statement":"A platform-operating agent holds no grant that reads tenant content.","group":"Agents","ref":"K-401"},
    {"id":"k-402","statement":"The record of agent activity is written by the platform, and an agent cannot alter the entries that describe its own activity.","group":"Agents","ref":"K-402"},
    {"id":"k-450","statement":"A token value enters a page or a message in the form of its output context, as text.","group":"Content","ref":"K-450"},
    {"id":"k-451","statement":"The mail dispatcher is the one component that talks to a mail provider.","group":"Platform","ref":"K-451"},
    {"id":"k-550","statement":"A change to a stored layout or a stored format SHALL reach production in a release of its own, separate from any colour switch.","group":"Platform","ref":"K-550"},
    {"id":"k-551","statement":"The kernel decides each step of a migration run, and each step commits together with the cursor that records it.","group":"Tenancy","ref":"K-551"},
    {"id":"k-17","statement":"A lease on work carries a fencing token that the tenant database checks when the work is recorded.","group":"Automation","ref":"K-17"}
  ],
  "openQuestions": [
  ],

  // ---- Roadmap -----------------------------------------------------------------------------------
  "releaseStages": [
    {"id":"r0","name":"Foundation","purpose":"The specification gates the code, and a tenant is a database behind clean seams, running locally in containers","milestones":"1, 2","exitEvidence":"Every goal tagged R0 verified. Both tools pass on every commit of the main line.","ref":"R0"},
    {"id":"r1","name":"Identity","purpose":"The identity service carries every sign-in method, sessions, tokens and audit","milestones":"3, 4","exitEvidence":"Every goal tagged R1 verified, with the behaviour models of sign-in checked in Exegra and a security review of the federation endpoints.","ref":"R1"},
    {"id":"r2","name":"Automation and delivery","purpose":"Tenants schedule work, are notified and approve content, and a first site is authored, reviewed and served from stored copies and the edge","milestones":"5, 6","exitEvidence":"Every goal tagged R2 verified, with the freshness and start budgets measured on the local stack, and a first site taken through authoring, review, preview and delivery there.","ref":"R2"},
    {"id":"r3","name":"Agent operation","purpose":"Agents observe, explain, propose and apply changes under policy, with a tamper-evident record","milestones":"7, 8, 9","exitEvidence":"Every goal tagged R3 verified, including an agent carrying out a schema change through a proposal end to end.","ref":"R3"},
    {"id":"r4","name":"Enterprise readiness","purpose":"The content features are complete and the platform is deployed and recovered in the cloud","milestones":"10, 11, 12","exitEvidence":"Every goal tagged R4 verified, with a zone-loss drill and a tenant point-in-time restore measured against their objectives.","ref":"R4"}
  ],
  "milestones": [
    {"id":"rm-1","name":"Gate","number":1,"proves":"the specification and the two tools hold the code that already exists to account.","stage":"R0","stageRef":"r0","detail":"**Proves:** the specification and the two tools hold the code that already exists to account.\n\nThe requirements of the prototype's kernel, store, runtime, gateway and simulator are written, each tied to an existing test, and Concordance reports them verified from a recorded run. Exegra validates the specification and its structural, data and behaviour claims.","ref":"RM-1"},
    {"id":"rm-2","name":"Tenant databases and seams","number":2,"proves":"a tenant is a PostgreSQL database behind the store contract, found through a directory, in a local container stack.","stage":"R0","stageRef":"r0","detail":"**Proves:** a tenant is a PostgreSQL database behind the store contract, found through a directory, in a local container stack.\n\nThe PostgreSQL adapter passes the conformance suite. The control plane provisions, suspends, exports and deletes tenants. Every other seam (files, copies, wake, keys, mail, limits, backup) has its trait, suite and local adapter. Each tenant database is backed up to the backup archive, and each tenant has a data key held by the key service. Component-to-component credentials replace the shared service token. Tenants have a kind (production, staging or sandbox), and a tenant can be archived, exported and deleted after a grace period.","ref":"RM-2"},
    {"id":"rm-3","name":"Identity core","number":3,"proves":"sign-in, sessions and their revocation live in one service with an audit record.","stage":"R1","stageRef":"r1","detail":"**Proves:** sign-in, sessions and their revocation live in one service with an audit record.\n\nRealms per tenant, passwords, passkeys, emailed links, second factors, step-up, recovery, session listing and revocation. Sign-in code is removed from the runtime. Roles and teams, invitations and sandbox tenants started from a template.","ref":"RM-3"},
    {"id":"rm-4","name":"Federation and tokens","number":4,"proves":"organisations bring their identity providers, and services and agents get identities.","stage":"R1","stageRef":"r1","detail":"**Proves:** organisations bring their identity providers, and services and agents get identities.\n\nOpenID Connect and SAML sign-in, SCIM provisioning, domains bound to a provider, service accounts, delegated tokens for agents, key rotation. Support grants that a tenant owner issues to platform operators, with every act recorded.","ref":"RM-4"},
    {"id":"rm-5","name":"Scheduling and workflows","number":5,"proves":"tenants schedule work that survives failure and applies effects once.","stage":"R2","stageRef":"r2","detail":"**Proves:** tenants schedule work that survives failure and applies effects once.\n\nJobs, schedules, triggers, leases with fencing, retries, the wake index, workflows as metadata, the connector runner, scheduled publication. Notices and the inbox, inbound and outbound webhooks, bulk jobs, and the trigger and action catalogue.","ref":"RM-5"},
    {"id":"rm-6","name":"Copies, the edge and the first site","number":6,"proves":"published content is served from stored copies with bounded staleness and no leakage.","stage":"R2","stageRef":"r2","detail":"**Proves:** published content is served from stored copies with bounded staleness and no leakage.\n\nVersion-keyed view copies, audience classes, tags and removal, the content delivery network contract, purge from the outbox, custom domains and certificates. Authoring of records of tenant-defined content types, named content tokens, review by named approvers, preview links, redirects, sitemaps and feeds, the delivery interface with field selection, paging and filtering, delivery keys, plan quotas and metering with the billing export.","ref":"RM-6"},
    {"id":"rm-7","name":"Agent plane","number":7,"proves":"agents operate the platform through the catalogue, under policy, on the record.","stage":"R3","stageRef":"r3","detail":"**Proves:** agents operate the platform through the catalogue, under policy, on the record.\n\nThe operation catalogue, queries and operations over the platform, dry runs, proposals with projections and approvals, the Model Context Protocol server and self-description. Promotion of configuration from a staging tenant through a proposal, and installation of platform templates after a projection.","ref":"RM-7"},
    {"id":"rm-8","name":"Agent safety, telemetry and audit","number":8,"proves":"agents act within limits, every act is attributed to a principal, and the platform's telemetry and audit are complete.","stage":"R3","stageRef":"r3","detail":"**Proves:** agents act within limits, every act is attributed to a principal, and the platform's telemetry and audit are complete.\n\nTelemetry export and correlation, the hash-chained audit log, the status page, agent run traces, the registry and attestation, delegation and authority, blast-radius limits, the kill switch, platform-operating agents, untrusted text, data leaving the platform, concurrent and chained change, and evaluation.","ref":"RM-8"},
    {"id":"rm-9","name":"Conversation","number":9,"proves":"a person changes the platform by talking to an assistant that acts only through the operation catalogue, with the authority of that person.","stage":"R3","stageRef":"r3","detail":"**Proves:** a person changes the platform by talking to an assistant that acts only through the operation catalogue, with the authority of that person.\n\nOperations and authority, previews and confirmation, explanation and evidence, one interface, replies, streams and cancellation, records, retention and visibility, the model provider, accessibility, network and language, and untrusted content.","ref":"RM-9"},
    {"id":"rm-10","name":"Operations, privacy and threat controls","number":10,"proves":"the platform is operated and defended on its own evidence, and answers to its privacy duties.","stage":"R4","stageRef":"r4","detail":"**Proves:** the platform is operated and defended on its own evidence, and answers to its privacy duties.\n\nCapacity and fan-out, alerts, runbooks and diagnostics, objectives and budgets, data safety, reporting and backup, sealing and audit of personal data, access by platform staff, compliance evidence, incidents and disclosure, and the reach of the operator console.","ref":"RM-10"},
    {"id":"rm-11","name":"Content features","number":11,"proves":"the content model is complete for editorial work.","stage":"R4","stageRef":"r4","detail":"**Proves:** the content model is complete for editorial work.\n\nVersion history and restore, media with renditions, languages with fallback, preview, accessibility conformance of the authoring application. Search by audience, form submissions, import and export of records, and the review diff.","ref":"RM-11"},
    {"id":"rm-12","name":"Cloud profile","number":12,"proves":"the same images run in the cloud and recover from failure.","stage":"R4","stageRef":"r4","detail":"**Proves:** the same images run in the cloud and recover from failure.\n\nInfrastructure definitions, cloud adapters for every seam, deployments without refused requests, zone-loss and restore drills.","ref":"RM-12"}
  ],

  // ---- Requirements (kind "requirement") and the claims Exegra evaluates itself (m-...) ----------
  "claims": [
    {"id":"krn-001","kind":"requirement","statement":"For every snapshot, intent and context, two evaluations of the transition function SHALL return equal results.","rationale":"Replay, simulation and projection all rest on this.","evaluate":{"method":"property"},"ref":"KRN-001","area":"01-core","section":"Decisions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["k-11","g-5"],"milestone":1,"inSection":"sec-kernel-2","realisation":"checked"},
    {"id":"krn-002","kind":"requirement","statement":"An accepted transition SHALL produce a state delta addressed only to the tenant named in its context.","rationale":"Isolation starts at the decision: a delta for another tenant cannot be expressed.","evaluate":{"method":"property"},"ref":"KRN-002","area":"01-core","section":"Decisions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::World::step`","traces":["g-1","k-2"],"milestone":1,"inSection":"sec-kernel-2","realisation":"checked"},
    {"id":"krn-003","kind":"requirement","statement":"A transition requested by a principal that no policy authorises SHALL be rejected without a state delta.","rationale":"Authorisation is default deny and has no side door.","evaluate":{"method":"property"},"ref":"KRN-003","area":"01-core","section":"Decisions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["k-13","g-20"],"milestone":1,"inSection":"sec-kernel-2","realisation":"checked"},
    {"id":"krn-004","kind":"requirement","statement":"A read SHALL return only records that the policies of the requesting principal permit.","rationale":"Reads are filtered by the same decision that guards writes.","evaluate":{"method":"property"},"ref":"KRN-004","area":"01-core","section":"Decisions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::read`","traces":["g-20"],"milestone":1,"inSection":"sec-kernel-2","realisation":"checked"},
    {"id":"krn-005","kind":"requirement","statement":"A transition evaluated on a partial snapshot SHALL return the result of the complete snapshot or a rejection naming the state it lacks.","rationale":"A store may load only part of a tenant. A missing record must not turn into a wrong acceptance.","evaluate":{"method":"property"},"ref":"KRN-005","area":"01-core","section":"Decisions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::needs`","traces":["k-3","g-5"],"milestone":1,"inSection":"sec-kernel-2","realisation":"checked"},
    {"id":"krn-006","kind":"requirement","statement":"Each accepted transition SHALL advance the tenant revision by exactly one step.","rationale":"Revisions are the versions that stored copies and optimistic commits are keyed by.","evaluate":{"method":"property"},"ref":"KRN-006","area":"01-core","section":"Decisions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::apply_delta`","traces":["g-5"],"milestone":1,"inSection":"sec-kernel-2","realisation":"checked"},
    {"id":"krn-007","kind":"requirement","statement":"A rejected transition SHALL list the checks that failed.","rationale":"People and agents act on the reason, not on the fact of a refusal.","evaluate":{"method":"example"},"ref":"KRN-007","area":"01-core","section":"Decisions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::DomainError`","traces":["g-24","g-11"],"milestone":1,"inSection":"sec-kernel-2","realisation":"checked"},
    {"id":"krn-008","kind":"requirement","statement":"A change to a workflow field SHALL be rejected unless a declared workflow transition permits it.","rationale":"Workflows are data, and the kernel is what enforces them.","evaluate":{"method":"example"},"ref":"KRN-008","area":"01-core","section":"Decisions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["g-31"],"milestone":1,"inSection":"sec-kernel-2","realisation":"checked"},
    {"id":"krn-009","kind":"requirement","statement":"A schema change applied in strict mode SHALL be rejected while an existing record would not conform to the new schema.","rationale":"A strict change either leaves every record valid or does not happen.","evaluate":{"method":"example"},"ref":"KRN-009","area":"01-core","section":"Schema changes","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::plan_migration`","traces":["g-44","d-573"],"milestone":1,"inSection":"sec-kernel-3","realisation":"checked"},
    {"id":"krn-010","kind":"requirement","statement":"A schema change applied in grandfather mode SHALL be accepted with the non-conforming records listed in its evidence.","rationale":"The other honest option: accept, and say exactly what is now out of line.","evaluate":{"method":"example"},"ref":"KRN-010","area":"01-core","section":"Schema changes","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::plan_migration`","traces":["g-44"],"milestone":1,"inSection":"sec-kernel-3","realisation":"checked"},
    {"id":"krn-011","kind":"requirement","statement":"Every state accepted by the transition function without a grandfathered change SHALL satisfy every state invariant.","rationale":"This is the invariant the abstract model proves for its fragment, checked on the real kernel.","evaluate":{"method":"property"},"ref":"KRN-011","area":"01-core","section":"Schema changes","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_verification::invariants::check_world`","traces":["g-43"],"milestone":1,"inSection":"sec-kernel-3","realisation":"checked"},
    {"id":"krn-012","kind":"requirement","statement":"The kernel crate SHALL contain no reference to file, network, clock, randomness, environment or process facilities.","rationale":"Purity is what makes the kernel simulable. It is kept by a scan, not by intention.","evaluate":{"method":"example"},"ref":"KRN-012","area":"01-core","section":"Purity and proof","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel`","traces":["k-1"],"milestone":1,"inSection":"sec-kernel-4","realisation":"construction"},
    {"id":"krn-013","kind":"requirement","statement":"The step function of the abstract model SHALL leave every tenant other than the addressed one unchanged.","rationale":"Tenant isolation, machine-checked for the model.","evaluate":{"method":"proof"},"ref":"KRN-013","area":"01-core","section":"Purity and proof","lifecycle":"active","boundary":"b-1","boundaryDetail":"`Strata.step`","traces":["g-43"],"milestone":1,"inSection":"sec-kernel-4","realisation":"checked"},
    {"id":"krn-014","kind":"requirement","statement":"An accepted strict step of the abstract model SHALL preserve the well-formedness of every tenant.","rationale":"Invariant preservation, machine-checked for the model.","evaluate":{"method":"proof"},"ref":"KRN-014","area":"01-core","section":"Purity and proof","lifecycle":"active","boundary":"b-1","boundaryDetail":"`Strata.step`","traces":["g-43"],"milestone":1,"inSection":"sec-kernel-4","realisation":"checked"},
    {"id":"krn-015","kind":"requirement","statement":"A step of the abstract model requested by an unauthorised principal SHALL yield no new world.","rationale":"Authorisation, machine-checked for the model.","evaluate":{"method":"proof"},"ref":"KRN-015","area":"01-core","section":"Purity and proof","lifecycle":"active","boundary":"b-1","boundaryDetail":"`Strata.step`","traces":["g-43","k-13"],"milestone":1,"inSection":"sec-kernel-4","realisation":"checked"},
    {"id":"krn-016","kind":"requirement","statement":"The kernel and the abstract model SHALL produce identical outcomes for every scenario of the correspondence fixtures.","rationale":"The proofs are about the model. This is what ties the model to the code.","evaluate":{"method":"property"},"ref":"KRN-016","area":"01-core","section":"Purity and proof","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_verification::lean::kernel_output`","traces":["g-43"],"milestone":1,"inSection":"sec-kernel-4","realisation":"checked"},
    {"id":"sto-001","kind":"requirement","statement":"The memory adapter SHALL pass every check of the storage conformance table.","rationale":"The reference adapter states the contract in the simplest code.","evaluate":{"method":"conformance"},"ref":"STO-001","area":"01-core","section":"Adapters","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["g-38"],"milestone":1,"cases":["cases-storage-conformance"],"inSection":"sec-storage-2","realisation":"checked"},
    {"id":"sto-002","kind":"requirement","statement":"The SQLite adapter SHALL pass every check of the storage conformance table on a database file.","rationale":"The adapter used for single-process local work and for simulation.","evaluate":{"method":"conformance"},"ref":"STO-002","area":"01-core","section":"Adapters","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["g-38","g-36"],"milestone":1,"cases":["cases-storage-conformance"],"inSection":"sec-storage-2","realisation":"checked"},
    {"id":"sto-003","kind":"requirement","statement":"Data acknowledged by the SQLite adapter SHALL be readable after the database file is reopened.","rationale":"Durability is claimed by the adapter and checked.","evaluate":{"method":"example"},"ref":"STO-003","area":"01-core","section":"Adapters","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["g-39"],"milestone":1,"inSection":"sec-storage-2","realisation":"checked"},
    {"id":"sto-004","kind":"requirement","statement":"The PostgreSQL adapter SHALL pass every check of the storage conformance table against a database of one tenant.","rationale":"The production adapter is accepted on the same terms as the others.","evaluate":{"method":"conformance"},"ref":"STO-004","area":"01-core","section":"Adapters","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["g-38","g-1","d-1"],"milestone":2,"cases":["cases-storage-conformance"],"inSection":"sec-storage-2","realisation":"checked"},
    {"id":"sto-005","kind":"requirement","statement":"An adapter SHALL open a tenant database using only the placement that the tenant directory returns for that tenant.","rationale":"A move changes the placement and nothing else.","evaluate":{"method":"scenario"},"ref":"STO-005","area":"01-core","section":"Adapters","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["k-3","g-3"],"milestone":2,"inSection":"sec-storage-2","realisation":"checked"},
    {"id":"sto-006","kind":"requirement","statement":"The connections an adapter holds open for one tenant SHALL stay within that tenant's connection quota.","rationale":"A database per tenant makes connections the first shared resource to run out.","evaluate":{"method":"property"},"ref":"STO-006","area":"01-core","section":"Adapters","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["g-4"],"milestone":2,"inSection":"sec-storage-2","realisation":"checked"},
    {"id":"run-001","kind":"requirement","statement":"A subscriber SHALL receive a notice about a record only when the policies of its principal permit reading that record.","rationale":"Live updates go through the same read decision as queries.","evaluate":{"method":"scenario"},"ref":"RUN-001","area":"01-core","section":"Runtime","lifecycle":"active","boundary":"b-9","boundaryDetail":"`event stream`","traces":["g-20"],"milestone":1,"inSection":"sec-runtime-2","realisation":"checked"},
    {"id":"run-002","kind":"requirement","statement":"A session issued for one tenant SHALL carry no identity when presented at the address of another tenant.","rationale":"A session belongs to a realm, and a realm to a tenant.","evaluate":{"method":"scenario"},"ref":"RUN-002","area":"01-core","section":"Runtime","lifecycle":"active","boundary":"b-4","boundaryDetail":"`session`","traces":["g-20","k-2"],"milestone":1,"inSection":"sec-runtime-2","realisation":"checked"},
    {"id":"run-003","kind":"requirement","statement":"The runtime SHALL refuse any request, other than the health check, that lacks the service credential.","rationale":"Only platform components call the runtime.","evaluate":{"method":"scenario"},"ref":"RUN-003","area":"01-core","section":"Runtime","lifecycle":"active","boundary":"b-3","boundaryDetail":"`service credential`","traces":["k-6"],"milestone":1,"inSection":"sec-runtime-2","realisation":"checked"},
    {"id":"run-004","kind":"requirement","statement":"Installing the same tenant bundles into an empty store SHALL produce the same tenant state.","rationale":"Provisioning from a template is a deterministic sequence of kernel intents.","evaluate":{"method":"scenario"},"ref":"RUN-004","area":"01-core","section":"Runtime","lifecycle":"active","boundary":"b-21","boundaryDetail":"`tenant bundle`","traces":["k-11","g-2"],"milestone":1,"inSection":"sec-runtime-2","realisation":"checked"},
    {"id":"run-005","kind":"requirement","statement":"The runtime SHALL publish a domain event only after the transaction that produced it has committed.","rationale":"Subscribers, triggers and purges all act on events, so an event for a change that did not happen is a defect everywhere at once.","evaluate":{"method":"scenario"},"ref":"RUN-005","area":"01-core","section":"Runtime","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["k-9"],"milestone":2,"inSection":"sec-runtime-2","realisation":"checked"},
    {"id":"run-006","kind":"requirement","statement":"A page that loses its live connection SHALL reconnect and show every change published while it was away, each once and in order.","rationale":"Readers and authors keep a page open; a dropped connection must not leave it stale or show a change twice. The web client resumes from the last notice number it acknowledged.","evaluate":{"method":"scenario"},"ref":"RUN-006","area":"01-core","section":"Runtime","lifecycle":"active","boundary":"b-9","boundaryDetail":"`event stream`","traces":["g-20"],"milestone":11,"inSection":"sec-runtime-2","realisation":"checked"},
    {"id":"gwy-001","kind":"requirement","statement":"The gateway SHALL resolve the tenant of a request from its host name alone.","rationale":"Nothing a client sends in a header, a parameter or a body can name a tenant.","evaluate":{"method":"scenario"},"ref":"GWY-001","area":"01-core","section":"Gateway","lifecycle":"active","boundary":"b-9","boundaryDetail":"`Host`","traces":["g-20","d-6","d-27"],"milestone":1,"inSection":"sec-runtime-3","realisation":"checked"},
    {"id":"gwy-002","kind":"requirement","statement":"The gateway SHALL refuse a state-changing request that lacks the request token of its session.","rationale":"A cross-site request carries the cookie and not the token.","evaluate":{"method":"scenario"},"ref":"GWY-002","area":"01-core","section":"Gateway","lifecycle":"active","boundary":"b-9","boundaryDetail":"`x-csrf-token`","traces":["g-46"],"milestone":1,"inSection":"sec-runtime-3","realisation":"checked"},
    {"id":"gwy-003","kind":"requirement","statement":"The gateway SHALL set the session cookie with the HttpOnly and SameSite=Strict attributes.","rationale":"Page script cannot read the secret and other sites cannot send it.","evaluate":{"method":"scenario"},"ref":"GWY-003","area":"01-core","section":"Gateway","lifecycle":"active","boundary":"b-4","boundaryDetail":"`strata_sid`","traces":["k-16"],"milestone":1,"inSection":"sec-runtime-3","realisation":"checked"},
    {"id":"gwy-004","kind":"requirement","statement":"The gateway SHALL refuse a WebSocket upgrade whose origin is not an allowed origin.","rationale":"A socket opened from another site would carry the cookie.","evaluate":{"method":"scenario"},"ref":"GWY-004","area":"01-core","section":"Gateway","lifecycle":"active","boundary":"b-9","boundaryDetail":"`Origin`","traces":["g-46"],"milestone":1,"inSection":"sec-runtime-3","realisation":"checked"},
    {"id":"gwy-005","kind":"requirement","statement":"A page response SHALL carry a content security policy that allows no inline script.","rationale":"The second line of defence behind structured content.","evaluate":{"method":"example"},"ref":"GWY-005","area":"01-core","section":"Gateway","lifecycle":"active","boundary":"b-13","boundaryDetail":"`Content-Security-Policy`","traces":["k-12"],"milestone":1,"inSection":"sec-runtime-3","realisation":"checked"},
    {"id":"sim-001","kind":"requirement","statement":"Two runs of one scenario SHALL produce traces with equal hashes.","rationale":"A simulation that cannot be repeated proves nothing.","evaluate":{"method":"example"},"ref":"SIM-001","area":"01-core","section":"Simulator","lifecycle":"active","boundary":"b-20","boundaryDetail":"`strata_simulation::engine::run`","traces":["k-11","g-42"],"milestone":1,"inSection":"sec-runtime-4","realisation":"checked"},
    {"id":"sim-002","kind":"requirement","statement":"A projection of a change that alters no behaviour SHALL report no divergence.","rationale":"The comparison has no false positives on an empty change.","evaluate":{"method":"example"},"ref":"SIM-002","area":"01-core","section":"Simulator","lifecycle":"active","boundary":"b-20","boundaryDetail":"`strata_simulation::project::project`","traces":["g-44"],"milestone":1,"inSection":"sec-runtime-4","realisation":"checked"},
    {"id":"sim-003","kind":"requirement","statement":"A projection SHALL report the first scheduled operation whose outcome differs under the proposed change.","rationale":"The first divergence is the one certainly caused by the change.","evaluate":{"method":"example"},"ref":"SIM-003","area":"01-core","section":"Simulator","lifecycle":"active","boundary":"b-20","boundaryDetail":"`strata_simulation::project::project`","traces":["g-44","g-26"],"milestone":1,"inSection":"sec-runtime-4","realisation":"checked"},
    {"id":"sim-004","kind":"requirement","statement":"A replay of a tenant journal SHALL reproduce the recorded state delta of each entry.","rationale":"Production and simulation run the same kernel, and this is the check that they agree.","evaluate":{"method":"example"},"ref":"SIM-004","area":"01-core","section":"Simulator","lifecycle":"active","boundary":"b-20","boundaryDetail":"`strata_simulation::journal::replay_journal`","traces":["g-42","k-11"],"milestone":1,"inSection":"sec-runtime-4","realisation":"checked"},
    {"id":"ten-001","kind":"requirement","statement":"Provisioning a tenant SHALL create a database that holds the data of that tenant alone.","rationale":"The database is the isolation boundary.","evaluate":{"method":"scenario"},"ref":"TEN-001","area":"02-tenancy","section":"Provisioning","lifecycle":"active","boundary":"b-3","boundaryDetail":"`POST /tenants`","traces":["g-1"],"milestone":2,"inSection":"sec-tenancy-2","realisation":"checked"},
    {"id":"ten-002","kind":"requirement","statement":"The tenant directory SHALL report a tenant as active only after its database layout and its template have been installed.","rationale":"Active means usable. Modelled as the provisioning flow.","evaluate":{"method":"scenario"},"ref":"TEN-002","area":"02-tenancy","section":"Provisioning","lifecycle":"active","boundary":"b-3","boundaryDetail":"`tenant state`","traces":["g-2"],"milestone":2,"inSection":"sec-tenancy-2","realisation":"checked"},
    {"id":"ten-003","kind":"requirement","statement":"A provisioning run that fails SHALL leave no tenant reported as active.","rationale":"A half-made tenant is removed or retried, and is not offered to anyone meanwhile.","evaluate":{"method":"scenario"},"ref":"TEN-003","area":"02-tenancy","section":"Provisioning","lifecycle":"active","boundary":"b-3","boundaryDetail":"`tenant state`","traces":["g-2"],"milestone":2,"inSection":"sec-tenancy-2","realisation":"checked"},
    {"id":"ten-004","kind":"requirement","statement":"Provisioning a tenant from the publication template SHALL complete within 30 seconds at the 95th percentile.","rationale":"Sign-up waits for this.","evaluate":{"method":"budget"},"ref":"TEN-004","area":"02-tenancy","section":"Provisioning","lifecycle":"active","boundary":"b-3","boundaryDetail":"`POST /tenants`","traces":["g-2"],"milestone":2,"inSection":"sec-tenancy-2","realisation":"operational"},
    {"id":"ten-005","kind":"requirement","statement":"A tenant created with a region SHALL have its database and its stored files placed in that region.","rationale":"Residency is a property of the placement.","evaluate":{"method":"scenario"},"ref":"TEN-005","area":"02-tenancy","section":"Provisioning","lifecycle":"active","boundary":"b-3","boundaryDetail":"`placement`","traces":["g-3","d-503"],"milestone":2,"inSection":"sec-tenancy-2","realisation":"checked"},
    {"id":"ten-006","kind":"requirement","statement":"The control database SHALL hold no field of a tenant record.","rationale":"Identifiers, states and addresses only, so that a tenant can be deleted by deleting its own things.","evaluate":{"method":"property"},"ref":"TEN-006","area":"02-tenancy","section":"Isolation","lifecycle":"active","boundary":"b-3","boundaryDetail":"`control database`","traces":["k-2","d-2"],"milestone":2,"inSection":"sec-tenancy-3","realisation":"checked"},
    {"id":"ten-007","kind":"requirement","statement":"A request for one tenant SHALL be served using a database connection opened for that tenant alone.","rationale":"No pooled connection is ever switched between tenants.","evaluate":{"method":"property"},"ref":"TEN-007","area":"02-tenancy","section":"Isolation","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["g-20","k-3"],"milestone":2,"inSection":"sec-tenancy-3","realisation":"checked"},
    {"id":"ten-008","kind":"requirement","statement":"A tenant that exceeds its connection quota SHALL receive a throttling response while other tenants are served.","rationale":"The noisy tenant is the one that waits.","evaluate":{"method":"scenario"},"ref":"TEN-008","area":"02-tenancy","section":"Isolation","lifecycle":"active","boundary":"b-2","boundaryDetail":"`429`","traces":["g-4"],"milestone":2,"inSection":"sec-tenancy-3","realisation":"checked"},
    {"id":"ten-009","kind":"requirement","statement":"A suspended tenant SHALL refuse state-changing requests, except the owner operations that TEN-1225 keeps.","rationale":"Suspension is reversible and loses nothing.","evaluate":{"method":"scenario"},"ref":"TEN-009","area":"02-tenancy","section":"Life cycle","lifecycle":"active","boundary":"b-3","boundaryDetail":"`POST /tenants/{id}/suspend`","traces":["g-1"],"milestone":2,"inSection":"sec-tenancy-4","realisation":"checked"},
    {"id":"ten-010","kind":"requirement","statement":"An export of a tenant SHALL restore into an empty installation as a state with the same canonical hash.","rationale":"The tenant is portable, and the hash is the proof.","evaluate":{"method":"scenario"},"ref":"TEN-010","area":"02-tenancy","section":"Life cycle","lifecycle":"active","boundary":"b-3","boundaryDetail":"`POST /tenants/{id}/export`","traces":["g-1"],"milestone":2,"inSection":"sec-tenancy-4","realisation":"checked"},
    {"id":"ten-011","kind":"requirement","statement":"Deleting a tenant SHALL remove its database, its stored files and its encryption key.","rationale":"Deletion is the removal of three things that belong to nobody else.","evaluate":{"method":"scenario"},"ref":"TEN-011","area":"02-tenancy","section":"Life cycle","lifecycle":"active","boundary":"b-3","boundaryDetail":"`DELETE /tenants/{id}`","traces":["g-1","g-40"],"milestone":2,"inSection":"sec-tenancy-4","realisation":"checked"},
    {"id":"ten-012","kind":"requirement","statement":"Moving a tenant to another database cluster SHALL preserve the canonical hash of its state.","rationale":"A move is a copy that can be checked.","evaluate":{"method":"scenario"},"ref":"TEN-012","area":"02-tenancy","section":"Life cycle","lifecycle":"active","boundary":"b-3","boundaryDetail":"`POST /tenants/{id}/move`","traces":["g-3"],"milestone":2,"inSection":"sec-tenancy-4","realisation":"checked"},
    {"id":"ten-013","kind":"requirement","statement":"The address of a tenant SHALL resolve to the same tenant before and after a move.","rationale":"Addresses belong to the directory, not to a cluster.","evaluate":{"method":"scenario"},"ref":"TEN-013","area":"02-tenancy","section":"Life cycle","lifecycle":"active","boundary":"b-3","boundaryDetail":"`domain binding`","traces":["g-3"],"milestone":2,"inSection":"sec-tenancy-4","realisation":"checked"},
    {"id":"ten-014","kind":"requirement","statement":"A change to the storage layout SHALL be applied to each tenant database separately with its outcome recorded per tenant.","rationale":"With a database per tenant, a layout change is many small changes, and some will lag.","evaluate":{"method":"scenario"},"ref":"TEN-014","area":"02-tenancy","section":"Life cycle","lifecycle":"active","boundary":"b-3","boundaryDetail":"`layout version`","traces":["g-1"],"milestone":2,"inSection":"sec-tenancy-4","realisation":"checked"},
    {"id":"ten-015","kind":"requirement","statement":"A tenant restored to a point in time SHALL have the state hash that its journal records at that point.","rationale":"Restore is checked the same way as replay.","evaluate":{"method":"scenario"},"ref":"TEN-015","area":"02-tenancy","section":"Life cycle","lifecycle":"active","boundary":"b-3","boundaryDetail":"`POST /tenants/{id}/restore`","traces":["g-39"],"milestone":12,"inSection":"sec-tenancy-4","realisation":"checked"},
    {"id":"idn-001","kind":"requirement","statement":"Each sign-in method SHALL issue a session only for the outcomes that the sign-in method table marks as accepted.","rationale":"One table states, per method, what is accepted and what is refused.","evaluate":{"method":"conformance"},"ref":"IDN-001","area":"03-identity","section":"Sign-in methods","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/{method}`","traces":["g-6"],"milestone":3,"cases":["cases-sign-in-methods"],"inSection":"sec-identity-2","realisation":"checked"},
    {"id":"idn-002","kind":"requirement","statement":"A stored password SHALL be an Argon2id hash with a salt drawn for that password.","rationale":"A stolen database yields no passwords.","evaluate":{"method":"property"},"ref":"IDN-002","area":"03-identity","section":"Sign-in methods","lifecycle":"active","boundary":"b-4","boundaryDetail":"`credential`","traces":["k-4","g-46"],"milestone":3,"inSection":"sec-identity-2","realisation":"checked"},
    {"id":"idn-003","kind":"requirement","statement":"An emailed sign-in link SHALL be accepted once.","rationale":"Modelled as the emailed link flow, with replay as its negative.","evaluate":{"method":"scenario"},"ref":"IDN-003","area":"03-identity","section":"Sign-in methods","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/link`","traces":["g-6","d-9","d-703"],"milestone":3,"inSection":"sec-identity-2","realisation":"checked"},
    {"id":"idn-004","kind":"requirement","statement":"An emailed sign-in link SHALL be refused after its lifetime has passed.","rationale":"A link in an old mailbox is not a credential.","evaluate":{"method":"scenario"},"ref":"IDN-004","area":"03-identity","section":"Sign-in methods","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/link`","traces":["g-46","d-9"],"milestone":3,"inSection":"sec-identity-2","realisation":"checked"},
    {"id":"idn-005","kind":"requirement","statement":"An emailed sign-in link SHALL be accepted only in the browser that requested it.","rationale":"A forwarded or intercepted link does not sign anyone else in.","evaluate":{"method":"scenario"},"ref":"IDN-005","area":"03-identity","section":"Sign-in methods","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/link`","traces":["g-46","d-9"],"milestone":3,"inSection":"sec-identity-2","realisation":"checked"},
    {"id":"idn-006","kind":"requirement","statement":"The response to a request for a sign-in link SHALL be the same whether or not the address belongs to an account.","rationale":"The endpoint does not tell an attacker who has an account.","evaluate":{"method":"scenario"},"ref":"IDN-006","area":"03-identity","section":"Sign-in methods","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/link/request`","traces":["g-46"],"milestone":3,"inSection":"sec-identity-2","realisation":"checked"},
    {"id":"idn-007","kind":"requirement","statement":"A passkey registration SHALL bind the credential to the address of the tenant as the relying party.","rationale":"A passkey for one tenant is useless at another.","evaluate":{"method":"scenario"},"ref":"IDN-007","area":"03-identity","section":"Sign-in methods","lifecycle":"active","boundary":"b-4","boundaryDetail":"`WebAuthn relying party`","traces":["g-6","k-14"],"milestone":3,"inSection":"sec-identity-2","realisation":"checked"},
    {"id":"idn-008","kind":"requirement","statement":"Repeated failed sign-in attempts for one account SHALL delay further attempts for that account: once the failures reach the threshold that D-700 states, further attempts are refused for the lockout that D-700 states, whatever the case, width or spacing of the login.","rationale":"Guessing is slowed without locking the owner out for good.","evaluate":{"method":"scenario"},"ref":"IDN-008","area":"03-identity","section":"Sign-in methods","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/password`","traces":["g-46"],"milestone":3,"inSection":"sec-identity-2","realisation":"checked"},
    {"id":"idn-009","kind":"requirement","statement":"A principal of one tenant SHALL be unknown to the sign-in of every other tenant.","rationale":"Realms do not overlap.","evaluate":{"method":"scenario"},"ref":"IDN-009","area":"03-identity","section":"Sign-in methods","lifecycle":"active","boundary":"b-4","boundaryDetail":"`realm`","traces":["g-20","d-3","d-500"],"milestone":3,"inSection":"sec-identity-2","realisation":"checked"},
    {"id":"idn-010","kind":"requirement","statement":"A session secret SHALL be stored only as a hash.","rationale":"A stolen database yields no sessions.","evaluate":{"method":"scenario"},"ref":"IDN-010","area":"03-identity","section":"Sessions","lifecycle":"active","boundary":"b-4","boundaryDetail":"`sign-in session`","traces":["k-16","d-5"],"milestone":3,"inSection":"sec-identity-3","realisation":"checked"},
    {"id":"idn-011","kind":"requirement","statement":"A successful authentication SHALL end the session that the same browser held before it.","rationale":"The secret changes at every authentication, so one planted beforehand is worthless.","evaluate":{"method":"scenario"},"ref":"IDN-011","area":"03-identity","section":"Sessions","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/{method}`","traces":["g-46"],"milestone":3,"inSection":"sec-identity-3","realisation":"checked"},
    {"id":"idn-012","kind":"requirement","statement":"A person SHALL be able to list each of their own sessions and to revoke any of them, or all the others at once, and a revoked session SHALL be refused from then on and SHALL close the connections it has open.","rationale":"The person is the one who knows which devices are theirs.","evaluate":{"method":"scenario"},"ref":"IDN-012","area":"03-identity","section":"Sessions","lifecycle":"active","boundary":"b-4","boundaryDetail":"`GET /sessions`","traces":["g-9","d-5"],"milestone":3,"inSection":"sec-identity-3","realisation":"checked"},
    {"id":"idn-013","kind":"requirement","statement":"A revoked session SHALL be refused by the gateway once the revocation bound has passed, including when the revocation notice is lost.","rationale":"Modelled as the session revocation flow: the notice is the quick path and a recheck is the backstop.","evaluate":{"method":"scenario"},"ref":"IDN-013","area":"03-identity","section":"Sessions","lifecycle":"active","boundary":"b-4","boundaryDetail":"`assertion`","traces":["g-9"],"milestone":3,"inSection":"sec-identity-3","realisation":"checked"},
    {"id":"idn-014","kind":"requirement","statement":"A session revocation SHALL be honoured by every gateway instance within 5 seconds.","rationale":"The bound the model's recheck interval stands for.","evaluate":{"method":"budget"},"ref":"IDN-014","area":"03-identity","section":"Sessions","lifecycle":"active","boundary":"b-4","boundaryDetail":"`assertion`","traces":["g-9"],"milestone":3,"inSection":"sec-identity-3","realisation":"operational"},
    {"id":"idn-015","kind":"requirement","statement":"The identity service SHALL answer a session lookup within 20 ms at the 99th percentile.","rationale":"Every authenticated request pays this once per freshness interval.","evaluate":{"method":"budget"},"ref":"IDN-015","area":"03-identity","section":"Sessions","lifecycle":"active","boundary":"b-4","boundaryDetail":"`assertion`","traces":["g-18","g-12"],"milestone":3,"inSection":"sec-identity-3","realisation":"operational"},
    {"id":"idn-016","kind":"requirement","statement":"Changing a password SHALL revoke the other sessions of the account.","rationale":"Whoever knew the old password is signed out.","evaluate":{"method":"scenario"},"ref":"IDN-016","area":"03-identity","section":"Sessions","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /password`","traces":["g-9"],"milestone":3,"inSection":"sec-identity-3","realisation":"checked"},
    {"id":"idn-017","kind":"requirement","statement":"A component other than the identity service SHALL accept a caller identity only from an assertion that the identity service signed.","rationale":"One issuer, many verifiers.","evaluate":{"method":"scenario"},"ref":"IDN-017","area":"03-identity","section":"Sessions","lifecycle":"active","boundary":"b-4","boundaryDetail":"`assertion`","traces":["g-12","d-4"],"milestone":3,"inSection":"sec-identity-3","realisation":"checked"},
    {"id":"idn-018","kind":"requirement","statement":"A realm policy that asks for a second factor SHALL withhold the session until a second factor has been verified.","rationale":"The first factor alone yields nothing usable.","evaluate":{"method":"scenario"},"ref":"IDN-018","area":"03-identity","section":"Factors, step-up and recovery","lifecycle":"active","boundary":"b-4","boundaryDetail":"`realm policy`","traces":["g-8"],"milestone":3,"inSection":"sec-identity-4","realisation":"checked"},
    {"id":"idn-019","kind":"requirement","statement":"An operation marked sensitive SHALL be refused when the last authentication of the session is older than the step-up age that D-700 states.","rationale":"An unattended browser cannot change a password or a key.","evaluate":{"method":"scenario"},"ref":"IDN-019","area":"03-identity","section":"Factors, step-up and recovery","lifecycle":"active","boundary":"b-4","boundaryDetail":"`authentication age`","traces":["g-8","d-700","d-4915"],"milestone":3,"inSection":"sec-identity-4","realisation":"checked"},
    {"id":"idn-020","kind":"requirement","statement":"Account recovery SHALL revoke every existing session of the account.","rationale":"Recovery is used when control was lost, so it takes control back everywhere.","evaluate":{"method":"scenario"},"ref":"IDN-020","area":"03-identity","section":"Factors, step-up and recovery","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /recovery`","traces":["g-46"],"milestone":3,"inSection":"sec-identity-4","realisation":"checked"},
    {"id":"idn-021","kind":"requirement","statement":"Every authentication decision SHALL append an audit entry naming the method, the outcome and the checks evaluated.","rationale":"A refused sign-in can be explained to the person and to their administrator.","evaluate":{"method":"scenario"},"ref":"IDN-021","area":"03-identity","section":"Record and presentation","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit entry`","traces":["g-11"],"milestone":3,"seam":2,"inSection":"sec-identity-5","realisation":"checked"},
    {"id":"idn-022","kind":"requirement","statement":"A log line or audit entry SHALL contain no password, session secret, token or one-time code.","rationale":"Checked by scanning real output for the secrets of a test run.","evaluate":{"method":"scenario"},"ref":"IDN-022","area":"03-identity","section":"Record and presentation","lifecycle":"active","boundary":"b-12","boundaryDetail":"`log line`","traces":["k-4"],"milestone":3,"seam":1,"inSection":"sec-identity-5","realisation":"checked"},
    {"id":"idn-023","kind":"requirement","statement":"The sign-in pages SHALL meet WCAG 2.2 level AA.","rationale":"Signing in is the one flow nobody can skip.","evaluate":{"method":"example"},"ref":"IDN-023","area":"03-identity","section":"Record and presentation","lifecycle":"active","boundary":"b-13","boundaryDetail":"`sign-in pages`","traces":["g-45"],"milestone":3,"inSection":"sec-identity-5","realisation":"checked"},
    {"id":"fed-001","kind":"requirement","statement":"An OpenID Connect callback whose state value matches no pending request of that browser SHALL be refused.","rationale":"Modelled as the callback flow, with a forged callback as its negative.","evaluate":{"method":"scenario"},"ref":"FED-001","area":"03-identity","section":"OpenID Connect","lifecycle":"active","boundary":"b-5","boundaryDetail":"`GET /federation/oidc/callback`","traces":["g-46","d-7"],"milestone":4,"inSection":"sec-federation-2","realisation":"checked"},
    {"id":"fed-002","kind":"requirement","statement":"An OpenID Connect sign-in SHALL use the authorization code flow with a proof key.","rationale":"An intercepted code cannot be redeemed.","evaluate":{"method":"scenario"},"ref":"FED-002","area":"03-identity","section":"OpenID Connect","lifecycle":"active","boundary":"b-5","boundaryDetail":"`GET /federation/oidc/start`","traces":["k-14","d-7"],"milestone":4,"inSection":"sec-federation-2","realisation":"checked"},
    {"id":"fed-003","kind":"requirement","statement":"An identity token whose issuer, audience, signature or nonce fails verification SHALL be refused.","rationale":"A token for another client, or from another issuer, signs nobody in.","evaluate":{"method":"scenario"},"ref":"FED-003","area":"03-identity","section":"OpenID Connect","lifecycle":"active","boundary":"b-5","boundaryDetail":"`identity token`","traces":["g-46"],"milestone":4,"inSection":"sec-federation-2","realisation":"checked"},
    {"id":"fed-004","kind":"requirement","statement":"Provider signing keys SHALL be refreshed from the provider metadata when a token names an unknown key.","rationale":"Providers rotate keys without notice.","evaluate":{"method":"scenario"},"ref":"FED-004","area":"03-identity","section":"OpenID Connect","lifecycle":"active","boundary":"b-5","boundaryDetail":"`provider metadata`","traces":["g-6"],"milestone":4,"inSection":"sec-federation-2","realisation":"checked"},
    {"id":"fed-005","kind":"requirement","statement":"A SAML response SHALL be accepted only when its assertion is signed by a certificate that the tenant configured.","rationale":"An unsigned or wrongly signed assertion is just text.","evaluate":{"method":"scenario"},"ref":"FED-005","area":"03-identity","section":"SAML","lifecycle":"active","boundary":"b-5","boundaryDetail":"`POST /federation/saml/acs`","traces":["g-6","d-8"],"milestone":4,"inSection":"sec-federation-3","realisation":"checked"},
    {"id":"fed-006","kind":"requirement","statement":"A SAML assertion presented a second time SHALL be refused.","rationale":"Assertions are bearer material until their identifier is remembered.","evaluate":{"method":"scenario"},"ref":"FED-006","area":"03-identity","section":"SAML","lifecycle":"active","boundary":"b-5","boundaryDetail":"`POST /federation/saml/acs`","traces":["g-46"],"milestone":4,"inSection":"sec-federation-3","realisation":"checked"},
    {"id":"fed-007","kind":"requirement","statement":"A SAML response that answers no pending request SHALL be refused unless the tenant enabled sign-in started by the provider.","rationale":"The unsolicited form is the one attackers inject into.","evaluate":{"method":"scenario"},"ref":"FED-007","area":"03-identity","section":"SAML","lifecycle":"active","boundary":"b-5","boundaryDetail":"`POST /federation/saml/acs`","traces":["d-8","g-46"],"milestone":4,"inSection":"sec-federation-3","realisation":"checked"},
    {"id":"fed-008","kind":"requirement","statement":"A SAML response whose audience or recipient names another service SHALL be refused.","rationale":"An assertion issued for a different service provider is not for this one.","evaluate":{"method":"scenario"},"ref":"FED-008","area":"03-identity","section":"SAML","lifecycle":"active","boundary":"b-5","boundaryDetail":"`POST /federation/saml/acs`","traces":["g-46"],"milestone":4,"inSection":"sec-federation-3","realisation":"checked"},
    {"id":"fed-009","kind":"requirement","statement":"A realm that binds an email domain to an identity provider SHALL refuse password and emailed-link sign-in for addresses in that domain.","rationale":"When the organisation says its provider decides, nothing else does.","evaluate":{"method":"scenario"},"ref":"FED-009","area":"03-identity","section":"Policy and linking","lifecycle":"active","boundary":"b-4","boundaryDetail":"`realm policy`","traces":["g-7","d-6"],"milestone":4,"inSection":"sec-federation-4","realisation":"checked"},
    {"id":"fed-010","kind":"requirement","statement":"The sign-in page SHALL offer the identity providers configured for the realm of the address it is served at.","rationale":"The address selects the realm before anyone types anything.","evaluate":{"method":"scenario"},"ref":"FED-010","area":"03-identity","section":"Policy and linking","lifecycle":"active","boundary":"b-4","boundaryDetail":"`sign-in page`","traces":["g-6","d-6"],"milestone":4,"inSection":"sec-federation-4","realisation":"checked"},
    {"id":"fed-011","kind":"requirement","statement":"A first federated sign-in SHALL create a principal only when the realm enabled creation on first sign-in.","rationale":"Otherwise people are admitted by provisioning or invitation.","evaluate":{"method":"scenario"},"ref":"FED-011","area":"03-identity","section":"Policy and linking","lifecycle":"active","boundary":"b-5","boundaryDetail":"`first federated sign-in`","traces":["g-7"],"milestone":4,"inSection":"sec-federation-4","realisation":"checked"},
    {"id":"fed-012","kind":"requirement","statement":"A federated identity SHALL be linked to an existing principal only after that principal has authenticated.","rationale":"A matching email address at a provider is not proof of owning the account.","evaluate":{"method":"scenario"},"ref":"FED-012","area":"03-identity","section":"Policy and linking","lifecycle":"active","boundary":"b-5","boundaryDetail":"`identity link`","traces":["g-46"],"milestone":4,"inSection":"sec-federation-4","realisation":"checked"},
    {"id":"fed-013","kind":"requirement","statement":"An outage of an external identity provider SHALL leave the other sign-in methods of the realm usable.","rationale":"One provider failing does not take the tenant down.","evaluate":{"method":"scenario"},"ref":"FED-013","area":"03-identity","section":"Policy and linking","lifecycle":"active","boundary":"b-4","boundaryDetail":"`sign-in methods`","traces":["g-6"],"milestone":4,"inSection":"sec-federation-4","realisation":"checked"},
    {"id":"fed-014","kind":"requirement","statement":"The provisioning endpoint SHALL behave as the provisioning case table states for each listed operation.","rationale":"SCIM is a standard, and conformance to it is a table.","evaluate":{"method":"conformance"},"ref":"FED-014","area":"03-identity","section":"Provisioning","lifecycle":"active","boundary":"b-5","boundaryDetail":"`/scim/v2`","traces":["g-7","k-14"],"milestone":4,"cases":["cases-provisioning-operations"],"inSection":"sec-federation-5","realisation":"checked"},
    {"id":"fed-015","kind":"requirement","statement":"Deactivating a person through provisioning SHALL revoke the sessions of that person.","rationale":"Leaving the organisation ends access now, not at the next sign-in.","evaluate":{"method":"scenario"},"ref":"FED-015","area":"03-identity","section":"Provisioning","lifecycle":"active","boundary":"b-5","boundaryDetail":"`/scim/v2/Users`","traces":["g-7","g-9"],"milestone":4,"inSection":"sec-federation-5","realisation":"checked"},
    {"id":"tok-001","kind":"requirement","statement":"A service account SHALL obtain an access token through the client credentials grant.","rationale":"The standard grant for a caller that is itself.","evaluate":{"method":"scenario"},"ref":"TOK-001","area":"03-identity","section":"Issue","lifecycle":"active","boundary":"b-6","boundaryDetail":"`POST /token`","traces":["g-10"],"milestone":4,"inSection":"sec-tokens-2","realisation":"checked"},
    {"id":"tok-002","kind":"requirement","statement":"An access token SHALL grant no scope beyond those of the grant it was issued from.","rationale":"A token is a subset of a grant.","evaluate":{"method":"scenario"},"ref":"TOK-002","area":"03-identity","section":"Issue","lifecycle":"active","boundary":"b-6","boundaryDetail":"`access token`","traces":["g-10"],"milestone":4,"inSection":"sec-tokens-2","realisation":"checked"},
    {"id":"tok-003","kind":"requirement","statement":"An agent acting for a person SHALL present a token that names both the agent and the person.","rationale":"Attribution needs both names on the request itself.","evaluate":{"method":"scenario"},"ref":"TOK-003","area":"03-identity","section":"Issue","lifecycle":"active","boundary":"b-6","boundaryDetail":"`POST /token`","traces":["g-25"],"milestone":4,"inSection":"sec-tokens-2","realisation":"checked"},
    {"id":"tok-004","kind":"requirement","statement":"A delegated token SHALL grant no permission that the delegating person lacks.","rationale":"Delegation narrows and cannot widen.","evaluate":{"method":"scenario"},"ref":"TOK-004","area":"03-identity","section":"Issue","lifecycle":"active","boundary":"b-6","boundaryDetail":"`delegated token`","traces":["k-13","g-28"],"milestone":4,"inSection":"sec-tokens-2","realisation":"checked"},
    {"id":"tok-005","kind":"requirement","statement":"An access token SHALL be valid for at most 5 minutes.","rationale":"Short enough that a missed revocation notice costs little (D-537).","evaluate":{"method":"budget"},"ref":"TOK-005","area":"03-identity","section":"Issue","lifecycle":"active","boundary":"b-6","boundaryDetail":"`access token`","traces":["g-28","d-537"],"milestone":4,"inSection":"sec-tokens-2","realisation":"operational"},
    {"id":"tok-006","kind":"requirement","statement":"An access token issued for one tenant SHALL be refused by every other tenant.","rationale":"The audience of a token is a tenant.","evaluate":{"method":"scenario"},"ref":"TOK-006","area":"03-identity","section":"Verify and revoke","lifecycle":"active","boundary":"b-6","boundaryDetail":"`access token`","traces":["g-20"],"milestone":4,"inSection":"sec-tokens-3","realisation":"checked"},
    {"id":"tok-007","kind":"requirement","statement":"Revoking a grant SHALL cause tokens issued from it to be refused within the revocation bound that applies to sessions.","rationale":"The revocation notice is the quick path, as it is for sessions, and the token lifetime is the backstop when the notice is lost.","evaluate":{"method":"scenario"},"ref":"TOK-007","area":"03-identity","section":"Verify and revoke","lifecycle":"active","boundary":"b-6","boundaryDetail":"`grant`","traces":["g-28"],"milestone":4,"inSection":"sec-tokens-3","realisation":"checked"},
    {"id":"tok-008","kind":"requirement","statement":"Rotation of a signing key SHALL leave tokens signed by the previous key verifiable until they expire.","rationale":"Rotation is routine and breaks nobody.","evaluate":{"method":"scenario"},"ref":"TOK-008","area":"03-identity","section":"Verify and revoke","lifecycle":"active","boundary":"b-6","boundaryDetail":"`GET /keys`","traces":["g-10"],"milestone":4,"inSection":"sec-tokens-3","realisation":"checked"},
    {"id":"tok-009","kind":"requirement","statement":"Token introspection SHALL report the scopes, the subject and the expiry of a token to a caller permitted to ask.","rationale":"An agent can find out what its own token allows.","evaluate":{"method":"scenario"},"ref":"TOK-009","area":"03-identity","section":"Verify and revoke","lifecycle":"active","boundary":"b-6","boundaryDetail":"`POST /introspect`","traces":["g-24"],"milestone":4,"inSection":"sec-tokens-3","realisation":"checked"},
    {"id":"sch-001","kind":"requirement","statement":"A job scheduled for a time SHALL be offered to a worker no earlier than that time.","rationale":"The due time is a promise in one direction.","evaluate":{"method":"scenario"},"ref":"SCH-001","area":"04-automation","section":"Due work","lifecycle":"active","boundary":"b-7","boundaryDetail":"`job`","traces":["g-13"],"milestone":5,"inSection":"sec-scheduling-2","realisation":"checked"},
    {"id":"sch-002","kind":"requirement","statement":"A due job SHALL start within 5 seconds of its due time at the 99th percentile.","rationale":"The other direction, as a measured bound.","evaluate":{"method":"budget"},"ref":"SCH-002","area":"04-automation","section":"Due work","lifecycle":"active","boundary":"b-7","boundaryDetail":"`job`","traces":["g-13"],"milestone":5,"inSection":"sec-scheduling-2","realisation":"operational"},
    {"id":"sch-003","kind":"requirement","statement":"A recurring schedule SHALL create its next job in the transaction that completes the current one.","rationale":"A crash between the two cannot lose the recurrence.","evaluate":{"method":"scenario"},"ref":"SCH-003","area":"04-automation","section":"Due work","lifecycle":"active","boundary":"b-7","boundaryDetail":"`schedule`","traces":["g-13"],"milestone":5,"inSection":"sec-scheduling-2","realisation":"checked"},
    {"id":"sch-004","kind":"requirement","statement":"A committed domain event SHALL create the jobs of the triggers subscribed to it in the transaction that commits the event.","rationale":"An event and its consequences are one fact.","evaluate":{"method":"scenario"},"ref":"SCH-004","area":"04-automation","section":"Due work","lifecycle":"active","boundary":"b-7","boundaryDetail":"`trigger`","traces":["g-13"],"milestone":5,"inSection":"sec-scheduling-2","realisation":"checked"},
    {"id":"sch-005","kind":"requirement","statement":"A paused schedule SHALL create no job.","rationale":"Pausing is the safe way to stop automation while looking at it.","evaluate":{"method":"scenario"},"ref":"SCH-005","area":"04-automation","section":"Due work","lifecycle":"active","boundary":"b-7","boundaryDetail":"`schedule`","traces":["g-13"],"milestone":5,"inSection":"sec-scheduling-2","realisation":"checked"},
    {"id":"sch-006","kind":"requirement","statement":"Cancelling a job SHALL prevent every later attempt of it.","rationale":"Cancel is final.","evaluate":{"method":"scenario"},"ref":"SCH-006","area":"04-automation","section":"Due work","lifecycle":"active","boundary":"b-7","boundaryDetail":"`job`","traces":["g-13"],"milestone":5,"inSection":"sec-scheduling-2","realisation":"checked"},
    {"id":"sch-007","kind":"requirement","statement":"The automation worker SHALL find due work without a query to the database of a tenant that has none.","rationale":"Thousands of idle tenants cost nothing.","evaluate":{"method":"scenario"},"ref":"SCH-007","area":"04-automation","section":"Finding work","lifecycle":"active","boundary":"b-3","boundaryDetail":"`wake index`","traces":["g-4","d-10"],"milestone":5,"inSection":"sec-scheduling-3","realisation":"checked"},
    {"id":"sch-008","kind":"requirement","statement":"A wake index entry SHALL hold a tenant identifier and a due time and no content of a job.","rationale":"The control database learns when, not what.","evaluate":{"method":"property"},"ref":"SCH-008","area":"04-automation","section":"Finding work","lifecycle":"active","boundary":"b-3","boundaryDetail":"`wake index`","traces":["k-2"],"milestone":5,"seam":2,"inSection":"sec-scheduling-3","realisation":"checked"},
    {"id":"sch-009","kind":"requirement","statement":"The queued work of one tenant SHALL leave the due jobs of other tenants within the start budget.","rationale":"Fairness between tenants is part of the schedule.","evaluate":{"method":"scenario"},"ref":"SCH-009","area":"04-automation","section":"Finding work","lifecycle":"active","boundary":"b-7","boundaryDetail":"`job`","traces":["g-4"],"milestone":5,"inSection":"sec-scheduling-3","realisation":"checked"},
    {"id":"sch-010","kind":"requirement","statement":"A job whose worker stops responding SHALL be offered to another worker after its lease expires.","rationale":"Modelled as the lease flow.","evaluate":{"method":"scenario"},"ref":"SCH-010","area":"04-automation","section":"Failure","lifecycle":"active","boundary":"b-7","boundaryDetail":"`lease`","traces":["g-14"],"milestone":5,"inSection":"sec-scheduling-4","realisation":"checked"},
    {"id":"sch-011","kind":"requirement","statement":"A result presented with a superseded lease token SHALL be refused.","rationale":"The stalled worker that wakes up cannot overwrite its replacement.","evaluate":{"method":"property"},"ref":"SCH-011","area":"04-automation","section":"Failure","lifecycle":"active","boundary":"b-7","boundaryDetail":"`fencing token`","traces":["k-17","d-11"],"milestone":5,"inSection":"sec-scheduling-4","realisation":"checked"},
    {"id":"sch-012","kind":"requirement","statement":"A job SHALL end in exactly one recorded outcome.","rationale":"Completed, failed or cancelled: one of them, once.","evaluate":{"method":"property"},"ref":"SCH-012","area":"04-automation","section":"Failure","lifecycle":"active","boundary":"b-7","boundaryDetail":"`job`","traces":["g-14"],"milestone":5,"inSection":"sec-scheduling-4","realisation":"checked"},
    {"id":"sch-013","kind":"requirement","statement":"A failed attempt SHALL be retried after a delay that grows with the number of attempts.","rationale":"A struggling dependency is given room.","evaluate":{"method":"scenario"},"ref":"SCH-013","area":"04-automation","section":"Failure","lifecycle":"active","boundary":"b-7","boundaryDetail":"`job`","traces":["g-14"],"milestone":5,"inSection":"sec-scheduling-4","realisation":"checked"},
    {"id":"sch-014","kind":"requirement","statement":"A job that exhausts its attempts SHALL be recorded as failed with the error of each attempt.","rationale":"Dead work is visible and explained, not silently dropped.","evaluate":{"method":"scenario"},"ref":"SCH-014","area":"04-automation","section":"Failure","lifecycle":"active","boundary":"b-7","boundaryDetail":"`job`","traces":["g-14","g-27"],"milestone":5,"inSection":"sec-scheduling-4","realisation":"checked"},
    {"id":"sch-015","kind":"requirement","statement":"An effect that carries an idempotency key SHALL be applied once however many times its job is attempted.","rationale":"At least once in, exactly once out.","evaluate":{"method":"property"},"ref":"SCH-015","area":"04-automation","section":"Failure","lifecycle":"active","boundary":"b-7","boundaryDetail":"`idempotency key`","traces":["g-15","d-12"],"milestone":5,"inSection":"sec-scheduling-4","realisation":"checked"},
    {"id":"sch-016","kind":"requirement","statement":"Two simulations of the automation worker with one seed SHALL produce equal traces.","rationale":"Scheduling decisions are kernel decisions, so they are simulable like the rest.","evaluate":{"method":"property"},"ref":"SCH-016","area":"04-automation","section":"Failure","lifecycle":"active","boundary":"b-20","boundaryDetail":"`strata_simulation::engine::run`","traces":["k-11","g-42"],"milestone":5,"inSection":"sec-scheduling-4","realisation":"checked"},
    {"id":"wfl-001","kind":"requirement","statement":"A workflow definition SHALL be stored as tenant metadata under the schema version.","rationale":"Workflows are versioned, migrated and inspected like the rest of the schema.","evaluate":{"method":"scenario"},"ref":"WFL-001","area":"04-automation","section":"Definition and activation","lifecycle":"active","boundary":"b-8","boundaryDetail":"`workflow definition`","traces":["g-16","g-31"],"milestone":5,"inSection":"sec-workflows-2","realisation":"checked"},
    {"id":"wfl-002","kind":"requirement","statement":"Activation of a workflow definition SHALL be refused until a projection of it has run.","rationale":"Automation is tried on history before it runs on the present.","evaluate":{"method":"scenario"},"ref":"WFL-002","area":"04-automation","section":"Definition and activation","lifecycle":"active","boundary":"b-20","boundaryDetail":"`projection`","traces":["g-16"],"milestone":5,"inSection":"sec-workflows-2","realisation":"checked"},
    {"id":"wfl-003","kind":"requirement","statement":"Each workflow step SHALL be decided by the kernel from the recorded state of the run.","rationale":"A run can be replayed, and a step cannot depend on anything unrecorded.","evaluate":{"method":"property"},"ref":"WFL-003","area":"04-automation","section":"Definition and activation","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["k-9","k-11","d-13"],"milestone":5,"inSection":"sec-workflows-2","realisation":"checked"},
    {"id":"wfl-004","kind":"requirement","statement":"A workflow run SHALL continue from its last recorded step after a process restart.","rationale":"The run is a record, not a thread.","evaluate":{"method":"scenario"},"ref":"WFL-004","area":"04-automation","section":"Definition and activation","lifecycle":"active","boundary":"b-8","boundaryDetail":"`workflow run`","traces":["g-14"],"milestone":5,"inSection":"sec-workflows-2","realisation":"checked"},
    {"id":"wfl-005","kind":"requirement","statement":"A failed step SHALL run the declared compensation steps of the completed steps in reverse order.","rationale":"A workflow that cannot finish undoes what it can.","evaluate":{"method":"scenario"},"ref":"WFL-005","area":"04-automation","section":"Definition and activation","lifecycle":"active","boundary":"b-8","boundaryDetail":"`compensation`","traces":["g-14"],"milestone":5,"inSection":"sec-workflows-2","realisation":"checked"},
    {"id":"wfl-006","kind":"requirement","statement":"A workflow waiting for approval SHALL continue only after a principal permitted by its policy approves.","rationale":"People stay in the loop where the tenant puts them.","evaluate":{"method":"scenario"},"ref":"WFL-006","area":"04-automation","section":"Definition and activation","lifecycle":"active","boundary":"b-8","boundaryDetail":"`approval step`","traces":["g-26"],"milestone":5,"inSection":"sec-workflows-2","realisation":"checked"},
    {"id":"wfl-007","kind":"requirement","statement":"A step that calls an external address SHALL be carried out by the connector runner after the transaction of the step commits.","rationale":"No call is made for a step that did not happen.","evaluate":{"method":"scenario"},"ref":"WFL-007","area":"04-automation","section":"External effects","lifecycle":"active","boundary":"b-8","boundaryDetail":"`call step`","traces":["k-9","d-506"],"milestone":5,"inSection":"sec-workflows-3","realisation":"checked"},
    {"id":"wfl-008","kind":"requirement","statement":"An external call SHALL be refused when its address resolves to a private, link-local or loopback network.","rationale":"Tenant automation is not a way into the platform's network.","evaluate":{"method":"scenario"},"ref":"WFL-008","area":"04-automation","section":"External effects","lifecycle":"active","boundary":"b-8","boundaryDetail":"`call step`","traces":["g-47"],"milestone":5,"inSection":"sec-workflows-3","realisation":"checked"},
    {"id":"wfl-009","kind":"requirement","statement":"A connector secret SHALL be readable only by the connector runner at the time of the call.","rationale":"Secrets are write-only to everyone else, agents included.","evaluate":{"method":"property"},"ref":"WFL-009","area":"04-automation","section":"External effects","lifecycle":"active","boundary":"b-17","boundaryDetail":"`connector secret`","traces":["g-40","g-47"],"milestone":5,"inSection":"sec-workflows-3","realisation":"checked"},
    {"id":"wfl-010","kind":"requirement","statement":"A webhook delivery SHALL carry a signature over its body made with the secret of its subscription.","rationale":"The receiver can tell the platform sent it.","evaluate":{"method":"scenario"},"ref":"WFL-010","area":"04-automation","section":"External effects","lifecycle":"active","boundary":"b-8","boundaryDetail":"`webhook`","traces":["g-13"],"milestone":5,"inSection":"sec-workflows-3","realisation":"checked"},
    {"id":"wfl-011","kind":"requirement","statement":"A content record with a publication time SHALL be published by a job at that time.","rationale":"Scheduled publication is the first workflow every publication needs.","evaluate":{"method":"scenario"},"ref":"WFL-011","area":"04-automation","section":"External effects","lifecycle":"active","boundary":"b-7","boundaryDetail":"`publication time`","traces":["g-17"],"milestone":5,"inSection":"sec-workflows-3","realisation":"checked"},
    {"id":"cpy-001","kind":"requirement","statement":"Each stored copy class SHALL have the owner, key, freshness bound and erasure point that the copy class table states.","rationale":"The table is the design. The data model in this specification is checked against the same rules.","evaluate":{"method":"conformance"},"ref":"CPY-001","area":"05-delivery","section":"Classes and keys","lifecycle":"active","boundary":"b-15","boundaryDetail":"`copy class`","traces":["k-8"],"milestone":6,"cases":["cases-copy-classes"],"inSection":"sec-copies-2","realisation":"construction"},
    {"id":"cpy-002","kind":"requirement","statement":"The key of a stored view copy SHALL contain the tenant, the view, its arguments, the audience class, the schema version and the revision of each object type it depends on.","rationale":"A change produces a new key, so a stale entry cannot be read by mistake.","evaluate":{"method":"property"},"ref":"CPY-002","area":"05-delivery","section":"Classes and keys","lifecycle":"active","boundary":"b-15","boundaryDetail":"`copy key`","traces":["d-14","g-19"],"milestone":6,"inSection":"sec-copies-2","realisation":"checked"},
    {"id":"cpy-003","kind":"requirement","statement":"A stored copy key SHALL begin with the tenant identifier.","rationale":"No two tenants can ever address the same entry.","evaluate":{"method":"property"},"ref":"CPY-003","area":"05-delivery","section":"Classes and keys","lifecycle":"active","boundary":"b-15","boundaryDetail":"`copy key`","traces":["g-20"],"milestone":6,"inSection":"sec-copies-2","realisation":"checked"},
    {"id":"cpy-004","kind":"requirement","statement":"Every read result SHALL name the object types and records it depends on.","rationale":"Invalidation is exact because the kernel says what an answer was made from.","evaluate":{"method":"property"},"ref":"CPY-004","area":"05-delivery","section":"Classes and keys","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::read`","traces":["d-14","g-19"],"milestone":6,"seam":2,"inSection":"sec-copies-2","realisation":"checked"},
    {"id":"cpy-005","kind":"requirement","statement":"The audience class of a principal for a read SHALL be derived by the kernel from the policies of the tenant.","rationale":"Who may share a copy is an authorisation question and has one answer.","evaluate":{"method":"property"},"ref":"CPY-005","area":"05-delivery","section":"Classes and keys","lifecycle":"active","boundary":"b-1","boundaryDetail":"`audience class`","traces":["d-15","k-13"],"milestone":6,"seam":3,"inSection":"sec-copies-2","realisation":"checked"},
    {"id":"cpy-006","kind":"requirement","statement":"A view copy stored for one audience class SHALL be served only to principals of that class.","rationale":"A draft stored for editors is not an answer for readers.","evaluate":{"method":"property"},"ref":"CPY-006","area":"05-delivery","section":"Isolation","lifecycle":"active","boundary":"b-15","boundaryDetail":"`audience class`","traces":["g-20"],"milestone":6,"inSection":"sec-copies-3","realisation":"checked"},
    {"id":"cpy-007","kind":"requirement","statement":"A shared copy SHALL contain no personal field and no field that depends on the requesting principal.","rationale":"Also evaluated by Exegra on the data model of this specification.","evaluate":{"method":"property"},"ref":"CPY-007","area":"05-delivery","section":"Isolation","lifecycle":"active","boundary":"b-15","boundaryDetail":"`shared copy`","traces":["k-7"],"milestone":6,"inSection":"sec-copies-3","realisation":"construction"},
    {"id":"cpy-008","kind":"requirement","statement":"A committed change SHALL supersede every stored copy that depends on a record it changed.","rationale":"Version keys do this for view copies, and tags do it where a key cannot.","evaluate":{"method":"scenario"},"ref":"CPY-008","area":"05-delivery","section":"Freshness and failure","lifecycle":"active","boundary":"b-15","boundaryDetail":"`remove by tag`","traces":["g-19"],"milestone":6,"inSection":"sec-copies-4","realisation":"checked"},
    {"id":"cpy-009","kind":"requirement","statement":"A committed change SHALL be visible through the delivery interface within 2 seconds at the 99th percentile.","rationale":"The freshness bound of the shared copy tier. A reader served from the edge sees the change within the edge bound of EDG-007.","evaluate":{"method":"budget"},"ref":"CPY-009","area":"05-delivery","section":"Freshness and failure","lifecycle":"active","boundary":"b-9","boundaryDetail":"`delivery interface`","traces":["g-19"],"milestone":6,"inSection":"sec-copies-4","realisation":"operational"},
    {"id":"cpy-010","kind":"requirement","statement":"At least 95 percent of delivery requests for published content SHALL be answered without a query to the tenant database.","rationale":"The point of the design, measured.","evaluate":{"method":"budget"},"ref":"CPY-010","area":"05-delivery","section":"Freshness and failure","lifecycle":"active","boundary":"b-9","boundaryDetail":"`delivery interface`","traces":["g-18"],"milestone":6,"inSection":"sec-copies-4","realisation":"operational"},
    {"id":"cpy-011","kind":"requirement","statement":"An outage of the copy store SHALL be answered by reads from the tenant database without an error to the reader.","rationale":"A copy store is an optimisation and its loss is a slowdown.","evaluate":{"method":"scenario"},"ref":"CPY-011","area":"05-delivery","section":"Freshness and failure","lifecycle":"active","boundary":"b-15","boundaryDetail":"`copy store`","traces":["g-18"],"milestone":6,"inSection":"sec-copies-4","realisation":"checked"},
    {"id":"cpy-012","kind":"requirement","statement":"Simultaneous requests for one missing copy SHALL cause one computation of it.","rationale":"A popular page expiring does not become a stampede on one tenant database.","evaluate":{"method":"scenario"},"ref":"CPY-012","area":"05-delivery","section":"Freshness and failure","lifecycle":"active","boundary":"b-15","boundaryDetail":"`copy store`","traces":["g-4"],"milestone":6,"inSection":"sec-copies-4","realisation":"checked"},
    {"id":"cpy-013","kind":"requirement","statement":"Deleting a record SHALL remove every stored copy that holds a field of it within the erasure bound of its class.","rationale":"Erasure reaches copies by design.","evaluate":{"method":"scenario"},"ref":"CPY-013","area":"05-delivery","section":"Freshness and failure","lifecycle":"active","boundary":"b-15","boundaryDetail":"`remove by tag`","traces":["g-22"],"milestone":6,"inSection":"sec-copies-4","realisation":"checked"},
    {"id":"cpy-014","kind":"requirement","statement":"A compiled schema SHALL be reused across requests while the schema version of the tenant is unchanged.","rationale":"The cheapest copy is the one keyed by a version that rarely moves.","evaluate":{"method":"scenario"},"ref":"CPY-014","area":"05-delivery","section":"Freshness and failure","lifecycle":"active","boundary":"b-1","boundaryDetail":"`schema version`","traces":["g-18","d-17"],"milestone":6,"inSection":"sec-copies-4","realisation":"checked"},
    {"id":"edg-001","kind":"requirement","statement":"The edge key of a response SHALL include the host name of its request.","rationale":"Two tenants with the same path are two entries.","evaluate":{"method":"property"},"ref":"EDG-001","area":"05-delivery","section":"Storability","lifecycle":"active","boundary":"b-10","boundaryDetail":"`Host`","traces":["g-20","d-16"],"milestone":6,"inSection":"sec-edge-2","realisation":"checked"},
    {"id":"edg-002","kind":"requirement","statement":"A response that depends on the requesting principal SHALL be marked as not storable by shared intermediaries.","rationale":"Only what is the same for everyone is kept at the edge.","evaluate":{"method":"property"},"ref":"EDG-002","area":"05-delivery","section":"Storability","lifecycle":"active","boundary":"b-10","boundaryDetail":"`Cache-Control`","traces":["k-7"],"milestone":6,"inSection":"sec-edge-2","realisation":"checked"},
    {"id":"edg-003","kind":"requirement","statement":"A published page SHALL carry surrogate keys naming the tenant and each record it was rendered from.","rationale":"The page says what would make it wrong.","evaluate":{"method":"scenario"},"ref":"EDG-003","area":"05-delivery","section":"Storability","lifecycle":"active","boundary":"b-10","boundaryDetail":"`Surrogate-Key`","traces":["g-19","d-16"],"milestone":6,"inSection":"sec-edge-2","realisation":"checked"},
    {"id":"edg-004","kind":"requirement","statement":"Static assets SHALL be served at addresses derived from their content.","rationale":"An asset can be kept at the edge indefinitely because its address changes when it does.","evaluate":{"method":"property"},"ref":"EDG-004","area":"05-delivery","section":"Storability","lifecycle":"active","boundary":"b-10","boundaryDetail":"`asset address`","traces":["g-18"],"milestone":6,"inSection":"sec-edge-2","realisation":"checked"},
    {"id":"edg-005","kind":"requirement","statement":"A committed change SHALL purge the surrogate keys of the records it changed.","rationale":"Driven from the outbox, so a purge follows a commit and nothing else.","evaluate":{"method":"scenario"},"ref":"EDG-005","area":"05-delivery","section":"Purge","lifecycle":"active","boundary":"b-10","boundaryDetail":"`purge`","traces":["g-19"],"milestone":6,"inSection":"sec-edge-3","realisation":"checked"},
    {"id":"edg-006","kind":"requirement","statement":"An edge copy older than its lifetime SHALL be revalidated with the origin before it is served.","rationale":"Modelled as the edge copy flow: the purge is the quick path and the lifetime is the backstop when a purge is lost.","evaluate":{"method":"scenario"},"ref":"EDG-006","area":"05-delivery","section":"Purge","lifecycle":"active","boundary":"b-10","boundaryDetail":"`s-maxage`","traces":["g-19"],"milestone":6,"inSection":"sec-edge-3","realisation":"checked"},
    {"id":"edg-007","kind":"requirement","statement":"A purge SHALL take effect at the edge within 5 seconds at the 99th percentile.","rationale":"The freshness bound of the edge tier.","evaluate":{"method":"budget"},"ref":"EDG-007","area":"05-delivery","section":"Purge","lifecycle":"active","boundary":"b-10","boundaryDetail":"`purge`","traces":["g-19"],"milestone":6,"inSection":"sec-edge-3","realisation":"operational"},
    {"id":"edg-008","kind":"requirement","statement":"Removing a domain binding SHALL purge every edge copy stored under that host name.","rationale":"A domain that leaves takes its copies with it.","evaluate":{"method":"scenario"},"ref":"EDG-008","area":"05-delivery","section":"Purge","lifecycle":"active","boundary":"b-10","boundaryDetail":"`purge`","traces":["g-22"],"milestone":6,"inSection":"sec-edge-3","realisation":"checked"},
    {"id":"edg-009","kind":"requirement","statement":"A tenant SHALL be able to serve its site from a domain name after proving control of that name.","rationale":"Proof first, so one tenant cannot claim another's name.","evaluate":{"method":"scenario"},"ref":"EDG-009","area":"05-delivery","section":"Domains and limits","lifecycle":"active","boundary":"b-3","boundaryDetail":"`domain binding`","traces":["g-21"],"milestone":6,"inSection":"sec-edge-4","realisation":"checked"},
    {"id":"edg-010","kind":"requirement","statement":"The certificate of a tenant domain SHALL be renewed before it expires.","rationale":"Certificates are the platform's job.","evaluate":{"method":"scenario"},"ref":"EDG-010","area":"05-delivery","section":"Domains and limits","lifecycle":"active","boundary":"b-3","boundaryDetail":"`certificate`","traces":["g-21"],"milestone":6,"inSection":"sec-edge-4","realisation":"checked"},
    {"id":"edg-011","kind":"requirement","statement":"A host name bound to no tenant SHALL receive a not-found response without contact with a tenant database.","rationale":"Unknown hosts are answered from the directory copy alone.","evaluate":{"method":"scenario"},"ref":"EDG-011","area":"05-delivery","section":"Domains and limits","lifecycle":"active","boundary":"b-9","boundaryDetail":"`Host`","traces":["g-20"],"milestone":6,"inSection":"sec-edge-4","realisation":"checked"},
    {"id":"edg-012","kind":"requirement","statement":"A private media file SHALL be delivered only through an address signed for the requesting principal with an expiry.","rationale":"Private files use the edge without becoming public.","evaluate":{"method":"scenario"},"ref":"EDG-012","area":"05-delivery","section":"Domains and limits","lifecycle":"active","boundary":"b-10","boundaryDetail":"`signed address`","traces":["g-33","g-20"],"milestone":11,"inSection":"sec-edge-4","realisation":"checked"},
    {"id":"edg-013","kind":"requirement","statement":"A request rate above the limit of a tenant SHALL receive a throttling response at the gateway.","rationale":"Limits are applied before work is done.","evaluate":{"method":"scenario"},"ref":"EDG-013","area":"05-delivery","section":"Domains and limits","lifecycle":"active","boundary":"b-9","boundaryDetail":"`429`","traces":["g-4"],"milestone":6,"inSection":"sec-edge-4","realisation":"checked"},
    {"id":"agt-001","kind":"requirement","statement":"Every operation available through the authoring application SHALL be listed in the operation catalogue with its input schema.","rationale":"There is no capability reachable only through a screen.","evaluate":{"method":"property"},"ref":"AGT-001","area":"06-agents","section":"Discover","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /operations`","traces":["g-23","d-18"],"milestone":7,"inSection":"sec-agents-2","realisation":"checked"},
    {"id":"agt-002","kind":"requirement","statement":"The operation catalogue SHALL mark for the requesting principal each operation that its policies permit it to attempt.","rationale":"An agent plans with what it can do, not with everything that exists.","evaluate":{"method":"scenario"},"ref":"AGT-002","area":"06-agents","section":"Discover","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /operations`","traces":["g-24"],"milestone":7,"inSection":"sec-agents-2","realisation":"checked"},
    {"id":"agt-003","kind":"requirement","statement":"The operation catalogue of a tenant SHALL reflect a change of its schema version without a deployment.","rationale":"Operations over tenant objects come from tenant metadata.","evaluate":{"method":"scenario"},"ref":"AGT-003","area":"06-agents","section":"Discover","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /operations`","traces":["g-23","g-31"],"milestone":7,"inSection":"sec-agents-2","realisation":"checked"},
    {"id":"agt-004","kind":"requirement","statement":"The agent gateway SHALL expose the operation catalogue through the Model Context Protocol.","rationale":"The standard way for agents to find and call tools.","evaluate":{"method":"scenario"},"ref":"AGT-004","area":"06-agents","section":"Discover","lifecycle":"active","boundary":"b-11","boundaryDetail":"`Model Context Protocol`","traces":["g-23","k-14"],"milestone":7,"inSection":"sec-agents-2","realisation":"checked"},
    {"id":"agt-005","kind":"requirement","statement":"The catalogue entry of an operation SHALL name the requirements of this specification that it implements.","rationale":"An agent can ask what an operation is supposed to guarantee.","evaluate":{"method":"scenario"},"ref":"AGT-005","area":"06-agents","section":"Discover","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /operations/{name}`","traces":["g-41"],"milestone":7,"inSection":"sec-agents-2","realisation":"checked"},
    {"id":"agt-006","kind":"requirement","statement":"The platform SHALL publish its component topology, configuration and health in machine-readable form.","rationale":"Self-description is what lets an agent diagnose instead of guess.","evaluate":{"method":"scenario"},"ref":"AGT-006","area":"06-agents","section":"Discover","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /platform`","traces":["g-27"],"milestone":7,"inSection":"sec-agents-2","realisation":"checked"},
    {"id":"agt-007","kind":"requirement","statement":"The agent gateway SHALL deliver to a subscribed agent the domain events that the policies of its principal permit it to read.","rationale":"Watching is the other half of operating.","evaluate":{"method":"scenario"},"ref":"AGT-007","area":"06-agents","section":"Discover","lifecycle":"active","boundary":"b-11","boundaryDetail":"`event stream`","traces":["g-23"],"milestone":7,"inSection":"sec-agents-2","realisation":"checked"},
    {"id":"agt-008","kind":"requirement","statement":"An operation invoked as a dry run SHALL return the state changes it would make without committing them.","rationale":"The kernel already separates deciding from committing.","evaluate":{"method":"scenario"},"ref":"AGT-008","area":"06-agents","section":"Try and explain","lifecycle":"active","boundary":"b-11","boundaryDetail":"`dry run`","traces":["g-24"],"milestone":7,"seam":2,"inSection":"sec-agents-3","realisation":"checked"},
    {"id":"agt-009","kind":"requirement","statement":"A rejected operation SHALL return the checks that failed in machine-readable form.","rationale":"The same evidence a form shows a person.","evaluate":{"method":"scenario"},"ref":"AGT-009","area":"06-agents","section":"Try and explain","lifecycle":"active","boundary":"b-11","boundaryDetail":"`error`","traces":["g-24"],"milestone":7,"inSection":"sec-agents-3","realisation":"checked"},
    {"id":"agt-010","kind":"requirement","statement":"The result of an applied change SHALL name an inverse operation or state that none exists.","rationale":"Reversibility is declared per operation.","evaluate":{"method":"scenario"},"ref":"AGT-010","area":"06-agents","section":"Try and explain","lifecycle":"active","boundary":"b-11","boundaryDetail":"`inverse`","traces":["g-25"],"milestone":7,"inSection":"sec-agents-3","realisation":"checked"},
    {"id":"agt-011","kind":"requirement","statement":"A change classed as risky by tenant policy SHALL be applied only from an approved proposal.","rationale":"Modelled as the proposal flow, with an unapproved apply as its negative.","evaluate":{"method":"scenario"},"ref":"AGT-011","area":"06-agents","section":"Propose and approve","lifecycle":"active","boundary":"b-11","boundaryDetail":"`proposal`","traces":["g-26","d-19"],"milestone":7,"inSection":"sec-agents-4","realisation":"checked"},
    {"id":"agt-012","kind":"requirement","statement":"A proposal SHALL carry the projection of its change against the recorded history of the tenant.","rationale":"The approver sees consequences, not intentions.","evaluate":{"method":"scenario"},"ref":"AGT-012","area":"06-agents","section":"Propose and approve","lifecycle":"active","boundary":"b-20","boundaryDetail":"`proposal`","traces":["g-26","g-44"],"milestone":7,"inSection":"sec-agents-4","realisation":"checked"},
    {"id":"agt-013","kind":"requirement","statement":"An approved proposal SHALL be refused when the revision of the tenant differs from the revision it was projected against.","rationale":"An approval is for one state of the world.","evaluate":{"method":"property"},"ref":"AGT-013","area":"06-agents","section":"Propose and approve","lifecycle":"active","boundary":"b-11","boundaryDetail":"`proposal`","traces":["g-26"],"milestone":7,"inSection":"sec-agents-4","realisation":"checked"},
    {"id":"agt-014","kind":"requirement","statement":"An operation performed by an agent SHALL be authorised by the same policies as that operation performed by a person.","rationale":"There is one authorisation path.","evaluate":{"method":"property"},"ref":"AGT-014","area":"06-agents","section":"Authorise, attribute and limit","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["k-13"],"milestone":7,"inSection":"sec-agents-5","realisation":"checked"},
    {"id":"agt-015","kind":"requirement","statement":"Every operation performed by an agent SHALL be recorded with the agent, the person it acted for and the correlation identifier.","rationale":"Who, for whom, and which request.","evaluate":{"method":"property"},"ref":"AGT-015","area":"06-agents","section":"Authorise, attribute and limit","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit entry`","traces":["g-25"],"milestone":7,"inSection":"sec-agents-5","realisation":"checked"},
    {"id":"agt-016","kind":"requirement","statement":"The requests of a disabled agent SHALL be refused by the agent gateway.","rationale":"The kill switch does not wait for a token to expire.","evaluate":{"method":"scenario"},"ref":"AGT-016","area":"06-agents","section":"Authorise, attribute and limit","lifecycle":"active","boundary":"b-11","boundaryDetail":"`agent state`","traces":["g-28"],"milestone":7,"inSection":"sec-agents-5","realisation":"checked"},
    {"id":"agt-017","kind":"requirement","statement":"An agent that exceeds its operation budget SHALL be refused until the budget window ends.","rationale":"A runaway loop is bounded by volume.","evaluate":{"method":"scenario"},"ref":"AGT-017","area":"06-agents","section":"Authorise, attribute and limit","lifecycle":"active","boundary":"b-11","boundaryDetail":"`operation budget`","traces":["g-28"],"milestone":7,"inSection":"sec-agents-5","realisation":"checked"},
    {"id":"obs-001","kind":"requirement","statement":"Every log line, span and audit entry produced for a request SHALL carry the correlation identifier of that request.","rationale":"One search finds the whole story.","evaluate":{"method":"property"},"ref":"OBS-001","area":"06-agents","section":"Telemetry","lifecycle":"active","boundary":"b-12","boundaryDetail":"`correlation identifier`","traces":["g-29"],"milestone":8,"seam":1,"inSection":"sec-observability-2","realisation":"checked"},
    {"id":"obs-002","kind":"requirement","statement":"Each process of the platform other than the telemetry pipeline, and each store that holds tenant content, SHALL export traces, metrics and logs through the OpenTelemetry protocol.","rationale":"One collector, any backend. A library, an external service and a client program export nothing: the process that hosts or calls it does.","evaluate":{"method":"scenario"},"ref":"OBS-002","area":"06-agents","section":"Telemetry","lifecycle":"active","boundary":"b-12","boundaryDetail":"`OpenTelemetry protocol`","traces":["k-14","g-27","d-21"],"milestone":8,"seam":2,"inSection":"sec-observability-2","realisation":"checked"},
    {"id":"obs-003","kind":"requirement","statement":"Telemetry SHALL carry the tenant identifier and no content of a tenant record.","rationale":"Operational data can be shared with operators and agents that may not read tenant data.","evaluate":{"method":"property"},"ref":"OBS-003","area":"06-agents","section":"Telemetry","lifecycle":"active","boundary":"b-12","boundaryDetail":"`telemetry`","traces":["k-2","g-29"],"milestone":8,"inSection":"sec-observability-2","realisation":"checked"},
    {"id":"obs-004","kind":"requirement","statement":"A component SHALL report readiness only while its dependencies answer.","rationale":"Health that can be trusted for routing and for diagnosis.","evaluate":{"method":"scenario"},"ref":"OBS-004","area":"06-agents","section":"Telemetry","lifecycle":"active","boundary":"b-12","boundaryDetail":"`readiness`","traces":["g-27"],"milestone":8,"seam":2,"inSection":"sec-observability-2","realisation":"checked"},
    {"id":"obs-005","kind":"requirement","statement":"A service level objective SHALL be stored as data with the query that measures it.","rationale":"Objectives are inspectable and changeable by the same means as everything else.","evaluate":{"method":"scenario"},"ref":"OBS-005","area":"06-agents","section":"Telemetry","lifecycle":"active","boundary":"b-12","boundaryDetail":"`service level objective`","traces":["g-27"],"milestone":8,"inSection":"sec-observability-2","realisation":"checked"},
    {"id":"obs-006","kind":"requirement","statement":"An audit entry SHALL contain the hash of the entry before it.","rationale":"The chain is what makes a removal visible.","evaluate":{"method":"property"},"ref":"OBS-006","area":"06-agents","section":"Audit","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit entry`","traces":["g-30","d-20","d-527"],"milestone":8,"seam":3,"inSection":"sec-observability-3","realisation":"checked"},
    {"id":"obs-007","kind":"requirement","statement":"Verification of an audit log from which an entry was removed SHALL report the break.","rationale":"The negative case of the chain.","evaluate":{"method":"scenario"},"ref":"OBS-007","area":"06-agents","section":"Audit","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit verification`","traces":["g-30"],"milestone":8,"inSection":"sec-observability-3","realisation":"checked"},
    {"id":"obs-008","kind":"requirement","statement":"The audit log of a tenant SHALL be exportable by the owner of that tenant.","rationale":"The record belongs to the tenant.","evaluate":{"method":"scenario"},"ref":"OBS-008","area":"06-agents","section":"Audit","lifecycle":"active","boundary":"b-12","boundaryDetail":"`GET /audit`","traces":["g-30","g-11"],"milestone":8,"inSection":"sec-observability-3","realisation":"checked"},
    {"id":"cms-001","kind":"requirement","statement":"The publication template SHALL install as tenant metadata through kernel intents.","rationale":"The blog is data, and installing it exercises the kernel like any other change.","evaluate":{"method":"scenario"},"ref":"CMS-001","area":"07-content","section":"Model","lifecycle":"active","boundary":"b-21","boundaryDetail":"`tenant bundle`","traces":["g-31"],"milestone":1,"inSection":"sec-content-2","realisation":"checked"},
    {"id":"cms-002","kind":"requirement","statement":"A delivery response SHALL be produced from named queries and view definitions held as tenant metadata.","rationale":"No page is written into platform code.","evaluate":{"method":"scenario"},"ref":"CMS-002","area":"07-content","section":"Model","lifecycle":"active","boundary":"b-9","boundaryDetail":"`view`","traces":["g-31"],"milestone":1,"inSection":"sec-content-2","realisation":"checked"},
    {"id":"cms-003","kind":"requirement","statement":"A draft SHALL be invisible to principals whose policies permit published content alone.","rationale":"Visibility is policy, evaluated by the kernel.","evaluate":{"method":"scenario"},"ref":"CMS-003","area":"07-content","section":"Model","lifecycle":"active","boundary":"b-9","boundaryDetail":"`view`","traces":["g-20"],"milestone":1,"inSection":"sec-content-2","realisation":"checked"},
    {"id":"cms-004","kind":"requirement","statement":"Tenant-authored rich text SHALL reach the browser as structured blocks with markup left as text.","rationale":"Nothing a tenant writes is parsed as HTML.","evaluate":{"method":"example"},"ref":"CMS-004","area":"07-content","section":"Model","lifecycle":"active","boundary":"b-9","boundaryDetail":"`strata_substrate::markdown::parse`","traces":["k-12"],"milestone":1,"inSection":"sec-content-2","realisation":"checked"},
    {"id":"cms-005","kind":"requirement","statement":"A theme value that is not a value of the token schema SHALL be rejected.","rationale":"A tenant selects tokens and supplies no style.","evaluate":{"method":"example"},"ref":"CMS-005","area":"07-content","section":"Model","lifecycle":"active","boundary":"b-21","boundaryDetail":"`theme tokens`","traces":["k-12"],"milestone":1,"inSection":"sec-content-2","realisation":"checked"},
    {"id":"cms-006","kind":"requirement","statement":"Each published version of a record SHALL be retrievable.","rationale":"History is kept, not reconstructed.","evaluate":{"method":"scenario"},"ref":"CMS-006","area":"07-content","section":"Versions, media and languages","lifecycle":"active","boundary":"b-9","boundaryDetail":"`GET /records/{id}/versions`","traces":["g-32"],"milestone":11,"inSection":"sec-content-3","realisation":"checked"},
    {"id":"cms-007","kind":"requirement","statement":"Restoring an earlier version SHALL create a new version with the earlier content.","rationale":"Restore moves forward, so history stays linear.","evaluate":{"method":"scenario"},"ref":"CMS-007","area":"07-content","section":"Versions, media and languages","lifecycle":"active","boundary":"b-9","boundaryDetail":"`POST /records/{id}/restore`","traces":["g-32"],"milestone":11,"inSection":"sec-content-3","realisation":"checked"},
    {"id":"cms-008","kind":"requirement","statement":"An uploaded file SHALL be stored in the file namespace of its tenant under its content hash.","rationale":"Files follow the tenant like records do.","evaluate":{"method":"scenario"},"ref":"CMS-008","area":"07-content","section":"Versions, media and languages","lifecycle":"active","boundary":"b-14","boundaryDetail":"`file store`","traces":["g-33"],"milestone":11,"seam":2,"inSection":"sec-content-3","realisation":"checked"},
    {"id":"cms-009","kind":"requirement","statement":"A rendition SHALL be produced from a stored file by a job.","rationale":"Slow work is scheduled work.","evaluate":{"method":"scenario"},"ref":"CMS-009","area":"07-content","section":"Versions, media and languages","lifecycle":"active","boundary":"b-7","boundaryDetail":"`rendition job`","traces":["g-33"],"milestone":11,"inSection":"sec-content-3","realisation":"checked"},
    {"id":"cms-010","kind":"requirement","statement":"A record requested in a language it lacks SHALL be answered in the fallback language of the tenant.","rationale":"A missing translation is not a missing page.","evaluate":{"method":"scenario"},"ref":"CMS-010","area":"07-content","section":"Versions, media and languages","lifecycle":"active","boundary":"b-9","boundaryDetail":"`Accept-Language`","traces":["g-34"],"milestone":11,"inSection":"sec-content-3","realisation":"checked"},
    {"id":"cms-011","kind":"requirement","statement":"A preview SHALL render unpublished content through the view definitions that delivery uses.","rationale":"What the author sees is what readers will get.","evaluate":{"method":"scenario"},"ref":"CMS-011","area":"07-content","section":"Versions, media and languages","lifecycle":"active","boundary":"b-9","boundaryDetail":"`preview`","traces":["g-35"],"milestone":11,"inSection":"sec-content-3","realisation":"checked"},
    {"id":"cms-012","kind":"requirement","statement":"The authoring application SHALL meet WCAG 2.2 level AA.","rationale":"Authors are users too.","evaluate":{"method":"example"},"ref":"CMS-012","area":"07-content","section":"Versions, media and languages","lifecycle":"active","boundary":"b-13","boundaryDetail":"`authoring application`","traces":["g-45"],"milestone":11,"inSection":"sec-content-3","realisation":"checked"},
    {"id":"dep-001","kind":"requirement","statement":"A single command SHALL start every platform component and its dependencies in containers on one machine.","rationale":"The whole system is something a developer or an agent can hold.","evaluate":{"method":"scenario"},"ref":"DEP-001","area":"08-platform","section":"Local stack and seams","lifecycle":"active","boundary":"b-19","boundaryDetail":"`compose file`","traces":["g-36","d-22"],"milestone":2,"inSection":"sec-platform-2","realisation":"checked"},
    {"id":"dep-002","kind":"requirement","statement":"The local stack SHALL start without credentials for a cloud provider.","rationale":"No account, no bill, no network.","evaluate":{"method":"scenario"},"ref":"DEP-002","area":"08-platform","section":"Local stack and seams","lifecycle":"active","boundary":"b-19","boundaryDetail":"`compose file`","traces":["k-10"],"milestone":2,"inSection":"sec-platform-2","realisation":"checked"},
    {"id":"dep-003","kind":"requirement","statement":"Each infrastructure seam SHALL have the contract, the local adapter and the cloud adapter that the seam table names.","rationale":"The table is the list of everything that may differ between local and cloud.","evaluate":{"method":"conformance"},"ref":"DEP-003","area":"08-platform","section":"Local stack and seams","lifecycle":"active","boundary":"b-19","boundaryDetail":"`seam`","traces":["g-38","d-24"],"milestone":2,"cases":["cases-seams"],"inSection":"sec-platform-2","realisation":"checked"},
    {"id":"dep-004","kind":"requirement","statement":"Each adapter of a seam SHALL pass the conformance suite of that seam.","rationale":"An adapter is accepted by behaviour, as the store adapters already are.","evaluate":{"method":"scenario"},"ref":"DEP-004","area":"08-platform","section":"Local stack and seams","lifecycle":"active","boundary":"b-19","boundaryDetail":"`conformance suite`","traces":["g-38"],"milestone":2,"inSection":"sec-platform-2","realisation":"checked"},
    {"id":"dep-005","kind":"requirement","statement":"A request SHALL be answerable by every running instance of the component it is addressed to.","rationale":"Instances are interchangeable, so they can be added, removed and replaced.","evaluate":{"method":"scenario"},"ref":"DEP-005","area":"08-platform","section":"Local stack and seams","lifecycle":"active","boundary":"b-19","boundaryDetail":"`instance`","traces":["k-5"],"milestone":2,"inSection":"sec-platform-2","realisation":"checked"},
    {"id":"dep-006","kind":"requirement","statement":"A component SHALL read its configuration from its environment.","rationale":"The image is the same everywhere and only the environment differs.","evaluate":{"method":"scenario"},"ref":"DEP-006","area":"08-platform","section":"Local stack and seams","lifecycle":"active","boundary":"b-19","boundaryDetail":"`environment`","traces":["g-37","d-510"],"milestone":2,"inSection":"sec-platform-2","realisation":"checked"},
    {"id":"dep-007","kind":"requirement","statement":"The cloud profile SHALL be created from version-controlled infrastructure definitions without a manual step.","rationale":"An environment is reproducible, and an agent can read what it is made of.","evaluate":{"method":"scenario"},"ref":"DEP-007","area":"08-platform","section":"Cloud profile","lifecycle":"active","boundary":"b-19","boundaryDetail":"`infrastructure modules`","traces":["g-37","d-23","d-501","d-502"],"milestone":12,"inSection":"sec-platform-3","realisation":"checked"},
    {"id":"dep-008","kind":"requirement","statement":"A component image SHALL run unchanged in the local stack and in the cloud profile.","rationale":"What was tested is what is deployed.","evaluate":{"method":"scenario"},"ref":"DEP-008","area":"08-platform","section":"Cloud profile","lifecycle":"active","boundary":"b-19","boundaryDetail":"`image`","traces":["g-37"],"milestone":12,"inSection":"sec-platform-3","realisation":"checked"},
    {"id":"dep-009","kind":"requirement","statement":"A release SHALL refuse no request that the live colour of its component can answer.","rationale":"Releases are routine, and each is a colour switch (REL-566 to REL-568).","evaluate":{"method":"scenario"},"ref":"DEP-009","area":"08-platform","section":"Cloud profile","lifecycle":"active","boundary":"b-19","boundaryDetail":"`deployment`","traces":["g-37"],"milestone":12,"inSection":"sec-platform-3","realisation":"checked"},
    {"id":"dep-010","kind":"requirement","statement":"After the loss of one zone the platform SHALL serve requests again within 15 minutes.","rationale":"The recovery time objective.","evaluate":{"method":"budget"},"ref":"DEP-010","area":"08-platform","section":"Cloud profile","lifecycle":"active","boundary":"b-19","boundaryDetail":"`zone loss`","traces":["g-39"],"milestone":12,"inSection":"sec-platform-3","realisation":"operational"},
    {"id":"dep-011","kind":"requirement","statement":"A restore inside the restore window SHALL lose at most 5 minutes of committed changes (the recovery point objective, and not the length of the window, which is D-522 and OPS-1213).","rationale":"The recovery point objective.","evaluate":{"method":"budget"},"ref":"DEP-011","area":"08-platform","section":"Cloud profile","lifecycle":"active","boundary":"b-19","boundaryDetail":"`restore`","traces":["g-39"],"milestone":12,"inSection":"sec-platform-3","realisation":"operational"},
    {"id":"sec-001","kind":"requirement","statement":"The stored data of each tenant SHALL be encrypted under a key held for that tenant alone.","rationale":"One tenant's key opens nothing else.","evaluate":{"method":"property"},"ref":"SEC-001","area":"08-platform","section":"Keys and credentials","lifecycle":"active","boundary":"b-17","boundaryDetail":"`data key`","traces":["g-40","d-25","d-505"],"milestone":2,"seam":2,"inSection":"sec-platform-4","realisation":"checked"},
    {"id":"sec-002","kind":"requirement","statement":"Destroying the key of a tenant SHALL make the stored data and the backups of that tenant unreadable.","rationale":"Deletion that reaches backups.","evaluate":{"method":"scenario"},"ref":"SEC-002","area":"08-platform","section":"Keys and credentials","lifecycle":"active","boundary":"b-17","boundaryDetail":"`destroy key`","traces":["g-40"],"milestone":2,"inSection":"sec-platform-4","realisation":"checked"},
    {"id":"sec-003","kind":"requirement","statement":"A secret SHALL be stored only in encrypted form, with its wrapping key held by the key service.","rationale":"The database alone is not enough to read a secret.","evaluate":{"method":"scenario"},"ref":"SEC-003","area":"08-platform","section":"Keys and credentials","lifecycle":"active","boundary":"b-17","boundaryDetail":"`wrap`","traces":["g-40"],"milestone":3,"inSection":"sec-platform-4","realisation":"checked"},
    {"id":"sec-004","kind":"requirement","statement":"A call between platform components SHALL carry a credential issued to the calling component.","rationale":"Replaces the single shared service token of the prototype.","evaluate":{"method":"scenario"},"ref":"SEC-004","area":"08-platform","section":"Keys and credentials","lifecycle":"active","boundary":"b-6","boundaryDetail":"`component credential`","traces":["k-6","g-12"],"milestone":2,"inSection":"sec-platform-4","realisation":"checked"},
    {"id":"sec-005","kind":"requirement","statement":"A platform component SHALL reach a tenant database only through the store contract.","rationale":"Checked structurally by Exegra on the component model and by Concordance on the code.","evaluate":{"method":"property"},"ref":"SEC-005","area":"08-platform","section":"Keys and credentials","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["k-3"],"milestone":2,"inSection":"sec-platform-4","realisation":"construction"},
    {"id":"asr-001","kind":"requirement","statement":"The gate SHALL fail while a requirement of a started milestone has no proof with a recorded passing result.","rationale":"Done is something the tools say, not something a person says.","evaluate":{"method":"scenario"},"ref":"ASR-001","area":"08-platform","section":"Assurance","lifecycle":"active","boundary":"b-19","boundaryDetail":"`gate`","traces":["g-41","k-15","d-26"],"milestone":2,"inSection":"sec-platform-5","realisation":"checked"},
    {"id":"asr-002","kind":"requirement","statement":"Each behaviour claim that Exegra evaluates in this specification SHALL declare a run that violates it.","rationale":"A check that cannot fail shows nothing.","evaluate":{"method":"scenario"},"ref":"ASR-002","area":"08-platform","section":"Assurance","lifecycle":"active","boundary":"b-20","boundaryDetail":"`behaviour claim`","traces":["g-42"],"milestone":2,"inSection":"sec-platform-5","realisation":"checked"},
    {"id":"ops-300","kind":"requirement","statement":"The reference load SHALL hold the tenant, request, payload and connection values that the reference load table states.","rationale":"Every budget is measured under one stated load, so the numbers mean the same in every run.","evaluate":{"method":"conformance"},"ref":"OPS-300","area":"09-operations","section":"Reference load","lifecycle":"active","boundary":"b-19","boundaryDetail":"`benchmark harness`","traces":["g-300","g-4","d-518"],"milestone":2,"cases":["cases-reference-load"],"inSection":"sec-operations-2","realisation":"checked"},
    {"id":"ops-301","kind":"requirement","statement":"When the work queued for a cluster is at the queue limit of that cluster, the gateway SHALL refuse a further request for that cluster with a throttling response, without queuing it.","rationale":"Refusing early keeps a backlog from turning every request into a late failure.","evaluate":{"method":"scenario"},"ref":"OPS-301","area":"09-operations","section":"Admission and deadlines","lifecycle":"active","boundary":"b-9","boundaryDetail":"`429`","traces":["g-301","k-300"],"milestone":6,"inSection":"sec-operations-3","realisation":"checked"},
    {"id":"ops-302","kind":"requirement","statement":"Under overload, the gateway SHALL refuse requests for authoring and sign-in before it refuses requests for published content.","rationale":"Published content is the part of the platform that readers depend on most.","evaluate":{"method":"scenario"},"ref":"OPS-302","area":"09-operations","section":"Admission and deadlines","lifecycle":"active","boundary":"b-9","boundaryDetail":"`429`","traces":["g-301","g-18"],"milestone":6,"inSection":"sec-operations-3","realisation":"checked"},
    {"id":"ops-303","kind":"requirement","statement":"A request admitted by the gateway SHALL receive a final response within 10 seconds, counting the retries it made.","rationale":"A caller waits a bounded time, whatever the dependencies below the gateway are doing.","evaluate":{"method":"budget"},"ref":"OPS-303","area":"09-operations","section":"Admission and deadlines","lifecycle":"active","boundary":"b-9","boundaryDetail":"`gateway request`","traces":["g-301"],"milestone":6,"inSection":"sec-operations-3","realisation":"operational"},
    {"id":"ops-304","kind":"requirement","statement":"A slow call to an external address SHALL occupy connector capacity only for the tenant that made the call.","rationale":"One tenant's slow endpoint does not starve the connectors of other tenants.","evaluate":{"method":"scenario"},"ref":"OPS-304","area":"09-operations","section":"Dependencies and retries","lifecycle":"active","boundary":"b-8","boundaryDetail":"`connector slot`","traces":["g-4","g-301"],"milestone":5,"inSection":"sec-operations-4","realisation":"checked"},
    {"id":"ops-305","kind":"requirement","statement":"Every retry between platform components SHALL be bounded in attempts, in total time and by jitter in its delay.","rationale":"Unbounded retries turn one failing dependency into a load that keeps it failing.","evaluate":{"method":"property"},"ref":"OPS-305","area":"09-operations","section":"Dependencies and retries","lifecycle":"active","boundary":"b-19","boundaryDetail":"`retry policy`","traces":["g-301"],"milestone":2,"inSection":"sec-operations-4","realisation":"checked"},
    {"id":"ops-306","kind":"requirement","statement":"When the retries of one component to one dependency exceed the share of its first attempts that D-700 states within the window that D-700 states, the component SHALL make no further retries to that dependency until that window ends.","rationale":"A retry budget gives a struggling dependency room to recover.","evaluate":{"method":"scenario"},"ref":"OPS-306","area":"09-operations","section":"Dependencies and retries","lifecycle":"active","boundary":"b-19","boundaryDetail":"`retry budget`","traces":["g-301","d-700"],"milestone":2,"inSection":"sec-operations-4","realisation":"checked"},
    {"id":"ops-307","kind":"requirement","statement":"When calls from a component to a dependency keep failing, the component SHALL stop calling that dependency for the cool-down period that D-700 states, answering from its stored copies or refusing without waiting.","rationale":"A dependency that is down is answered from what the platform already holds, not called again at once.","evaluate":{"method":"scenario"},"ref":"OPS-307","area":"09-operations","section":"Dependencies and retries","lifecycle":"active","boundary":"b-19","boundaryDetail":"`circuit`","traces":["g-301","d-700"],"milestone":2,"inSection":"sec-operations-4","realisation":"checked"},
    {"id":"ops-308","kind":"requirement","statement":"After every instance of a component restarts, the requests that refill its stored copies SHALL be released at the rate that D-700 states in each cluster.","rationale":"A restart of the whole fleet otherwise sends every tenant's first read to its database at once.","evaluate":{"method":"scenario"},"ref":"OPS-308","area":"09-operations","section":"Dependencies and retries","lifecycle":"active","boundary":"b-15","boundaryDetail":"`copy store`","traces":["g-301","g-4","d-700"],"milestone":6,"inSection":"sec-operations-4","realisation":"checked"},
    {"id":"ops-309","kind":"requirement","statement":"The platform SHALL report, in each cluster, the time remaining before each capacity measure reaches its limit, computed from the trend of its recent window.","rationale":"A forecast turns a capacity alert into a planned change.","evaluate":{"method":"scenario"},"ref":"OPS-309","area":"09-operations","section":"Capacity and fan-out","lifecycle":"active","boundary":"b-12","boundaryDetail":"`capacity report`","traces":["g-304"],"milestone":10,"inSection":"sec-operations-5","realisation":"checked"},
    {"id":"ops-310","kind":"requirement","statement":"The platform SHALL report each tenant whose share of a cluster's connections or job runs stays above its fair share through the window that D-700 states, together with the measure that exceeded.","rationale":"A noisy tenant is visible before the other tenants on its cluster feel it.","evaluate":{"method":"scenario"},"ref":"OPS-310","area":"09-operations","section":"Capacity and fan-out","lifecycle":"active","boundary":"b-12","boundaryDetail":"`noisy neighbour report`","traces":["g-4","g-304","d-700"],"milestone":10,"inSection":"sec-operations-5","realisation":"checked"},
    {"id":"ops-311","kind":"requirement","statement":"A subscriber that takes events more slowly than they are committed SHALL NOT delay their delivery to the other subscribers of the same tenant.","rationale":"Webhooks and subscribers are outside the platform's control, and their speed stays their own problem.","evaluate":{"method":"scenario"},"ref":"OPS-311","area":"09-operations","section":"Capacity and fan-out","lifecycle":"active","boundary":"b-9","boundaryDetail":"`event stream`","traces":["g-301","g-4"],"milestone":2,"inSection":"sec-operations-5","realisation":"checked"},
    {"id":"ops-312","kind":"requirement","statement":"While the control database is unreachable, the gateway SHALL keep serving each tenant whose directory entry is younger than the age that ARC-500 allows and refuse each tenant whose entry records a deletion.","rationale":"The directory copy keeps published sites up through a control database outage, and a deleted tenant is not served from it.","evaluate":{"method":"scenario"},"ref":"OPS-312","area":"09-operations","section":"Failure containment","lifecycle":"active","boundary":"b-3","boundaryDetail":"`directory entry`","traces":["g-301","g-20"],"milestone":2,"inSection":"sec-operations-6","realisation":"checked"},
    {"id":"ops-313","kind":"requirement","statement":"While the key service is unreachable, the platform SHALL serve published pages and requests that read no encrypted field, refusing other requests with a response that names the outage.","rationale":"Only the requests that need a tenant data key depend on the key service.","evaluate":{"method":"scenario"},"ref":"OPS-313","area":"09-operations","section":"Failure containment","lifecycle":"active","boundary":"b-17","boundaryDetail":"`key service contract`","traces":["g-40","g-301"],"milestone":3,"inSection":"sec-operations-6","realisation":"checked"},
    {"id":"ops-314","kind":"requirement","statement":"While the mail service is unreachable, mail SHALL wait in a queue and leave in the order it was queued once the service answers.","rationale":"A sign-in link that arrives late is still a valid sign-in link, and ordered mail keeps notices in sequence.","evaluate":{"method":"scenario"},"ref":"OPS-314","area":"09-operations","section":"Failure containment","lifecycle":"active","boundary":"b-18","boundaryDetail":"`mail contract`","traces":["g-6","g-301"],"milestone":3,"inSection":"sec-operations-6","realisation":"checked"},
    {"id":"ops-315","kind":"requirement","statement":"While the content delivery network is unavailable, the origin SHALL refuse page renders beyond its admission limit with a response that names the outage.","rationale":"Without the edge, every page render reaches the origin, so the origin needs its own limit.","evaluate":{"method":"scenario"},"ref":"OPS-315","area":"09-operations","section":"Failure containment","lifecycle":"active","boundary":"b-10","boundaryDetail":"`origin response`","traces":["g-18","g-301"],"milestone":6,"inSection":"sec-operations-6","realisation":"checked"},
    {"id":"ops-316","kind":"requirement","statement":"A freshness check SHALL treat a stored copy whose age has decreased since its last check as expired.","rationale":"A clock that steps backwards would otherwise keep a copy fresh for as long as the step lasts.","evaluate":{"method":"property"},"ref":"OPS-316","area":"09-operations","section":"Failure containment","lifecycle":"active","boundary":"b-15","boundaryDetail":"`freshness check`","traces":["g-19","k-8"],"milestone":6,"inSection":"sec-operations-6","realisation":"checked"},
    {"id":"ops-317","kind":"requirement","statement":"A commit interrupted by the failover of a tenant database SHALL be reported to its caller as committed or as not committed, never as both.","rationale":"A caller that retries after an unknown outcome needs one answer that is true.","evaluate":{"method":"property"},"ref":"OPS-317","area":"09-operations","section":"Failure containment","lifecycle":"active","boundary":"b-2","boundaryDetail":"`commit`","traces":["g-39","g-14"],"milestone":12,"inSection":"sec-operations-6","realisation":"checked"},
    {"id":"ops-318","kind":"requirement","statement":"A request that repeats an intent whose idempotency key the tenant has already committed SHALL receive the first result, without a second commit.","rationale":"Browsers and agents retry. A repeated intent changes the tenant only once.","evaluate":{"method":"scenario"},"ref":"OPS-318","area":"09-operations","section":"Failure containment","lifecycle":"active","boundary":"b-2","boundaryDetail":"`Idempotency-Key`","traces":["g-15","g-14"],"milestone":2,"inSection":"sec-operations-6","realisation":"checked"},
    {"id":"ops-320","kind":"requirement","statement":"A tenant database SHALL keep a restorable window of at least 14 days.","rationale":"A window shorter than the time it takes to notice a bad change leaves nothing to restore to.","evaluate":{"method":"budget"},"ref":"OPS-320","area":"09-operations","section":"Data safety","lifecycle":"active","boundary":"b-3","boundaryDetail":"`tenant restore`","traces":["g-302","g-1","d-522"],"milestone":12,"inSection":"sec-operations-7","realisation":"operational"},
    {"id":"ops-321","kind":"requirement","statement":"A restore drill SHALL restore a backup of each tenant of the drill into a separate database, and it fails, naming the tenant, when the restored state hash differs from the hash its journal records.","rationale":"A backup that has never been restored is an assumption, and the state hash is the proof that it works.","evaluate":{"method":"scenario"},"ref":"OPS-321","area":"09-operations","section":"Data safety","lifecycle":"active","boundary":"b-3","boundaryDetail":"`tenant restore`","traces":["g-302"],"milestone":12,"inSection":"sec-operations-7","realisation":"operational"},
    {"id":"ops-322","kind":"requirement","statement":"The platform SHALL recompute the state hash of each tenant from its journal on a schedule, reporting with the tenant identifier each tenant whose hash differs.","rationale":"Silent corruption is found by the platform, not by the first reader who notices it.","evaluate":{"method":"scenario"},"ref":"OPS-322","area":"09-operations","section":"Data safety","lifecycle":"active","boundary":"b-12","boundaryDetail":"`integrity report`","traces":["g-302","g-30"],"milestone":10,"inSection":"sec-operations-7","realisation":"checked"},
    {"id":"ops-323","kind":"requirement","statement":"A layout change SHALL be applied in waves, and each wave stops the change when the share of its tenants that failed exceeds the limit that D-700 states.","rationale":"A bad layout reaches a few tenants before it reaches all of them.","evaluate":{"method":"scenario"},"ref":"OPS-323","area":"09-operations","section":"Data safety","lifecycle":"active","boundary":"b-3","boundaryDetail":"`layout version`","traces":["g-1","g-303","d-700"],"milestone":2,"inSection":"sec-operations-7","realisation":"checked"},
    {"id":"ops-324","kind":"requirement","statement":"A layout change SHALL run its expanding phase on all tenants before any tenant runs its contracting phase.","rationale":"Expand and contract keeps the old and the new version of the layout readable at the same time.","evaluate":{"method":"scenario"},"ref":"OPS-324","area":"09-operations","section":"Data safety","lifecycle":"active","boundary":"b-3","boundaryDetail":"`layout version`","traces":["g-303","g-1"],"milestone":2,"inSection":"sec-operations-7","realisation":"checked"},
    {"id":"ops-325","kind":"requirement","statement":"An irreversible operation SHALL be refused unless its request repeats the identifier of the object it destroys.","rationale":"A name or a label typed by mistake does not destroy the wrong tenant.","evaluate":{"method":"scenario"},"ref":"OPS-325","area":"09-operations","section":"Data safety","lifecycle":"active","boundary":"b-3","boundaryDetail":"`tenant lifecycle operation`","traces":["g-22","k-302"],"milestone":2,"inSection":"sec-operations-7","realisation":"checked"},
    {"id":"ops-326","kind":"requirement","statement":"While two versions of a component run together, each version SHALL accept the requests and the events that the other writes, apart from the commit format that ARC-106 states.","rationale":"A rollout is a period in which both versions are live. The format of a commit is the subject of ARC-106 and is not stated twice.","evaluate":{"method":"scenario"},"ref":"OPS-326","area":"09-operations","section":"Releases and change","lifecycle":"active","boundary":"b-19","boundaryDetail":"`rolling deployment`","traces":["g-303","k-301"],"milestone":12,"inSection":"sec-operations-8","realisation":"checked"},
    {"id":"ops-327","kind":"requirement","statement":"A colour switch SHALL return traffic to the previous colour when a criterion named in its release record is breached while the new colour is live.","rationale":"Rollback is decided by criteria written before the release, not by an argument during the incident.","evaluate":{"method":"scenario"},"ref":"OPS-327","area":"09-operations","section":"Releases and change","lifecycle":"active","boundary":"b-19","boundaryDetail":"`deployment`","traces":["g-303"],"milestone":12,"inSection":"sec-operations-8","realisation":"checked"},
    {"id":"ops-328","kind":"requirement","statement":"A feature flag SHALL be off for a tenant unless the release record of the flag enables it for that tenant.","rationale":"A flag that is on by default is an unreviewed release.","evaluate":{"method":"property"},"ref":"OPS-328","area":"09-operations","section":"Releases and change","lifecycle":"active","boundary":"b-19","boundaryDetail":"`feature flag`","traces":["g-303","g-1"],"milestone":12,"inSection":"sec-operations-8","realisation":"checked"},
    {"id":"ops-329","kind":"requirement","statement":"A configuration change SHALL be recorded in the audit log with the previous value, the new value, the principal and the correlation identifier.","rationale":"A changed setting is a change of behaviour, and it is explained the same way as any other change.","evaluate":{"method":"scenario"},"ref":"OPS-329","area":"09-operations","section":"Releases and change","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit entry`","traces":["g-30"],"milestone":10,"inSection":"sec-operations-8","realisation":"checked"},
    {"id":"ops-331","kind":"requirement","statement":"The delivery of published content SHALL answer at least 99.95 percent of its requests without a platform error over each window of 30 days.","rationale":"Readers feel delivery first, so its objective is the highest.","evaluate":{"method":"budget"},"ref":"OPS-331","area":"09-operations","section":"Objectives and budgets","lifecycle":"active","boundary":"b-9","boundaryDetail":"`delivery interface`","traces":["g-300","g-18"],"milestone":12,"inSection":"sec-operations-9","realisation":"operational"},
    {"id":"ops-332","kind":"requirement","statement":"The authoring application and the sign-in pages SHALL answer at least 99.9 percent of their requests without a platform error over each window of 30 days.","rationale":"Authoring and sign-in are used less than delivery, and each failure costs a person a whole session.","evaluate":{"method":"budget"},"ref":"OPS-332","area":"09-operations","section":"Objectives and budgets","lifecycle":"active","boundary":"b-13","boundaryDetail":"`authoring application`","traces":["g-300","g-6"],"milestone":12,"inSection":"sec-operations-9","realisation":"operational"},
    {"id":"ops-333","kind":"requirement","statement":"A delivery request answered from a stored copy SHALL complete within 100 ms at the 99th percentile.","rationale":"The read path of the design, held to a bound a reader cannot notice.","evaluate":{"method":"budget"},"ref":"OPS-333","area":"09-operations","section":"Objectives and budgets","lifecycle":"active","boundary":"b-9","boundaryDetail":"`delivery interface`","traces":["g-18","g-300"],"milestone":6,"inSection":"sec-operations-9","realisation":"operational"},
    {"id":"ops-334","kind":"requirement","statement":"A state-changing intent SHALL be confirmed as committed within 300 ms at the 99th percentile.","rationale":"The write path of the design, held to a bound that an editor still feels as responsive.","evaluate":{"method":"budget"},"ref":"OPS-334","area":"09-operations","section":"Objectives and budgets","lifecycle":"active","boundary":"b-2","boundaryDetail":"`commit`","traces":["g-300","g-19"],"milestone":2,"inSection":"sec-operations-9","realisation":"operational"},
    {"id":"ops-335","kind":"requirement","statement":"A tenant whose database is lost SHALL answer requests again within 4 hours of the loss.","rationale":"A tenant is one database, so its recovery time is the restore time of one database.","evaluate":{"method":"budget"},"ref":"OPS-335","area":"09-operations","section":"Objectives and budgets","lifecycle":"active","boundary":"b-3","boundaryDetail":"`tenant restore`","traces":["g-1","g-302"],"milestone":12,"inSection":"sec-operations-9","realisation":"operational"},
    {"id":"ops-336","kind":"requirement","statement":"The first request for an idle tenant SHALL complete within 2 seconds at the 95th percentile.","rationale":"Thousands of idle tenants cost nothing, so the first request after an idle period pays for opening the tenant.","evaluate":{"method":"budget"},"ref":"OPS-336","area":"09-operations","section":"Objectives and budgets","lifecycle":"active","boundary":"b-9","boundaryDetail":"`delivery interface`","traces":["g-4","g-300"],"milestone":6,"inSection":"sec-operations-9","realisation":"operational"},
    {"id":"ops-337","kind":"requirement","statement":"A request waiting in the queue of a cluster SHALL start within 1 second at the 99th percentile, or be refused.","rationale":"A queue that is allowed to grow silently breaks every deadline behind it.","evaluate":{"method":"budget"},"ref":"OPS-337","area":"09-operations","section":"Objectives and budgets","lifecycle":"active","boundary":"b-9","boundaryDetail":"`gateway queue`","traces":["g-301"],"milestone":6,"inSection":"sec-operations-9","realisation":"operational"},
    {"id":"ops-338","kind":"requirement","statement":"An outage of a tenant-facing surface SHALL raise an alert within 5 minutes of its start.","rationale":"An alert that comes after the readers have noticed is a report, not an alert.","evaluate":{"method":"budget"},"ref":"OPS-338","area":"09-operations","section":"Objectives and budgets","lifecycle":"active","boundary":"b-12","boundaryDetail":"`alert`","traces":["g-300"],"milestone":10,"inSection":"sec-operations-9","realisation":"operational"},
    {"id":"ops-339","kind":"requirement","statement":"The telemetry of one cluster SHALL hold fewer than 500000 metric series at the reference load.","rationale":"Every tenant label multiplies the series, so the count is bounded by the design.","evaluate":{"method":"budget"},"ref":"OPS-339","area":"09-operations","section":"Objectives and budgets","lifecycle":"active","boundary":"b-12","boundaryDetail":"`metric series`","traces":["g-304"],"milestone":10,"inSection":"sec-operations-9","realisation":"operational"},
    {"id":"ops-340","kind":"requirement","statement":"An alert of a tenant-facing surface SHALL be raised from the rate at which its error budget is consumed over a short window and over a long window together.","rationale":"Two windows separate a fast burn that needs a person now from a slow burn that can wait for the morning.","evaluate":{"method":"scenario"},"ref":"OPS-340","area":"09-operations","section":"Alerts, runbooks and diagnostics","lifecycle":"active","boundary":"b-12","boundaryDetail":"`alert`","traces":["g-300"],"milestone":10,"inSection":"sec-operations-10","realisation":"operational"},
    {"id":"ops-341","kind":"requirement","statement":"Each alert names the catalogue operation that carries its runbook, and that operation SHALL run as a dry run before it runs as a change.","rationale":"A runbook is an operation like any other, so an agent can read it and try it first.","evaluate":{"method":"scenario"},"ref":"OPS-341","area":"09-operations","section":"Alerts, runbooks and diagnostics","lifecycle":"active","boundary":"b-11","boundaryDetail":"`runbook operation`","traces":["g-304","g-23"],"milestone":10,"inSection":"sec-operations-10","realisation":"operational"},
    {"id":"ops-342","kind":"requirement","statement":"The agent gateway SHALL offer read-only diagnostic operations for one tenant, covering its health, its configuration and its recent failures.","rationale":"An agent diagnoses one tenant without the power to change it.","evaluate":{"method":"scenario"},"ref":"OPS-342","area":"09-operations","section":"Alerts, runbooks and diagnostics","lifecycle":"active","boundary":"b-11","boundaryDetail":"`diagnostic operation`","traces":["g-304","g-24"],"milestone":10,"inSection":"sec-operations-10","realisation":"checked"},
    {"id":"ops-343","kind":"requirement","statement":"When no step of an alert's runbook resolves the alert, the alert SHALL be handed to the person on call with the diagnostic output of the runbook attached.","rationale":"An agent that cannot resolve an alert hands over what it already found, not a bare page.","evaluate":{"method":"scenario"},"ref":"OPS-343","area":"09-operations","section":"Alerts, runbooks and diagnostics","lifecycle":"active","boundary":"b-11","boundaryDetail":"`escalation`","traces":["g-304"],"milestone":10,"inSection":"sec-operations-10","realisation":"operational"},
    {"id":"ops-344","kind":"requirement","statement":"Telemetry SHALL carry the tenant identifier as the only per-tenant dimension of a metric, and no record identifier as a dimension of any metric.","rationale":"Record identifiers as labels make the telemetry unaffordable at thousands of tenants.","evaluate":{"method":"property"},"ref":"OPS-344","area":"09-operations","section":"Alerts, runbooks and diagnostics","lifecycle":"active","boundary":"b-12","boundaryDetail":"`metric dimension`","traces":["g-29","g-304"],"milestone":10,"inSection":"sec-operations-10","realisation":"checked"},
    {"id":"ops-345","kind":"requirement","statement":"The platform SHALL attribute to each tenant its connection time, stored bytes, job runs, copy bytes and outbound calls, each as a measure the tenant owner can read.","rationale":"Cost and load are attributed to the tenant that causes them.","evaluate":{"method":"scenario"},"ref":"OPS-345","area":"09-operations","section":"Alerts, runbooks and diagnostics","lifecycle":"active","boundary":"b-12","boundaryDetail":"`tenant measure`","traces":["g-27","g-4"],"milestone":10,"inSection":"sec-operations-10","realisation":"checked"},
    {"id":"ops-346","kind":"requirement","statement":"A synthetic request from outside the platform network SHALL run against each tenant-facing surface at the interval that D-700 states, and a failed one raises an alert even when no tenant request fails.","rationale":"A quiet surface is not necessarily a working one.","evaluate":{"method":"scenario"},"ref":"OPS-346","area":"09-operations","section":"Alerts, runbooks and diagnostics","lifecycle":"active","boundary":"b-12","boundaryDetail":"`synthetic probe`","traces":["g-300","g-27","d-700"],"milestone":10,"inSection":"sec-operations-10","realisation":"operational"},
    {"id":"ops-347","kind":"requirement","statement":"No sampling rule SHALL discard an error record, an alert or an audit entry.","rationale":"Sampling is for the routine records, and the records that explain a failure are kept whole.","evaluate":{"method":"property"},"ref":"OPS-347","area":"09-operations","section":"Alerts, runbooks and diagnostics","lifecycle":"active","boundary":"b-12","boundaryDetail":"`sampling rule`","traces":["g-30","g-27"],"milestone":10,"inSection":"sec-operations-10","realisation":"checked"},
    {"id":"ops-348","kind":"requirement","statement":"A committed domain event that keeps failing to publish SHALL be parked with the error of each attempt, and it stays visible to the tenant owner until it is published or dropped by the tenant owner.","rationale":"A poison event otherwise stops the outbox silently, with nobody able to see which event it is.","evaluate":{"method":"scenario"},"ref":"OPS-348","area":"09-operations","section":"Undeliverable events","lifecycle":"active","boundary":"b-12","boundaryDetail":"`parked event`","traces":["g-14","g-27","d-519"],"milestone":2,"inSection":"sec-operations-11","realisation":"checked"},
    {"id":"ops-349","kind":"requirement","statement":"Every failure mode of the operations fault model SHALL have a fault injection hook in the local stack, named in the fault injection table.","rationale":"A failure that cannot be injected locally is tested only in production.","evaluate":{"method":"conformance"},"ref":"OPS-349","area":"09-operations","section":"Local failure injection","lifecycle":"active","boundary":"b-19","boundaryDetail":"`fault injection hook`","traces":["g-42","g-301"],"milestone":2,"cases":["cases-fault-injection"],"inSection":"sec-operations-12","realisation":"checked"},
    {"id":"idn-300","kind":"requirement","statement":"While the identity service is unreachable, the gateway SHALL refuse a request that needs a session, with a response that names the identity outage.","rationale":"A signed-in request cannot be checked during the outage, so it is refused and not guessed at.","evaluate":{"method":"scenario"},"ref":"IDN-300","area":"03-identity","section":"Outage","lifecycle":"active","boundary":"b-4","boundaryDetail":"`session`","traces":["g-301","g-9","d-517"],"milestone":3,"inSection":"sec-identity-6","realisation":"checked"},
    {"id":"idn-301","kind":"requirement","statement":"While the identity service is unreachable, the gateway SHALL keep serving published content to readers who need no session.","rationale":"Published content does not depend on who is asking, so its readers are not affected by the identity outage.","evaluate":{"method":"scenario"},"ref":"IDN-301","area":"03-identity","section":"Outage","lifecycle":"active","boundary":"b-9","boundaryDetail":"`published content`","traces":["g-18","g-301"],"milestone":6,"inSection":"sec-identity-6","realisation":"checked"},
    {"id":"idn-302","kind":"requirement","statement":"A session lookup SHALL end with an answer or a refusal within 2 seconds.","rationale":"A lookup that hangs holds the request that waits for it.","evaluate":{"method":"budget"},"ref":"IDN-302","area":"03-identity","section":"Outage","lifecycle":"active","boundary":"b-4","boundaryDetail":"`session lookup`","traces":["g-301","g-9"],"milestone":3,"inSection":"sec-identity-6","realisation":"operational"},
    {"id":"sch-300","kind":"requirement","statement":"A trigger SHALL create no job for an event whose chain of triggers has passed the hop limit that D-700 states for its tenant.","rationale":"A trigger that creates an event that starts the trigger again is a loop, and the hop limit is what ends it.","evaluate":{"method":"scenario"},"ref":"SCH-300","area":"04-automation","section":"Chains, bursts and lease outage","lifecycle":"active","boundary":"b-7","boundaryDetail":"`trigger`","traces":["g-13","g-14"],"milestone":5,"inSection":"sec-scheduling-5","realisation":"checked"},
    {"id":"sch-301","kind":"requirement","statement":"A worker that cannot reach the tenant database of a job SHALL take no lease on that job.","rationale":"A worker that cannot record its result cannot hold the job either, so the job is left for a worker that can.","evaluate":{"method":"scenario"},"ref":"SCH-301","area":"04-automation","section":"Chains, bursts and lease outage","lifecycle":"active","boundary":"b-7","boundaryDetail":"`lease`","traces":["g-14","k-17"],"milestone":5,"inSection":"sec-scheduling-5","realisation":"checked"},
    {"id":"sch-302","kind":"requirement","statement":"A burst of due jobs of one tenant SHALL be released to workers at the job admission rate that D-700 states for that tenant.","rationale":"A tenant that schedules a thousand jobs at one minute does not occupy every worker for an hour.","evaluate":{"method":"scenario"},"ref":"SCH-302","area":"04-automation","section":"Chains, bursts and lease outage","lifecycle":"active","boundary":"b-7","boundaryDetail":"`job`","traces":["g-4","g-13"],"milestone":5,"inSection":"sec-scheduling-5","realisation":"checked"},
    {"id":"m-link-accepted-once","kind":"invariant","models":"idn-003","statement":"In the emailed link scenarios, one link yields at most one session.","evaluate":{"method":"state-invariant","scenarios":["link-used-twice","link-presented-late","link-presented-elsewhere","link-presentation-duplicated"],"expr":"emailed-link-flow.sessions <= 1","negatives":[{"scenario":"link-used-twice","faults":["defect-link-replay"]},{"scenario":"link-presentation-duplicated","faults":["defect-link-replay"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-link-accepted-in-time","kind":"temporal","models":"idn-003","statement":"A link presented in the requesting browser within its lifetime yields a session.","evaluate":{"method":"eventually","scenarios":["link-used-twice"],"occurs":{"event":"ml-session-issued"},"negatives":[{"scenario":"link-used-twice","faults":["link-acceptance-disabled"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-tick"],"faultBasis":"restatement"},
    {"id":"m-late-link-refused","kind":"temporal","models":"idn-004","statement":"A link presented after its lifetime yields no session.","evaluate":{"method":"never","scenarios":["link-presented-late","link-presented-after-delay"],"occurs":{"event":"ml-session-issued"},"negatives":[{"scenario":"link-presented-late","faults":["defect-link-lifetime-unchecked"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-tick"],"faultBasis":"fault"},
    {"id":"m-foreign-browser-refused","kind":"temporal","models":"idn-005","statement":"A link presented in a browser that did not request it yields no session.","evaluate":{"method":"never","scenarios":["link-presented-elsewhere","link-intercepted"],"occurs":{"event":"ml-session-issued"},"negatives":[{"scenario":"link-presented-elsewhere","faults":["defect-link-browser-unchecked"]},{"scenario":"link-intercepted","faults":["defect-link-browser-unchecked"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-emailed-link-flow-refined","kind":"temporal","models":"idn-003","statement":"The implementation of the emailed link, with its stored challenge and expiry, refines the emailed link model.","evaluate":{"method":"refines","behavior":"emailed-link-flow-impl","scenarios":["link-used-twice-impl","link-presented-late-impl","link-presented-elsewhere-impl","link-presented-after-delay-impl","link-presentation-duplicated-impl","link-intercepted-impl"]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-forged-callback-refused","kind":"temporal","models":"fed-001","statement":"A callback whose state matches no pending request yields no session.","evaluate":{"method":"never","scenarios":["oidc-forged-callback","oidc-provider-silent-forged-callback"],"occurs":{"event":"oidc-session-issued"},"negatives":[{"scenario":"oidc-forged-callback","faults":["defect-oidc-state-unchecked"]},{"scenario":"oidc-provider-silent-forged-callback","faults":["defect-oidc-state-unchecked"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-provider-signatures"],"faultBasis":"fault"},
    {"id":"m-matching-callback-accepted","kind":"temporal","models":"fed-001","statement":"A callback that carries the pending state yields a session.","evaluate":{"method":"eventually","scenarios":["oidc-sign-in"],"occurs":{"event":"oidc-session-issued"},"negatives":[{"scenario":"oidc-sign-in","faults":["oidc-acceptance-disabled"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-provider-signatures"],"faultBasis":"restatement"},
    {"id":"m-oidc-callback-flow-refined","kind":"temporal","models":"fed-001","statement":"The implementation of the provider sign-in callback refines the callback model.","evaluate":{"method":"refines","behavior":"oidc-callback-flow-impl","scenarios":["oidc-sign-in-impl","oidc-forged-callback-impl","oidc-provider-silent-forged-callback-impl"]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-revocation-bounded","kind":"invariant","models":"idn-013","statement":"The gateway never accepts a session 5 ticks or more after it was revoked, whether or not the revocation notice arrives.","evaluate":{"method":"state-invariant","scenarios":["revocation-heard","revocation-notice-lost"],"expr":"!gateway-session-flow.staleAccept","negatives":[{"scenario":"revocation-notice-lost","faults":["defect-gateway-no-recheck"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-clock-skew","a-tick"],"faultBasis":"fault"},
    {"id":"m-revoked-session-refused","kind":"temporal","models":"idn-013","statement":"When the revocation notice is lost, a request after the bound is still refused.","evaluate":{"method":"eventually","scenarios":["revocation-notice-lost"],"occurs":{"event":"sr-refused"},"negatives":[{"scenario":"revocation-notice-lost","faults":["defect-gateway-no-recheck"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-clock-skew","a-tick"],"faultBasis":"fault"},
    {"id":"m-gateway-session-flow-refined","kind":"temporal","models":"idn-013","statement":"The implementation of the gateway copy of a session refines the gateway session model.","evaluate":{"method":"refines","behavior":"gateway-session-flow-impl","scenarios":["revocation-heard-impl","revocation-notice-lost-impl"]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-result-carries-current-token","kind":"invariant","models":"sch-011","statement":"A recorded result carries the token of the current lease.","evaluate":{"method":"state-invariant","scenarios":["lease-takeover","lease-report-in-transit"],"expr":"job-lease-flow.completions > 0 => job-lease-flow.acceptedToken == job-lease-flow.token","negatives":[{"scenario":"lease-takeover","faults":["defect-result-token-unchecked"]},{"scenario":"lease-report-in-transit","faults":["defect-result-token-unchecked"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-database-commit"],"faultBasis":"fault"},
    {"id":"m-job-completes-after-takeover","kind":"temporal","models":"sch-010","statement":"A job whose first worker stalls is completed by its replacement.","evaluate":{"method":"eventually","scenarios":["lease-takeover","lease-report-in-transit","lease-report-lost-in-partition"],"occurs":{"event":"job-completed"},"negatives":[{"scenario":"lease-takeover","faults":["completion-disabled"]},{"scenario":"lease-report-lost-in-partition","faults":["completion-disabled"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-database-commit"],"faultBasis":"fault"},
    {"id":"m-job-lease-flow-refined","kind":"temporal","models":"sch-011","statement":"The implementation of the job lease, with the lease token stored on the job, refines the job lease model.","evaluate":{"method":"refines","behavior":"job-lease-flow-impl","scenarios":["lease-takeover-impl","lease-report-in-transit-impl","lease-report-lost-in-partition-impl"]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-edge-staleness-bounded","kind":"invariant","models":"edg-006","statement":"The edge never serves a version 5 ticks or more after it was superseded, whether or not the purge arrives.","evaluate":{"method":"state-invariant","scenarios":["page-purged","page-purge-lost"],"expr":"!edge-copy-flow.staleServed","negatives":[{"scenario":"page-purge-lost","faults":["defect-edge-ignores-lifetime"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-tick"],"faultBasis":"fault"},
    {"id":"m-edge-copy-flow-refined","kind":"temporal","models":"edg-006","statement":"The implementation of the edge copy of a page refines the edge copy model.","evaluate":{"method":"refines","behavior":"edge-copy-flow-impl","scenarios":["page-purged-impl","page-purge-lost-impl"]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-origin-content-flow-refined","kind":"temporal","models":"edg-006","statement":"The implementation of the origin page version refines the origin content model.","evaluate":{"method":"refines","behavior":"origin-content-flow-impl","scenarios":["page-purged-impl","page-purge-lost-impl"]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-active-means-ready","kind":"invariant","models":"ten-002","statement":"A tenant reported as active has its layout applied and its template installed.","evaluate":{"method":"state-invariant","scenarios":["tenant-provisioned","tenant-provisioning-fails","tenant-provisioning-fails-late"],"expr":"provisioning-flow.active => provisioning-flow.layout && provisioning-flow.template","negatives":[{"scenario":"tenant-provisioned","faults":["defect-early-activation"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-failed-provisioning-not-active","kind":"temporal","models":"ten-003","statement":"A provisioning run that fails never reports the tenant as active.","evaluate":{"method":"never","scenarios":["tenant-provisioning-fails","tenant-provisioning-fails-late"],"occurs":{"event":"pv-activated"},"negatives":[{"scenario":"tenant-provisioning-fails","faults":["defect-early-activation"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-provisioning-flow-refined","kind":"temporal","models":"ten-002","statement":"The implementation of tenant provisioning, with its tenant record and its steps, refines the provisioning model.","evaluate":{"method":"refines","behavior":"provisioning-flow-impl","scenarios":["tenant-provisioned-impl","tenant-provisioning-fails-impl","tenant-provisioning-fails-late-impl"]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-applied-means-cleared","kind":"invariant","models":"agt-011","statement":"An applied change was projected, and was either classed as safe or approved.","evaluate":{"method":"state-invariant","scenarios":["safe-change-applied","risky-change-approved","risky-change-rejected","risky-change-approval-in-transit"],"expr":"proposal-flow.applied => proposal-flow.projected && proposal-flow.cleared","negatives":[{"scenario":"risky-change-approved","faults":["defect-apply-unapproved"]},{"scenario":"risky-change-approval-in-transit","faults":["defect-apply-unapproved"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-rejected-change-not-applied","kind":"temporal","models":"agt-011","statement":"A rejected change is never applied.","evaluate":{"method":"never","scenarios":["risky-change-rejected","rejected-change-apply-redelivered"],"occurs":{"event":"cp-applied"},"negatives":[{"scenario":"risky-change-rejected","faults":["defect-apply-rejected"]},{"scenario":"rejected-change-apply-redelivered","faults":["defect-apply-rejected"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-proposal-flow-refined","kind":"temporal","models":"agt-011","statement":"The implementation of the change proposal, with its stored state, refines the proposal model.","evaluate":{"method":"refines","behavior":"proposal-flow-impl","scenarios":["safe-change-applied-impl","risky-change-approved-impl","risky-change-rejected-impl","risky-change-approval-in-transit-impl","rejected-change-apply-redelivered-impl"]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-commit-precedes-publication","kind":"temporal","models":"run-005","statement":"Every published event is preceded by the confirmation of its commit.","evaluate":{"method":"precedes","scenarios":["intent-committed","intent-commit-confirmation-delayed"],"first":{"event":"rt-committed"},"then":{"event":"rt-published"},"negatives":[{"scenario":"intent-committed","faults":["defect-publish-before-commit"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-database-commit"],"faultBasis":"fault"},
    {"id":"m-browser-reaches-data-through-gateway","kind":"structural","models":"gwy-700","statement":"Every path from the web application to a tenant database passes through the gateway.","evaluate":{"method":"only-via","from":"web-application","to":"tenant-database","via":"gateway"},"assumptions":["a-model-abstraction"]},
    {"id":"m-external-requests-pass-traffic-switch","kind":"structural","models":"rel-577","statement":"Every path from a client of the platform (the web application, an agent, the content delivery network) to the gateway or the agent gateway passes through a listener of the traffic switch. The model holds paths between components, not requests: it shows that no relationship lets a client bypass the switch, and the choice of colour per request is the behaviour of the colour switch model.","evaluate":{"method":"only-via","from":["web-application","agent","delivery-network"],"to":["gateway","agent-gateway"],"via":["traffic-switch","agent-traffic-switch"],"kinds":["depends-on","calls","data-flow","publishes","subscribes","reads","writes"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-agents-reach-data-through-agent-gateway","kind":"structural","models":"agt-014","statement":"Every path from an agent to a tenant database passes through the agent gateway.","evaluate":{"method":"only-via","from":"agent","to":"tenant-database","via":"agent-gateway"},"assumptions":["a-model-abstraction"]},
    {"id":"m-tenant-database-through-store-contract","kind":"structural","models":"sec-005","statement":"Every path from a component other than the tenant database, the two database adapters and the store contract to a tenant database passes through the store contract (telemetry observation excepted, OBS-003).","evaluate":{"method":"only-via","from":["kernel","substrate","control-plane","control-database","identity-service","runtime","gateway","automation-worker","connector-runner","copy-store","file-store","delivery-network","delivery-network-control","agent-gateway","telemetry-pipeline","audit-log","key-service","mail-service","external-identity-provider","web-application","simulator","verification","agent","limit-store","backup-archive","fleet-reporting","product-module","external-endpoint","notice-queue","search-index","notification-service","conversation-service","model-provider","local-model-adapter","operator-console","outbound-gate","upload-scanner","mail-dispatcher","release-controller","release-pipeline","image-registry","traffic-switch","subject-rights-service","agent-traffic-switch","migration-job","platform-audit-store"],"to":"tenant-database","via":"store-contract","kinds":["depends-on","calls","data-flow","publishes","subscribes","reads","writes"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-kernel-reaches-nothing","kind":"structural","models":"krn-012","statement":"The kernel has no path to any store, service or external component.","evaluate":{"method":"no-relationship","from":"kernel","to":{"all":true},"transitive":true},"assumptions":["a-model-abstraction"]},
    {"id":"m-control-database-private","kind":"structural","models":"ten-006","statement":"The control plane alone reaches the control database: no other component has a data relationship to (telemetry observation excepted, OBS-003) it.","evaluate":{"method":"no-relationship","from":["kernel","substrate","store-contract","sqlite-adapter","postgres-adapter","tenant-database","identity-service","runtime","gateway","automation-worker","connector-runner","copy-store","file-store","delivery-network","delivery-network-control","agent-gateway","telemetry-pipeline","audit-log","key-service","mail-service","external-identity-provider","web-application","simulator","verification","agent","limit-store","backup-archive","fleet-reporting","product-module","external-endpoint","notice-queue","search-index","notification-service","conversation-service","model-provider","local-model-adapter","operator-console","outbound-gate","upload-scanner","mail-dispatcher","release-controller","release-pipeline","image-registry","traffic-switch","subject-rights-service","agent-traffic-switch","migration-job","platform-audit-store"],"to":"control-database","transitive":false,"kinds":["depends-on","calls","data-flow","publishes","subscribes","reads","writes"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-dependencies-acyclic","kind":"structural","models":"krn-012","statement":"The depends-on relationships between components have no cycle.","evaluate":{"method":"acyclic","kinds":["depends-on"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-calls-acyclic","kind":"structural","models":"arc-701","statement":"The calls relationships between the components of the platform have no cycle. Components outside the platform (clients and providers) are left out: a sign-in redirect goes to the identity provider and comes back by design.","evaluate":{"method":"acyclic","kinds":["calls"],"within":["kernel","substrate","store-contract","sqlite-adapter","postgres-adapter","tenant-database","control-plane","control-database","identity-service","runtime","gateway","automation-worker","connector-runner","copy-store","file-store","agent-gateway","telemetry-pipeline","audit-log","simulator","verification","limit-store","backup-archive","fleet-reporting","product-module","notice-queue","search-index","notification-service","conversation-service","local-model-adapter","outbound-gate","upload-scanner","mail-dispatcher","release-controller","release-pipeline","image-registry","traffic-switch","agent-traffic-switch","migration-job","platform-audit-store","subject-rights-service"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-copies-designed","kind":"structural","models":"cpy-001","statement":"Every stored copy states a freshness bound, is reachable from its owner, and states an erasure point where it holds personal data or a principal.","evaluate":{"method":"data-model","rules":["freshness-bound","holder-reaches-owner","erasure-point"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-records-state-erasure","kind":"structural","models":"prv-353","statement":"Every record that holds a personal or credential field states the point at which it is erased, or a bound after which it is removed.","evaluate":{"method":"data-model","rules":["record-erasure-point"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-shared-copies-impersonal","kind":"structural","models":"cpy-007","statement":"No shared copy holds a personal field or a principal, and none depends on who is asking.","evaluate":{"method":"data-model","rules":["no-principal-in-shared"]},"assumptions":["a-model-abstraction"]},
    {"id":"arc-100","kind":"requirement","statement":"While the control plane cannot be reached, the gateway SHALL answer reads for a tenant from the directory entry it holds, while that entry is within the age that ARC-500 allows, stating its age, and refuse every state-changing request for that tenant.","rationale":"Without this, every request depends on the control plane, so an outage of the directory becomes an outage of every tenant.","evaluate":{"method":"scenario"},"ref":"ARC-100","area":"09-architecture","section":"Control plane and wake index","lifecycle":"active","boundary":"b-3","boundaryDetail":"`directory entry`","traces":["g-101","d-100"],"milestone":2,"inSection":"sec-arch-2","realisation":"checked"},
    {"id":"arc-101","kind":"requirement","statement":"The wake index SHALL be rebuildable from the tenant databases, so that losing it delays due work and loses none of it.","rationale":"The index is a convenience of the control plane. Due work lives in the tenant databases, so the index can be lost without losing a job.","evaluate":{"method":"scenario"},"ref":"ARC-101","area":"09-architecture","section":"Control plane and wake index","lifecycle":"active","boundary":"b-3","boundaryDetail":"`wake index`","traces":["g-14","g-102","d-10"],"milestone":5,"inSection":"sec-arch-2","realisation":"checked"},
    {"id":"arc-102","kind":"requirement","statement":"A domain event SHALL reach the notice queue as a reference that names its tenant and sequence number, with no content of the record it changed.","rationale":"The queue sits in the control zone. Record content stays in the tenant database, which subscribers read when they need it.","evaluate":{"method":"property"},"ref":"ARC-102","area":"09-architecture","section":"Notices and outbox","lifecycle":"active","boundary":"b-16","boundaryDetail":"`notice`","traces":["k-2","d-10"],"milestone":3,"inSection":"sec-arch-3","realisation":"checked"},
    {"id":"arc-103","kind":"requirement","statement":"The notice queue SHALL redeliver a notice to each subscriber until that subscriber acknowledges it, so that every notice reaches every subscriber it names.","rationale":"Delivery repeats until acknowledged, so a lost notice is a delay and not a loss. The revocation bound depends on this.","evaluate":{"method":"scenario"},"ref":"ARC-103","area":"09-architecture","section":"Notices and outbox","lifecycle":"active","boundary":"b-16","boundaryDetail":"`notice delivery`","traces":["d-12","g-19"],"milestone":3,"inSection":"sec-arch-3","realisation":"checked"},
    {"id":"arc-104","kind":"requirement","statement":"A subscriber that receives a domain event a second time SHALL make no further effect from it.","rationale":"Redelivery is what makes delivery reliable, so the subscriber is the one that makes each effect once.","evaluate":{"method":"property"},"ref":"ARC-104","area":"09-architecture","section":"Notices and outbox","lifecycle":"active","boundary":"b-16","boundaryDetail":"`notice subscriber`","traces":["d-12","g-15"],"milestone":3,"inSection":"sec-arch-3","realisation":"checked"},
    {"id":"arc-105","kind":"requirement","statement":"An event that a commit left unpublished SHALL reach its subscribers after the process that made the commit has stopped.","rationale":"Without this, a crash between the commit and the publication strands the event until someone next writes to the tenant.","evaluate":{"method":"scenario"},"ref":"ARC-105","area":"09-architecture","section":"Notices and outbox","lifecycle":"active","boundary":"b-7","boundaryDetail":"`outbox job`","traces":["g-14","d-102","d-529"],"milestone":5,"inSection":"sec-arch-3","realisation":"checked"},
    {"id":"arc-106","kind":"requirement","statement":"While two versions of the platform run together, a commit SHALL be written in a format that both versions read.","rationale":"A rolling deployment has an old process and a new process serving the same tenant database at once.","evaluate":{"method":"scenario"},"ref":"ARC-106","area":"09-architecture","section":"Change across versions","lifecycle":"active","boundary":"b-2","boundaryDetail":"`commit format`","traces":["g-104","g-5"],"milestone":12,"inSection":"sec-arch-4","realisation":"checked"},
    {"id":"arc-107","kind":"requirement","statement":"A layout change SHALL reach every tenant database before code that needs the new layout serves that tenant.","rationale":"Layouts change one tenant database at a time, so the code that depends on a layout waits for its tenant.","evaluate":{"method":"scenario"},"ref":"ARC-107","area":"09-architecture","section":"Change across versions","lifecycle":"active","boundary":"b-3","boundaryDetail":"`layout version`","traces":["g-104","g-1"],"milestone":2,"inSection":"sec-arch-4","realisation":"checked"},
    {"id":"arc-108","kind":"requirement","statement":"A decision SHALL load only the records that its plan names.","rationale":"A tenant holds a great many records. A decision that loads its whole tenant makes the kernel's memory and latency a function of tenant size rather than of the decision.","evaluate":{"method":"property"},"ref":"ARC-108","area":"09-architecture","section":"Kernel load, limits and connections","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::needs`","traces":["k-100","g-4"],"milestone":2,"inSection":"sec-arch-5","realisation":"checked"},
    {"id":"arc-109","kind":"requirement","statement":"Request rates SHALL be counted in one store that every gateway instance reads and writes.","rationale":"A limit counted separately in each instance is a limit that grows with the number of instances.","evaluate":{"method":"scenario"},"ref":"ARC-109","area":"09-architecture","section":"Kernel load, limits and connections","lifecycle":"active","boundary":"b-100","boundaryDetail":"`request limit`","traces":["g-4","g-102"],"milestone":6,"inSection":"sec-arch-5","realisation":"checked"},
    {"id":"arc-110","kind":"requirement","statement":"An operator report that spans tenants SHALL be answered from telemetry, published summaries and the tenant directory alone.","rationale":"Operators need the fleet view, and the data of a tenant stays with that tenant.","evaluate":{"method":"property"},"ref":"ARC-110","area":"09-architecture","section":"Reporting and backup","lifecycle":"active","boundary":"b-12","boundaryDetail":"`fleet report`","traces":["g-100","ng-6","d-101"],"milestone":10,"inSection":"sec-arch-6","realisation":"construction"},
    {"id":"arc-111","kind":"requirement","statement":"Each tenant database SHALL be backed up to the backup archive on a schedule, with every copy encrypted under the key of that tenant.","rationale":"A backup that no schedule produces, or that another tenant's key can open, is not a backup of that tenant.","evaluate":{"method":"scenario"},"ref":"ARC-111","area":"09-architecture","section":"Reporting and backup","lifecycle":"active","boundary":"b-101","boundaryDetail":"`backup archive`","traces":["g-1","g-40","d-706"],"milestone":2,"inSection":"sec-arch-6","realisation":"operational"},
    {"id":"arc-112","kind":"requirement","statement":"A product module SHALL reach tenant data only through the runtime.","rationale":"A module with its own path to a tenant database would bypass the authorisation and the copies that the runtime applies.","evaluate":{"method":"property"},"ref":"ARC-112","area":"09-architecture","section":"Extension","lifecycle":"active","boundary":"b-21","boundaryDetail":"`product module`","traces":["k-3","g-31"],"milestone":2,"inSection":"sec-arch-7","realisation":"construction"},
    {"id":"arc-113","kind":"requirement","statement":"A product module SHALL add its record types, views, workflows and operations as tenant metadata, with no change to the kernel.","rationale":"A feature that changes the kernel changes every tenant at once, and cannot be installed, removed or projected on its own.","evaluate":{"method":"scenario"},"ref":"ARC-113","area":"09-architecture","section":"Extension","lifecycle":"active","boundary":"b-21","boundaryDetail":"`module bundle`","traces":["g-103","k-1","d-103"],"milestone":2,"inSection":"sec-arch-7","realisation":"checked"},
    {"id":"arc-114","kind":"requirement","statement":"The total of connections that one database cluster holds open SHALL stay within the configured ceiling of that cluster, whatever the number of tenants on it.","rationale":"With a database per tenant, connections are the first shared resource that runs out as tenants are added.","evaluate":{"method":"property"},"ref":"ARC-114","area":"09-architecture","section":"Kernel load, limits and connections","lifecycle":"active","boundary":"b-2","boundaryDetail":"`cluster connection ceiling`","traces":["g-102","d-1","d-511"],"milestone":2,"inSection":"sec-arch-5","realisation":"checked"},
    {"id":"arc-115","kind":"requirement","statement":"A stored event SHALL name the version of its format, so that a reader refuses a version that it does not support.","rationale":"Old and new readers meet during a rolling change, and a reader that guesses at a format writes a wrong state.","evaluate":{"method":"property"},"ref":"ARC-115","area":"09-architecture","section":"Change across versions","lifecycle":"active","boundary":"b-2","boundaryDetail":"`event format`","traces":["g-5","g-104"],"milestone":2,"inSection":"sec-arch-4","realisation":"checked"},
    {"id":"m-outbox-effect-once","kind":"invariant","models":"arc-104","statement":"A subscriber that receives one notice twice makes one effect from it.","evaluate":{"method":"state-invariant","scenarios":["arc-outbox-duplicate-delivery","arc-outbox-delayed-first-delivery"],"expr":"arc-outbox-consumer-flow.effects <= 1","negatives":[{"scenario":"arc-outbox-duplicate-delivery","faults":["arc-defect-outbox-duplicate-applied"]},{"scenario":"arc-outbox-delayed-first-delivery","faults":["arc-defect-outbox-duplicate-applied"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-arc-outbox-consumer-flow-refined","kind":"temporal","models":"arc-104","statement":"The implementation of the outbox consumer, which remembers the last sequence number applied, refines the consumer model.","evaluate":{"method":"refines","behavior":"arc-outbox-consumer-flow-impl","scenarios":["arc-outbox-duplicate-delivery-impl","arc-outbox-delayed-first-delivery-impl"]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-outbox-published-after-crash","kind":"temporal","models":"arc-105","statement":"An event that a stopped runtime left unpublished is published by the outbox job.","evaluate":{"method":"eventually","scenarios":["arc-publisher-crashed-after-commit"],"occurs":{"event":"arc-ob-published"},"negatives":[{"scenario":"arc-publisher-crashed-after-commit","faults":["arc-recovery-disabled"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-database-commit"],"faultBasis":"fault"},
    {"id":"m-arc-outbox-delivery-flow-refined","kind":"temporal","models":"arc-105","statement":"The implementation of the outbox delivery, over the stored domain events, refines the delivery model.","evaluate":{"method":"refines","behavior":"arc-outbox-delivery-flow-impl","scenarios":["arc-publisher-crashed-after-commit-impl","arc-idle-sweep-publishes-foreign-commit-impl"]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-old-format-while-old-runs","kind":"invariant","models":"arc-106","statement":"Once a commit is written in the newer format, no older version is still running.","evaluate":{"method":"state-invariant","scenarios":["arc-rolling-deploy-with-commit","rolling-deploy-finish-delayed"],"expr":"arc-rolling-change-flow.newFormat => !arc-rolling-change-flow.oldRunning","negatives":[{"scenario":"arc-rolling-deploy-with-commit","faults":["arc-defect-new-format-early"]},{"scenario":"rolling-deploy-finish-delayed","faults":["arc-defect-new-format-early"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-arc-rolling-change-flow-refined","kind":"temporal","models":"arc-106","statement":"The implementation of the rolling change refines the rolling change model.","evaluate":{"method":"refines","behavior":"arc-rolling-change-flow-impl","scenarios":["arc-rolling-deploy-with-commit-impl","rolling-deploy-finish-delayed-impl"]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-module-through-runtime","kind":"structural","models":"arc-112","statement":"Every path from a product module to a tenant database passes through the runtime.","evaluate":{"method":"only-via","from":"product-module","to":"tenant-database","via":"runtime"},"assumptions":["a-model-abstraction"]},
    {"id":"m-fleet-reads-no-tenant-database","kind":"structural","models":"arc-110","statement":"Fleet reporting has no path to any tenant database.","evaluate":{"method":"no-relationship","from":"fleet-reporting","to":"tenant-database","transitive":true},"assumptions":["a-model-abstraction"]},
    {"id":"m-backup-archive-private","kind":"structural","models":"arc-111","statement":"No component other than the tenant database, the control plane, the PostgreSQL adapter and the file store has a data relationship to the backup archive (telemetry observation excepted, OBS-003).","evaluate":{"method":"no-relationship","from":["kernel","substrate","store-contract","sqlite-adapter","control-database","identity-service","runtime","gateway","automation-worker","connector-runner","copy-store","delivery-network","delivery-network-control","agent-gateway","telemetry-pipeline","audit-log","key-service","mail-service","external-identity-provider","web-application","simulator","verification","agent","limit-store","fleet-reporting","product-module","external-endpoint","notice-queue","search-index","notification-service","conversation-service","model-provider","local-model-adapter","operator-console","outbound-gate","upload-scanner","mail-dispatcher","release-controller","release-pipeline","image-registry","traffic-switch","subject-rights-service","agent-traffic-switch","migration-job","platform-audit-store"],"to":"backup-archive","transitive":false,"kinds":["depends-on","calls","data-flow","publishes","subscribes","reads","writes"]},"assumptions":["a-model-abstraction"]},
    {"id":"adm-150","kind":"requirement","statement":"A tenant SHALL define roles as named sets of permissions over the operations and object types of its schema, and assign each role to people, services, agents and teams.","rationale":"Custom roles fit a tenant's own organisation into the one policy model.","evaluate":{"method":"scenario"},"ref":"ADM-150","area":"09-administration","section":"Roles and teams","lifecycle":"active","boundary":"b-4","boundaryDetail":"`role assignment`","traces":["g-153","k-13"],"milestone":3,"inSection":"sec-administration-2","realisation":"checked"},
    {"id":"adm-151","kind":"requirement","statement":"A principal SHALL hold the permissions of each role assigned to it directly and of each role of each team it belongs to, and no other permission.","rationale":"Team membership grants roles through the same decision as a direct assignment.","evaluate":{"method":"scenario"},"ref":"ADM-151","area":"09-administration","section":"Roles and teams","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["g-153"],"milestone":3,"inSection":"sec-administration-2","realisation":"checked"},
    {"id":"adm-152","kind":"requirement","statement":"Assigning a role SHALL be refused unless the assigning principal holds every permission and every capability that the role grants.","rationale":"Nobody raises their own reach, or anyone else�s, by handing out a role they could not fully use: holding some of what a role grants is not holding it.","evaluate":{"method":"scenario"},"ref":"ADM-152","area":"09-administration","section":"Roles and teams","lifecycle":"active","boundary":"b-4","boundaryDetail":"`role assignment`","traces":["g-153","k-13"],"milestone":3,"inSection":"sec-administration-2","realisation":"checked"},
    {"id":"adm-153","kind":"requirement","statement":"An invitation SHALL grant its roles to the one person who redeems it with the address it names, as verified for the signed-in account and never as the request gives it, and to no one else.","rationale":"An invitation is a grant of roles, so it binds to one address and one redemption.","evaluate":{"method":"scenario"},"ref":"ADM-153","area":"09-administration","section":"Invitations and onboarding","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /invitations/accept`","traces":["g-153"],"milestone":3,"inSection":"sec-administration-3","realisation":"checked"},
    {"id":"adm-154","kind":"requirement","statement":"A person SHALL start a sandbox tenant from a published template and become its owner, with no step taken by the platform operator.","rationale":"A buyer who has to wait for a sales call does not try the product first.","evaluate":{"method":"scenario"},"ref":"ADM-154","area":"09-administration","section":"Invitations and onboarding","lifecycle":"active","boundary":"b-3","boundaryDetail":"`POST /sandboxes`","traces":["g-154"],"milestone":3,"inSection":"sec-administration-3","realisation":"checked"},
    {"id":"adm-155","kind":"requirement","statement":"A sandbox tenant SHALL be deleted at the end of the period that its plan states, unless its owner has kept it.","rationale":"An abandoned sandbox holds personal data and storage that nobody uses.","evaluate":{"method":"scenario"},"ref":"ADM-155","area":"09-administration","section":"Invitations and onboarding","lifecycle":"active","boundary":"b-3","boundaryDetail":"`sandbox expiry`","traces":["g-154","g-157","d-705"],"milestone":3,"inSection":"sec-administration-3","realisation":"checked"},
    {"id":"adm-156","kind":"requirement","statement":"Keeping a sandbox tenant SHALL change its kind to production without copying its records.","rationale":"The kept tenant is the one the customer keeps using, so nothing has to move.","evaluate":{"method":"scenario"},"ref":"ADM-156","area":"09-administration","section":"Invitations and onboarding","lifecycle":"active","boundary":"b-3","boundaryDetail":"`keep sandbox`","traces":["g-154"],"milestone":3,"inSection":"sec-administration-3","realisation":"checked"},
    {"id":"adm-157","kind":"requirement","statement":"Each tenant SHALL record whether it is production, staging or sandbox, and the production tenant that a staging tenant serves.","rationale":"Environments are tenants, so their kind and their link are directory data.","evaluate":{"method":"example"},"ref":"ADM-157","area":"09-administration","section":"Tenant kinds and environments","lifecycle":"active","boundary":"b-3","boundaryDetail":"`tenant kind`","traces":["g-1","d-150"],"milestone":2,"inSection":"sec-administration-4","realisation":"checked"},
    {"id":"adm-158","kind":"requirement","statement":"A change to the configuration of a staging tenant SHALL reach its production tenant only through a proposal that the production policies approve.","rationale":"A promotion changes production, so it takes the route of any other risky change.","evaluate":{"method":"scenario"},"ref":"ADM-158","area":"09-administration","section":"Tenant kinds and environments","lifecycle":"active","boundary":"b-11","boundaryDetail":"`proposal`","traces":["g-164","g-26"],"milestone":7,"inSection":"sec-administration-4","realisation":"checked"},
    {"id":"adm-159","kind":"requirement","statement":"A promotion SHALL carry the tenant metadata of the staging tenant and leave the records of its content where they are.","rationale":"Content is written by people in the tenant that holds it, and a promotion moves configuration only.","evaluate":{"method":"scenario"},"ref":"ADM-159","area":"09-administration","section":"Tenant kinds and environments","lifecycle":"active","boundary":"b-11","boundaryDetail":"`promotion`","traces":["g-164","d-151"],"milestone":7,"inSection":"sec-administration-4","realisation":"checked"},
    {"id":"adm-160","kind":"requirement","statement":"A tenant deletion requested by its owner SHALL stay cancellable until the grace period that its plan states has ended.","rationale":"A deletion made by mistake is the costliest mistake a customer can make.","evaluate":{"method":"scenario"},"ref":"ADM-160","area":"09-administration","section":"Offboarding","lifecycle":"active","boundary":"b-3","boundaryDetail":"`DELETE /tenants/{id}`","traces":["g-160","d-705"],"milestone":2,"inSection":"sec-administration-5","realisation":"checked"},
    {"id":"adm-161","kind":"requirement","statement":"A tenant owner SHALL be able to request the export of TEN-010 and receive it as an archive of the tenant's records, files, configuration and audit entries in documented formats.","rationale":"The customer leaves with the data in a format that another system reads. The archive is the export of TEN-010, one artifact at one endpoint, and this requirement states who may ask for it and what it holds (D-701).","evaluate":{"method":"scenario"},"ref":"ADM-161","area":"09-administration","section":"Offboarding","lifecycle":"active","boundary":"b-153","boundaryDetail":"`POST /tenants/{id}/export`","traces":["g-160","g-1","d-701"],"milestone":2,"inSection":"sec-administration-5","realisation":"checked"},
    {"id":"adm-162","kind":"requirement","statement":"Every archive SHALL hold a manifest that names the hash of each file the archive includes.","rationale":"A customer can check an archive without trusting the platform that produced it.","evaluate":{"method":"property"},"ref":"ADM-162","area":"09-administration","section":"Offboarding","lifecycle":"active","boundary":"b-153","boundaryDetail":"`archive manifest`","traces":["g-160"],"milestone":2,"inSection":"sec-administration-5","realisation":"checked"},
    {"id":"adm-163","kind":"requirement","statement":"A support grant SHALL be issued by an owner of the tenant that it names.","rationale":"The tenant owner decides who may look, and until when.","evaluate":{"method":"scenario"},"ref":"ADM-163","area":"09-administration","section":"Support access","lifecycle":"active","boundary":"b-350","boundaryDetail":"`POST /tenants/{id}/access-grants`","traces":["g-165"],"milestone":4,"inSection":"sec-administration-6","realisation":"checked"},
    {"id":"adm-164","kind":"requirement","statement":"An act of a platform operator in a tenant SHALL leave an audit entry that names the operator, the support grant and the request.","rationale":"The tenant can read back every look that the platform took.","evaluate":{"method":"property"},"ref":"ADM-164","area":"09-administration","section":"Support access","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit entry`","traces":["g-165","g-30"],"milestone":4,"inSection":"sec-administration-6","realisation":"checked"},
    {"id":"adm-165","kind":"requirement","statement":"Withdrawing a support grant SHALL refuse every later request made under that grant.","rationale":"Withdrawal takes effect without waiting for a token to expire.","evaluate":{"method":"scenario"},"ref":"ADM-165","area":"09-administration","section":"Support access","lifecycle":"active","boundary":"b-350","boundaryDetail":"`DELETE /tenants/{id}/access-grants/{grant-id}`","traces":["g-165","g-28"],"milestone":4,"inSection":"sec-administration-6","realisation":"checked"},
    {"id":"bil-150","kind":"requirement","statement":"A tenant SHALL hold one plan that states the quotas of its connections, requests, stored bytes, jobs and emails.","rationale":"Without a plan a tenant has no bound on its own heavy use.","evaluate":{"method":"example"},"ref":"BIL-150","area":"02-tenancy","section":"Plans and quotas","lifecycle":"active","boundary":"b-3","boundaryDetail":"`tenant plan`","traces":["g-157","d-508"],"milestone":2,"inSection":"sec-billing-2","realisation":"checked"},
    {"id":"bil-151","kind":"requirement","statement":"A write that would exceed a quota of the tenant's plan SHALL be refused, with the quota it would exceed named in the refusal.","rationale":"A refused write tells the customer which limit to raise.","evaluate":{"method":"scenario"},"ref":"BIL-151","area":"02-tenancy","section":"Plans and quotas","lifecycle":"active","boundary":"b-11","boundaryDetail":"`operation`","traces":["g-157","g-4"],"milestone":6,"inSection":"sec-billing-2","realisation":"checked"},
    {"id":"bil-152","kind":"requirement","statement":"The platform SHALL count the metered quantities of each tenant for each billing period from the records that carry them.","rationale":"Counts that come from the records can be checked against the records.","evaluate":{"method":"property"},"ref":"BIL-152","area":"02-tenancy","section":"Metering and export","lifecycle":"active","boundary":"b-155","boundaryDetail":"`usage count`","traces":["g-157"],"milestone":6,"inSection":"sec-billing-4","realisation":"checked"},
    {"id":"bil-153","kind":"requirement","statement":"The usage of each billing period SHALL be delivered to the billing system that the tenant configures as a signed document that carries an idempotency key.","rationale":"A billing system that receives the same usage twice counts it once.","evaluate":{"method":"scenario"},"ref":"BIL-153","area":"02-tenancy","section":"Metering and export","lifecycle":"active","boundary":"b-155","boundaryDetail":"`usage export`","traces":["g-157","d-154","d-513"],"milestone":6,"inSection":"sec-billing-4","realisation":"checked"},
    {"id":"bil-154","kind":"requirement","statement":"A trial that ends without a chosen plan SHALL suspend the tenant with all of its data kept.","rationale":"A lapsed trial is a pause, and the buyer can still choose a plan.","evaluate":{"method":"scenario"},"ref":"BIL-154","area":"02-tenancy","section":"Trials","lifecycle":"active","boundary":"b-3","boundaryDetail":"`trial end`","traces":["g-157"],"milestone":2,"inSection":"sec-billing-3","realisation":"checked"},
    {"id":"bil-155","kind":"requirement","statement":"The platform SHALL publish the objectives of each plan and the result measured in each calendar month.","rationale":"A published objective is one that the customer can hold the platform to.","evaluate":{"method":"example"},"ref":"BIL-155","area":"02-tenancy","section":"Published objectives","lifecycle":"active","boundary":"b-156","boundaryDetail":"`service objectives`","traces":["g-168","g-27"],"milestone":12,"inSection":"sec-billing-5","realisation":"checked"},
    {"id":"ntf-150","kind":"requirement","statement":"An email notice SHALL omit the field values of each record that its recipient has no right to read.","rationale":"Email leaves the platform, and what it carries leaves with it.","evaluate":{"method":"property"},"ref":"NTF-150","area":"04-automation","section":"Notices and inbox","lifecycle":"active","boundary":"b-154","boundaryDetail":"`email notice`","traces":["g-155","g-20"],"milestone":5,"inSection":"sec-notifications-2","realisation":"checked"},
    {"id":"ntf-151","kind":"requirement","statement":"Each subscription SHALL choose delivery by email, by the inbox of its recipient, or by both.","rationale":"Some notices belong in the inbox alone, and others are also sent by mail.","evaluate":{"method":"example"},"ref":"NTF-151","area":"04-automation","section":"Notices and inbox","lifecycle":"active","boundary":"b-154","boundaryDetail":"`subscription`","traces":["g-155"],"milestone":5,"inSection":"sec-notifications-2","realisation":"checked"},
    {"id":"ntf-152","kind":"requirement","statement":"An approval step SHALL appear in the inbox of each principal that its policy names, and in no other inbox.","rationale":"The approver sees the task where the approver works, and nobody else sees it.","evaluate":{"method":"scenario"},"ref":"NTF-152","area":"04-automation","section":"Notices and inbox","lifecycle":"active","boundary":"b-154","boundaryDetail":"`approval task`","traces":["g-155","g-151"],"milestone":5,"inSection":"sec-notifications-2","realisation":"checked"},
    {"id":"int-150","kind":"requirement","statement":"An inbound webhook delivery SHALL start a workflow run only when its signature matches the secret of its endpoint.","rationale":"A caller without the secret cannot start work in the tenant.","evaluate":{"method":"scenario"},"ref":"INT-150","area":"04-automation","section":"Inbound webhooks","lifecycle":"active","boundary":"b-150","boundaryDetail":"`inbound webhook`","traces":["g-156"],"milestone":5,"inSection":"sec-integrations-2","realisation":"checked"},
    {"id":"int-151","kind":"requirement","statement":"A repeated inbound delivery of one event SHALL leave the number of runs that it started unchanged.","rationale":"Senders retry, and a retry does not run the workflow twice.","evaluate":{"method":"scenario"},"ref":"INT-151","area":"04-automation","section":"Inbound webhooks","lifecycle":"active","boundary":"b-150","boundaryDetail":"`inbound webhook`","traces":["g-156"],"milestone":5,"inSection":"sec-integrations-2","realisation":"checked"},
    {"id":"int-152","kind":"requirement","statement":"The tenant SHALL see the response status and the attempt count of each outbound webhook delivery that it sent.","rationale":"A failing receiver is diagnosed from the log rather than from guesses.","evaluate":{"method":"scenario"},"ref":"INT-152","area":"04-automation","section":"Outbound deliveries and the catalogue","lifecycle":"active","boundary":"b-150","boundaryDetail":"`webhook log`","traces":["g-156"],"milestone":5,"inSection":"sec-integrations-3","realisation":"checked"},
    {"id":"int-153","kind":"requirement","statement":"A workflow definition that names a trigger or an action outside the published catalogue SHALL be refused at activation, where the catalogue is the variants of the trigger-event union for triggers and of the automation-step union for actions (INT-1522).","rationale":"A workflow uses only what the platform describes and can check.","evaluate":{"method":"scenario"},"ref":"INT-153","area":"04-automation","section":"Outbound deliveries and the catalogue","lifecycle":"active","boundary":"b-8","boundaryDetail":"`activation`","traces":["g-156","g-16"],"milestone":5,"inSection":"sec-integrations-3","realisation":"checked"},
    {"id":"int-154","kind":"requirement","statement":"A tenant SHALL install a platform template or integration only after reviewing the projection of the changes it makes.","rationale":"Installing a template is a change, so it is projected like one.","evaluate":{"method":"scenario"},"ref":"INT-154","area":"04-automation","section":"Installed templates and integrations","lifecycle":"active","boundary":"b-21","boundaryDetail":"`template install`","traces":["g-167","g-44"],"milestone":7,"inSection":"sec-integrations-4","realisation":"checked"},
    {"id":"int-155","kind":"requirement","statement":"A bundle installed from the platform catalogue SHALL contain declared metadata and no executable code.","rationale":"Installing a bundle runs no code of its author, so review means reading what the bundle says.","evaluate":{"method":"property"},"ref":"INT-155","area":"04-automation","section":"Installed templates and integrations","lifecycle":"active","boundary":"b-21","boundaryDetail":"`tenant bundle`","traces":["g-167","ng-150"],"milestone":7,"inSection":"sec-integrations-4","realisation":"checked"},
    {"id":"sch-150","kind":"requirement","statement":"A bulk change to many records SHALL run as jobs that record the outcome of every record they change.","rationale":"A bulk change that stops halfway has a known extent.","evaluate":{"method":"scenario"},"ref":"SCH-150","area":"04-automation","section":"Bulk work","lifecycle":"active","boundary":"b-7","boundaryDetail":"`bulk job`","traces":["g-14"],"milestone":5,"inSection":"sec-scheduling-150","realisation":"checked"},
    {"id":"cms-150","kind":"requirement","statement":"A record SHALL be refused when one of its fields does not hold a value of the field type that its content type declares.","rationale":"The field types are the schema of the content, and every write is checked against them.","evaluate":{"method":"property"},"ref":"CMS-150","area":"07-content","section":"Authoring","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["g-31","g-150"],"milestone":6,"inSection":"sec-content-150","realisation":"checked"},
    {"id":"cms-151","kind":"requirement","statement":"A reference field SHALL name only a record of the content type that the field declares.","rationale":"A reference to the wrong kind of record breaks every page that follows it.","evaluate":{"method":"property"},"ref":"CMS-151","area":"07-content","section":"Authoring","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["g-31"],"milestone":6,"inSection":"sec-content-150","realisation":"checked"},
    {"id":"cms-152","kind":"requirement","statement":"Deleting a record that another record refers to SHALL be refused until the referring field is changed.","rationale":"A deletion leaves no dangling reference on a published page.","evaluate":{"method":"scenario"},"ref":"CMS-152","area":"07-content","section":"Authoring","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["g-31"],"milestone":6,"inSection":"sec-content-150","realisation":"checked"},
    {"id":"cms-153","kind":"requirement","statement":"Saving an edit to a published record SHALL leave its published version unchanged until the draft is published.","rationale":"Readers see a change when it is published, not when it is typed.","evaluate":{"method":"scenario"},"ref":"CMS-153","area":"07-content","section":"Authoring","lifecycle":"active","boundary":"b-1","boundaryDetail":"`draft save`","traces":["g-150"],"milestone":6,"inSection":"sec-content-150","realisation":"checked"},
    {"id":"cms-154","kind":"requirement","statement":"A record created in the authoring application SHALL start as a draft.","rationale":"Nothing a new record holds reaches readers before someone publishes it.","evaluate":{"method":"example"},"ref":"CMS-154","area":"07-content","section":"Authoring","lifecycle":"active","boundary":"b-13","boundaryDetail":"`authoring application`","traces":["g-150"],"milestone":6,"inSection":"sec-content-150","realisation":"checked"},
    {"id":"cms-155","kind":"requirement","statement":"A save from a copy of a draft that is older than the stored draft SHALL be refused, with the current version named.","rationale":"Two editors cannot overwrite each other without a trace.","evaluate":{"method":"scenario"},"ref":"CMS-155","area":"07-content","section":"Authoring","lifecycle":"active","boundary":"b-13","boundaryDetail":"`draft save`","traces":["g-150"],"milestone":6,"inSection":"sec-content-150","realisation":"checked"},
    {"id":"cms-156","kind":"requirement","statement":"A record of a content type that the tenant marks for review SHALL be published only after an approval by a principal that the review policy names.","rationale":"Review is a workflow step with a named approver, so it can be audited.","evaluate":{"method":"scenario"},"ref":"CMS-156","area":"07-content","section":"Review and publication","lifecycle":"active","boundary":"b-8","boundaryDetail":"`review step`","traces":["g-151","g-17"],"milestone":6,"inSection":"sec-content-151","realisation":"checked"},
    {"id":"cms-157","kind":"requirement","statement":"A reviewer SHALL see the differences between a draft and the published version of its record before approving it.","rationale":"A reviewer approves the change itself, not a summary of it.","evaluate":{"method":"scenario"},"ref":"CMS-157","area":"07-content","section":"Review and publication","lifecycle":"active","boundary":"b-13","boundaryDetail":"`review diff`","traces":["g-32"],"milestone":11,"inSection":"sec-content-151","realisation":"checked"},
    {"id":"cms-158","kind":"requirement","statement":"Scheduling a publication SHALL remain cancellable until the publication time.","rationale":"A scheduled change is a plan, and a plan changes until it runs.","evaluate":{"method":"scenario"},"ref":"CMS-158","area":"07-content","section":"Review and publication","lifecycle":"active","boundary":"b-7","boundaryDetail":"`publication time`","traces":["g-17"],"milestone":6,"inSection":"sec-content-151","realisation":"checked"},
    {"id":"cms-159","kind":"requirement","statement":"A preview link SHALL show one stated draft version of one record to a reader without an account, and stop showing it at the expiry that the link states.","rationale":"The reviewer sees what delivery would show, for as long as the review lasts.","evaluate":{"method":"scenario"},"ref":"CMS-159","area":"07-content","section":"Preview links","lifecycle":"active","boundary":"b-9","boundaryDetail":"`preview link`","traces":["g-158","g-20"],"milestone":6,"inSection":"sec-content-152","realisation":"checked"},
    {"id":"cms-160","kind":"requirement","statement":"A preview link SHALL grant access to no record and no screen of the authoring application other than its own draft version.","rationale":"A link sent to a reviewer opens one draft and nothing else.","evaluate":{"method":"scenario"},"ref":"CMS-160","area":"07-content","section":"Preview links","lifecycle":"active","boundary":"b-9","boundaryDetail":"`preview link`","traces":["g-158","g-20"],"milestone":6,"inSection":"sec-content-152","realisation":"checked"},
    {"id":"cms-161","kind":"requirement","statement":"Changing the address of a published page SHALL keep the former address answering with a redirect to the new address.","rationale":"Links from outside the site keep working after a page moves.","evaluate":{"method":"scenario"},"ref":"CMS-161","area":"07-content","section":"Addresses and redirects","lifecycle":"active","boundary":"b-9","boundaryDetail":"`address`","traces":["g-159"],"milestone":6,"inSection":"sec-content-153","realisation":"checked"},
    {"id":"cms-162","kind":"requirement","statement":"A redirect SHALL be refused when it would form a loop with the redirects of the same site.","rationale":"A loop is a page that no reader can reach.","evaluate":{"method":"scenario"},"ref":"CMS-162","area":"07-content","section":"Addresses and redirects","lifecycle":"active","boundary":"b-9","boundaryDetail":"`redirect`","traces":["g-159"],"milestone":6,"inSection":"sec-content-153","realisation":"checked"},
    {"id":"cms-163","kind":"requirement","statement":"A delivery query SHALL return only the fields that the request names in its field selection.","rationale":"Readers take the fields they ask for and no others, so responses stay small and private fields stay private.","evaluate":{"method":"property"},"ref":"CMS-163","area":"07-content","section":"Delivery interface","lifecycle":"active","boundary":"b-9","boundaryDetail":"`field selection`","traces":["g-152","d-507"],"milestone":6,"inSection":"sec-content-154","realisation":"checked"},
    {"id":"cms-164","kind":"requirement","statement":"A delivery list SHALL return one page of results together with the cursor that fetches the next page.","rationale":"Lists of any length arrive in pages that a client can finish.","evaluate":{"method":"scenario"},"ref":"CMS-164","area":"07-content","section":"Delivery interface","lifecycle":"active","boundary":"b-9","boundaryDetail":"`cursor`","traces":["g-152"],"milestone":6,"inSection":"sec-content-154","realisation":"checked"},
    {"id":"cms-165","kind":"requirement","statement":"A delivery list SHALL filter only on the fields that its named query declares as filterable.","rationale":"The filters a client can use are the ones the tenant chose to publish.","evaluate":{"method":"property"},"ref":"CMS-165","area":"07-content","section":"Delivery interface","lifecycle":"active","boundary":"b-9","boundaryDetail":"`named query`","traces":["g-152","g-31"],"milestone":6,"inSection":"sec-content-154","realisation":"checked"},
    {"id":"cms-166","kind":"requirement","statement":"A delivery key SHALL read only the site and the audience class that the key names.","rationale":"A key for one site cannot read another site of the same tenant.","evaluate":{"method":"scenario"},"ref":"CMS-166","area":"07-content","section":"Delivery interface","lifecycle":"active","boundary":"b-6","boundaryDetail":"`delivery key`","traces":["g-152","g-20","d-152"],"milestone":6,"inSection":"sec-content-154","realisation":"checked"},
    {"id":"cms-167","kind":"requirement","statement":"A delivery key that its owner revokes SHALL be refused by the delivery interface on the same terms as a revoked session.","rationale":"One revocation rule covers both kinds of credential.","evaluate":{"method":"scenario"},"ref":"CMS-167","area":"07-content","section":"Delivery interface","lifecycle":"active","boundary":"b-6","boundaryDetail":"`delivery key`","traces":["g-152","g-9"],"milestone":6,"inSection":"sec-content-154","realisation":"checked"},
    {"id":"cms-168","kind":"requirement","statement":"A throttled delivery response SHALL name the limit that applied and the time after which the next request is permitted, as a Retry-After value in seconds.","rationale":"A client that is told the limit can back off without guessing.","evaluate":{"method":"scenario"},"ref":"CMS-168","area":"07-content","section":"Delivery interface","lifecycle":"active","boundary":"b-9","boundaryDetail":"`429`","traces":["g-166","g-4"],"milestone":6,"inSection":"sec-content-154","realisation":"checked"},
    {"id":"cms-169","kind":"requirement","statement":"The delivery interface SHALL be described in a machine-readable document that names each operation with its input and output schema and its version.","rationale":"Clients and tools read the description instead of the documentation.","evaluate":{"method":"example"},"ref":"CMS-169","area":"07-content","section":"Delivery interface","lifecycle":"active","boundary":"b-9","boundaryDetail":"`description document`","traces":["g-152","g-166"],"milestone":6,"inSection":"sec-content-154","realisation":"checked"},
    {"id":"cms-170","kind":"requirement","statement":"A delivery version SHALL remain served for at least 90 days after its replacement is published, or for the longer period that its notice states.","rationale":"A client gets the time it was promised to move.","evaluate":{"method":"budget"},"ref":"CMS-170","area":"07-content","section":"Delivery interface","lifecycle":"active","boundary":"b-9","boundaryDetail":"`delivery version`","traces":["g-166","d-574"],"milestone":6,"inSection":"sec-content-154","realisation":"operational"},
    {"id":"cms-171","kind":"requirement","statement":"A change to the delivery interface SHALL appear in a changelog that names the version it introduced.","rationale":"Customers find changes where they already look.","evaluate":{"method":"example"},"ref":"CMS-171","area":"07-content","section":"Delivery interface","lifecycle":"active","boundary":"b-156","boundaryDetail":"`changelog`","traces":["g-166"],"milestone":6,"inSection":"sec-content-154","realisation":"checked"},
    {"id":"cms-173","kind":"requirement","statement":"A delivery key SHALL be a service account, with the secret, the rotation and the revocation of one.","rationale":"A delivery key is not a second kind of credential: it is issued, rotated and revoked as the service account it is (D-538, TOK-252).","evaluate":{"method":"scenario"},"ref":"CMS-173","area":"07-content","section":"Delivery interface","lifecycle":"active","boundary":"b-6","boundaryDetail":"`delivery key`","traces":["g-152","d-538"],"milestone":6,"inSection":"sec-content-154","realisation":"checked"},
    {"id":"cms-172","kind":"requirement","statement":"An import of records SHALL refuse a record whose fields its content type does not declare.","rationale":"An import cannot add fields that the schema does not have.","evaluate":{"method":"scenario"},"ref":"CMS-172","area":"07-content","section":"Import and export","lifecycle":"active","boundary":"b-153","boundaryDetail":"`record import`","traces":["g-163","g-31"],"milestone":11,"inSection":"sec-content-155","realisation":"checked"},
    {"id":"edg-150","kind":"requirement","statement":"A published site SHALL serve a sitemap that lists the address of each published page of that site.","rationale":"Search engines find the pages that the site lists, so the list is the site's own statement.","evaluate":{"method":"scenario"},"ref":"EDG-150","area":"05-delivery","section":"Discovery","lifecycle":"active","boundary":"b-9","boundaryDetail":"`sitemap`","traces":["g-159"],"milestone":6,"inSection":"sec-edge-150","realisation":"checked"},
    {"id":"edg-151","kind":"requirement","statement":"A collection of published records SHALL be served as a syndication feed that names the address and the publication time of each record.","rationale":"Readers who subscribe get each new record with its time.","evaluate":{"method":"scenario"},"ref":"EDG-151","area":"05-delivery","section":"Discovery","lifecycle":"active","boundary":"b-9","boundaryDetail":"`feed`","traces":["g-159"],"milestone":6,"inSection":"sec-edge-150","realisation":"checked"},
    {"id":"obs-150","kind":"requirement","statement":"A status page SHALL name the state of each component and of each open incident, for readers who hold no account.","rationale":"Customers check status without signing in, and tools read the same page.","evaluate":{"method":"scenario"},"ref":"OBS-150","area":"06-agents","section":"Status","lifecycle":"active","boundary":"b-156","boundaryDetail":"`status page`","traces":["g-27"],"milestone":8,"inSection":"sec-observability-150","realisation":"operational"},
    {"id":"frm-150","kind":"requirement","statement":"A form submission SHALL be stored in the tenant database before the reader is told that it was received.","rationale":"A reader is not told that a message arrived which the tenant cannot see.","evaluate":{"method":"scenario"},"ref":"FRM-150","area":"07-content","section":"Submissions","lifecycle":"active","boundary":"b-152","boundaryDetail":"`form submission`","traces":["g-162","d-153"],"milestone":11,"inSection":"sec-forms-2","realisation":"checked"},
    {"id":"frm-151","kind":"requirement","statement":"A form submission SHALL be refused when it carries no submission token that the form issued to the browser that sent it.","rationale":"Automated posts that did not load the form are refused.","evaluate":{"method":"scenario"},"ref":"FRM-151","area":"07-content","section":"Submissions","lifecycle":"active","boundary":"b-152","boundaryDetail":"`submission token`","traces":["g-162","g-20"],"milestone":11,"inSection":"sec-forms-2","realisation":"checked"},
    {"id":"frm-152","kind":"requirement","statement":"The notice of a submission SHALL be sent through the notification subscriptions that the form names.","rationale":"Submissions reach the people who handle them, by the channels they chose.","evaluate":{"method":"scenario"},"ref":"FRM-152","area":"07-content","section":"Submissions","lifecycle":"active","boundary":"b-154","boundaryDetail":"`submission notice`","traces":["g-162","g-155"],"milestone":11,"inSection":"sec-forms-2","realisation":"checked"},
    {"id":"frm-154","kind":"requirement","statement":"A person with the role that reads submissions SHALL export the submissions of a form as a document of their declared fields.","rationale":"The people who handle submissions can take them out of the platform.","evaluate":{"method":"scenario"},"ref":"FRM-154","area":"07-content","section":"Submissions","lifecycle":"active","boundary":"b-153","boundaryDetail":"`form export`","traces":["g-162"],"milestone":11,"inSection":"sec-forms-2","realisation":"checked"},
    {"id":"srh-150","kind":"requirement","statement":"A search over a site SHALL return only the published records that the audience class of the reader permits.","rationale":"Search is a read like any other, decided by the same policies.","evaluate":{"method":"property"},"ref":"SRH-150","area":"07-content","section":"Queries","lifecycle":"active","boundary":"b-151","boundaryDetail":"`search query`","traces":["g-161","g-20","d-504","d-512"],"milestone":11,"inSection":"sec-search-2","realisation":"checked"},
    {"id":"srh-151","kind":"requirement","statement":"A search by an editor SHALL return the drafts that the editor's roles permit reading, each with its status.","rationale":"An editor finds unpublished work without seeing work the roles do not permit reading.","evaluate":{"method":"scenario"},"ref":"SRH-151","area":"07-content","section":"Queries","lifecycle":"active","boundary":"b-151","boundaryDetail":"`search query`","traces":["g-161"],"milestone":11,"inSection":"sec-search-2","realisation":"checked"},
    {"id":"srh-152","kind":"requirement","statement":"A search entry SHALL follow the commit of the record it was made from, including the commit of its deletion.","rationale":"A deleted record is not found, and an edited one is found by its new words.","evaluate":{"method":"scenario"},"ref":"SRH-152","area":"07-content","section":"Queries","lifecycle":"active","boundary":"b-151","boundaryDetail":"`search entry`","traces":["g-161","g-22","d-153"],"milestone":11,"inSection":"sec-search-2","realisation":"checked"},
    {"id":"m-inbound-repeat-single-run","kind":"invariant","models":"int-151","statement":"In the repeated inbound delivery scenario, a repeated delivery of one event starts no second run.","evaluate":{"method":"state-invariant","scenarios":["inbound-repeated-delivery","inbound-delivery-redelivered"],"expr":"inbound-run-flow.runs <= 1","negatives":[{"scenario":"inbound-repeated-delivery","faults":["defect-webhook-no-dedupe"]},{"scenario":"inbound-delivery-redelivered","faults":["defect-webhook-no-dedupe"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-inbound-run-flow-refined","kind":"temporal","models":"int-151","statement":"The implementation of the inbound event handling refines the inbound run model.","evaluate":{"method":"refines","behavior":"inbound-run-flow-impl","scenarios":["inbound-repeated-delivery-impl","inbound-delivery-redelivered-impl"]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-preview-expired-refused","kind":"temporal","models":"cms-159","statement":"A preview link presented after its expiry shows no draft.","evaluate":{"method":"never","scenarios":["preview-presented-late","preview-presentation-in-transit"],"occurs":{"event":"pl-shown"},"negatives":[{"scenario":"preview-presented-late","faults":["defect-preview-unchecked"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-tick"],"faultBasis":"fault"},
    {"id":"m-preview-link-flow-refined","kind":"temporal","models":"cms-159","statement":"The implementation of the preview link, with its stored expiry, refines the preview link model.","evaluate":{"method":"refines","behavior":"preview-link-flow-impl","scenarios":["preview-presented-late-impl","preview-presentation-in-transit-impl"]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"cnv-200","kind":"requirement","statement":"For every operation that the assistant proposes, the same operation with the same input SHALL be available to the person in the authoring application.","rationale":"The assistant is a client of the catalogue, not a second way to change the platform.","evaluate":{"method":"property"},"ref":"CNV-200","area":"09-conversation","section":"Operations and authority","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /operations`","traces":["g-200","d-200"],"milestone":9,"inSection":"sec-conversation-2","realisation":"checked"},
    {"id":"cnv-201","kind":"requirement","statement":"The assistant SHALL call each operation only with the delegated token of the person it acts for.","rationale":"The token names both the assistant and the person, so every request carries its own attribution.","evaluate":{"method":"scenario"},"ref":"CNV-201","area":"09-conversation","section":"Operations and authority","lifecycle":"active","boundary":"b-11","boundaryDetail":"`POST /operations/{name}`","traces":["g-200","d-200","k-13"],"milestone":9,"inSection":"sec-conversation-2","realisation":"checked"},
    {"id":"cnv-202","kind":"requirement","statement":"The operation catalogue SHALL refuse a call by the assistant for each operation that the person it acts for lacks permission to attempt.","rationale":"The assistant is held to the person's permissions at the one place every call passes.","evaluate":{"method":"property"},"ref":"CNV-202","area":"09-conversation","section":"Operations and authority","lifecycle":"active","boundary":"b-11","boundaryDetail":"`POST /operations/{name}`","traces":["g-200","k-13"],"milestone":9,"inSection":"sec-conversation-2","realisation":"checked"},
    {"id":"cnv-203","kind":"requirement","statement":"When the permissions of a person change during a conversation, the assistant SHALL use the permissions that person holds when each operation runs.","rationale":"A permission withdrawn in the middle of a conversation stops the work, including work already previewed.","evaluate":{"method":"scenario"},"ref":"CNV-203","area":"09-conversation","section":"Operations and authority","lifecycle":"active","boundary":"b-11","boundaryDetail":"`POST /operations/{name}`","traces":["g-200","k-13"],"milestone":9,"inSection":"sec-conversation-2","realisation":"checked"},
    {"id":"cnv-205","kind":"requirement","statement":"A preview SHALL list the records that the change creates, changes and removes, and the views that the change alters.","rationale":"The preview is the projection the person confirms, so it names what changes.","evaluate":{"method":"example"},"ref":"CNV-205","area":"09-conversation","section":"Preview and confirmation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`GET /pending-actions/{id}`","traces":["g-201"],"milestone":9,"inSection":"sec-conversation-3","realisation":"checked"},
    {"id":"cnv-206","kind":"requirement","statement":"A change SHALL be applied only after the person confirms the preview that shows it.","rationale":"Confirmation is the step that turns a suggestion into a change.","evaluate":{"method":"scenario"},"ref":"CNV-206","area":"09-conversation","section":"Preview and confirmation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /pending-actions/{id}/confirm`","traces":["g-201","d-201"],"milestone":9,"inSection":"sec-conversation-3","realisation":"checked"},
    {"id":"cnv-207","kind":"requirement","statement":"A confirmation SHALL bind to the preview it answers, so that an edited or replaced preview needs a new confirmation.","rationale":"A yes to one preview is not a yes to a different change.","evaluate":{"method":"scenario"},"ref":"CNV-207","area":"09-conversation","section":"Preview and confirmation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /pending-actions/{id}/confirm`","traces":["g-201","d-201"],"milestone":9,"inSection":"sec-conversation-3","realisation":"checked"},
    {"id":"cnv-208","kind":"requirement","statement":"A change that tenant policy classes as risky SHALL reach the person as a proposal with its projection, and no control in the conversation applies it directly.","rationale":"Risky changes keep the proposal flow of the agent plane (D-19) whichever interface asks for them.","evaluate":{"method":"scenario"},"ref":"CNV-208","area":"09-conversation","section":"Preview and confirmation","lifecycle":"active","boundary":"b-11","boundaryDetail":"`POST /proposals`","traces":["g-26","d-19","g-201"],"milestone":9,"inSection":"sec-conversation-3","realisation":"checked"},
    {"id":"cnv-209","kind":"requirement","statement":"Undoing a change SHALL preview its inverse operation and apply that inverse only after the person confirms.","rationale":"Undo is a change in its own right, so it is previewed and confirmed like any other.","evaluate":{"method":"scenario"},"ref":"CNV-209","area":"09-conversation","section":"Preview and confirmation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /turns/{id}/undo`","traces":["g-25","g-201"],"milestone":9,"inSection":"sec-conversation-3","realisation":"checked"},
    {"id":"cnv-210","kind":"requirement","statement":"A preview that the person cancels SHALL apply no change to any record.","rationale":"Cancelling stops the proposal it belongs to.","evaluate":{"method":"scenario"},"ref":"CNV-210","area":"09-conversation","section":"Preview and confirmation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /pending-actions/{id}/cancel`","traces":["g-201"],"milestone":9,"inSection":"sec-conversation-3","realisation":"checked"},
    {"id":"cnv-211","kind":"requirement","statement":"A preview SHALL be shown within 3 seconds at the 95th percentile for a tenant of one hundred thousand records.","rationale":"A person waits for the preview before deciding, so the wait is bounded.","evaluate":{"method":"budget"},"ref":"CNV-211","area":"09-conversation","section":"Preview and confirmation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`GET /pending-actions/{id}`","traces":["g-201"],"milestone":9,"inSection":"sec-conversation-3","realisation":"operational"},
    {"id":"cnv-212","kind":"requirement","statement":"A refusal shown in the conversation SHALL name the policy that refused the person and the next step open to the person.","rationale":"A person acts on the reason for a refusal, which the kernel returns as failed checks.","evaluate":{"method":"scenario"},"ref":"CNV-212","area":"09-conversation","section":"Explanation and evidence","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /conversations/{id}/turns`","traces":["g-202","g-24"],"milestone":9,"inSection":"sec-conversation-4","realisation":"checked"},
    {"id":"cnv-213","kind":"requirement","statement":"An answer about what an action would do SHALL come from a dry run of that action, named in the answer.","rationale":"Predictions come from the decision the platform would make, not from the model.","evaluate":{"method":"scenario"},"ref":"CNV-213","area":"09-conversation","section":"Explanation and evidence","lifecycle":"active","boundary":"b-11","boundaryDetail":"`dry run`","traces":["g-202","g-24"],"milestone":9,"inSection":"sec-conversation-4","realisation":"checked"},
    {"id":"cnv-214","kind":"requirement","statement":"For every statement about tenant data that a conversation reply makes, the reply SHALL cite the operation, projection or audit entry that the statement was read from.","rationale":"A statement the reply did not read is a guess, and the person needs to tell the two apart.","evaluate":{"method":"property"},"ref":"CNV-214","area":"09-conversation","section":"Explanation and evidence","lifecycle":"active","boundary":"b-200","boundaryDetail":"`reply`","traces":["g-202","k-2"],"milestone":9,"inSection":"sec-conversation-4","realisation":"checked"},
    {"id":"cnv-215","kind":"requirement","statement":"A reply that has no source for an answer SHALL say so in place of the answer.","rationale":"Silence about the source is not an answer.","evaluate":{"method":"scenario"},"ref":"CNV-215","area":"09-conversation","section":"Explanation and evidence","lifecycle":"active","boundary":"b-200","boundaryDetail":"`reply`","traces":["g-202"],"milestone":9,"inSection":"sec-conversation-4","realisation":"checked"},
    {"id":"cnv-216","kind":"requirement","statement":"A reply SHALL open, point at or fill a view of the authoring application using the view definition that the person would open directly.","rationale":"The conversation and the direct interface show the same screen.","evaluate":{"method":"scenario"},"ref":"CNV-216","area":"09-conversation","section":"One interface","lifecycle":"active","boundary":"b-13","boundaryDetail":"`view definition`","traces":["g-203","d-204"],"milestone":9,"inSection":"sec-conversation-5","realisation":"checked"},
    {"id":"cnv-217","kind":"requirement","statement":"The authoring application SHALL send the current selection to the conversation as context, and show the person that context before the next turn is sent.","rationale":"The selection is what the person is pointing at, so the assistant receives it without a copy step.","evaluate":{"method":"scenario"},"ref":"CNV-217","area":"09-conversation","section":"One interface","lifecycle":"active","boundary":"b-13","boundaryDetail":"`selection`","traces":["g-203"],"milestone":9,"inSection":"sec-conversation-5","realisation":"checked"},
    {"id":"cnv-218","kind":"requirement","statement":"A direct edit in the authoring application SHALL take effect while a reply is in progress, without waiting for that reply.","rationale":"The person can take over at any point.","evaluate":{"method":"scenario"},"ref":"CNV-218","area":"09-conversation","section":"One interface","lifecycle":"active","boundary":"b-13","boundaryDetail":"`edit`","traces":["g-203"],"milestone":9,"inSection":"sec-conversation-5","realisation":"checked"},
    {"id":"cnv-219","kind":"requirement","statement":"For every interface that a reply generates, the interface SHALL be rendered from a view definition and structured blocks, not from markup that a model produced.","rationale":"Generated interfaces are data the platform renders, so a model cannot inject script or style.","evaluate":{"method":"property"},"ref":"CNV-219","area":"09-conversation","section":"One interface","lifecycle":"active","boundary":"b-200","boundaryDetail":"`reply blocks`","traces":["k-12","d-204"],"milestone":9,"inSection":"sec-conversation-5","realisation":"checked"},
    {"id":"cnv-220","kind":"requirement","statement":"A reply SHALL stream as it is produced and end in one recorded state: complete, interrupted or failed.","rationale":"A stream that ends without a state cannot be resumed or explained.","evaluate":{"method":"scenario"},"ref":"CNV-220","area":"09-conversation","section":"Replies, streams and cancellation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`GET /conversations/{id}/stream`","traces":["g-203"],"milestone":9,"inSection":"sec-conversation-6","realisation":"checked"},
    {"id":"cnv-221","kind":"requirement","statement":"Cancelling a reply SHALL stop the model output and every operation of that reply that has not committed.","rationale":"The person's stop applies to the work as well as the words.","evaluate":{"method":"scenario"},"ref":"CNV-221","area":"09-conversation","section":"Replies, streams and cancellation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /turns/{id}/cancel`","traces":["g-201"],"milestone":9,"inSection":"sec-conversation-6","realisation":"checked"},
    {"id":"cnv-222","kind":"requirement","statement":"For every operation of a reply that is cancelled before its commit, the operation SHALL commit no change to any record.","rationale":"An operation that commits after a cancel is the defect cancellation exists to prevent.","evaluate":{"method":"property"},"ref":"CNV-222","area":"09-conversation","section":"Replies, streams and cancellation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /turns/{id}/cancel`","traces":["g-201"],"milestone":9,"inSection":"sec-conversation-6","realisation":"checked"},
    {"id":"cnv-223","kind":"requirement","statement":"A browser that reloads during a reply SHALL resume the reply from its last recorded part, with no part shown twice.","rationale":"A reload must neither lose the reply nor repeat it.","evaluate":{"method":"scenario"},"ref":"CNV-223","area":"09-conversation","section":"Replies, streams and cancellation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`GET /conversations/{id}/stream`","traces":["g-203"],"milestone":9,"inSection":"sec-conversation-6","realisation":"checked"},
    {"id":"cnv-224","kind":"requirement","statement":"The conversation service SHALL send the first part of a reply within 1 second at the 95th percentile after it accepts the person's message.","rationale":"Measures the platform time to the first part, with the model adapter replying from a fixed script.","evaluate":{"method":"budget"},"ref":"CNV-224","area":"09-conversation","section":"Replies, streams and cancellation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`GET /conversations/{id}/stream`","traces":["g-204"],"milestone":9,"inSection":"sec-conversation-6","realisation":"operational"},
    {"id":"cnv-225","kind":"requirement","statement":"A cancellation SHALL take effect within 1 second at the 99th percentile after the person cancels.","rationale":"A stop that arrives late is not a stop.","evaluate":{"method":"budget"},"ref":"CNV-225","area":"09-conversation","section":"Replies, streams and cancellation","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /turns/{id}/cancel`","traces":["g-201"],"milestone":9,"inSection":"sec-conversation-6","realisation":"operational"},
    {"id":"cnv-226","kind":"requirement","statement":"The conversation service SHALL keep every turn of a conversation as tenant data in the tenant database and no transcript in the browser.","rationale":"Conversations follow the tenant, so they are exported and deleted with it (K-2).","evaluate":{"method":"property"},"ref":"CNV-226","area":"09-conversation","section":"Records, retention and visibility","lifecycle":"active","boundary":"b-200","boundaryDetail":"`conversation record`","traces":["k-2","g-200","d-203"],"milestone":9,"inSection":"sec-conversation-7","realisation":"checked"},
    {"id":"cnv-227","kind":"requirement","statement":"Each change that the assistant makes SHALL appear in the audit log with the person it acted for, and in the history of the record it changed, visible to each member permitted to read that record.","rationale":"Several people can see what an assistant did on someone's behalf, and the record says whom it acted for.","evaluate":{"method":"scenario"},"ref":"CNV-227","area":"09-conversation","section":"Records, retention and visibility","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit entry`","traces":["g-25","g-30"],"milestone":9,"inSection":"sec-conversation-7","realisation":"checked"},
    {"id":"cnv-228","kind":"requirement","statement":"For every turn of a conversation, the turn SHALL name by principal identifier the principal that wrote it.","rationale":"Assistant turns and person turns are attributed the same way as other records.","evaluate":{"method":"property"},"ref":"CNV-228","area":"09-conversation","section":"Records, retention and visibility","lifecycle":"active","boundary":"b-200","boundaryDetail":"`turn record`","traces":["g-25","g-200"],"milestone":9,"inSection":"sec-conversation-7","realisation":"checked"},
    {"id":"cnv-229","kind":"requirement","statement":"Deleting a conversation SHALL remove its turns, its pending actions and its model request context within the erasure bound of its class.","rationale":"Conversation history has retention and erasure like any other tenant data.","evaluate":{"method":"scenario"},"ref":"CNV-229","area":"09-conversation","section":"Records, retention and visibility","lifecycle":"active","boundary":"b-200","boundaryDetail":"`DELETE /conversations/{id}`","traces":["g-22","k-8"],"milestone":9,"inSection":"sec-conversation-7","realisation":"checked"},
    {"id":"cnv-230","kind":"requirement","statement":"A conversation SHALL be readable only by the principal that started it and by holders of the tenant's audit permission.","rationale":"Other members see the effects of the assistant in records and in the audit log, not the private conversation.","evaluate":{"method":"scenario"},"ref":"CNV-230","area":"09-conversation","section":"Records, retention and visibility","lifecycle":"active","boundary":"b-200","boundaryDetail":"`GET /conversations/{id}`","traces":["g-20"],"milestone":9,"inSection":"sec-conversation-7","realisation":"checked"},
    {"id":"cnv-231","kind":"requirement","statement":"The model provider adapters SHALL pass every check of the model provider conformance table.","rationale":"An adapter is accepted by behaviour, as the store adapters are.","evaluate":{"method":"conformance"},"ref":"CNV-231","area":"09-conversation","section":"Model provider","lifecycle":"active","boundary":"b-201","boundaryDetail":"`model provider contract`","traces":["g-38","d-202"],"milestone":9,"inSection":"sec-conversation-8","cases":["cases-model-provider-conformance"],"realisation":"checked"},
    {"id":"cnv-232","kind":"requirement","statement":"The local stack SHALL answer a conversation turn through the local model adapter without any cloud credential.","rationale":"The conversation runs in containers with no account, as the rest of the platform does.","evaluate":{"method":"scenario"},"ref":"CNV-232","area":"09-conversation","section":"Model provider","lifecycle":"active","boundary":"b-19","boundaryDetail":"`compose file`","traces":["g-36","k-10"],"milestone":9,"inSection":"sec-conversation-8","realisation":"checked"},
    {"id":"cnv-233","kind":"requirement","statement":"For every model request, the content sent to the model provider SHALL be only the content that the tenant policy permits for the read of the person the request serves.","rationale":"Tenant content reaches a model only as far as a read by that person would reach.","evaluate":{"method":"property"},"ref":"CNV-233","area":"09-conversation","section":"Model provider","lifecycle":"active","boundary":"b-201","boundaryDetail":"`model request`","traces":["k-200","g-205"],"milestone":9,"inSection":"sec-conversation-8","realisation":"checked"},
    {"id":"cnv-234","kind":"requirement","statement":"A tenant that turns the assistant off SHALL have every conversation refused and no model request made, while its records stay readable.","rationale":"Turning the assistant off stops the disclosure and loses nothing.","evaluate":{"method":"scenario"},"ref":"CNV-234","area":"09-conversation","section":"Model provider","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /conversations/{id}/turns`","traces":["g-205"],"milestone":9,"inSection":"sec-conversation-8","realisation":"checked"},
    {"id":"cnv-235","kind":"requirement","statement":"The conversation service SHALL send tenant content to a model provider only under a contract that forbids the provider to train a model on that content.","rationale":"Tenant content is not training material unless the tenant contract says so.","evaluate":{"method":"property"},"ref":"CNV-235","area":"09-conversation","section":"Model provider","lifecycle":"active","boundary":"b-201","boundaryDetail":"`model request`","traces":["g-205"],"milestone":9,"inSection":"sec-conversation-8","realisation":"checked"},
    {"id":"cnv-236","kind":"requirement","statement":"Each reply SHALL name the model provider and the model that produced it.","rationale":"A person can see which system answered.","evaluate":{"method":"example"},"ref":"CNV-236","area":"09-conversation","section":"Model provider","lifecycle":"active","boundary":"b-200","boundaryDetail":"`reply`","traces":["g-205"],"milestone":9,"inSection":"sec-conversation-8","realisation":"checked"},
    {"id":"cnv-237","kind":"requirement","statement":"The conversation SHALL announce a streamed reply in a live region that receives one message when the reply starts and one when it ends.","rationale":"A reply that announces every part floods a screen reader.","evaluate":{"method":"example"},"ref":"CNV-237","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`live region`","traces":["g-204"],"milestone":9,"inSection":"sec-conversation-9","realisation":"checked"},
    {"id":"cnv-238","kind":"requirement","statement":"Every control of the conversation SHALL be operable with the keyboard alone.","rationale":"A conversation that needs a pointer is not usable by everyone.","evaluate":{"method":"example"},"ref":"CNV-238","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`conversation controls`","traces":["g-204"],"milestone":9,"inSection":"sec-conversation-9","realisation":"checked"},
    {"id":"cnv-239","kind":"requirement","statement":"When a preview appears in answer to a message the person sent, focus SHALL move to it, and an unasked preview is announced without moving focus.","rationale":"Focus moves only when the person asked for the result.","evaluate":{"method":"scenario"},"ref":"CNV-239","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`preview`","traces":["g-204"],"milestone":9,"inSection":"sec-conversation-9","realisation":"checked"},
    {"id":"cnv-240","kind":"requirement","statement":"The live region of the conversation SHALL announce no more than one message per 10 seconds while a reply streams.","rationale":"A bounded announcement rate keeps a screen reader usable during a long reply.","evaluate":{"method":"budget"},"ref":"CNV-240","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`live region`","traces":["g-204"],"milestone":9,"inSection":"sec-conversation-9","realisation":"operational"},
    {"id":"cnv-241","kind":"requirement","statement":"Motion in the conversation SHALL stop while the person prefers reduced motion.","rationale":"Reduced motion is a setting the platform honours.","evaluate":{"method":"example"},"ref":"CNV-241","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`conversation`","traces":["g-204"],"milestone":9,"inSection":"sec-conversation-9","realisation":"checked"},
    {"id":"cnv-242","kind":"requirement","statement":"A stream SHALL resume within 3 seconds at the 95th percentile after a dropped connection is restored.","rationale":"Poor networks drop connections, and the reply should carry on from where it stopped.","evaluate":{"method":"budget"},"ref":"CNV-242","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`GET /conversations/{id}/stream`","traces":["g-204"],"milestone":9,"inSection":"sec-conversation-9","realisation":"operational"},
    {"id":"cnv-243","kind":"requirement","statement":"Every control of the conversation SHALL have a target of at least 24 CSS pixels in each direction at a width of 360 CSS pixels.","rationale":"The minimum target size of WCAG 2.2 at the narrowest phone width the platform supports.","evaluate":{"method":"budget"},"ref":"CNV-243","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`conversation controls`","traces":["g-204"],"milestone":9,"inSection":"sec-conversation-9","realisation":"operational"},
    {"id":"cnv-244","kind":"requirement","statement":"A reply SHALL reflow without horizontal scrolling at a width of 360 CSS pixels.","rationale":"A long reply does not need sideways scrolling on a phone.","evaluate":{"method":"budget"},"ref":"CNV-244","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`reply`","traces":["g-204"],"milestone":9,"inSection":"sec-conversation-9","realisation":"operational"},
    {"id":"cnv-245","kind":"requirement","statement":"While the connection is lost, the conversation SHALL keep the drafted message and send it once when the connection returns, with no duplicate turn.","rationale":"A message written on a train arrives once.","evaluate":{"method":"scenario"},"ref":"CNV-245","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`draft`","traces":["g-204"],"milestone":9,"inSection":"sec-conversation-9","realisation":"checked"},
    {"id":"cnv-246","kind":"requirement","statement":"A reply SHALL follow the language of the message it answers, and the interface text of the conversation follows the language the person chose.","rationale":"Localisation of the conversation follows the localisation of content (G-34).","evaluate":{"method":"example"},"ref":"CNV-246","area":"09-conversation","section":"Accessibility, network and language","lifecycle":"active","boundary":"b-200","boundaryDetail":"`reply`","traces":["g-34","g-204","d-515"],"milestone":11,"inSection":"sec-conversation-9","realisation":"checked"},
    {"id":"cnv-247","kind":"requirement","statement":"A new tenant SHALL be set up through the conversation by choosing a template, defining its content types and inviting people, with each step applied only after the person confirms it.","rationale":"Onboarding uses the same previews and confirmations as every other change.","evaluate":{"method":"scenario"},"ref":"CNV-247","area":"09-conversation","section":"Onboarding","lifecycle":"active","boundary":"b-200","boundaryDetail":"`conversation`","traces":["g-207","g-2"],"milestone":11,"inSection":"sec-conversation-10","realisation":"checked"},
    {"id":"cnv-248","kind":"requirement","statement":"Text from a source outside the tenant, such as a received email or a fetched web page, SHALL be shown with a label that names its source wherever the conversation presents it.","rationale":"The person sees that text came from outside the tenant. This is the interface half of the defence against injected instructions.","evaluate":{"method":"example"},"ref":"CNV-248","area":"09-conversation","section":"Untrusted content","lifecycle":"active","boundary":"b-200","boundaryDetail":"`reply`","traces":["k-12","g-200"],"milestone":9,"inSection":"sec-conversation-11","realisation":"checked"},
    {"id":"uxa-200","kind":"requirement","statement":"An empty list in the authoring application SHALL name what it will hold and offer the action that fills it.","rationale":"An empty list that says nothing tells a person nothing.","evaluate":{"method":"example"},"ref":"UXA-200","area":"09-conversation","section":"Empty states, errors and sign-in","lifecycle":"active","boundary":"b-13","boundaryDetail":"`authoring application list`","traces":["g-206"],"milestone":11,"inSection":"sec-authoring-2","realisation":"checked"},
    {"id":"uxa-201","kind":"requirement","statement":"An error in the authoring application SHALL name the field or record it concerns and say how to correct it.","rationale":"An error that names no field sends the person looking for the problem.","evaluate":{"method":"example"},"ref":"UXA-201","area":"09-conversation","section":"Empty states, errors and sign-in","lifecycle":"active","boundary":"b-13","boundaryDetail":"`authoring application error`","traces":["g-206"],"milestone":11,"inSection":"sec-authoring-2","realisation":"checked"},
    {"id":"uxa-202","kind":"requirement","statement":"A sign-in error SHALL state the next step in words that do not depend on whether the address has an account.","rationale":"The person learns what to do without learning who has an account.","evaluate":{"method":"example"},"ref":"UXA-202","area":"09-conversation","section":"Empty states, errors and sign-in","lifecycle":"active","boundary":"b-13","boundaryDetail":"`POST /sign-in/{method}`","traces":["g-46","g-206"],"milestone":3,"inSection":"sec-authoring-2","realisation":"checked"},
    {"id":"uxa-203","kind":"requirement","statement":"The sign-in page SHALL offer recovery beside every sign-in method it offers, so that a person who has lost every method reaches recovery from the same page.","rationale":"A locked-out person needs recovery on the page they are already on.","evaluate":{"method":"example"},"ref":"UXA-203","area":"09-conversation","section":"Empty states, errors and sign-in","lifecycle":"active","boundary":"b-13","boundaryDetail":"`sign-in page`","traces":["g-46","g-206"],"milestone":3,"inSection":"sec-authoring-2","realisation":"checked"},
    {"id":"uxa-204","kind":"requirement","statement":"The authoring application SHALL save a draft within 2 seconds after the person's last edit.","rationale":"Autosave removes the fear of losing work without a save control.","evaluate":{"method":"budget"},"ref":"UXA-204","area":"09-conversation","section":"Drafts, saves and conflicts","lifecycle":"active","boundary":"b-13","boundaryDetail":"`draft`","traces":["g-206"],"milestone":11,"inSection":"sec-authoring-3","realisation":"operational"},
    {"id":"uxa-205","kind":"requirement","statement":"A draft not yet saved SHALL stay on screen through a connection loss and be sent when the connection returns.","rationale":"A dropped connection does not discard typed work.","evaluate":{"method":"scenario"},"ref":"UXA-205","area":"09-conversation","section":"Drafts, saves and conflicts","lifecycle":"active","boundary":"b-13","boundaryDetail":"`draft`","traces":["g-206"],"milestone":11,"inSection":"sec-authoring-3","realisation":"checked"},
    {"id":"uxa-206","kind":"requirement","statement":"When two people save changes to one record from the same version, the second save SHALL be refused with both versions shown.","rationale":"A silent overwrite is the defect that collaborative editing exists to prevent.","evaluate":{"method":"scenario"},"ref":"UXA-206","area":"09-conversation","section":"Drafts, saves and conflicts","lifecycle":"active","boundary":"b-202","boundaryDetail":"`PUT /records/{id}`","traces":["g-206","g-32"],"milestone":11,"inSection":"sec-authoring-3","realisation":"checked"},
    {"id":"uxa-207","kind":"requirement","statement":"A resolved conflict SHALL become a new version in which the person chose the value of each field that conflicted.","rationale":"The history records the decision and keeps the earlier versions.","evaluate":{"method":"scenario"},"ref":"UXA-207","area":"09-conversation","section":"Drafts, saves and conflicts","lifecycle":"active","boundary":"b-202","boundaryDetail":"`PUT /records/{id}`","traces":["g-206","g-32"],"milestone":11,"inSection":"sec-authoring-3","realisation":"checked"},
    {"id":"uxa-208","kind":"requirement","statement":"A change of another editor's presence SHALL appear in the authoring application within 3 seconds at the 95th percentile.","rationale":"Presence that lags says nothing about who is editing now.","evaluate":{"method":"budget"},"ref":"UXA-208","area":"09-conversation","section":"Drafts, saves and conflicts","lifecycle":"active","boundary":"b-202","boundaryDetail":"`presence`","traces":["g-206"],"milestone":11,"inSection":"sec-authoring-3","realisation":"operational"},
    {"id":"uxa-209","kind":"requirement","statement":"The authoring application SHALL show by display name each other person editing a record before the person starts editing it.","rationale":"Two people on one field are found before the second one types.","evaluate":{"method":"example"},"ref":"UXA-209","area":"09-conversation","section":"Drafts, saves and conflicts","lifecycle":"active","boundary":"b-202","boundaryDetail":"`presence`","traces":["g-206"],"milestone":11,"inSection":"sec-authoring-3","realisation":"checked"},
    {"id":"uxa-210","kind":"requirement","statement":"The authoring application SHALL mark a change shown before the server confirms it as pending, and withdraw it with its reason when the server refuses it.","rationale":"An optimistic change that is reverted without a reason teaches people not to trust the screen.","evaluate":{"method":"scenario"},"ref":"UXA-210","area":"09-conversation","section":"Drafts, saves and conflicts","lifecycle":"active","boundary":"b-13","boundaryDetail":"`save`","traces":["g-206"],"milestone":11,"inSection":"sec-authoring-3","realisation":"checked"},
    {"id":"uxa-211","kind":"requirement","statement":"A session that ends during editing SHALL keep the unsaved changes on screen and offer sign-in again without losing them.","rationale":"Revocation or expiry does not take unsaved work with it.","evaluate":{"method":"scenario"},"ref":"UXA-211","area":"09-conversation","section":"Sessions, destructive actions and layout","lifecycle":"active","boundary":"b-13","boundaryDetail":"`session`","traces":["g-9","g-206"],"milestone":11,"inSection":"sec-authoring-4","realisation":"checked"},
    {"id":"uxa-212","kind":"requirement","statement":"A destructive action SHALL name what it removes and require a confirmation that repeats that name.","rationale":"Deleting the wrong record is the most expensive mistake an author can make.","evaluate":{"method":"example"},"ref":"UXA-212","area":"09-conversation","section":"Sessions, destructive actions and layout","lifecycle":"active","boundary":"b-13","boundaryDetail":"`destructive action`","traces":["g-206"],"milestone":11,"inSection":"sec-authoring-4","realisation":"checked"},
    {"id":"uxa-213","kind":"requirement","statement":"The sign-in page SHALL show its first content within 1 second at the 95th percentile.","rationale":"Signing in is the one flow nobody can skip.","evaluate":{"method":"budget"},"ref":"UXA-213","area":"09-conversation","section":"Empty states, errors and sign-in","lifecycle":"active","boundary":"b-13","boundaryDetail":"`GET /sign-in`","traces":["g-45"],"milestone":3,"inSection":"sec-authoring-2","realisation":"operational"},
    {"id":"uxa-214","kind":"requirement","statement":"Each view of the authoring application SHALL reflow without horizontal scrolling at a width of 360 CSS pixels.","rationale":"Authors on a phone can read and edit every view.","evaluate":{"method":"budget"},"ref":"UXA-214","area":"09-conversation","section":"Sessions, destructive actions and layout","lifecycle":"active","boundary":"b-13","boundaryDetail":"`view`","traces":["g-45","g-206"],"milestone":11,"inSection":"sec-authoring-4","realisation":"operational"},
    {"id":"m-cv-applied-after-confirmation","kind":"invariant","models":"cnv-206","statement":"A change the assistant applied was confirmed by the person first.","evaluate":{"method":"state-invariant","scenarios":["cv-confirmed-apply","cv-unconfirmed-apply","cv-cancelled-preview","cv-confirmation-in-transit"],"expr":"cv-change-flow.applied => cv-change-flow.confirmed","negatives":[{"scenario":"cv-unconfirmed-apply","faults":["defect-cv-apply-unconfirmed"]},{"scenario":"cv-confirmation-in-transit","faults":["defect-cv-apply-unconfirmed"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-cv-unconfirmed-never-applied","kind":"temporal","models":"cnv-206","statement":"A change applied before the person confirmed it never commits.","evaluate":{"method":"never","scenarios":["cv-unconfirmed-apply","cv-apply-before-delayed-confirmation"],"occurs":{"event":"cv-applied"},"negatives":[{"scenario":"cv-unconfirmed-apply","faults":["defect-cv-apply-unconfirmed"]},{"scenario":"cv-apply-before-delayed-confirmation","faults":["defect-cv-apply-unconfirmed"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-cv-change-flow-refined","kind":"temporal","models":"cnv-206","statement":"The implementation of the conversation change, with its stored pending action, refines the change model.","evaluate":{"method":"refines","behavior":"cv-change-flow-impl","scenarios":["cv-confirmed-apply-impl","cv-unconfirmed-apply-impl","cv-cancelled-preview-impl","cv-confirmation-in-transit-impl","cv-apply-before-delayed-confirmation-impl"]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-cv-stale-authority-refused","kind":"temporal","models":"cnv-203","statement":"An operation whose permission was withdrawn before it runs never commits.","evaluate":{"method":"never","scenarios":["cv-withdrawn-before-run","cv-run-in-transit-past-withdrawal"],"occurs":{"event":"cv-operation-committed"},"negatives":[{"scenario":"cv-withdrawn-before-run","faults":["defect-cv-apply-stale"]},{"scenario":"cv-run-in-transit-past-withdrawal","faults":["defect-cv-apply-stale"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-cv-permitted-operation-commits","kind":"temporal","models":"cnv-203","statement":"An operation run while its permission holds commits.","evaluate":{"method":"eventually","scenarios":["cv-permitted-run"],"occurs":{"event":"cv-operation-committed"},"negatives":[{"scenario":"cv-permitted-run","faults":["cv-run-disabled"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"restatement"},
    {"id":"m-cv-authority-flow-refined","kind":"temporal","models":"cnv-203","statement":"The implementation of the conversation operation authority check refines the authority model.","evaluate":{"method":"refines","behavior":"cv-authority-flow-impl","scenarios":["cv-withdrawn-before-run-impl","cv-permitted-run-impl","cv-run-in-transit-past-withdrawal-impl"]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-conversation-reaches-data-through-store","kind":"structural","models":"cnv-226","statement":"Every path from the conversation service to a tenant database passes through the store contract.","evaluate":{"method":"only-via","from":"conversation-service","to":"tenant-database","via":"store-contract"},"assumptions":["a-model-abstraction"]},
    {"id":"m-browser-reaches-conversation-through-gateway","kind":"structural","models":"cnv-700","statement":"Every path from the web application to the conversation service passes through the gateway.","evaluate":{"method":"only-via","from":"web-application","to":"conversation-service","via":"gateway"},"assumptions":["a-model-abstraction"]},
    {"id":"m-model-provider-no-tenant-database","kind":"structural","models":"cnv-233","statement":"The model provider has no path to any tenant database.","evaluate":{"method":"no-relationship","from":"model-provider","to":"tenant-database","transitive":true},"assumptions":["a-model-abstraction"]},
    {"id":"idn-250","kind":"requirement","statement":"Password attempts from one source SHALL be refused across all accounts once the failures from that source reach the threshold that D-700 states.","rationale":"A password sprayed across many accounts from one source is refused at the source.","evaluate":{"method":"scenario"},"ref":"IDN-250","area":"03-identity","section":"Guessing and enumeration","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/password`","traces":["g-251","d-252","d-535","d-700"],"milestone":3,"inSection":"sec-identity-250","realisation":"checked"},
    {"id":"idn-251","kind":"requirement","statement":"Password attempts across the accounts of one realm SHALL be slowed while their failure rate stays above the rate that D-700 states.","rationale":"Spraying is slowed for the whole realm, whichever source it comes from.","evaluate":{"method":"scenario"},"ref":"IDN-251","area":"03-identity","section":"Guessing and enumeration","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/password`","traces":["g-251","d-252","d-700"],"milestone":3,"inSection":"sec-identity-250","realisation":"checked"},
    {"id":"idn-252","kind":"requirement","statement":"A password chosen at sign-up or at a change SHALL be refused when it appears on the breached-password list that the realm uses.","rationale":"Passwords taken from other breaches are the ones guessing starts with.","evaluate":{"method":"example"},"ref":"IDN-252","area":"03-identity","section":"Guessing and enumeration","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-up`","traces":["g-251"],"milestone":3,"inSection":"sec-identity-250","realisation":"checked"},
    {"id":"idn-253","kind":"requirement","statement":"A one-time code SHALL be spent when its failed presentations reach the limit that D-700 states.","rationale":"A code that can be tried without end is a password with a short alphabet.","evaluate":{"method":"scenario"},"ref":"IDN-253","area":"03-identity","section":"Guessing and enumeration","lifecycle":"active","boundary":"b-4","boundaryDetail":"`one-time code`","traces":["g-251","k-4","d-700"],"milestone":3,"inSection":"sec-identity-250","realisation":"checked"},
    {"id":"idn-254","kind":"requirement","statement":"A one-time code SHALL be drawn at random for each challenge, so that a code of one challenge opens no other challenge.","rationale":"Codes drawn in sequence, or shared across challenges, can be predicted.","evaluate":{"method":"property"},"ref":"IDN-254","area":"03-identity","section":"Guessing and enumeration","lifecycle":"active","boundary":"b-4","boundaryDetail":"`one-time code`","traces":["g-251"],"milestone":3,"inSection":"sec-identity-250","realisation":"checked"},
    {"id":"idn-255","kind":"requirement","statement":"A password sign-in for an account that does not exist SHALL take as long to answer as a wrong password for an account that does exist.","rationale":"A difference in answer time tells an attacker which accounts exist.","evaluate":{"method":"scenario"},"ref":"IDN-255","area":"03-identity","section":"Guessing and enumeration","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/password`","traces":["g-252"],"milestone":3,"inSection":"sec-identity-250","realisation":"checked"},
    {"id":"idn-256","kind":"requirement","statement":"A sign-up request for an address that already has an account SHALL receive the response that a new address receives.","rationale":"Sign-up does not confirm which addresses hold accounts.","evaluate":{"method":"scenario"},"ref":"IDN-256","area":"03-identity","section":"Guessing and enumeration","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-up`","traces":["g-252"],"milestone":3,"inSection":"sec-identity-250","realisation":"checked"},
    {"id":"idn-257","kind":"requirement","statement":"The owner of an address SHALL be sent a notice when a sign-up or a recovery request names that address.","rationale":"The owner learns of the attempt even though the attacker learns nothing.","evaluate":{"method":"scenario"},"ref":"IDN-257","area":"03-identity","section":"Guessing and enumeration","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-up`","traces":["g-252","g-253"],"milestone":3,"inSection":"sec-identity-250","realisation":"checked"},
    {"id":"idn-258","kind":"requirement","statement":"A sign-in that succeeds from a source or a device the account has not used before SHALL send the account owner a notice.","rationale":"Credential stuffing that succeeds is visible to the owner at once.","evaluate":{"method":"scenario"},"ref":"IDN-258","area":"03-identity","section":"Guessing and enumeration","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/password`","traces":["g-253"],"milestone":3,"inSection":"sec-identity-250","realisation":"checked"},
    {"id":"idn-259","kind":"requirement","statement":"A session SHALL end when its idle lifetime or its absolute lifetime, whichever the realm sets shorter, has passed.","rationale":"A session left open on a shared machine is a session that someone else can use.","evaluate":{"method":"scenario"},"ref":"IDN-259","area":"03-identity","section":"Sessions, cookies and passkeys","lifecycle":"active","boundary":"b-4","boundaryDetail":"`sign-in session`","traces":["g-9","k-16"],"milestone":3,"inSection":"sec-identity-251","realisation":"checked"},
    {"id":"idn-260","kind":"requirement","statement":"A sensitive operation SHALL require a fresh authentication when its session appears from a network context that differs from the one that authenticated it.","rationale":"A session moved to another network is treated as a new arrival.","evaluate":{"method":"scenario"},"ref":"IDN-260","area":"03-identity","section":"Sessions, cookies and passkeys","lifecycle":"active","boundary":"b-4","boundaryDetail":"`realm policy`","traces":["g-8","g-253","d-704","d-4915"],"milestone":3,"inSection":"sec-identity-251","realisation":"checked"},
    {"id":"idn-261","kind":"requirement","statement":"A session cookie SHALL be set without a domain attribute, so that the browser returns it only to the host that set it.","rationale":"A cookie with a parent domain reaches every sibling tenant and every host under it, and public suffix rules do not protect a platform's own tenants.","evaluate":{"method":"example"},"ref":"IDN-261","area":"03-identity","section":"Sessions, cookies and passkeys","lifecycle":"active","boundary":"b-4","boundaryDetail":"`strata_sid`","traces":["g-254","d-250","k-16"],"milestone":3,"inSection":"sec-identity-251","realisation":"checked"},
    {"id":"idn-262","kind":"requirement","statement":"A session cookie SHALL carry the host name prefix and the attribute that limits it to encrypted connections.","rationale":"The prefix stops another host from setting a cookie of the same name, and the attribute keeps it off plain connections.","evaluate":{"method":"example"},"ref":"IDN-262","area":"03-identity","section":"Sessions, cookies and passkeys","lifecycle":"active","boundary":"b-4","boundaryDetail":"`__Host-strata_sid`","traces":["g-254","k-16","d-536"],"milestone":3,"inSection":"sec-identity-251","realisation":"checked"},
    {"id":"idn-263","kind":"requirement","statement":"Sign-out SHALL revoke the session at the identity service, and not only the cookie in the browser.","rationale":"A copied cookie does not outlive the sign-out of its owner.","evaluate":{"method":"scenario"},"ref":"IDN-263","area":"03-identity","section":"Sessions, cookies and passkeys","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-out`","traces":["g-9","g-253"],"milestone":3,"inSection":"sec-identity-251","realisation":"checked"},
    {"id":"idn-264","kind":"requirement","statement":"A passkey assertion SHALL carry a challenge issued for that sign-in and bound to the address that the sign-in was requested at.","rationale":"A replayed assertion from another sign-in or another address is refused.","evaluate":{"method":"scenario"},"ref":"IDN-264","area":"03-identity","section":"Sessions, cookies and passkeys","lifecycle":"active","boundary":"b-4","boundaryDetail":"`WebAuthn relying party`","traces":["g-6","k-14"],"milestone":3,"inSection":"sec-identity-251","realisation":"checked"},
    {"id":"idn-265","kind":"requirement","statement":"Account recovery SHALL notify every registered contact of the account before it completes, after the delay that D-700 states.","rationale":"Recovery is the weakest factor, so the owner is told and given time to object.","evaluate":{"method":"scenario"},"ref":"IDN-265","area":"03-identity","section":"Recovery, factors and prompts","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /recovery`","traces":["g-253","g-46","d-700"],"milestone":3,"inSection":"sec-identity-252","realisation":"checked"},
    {"id":"idn-266","kind":"requirement","statement":"Account recovery SHALL leave the second factor of the realm in force at the next sign-in.","rationale":"Recovery of a password does not switch off the second factor.","evaluate":{"method":"scenario"},"ref":"IDN-266","area":"03-identity","section":"Recovery, factors and prompts","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /recovery`","traces":["g-8"],"milestone":3,"inSection":"sec-identity-252","realisation":"checked"},
    {"id":"idn-267","kind":"requirement","statement":"A realm that requires a second factor SHALL refuse a sign-in method that proves only one factor.","rationale":"A sign-in through a provider or an emailed link is not a way around the second factor.","evaluate":{"method":"scenario"},"ref":"IDN-267","area":"03-identity","section":"Recovery, factors and prompts","lifecycle":"active","boundary":"b-4","boundaryDetail":"`realm policy`","traces":["g-8"],"milestone":3,"inSection":"sec-identity-252","realisation":"checked"},
    {"id":"idn-268","kind":"requirement","statement":"The number of second-factor prompts sent to one account SHALL be limited by the realm within the window that D-700 states.","rationale":"Prompt flooding wears a person down until they approve one.","evaluate":{"method":"scenario"},"ref":"IDN-268","area":"03-identity","section":"Recovery, factors and prompts","lifecycle":"active","boundary":"b-4","boundaryDetail":"`second factor prompt`","traces":["g-253","g-8","d-700"],"milestone":3,"inSection":"sec-identity-252","realisation":"checked"},
    {"id":"idn-269","kind":"requirement","statement":"The emailed sign-in links requested for one address and those requested from one browser SHALL each be limited by the platform.","rationale":"Limits on both keys stop email bombing and the use of the link endpoint to flood a mailbox.","evaluate":{"method":"scenario"},"ref":"IDN-269","area":"03-identity","section":"Recovery, factors and prompts","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-in/link/request`","traces":["g-251","d-9"],"milestone":3,"inSection":"sec-identity-252","realisation":"checked"},
    {"id":"idn-270","kind":"requirement","statement":"Sign-up requests from one source SHALL be limited by the platform within the window that D-700 states.","rationale":"Sign-up is an abuse path for mail and for account creation.","evaluate":{"method":"scenario"},"ref":"IDN-270","area":"03-identity","section":"Recovery, factors and prompts","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-up`","traces":["g-251","g-262","d-700"],"milestone":3,"inSection":"sec-identity-252","realisation":"checked"},
    {"id":"fed-250","kind":"requirement","statement":"The return address of a federated sign-in SHALL name a path on the host of the tenant that started it, whichever protocol carried the sign-in.","rationale":"A return address that leaves the tenant turns a sign-in into an open redirect.","evaluate":{"method":"scenario"},"ref":"FED-250","area":"03-identity","section":"Messages and return addresses","lifecycle":"active","boundary":"b-5","boundaryDetail":"`return address`","traces":["g-255"],"milestone":4,"inSection":"sec-federation-250","realisation":"checked"},
    {"id":"fed-251","kind":"requirement","statement":"A SAML message SHALL be read with external entity and document type processing turned off.","rationale":"A message that names an external entity can read files of the platform or reach its network.","evaluate":{"method":"example"},"ref":"FED-251","area":"03-identity","section":"Messages and return addresses","lifecycle":"active","boundary":"b-5","boundaryDetail":"`POST /federation/saml/acs`","traces":["g-255"],"milestone":4,"inSection":"sec-federation-250","realisation":"checked"},
    {"id":"fed-252","kind":"requirement","statement":"A SAML sign-in SHALL take the subject and the attributes only from the assertion whose signature covers them.","rationale":"A signed assertion with an unsigned copy wrapped around it is the signature wrapping attack.","evaluate":{"method":"scenario"},"ref":"FED-252","area":"03-identity","section":"Messages and return addresses","lifecycle":"active","boundary":"b-5","boundaryDetail":"`POST /federation/saml/acs`","traces":["g-255"],"milestone":4,"inSection":"sec-federation-250","realisation":"checked"},
    {"id":"fed-253","kind":"requirement","statement":"The subject identifier of a SAML assertion SHALL be the complete text of its name identifier, with markup comments excluded.","rationale":"A comment inside the identifier does not split it into a name that another person holds.","evaluate":{"method":"example"},"ref":"FED-253","area":"03-identity","section":"Messages and return addresses","lifecycle":"active","boundary":"b-5","boundaryDetail":"`POST /federation/saml/acs`","traces":["g-255"],"milestone":4,"inSection":"sec-federation-250","realisation":"checked"},
    {"id":"fed-254","kind":"requirement","statement":"A SAML assertion SHALL be accepted only from the issuer that the provider configuration of the realm names.","rationale":"An assertion from a second provider that a tenant once trusted is not accepted for the first.","evaluate":{"method":"scenario"},"ref":"FED-254","area":"03-identity","section":"Messages and return addresses","lifecycle":"active","boundary":"b-5","boundaryDetail":"`POST /federation/saml/acs`","traces":["g-255"],"milestone":4,"inSection":"sec-federation-250","realisation":"checked"},
    {"id":"fed-255","kind":"requirement","statement":"An identity token SHALL be verified only with the signature method that the provider configuration names.","rationale":"A token that names a weaker or no signature method is the algorithm confusion attack.","evaluate":{"method":"scenario"},"ref":"FED-255","area":"03-identity","section":"Assertions and tokens checked","lifecycle":"active","boundary":"b-5","boundaryDetail":"`identity token`","traces":["g-255"],"milestone":4,"inSection":"sec-federation-251","realisation":"checked"},
    {"id":"fed-256","kind":"requirement","statement":"A signing key of one provider SHALL verify the tokens of that provider only.","rationale":"A key of one provider that verified another provider's tokens would let one tenant's provider sign in as another's.","evaluate":{"method":"scenario"},"ref":"FED-256","area":"03-identity","section":"Assertions and tokens checked","lifecycle":"active","boundary":"b-5","boundaryDetail":"`provider metadata`","traces":["g-255","g-20"],"milestone":4,"inSection":"sec-federation-251","realisation":"checked"},
    {"id":"fed-257","kind":"requirement","statement":"An email address that a provider asserts SHALL link to an existing principal only when the provider marks the address as verified.","rationale":"A provider that lets a person type any address into a claim can take over the account of that address.","evaluate":{"method":"scenario"},"ref":"FED-257","area":"03-identity","section":"Binding, provisioning and metadata","lifecycle":"active","boundary":"b-5","boundaryDetail":"`identity link`","traces":["g-255","g-46"],"milestone":4,"inSection":"sec-federation-252","realisation":"checked"},
    {"id":"fed-258","kind":"requirement","statement":"A principal created at a first federated sign-in SHALL receive only the default role that the realm names.","rationale":"Just-in-time creation does not grant the roles of an administrator.","evaluate":{"method":"scenario"},"ref":"FED-258","area":"03-identity","section":"Binding, provisioning and metadata","lifecycle":"active","boundary":"b-5","boundaryDetail":"`first federated sign-in`","traces":["g-7"],"milestone":4,"inSection":"sec-federation-252","realisation":"checked"},
    {"id":"fed-259","kind":"requirement","statement":"A provisioning token SHALL grant access to the provisioning endpoint of one realm and to no other endpoint.","rationale":"A token that provisions users can also read the realm's configuration if its scope is wider than provisioning.","evaluate":{"method":"scenario"},"ref":"FED-259","area":"03-identity","section":"Binding, provisioning and metadata","lifecycle":"active","boundary":"b-5","boundaryDetail":"`/scim/v2`","traces":["g-7"],"milestone":4,"inSection":"sec-federation-252","realisation":"checked"},
    {"id":"fed-260","kind":"requirement","statement":"A provisioning request SHALL change the roles of a principal only through the group mapping that the realm declares.","rationale":"A provisioning client cannot grant a role that no group of the realm maps to.","evaluate":{"method":"scenario"},"ref":"FED-260","area":"03-identity","section":"Binding, provisioning and metadata","lifecycle":"active","boundary":"b-5","boundaryDetail":"`/scim/v2/Groups`","traces":["g-7","g-263"],"milestone":4,"inSection":"sec-federation-252","realisation":"checked"},
    {"id":"fed-261","kind":"requirement","statement":"The metadata, the keys and the token endpoint of a provider SHALL be reached only at the address that the provider configuration names, and through the outbound gate.","rationale":"A tenant that names an address on the platform's own network as its provider's metadata address would make the platform fetch from that network.","evaluate":{"method":"scenario"},"ref":"FED-261","area":"03-identity","section":"Binding, provisioning and metadata","lifecycle":"active","boundary":"b-252","boundaryDetail":"`provider metadata`","traces":["g-257","k-252","d-702"],"milestone":4,"inSection":"sec-federation-252","realisation":"checked"},
    {"id":"tok-250","kind":"requirement","statement":"A resource SHALL refuse an access token whose audience names a client other than the one presenting it.","rationale":"A token issued to one client is worthless to another client that holds it.","evaluate":{"method":"scenario"},"ref":"TOK-250","area":"03-identity","section":"Audience, compromise and clients","lifecycle":"active","boundary":"b-6","boundaryDetail":"`access token`","traces":["g-10","g-20"],"milestone":4,"inSection":"sec-tokens-250","realisation":"checked"},
    {"id":"tok-251","kind":"requirement","statement":"A compromised signing key SHALL be retired at once, so that the tokens it signed are refused from the moment of retirement.","rationale":"Rotation is for routine change; a compromised key needs an immediate cut.","evaluate":{"method":"scenario"},"ref":"TOK-251","area":"03-identity","section":"Audience, compromise and clients","lifecycle":"active","boundary":"b-6","boundaryDetail":"`GET /keys`","traces":["g-261","g-10"],"milestone":4,"inSection":"sec-tokens-250","realisation":"checked"},
    {"id":"tok-252","kind":"requirement","statement":"A client secret of a service account SHALL be stored only as a hash and shown once, when it is created.","rationale":"A stolen database yields no client secret, and a secret that is shown again is one more place it can leak.","evaluate":{"method":"example"},"ref":"TOK-252","area":"03-identity","section":"Audience, compromise and clients","lifecycle":"active","boundary":"b-6","boundaryDetail":"`POST /token`","traces":["g-10","k-4"],"milestone":4,"inSection":"sec-tokens-250","realisation":"checked"},
    {"id":"tok-253","kind":"requirement","statement":"The token endpoint SHALL limit the credential requests of each client within the window that D-700 states.","rationale":"Client credentials are guessed at the token endpoint as much as at sign-in.","evaluate":{"method":"scenario"},"ref":"TOK-253","area":"03-identity","section":"Audience, compromise and clients","lifecycle":"active","boundary":"b-6","boundaryDetail":"`POST /token`","traces":["g-251","g-10","d-700"],"milestone":4,"inSection":"sec-tokens-250","realisation":"checked"},
    {"id":"ten-251","kind":"requirement","statement":"A job, a wake notice or a file address carries the tenant identifier of the tenant it acts for, and its receiver SHALL refuse one that names another tenant.","rationale":"A tenant identifier that is only implied is one that a shared component can mix up.","evaluate":{"method":"property"},"ref":"TEN-251","area":"02-tenancy","section":"Operator access and tenant identifiers","lifecycle":"active","boundary":"b-16","boundaryDetail":"`wake notice`","traces":["g-20","k-2"],"milestone":5,"inSection":"sec-tenancy-250","realisation":"checked"},
    {"id":"ten-252","kind":"requirement","statement":"A backup of one tenant SHALL be unreadable with the key of any other tenant.","rationale":"Backups follow the tenant, and so do their keys.","evaluate":{"method":"scenario"},"ref":"TEN-252","area":"02-tenancy","section":"Operator access and tenant identifiers","lifecycle":"active","boundary":"b-3","boundaryDetail":"`POST /tenants/{id}/restore`","traces":["g-1","g-40","g-266"],"milestone":2,"inSection":"sec-tenancy-250","realisation":"checked"},
    {"id":"ten-255","kind":"requirement","statement":"A runtime instance SHALL hold database credentials only for the tenant databases of the placements it serves, issued for a lifetime that ends when it stops serving them.","rationale":"A compromised instance reaches only the tenants it was serving, and only while it serves them.","evaluate":{"method":"scenario"},"ref":"TEN-255","area":"02-tenancy","section":"Credentials and reach","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["g-266","k-3"],"milestone":2,"inSection":"sec-tenancy-251","realisation":"checked"},
    {"id":"ten-256","kind":"requirement","statement":"Each database credential SHALL open one tenant database and no other database of its cluster.","rationale":"A credential that opens a cluster opens every tenant on it.","evaluate":{"method":"property"},"ref":"TEN-256","area":"02-tenancy","section":"Credentials and reach","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["g-266","k-3"],"milestone":2,"inSection":"sec-tenancy-251","realisation":"checked"},
    {"id":"ten-257","kind":"requirement","statement":"A platform component acting for a tenant SHALL act only on the tenant that the credential authorising the call names.","rationale":"The confused deputy is a component that holds more authority than the call it is making.","evaluate":{"method":"property"},"ref":"TEN-257","area":"02-tenancy","section":"Credentials and reach","lifecycle":"active","boundary":"b-6","boundaryDetail":"`component credential`","traces":["g-266","k-6"],"milestone":2,"inSection":"sec-tenancy-251","realisation":"checked"},
    {"id":"sec-250","kind":"requirement","statement":"When the key service does not answer, the platform SHALL refuse each request that needs a data key and answer requests that need none.","rationale":"A key outage slows secret reads and blocks the reads that need a key, and nothing else.","evaluate":{"method":"scenario"},"ref":"SEC-250","area":"08-platform","section":"Keys under stress","lifecycle":"active","boundary":"b-17","boundaryDetail":"`data key`","traces":["g-261","g-4"],"milestone":3,"inSection":"sec-platform-250","realisation":"checked"},
    {"id":"sec-251","kind":"requirement","statement":"A tenant data key SHALL be rotated while the tenant reads and writes its records.","rationale":"Rotation that needs a pause is rotation that is not done.","evaluate":{"method":"scenario"},"ref":"SEC-251","area":"08-platform","section":"Keys under stress","lifecycle":"active","boundary":"b-17","boundaryDetail":"`data key`","traces":["g-261","g-40"],"milestone":3,"inSection":"sec-platform-250","realisation":"checked"},
    {"id":"sec-252","kind":"requirement","statement":"A compromised tenant data key SHALL be replaced by a key that protects every record the old key protected.","rationale":"A replacement that leaves some records under the compromised key leaves them open.","evaluate":{"method":"scenario"},"ref":"SEC-252","area":"08-platform","section":"Keys under stress","lifecycle":"active","boundary":"b-17","boundaryDetail":"`destroy key`","traces":["g-261","g-40"],"milestone":3,"inSection":"sec-platform-250","realisation":"checked"},
    {"id":"sec-253","kind":"requirement","statement":"A request whose address carries a session secret, a token or a one-time code SHALL be refused.","rationale":"Addresses are written to logs, histories and referrers, so a secret in one is a secret in all of them.","evaluate":{"method":"example"},"ref":"SEC-253","area":"08-platform","section":"Secrets in addresses","lifecycle":"active","boundary":"b-4","boundaryDetail":"`request address`","traces":["k-250"],"milestone":3,"inSection":"sec-platform-251","realisation":"checked"},
    {"id":"cms-250","kind":"requirement","statement":"A link in tenant rich text SHALL carry only the web and mail schemes.","rationale":"A link with a script scheme runs script in the reader's page when it is followed.","evaluate":{"method":"example"},"ref":"CMS-250","area":"07-content","section":"Markup and expressions","lifecycle":"active","boundary":"b-9","boundaryDetail":"`strata_substrate::markdown::parse`","traces":["k-12"],"milestone":2,"inSection":"sec-content-250","realisation":"checked"},
    {"id":"cms-251","kind":"requirement","statement":"A tenant expression, constraint or workflow guard SHALL read only the fields of the record it is evaluated on and the values that the kernel passes to it.","rationale":"Tenant expressions are data reach: they read no other record and no platform state.","evaluate":{"method":"property"},"ref":"CMS-251","area":"07-content","section":"Markup and expressions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["g-20","g-31"],"milestone":2,"inSection":"sec-content-250","realisation":"checked"},
    {"id":"cms-252","kind":"requirement","statement":"A tenant expression SHALL be evaluated under a step budget, and an evaluation that exhausts the budget is refused.","rationale":"A loop written by a tenant is bounded by steps, so one expression cannot hold a worker.","evaluate":{"method":"scenario"},"ref":"CMS-252","area":"07-content","section":"Markup and expressions","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["g-4","g-31"],"milestone":2,"inSection":"sec-content-250","realisation":"checked"},
    {"id":"cms-253","kind":"requirement","statement":"Tenant template text SHALL be rendered only by the substrate expression interpreter, and no tenant text reaches the evaluator of the host language.","rationale":"Template text that reaches the host language's evaluator runs code from the tenant.","evaluate":{"method":"property"},"ref":"CMS-253","area":"07-content","section":"Markup and expressions","lifecycle":"active","boundary":"b-9","boundaryDetail":"`view`","traces":["k-251","g-31"],"milestone":2,"inSection":"sec-content-250","realisation":"checked"},
    {"id":"cms-254","kind":"requirement","statement":"A query over tenant records SHALL bind each value it receives as data, so that no value becomes part of the query text.","rationale":"A value that becomes query text changes what the query reads.","evaluate":{"method":"property"},"ref":"CMS-254","area":"07-content","section":"Queries and patterns","lifecycle":"active","boundary":"b-2","boundaryDetail":"`strata_storage_api::Store`","traces":["g-31","g-20"],"milestone":2,"inSection":"sec-content-251","realisation":"checked"},
    {"id":"cms-255","kind":"requirement","statement":"A query that would read more records than its plan allows SHALL be refused before it reads them.","rationale":"Expensive queries are refused by their plan before they cost the platform anything.","evaluate":{"method":"scenario"},"ref":"CMS-255","area":"07-content","section":"Queries and patterns","lifecycle":"active","boundary":"b-9","boundaryDetail":"`named query`","traces":["g-4"],"milestone":2,"inSection":"sec-content-251","realisation":"checked"},
    {"id":"cms-256","kind":"requirement","statement":"A pattern that a tenant supplies SHALL be evaluated by an engine whose running time grows linearly with the length of its input.","rationale":"A pattern with exponential backtracking holds a worker for as long as the pattern is written to.","evaluate":{"method":"property"},"ref":"CMS-256","area":"07-content","section":"Queries and patterns","lifecycle":"active","boundary":"b-9","boundaryDetail":"`named query`","traces":["g-4"],"milestone":2,"inSection":"sec-content-251","realisation":"checked"},
    {"id":"cms-257","kind":"requirement","statement":"A file name that a tenant supplies SHALL be stored as data and escaped wherever the platform shows it.","rationale":"A file name is tenant text, so it is treated like any other tenant text.","evaluate":{"method":"example"},"ref":"CMS-257","area":"07-content","section":"Uploads","lifecycle":"active","boundary":"b-14","boundaryDetail":"`file store`","traces":["g-260"],"milestone":11,"inSection":"sec-content-252","realisation":"checked"},
    {"id":"cms-258","kind":"requirement","statement":"A file of a markup or script capable media type SHALL be delivered only from the file domain of the platform, under a sandboxed policy.","rationale":"A script in an uploaded SVG or HTML file runs with the authority of the host that serves it.","evaluate":{"method":"scenario"},"ref":"CMS-258","area":"07-content","section":"Uploads","lifecycle":"active","boundary":"b-251","boundaryDetail":"`file-domain delivery`","traces":["g-260","d-251","k-251"],"milestone":11,"inSection":"sec-content-252","realisation":"checked"},
    {"id":"cms-259","kind":"requirement","statement":"A tenant host name SHALL serve no file that a tenant uploaded.","rationale":"A tenant host carries the tenant's cookies, so an upload served there is a stored attack on its readers.","evaluate":{"method":"property"},"ref":"CMS-259","area":"07-content","section":"Uploads","lifecycle":"active","boundary":"b-251","boundaryDetail":"`file-domain delivery`","traces":["g-260","d-251"],"milestone":11,"inSection":"sec-content-252","realisation":"checked"},
    {"id":"cms-260","kind":"requirement","statement":"An uploaded file SHALL be released for delivery only after the upload scanner records a clean result for it.","rationale":"A file is untrusted until a scan has looked at it.","evaluate":{"method":"scenario"},"ref":"CMS-260","area":"07-content","section":"Uploads","lifecycle":"active","boundary":"b-251","boundaryDetail":"`release`","traces":["g-260"],"milestone":11,"inSection":"sec-content-252","realisation":"checked"},
    {"id":"cms-261","kind":"requirement","statement":"An upload SHALL be accepted only for a media type that its content confirms, and not only for the type it declares.","rationale":"A file declared as an image and carrying markup is refused on what it is.","evaluate":{"method":"example"},"ref":"CMS-261","area":"07-content","section":"Uploads","lifecycle":"active","boundary":"b-251","boundaryDetail":"`upload intake`","traces":["g-260"],"milestone":11,"inSection":"sec-content-252","realisation":"checked"},
    {"id":"cms-262","kind":"requirement","statement":"A rendition SHALL be produced by a process that holds no connector secret and no network access.","rationale":"A process that parses hostile images holds nothing worth taking.","evaluate":{"method":"scenario"},"ref":"CMS-262","area":"07-content","section":"Uploads","lifecycle":"active","boundary":"b-7","boundaryDetail":"`rendition job`","traces":["g-260","g-40"],"milestone":11,"inSection":"sec-content-252","realisation":"checked"},
    {"id":"cms-263","kind":"requirement","statement":"An archive or an image whose decompressed size exceeds the limit of the tenant plan SHALL be refused before it is fully expanded.","rationale":"A decompression bomb is refused by its declared size before it fills the disk.","evaluate":{"method":"scenario"},"ref":"CMS-263","area":"07-content","section":"Uploads","lifecycle":"active","boundary":"b-251","boundaryDetail":"`upload intake`","traces":["g-260","g-4"],"milestone":11,"inSection":"sec-content-252","realisation":"checked"},
    {"id":"gwy-250","kind":"requirement","statement":"A page response SHALL allow script only from the scripts whose hash or nonce the response declares.","rationale":"Structured content is the first defence; this is the second, and it stops script that a template or a reflected value adds.","evaluate":{"method":"example"},"ref":"GWY-250","area":"01-core","section":"Pages and browser requests","lifecycle":"active","boundary":"b-13","boundaryDetail":"`Content-Security-Policy`","traces":["k-12","g-250"],"milestone":2,"inSection":"sec-runtime-250","realisation":"checked"},
    {"id":"gwy-251","kind":"requirement","statement":"A page response SHALL forbid framing by other origins through the frame-ancestors directive.","rationale":"A framed sign-in page lets another site click for the reader.","evaluate":{"method":"example"},"ref":"GWY-251","area":"01-core","section":"Pages and browser requests","lifecycle":"active","boundary":"b-13","boundaryDetail":"`frame-ancestors`","traces":["g-250"],"milestone":2,"inSection":"sec-runtime-250","realisation":"checked"},
    {"id":"gwy-252","kind":"requirement","statement":"A page response SHALL restrict the base-uri, object-src and form-action directives to the page's own origin or to none.","rationale":"A base element or a form target on another origin moves the page's relative addresses or its submissions.","evaluate":{"method":"example"},"ref":"GWY-252","area":"01-core","section":"Pages and browser requests","lifecycle":"active","boundary":"b-13","boundaryDetail":"`base-uri`","traces":["g-250","k-12"],"milestone":2,"inSection":"sec-runtime-250","realisation":"checked"},
    {"id":"gwy-253","kind":"requirement","statement":"A page response SHALL require Trusted Types for script sinks.","rationale":"A string that reaches a script sink without a typed wrapper is the DOM cross-site scripting path.","evaluate":{"method":"example"},"ref":"GWY-253","area":"01-core","section":"Pages and browser requests","lifecycle":"active","boundary":"b-13","boundaryDetail":"`Trusted Types`","traces":["g-250"],"milestone":2,"inSection":"sec-runtime-250","realisation":"checked"},
    {"id":"gwy-254","kind":"requirement","statement":"A response SHALL state its media type and carry the header that forbids content sniffing.","rationale":"A browser that guesses a type runs an upload as a page.","evaluate":{"method":"example"},"ref":"GWY-254","area":"01-core","section":"Pages and browser requests","lifecycle":"active","boundary":"b-9","boundaryDetail":"`response`","traces":["g-250","g-260"],"milestone":2,"inSection":"sec-runtime-250","realisation":"checked"},
    {"id":"gwy-255","kind":"requirement","statement":"Each value reflected into a response SHALL be escaped for the place in the response where it appears.","rationale":"Escaping for the wrong place, such as HTML text inside a script, is still cross-site scripting.","evaluate":{"method":"property"},"ref":"GWY-255","area":"01-core","section":"Pages and browser requests","lifecycle":"active","boundary":"b-9","boundaryDetail":"`reflected value`","traces":["g-250"],"milestone":2,"inSection":"sec-runtime-250","realisation":"checked"},
    {"id":"gwy-256","kind":"requirement","statement":"A WebSocket upgrade SHALL be refused unless it carries the request token of the session.","rationale":"A socket opened from another site carries the cookie, and only the token proves the request came from the page.","evaluate":{"method":"scenario"},"ref":"GWY-256","area":"01-core","section":"Pages and browser requests","lifecycle":"active","boundary":"b-9","boundaryDetail":"`Origin`","traces":["g-46","g-250"],"milestone":2,"inSection":"sec-runtime-250","realisation":"checked"},
    {"id":"gwy-257","kind":"requirement","statement":"A sign-in request and a sign-out request SHALL carry a request token that the gateway issued to the browser.","rationale":"Login CSRF plants an attacker's session in the victim's browser, and forced sign-out is a nuisance attack.","evaluate":{"method":"scenario"},"ref":"GWY-257","area":"01-core","section":"Pages and browser requests","lifecycle":"active","boundary":"b-4","boundaryDetail":"`POST /sign-out`","traces":["g-46","g-253"],"milestone":2,"inSection":"sec-runtime-250","realisation":"checked"},
    {"id":"gwy-258","kind":"requirement","statement":"A delivery response SHALL allow cross-origin reads only from the origins that the tenant lists.","rationale":"A tenant's content read from an origin the tenant did not list is a copy made outside its control.","evaluate":{"method":"scenario"},"ref":"GWY-258","area":"01-core","section":"Requests, exports and limits","lifecycle":"active","boundary":"b-9","boundaryDetail":"`Access-Control-Allow-Origin`","traces":["g-20"],"milestone":2,"inSection":"sec-runtime-251","realisation":"checked"},
    {"id":"gwy-259","kind":"requirement","statement":"A request whose body exceeds the limit of its route SHALL be refused before the body is processed.","rationale":"Limits are applied before work is done, not after the body is read.","evaluate":{"method":"scenario"},"ref":"GWY-259","area":"01-core","section":"Requests, exports and limits","lifecycle":"active","boundary":"b-9","boundaryDetail":"`request body`","traces":["g-4","g-262"],"milestone":2,"inSection":"sec-runtime-251","realisation":"checked"},
    {"id":"gwy-260","kind":"requirement","statement":"Each absolute address that the gateway emits SHALL be built from the configured host of the tenant alone.","rationale":"A host header that the gateway echoes into a link is a way to poison the links of the next reader.","evaluate":{"method":"property"},"ref":"GWY-260","area":"01-core","section":"Requests, exports and limits","lifecycle":"active","boundary":"b-9","boundaryDetail":"`Host`","traces":["g-20","g-267"],"milestone":2,"inSection":"sec-runtime-251","realisation":"checked"},
    {"id":"gwy-261","kind":"requirement","statement":"The gateway SHALL refuse a request whose message framing the edge and the gateway read differently.","rationale":"Request smuggling depends on two components disagreeing about where one request ends.","evaluate":{"method":"scenario"},"ref":"GWY-261","area":"01-core","section":"Requests, exports and limits","lifecycle":"active","boundary":"b-9","boundaryDetail":"`request framing`","traces":["g-250","g-267"],"milestone":2,"inSection":"sec-runtime-251","realisation":"checked"},
    {"id":"gwy-262","kind":"requirement","statement":"An export file SHALL prefix each cell that begins with a formula character, so that a spreadsheet reads the cell as text.","rationale":"A cell that begins with an equals sign is run by the spreadsheet of the person who opens the export.","evaluate":{"method":"example"},"ref":"GWY-262","area":"01-core","section":"Requests, exports and limits","lifecycle":"active","boundary":"b-9","boundaryDetail":"`export`","traces":["g-264"],"milestone":2,"inSection":"sec-runtime-251","realisation":"checked"},
    {"id":"gwy-263","kind":"requirement","statement":"A client SHALL be refused a new WebSocket connection when it already holds the connections that the gateway allows it.","rationale":"Connection limits keep one client from holding the gateway's sockets.","evaluate":{"method":"scenario"},"ref":"GWY-263","area":"01-core","section":"Requests, exports and limits","lifecycle":"active","boundary":"b-9","boundaryDetail":"`WebSocket`","traces":["g-262","g-4"],"milestone":2,"inSection":"sec-runtime-251","realisation":"checked"},
    {"id":"edg-250","kind":"requirement","statement":"The edge key of a response SHALL include every request header that changes the response and no other request header.","rationale":"A header that changes the response but is not in the key lets one reader's response serve another.","evaluate":{"method":"property"},"ref":"EDG-250","area":"05-delivery","section":"Keys and paths","lifecycle":"active","boundary":"b-10","boundaryDetail":"`Vary`","traces":["g-267","d-16"],"milestone":6,"inSection":"sec-edge-250","realisation":"checked"},
    {"id":"edg-251","kind":"requirement","statement":"The edge key of a response SHALL be formed from the normalised path of the request that produced it.","rationale":"Two spellings of one path that get two keys let a private page be cached under a public name.","evaluate":{"method":"property"},"ref":"EDG-251","area":"05-delivery","section":"Keys and paths","lifecycle":"active","boundary":"b-10","boundaryDetail":"`edge key`","traces":["g-267","g-20"],"milestone":6,"inSection":"sec-edge-250","realisation":"checked"},
    {"id":"edg-252","kind":"requirement","statement":"A tenant domain binding SHALL be removed when its name stops resolving to the platform.","rationale":"A binding left behind after its name moves elsewhere serves the next owner's traffic.","evaluate":{"method":"scenario"},"ref":"EDG-252","area":"05-delivery","section":"Domains and headers","lifecycle":"active","boundary":"b-3","boundaryDetail":"`domain binding`","traces":["g-21","g-262"],"milestone":6,"inSection":"sec-edge-251","realisation":"checked"},
    {"id":"edg-253","kind":"requirement","statement":"A name that a removed tenant held SHALL be bound to another tenant only after proof of control is given again.","rationale":"A name that a departed tenant left is a name a new tenant can take over.","evaluate":{"method":"scenario"},"ref":"EDG-253","area":"05-delivery","section":"Domains and headers","lifecycle":"active","boundary":"b-3","boundaryDetail":"`domain binding`","traces":["g-21"],"milestone":6,"inSection":"sec-edge-251","realisation":"checked"},
    {"id":"edg-254","kind":"requirement","statement":"The platform SHALL issue a certificate for a tenant domain only when the certificate authority record of that domain permits it.","rationale":"A certificate issued against a record that does not name the platform is one the platform would not have issued.","evaluate":{"method":"scenario"},"ref":"EDG-254","area":"05-delivery","section":"Domains and headers","lifecycle":"active","boundary":"b-10","boundaryDetail":"`certificate`","traces":["g-21"],"milestone":6,"inSection":"sec-edge-251","realisation":"checked"},
    {"id":"edg-255","kind":"requirement","statement":"A response header value that a tenant supplies SHALL be refused when it contains a line break.","rationale":"A line break in a header value starts a second header, or a second response.","evaluate":{"method":"example"},"ref":"EDG-255","area":"05-delivery","section":"Domains and headers","lifecycle":"active","boundary":"b-10","boundaryDetail":"`response header`","traces":["k-12","g-250"],"milestone":6,"inSection":"sec-edge-251","realisation":"checked"},
    {"id":"agt-250","kind":"requirement","statement":"The agent gateway SHALL accept cross-origin requests only from the origins that the operator lists.","rationale":"An agent interface readable from any site is one a visited page can drive with the operator's credentials.","evaluate":{"method":"scenario"},"ref":"AGT-250","area":"06-agents","section":"Interfaces and inputs","lifecycle":"active","boundary":"b-11","boundaryDetail":"`Access-Control-Allow-Origin`","traces":["g-28","g-23"],"milestone":7,"inSection":"sec-agents-250","realisation":"checked"},
    {"id":"agt-251","kind":"requirement","statement":"An operation SHALL accept only the input fields that its input schema declares.","rationale":"A field the schema does not declare, set through JSON coercion, is a way to set what the operation was not meant to set.","evaluate":{"method":"property"},"ref":"AGT-251","area":"06-agents","section":"Interfaces and inputs","lifecycle":"active","boundary":"b-11","boundaryDetail":"`operation input`","traces":["g-263","g-24"],"milestone":7,"inSection":"sec-agents-250","realisation":"checked"},
    {"id":"agt-253","kind":"requirement","statement":"A change to a role, a policy or a schema SHALL be authorised only for a principal whose policies permit administering that object.","rationale":"A principal that can change its own policy has no limit on its authority.","evaluate":{"method":"scenario"},"ref":"AGT-253","area":"06-agents","section":"Separation and reach","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::transition`","traces":["g-263","k-13"],"milestone":7,"inSection":"sec-agents-251","realisation":"checked"},
    {"id":"agt-254","kind":"requirement","statement":"An export, a search result and a subscription SHALL include only the records that the policies of the requester permit reading.","rationale":"The read decision guards queries; exports, searches and subscriptions are reads too.","evaluate":{"method":"property"},"ref":"AGT-254","area":"06-agents","section":"Separation and reach","lifecycle":"active","boundary":"b-11","boundaryDetail":"`export`","traces":["g-263","g-20"],"milestone":7,"inSection":"sec-agents-251","realisation":"checked"},
    {"id":"wfl-250","kind":"requirement","statement":"An outbound call SHALL connect only to the address that the outbound gate resolved and judged, so that a later resolution cannot change the target.","rationale":"A name that resolves to a private address on the second lookup defeats a check made on the first.","evaluate":{"method":"scenario"},"ref":"WFL-250","area":"04-automation","section":"Outbound calls","lifecycle":"active","boundary":"b-252","boundaryDetail":"`outbound gate`","traces":["g-257","k-252","d-254","d-702"],"milestone":4,"inSection":"sec-workflows-250","realisation":"checked"},
    {"id":"wfl-251","kind":"requirement","statement":"The outbound gate SHALL refuse a redirect whose address the outbound rule does not allow.","rationale":"A permitted address that redirects to a forbidden one is the redirect bypass.","evaluate":{"method":"scenario"},"ref":"WFL-251","area":"04-automation","section":"Outbound calls","lifecycle":"active","boundary":"b-252","boundaryDetail":"`redirect`","traces":["g-257"],"milestone":4,"inSection":"sec-workflows-250","realisation":"checked"},
    {"id":"wfl-252","kind":"requirement","statement":"The outbound gate SHALL judge an address in its canonical numeric form, including mapped, encoded and cloud metadata forms.","rationale":"Alternate spellings of a private or metadata address are the usual way past a text check.","evaluate":{"method":"example"},"ref":"WFL-252","area":"04-automation","section":"Outbound calls","lifecycle":"active","boundary":"b-252","boundaryDetail":"`outbound rule`","traces":["g-257"],"milestone":4,"inSection":"sec-workflows-250","realisation":"checked"},
    {"id":"wfl-253","kind":"requirement","statement":"A connector call SHALL end when its response exceeds the size that the connector policy names or when the time that the policy names has passed.","rationale":"An external server that answers slowly or without end holds a worker.","evaluate":{"method":"scenario"},"ref":"WFL-253","area":"04-automation","section":"Outbound calls","lifecycle":"active","boundary":"b-252","boundaryDetail":"`response`","traces":["g-257","g-14"],"milestone":5,"inSection":"sec-workflows-250","realisation":"checked"},
    {"id":"wfl-254","kind":"requirement","statement":"A connector log entry SHALL omit the query and the userinfo of the address called, and every connector secret.","rationale":"Addresses carry tokens in their queries and passwords in their userinfo.","evaluate":{"method":"property"},"ref":"WFL-254","area":"04-automation","section":"Outbound calls","lifecycle":"active","boundary":"b-12","boundaryDetail":"`log line`","traces":["g-40","k-4"],"milestone":5,"inSection":"sec-workflows-250","realisation":"checked"},
    {"id":"wfl-255","kind":"requirement","statement":"A webhook delivery SHALL carry a timestamp by which the receiver refuses a repeat of an old delivery.","rationale":"A captured signed delivery replayed later is accepted unless the receiver has a time to compare against.","evaluate":{"method":"example"},"ref":"WFL-255","area":"04-automation","section":"Outbound calls","lifecycle":"active","boundary":"b-8","boundaryDetail":"`webhook`","traces":["g-13"],"milestone":5,"inSection":"sec-workflows-250","realisation":"checked"},
    {"id":"wfl-256","kind":"requirement","statement":"The connector runner SHALL reach no platform component other than the outbound gate and the key service.","rationale":"A connector that reaches the platform's own components is a route from tenant automation into the platform.","evaluate":{"method":"scenario"},"ref":"WFL-256","area":"04-automation","section":"Reach","lifecycle":"active","boundary":"b-252","boundaryDetail":"`connector runner`","traces":["g-47","k-252"],"milestone":5,"inSection":"sec-workflows-251","realisation":"construction"},
    {"id":"thr-250","kind":"requirement","statement":"Every HTTP response of a platform component SHALL carry the security header set of its response class, including error and redirect responses.","rationale":"Headers left off error pages are headers an attacker can find.","evaluate":{"method":"property"},"ref":"THR-250","area":"09-threat","section":"Responses and transport","lifecycle":"active","boundary":"b-9","boundaryDetail":"`HTTP response`","traces":["g-250","g-256"],"milestone":2,"inSection":"sec-threat-251","realisation":"checked"},
    {"id":"thr-251","kind":"requirement","statement":"A connection to a platform endpoint SHALL negotiate only the protocol versions of TLS that the platform policy lists.","rationale":"An older protocol version is a downgrade that the endpoint refuses.","evaluate":{"method":"example"},"ref":"THR-251","area":"09-threat","section":"Responses and transport","lifecycle":"active","boundary":"b-10","boundaryDetail":"`TLS`","traces":["g-21","g-256"],"milestone":6,"inSection":"sec-threat-251","realisation":"checked"},
    {"id":"thr-252","kind":"requirement","statement":"The strict transport security header of a custom domain SHALL omit the preload and subdomain directives unless the tenant owner requests them in writing.","rationale":"A preloaded directive applies to every name under the domain, including the ones the tenant does not run.","evaluate":{"method":"example"},"ref":"THR-252","area":"09-threat","section":"Responses and transport","lifecycle":"active","boundary":"b-10","boundaryDetail":"`Strict-Transport-Security`","traces":["g-21"],"milestone":6,"inSection":"sec-threat-251","realisation":"checked"},
    {"id":"thr-253","kind":"requirement","statement":"The operator console SHALL accept connections only from the operations network.","rationale":"An administration interface on the public network is found by scanning.","evaluate":{"method":"scenario"},"ref":"THR-253","area":"09-threat","section":"Reachability","lifecycle":"active","boundary":"b-250","boundaryDetail":"`operator console`","traces":["g-256"],"milestone":10,"inSection":"sec-threat-252","realisation":"operational"},
    {"id":"thr-254","kind":"requirement","statement":"A deployment SHALL refuse a network connection from a component that the architecture does not name as a caller of the receiving component.","rationale":"Network policy is the architecture enforced, so an unnamed caller is refused at the network.","evaluate":{"method":"scenario"},"ref":"THR-254","area":"09-threat","section":"Reachability","lifecycle":"active","boundary":"b-19","boundaryDetail":"`network policy`","traces":["g-256"],"milestone":2,"inSection":"sec-threat-252","realisation":"checked"},
    {"id":"thr-255","kind":"requirement","statement":"A component image SHALL run only when its signature and its build provenance verify against the release key.","rationale":"An image that cannot be traced to its build is one that nobody can vouch for.","evaluate":{"method":"scenario"},"ref":"THR-255","area":"09-threat","section":"Supply chain","lifecycle":"active","boundary":"b-19","boundaryDetail":"`image`","traces":["g-259"],"milestone":2,"inSection":"sec-threat-253","realisation":"operational"},
    {"id":"thr-256","kind":"requirement","statement":"Each component image SHALL carry a software bill of materials that lists every package the image contains.","rationale":"A vulnerability in a package is found in the images that contain it only if the images say what they contain.","evaluate":{"method":"example"},"ref":"THR-256","area":"09-threat","section":"Supply chain","lifecycle":"active","boundary":"b-19","boundaryDetail":"`image`","traces":["g-259"],"milestone":2,"inSection":"sec-threat-253","realisation":"checked"},
    {"id":"thr-257","kind":"requirement","statement":"A release build SHALL fail when a dependency of the build carries a published vulnerability of a severity that the release policy blocks.","rationale":"The gate is in the build, so a known vulnerability cannot ship by default.","evaluate":{"method":"scenario"},"ref":"THR-257","area":"09-threat","section":"Supply chain","lifecycle":"active","boundary":"b-19","boundaryDetail":"`release build`","traces":["g-259"],"milestone":2,"inSection":"sec-threat-253","realisation":"operational"},
    {"id":"thr-258","kind":"requirement","statement":"A component SHALL run under a cloud identity that grants only the actions its deployment descriptor lists.","rationale":"A component that holds the whole account's rights is the reach of its worst bug.","evaluate":{"method":"scenario"},"ref":"THR-258","area":"09-threat","section":"Supply chain","lifecycle":"active","boundary":"b-19","boundaryDetail":"`infrastructure modules`","traces":["g-256","d-23"],"milestone":12,"inSection":"sec-threat-253","realisation":"operational"},
    {"id":"thr-259","kind":"requirement","statement":"An attempt to cross a tenant boundary SHALL raise an alert to the platform operators and be recorded as an audit entry.","rationale":"A boundary attempt is the earliest sign of a breach and needs a person watching for it.","evaluate":{"method":"scenario"},"ref":"THR-259","area":"09-threat","section":"Incidents and disclosure","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit entry`","traces":["g-30","g-266"],"milestone":10,"inSection":"sec-threat-254","realisation":"checked"},
    {"id":"thr-260","kind":"requirement","statement":"A security incident SHALL open an audit record that names the affected tenants and that the owner of each affected tenant is shown.","rationale":"A tenant hears of an incident from the record of it, not from a rumour.","evaluate":{"method":"scenario"},"ref":"THR-260","area":"09-threat","section":"Incidents and disclosure","lifecycle":"active","boundary":"b-12","boundaryDetail":"`GET /audit`","traces":["g-30","g-265"],"milestone":10,"inSection":"sec-threat-254","realisation":"checked"},
    {"id":"thr-261","kind":"requirement","statement":"The platform SHALL publish a disclosure policy that names a reporting address and the steps taken for affected tenants.","rationale":"A reporter who finds no address reports to a public forum instead.","evaluate":{"method":"example"},"ref":"THR-261","area":"09-threat","section":"Incidents and disclosure","lifecycle":"active","boundary":"b-13","boundaryDetail":"`disclosure policy`","traces":["g-265"],"milestone":2,"inSection":"sec-threat-254","realisation":"checked"},
    {"id":"thr-262","kind":"requirement","statement":"A tenant domain named in a takedown SHALL stop serving content and have its edge copies purged, within the bound of ARC-1228, through the operator contract take-down-host (THR-1227).","rationale":"A takedown that leaves the edge serving the content is not a takedown.","evaluate":{"method":"scenario"},"ref":"THR-262","area":"09-threat","section":"Abuse and takedown","lifecycle":"active","boundary":"b-10","boundaryDetail":"`purge`","traces":["g-262"],"milestone":6,"inSection":"sec-threat-255","realisation":"checked"},
    {"id":"thr-263","kind":"requirement","statement":"The published content of a tenant SHALL occupy none of the paths that the platform reserves for sign-in and federation.","rationale":"A tenant page at the sign-in path is a phishing page on the platform's own domain.","evaluate":{"method":"property"},"ref":"THR-263","area":"09-threat","section":"Abuse and takedown","lifecycle":"active","boundary":"b-9","boundaryDetail":"`reserved paths`","traces":["g-6","g-262"],"milestone":6,"inSection":"sec-threat-255","realisation":"checked"},
    {"id":"m-saml-assertion-single-use","kind":"invariant","models":"fed-006","statement":"A SAML assertion yields at most one session.","evaluate":{"method":"state-invariant","scenarios":["saml-replayed","saml-response-redelivered"],"expr":"saml-assertion-flow.sessions <= 1","negatives":[{"scenario":"saml-replayed","faults":["defect-saml-replay-accepted"]},{"scenario":"saml-response-redelivered","faults":["defect-saml-replay-accepted"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-provider-signatures"],"faultBasis":"fault"},
    {"id":"m-saml-assertion-flow-refined","kind":"temporal","models":"fed-006","statement":"The implementation of the SAML assertion handling refines the assertion model.","evaluate":{"method":"refines","behavior":"saml-assertion-flow-impl","scenarios":["saml-replayed-impl","saml-response-redelivered-impl"]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-guessing-throttled","kind":"invariant","models":"idn-008","statement":"A guess that arrives after ten failed guesses is refused, because the model counts the failures against one account (D-700).","evaluate":{"method":"state-invariant","scenarios":["guesses-from-one-source","guesses-on-parallel-connections"],"expr":"guess-throttle-flow.throttled == 0","negatives":[{"scenario":"guesses-from-one-source","faults":["defect-throttle-ignored"]},{"scenario":"guesses-on-parallel-connections","faults":["defect-throttle-ignored"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-guess-throttle-flow-refined","kind":"temporal","models":"idn-008","statement":"The implementation machine of Password guessing throttle refines its model: every step it takes is a step the model takes from the mapped state, or a step the model does not see.","evaluate":{"method":"refines","behavior":"guess-throttle-flow-impl"},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"restatement"},
    {"id":"m-operator-console-private","kind":"structural","models":"thr-253","statement":"No public component and no gateway has a path to the operator console.","evaluate":{"method":"no-relationship","from":["gateway","delivery-network","delivery-network-control","agent-gateway","external-identity-provider","web-application","agent","external-endpoint","traffic-switch","agent-traffic-switch"],"to":"operator-console","transitive":true},"assumptions":["a-model-abstraction"]},
    {"id":"m-connector-runner-isolated","kind":"structural","models":"wfl-256","statement":"The connector runner has no path to a platform component other than the outbound gate and the key service; components outside the platform (category external) are reached only through the outbound gate.","evaluate":{"method":"no-relationship","from":"connector-runner","to":["kernel","substrate","store-contract","sqlite-adapter","postgres-adapter","tenant-database","control-plane","control-database","identity-service","runtime","gateway","automation-worker","copy-store","file-store","agent-gateway","telemetry-pipeline","audit-log","web-application","simulator","verification","agent","limit-store","backup-archive","fleet-reporting","product-module","notice-queue","search-index","notification-service","conversation-service","local-model-adapter","operator-console","upload-scanner","mail-dispatcher","release-controller","release-pipeline","image-registry","traffic-switch","subject-rights-service","agent-traffic-switch","migration-job","platform-audit-store"],"transitive":true},"assumptions":["a-model-abstraction"]},
    {"id":"m-trigger-chain-bounded","kind":"invariant","models":"sch-300","statement":"A chain of triggers creates no more jobs than the hop limit of eight (D-700) allows.","evaluate":{"method":"state-invariant","scenarios":["trigger-chain-runaway","trigger-chain-reentered"],"expr":"trigger-chain-flow.accepted <= 8","negatives":[{"scenario":"trigger-chain-runaway","faults":["defect-trigger-loop-unbounded"]},{"scenario":"trigger-chain-reentered","faults":["defect-trigger-loop-unbounded"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-trigger-chain-flow-refined","kind":"temporal","models":"sch-300","statement":"The implementation machine of Trigger chain refines its model: every step it takes is a step the model takes from the mapped state, or a step the model does not see.","evaluate":{"method":"refines","behavior":"trigger-chain-flow-impl"},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"restatement"},
    {"id":"m-outage-no-acceptance","kind":"temporal","models":"idn-300","statement":"While a session lookup is unanswered, the gateway accepts no request that needs a session.","evaluate":{"method":"never","scenarios":["identity-unreachable"],"occurs":{"event":"sr-accepted"},"negatives":[{"scenario":"identity-unreachable","faults":["defect-gateway-accepts-unanswered"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction","a-tick"],"faultBasis":"fault"},
    {"id":"m-outage-refusal-given","kind":"temporal","models":"idn-300","statement":"A request that needs a session and meets an unanswered lookup is refused with the outage named.","evaluate":{"method":"eventually","scenarios":["identity-unreachable"],"occurs":{"event":"sr-unavailable"},"negatives":[{"scenario":"identity-unreachable","faults":["outage-refusal-disabled"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction","a-tick"],"faultBasis":"fault"},
    {"id":"m-gateway-outage-flow-refined","kind":"temporal","models":"idn-300","statement":"The implementation machine of Gateway during identity outage refines its model: every step it takes is a step the model takes from the mapped state, or a step the model does not see.","evaluate":{"method":"refines","behavior":"gateway-outage-flow-impl"},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"restatement"},
    {"id":"m-session-authority-flow-refined","kind":"temporal","models":"idn-013","statement":"The implementation of the identity service record of a session refines the session authority model.","evaluate":{
        "method": "refines",
        "behavior": "session-authority-flow-impl",
        "scenarios": [
          "revocation-heard-impl",
          "revocation-notice-lost-impl",
          "identity-unreachable-authority-impl",
          "session-superseded-impl",
          "session-of-other-browser-impl",
          "password-changed-from-another-session-impl",
          "password-changed-from-this-session-impl",
          "session-after-recovery-impl",
          "session-after-sign-out-impl",
          "session-after-deactivation-impl",
          "owner-revokes-this-session-impl",
          "owner-revokes-another-session-impl",
          "owner-lists-sessions-impl"
        ]
      },"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"prv-350","kind":"requirement","statement":"The tenant SHALL obtain, for one principal, every field of every record and copy of the tenant that names that principal, as one machine-readable export.","rationale":"The access right and the portability right for one person, across the tenant.","evaluate":{"method":"scenario"},"ref":"PRV-350","area":"09-privacy","section":"Data subject rights","lifecycle":"active","boundary":"b-350","boundaryDetail":"`GET /tenants/{id}/subjects/{principal-id}/export`","traces":["g-350","k-2"],"milestone":6,"inSection":"sec-privacy-2","realisation":"checked"},
    {"id":"prv-351","kind":"requirement","statement":"A rectification of one personal field SHALL replace that field in its record and in every copy that holds it.","rationale":"A corrected value must not survive in a copy that was made before the correction.","evaluate":{"method":"scenario"},"ref":"PRV-351","area":"09-privacy","section":"Data subject rights","lifecycle":"active","boundary":"b-350","boundaryDetail":"`PATCH /tenants/{id}/subjects/{principal-id}/fields`","traces":["g-350","k-8"],"milestone":6,"inSection":"sec-privacy-2","realisation":"checked"},
    {"id":"prv-352","kind":"requirement","statement":"A restriction placed on one principal SHALL refuse every read that names the personal fields of that principal until the restriction is lifted.","rationale":"Restriction stops the use of data without deleting it.","evaluate":{"method":"scenario"},"ref":"PRV-352","area":"09-privacy","section":"Data subject rights","lifecycle":"active","boundary":"b-350","boundaryDetail":"`POST /tenants/{id}/subjects/{principal-id}/restriction`","traces":["g-350"],"milestone":2,"inSection":"sec-privacy-2","realisation":"checked"},
    {"id":"prv-353","kind":"requirement","statement":"An erasure request for one principal SHALL end in a receipt that names each record and copy reached and the erasure point each one reached.","rationale":"The person and the controller can see what was erased and when it stopped being held.","evaluate":{"method":"scenario"},"ref":"PRV-353","area":"09-privacy","section":"Data subject rights","lifecycle":"active","boundary":"b-350","boundaryDetail":"`DELETE /tenants/{id}/subjects/{principal-id}`","traces":["g-350","k-352"],"milestone":6,"inSection":"sec-privacy-2","realisation":"checked"},
    {"id":"prv-354","kind":"requirement","statement":"The deletion of a tenant SHALL produce a certificate that states when the tenant key was destroyed and when each backup image and export of the tenant expires.","rationale":"Deleting a tenant is only shown to be complete when the copies that outlive the database are named.","evaluate":{"method":"scenario"},"ref":"PRV-354","area":"09-privacy","section":"Data subject rights","lifecycle":"active","boundary":"b-3","boundaryDetail":"`DELETE /tenants/{id}`","traces":["g-22","g-350","d-706"],"milestone":6,"inSection":"sec-privacy-2","realisation":"checked"},
    {"id":"prv-355","kind":"requirement","statement":"A legal hold SHALL suspend the erasure and the expiry of each record that it names until the hold is released.","rationale":"A hold is the tenant's instruction to keep data, and it overrides the schedule.","evaluate":{"method":"scenario"},"ref":"PRV-355","area":"09-privacy","section":"Retention and legal hold","lifecycle":"active","boundary":"b-350","boundaryDetail":"`legal hold`","traces":["g-355","d-521"],"milestone":5,"inSection":"sec-privacy-3","realisation":"checked"},
    {"id":"prv-356","kind":"requirement","statement":"Each record type SHALL carry a retention rule whose period the tenant policy sets within the bounds that the platform defines, from thirty days to ten years, except the audit entries, whose floor is one year (OBS-1215).","rationale":"Retention is the tenant's choice, and the platform sets the limits a choice may reach: from thirty days to ten years (D-708).","evaluate":{"method":"scenario"},"ref":"PRV-356","area":"09-privacy","section":"Retention and legal hold","lifecycle":"active","boundary":"b-3","boundaryDetail":"`retention rule`","traces":["g-355","d-708"],"milestone":5,"inSection":"sec-privacy-3","realisation":"checked"},
    {"id":"prv-357","kind":"requirement","statement":"A record whose retention rule has ended SHALL be removed by a scheduled job.","rationale":"Removal is scheduled work, so it survives failure and leaves a recorded outcome.","evaluate":{"method":"scenario"},"ref":"PRV-357","area":"09-privacy","section":"Retention and legal hold","lifecycle":"active","boundary":"b-7","boundaryDetail":"`retention sweep`","traces":["g-355","g-14"],"milestone":5,"inSection":"sec-privacy-3","realisation":"checked"},
    {"id":"prv-358","kind":"requirement","statement":"A personal field SHALL be stored sealed under the key of the principal it concerns, so that destroying that key makes the field unreadable in every copy and backup.","rationale":"Erasure that reaches backups without editing them, because the key is the only way in.","evaluate":{"method":"property"},"ref":"PRV-358","area":"09-privacy","section":"Sealing and audit","lifecycle":"active","boundary":"b-17","boundaryDetail":"`subject key`","traces":["g-350","k-352","d-350"],"milestone":3,"inSection":"sec-privacy-4","realisation":"checked"},
    {"id":"prv-359","kind":"requirement","statement":"An erasure of one principal SHALL leave the audit chain of its tenant verifiable with no break.","rationale":"The audit log is immutable, and erasure must not break it.","evaluate":{"method":"scenario"},"ref":"PRV-359","area":"09-privacy","section":"Sealing and audit","lifecycle":"active","boundary":"b-12","boundaryDetail":"`GET /audit`","traces":["g-352","d-20"],"milestone":10,"inSection":"sec-privacy-4","realisation":"checked"},
    {"id":"prv-360","kind":"requirement","statement":"The hash that links each audit entry SHALL be computed over the sealed form of that entry.","rationale":"A hash over plain values would break on erasure. A hash over sealed values does not.","evaluate":{"method":"property"},"ref":"PRV-360","area":"09-privacy","section":"Sealing and audit","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit entry`","traces":["g-352","k-352","d-350"],"milestone":10,"inSection":"sec-privacy-4","realisation":"checked"},
    {"id":"prv-361","kind":"requirement","statement":"Replay of the event journal of a tenant after an erasure SHALL report each erased personal field in sealed form.","rationale":"Replay still reproduces the history, and the erased values appear only as sealed.","evaluate":{"method":"scenario"},"ref":"PRV-361","area":"09-privacy","section":"Sealing and audit","lifecycle":"active","boundary":"b-2","boundaryDetail":"`journal`","traces":["g-352","k-352"],"milestone":3,"inSection":"sec-privacy-4","realisation":"checked"},
    {"id":"prv-362","kind":"requirement","statement":"The destruction of a subject key SHALL be recorded in the audit log with the principal or tenant it concerned and no key material.","rationale":"Destruction is the erasure, so it must be evidenced without keeping what it destroyed.","evaluate":{"method":"scenario"},"ref":"PRV-362","area":"09-privacy","section":"Sealing and audit","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit entry`","traces":["g-352","k-352"],"milestone":10,"inSection":"sec-privacy-4","realisation":"checked"},
    {"id":"prv-363","kind":"requirement","statement":"A log line, span or metric SHALL carry no personal field other than the tenant identifier, the correlation identifier and a client network address with its host part removed.","rationale":"Operational data is shared more widely than tenant data, so it carries as little personal data as diagnosis allows.","evaluate":{"method":"property"},"ref":"PRV-363","area":"09-privacy","section":"Logs and minimisation","lifecycle":"active","boundary":"b-12","boundaryDetail":"`log line`","traces":["g-350","k-351"],"milestone":6,"inSection":"sec-privacy-5","realisation":"checked"},
    {"id":"prv-364","kind":"requirement","statement":"A session record SHALL hold no user agent string, and no network address except as a keyed hash that a realm rule compares.","rationale":"Session records last a day. A user agent adds personal data that sign-in does not need, and a network context is kept only as the keyed hash that the rule of IDN-260 compares (D-704).","evaluate":{"method":"example"},"ref":"PRV-364","area":"09-privacy","section":"Logs and minimisation","lifecycle":"active","boundary":"b-4","boundaryDetail":"`sign-in session`","traces":["g-350","k-16","d-704"],"milestone":3,"inSection":"sec-privacy-5","realisation":"checked"},
    {"id":"prv-365","kind":"requirement","statement":"A sign-in link challenge SHALL hold the identifier of its principal and no email address.","rationale":"The address is needed to send the link, and the link is then bound to the browser. Keeping it adds nothing.","evaluate":{"method":"property"},"ref":"PRV-365","area":"09-privacy","section":"Logs and minimisation","lifecycle":"active","boundary":"b-4","boundaryDetail":"`sign-in challenge`","traces":["g-350","d-9"],"milestone":3,"inSection":"sec-privacy-5","realisation":"checked"},
    {"id":"prv-366","kind":"requirement","statement":"The connector runner SHALL record each external call with its target address, its outcome and its idempotency key, and no body of the request or of the response.","rationale":"A record of the call supports retries and disputes. A copy of the payload would be a second store of personal data.","evaluate":{"method":"property"},"ref":"PRV-366","area":"09-privacy","section":"Logs and minimisation","lifecycle":"active","boundary":"b-7","boundaryDetail":"`call step`","traces":["k-351","g-15"],"milestone":5,"inSection":"sec-privacy-5","realisation":"checked"},
    {"id":"prv-367","kind":"requirement","statement":"Platform staff SHALL reach tenant personal data only through an access grant that names the operator, the tenant, the purpose and an expiry.","rationale":"Access is a grant with a purpose and an end, and no other route exists.","evaluate":{"method":"scenario"},"ref":"PRV-367","area":"09-privacy","section":"Access by platform staff","lifecycle":"active","boundary":"b-350","boundaryDetail":"`POST /tenants/{id}/access-grants`","traces":["g-354","g-258","d-352","d-253"],"milestone":4,"inSection":"sec-privacy-6","realisation":"checked"},
    {"id":"prv-368","kind":"requirement","statement":"An access grant SHALL appear in the audit log of its tenant before the first read made under it.","rationale":"The tenant can see the access before the data is read, not only afterwards.","evaluate":{"method":"scenario"},"ref":"PRV-368","area":"09-privacy","section":"Access by platform staff","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit entry`","traces":["g-354","g-356"],"milestone":10,"inSection":"sec-privacy-6","realisation":"checked"},
    {"id":"prv-369","kind":"requirement","statement":"A grant of platform access to a tenant that forbids platform access SHALL be refused, and the refusal appears in the audit log of that tenant.","rationale":"A tenant's refusal is a setting the platform honours, and the refusal is itself evidence.","evaluate":{"method":"scenario"},"ref":"PRV-369","area":"09-privacy","section":"Access by platform staff","lifecycle":"active","boundary":"b-350","boundaryDetail":"`POST /tenants/{id}/access-grants`","traces":["g-354"],"milestone":10,"inSection":"sec-privacy-6","realisation":"checked"},
    {"id":"prv-370","kind":"requirement","statement":"The owner of a tenant SHALL receive an access report that lists each grant made to the data of the tenant over a period the owner chooses.","rationale":"The report is how an owner checks who looked at its data.","evaluate":{"method":"scenario"},"ref":"PRV-370","area":"09-privacy","section":"Access by platform staff","lifecycle":"active","boundary":"b-12","boundaryDetail":"`GET /tenants/{id}/access-report`","traces":["g-354","g-356"],"milestone":10,"inSection":"sec-privacy-6","realisation":"checked"},
    {"id":"prv-371","kind":"requirement","statement":"The backups, exports, copies, logs and mail of a tenant SHALL be stored in the region of its primary placement.","rationale":"Residency that covers only the database is not residency, because the other copies hold the same personal data.","evaluate":{"method":"scenario"},"ref":"PRV-371","area":"09-privacy","section":"Residency and subprocessors","lifecycle":"active","boundary":"b-3","boundaryDetail":"`placement`","traces":["g-353","d-23"],"milestone":12,"inSection":"sec-privacy-7","realisation":"operational"},
    {"id":"prv-372","kind":"requirement","statement":"A call that sends tenant personal data to a subprocessor outside the region of the tenant SHALL be refused unless the tenant policy lists that subprocessor.","rationale":"A transfer is named and refused by default, not discovered afterwards.","evaluate":{"method":"scenario"},"ref":"PRV-372","area":"09-privacy","section":"Residency and subprocessors","lifecycle":"active","boundary":"b-3","boundaryDetail":"`subprocessor transfer`","traces":["g-353"],"milestone":12,"inSection":"sec-privacy-7","realisation":"checked"},
    {"id":"prv-373","kind":"requirement","statement":"The subprocessor register SHALL list each component that holds tenant personal data, with its region, its role and the transfer basis that applies to it.","rationale":"The register is data, so a tenant can read it and an agent can check it.","evaluate":{"method":"example"},"ref":"PRV-373","area":"09-privacy","section":"Residency and subprocessors","lifecycle":"active","boundary":"b-350","boundaryDetail":"`subprocessor register`","traces":["g-351","g-356","d-520"],"milestone":2,"inSection":"sec-privacy-7","realisation":"checked"},
    {"id":"prv-374","kind":"requirement","statement":"The platform SHALL set on a tenant site no cookie other than the session cookie and the request token, both needed for sign-in and for the protection of forms.","rationale":"Strictly necessary cookies need no consent. Any other cookie the platform set would need a basis the specification does not give.","evaluate":{"method":"example"},"ref":"PRV-374","area":"09-privacy","section":"Consent and cookies","lifecycle":"active","boundary":"b-9","boundaryDetail":"`Set-Cookie`","traces":["g-46","k-16"],"milestone":3,"inSection":"sec-privacy-8","realisation":"checked"},
    {"id":"prv-375","kind":"requirement","statement":"A consent decision of a site visitor SHALL be recorded with its purpose, its time and the text the visitor was shown.","rationale":"A consent is evidence only with the wording the visitor saw.","evaluate":{"method":"scenario"},"ref":"PRV-375","area":"09-privacy","section":"Consent and cookies","lifecycle":"active","boundary":"b-9","boundaryDetail":"`consent record`","traces":["g-350"],"milestone":6,"inSection":"sec-privacy-8","realisation":"checked"},
    {"id":"prv-376","kind":"requirement","statement":"A tenant feature that sets a cookie for a purpose SHALL be refused while no consent record of the visitor covers that purpose.","rationale":"The platform enforces the consent the tenant recorded, rather than trusting the tenant's script.","evaluate":{"method":"scenario"},"ref":"PRV-376","area":"09-privacy","section":"Consent and cookies","lifecycle":"active","boundary":"b-9","boundaryDetail":"`cookie`","traces":["g-350","g-355"],"milestone":6,"inSection":"sec-privacy-8","realisation":"checked"},
    {"id":"prv-378","kind":"requirement","statement":"The platform SHALL export, for one tenant, a processing record that lists each record type with its owner, retention, personal fields and encryption, and each copy that holds those fields.","rationale":"The processing record is the document a controller asks a processor for.","evaluate":{"method":"scenario"},"ref":"PRV-378","area":"09-privacy","section":"Compliance evidence","lifecycle":"active","boundary":"b-350","boundaryDetail":"`GET /tenants/{id}/processing-record`","traces":["g-356","g-351"],"milestone":10,"inSection":"sec-privacy-9","realisation":"checked"},
    {"id":"prv-379","kind":"requirement","statement":"A field that holds personal data SHALL name the kind of personal data it holds.","rationale":"The processing record and the erasure rules can only list the personal fields that are named.","evaluate":{"method":"example"},"ref":"PRV-379","area":"09-privacy","section":"Compliance evidence","lifecycle":"active","boundary":"b-2","boundaryDetail":"`record declaration`","traces":["g-351","k-350"],"milestone":2,"inSection":"sec-privacy-9","realisation":"checked"},
    {"id":"prv-380","kind":"requirement","statement":"A breach of personal data held for a tenant SHALL be reported to the tenant owner, with the records and copies it reached, within the notice period that the tenant policy sets.","rationale":"The tenant has a duty to notify, and the platform must give it the facts in time to do so: within twenty-four hours of confirming the breach, shortened or extended up to forty-eight hours by the tenant policy (D-708).","evaluate":{"method":"scenario"},"ref":"PRV-380","area":"09-privacy","section":"Compliance evidence","lifecycle":"active","boundary":"b-12","boundaryDetail":"`breach notice`","traces":["g-356","d-708"],"milestone":10,"inSection":"sec-privacy-9","realisation":"checked"},
    {"id":"m-erasure-reaches-copy","kind":"invariant","models":"cpy-013","statement":"A copy of an erased principal's personal data serves no reader after its erasure bound has passed, whether or not the purge arrives.","evaluate":{"method":"state-invariant","scenarios":["erasure-purged","erasure-purge-lost"],"expr":"!erasure-copy-flow.leak","negatives":[{"scenario":"erasure-purge-lost","faults":["defect-erasure-ignores-lifetime"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-tick"],"faultBasis":"fault"},
    {"id":"m-erasure-copy-flow-refined","kind":"temporal","models":"cpy-013","statement":"The implementation machine of Erased copy refines its model: every step it takes is a step the model takes from the mapped state, or a step the model does not see.","evaluate":{"method":"refines","behavior":"erasure-copy-flow-impl"},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-tick"],"faultBasis":"restatement"},
    {"id":"m-shred-leaves-no-plain-value","kind":"invariant","models":"sec-002","statement":"In the model, once the key of a subject is destroyed, no read returns a plain value of that subject's sealed field.","evaluate":{"method":"state-invariant","scenarios":["subject-shredded","read-in-transit-past-shred"],"expr":"!subject-key-flow.plainAfterShred","negatives":[{"scenario":"subject-shredded","faults":["defect-shred-ignored"]},{"scenario":"read-in-transit-past-shred","faults":["defect-shred-ignored"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction","a-database-commit"],"faultBasis":"fault"},
    {"id":"m-subject-key-flow-refined","kind":"temporal","models":"sec-002","statement":"The implementation machine of Subject key refines its model: every step it takes is a step the model takes from the mapped state, or a step the model does not see.","evaluate":{"method":"refines","behavior":"subject-key-flow-impl"},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"restatement"},
    {"id":"m-audit-chain-survives-erasure","kind":"invariant","models":"prv-359","statement":"In the model, sealing the entries of an erased principal does not clear the audit chain's validity flag.","evaluate":{"method":"state-invariant","scenarios":["audit-erasure","audit-erasure-redelivered"],"expr":"audit-chain-flow.chainOk","negatives":[{"scenario":"audit-erasure","faults":["defect-audit-rewrites-entry"]},{"scenario":"audit-erasure-redelivered","faults":["defect-audit-rewrites-entry"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-audit-chain-flow-refined","kind":"temporal","models":"prv-359","statement":"The implementation machine of Audit chain under erasure refines its model: every step it takes is a step the model takes from the mapped state, or a step the model does not see.","evaluate":{"method":"refines","behavior":"audit-chain-flow-impl"},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"restatement"},
    {"id":"m-support-only-via-store","kind":"structural","models":"prv-367","statement":"Every path from the operator console to a tenant database passes through the store contract.","evaluate":{"method":"only-via","from":"operator-console","to":"tenant-database","via":"store-contract"},"assumptions":["a-model-abstraction"]},
    {"id":"agt-400","kind":"requirement","statement":"Every operation in the operation catalogue SHALL carry a stable name, a version and a deprecation state.","rationale":"Agents write against names and versions, so a silent change breaks them.","evaluate":{"method":"property"},"ref":"AGT-400","area":"06-agents","section":"Catalogue contract","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /operations`","traces":["g-23","d-18"],"milestone":7,"inSection":"sec-agents-401","realisation":"checked"},
    {"id":"agt-401","kind":"requirement","statement":"The meaning of an operation at one version SHALL stay unchanged in every later release of the platform.","rationale":"A version names a meaning. Changing the meaning under the same name is the silent break the version exists to prevent.","evaluate":{"method":"property"},"ref":"AGT-401","area":"06-agents","section":"Catalogue contract","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /operations/{name}`","traces":["g-23"],"milestone":7,"inSection":"sec-agents-401","realisation":"checked"},
    {"id":"agt-402","kind":"requirement","statement":"A deprecated operation SHALL keep answering its callers until the removal date that its catalogue entry declares.","rationale":"Removal is announced in the catalogue, so a caller can move before it happens.","evaluate":{"method":"scenario"},"ref":"AGT-402","area":"06-agents","section":"Catalogue contract","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /operations/{name}`","traces":["g-23"],"milestone":7,"inSection":"sec-agents-401","realisation":"checked"},
    {"id":"agt-403","kind":"requirement","statement":"A mutating operation SHALL accept an idempotency key chosen by its caller.","rationale":"A caller that retries after a lost response needs a way to name the same request twice.","evaluate":{"method":"scenario"},"ref":"AGT-403","area":"06-agents","section":"Catalogue contract","lifecycle":"active","boundary":"b-11","boundaryDetail":"`Idempotency-Key`","traces":["g-25"],"milestone":7,"inSection":"sec-agents-401","realisation":"checked"},
    {"id":"agt-405","kind":"requirement","statement":"A list operation SHALL return its results in pages, each with a cursor that resumes the same listing.","rationale":"A tenant can hold more records than a single response carries.","evaluate":{"method":"scenario"},"ref":"AGT-405","area":"06-agents","section":"Catalogue contract","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /records`","traces":["g-24"],"milestone":7,"inSection":"sec-agents-401","realisation":"checked"},
    {"id":"agt-406","kind":"requirement","statement":"An operation whose work outlasts its request SHALL return an operation handle whose state stays readable until the work ends.","rationale":"Long work is started, then watched, so the handle is the contract for the wait.","evaluate":{"method":"scenario"},"ref":"AGT-406","area":"06-agents","section":"Catalogue contract","lifecycle":"active","boundary":"b-11","boundaryDetail":"`operation handle`","traces":["g-24"],"milestone":7,"inSection":"sec-agents-401","realisation":"checked"},
    {"id":"agt-407","kind":"requirement","statement":"A failed operation SHALL return a stable error code and a flag that states whether repeating the same request would succeed.","rationale":"An agent decides whether to retry from the error alone, so the error must be machine-readable and stable.","evaluate":{"method":"scenario"},"ref":"AGT-407","area":"06-agents","section":"Catalogue contract","lifecycle":"active","boundary":"b-11","boundaryDetail":"`error`","traces":["g-24"],"milestone":7,"inSection":"sec-agents-401","realisation":"checked"},
    {"id":"agt-408","kind":"requirement","statement":"An event subscription SHALL resume after a disconnect from the last position that its subscriber acknowledged.","rationale":"A watching agent that reconnects must not silently miss committed changes.","evaluate":{"method":"scenario"},"ref":"AGT-408","area":"06-agents","section":"Catalogue contract","lifecycle":"active","boundary":"b-11","boundaryDetail":"`event stream`","traces":["g-23"],"milestone":7,"inSection":"sec-agents-401","realisation":"checked"},
    {"id":"agt-409","kind":"requirement","statement":"The events delivered to one subscription SHALL keep the commit order of the tenant they come from.","rationale":"Events of one tenant are a sequence, and an agent that reads them out of order reaches a wrong state.","evaluate":{"method":"property"},"ref":"AGT-409","area":"06-agents","section":"Catalogue contract","lifecycle":"active","boundary":"b-11","boundaryDetail":"`event stream`","traces":["g-23"],"milestone":7,"inSection":"sec-agents-401","realisation":"checked"},
    {"id":"agt-410","kind":"requirement","statement":"The operation catalogue SHALL offer queries over metrics, logs and traces to agents.","rationale":"An agent that diagnoses a fault needs the telemetry through the same contract as everything else.","evaluate":{"method":"scenario"},"ref":"AGT-410","area":"06-agents","section":"Queries over the platform","lifecycle":"active","boundary":"b-11","boundaryDetail":"`telemetry query`","traces":["g-23","g-27"],"milestone":7,"inSection":"sec-agents-402","realisation":"checked"},
    {"id":"agt-411","kind":"requirement","statement":"A telemetry query made by an agent SHALL return only the series, log lines and spans that the policies of the agent's principal permit it to read.","rationale":"Telemetry carries no record content, but it still reveals who is active and where, so it is filtered like a read.","evaluate":{"method":"scenario"},"ref":"AGT-411","area":"06-agents","section":"Queries over the platform","lifecycle":"active","boundary":"b-12","boundaryDetail":"`telemetry query`","traces":["g-23","g-27"],"milestone":7,"inSection":"sec-agents-402","realisation":"checked"},
    {"id":"agt-412","kind":"requirement","statement":"An audit query made by an agent SHALL return only the entries that the policies of the agent's principal permit it to read.","rationale":"The audit log describes people and tenants, so an agent sees the part its principal may see and no more.","evaluate":{"method":"scenario"},"ref":"AGT-412","area":"06-agents","section":"Queries over the platform","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit query`","traces":["g-30","g-23"],"milestone":7,"inSection":"sec-agents-402","realisation":"checked"},
    {"id":"agt-413","kind":"requirement","statement":"A result that withholds audit entries from an agent SHALL state that entries were withheld.","rationale":"A filtered record that looks complete misleads the agent that reads it.","evaluate":{"method":"scenario"},"ref":"AGT-413","area":"06-agents","section":"Queries over the platform","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit query`","traces":["g-30"],"milestone":7,"inSection":"sec-agents-402","realisation":"checked"},
    {"id":"agt-414","kind":"requirement","statement":"The verification status of each requirement of this specification SHALL be readable through the operation catalogue by owners of a tenant and by platform operators.","rationale":"An agent asks what the platform is required to guarantee before it relies on it.","evaluate":{"method":"scenario"},"ref":"AGT-414","area":"06-agents","section":"Queries over the platform","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /specification/requirements`","traces":["g-41","g-27","d-533"],"milestone":7,"inSection":"sec-agents-402","realisation":"checked"},
    {"id":"agt-415","kind":"requirement","statement":"Every tenant lifecycle operation SHALL be a catalogue operation that offers a dry run and writes an audit entry.","rationale":"Provisioning, suspension, export, move and deletion are the operations with the largest effect, so they carry the same evidence as every other operation.","evaluate":{"method":"scenario"},"ref":"AGT-415","area":"06-agents","section":"Operations over the platform","lifecycle":"active","boundary":"b-3","boundaryDetail":"`POST /tenants`","traces":["g-23","g-30"],"milestone":7,"inSection":"sec-agents-403","realisation":"checked"},
    {"id":"agt-416","kind":"requirement","statement":"The jobs and schedules of a tenant SHALL be listable through the operation catalogue with their state, their attempts and the error of each attempt.","rationale":"An agent that reasons about stuck automation needs the record that the automation worker keeps.","evaluate":{"method":"scenario"},"ref":"AGT-416","area":"06-agents","section":"Operations over the platform","lifecycle":"active","boundary":"b-7","boundaryDetail":"`job`","traces":["g-13","g-27"],"milestone":7,"inSection":"sec-agents-403","realisation":"checked"},
    {"id":"agt-417","kind":"requirement","statement":"Cancelling a job SHALL be a catalogue operation that records the requester and the reason for the cancellation.","rationale":"A cancelled job is final, so the reason is kept with it.","evaluate":{"method":"scenario"},"ref":"AGT-417","area":"06-agents","section":"Operations over the platform","lifecycle":"active","boundary":"b-7","boundaryDetail":"`job cancel`","traces":["g-13","g-25"],"milestone":7,"inSection":"sec-agents-403","realisation":"checked"},
    {"id":"agt-418","kind":"requirement","statement":"Retrying a failed job SHALL create a new attempt and leave the recorded outcome of earlier attempts unchanged.","rationale":"Dead work is explained by its history, so a retry adds to the history and does not rewrite it.","evaluate":{"method":"scenario"},"ref":"AGT-418","area":"06-agents","section":"Operations over the platform","lifecycle":"active","boundary":"b-7","boundaryDetail":"`job retry`","traces":["g-14","g-25"],"milestone":7,"inSection":"sec-agents-403","realisation":"checked"},
    {"id":"agt-419","kind":"requirement","statement":"Purging a stored copy by tag SHALL be a catalogue operation that records the tag, the requester and the outcome.","rationale":"A purge removes what readers saw, so it needs the same record as a change.","evaluate":{"method":"scenario"},"ref":"AGT-419","area":"06-agents","section":"Operations over the platform","lifecycle":"active","boundary":"b-15","boundaryDetail":"`remove by tag`","traces":["g-22","g-25"],"milestone":7,"inSection":"sec-agents-403","realisation":"checked"},
    {"id":"agt-420","kind":"requirement","statement":"Feature flags and tenant quotas SHALL be readable and changeable through the operation catalogue as tenant metadata.","rationale":"Flags and quotas are how a tenant controls its own load and its own rollout, so an agent reaches them through the same catalogue.","evaluate":{"method":"scenario"},"ref":"AGT-420","area":"06-agents","section":"Operations over the platform","lifecycle":"active","boundary":"b-11","boundaryDetail":"`feature flag`","traces":["g-23","g-4"],"milestone":7,"inSection":"sec-agents-403","realisation":"checked"},
    {"id":"agt-421","kind":"requirement","statement":"Incident records SHALL be readable and updatable through the operation catalogue with their affected tenants and their timeline.","rationale":"An agent working an incident reads and writes the same incident record as the people on call.","evaluate":{"method":"scenario"},"ref":"AGT-421","area":"06-agents","section":"Operations over the platform","lifecycle":"active","boundary":"b-11","boundaryDetail":"`incident`","traces":["g-27"],"milestone":7,"inSection":"sec-agents-403","realisation":"checked"},
    {"id":"agt-422","kind":"requirement","statement":"A projection of a change SHALL be requestable through the operation catalogue against the recorded history of a tenant at a revision that the caller names.","rationale":"Simulation on demand is what lets an agent test a change before it proposes it.","evaluate":{"method":"scenario"},"ref":"AGT-422","area":"06-agents","section":"Operations over the platform","lifecycle":"active","boundary":"b-20","boundaryDetail":"`projection`","traces":["g-44","g-24"],"milestone":7,"inSection":"sec-agents-403","realisation":"checked"},
    {"id":"agt-423","kind":"requirement","statement":"The operation catalogue SHALL report the spend attributable to each agent and to each tenant for a period that the caller names.","rationale":"Cost is a cost of operation, and an agent that spends must be seen spending.","evaluate":{"method":"scenario"},"ref":"AGT-423","area":"06-agents","section":"Operations over the platform","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /spend`","traces":["g-27","g-28"],"milestone":7,"inSection":"sec-agents-403","realisation":"checked"},
    {"id":"agt-424","kind":"requirement","statement":"A deployment or configuration change SHALL be a catalogue operation that offers a dry run and records its outcome.","rationale":"The platform's own configuration is changed through the same contract as tenant metadata, so the same evidence applies.","evaluate":{"method":"scenario"},"ref":"AGT-424","area":"06-agents","section":"Operations over the platform","lifecycle":"active","boundary":"b-19","boundaryDetail":"`deployment descriptor`","traces":["g-23","g-44"],"milestone":7,"inSection":"sec-agents-403","realisation":"checked"},
    {"id":"agt-425","kind":"requirement","statement":"Identity realm configuration SHALL be readable and changeable through the operation catalogue, with each change projected before it applies.","rationale":"Sign-in policy is the most consequential configuration of a tenant, and it is projected like any schema change.","evaluate":{"method":"scenario"},"ref":"AGT-425","area":"06-agents","section":"Operations over the platform","lifecycle":"active","boundary":"b-4","boundaryDetail":"`realm configuration`","traces":["g-23","g-44"],"milestone":7,"inSection":"sec-agents-403","realisation":"checked"},
    {"id":"obs-400","kind":"requirement","statement":"Every run of an agent SHALL produce a trace that names each input the run read, each operation the run called and the outcome of each.","rationale":"The trace is the account of a run, so it names what the run saw and what it did.","evaluate":{"method":"scenario"},"ref":"OBS-400","area":"06-agents","section":"Agent run traces","lifecycle":"active","boundary":"b-12","boundaryDetail":"`agent run trace`","traces":["g-400"],"milestone":8,"inSection":"sec-observability-401","realisation":"checked"},
    {"id":"obs-401","kind":"requirement","statement":"A run trace of the platform's own conversational assistant SHALL name the model, its provider and its version behind each decision.","rationale":"A decision of the platform's own assistant is traceable to the model that made it. Third-party agents are covered by the non-goal on their reasoning.","evaluate":{"method":"example"},"ref":"OBS-401","area":"06-agents","section":"Agent run traces","lifecycle":"active","boundary":"b-12","boundaryDetail":"`assistant run trace`","traces":["g-400"],"milestone":8,"inSection":"sec-observability-401","realisation":"checked"},
    {"id":"obs-402","kind":"requirement","statement":"The platform-side steps of a run trace SHALL be replayable from the recorded inputs and operation outcomes.","rationale":"A replay shows whether the platform did what the record says, without asking the agent to repeat itself.","evaluate":{"method":"scenario"},"ref":"OBS-402","area":"06-agents","section":"Agent run traces","lifecycle":"active","boundary":"b-12","boundaryDetail":"`run replay`","traces":["g-400"],"milestone":8,"inSection":"sec-observability-401","realisation":"checked"},
    {"id":"obs-403","kind":"requirement","statement":"A run trace SHALL be visible to the owner of each tenant that the run touched and to no principal that lacks a permission on that tenant.","rationale":"The trace is the tenant's own record of what acted in it.","evaluate":{"method":"scenario"},"ref":"OBS-403","area":"06-agents","section":"Agent run traces","lifecycle":"active","boundary":"b-12","boundaryDetail":"`agent run trace`","traces":["g-400"],"milestone":8,"inSection":"sec-observability-401","realisation":"checked"},
    {"id":"obs-404","kind":"requirement","statement":"Each run trace, retained for the period that the tenant owner sets, SHALL name the agent and the person it acted for.","rationale":"Attribution is what makes the trace useful after the run is over.","evaluate":{"method":"scenario"},"ref":"OBS-404","area":"06-agents","section":"Agent run traces","lifecycle":"active","boundary":"b-12","boundaryDetail":"`agent run trace`","traces":["g-400","g-25"],"milestone":8,"inSection":"sec-observability-401","realisation":"checked"},
    {"id":"obs-405","kind":"requirement","statement":"The platform SHALL raise an alert when the operations of an agent depart from the pattern recorded for that agent.","rationale":"A compromised or confused agent is first visible as a change in its own pattern.","evaluate":{"method":"scenario"},"ref":"OBS-405","area":"06-agents","section":"Registry, attestation and alerts","lifecycle":"active","boundary":"b-12","boundaryDetail":"`alert`","traces":["g-403","g-27"],"milestone":8,"inSection":"sec-observability-402","realisation":"checked"},
    {"id":"obs-406","kind":"requirement","statement":"The agent registry SHALL list every agent with its owner, its purpose, its scopes and its tier.","rationale":"An agent that nobody owns is an agent nobody can stop, so the registry is complete by rule.","evaluate":{"method":"property"},"ref":"OBS-406","area":"06-agents","section":"Registry, attestation and alerts","lifecycle":"active","boundary":"b-11","boundaryDetail":"`agent registry`","traces":["g-23","g-10"],"milestone":8,"inSection":"sec-observability-402","realisation":"checked"},
    {"id":"obs-407","kind":"requirement","statement":"An agent request whose identity fails attestation SHALL be refused.","rationale":"Attestation ties each request to a registered agent, and a request without it is not that agent's.","evaluate":{"method":"scenario"},"ref":"OBS-407","area":"06-agents","section":"Registry, attestation and alerts","lifecycle":"active","boundary":"b-6","boundaryDetail":"`agent identity`","traces":["g-10","k-6"],"milestone":8,"inSection":"sec-observability-402","realisation":"checked"},
    {"id":"ags-400","kind":"requirement","statement":"Data that the platform returns to an agent SHALL carry the origin and the trust level of every text it contains.","rationale":"An agent cannot weigh a text it cannot place, so origin and trust travel with the text.","evaluate":{"method":"property"},"ref":"AGS-400","area":"06-agents","section":"Untrusted text","lifecycle":"active","boundary":"b-11","boundaryDetail":"`agent response`","traces":["k-400","g-402","d-532"],"milestone":8,"inSection":"sec-ags-2","realisation":"checked"},
    {"id":"ags-401","kind":"requirement","statement":"An instruction found inside data that an agent reads SHALL carry no authority over the operations that the agent performs.","rationale":"Prompt injection is the case where text written by a stranger is read as a command, and this rule removes that reading.","evaluate":{"method":"scenario"},"ref":"AGS-401","area":"06-agents","section":"Untrusted text","lifecycle":"active","boundary":"b-11","boundaryDetail":"`agent response`","traces":["g-402"],"milestone":8,"inSection":"sec-ags-2","realisation":"checked"},
    {"id":"ags-402","kind":"requirement","statement":"An operation requested while the agent works on text of low trust SHALL be refused when it would widen a scope, change a policy, or send data to an address that the tenant has not allowed.","rationale":"The three effects a planted instruction wants are the three that need a person, so the platform refuses them while the text is untrusted.","evaluate":{"method":"scenario"},"ref":"AGS-402","area":"06-agents","section":"Untrusted text","lifecycle":"active","boundary":"b-11","boundaryDetail":"`operation`","traces":["g-402","g-401"],"milestone":8,"inSection":"sec-ags-2","realisation":"checked"},
    {"id":"ags-403","kind":"requirement","statement":"Each case of the agent safety corpus SHALL end in the outcome that its row states.","rationale":"The corpus is the standing evidence that the rules above hold against the attacks it lists.","evaluate":{"method":"conformance"},"ref":"AGS-403","area":"06-agents","section":"Untrusted text","lifecycle":"active","boundary":"b-11","boundaryDetail":"`operation`","traces":["g-402","g-401"],"milestone":8,"cases":["cases-agent-safety-corpus"],"inSection":"sec-ags-2","realisation":"checked"},
    {"id":"ags-404","kind":"requirement","statement":"The platform's own conversational assistant SHALL receive tenant-authored text only inside a delimited data field.","rationale":"The assistant reads everything a tenant writes, so its context marks which text is data and which is its instruction.","evaluate":{"method":"example"},"ref":"AGS-404","area":"06-agents","section":"Untrusted text","lifecycle":"active","boundary":"b-11","boundaryDetail":"`assistant context`","traces":["g-402"],"milestone":8,"inSection":"sec-ags-2","realisation":"checked"},
    {"id":"ags-405","kind":"requirement","statement":"Tenant-defined object names SHALL appear in the operation catalogue only as quoted data inside a description.","rationale":"Operation names come from tenant metadata, so a crafted object name is the cheapest injection a catalogue offers.","evaluate":{"method":"property"},"ref":"AGS-405","area":"06-agents","section":"Untrusted text","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /operations`","traces":["g-402","k-400"],"milestone":8,"inSection":"sec-ags-2","realisation":"checked"},
    {"id":"ags-406","kind":"requirement","statement":"A delegation issued from a delegated token SHALL grant no scope beyond the scopes of that token.","rationale":"A chain of delegations narrows at every link, so the last agent holds no more than the first delegated token allowed.","evaluate":{"method":"property"},"ref":"AGS-406","area":"06-agents","section":"Delegation and authority","lifecycle":"active","boundary":"b-6","boundaryDetail":"`delegated token`","traces":["g-401","k-13"],"milestone":8,"inSection":"sec-ags-3","realisation":"checked"},
    {"id":"ags-407","kind":"requirement","statement":"A delegation SHALL name a purpose and an expiry that is no later than the expiry of the token it is issued from.","rationale":"A delegation without a purpose is a grant of everything the token reaches, and one that outlives its token is a way around revocation.","evaluate":{"method":"property"},"ref":"AGS-407","area":"06-agents","section":"Delegation and authority","lifecycle":"active","boundary":"b-6","boundaryDetail":"`delegation`","traces":["g-401"],"milestone":8,"inSection":"sec-ags-3","realisation":"checked"},
    {"id":"ags-408","kind":"requirement","statement":"A delegated token SHALL be refused for an operation outside the purpose that the delegation names.","rationale":"The purpose is checked at each use, not only at issue.","evaluate":{"method":"scenario"},"ref":"AGS-408","area":"06-agents","section":"Delegation and authority","lifecycle":"active","boundary":"b-6","boundaryDetail":"`delegated token`","traces":["g-401"],"milestone":8,"inSection":"sec-ags-3","realisation":"checked"},
    {"id":"ags-409","kind":"requirement","statement":"A proposal SHALL be approved only by a principal other than its author.","rationale":"An author who approves their own change is no check at all, so separation of duties is a rule of the approval and not a matter of convention.","evaluate":{"method":"scenario"},"ref":"AGS-409","area":"06-agents","section":"Delegation and authority","lifecycle":"active","boundary":"b-11","boundaryDetail":"`proposal approval`","traces":["g-401","g-26"],"milestone":8,"inSection":"sec-ags-3","realisation":"checked"},
    {"id":"ags-410","kind":"requirement","statement":"Approval of a change that tenant policy assigns to human approval SHALL come from a person and from no agent.","rationale":"Where policy names a person, an agent in the loop does not satisfy it, however capable it is.","evaluate":{"method":"scenario"},"ref":"AGS-410","area":"06-agents","section":"Delegation and authority","lifecycle":"active","boundary":"b-11","boundaryDetail":"`proposal approval`","traces":["g-26","k-13"],"milestone":8,"inSection":"sec-ags-3","realisation":"checked"},
    {"id":"ags-411","kind":"requirement","statement":"The approvals that count toward a quorum SHALL come from distinct principals that the policy names.","rationale":"A quorum counted with one principal twice is a quorum of one.","evaluate":{"method":"property"},"ref":"AGS-411","area":"06-agents","section":"Delegation and authority","lifecycle":"active","boundary":"b-11","boundaryDetail":"`proposal approval`","traces":["g-26"],"milestone":8,"inSection":"sec-ags-3","realisation":"checked"},
    {"id":"ags-412","kind":"requirement","statement":"A principal SHALL be refused a grant of any scope that its own policies do not permit it to grant, including a grant to itself.","rationale":"Granting is authority over authority, so it is decided by the same rule as any other act and has no exception for the grantor.","evaluate":{"method":"property"},"ref":"AGS-412","area":"06-agents","section":"Delegation and authority","lifecycle":"active","boundary":"b-6","boundaryDetail":"`grant`","traces":["g-401","k-13"],"milestone":8,"inSection":"sec-ags-3","realisation":"checked"},
    {"id":"ags-413","kind":"requirement","statement":"Changing the policy, the budget, the audit setting or the halt of an agent SHALL require a principal other than that agent.","rationale":"These are the four controls that bound an agent, and an agent that could change one of them would be unbounded.","evaluate":{"method":"scenario"},"ref":"AGS-413","area":"06-agents","section":"Delegation and authority","lifecycle":"active","boundary":"b-11","boundaryDetail":"`policy change`","traces":["g-401","g-28"],"milestone":8,"inSection":"sec-ags-3","realisation":"checked"},
    {"id":"ags-414","kind":"requirement","statement":"The platform SHALL count the operations, the records changed, the spend and the external calls of each agent against budgets of that agent and of its tenant.","rationale":"Volume is the first thing a runaway agent exhausts, so it is counted at two levels.","evaluate":{"method":"scenario"},"ref":"AGS-414","area":"06-agents","section":"Blast radius","lifecycle":"active","boundary":"b-11","boundaryDetail":"`operation budget`","traces":["g-403","g-28","d-531"],"milestone":8,"inSection":"sec-ags-4","realisation":"checked"},
    {"id":"ags-415","kind":"requirement","statement":"A bulk operation SHALL be refused unless a projection of the same operation ran against the current revision of the tenant.","rationale":"A bulk change is the one whose mistakes cannot be seen one record at a time, so it is seen whole first.","evaluate":{"method":"scenario"},"ref":"AGS-415","area":"06-agents","section":"Blast radius","lifecycle":"active","boundary":"b-11","boundaryDetail":"`bulk operation`","traces":["g-403","g-44"],"milestone":8,"inSection":"sec-ags-4","realisation":"checked"},
    {"id":"ags-416","kind":"requirement","statement":"An irreversible operation SHALL take effect only after the delay window that the tenant configured has passed, unless a person approved it.","rationale":"A window gives a person time to notice, and it is the only defence against a change nobody can undo. The default is twenty-four hours, and a tenant may set one hour to seven days (D-709).","evaluate":{"method":"scenario"},"ref":"AGS-416","area":"06-agents","section":"Blast radius","lifecycle":"active","boundary":"b-11","boundaryDetail":"`irreversible operation`","traces":["g-403","d-709"],"milestone":8,"inSection":"sec-ags-4","realisation":"checked"},
    {"id":"ags-417","kind":"requirement","statement":"A change by an agent to published content SHALL be applied first to a canary subset of records, and widened only after the checks on that subset pass.","rationale":"A published page reaches readers at once, so the first effect of an agent's change is limited to a subset that can be checked.","evaluate":{"method":"scenario"},"ref":"AGS-417","area":"06-agents","section":"Blast radius","lifecycle":"active","boundary":"b-9","boundaryDetail":"`published content`","traces":["g-403","g-26"],"milestone":8,"inSection":"sec-ags-4","realisation":"checked"},
    {"id":"ags-418","kind":"requirement","statement":"An agent SHALL be halted automatically when an anomaly rule of its tenant trips.","rationale":"A halt that waits for a person arrives after the damage, so the platform stops the agent itself and a person decides afterwards.","evaluate":{"method":"scenario"},"ref":"AGS-418","area":"06-agents","section":"Blast radius","lifecycle":"active","boundary":"b-11","boundaryDetail":"`agent halt`","traces":["g-403","g-28"],"milestone":8,"inSection":"sec-ags-4","realisation":"checked"},
    {"id":"ags-419","kind":"requirement","statement":"A halted agent SHALL have every further operation refused until a principal other than that agent resumes it.","rationale":"A halt that the agent can lift is not a halt, so resuming is for a person.","evaluate":{"method":"scenario"},"ref":"AGS-419","area":"06-agents","section":"Blast radius","lifecycle":"active","boundary":"b-11","boundaryDetail":"`agent halt`","traces":["g-403","g-28"],"milestone":8,"inSection":"sec-ags-4","realisation":"checked"},
    {"id":"ags-420","kind":"requirement","statement":"The anomaly rules of a tenant SHALL cover an error spike, a violated state invariant and a mass deletion.","rationale":"These are the three signatures of a runaway agent that the platform can see directly.","evaluate":{"method":"example"},"ref":"AGS-420","area":"06-agents","section":"Blast radius","lifecycle":"active","boundary":"b-11","boundaryDetail":"`anomaly rule`","traces":["g-403"],"milestone":8,"inSection":"sec-ags-4","realisation":"checked"},
    {"id":"ags-421","kind":"requirement","statement":"An applied agent change whose operation declares a reversal SHALL be reversible within the undo window that the tenant configured.","rationale":"Reversibility is declared per operation, and the window is the time in which a declared reversal is still possible. The default is seven days, and a tenant may set one hour to thirty days (D-709).","evaluate":{"method":"scenario"},"ref":"AGS-421","area":"06-agents","section":"Blast radius","lifecycle":"active","boundary":"b-11","boundaryDetail":"`undo`","traces":["g-403","g-25","d-709"],"milestone":8,"inSection":"sec-ags-4","realisation":"checked"},
    {"id":"ags-422","kind":"requirement","statement":"A change by an agent that exceeds a rate configured by the tenant SHALL be held for approval.","rationale":"The rate limit bounds how fast a mistake spreads, and the hold gives a person the choice before the rest of the changes happen.","evaluate":{"method":"scenario"},"ref":"AGS-422","area":"06-agents","section":"Blast radius","lifecycle":"active","boundary":"b-11","boundaryDetail":"`rate limit`","traces":["g-403","g-26"],"milestone":8,"inSection":"sec-ags-4","realisation":"checked"},
    {"id":"ags-423","kind":"requirement","statement":"A chain of events in which the output of an agent starts an event that starts the same agent again SHALL be stopped at the loop depth that the tenant configured.","rationale":"Agents that react to each other's events can loop without any single step being wrong, so the chain is measured as a whole. The default loop depth is five, and a tenant may set one up to the hop limit of D-700 (D-709).","evaluate":{"method":"scenario"},"ref":"AGS-423","area":"06-agents","section":"Blast radius","lifecycle":"active","boundary":"b-7","boundaryDetail":"`trigger chain`","traces":["g-403","d-709"],"milestone":8,"inSection":"sec-ags-4","realisation":"checked"},
    {"id":"ags-424","kind":"requirement","statement":"A platform-operating agent SHALL hold an identity separate from every tenant agent, with no grant that reads tenant content.","rationale":"An agent that deploys the platform is a different class of principal, and a tenant agent must not be one of them by accident.","evaluate":{"method":"scenario"},"ref":"AGS-424","area":"06-agents","section":"Platform-operating agents","lifecycle":"active","boundary":"b-19","boundaryDetail":"`platform identity`","traces":["k-401","g-404","d-530"],"milestone":8,"inSection":"sec-ags-5","realisation":"checked"},
    {"id":"ags-425","kind":"requirement","statement":"A platform-operating agent SHALL be refused any write to the audit log, to the specification gate and to the kill switch.","rationale":"These three are the means by which a platform-operating agent would hide what it did or stop being watched.","evaluate":{"method":"scenario"},"ref":"AGS-425","area":"06-agents","section":"Platform-operating agents","lifecycle":"active","boundary":"b-12","boundaryDetail":"`audit entry`","traces":["k-402","g-404"],"milestone":8,"inSection":"sec-ags-5","realisation":"checked"},
    {"id":"ags-426","kind":"requirement","statement":"A change to deployment or configuration by a platform-operating agent SHALL need approval from two principals, neither of which is that agent.","rationale":"A change to the platform reaches every tenant, so it is the change that most needs a second pair of eyes.","evaluate":{"method":"scenario"},"ref":"AGS-426","area":"06-agents","section":"Platform-operating agents","lifecycle":"active","boundary":"b-19","boundaryDetail":"`deployment descriptor`","traces":["g-404"],"milestone":12,"inSection":"sec-ags-5","realisation":"checked"},
    {"id":"ags-427","kind":"requirement","statement":"A change freeze declared by a platform owner SHALL refuse every deployment and configuration change by an agent until a person lifts the freeze.","rationale":"A freeze is the platform owner's statement that nothing changes now, and it binds agents as much as people.","evaluate":{"method":"scenario"},"ref":"AGS-427","area":"06-agents","section":"Platform-operating agents","lifecycle":"active","boundary":"b-19","boundaryDetail":"`change freeze`","traces":["g-404","g-28"],"milestone":12,"inSection":"sec-ags-5","realisation":"checked"},
    {"id":"ags-428","kind":"requirement","statement":"Break-glass access granted to an agent SHALL expire at a stated time, with each use audited.","rationale":"Break-glass is the emergency path, so it is the path that most needs a time limit and a record.","evaluate":{"method":"scenario"},"ref":"AGS-428","area":"06-agents","section":"Platform-operating agents","lifecycle":"active","boundary":"b-6","boundaryDetail":"`break-glass grant`","traces":["g-404","g-30"],"milestone":12,"inSection":"sec-ags-5","realisation":"checked"},
    {"id":"ags-429","kind":"requirement","statement":"Data that an agent reads SHALL leave the platform only through an address on the allow list that the tenant configured.","rationale":"What an agent reads is the one thing that can leave the platform by means that no record shows, so the allow list is the control.","evaluate":{"method":"scenario"},"ref":"AGS-429","area":"06-agents","section":"Data leaving the platform","lifecycle":"active","boundary":"b-11","boundaryDetail":"`agent export`","traces":["g-405"],"milestone":8,"inSection":"sec-ags-6","realisation":"checked"},
    {"id":"ags-430","kind":"requirement","statement":"An agent scope SHALL name the data classifications that the agent reads, and a read of any other classification is refused.","rationale":"Classification is the label that tells a read what it touches, so a scope that names it limits the read at the boundary.","evaluate":{"method":"property"},"ref":"AGS-430","area":"06-agents","section":"Data leaving the platform","lifecycle":"active","boundary":"b-11","boundaryDetail":"`agent scope`","traces":["g-405","g-20"],"milestone":8,"inSection":"sec-ags-6","realisation":"checked"},
    {"id":"ags-431","kind":"requirement","statement":"An operation of the agent plane SHALL return no value of a connector secret in a result, a dry run, an error or a projection.","rationale":"Connector secrets are write-only to every principal, and an agent is a principal, so no output of the agent plane carries one.","evaluate":{"method":"property"},"ref":"AGS-431","area":"06-agents","section":"Data leaving the platform","lifecycle":"active","boundary":"b-17","boundaryDetail":"`connector secret`","traces":["g-405","g-40"],"milestone":8,"inSection":"sec-ags-6","realisation":"checked"},
    {"id":"ags-432","kind":"requirement","statement":"A model provider that receives tenant data through an agent SHALL appear in the subprocessor list of that tenant with its region.","rationale":"A model provider that reads tenant data is a processor of it, and the tenant has to be able to see that.","evaluate":{"method":"example"},"ref":"AGS-432","area":"06-agents","section":"Data leaving the platform","lifecycle":"active","boundary":"b-11","boundaryDetail":"`subprocessor list`","traces":["g-405"],"milestone":8,"inSection":"sec-ags-6","realisation":"checked"},
    {"id":"ags-433","kind":"requirement","statement":"A direct operation that names a revision older than the current revision of its record SHALL be refused.","rationale":"A direct operation based on a stale read silently overwrites a change another agent made, so the revision it was based on is part of the request.","evaluate":{"method":"property"},"ref":"AGS-433","area":"06-agents","section":"Concurrent and chained change","lifecycle":"active","boundary":"b-11","boundaryDetail":"`operation revision`","traces":["g-25","g-26"],"milestone":8,"inSection":"sec-ags-7","realisation":"checked"},
    {"id":"ags-434","kind":"requirement","statement":"An agent that operates on a record with an open change by another agent SHALL receive that change in the status of the record.","rationale":"Two agents editing one record without knowing of each other is a conflict the platform can name, so the status says it.","evaluate":{"method":"scenario"},"ref":"AGS-434","area":"06-agents","section":"Concurrent and chained change","lifecycle":"active","boundary":"b-11","boundaryDetail":"`record status`","traces":["g-23","g-25"],"milestone":8,"inSection":"sec-ags-7","realisation":"checked"},
    {"id":"ags-435","kind":"requirement","statement":"The gate SHALL fail while any case of the agent safety corpus fails.","rationale":"An adversarial suite that does not block a change is a report, and the gate is what blocks it.","evaluate":{"method":"conformance"},"ref":"AGS-435","area":"06-agents","section":"Evaluation","lifecycle":"active","boundary":"b-19","boundaryDetail":"`gate`","traces":["g-41","k-15","d-534"],"milestone":8,"cases":["cases-agent-safety-corpus"],"inSection":"sec-ags-8","realisation":"checked"},
    {"id":"m-halted-agent-applies-nothing","kind":"temporal","models":"ags-419","statement":"After an anomaly halts an agent, no operation of that agent is applied.","evaluate":{"method":"never","scenarios":["anomaly-then-operation","operation-in-transit-at-halt"],"occurs":{"event":"ah-applied"},"negatives":[{"scenario":"anomaly-then-operation","faults":["defect-halt-ignored"]},{"scenario":"operation-in-transit-at-halt","faults":["defect-halt-ignored"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-anomaly-halts","kind":"temporal","models":"ags-418","statement":"A tripped anomaly rule halts the agent it concerns.","evaluate":{"method":"eventually","scenarios":["anomaly-then-operation"],"occurs":{"event":"ah-halted"},"negatives":[{"scenario":"anomaly-then-operation","faults":["ah-trip-disabled"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"restatement"},
    {"id":"m-running-agent-applies","kind":"temporal","models":"ags-418","statement":"An agent that has not been halted applies the operation it is asked to perform.","evaluate":{"method":"eventually","scenarios":["operation-when-running"],"occurs":{"event":"ah-applied"},"negatives":[{"scenario":"operation-when-running","faults":["ah-apply-disabled"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"restatement"},
    {"id":"m-agent-halt-flow-refined","kind":"temporal","models":"ags-419","statement":"The implementation machine of Agent halt refines its model: every step it takes is a step the model takes from the mapped state, or a step the model does not see.","evaluate":{"method":"refines","behavior":"agent-halt-flow-impl"},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"restatement"},
    {"id":"m-self-approval-clears-nothing","kind":"temporal","models":"ags-409","statement":"An approval by the author of a proposal clears nothing.","evaluate":{"method":"never","scenarios":["self-approval-attempted","self-approval-redelivered"],"occurs":{"event":"sp-cleared"},"negatives":[{"scenario":"self-approval-attempted","faults":["defect-self-approval-accepted"]},{"scenario":"self-approval-redelivered","faults":["defect-self-approval-accepted"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-other-approval-clears","kind":"temporal","models":"ags-409","statement":"An approval by a principal other than the author clears the proposal.","evaluate":{"method":"eventually","scenarios":["other-approves"],"occurs":{"event":"sp-cleared"},"negatives":[{"scenario":"other-approves","faults":["sp-other-approval-disabled"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"restatement"},
    {"id":"m-approval-separation-flow-refined","kind":"temporal","models":"ags-409","statement":"The implementation machine of Approval separation refines its model: every step it takes is a step the model takes from the mapped state, or a step the model does not see.","evaluate":{"method":"refines","behavior":"approval-separation-flow-impl"},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"restatement"},
    {"id":"ctk-001","kind":"requirement","statement":"A content token SHALL be stored as tenant metadata under the schema version, holding a name, an expression and a fallback text.","rationale":"Tokens are versioned, migrated, exported and inspected like the rest of the schema.","evaluate":{"method":"scenario"},"ref":"CTK-001","area":"07-content","section":"Definition","lifecycle":"active","boundary":"b-450","boundaryDetail":"`token definition`","traces":["g-450","g-31","d-450","d-524"],"milestone":6,"inSection":"sec-content-tokens-2","realisation":"checked"},
    {"id":"ctk-002","kind":"requirement","statement":"A token definition whose expression fails to parse SHALL be rejected with the position of the error.","rationale":"The author fixes the expression where it is wrong.","evaluate":{"method":"example"},"ref":"CTK-002","area":"07-content","section":"Definition","lifecycle":"active","boundary":"b-450","boundaryDetail":"`token definition`","traces":["g-450","g-24"],"milestone":6,"inSection":"sec-content-tokens-2","realisation":"checked"},
    {"id":"ctk-003","kind":"requirement","statement":"A token definition that refers to itself through other tokens SHALL be rejected.","rationale":"Evaluation then has an end.","evaluate":{"method":"scenario"},"ref":"CTK-003","area":"07-content","section":"Definition","lifecycle":"active","boundary":"b-450","boundaryDetail":"`token definition`","traces":["g-450","g-4"],"milestone":6,"inSection":"sec-content-tokens-2","realisation":"checked"},
    {"id":"ctk-004","kind":"requirement","statement":"Removing a token that stored content refers to SHALL be rejected in strict mode with the referring records listed.","rationale":"The same rule as any schema change: either everything still conforms or the change does not happen.","evaluate":{"method":"scenario"},"ref":"CTK-004","area":"07-content","section":"Definition","lifecycle":"active","boundary":"b-450","boundaryDetail":"`token definition`","traces":["g-450","g-44"],"milestone":6,"inSection":"sec-content-tokens-2","realisation":"checked"},
    {"id":"ctk-005","kind":"requirement","statement":"Saving content that refers to an undefined token SHALL be rejected with the name of that token.","rationale":"A misspelt token is found by the author, not by a reader.","evaluate":{"method":"scenario"},"ref":"CTK-005","area":"07-content","section":"Definition","lifecycle":"active","boundary":"b-450","boundaryDetail":"`token reference`","traces":["g-450","g-24"],"milestone":6,"inSection":"sec-content-tokens-2","realisation":"checked"},
    {"id":"ctk-006","kind":"requirement","statement":"A change to a token definition SHALL be offered with a projection that lists the content whose rendered text differs.","rationale":"One token appears on many pages, so its change is previewed like a schema change.","evaluate":{"method":"scenario"},"ref":"CTK-006","area":"07-content","section":"Definition","lifecycle":"active","boundary":"b-20","boundaryDetail":"`projection`","traces":["g-450","g-44"],"milestone":7,"inSection":"sec-content-tokens-2","realisation":"checked"},
    {"id":"ctk-007","kind":"requirement","statement":"The operation catalogue SHALL list the tokens of a tenant with their expressions and the fields they read.","rationale":"Agents and the assistant work with tokens through the same catalogue as people.","evaluate":{"method":"scenario"},"ref":"CTK-007","area":"07-content","section":"Definition","lifecycle":"active","boundary":"b-11","boundaryDetail":"`GET /operations`","traces":["g-450","g-23"],"milestone":7,"inSection":"sec-content-tokens-2","realisation":"checked"},
    {"id":"ctk-008","kind":"requirement","statement":"For every snapshot, token and context, two evaluations of the token SHALL return equal values.","rationale":"A token is a kernel decision, so it replays and simulates like the rest.","evaluate":{"method":"property"},"ref":"CTK-008","area":"07-content","section":"Evaluation","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::read`","traces":["g-450","k-11"],"milestone":6,"inSection":"sec-content-tokens-3","realisation":"checked"},
    {"id":"ctk-009","kind":"requirement","statement":"A token expression SHALL receive the record being rendered, the reader, the tenant and the time of the request as its whole context.","rationale":"The time is a value handed in, so the kernel still reads no clock.","evaluate":{"method":"property"},"ref":"CTK-009","area":"07-content","section":"Evaluation","lifecycle":"active","boundary":"b-1","boundaryDetail":"`evaluation context`","traces":["g-450","k-1"],"milestone":6,"inSection":"sec-content-tokens-3","realisation":"checked"},
    {"id":"ctk-010","kind":"requirement","statement":"A token value SHALL be computed from field values that the policies of the reader permit that reader to read, and from no other field.","rationale":"A token is a read, and a read is filtered by policy. A token cannot be used to show a reader what a query would hide.","evaluate":{"method":"property"},"ref":"CTK-010","area":"07-content","section":"Evaluation","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::read`","traces":["g-451","g-20"],"milestone":6,"inSection":"sec-content-tokens-3","realisation":"checked"},
    {"id":"ctk-011","kind":"requirement","statement":"A token whose expression yields no value SHALL render its fallback text.","rationale":"Three-valued logic gives unknown, and the reader gets the text the author chose for that case.","evaluate":{"method":"scenario"},"ref":"CTK-011","area":"07-content","section":"Evaluation","lifecycle":"active","boundary":"b-450","boundaryDetail":"`fallback`","traces":["g-450"],"milestone":6,"inSection":"sec-content-tokens-3","realisation":"checked"},
    {"id":"ctk-012","kind":"requirement","statement":"A token evaluation that exhausts its step budget SHALL render the fallback text and record the failure for the tenant.","rationale":"A costly token degrades to its fallback and the owner hears about it.","evaluate":{"method":"scenario"},"ref":"CTK-012","area":"07-content","section":"Evaluation","lifecycle":"active","boundary":"b-450","boundaryDetail":"`fallback`","traces":["g-450","g-4"],"milestone":6,"inSection":"sec-content-tokens-3","realisation":"checked"},
    {"id":"ctk-013","kind":"requirement","statement":"A token value that is a date or a number SHALL be formatted for the language of the reader.","rationale":"The same token reads naturally in each language of the site.","evaluate":{"method":"scenario"},"ref":"CTK-013","area":"07-content","section":"Evaluation","lifecycle":"active","boundary":"b-9","boundaryDetail":"`Accept-Language`","traces":["g-450","g-34"],"milestone":11,"inSection":"sec-content-tokens-3","realisation":"checked"},
    {"id":"ctk-014","kind":"requirement","statement":"A token value SHALL enter each output context in the form that the token output context table states.","rationale":"A value is data. What makes it safe is the context it lands in, so each context has its row.","evaluate":{"method":"conformance"},"ref":"CTK-014","area":"07-content","section":"Output","lifecycle":"active","boundary":"b-450","boundaryDetail":"`output context`","traces":["k-450","k-12"],"milestone":6,"cases":["cases-token-output-contexts"],"inSection":"sec-content-tokens-4","realisation":"checked"},
    {"id":"ctk-015","kind":"requirement","statement":"A delivery response SHALL carry each resolved token as a text node of its structured blocks.","rationale":"The browser builds the page from nodes, so a value with markup characters shows those characters.","evaluate":{"method":"scenario"},"ref":"CTK-015","area":"07-content","section":"Output","lifecycle":"active","boundary":"b-9","boundaryDetail":"`structured blocks`","traces":["k-450","k-12"],"milestone":6,"inSection":"sec-content-tokens-4","realisation":"checked"},
    {"id":"ctk-016","kind":"requirement","statement":"The authoring application SHALL preview the tokens of a draft with the values that a reader chosen by the author would see.","rationale":"The author checks what a member, a guest or a named recipient will read.","evaluate":{"method":"scenario"},"ref":"CTK-016","area":"07-content","section":"Output","lifecycle":"active","boundary":"b-13","boundaryDetail":"`authoring application`","traces":["g-450","g-35"],"milestone":6,"inSection":"sec-content-tokens-4","realisation":"checked"},
    {"id":"ctk-017","kind":"requirement","statement":"A view that holds a token whose value depends on the requesting principal SHALL be marked as dependent on that principal.","rationale":"The mark is what keeps it out of shared copies and out of the edge. Modelled, with a shared store as the defect.","evaluate":{"method":"property"},"ref":"CTK-017","area":"07-content","section":"Stored copies","lifecycle":"active","boundary":"b-15","boundaryDetail":"`audience class`","traces":["g-451","k-7"],"milestone":6,"inSection":"sec-content-tokens-5","realisation":"checked"},
    {"id":"ctk-018","kind":"requirement","statement":"A read result that holds token values SHALL name the records and object types that each token expression read.","rationale":"A page is superseded when something its tokens read changes, not only when its own record does.","evaluate":{"method":"property"},"ref":"CTK-018","area":"07-content","section":"Stored copies","lifecycle":"active","boundary":"b-1","boundaryDetail":"`strata_kernel::read`","traces":["g-450","g-19"],"milestone":6,"inSection":"sec-content-tokens-5","realisation":"checked"},
    {"id":"ctk-019","kind":"requirement","statement":"A token in an email SHALL be evaluated once for each recipient, with that recipient as the reader.","rationale":"A mailing to many people is many renderings, each under its own authority.","evaluate":{"method":"property"},"ref":"CTK-019","area":"07-content","section":"Email","lifecycle":"active","boundary":"b-451","boundaryDetail":"`mail template`","traces":["g-450","g-451"],"milestone":6,"inSection":"sec-content-tokens-6","realisation":"checked"},
    {"id":"ctk-020","kind":"requirement","statement":"An email addressed to a recipient that is no principal of the tenant SHALL evaluate its tokens with the authority of an anonymous reader.","rationale":"An outside address gets what the public gets.","evaluate":{"method":"scenario"},"ref":"CTK-020","area":"07-content","section":"Email","lifecycle":"active","boundary":"b-451","boundaryDetail":"`mail template`","traces":["g-451","g-20"],"milestone":6,"inSection":"sec-content-tokens-6","realisation":"checked"},
    {"id":"eml-001","kind":"requirement","statement":"Each mail adapter SHALL behave as the mail conformance table states for each listed case.","rationale":"An adapter is accepted by behaviour, like every other seam.","evaluate":{"method":"conformance"},"ref":"EML-001","area":"04-automation","section":"The mail contract","lifecycle":"active","boundary":"b-18","boundaryDetail":"`mail contract`","traces":["g-452","g-38"],"milestone":3,"cases":["cases-mail-conformance"],"inSection":"sec-email-2","realisation":"checked"},
    {"id":"eml-002","kind":"requirement","statement":"The mail provider of a deployment SHALL be selected by configuration, with no change to a component image.","rationale":"Changing provider is an operation, not a release.","evaluate":{"method":"scenario"},"ref":"EML-002","area":"04-automation","section":"The mail contract","lifecycle":"active","boundary":"b-19","boundaryDetail":"`environment`","traces":["g-452","k-10"],"milestone":3,"inSection":"sec-email-2","realisation":"checked"},
    {"id":"eml-003","kind":"requirement","statement":"A platform component other than the mail dispatcher SHALL hold no credential of a mail provider and open no connection to one.","rationale":"One place to rate-limit, suppress, log and swap. Checked structurally on the component model.","evaluate":{"method":"property"},"ref":"EML-003","area":"04-automation","section":"The mail contract","lifecycle":"active","boundary":"b-18","boundaryDetail":"`mail contract`","traces":["k-451","g-452"],"milestone":3,"inSection":"sec-email-2","realisation":"construction"},
    {"id":"eml-004","kind":"requirement","statement":"The credential of a mail provider SHALL be read from the key service at the time of sending.","rationale":"The credential sits in no image, no environment file and no tenant database.","evaluate":{"method":"scenario"},"ref":"EML-004","area":"04-automation","section":"The mail contract","lifecycle":"active","boundary":"b-17","boundaryDetail":"`unwrap`","traces":["g-452","g-40","d-523"],"milestone":3,"inSection":"sec-email-2","realisation":"checked"},
    {"id":"eml-005","kind":"requirement","statement":"A request to send mail SHALL become a job in the transaction that commits the change it belongs to.","rationale":"No mail for a change that did not happen, and no change whose mail is lost.","evaluate":{"method":"scenario"},"ref":"EML-005","area":"04-automation","section":"Sending","lifecycle":"active","boundary":"b-7","boundaryDetail":"`mail job`","traces":["g-452","k-9","d-451"],"milestone":5,"inSection":"sec-email-3","realisation":"checked"},
    {"id":"eml-006","kind":"requirement","statement":"A message submitted again with the idempotency key of an accepted message SHALL be delivered once.","rationale":"A lost acknowledgement leads to a retry, and the retry is not a second email. Modelled, with a repeat delivery as the defect.","evaluate":{"method":"property"},"ref":"EML-006","area":"04-automation","section":"Sending","lifecycle":"active","boundary":"b-18","boundaryDetail":"`idempotency key`","traces":["g-453","g-15"],"milestone":3,"inSection":"sec-email-3","realisation":"checked"},
    {"id":"eml-007","kind":"requirement","statement":"A temporary refusal by the mail provider SHALL leave its message queued for a later attempt.","rationale":"Providers throttle and defer as a matter of course.","evaluate":{"method":"scenario"},"ref":"EML-007","area":"04-automation","section":"Sending","lifecycle":"active","boundary":"b-18","boundaryDetail":"`temporary refusal`","traces":["g-453","g-14"],"milestone":3,"inSection":"sec-email-3","realisation":"checked"},
    {"id":"eml-008","kind":"requirement","statement":"A message that the provider refuses for a permanent reason SHALL be recorded as failed with the reason and attempted no further.","rationale":"A bad address does not get better.","evaluate":{"method":"scenario"},"ref":"EML-008","area":"04-automation","section":"Sending","lifecycle":"active","boundary":"b-18","boundaryDetail":"`permanent refusal`","traces":["g-453","g-14"],"milestone":3,"inSection":"sec-email-3","realisation":"checked"},
    {"id":"eml-009","kind":"requirement","statement":"A message that carries a sign-in link SHALL be discarded unsent once the lifetime of its link has passed.","rationale":"After an outage the queue does not deliver links that no longer work.","evaluate":{"method":"scenario"},"ref":"EML-009","area":"04-automation","section":"Sending","lifecycle":"active","boundary":"b-7","boundaryDetail":"`mail job`","traces":["g-452","g-46"],"milestone":5,"inSection":"sec-email-3","realisation":"checked"},
    {"id":"eml-010","kind":"requirement","statement":"The state of each message SHALL be readable by a principal that the policies of the tenant permit to read its mail log.","rationale":"Did it send is the first support question, and an agent can answer it.","evaluate":{"method":"scenario"},"ref":"EML-010","area":"04-automation","section":"Sending","lifecycle":"active","boundary":"b-451","boundaryDetail":"`GET /mail/messages`","traces":["g-453","g-23"],"milestone":5,"inSection":"sec-email-3","realisation":"checked"},
    {"id":"eml-011","kind":"requirement","statement":"The mail log SHALL keep the state and the recipient of a message and drop its body once the provider has accepted it.","rationale":"The log answers what happened without keeping a second copy of what was said.","evaluate":{"method":"property"},"ref":"EML-011","area":"04-automation","section":"Sending","lifecycle":"active","boundary":"b-451","boundaryDetail":"`mail log`","traces":["g-453","g-22"],"milestone":5,"inSection":"sec-email-3","realisation":"checked"},
    {"id":"eml-012","kind":"requirement","statement":"A mail template SHALL be stored as tenant metadata holding a subject, structured blocks and content tokens.","rationale":"Templates are data, so they are versioned, projected and exported with the tenant.","evaluate":{"method":"scenario"},"ref":"EML-012","area":"04-automation","section":"Tenant mail","lifecycle":"active","boundary":"b-451","boundaryDetail":"`mail template`","traces":["g-453","g-31"],"milestone":6,"inSection":"sec-email-4","realisation":"checked"},
    {"id":"eml-013","kind":"requirement","statement":"Mail of a tenant SHALL carry a sender address on a domain of that tenant only after the tenant has proved control of that domain.","rationale":"Proof first, so one tenant cannot send as another, or as anyone else.","evaluate":{"method":"scenario"},"ref":"EML-013","area":"04-automation","section":"Tenant mail","lifecycle":"active","boundary":"b-451","boundaryDetail":"`sender domain`","traces":["g-453","g-21"],"milestone":5,"inSection":"sec-email-4","realisation":"checked"},
    {"id":"eml-014","kind":"requirement","statement":"Mail of a tenant with no proved domain SHALL be sent from an address of the platform that names the tenant.","rationale":"A new tenant can send on its first day.","evaluate":{"method":"scenario"},"ref":"EML-014","area":"04-automation","section":"Tenant mail","lifecycle":"active","boundary":"b-451","boundaryDetail":"`sender domain`","traces":["g-453"],"milestone":5,"inSection":"sec-email-4","realisation":"checked"},
    {"id":"eml-015","kind":"requirement","statement":"A message sent from a tenant domain SHALL be signed with a key published under that domain.","rationale":"Receivers check alignment between the sender address and the signature.","evaluate":{"method":"scenario"},"ref":"EML-015","area":"04-automation","section":"Tenant mail","lifecycle":"active","boundary":"b-18","boundaryDetail":"`DKIM-Signature`","traces":["g-453","k-14"],"milestone":5,"inSection":"sec-email-4","realisation":"checked"},
    {"id":"eml-016","kind":"requirement","statement":"A message SHALL be rendered from structured blocks into an HTML part and a plain text part.","rationale":"No tenant markup reaches a mail client, and every message is readable as text.","evaluate":{"method":"scenario"},"ref":"EML-016","area":"04-automation","section":"Tenant mail","lifecycle":"active","boundary":"b-451","boundaryDetail":"`mail template`","traces":["k-12","k-450"],"milestone":5,"inSection":"sec-email-4","realisation":"checked"},
    {"id":"eml-017","kind":"requirement","statement":"A permanent bounce or a complaint reported by the provider SHALL add its address to the suppression list of the tenant.","rationale":"Sending again to an address that bounced or complained costs the reputation of every sender on the platform.","evaluate":{"method":"scenario"},"ref":"EML-017","area":"04-automation","section":"Tenant mail","lifecycle":"active","boundary":"b-18","boundaryDetail":"`delivery report`","traces":["g-453"],"milestone":5,"inSection":"sec-email-4","realisation":"checked"},
    {"id":"eml-018","kind":"requirement","statement":"A message addressed to a suppressed address SHALL be recorded as suppressed and left unsent.","rationale":"The suppression list is checked at the one place all mail passes.","evaluate":{"method":"property"},"ref":"EML-018","area":"04-automation","section":"Tenant mail","lifecycle":"active","boundary":"b-451","boundaryDetail":"`suppression list`","traces":["g-453"],"milestone":5,"inSection":"sec-email-4","realisation":"checked"},
    {"id":"eml-019","kind":"requirement","statement":"A delivery report SHALL be accepted only when it carries the signature of the provider that the deployment is configured for.","rationale":"A forged bounce would silence mail to a real address.","evaluate":{"method":"scenario"},"ref":"EML-019","area":"04-automation","section":"Tenant mail","lifecycle":"active","boundary":"b-18","boundaryDetail":"`delivery report`","traces":["g-453","g-46"],"milestone":5,"inSection":"sec-email-4","realisation":"checked"},
    {"id":"eml-020","kind":"requirement","statement":"Mail that a tenant sends to an audience SHALL carry an unsubscribe header and a link that take effect without a sign-in.","rationale":"What mailbox providers expect of bulk senders, and what recipients are owed.","evaluate":{"method":"scenario"},"ref":"EML-020","area":"04-automation","section":"Tenant mail","lifecycle":"active","boundary":"b-451","boundaryDetail":"`List-Unsubscribe`","traces":["g-453","k-14"],"milestone":5,"inSection":"sec-email-4","realisation":"checked"},
    {"id":"eml-021","kind":"requirement","statement":"A tenant that exceeds its mail quota SHALL have its further messages held while sign-in mail and the mail of other tenants leave.","rationale":"One tenant's campaign does not delay another tenant's sign-in link.","evaluate":{"method":"scenario"},"ref":"EML-021","area":"04-automation","section":"Tenant mail","lifecycle":"active","boundary":"b-451","boundaryDetail":"`mail quota`","traces":["g-453","g-4"],"milestone":5,"inSection":"sec-email-4","realisation":"checked"},
    {"id":"m-token-value-not-shared","kind":"invariant","models":"ctk-017","statement":"In the model, no reader is served a stored page rendered for another reader, because the normal design stores no reader-dependent page.","evaluate":{"method":"state-invariant","scenarios":["token-two-readers","token-reader-joins-concurrently"],"expr":"!token-render-flow.leak","negatives":[{"scenario":"token-two-readers","faults":["defect-token-stored-shared"]},{"scenario":"token-reader-joins-concurrently","faults":["defect-token-stored-shared"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-mail-delivered-once","kind":"invariant","models":"eml-006","statement":"A message submitted twice with one idempotency key is delivered once, and a message with another key is not taken for it. Two keys are modelled: the table of the adapter has two slots.","evaluate":{"method":"state-invariant","scenarios":["mail-timeout-then-retry","mail-first-acknowledgement-lost","mail-first-submission-lost","mail-same-key-twice","mail-two-keys"],"expr":"mail-adapter-flow.deliveredK1 <= 1 && mail-adapter-flow.deliveredK2 <= 1","negatives":[{"scenario":"mail-timeout-then-retry","faults":["defect-mail-delivered-again"]},{"scenario":"mail-two-keys","faults":["defect-mail-delivered-again"]},{"scenario":"mail-two-keys","faults":["defect-mail-delivered-again-k2"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-mail-recorded-after-retry","kind":"temporal","models":"eml-006","statement":"A message whose first acknowledgement came late, or was lost, is still recorded as sent.","evaluate":{"method":"eventually","scenarios":["mail-timeout-then-retry","mail-first-acknowledgement-lost","mail-first-submission-lost"],"occurs":{"event":"em-recorded"},"negatives":[{"scenario":"mail-timeout-then-retry","faults":["mail-recording-disabled"]},{"scenario":"mail-first-submission-lost","faults":["mail-recording-disabled"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-mail-dispatch-flow-refined","kind":"temporal","models":"eml-006","statement":"The implementation machine of Mail dispatch refines its model: every step it takes is a step the model takes from the mapped state, or a step the model does not see.","evaluate":{"method":"refines","behavior":"mail-dispatch-flow-impl"},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"restatement"},
    {"id":"m-mail-only-via-dispatcher","kind":"structural","models":"eml-003","statement":"Every path from a component other than the mail dispatcher to the mail provider passes through the mail dispatcher.","evaluate":{"method":"only-via","from":["kernel","substrate","store-contract","sqlite-adapter","postgres-adapter","tenant-database","control-plane","control-database","identity-service","runtime","gateway","automation-worker","connector-runner","copy-store","file-store","delivery-network","delivery-network-control","agent-gateway","telemetry-pipeline","audit-log","key-service","external-identity-provider","web-application","simulator","verification","agent","limit-store","backup-archive","fleet-reporting","product-module","external-endpoint","notice-queue","search-index","notification-service","conversation-service","model-provider","local-model-adapter","operator-console","outbound-gate","upload-scanner","release-controller","release-pipeline","image-registry","traffic-switch","subject-rights-service","agent-traffic-switch","migration-job","platform-audit-store"],"to":"mail-service","via":"mail-dispatcher"},"assumptions":["a-model-abstraction"]},
    {"id":"cnv-500","kind":"requirement","statement":"A new tenant SHALL have the assistant turned off until an owner of that tenant turns it on.","rationale":"Nothing is sent to a model provider that the tenant did not choose to send (D-514).","evaluate":{"method":"scenario"},"ref":"CNV-500","area":"09-conversation","section":"Model provider","lifecycle":"active","boundary":"b-200","boundaryDetail":"`POST /conversations/{id}/turns`","traces":["g-205","d-514"],"milestone":9,"inSection":"sec-conversation-8","realisation":"checked"},
    {"id":"ten-500","kind":"requirement","statement":"Provisioning a tenant SHALL issue one bootstrap credential for its first owner, which is refused after its first use and after its expiry.","rationale":"A tenant is usable from the milestone that provisions it, before any other sign-in method exists (D-509).","evaluate":{"method":"scenario"},"ref":"TEN-500","area":"02-tenancy","section":"Provisioning","lifecycle":"active","boundary":"b-3","boundaryDetail":"`bootstrap credential`","traces":["g-2","d-509"],"milestone":2,"inSection":"sec-tenancy-2","realisation":"checked"},
    {"id":"arc-500","kind":"requirement","statement":"A directory entry of an active tenant SHALL be served for at most 15 minutes after the control plane was last reached, and an entry in any other state for at most 60 seconds (ARC-1229).","rationale":"Long enough to ride out a restart or a failover of the control plane, short enough that a suspended or moved tenant is not served for long (D-528).","evaluate":{"method":"budget"},"ref":"ARC-500","area":"09-architecture","section":"Control plane and wake index","lifecycle":"active","boundary":"b-3","boundaryDetail":"`directory entry`","traces":["g-101","d-528"],"milestone":2,"inSection":"sec-arch-2","realisation":"operational"},
    {"id":"agt-500","kind":"requirement","statement":"Disabling an agent SHALL be honoured by every agent gateway instance within 5 seconds.","rationale":"The bound on the kill switch, measured like the bound on session revocation.","evaluate":{"method":"budget"},"ref":"AGT-500","area":"06-agents","section":"Authorise, attribute and limit","lifecycle":"active","boundary":"b-11","boundaryDetail":"`agent state`","traces":["g-28"],"milestone":7,"inSection":"sec-agents-5","realisation":"operational"},
    {"id":"rel-550","kind":"requirement","lifecycle":"active","statement":"A component image SHALL be addressed by its content digest in every release record and every deployment descriptor.","rationale":"A tag can be moved after a test, so a name that moves is not evidence of what ran.","evaluate":{"method":"property"},"ref":"REL-550","area":"08-platform","section":"Images and configuration","boundary":"b-19","boundaryDetail":"`deployment descriptor`","traces":["g-550","d-550"],"milestone":2,"inSection":"sec-release-2","realisation":"operational"},
    {"id":"rel-551","kind":"requirement","lifecycle":"active","statement":"The image that passes the gate in the stage environment SHALL be the image that the production environment runs, with the same digest.","rationale":"What was tested is what is deployed. A second build is a second program.","evaluate":{"method":"scenario"},"ref":"REL-551","area":"08-platform","section":"Images and configuration","boundary":"b-19","boundaryDetail":"`release record`","traces":["g-551","d-550"],"milestone":12,"inSection":"sec-release-2","realisation":"checked"},
    {"id":"rel-552","kind":"requirement","lifecycle":"active","statement":"A component image SHALL be rebuilt on a newer base image within 7 days of the publication of a fix to its base image.","rationale":"A base image that is not rebuilt keeps the fixed flaw in every image that uses it.","evaluate":{"method":"budget"},"ref":"REL-552","area":"08-platform","section":"Images and configuration","boundary":"b-19","boundaryDetail":"`base image`","traces":["g-550","g-259"],"milestone":12,"inSection":"sec-release-2","realisation":"operational"},
    {"id":"rel-553","kind":"requirement","lifecycle":"active","statement":"A release record SHALL name each configuration value of its deployment and hold no secret value.","rationale":"Configuration is named where it is set, and a secret reaches a component only from the key service (DEP-006, SEC-003).","evaluate":{"method":"property"},"ref":"REL-553","area":"08-platform","section":"Images and configuration","boundary":"b-550","boundaryDetail":"`release record`","traces":["g-550","g-554"],"milestone":12,"inSection":"sec-release-2","realisation":"checked"},
    {"id":"rel-554","kind":"requirement","lifecycle":"active","statement":"The stage environment and the production environment SHALL differ only in the ways that the rule column of the environment parity table allows.","rationale":"The parity table is the list of what the stage evidence covers, and each row is checked.","evaluate":{"method":"conformance"},"cases":["cases-environment-parity"],"ref":"REL-554","area":"08-platform","section":"Environments and parity","boundary":"b-19","boundaryDetail":"`environment`","traces":["g-551","d-553"],"milestone":12,"inSection":"sec-release-3","realisation":"checked"},
    {"id":"rel-555","kind":"requirement","lifecycle":"active","statement":"The stage environment SHALL hold only synthetic tenants and scrubbed copies, and no personal data of a production tenant.","rationale":"A personal field of a production tenant held in stage is a copy that the subject rights of PRV-350 to PRV-353 must reach, and the stage environment is not built to reach it.","evaluate":{"method":"property"},"ref":"REL-555","area":"08-platform","section":"Environments and parity","boundary":"b-19","boundaryDetail":"`stage tenant`","traces":["g-555"],"milestone":12,"inSection":"sec-release-3","realisation":"checked"},
    {"id":"rel-556","kind":"requirement","lifecycle":"active","statement":"The stage environment and the production environment SHALL use separate cloud accounts, networks, keys, databases and identity realms.","rationale":"A compromise or a mistake in one environment reaches the other only through a shared account, key or realm, so none is shared.","evaluate":{"method":"scenario"},"ref":"REL-556","area":"08-platform","section":"Environments and parity","boundary":"b-19","boundaryDetail":"`environment`","traces":["g-555","d-553"],"milestone":12,"inSection":"sec-release-3","realisation":"operational"},
    {"id":"rel-584","kind":"requirement","lifecycle":"active","statement":"The cloud profile SHALL hold one stage environment and one production environment, and no environment for a branch or a change.","rationale":"A review environment per branch is a third place that holds the platform and needs its own care, and no requirement is met by it that the stage environment does not meet (D-552).","evaluate":{"method":"scenario"},"ref":"REL-584","area":"08-platform","section":"Environments and parity","boundary":"b-19","boundaryDetail":"`environment`","traces":["g-554","d-552"],"milestone":12,"inSection":"sec-release-3","realisation":"checked"},
    {"id":"rel-557","kind":"requirement","lifecycle":"active","statement":"A release SHALL reach the production environment only after each gate of its promotion path has recorded a passing result in its release record.","rationale":"A gate that is skipped leaves no record, so the record is the proof that every gate ran.","evaluate":{"method":"scenario"},"ref":"REL-557","area":"08-platform","section":"Promotion and approval","boundary":"b-550","boundaryDetail":"`promotion`","traces":["g-551","d-551"],"milestone":12,"inSection":"sec-release-4","realisation":"checked"},
    {"id":"rel-558","kind":"requirement","lifecycle":"active","statement":"A release SHALL pass the smoke checks, the conformance suites of every seam, a migration rehearsal on a copy of production-shaped data and the synthetic probes in the stage environment before its soak begins.","rationale":"Each check answers a different failure: the smoke checks the start, the suites the seams, the rehearsal the data and the probes the outside view.","evaluate":{"method":"scenario"},"ref":"REL-558","area":"08-platform","section":"Promotion and approval","boundary":"b-550","boundaryDetail":"`stage verification`","traces":["g-551"],"milestone":12,"inSection":"sec-release-4","realisation":"checked"},
    {"id":"rel-559","kind":"requirement","lifecycle":"active","statement":"A release SHALL remain in the stage environment for at least 24 hours with its probes passing before its approval is requested.","rationale":"A soak exposes faults that appear only after time, such as a leak or a schedule that runs once a day.","evaluate":{"method":"budget"},"ref":"REL-559","area":"08-platform","section":"Promotion and approval","boundary":"b-550","boundaryDetail":"`stage soak`","traces":["g-551"],"milestone":12,"inSection":"sec-release-4","realisation":"operational"},
    {"id":"rel-560","kind":"requirement","lifecycle":"active","statement":"A production release SHALL carry approvals from two distinct principals, neither of which is its author, and none of which is an agent.","rationale":"The separation rule of AGS-409 and the two-principal rule of AGS-426 apply to every production release, and D-530 keeps agents out of approvals until the last release stage.","evaluate":{"method":"property"},"ref":"REL-560","area":"08-platform","section":"Promotion and approval","boundary":"b-550","boundaryDetail":"`approval`","traces":["g-554","d-564"],"milestone":12,"inSection":"sec-release-4","realisation":"checked"},
    {"id":"rel-561","kind":"requirement","lifecycle":"active","statement":"A change to the production environment SHALL be made only through a release record or an audited operation of the operation catalogue.","rationale":"A change without a record cannot be explained, and an unexplained change to production is the first thing an audit asks about.","evaluate":{"method":"property"},"ref":"REL-561","area":"08-platform","section":"Promotion and approval","boundary":"b-550","boundaryDetail":"`production change`","traces":["g-554","d-567"],"milestone":12,"inSection":"sec-release-4","realisation":"checked"},
    {"id":"rel-562","kind":"requirement","lifecycle":"active","statement":"The release controller SHALL report each difference between the definitions of an environment and what runs in it, at a stated interval.","rationale":"A difference that is only found at the next release is a release that fails for a reason nobody recorded.","evaluate":{"method":"scenario"},"ref":"REL-562","area":"08-platform","section":"Promotion and approval","boundary":"b-550","boundaryDetail":"`drift report`","traces":["g-554","d-566"],"milestone":12,"inSection":"sec-release-4","realisation":"checked"},
    {"id":"rel-563","kind":"requirement","lifecycle":"active","statement":"The release controller SHALL refuse a production release that falls within a freeze window declared by a platform owner, unless the release is a hotfix that the freeze names.","rationale":"A freeze is the owner's statement that nothing changes now, and an emergency fix is the one release a freeze names.","evaluate":{"method":"scenario"},"ref":"REL-563","area":"08-platform","section":"Promotion and approval","boundary":"b-550","boundaryDetail":"`freeze window`","traces":["g-554","d-563"],"milestone":12,"inSection":"sec-release-4","realisation":"checked"},
    {"id":"rel-564","kind":"requirement","lifecycle":"active","statement":"A hotfix SHALL pass every gate of the promotion path, with a stage soak of at least one hour before its approval is requested.","rationale":"The emergency path keeps every gate and shortens only the soak, so that the fix is proved before it reaches readers.","evaluate":{"method":"budget"},"ref":"REL-564","area":"08-platform","section":"Emergency path","boundary":"b-550","boundaryDetail":"`hotfix`","traces":["g-554","d-562"],"milestone":12,"inSection":"sec-release-5","realisation":"operational"},
    {"id":"rel-565","kind":"requirement","lifecycle":"active","statement":"A colour switch SHALL first send at most 5 percent of public requests to the new colour for at least 15 minutes, and then the full share.","rationale":"The canary is the cheapest evidence that the new colour works under real traffic before every reader reaches it (d-554).","evaluate":{"method":"budget"},"ref":"REL-565","area":"08-platform","section":"Colour switch","boundary":"b-551","boundaryDetail":"`canary share`","traces":["g-552","d-554"],"milestone":12,"inSection":"sec-release-6","realisation":"operational"},
    {"id":"rel-566","kind":"requirement","lifecycle":"active","statement":"A new colour SHALL take no public traffic until the release record names it as verified against production dependencies.","rationale":"The new colour is deployed beside the live one and is checked against production databases, queues and identity before a reader can reach it.","evaluate":{"method":"scenario"},"ref":"REL-566","area":"08-platform","section":"Colour switch","boundary":"b-551","boundaryDetail":"`public traffic`","traces":["g-552","d-556"],"milestone":12,"inSection":"sec-release-6","realisation":"checked"},
    {"id":"rel-567","kind":"requirement","lifecycle":"active","statement":"A colour switch or a switch back SHALL take effect at the traffic switch within 30 seconds at the 99th percentile after the release controller requests it.","rationale":"A switch that takes minutes is a deployment, and the short bound keeps a switch back as a remedy and not a project.","evaluate":{"method":"budget"},"ref":"REL-567","area":"08-platform","section":"Colour switch","boundary":"b-551","boundaryDetail":"`colour switch`","traces":["g-552"],"milestone":12,"inSection":"sec-release-6","realisation":"operational"},
    {"id":"rel-568","kind":"requirement","lifecycle":"active","statement":"A switch back SHALL be a single operation of the release controller that deploys nothing.","rationale":"Switching back returns to a colour that is still running, so it needs no build, no deployment and no second decision.","evaluate":{"method":"scenario"},"ref":"REL-568","area":"08-platform","section":"Colour switch","boundary":"b-550","boundaryDetail":"`switch back`","traces":["g-552","d-555"],"milestone":12,"inSection":"sec-release-6","realisation":"checked"},
    {"id":"rel-569","kind":"requirement","lifecycle":"active","statement":"The previous colour SHALL keep its instances running for at least 24 hours after a colour switch.","rationale":"A problem found the next morning is still answered by a switch back, because the previous colour is still there (d-556).","evaluate":{"method":"budget"},"ref":"REL-569","area":"08-platform","section":"Colour switch","boundary":"b-551","boundaryDetail":"`warm colour`","traces":["g-552","d-556"],"milestone":12,"inSection":"sec-release-6","realisation":"operational"},
    {"id":"rel-570","kind":"requirement","lifecycle":"active","statement":"Withdrawing a colour SHALL wait until each of its workers has finished or released the job leases it holds, or until those leases have expired.","rationale":"A job whose lease is held by a withdrawn worker is finished by its replacement only after the lease expires (SCH-010, SCH-011).","evaluate":{"method":"scenario"},"ref":"REL-570","area":"08-platform","section":"Withdrawing a colour","boundary":"b-7","boundaryDetail":"`job lease`","traces":["g-552","d-561"],"milestone":12,"inSection":"sec-release-7","realisation":"checked"},
    {"id":"rel-571","kind":"requirement","lifecycle":"active","statement":"A colour that is withdrawn SHALL close each open event stream and streamed reply with a notice that names the last sequence number it sent.","rationale":"A stream that ends without a notice looks like a failure. With the number, the client resumes on the live colour without a gap (d-558).","evaluate":{"method":"scenario"},"ref":"REL-571","area":"08-platform","section":"Withdrawing a colour","boundary":"b-9","boundaryDetail":"`event stream`","traces":["g-552","d-558"],"milestone":12,"inSection":"sec-release-7","realisation":"checked"},
    {"id":"rel-572","kind":"requirement","lifecycle":"active","statement":"Both colours SHALL share the tenant databases, the copy store, the file store and the notice queue, with no private copy of any of them held by a colour.","rationale":"Shared state is what lets a switch be undone, and a private copy would be lost with its colour (d-557).","evaluate":{"method":"scenario"},"ref":"REL-572","area":"08-platform","section":"Withdrawing a colour","boundary":"b-2","boundaryDetail":"`shared state`","traces":["g-552","d-557"],"milestone":12,"inSection":"sec-release-7","realisation":"checked"},
    {"id":"rel-573","kind":"requirement","lifecycle":"active","statement":"A stored copy SHALL carry the release identifier of the colour that computed it, so that the other colour treats it as absent.","rationale":"A copy computed by one colour is an answer the other colour may compute differently, and the identifier keeps the two apart (CPY-002).","evaluate":{"method":"scenario"},"ref":"REL-573","area":"08-platform","section":"Withdrawing a colour","boundary":"b-15","boundaryDetail":"`copy key`","traces":["g-552","d-557"],"milestone":12,"inSection":"sec-release-7","realisation":"checked"},
    {"id":"rel-577","kind":"requirement","lifecycle":"active","statement":"After a switch back, the traffic switch SHALL send no public request to the withdrawn colour.","rationale":"A withdrawn colour that still takes traffic serves the state that was rolled back.","evaluate":{"method":"scenario"},"ref":"REL-577","area":"08-platform","section":"Withdrawing a colour","boundary":"b-551","boundaryDetail":"`public traffic`","traces":["g-552"],"milestone":12,"inSection":"sec-release-7","realisation":"checked"},
    {"id":"rel-574","kind":"requirement","lifecycle":"active","statement":"A release that carries a contracting phase of a stored layout change SHALL carry it in a release of its own.","rationale":"A contracting phase removes what the previous colour reads, so it cannot be undone by a switch back (k-550, OPS-324).","evaluate":{"method":"example"},"ref":"REL-574","area":"08-platform","section":"Rollback and roll-forward","boundary":"b-3","boundaryDetail":"`layout version`","traces":["g-553","k-550"],"milestone":12,"inSection":"sec-release-8","realisation":"checked"},
    {"id":"rel-575","kind":"requirement","lifecycle":"active","statement":"The release record of a release SHALL classify the release as rollback-safe or roll-forward-only, naming each stored change that the previous colour cannot read.","rationale":"The classification is written before the release starts, so the question whether to undo a release is answered by the record and not by an argument during an incident.","evaluate":{"method":"scenario"},"ref":"REL-575","area":"08-platform","section":"Rollback and roll-forward","boundary":"b-550","boundaryDetail":"`release record`","traces":["g-553"],"milestone":12,"inSection":"sec-release-8","realisation":"checked"},
    {"id":"rel-576","kind":"requirement","lifecycle":"active","statement":"Lifecycle operations of the control plane SHALL run in one active instance at a time, across both colours.","rationale":"Two instances of the control plane acting on one tenant at once can provision, move or delete it twice (d-559).","evaluate":{"method":"scenario"},"ref":"REL-576","area":"08-platform","section":"Control plane, identity and edge","boundary":"b-3","boundaryDetail":"`tenant operation`","traces":["g-552","d-559"],"milestone":12,"inSection":"sec-release-9","realisation":"checked"},
    {"id":"rel-578","kind":"requirement","lifecycle":"active","statement":"The edge configuration of a release SHALL be versioned in its release record and change only with the colour switch of that release.","rationale":"The domain bindings, cache rules and response headers are part of what readers receive, so they move with the release that changes them.","evaluate":{"method":"scenario"},"ref":"REL-578","area":"08-platform","section":"Control plane, identity and edge","boundary":"b-10","boundaryDetail":"`edge configuration`","traces":["g-554"],"milestone":12,"inSection":"sec-release-9","realisation":"checked"},
    {"id":"rel-579","kind":"requirement","lifecycle":"active","statement":"A colour switch SHALL end no sign-in session and no delegated grant.","rationale":"Sessions live in the tenant databases and both colours verify them, so a switch that ends a session would be a bug in the switch (d-560).","evaluate":{"method":"scenario"},"ref":"REL-579","area":"08-platform","section":"Control plane, identity and edge","boundary":"b-4","boundaryDetail":"`sign-in session`","traces":["g-552","d-560"],"milestone":12,"inSection":"sec-release-9","realisation":"checked"},
    {"id":"rel-580","kind":"requirement","lifecycle":"active","statement":"The release controller SHALL have no relationship of any kind, calls included, to a tenant database, a copy store or a file store, and no path to one that avoids the control plane and the migration job.","rationale":"The controller changes the platform and never reads tenant content, so its own reach is the registry, the traffic switch, the platform audit store, the control plane and the migration job (K-2, D-707). The control plane and the migration job hold tenant data access of their own, as they must to provision and to migrate.","evaluate":{"method":"property"},"ref":"REL-580","area":"08-platform","section":"The release controller and its records","boundary":"b-550","boundaryDetail":"`release controller`","traces":["k-2","g-554","d-707"],"milestone":12,"inSection":"sec-release-10","realisation":"construction"},
    {"id":"rel-581","kind":"requirement","lifecycle":"active","statement":"The operation catalogue SHALL list the release record of each production release with its digests, its gate results, its approvals and its colour history.","rationale":"An agent or an operator who asks what runs in production gets the same answer the release controller holds (AGT-414).","evaluate":{"method":"scenario"},"ref":"REL-581","area":"08-platform","section":"The release controller and its records","boundary":"b-11","boundaryDetail":"`GET /releases`","traces":["g-554","d-565"],"milestone":12,"inSection":"sec-release-10","realisation":"checked"},
    {"id":"rel-582","kind":"requirement","lifecycle":"active","statement":"Each platform component that the platform builds SHALL run from a component image that the release pipeline built, and runs from no process installed on a host.","rationale":"A component that runs from an installed process cannot be rebuilt, signed, rolled back or compared with the image that was tested (DEP-001, DEP-008).","evaluate":{"method":"property"},"ref":"REL-582","area":"08-platform","section":"Images and configuration","boundary":"b-19","boundaryDetail":"`component image`","traces":["g-550","g-37"],"milestone":12,"inSection":"sec-release-2","realisation":"operational"},
    {"id":"rel-583","kind":"requirement","lifecycle":"active","statement":"A release SHALL be built only from a commit that the specification gate has passed, and its release record names that commit.","rationale":"The gate is the first step of the promotion path, so an image that was built from an unchecked commit never reaches stage (ASR-001).","evaluate":{"method":"scenario"},"ref":"REL-583","area":"08-platform","section":"Promotion and approval","boundary":"b-550","boundaryDetail":"`release build`","traces":["g-551","g-41"],"milestone":12,"inSection":"sec-release-4","realisation":"operational"},
    {"id":"mig-550","kind":"requirement","lifecycle":"active","statement":"A schema change SHALL be previewed on a copy of the tenant before it is applied to the tenant.","rationale":"The copy holds the tenant's own data, so the preview reports what the change does to the records it will change (d-571).","evaluate":{"method":"scenario"},"ref":"MIG-550","area":"02-tenancy","section":"The guarantee","boundary":"b-1","boundaryDetail":"`schema change`","traces":["g-556","g-44"],"milestone":2,"inSection":"sec-migration-2","realisation":"checked"},
    {"id":"mig-552","kind":"requirement","lifecycle":"active","statement":"A reader SHALL see each record of a tenant in its prior form or in its migrated form, and in no partly converted form.","rationale":"A reader that sees half of a record sees data that no version of the schema has.","evaluate":{"method":"property"},"ref":"MIG-552","area":"02-tenancy","section":"The guarantee","boundary":"b-552","boundaryDetail":"`migrated record`","traces":["g-557"],"milestone":2,"inSection":"sec-migration-2","realisation":"checked"},
    {"id":"mig-555","kind":"requirement","lifecycle":"active","statement":"A migration run that fails SHALL leave the tenant in the form it had before the run, with the failure named in its migration run record.","rationale":"A failed run that leaves the tenant partly changed is a second incident on top of the first.","evaluate":{"method":"scenario"},"ref":"MIG-555","area":"02-tenancy","section":"The guarantee","boundary":"b-552","boundaryDetail":"`migration run`","traces":["g-556","g-557","d-572"],"milestone":2,"inSection":"sec-migration-2","realisation":"checked"},
    {"id":"mig-556","kind":"requirement","lifecycle":"active","statement":"Each migration run SHALL record the preview it was applied from, its batches and its outcome, together with the principal that started it.","rationale":"A change to a tenant's content is attributable in the same way as any other change of the tenant (AGT-015).","evaluate":{"method":"scenario"},"ref":"MIG-556","area":"02-tenancy","section":"The guarantee","boundary":"b-552","boundaryDetail":"`migration run record`","traces":["g-556","g-25"],"milestone":2,"inSection":"sec-migration-2","realisation":"checked"},
    {"id":"mig-579","kind":"requirement","lifecycle":"active","statement":"A committed record of a tenant SHALL remain readable after a migration run or a move that the platform reports as complete.","rationale":"Completion is a claim about the data, and this states what the claim covers.","evaluate":{"method":"property"},"ref":"MIG-579","area":"02-tenancy","section":"The guarantee","boundary":"b-2","boundaryDetail":"`tenant database`","traces":["g-557"],"milestone":2,"inSection":"sec-migration-2","realisation":"checked"},
    {"id":"mig-580","kind":"requirement","lifecycle":"active","statement":"Each batch of a migration run SHALL read and write records of its own tenant only.","rationale":"A batch that reads another tenant to build its own change breaks isolation, which holds through every change (K-2, TEN-007).","evaluate":{"method":"property"},"ref":"MIG-580","area":"02-tenancy","section":"The guarantee","boundary":"b-552","boundaryDetail":"`migration batch`","traces":["g-20","k-2"],"milestone":2,"inSection":"sec-migration-2","realisation":"checked"},
    {"id":"mig-581","kind":"requirement","lifecycle":"active","statement":"A migration run SHALL stop when the tenant owner stops it, with its cursor recorded and the tenant serving its readers.","rationale":"The owner controls the change to their own content, and stopping it leaves the tenant working.","evaluate":{"method":"scenario"},"ref":"MIG-581","area":"02-tenancy","section":"The guarantee","boundary":"b-552","boundaryDetail":"`migration run`","traces":["g-557","g-28"],"milestone":5,"inSection":"sec-migration-2","realisation":"checked"},
    {"id":"mig-551","kind":"requirement","lifecycle":"active","statement":"A schema change of at most 10000 records of one type SHALL apply in one transition, and a larger change runs as a migration run.","rationale":"One transition is the simplest guarantee. The limit keeps one commit within what a single transaction can hold (d-569).","evaluate":{"method":"budget"},"ref":"MIG-551","area":"02-tenancy","section":"Schema changes","boundary":"b-1","boundaryDetail":"`schema change`","traces":["g-557","d-569"],"milestone":2,"inSection":"sec-migration-3","realisation":"operational"},
    {"id":"mig-557","kind":"requirement","lifecycle":"active","statement":"A schema change that removes a field or a constraint SHALL be marked irreversible in its preview.","rationale":"A removal cannot be undone by the platform once later writes depend on it, so the preview says so before the owner decides (AGT-010, NG-551).","evaluate":{"method":"example"},"ref":"MIG-557","area":"02-tenancy","section":"Schema changes","boundary":"b-1","boundaryDetail":"`schema change preview`","traces":["g-556","d-571"],"milestone":2,"inSection":"sec-migration-3","realisation":"checked"},
    {"id":"mig-558","kind":"requirement","lifecycle":"active","statement":"Each conversion of a field from one type to another SHALL behave as the type conversion table states for that pair of types.","rationale":"A conversion is accepted by its table, the way every adapter is accepted by its conformance suite (d-570).","evaluate":{"method":"conformance"},"cases":["cases-type-conversions"],"ref":"MIG-558","area":"02-tenancy","section":"Schema changes","boundary":"b-1","boundaryDetail":"`field type conversion`","traces":["g-557","d-570"],"milestone":2,"inSection":"sec-migration-3","realisation":"checked"},
    {"id":"mig-559","kind":"requirement","lifecycle":"active","statement":"A new field SHALL take the value of each existing record from the expression that its schema change declares.","rationale":"A backfill that is written by hand is a second rule that nobody previews. The expression is in the preview like the rest of the change.","evaluate":{"method":"scenario"},"ref":"MIG-559","area":"02-tenancy","section":"Schema changes","boundary":"b-1","boundaryDetail":"`backfill expression`","traces":["g-556"],"milestone":2,"inSection":"sec-migration-3","realisation":"checked"},
    {"id":"mig-560","kind":"requirement","lifecycle":"active","statement":"A rename SHALL keep the values of existing records under the new name, so that a request under the old name is refused after the change.","rationale":"A rename that drops the values is a delete, and a rename that keeps the old name alive is two fields.","evaluate":{"method":"scenario"},"ref":"MIG-560","area":"02-tenancy","section":"Schema changes","boundary":"b-1","boundaryDetail":"`rename`","traces":["g-557"],"milestone":2,"inSection":"sec-migration-3","realisation":"checked"},
    {"id":"mig-561","kind":"requirement","lifecycle":"active","statement":"A save of a draft made under a prior schema version SHALL be refused with the current version named, and the author's text stays on screen.","rationale":"The author keeps the work, and learns which schema the save was refused against.","evaluate":{"method":"scenario"},"ref":"MIG-561","area":"02-tenancy","section":"Schema changes","boundary":"b-13","boundaryDetail":"`draft save`","traces":["g-556","g-206"],"milestone":6,"inSection":"sec-migration-3","realisation":"checked"},
    {"id":"mig-562","kind":"requirement","lifecycle":"active","statement":"A workflow run SHALL continue under the definition version that started it, and a run that the new definition cannot continue stops with its state recorded.","rationale":"A run started under one definition is finished under it, unless the definition has changed in a way the run cannot follow.","evaluate":{"method":"scenario"},"ref":"MIG-562","area":"02-tenancy","section":"Schema changes","boundary":"b-8","boundaryDetail":"`workflow run`","traces":["g-16","g-556"],"milestone":5,"inSection":"sec-migration-3","realisation":"checked"},
    {"id":"mig-563","kind":"requirement","lifecycle":"active","statement":"A scheduled job SHALL be checked against the schema version in force when it falls due, and it is refused with the changed field named when its definition no longer fits.","rationale":"A job created under the old schema is checked when it runs, because the schema it was written for may no longer exist.","evaluate":{"method":"scenario"},"ref":"MIG-563","area":"02-tenancy","section":"Schema changes","boundary":"b-7","boundaryDetail":"`job`","traces":["g-13","g-556"],"milestone":5,"inSection":"sec-migration-3","realisation":"checked"},
    {"id":"mig-553","kind":"requirement","lifecycle":"active","statement":"A batch of a migration run SHALL hold the writes of its tenant for no longer than 1 second at the 99th percentile.","rationale":"The write pause is the one visible cost of a batched run, so it has a bound that the owner can rely on.","evaluate":{"method":"budget"},"ref":"MIG-553","area":"02-tenancy","section":"Batched runs","boundary":"b-552","boundaryDetail":"`migration batch`","traces":["g-557"],"milestone":2,"inSection":"sec-migration-4","realisation":"operational"},
    {"id":"mig-554","kind":"requirement","lifecycle":"active","statement":"A migration run that stops SHALL resume from its last committed cursor, so that each record of the tenant is converted once.","rationale":"A run that restarts from the beginning converts some records twice, and the cursor is what makes the resume exact.","evaluate":{"method":"scenario"},"ref":"MIG-554","area":"02-tenancy","section":"Batched runs","boundary":"b-7","boundaryDetail":"`migration cursor`","traces":["g-557","k-551","d-568"],"milestone":2,"inSection":"sec-migration-4","realisation":"checked"},
    {"id":"mig-564","kind":"requirement","lifecycle":"active","statement":"A newer version of an installed template SHALL reach a tenant only as a proposal that carries its projection and that the tenant approves before any change applies.","rationale":"An upgrade changes the tenant's own records, so the tenant sees its projection and decides (d-578, INT-154).","evaluate":{"method":"scenario"},"ref":"MIG-564","area":"02-tenancy","section":"Delivery shape and templates","boundary":"b-21","boundaryDetail":"`template upgrade`","traces":["g-167","g-556","d-578"],"milestone":7,"inSection":"sec-migration-5","realisation":"checked"},
    {"id":"mig-582","kind":"requirement","lifecycle":"active","statement":"Both delivery shapes SHALL return the same content for each field that they both carry while the old shape is served.","rationale":"A client that moves at its own pace must not find different facts in the old shape and the new one.","evaluate":{"method":"property"},"ref":"MIG-582","area":"02-tenancy","section":"Delivery shape and templates","boundary":"b-9","boundaryDetail":"`delivery interface`","traces":["g-166"],"milestone":6,"inSection":"sec-migration-5","realisation":"checked"},
    {"id":"mig-565","kind":"requirement","lifecycle":"active","statement":"A tenant whose layout change fails SHALL stay on its previous layout and keep serving its readers.","rationale":"A failed wave is a tenant that lags, and a lagging tenant that stops serving is an outage caused by a release (OPS-323, d-577).","evaluate":{"method":"scenario"},"ref":"MIG-565","area":"02-tenancy","section":"Platform-driven changes","boundary":"b-3","boundaryDetail":"`layout version`","traces":["g-557","g-303","d-577"],"milestone":2,"inSection":"sec-migration-6","realisation":"checked"},
    {"id":"mig-566","kind":"requirement","lifecycle":"active","statement":"A tenant SHALL be served by a newer kernel version only after its journal replays under that version to the state hash that the journal records.","rationale":"The replay is the proof that the new kernel decides the same history the old one did (SIM-004, TEN-015).","evaluate":{"method":"scenario"},"ref":"MIG-566","area":"02-tenancy","section":"Platform-driven changes","boundary":"b-20","boundaryDetail":"`kernel version`","traces":["g-5","g-557","d-580"],"milestone":12,"inSection":"sec-migration-6","realisation":"checked"},
    {"id":"mig-567","kind":"requirement","lifecycle":"active","statement":"A migration applied to a staging tenant SHALL reach its production tenant only as a migration run of that tenant, previewed against the production data.","rationale":"The staging tenant prepares the change, and the production run is the one that changes production (d-575, ADM-158).","evaluate":{"method":"scenario"},"ref":"MIG-567","area":"02-tenancy","section":"Platform-driven changes","boundary":"b-11","boundaryDetail":"`promotion`","traces":["g-164","g-556","d-575"],"milestone":7,"inSection":"sec-migration-6","realisation":"checked"},
    {"id":"mig-568","kind":"requirement","lifecycle":"active","statement":"Writes to a tenant that is moving SHALL be refused for no longer than 60 seconds at the 99th percentile.","rationale":"The read-only window is the visible cost of a move, and the bound states it in advance (d-576).","evaluate":{"method":"budget"},"ref":"MIG-568","area":"02-tenancy","section":"Moving a tenant","boundary":"b-553","boundaryDetail":"`tenant move`","traces":["g-558"],"milestone":2,"inSection":"sec-migration-7","realisation":"operational"},
    {"id":"mig-569","kind":"requirement","lifecycle":"active","statement":"The owner of a tenant SHALL receive notice of the read-only window of a move at least 48 hours before the window starts.","rationale":"The owner plans around a window they know about, and a window announced at its start is an outage.","evaluate":{"method":"budget"},"ref":"MIG-569","area":"02-tenancy","section":"Moving a tenant","boundary":"b-553","boundaryDetail":"`move notice`","traces":["g-558"],"milestone":2,"inSection":"sec-migration-7","realisation":"operational"},
    {"id":"mig-570","kind":"requirement","lifecycle":"active","statement":"The directory SHALL switch a moving tenant to its target placement only after the target state hash equals the source state hash.","rationale":"The hash is the proof that the copy holds the same state, so the directory does not switch to an unverified copy (TEN-012).","evaluate":{"method":"scenario"},"ref":"MIG-570","area":"02-tenancy","section":"Moving a tenant","boundary":"b-553","boundaryDetail":"`placement switch`","traces":["g-558","d-576"],"milestone":2,"inSection":"sec-migration-7","realisation":"checked"},
    {"id":"mig-571","kind":"requirement","lifecycle":"active","statement":"A move whose copy fails SHALL leave the source serving every request and the directory on the source placement.","rationale":"A failed copy is a failed move, and the tenant is where it was before the move started.","evaluate":{"method":"scenario"},"ref":"MIG-571","area":"02-tenancy","section":"Moving a tenant","boundary":"b-553","boundaryDetail":"`tenant move`","traces":["g-558"],"milestone":2,"inSection":"sec-migration-7","realisation":"checked"},
    {"id":"mig-572","kind":"requirement","lifecycle":"active","statement":"The source database of a moved tenant SHALL be kept for at least 7 days after its placement switch.","rationale":"A problem found after the switch is undone by switching back to the source, which exists only for the retention (d-576).","evaluate":{"method":"budget"},"ref":"MIG-572","area":"02-tenancy","section":"Moving a tenant","boundary":"b-553","boundaryDetail":"`source retention`","traces":["g-558"],"milestone":2,"inSection":"sec-migration-7","realisation":"operational"},
    {"id":"mig-573","kind":"requirement","lifecycle":"active","statement":"A point-in-time restore SHALL report the first and the last committed change that it did not restore.","rationale":"A restore that loses changes without naming them leaves the owner to find out what is missing (D-579, OPS-320).","evaluate":{"method":"example"},"ref":"MIG-573","area":"02-tenancy","section":"Restore","boundary":"b-3","boundaryDetail":"`tenant restore`","traces":["g-39","g-302","d-579"],"milestone":12,"inSection":"sec-migration-8","realisation":"checked"},
    {"id":"mig-574","kind":"requirement","lifecycle":"active","statement":"An import of records SHALL update a record that the tenant already holds rather than duplicate it, so that the import can be run again.","rationale":"An import that stops halfway is run again, and a second run that duplicates every record is worse than the first failure.","evaluate":{"method":"scenario"},"ref":"MIG-574","area":"02-tenancy","section":"Import and export","boundary":"b-153","boundaryDetail":"`record import`","traces":["g-163"],"milestone":11,"inSection":"sec-migration-9","realisation":"checked"},
    {"id":"mig-575","kind":"requirement","lifecycle":"active","statement":"An import SHALL produce a mapping report that names each source field with its target field and each value that it could not map.","rationale":"The report is the record of what the import changed and what it refused, and the owner reviews it before the import is trusted.","evaluate":{"method":"example"},"ref":"MIG-575","area":"02-tenancy","section":"Import and export","boundary":"b-153","boundaryDetail":"`mapping report`","traces":["g-163"],"milestone":11,"inSection":"sec-migration-9","realisation":"checked"},
    {"id":"mig-576","kind":"requirement","lifecycle":"active","statement":"An import SHALL keep the identifiers, version numbers, timestamps and authors that the archive names for each record.","rationale":"Links and references between records survive a move between systems only when identifiers survive it (G-163).","evaluate":{"method":"property"},"ref":"MIG-576","area":"02-tenancy","section":"Import and export","boundary":"b-153","boundaryDetail":"`record import`","traces":["g-163"],"milestone":11,"inSection":"sec-migration-9","realisation":"checked"},
    {"id":"mig-577","kind":"requirement","lifecycle":"active","statement":"An import of pages SHALL create a redirect from each former address that the archive names to the address of the imported page.","rationale":"Links from outside the old site keep working after the move (CMS-161).","evaluate":{"method":"scenario"},"ref":"MIG-577","area":"02-tenancy","section":"Import and export","boundary":"b-9","boundaryDetail":"`redirect`","traces":["g-159"],"milestone":11,"inSection":"sec-migration-9","realisation":"checked"},
    {"id":"mig-578","kind":"requirement","lifecycle":"active","statement":"An archive SHALL state each kind of content that it does not carry.","rationale":"An archive that looks complete and is not misleads the customer who takes it elsewhere (ADM-161).","evaluate":{"method":"example"},"ref":"MIG-578","area":"02-tenancy","section":"Import and export","boundary":"b-153","boundaryDetail":"`archive manifest`","traces":["g-163"],"milestone":11,"inSection":"sec-migration-9","realisation":"checked"},
    {"id":"mig-583","kind":"requirement","lifecycle":"active","statement":"A plan change SHALL be refused while the tenant holds more of a metered quantity than the new plan allows, with that quantity named.","rationale":"A downgrade is a migration of the tenant's own usage, and it is refused where the tenant would be out of line (BIL-151).","evaluate":{"method":"scenario"},"ref":"MIG-583","area":"02-tenancy","section":"Plans","boundary":"b-3","boundaryDetail":"`tenant plan`","traces":["g-157","g-4"],"milestone":6,"inSection":"sec-migration-10","realisation":"checked"},
    {"id":"mig-584","kind":"requirement","lifecycle":"active","statement":"A migration run SHALL carry each published version of a record across its change, with the schema version under which that version was written.","rationale":"A record's history reads the same after a change of schema, and each version says which schema it was written under (CMS-006, G-32).","evaluate":{"method":"scenario"},"ref":"MIG-584","area":"02-tenancy","section":"Schema changes","boundary":"b-552","boundaryDetail":"`record history`","traces":["g-32","g-556"],"milestone":11,"inSection":"sec-migration-3","realisation":"checked"},
    {"id":"mig-586","kind":"requirement","lifecycle":"active","statement":"A request that began before a placement switch SHALL complete on the source placement, and a request that begins after it uses the target placement.","rationale":"A switch that changes the placement under a request in flight writes to the wrong database for that request.","evaluate":{"method":"scenario"},"ref":"MIG-586","area":"02-tenancy","section":"Moving a tenant","boundary":"b-553","boundaryDetail":"`placement switch`","traces":["g-558"],"milestone":2,"inSection":"sec-migration-7","realisation":"checked"},
    {"id":"mig-587","kind":"requirement","lifecycle":"active","statement":"A placement switch SHALL leave the stored copies and the edge copies of the tenant valid, because their keys name the tenant and not the placement.","rationale":"A move that purges every copy turns a placement change into a load spike on the target database.","evaluate":{"method":"scenario"},"ref":"MIG-587","area":"02-tenancy","section":"Moving a tenant","boundary":"b-553","boundaryDetail":"`placement switch`","traces":["g-558","g-18"],"milestone":6,"inSection":"sec-migration-7","realisation":"checked"},
    {"id":"mig-588","kind":"requirement","lifecycle":"active","statement":"After a placement switch, the backups and the files of the tenant SHALL be those of the target placement, with the source backups kept for the source retention.","rationale":"Backups and files follow the placement that holds the tenant, and the source copies stay available for the retention (MIG-572).","evaluate":{"method":"scenario"},"ref":"MIG-588","area":"02-tenancy","section":"Moving a tenant","boundary":"b-553","boundaryDetail":"`placement switch`","traces":["g-558","g-1","d-706"],"milestone":2,"inSection":"sec-migration-7","realisation":"checked"},
    {"id":"m-release-controller-no-tenant-data","kind":"structural","models":"rel-580","statement":"The release controller has no relationship of any kind, calls and instructions included, to a tenant database, a copy store or a file store.","evaluate":{"method":"no-relationship","from":"release-controller","to":["tenant-database","copy-store","file-store"],"transitive":false},"assumptions":["a-model-abstraction"]},
    {"id":"m-release-controller-tenant-data-only-via-lifecycle","kind":"structural","models":"rel-580","statement":"Every path from the release controller to a tenant database, a copy store or a file store passes through the control plane or the migration job. Instructions to the traffic switch are of the kind controls: they carry no request or tenant data, and the check follows the other kinds, calls included.","evaluate":{"method":"only-via","from":"release-controller","to":["tenant-database","copy-store","file-store"],"via":["control-plane","migration-job"],"kinds":["depends-on","calls","data-flow","publishes","subscribes","reads","writes"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-platform-audit-store-apart","kind":"structural","models":"rel-580","statement":"The platform audit store has no path of any kind to a tenant database, a copy store, a file store or the store contract.","evaluate":{"method":"no-relationship","from":"platform-audit-store","to":["tenant-database","copy-store","file-store","store-contract"],"transitive":true},"assumptions":["a-model-abstraction"]},
    {"id":"m-no-traffic-before-verification","kind":"temporal","models":"rel-566","statement":"A colour switch that is requested before the new colour is verified sends no public traffic to green.","evaluate":{"method":"never","scenarios":["switch-before-verification","switch-before-delayed-verification","switch-instruction-lost"],"occurs":{"event":"cs-traffic-green"},"negatives":[{"scenario":"switch-before-verification","faults":["defect-switch-unverified"]},{"scenario":"switch-before-delayed-verification","faults":["defect-switch-unverified"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction","a-stage-parity"],"faultBasis":"fault"},
    {"id":"m-green-takes-traffic-when-verified","kind":"temporal","models":"rel-566","statement":"A colour switch requested after the new colour is verified sends public traffic to green.","evaluate":{"method":"eventually","scenarios":["verified-switch"],"occurs":{"event":"cs-traffic-green"},"negatives":[{"scenario":"verified-switch","faults":["colour-switch-disabled"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction","a-stage-parity"],"faultBasis":"restatement"},
    {"id":"m-rollback-restores-blue","kind":"temporal","models":"rel-568","statement":"In the model, a switch back sends public traffic to blue; that it deploys nothing is not checked.","evaluate":{"method":"eventually","scenarios":["rollback-then-request"],"occurs":{"event":"cs-traffic-blue"},"negatives":[{"scenario":"rollback-then-request","faults":["colour-rollback-disabled"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction"],"faultBasis":"restatement"},
    {"id":"m-switch-back-withdrawn-silent","kind":"temporal","models":"rel-577","statement":"A request after a switch back is served by no withdrawn colour.","evaluate":{"method":"never","scenarios":["rollback-then-request","request-in-flight-at-switch-back"],"occurs":{"event":"cs-served-withdrawn"},"negatives":[{"scenario":"rollback-then-request","faults":["defect-serve-withdrawn"]},{"scenario":"request-in-flight-at-switch-back","faults":["defect-serve-withdrawn"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-colour-switch-flow-refined","kind":"temporal","models":"rel-566","statement":"The implementation machine of Colour switch refines its model: every step it takes is a step the model takes from the mapped state, or a step the model does not see.","evaluate":{"method":"refines","behavior":"colour-switch-flow-impl"},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"restatement"},
    {"id":"m-production-gated","kind":"invariant","models":"rel-557","statement":"A production environment that receives a release has a passed gate for it.","evaluate":{"method":"state-invariant","scenarios":["release-promoted","release-promote-without-gate","gate-result-arrives-late"],"expr":"release-promotion-flow.live => release-promotion-flow.gated","negatives":[{"scenario":"release-promote-without-gate","faults":["defect-promote-ungated"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction","a-stage-parity"],"faultBasis":"fault"},
    {"id":"m-production-two-approvals","kind":"invariant","models":"rel-560","statement":"A production environment that receives a release holds at least two approvals for it.","evaluate":{"method":"state-invariant","scenarios":["release-promoted","release-promote-unapproved","release-approval-duplicated"],"expr":"release-promotion-flow.live => release-promotion-flow.approvals >= 2","negatives":[{"scenario":"release-promote-unapproved","faults":["defect-promote-unapproved"]},{"scenario":"release-approval-duplicated","faults":["defect-promote-unapproved"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
    {"id":"m-production-promotion-possible","kind":"temporal","models":"rel-557","statement":"A gated release with two approvals reaches production.","evaluate":{"method":"eventually","scenarios":["release-promoted"],"occurs":{"event":"rp-production-received"},"negatives":[{"scenario":"release-promoted","faults":["promotion-disabled"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction"],"faultBasis":"restatement"},
    {"id":"m-release-promotion-flow-refined","kind":"temporal","models":"rel-557","statement":"The implementation machine of Release promotion refines its model: every step it takes is a step the model takes from the mapped state, or a step the model does not see.","evaluate":{"method":"refines","behavior":"release-promotion-flow-impl"},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"restatement"},
    {"id":"m-migration-converts-once","kind":"invariant","models":"mig-554","statement":"A migration run that stops and resumes converts no record more than once, given that each batch commits together with its cursor.","evaluate":{"method":"state-invariant","scenarios":["migration-interrupted-resumed"],"expr":"migration-batch-flow.converted <= 3","negatives":[{"scenario":"migration-interrupted-resumed","faults":["defect-migration-restarts"]},{"scenario":"migration-interrupted-resumed","faults":["migration-crash-before-cursor"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction","a-database-commit"],"faultBasis":"fault"},
    {"id":"m-migration-finishes","kind":"temporal","models":"mig-554","statement":"A migration run that stops and resumes reaches its end.","evaluate":{"method":"eventually","scenarios":["migration-interrupted-resumed"],"occurs":{"event":"mg-done"},"negatives":[{"scenario":"migration-interrupted-resumed","faults":["migration-batches-disabled"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction","a-database-commit"],"faultBasis":"restatement"},
    {"id":"m-migration-batch-flow-refined","kind":"temporal","models":"mig-554","statement":"The implementation machine of Migration run in batches refines its model: every step it takes is a step the model takes from the mapped state, or a step the model does not see.","evaluate":{"method":"refines","behavior":"migration-batch-flow-impl"},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"restatement"},
    {"id":"m-writes-refused-while-frozen","kind":"temporal","models":"mig-568","statement":"In the model, a write to a moving tenant during its read-only window is refused; the 60-second bound of MIG-568 is not modelled.","evaluate":{"method":"never","scenarios":["move-write-during-freeze","move-write-in-flight"],"occurs":{"event":"tm-write-accepted"},"negatives":[{"scenario":"move-write-during-freeze","faults":["defect-write-during-freeze"]},{"scenario":"move-write-in-flight","faults":["defect-write-during-freeze"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction","a-database-commit"],"faultBasis":"fault"},
    {"id":"m-directory-switch-after-hash","kind":"temporal","models":"mig-570","statement":"The directory switches a moving tenant only after the target hash has been checked.","evaluate":{"method":"precedes","scenarios":["move-completes","move-switch-requested-early","move-with-concurrent-write","move-switch-request-premature"],"first":{"event":"tm-hash-checked"},"then":{"event":"tm-directory-switched"},"negatives":[{"scenario":"move-switch-requested-early","faults":["defect-move-switch-unverified"]},{"scenario":"move-switch-request-premature","faults":["defect-move-switch-unverified"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction","a-database-commit"],"faultBasis":"fault"},
    {"id":"m-move-completes","kind":"temporal","models":"mig-570","statement":"A move whose hash matches reaches its target placement.","evaluate":{"method":"eventually","scenarios":["move-completes"],"occurs":{"event":"tm-directory-switched"},"negatives":[{"scenario":"move-completes","faults":["move-switch-disabled"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction","a-database-commit"],"faultBasis":"restatement"},
    {"id":"m-failed-move-keeps-source","kind":"temporal","models":"mig-571","statement":"A move whose copy fails leaves the directory on the source placement.","evaluate":{"method":"never","scenarios":["move-copy-fails"],"occurs":{"event":"tm-directory-switched"},"negatives":[{"scenario":"move-copy-fails","faults":["defect-switch-on-failure"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction","a-database-commit"],"faultBasis":"fault"},
    {"kind":"requirement","lifecycle":"active","ref":"CNV-700","area":"09-conversation","section":"Consistency review additions","id":"cnv-700","statement":"A browser SHALL reach the conversation service only through the gateway.","rationale":"The conversation service has no address of its own that a browser can reach (D-205).","evaluate":{"method":"property"},"boundary":"b-200","boundaryDetail":"`conversation service`","traces":["d-205","k-6"],"milestone":9,"inSection":"sec-conversation-700","realisation":"construction"},
    {"kind":"requirement","lifecycle":"active","ref":"CNV-701","area":"09-conversation","section":"Consistency review additions","id":"cnv-701","statement":"A preview SHALL stop being valid when the revision of the tenant changes, or 15 minutes after it was shown, whichever comes first.","rationale":"A preview is what the person confirmed, so it does not outlive the state it was computed against (D-516).","evaluate":{"method":"budget"},"boundary":"b-200","boundaryDetail":"`POST /pending-actions/{id}/confirm`","traces":["d-516","g-201"],"milestone":9,"inSection":"sec-conversation-700","realisation":"operational"},
    {"kind":"requirement","lifecycle":"active","ref":"GWY-700","area":"01-core","section":"Consistency review additions","id":"gwy-700","statement":"A browser SHALL reach no platform component except the gateway and the content delivery network.","rationale":"Every other path would bypass the gateway that carries the session and the tenant from the host name (K-6).","evaluate":{"method":"property"},"boundary":"b-9","boundaryDetail":"`browser request`","traces":["k-6","g-20"],"milestone":2,"inSection":"sec-runtime-700","realisation":"construction"},
    {"kind":"requirement","lifecycle":"active","ref":"IDN-700","area":"03-identity","section":"Consistency review additions","id":"idn-700","statement":"A realm policy that turns password sign-in off SHALL be refused while an owner of the tenant has no other sign-in method and no recovery path.","rationale":"Passwords can be turned off, but never in a way that strands an owner (D-525).","evaluate":{"method":"scenario"},"boundary":"b-4","boundaryDetail":"`realm policy`","traces":["g-6","d-525"],"milestone":3,"inSection":"sec-identity-700","realisation":"checked"},
    {"kind":"requirement","lifecycle":"active","ref":"IDN-701","area":"03-identity","section":"Consistency review additions","id":"idn-701","statement":"Audit entries SHALL be kept for the retention period of the tenant policy, which is the platform default of one year when the tenant sets none (D-539), and the period SHALL NOT be shorter than one year (OBS-1215).","rationale":"The audit record outlives the change it describes, for the period the tenant can lengthen.","evaluate":{"method":"scenario"},"boundary":"b-12","boundaryDetail":"`audit entry`","traces":["d-539","g-30"],"milestone":3,"inSection":"sec-identity-700","realisation":"checked"},
    {"kind":"requirement","lifecycle":"active","ref":"PRV-700","area":"09-privacy","section":"Consistency review additions","id":"prv-700","statement":"A backup image or tenant export SHALL be removed when its retention period has ended.","rationale":"Backups and exports expire on a schedule, so that a copy of a person's data is not kept beyond the retention the tenant chose (D-351).","evaluate":{"method":"scenario"},"boundary":"b-101","boundaryDetail":"`backup image`","traces":["d-351","g-22","d-706"],"milestone":2,"inSection":"sec-privacy-700","realisation":"checked"},
    {"kind":"requirement","lifecycle":"active","ref":"ARC-700","area":"09-architecture","section":"Consistency review additions","id":"arc-700","statement":"A workflow step SHALL run as a job under the lease and retry rules that apply to every scheduled job.","rationale":"One lease path and one retry path serve schedules and workflows (D-526).","evaluate":{"method":"scenario"},"boundary":"b-8","boundaryDetail":"`workflow step`","traces":["d-526","g-14"],"milestone":5,"inSection":"sec-arch-700","realisation":"checked"},
    {"kind":"requirement","lifecycle":"active","ref":"ARC-701","area":"09-architecture","section":"Consistency review additions","id":"arc-701","statement":"The calls between the components of the platform SHALL form no cycle.","rationale":"A cycle of calls has no order in which its members can start, be released or fail apart (D-710). Checked structurally by Exegra on the component model.","evaluate":{"method":"property"},"boundary":"b-3","boundaryDetail":"`component model`","traces":["d-710","g-101"],"milestone":2,"inSection":"sec-arch-700","realisation":"construction"},
    {"kind":"requirement","lifecycle":"active","ref":"AGS-700","area":"06-agents","section":"Consistency review additions","id":"ags-700","statement":"A tenant policy SHALL NOT loosen an agent limit below the floor that the platform sets.","rationale":"Limits have platform defaults and floors, and a tenant can tighten them without limit (D-531).","evaluate":{"method":"property"},"boundary":"b-11","boundaryDetail":"`agent limit`","traces":["d-531","g-28"],"milestone":8,"inSection":"sec-ags-700","realisation":"checked"},
    {"kind":"requirement","lifecycle":"active","ref":"UXA-700","area":"09-conversation","section":"Consistency review additions","id":"uxa-700","statement":"The browser code of the platform SHALL use no client framework.","rationale":"Browser code stays framework-free JavaScript run by a kernel in a worker (D-28).","evaluate":{"method":"example"},"boundary":"b-13","boundaryDetail":"`browser code`","traces":["d-28","g-5"],"milestone":3,"inSection":"sec-authoring-700","realisation":"checked"},
    {"id":"m-public-no-direct-storage","kind":"structural","models":"arc-112","statement":"No component in the public zone has a data relationship to (telemetry observation excepted, OBS-003) a storage component.","evaluate":{"method":"no-relationship","from":{"trustZone":"public"},"to":{"category":"storage"},"transitive":false,"kinds":["depends-on","calls","data-flow","publishes","subscribes","reads","writes"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-public-no-direct-data","kind":"structural","models":"arc-112","statement":"No component in the public zone has a data relationship to (telemetry observation excepted, OBS-003) a component of the data zone.","evaluate":{"method":"no-relationship","from":{"trustZone":"public"},"to":{"trustZone":"data"},"transitive":false,"kinds":["depends-on","calls","data-flow","publishes","subscribes","reads","writes"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-model-provider-only-via-conversation","kind":"structural","models":"cnv-235","statement":"Every path from a component other than the conversation service and the local model adapter to the model provider passes through the conversation service.","evaluate":{"method":"only-via","from":["kernel","substrate","store-contract","sqlite-adapter","postgres-adapter","tenant-database","control-plane","control-database","identity-service","runtime","gateway","automation-worker","connector-runner","copy-store","file-store","delivery-network","delivery-network-control","agent-gateway","telemetry-pipeline","audit-log","key-service","mail-service","external-identity-provider","web-application","simulator","verification","agent","limit-store","backup-archive","fleet-reporting","product-module","external-endpoint","notice-queue","search-index","notification-service","operator-console","outbound-gate","upload-scanner","mail-dispatcher","release-controller","release-pipeline","image-registry","traffic-switch","subject-rights-service","agent-traffic-switch","migration-job","platform-audit-store"],"to":"model-provider","via":"conversation-service","kinds":["depends-on","calls","data-flow","publishes","subscribes","reads","writes"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-external-only-via-outbound-gate","kind":"structural","models":"wfl-250","statement":"Every path from a component to an external endpoint passes through the outbound gate.","evaluate":{"method":"only-via","from":["kernel","substrate","store-contract","sqlite-adapter","postgres-adapter","tenant-database","control-plane","control-database","identity-service","runtime","gateway","automation-worker","connector-runner","copy-store","file-store","delivery-network","delivery-network-control","agent-gateway","telemetry-pipeline","audit-log","key-service","mail-service","external-identity-provider","web-application","simulator","verification","agent","limit-store","backup-archive","fleet-reporting","product-module","notice-queue","search-index","notification-service","conversation-service","model-provider","local-model-adapter","operator-console","upload-scanner","mail-dispatcher","release-controller","release-pipeline","image-registry","traffic-switch","subject-rights-service","agent-traffic-switch","migration-job","platform-audit-store"],"to":"external-endpoint","via":"outbound-gate"},"assumptions":["a-model-abstraction"]},
    {"id":"m-copy-store-private","kind":"structural","models":"cpy-011","statement":"Only the runtime, the gateway and the subject rights service have a data relationship to (telemetry observation excepted, OBS-003) the copy store.","evaluate":{"method":"no-relationship","from":["kernel","substrate","store-contract","sqlite-adapter","postgres-adapter","tenant-database","control-plane","control-database","identity-service","automation-worker","connector-runner","file-store","delivery-network","delivery-network-control","agent-gateway","telemetry-pipeline","audit-log","key-service","mail-service","external-identity-provider","web-application","simulator","verification","agent","limit-store","backup-archive","fleet-reporting","product-module","external-endpoint","notice-queue","search-index","notification-service","conversation-service","model-provider","local-model-adapter","operator-console","outbound-gate","upload-scanner","mail-dispatcher","release-controller","release-pipeline","image-registry","traffic-switch","agent-traffic-switch","migration-job","platform-audit-store"],"to":"copy-store","transitive":false,"kinds":["depends-on","calls","data-flow","publishes","subscribes","reads","writes"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-file-store-private","kind":"structural","models":"cms-008","statement":"Only the runtime, the upload scanner, the gateway, the subject rights service and the PostgreSQL adapter have a data relationship to (telemetry observation excepted, OBS-003) the file store.","evaluate":{"method":"no-relationship","from":["kernel","substrate","store-contract","sqlite-adapter","tenant-database","control-plane","control-database","identity-service","automation-worker","connector-runner","copy-store","delivery-network","delivery-network-control","agent-gateway","telemetry-pipeline","audit-log","key-service","mail-service","external-identity-provider","web-application","simulator","verification","agent","limit-store","backup-archive","fleet-reporting","product-module","external-endpoint","notice-queue","search-index","notification-service","conversation-service","model-provider","local-model-adapter","operator-console","outbound-gate","mail-dispatcher","release-controller","release-pipeline","image-registry","traffic-switch","agent-traffic-switch","migration-job","platform-audit-store"],"to":"file-store","transitive":false,"kinds":["depends-on","calls","data-flow","publishes","subscribes","reads","writes"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-search-index-private","kind":"structural","models":"srh-150","statement":"Only the gateway, the runtime, the agent gateway and the subject rights service have a data relationship to (telemetry observation excepted, OBS-003) the search index.","evaluate":{"method":"no-relationship","from":["kernel","substrate","store-contract","sqlite-adapter","postgres-adapter","tenant-database","control-plane","control-database","identity-service","automation-worker","connector-runner","copy-store","file-store","delivery-network","delivery-network-control","telemetry-pipeline","audit-log","key-service","mail-service","external-identity-provider","web-application","simulator","verification","agent","limit-store","backup-archive","fleet-reporting","product-module","external-endpoint","notice-queue","notification-service","conversation-service","model-provider","local-model-adapter","operator-console","outbound-gate","upload-scanner","mail-dispatcher","release-controller","release-pipeline","image-registry","traffic-switch","agent-traffic-switch","migration-job","platform-audit-store"],"to":"search-index","transitive":false,"kinds":["depends-on","calls","data-flow","publishes","subscribes","reads","writes"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-limit-store-private","kind":"structural","models":"arc-109","statement":"Only the gateway, the agent gateway and the identity service have a data relationship to (telemetry observation excepted, OBS-003) the limit store.","evaluate":{"method":"no-relationship","from":["kernel","substrate","store-contract","sqlite-adapter","postgres-adapter","tenant-database","control-plane","control-database","runtime","automation-worker","connector-runner","copy-store","file-store","delivery-network","delivery-network-control","telemetry-pipeline","audit-log","key-service","mail-service","external-identity-provider","web-application","simulator","verification","agent","backup-archive","fleet-reporting","product-module","external-endpoint","notice-queue","search-index","notification-service","conversation-service","model-provider","local-model-adapter","operator-console","outbound-gate","upload-scanner","mail-dispatcher","release-controller","release-pipeline","image-registry","traffic-switch","subject-rights-service","agent-traffic-switch","migration-job","platform-audit-store"],"to":"limit-store","transitive":false,"kinds":["depends-on","calls","data-flow","publishes","subscribes","reads","writes"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-parties-by-identifier","kind":"structural","models":"agt-015","statement":"Every record that names a party to an act names it by principal identifier.","evaluate":{"method":"data-model","rules":["party-by-id"]},"assumptions":["a-model-abstraction"]},
    {"id":"m-mail-keys-distinguished","kind":"temporal","models":"eml-006","faultBasis":"fault","statement":"Messages with two different idempotency keys are each delivered once: the second key is not taken for the first.","evaluate":{"method":"eventually","scenarios":["mail-two-keys"],"expr":"mail-adapter-flow.delivered == 2","negatives":[{"scenario":"mail-two-keys","faults":["defect-keys-treated-alike"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-move-target-holds-every-write","kind":"invariant","models":"mig-570","faultBasis":"fault","statement":"The directory switches a moving tenant only when the target holds every write the source accepted, including the writes accepted while the copy ran. The comparison is computed from the writes each side holds.","evaluate":{"method":"state-invariant","scenarios":["move-completes","move-with-concurrent-write","move-write-in-flight","move-concurrent-write-early-switch"],"expr":"!tenant-move-flow.switched || tenant-move-flow.targetVersion == tenant-move-flow.sourceVersion","negatives":[{"scenario":"move-concurrent-write-early-switch","faults":["reconcile-disabled","defect-move-switch-unverified"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction","a-database-commit"]},
    {"id":"m-move-with-writes-completes","kind":"temporal","models":"mig-570","faultBasis":"fault","statement":"A move during which a writer wrote reaches its target placement only because the source is frozen and the missed writes are applied: without the final synchronisation, or without the freeze, the hashes differ or are never compared, and the directory does not switch.","evaluate":{"method":"eventually","scenarios":["move-with-concurrent-write","move-write-in-flight"],"occurs":{"event":"tm-directory-switched"},"negatives":[{"scenario":"move-with-concurrent-write","faults":["reconcile-disabled"]},{"scenario":"move-with-concurrent-write","faults":["freeze-disabled"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction","a-database-commit"]},
    {"id":"m-tenant-move-flow-refined","kind":"temporal","models":"mig-570","statement":"The implementation machine of Tenant move refines its model: every step it takes is a step the model takes from the mapped state, or a step the model does not see.","evaluate":{"method":"refines","behavior":"tenant-move-flow-impl"},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"restatement"},
    {"id":"m-source-throttled-across-accounts","kind":"invariant","models":"idn-250","faultBasis":"fault","statement":"Once the failures from one source reach the threshold, no attempt from that source is evaluated, whichever account it names. The threshold of 3 stands for the 100 failures of D-700 and the window is not modelled.","evaluate":{"method":"state-invariant","scenarios":["password-spray-one-source"],"expr":"source-throttle-flow.evaluatedWhileThrottled == 0","negatives":[{"scenario":"password-spray-one-source","faults":["defect-source-throttle-ignored"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-throttle-isolates-sources","kind":"temporal","models":"idn-250","faultBasis":"restatement","statement":"A source that has not reached the threshold is still answered while another source is throttled.","evaluate":{"method":"eventually","scenarios":["password-spray-one-source"],"occurs":{"event":"src-accepted"},"negatives":[{"scenario":"password-spray-one-source","faults":["source-acceptance-disabled"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"]},
    {"id":"m-source-throttle-flow-refined","kind":"temporal","models":"idn-250","statement":"The implementation machine of Per-source sign-in throttle refines its model: every step it takes is a step the model takes from the mapped state, or a step the model does not see.","evaluate":{"method":"refines","behavior":"source-throttle-flow-impl"},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"restatement"},
    {"id":"m-client-session-flow-refined","kind":"temporal","statement":"The session of the web application, with its request token dropped at the moment a session frame ends it, refines the client session model.","evaluate":{"method":"refines","behavior":"client-session-flow-impl","scenarios":["session-ends-and-person-signs-in-again-impl"]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"models":"uxa-211"},
    {"id":"m-client-live-flow-refined","kind":"temporal","statement":"The live connection of the web application, with its heartbeat timer and its back-off timers, refines the live connection model.","evaluate":{"method":"refines","behavior":"client-live-flow-impl","scenarios":["live-catch-up-after-reconnect-impl","live-silent-server-impl","live-backoff-step-1-impl","live-backoff-step-2-impl","live-backoff-step-3-impl","live-backoff-step-4-impl","live-backoff-step-5-impl","live-backoff-cap-impl","live-backoff-reset-impl"]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"models":"run-006"},
    {"id":"m-client-submit-flow-refined","kind":"temporal","statement":"The submission of a form in the web application refines the form submission model.","evaluate":{"method":"refines","behavior":"client-submit-flow-impl","scenarios":["submit-refused-then-accepted-impl"]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"models":"uxa-201"},
    {
      "id": "m-job-offered-not-before-due",
      "kind": "invariant",
      "models": "sch-001",
      "statement": "A job is offered to a worker only when the time of the poll is no earlier than its due time.",
      "evaluate": {
        "method": "state-invariant",
        "scenarios": [
          "job-run-poll-before-due",
          "job-run-attempts-exhausted"
        ],
        "expr": "job-run-flow.state != 'jr-leased' || job-run-flow.offeredAt >= job-run-flow.dueAt",
        "negatives": [
          {
            "scenario": "job-run-poll-before-due",
            "faults": [
              "defect-job-offered-early"
            ]
          }
        ]
      },
      "faultModel": "fault-model-launch",
      "assumptions": [
        "a-model-abstraction"
      ],
      "faultBasis": "restatement"
    },
    {
      "id": "m-cancelled-job-takes-no-attempt",
      "kind": "invariant",
      "models": "sch-006",
      "statement": "After a job is cancelled its number of attempts never changes, in a retry that was already scheduled or in a later poll.",
      "evaluate": {
        "method": "state-invariant",
        "scenarios": [
          "job-run-cancelled-in-backoff",
          "job-run-cancelled-while-leased"
        ],
        "expr": "job-run-flow.cancelled == false || job-run-flow.attempts == job-run-flow.attemptsAtCancel",
        "negatives": [
          {
            "scenario": "job-run-cancelled-in-backoff",
            "faults": [
              "defect-cancelled-job-offered"
            ]
          },
          {
            "scenario": "job-run-cancelled-while-leased",
            "faults": [
              "defect-cancelled-job-offered"
            ]
          }
        ]
      },
      "faultModel": "fault-model-launch",
      "assumptions": [
        "a-model-abstraction"
      ],
      "faultBasis": "restatement"
    },
    {
      "id": "m-retry-delay-grows",
      "kind": "invariant",
      "models": "sch-013",
      "statement": "Each retry of a failed job starts after a longer wait than the retry before it.",
      "evaluate": {
        "method": "state-invariant",
        "scenarios": [
          "job-run-attempts-exhausted"
        ],
        "expr": "job-run-flow.attempts < 3 || job-run-flow.gap > job-run-flow.prevGap",
        "negatives": [
          {
            "scenario": "job-run-attempts-exhausted",
            "faults": [
              "defect-retry-delay-not-growing"
            ]
          }
        ]
      },
      "faultModel": "fault-model-launch",
      "assumptions": [
        "a-model-abstraction"
      ],
      "faultBasis": "restatement"
    },
    {
      "id": "m-exhausted-job-records-every-error",
      "kind": "invariant",
      "models": "sch-014",
      "statement": "A job recorded as failed holds an error for each of its attempts.",
      "evaluate": {
        "method": "state-invariant",
        "scenarios": [
          "job-run-attempts-exhausted"
        ],
        "expr": "job-run-flow.state != 'jr-failed' || job-run-flow.errors == job-run-flow.attempts",
        "negatives": [
          {
            "scenario": "job-run-attempts-exhausted",
            "faults": [
              "defect-exhausted-error-unrecorded"
            ]
          }
        ]
      },
      "faultModel": "fault-model-launch",
      "assumptions": [
        "a-model-abstraction"
      ],
      "faultBasis": "restatement"
    },
    {
      "id": "m-exhausted-job-is-failed",
      "kind": "temporal",
      "models": "sch-014",
      "statement": "A job whose attempts all fail is recorded as failed.",
      "evaluate": {
        "method": "eventually",
        "scenarios": [
          "job-run-attempts-exhausted"
        ],
        "occurs": {
          "event": "jr-job-failed"
        },
        "negatives": [
          {
            "scenario": "job-run-attempts-exhausted",
            "faults": [
              "exhaustion-disabled"
            ]
          }
        ]
      },
      "faultModel": "fault-model-launch",
      "assumptions": [
        "a-model-abstraction"
      ],
      "faultBasis": "restatement"
    },
    {
      "id": "m-job-run-flow-refined",
      "kind": "temporal",
      "models": "sch-013",
      "statement": "The implementation machine of Job run refines its model: every step it takes is a step the model takes from the mapped state, or a step the model does not see.",
      "evaluate": {
        "method": "refines",
        "behavior": "job-run-flow-impl",
        "scenarios": [
          "job-run-poll-before-due-impl",
          "job-run-attempts-exhausted-impl",
          "job-run-cancelled-in-backoff-impl",
          "job-run-cancelled-while-leased-impl"
        ]
      },
      "faultModel": "fault-model-launch",
      "assumptions": [
        "a-model-abstraction"
      ],
      "faultBasis": "restatement"
    },
    {
      "id": "m-next-job-created-with-completion",
      "kind": "invariant",
      "models": "sch-003",
      "statement": "A schedule that is not paused always has an open job: the next job exists as soon as the current one is recorded as completed.",
      "evaluate": {
        "method": "state-invariant",
        "scenarios": [
          "schedule-job-completes",
          "schedule-paused-while-job-runs",
          "schedule-paused-and-resumed-before-completion"
        ],
        "expr": "schedule-flow.paused || schedule-flow.created > schedule-flow.completions",
        "negatives": [
          {
            "scenario": "schedule-job-completes",
            "faults": [
              "defect-recurrence-split"
            ]
          },
          {
            "scenario": "schedule-paused-and-resumed-before-completion",
            "faults": [
              "defect-recurrence-split"
            ]
          }
        ]
      },
      "faultModel": "fault-model-launch",
      "assumptions": [
        "a-model-abstraction"
      ],
      "faultBasis": "restatement"
    },
    {
      "id": "m-paused-schedule-creates-no-job",
      "kind": "invariant",
      "models": "sch-005",
      "statement": "While a schedule is paused no job is created, whether a job completes or the schedule is resumed.",
      "evaluate": {
        "method": "state-invariant",
        "scenarios": [
          "schedule-paused-while-job-runs",
          "schedule-paused-and-resumed-before-completion"
        ],
        "expr": "!schedule-flow.paused || schedule-flow.created == schedule-flow.createdAtPause",
        "negatives": [
          {
            "scenario": "schedule-paused-while-job-runs",
            "faults": [
              "defect-paused-schedule-creates-job"
            ]
          }
        ]
      },
      "faultModel": "fault-model-launch",
      "assumptions": [
        "a-model-abstraction"
      ],
      "faultBasis": "restatement"
    },
    {
      "id": "m-schedule-flow-refined",
      "kind": "temporal",
      "models": "sch-003",
      "statement": "The implementation machine of Recurring schedule refines its model: every step it takes is a step the model takes from the mapped state, or a step the model does not see.",
      "evaluate": {
        "method": "refines",
        "behavior": "schedule-flow-impl",
        "scenarios": [
          "schedule-job-completes-impl",
          "schedule-paused-while-job-runs-impl",
          "schedule-paused-and-resumed-before-completion-impl"
        ]
      },
      "faultModel": "fault-model-launch",
      "assumptions": [
        "a-model-abstraction"
      ],
      "faultBasis": "restatement"
    },
    {
      "id": "m-trigger-jobs-with-commit",
      "kind": "invariant",
      "models": "sch-004",
      "statement": "The jobs of the subscribed triggers exist exactly for the events that committed: a commit creates them in the same step and a rolled back event creates none.",
      "evaluate": {
        "method": "state-invariant",
        "scenarios": [
          "trigger-commit-event-committed",
          "trigger-commit-event-rolled-back"
        ],
        "expr": "trigger-commit-flow.jobs == trigger-commit-flow.committed * trigger-commit-flow.subscribers",
        "negatives": [
          {
            "scenario": "trigger-commit-event-committed",
            "faults": [
              "defect-trigger-jobs-after-commit"
            ]
          },
          {
            "scenario": "trigger-commit-event-rolled-back",
            "faults": [
              "defect-trigger-jobs-before-commit"
            ]
          }
        ]
      },
      "faultModel": "fault-model-launch",
      "assumptions": [
        "a-model-abstraction"
      ],
      "faultBasis": "restatement"
    },
    {
      "id": "m-trigger-jobs-created",
      "kind": "temporal",
      "models": "sch-004",
      "statement": "A committed event creates the jobs of its triggers.",
      "evaluate": {
        "method": "eventually",
        "scenarios": [
          "trigger-commit-event-committed"
        ],
        "occurs": {
          "event": "tg-jobs-created"
        },
        "negatives": [
          {
            "scenario": "trigger-commit-event-committed",
            "faults": [
              "trigger-commit-disabled"
            ]
          }
        ]
      },
      "faultModel": "fault-model-launch",
      "assumptions": [
        "a-model-abstraction"
      ],
      "faultBasis": "restatement"
    },
    {
      "id": "m-trigger-commit-flow-refined",
      "kind": "temporal",
      "models": "sch-004",
      "statement": "The implementation machine of Trigger jobs of a committed event refines its model: every step it takes is a step the model takes from the mapped state, or a step the model does not see.",
      "evaluate": {
        "method": "refines",
        "behavior": "trigger-commit-flow-impl",
        "scenarios": [
          "trigger-commit-event-committed-impl",
          "trigger-commit-event-rolled-back-impl"
        ]
      },
      "faultModel": "fault-model-launch",
      "assumptions": [
        "a-model-abstraction"
      ],
      "faultBasis": "restatement"
    },
    {
      "id": "m-no-lease-without-database",
      "kind": "temporal",
      "models": "sch-301",
      "statement": "A worker that cannot reach the tenant database of a job takes no lease on it.",
      "evaluate": {
        "method": "never",
        "scenarios": [
          "lease-reach-lease-while-cut-off"
        ],
        "occurs": {
          "event": "lr-lease-granted"
        },
        "negatives": [
          {
            "scenario": "lease-reach-lease-while-cut-off",
            "faults": [
              "defect-lease-without-database"
            ]
          }
        ]
      },
      "faultModel": "fault-model-launch",
      "assumptions": [
        "a-model-abstraction"
      ],
