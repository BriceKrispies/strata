    {
      "id": "change-schema",
      "description": "transition.rs change_schema: Manage on Schema is authorised; a stale expected version is SchemaConflict; no changes is InvalidIntent; then plan-migration, whose refusal keeps its kind, message and missing need with the draft's evidence before its own. The change's lines pass as schema:change, and every violation is a failed check existing:<object>/<id>:<rule>; in Reject mode any record that would not conform refuses the change with MigrationRejected (\"<n> existing record(s) ...\"), in Grandfather mode it is accepted: the new schema, the rewritten records and a SchemaChanged event counting the records that do not conform.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "changes",
          "type": "list<schema-change>"
        },
        {
          "name": "expected-version",
          "type": "option<schema-version>"
        },
        {
          "name": "existing",
          "type": "existing-data"
        },
        {
          "name": "texts",
          "type": "intent-texts"
        }
      ],
      "returns": "decided",
      "errors": "rejection",
      "let": [
        {
          "name": "d1",
          "expr": "try call require(d, action.manage, resource.schema, subject{}, texts)"
        },
        {
          "name": "current",
          "expr": "d1.tenant.schema.version"
        },
        {
          "name": "stale",
          "expr": "match expected-version { Some(e) => e != current, None => false }"
        }
      ],
      "body": "if stale then fail(call draft-reject(d1.evidence, error-kind.schema-conflict, format('schema is at version {}, expected {}', current, match expected-version { Some(e) => e, None => 0 }))) else if changes == [] then fail(call draft-reject(d1.evidence, error-kind.invalid-intent, 'no changes given')) else let plan = match call plan-migration(d1.tenant, d1.coverage, changes, d1.ctx.now, texts) { Ok(m) => m, Err(e) => match e { rejected(err) => fail(rejection.rejected(domain-error{kind: err.kind, message: err.message, evidence: concat(d1.evidence, err.evidence), missing: err.missing})) } } in let affected = fold(a in call set-of(map(x in plan.violations, format('{}/{}', x.object, x.id))), n = 0, n + 1) in let evidence = concat(concat(d1.evidence, map(l in plan.summary, check{rule: 'schema:change', passed: true, detail: l})), map(x in plan.violations, check{rule: format('existing:{}/{}:{}', x.object, x.id, x.check.rule), passed: false, detail: x.check.detail})) in if existing == existing-data.reject && affected > 0 then fail(call draft-reject(evidence, error-kind.migration-rejected, format('{} existing record(s) would not conform to the new schema', affected))) else decided{draft: draft{tenant: d1.tenant, ctx: d1.ctx, coverage: d1.coverage, ops: concat(concat(d1.ops, [delta-op.put-schema(plan.schema)]), map(r in plan.rewritten, delta-op.put-record(r))), events: concat(d1.events, [event-body.schema-changed{version: plan.schema.version, summary: plan.summary, grandfathered: affected}]), effects: d1.effects, evidence: evidence, next-record: d1.next-record}, output: output.schema{version: plan.schema.version}}",
      "examples": [
        {
