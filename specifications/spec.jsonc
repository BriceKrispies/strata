    {
      "id": "team-member",
      "description": "transition.rs team_member: add a principal to a team or remove it. Authorised as Manage on Members; every role of the team must be one the principal may confer, whether adding or removing (require-conferrable), and a removal must leave the tenant an owner, counting the owners through teams (owner-lost). A removed member gets its own event with the roles it keeps, and its sessions are revoked when it keeps none.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "team",
          "type": "team-id"
        },
        {
          "name": "principal",
          "type": "principal-id"
        },
        {
          "name": "add",
          "type": "bool"
        }
      ],
      "returns": "decided",
      "errors": "rejection",
      "let": [
        {
          "name": "d1",
          "expr": "try call require(d, action.manage, resource.members, subject{})"
        },
        {
          "name": "def0",
          "expr": "try call team-of(d1, team)"
        },
        {
          "name": "d2",
          "expr": "try call require-conferrable(d1, def0.roles)"
        },
        {
          "name": "def",
          "expr": "team-def{id: def0.id, label: def0.label, members: if add then call principal-set-of(concat(def0.members, [principal])) else filter(m in def0.members, m != principal), roles: def0.roles}"
        },
        {
          "name": "roles",
          "expr": "call assigned-roles(d2.tenant.members, call schema-with-team(d2.tenant.schema, def), principal)"
        }
      ],
      "body": "if !add && call owner-lost(d2.tenant.members, d2.tenant.schema, d2.tenant.members, call schema-with-team(d2.tenant.schema, def)) then fail(call draft-reject(d2.evidence, error-kind.invalid-intent, 'a tenant keeps at least one owner')) else decided{draft: call put-team(draft{tenant: d2.tenant, ctx: d2.ctx, coverage: d2.coverage, ops: d2.ops, events: if add then d2.events else concat(d2.events, [event-body.member-changed{principal, roles}]), effects: if !add && roles == [] then concat(d2.effects, [effect.revoke-sessions{principal}]) else d2.effects, evidence: d2.evidence, next-record: d2.next-record}, d2.tenant.schema, def), output: output.member}",
