                    "label": "Everyone"
                  }
                },
                "policies": {},
                "workflows": {},
                "queries": {},
                "views": {}
              },
              "members": {
                "alpha:editor": [
                  "editor"
                ],
                "alpha:writer1": [
                  "writer"
                ],
                "alpha:writer2": [
                  "writer"
                ],
                "alpha:stranger": [
                  "guest"
                ]
              },
              "records": {
                "person": {
                  "1": {
                    "id": 1,
                    "object": "person",
                    "version": 1,
                    "created-by": "alpha:editor",
                    "created-at": 1001,
                    "updated-at": 1001,
                    "fields": {
