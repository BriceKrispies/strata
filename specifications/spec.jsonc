      "id": "query-problems",
      "description": "schema.rs TenantSchema::problems, one query: an unknown object type (nothing else is checked), a filter that does not check against the fields and the query's parameters, and each order key read as record.<field> that does not check.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "roles",
          "type": "list<role-id>"
        },
        {
          "name": "query",
          "type": "query-def"
        }
      ],
      "returns": "list<string>",
      "let": [
        {
          "name": "at",
          "expr": "format('query {}', query.id)"
        }
      ],
      "body": "match get(schema.objects, query.object) { None => [format('{}: unknown object type {}', at, query.object)], Some(o) => let env = expr-check-env{fields: call field-shapes(o.fields), params: query.params, roles} in concat(match query.filter { Some(fl) => match check(tenant-rule-language, fl, env) { Ok(_) => [], Err(e) => [format('{}: filter: {}', at, e)] }, None => [] }, fold(k in query.order, ps = [], match check(tenant-rule-language, expr.var{scope: scope.record, field: k.field}, env) { Ok(_) => ps, Err(e) => concat(ps, [format('{}: order: {}', at, e)]) })) }",
