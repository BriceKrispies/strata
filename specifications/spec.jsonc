                  "check": {
                    "rule": "required:note.title",
                    "passed": false,
                    "detail": "a value is required"
                  },
                  "kind": "missing-required"
                },
                {
                  "check": {
                    "rule": "type:note.rank",
                    "passed": false,
                    "detail": "expected int, found string"
                  },
                  "kind": "type-mismatch"
                }
              ]
            },
            "evidence": []
          },
          "error": {
            "rejected": {
              "kind": "missing-required",
              "message": "required:note.title: a value is required",
              "evidence": [
                {
                  "rule": "required:note.slug",
                  "passed": true,
                  "detail": "present"
                },
                {
                  "rule": "required:note.title",
                  "passed": false,
                  "detail": "a value is required"
                },
                {
                  "rule": "type:note.rank",
                  "passed": false,
                  "detail": "expected int, found string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "error-kind-snake",
      "description": "transition.rs snake_case of an ErrorKind's Debug name.",
      "params": [
        {
          "name": "kind",
          "type": "error-kind"
        }
      ],
      "returns": "string",
      "body": "match kind { tenant-mismatch => 'tenant_mismatch', tenant-exists => 'tenant_exists', tenant-not-found => 'tenant_not_found', unauthorized => 'unauthorized', unknown-object => 'unknown_object', unknown-field => 'unknown_field', unknown-record => 'unknown_record', unknown-role => 'unknown_role', unknown-query => 'unknown_query', type-mismatch => 'type_mismatch', missing-required => 'missing_required', constraint-violated => 'constraint_violated', unique-violated => 'unique_violated', dangling-reference => 'dangling_reference', still-referenced => 'still_referenced', workflow-violation => 'workflow_violation', version-conflict => 'version_conflict', schema-conflict => 'schema_conflict', invalid-schema => 'invalid_schema', migration-rejected => 'migration_rejected', insufficient-state => 'insufficient_state', evaluation => 'evaluation', invalid-intent => 'invalid_intent', limit-exceeded => 'limit_exceeded', idempotency-mismatch => 'idempotency_mismatch' }",
