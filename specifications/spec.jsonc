        "transitions": {
          "rg-place-i": "rg-place",
          "rg-refuse-i": "rg-refuse"
        }
      },
      "storage": {
        "record": "rec-placement-choice",
        "key": "tenant-id",
        "creates": true
      },
      "instances": {
        "key": "tenant-id",
        "storedIn": "rec-placement-choice",
        "max": 16
      }
    },
    {
      "id": "tenant-deletion-flow",
      "name": "Tenant deletion",
      "subject": "control-plane",
      "initial": "td-live",
      "description": "Deleting a tenant removes its database, then its stored files, then destroys its encryption key. The tenant is reported deleted only after all three; a step that fails leaves the tenant undeleted.",
      "variables": [
        {
          "name": "database",
          "type": "boolean",
          "initial": true
        },
        {
          "name": "files",
          "type": "boolean",
          "initial": true
        },
        {
          "name": "key",
          "type": "boolean",
          "initial": true
        },
        {
          "name": "deleted",
          "type": "boolean",
          "initial": false
        }
      ],
      "states": [
        {
          "id": "td-live",
          "name": "Live"
        },
        {
          "id": "td-removing-database",
          "name": "Removing the database"
        },
        {
          "id": "td-removing-files",
          "name": "Removing the files"
        },
        {
          "id": "td-destroying-key",
          "name": "Destroying the key"
        },
        {
          "id": "td-deleted",
          "name": "Deleted",
          "terminal": true
        },
        {
          "id": "td-retained",
          "name": "Deletion stopped",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "td-skip-key",
          "from": "td-removing-files",
          "to": "td-deleted",
          "on": "td-files-removed",
          "effects": [
            {
              "set": "files",
              "to": false
            },
            {
              "set": "deleted",
              "to": true
            },
            {
              "emit": "td-tenant-deleted"
            }
          ],
          "faultOnly": true,
          "description": "Defect: reports the tenant deleted before its key is destroyed."
        },
        {
          "id": "td-delete-early",
          "from": "td-removing-database",
          "to": "td-deleted",
          "on": "td-database-removed",
          "effects": [
            {
              "set": "database",
              "to": false
            },
            {
              "set": "deleted",
              "to": true
            },
            {
              "emit": "td-tenant-deleted"
            }
          ],
          "faultOnly": true,
          "description": "Defect: reports the tenant deleted as soon as its database is gone."
        },
        {
          "id": "td-begin",
          "from": "td-live",
          "to": "td-removing-database",
          "on": "td-delete-requested",
          "effects": []
        },
        {
          "id": "td-database-gone",
          "from": "td-removing-database",
          "to": "td-removing-files",
          "on": "td-database-removed",
          "effects": [
            {
              "set": "database",
              "to": false
            }
          ]
        },
        {
          "id": "td-files-gone",
          "from": "td-removing-files",
          "to": "td-destroying-key",
          "on": "td-files-removed",
          "effects": [
            {
              "set": "files",
              "to": false
            }
          ]
        },
        {
          "id": "td-key-gone",
          "from": "td-destroying-key",
          "to": "td-deleted",
          "on": "td-key-destroyed",
          "effects": [
            {
              "set": "key",
              "to": false
            },
            {
              "set": "deleted",
              "to": true
            },
            {
              "emit": "td-tenant-deleted"
            }
          ]
        },
        {
          "id": "td-fail-database",
          "from": "td-removing-database",
          "to": "td-retained",
          "on": "td-step-failed",
          "effects": [
            {
              "emit": "td-deletion-failed"
            }
          ]
        },
        {
          "id": "td-fail-files",
          "from": "td-removing-files",
          "to": "td-retained",
          "on": "td-step-failed",
          "effects": [
            {
              "emit": "td-deletion-failed"
            }
          ]
        },
        {
          "id": "td-fail-key",
          "from": "td-destroying-key",
          "to": "td-retained",
          "on": "td-step-failed",
          "effects": [
            {
              "emit": "td-deletion-failed"
            }
          ]
        }
      ]
    },
    {
      "id": "tenant-deletion-flow-impl",
      "name": "Tenant deletion (implementation)",
      "level": "implementation",
      "subject": "control-plane",
      "refines": "tenant-deletion-flow",
      "description": "Deleting a tenant removes its database, then its stored files, then destroys its encryption key. The tenant is reported deleted only after all three; a step that fails leaves the tenant undeleted.",
      "initial": "td-live-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "database",
          "type": "boolean",
          "initial": true,
          "repr": "bool"
        },
        {
          "name": "files",
          "type": "boolean",
          "initial": true,
          "repr": "bool"
        },
        {
          "name": "key",
          "type": "boolean",
          "initial": true,
          "repr": "bool"
        },
        {
          "name": "deleted",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        }
      ],
      "states": [
        {
          "id": "td-live-i",
          "name": "Live",
          "ignores": [
            "td-database-removed",
            "td-files-removed",
            "td-key-destroyed",
            "td-step-failed"
          ]
        },
        {
          "id": "td-removing-database-i",
          "name": "Removing the database",
          "ignores": [
            "td-delete-requested",
            "td-files-removed",
            "td-key-destroyed"
          ]
        },
        {
          "id": "td-removing-files-i",
          "name": "Removing the files",
          "ignores": [
            "td-delete-requested",
            "td-database-removed",
            "td-key-destroyed"
          ]
        },
        {
          "id": "td-destroying-key-i",
          "name": "Destroying the key",
          "ignores": [
            "td-delete-requested",
            "td-database-removed",
            "td-files-removed"
          ]
        },
        {
          "id": "td-deleted-i",
          "name": "Deleted",
          "terminal": true
        },
        {
          "id": "td-retained-i",
          "name": "Deletion stopped",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "td-begin-i",
          "from": "td-live-i",
          "to": "td-removing-database-i",
          "on": "td-delete-requested",
          "otherwise": true,
          "effects": []
        },
        {
          "id": "td-database-gone-i",
          "from": "td-removing-database-i",
          "to": "td-removing-files-i",
          "on": "td-database-removed",
          "otherwise": true,
          "effects": [
            {
              "set": "database",
              "to": false
            }
          ]
        },
        {
          "id": "td-files-gone-i",
          "from": "td-removing-files-i",
          "to": "td-destroying-key-i",
          "on": "td-files-removed",
          "otherwise": true,
          "effects": [
            {
              "set": "files",
              "to": false
            }
          ]
        },
        {
          "id": "td-key-gone-i",
          "from": "td-destroying-key-i",
          "to": "td-deleted-i",
          "on": "td-key-destroyed",
          "otherwise": true,
          "effects": [
            {
              "set": "key",
              "to": false
            },
            {
              "set": "deleted",
              "to": true
            },
            {
              "emit": "td-tenant-deleted",
              "to": "operator-console"
            }
          ]
        },
        {
          "id": "td-fail-database-i",
          "from": "td-removing-database-i",
          "to": "td-retained-i",
          "on": "td-step-failed",
          "otherwise": true,
          "effects": [
            {
              "emit": "td-deletion-failed",
              "to": "operator-console"
            }
          ]
        },
        {
          "id": "td-fail-files-i",
          "from": "td-removing-files-i",
          "to": "td-retained-i",
          "on": "td-step-failed",
          "otherwise": true,
          "effects": [
            {
              "emit": "td-deletion-failed",
              "to": "operator-console"
            }
          ]
        },
        {
          "id": "td-fail-key-i",
          "from": "td-destroying-key-i",
          "to": "td-retained-i",
          "on": "td-step-failed",
          "otherwise": true,
          "effects": [
            {
              "emit": "td-deletion-failed",
              "to": "operator-console"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "td-live-i": "td-live",
          "td-removing-database-i": "td-removing-database",
          "td-removing-files-i": "td-removing-files",
          "td-destroying-key-i": "td-destroying-key",
          "td-deleted-i": "td-deleted",
          "td-retained-i": "td-retained"
        },
        "variables": {
          "database": "database",
          "files": "files",
          "key": "key",
          "deleted": "deleted"
        },
        "transitions": {
          "td-begin-i": "td-begin",
          "td-database-gone-i": "td-database-gone",
          "td-files-gone-i": "td-files-gone",
          "td-key-gone-i": "td-key-gone",
          "td-fail-database-i": "td-fail-database",
          "td-fail-files-i": "td-fail-files",
          "td-fail-key-i": "td-fail-key"
        }
      },
      "storage": {
        "record": "rec-tenant-deletion",
        "key": "tenant-id",
        "creates": true
      },
      "instances": {
        "key": "tenant-id",
        "storedIn": "rec-tenant-deletion",
        "max": 16
      }
    },
    {
      "id": "backup-key-flow",
      "name": "Reading a backup",
      "subject": "backup-archive",
      "initial": "bk-open",
      "description": "The backup of tenant a. A read of it succeeds only with the key of tenant a; a key of any other tenant is refused.",
      "variables": [
        {
          "name": "backupOwner",
          "type": "string",
          "initial": "a"
        },
        {
          "name": "readsAccepted",
          "type": "number",
          "initial": 0
        },
        {
          "name": "lastReadKeyOwner",
          "type": "string",
          "initial": ""
        }
      ],
      "states": [
        {
          "id": "bk-open",
          "name": "Backup held"
        }
      ],
      "transitions": [
        {
          "id": "bk-read-any-key",
          "from": "bk-open",
          "to": "bk-open",
          "on": "bk-read-requested",
          "effects": [
            {
              "set": "readsAccepted",
              "to": "readsAccepted + 1"
            },
            {
              "set": "lastReadKeyOwner",
              "to": "event.keyOwner"
            },
            {
              "emit": "bk-read-accepted"
            }
          ],
          "faultOnly": true,
          "description": "Defect: opens the backup with the key of any tenant."
        },
        {
          "id": "bk-read",
          "from": "bk-open",
          "to": "bk-open",
          "on": "bk-read-requested",
          "guard": "event.keyOwner == backupOwner",
          "effects": [
            {
              "set": "readsAccepted",
              "to": "readsAccepted + 1"
            },
            {
              "set": "lastReadKeyOwner",
              "to": "event.keyOwner"
            },
            {
              "emit": "bk-read-accepted"
            }
          ]
        },
        {
          "id": "bk-read-foreign-key",
          "from": "bk-open",
          "to": "bk-open",
          "on": "bk-read-requested",
          "guard": "event.keyOwner != backupOwner",
          "effects": [
            {
              "emit": "bk-read-refused"
            }
          ]
        }
      ]
    },
    {
      "id": "backup-key-flow-impl",
      "name": "Reading a backup (implementation)",
      "level": "implementation",
      "subject": "backup-archive",
      "refines": "backup-key-flow",
      "description": "The backup of tenant a. A read of it succeeds only with the key of tenant a; a key of any other tenant is refused.",
      "initial": "bk-open-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "backupOwner",
          "type": "string",
          "initial": "a",
          "repr": "string"
        },
        {
          "name": "readsAccepted",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "lastReadKeyOwner",
          "type": "string",
          "initial": "",
          "repr": "string"
        }
      ],
      "states": [
        {
          "id": "bk-open-i",
          "name": "Backup held"
        }
      ],
      "transitions": [
        {
          "id": "bk-read-i",
          "from": "bk-open-i",
          "to": "bk-open-i",
          "on": "bk-read-requested",
          "guard": "event.keyOwner == backupOwner",
          "effects": [
            {
              "set": "readsAccepted",
              "to": "readsAccepted + 1"
            },
            {
              "set": "lastReadKeyOwner",
              "to": "event.keyOwner"
            },
            {
              "emit": "bk-read-accepted",
              "to": "operator-console"
            }
          ]
        },
        {
          "id": "bk-read-foreign-key-i",
          "from": "bk-open-i",
          "to": "bk-open-i",
          "on": "bk-read-requested",
          "guard": "event.keyOwner != backupOwner",
          "effects": [
            {
              "emit": "bk-read-refused",
              "to": "operator-console"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "bk-open-i": "bk-open"
        },
        "variables": {
          "backupOwner": "backupOwner",
          "readsAccepted": "readsAccepted",
          "lastReadKeyOwner": "lastReadKeyOwner"
        },
        "transitions": {
          "bk-read-i": "bk-read",
          "bk-read-foreign-key-i": "bk-read-foreign-key"
        }
      },
      "storage": {
        "record": "rec-backup-key",
        "key": "tenant-id",
        "creates": true
      },
      "instances": {
        "key": "tenant-id",
        "storedIn": "rec-backup-key",
        "max": 16
      }
    },
    {
      "id": "runtime-credential-flow",
      "name": "Runtime database credentials",
      "subject": "runtime",
      "initial": "rc-running",
      "description": "One runtime instance. It holds the database credential of a placement only while it serves that placement: the credential is issued when it starts serving and ends when it stops. A request to open a database without a credential for that placement is refused.",
      "variables": [
        {
          "name": "servedPlacement",
          "type": "string",
          "initial": ""
        },
        {
          "name": "credentialFor",
          "type": "string",
          "initial": ""
        }
      ],
      "states": [
        {
          "id": "rc-running",
          "name": "Running"
        }
      ],
      "transitions": [
        {
          "id": "rc-keep-credential-after-stop",
          "from": "rc-running",
          "to": "rc-running",
          "on": "rc-stop-serving",
          "effects": [
            {
              "set": "servedPlacement",
              "to": "''"
            }
          ],
          "faultOnly": true,
          "description": "Defect: keeps the credential after the instance stops serving."
        },
        {
          "id": "rc-credential-for-other",
          "from": "rc-running",
          "to": "rc-running",
          "on": "rc-serve-requested",
          "effects": [
            {
              "set": "servedPlacement",
              "to": "event.placement"
            },
            {
              "set": "credentialFor",
              "to": "'p0'"
            }
          ],
          "faultOnly": true,
          "description": "Defect: issues the credential of another placement."
        },
        {
          "id": "rc-open-unserved",
          "from": "rc-running",
          "to": "rc-running",
          "on": "rc-open-requested",
          "guard": "credentialFor == ''",
          "effects": [
            {
              "emit": "rc-database-opened"
            }
          ],
          "faultOnly": true,
          "description": "Defect: opens a database without a credential."
        },
        {
          "id": "rc-serve",
          "from": "rc-running",
          "to": "rc-running",
          "on": "rc-serve-requested",
          "effects": [
            {
              "set": "servedPlacement",
              "to": "event.placement"
            },
            {
              "set": "credentialFor",
              "to": "event.placement"
            }
          ]
        },
        {
          "id": "rc-stop",
          "from": "rc-running",
          "to": "rc-running",
          "on": "rc-stop-serving",
          "effects": [
            {
              "set": "servedPlacement",
              "to": "''"
            },
            {
              "set": "credentialFor",
              "to": "''"
            }
          ]
        },
        {
          "id": "rc-open",
          "from": "rc-running",
          "to": "rc-running",
          "on": "rc-open-requested",
          "guard": "credentialFor != '' && event.placement == credentialFor",
          "effects": [
            {
              "emit": "rc-database-opened"
            }
          ]
        },
        {
          "id": "rc-open-refused-no-credential",
          "from": "rc-running",
          "to": "rc-running",
          "on": "rc-open-requested",
          "guard": "credentialFor == '' || event.placement != credentialFor",
          "effects": [
            {
              "emit": "rc-open-refused"
            }
          ]
        }
      ]
    },
    {
      "id": "runtime-credential-flow-impl",
      "name": "Runtime database credentials (implementation)",
      "level": "implementation",
      "subject": "runtime",
      "refines": "runtime-credential-flow",
      "description": "One runtime instance. It holds the database credential of a placement only while it serves that placement: the credential is issued when it starts serving and ends when it stops. A request to open a database without a credential for that placement is refused.",
      "initial": "rc-running-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "servedPlacement",
          "type": "string",
          "initial": "",
          "repr": "string"
        },
        {
          "name": "credentialFor",
          "type": "string",
          "initial": "",
          "repr": "string"
        }
      ],
      "states": [
        {
          "id": "rc-running-i",
          "name": "Running"
        }
      ],
      "transitions": [
        {
          "id": "rc-serve-i",
          "from": "rc-running-i",
          "to": "rc-running-i",
          "on": "rc-serve-requested",
          "otherwise": true,
          "effects": [
            {
              "set": "servedPlacement",
              "to": "event.placement"
            },
            {
              "set": "credentialFor",
              "to": "event.placement"
            }
          ]
        },
        {
          "id": "rc-stop-i",
          "from": "rc-running-i",
          "to": "rc-running-i",
          "on": "rc-stop-serving",
          "otherwise": true,
          "effects": [
            {
              "set": "servedPlacement",
              "to": "''"
            },
            {
              "set": "credentialFor",
              "to": "''"
            }
          ]
        },
        {
          "id": "rc-open-i",
          "from": "rc-running-i",
          "to": "rc-running-i",
          "on": "rc-open-requested",
          "guard": "credentialFor != '' && event.placement == credentialFor",
          "effects": [
            {
              "emit": "rc-database-opened",
              "to": "tenant-database"
            }
          ]
        },
        {
          "id": "rc-open-refused-no-credential-i",
          "from": "rc-running-i",
          "to": "rc-running-i",
          "on": "rc-open-requested",
          "guard": "credentialFor == '' || event.placement != credentialFor",
          "effects": [
            {
              "emit": "rc-open-refused",
              "to": "tenant-database"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "rc-running-i": "rc-running"
        },
        "variables": {
          "servedPlacement": "servedPlacement",
          "credentialFor": "credentialFor"
        },
        "transitions": {
          "rc-serve-i": "rc-serve",
          "rc-stop-i": "rc-stop",
          "rc-open-i": "rc-open",
          "rc-open-refused-no-credential-i": "rc-open-refused-no-credential"
        }
      },
      "storage": {
        "record": "rec-runtime-credential",
        "key": "tenant-id",
        "creates": true
      },
      "instances": {
        "key": "tenant-id",
        "storedIn": "rec-runtime-credential",
        "max": 16
      },
      "realisation": "target"
    },
    {
      "id": "export-restore-flow",
      "name": "Export and restore of a tenant",
      "subject": "control-plane",
      "initial": "er-live",
      "description": "A tenant is exported and the export is restored. As in the tenant move, the canonical hash of a state is modelled as the number of writes it holds. A restore is accepted only into an empty installation, and the restored state holds exactly the writes the export held.",
      "variables": [
        {
          "name": "version",
          "type": "number",
          "initial": 0
        },
        {
          "name": "exportedVersion",
          "type": "number",
          "initial": 0
        },
        {
          "name": "restoredVersion",
          "type": "number",
          "initial": 0
        },
        {
          "name": "restored",
          "type": "boolean",
          "initial": false
        }
      ],
      "states": [
        {
          "id": "er-live",
          "name": "Live"
        },
        {
          "id": "er-exported",
          "name": "Exported"
        },
        {
          "id": "er-restored",
          "name": "Restored",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "er-restore-drops-write",
          "from": "er-exported",
          "to": "er-restored",
          "on": "er-restore-requested",
          "guard": "event.empty",
          "effects": [
            {
              "set": "restoredVersion",
              "to": "exportedVersion - 1"
            },
            {
              "set": "restored",
              "to": true
            },
            {
              "emit": "er-tenant-restored"
            }
          ],
          "faultOnly": true,
          "description": "Defect: restores a state that lacks the last write of the export."
        },
        {
          "id": "er-restore-into-nonempty",
          "from": "er-exported",
          "to": "er-restored",
          "on": "er-restore-requested",
          "guard": "!event.empty",
          "effects": [
            {
              "set": "restoredVersion",
              "to": "exportedVersion"
            },
            {
              "set": "restored",
              "to": true
            },
            {
              "emit": "er-tenant-restored"
            }
          ],
          "faultOnly": true,
          "description": "Defect: restores into an installation that is not empty."
        },
        {
          "id": "er-write",
          "from": "er-live",
          "to": "er-live",
          "on": "er-write-requested",
          "effects": [
            {
              "set": "version",
              "to": "version + 1"
            }
          ]
        },
        {
          "id": "er-export",
          "from": "er-live",
          "to": "er-exported",
          "on": "er-export-requested",
          "effects": [
            {
              "set": "exportedVersion",
              "to": "version"
            }
          ]
        },
        {
          "id": "er-write-after-export",
          "from": "er-exported",
          "to": "er-exported",
          "on": "er-write-requested",
          "effects": [
            {
              "set": "version",
              "to": "version + 1"
            }
          ]
        },
        {
          "id": "er-restore",
          "from": "er-exported",
          "to": "er-restored",
          "on": "er-restore-requested",
          "guard": "event.empty",
          "effects": [
            {
              "set": "restoredVersion",
              "to": "exportedVersion"
            },
            {
              "set": "restored",
              "to": true
            },
            {
              "emit": "er-tenant-restored"
            }
          ]
        },
        {
          "id": "er-restore-refused-nonempty",
          "from": "er-exported",
          "to": "er-exported",
          "on": "er-restore-requested",
          "guard": "!event.empty",
          "effects": [
            {
              "emit": "er-restore-refused"
            }
          ]
        }
      ]
    },
    {
      "id": "export-restore-flow-impl",
      "name": "Export and restore of a tenant (implementation)",
      "level": "implementation",
      "subject": "control-plane",
      "refines": "export-restore-flow",
      "description": "A tenant is exported and the export is restored. As in the tenant move, the canonical hash of a state is modelled as the number of writes it holds. A restore is accepted only into an empty installation, and the restored state holds exactly the writes the export held.",
      "initial": "er-live-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "version",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "exportedVersion",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "restoredVersion",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "restored",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        }
      ],
      "states": [
        {
          "id": "er-live-i",
          "name": "Live",
          "ignores": [
            "er-restore-requested"
          ]
        },
        {
          "id": "er-exported-i",
          "name": "Exported",
          "ignores": [
            "er-export-requested"
          ]
        },
        {
          "id": "er-restored-i",
          "name": "Restored",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "er-write-i",
          "from": "er-live-i",
          "to": "er-live-i",
          "on": "er-write-requested",
          "otherwise": true,
          "effects": [
            {
              "set": "version",
              "to": "version + 1"
            }
          ]
        },
        {
          "id": "er-export-i",
          "from": "er-live-i",
          "to": "er-exported-i",
          "on": "er-export-requested",
          "otherwise": true,
          "effects": [
            {
              "set": "exportedVersion",
              "to": "version"
            }
          ]
        },
        {
          "id": "er-write-after-export-i",
          "from": "er-exported-i",
          "to": "er-exported-i",
          "on": "er-write-requested",
          "otherwise": true,
          "effects": [
            {
              "set": "version",
              "to": "version + 1"
            }
          ]
        },
        {
          "id": "er-restore-i",
          "from": "er-exported-i",
          "to": "er-restored-i",
          "on": "er-restore-requested",
          "guard": "event.empty",
          "effects": [
            {
              "set": "restoredVersion",
              "to": "exportedVersion"
            },
            {
              "set": "restored",
              "to": true
            },
            {
              "emit": "er-tenant-restored",
              "to": "operator-console"
            }
          ]
        },
        {
          "id": "er-restore-refused-nonempty-i",
          "from": "er-exported-i",
          "to": "er-exported-i",
          "on": "er-restore-requested",
          "guard": "!event.empty",
          "effects": [
            {
              "emit": "er-restore-refused",
              "to": "operator-console"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "er-live-i": "er-live",
          "er-exported-i": "er-exported",
          "er-restored-i": "er-restored"
        },
        "variables": {
          "version": "version",
          "exportedVersion": "exportedVersion",
          "restoredVersion": "restoredVersion",
          "restored": "restored"
        },
        "transitions": {
          "er-write-i": "er-write",
          "er-export-i": "er-export",
          "er-write-after-export-i": "er-write-after-export",
          "er-restore-i": "er-restore",
          "er-restore-refused-nonempty-i": "er-restore-refused-nonempty"
        }
      },
      "storage": {
        "record": "rec-export-restore",
        "key": "tenant-id",
        "creates": true
      },
      "instances": {
        "key": "tenant-id",
        "storedIn": "rec-export-restore",
        "max": 16
      }
    },
    {
      "id": "point-in-time-flow",
      "name": "Point-in-time restore",
      "subject": "control-plane",
      "initial": "pt-live",
      "description": "A tenant is restored to a point in time. The journal records the state hash at the point (modelled as the number of writes the state holds, as in the tenant move); the restored tenant holds the writes up to the point and none after it.",
      "variables": [
        {
          "name": "version",
          "type": "number",
          "initial": 0
        },
        {
          "name": "journalPoint",
          "type": "number",
          "initial": 0
        },
        {
          "name": "pointMarked",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "restoredTo",
          "type": "number",
          "initial": 0
        },
        {
          "name": "restored",
          "type": "boolean",
          "initial": false
        }
      ],
      "states": [
        {
          "id": "pt-live",
          "name": "Live"
        },
        {
          "id": "pt-restored",
          "name": "Restored",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "pt-restore-to-latest",
          "from": "pt-live",
          "to": "pt-restored",
          "on": "pt-restore-requested",
          "guard": "pointMarked",
          "effects": [
            {
              "set": "restoredTo",
              "to": "version"
            },
            {
              "set": "restored",
              "to": true
            },
            {
              "emit": "pt-tenant-restored"
            }
          ],
          "faultOnly": true,
          "description": "Defect: restores the latest state instead of the state of the point."
        },
        {
          "id": "pt-write",
          "from": "pt-live",
          "to": "pt-live",
          "on": "pt-write-requested",
          "effects": [
            {
              "set": "version",
              "to": "version + 1"
            }
          ]
        },
        {
          "id": "pt-point",
          "from": "pt-live",
          "to": "pt-live",
          "on": "pt-point-reached",
          "effects": [
            {
              "set": "journalPoint",
              "to": "version"
            },
            {
              "set": "pointMarked",
              "to": true
            }
          ]
        },
        {
          "id": "pt-restore",
          "from": "pt-live",
          "to": "pt-restored",
          "on": "pt-restore-requested",
          "guard": "pointMarked",
          "effects": [
            {
              "set": "restoredTo",
              "to": "journalPoint"
            },
            {
              "set": "restored",
              "to": true
            },
            {
              "emit": "pt-tenant-restored"
            }
          ]
        },
        {
          "id": "pt-restore-without-point",
          "from": "pt-live",
          "to": "pt-live",
          "on": "pt-restore-requested",
          "guard": "!pointMarked",
          "effects": [
            {
              "emit": "pt-restore-refused"
            }
          ]
        }
      ]
    },
    {
      "id": "point-in-time-flow-impl",
      "name": "Point-in-time restore (implementation)",
      "level": "implementation",
      "subject": "control-plane",
      "refines": "point-in-time-flow",
      "description": "A tenant is restored to a point in time. The journal records the state hash at the point (modelled as the number of writes the state holds, as in the tenant move); the restored tenant holds the writes up to the point and none after it.",
      "initial": "pt-live-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "version",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "journalPoint",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "pointMarked",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "restoredTo",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "restored",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        }
      ],
      "states": [
        {
          "id": "pt-live-i",
          "name": "Live"
        },
        {
          "id": "pt-restored-i",
          "name": "Restored",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "pt-write-i",
          "from": "pt-live-i",
          "to": "pt-live-i",
          "on": "pt-write-requested",
          "otherwise": true,
          "effects": [
            {
              "set": "version",
              "to": "version + 1"
            }
          ]
        },
        {
          "id": "pt-point-i",
          "from": "pt-live-i",
          "to": "pt-live-i",
          "on": "pt-point-reached",
          "otherwise": true,
          "effects": [
            {
              "set": "journalPoint",
              "to": "version"
            },
            {
              "set": "pointMarked",
              "to": true
            }
          ]
        },
        {
          "id": "pt-restore-i",
          "from": "pt-live-i",
          "to": "pt-restored-i",
          "on": "pt-restore-requested",
          "guard": "pointMarked",
          "effects": [
            {
              "set": "restoredTo",
              "to": "journalPoint"
            },
            {
              "set": "restored",
              "to": true
            },
            {
              "emit": "pt-tenant-restored",
              "to": "operator-console"
            }
          ]
        },
        {
          "id": "pt-restore-without-point-i",
          "from": "pt-live-i",
          "to": "pt-live-i",
          "on": "pt-restore-requested",
          "guard": "!pointMarked",
          "effects": [
            {
              "emit": "pt-restore-refused",
              "to": "operator-console"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "pt-live-i": "pt-live",
          "pt-restored-i": "pt-restored"
        },
        "variables": {
          "version": "version",
          "journalPoint": "journalPoint",
          "pointMarked": "pointMarked",
          "restoredTo": "restoredTo",
          "restored": "restored"
        },
        "transitions": {
          "pt-write-i": "pt-write",
          "pt-point-i": "pt-point",
          "pt-restore-i": "pt-restore",
          "pt-restore-without-point-i": "pt-restore-without-point"
        }
      },
      "storage": {
        "record": "rec-point-in-time",
        "key": "tenant-id",
        "creates": true
      },
      "instances": {
        "key": "tenant-id",
        "storedIn": "rec-point-in-time",
        "max": 16
      }
    },
    {
      "id": "kernel-upgrade-flow",
      "name": "Serving under a newer kernel",
      "subject": "runtime",
      "initial": "ku-old",
      "description": "A tenant served by one kernel version is moved to a newer one. The journal of the tenant is replayed under the newer version; the tenant is served by it only when the replay reaches the state hash the journal records (modelled as a number).",
      "variables": [
        {
          "name": "journalHash",
          "type": "number",
          "initial": 5
        },
        {
          "name": "replayed",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "replayedHash",
          "type": "number",
          "initial": 0
        },
        {
          "name": "servedByNew",
          "type": "boolean",
          "initial": false
        }
      ],
      "states": [
        {
          "id": "ku-old",
          "name": "Served by the current version"
        },
        {
          "id": "ku-new",
          "name": "Served by the newer version",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "ku-switch-unchecked",
          "from": "ku-old",
          "to": "ku-new",
          "on": "ku-serve-requested",
          "effects": [
            {
              "set": "servedByNew",
              "to": true
            },
            {
              "emit": "ku-served-by-new"
            }
          ],
          "faultOnly": true,
          "description": "Defect: serves the tenant under the newer version whatever the replay found."
        },
        {
          "id": "ku-replay",
          "from": "ku-old",
          "to": "ku-old",
          "on": "ku-replay-finished",
          "effects": [
            {
              "set": "replayed",
              "to": true
            },
            {
              "set": "replayedHash",
              "to": "event.replayedHash"
            }
          ]
        },
        {
          "id": "ku-switch",
          "from": "ku-old",
          "to": "ku-new",
          "on": "ku-serve-requested",
          "guard": "replayed && replayedHash == journalHash",
          "effects": [
            {
              "set": "servedByNew",
              "to": true
            },
            {
              "emit": "ku-served-by-new"
            }
          ]
        },
        {
          "id": "ku-switch-refused",
          "from": "ku-old",
          "to": "ku-old",
          "on": "ku-serve-requested",
          "guard": "!replayed || replayedHash != journalHash",
          "effects": [
            {
              "emit": "ku-serve-refused"
            }
          ]
        }
      ]
    },
    {
      "id": "kernel-upgrade-flow-impl",
      "name": "Serving under a newer kernel (implementation)",
      "level": "implementation",
      "subject": "runtime",
      "refines": "kernel-upgrade-flow",
      "description": "A tenant served by one kernel version is moved to a newer one. The journal of the tenant is replayed under the newer version; the tenant is served by it only when the replay reaches the state hash the journal records (modelled as a number).",
      "initial": "ku-old-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "journalHash",
          "type": "number",
          "initial": 5,
          "repr": "u64"
        },
        {
          "name": "replayed",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "replayedHash",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "servedByNew",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        }
      ],
      "states": [
        {
          "id": "ku-old-i",
          "name": "Served by the current version"
        },
        {
          "id": "ku-new-i",
          "name": "Served by the newer version",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "ku-replay-i",
          "from": "ku-old-i",
          "to": "ku-old-i",
          "on": "ku-replay-finished",
          "otherwise": true,
          "effects": [
            {
              "set": "replayed",
              "to": true
            },
            {
              "set": "replayedHash",
              "to": "event.replayedHash"
            }
          ]
        },
        {
          "id": "ku-switch-i",
          "from": "ku-old-i",
          "to": "ku-new-i",
          "on": "ku-serve-requested",
          "guard": "replayed && replayedHash == journalHash",
          "effects": [
            {
              "set": "servedByNew",
              "to": true
            },
            {
              "emit": "ku-served-by-new",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "ku-switch-refused-i",
          "from": "ku-old-i",
          "to": "ku-old-i",
          "on": "ku-serve-requested",
          "guard": "!replayed || replayedHash != journalHash",
          "effects": [
            {
              "emit": "ku-serve-refused",
              "to": "operator-console"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "ku-old-i": "ku-old",
          "ku-new-i": "ku-new"
        },
        "variables": {
          "journalHash": "journalHash",
          "replayed": "replayed",
          "replayedHash": "replayedHash",
          "servedByNew": "servedByNew"
        },
        "transitions": {
          "ku-replay-i": "ku-replay",
          "ku-switch-i": "ku-switch",
          "ku-switch-refused-i": "ku-switch-refused"
        }
      },
      "storage": {
        "record": "rec-kernel-upgrade",
        "key": "tenant-id",
        "creates": true
      },
      "instances": {
        "key": "tenant-id",
        "storedIn": "rec-kernel-upgrade",
        "max": 16
      },
      "realisation": "target"
    },
    {
      "id": "placement-switch-flow",
      "name": "Directory switch of a tenant placement",
      "subject": "control-plane",
      "initial": "ps-serving",
      "description": "The directory switches a tenant from its source placement to its target placement. A request that began before the switch completes on the source and one that begins after it uses the target; the address of the tenant resolves to the same tenant before and after the switch.",
      "variables": [
        {
          "name": "placement",
          "type": "string",
          "initial": "source"
        },
        {
          "name": "addressTenant",
          "type": "string",
          "initial": "t1"
        },
        {
          "name": "r1On",
          "type": "string",
          "initial": ""
        },
        {
          "name": "r2On",
          "type": "string",
          "initial": ""
        },
        {
          "name": "r1DoneOn",
          "type": "string",
          "initial": ""
        },
        {
          "name": "r2DoneOn",
          "type": "string",
          "initial": ""
        },
        {
          "name": "resolvedTenant",
          "type": "string",
          "initial": ""
        }
      ],
      "states": [
        {
          "id": "ps-serving",
          "name": "Directory serving"
        }
      ],
      "transitions": [
        {
          "id": "ps-complete-on-current",
          "from": "ps-serving",
          "to": "ps-serving",
          "on": "ps-request-completed",
          "guard": "event.req == 'r1'",
          "effects": [
            {
              "set": "r1DoneOn",
              "to": "placement"
            }
          ],
          "faultOnly": true,
          "description": "Defect: completes a request on the placement in force when it completes."
        },
        {
          "id": "ps-begin-on-source",
          "from": "ps-serving",
          "to": "ps-serving",
          "on": "ps-request-begun",
          "guard": "event.req == 'r2'",
          "effects": [
            {
              "set": "r2On",
              "to": "'source'"
            }
          ],
          "faultOnly": true,
          "description": "Defect: begins a request after the switch on the source placement."
        },
        {
          "id": "ps-resolve-by-placement",
          "from": "ps-serving",
          "to": "ps-serving",
          "on": "ps-address-resolved",
          "effects": [
            {
              "set": "resolvedTenant",
              "to": "placement"
            }
          ],
          "faultOnly": true,
          "description": "Defect: resolves the address through the placement, so the answer changes with a switch."
        },
        {
          "id": "ps-switch",
          "from": "ps-serving",
          "to": "ps-serving",
          "on": "ps-switched",
          "effects": [
            {
              "set": "placement",
              "to": "'target'"
            }
          ]
        },
        {
          "id": "ps-begin-r1",
          "from": "ps-serving",
          "to": "ps-serving",
          "on": "ps-request-begun",
          "guard": "event.req == 'r1'",
          "effects": [
            {
              "set": "r1On",
              "to": "placement"
            }
          ]
        },
        {
          "id": "ps-begin-r2",
          "from": "ps-serving",
          "to": "ps-serving",
          "on": "ps-request-begun",
          "guard": "event.req == 'r2'",
          "effects": [
            {
              "set": "r2On",
              "to": "placement"
            }
          ]
        },
        {
          "id": "ps-complete-r1",
          "from": "ps-serving",
          "to": "ps-serving",
          "on": "ps-request-completed",
          "guard": "event.req == 'r1'",
          "effects": [
            {
              "set": "r1DoneOn",
              "to": "r1On"
            }
          ]
        },
        {
          "id": "ps-complete-r2",
          "from": "ps-serving",
          "to": "ps-serving",
          "on": "ps-request-completed",
          "guard": "event.req == 'r2'",
          "effects": [
            {
              "set": "r2DoneOn",
              "to": "r2On"
            }
          ]
        },
        {
          "id": "ps-resolve",
          "from": "ps-serving",
          "to": "ps-serving",
          "on": "ps-address-resolved",
          "effects": [
            {
              "set": "resolvedTenant",
              "to": "addressTenant"
            }
          ]
        }
      ]
    },
    {
      "id": "placement-switch-flow-impl",
      "name": "Directory switch of a tenant placement (implementation)",
      "level": "implementation",
      "subject": "control-plane",
      "refines": "placement-switch-flow",
      "description": "The directory switches a tenant from its source placement to its target placement. A request that began before the switch completes on the source and one that begins after it uses the target; the address of the tenant resolves to the same tenant before and after the switch.",
      "initial": "ps-serving-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "placement",
          "type": "string",
          "initial": "source",
          "repr": "string"
        },
        {
          "name": "addressTenant",
          "type": "string",
          "initial": "t1",
          "repr": "string"
        },
        {
          "name": "r1On",
          "type": "string",
          "initial": "",
          "repr": "string"
        },
        {
          "name": "r2On",
          "type": "string",
          "initial": "",
          "repr": "string"
        },
        {
          "name": "r1DoneOn",
          "type": "string",
          "initial": "",
          "repr": "string"
        },
        {
          "name": "r2DoneOn",
          "type": "string",
          "initial": "",
          "repr": "string"
        },
        {
          "name": "resolvedTenant",
          "type": "string",
          "initial": "",
          "repr": "string"
        }
      ],
      "states": [
        {
          "id": "ps-serving-i",
          "name": "Directory serving"
        }
      ],
      "transitions": [
        {
          "id": "ps-switch-i",
          "from": "ps-serving-i",
          "to": "ps-serving-i",
          "on": "ps-switched",
          "otherwise": true,
          "effects": [
            {
              "set": "placement",
              "to": "'target'"
            }
          ]
        },
        {
          "id": "ps-begin-r1-i",
          "from": "ps-serving-i",
          "to": "ps-serving-i",
          "on": "ps-request-begun",
          "guard": "event.req == 'r1'",
          "effects": [
            {
              "set": "r1On",
              "to": "placement"
            }
          ]
        },
        {
          "id": "ps-begin-r2-i",
          "from": "ps-serving-i",
          "to": "ps-serving-i",
          "on": "ps-request-begun",
          "guard": "event.req == 'r2'",
          "effects": [
            {
              "set": "r2On",
              "to": "placement"
            }
          ]
        },
        {
          "id": "ps-complete-r1-i",
          "from": "ps-serving-i",
          "to": "ps-serving-i",
          "on": "ps-request-completed",
          "guard": "event.req == 'r1'",
          "effects": [
            {
              "set": "r1DoneOn",
              "to": "r1On"
            }
          ]
        },
        {
          "id": "ps-complete-r2-i",
          "from": "ps-serving-i",
          "to": "ps-serving-i",
          "on": "ps-request-completed",
          "guard": "event.req == 'r2'",
          "effects": [
            {
              "set": "r2DoneOn",
              "to": "r2On"
            }
          ]
        },
        {
          "id": "ps-resolve-i",
          "from": "ps-serving-i",
          "to": "ps-serving-i",
          "on": "ps-address-resolved",
          "otherwise": true,
          "effects": [
            {
              "set": "resolvedTenant",
              "to": "addressTenant"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "ps-serving-i": "ps-serving"
        },
        "variables": {
          "placement": "placement",
          "addressTenant": "addressTenant",
          "r1On": "r1On",
          "r2On": "r2On",
          "r1DoneOn": "r1DoneOn",
          "r2DoneOn": "r2DoneOn",
          "resolvedTenant": "resolvedTenant"
        },
        "transitions": {
          "ps-switch-i": "ps-switch",
          "ps-begin-r1-i": "ps-begin-r1",
          "ps-begin-r2-i": "ps-begin-r2",
          "ps-complete-r1-i": "ps-complete-r1",
          "ps-complete-r2-i": "ps-complete-r2",
          "ps-resolve-i": "ps-resolve"
        }
      },
      "storage": {
        "record": "rec-placement-switch",
        "key": "tenant-id",
        "creates": true
      },
      "instances": {
        "key": "tenant-id",
        "storedIn": "rec-placement-switch",
        "max": 16
      }
    },
    {
      "id": "schema-change-flow",
      "name": "Schema change run",
      "subject": "migration-job",
      "initial": "sc-idle",
      "description": "One schema change of one tenant, applied as a migration run of two batches. The change is previewed before it is applied; the run records its preview, its batches, its outcome and the principal that started it. A run that fails leaves the tenant in the form it had and names the failure; a run the tenant owner stops records its cursor and the tenant keeps serving its readers.",
      "variables": [
        {
          "name": "previewRef",
          "type": "string",
          "initial": ""
        },
        {
          "name": "startedBy",
          "type": "string",
          "initial": ""
        },
        {
          "name": "started",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "batches",
          "type": "number",
          "initial": 0
        },
        {
          "name": "layoutVersion",
          "type": "number",
          "initial": 1
        },
        {
          "name": "priorVersion",
          "type": "number",
          "initial": 1
        },
        {
          "name": "failure",
          "type": "string",
          "initial": ""
        },
        {
          "name": "stopped",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "cursorRecorded",
          "type": "number",
          "initial": 0
        },
        {
          "name": "serving",
          "type": "boolean",
          "initial": true
        }
      ],
      "states": [
        {
          "id": "sc-idle",
          "name": "Not started"
        },
        {
          "id": "sc-previewed",
          "name": "Previewed"
        },
        {
          "id": "sc-running",
          "name": "Running"
        },
        {
          "id": "sc-completed",
          "name": "Complete",
          "terminal": true
        },
        {
          "id": "sc-failed",
          "name": "Failed",
          "terminal": true
        },
        {
          "id": "sc-stopped",
          "name": "Stopped",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "sc-apply-unpreviewed",
          "from": "sc-idle",
          "to": "sc-running",
          "on": "sc-apply-requested",
          "effects": [
            {
              "set": "started",
              "to": true
            },
            {
              "set": "startedBy",
              "to": "event.principal"
            },
            {
              "emit": "sc-run-started"
            }
          ],
          "faultOnly": true,
          "description": "Defect: applies a change that was never previewed."
        },
        {
          "id": "sc-apply-unrecorded",
          "from": "sc-previewed",
          "to": "sc-running",
          "on": "sc-apply-requested",
          "effects": [
            {
              "set": "started",
              "to": true
            },
            {
              "emit": "sc-run-started"
            }
          ],
          "faultOnly": true,
          "description": "Defect: starts the run without recording the principal that started it."
        },
        {
          "id": "sc-failure-leaves-change",
          "from": "sc-running",
          "to": "sc-failed",
          "on": "sc-batch-failed",
          "effects": [
            {
              "set": "layoutVersion",
              "to": 2
            },
            {
              "set": "failure",
              "to": "event.reason"
            },
            {
              "emit": "sc-run-failed"
            }
          ],
          "faultOnly": true,
          "description": "Defect: leaves the tenant half converted after a failed batch."
        },
        {
          "id": "sc-failure-unnamed",
          "from": "sc-running",
          "to": "sc-failed",
          "on": "sc-batch-failed",
          "effects": [
            {
              "emit": "sc-run-failed"
            }
          ],
          "faultOnly": true,
          "description": "Defect: does not record the failure in the run."
        },
        {
          "id": "sc-stop-drops-cursor",
          "from": "sc-running",
          "to": "sc-stopped",
          "on": "sc-stop-requested",
          "effects": [
            {
              "set": "stopped",
              "to": true
            },
            {
              "set": "cursorRecorded",
              "to": 0
            },
            {
              "set": "serving",
              "to": false
            },
            {
              "emit": "sc-run-stopped"
            }
          ],
          "faultOnly": true,
          "description": "Defect: stopping the run forgets its cursor and takes the tenant out of service."
        },
        {
          "id": "sc-preview",
          "from": "sc-idle",
          "to": "sc-previewed",
          "on": "sc-preview-requested",
          "effects": [
            {
              "set": "previewRef",
              "to": "event.preview"
            }
          ]
        },
        {
          "id": "sc-apply-refuse",
          "from": "sc-idle",
          "to": "sc-idle",
          "on": "sc-apply-requested",
          "effects": [
            {
              "emit": "sc-apply-refused"
            }
          ]
        },
        {
          "id": "sc-apply",
          "from": "sc-previewed",
          "to": "sc-running",
          "on": "sc-apply-requested",
          "effects": [
            {
              "set": "started",
              "to": true
            },
            {
              "set": "startedBy",
              "to": "event.principal"
            },
            {
              "emit": "sc-run-started"
            }
          ]
        },
        {
          "id": "sc-batch",
          "from": "sc-running",
          "to": "sc-running",
          "on": "sc-batch-committed",
          "guard": "batches < 1",
          "effects": [
            {
              "set": "batches",
              "to": "batches + 1"
            }
          ]
        },
        {
          "id": "sc-finish",
          "from": "sc-running",
          "to": "sc-completed",
          "on": "sc-batch-committed",
          "guard": "batches >= 1",
          "effects": [
            {
              "set": "batches",
              "to": "batches + 1"
            },
            {
              "set": "layoutVersion",
              "to": 2
            },
            {
              "emit": "sc-run-complete"
            }
          ]
        },
        {
          "id": "sc-fail",
          "from": "sc-running",
          "to": "sc-failed",
          "on": "sc-batch-failed",
          "effects": [
            {
              "set": "failure",
              "to": "event.reason"
            },
            {
              "emit": "sc-run-failed"
            }
          ]
        },
        {
          "id": "sc-stop",
          "from": "sc-running",
          "to": "sc-stopped",
          "on": "sc-stop-requested",
          "effects": [
            {
              "set": "stopped",
              "to": true
            },
            {
              "set": "cursorRecorded",
              "to": "batches"
            },
            {
              "emit": "sc-run-stopped"
            }
          ]
        }
      ]
    },
    {
      "id": "schema-change-flow-impl",
      "name": "Schema change run (implementation)",
      "level": "implementation",
      "subject": "migration-job",
      "refines": "schema-change-flow",
      "description": "One schema change of one tenant, applied as a migration run of two batches. The change is previewed before it is applied; the run records its preview, its batches, its outcome and the principal that started it. A run that fails leaves the tenant in the form it had and names the failure; a run the tenant owner stops records its cursor and the tenant keeps serving its readers.",
      "initial": "sc-idle-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "previewRef",
          "type": "string",
          "initial": "",
          "repr": "string"
        },
        {
          "name": "startedBy",
          "type": "string",
          "initial": "",
          "repr": "string"
        },
        {
          "name": "started",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "batches",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "layoutVersion",
          "type": "number",
          "initial": 1,
          "repr": "u64"
        },
        {
          "name": "priorVersion",
          "type": "number",
          "initial": 1,
          "repr": "u64"
        },
        {
          "name": "failure",
          "type": "string",
          "initial": "",
          "repr": "string"
        },
        {
          "name": "stopped",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "cursorRecorded",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "serving",
          "type": "boolean",
          "initial": true,
          "repr": "bool"
        }
      ],
      "states": [
        {
          "id": "sc-idle-i",
          "name": "Not started",
          "ignores": [
            "sc-batch-committed",
            "sc-batch-failed",
            "sc-stop-requested"
          ]
        },
        {
          "id": "sc-previewed-i",
          "name": "Previewed",
          "ignores": [
            "sc-preview-requested",
            "sc-batch-committed",
            "sc-batch-failed",
            "sc-stop-requested"
          ]
        },
        {
          "id": "sc-running-i",
          "name": "Running",
          "ignores": [
            "sc-preview-requested",
            "sc-apply-requested"
          ]
        },
        {
          "id": "sc-completed-i",
          "name": "Complete",
          "terminal": true
        },
        {
          "id": "sc-failed-i",
          "name": "Failed",
          "terminal": true
        },
        {
          "id": "sc-stopped-i",
          "name": "Stopped",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "sc-preview-i",
          "from": "sc-idle-i",
          "to": "sc-previewed-i",
          "on": "sc-preview-requested",
          "otherwise": true,
          "effects": [
            {
              "set": "previewRef",
              "to": "event.preview"
            }
          ]
        },
        {
          "id": "sc-apply-refuse-i",
          "from": "sc-idle-i",
          "to": "sc-idle-i",
          "on": "sc-apply-requested",
          "otherwise": true,
          "effects": [
            {
              "emit": "sc-apply-refused",
              "to": "operator-console"
            }
          ]
        },
        {
          "id": "sc-apply-i",
          "from": "sc-previewed-i",
          "to": "sc-running-i",
          "on": "sc-apply-requested",
          "otherwise": true,
          "effects": [
            {
              "set": "started",
              "to": true
            },
            {
              "set": "startedBy",
              "to": "event.principal"
            },
            {
              "emit": "sc-run-started",
              "to": "operator-console"
            }
          ]
        },
        {
          "id": "sc-batch-i",
          "from": "sc-running-i",
          "to": "sc-running-i",
          "on": "sc-batch-committed",
          "guard": "batches < 1",
          "effects": [
            {
              "set": "batches",
              "to": "batches + 1"
            }
          ]
        },
        {
          "id": "sc-finish-i",
          "from": "sc-running-i",
          "to": "sc-completed-i",
          "on": "sc-batch-committed",
          "guard": "batches >= 1",
          "effects": [
            {
              "set": "batches",
              "to": "batches + 1"
            },
            {
              "set": "layoutVersion",
              "to": 2
            },
            {
              "emit": "sc-run-complete",
              "to": "operator-console"
            }
          ]
        },
        {
          "id": "sc-fail-i",
          "from": "sc-running-i",
          "to": "sc-failed-i",
          "on": "sc-batch-failed",
          "otherwise": true,
          "effects": [
            {
              "set": "failure",
              "to": "event.reason"
            },
            {
              "emit": "sc-run-failed",
              "to": "operator-console"
            }
          ]
        },
        {
          "id": "sc-stop-i",
          "from": "sc-running-i",
          "to": "sc-stopped-i",
          "on": "sc-stop-requested",
          "otherwise": true,
          "effects": [
            {
              "set": "stopped",
              "to": true
            },
            {
              "set": "cursorRecorded",
              "to": "batches"
            },
            {
              "emit": "sc-run-stopped",
              "to": "operator-console"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "sc-idle-i": "sc-idle",
          "sc-previewed-i": "sc-previewed",
          "sc-running-i": "sc-running",
          "sc-completed-i": "sc-completed",
          "sc-failed-i": "sc-failed",
          "sc-stopped-i": "sc-stopped"
        },
        "variables": {
          "previewRef": "previewRef",
          "startedBy": "startedBy",
          "started": "started",
          "batches": "batches",
          "layoutVersion": "layoutVersion",
          "priorVersion": "priorVersion",
          "failure": "failure",
          "stopped": "stopped",
          "cursorRecorded": "cursorRecorded",
          "serving": "serving"
        },
        "transitions": {
          "sc-preview-i": "sc-preview",
          "sc-apply-refuse-i": "sc-apply-refuse",
          "sc-apply-i": "sc-apply",
          "sc-batch-i": "sc-batch",
          "sc-finish-i": "sc-finish",
          "sc-fail-i": "sc-fail",
          "sc-stop-i": "sc-stop"
        }
      },
      "storage": {
        "record": "rec-schema-change",
        "key": "tenant-id",
        "creates": true
      },
      "instances": {
        "key": "tenant-id",
        "storedIn": "rec-schema-change",
        "max": 16
      }
    },
    {
      "id": "layout-rollout-flow",
      "name": "Layout change across tenants",
      "subject": "migration-job",
      "initial": "lr-open",
      "description": "A change to the storage layout applied to the databases of two tenants, a and b, one tenant at a time, with the outcome recorded for each. A tenant whose change fails stays on its previous layout and keeps serving, and the other tenant is still changed. The model puts both tenants in one machine, so this one is a single unit and has no keyed instances.",
      "variables": [
        {
          "name": "layoutA",
          "type": "number",
          "initial": 1
        },
        {
          "name": "layoutB",
          "type": "number",
          "initial": 1
        },
        {
          "name": "outcomeA",
          "type": "string",
          "initial": ""
        },
        {
          "name": "outcomeB",
          "type": "string",
          "initial": ""
        },
        {
          "name": "servingA",
          "type": "boolean",
          "initial": true
        },
        {
          "name": "servingB",
          "type": "boolean",
          "initial": true
        }
      ],
      "states": [
        {
          "id": "lr-open",
          "name": "Rolling out"
        }
      ],
      "transitions": [
        {
          "id": "lr-failure-aborts-rollout",
          "from": "lr-open",
          "to": "lr-open",
          "on": "lr-apply-requested",
          "guard": "event.tenant == 'b' && outcomeA == 'failed'",
          "effects": [
            {
              "set": "outcomeB",
              "to": "'skipped'"
            }
          ],
          "faultOnly": true,
          "description": "Defect: a failure on one tenant stops the change of the others."
        },
        {
          "id": "lr-failure-half-applied",
          "from": "lr-open",
          "to": "lr-open",
          "on": "lr-apply-requested",
          "guard": "event.tenant == 'a' && !event.ok",
          "effects": [
            {
              "set": "layoutA",
              "to": 2
            },
            {
              "set": "outcomeA",
              "to": "'failed'"
            },
            {
              "set": "servingA",
              "to": false
            }
          ],
          "faultOnly": true,
          "description": "Defect: a failed change leaves the tenant on a partly changed layout and out of service."
        },
        {
          "id": "lr-apply-a",
          "from": "lr-open",
          "to": "lr-open",
          "on": "lr-apply-requested",
          "guard": "event.tenant == 'a' && event.ok",
          "effects": [
            {
              "set": "layoutA",
              "to": 2
            },
            {
              "set": "outcomeA",
              "to": "'applied'"
            }
          ]
        },
        {
          "id": "lr-fail-a",
          "from": "lr-open",
          "to": "lr-open",
          "on": "lr-apply-requested",
          "guard": "event.tenant == 'a' && !event.ok",
          "effects": [
            {
              "set": "outcomeA",
              "to": "'failed'"
            }
          ]
        },
        {
          "id": "lr-apply-b",
          "from": "lr-open",
          "to": "lr-open",
          "on": "lr-apply-requested",
          "guard": "event.tenant == 'b' && event.ok",
          "effects": [
            {
              "set": "layoutB",
              "to": 2
            },
            {
              "set": "outcomeB",
              "to": "'applied'"
            }
          ]
        },
        {
          "id": "lr-fail-b",
          "from": "lr-open",
          "to": "lr-open",
          "on": "lr-apply-requested",
          "guard": "event.tenant == 'b' && !event.ok",
          "effects": [
            {
              "set": "outcomeB",
              "to": "'failed'"
            }
          ]
        }
      ]
    },
    {
      "id": "layout-rollout-flow-impl",
      "name": "Layout change across tenants (implementation)",
      "level": "implementation",
      "subject": "migration-job",
      "refines": "layout-rollout-flow",
      "description": "A change to the storage layout applied to the databases of two tenants, a and b, one tenant at a time, with the outcome recorded for each. A tenant whose change fails stays on its previous layout and keeps serving, and the other tenant is still changed. The model puts both tenants in one machine, so this one is a single unit and has no keyed instances.",
      "initial": "lr-open-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "layoutA",
          "type": "number",
          "initial": 1,
          "repr": "u64"
        },
        {
          "name": "layoutB",
          "type": "number",
          "initial": 1,
          "repr": "u64"
        },
        {
          "name": "outcomeA",
          "type": "string",
          "initial": "",
          "repr": "string"
        },
        {
          "name": "outcomeB",
          "type": "string",
          "initial": "",
          "repr": "string"
        },
        {
          "name": "servingA",
          "type": "boolean",
          "initial": true,
          "repr": "bool"
        },
        {
          "name": "servingB",
          "type": "boolean",
          "initial": true,
          "repr": "bool"
        }
      ],
      "states": [
        {
          "id": "lr-open-i",
          "name": "Rolling out"
        }
      ],
      "transitions": [
        {
          "id": "lr-apply-a-i",
          "from": "lr-open-i",
          "to": "lr-open-i",
          "on": "lr-apply-requested",
          "guard": "event.tenant == 'a' && event.ok",
          "effects": [
            {
              "set": "layoutA",
              "to": 2
            },
            {
              "set": "outcomeA",
              "to": "'applied'"
            }
          ]
        },
        {
          "id": "lr-fail-a-i",
          "from": "lr-open-i",
          "to": "lr-open-i",
          "on": "lr-apply-requested",
          "guard": "event.tenant == 'a' && !event.ok",
          "effects": [
            {
              "set": "outcomeA",
              "to": "'failed'"
            }
          ]
        },
        {
          "id": "lr-apply-b-i",
          "from": "lr-open-i",
          "to": "lr-open-i",
          "on": "lr-apply-requested",
          "guard": "event.tenant == 'b' && event.ok",
          "effects": [
            {
              "set": "layoutB",
              "to": 2
            },
            {
              "set": "outcomeB",
              "to": "'applied'"
            }
          ]
        },
        {
          "id": "lr-fail-b-i",
          "from": "lr-open-i",
          "to": "lr-open-i",
          "on": "lr-apply-requested",
          "guard": "event.tenant == 'b' && !event.ok",
          "effects": [
            {
              "set": "outcomeB",
              "to": "'failed'"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "lr-open-i": "lr-open"
        },
        "variables": {
          "layoutA": "layoutA",
          "layoutB": "layoutB",
          "outcomeA": "outcomeA",
          "outcomeB": "outcomeB",
          "servingA": "servingA",
          "servingB": "servingB"
        },
        "transitions": {
          "lr-apply-a-i": "lr-apply-a",
          "lr-fail-a-i": "lr-fail-a",
          "lr-apply-b-i": "lr-apply-b",
          "lr-fail-b-i": "lr-fail-b"
        }
      },
      "storage": {
        "record": "rec-layout-rollout",
        "key": "scope",
        "creates": true
      }
    },
    {
      "id": "staging-promotion-flow",
      "name": "Promotion of a staging migration",
      "subject": "migration-job",
      "initial": "sp-both",
      "description": "A migration applied to a staging tenant. It reaches the production tenant only as a migration run of that tenant, previewed against the production data; applying it to staging changes nothing in production.",
      "variables": [
        {
          "name": "stagingApplied",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "prodPreviewed",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "prodRunStarted",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "prodChanged",
          "type": "boolean",
          "initial": false
        }
      ],
      "states": [
        {
          "id": "sp-both",
          "name": "Staging and production"
        }
      ],
      "transitions": [
        {
          "id": "sp-staging-reaches-prod",
          "from": "sp-both",
          "to": "sp-both",
          "on": "sp-staging-applied",
          "effects": [
            {
              "set": "stagingApplied",
              "to": true
            },
            {
              "set": "prodChanged",
              "to": true
            }
          ],
          "faultOnly": true,
          "description": "Defect: the migration applied to staging also changes production."
        },
        {
          "id": "sp-promote-unpreviewed",
          "from": "sp-both",
          "to": "sp-both",
          "on": "sp-promote-requested",
          "effects": [
            {
              "set": "prodRunStarted",
              "to": true
            },
            {
              "set": "prodChanged",
              "to": true
            },
            {
              "emit": "sp-prod-run-started"
            }
          ],
          "faultOnly": true,
          "description": "Defect: starts the production run without a preview against production."
        },
        {
          "id": "sp-staging",
          "from": "sp-both",
          "to": "sp-both",
          "on": "sp-staging-applied",
          "effects": [
            {
              "set": "stagingApplied",
              "to": true
            }
          ]
        },
        {
          "id": "sp-preview",
          "from": "sp-both",
          "to": "sp-both",
          "on": "sp-prod-preview-requested",
          "effects": [
            {
              "set": "prodPreviewed",
              "to": true
            }
          ]
        },
        {
          "id": "sp-promote",
          "from": "sp-both",
          "to": "sp-both",
          "on": "sp-promote-requested",
          "guard": "prodPreviewed",
          "effects": [
            {
              "set": "prodRunStarted",
              "to": true
            },
            {
              "set": "prodChanged",
              "to": true
            },
            {
              "emit": "sp-prod-run-started"
            }
          ]
        },
        {
          "id": "sp-promote-refused-unpreviewed",
          "from": "sp-both",
          "to": "sp-both",
          "on": "sp-promote-requested",
          "guard": "!prodPreviewed",
          "effects": [
            {
              "emit": "sp-promote-refused"
            }
          ]
        }
      ]
    },
    {
      "id": "staging-promotion-flow-impl",
      "name": "Promotion of a staging migration (implementation)",
      "level": "implementation",
      "subject": "migration-job",
      "refines": "staging-promotion-flow",
      "description": "A migration applied to a staging tenant. It reaches the production tenant only as a migration run of that tenant, previewed against the production data; applying it to staging changes nothing in production.",
      "initial": "sp-both-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "stagingApplied",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "prodPreviewed",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "prodRunStarted",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "prodChanged",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        }
      ],
      "states": [
        {
          "id": "sp-both-i",
          "name": "Staging and production"
        }
      ],
      "transitions": [
        {
          "id": "sp-staging-i",
          "from": "sp-both-i",
          "to": "sp-both-i",
          "on": "sp-staging-applied",
          "otherwise": true,
          "effects": [
            {
              "set": "stagingApplied",
              "to": true
            }
          ]
        },
        {
          "id": "sp-preview-i",
          "from": "sp-both-i",
          "to": "sp-both-i",
          "on": "sp-prod-preview-requested",
          "otherwise": true,
          "effects": [
            {
              "set": "prodPreviewed",
              "to": true
            }
          ]
        },
        {
          "id": "sp-promote-i",
          "from": "sp-both-i",
          "to": "sp-both-i",
          "on": "sp-promote-requested",
          "guard": "prodPreviewed",
          "effects": [
            {
              "set": "prodRunStarted",
              "to": true
            },
            {
              "set": "prodChanged",
              "to": true
            },
            {
              "emit": "sp-prod-run-started",
              "to": "operator-console"
            }
          ]
        },
        {
          "id": "sp-promote-refused-unpreviewed-i",
          "from": "sp-both-i",
          "to": "sp-both-i",
          "on": "sp-promote-requested",
          "guard": "!prodPreviewed",
          "effects": [
            {
              "emit": "sp-promote-refused",
              "to": "operator-console"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "sp-both-i": "sp-both"
        },
        "variables": {
          "stagingApplied": "stagingApplied",
          "prodPreviewed": "prodPreviewed",
          "prodRunStarted": "prodRunStarted",
          "prodChanged": "prodChanged"
        },
        "transitions": {
          "sp-staging-i": "sp-staging",
          "sp-preview-i": "sp-preview",
          "sp-promote-i": "sp-promote",
          "sp-promote-refused-unpreviewed-i": "sp-promote-refused-unpreviewed"
        }
      },
      "storage": {
        "record": "rec-staging-promotion",
        "key": "tenant-id",
        "creates": true
      },
      "instances": {
        "key": "tenant-id",
        "storedIn": "rec-staging-promotion",
        "max": 16
      }
    },
    {
      "id": "field-change-flow",
      "name": "Field added and field renamed",
      "subject": "migration-job",
      "initial": "fc-open",
      "description": "Two schema changes of one tenant. A new field takes, for each existing record, the value of the expression its change declares (here the base of the record times a factor of 2). A rename keeps the values under the new name and a request under the old name is refused.",
      "variables": [
        {
          "name": "base1",
          "type": "number",
          "initial": 1
        },
        {
          "name": "base2",
          "type": "number",
          "initial": 5
        },
        {
          "name": "factor",
          "type": "number",
          "initial": 2
        },
        {
          "name": "newField1",
          "type": "number",
          "initial": 0
        },
        {
          "name": "newField2",
          "type": "number",
          "initial": 0
        },
        {
          "name": "added",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "oldName",
          "type": "string",
          "initial": "title"
        },
        {
          "name": "fieldName",
          "type": "string",
          "initial": "title"
        },
        {
          "name": "value",
          "type": "string",
          "initial": "v1"
        },
        {
          "name": "renamed",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "lastServedName",
          "type": "string",
          "initial": ""
        },
        {
          "name": "lastServedValue",
          "type": "string",
          "initial": ""
        }
      ],
      "states": [
        {
          "id": "fc-open",
          "name": "Tenant serving"
        }
      ],
      "transitions": [
        {
          "id": "fc-field-defaulted",
          "from": "fc-open",
          "to": "fc-open",
          "on": "fc-field-added",
          "effects": [
            {
              "set": "added",
              "to": true
            }
          ],
          "faultOnly": true,
          "description": "Defect: gives each existing record the default value instead of the value of the expression."
        },
        {
          "id": "fc-rename-drops-values",
          "from": "fc-open",
          "to": "fc-open",
          "on": "fc-rename-applied",
          "effects": [
            {
              "set": "fieldName",
              "to": "event.newName"
            },
            {
              "set": "value",
              "to": "''"
            },
            {
              "set": "renamed",
              "to": true
            },
            {
              "set": "lastServedName",
              "to": "''"
            }
          ],
          "faultOnly": true,
          "description": "Defect: the rename loses the values of the existing records."
        },
        {
          "id": "fc-old-name-still-served",
          "from": "fc-open",
          "to": "fc-open",
          "on": "fc-read-requested",
          "guard": "renamed && event.name == oldName",
          "effects": [
            {
              "set": "lastServedName",
              "to": "event.name"
            },
            {
              "set": "lastServedValue",
              "to": "value"
            },
            {
              "emit": "fc-served"
            }
          ],
          "faultOnly": true,
          "description": "Defect: a request under the old name is still answered after the rename."
        },
        {
          "id": "fc-add-field",
          "from": "fc-open",
          "to": "fc-open",
          "on": "fc-field-added",
          "effects": [
            {
              "set": "newField1",
              "to": "base1 * factor"
            },
            {
              "set": "newField2",
              "to": "base2 * factor"
            },
            {
              "set": "added",
              "to": true
            }
          ]
        },
        {
          "id": "fc-rename",
          "from": "fc-open",
          "to": "fc-open",
          "on": "fc-rename-applied",
          "effects": [
            {
              "set": "fieldName",
              "to": "event.newName"
            },
            {
              "set": "renamed",
              "to": true
            },
            {
              "set": "lastServedName",
              "to": "''"
            }
          ]
        },
        {
          "id": "fc-read",
          "from": "fc-open",
          "to": "fc-open",
          "on": "fc-read-requested",
          "guard": "event.name == fieldName",
          "effects": [
            {
              "set": "lastServedName",
              "to": "event.name"
            },
            {
              "set": "lastServedValue",
              "to": "value"
            },
            {
              "emit": "fc-served"
            }
          ]
        },
        {
          "id": "fc-read-unknown-name",
          "from": "fc-open",
          "to": "fc-open",
          "on": "fc-read-requested",
          "guard": "event.name != fieldName",
          "effects": [
            {
              "emit": "fc-read-refused"
            }
          ]
        }
      ]
    },
    {
      "id": "field-change-flow-impl",
      "name": "Field added and field renamed (implementation)",
      "level": "implementation",
