    {
      "id": "execute-decide",
      "description": "crates/storage-api/src/lib.rs execute, one decision, the decide of contract execute-intent (CT-031): the needs plan-intent-needs names for the snapshot's schema are asked for first, one at a time (storage-api loads them together after a header load); then the kernel decides (intent-decision). An InsufficientState rejection naming a need asks for it; any other rejection is the contract's domain error. An accepted transition is handed to the commit with its intent and its record reply.",
      "params": [
        {
          "name": "state",
          "type": "state"
        },
        {
          "name": "texts",
          "type": "intent-texts"
        },
        {
          "name": "intent",
          "type": "intent"
        },
        {
          "name": "context",
          "type": "context"
        }
      ],
      "returns": "accepted-intent",
      "errors": "execute-failure",
      "body": "match call first-missing(state.coverage, call needs(match state.tenant { Some(t) => t.schema, None => null }, intent)) { Some(n) => fail(execute-failure.insufficient-state(n)), None => match call intent-decision(state, intent, context, texts) { Ok(tr) => accepted-intent{intent, transition: tr, reply: call mutation-reply-of(tr)}, Err(e) => match e { rejected(d) => match d.missing { Some(n) => if d.kind == error-kind.insufficient-state then fail(execute-failure.insufficient-state(n)) else fail(execute-failure.domain(d)), None => fail(execute-failure.domain(d)) } } } }",
      "examples": [
        {
          "args": {
            "state": {
              "tenant-id": "gamma",
              "tenant": null,
              "coverage": "complete"
            },
            "texts": {
