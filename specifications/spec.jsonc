    {
      "id": "view-problems",
      "description": "schema.rs TenantSchema::problems, one view: a route that does not start with /, a route an earlier view (in id order) took, then each section in name order.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "view",
          "type": "view-def"
        },
        {
          "name": "taken",
          "type": "list<string>"
        }
      ],
      "returns": "list<string>",
      "let": [
        {
          "name": "at",
          "expr": "format('view {}', view.id)"
        },
        {
          "name": "p1",
          "expr": "concat(if call text-starts-with(view.route, '/') then [] else [format('{}: route must start with /', at)], if any(r in taken, r == view.route) then [format('{}: route {} is already taken', at, view.route)] else [])"
        }
      ],
      "body": "fold(name in keys(view.sections), ps = p1, match get(view.sections, name) { None => ps, Some(s) => concat(ps, call section-problems(schema, view, at, name, s)) })",
