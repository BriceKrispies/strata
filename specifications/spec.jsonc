    {
      "id": "draft-reject",
      "description": "transition.rs Draft::reject: the error of a kind and message with the draft evidence, which gains a failed intent:<kind> check when every check in it passed.",
      "params": [
        {
          "name": "evidence",
          "type": "list<check>"
        },
        {
          "name": "kind",
          "type": "error-kind"
        },
        {
          "name": "message",
          "type": "string"
        }
      ],
      "returns": "rejection",
      "body": "rejection.rejected(domain-error{kind, message, evidence: if all(c in evidence, c.passed) then concat(evidence, [check{rule: format('intent:{}', call error-kind-snake(kind)), passed: false, detail: message}]) else evidence})",
      "examples": [
        {
          "args": {
            "evidence": [
              {
                "rule": "default:note.status",
                "passed": true,
                "detail": "'draft'"
              }
            ],
            "kind": "evaluation",
            "message": "default of x: oops"
          },
          "result": {
            "rejected": {
              "kind": "evaluation",
              "message": "default of x: oops",
              "evidence": [
                {
                  "rule": "default:note.status",
                  "passed": true,
                  "detail": "'draft'"
                },
                {
                  "rule": "intent:evaluation",
                  "passed": false,
                  "detail": "default of x: oops"
                }
              ]
            }
          }
        },
        {
          "args": {
            "evidence": [
              {
                "rule": "policy:none",
                "passed": false,
                "detail": "no policy grants"
              }
            ],
            "kind": "unauthorized",
            "message": "m"
          },
          "result": {
            "rejected": {
              "kind": "unauthorized",
              "message": "m",
              "evidence": [
                {
                  "rule": "policy:none",
                  "passed": false,
                  "detail": "no policy grants"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "defaults",
      "description": "transition.rs create_record, the defaults (lines 409-437): the given fields without nulls, then for each declared field (in id order) the intent leaves out entirely and that has a default, the default evaluated with no record, no parameters and the context's time, principal and roles (rules.rs roles_of of the tenant); a null result is left out, any other value is set with a passed default:<object>.<field> check; an evaluation error rejects the intent with Evaluation (draft-reject). evidence is the draft evidence so far; texts holds the printed default expressions.",
      "params": [
        {
          "name": "object",
          "type": "object-type-def"
        },
        {
          "name": "fields",
          "type": "map<field-id, value>"
        },
        {
          "name": "principal",
          "type": "principal"
        },
        {
          "name": "now",
          "type": "timestamp"
        },
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "evidence",
          "type": "list<check>"
        }
      ],
      "returns": "defaults-outcome",
      "errors": "rejection",
      "let": [
        {
          "name": "roles",
          "expr": "call roles-of(tenant, principal)"
        },
        {
          "name": "env",
          "expr": "expr-env{record: null, old: null, new: null, param: {}, now: value.time(now), principal: call principal-value(principal), has_role: roles}"
        },
        {
          "name": "given",
          "expr": "fold(k in keys(fields), m = fields, match get(fields, k) { Some(x) => if call value-is-null(x) then remove(m, k) else m, None => m })"
        }
      ],
      "body": "fold(f in values(object.fields), a = defaults-outcome{values: given, evidence}, if get(fields, f.id) != null then a else match f.default { None => a, Some(d) => match eval(tenant-rule-language, d, env) { Ok(x) => if call value-is-null(x) then a else defaults-outcome{values: insert(a.values, f.id, x), evidence: concat(a.evidence, [check{rule: format('default:{}.{}', object.id, f.id), passed: true, detail: print(tenant-rule-language, d)}])}, Err(e) => fail(call draft-reject(a.evidence, error-kind.evaluation, format('default of {}: {}', f.id, e))) } })",
      "examples": [
        {
          "description": "behaviour.rs create_applies_defaults_and_allocates_the_next_id: status defaults to 'draft'.",
          "args": {
            "object": {
              "fixture": "fx-object-type-def-1"
            },
            "fields": {
              "title": {
                "str": "First"
              },
              "slug": {
                "str": "first"
              }
            },
            "principal": {
              "user": "alpha:writer1"
            },
            "now": 5000,
            "evidence": [],
            "tenant": {
              "fixture": "fx-tenant-state-8"
            }
          },
          "result": {
            "values": {
              "slug": {
                "str": "first"
              },
              "status": {
                "str": "draft"
              },
              "title": {
                "str": "First"
              }
            },
            "evidence": [
              {
                "rule": "default:note.status",
                "passed": true,
                "detail": "'draft'"
              }
            ]
          }
        },
        {
          "description": "A field the intent names, even as null, takes no default; a null given value is dropped.",
          "args": {
            "object": {
              "fixture": "fx-object-type-def-1"
            },
            "fields": {
              "title": {
                "str": "First"
              },
              "slug": {
                "str": "first"
              },
              "status": "null",
              "rank": "null"
            },
            "principal": {
              "user": "alpha:writer1"
            },
            "now": 5000,
            "evidence": [],
            "tenant": {
              "fixture": "fx-tenant-state-8"
            }
          },
          "result": {
            "values": {
              "slug": {
                "str": "first"
              },
              "title": {
                "str": "First"
              }
            },
            "evidence": []
          }
        },
        {
          "description": "A default that evaluates to null is left out; a default may read the principal and the clock.",
          "args": {
            "object": {
              "id": "note",
              "label": "Note",
              "fields": {
                "by": {
                  "id": "by",
                  "label": "By",
                  "ty": "str",
                  "required": false,
                  "unique": false,
                  "default": "principal"
                },
                "at": {
                  "id": "at",
                  "label": "At",
                  "ty": "time",
                  "required": false,
                  "unique": false,
                  "default": "now"
                }
              },
              "constraints": {}
            },
            "fields": {},
            "principal": "anonymous",
            "now": 5000,
            "evidence": [],
            "tenant": {
              "fixture": "fx-tenant-state-8"
            }
          },
          "result": {
            "values": {
              "at": {
                "time": 5000
              }
            },
            "evidence": [
              {
                "rule": "default:note.at",
                "passed": true,
                "detail": "now"
              }
            ]
          }
        },
        {
          "description": "An evaluation error rejects the intent (the text after the colon is the evaluator's own wording, not the kernel's).",
          "args": {
            "object": {
              "id": "note",
              "label": "Note",
              "fields": {
                "bad": {
                  "id": "bad",
                  "label": "Bad",
                  "ty": "bool",
                  "required": false,
                  "unique": false,
                  "default": {
                    "cmp": {
                      "op": "eq",
                      "left": {
                        "lit": {
                          "str": "a"
                        }
                      },
                      "right": {
                        "lit": {
                          "int": 1
                        }
                      }
                    }
                  }
                }
              },
              "constraints": {}
            },
            "fields": {},
            "principal": {
              "user": "alpha:writer1"
            },
            "now": 5000,
            "evidence": [
              {
                "rule": "intent:shape",
                "passed": true,
                "detail": "ok"
              }
            ],
            "tenant": {
              "fixture": "fx-tenant-state-8"
            }
          },
          "error": {
            "rejected": {
              "kind": "evaluation",
              "message": "default of bad: cannot compare a string with a int",
              "evidence": [
                {
                  "rule": "intent:shape",
                  "passed": true,
                  "detail": "ok"
                },
                {
                  "rule": "intent:evaluation",
                  "passed": false,
                  "detail": "default of bad: cannot compare a string with a int"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "field-shape",
      "description": "expr.rs shape_of_type: the shape check gives a field of a type.",
      "params": [
        {
          "name": "ty",
          "type": "field-type"
        }
      ],
      "returns": "string",
      "body": "match ty { str => 'str', int => 'int', bool => 'bool', time => 'time', ref => 'ref', list(_) => 'list', file => 'str', language => 'str' }",
      "examples": [
        {
          "args": {
            "ty": "time"
          },
          "result": "time"
        },
        {
          "args": {
            "ty": {
              "list": "int"
            }
          },
          "result": "list"
        },
        {
          "args": {
            "ty": "bool"
          },
          "result": "bool"
        },
        {
          "args": {
            "ty": {
              "file": {
                "media-types": [
                  "image/png"
                ],
                "max-bytes": 5242880,
                "renditions": []
              }
            }
          },
          "result": "str"
        },
        {
          "args": {
            "ty": "language"
          },
          "result": "str"
        }
      ]
    },
    {
      "id": "field-shapes",
      "description": "The fields of a check environment: the shape of each field of an object type.",
      "params": [
        {
          "name": "fields",
          "type": "map<field-id, field-def>"
        }
      ],
      "returns": "map<string, string>",
      "body": "fold(f in values(fields), m = {}, insert(m, f.id, call field-shape(f.ty)))",
      "examples": [
        {
          "args": {
            "fields": {
              "name": {
                "id": "name",
                "label": "name",
                "ty": "str",
                "required": true,
                "unique": false
              }
            }
          },
          "result": {
            "name": "str"
          }
        },
        {
          "args": {
            "fields": {}
          },
          "result": {}
        }
      ]
    },
    {
      "id": "shape-debug",
      "description": "The Rust Debug name of an expr.rs Shape ({shape:?}).",
      "params": [
        {
          "name": "shape",
          "type": "string"
        }
      ],
      "returns": "string",
      "body": "if shape == 'bool' then 'Bool' else if shape == 'int' then 'Int' else if shape == 'str' then 'Str' else if shape == 'time' then 'Time' else if shape == 'ref' then 'Ref' else if shape == 'list' then 'List' else 'Any'",
      "examples": [
        {
          "args": {
            "shape": "int"
          },
          "result": "Int"
        },
        {
          "args": {
            "shape": "any"
          },
          "result": "Any"
        },
        {
          "args": {
            "shape": "bool"
          },
          "result": "Bool"
        },
        {
          "args": {
            "shape": "str"
          },
          "result": "Str"
        },
        {
          "args": {
            "shape": "time"
          },
          "result": "Time"
        },
        {
          "args": {
            "shape": "ref"
          },
          "result": "Ref"
        },
        {
          "args": {
            "shape": "list"
          },
          "result": "List"
        }
      ]
    },
    {
      "id": "action-debug",
      "description": "The Rust Debug name of an Action ({action:?}).",
      "params": [
        {
          "name": "a",
          "type": "action"
        }
      ],
      "returns": "string",
      "body": "match a { read => 'Read', create => 'Create', update => 'Update', delete => 'Delete', manage => 'Manage' }",
      "examples": [
        {
          "args": {
            "a": "manage"
          },
          "result": "Manage"
        },
        {
          "args": {
            "a": "read"
          },
          "result": "Read"
        }
      ]
    },
    {
      "id": "text-starts-with",
      "description": "Rust str::starts_with, read through the rule language's starts_with primitive (the body language has no string operations).",
      "params": [
        {
          "name": "text",
          "type": "string"
        },
        {
          "name": "prefix",
          "type": "string"
        }
      ],
      "returns": "bool",
      "body": "match eval(tenant-rule-language, expr.starts-with{text: expr.lit(value.str(text)), prefix: expr.lit(value.str(prefix))}, expr-env{record: null, old: null, new: null, param: {}, now: value.time(0), principal: value.str(''), has_role: []}) { Ok(r) => match r { bool(b) => b, _ => false }, Err(e) => false }",
      "examples": [
        {
          "args": {
            "text": "/posts/:slug",
            "prefix": "/"
          },
          "result": true
        },
        {
          "args": {
            "text": "posts",
            "prefix": "/"
          },
          "result": false
        },
        {
          "args": {
            "text": "@ines",
            "prefix": "@"
          },
          "result": true
        },
        {
          "args": {
            "text": "",
            "prefix": "@"
          },
          "result": false
        }
      ]
    },
    {
      "id": "object-problems",
      "description": "schema.rs TenantSchema::problems, the loop over object types: first more than 100 fields; then per field (in id order) an unknown reference target, a list of lists, a unique list, a default that does not check without fields, a read condition that does not check against the fields of the type or is not a truth value (WG-5077); then per constraint (in id order) a check error or a shape other than Bool or Any. Last, a type with a personal field and no retention rule (D-6584).",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "roles",
          "type": "list<role-id>"
        },
        {
          "name": "object",
          "type": "object-type-def"
        }
      ],
      "returns": "list<string>",
      "let": [
        {
          "name": "env",
          "expr": "expr-check-env{fields: call field-shapes(object.fields), params: [], roles}"
        },
        {
          "name": "bare",
          "expr": "expr-check-env{fields: {}, params: [], roles}"
        },
        {
          "name": "field-problems",
          "expr": "fold(f in values(object.fields), ps = [], let at = format('{}.{}', object.id, f.id) in concat(concat(concat(concat(ps, match call ref-target(f.ty) { Some(t) => if get(schema.objects, t) == null then [format('{}: refers to unknown object type {}', at, t)] else [], None => [] }), match f.ty { list(inner) => concat(match inner { list(_) => [format('{}: nested lists are not supported', at)], _ => [] }, if f.unique then [format('{}: a list field cannot be unique', at)] else []), _ => [] }), match f.default { Some(d) => match check(tenant-rule-language, d, bare) { Ok(_) => [], Err(e) => [format('{}: default: {}', at, e)] }, None => [] }), match f.read { Some(r) => match check(tenant-rule-language, r, env) { Ok(s) => if s == 'bool' || s == 'any' then [] else [format('{}: read is {}, not a truth value', at, call shape-debug(s))], Err(e) => [format('{}: read: {}', at, e)] }, None => [] }))"
        },
        {
          "name": "retention-problems",
          "expr": "match object.retention { Some(_) => [], None => if fold(f in values(object.fields), found = false, let personal = match f.personal { Some(_) => true, None => false } in found || personal) then [format('{}: a type with a personal field must declare retention (D-6584)', object.id)] else [] }"
        }
      ],
      "body": "concat(call field-count-problem(object), concat(fold(c in values(object.constraints), ps = field-problems, concat(ps, match check(tenant-rule-language, c.expr, env) { Ok(s) => if s == 'bool' || s == 'any' then [] else [format('{}.{}: constraint is {}, not a truth value', object.id, c.id, call shape-debug(s))], Err(e) => [format('{}.{}: {}', object.id, c.id, e)] })), retention-problems))",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-4"
            },
            "roles": [
              "editor",
              "owner",
              "public",
              "writer"
            ],
            "object": {
              "fixture": "fx-object-type-def-1"
            }
          },
          "result": []
        },
        {
          "description": "behaviour.rs an_inconsistent_schema_change_is_rejected_with_the_reason",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-4"
            },
            "roles": [
              "editor",
              "owner",
              "public",
              "writer"
            ],
            "object": {
              "fixture": "fx-object-type-def-1",
              "with": {
                "constraints.broken": {
                  "id": "broken",
                  "expr": {
                    "cmp": {
                      "op": "eq",
                      "left": {
                        "var": {
                          "scope": "new",
                          "field": "no_such_field"
                        }
                      },
                      "right": {
                        "lit": {
                          "str": "x"
                        }
                      }
                    }
                  },
                  "message": "never"
                }
              }
            }
          },
          "result": [
            "note.broken: unknown field no_such_field"
          ]
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-4"
            },
            "roles": [
              "editor",
              "owner",
              "public",
              "writer"
            ],
            "object": {
              "id": "tag",
              "label": "Tag",
              "fields": {
                "grid": {
                  "id": "grid",
                  "label": "Grid",
                  "ty": {
                    "list": {
                      "list": "int"
                    }
                  },
                  "required": false,
                  "unique": false
                },
                "owner": {
                  "id": "owner",
                  "label": "Owner",
                  "ty": {
                    "ref": {
                      "target": "nobody",
                      "on-delete": "restrict"
                    }
                  },
                  "required": false,
                  "unique": false
                },
                "slugs": {
                  "id": "slugs",
