          "from": "jw-open-i",
          "to": "jw-open-i",
          "on": "jw-token",
          "guard": "event.kid == knownKid",
          "effects": [
            {
              "emit": "jw-verified",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "jw-refresh-i",
          "from": "jw-open-i",
          "to": "jw-open-i",
          "on": "jw-token",
          "guard": "event.metadataHas",
          "effects": [
            {
              "set": "knownKid",
              "to": "event.kid"
            },
            {
              "emit": "jw-refreshed",
              "to": "outbound-gate"
            },
            {
              "emit": "jw-verified",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "jw-reject-i",
          "from": "jw-open-i",
          "to": "jw-open-i",
          "on": "jw-token",
          "effects": [
            {
              "emit": "jw-rejected",
              "to": "web-application"
            }
          ],
          "otherwise": true
        }
      ],
