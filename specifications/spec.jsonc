                    ]
                  },
                  "start": "done",
                  "steps": {
                    "done": {
                      "action": "end"
                    }
                  }
                }
              }
            },
            "principal": {
              "user": "automation:reads"
            },
            "now": 6000,
            "body": {
              "fixture": "fx-event-body-5"
            }
          },
          "result": {
            "new": {
              "id": 1,
              "object": "note",
              "version": 1,
              "created-by": "alpha:writer1",
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "slug": {
                  "str": "n1"
                },
                "status": {
                  "str": "published"
                },
                "title": {
