    {
      "id": "update-record",
      "description": "transition.rs update_record: the object type and the stored record; the candidate is the record with the given fields (a null clears one), the version one higher and updated now; Update is authorised (old the stored record, new the candidate) before anything else about the record is revealed, so authorisation comes before the version check; then each workflow of the object type in id order (workflow-step); when the assignments of the workflows changed the candidate, Update is authorised again for the candidate it now is (old the stored record), so that a step cannot write what the caller could not write directly; then validate-record with old the stored record; accepted, it is a PutRecord and a RecordUpdated event. The event names the transition each workflow fired, by workflow id (transitions, D-7203): found in the passing workflow:<id>:<transition> checks the workflow steps left in the evidence; none fired leaves the member out.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "id",
          "type": "record-id"
        },
        {
          "name": "fields",
          "type": "map<field-id, value>"
        },
        {
          "name": "expected-version",
          "type": "option<u64>"
        }
      ],
      "returns": "decided",
      "errors": "rejection",
      "let": [
        {
          "name": "def",
          "expr": "try call object-def(d, object, action.update)"
        },
        {
          "name": "old",
          "expr": "try call stored(d, object, id, action.update)"
        },
        {
          "name": "candidate",
          "expr": "record{id: old.id, object: old.object, version: old.version + 1, created-by: old.created-by, created-at: old.created-at, updated-at: d.ctx.now, fields: fold(k in keys(fields), m = old.fields, match get(fields, k) { Some(x) => if call value-is-null(x) then remove(m, k) else insert(m, k, x), None => m })}"
        },
        {
          "name": "d1",
          "expr": "try call require(d, action.update, resource.object(object), subject{old, new: candidate})"
        },
        {
          "name": "d2",
          "expr": "try call check-version(d1, old, expected-version)"
        },
        {
          "name": "flow",
          "expr": "fold(w in filter(w in values(d2.tenant.schema.workflows), w.object == object), acc = workflow-outcome{draft: d2, candidate}, try call workflow-step(acc.draft, old, acc.candidate, w))"
        },
        {
          "name": "d3",
          "expr": "if flow.candidate.fields != candidate.fields then try call require(flow.draft, action.update, resource.object(object), subject{old, new: flow.candidate}) else flow.draft"
        },
        {
          "name": "evidence",
          "expr": "try call validation-into-result(try call validate-record(d3.tenant, d3.coverage, d3.tenant.schema, def, flow.candidate, old, d.ctx.principal, d.ctx.now), d3.evidence)"
        },
        {
          "name": "fired",
          "expr": "fold(w in filter(w in values(d2.tenant.schema.workflows), w.object == object), m = {}, match find(t in w.transitions, any(c in flow.draft.evidence, c.passed && c.rule == format('workflow:{}:{}', w.id, t.name))) { Some(t) => insert(m, w.id, t.name), None => m })"
        }
      ],
      "body": "decided{draft: draft{tenant: d3.tenant, ctx: d3.ctx, coverage: d3.coverage, ops: concat(d3.ops, [delta-op.put-record(flow.candidate)]), events: concat(d3.events, [event-body.record-updated{before: old, after: flow.candidate, transitions: if keys(fired) == [] then null else fired}]), effects: d3.effects, evidence: evidence, next-record: d3.next-record}, output: output.record{object, id, version: flow.candidate.version}}",
      "examples": [
        {
          "description": "behaviour.rs a_stale_expected_version_is_a_conflict: the first edit, by the note's writer.",
          "args": {
            "d": {
              "fixture": "fx-draft-4"
