          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "draftText",
          "type": "string",
          "initial": "x",
          "repr": "string"
        }
      ],
      "states": [
        {
          "id": "ds-open-i",
          "name": "Tenant serving"
        }
      ],
      "transitions": [
        {
          "id": "ds-schema-change-i",
          "from": "ds-open-i",
          "to": "ds-open-i",
          "on": "ds-schema-changed",
          "otherwise": true,
          "effects": [
            {
              "set": "schemaVersion",
              "to": "schemaVersion + 1"
            }
          ]
        },
        {
          "id": "ds-save-i",
          "from": "ds-open-i",
          "to": "ds-open-i",
          "on": "ds-save-requested",
          "guard": "event.draftVersion == schemaVersion",
          "effects": [
            {
              "set": "saved",
