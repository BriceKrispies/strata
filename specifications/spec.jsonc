    {"id":"ui-tenants-share-nothing","name":"A second tenant on the same substrate shares nothing with the first","verifies":["idn-009","run-002","run-001","cms-003"],"browsers":["visitor","owner","thief"],"description":"Journey of tests/e2e/site.spec.js, the test named \"a second tenant on the same substrate shares nothing with the first\". Hand-written test keeps: the screenshot.","steps":[{"goto":{"screen":"screen-front-page","host":"tidewater.localhost:4200"}},{"expectTitle":{"text":"Tidewater Review"}},{"expectRole":{"role":"heading","level":2,"name":"High Water at Six"}},{"expectAttribute":{"attribute":"data-accent","value":"ink"}},{"expectAttribute":{"attribute":"data-paper","value":"stone"}},{"expectNoText":{"text":"The Jig Is the Work"}},{"goto":{"screen":"screen-sign-in","host":"tidewater.localhost:4200"}},{"fill":{"form":"form-sign-in","field":"login","value":"ines"}},{"fill":{"form":"form-sign-in","field":"password","value":"strata-dev-ines"}},{"submit":{"form":"form-sign-in"}},{"expectText":{"text":"The name or password is not right.","within":{"role":"alert"}}},{"switchBrowser":"owner"},{"goto":{"screen":"screen-sign-in"}},{"fill":{"form":"form-sign-in","field":"login","value":"admin"}},{"fill":{"form":"form-sign-in","field":"password","value":"strata-dev-admin"}},{"submit":{"form":"form-sign-in"}},{"expectRole":{"role":"heading","level":1,"name":"Writing desk"}},{"capture":{"name":"ownerSession","from":"cookie","cookie":"__Host-strata_sid"}},{"switchBrowser":"thief"},{"setCookie":{"name":"__Host-strata_sid","value":"${ownerSession}","host":"tidewater.localhost:4200","attributes":{"httpOnly":true,"secure":true,"sameSite":"Strict","path":"/"}}},{"goto":{"screen":"screen-desk","host":"tidewater.localhost:4200"}},{"expectRole":{"role":"heading","level":1,"name":"Sign in to continue"}},{"apiCall":{"method":"GET","host":"tidewater.localhost:4200","path":"/api/session","expectJson":{"session.authenticated":false}}},{"apiCall":{"method":"GET","host":"tidewate