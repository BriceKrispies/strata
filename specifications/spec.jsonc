    {"id":"tm-write-refused","name":"Write refused","description":"A write to the moving tenant is refused during its read-only window.","delivery":"at-most-once"},
    {"id":"tm-freeze-requested","name":"Freeze requested","description":"The read-only window of the move begins.","payload":[{"name":"move-id","type":"move-id"}]},
