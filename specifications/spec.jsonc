    {
      "id": "draft-reject",
      "description": "transition.rs Draft::reject: the error of a kind and message with the draft evidence, which gains a failed intent:<kind> check when every check in it passed.",
      "params": [
        {
          "name": "evidence",
          "type": "list<check>"
        },
        {
          "name": "kind",
          "type": "error-kind"
        },
        {
          "name": "message",
          "type": "string"
        }
      ],
      "returns": "rejection",
      "body": "rejection.rejected(domain-error{kind, message, evidence: if all(c in evidence, c.passed) then concat(evidence, [check{rule: format('intent:{}', call error-kind-snake(kind)), passed: false, detail: message}]) else evidence})",
      "examples": [
        {
          "args": {
            "evidence": [
              {
                "rule": "default:note.status",
                "passed": true,
                "detail": "'draft'"
              }
            ],
            "kind": "evaluation",
            "message": "default of x: oops"
          },
          "result": {
            "rejected": {
              "kind": "evaluation",
              "message": "default of x: oops",
              "evidence": [
                {
                  "rule": "default:note.status",
                  "passed": true,
                  "detail": "'draft'"
                },
                {
                  "rule": "intent:evaluation",
                  "passed": false,
                  "detail": "default of x: oops"
                }
              ]
            }
          }
        },
        {
          "args": {
            "evidence": [
              {
                "rule": "policy:none",
                "passed": false,
                "detail": "no policy grants"
              }
            ],
            "kind": "unauthorized",
            "message": "m"
          },
          "result": {
            "rejected": {
              "kind": "unauthorized",
              "message": "m",
              "evidence": [
                {
                  "rule": "policy:none",
                  "passed": false,
                  "detail": "no policy grants"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "defaults",
      "description": "transition.rs create_record, the defaults (lines 409-437): the given fields without nulls, then for each declared field (in id order) the intent leaves out entirely and that has a default, the default evaluated with no record, no parameters and the context's time, principal and roles (rules.rs roles_of of the tenant); a null result is left out, any other value is set with a passed default:<object>.<field> check; an evaluation error rejects the intent with Evaluation (draft-reject). evidence is the draft evidence so far; texts holds the printed default expressions.",
      "params": [
        {
          "name": "object",
          "type": "object-type-def"
        },
        {
          "name": "fields",
          "type": "map<field-id, value>"
        },
        {
          "name": "principal",
          "type": "principal"
        },
        {
          "name": "now",
          "type": "timestamp"
        },
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "evidence",
          "type": "list<check>"
        },
        {
          "name": "texts",
          "type": "map<field-id, string>"
        }
      ],
      "returns": "defaults-outcome",
      "errors": "rejection",
      "let": [
        {
          "name": "roles",
          "expr": "call roles-of(tenant, principal)"
        },
        {
          "name": "env",
          "expr": "expr-env{record: null, old: null, new: null, param: {}, now: value.time(now), principal: call principal-value(principal), has_role: roles}"
        },
        {
          "name": "given",
          "expr": "fold(k in keys(fields), m = fields, match get(fields, k) { Some(x) => if call value-is-null(x) then remove(m, k) else m, None => m })"
        }
      ],
      "body": "fold(f in values(object.fields), a = defaults-outcome{values: given, evidence}, if get(fields, f.id) != null then a else match f.default { None => a, Some(d) => match eval(tenant-rule-language, d, env) { Ok(x) => if call value-is-null(x) then a else defaults-outcome{values: insert(a.values, f.id, x), evidence: concat(a.evidence, [check{rule: format('default:{}.{}', object.id, f.id), passed: true, detail: match get(texts, f.id) { Some(t) => t, None => '' }}])}, Err(e) => fail(call draft-reject(a.evidence, error-kind.evaluation, format('default of {}: {}', f.id, e))) } })",
      "examples": [
        {
          "description": "behaviour.rs create_applies_defaults_and_allocates_the_next_id: status defaults to 'draft'.",
          "args": {
            "object": {
              "id": "note",
              "label": "Note",
              "fields": {
                "author": {
                  "id": "author",
                  "label": "Author",
                  "ty": {
                    "ref": {
                      "target": "person",
                      "on-delete": "set-null"
                    }
                  },
                  "required": false,
                  "unique": false
                },
                "body": {
                  "id": "body",
                  "label": "body",
                  "ty": "str",
                  "required": false,
                  "unique": false
                },
                "published_at": {
                  "id": "published_at",
                  "label": "published_at",
                  "ty": "time",
                  "required": false,
                  "unique": false
                },
                "rank": {
                  "id": "rank",
                  "label": "rank",
                  "ty": "int",
                  "required": false,
                  "unique": false
                },
                "slug": {
                  "id": "slug",
                  "label": "slug",
                  "ty": "str",
                  "required": true,
                  "unique": true
                },
                "status": {
                  "id": "status",
                  "label": "status",
                  "ty": "str",
                  "required": true,
                  "unique": false,
                  "default": {
                    "lit": {
