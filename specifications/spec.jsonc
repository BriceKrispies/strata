        },
        {
          "name": "data",
          "type": "json",
          "personal": "other",
          "description": "The whole step as canonical JSON: its state, attempts, step key, typed result and the error of each failed attempt (WFL-1531, SCH-1524)."
        }
      ],
      "retention": "Ninety days after the run they belong to ended (rec-workflow-step-run): the janitor removes them with the run (D-7703).",
      "erasure": {
        "point": "the deletion of the tenant file"
      },
      "description": "Table automation_steps of a tenant file: one row per step a run ran (rec-workflow-step-run, WFL-1531), replaced at each attempt."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-automation-exceptions",
      "name": "Automation exceptions (tenant file)",
      "scope": "platform",
      "key": [
        "seq"
      ],
      "unique": [
        [
          "id"
        ]
      ],
      "fields": [
        {
          "name": "seq",
          "type": "u64",
          "description": "Assigned on insert: the cursor of list-automation-exceptions."
        },
        {
          "name": "id",
          "type": "identifier"
        },
        {
          "name": "kind",
          "type": "automation-exception-kind"
        },
        {
          "name": "settled",
          "type": "bool"
        },
        {
          "name": "data",
          "type": "json",
          "personal": "other",
          "description": "The whole record as canonical JSON: its reason, trigger, automation, run, step, event, job, hop and a detail that names ids and limits only (SCH-1532)."
        }
      ],
      "retention": "A declined or held row ninety days after it was written; a parked or dead-lettered row until the tenant owner settles it (OPS-348) and then ninety days after it was written; the janitor removes the rows past it (D-7703). An unsettled parked or dead-lettered row is never removed.",
      "erasure": {
        "point": "the deletion of the tenant file"
      },
      "description": "Table automation_exceptions of a tenant file: every declined, held, parked or dead-lettered piece of automation work with its reason (rec-automation-exception, SCH-1532), written once in the transaction that decides it."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-job-wake",
      "name": "Job wake index (control database)",
