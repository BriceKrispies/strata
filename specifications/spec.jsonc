    {
      "id": "stepup-flow",
      "name": "Sensitive operations",
      "subject": "identity-service",
      "initial": "stepup-open",
      "description": "An operation presented with a session. A sensitive operation is refused when the last authentication is older than the step-up age of 15 minutes, and when the session now appears from another network context than the one that authenticated it unless the person has authenticated again since.",
      "states": [
        {
          "id": "stepup-open",
          "name": "Deciding"
        }
      ],
      "transitions": [
        {
          "id": "stepup-accept-without-age",
          "from": "stepup-open",
          "to": "stepup-open",
          "on": "stepup-presented",
          "faultOnly": true,
          "guard": "(!event.sensitive || !event.contextChanged || event.authSinceChange) && (!(!event.sensitive || event.authAge <= 15))",
          "description": "Defect: accepts although the condition \"follows a fresh authentication\" does not hold.",
          "effects": [
            {
              "emit": "stepup-accepted"
            }
          ]
        },
        {
          "id": "stepup-accept-without-network",
          "from": "stepup-open",
          "to": "stepup-open",
          "on": "stepup-presented",
          "faultOnly": true,
          "guard": "(!event.sensitive || event.authAge <= 15) && (!(!event.sensitive || !event.contextChanged || event.authSinceChange))",
          "description": "Defect: accepts although the condition \"keeps the authenticated network context\" does not hold.",
          "effects": [
            {
              "emit": "stepup-accepted"
            }
          ]
        },
        {
          "id": "stepup-accept",
          "from": "stepup-open",
          "to": "stepup-open",
          "on": "stepup-presented",
          "guard": "(!event.sensitive || event.authAge <= 15) && (!event.sensitive || !event.contextChanged || event.authSinceChange)",
          "effects": [
            {
              "emit": "stepup-accepted"
            }
          ]
        },
        {
          "id": "stepup-refuse",
          "from": "stepup-open",
          "to": "stepup-open",
          "on": "stepup-presented",
          "effects": [
            {
              "emit": "stepup-refused"
            }
          ]
        }
      ]
    },
    {
      "id": "stepup-flow-impl",
      "name": "Sensitive operations (implementation)",
      "subject": "identity-service",
      "level": "implementation",
      "initial": "stepup-open-i",
      "description": "An operation presented with a session. A sensitive operation is refused when the last authentication is older than the step-up age of 15 minutes, and when the session now appears from another network context than the one that authenticated it unless the person has authenticated again since. This is the decision as the code takes it: it keeps nothing between presentations.",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "states": [
        {
          "id": "stepup-open-i",
          "name": "Deciding"
        }
      ],
      "transitions": [
        {
          "id": "stepup-accept-i",
          "from": "stepup-open-i",
          "to": "stepup-open-i",
          "on": "stepup-presented",
          "guard": "(!event.sensitive || event.authAge <= 15) && (!event.sensitive || !event.contextChanged || event.authSinceChange)",
          "effects": [
            {
              "emit": "stepup-accepted",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "stepup-refuse-i",
          "from": "stepup-open-i",
          "to": "stepup-open-i",
          "on": "stepup-presented",
          "otherwise": true,
          "effects": [
            {
              "emit": "stepup-refused",
              "to": "web-application"
            }
          ]
        }
      ],
      "refines": "stepup-flow",
