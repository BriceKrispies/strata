        }
      ]
    },
    {
      "id": "fired-transitions",
      "description": "triggers.rs fired: the workflow transitions a record-updated event says it fired, in workflow id order.",
      "params": [
        {
          "name": "transitions",
          "type": "option<map<workflow-id, string>>"
        }
      ],
      "returns": "list<string>",
      "body": "match transitions { Some(m) => values(m), None => [] }",
      "examples": [
        {
          "args": {
            "transitions": null
          },
          "result": []
        },
        {
          "args": {
            "transitions": {
              "note_status": "publish",
              "zeta": "go"
            }
          },
          "result": [
            "publish",
            "go"
          ]
        }
      ]
    },
    {
      "id": "trigger-matches",
      "description": "triggers.rs matches (D-6522, D-7200): whether the event a trigger subscribes to matches a domain event: the kind and the object type and, for record-updated naming a transition, a transition the update fired (D-7203). The other trigger events come from engines outside the kernel and match no kernel event.",
      "params": [
        {
          "name": "on",
          "type": "trigger-event"
        },
        {
          "name": "body",
          "type": "event-body"
        }
      ],
      "returns": "bool",
      "body": "match on { record-created{object} => match body { record-created{record} => record.object == object, _ => false }, record-updated{object, transition} => match body { record-updated{after, transitions} => after.object == object && match transition { None => true, Some(name) => any(t in call fired-transitions(transitions), t == name) }, _ => false }, record-deleted{object} => match body { record-deleted{before} => before.object == object, _ => false }, _ => false }",
      "examples": [
        {
          "description": "A record created of the object type.",
          "args": {
            "on": {
              "record-created": {
                "object": "note"
              }
            },
            "body": {
              "fixture": "fx-event-body-1"
            }
          },
          "result": true
        },
        {
          "description": "A record created of another object type.",
          "args": {
            "on": {
              "record-created": {
                "object": "person"
              }
            },
            "body": {
              "fixture": "fx-event-body-1"
            }
          },
          "result": false
        },
        {
          "description": "An update of the object type with no transition named matches whatever it fired.",
          "args": {
            "on": {
              "record-updated": {
                "object": "note"
              }
            },
            "body": {
              "fixture": "fx-event-body-2"
            }
          },
          "result": true
        },
        {
          "description": "An update that fired the transition the trigger names.",
          "args": {
            "on": {
              "record-updated": {
                "object": "note",
                "transition": "publish"
              }
            },
            "body": {
              "fixture": "fx-event-body-2",
              "with": {
                "record-updated.transitions": {
                  "note_status": "publish"
                }
              }
            }
          },
          "result": true
        },
        {
          "description": "An update that fired another transition.",
          "args": {
            "on": {
              "record-updated": {
                "object": "note",
                "transition": "publish"
              }
            },
            "body": {
              "fixture": "fx-event-body-2",
              "with": {
                "record-updated.transitions": {
                  "note_status": "unpublish"
                }
              }
            }
          },
          "result": false
        },
        {
          "description": "An update that fired no transition, for a trigger that names one.",
          "args": {
            "on": {
              "record-updated": {
                "object": "note",
                "transition": "publish"
              }
            },
            "body": {
              "fixture": "fx-event-body-2"
            }
          },
          "result": false
        },
        {
          "description": "An update of another object type.",
          "args": {
            "on": {
              "record-updated": {
                "object": "person"
              }
            },
            "body": {
              "fixture": "fx-event-body-2"
            }
          },
          "result": false
        },
        {
          "description": "A record deleted of the object type.",
          "args": {
            "on": {
              "record-deleted": {
                "object": "note"
              }
            },
            "body": {
              "fixture": "fx-event-body-3"
            }
          },
          "result": true
        },
        {
          "description": "A record deleted of another object type.",
          "args": {
            "on": {
              "record-deleted": {
                "object": "person"
              }
            },
            "body": {
              "fixture": "fx-event-body-3"
            }
          },
          "result": false
        },
        {
          "description": "A record event does not match another kind of event.",
          "args": {
            "on": {
              "record-created": {
                "object": "note"
              }
            },
            "body": {
              "fixture": "fx-event-body-3"
            }
          },
          "result": false
        },
        {
          "description": "An event of an engine outside the kernel matches no kernel event.",
          "args": {
            "on": {
              "ledger-posted": {
                "unit": "credits"
              }
            },
            "body": {
              "fixture": "fx-event-body-1"
            }
          },
          "result": false
        },
        {
          "description": "An update trigger does not match a creation.",
          "args": {
            "on": {
              "record-updated": {
                "object": "note"
              }
            },
            "body": {
              "fixture": "fx-event-body-1"
            }
          },
          "result": false
        },
        {
          "description": "A deletion trigger does not match a creation.",
          "args": {
            "on": {
              "record-deleted": {
                "object": "note"
              }
            },
            "body": {
              "fixture": "fx-event-body-1"
            }
          },
          "result": false
        }
      ]
    },
    {
      "id": "event-bound-params",
      "description": "triggers.rs event_params (D-6523): the parameters an event binds for a trigger: seq, at and hop, and for record-updated transition: the transition the trigger names, else the first the update fired in workflow id order, else null. (event-params lists the names, for the check of a definition.)",
      "params": [
        {
          "name": "event",
          "type": "domain-event"
        },
        {
          "name": "hop",
          "type": "u32"
        },
        {
          "name": "on",
          "type": "trigger-event"
        }
      ],
      "returns": "map<string, value>",
      "body": "let base = insert(insert(insert({}, 'seq', value.int(event.seq)), 'at', value.time(event.at)), 'hop', value.int(hop)) in match event.body { record-updated{transitions} => insert(base, 'transition', match (match on { record-updated{transition: named} => match named { Some(n) => n, None => get(call fired-transitions(transitions), 0) }, _ => get(call fired-transitions(transitions), 0) }) { Some(n) => value.str(n), None => value.null }), _ => base }",
      "examples": [
        {
          "description": "A record event binds seq, at and hop.",
          "args": {
            "event": {
              "fixture": "fx-domain-event-2",
              "with": {
                "correlation": "test-6000"
              }
            },
            "hop": 0,
            "on": {
              "record-created": {
                "object": "note"
              }
            }
          },
          "result": {
            "at": {
              "time": 6000
            },
            "hop": {
              "int": 0
            },
            "seq": {
              "int": 7
            }
          }
        },
        {
          "description": "An update binds the transition the trigger names.",
          "args": {
            "event": {
              "fixture": "fx-domain-event-1"
            },
            "hop": 2,
            "on": {
              "record-updated": {
                "object": "note",
                "transition": "go"
              }
            }
          },
          "result": {
            "at": {
              "time": 6000
            },
            "hop": {
              "int": 2
            },
            "seq": {
              "int": 7
            },
            "transition": {
              "str": "go"
            }
          }
        },
        {
          "description": "A trigger that names none gets the first transition fired, in workflow id order.",
          "args": {
            "event": {
              "fixture": "fx-domain-event-1"
            },
            "hop": 0,
            "on": {
              "record-updated": {
                "object": "note"
              }
            }
          },
          "result": {
            "at": {
              "time": 6000
            },
            "hop": {
              "int": 0
            },
            "seq": {
              "int": 7
            },
            "transition": {
              "str": "publish"
            }
          }
        },
        {
          "description": "An update that fired nothing binds null.",
          "args": {
            "event": {
              "tenant": "alpha",
              "seq": 7,
              "revision": 7,
              "at": 6000,
              "principal": {
                "user": "alpha:editor"
              },
              "correlation": "test-6000",
              "body": {
                "record-updated": {
                  "before": {
                    "id": 1,
                    "object": "note",
                    "version": 1,
                    "created-by": "alpha:writer1",
                    "created-at": 5000,
                    "updated-at": 5000,
                    "fields": {
                      "slug": {
                        "str": "n1"
                      },
                      "status": {
                        "str": "draft"
                      },
                      "title": {
                        "str": "First"
                      }
                    }
                  },
                  "after": {
                    "id": 1,
                    "object": "note",
                    "version": 1,
                    "created-by": "alpha:writer1",
                    "created-at": 5000,
                    "updated-at": 5000,
                    "fields": {
                      "slug": {
                        "str": "n1"
                      },
                      "status": {
                        "str": "published"
                      },
                      "title": {
                        "str": "First"
                      }
                    }
                  }
                }
              }
            },
            "hop": 0,
            "on": {
              "record-updated": {
                "object": "note"
              }
            }
          },
          "result": {
            "at": {
              "time": 6000
            },
            "hop": {
              "int": 0
            },
            "seq": {
              "int": 7
            },
            "transition": "null"
          }
        },
        {
          "description": "A trigger that is no update trigger binds the first transition fired too.",
          "args": {
            "event": {
              "fixture": "fx-domain-event-1",
              "with": {
                "body.record-updated.transitions": {
                  "note_status": "publish"
                }
              }
            },
            "hop": 0,
            "on": {
              "record-created": {
                "object": "note"
              }
            }
          },
          "result": {
            "at": {
              "time": 6000
            },
            "hop": {
              "int": 0
            },
            "seq": {
              "int": 7
            },
            "transition": {
              "str": "publish"
            }
          }
        }
      ]
    },
    {
      "id": "value-canonical-leaf",
      "description": "canon.rs canonical_json of a value that is not a list: the externally tagged JSON of strata_kernel::Value (\"Null\", {\"Bool\":true}, {\"Int\":5}, {\"Str\":\"x\"}, {\"Time\":5}, {\"Ref\":7}), a string written as serde_json writes it. A list gives the empty text here.",
      "params": [
        {
          "name": "v",
          "type": "value"
        }
      ],
      "returns": "string",
      "body": "match v { null => '\"Null\"', bool(b) => '{\"Bool\":' + format('{}', b) + '}', int(n) => '{\"Int\":' + format('{}', n) + '}', str(s) => '{\"Str\":' + format('{:json}', s) + '}', time(t) => '{\"Time\":' + format('{}', t) + '}', ref(r) => '{\"Ref\":' + format('{}', r) + '}', list(_) => '' }",
      "examples": [
        {
          "args": {
            "v": "null"
          },
          "result": "\"Null\""
        },
        {
          "args": {
            "v": {
              "bool": true
            }
          },
          "result": "{\"Bool\":true}"
        },
        {
          "args": {
            "v": {
              "int": -5
            }
          },
          "result": "{\"Int\":-5}"
        },
        {
          "args": {
            "v": {
              "str": "a\"b"
            }
          },
          "result": "{\"Str\":\"a\\\"b\"}"
        },
        {
          "args": {
            "v": {
              "time": 6000
            }
          },
          "result": "{\"Time\":6000}"
        },
        {
          "args": {
            "v": {
              "ref": 7
            }
          },
          "result": "{\"Ref\":7}"
        },
        {
          "args": {
            "v": {
              "list": []
            }
          },
          "result": ""
        }
      ]
    },
    {
      "id": "value-canonical-json",
      "description": "canon.rs canonical_json of a value (triggers.rs hashes it for the run key, D-6534): a list is {\"List\":[item,item]}. A list holding a list is written one level deep only, because the body language has no recursion; a run key is a scalar or a list of scalars.",
      "params": [
        {
          "name": "v",
          "type": "value"
        }
      ],
      "returns": "string",
      "body": "match v { list(items) => '{\"List\":[' + fold(i in items, acc = '', if acc == '' then call value-canonical-leaf(i) else acc + ',' + call value-canonical-leaf(i)) + ']}', _ => call value-canonical-leaf(v) }",
      "examples": [
        {
          "args": {
            "v": {
              "str": "x"
            }
          },
          "result": "{\"Str\":\"x\"}"
        },
        {
          "args": {
            "v": {
              "list": []
            }
          },
          "result": "{\"List\":[]}"
        },
        {
          "args": {
            "v": {
              "list": [
                {
                  "int": 1
                },
                {
                  "str": "a"
                },
                "null"
              ]
            }
          },
          "result": "{\"List\":[{\"Int\":1},{\"Str\":\"a\"},\"Null\"]}"
        }
      ]
    },
    {
      "id": "trigger-scopes-of",
      "description": "triggers.rs scopes: the scopes of an event as the automation principal may observe them: none when it may not read the record the event leaves (the record created, the record after an update, the record deleted), so the trigger does not observe the event; the scope old of an update only when it may read the record as it was (D-7201). Visibility is the read decision of visible, which follows no reference (difference 2 of the differential).",
      "params": [
        {
          "name": "t",
          "type": "tenant-state"
        },
        {
          "name": "principal",
          "type": "principal"
        },
        {
          "name": "now",
          "type": "timestamp"
        },
        {
          "name": "body",
          "type": "event-body"
        }
      ],
      "returns": "option<trigger-scopes>",
      "body": "match body { record-created{record} => if call visible(t, principal, record, now) then trigger-scopes{record: record, new: record} else null, record-updated{before, after} => if call visible(t, principal, after, now) then trigger-scopes{old: if call visible(t, principal, before, now) then before else null, new: after} else null, record-deleted{before} => if call visible(t, principal, before, now) then trigger-scopes{old: before} else null, _ => null }",
      "examples": [
        {
          "description": "An editor automation reads the created record: it binds record and new.",
          "args": {
            "t": {
              "fixture": "fx-tenant-state-26"
            },
            "principal": {
              "user": "automation:award"
            },
            "now": 6000,
            "body": {
              "fixture": "fx-event-body-4"
            }
          },
          "result": {
            "record": {
              "id": 1,
              "object": "note",
              "version": 1,
              "created-by": "alpha:writer1",
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "slug": {
                  "str": "n1"
                },
                "status": {
                  "str": "published"
                },
                "title": {
                  "str": "First"
                }
              }
            },
            "new": {
              "id": 1,
              "object": "note",
              "version": 1,
              "created-by": "alpha:writer1",
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "slug": {
                  "str": "n1"
                },
                "status": {
                  "str": "published"
                },
                "title": {
                  "str": "First"
                }
              }
            }
          }
        },
        {
          "description": "An automation with no role reads nothing, so it does not observe the event.",
          "args": {
            "t": {
              "fixture": "fx-tenant-state-26"
            },
            "principal": {
              "user": "automation:quiet"
            },
            "now": 6000,
