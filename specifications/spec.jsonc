    {
      "id": "view-read",
      "description": "backend ops.rs view, one read of the kernel (kernel-read): a rejection is answered as the error body (api-error-of); InsufficientState naming a need asks for it.",
      "params": [
        {
          "name": "state",
          "type": "state"
        },
        {
          "name": "request",
          "type": "read-request"
        },
        {
          "name": "context",
          "type": "context"
        },
        {
          "name": "texts",
          "type": "intent-texts"
        }
      ],
      "returns": "read-result",
      "errors": "api-failure",
      "body": "match call kernel-read(state, request, context, texts) { Ok(r) => r, Err(e) => match e { rejected(d) => match d.missing { Some(n) => if d.kind == error-kind.insufficient-state then fail(api-failure.insufficient-state(n)) else fail(api-failure.rejected(call api-error-of(d, context))), None => fail(api-failure.rejected(call api-error-of(d, context))) } } }",
