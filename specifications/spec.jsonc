      "states": [
        {
          "id": "asrt-open",
          "name": "Deciding"
        }
      ],
      "transitions": [
        {
          "id": "asrt-accept-without-signer",
          "from": "asrt-open",
          "to": "asrt-open",
          "on": "asrt-presented",
          "faultOnly": true,
          "guard": "(!(event.signer == 'identity-service'))",
          "description": "Defect: accepts although the condition \"is signed by the identity service\" does not hold.",
          "effects": [
            {
              "emit": "asrt-accepted"
            }
          ]
        },
        {
          "id": "asrt-accept",
          "from": "asrt-open",
          "to": "asrt-open",
          "on": "asrt-presented",
          "guard": "(event.signer == 'identity-service')",
          "effects": [
            {
              "emit": "asrt-accepted"
            }
          ]
        },
        {
          "id": "asrt-refuse",
          "from": "asrt-open",
          "to": "asrt-open",
          "on": "asrt-presented",
          "effects": [
            {
              "emit": "asrt-refused"
            }
          ]
        }
      ]
    },
    {
      "id": "asrt-flow-impl",
      "name": "Caller identity assertion (implementation)",
      "subject": "gateway",
      "level": "implementation",
      "initial": "asrt-open-i",
      "description": "A component other than the identity service is handed a caller identity. It accepts the identity only from an assertion that the identity service signed. This is the decision as the code takes it: it keeps nothing between presentations.",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "states": [
        {
          "id": "asrt-open-i",
          "name": "Deciding"
        }
      ],
      "transitions": [
        {
          "id": "asrt-accept-i",
          "from": "asrt-open-i",
          "to": "asrt-open-i",
          "on": "asrt-presented",
          "guard": "(event.signer == 'identity-service')",
          "effects": [
            {
              "emit": "asrt-accepted",
              "to": "runtime"
            }
          ]
        },
        {
          "id": "asrt-refuse-i",
          "from": "asrt-open-i",
          "to": "asrt-open-i",
          "on": "asrt-presented",
          "otherwise": true,
          "effects": [
            {
              "emit": "asrt-refused",
              "to": "runtime"
            }
          ]
        }
      ],
      "refines": "asrt-flow",
      "refinement": {
        "states": {
          "asrt-open-i": "asrt-open"
        },
        "variables": {},
        "transitions": {
          "asrt-accept-i": "asrt-accept",
          "asrt-refuse-i": "asrt-refuse"
        }
      },
      "storage": {
        "record": "rec-identity-decision",
        "key": "decision-id",
        "creates": true
      },
      "realisation": "target"
    },
    {
      "id": "session-lifetime-flow",
      "name": "Session lifetime",
      "subject": "identity-service",
      "initial": "sl-new",
      "description": "One session and its two lifetimes. The session is accepted only while the time since it was last used is within the idle lifetime and the time since sign-in is within the absolute lifetime; a session past either is ended and refused from then on. The realm gives both lifetimes; the shorter one ends the session first. One model tick is one hour.",
      "variables": [
        {
          "name": "issuedAt",
          "type": "number",
          "initial": 0
        },
        {
          "name": "lastUsed",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "sl-live",
          "name": "Live"
        },
        {
          "id": "sl-over",
          "name": "Ended"
        },
        {
          "id": "sl-new",
          "name": "Not yet issued"
        }
      ],
      "transitions": [
        {
          "id": "sl-issue",
          "from": "sl-new",
          "to": "sl-live",
          "on": "sl-issued",
          "effects": [
            {
              "set": "issuedAt",
              "to": "time"
            },
            {
              "set": "lastUsed",
              "to": "time"
            }
          ]
        },
        {
          "id": "sl-accept-idle-expired",
          "from": "sl-live",
          "to": "sl-live",
          "on": "sl-used",
          "guard": "lastUsed <= time && time - lastUsed > event.idleHours && issuedAt <= time && time - issuedAt <= event.absoluteHours",
          "effects": [
            {
              "set": "lastUsed",
              "to": "time"
            },
            {
              "emit": "sl-session-valid"
            }
          ],
          "faultOnly": true,
          "description": "Defect: ignores the idle lifetime."
        },
        {
          "id": "sl-accept-absolute-expired",
          "from": "sl-live",
          "to": "sl-live",
          "on": "sl-used",
          "guard": "lastUsed <= time && time - lastUsed <= event.idleHours && issuedAt <= time && time - issuedAt > event.absoluteHours",
          "effects": [
            {
              "set": "lastUsed",
              "to": "time"
            },
            {
              "emit": "sl-session-valid"
            }
          ],
          "faultOnly": true,
          "description": "Defect: ignores the absolute lifetime."
        },
        {
          "id": "sl-accept",
          "from": "sl-live",
          "to": "sl-live",
          "on": "sl-used",
          "guard": "lastUsed <= time && time - lastUsed <= event.idleHours && issuedAt <= time && time - issuedAt <= event.absoluteHours",
          "effects": [
            {
              "set": "lastUsed",
              "to": "time"
            },
            {
              "emit": "sl-session-valid"
            }
          ]
        },
        {
          "id": "sl-expire",
          "from": "sl-live",
          "to": "sl-over",
          "on": "sl-used",
          "effects": [
            {
              "emit": "sl-session-ended"
            }
          ]
        },
        {
          "id": "sl-refuse-ended",
          "from": "sl-over",
          "to": "sl-over",
          "on": "sl-used",
          "effects": [
            {
              "emit": "sl-session-ended"
            }
          ]
        }
      ],
      "realisation": "target"
    },
    {
      "level": "implementation",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "id": "session-lifetime-flow-impl",
      "name": "Session lifetime (implementation)",
      "subject": "identity-service",
      "initial": "sl-new-i",
      "description": "The lifetimes of one session as the identity service keeps them (rec-session-lifetime): the time of sign-in and the time of last use, in milliseconds, against the idle and absolute lifetimes that the realm gives in hours. The refinement reads one model tick as one hour (timeScale 3600000).",
      "variables": [
        {
          "name": "issuedAt",
          "type": "number",
          "initial": 0,
          "repr": "timestamp"
        },
        {
          "name": "lastUsed",
          "type": "number",
          "initial": 0,
          "repr": "timestamp"
        }
      ],
      "states": [
        {
          "id": "sl-live-i",
          "name": "Live",
          "ignores": [
            "sl-issued"
          ]
        },
        {
          "id": "sl-over-i",
          "name": "Ended",
          "ignores": [
            "sl-issued"
          ]
        },
        {
          "id": "sl-new-i",
          "name": "Not yet issued",
          "ignores": [
            "sl-used"
          ]
        }
      ],
      "transitions": [
        {
          "id": "sl-issue-i",
          "from": "sl-new-i",
          "to": "sl-live-i",
          "on": "sl-issued",
          "effects": [
            {
              "set": "issuedAt",
              "to": "time"
            },
            {
              "set": "lastUsed",
              "to": "time"
            }
          ],
          "otherwise": true
        },
        {
          "id": "sl-accept-i",
          "from": "sl-live-i",
          "to": "sl-live-i",
          "on": "sl-used",
          "guard": "lastUsed <= time && time - lastUsed <= event.idleHours * 3600000 && issuedAt <= time && time - issuedAt <= event.absoluteHours * 3600000",
          "effects": [
            {
              "set": "lastUsed",
              "to": "time"
            },
            {
              "emit": "sl-session-valid",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "sl-expire-i",
          "from": "sl-live-i",
          "to": "sl-over-i",
          "on": "sl-used",
          "effects": [
            {
              "emit": "sl-session-ended",
              "to": "gateway"
            }
          ],
          "otherwise": true
        },
        {
          "id": "sl-refuse-ended-i",
          "from": "sl-over-i",
          "to": "sl-over-i",
          "on": "sl-used",
          "effects": [
            {
              "emit": "sl-session-ended",
              "to": "gateway"
            }
          ],
          "otherwise": true
        }
      ],
      "refines": "session-lifetime-flow",
      "refinement": {
        "states": {
          "sl-live-i": "sl-live",
          "sl-over-i": "sl-over",
          "sl-new-i": "sl-new"
        },
        "variables": {
          "issuedAt": "issuedAt / 3600000",
          "lastUsed": "lastUsed / 3600000"
        },
        "transitions": {
          "sl-accept-i": "sl-accept",
          "sl-expire-i": "sl-expire",
          "sl-refuse-ended-i": "sl-refuse-ended",
          "sl-issue-i": "sl-issue"
        },
        "timeScale": 3600000
      },
      "storage": {
        "record": "rec-session-lifetime",
        "key": "session-id",
        "fields": {
          "issuedAt": "issued-at",
          "lastUsed": "last-used-at"
        },
        "creates": true
      },
      "realisation": "target"
    },
    {
      "id": "second-factor-flow",
      "name": "Second factor",
      "subject": "identity-service",
      "initial": "sf-start",
      "description": "One sign-in under a realm policy. When the realm asks for a second factor, the first factor alone issues no session: the sign-in waits, and only a verified second factor issues it.",
      "states": [
        {
          "id": "sf-start",
          "name": "First factor pending"
        },
        {
          "id": "sf-awaiting",
          "name": "Waiting for the second factor"
        },
        {
          "id": "sf-done",
          "name": "Signed in"
        }
      ],
      "transitions": [
        {
          "id": "sf-issue-without-second",
          "from": "sf-start",
          "to": "sf-done",
          "on": "sf-primary",
          "guard": "event.secondRequired",
          "effects": [
            {
              "emit": "sf-session-issued"
            }
          ],
          "faultOnly": true,
          "description": "Defect: issues the session on the first factor alone."
        },
        {
          "id": "sf-await",
          "from": "sf-start",
          "to": "sf-awaiting",
          "on": "sf-primary",
          "guard": "event.secondRequired",
          "effects": [
            {
              "emit": "sf-second-asked"
            }
          ]
        },
        {
          "id": "sf-primary-only",
          "from": "sf-start",
          "to": "sf-done",
          "on": "sf-primary",
          "effects": [
            {
              "emit": "sf-session-issued"
            }
          ]
        },
        {
          "id": "sf-second-ok",
          "from": "sf-awaiting",
          "to": "sf-done",
          "on": "sf-second",
          "guard": "event.valid",
          "effects": [
            {
              "emit": "sf-session-issued"
            }
          ]
        },
        {
          "id": "sf-second-bad",
          "from": "sf-awaiting",
          "to": "sf-awaiting",
          "on": "sf-second",
          "effects": [
            {
              "emit": "sf-refused"
            }
          ]
        }
      ],
      "realisation": "target"
    },
    {
      "level": "implementation",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "id": "second-factor-flow-impl",
      "name": "Second factor (implementation)",
      "subject": "identity-service",
      "initial": "sf-start-i",
      "description": "One sign-in attempt as the identity service keeps it (rec-sign-in-attempt): the state says whether the first factor is verified and the second is awaited. No session is issued from the waiting state except by a verified second factor.",
      "states": [
        {
          "id": "sf-start-i",
          "name": "First factor pending",
          "ignores": [
            "sf-second"
          ]
        },
        {
          "id": "sf-awaiting-i",
          "name": "Waiting for the second factor",
          "ignores": [
            "sf-primary"
          ]
        },
        {
          "id": "sf-done-i",
          "name": "Signed in",
          "ignores": [
            "sf-primary",
            "sf-second"
          ]
        }
      ],
      "transitions": [
        {
          "id": "sf-await-i",
          "from": "sf-start-i",
          "to": "sf-awaiting-i",
          "on": "sf-primary",
          "guard": "event.secondRequired",
          "effects": [
            {
              "emit": "sf-second-asked",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "sf-primary-only-i",
          "from": "sf-start-i",
          "to": "sf-done-i",
          "on": "sf-primary",
          "effects": [
            {
              "emit": "sf-session-issued",
              "to": "web-application"
            }
          ],
          "otherwise": true
        },
        {
          "id": "sf-second-ok-i",
          "from": "sf-awaiting-i",
          "to": "sf-done-i",
          "on": "sf-second",
          "guard": "event.valid",
          "effects": [
            {
              "emit": "sf-session-issued",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "sf-second-bad-i",
          "from": "sf-awaiting-i",
          "to": "sf-awaiting-i",
          "on": "sf-second",
          "effects": [
            {
              "emit": "sf-refused",
              "to": "web-application"
            }
          ],
          "otherwise": true
        }
      ],
      "refines": "second-factor-flow",
      "refinement": {
        "states": {
          "sf-start-i": "sf-start",
          "sf-awaiting-i": "sf-awaiting",
          "sf-done-i": "sf-done"
        },
        "variables": {},
        "transitions": {
          "sf-await-i": "sf-await",
          "sf-primary-only-i": "sf-primary-only",
          "sf-second-ok-i": "sf-second-ok",
          "sf-second-bad-i": "sf-second-bad"
        }
      },
      "storage": {
        "record": "rec-sign-in-attempt",
        "key": "attempt-id",
        "creates": true
      },
      "realisation": "target"
    },
    {
      "id": "recovery-flow",
      "name": "Account recovery",
      "subject": "identity-service",
      "initial": "rc-none",
      "description": "One account recovery. The request tells every registered contact of the account at once, the recovery completes only after the delay of 24 hours (D-700) and only once every contact was told, and completing it does not switch off the second factor, so the next sign-in still asks for it. One model tick is one hour.",
      "variables": [
        {
          "name": "contacts",
          "type": "number",
          "initial": 0
        },
        {
          "name": "notified",
          "type": "number",
          "initial": 0
        },
        {
          "name": "requestedAt",
          "type": "number",
          "initial": 0
        },
        {
          "name": "secondFactor",
          "type": "boolean",
          "initial": true
        }
      ],
      "states": [
        {
          "id": "rc-none",
          "name": "No recovery"
        },
        {
          "id": "rc-waiting",
          "name": "Waiting out the delay"
        },
        {
          "id": "rc-recovered",
          "name": "Recovered"
        }
      ],
      "transitions": [
        {
          "id": "rc-request-unnotified",
          "from": "rc-none",
          "to": "rc-waiting",
          "on": "rc-requested",
          "effects": [
            {
              "set": "contacts",
              "to": "event.contacts"
            },
            {
              "set": "requestedAt",
              "to": "time"
            }
          ],
          "faultOnly": true,
          "description": "Defect: starts the recovery without telling the contacts."
        },
        {
          "id": "rc-request",
          "from": "rc-none",
          "to": "rc-waiting",
          "on": "rc-requested",
          "effects": [
            {
              "set": "contacts",
              "to": "event.contacts"
            },
            {
              "set": "notified",
              "to": "event.contacts"
            },
            {
              "set": "requestedAt",
              "to": "time"
            },
            {
              "emit": "rc-notice"
            }
          ]
        },
        {
          "id": "rc-complete-early",
          "from": "rc-waiting",
          "to": "rc-recovered",
          "on": "rc-completion-asked",
          "guard": "requestedAt <= time && time - requestedAt < 24",
          "effects": [
            {
              "emit": "rc-completed"
            }
          ],
          "faultOnly": true,
          "description": "Defect: completes before the delay has passed."
        },
        {
          "id": "rc-complete-unnotified",
          "from": "rc-waiting",
          "to": "rc-recovered",
          "on": "rc-completion-asked",
          "guard": "requestedAt <= time && time - requestedAt >= 24 && notified != contacts",
          "effects": [
            {
              "emit": "rc-completed"
            }
          ],
          "faultOnly": true,
          "description": "Defect: completes without every contact having been told."
        },
        {
          "id": "rc-complete-drops-factor",
          "from": "rc-waiting",
          "to": "rc-recovered",
          "on": "rc-completion-asked",
          "guard": "requestedAt <= time && time - requestedAt >= 24 && notified == contacts",
          "effects": [
            {
              "set": "secondFactor",
              "to": false
            },
            {
              "emit": "rc-completed"
            }
          ],
          "faultOnly": true,
          "description": "Defect: switches the second factor off when it completes."
        },
        {
          "id": "rc-complete",
          "from": "rc-waiting",
          "to": "rc-recovered",
          "on": "rc-completion-asked",
          "guard": "requestedAt <= time && time - requestedAt >= 24 && notified == contacts",
          "effects": [
            {
              "emit": "rc-completed"
            }
          ]
        },
        {
          "id": "rc-complete-refuse",
          "from": "rc-waiting",
          "to": "rc-waiting",
          "on": "rc-completion-asked",
          "effects": [
            {
              "emit": "rc-too-early"
            }
          ]
        },
        {
          "id": "rc-sign-in-factor",
          "from": "rc-recovered",
          "to": "rc-recovered",
          "on": "rc-signed-in",
          "guard": "secondFactor",
          "effects": [
            {
              "emit": "rc-second-factor-asked"
            }
          ]
        },
        {
          "id": "rc-sign-in-session",
          "from": "rc-recovered",
          "to": "rc-recovered",
          "on": "rc-signed-in",
          "effects": [
            {
              "emit": "rc-session-issued"
            }
          ]
        }
      ],
      "realisation": "target"
    },
    {
      "level": "implementation",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "id": "recovery-flow-impl",
      "name": "Account recovery (implementation)",
      "subject": "identity-service",
      "initial": "rc-none-i",
      "description": "One account recovery as the identity service keeps it (rec-recovery-request): the number of contacts, the number told, the time of the request in milliseconds and whether the second factor is in force. The delay of 24 hours is 86400000 ms; the refinement reads one model tick as one hour (timeScale 3600000).",
      "variables": [
        {
          "name": "contacts",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "notified",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "requestedAt",
          "type": "number",
          "initial": 0,
          "repr": "timestamp"
        },
        {
          "name": "secondFactor",
          "type": "boolean",
          "initial": true,
          "repr": "bool"
        }
      ],
      "states": [
        {
          "id": "rc-none-i",
          "name": "No recovery",
          "ignores": [
            "rc-completion-asked",
            "rc-signed-in"
          ]
        },
        {
          "id": "rc-waiting-i",
          "name": "Waiting out the delay",
          "ignores": [
            "rc-requested",
            "rc-signed-in"
          ]
        },
        {
          "id": "rc-recovered-i",
          "name": "Recovered",
          "ignores": [
            "rc-requested",
            "rc-completion-asked"
          ]
        }
      ],
      "transitions": [
        {
          "id": "rc-request-i",
          "from": "rc-none-i",
          "to": "rc-waiting-i",
          "on": "rc-requested",
          "effects": [
            {
              "set": "contacts",
              "to": "event.contacts"
            },
            {
              "set": "notified",
              "to": "event.contacts"
            },
            {
              "set": "requestedAt",
              "to": "time"
            },
            {
              "emit": "rc-notice",
              "to": "mail-service"
            }
          ],
          "otherwise": true
        },
        {
          "id": "rc-complete-i",
          "from": "rc-waiting-i",
          "to": "rc-recovered-i",
          "on": "rc-completion-asked",
          "guard": "requestedAt <= time && time - requestedAt >= 86400000 && notified == contacts",
          "effects": [
            {
              "emit": "rc-completed",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "rc-complete-refuse-i",
          "from": "rc-waiting-i",
          "to": "rc-waiting-i",
          "on": "rc-completion-asked",
          "effects": [
            {
              "emit": "rc-too-early",
              "to": "web-application"
            }
          ],
          "otherwise": true
        },
        {
          "id": "rc-sign-in-factor-i",
          "from": "rc-recovered-i",
          "to": "rc-recovered-i",
          "on": "rc-signed-in",
          "guard": "secondFactor",
          "effects": [
            {
              "emit": "rc-second-factor-asked",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "rc-sign-in-session-i",
          "from": "rc-recovered-i",
          "to": "rc-recovered-i",
          "on": "rc-signed-in",
          "effects": [
            {
              "emit": "rc-session-issued",
              "to": "web-application"
            }
          ],
          "otherwise": true
        }
      ],
      "refines": "recovery-flow",
      "refinement": {
        "states": {
          "rc-none-i": "rc-none",
          "rc-waiting-i": "rc-waiting",
          "rc-recovered-i": "rc-recovered"
        },
        "variables": {
          "contacts": "contacts",
          "notified": "notified",
          "requestedAt": "requestedAt / 3600000",
          "secondFactor": "secondFactor"
        },
        "transitions": {
          "rc-request-i": "rc-request",
          "rc-complete-i": "rc-complete",
          "rc-complete-refuse-i": "rc-complete-refuse",
          "rc-sign-in-factor-i": "rc-sign-in-factor",
          "rc-sign-in-session-i": "rc-sign-in-session"
        },
        "timeScale": 3600000
      },
      "storage": {
        "record": "rec-recovery-request",
        "key": "recovery-id",
        "fields": {
