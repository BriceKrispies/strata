                "fields": {
                  "author": {
                    "ref": 2
                  },
                  "title": {
                    "str": "Hello"
                  }
                }
              }
            },
            "coverage": {
              "partial": [
                {
                  "record": {
                    "object": "post",
                    "id": 7
                  }
                }
              ]
            }
          },
          "result": {
            "allowed": false,
            "checks": [
              {
                "rule": "policy:authors_write_posts",
                "passed": false,
                "what": "Create on Object(ObjectTypeId(\"post\"))",
                "outcome": "failed",
                "condition": {
                  "cmp": {
                    "op": "eq",
                    "left": {
                      "through": {
                        "scope": "new",
                        "reference": "author",
                        "field": "principal"
                      }
                    },
                    "right": "principal"
                  }
                }
              }
            ],
            "needed": {
              "record": {
                "object": "author",
                "id": 2
              }
            }
          }
        },
        {
          "description": "A byline naming an author that does not exist: following it is null, so the condition is null, and nothing is needed.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-25"
            },
            "schema": {
              "fixture": "fx-tenant-schema-29"
            },
            "principal": {
