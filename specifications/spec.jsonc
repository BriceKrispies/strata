    {
      "id": "create-invitation",
      "description": "transition.rs create_invitation (ADM-153): a person issues an invitation to an address for roles. Authorised as Manage on Members; the address is kept normalised (normalise-address) and must hold an @; it grants at least one role, every one existing and not public and one the person may confer; an invitation id is used once. The invitation expires fourteen days after it is issued and starts unrevoked (ADM-1082).",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "invitation",
          "type": "invitation-id"
        },
        {
          "name": "address",
          "type": "string"
        },
        {
          "name": "roles",
          "type": "set<role-id>"
        }
      ],
      "returns": "decided",
      "errors": "rejection",
      "let": [
        {
          "name": "d1",
          "expr": "try call require(d, action.manage, resource.members, subject{})"
        },
        {
          "name": "addr",
          "expr": "call normalise-address(address)"
        },
        {
          "name": "bad",
          "expr": "find(r in roles, get(d1.tenant.schema.roles, r) == null || r == 'public')"
        }
      ],
      "body": "match d1.ctx.principal { user(creator) => if !any(c in chars(addr), c == '@') then fail(call draft-reject(d1.evidence, error-kind.invalid-intent, 'an invitation names an address')) else if roles == [] then fail(call draft-reject(d1.evidence, error-kind.invalid-intent, 'an invitation grants a role')) else if get(call invitations-of(d1.tenant.schema), invitation) != null then fail(call draft-reject(d1.evidence, error-kind.invalid-intent, format('invitation {} already exists', invitation))) else match bad { Some(r) => if get(d1.tenant.schema.roles, r) == null then fail(call draft-reject(d1.evidence, error-kind.unknown-role, format('no role {}', r))) else fail(call draft-reject(d1.evidence, error-kind.invalid-intent, 'everyone already holds public')), None => let d2 = try call require-conferrable(d1, roles) in decided{draft: draft{tenant: d2.tenant, ctx: d2.ctx, coverage: d2.coverage, ops: concat(d2.ops, [delta-op.put-schema(call schema-with-invitation(d2.tenant.schema, invitation-def{id: invitation, address: addr, roles, created-by: creator, redeemed-by: null, expires-at: d1.ctx.now + 1209600000, revoked-by: null}))]), events: d2.events, effects: d2.effects, evidence: d2.evidence, next-record: d2.next-record}, output: output.member} }, _ => fail(call draft-reject(d1.evidence, error-kind.invalid-intent, 'a person issues an invitation')) }",
