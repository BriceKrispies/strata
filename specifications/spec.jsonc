  "uiScenarios": [
    {"id":"ui-front-page","name":"The front page shows the featured essay and the earlier ones","verifies":["cms-002","cms-003"],"description":"Journey of tests/e2e/site.spec.js, test 1: \"the front page shows the featured essay and the earlier ones\". Hand-written test keeps: that the first of the earlier essays is \"The Second Hundred Hours\" (position among siblings); the full-page screenshot, which asserts nothing.","steps":[{"goto":{"screen":"screen-front-page"}},{"expectTitle":{"text":"Fieldnotes"}},{"expectRole":{"role":"heading","level":1,"name":"Fieldnotes"}},{"expectRole":{"role":"heading","level":2,"name":"The Jig Is the Work"}},{"expectCount":{"role":"article","within":{"role":"region","name":"Earlier essays"},"count":5}},{"expectNoText":{"text":"Notes Toward a Workbench"}},{"expectRole":{"role":"img","namePattern":"plywood fixture holding a chair leg"}},{"expectAttribute":{"attribute":"data-accent","value":"moss"}}]},
    {"id":"ui-first-paint-bootstrap","name":"The first paint comes from the server-rendered bootstrap","description":"Journey of tests/e2e/site.spec.js, test 2: \"the first paint comes from the server-rendered bootstrap, without a request for the view\".","steps":[{"recordRequests":"views"},{"goto":{"screen":"screen-article","params":{"slug":"slow-software"}}},{"expectRole":{"role":"heading","level":1,"name":"Slow Software"}},{"expectNoRequest":{"log":"views","path":"/api/view"}}]},
    {"id":"ui-follow-link-no-reload","name":"Following a link opens the article without a page load","verifies":["cms-004"],"description":"Journey of tests/e2e/site.spec.js, test 3: \"following a link opens the article without a page load and moves focus to it\".","steps":[{"goto":{"screen":"screen-front-page"}},{"mark":"loaded"},{"click":{"role":"link","name":"What the Kiln Decides"}},{"expectScreen":{"screen":"screen-article","params":{"slug":"what-the-kiln-decides"}}},{"expectRole":{"role":"heading","level":1,"name":"What the Kiln Decides"}},{"expectTitle":{"text":"What the Kiln Decides — Fieldnotes"}},{"expectRole":{"role":"main","name":"Content","state":"focused"}},{"expectRole":{"role":"link","name":"Mirela Ashby","within":{"role":"complementary","name":"About this essay"}}},{"expectText":{"text":"You do not finish a pot","within":{"role":"blockquote"}}},{"expectNoReload":"loaded"},{"back":{}},{"expectRole":{"role":"heading","level":2,"name":"The Jig Is the Work"}},{"expectNoReload":"loaded"}]},
    {"id":"ui-browse-and-search","name":"Topics, authors, about and search all work","verifies":["srh-150"],"description":"Journey of tests/e2e/site.spec.js, test 4: \"topics, authors, about and search all work\".","steps":[{"goto":{"screen":"screen-topics"}},{"click":{"role":"link","name":"Design"}},{"expectRole":{"role":"heading","level":1,"name":"Design"}},{"expectCount":{"role":"article","count":2}},{"click":{"role":"link","name":"Authors","within":{"role":"navigation","name":"Sections"}}},{"click":{"role":"link","name":"Tomasz Wren"}},{"expectRole":{"role":"heading","level":1,"name":"Tomasz Wren"}},{"expectCount":{"role":"article","count":2}},{"click":{"role":"link","name":"About","within":{"role":"navigation","name":"Sections"}}},{"expectRole":{"role":"heading","level":1,"name":"About Fieldnotes"}},{"expectRole":{"role":"heading","name":"Colophon"}},{"fill":{"form":"form-search","field":"q","value":"kiln"}},{"press":"Enter"},{"expectScreen":{"screen":"screen-search","params":{"q":"kiln"}}},{"expectText":{"text":"1 essay mentions “kiln”."}},{"expectRole":{"role":"heading","name":"What the Kiln Decides","within":{"role":"article"}}},{"goto":{"screen":"screen-search","params":{"q":"zzzz"}}},{"expectText":{"text":"Nothing mentions “zzzz”."}}]},
    {"id":"ui-unknown-address","name":"An unknown address says so, with the right status","description":"Journey of tests/e2e/site.spec.js, test 5: \"an unknown address says so, with the right status\".","steps":[{"gotoPath":{"path":"/posts/no-such-essay"}},{"expectStatus":200},{"expectRole":{"role":"heading","level":1,"name":"There is nothing at this address"}},{"gotoPath":{"path":"/no/such/route"}},{"expectStatus":404}]},
    {"id":"ui-requests-from-worker-to-bff","name":"Every application request comes from the worker and goes to the BFF only","verifies":["run-003"],"description":"Journey of tests/e2e/site.spec.js, test 6: \"every application request comes from the worker and goes to the BFF only\". Hand-written test keeps: that exactly one worker exists (worker count); the check that the main thread itself calls fetch, WebSocket and XMLHttpRequest never, which the worker-origin assertions below cover for the application's own requests.","steps":[{"recordRequests":"app"},{"goto":{"screen":"screen-front-page"}},{"click":{"role":"link","name":"Drawing the Thing You Mean"}},{"expectRole":{"role":"heading","level":1,"name":"Drawing the Thing You Mean"}},{"click":{"role":"link","name":"Topics","within":{"role":"navigation","name":"Sections"}}},{"expectRole":{"role":"heading","level":1,"name":"Topics"}},{"expectAttribute":{"role":"status","name":"Live connection","attribute":"data-connection","value":"open"}},{"expectRequests":{"log":"app","to":"/api/view","atLeast":2,"fromWorker":true}},{"expectRequests":{"log":"app","to":"^ws://","atLeast":1,"fromWorker":true}},{"expectRequests":{"log":"app","to":"^(http|ws)://127\\.0\\.0\\.1:4200/","only":true}},{"apiCall":{"method":"POST","host":"127.0.0.1:4201","path":"/internal/view","anonymous":true,"body":{"path":"/"},"expectStatus":401}}]},
    {"id":"ui-sign-in-and-out","name":"Signing in with a wrong password explains itself; signing in and out works","verifies":["uxa-202","gwy-003","idn-261","idn-262"],"description":"Journey of tests/e2e/site.spec.js, test 7: \"signing in with a wrong password explains itself; signing in and out works\". Hand-written test keeps: that the Password field is focused and emptied after a refusal (a password input has no WAI-ARIA role to address it by); that document.cookie is empty (the cookie's httpOnly attribute is asserted instead).","steps":[
        {
          "goto": {
            "screen": "screen-sign-in"
          }
        },
        {
          "fill": {
            "form": "form-sign-in",
            "field": "login",
            "value": "ines"
          }
        },
        {
          "fill": {
            "form": "form-sign-in",
            "field": "password",
            "value": "not-the-password"
          }
        },
        {
          "submit": {
            "form": "form-sign-in"
          }
        },
        {
          "expectText": {
            "text": "The name or password is not right.",
            "within": {
              "role": "alert"
            }
          }
        },
        {
          "fill": {
            "form": "form-sign-in",
            "field": "password",
            "value": "strata-dev-ines"
          }
        },
        {
          "press": "Enter"
        },
        {
          "expectRole": {
            "role": "heading",
            "level": 1,
            "name": "Writing desk"
          }
        },
        {
          "expectText": {
            "text": "Signed in as Inès Okafor.",
            "within": {
              "role": "region",
              "name": "Messages"
            }
          }
        },
        {
          "expectLog": {
            "service": "backend",
            "event": "session-started",
            "fields": {
              "tenant": "fieldnotes",
              "principal": "user:ines",
              "method": "password"
            }
          }
        },
        {
          "expectCookie": {
            "name": "__Host-strata_sid",
