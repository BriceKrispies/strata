                    "condition": {
                      "cmp": {
                        "op": "eq",
                        "left": {
                          "var": {
                            "scope": "record",
                            "field": "status"
                          }
                        },
                        "right": {
                          "lit": {
                            "str": "published"
                          }
                        }
                      }
                    }
                  },
                  "public_reads_settings": {
                    "id": "public_reads_settings",
                    "role": "public",
                    "resource": {
                      "object": "publication"
                    },
                    "actions": [
                      "read"
                    ]
                  }
                },
                "workflows": {},
                "queries": {},
                "views": {}
              },
              "members": {
                "user:admin": [
                  "owner"
                ],
                "user:ann": [
