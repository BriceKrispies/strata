    {
      "id": "need-order",
      "description": "A BTreeSet<Need> as needs returns it: each need once, in the derived order of Need (Record, then ByField, then AllOf; then the object type, the id, the field and the value in Value's order). Stable sorts from the least to the most significant key; a list value is not ordered by its items (unique list fields are refused by schema-problems, so needs never holds one).",
      "params": [
        {
          "name": "xs",
          "type": "list<need>"
        }
      ],
      "returns": "list<need>",
      "let": [
        {
          "name": "sorted",
          "expr": "sortBy(n in sortBy(n in sortBy(n in sortBy(n in sortBy(n in sortBy(n in xs, match n { record{id} => id, by-field{value} => match value { int(i) => i, time(t) => t, ref(r) => r, bool(b) => if b then 1 else 0, _ => 0 }, all-of(_) => 0 }), match n { by-field{value} => match value { str(s) => s, _ => '' }, _ => '' }), match n { by-field{value} => match value { bool(_) => 1, int(_) => 2, str(_) => 3, time(_) => 4, ref(_) => 5, list(_) => 6, _ => 0 }, _ => 0 }), match n { by-field{field} => field, _ => '' }), match n { record{object} => object, by-field{object} => object, all-of(o) => o }), match n { record => 0, by-field => 1, all-of => 2 })"
        }
      ],
      "body": "fold(n in sorted, acc = [], if any(a in acc, a == n) then acc else concat(acc, [n]))",
      "examples": [
        {
          "args": {
            "xs": [
              {
                "all-of": "person"
              },
              {
                "by-field": {
                  "object": "note",
                  "field": "slug",
                  "value": {
                    "str": "b"
                  }
                }
              },
              {
                "record": {
                  "object": "person",
                  "id": 2
                }
              },
              {
                "by-field": {
                  "object": "note",
                  "field": "slug",
                  "value": {
                    "str": "a"
                  }
                }
              },
              {
                "record": {
                  "object": "note",
                  "id": 10
                }
              },
              {
                "record": {
                  "object": "note",
                  "id": 9
                }
              },
              {
                "all-of": "note"
              },
              {
                "record": {
                  "object": "person",
                  "id": 2
                }
              },
              {
                "by-field": {
                  "object": "note",
                  "field": "rank",
                  "value": {
                    "int": 3
                  }
                }
              }
            ]
          },
          "result": [
            {
              "record": {
                "object": "note",
                "id": 9
              }
            },
            {
              "record": {
                "object": "note",
                "id": 10
              }
            },
            {
              "record": {
                "object": "person",
                "id": 2
              }
            },
            {
              "by-field": {
                "object": "note",
                "field": "rank",
                "value": {
                  "int": 3
                }
              }
            },
            {
              "by-field": {
                "object": "note",
                "field": "slug",
                "value": {
                  "str": "a"
                }
              }
            },
            {
              "by-field": {
                "object": "note",
                "field": "slug",
                "value": {
                  "str": "b"
                }
              }
            },
            {
              "all-of": "note"
            },
            {
              "all-of": "person"
            }
          ]
        }
      ]
    },
    {
      "id": "field-needs",
      "description": "transition.rs needs, field_needs: for each given field (in id order) the object type declares, a ByField need for a unique field with a value, and a Record need for each record a reference field refers to.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "fields",
          "type": "map<field-id, value>"
        }
      ],
      "returns": "list<need>",
      "body": "match get(schema.objects, object) { None => [], Some(def) => fold(k in keys(fields), acc = [], match get(def.fields, k) { None => acc, Some(f) => match get(fields, k) { None => acc, Some(x) => concat(concat(acc, if f.unique && !call value-is-null(x) then [need.by-field{object, field: k, value: x}] else []), match call ref-target(f.ty) { Some(t) => map(i in call refs-in(x), need.record{object: t, id: i}), None => [] }) } }) }",
      "examples": [
        {
          "args": {
            "schema": {
              "version": 2,
              "objects": {
                "note": {
                  "id": "note",
                  "label": "Note",
                  "fields": {
                    "author": {
                      "id": "author",
                      "label": "Author",
                      "ty": {
                        "ref": {
                          "target": "person",
                          "on-delete": "set-null"
                        }
                      },
                      "required": false,
                      "unique": false
                    },
                    "body": {
                      "id": "body",
                      "label": "body",
                      "ty": "str",
                      "required": false,
                      "unique": false
                    },
                    "published_at": {
                      "id": "published_at",
                      "label": "published_at",
                      "ty": "time",
                      "required": false,
                      "unique": false
                    },
                    "rank": {
                      "id": "rank",
                      "label": "rank",
                      "ty": "int",
                      "required": false,
                      "unique": false
                    },
                    "slug": {
                      "id": "slug",
                      "label": "slug",
                      "ty": "str",
                      "required": true,
                      "unique": true
                    },
                    "status": {
                      "id": "status",
                      "label": "status",
                      "ty": "str",
                      "required": true,
                      "unique": false,
                      "default": {
                        "lit": {
