        },
        {
          "name": "key",
          "type": "key-id"
        }
      ],
      "outputs": [
        {
          "name": "sealed",
          "type": "bytes"
        }
      ],
      "postconditions": [
        "The result opens only with the same key and fails to open if changed.",
        "A personal field stored sealed under the key of its principal is unreadable once that key is destroyed (PRV-358)."
      ],
      "errors": [
        {
          "name": "key-destroyed",
          "condition": "The key was destroyed.",
          "type": "store-error",
          "kind": "not_found"
        }
      ],
      "exposure": "local"
    },
    {
      "id": "open-field",
      "name": "Decrypt under a data key",
      "ref": "H-020",
      "realisation": "hand",
      "milestone": 3,
      "implementedBy": "key-service",
      "auth": {
        "scheme": "in-process",
