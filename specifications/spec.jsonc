    {
      "id": "token-verifier-flow",
      "name": "Token verifier copy of a grant",
      "subject": "gateway",
      "initial": "tg-open",
      "description": "The verifier of tokens holds a copy of the state of the grant they were issued from. It trusts the copy for 5 seconds, the revocation bound of sessions (IDN-014), then asks the grant record again; a revocation notice marks the copy revoked at once. Whether or not the notice arrives, a token of a revoked grant is refused once the bound has passed. One model tick is one second.",
      "variables": [
        {
          "name": "copyRevoked",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "checkedAt",
          "type": "number",
          "initial": 0
        },
        {
          "name": "checked",
          "type": "boolean",
          "initial": false
        }
      ],
      "states": [
        {
          "id": "tg-open",
          "name": "Verifying"
        }
      ],
      "transitions": [
        {
          "id": "tg-notice-heard",
          "from": "tg-open",
          "to": "tg-open",
          "on": "tg-notice",
          "effects": [
            {
              "set": "copyRevoked",
              "to": true
            }
          ]
        },
        {
          "id": "tg-accept-stale",
          "from": "tg-open",
          "to": "tg-open",
          "on": "tg-presented",
          "guard": "!copyRevoked",
          "effects": [
            {
              "emit": "tg-accepted"
            }
          ],
          "faultOnly": true,
          "description": "Defect: trusts the copy however old it is."
        },
        {
          "id": "tg-accept-cached",
          "from": "tg-open",
          "to": "tg-open",
          "on": "tg-presented",
          "guard": "!copyRevoked && checked && checkedAt <= time && time - checkedAt < 5",
          "effects": [
            {
              "emit": "tg-accepted"
            }
          ]
        },
        {
          "id": "tg-refuse-known",
          "from": "tg-open",
          "to": "tg-open",
          "on": "tg-presented",
          "guard": "copyRevoked",
          "effects": [
            {
              "emit": "tg-refused"
            }
          ]
        },
        {
          "id": "tg-recheck-ok",
          "from": "tg-open",
          "to": "tg-open",
          "on": "tg-presented",
          "guard": "!event.grantRevoked",
          "effects": [
            {
              "set": "checkedAt",
              "to": "time"
            },
            {
              "set": "checked",
              "to": true
            },
            {
              "emit": "tg-accepted"
            }
          ]
        },
        {
          "id": "tg-recheck-revoked",
          "from": "tg-open",
          "to": "tg-open",
          "on": "tg-presented",
          "effects": [
            {
              "set": "copyRevoked",
              "to": true
            },
            {
              "emit": "tg-refused"
            }
          ]
        }
      ]
    },
    {
      "level": "implementation",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "id": "token-verifier-flow-impl",
      "name": "Token verifier copy of a grant (implementation)",
      "subject": "gateway",
      "initial": "tg-open-i",
      "description": "The verifier copy of one grant (rec-grant-copy): whether the copy is revoked and when it was last checked against the grant record, in milliseconds. It trusts the copy for 5000 ms. The refinement reads one model tick as one second (timeScale 1000).",
      "variables": [
        {
          "name": "copyRevoked",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "checkedAt",
          "type": "number",
          "initial": 0,
          "repr": "timestamp"
        },
        {
          "name": "checked",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        }
      ],
      "states": [
        {
          "id": "tg-open-i",
          "name": "Verifying"
        }
      ],
      "transitions": [
        {
          "id": "tg-notice-heard-i",
          "from": "tg-open-i",
          "to": "tg-open-i",
          "on": "tg-notice",
          "effects": [
            {
              "set": "copyRevoked",
              "to": true
            }
          ],
          "otherwise": true
        },
        {
          "id": "tg-accept-cached-i",
          "from": "tg-open-i",
          "to": "tg-open-i",
          "on": "tg-presented",
          "guard": "!copyRevoked && checked && checkedAt <= time && time - checkedAt < 5000",
          "effects": [
            {
              "emit": "tg-accepted",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "tg-refuse-known-i",
          "from": "tg-open-i",
          "to": "tg-open-i",
          "on": "tg-presented",
          "guard": "copyRevoked",
          "effects": [
            {
              "emit": "tg-refused",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "tg-recheck-ok-i",
          "from": "tg-open-i",
          "to": "tg-open-i",
          "on": "tg-presented",
          "guard": "!event.grantRevoked",
          "effects": [
            {
              "set": "checkedAt",
              "to": "time"
            },
            {
              "set": "checked",
              "to": true
            },
            {
              "emit": "tg-accepted",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "tg-recheck-revoked-i",
          "from": "tg-open-i",
          "to": "tg-open-i",
          "on": "tg-presented",
          "effects": [
            {
              "set": "copyRevoked",
              "to": true
            },
            {
              "emit": "tg-refused",
              "to": "web-application"
            }
          ],
          "otherwise": true
        }
      ],
      "refines": "token-verifier-flow",
      "refinement": {
        "states": {
          "tg-open-i": "tg-open"
        },
        "variables": {
          "copyRevoked": "copyRevoked",
          "checkedAt": "checkedAt / 1000",
          "checked": "checked"
        },
        "transitions": {
          "tg-notice-heard-i": "tg-notice-heard",
          "tg-accept-cached-i": "tg-accept-cached",
          "tg-refuse-known-i": "tg-refuse-known",
          "tg-recheck-ok-i": "tg-recheck-ok",
          "tg-recheck-revoked-i": "tg-recheck-revoked"
        },
        "timeScale": 1000
      },
      "storage": {
        "record": "rec-grant-copy",
        "key": "grant-id",
        "fields": {
          "copyRevoked": "copy-revoked",
          "checkedAt": "checked-at",
          "checked": "checked"
        },
        "creates": true
      },
      "realisation": "target"
    },
    {
      "id": "signing-key-flow",
      "name": "Signing keys",
      "subject": "identity-service",
      "initial": "sk-open",
      "description": "The keys that verify tokens: the current key and the previous one. A routine rotation keeps the previous key until its tokens expire; a compromised key is retired at once and no token signed by it verifies from then on.",
      "variables": [
        {
          "name": "current",
          "type": "string",
          "initial": "k1"
        },
        {
          "name": "previous",
          "type": "string",
          "initial": "none"
        }
      ],
      "states": [
        {
          "id": "sk-open",
          "name": "Keys held"
        }
      ],
      "transitions": [
        {
          "id": "sk-rotation-drops-previous",
          "from": "sk-open",
          "to": "sk-open",
          "on": "sk-rotated",
          "effects": [
            {
              "set": "previous",
              "to": "'none'"
            },
            {
              "set": "current",
              "to": "event.newKid"
            }
          ],
          "faultOnly": true,
          "description": "Defect: drops the previous key at a rotation."
        },
        {
          "id": "sk-rotate",
          "from": "sk-open",
          "to": "sk-open",
          "on": "sk-rotated",
          "effects": [
            {
              "set": "previous",
              "to": "current"
            },
            {
              "set": "current",
              "to": "event.newKid"
            }
          ]
        },
        {
          "id": "sk-retire-keeps-key",
          "from": "sk-open",
          "to": "sk-open",
          "on": "sk-compromised",
          "guard": "event.kid == current",
          "effects": [
            {
              "set": "previous",
              "to": "current"
            },
            {
              "set": "current",
              "to": "event.replacement"
            }
          ],
          "faultOnly": true,
          "description": "Defect: treats a compromised key as a routine rotation and keeps it as the previous key."
        },
        {
          "id": "sk-retire-current",
          "from": "sk-open",
          "to": "sk-open",
          "on": "sk-compromised",
          "guard": "event.kid == current",
          "effects": [
            {
              "set": "current",
              "to": "event.replacement"
            },
            {
              "set": "previous",
              "to": "'none'"
            }
          ]
        },
        {
          "id": "sk-retire-previous",
          "from": "sk-open",
          "to": "sk-open",
          "on": "sk-compromised",
          "guard": "event.kid == previous",
          "effects": [
            {
              "set": "previous",
              "to": "'none'"
            }
          ]
        },
        {
          "id": "sk-accept-expired",
          "from": "sk-open",
          "to": "sk-open",
          "on": "sk-token",
          "guard": "event.kid == current || event.kid == previous",
          "effects": [
            {
              "emit": "sk-accepted"
            }
          ],
          "faultOnly": true,
          "description": "Defect: verifies an expired token."
        },
        {
          "id": "sk-accept",
          "from": "sk-open",
          "to": "sk-open",
          "on": "sk-token",
          "guard": "!event.expired && (event.kid == current || event.kid == previous)",
          "effects": [
            {
              "emit": "sk-accepted"
            }
          ]
        },
        {
          "id": "sk-refuse",
          "from": "sk-open",
          "to": "sk-open",
          "on": "sk-token",
          "effects": [
            {
              "emit": "sk-refused"
            }
          ]
        }
      ],
      "realisation": "target"
    },
    {
      "level": "implementation",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "id": "signing-key-flow-impl",
      "name": "Signing keys (implementation)",
      "subject": "identity-service",
      "initial": "sk-open-i",
      "description": "The key set of the platform as the identity service holds it (rec-signing-key-set): the current and the previous key identifier. A token verifies only with one of them and only until it expires.",
      "variables": [
        {
          "name": "current",
          "type": "string",
          "initial": "k1",
          "repr": "string"
        },
        {
          "name": "previous",
          "type": "string",
          "initial": "none",
          "repr": "string"
        }
      ],
      "states": [
        {
          "id": "sk-open-i",
          "name": "Keys held"
        }
      ],
      "transitions": [
        {
          "id": "sk-rotate-i",
          "from": "sk-open-i",
          "to": "sk-open-i",
          "on": "sk-rotated",
          "effects": [
            {
              "set": "previous",
              "to": "current"
            },
            {
              "set": "current",
              "to": "event.newKid"
            }
          ],
          "otherwise": true
        },
        {
          "id": "sk-retire-current-i",
          "from": "sk-open-i",
          "to": "sk-open-i",
          "on": "sk-compromised",
          "guard": "event.kid == current",
          "effects": [
            {
              "set": "current",
              "to": "event.replacement"
            },
            {
              "set": "previous",
              "to": "'none'"
            }
          ]
        },
        {
          "id": "sk-retire-previous-i",
          "from": "sk-open-i",
          "to": "sk-open-i",
          "on": "sk-compromised",
          "guard": "event.kid == previous",
          "effects": [
            {
              "set": "previous",
              "to": "'none'"
            }
          ]
        },
        {
          "id": "sk-accept-i",
          "from": "sk-open-i",
          "to": "sk-open-i",
          "on": "sk-token",
          "guard": "!event.expired && (event.kid == current || event.kid == previous)",
          "effects": [
            {
              "emit": "sk-accepted",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "sk-refuse-i",
          "from": "sk-open-i",
          "to": "sk-open-i",
          "on": "sk-token",
          "effects": [
            {
              "emit": "sk-refused",
              "to": "web-application"
            }
          ],
          "otherwise": true
        }
      ],
      "refines": "signing-key-flow",
      "refinement": {
        "states": {
          "sk-open-i": "sk-open"
        },
        "variables": {
          "current": "current",
          "previous": "previous"
        },
        "transitions": {
          "sk-rotate-i": "sk-rotate",
          "sk-retire-current-i": "sk-retire-current",
          "sk-retire-previous-i": "sk-retire-previous",
          "sk-accept-i": "sk-accept",
          "sk-refuse-i": "sk-refuse"
        }
      },
      "storage": {
        "record": "rec-signing-key-set",
        "key": "key-set-id",
        "fields": {
          "current": "current-kid",
          "previous": "previous-kid"
        },
        "creates": true
      },
      "realisation": "target"
    },
    {
      "id": "signup-notice-flow",
      "name": "Sign-up and recovery responses",
      "subject": "identity-service",
      "initial": "su-open",
      "description": "A sign-up or recovery request that names an address. The requester receives the same response whether or not the address already has an account; when it has, the owner of the address is sent a notice.",
      "states": [
        {
          "id": "su-open",
          "name": "Answering"
        }
      ],
      "transitions": [
        {
          "id": "su-reveals",
          "from": "su-open",
          "to": "su-open",
          "on": "su-requested",
          "guard": "event.addressExists",
          "effects": [
            {
              "emit": "su-address-taken"
            },
            {
              "emit": "su-owner-notified"
            }
          ],
          "faultOnly": true,
          "description": "Defect: tells the requester that the address is taken."
        },
        {
          "id": "su-no-notice",
          "from": "su-open",
          "to": "su-open",
          "on": "su-requested",
          "guard": "event.addressExists",
          "effects": [
            {
              "emit": "su-response-sent"
            }
          ],
          "faultOnly": true,
          "description": "Defect: sends no notice to the owner."
        },
        {
          "id": "su-existing",
          "from": "su-open",
          "to": "su-open",
          "on": "su-requested",
          "guard": "event.addressExists",
          "effects": [
            {
              "emit": "su-response-sent"
            },
            {
              "emit": "su-owner-notified"
            }
          ]
        },
        {
          "id": "su-new",
          "from": "su-open",
          "to": "su-open",
          "on": "su-requested",
          "effects": [
            {
              "emit": "su-response-sent"
            }
          ]
        }
      ],
      "realisation": "target"
    },
    {
      "level": "implementation",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "id": "signup-notice-flow-impl",
      "name": "Sign-up and recovery responses (implementation)",
      "subject": "identity-service",
      "initial": "su-open-i",
      "description": "The answer to one sign-up or recovery request. It keeps nothing between requests; the notice goes to the owner through the mail service.",
      "states": [
        {
          "id": "su-open-i",
          "name": "Answering"
        }
      ],
      "transitions": [
        {
          "id": "su-existing-i",
          "from": "su-open-i",
          "to": "su-open-i",
          "on": "su-requested",
          "guard": "event.addressExists",
          "effects": [
            {
              "emit": "su-response-sent",
              "to": "web-application"
            },
            {
              "emit": "su-owner-notified",
              "to": "mail-service"
            }
          ]
        },
        {
          "id": "su-new-i",
          "from": "su-open-i",
          "to": "su-open-i",
          "on": "su-requested",
          "effects": [
            {
              "emit": "su-response-sent",
              "to": "web-application"
            }
          ],
          "otherwise": true
        }
      ],
      "refines": "signup-notice-flow",
      "refinement": {
        "states": {
          "su-open-i": "su-open"
        },
        "variables": {},
        "transitions": {
          "su-existing-i": "su-existing",
          "su-new-i": "su-new"
        }
      },
      "storage": {
        "record": "rec-identity-decision",
        "key": "decision-id",
        "creates": true
      },
      "realisation": "target"
    },
    {
      "id": "new-device-flow",
      "name": "Sign-in from a new source or device",
      "subject": "identity-service",
      "initial": "nd-open",
      "description": "A successful sign-in. When the source or the device was not used by the account before, the account owner is sent a notice.",
      "states": [
        {
          "id": "nd-open",
          "name": "Answering"
        }
      ],
      "transitions": [
        {
          "id": "nd-no-notice",
          "from": "nd-open",
          "to": "nd-open",
          "on": "nd-signed-in",
          "guard": "!event.known",
          "effects": [
            {
              "emit": "nd-session-issued"
            }
          ],
          "faultOnly": true,
          "description": "Defect: sends no notice for a new source or device."
        },
        {
          "id": "nd-notify",
          "from": "nd-open",
          "to": "nd-open",
          "on": "nd-signed-in",
          "guard": "!event.known",
          "effects": [
            {
              "emit": "nd-session-issued"
            },
            {
              "emit": "nd-notice-sent"
            }
          ]
        },
        {
          "id": "nd-known",
          "from": "nd-open",
          "to": "nd-open",
          "on": "nd-signed-in",
          "effects": [
            {
              "emit": "nd-session-issued"
            }
          ]
        }
      ],
      "realisation": "target"
    },
    {
      "level": "implementation",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "id": "new-device-flow-impl",
      "name": "Sign-in from a new source or device (implementation)",
      "subject": "identity-service",
      "initial": "nd-open-i",
      "description": "One successful sign-in. The notice to the account owner goes through the mail service.",
      "states": [
        {
          "id": "nd-open-i",
          "name": "Answering"
        }
      ],
      "transitions": [
        {
          "id": "nd-notify-i",
          "from": "nd-open-i",
          "to": "nd-open-i",
          "on": "nd-signed-in",
          "guard": "!event.known",
          "effects": [
            {
              "emit": "nd-session-issued",
              "to": "web-application"
            },
            {
              "emit": "nd-notice-sent",
              "to": "mail-service"
            }
          ]
        },
        {
          "id": "nd-known-i",
