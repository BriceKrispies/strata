    {"id":"sec-federation-4","title":"Policy and linking","level":2,"document":"doc-federation","order":4,"body":"\n{{entity:fed-009}}\n\n{{entity:fed-010}}\n\n{{entity:fed-011}}\n\n{{entity:fed-012}}\n\n{{entity:fed-013}}\n\n"},
    {"id":"sec-federation-5","title":"Provisioning","level":2,"document":"doc-federation","order":5,"body":"\n{{entity:fed-014}}\n\n{{entity:fed-015}}\n\n"},
    {"id":"sec-tokens-1","title":"Tokens","level":1,"document":"doc-tokens","order":1,"body":"\nCallers that are not browsers authenticate with signed access tokens. An agent is such a caller, and when it acts for a person the token says so.\n\n"},
    {"id":"sec-tokens-2","title":"Issue","level":2,"document":"doc-tokens","order":2,"body":"\n{{entity:tok-001}}\n\n{{entity:tok-002}}\n\n{{entity:tok-003}}\n\n{{entity:tok-004}}\n\n{{entity:tok-005}}\n\n"},
