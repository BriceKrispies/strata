    {
      "id": "authorize",
      "description": "crates/kernel/src/rules.rs authorize with no lookup: default deny; the owner role is allowed everything (policy:builtin_owner); otherwise the policies of the schema, in id order, that match role, action and resource are tried: the first without a condition, or whose condition evaluates to true, grants alone; a condition that is false, null or fails to evaluate is a failed check policy:<id>; with no matching policy the one check is policy:none. Without a lookup a condition that follows a reference (through) fails to evaluate, as in the kernel.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "principal",
          "type": "principal"
        },
        {
          "name": "now",
          "type": "timestamp"
        },
        {
          "name": "action",
          "type": "action"
        },
        {
          "name": "resource",
          "type": "resource"
        },
        {
          "name": "subject",
          "type": "subject"
        }
      ],
      "returns": "policy-decision",
      "let": [
        {
          "name": "roles",
          "expr": "call roles-of(tenant, principal)"
        },
        {
          "name": "what",
          "expr": "call request-text(action, resource)"
        }
      ],
      "body": "if any(r in roles, r == 'owner') then policy-decision{allowed: true, checks: [policy-check{rule: 'policy:builtin_owner', passed: true, what, outcome: policy-outcome.owner}]} else let env = expr-env{record: call scope-of(if subject.old == null then subject.new else subject.old), old: call scope-of(subject.old), new: call scope-of(subject.new), param: {}, now: value.time(now), principal: match principal { user(id) => value.str(id), _ => call null-value() }, has_role: roles} in let state = fold(p in values(schema.policies), acc = policy-progress{granted: null, checks: []}, if acc.granted != null || !call policy-applies(p, roles, action, resource) then acc else call policy-step(p, env, acc, what)) in match state.granted { Some(c) => policy-decision{allowed: true, checks: [c]}, None => policy-decision{allowed: false, checks: if state.checks == [] then [policy-check{rule: 'policy:none', passed: false, what, outcome: policy-outcome.no-policy}] else state.checks} }",
      "examples": [
        {
          "description": "The owner bypasses the policies: no policy names the owner, and it may delete a post.",
          "args": {
            "now": 1800000000000,
            "tenant": {
              "id": "gazette",
              "name": "Gazette",
              "revision": 0,
              "next-record": 7,
              "event-seq": 0,
              "schema": {
                "version": 1,
                "objects": {},
                "roles": {},
                "policies": {
                  "authors_own_posts": {
                    "id": "authors_own_posts",
                    "role": "author",
                    "resource": {
                      "object": "post"
                    },
                    "actions": [
                      "read",
                      "update",
                      "delete"
                    ],
                    "condition": {
                      "cmp": {
                        "op": "eq",
                        "left": {
                          "var": {
                            "scope": "record",
                            "field": "$created_by"
                          }
                        },
                        "right": "principal"
                      }
                    }
                  },
                  "authors_write_posts": {
                    "id": "authors_write_posts",
                    "role": "author",
                    "resource": {
                      "object": "post"
                    },
                    "actions": [
                      "create"
                    ],
                    "condition": {
                      "cmp": {
                        "op": "eq",
                        "left": {
                          "through": {
                            "scope": "new",
                            "reference": "author",
                            "field": "principal"
                          }
                        },
                        "right": "principal"
                      }
                    }
                  },
                  "editors_run_authors": {
                    "id": "editors_run_authors",
                    "role": "editor",
                    "resource": {
                      "object": "author"
                    },
                    "actions": [
                      "create",
                      "update"
                    ]
                  },
                  "editors_run_categories": {
                    "id": "editors_run_categories",
                    "role": "editor",
                    "resource": {
                      "object": "category"
                    },
                    "actions": [
                      "create",
                      "update",
                      "delete"
                    ]
                  },
                  "editors_run_posts": {
                    "id": "editors_run_posts",
                    "role": "editor",
                    "resource": {
                      "object": "post"
                    },
                    "actions": [
                      "read",
                      "create",
                      "update",
                      "delete"
                    ]
