    {
      "id": "samlv-flow",
      "name": "SAML response checks",
      "subject": "identity-service",
      "initial": "samlv-open",
      "description": "One SAML response presented to the identity service. It yields a session only when its assertion is signed by a certificate the tenant configured, the signature covers the subject and attributes that are taken, the issuer is the one the realm names, the audience and recipient name this service, and the response answers a pending request or the tenant enabled sign-in started by the provider.",
      "states": [
        {
          "id": "samlv-open",
          "name": "Deciding"
        }
      ],
      "transitions": [
        {
          "id": "samlv-accept-without-signer",
          "from": "samlv-open",
          "to": "samlv-open",
          "on": "samlv-presented",
          "faultOnly": true,
          "guard": "(event.covered == 'signed') && (event.issuer == 'configured') && (event.audience == 'this-service' && event.recipient == 'this-service') && (event.answers == 'pending' || event.idpInitiated) && (!(event.signer == 'configured'))",
          "description": "Defect: accepts although the condition \"signed by a certificate the tenant configured\" does not hold.",
          "effects": [
            {
              "emit": "samlv-accepted"
            }
          ]
        },
        {
          "id": "samlv-accept-without-covered",
          "from": "samlv-open",
          "to": "samlv-open",
          "on": "samlv-presented",
          "faultOnly": true,
          "guard": "(event.signer == 'configured') && (event.issuer == 'configured') && (event.audience == 'this-service' && event.recipient == 'this-service') && (event.answers == 'pending' || event.idpInitiated) && (!(event.covered == 'signed'))",
          "description": "Defect: accepts although the condition \"subject and attributes taken from the signed part\" does not hold.",
          "effects": [
            {
              "emit": "samlv-accepted"
            }
          ]
        },
        {
          "id": "samlv-accept-without-issuer",
          "from": "samlv-open",
          "to": "samlv-open",
          "on": "samlv-presented",
          "faultOnly": true,
          "guard": "(event.signer == 'configured') && (event.covered == 'signed') && (event.audience == 'this-service' && event.recipient == 'this-service') && (event.answers == 'pending' || event.idpInitiated) && (!(event.issuer == 'configured'))",
          "description": "Defect: accepts although the condition \"issued by the issuer the realm names\" does not hold.",
          "effects": [
            {
              "emit": "samlv-accepted"
            }
          ]
        },
        {
          "id": "samlv-accept-without-audience",
          "from": "samlv-open",
          "to": "samlv-open",
          "on": "samlv-presented",
          "faultOnly": true,
          "guard": "(event.signer == 'configured') && (event.covered == 'signed') && (event.issuer == 'configured') && (event.answers == 'pending' || event.idpInitiated) && (!(event.audience == 'this-service' && event.recipient == 'this-service'))",
          "description": "Defect: accepts although the condition \"audience and recipient name this service\" does not hold.",
          "effects": [
            {
              "emit": "samlv-accepted"
            }
          ]
        },
        {
          "id": "samlv-accept-without-request",
          "from": "samlv-open",
          "to": "samlv-open",
          "on": "samlv-presented",
          "faultOnly": true,
          "guard": "(event.signer == 'configured') && (event.covered == 'signed') && (event.issuer == 'configured') && (event.audience == 'this-service' && event.recipient == 'this-service') && (!(event.answers == 'pending' || event.idpInitiated))",
          "description": "Defect: accepts although the condition \"answers a pending request, or sign-in started by the provider is enabled\" does not hold.",
          "effects": [
            {
              "emit": "samlv-accepted"
            }
          ]
        },
        {
          "id": "samlv-accept",
          "from": "samlv-open",
          "to": "samlv-open",
          "on": "samlv-presented",
          "guard": "(event.signer == 'configured') && (event.covered == 'signed') && (event.issuer == 'configured') && (event.audience == 'this-service' && event.recipient == 'this-service') && (event.answers == 'pending' || event.idpInitiated)",
          "effects": [
            {
              "emit": "samlv-accepted"
            }
          ]
        },
        {
          "id": "samlv-refuse",
          "from": "samlv-open",
          "to": "samlv-open",
          "on": "samlv-presented",
          "effects": [
            {
              "emit": "samlv-refused"
            }
          ]
        }
      ],
      "realisation": "target"
    },
    {
      "id": "samlv-flow-impl",
      "name": "SAML response checks (implementation)",
      "subject": "identity-service",
      "level": "implementation",
      "initial": "samlv-open-i",
      "description": "One SAML response presented to the identity service. It yields a session only when its assertion is signed by a certificate the tenant configured, the signature covers the subject and attributes that are taken, the issuer is the one the realm names, the audience and recipient name this service, and the response answers a pending request or the tenant enabled sign-in started by the provider. This is the decision as the code takes it: it keeps nothing between presentations.",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "states": [
        {
          "id": "samlv-open-i",
          "name": "Deciding"
        }
      ],
      "transitions": [
        {
          "id": "samlv-accept-i",
          "from": "samlv-open-i",
          "to": "samlv-open-i",
          "on": "samlv-presented",
          "guard": "(event.signer == 'configured') && (event.covered == 'signed') && (event.issuer == 'configured') && (event.audience == 'this-service' && event.recipient == 'this-service') && (event.answers == 'pending' || event.idpInitiated)",
          "effects": [
            {
              "emit": "samlv-accepted",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "samlv-refuse-i",
          "from": "samlv-open-i",
          "to": "samlv-open-i",
          "on": "samlv-presented",
          "otherwise": true,
          "effects": [
            {
              "emit": "samlv-refused",
              "to": "web-application"
            }
          ]
        }
      ],
      "refines": "samlv-flow",
      "refinement": {
        "states": {
          "samlv-open-i": "samlv-open"
        },
        "variables": {},
        "transitions": {
          "samlv-accept-i": "samlv-accept",
          "samlv-refuse-i": "samlv-refuse"
        }
      },
      "storage": {
        "record": "rec-identity-decision",
        "key": "decision-id",
        "creates": true
      },
      "realisation": "target"
    },
    {
      "id": "oidcv-flow",
      "name": "OpenID Connect token checks",
      "subject": "identity-service",
      "initial": "oidcv-open",
      "description": "One identity token returned by an OpenID Connect provider. The identity service accepts it only when its issuer, audience, signature and nonce verify, when it is verified with the signature method that the provider configuration names, and when the key that verified it belongs to the provider that issued it.",
      "states": [
        {
          "id": "oidcv-open",
          "name": "Deciding"
        }
      ],
      "transitions": [
        {
          "id": "oidcv-accept-without-issuer",
          "from": "oidcv-open",
          "to": "oidcv-open",
          "on": "oidcv-presented",
          "faultOnly": true,
          "guard": "(event.audience == 'this-client') && (event.signature == 'valid') && (event.nonce == 'match') && (event.alg == event.configuredAlg) && (event.keyOwner == event.provider) && (!(event.issuer == 'configured'))",
          "description": "Defect: accepts although the condition \"issued by the configured issuer\" does not hold.",
          "effects": [
            {
              "emit": "oidcv-accepted"
            }
          ]
        },
        {
          "id": "oidcv-accept-without-audience",
          "from": "oidcv-open",
          "to": "oidcv-open",
          "on": "oidcv-presented",
          "faultOnly": true,
          "guard": "(event.issuer == 'configured') && (event.signature == 'valid') && (event.nonce == 'match') && (event.alg == event.configuredAlg) && (event.keyOwner == event.provider) && (!(event.audience == 'this-client'))",
          "description": "Defect: accepts although the condition \"issued for this client\" does not hold.",
          "effects": [
            {
              "emit": "oidcv-accepted"
            }
          ]
        },
        {
          "id": "oidcv-accept-without-signature",
          "from": "oidcv-open",
          "to": "oidcv-open",
          "on": "oidcv-presented",
          "faultOnly": true,
          "guard": "(event.issuer == 'configured') && (event.audience == 'this-client') && (event.nonce == 'match') && (event.alg == event.configuredAlg) && (event.keyOwner == event.provider) && (!(event.signature == 'valid'))",
          "description": "Defect: accepts although the condition \"carries a valid signature\" does not hold.",
          "effects": [
            {
              "emit": "oidcv-accepted"
            }
          ]
        },
        {
          "id": "oidcv-accept-without-nonce",
          "from": "oidcv-open",
          "to": "oidcv-open",
          "on": "oidcv-presented",
          "faultOnly": true,
          "guard": "(event.issuer == 'configured') && (event.audience == 'this-client') && (event.signature == 'valid') && (event.alg == event.configuredAlg) && (event.keyOwner == event.provider) && (!(event.nonce == 'match'))",
          "description": "Defect: accepts although the condition \"carries the nonce of the request\" does not hold.",
          "effects": [
            {
              "emit": "oidcv-accepted"
            }
          ]
        },
        {
          "id": "oidcv-accept-without-alg",
          "from": "oidcv-open",
          "to": "oidcv-open",
          "on": "oidcv-presented",
          "faultOnly": true,
          "guard": "(event.issuer == 'configured') && (event.audience == 'this-client') && (event.signature == 'valid') && (event.nonce == 'match') && (event.keyOwner == event.provider) && (!(event.alg == event.configuredAlg))",
          "description": "Defect: accepts although the condition \"verified with the configured signature method\" does not hold.",
          "effects": [
            {
              "emit": "oidcv-accepted"
            }
          ]
        },
        {
          "id": "oidcv-accept-without-key",
          "from": "oidcv-open",
          "to": "oidcv-open",
          "on": "oidcv-presented",
          "faultOnly": true,
          "guard": "(event.issuer == 'configured') && (event.audience == 'this-client') && (event.signature == 'valid') && (event.nonce == 'match') && (event.alg == event.configuredAlg) && (!(event.keyOwner == event.provider))",
          "description": "Defect: accepts although the condition \"verified with a key of the issuing provider\" does not hold.",
          "effects": [
            {
              "emit": "oidcv-accepted"
            }
          ]
        },
        {
          "id": "oidcv-accept",
          "from": "oidcv-open",
          "to": "oidcv-open",
          "on": "oidcv-presented",
          "guard": "(event.issuer == 'configured') && (event.audience == 'this-client') && (event.signature == 'valid') && (event.nonce == 'match') && (event.alg == event.configuredAlg) && (event.keyOwner == event.provider)",
          "effects": [
            {
              "emit": "oidcv-accepted"
            }
          ]
        },
        {
          "id": "oidcv-refuse",
          "from": "oidcv-open",
          "to": "oidcv-open",
          "on": "oidcv-presented",
          "effects": [
            {
              "emit": "oidcv-refused"
            }
          ]
        }
      ],
      "realisation": "target"
    },
