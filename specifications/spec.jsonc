    {
      "id": "m-served-only-after-matching-replay",
      "kind": "invariant",
      "models": "mig-566",
      "statement": "A tenant served by the newer version has a replay that reached the hash its journal records.",
      "evaluate": {
        "method": "state-invariant",
        "scenarios": [
          "replay-reaches-the-recorded-hash",
          "replay-reaches-another-hash",
          "serving-requested-without-replay"
        ],
        "expr": "kernel-upgrade-flow.servedByNew => kernel-upgrade-flow.replayed && kernel-upgrade-flow.replayedHash == kernel-upgrade-flow.journalHash",
        "negatives": [
          {
            "scenario": "replay-reaches-another-hash",
            "faults": [
              "defect-switch-unchecked"
            ]
          },
          {
            "scenario": "serving-requested-without-replay",
            "faults": [
              "defect-switch-unchecked"
            ]
          }
        ]
      },
      "faultModel": "fault-model-operations",
      "assumptions": [
        "a-model-abstraction"
      ],
      "faultBasis": "fault"
    },
    {
      "id": "m-mismatching-replay-never-served",
      "kind": "temporal",
      "models": "mig-566",
      "statement": "A tenant whose replay does not reach the recorded hash is not served by the newer version.",
      "evaluate": {
        "method": "never",
        "scenarios": [
          "replay-reaches-another-hash",
          "serving-requested-without-replay"
