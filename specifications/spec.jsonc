          "type": "string"
        },
        {
          "name": "published",
          "type": "bool"
        }
      ],
      "retention": "Until the job worker has handed the event on and the retention of the event log has passed.",
      "schemaVersion": 1,
      "scope": "platform",
      "source": "d-7280",
      "description": "An entry or exit event, written in the transaction that changes the membership, in the ordered log of the segment block that the job worker reads as its outbox (d-7280)."
    },
    {
      "id": "rec-segment-erased",
      "name": "Segment erased person",
      "owner": "runtime",
      "key": [
        "principal-id"
      ],
      "fields": [
        {
          "name": "principal-id",
          "type": "principal-id",
          "refersTo": "principal",
          "role": "subject",
          "onDelete": "restrict",
          "constraints": {
            "pattern": "^[A-Za-z0-9_:.-]+$",
            "maxLength": 96
          }
        }
      ],
      "retention": "For as long as the tenant exists: no later decision enters an erased person into a segment (SEG-037).",
      "schemaVersion": 1,
      "scope": "platform",
      "source": "d-5031",
      "description": "A person whose erasure removed them from every segment, so that no later change or refresh enters them again (SEG-037)."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
