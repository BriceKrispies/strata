    {
      "id": "json-int",
      "description": "serde_json json!(i64): a negative integer is a NegInt, any other a PosInt.",
      "params": [
        {
          "name": "i",
          "type": "i64"
        }
      ],
      "returns": "plain-json",
      "body": "if i < 0 then plain-json.number(json-number.neg-int(i)) else plain-json.number(json-number.pos-int(i))",
      "examples": [
        {
          "args": {
            "i": 3
          },
          "result": {
            "number": {
              "pos-int": 3
            }
          }
        },
        {
          "args": {
            "i": -2
          },
          "result": {
            "number": {
              "neg-int": -2
            }
          }
        }
      ]
    },
    {
      "id": "to-plain-leaf",
      "description": "substrate plain.rs to_plain of a value that is not a list (a list of lists, which schema-problems refuse, is null here). none is the JSON null, which a body cannot write yet (the keyword-named variant gap of WG-4957): callers pass null.",
      "params": [
        {
          "name": "x",
          "type": "value"
        },
        {
          "name": "none",
          "type": "plain-json"
        }
      ],
      "returns": "plain-json",
      "body": "match x { bool(b) => plain-json.bool(b), int(i) => call json-int(i), str(s) => plain-json.string(s), time(t) => call json-int(t), ref(r) => plain-json.number(json-number.pos-int(r)), _ => none }",
      "examples": [
        {
          "args": {
            "x": {
              "time": 5
            },
            "none": "null"
          },
          "result": {
            "number": {
              "pos-int": 5
            }
          }
        },
        {
          "args": {
            "x": {
              "ref": 2
            },
            "none": "null"
          },
          "result": {
            "number": {
              "pos-int": 2
            }
          }
        },
        {
          "args": {
            "x": "null",
            "none": "null"
          },
          "result": "null"
        },
        {
          "args": {
            "x": {
              "int": 3
            },
            "none": "null"
          },
          "result": {
            "number": {
              "pos-int": 3
            }
          }
        },
        {
          "args": {
            "x": {
              "bool": true
            },
            "none": "null"
          },
          "result": {
            "bool": true
          }
        },
        {
          "args": {
            "x": {
              "str": "a"
            },
            "none": "null"
          },
          "result": {
            "string": "a"
          }
        }
      ]
    },
    {
      "id": "to-plain",
      "description": "crates/substrate/src/plain.rs to_plain: a value as plain JSON (a reference and a time as their numbers, a list item by item). none is the JSON null (see to-plain-leaf).",
      "params": [
        {
          "name": "x",
          "type": "value"
        },
        {
          "name": "none",
          "type": "plain-json"
        }
      ],
      "returns": "plain-json",
      "body": "match x { list(items) => plain-json.array(map(i in items, call to-plain-leaf(i, none))), _ => call to-plain-leaf(x, none) }",
      "examples": [
        {
          "args": {
            "x": {
              "list": [
                {
                  "str": "a"
                },
                {
                  "bool": false
                }
              ]
            },
            "none": "null"
          },
          "result": {
            "array": [
              {
                "string": "a"
              },
              {
                "bool": false
              }
            ]
          }
        },
        {
          "args": {
            "x": {
              "str": "a"
            },
            "none": "null"
          },
          "result": {
            "string": "a"
          }
        }
      ]
    },
    {
      "id": "project-record",
      "description": "crates/substrate/src/project.rs project_record: a record as the object id, object, version, created_at, updated_at, created_by (null when not told) and fields (to-plain). none is the JSON null (see to-plain-leaf).",
      "params": [
        {
          "name": "r",
          "type": "record"
        },
        {
          "name": "none",
          "type": "plain-json"
        }
      ],
      "returns": "map<string, plain-json>",
      "body": "insert(insert(insert(insert(insert(insert(insert({}, 'id', plain-json.number(json-number.pos-int(r.id))), 'object', plain-json.string(r.object)), 'version', plain-json.number(json-number.pos-int(r.version))), 'created_at', call json-int(r.created-at)), 'updated_at', call json-int(r.updated-at)), 'created_by', match r.created-by { Some(p) => plain-json.string(p), None => none }), 'fields', plain-json.object(fold(k in keys(r.fields), m = {}, match get(r.fields, k) { Some(x) => insert(m, k, call to-plain(x, none)), None => m })))",
      "examples": [
        {
          "args": {
            "r": {
              "id": 1,
              "object": "person",
              "version": 1,
              "created-at": 1000,
              "updated-at": 1000,
              "fields": {
                "name": {
                  "str": "Ada"
                }
              }
            },
            "none": "null"
          },
          "result": {
            "created_at": {
              "number": {
                "pos-int": 1000
              }
            },
            "created_by": "null",
            "fields": {
              "object": {
                "name": {
                  "string": "Ada"
                }
              }
            },
            "id": {
              "number": {
                "pos-int": 1
              }
            },
            "object": {
              "string": "person"
            },
            "updated_at": {
              "number": {
                "pos-int": 1000
              }
            },
            "version": {
              "number": {
                "pos-int": 1
              }
            }
          }
        }
      ]
    },
    {
      "id": "reading-minutes",
      "description": "crates/substrate/src/project.rs project_row (lines 211-212): reading time at 230 words a minute, rounded up, never less than one minute.",
      "params": [
        {
          "name": "words",
          "type": "u64"
        }
      ],
      "returns": "u64",
      "body": "if words == 0 then 1 else (words + 229) / 230",
      "examples": [
        {
          "args": {
            "words": 0
          },
          "result": 1
        },
        {
          "args": {
            "words": 230
          },
          "result": 1
        },
        {
          "args": {
            "words": 231
          },
          "result": 2
        }
      ]
    },
    {
      "id": "project-row",
      "description": "crates/substrate/src/project.rs project_row: the record (project-record) with refs, each included field's referenced record projected (null when not included; a list keeps the included ones), and, when the section names markdown fields, the blocks of each string one and reading_minutes over their words. markdown holds the parsed blocks and word count of each Markdown source (markdown.rs parse and word_count, a stand-in until the function language has string operations, WG-4957); a source it does not hold is left out. none is the JSON null (see to-plain-leaf).",
      "params": [
        {
          "name": "r",
          "type": "record"
        },
        {
          "name": "section",
          "type": "section-data"
        },
        {
          "name": "markdown",
          "type": "map<string, markdown-summary>"
        },
        {
          "name": "none",
          "type": "plain-json"
        }
      ],
      "returns": "plain-json",
      "let": [
        {
          "name": "base",
          "expr": "call project-record(r, none)"
        },
        {
          "name": "refs",
          "expr": "fold(f in keys(section.included), m = {}, match get(section.included, f) { None => m, Some(inc) => match call field-value(r, f) { ref(id) => insert(m, f, match get(inc, id) { Some(t) => plain-json.object(call project-record(t, none)), None => none }), list(items) => insert(m, f, plain-json.array(fold(i in items, xs = [], match i { ref(id) => match get(inc, id) { Some(t) => concat(xs, [plain-json.object(call project-record(t, none))]), None => xs }, _ => xs }))), _ => m } })"
        },
        {
          "name": "summary",
          "expr": "fold(f in section.markdown, acc = markdown-fold{blocks: {}, words: 0}, match call field-value(r, f) { str(source) => match get(markdown, source) { Some(md) => markdown-fold{blocks: insert(acc.blocks, f, md.blocks), words: acc.words + md.words}, None => acc }, _ => acc })"
        }
      ],
      "body": "plain-json.object(if section.markdown == [] then insert(base, 'refs', plain-json.object(refs)) else insert(insert(insert(base, 'refs', plain-json.object(refs)), 'blocks', plain-json.object(summary.blocks)), 'reading_minutes', call json-int(call reading-minutes(summary.words))))",
      "examples": [
        {
          "description": "A row with an included author and a markdown field.",
          "args": {
            "r": {
              "id": 2,
              "object": "post",
              "version": 1,
              "created-by": "alpha:writer",
              "created-at": 2000,
              "updated-at": 2000,
              "fields": {
                "author": {
                  "ref": 1
                },
                "status": {
                  "str": "published"
                },
                "title": {
                  "str": "B"
                }
              }
            },
            "section": {
              "single": false,
              "rows": [
                {
                  "id": 2,
                  "object": "post",
                  "version": 1,
                  "created-by": "alpha:writer",
                  "created-at": 2000,
                  "updated-at": 2000,
                  "fields": {
                    "author": {
                      "ref": 1
                    },
                    "status": {
                      "str": "published"
                    },
                    "title": {
                      "str": "B"
                    }
                  }
                }
              ],
              "included": {
                "author": {
                  "1": {
                    "id": 1,
                    "object": "person",
                    "version": 1,
                    "created-at": 1000,
                    "updated-at": 1000,
                    "fields": {
                      "name": {
                        "str": "Ada"
                      }
                    }
                  }
                }
              },
              "markdown": [
                "title"
              ]
            },
            "markdown": {
              "B": {
                "blocks": {
                  "array": []
                },
                "words": 1
              }
            },
            "none": "null"
          },
          "result": {
            "object": {
              "blocks": {
                "object": {
                  "title": {
                    "array": []
                  }
                }
              },
              "created_at": {
                "number": {
                  "pos-int": 2000
                }
              },
              "created_by": {
                "string": "alpha:writer"
              },
              "fields": {
                "object": {
                  "author": {
                    "number": {
                      "pos-int": 1
                    }
                  },
                  "status": {
                    "string": "published"
                  },
                  "title": {
                    "string": "B"
                  }
                }
              },
              "id": {
                "number": {
                  "pos-int": 2
                }
              },
              "object": {
                "string": "post"
              },
              "reading_minutes": {
                "number": {
                  "pos-int": 1
                }
              },
              "refs": {
                "object": {
                  "author": {
                    "object": {
                      "created_at": {
                        "number": {
                          "pos-int": 1000
                        }
                      },
                      "created_by": "null",
                      "fields": {
                        "object": {
                          "name": {
                            "string": "Ada"
                          }
                        }
                      },
                      "id": {
                        "number": {
                          "pos-int": 1
                        }
                      },
                      "object": {
                        "string": "person"
                      },
                      "updated_at": {
                        "number": {
                          "pos-int": 1000
                        }
                      },
                      "version": {
                        "number": {
                          "pos-int": 1
                        }
                      }
                    }
                  }
                }
              },
              "updated_at": {
                "number": {
                  "pos-int": 2000
                }
              },
              "version": {
                "number": {
                  "pos-int": 1
                }
              }
            }
          }
        }
      ]
    },
    {
      "id": "project-view",
      "description": "crates/substrate/src/project.rs project: raw view data as the plain view model the browser renders: view, title, params, data (a single section one row or null, any other an array of rows, project-row), depends_on, revision and schema_version. The BFF adds the path and the publication template's fields (theme and the desk's, WG-4942). none is the JSON null (see to-plain-leaf).",
      "params": [
        {
          "name": "data",
          "type": "view-data"
        },
        {
          "name": "markdown",
          "type": "map<string, markdown-summary>"
        },
        {
          "name": "none",
          "type": "plain-json"
        }
      ],
      "returns": "plain-json",
      "body": "plain-json.object(insert(insert(insert(insert(insert(insert(insert({}, 'view', plain-json.string(data.view)), 'title', plain-json.string(data.title)), 'params', plain-json.object(fold(k in keys(data.params), m = {}, match get(data.params, k) { Some(x) => insert(m, k, plain-json.string(x)), None => m }))), 'data', plain-json.object(fold(k in keys(data.sections), m = {}, match get(data.sections, k) { None => m, Some(s) => insert(m, k, if s.single then match get(s.rows, 0) { Some(r) => call project-row(r, s, markdown, none), None => none } else plain-json.array(map(r in s.rows, call project-row(r, s, markdown, none)))) }))), 'depends_on', plain-json.array(map(o in data.depends-on, plain-json.string(o)))), 'revision', plain-json.number(json-number.pos-int(data.revision))), 'schema_version', plain-json.number(json-number.pos-int(data.schema-version))))",
      "examples": [
        {
          "description": "A single section without a row is null.",
          "args": {
            "data": {
              "view": "one",
              "title": "Post",
              "params": {
                "title": "Q"
              },
              "sections": {
                "post": {
                  "single": true,
                  "rows": [],
                  "included": {},
                  "markdown": []
                }
              },
              "depends-on": [
                "post"
              ],
              "revision": 5,
              "schema-version": 2
            },
            "markdown": {},
            "none": "null"
          },
          "result": {
            "object": {
              "data": {
                "object": {
                  "post": "null"
                }
              },
              "depends_on": {
                "array": [
                  {
                    "string": "post"
                  }
                ]
              },
              "params": {
                "object": {
                  "title": {
                    "string": "Q"
                  }
                }
              },
              "revision": {
                "number": {
                  "pos-int": 5
                }
              },
              "schema_version": {
                "number": {
                  "pos-int": 2
                }
              },
              "title": {
                "string": "Post"
              },
              "view": {
                "string": "one"
              }
            }
          }
        }
      ]
    }
  ]
,
  "featureFlags": [
    {
      "id": "assistant-flag",
