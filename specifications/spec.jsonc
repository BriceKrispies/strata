      "models": "fed-258",
      "statement": "The principal created at a first federated sign-in holds the default role of the realm, whatever the provider asserts.",
      "evaluate": {
        "method": "state-invariant",
        "scenarios": [
          "provider-asserts-admin"
        ],
        "expr": "first-sign-in-role-flow.role == first-sign-in-role-flow.defaultRole",
        "negatives": [
          {
            "scenario": "provider-asserts-admin",
            "faults": [
              "defect-asserted-role-granted"
            ]
          }
        ]
      },
      "faultModel": "fault-model-launch",
      "assumptions": [
        "a-model-abstraction"
      ],
      "faultBasis": "fault"
    },
    {
      "id": "m-first-sign-in-role-flow-refined",
      "kind": "temporal",
      "models": "fed-258",
      "statement": "The implementation of principal creation refines the role model.",
      "evaluate": {
        "method": "refines",
        "behavior": "first-sign-in-role-flow-impl",
        "scenarios": [
          "provider-asserts-admin-impl"
        ]
      },
      "faultModel": "fault-model-launch",
      "assumptions": [
        "a-model-abstraction"
      ]
    },
    {
      "id": "m-revoked-grant-token-refused",
      "kind": "temporal",
      "models": "tok-007",
      "statement": "A token of a revoked grant is not accepted once the bound of 5 seconds has passed, whether or not the revocation notice arrived.",
      "evaluate": {
        "method": "never",
        "scenarios": [
          "grant-revoked-notice-lost",
          "grant-revoked-notice-heard"
        ],
        "occurs": {
          "event": "tg-accepted"
        },
        "negatives": [
          {
            "scenario": "grant-revoked-notice-lost",
            "faults": [
              "defect-revoked-grant-token-accepted"
            ]
          }
        ]
      },
      "faultModel": "fault-model-launch",
      "assumptions": [
        "a-model-abstraction",
        "a-clock-skew",
        "a-tick"
      ],
      "faultBasis": "fault"
    },
    {
      "id": "m-live-grant-token-accepted",
      "kind": "temporal",
      "models": "tok-007",
      "statement": "A token of a live grant is accepted after the copy has been checked again.",
      "evaluate": {
        "method": "eventually",
        "scenarios": [
          "grant-live"
        ],
        "occurs": {
          "event": "tg-accepted"
        },
        "negatives": [
          {
            "scenario": "grant-live",
            "faults": [
              "grant-recheck-disabled"
            ]
          }
        ]
      },
      "faultModel": "fault-model-launch",
      "assumptions": [
        "a-model-abstraction",
        "a-tick"
      ],
      "faultBasis": "restatement"
    },
    {
      "id": "m-token-verifier-flow-refined",
      "kind": "temporal",
      "models": "tok-007",
      "statement": "The implementation of the verifier copy refines the verifier model.",
      "evaluate": {
        "method": "refines",
        "behavior": "token-verifier-flow-impl",
        "scenarios": [
          "grant-revoked-notice-lost-impl",
          "grant-revoked-notice-heard-impl",
          "grant-live-impl"
        ]
      },
      "faultModel": "fault-model-launch",
      "assumptions": [
        "a-model-abstraction"
      ]
    },
    {
      "id": "m-previous-key-verifies-after-rotation",
      "kind": "temporal",
      "models": "tok-008",
      "statement": "After a rotation, a token signed by the previous key and not expired still verifies.",
      "evaluate": {
        "method": "eventually",
        "scenarios": [
          "rotated-key-still-verifies"
        ],
        "occurs": {
          "event": "sk-accepted"
        },
        "negatives": [
          {
            "scenario": "rotated-key-still-verifies",
            "faults": [
              "defect-rotation-drops-previous-key"
            ]
          }
        ]
      },
      "faultModel": "fault-model-launch",
      "assumptions": [
        "a-model-abstraction"
      ],
      "faultBasis": "restatement"
    },
    {
      "id": "m-expired-token-refused-after-rotation",
      "kind": "temporal",
      "models": "tok-008",
      "statement": "A token signed by the previous key stops verifying when it expires.",
      "evaluate": {
        "method": "never",
        "scenarios": [
