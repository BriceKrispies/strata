          "guard": "event.draftVersion != schemaVersion",
          "effects": [
            {
              "set": "refusedNamed",
              "to": "schemaVersion"
            },
            {
              "emit": "ds-save-refused",
              "to": "gateway"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "ds-open-i": "ds-open"
        },
        "variables": {
          "schemaVersion": "schemaVersion",
          "saved": "saved",
          "lastSavedAgainst": "lastSavedAgainst",
          "schemaAtSave": "schemaAtSave",
          "refusedNamed": "refusedNamed",
          "draftText": "draftText"
        },
        "transitions": {
          "ds-schema-change-i": "ds-schema-change",
          "ds-save-i": "ds-save",
          "ds-save-refused-stale-i": "ds-save-refused-stale"
        }
      },
      "storage": {
        "record": "rec-draft-save",
        "key": "tenant-id",
        "creates": true
      },
      "instances": {
        "key": "tenant-id",
        "storedIn": "rec-draft-save",
        "max": 16
      }
    },
    {
      "id": "workflow-version-flow",
      "name": "Workflow run across a definition change",
      "subject": "automation-worker",
      "initial": "wf-idle",
      "description": "A workflow run started under one definition version. Its steps run under that version when the definition changes; a run that the new definition cannot continue stops with the steps it did recorded.",
      "variables": [
        {
          "name": "definitionVersion",
          "type": "number",
          "initial": 1
        },
        {
          "name": "runVersion",
          "type": "number",
          "initial": 0
        },
        {
          "name": "lastStepVersion",
          "type": "number",
          "initial": 0
        },
        {
          "name": "steps",
          "type": "number",
          "initial": 0
        },
        {
          "name": "stopped",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "recordedSteps",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "wf-idle",
          "name": "Not started"
        },
        {
          "id": "wf-running",
          "name": "Running"
        },
        {
          "id": "wf-stopped",
          "name": "Stopped",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "wf-step-uses-current",
          "from": "wf-running",
          "to": "wf-running",
          "on": "wf-step-due",
          "effects": [
            {
              "set": "steps",
              "to": "steps + 1"
            },
            {
              "set": "lastStepVersion",
              "to": "definitionVersion"
            }
          ],
          "faultOnly": true,
          "description": "Defect: continues a run under the definition version in force instead of the one that started it."
        },
        {
          "id": "wf-stop-unrecorded",
          "from": "wf-running",
          "to": "wf-stopped",
          "on": "wf-definition-changed",
          "guard": "!event.retained",
          "effects": [
            {
              "set": "definitionVersion",
              "to": "definitionVersion + 1"
            },
            {
              "set": "stopped",
              "to": true
            },
            {
              "emit": "wf-run-stopped"
            }
          ],
          "faultOnly": true,
          "description": "Defect: stops the run without recording its state."
        },
        {
          "id": "wf-start",
          "from": "wf-idle",
          "to": "wf-running",
          "on": "wf-run-started",
          "effects": [
            {
              "set": "runVersion",
              "to": "definitionVersion"
            }
          ]
        },
        {
          "id": "wf-change-retained",
          "from": "wf-running",
          "to": "wf-running",
          "on": "wf-definition-changed",
          "guard": "event.retained",
          "effects": [
            {
              "set": "definitionVersion",
              "to": "definitionVersion + 1"
            }
          ]
        },
        {
          "id": "wf-change-withdrawn",
          "from": "wf-running",
          "to": "wf-stopped",
          "on": "wf-definition-changed",
          "guard": "!event.retained",
          "effects": [
            {
              "set": "definitionVersion",
              "to": "definitionVersion + 1"
            },
            {
              "set": "stopped",
              "to": true
            },
            {
              "set": "recordedSteps",
              "to": "steps"
            },
            {
              "emit": "wf-run-stopped"
            }
          ]
        },
        {
          "id": "wf-step",
          "from": "wf-running",
          "to": "wf-running",
          "on": "wf-step-due",
          "effects": [
            {
              "set": "steps",
              "to": "steps + 1"
            },
            {
              "set": "lastStepVersion",
              "to": "runVersion"
            }
          ]
        }
      ]
    },
    {
      "id": "workflow-version-flow-impl",
      "name": "Workflow run across a definition change (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "workflow-version-flow",
      "description": "A workflow run started under one definition version. Its steps run under that version when the definition changes; a run that the new definition cannot continue stops with the steps it did recorded.",
      "initial": "wf-idle-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "definitionVersion",
          "type": "number",
          "initial": 1,
          "repr": "u64"
        },
        {
          "name": "runVersion",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "lastStepVersion",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "steps",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "stopped",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "recordedSteps",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        }
      ],
      "states": [
        {
          "id": "wf-idle-i",
          "name": "Not started",
          "ignores": [
            "wf-definition-changed",
            "wf-step-due"
          ]
        },
        {
          "id": "wf-running-i",
          "name": "Running",
          "ignores": [
            "wf-run-started"
          ]
        },
        {
          "id": "wf-stopped-i",
          "name": "Stopped",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "wf-start-i",
          "from": "wf-idle-i",
          "to": "wf-running-i",
          "on": "wf-run-started",
          "otherwise": true,
          "effects": [
            {
              "set": "runVersion",
              "to": "definitionVersion"
            }
          ]
        },
        {
          "id": "wf-change-retained-i",
          "from": "wf-running-i",
          "to": "wf-running-i",
          "on": "wf-definition-changed",
          "guard": "event.retained",
          "effects": [
            {
              "set": "definitionVersion",
              "to": "definitionVersion + 1"
            }
          ]
        },
        {
          "id": "wf-change-withdrawn-i",
          "from": "wf-running-i",
          "to": "wf-stopped-i",
          "on": "wf-definition-changed",
          "guard": "!event.retained",
          "effects": [
            {
              "set": "definitionVersion",
              "to": "definitionVersion + 1"
            },
            {
              "set": "stopped",
              "to": true
            },
            {
              "set": "recordedSteps",
              "to": "steps"
            },
            {
              "emit": "wf-run-stopped",
              "to": "operator-console"
            }
          ]
        },
        {
          "id": "wf-step-i",
          "from": "wf-running-i",
          "to": "wf-running-i",
          "on": "wf-step-due",
          "otherwise": true,
          "effects": [
            {
              "set": "steps",
              "to": "steps + 1"
            },
            {
              "set": "lastStepVersion",
              "to": "runVersion"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "wf-idle-i": "wf-idle",
          "wf-running-i": "wf-running",
          "wf-stopped-i": "wf-stopped"
        },
        "variables": {
          "definitionVersion": "definitionVersion",
          "runVersion": "runVersion",
          "lastStepVersion": "lastStepVersion",
          "steps": "steps",
          "stopped": "stopped",
          "recordedSteps": "recordedSteps"
        },
        "transitions": {
          "wf-start-i": "wf-start",
          "wf-change-retained-i": "wf-change-retained",
          "wf-change-withdrawn-i": "wf-change-withdrawn",
          "wf-step-i": "wf-step"
        }
      },
      "storage": {
        "record": "rec-workflow-version",
        "key": "tenant-id",
        "creates": true
      },
      "instances": {
        "key": "tenant-id",
        "storedIn": "rec-workflow-version",
        "max": 16
      }
    },
    {
      "id": "scheduled-job-check-flow",
      "name": "Scheduled job against the schema",
      "subject": "automation-worker",
      "initial": "sj-open",
      "description": "A scheduled job defined against schema version 1. When it falls due it is checked against the schema version in force: it runs when the definition still fits, and is refused with the changed field named when it does not.",
      "variables": [
        {
          "name": "schemaVersion",
          "type": "number",
          "initial": 1
        },
        {
          "name": "jobDefinedAgainst",
          "type": "number",
          "initial": 1
        },
        {
          "name": "changedField",
          "type": "string",
          "initial": ""
        },
        {
          "name": "runs",
          "type": "number",
          "initial": 0
        },
        {
          "name": "lastRunSchema",
          "type": "number",
          "initial": 0
        },
        {
          "name": "lastRunDefinedAgainst",
          "type": "number",
          "initial": 0
        },
        {
          "name": "refusedNaming",
          "type": "string",
          "initial": ""
        }
      ],
      "states": [
        {
          "id": "sj-open",
          "name": "Schedule held"
        }
      ],
      "transitions": [
        {
          "id": "sj-run-stale-job",
          "from": "sj-open",
          "to": "sj-open",
          "on": "sj-job-due",
          "guard": "jobDefinedAgainst != schemaVersion",
          "effects": [
            {
              "set": "runs",
              "to": "runs + 1"
            },
            {
              "set": "lastRunSchema",
              "to": "schemaVersion"
            },
            {
              "set": "lastRunDefinedAgainst",
              "to": "jobDefinedAgainst"
            },
            {
              "emit": "sj-job-run"
            }
          ],
          "faultOnly": true,
          "description": "Defect: runs a job whose definition no longer fits the schema."
        },
        {
          "id": "sj-refusal-unnamed",
          "from": "sj-open",
          "to": "sj-open",
          "on": "sj-job-due",
          "guard": "jobDefinedAgainst != schemaVersion",
          "effects": [
            {
              "emit": "sj-job-refused"
            }
          ],
          "faultOnly": true,
          "description": "Defect: refuses the job without naming the changed field."
        },
        {
          "id": "sj-schema-change",
          "from": "sj-open",
          "to": "sj-open",
          "on": "sj-schema-changed",
          "effects": [
            {
              "set": "schemaVersion",
              "to": "schemaVersion + 1"
            },
            {
              "set": "changedField",
              "to": "event.field"
            }
          ]
        },
        {
          "id": "sj-run",
          "from": "sj-open",
          "to": "sj-open",
          "on": "sj-job-due",
          "guard": "jobDefinedAgainst == schemaVersion",
          "effects": [
            {
              "set": "runs",
              "to": "runs + 1"
            },
            {
              "set": "lastRunSchema",
              "to": "schemaVersion"
            },
            {
              "set": "lastRunDefinedAgainst",
              "to": "jobDefinedAgainst"
            },
            {
              "emit": "sj-job-run"
            }
          ]
        },
        {
          "id": "sj-refuse",
          "from": "sj-open",
          "to": "sj-open",
          "on": "sj-job-due",
          "guard": "jobDefinedAgainst != schemaVersion",
          "effects": [
            {
              "set": "refusedNaming",
              "to": "changedField"
            },
            {
              "emit": "sj-job-refused"
            }
          ]
        }
      ]
    },
    {
      "id": "scheduled-job-check-flow-impl",
      "name": "Scheduled job against the schema (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "scheduled-job-check-flow",
      "description": "A scheduled job defined against schema version 1. When it falls due it is checked against the schema version in force: it runs when the definition still fits, and is refused with the changed field named when it does not.",
      "initial": "sj-open-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "schemaVersion",
          "type": "number",
          "initial": 1,
          "repr": "u64"
        },
        {
          "name": "jobDefinedAgainst",
          "type": "number",
          "initial": 1,
          "repr": "u64"
        },
        {
          "name": "changedField",
          "type": "string",
          "initial": "",
          "repr": "string"
        },
        {
          "name": "runs",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "lastRunSchema",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "lastRunDefinedAgainst",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "refusedNaming",
          "type": "string",
          "initial": "",
          "repr": "string"
        }
      ],
      "states": [
        {
          "id": "sj-open-i",
          "name": "Schedule held"
        }
      ],
      "transitions": [
        {
          "id": "sj-schema-change-i",
          "from": "sj-open-i",
          "to": "sj-open-i",
          "on": "sj-schema-changed",
          "otherwise": true,
          "effects": [
            {
              "set": "schemaVersion",
              "to": "schemaVersion + 1"
            },
            {
              "set": "changedField",
              "to": "event.field"
            }
          ]
        },
        {
          "id": "sj-run-i",
          "from": "sj-open-i",
          "to": "sj-open-i",
          "on": "sj-job-due",
          "guard": "jobDefinedAgainst == schemaVersion",
          "effects": [
            {
              "set": "runs",
              "to": "runs + 1"
            },
            {
              "set": "lastRunSchema",
              "to": "schemaVersion"
            },
            {
              "set": "lastRunDefinedAgainst",
              "to": "jobDefinedAgainst"
            },
            {
              "emit": "sj-job-run",
              "to": "operator-console"
            }
          ]
        },
        {
          "id": "sj-refuse-i",
          "from": "sj-open-i",
          "to": "sj-open-i",
          "on": "sj-job-due",
          "guard": "jobDefinedAgainst != schemaVersion",
          "effects": [
            {
              "set": "refusedNaming",
              "to": "changedField"
            },
            {
              "emit": "sj-job-refused",
              "to": "operator-console"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "sj-open-i": "sj-open"
        },
        "variables": {
          "schemaVersion": "schemaVersion",
          "jobDefinedAgainst": "jobDefinedAgainst",
          "changedField": "changedField",
          "runs": "runs",
          "lastRunSchema": "lastRunSchema",
          "lastRunDefinedAgainst": "lastRunDefinedAgainst",
          "refusedNaming": "refusedNaming"
        },
        "transitions": {
          "sj-schema-change-i": "sj-schema-change",
          "sj-run-i": "sj-run",
          "sj-refuse-i": "sj-refuse"
        }
      },
      "storage": {
        "record": "rec-scheduled-job-check",
        "key": "tenant-id",
        "creates": true
      },
      "instances": {
        "key": "tenant-id",
        "storedIn": "rec-scheduled-job-check",
        "max": 16
      }
    },
    {
      "id": "template-proposal-flow",
      "name": "Template version proposal",
      "subject": "control-plane",
      "initial": "tp-idle",
      "description": "A newer version of an installed template. It reaches the tenant as a proposal that carries its projection; nothing changes until the tenant approves, and an apply before the approval is refused.",
      "variables": [
        {
          "name": "projected",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "approved",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "applied",
          "type": "boolean",
          "initial": false
        }
      ],
      "states": [
        {
          "id": "tp-idle",
          "name": "No proposal"
        },
        {
          "id": "tp-proposed",
          "name": "Proposed"
        },
        {
          "id": "tp-approved",
          "name": "Approved"
        },
        {
          "id": "tp-applied",
          "name": "Applied",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "tp-apply-on-publish",
          "from": "tp-idle",
          "to": "tp-applied",
          "on": "tp-version-published",
          "effects": [
            {
              "set": "projected",
              "to": true
            },
            {
              "set": "applied",
              "to": true
            },
            {
              "emit": "tp-template-applied"
            }
          ],
          "faultOnly": true,
          "description": "Defect: applies the newer version as soon as it is published."
        },
        {
          "id": "tp-apply-before-approval",
          "from": "tp-proposed",
          "to": "tp-applied",
          "on": "tp-apply-requested",
          "effects": [
            {
              "set": "applied",
              "to": true
            },
            {
              "emit": "tp-template-applied"
            }
          ],
          "faultOnly": true,
          "description": "Defect: applies a proposal the tenant has not approved."
        },
        {
          "id": "tp-propose",
          "from": "tp-idle",
          "to": "tp-proposed",
          "on": "tp-version-published",
          "effects": [
            {
              "set": "projected",
              "to": true
            },
            {
              "emit": "tp-proposal-created"
            }
          ]
        },
        {
          "id": "tp-approve",
          "from": "tp-proposed",
          "to": "tp-approved",
          "on": "tp-tenant-approved",
          "effects": [
            {
              "set": "approved",
              "to": true
            }
          ]
        },
        {
          "id": "tp-apply",
          "from": "tp-approved",
          "to": "tp-applied",
          "on": "tp-apply-requested",
          "effects": [
            {
              "set": "applied",
              "to": true
            },
            {
              "emit": "tp-template-applied"
            }
          ]
        },
        {
          "id": "tp-apply-refused-proposed",
          "from": "tp-proposed",
          "to": "tp-proposed",
          "on": "tp-apply-requested",
          "effects": [
            {
              "emit": "tp-apply-refused"
            }
          ]
        },
        {
          "id": "tp-apply-refused-idle",
          "from": "tp-idle",
          "to": "tp-idle",
          "on": "tp-apply-requested",
          "effects": [
            {
              "emit": "tp-apply-refused"
            }
          ]
        }
      ]
    },
    {
      "id": "template-proposal-flow-impl",
      "name": "Template version proposal (implementation)",
      "level": "implementation",
      "subject": "control-plane",
      "refines": "template-proposal-flow",
      "description": "A newer version of an installed template. It reaches the tenant as a proposal that carries its projection; nothing changes until the tenant approves, and an apply before the approval is refused.",
      "initial": "tp-idle-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "projected",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "approved",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "applied",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        }
      ],
      "states": [
        {
          "id": "tp-idle-i",
          "name": "No proposal",
          "ignores": [
            "tp-tenant-approved"
          ]
        },
        {
          "id": "tp-proposed-i",
          "name": "Proposed",
          "ignores": [
            "tp-version-published"
          ]
        },
        {
          "id": "tp-approved-i",
          "name": "Approved",
          "ignores": [
            "tp-version-published",
            "tp-tenant-approved"
          ]
        },
        {
          "id": "tp-applied-i",
          "name": "Applied",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "tp-propose-i",
          "from": "tp-idle-i",
          "to": "tp-proposed-i",
          "on": "tp-version-published",
          "otherwise": true,
          "effects": [
            {
              "set": "projected",
              "to": true
            },
            {
              "emit": "tp-proposal-created",
              "to": "operator-console"
            }
          ]
        },
        {
          "id": "tp-approve-i",
          "from": "tp-proposed-i",
          "to": "tp-approved-i",
          "on": "tp-tenant-approved",
          "otherwise": true,
          "effects": [
            {
              "set": "approved",
              "to": true
            }
          ]
        },
        {
          "id": "tp-apply-i",
          "from": "tp-approved-i",
          "to": "tp-applied-i",
          "on": "tp-apply-requested",
          "otherwise": true,
          "effects": [
            {
              "set": "applied",
              "to": true
            },
            {
              "emit": "tp-template-applied",
              "to": "operator-console"
            }
          ]
        },
        {
          "id": "tp-apply-refused-proposed-i",
          "from": "tp-proposed-i",
          "to": "tp-proposed-i",
          "on": "tp-apply-requested",
          "otherwise": true,
          "effects": [
            {
              "emit": "tp-apply-refused",
              "to": "operator-console"
            }
          ]
        },
        {
          "id": "tp-apply-refused-idle-i",
          "from": "tp-idle-i",
          "to": "tp-idle-i",
          "on": "tp-apply-requested",
          "otherwise": true,
          "effects": [
            {
              "emit": "tp-apply-refused",
              "to": "operator-console"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "tp-idle-i": "tp-idle",
          "tp-proposed-i": "tp-proposed",
          "tp-approved-i": "tp-approved",
          "tp-applied-i": "tp-applied"
        },
        "variables": {
          "projected": "projected",
          "approved": "approved",
          "applied": "applied"
        },
        "transitions": {
          "tp-propose-i": "tp-propose",
          "tp-approve-i": "tp-approve",
          "tp-apply-i": "tp-apply",
          "tp-apply-refused-proposed-i": "tp-apply-refused-proposed",
          "tp-apply-refused-idle-i": "tp-apply-refused-idle"
        }
      },
      "storage": {
        "record": "rec-template-proposal",
        "key": "tenant-id",
        "creates": true
      },
      "instances": {
        "key": "tenant-id",
        "storedIn": "rec-template-proposal",
        "max": 16
      }
    },
    {
      "id": "import-flow",
      "name": "Import of records and pages",
      "subject": "migration-job",
      "initial": "im-open",
      "description": "An import into one tenant. A record the tenant already holds is updated and not duplicated, so the import can be run again; each former address that an imported page names gets a redirect.",
      "variables": [
        {
          "name": "holdsR1",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "holdsR2",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "held",
          "type": "number",
          "initial": 0
        },
        {
          "name": "updates",
          "type": "number",
          "initial": 0
        },
        {
          "name": "formerAddresses",
          "type": "number",
          "initial": 0
        },
        {
          "name": "redirects",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "im-open",
          "name": "Tenant serving"
        }
      ],
      "transitions": [
        {
          "id": "im-duplicate-record",
          "from": "im-open",
          "to": "im-open",
          "on": "im-record-imported",
          "effects": [
            {
              "set": "held",
              "to": "held + 1"
            }
          ],
          "faultOnly": true,
          "description": "Defect: creates a record again when the import is run again."
        },
        {
          "id": "im-page-without-redirects",
          "from": "im-open",
          "to": "im-open",
          "on": "im-page-imported",
          "effects": [
            {
              "set": "formerAddresses",
              "to": "formerAddresses + event.formers"
            }
          ],
          "faultOnly": true,
          "description": "Defect: imports a page and creates no redirect for its former addresses."
        },
        {
          "id": "im-create-r1",
          "from": "im-open",
          "to": "im-open",
          "on": "im-record-imported",
          "guard": "event.record == 'r1' && !holdsR1",
          "effects": [
            {
              "set": "holdsR1",
              "to": true
            },
            {
              "set": "held",
              "to": "held + 1"
            }
          ]
        },
        {
          "id": "im-update-r1",
          "from": "im-open",
          "to": "im-open",
          "on": "im-record-imported",
          "guard": "event.record == 'r1' && holdsR1",
          "effects": [
            {
              "set": "updates",
              "to": "updates + 1"
            }
          ]
        },
        {
          "id": "im-create-r2",
          "from": "im-open",
          "to": "im-open",
          "on": "im-record-imported",
          "guard": "event.record == 'r2' && !holdsR2",
          "effects": [
            {
              "set": "holdsR2",
              "to": true
            },
            {
              "set": "held",
              "to": "held + 1"
            }
          ]
        },
        {
          "id": "im-update-r2",
          "from": "im-open",
          "to": "im-open",
          "on": "im-record-imported",
          "guard": "event.record == 'r2' && holdsR2",
          "effects": [
            {
              "set": "updates",
              "to": "updates + 1"
            }
          ]
        },
        {
          "id": "im-page",
          "from": "im-open",
          "to": "im-open",
          "on": "im-page-imported",
          "effects": [
            {
              "set": "formerAddresses",
              "to": "formerAddresses + event.formers"
            },
            {
              "set": "redirects",
              "to": "redirects + event.formers"
            }
          ]
        }
      ]
    },
    {
      "id": "import-flow-impl",
      "name": "Import of records and pages (implementation)",
      "level": "implementation",
      "subject": "migration-job",
      "refines": "import-flow",
