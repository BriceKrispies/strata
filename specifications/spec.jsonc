    {
      "id": "decide-run",
      "description": "triggers.rs decide, after the checks of the automation: the condition of the trigger, the hop limit and the run key, in that order. A condition that is false appends nothing (D-6530); one that cannot be evaluated declines with condition-failed (the condition of trigger <id> cannot be evaluated); a hop past 8 declines with hop-limit; a run key that is null or cannot be evaluated declines with condition-failed; otherwise the run starts (trigger-start). The condition and the run key are evaluated as the automation principal automation:<id>, with its run-as roles and no others (D-6525, D-7201), over the scopes the event binds and the parameters of event-bound-params. Not mirrored: the check of what the principal may not read (a condition or run key that reads a field whose read rule hides it declines with condition-failed), which walks the expression and so needs a recursion specc refuses, and the InsufficientState of a record a condition follows to (difference 2); the differential guards both.",
      "params": [
        {
          "name": "after",
          "type": "tenant-state"
        },
        {
          "name": "ctx",
          "type": "context"
        },
        {
          "name": "hop",
          "type": "u32"
        },
        {
          "name": "event",
          "type": "domain-event"
        },
        {
          "name": "trigger",
          "type": "trigger-def"
        },
        {
          "name": "a",
          "type": "automation-def"
        },
        {
          "name": "s",
          "type": "trigger-scopes"
        }
      ],
      "returns": "option<effect>",
      "let": [
        {
          "name": "pid",
          "expr": "format('automation:{}', a.id)"
        },
        {
          "name": "params",
          "expr": "call event-bound-params(event, hop, trigger.on)"
        },
        {
          "name": "env",
          "expr": "expr-env{record: match s.record { Some(r) => call record-scope(r), None => null }, old: match s.old { Some(r) => call record-scope(r), None => null }, new: match s.new { Some(r) => call record-scope(r), None => null }, param: params, now: value.time(ctx.now), principal: value.str(pid), has_role: call roles-of(after, principal.user(pid))}"
        },
        {
          "name": "cond",
          "expr": "match trigger.condition { None => 1, Some(c) => match eval(tenant-rule-language, c, env) { Ok(v) => if v == value.bool(true) then 1 else 0, Err(_) => 2 } }"
        }
      ],
      "body": "if cond == 0 then null else if cond == 2 then call trigger-decline(trigger, event, hop, automation-exception-reason.condition-failed, format('the condition of trigger {} cannot be evaluated', trigger.id)) else if hop > 8 then call trigger-decline(trigger, event, hop, automation-exception-reason.hop-limit, format('hop {} is past the hop limit of {}', hop, 8)) else match a.run-key { None => call trigger-start(after, a, trigger, event, hop, params, null), Some(key) => match eval(tenant-rule-language, key, env) { Ok(v) => match v { null => call trigger-decline(trigger, event, hop, automation-exception-reason.condition-failed, format('the run key of automation {} is null', a.id)), _ => call trigger-start(after, a, trigger, event, hop, params, call value-canonical-json(v)) }, Err(_) => call trigger-decline(trigger, event, hop, automation-exception-reason.condition-failed, format('the run key of automation {} cannot be evaluated', a.id)) } }",
      "examples": [
        {
          "description": "A condition that holds and no run key start the run.",
          "args": {
            "after": {
              "fixture": "fx-tenant-state-28"
            },
            "ctx": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:editor"
              },
              "session": null,
              "now": 6000,
              "correlation": "test-5000"
            },
            "hop": 0,
            "event": {
              "fixture": "fx-domain-event-3"
            },
            "trigger": {
              "fixture": "fx-trigger-def-1"
            },
            "a": {
              "id": "award",
              "label": "award",
              "run-as": {
                "roles": [
                  "editor"
                ]
              },
              "start": "done",
              "steps": {
                "done": {
                  "action": "end"
                }
              },
              "defined-by": "alpha:owner",
              "defined-at": 4000
            },
            "s": {
              "fixture": "fx-trigger-scopes-1"
            }
          },
          "result": {
            "start-automation": {
              "trigger": "on_publish",
              "automation": "award",
              "event-seq": 7,
              "hop": 0,
              "caused-by": "automation:award",
              "on-behalf-of": "alpha:owner",
              "definition-version": 2,
              "params": {
