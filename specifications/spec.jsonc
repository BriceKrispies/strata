    {
      "id": "capability-def-problems",
      "description": "capabilities.rs declaration_problems, one declaration: held under another key than its id; an id that is not a namespace and a name of lower-case letters, digits and underscores each starting with a letter, joined by two underscores, of at most 128 bytes (capability-well-formed); a blank name.",
      "params": [
        {
          "name": "key",
          "type": "capability-name"
        },
        {
          "name": "d",
          "type": "capability-def"
        }
      ],
      "returns": "list<string>",
      "body": "concat(concat(if key != d.id then [format('capability {}: held under the key {}', d.id, key)] else [], if call capability-well-formed(d.id) then [] else [format('capability {}: an id is a namespace and a name of lower-case letters, digits and underscores, joined by two underscores', d.id)]), if trim(d.name) == '' then [format('capability {}: a capability needs a name', d.id)] else [])",
      "examples": [
        {
          "args": {
            "key": "a__b",
            "d": {
              "id": "a__b",
              "name": "Name",
              "description": "d"
            }
          },
          "result": []
        },
        {
          "args": {
            "key": "other",
            "d": {
              "id": "a__b",
              "name": "Name",
              "description": "d"
            }
          },
          "result": [
            "capability a__b: held under the key other"
          ]
        },
        {
          "args": {
            "key": "Bad",
            "d": {
              "id": "Bad",
              "name": "Name",
              "description": "d"
            }
          },
          "result": [
            "capability Bad: an id is a namespace and a name of lower-case letters, digits and underscores, joined by two underscores"
          ]
        },
        {
          "args": {
            "key": "a__b",
            "d": {
              "id": "a__b",
              "name": " ",
              "description": "d"
            }
          },
          "result": [
            "capability a__b: a capability needs a name"
          ]
        }
      ]
    },
    {
      "id": "capability-well-formed",
      "description": "capabilities.rs well_formed: whether an id is <namespace>__<name>, each part of [a-z][a-z0-9_]*, the namespace not ending in an underscore so that the first two underscores in a row are the separator, at most 128 bytes.",
      "params": [
        {
          "name": "id",
          "type": "string"
        }
      ],
      "returns": "bool",
      "body": "match call capability-parts(id) { None => false, Some(p) => call capability-part(p.namespace) && !endsWith(p.namespace, '_') && call capability-part(p.name) && call utf8-length(id) <= 128 }",
      "examples": [
        {
          "args": {
            "id": "member_tiers__promote"
          },
          "result": true
        },
        {
          "args": {
            "id": "plain"
          },
          "result": false
        },
        {
          "args": {
            "id": "Member__x"
          },
          "result": false
        },
        {
          "args": {
            "id": "a___b"
          },
          "result": false
        },
        {
          "args": {
            "id": "a__b_"
          },
          "result": true
        },
        {
          "args": {
            "id": "a__1b"
          },
          "result": false
        },
        {
          "args": {
            "id": "a__"
          },
          "result": false
        },
        {
          "args": {
            "id": "a__bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
          },
          "result": false
        },
        {
          "args": {
            "id": "a__bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
          },
          "result": true
        }
      ]
    },
    {
      "id": "capability-part",
      "description": "capabilities.rs well_formed, one part: it starts with a lower-case letter and has only lower-case letters, digits and underscores.",
      "params": [
        {
          "name": "text",
          "type": "string"
        }
      ],
      "returns": "bool",
      "body": "match get(chars(text), 0) { Some(c) => isAsciiLowercase(c) && all(x in chars(text), isAsciiLowercase(x) || isAsciiDigit(x) || x == '_'), None => false }",
      "examples": [
        {
          "args": {
            "text": "abc_1"
          },
          "result": true
        },
        {
          "args": {
            "text": "1abc"
          },
          "result": false
        },
        {
          "args": {
            "text": "aBc"
          },
          "result": false
        },
        {
          "args": {
            "text": ""
          },
          "result": false
        }
      ]
    },
    {
      "id": "ledger-scope-text",
      "description": "ledger.rs scope_text: the scope of a request or a limit: empty when it names none (D-6551).",
      "params": [
        {
          "name": "scope",
          "type": "option<ledger-scope>"
        }
      ],
      "returns": "string",
      "body": "match scope { Some(s) => s, None => '' }",
      "examples": [
        {
          "args": {
            "scope": null
          },
          "result": ""
        },
        {
          "args": {
            "scope": "promo"
          },
          "result": "promo"
        }
      ]
    },
    {
      "id": "ledger-of",
      "description": "ledger.rs declarations: the declarations of a schema; an empty set when it declares nothing.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        }
      ],
      "returns": "ledger-declarations",
      "body": "match schema.ledger { Some(l) => l, None => ledger-declarations{units: {}, pools: {}, limits: []} }",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-6"
            }
          },
          "result": {
            "units": {},
            "pools": {},
            "limits": []
          }
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-32"
            }
          },
          "result": {
            "units": {
              "credits": {
                "unit": "credits",
                "description": "credits"
              }
            },
            "pools": {},
            "limits": []
          }
        }
      ]
    },
    {
      "id": "schema-with-ledger",
      "description": "The tenant schema with its ledger declarations replaced (the other members as they were). A table left empty is no table at all, so a schema that declares nothing hashes as one that never did (ledger.rs tidy).",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "ledger",
          "type": "ledger-declarations"
        }
      ],
      "returns": "tenant-schema",
      "body": "tenant-schema{version: schema.version, objects: schema.objects, roles: schema.roles, role-permissions: schema.role-permissions, teams: schema.teams, invitations: schema.invitations, policies: schema.policies, workflows: schema.workflows, queries: schema.queries, views: schema.views, triggers: schema.triggers, automations: schema.automations, operations: schema.operations, settings: schema.settings, capabilities: schema.capabilities, ledger: if keys(ledger.units) == [] && keys(ledger.pools) == [] && ledger.limits == [] then null else ledger, mail-templates: schema.mail-templates, notice-templates: schema.notice-templates, tokens: schema.tokens, products: schema.products}",
