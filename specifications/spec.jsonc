    {
      "id": "event-params",
      "description": "definitions.rs event_params (D-6523): the parameters an event of a kind binds for a trigger condition: seq, at and hop, and those of its kind.",
      "params": [
        {
          "name": "event",
          "type": "trigger-event"
        }
      ],
      "returns": "list<string>",
      "body": "concat(['seq', 'at', 'hop'], match event { record-created => [], record-updated => ['transition'], record-deleted => [], segment-entered => ['person', 'segment', 'reason'], segment-exited => ['person', 'segment', 'reason'], ledger-posted => ['owner', 'unit', 'amount', 'balance', 'balance_before', 'entry_sequence', 'reason'], setting-changed => ['setting', 'level', 'subject'], schedule-due => ['schedule', 'due_at'], inbound-webhook => ['endpoint', 'event_id', 'body'], declared-event => ['kind'] })",
      "examples": [
        {
          "args": {
            "event": {
              "record-created": {
                "object": "note"
              }
            }
          },
          "result": [
            "seq",
            "at",
            "hop"
          ]
        },
        {
          "args": {
            "event": {
              "ledger-posted": {
                "unit": "points"
              }
            }
          },
          "result": [
            "seq",
            "at",
            "hop",
            "owner",
            "unit",
            "amount",
            "balance",
            "balance_before",
            "entry_sequence",
            "reason"
          ]
        },
        {
          "args": {
            "event": {
              "inbound-webhook": {
                "endpoint": "shop"
              }
            }
          },
          "result": [
            "seq",
            "at",
            "hop",
            "endpoint",
            "event_id",
            "body"
          ]
        },
        {
          "description": "A declared event kind binds its name.",
          "args": {
            "event": {
              "declared-event": {
                "kind": "app.order-placed"
              }
            }
          },
          "result": [
            "seq",
            "at",
            "hop",
            "kind"
          ]
        }
      ]
    },
    {
      "id": "trigger-def-problems",
      "description": "definitions.rs trigger_problems, one trigger: an unknown automation; for a record event an unknown object type and, with a transition, no workflow of the type with a transition of that name; a condition that does not check as a truth value against the parameters of its event and the fields of its record (truth-problem). A trigger on a setting changing names a setting the schema defines (settings.rs, definitions.rs setting_reference_problem). A trigger on a posting names a unit the tenant declares (definitions.rs ledger_unit_reference).",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "roles",
          "type": "list<role-id>"
        },
        {
          "name": "t",
          "type": "trigger-def"
        }
      ],
      "returns": "list<string>",
      "let": [
        {
          "name": "at",
          "expr": "format('trigger {}', t.id)"
        },
        {
          "name": "p1",
          "expr": "if get(call automations-of(schema), t.automation) == null then [format('{}: unknown automation {}', at, t.automation)] else []"
        },
        {
          "name": "p2",
          "expr": "match t.on { record-created{object} => if get(schema.objects, object) == null then [format('{}: unknown object type {}', at, object)] else [], record-updated{object, transition} => match get(schema.objects, object) { None => [format('{}: unknown object type {}', at, object)], Some(_) => match transition { Some(name) => if any(w in values(schema.workflows), w.object == object && any(x in w.transitions, x.name == name)) then [] else [format('{}: no workflow of {} has a transition {}', at, object, name)], None => [] } }, record-deleted{object} => if get(schema.objects, object) == null then [format('{}: unknown object type {}', at, object)] else [], ledger-posted{unit} => if get(call ledger-of(schema).units, unit) == null then [format('{}: names ledger unit {}, which the tenant does not declare', at, unit)] else [], setting-changed{setting} => if get(call settings-of(schema), setting) == null then [format('{}: unknown setting {}', at, setting)] else [], _ => [] }"
        },
        {
          "name": "shapes",
          "expr": "match t.on { record-created{object} => match get(schema.objects, object) { Some(o) => call field-shapes(o.fields), None => {} }, record-updated{object} => match get(schema.objects, object) { Some(o) => call field-shapes(o.fields), None => {} }, record-deleted{object} => match get(schema.objects, object) { Some(o) => call field-shapes(o.fields), None => {} }, _ => {} }"
        },
        {
          "name": "p3",
          "expr": "match t.condition { Some(c) => call truth-problem(at, 'condition', c, expr-check-env{fields: shapes, params: call event-params(t.on), roles}), None => [] }"
        }
      ],
      "body": "concat(concat(p1, p2), p3)",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-9",
              "with": {
                "ledger": {
                  "units": {
                    "points": {
                      "unit": "points",
                      "description": "points"
                    }
                  },
                  "pools": {},
                  "limits": []
                }
              }
            },
            "roles": [
              "editor",
              "owner",
              "public"
            ],
            "t": {
              "id": "on_points",
              "on": {
                "ledger-posted": {
                  "unit": "points"
                }
              },
              "condition": {
                "cmp": {
                  "op": "ge",
                  "left": {
                    "param": "balance"
                  },
                  "right": {
                    "lit": {
                      "int": 500
                    }
                  }
                }
              },
              "automation": "award"
            }
          },
          "result": []
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-9"
            },
            "roles": [
              "editor",
              "owner",
              "public"
            ],
            "t": {
              "id": "on_publish",
              "on": {
                "record-updated": {
                  "object": "note",
                  "transition": "publish"
                }
              },
              "automation": "award"
            }
          },
          "result": []
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-10"
            },
            "roles": [
              "editor",
              "owner",
              "public"
            ],
            "t": {
              "id": "bad",
              "on": {
                "record-updated": {
                  "object": "note",
                  "transition": "archive"
                }
              },
              "condition": {
                "cmp": {
                  "op": "eq",
                  "left": {
                    "var": {
                      "scope": "new",
                      "field": "colour"
                    }
                  },
                  "right": {
                    "lit": {
                      "str": "red"
                    }
                  }
                }
              },
              "automation": "gone"
            }
          },
          "result": [
            "trigger bad: unknown automation gone",
            "trigger bad: no workflow of note has a transition archive",
            "trigger bad: condition: unknown field colour"
          ]
        },
        {
