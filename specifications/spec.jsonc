          },
          "result": "StillReferenced"
        },
        {
          "args": {
            "kind": "workflow-violation"
          },
          "result": "WorkflowViolation"
        },
        {
          "args": {
            "kind": "version-conflict"
          },
          "result": "VersionConflict"
        },
