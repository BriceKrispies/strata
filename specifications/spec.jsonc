    {
      "id": "apply-change",
      "description": "transition.rs apply_change: one schema change applied to a working copy, and the line that describes it. Every Define is define-or-replace (DefineObject keeps the fields and constraints of an object type it relabels); changing an object type that does not exist, removing something that does not exist, and defining a built-in role (public, owner) are refused with the problem.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "change",
          "type": "schema-change"
        }
      ],
      "returns": "schema-step",
      "errors": "schema-problem",
      "body": "match change { define-object{id, label} => schema-step{schema: tenant-schema{version: schema.version, objects: insert(schema.objects, id, match get(schema.objects, id) { Some(o) => object-type-def{id: o.id, label, fields: o.fields, constraints: o.constraints}, None => object-type-def{id, label, fields: {}, constraints: {}} }), roles: schema.roles, policies: schema.policies, workflows: schema.workflows, queries: schema.queries, views: schema.views}, line: format('define object {}', id)}, define-field{object, field} => match get(schema.objects, object) { None => fail(schema-problem.problem(format('no object type {}', object))), Some(o) => let o2 = object-type-def{id: o.id, label: o.label, fields: insert(o.fields, field.id, field), constraints: o.constraints} in schema-step{schema: tenant-schema{version: schema.version, objects: insert(schema.objects, object, o2), roles: schema.roles, policies: schema.policies, workflows: schema.workflows, queries: schema.queries, views: schema.views}, line: if get(o.fields, field.id) != null then format('redefine field {}.{}', object, field.id) else format('define field {}.{}', object, field.id)} }, define-relationship{object, field, label, target, on-delete, required} => match get(schema.objects, object) { None => fail(schema-problem.problem(format('no object type {}', object))), Some(o) => let o2 = object-type-def{id: o.id, label: o.label, fields: insert(o.fields, field, field-def{id: field, label, ty: field-type.ref{target, on-delete}, required, unique: false}), constraints: o.constraints} in schema-step{schema: tenant-schema{version: schema.version, objects: insert(schema.objects, object, o2), roles: schema.roles, policies: schema.policies, workflows: schema.workflows, queries: schema.queries, views: schema.views}, line: format('define relationship {}.{} -> {}', object, field, target)} }, remove-field{object, field} => match get(schema.objects, object) { None => fail(schema-problem.problem(format('no object type {}', object))), Some(o) => if get(o.fields, field) == null then fail(schema-problem.problem(format('no field {}.{}', object, field))) else let o2 = object-type-def{id: o.id, label: o.label, fields: remove(o.fields, field), constraints: o.constraints} in schema-step{schema: tenant-schema{version: schema.version, objects: insert(schema.objects, object, o2), roles: schema.roles, policies: schema.policies, workflows: schema.workflows, queries: schema.queries, views: schema.views}, line: format('remove field {}.{}', object, field)} }, define-constraint{object, constraint} => match get(schema.objects, object) { None => fail(schema-problem.problem(format('no object type {}', object))), Some(o) => let o2 = object-type-def{id: o.id, label: o.label, fields: o.fields, constraints: insert(o.constraints, constraint.id, constraint)} in schema-step{schema: tenant-schema{version: schema.version, objects: insert(schema.objects, object, o2), roles: schema.roles, policies: schema.policies, workflows: schema.workflows, queries: schema.queries, views: schema.views}, line: format('define constraint {}.{}', object, constraint.id)} }, remove-constraint{object, constraint} => match get(schema.objects, object) { None => fail(schema-problem.problem(format('no object type {}', object))), Some(o) => if get(o.constraints, constraint) == null then fail(schema-problem.problem(format('no constraint {}.{}', object, constraint))) else let o2 = object-type-def{id: o.id, label: o.label, fields: o.fields, constraints: remove(o.constraints, constraint)} in schema-step{schema: tenant-schema{version: schema.version, objects: insert(schema.objects, object, o2), roles: schema.roles, policies: schema.policies, workflows: schema.workflows, queries: schema.queries, views: schema.views}, line: format('remove constraint {}.{}', object, constraint)} }, define-role(role) => if role.id == 'public' || role.id == 'owner' then fail(schema-problem.problem(format('{} is built in', role.id))) else schema-step{schema: tenant-schema{version: schema.version, objects: schema.objects, roles: insert(schema.roles, role.id, role), policies: schema.policies, workflows: schema.workflows, queries: schema.queries, views: schema.views}, line: format('define role {}', role.id)}, define-policy(p) => schema-step{schema: tenant-schema{version: schema.version, objects: schema.objects, roles: schema.roles, policies: insert(schema.policies, p.id, p), workflows: schema.workflows, queries: schema.queries, views: schema.views}, line: format('define policy {}', p.id)}, remove-policy(id) => if get(schema.policies, id) == null then fail(schema-problem.problem(format('no policy {}', id))) else schema-step{schema: tenant-schema{version: schema.version, objects: schema.objects, roles: schema.roles, policies: remove(schema.policies, id), workflows: schema.workflows, queries: schema.queries, views: schema.views}, line: format('remove policy {}', id)}, define-workflow(w) => schema-step{schema: tenant-schema{version: schema.version, objects: schema.objects, roles: schema.roles, policies: schema.policies, workflows: insert(schema.workflows, w.id, w), queries: schema.queries, views: schema.views}, line: format('define workflow {}', w.id)}, remove-workflow(id) => if get(schema.workflows, id) == null then fail(schema-problem.problem(format('no workflow {}', id))) else schema-step{schema: tenant-schema{version: schema.version, objects: schema.objects, roles: schema.roles, policies: schema.policies, workflows: remove(schema.workflows, id), queries: schema.queries, views: schema.views}, line: format('remove workflow {}', id)}, define-query(q) => schema-step{schema: tenant-schema{version: schema.version, objects: schema.objects, roles: schema.roles, policies: schema.policies, workflows: schema.workflows, queries: insert(schema.queries, q.id, q), views: schema.views}, line: format('define query {}', q.id)}, remove-query(id) => if get(schema.queries, id) == null then fail(schema-problem.problem(format('no query {}', id))) else schema-step{schema: tenant-schema{version: schema.version, objects: schema.objects, roles: schema.roles, policies: schema.policies, workflows: schema.workflows, queries: remove(schema.queries, id), views: schema.views}, line: format('remove query {}', id)}, define-view(w) => schema-step{schema: tenant-schema{version: schema.version, objects: schema.objects, roles: schema.roles, policies: schema.policies, workflows: schema.workflows, queries: schema.queries, views: insert(schema.views, w.id, w)}, line: format('define view {}', w.id)}, remove-view(id) => if get(schema.views, id) == null then fail(schema-problem.problem(format('no view {}', id))) else schema-step{schema: tenant-schema{version: schema.version, objects: schema.objects, roles: schema.roles, policies: schema.policies, workflows: schema.workflows, queries: schema.queries, views: remove(schema.views, id)}, line: format('remove view {}', id)} }",
