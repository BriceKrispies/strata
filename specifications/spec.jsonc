                  "read",
                  "create",
                  "update",
                  "delete"
                ],
                "condition": null
              },
              "editors_manage_people": {
                "id": "editors_manage_people",
                "role": "editor",
                "resource": {
                  "object": "person"
                },
                "actions": [
                  "read",
                  "create",
                  "update",
                  "delete"
                ],
                "condition": null
              },
              "public_reads_people": {
                "id": "public_reads_people",
                "role": "public",
                "resource": {
                  "object": "person"
                },
                "actions": [
                  "read"
                ],
                "condition": null
              },
              "public_reads_published": {
                "id": "public_reads_published",
                "role": "public",
                "resource": {
                  "object": "note"
                },
                "actions": [
                  "read"
                ],
                "condition": {
                  "cmp": {
                    "op": "eq",
                    "left": {
                      "var": {
                        "scope": "record",
                        "field": "status"
                      }
                    },
                    "right": {
                      "lit": {
                        "str": "published"
                      }
                    }
                  }
                }
              },
              "writers_add_people": {
                "id": "writers_add_people",
                "role": "writer",
                "resource": {
                  "object": "person"
                },
                "actions": [
                  "create"
                ],
                "condition": null
              },
              "writers_edit_own": {
                "id": "writers_edit_own",
                "role": "writer",
                "resource": {
                  "object": "note"
                },
                "actions": [
                  "update",
                  "delete"
                ],
                "condition": {
                  "cmp": {
                    "op": "eq",
                    "left": {
                      "var": {
                        "scope": "record",
                        "field": "$created_by"
                      }
                    },
                    "right": "principal"
                  }
                }
              },
              "writers_read_notes": {
                "id": "writers_read_notes",
                "role": "writer",
                "resource": {
                  "object": "note"
                },
                "actions": [
                  "read",
                  "create"
                ],
                "condition": null
              }
            },
            "workflows": {
              "note_status": {
                "id": "note_status",
                "object": "note",
                "field": "status",
                "initial": [
                  "draft"
                ],
                "transitions": [
                  {
                    "name": "publish",
                    "from": "draft",
                    "to": "published",
                    "guard": {
                      "cmp": {
                        "op": "eq",
                        "left": "principal",
                        "right": {
                          "lit": {
                            "str": "alpha:editor"
                          }
                        }
                      }
                    },
                    "set": {
                      "published_at": "now"
                    }
                  },
                  {
                    "name": "unpublish",
                    "from": "published",
                    "to": "draft",
                    "guard": null,
                    "set": {
                      "published_at": {
                        "lit": "null"
                      }
                    }
                  }
                ]
              }
            },
            "queries": {},
            "views": {}
          }
        }
      ]
    },
    {
      "id": "ledger-same-limit",
      "description": "ledger.rs same_limit: whether a limit is of the same unit, or of the same account: the same unit and owner, and for an owner the same scope.",
      "params": [
        {
          "name": "a",
          "type": "ledger-limit"
        },
        {
          "name": "unit",
          "type": "ledger-unit"
        },
        {
          "name": "owner",
          "type": "option<ledger-owner>"
        },
        {
          "name": "scope",
          "type": "string"
        }
      ],
      "returns": "bool",
      "body": "a.unit == unit && a.owner == owner && (owner == null || call ledger-scope-text(a.scope) == scope)",
      "examples": [
        {
          "args": {
            "a": {
              "unit": "credits"
            },
            "unit": "credits",
            "owner": null,
            "scope": ""
          },
          "result": true
        },
        {
          "description": "A limit of a unit names no scope: the scope is not compared.",
          "args": {
            "a": {
              "unit": "credits",
              "scope": "x"
            },
            "unit": "credits",
            "owner": null,
            "scope": ""
          },
          "result": true
        },
        {
          "args": {
            "a": {
              "unit": "points"
            },
            "unit": "credits",
            "owner": null,
            "scope": ""
          },
          "result": false
        },
        {
          "description": "A limit of an account is of the same scope.",
          "args": {
            "a": {
              "unit": "credits",
              "owner": {
                "principal": {
                  "principal": "alpha:ed"
                }
              },
              "scope": "promo"
            },
            "unit": "credits",
            "owner": {
              "principal": {
                "principal": "alpha:ed"
              }
            },
            "scope": "promo"
          },
          "result": true
        },
        {
          "args": {
            "a": {
              "unit": "credits",
              "owner": {
                "principal": {
                  "principal": "alpha:ed"
                }
              },
              "scope": "promo"
            },
            "unit": "credits",
            "owner": {
              "principal": {
                "principal": "alpha:ed"
              }
            },
            "scope": ""
          },
          "result": false
        },
        {
          "description": "A limit of an account is not the unit's.",
          "args": {
            "a": {
              "unit": "credits",
              "owner": {
                "principal": {
                  "principal": "alpha:ed"
                }
              }
            },
            "unit": "credits",
            "owner": null,
            "scope": ""
          },
          "result": false
        }
      ]
    },
    {
      "id": "ledger-amount-problem",
      "description": "ledger.rs declaration_problems: a floor or a cap outside the range of an amount (D-5004), as \"<at>: <amount> is outside the range of an amount\". The range is a parameter so that an example can reach it: ledger-limit-problems passes 9007199254740991 (2^53 - 1), and a number past it cannot be written in an example.",
      "params": [
        {
          "name": "at",
          "type": "string"
        },
        {
          "name": "amount",
          "type": "option<ledger-amount>"
        },
        {
          "name": "max",
          "type": "i64"
        }
      ],
      "returns": "list<string>",
      "body": "match amount { Some(a) => if a > max || a < -max then [format('{}: {} is outside the range of an amount', at, a)] else [], None => [] }",
      "examples": [
        {
          "args": {
            "at": "x",
            "amount": null,
            "max": 10
          },
          "result": []
        },
        {
          "args": {
            "at": "x",
            "amount": 10,
            "max": 10
          },
          "result": []
        },
        {
          "args": {
            "at": "x",
            "amount": -10,
            "max": 10
          },
          "result": []
        },
        {
          "args": {
            "at": "x",
            "amount": 11,
            "max": 10
          },
          "result": [
            "x: 11 is outside the range of an amount"
          ]
        },
        {
          "args": {
            "at": "x",
            "amount": -11,
            "max": 10
          },
          "result": [
            "x: -11 is outside the range of an amount"
          ]
        }
      ]
    },
    {
      "id": "ledger-limit-problems",
      "description": "ledger.rs declaration_problems, one limit: a unit that is not declared, a pool owner that is not declared, a limit of a unit that names a scope, a scope of more than 128 bytes, a floor above the cap, a floor or cap outside the range of an amount (D-5004), a cap per period without its period (or the reverse), and a limit that sets nothing (CT-286).",
      "params": [
        {
          "name": "ledger",
          "type": "ledger-declarations"
        },
        {
          "name": "l",
          "type": "ledger-limit"
        }
      ],
      "returns": "list<string>",
      "let": [
        {
          "name": "at",
          "expr": "format('ledger limit of {}', l.unit)"
        }
      ],
      "body": "concat(concat(concat(concat(concat(concat(concat(if get(ledger.units, l.unit) == null then [format('{}: unknown ledger unit {}', at, l.unit)] else [], match l.owner { Some(o) => match o { pool{pool} => if get(ledger.pools, pool) == null then [format('{}: unknown ledger pool {}', at, pool)] else [], _ => [] }, None => if call ledger-scope-text(l.scope) != '' then [format('{}: a limit of a unit names no scope', at)] else [] }), if call utf8-length(call ledger-scope-text(l.scope)) > 128 then [format('{}: a scope is at most 128 bytes', at)] else []), match l.floor { Some(f) => match l.cap { Some(c) => if f > c then [format('{}: the floor {} is above the cap {}', at, f, c)] else [], None => [] }, None => [] }), call ledger-amount-problem(at, l.floor, 9007199254740991)), call ledger-amount-problem(at, l.cap, 9007199254740991)), if (l.period-cap != null) != (l.period != null) then [format('{}: a cap per period needs its period, and a period its cap', at)] else []), if l.floor == null && l.cap == null && l.period-cap == null then [format('{}: sets no limit', at)] else [])",
      "examples": [
        {
          "description": "A good limit of a unit.",
          "args": {
            "ledger": {
              "units": {
                "credits": {
                  "unit": "credits",
                  "description": "credits"
                }
              },
              "pools": {
                "promo": {
                  "pool": "promo",
                  "description": "promo"
                }
              },
              "limits": []
            },
            "l": {
              "unit": "credits",
              "floor": 0,
              "cap": 10,
              "period-cap": 5,
              "period": "day"
            }
          },
          "result": []
        },
        {
          "description": "A unit that is not declared.",
          "args": {
            "ledger": {
              "units": {
                "credits": {
                  "unit": "credits",
                  "description": "credits"
                }
              },
              "pools": {
                "promo": {
                  "pool": "promo",
                  "description": "promo"
                }
              },
              "limits": []
            },
            "l": {
              "unit": "points",
              "floor": 0
            }
          },
          "result": [
            "ledger limit of points: unknown ledger unit points"
          ]
        },
        {
          "description": "A pool that is not declared.",
          "args": {
            "ledger": {
              "units": {
                "credits": {
                  "unit": "credits",
                  "description": "credits"
                }
              },
              "pools": {
                "promo": {
                  "pool": "promo",
                  "description": "promo"
                }
              },
              "limits": []
            },
            "l": {
              "unit": "credits",
              "owner": {
                "pool": {
                  "pool": "ghost"
                }
              },
              "cap": 1
            }
          },
          "result": [
            "ledger limit of credits: unknown ledger pool ghost"
          ]
        },
        {
          "description": "A pool that is declared, and a person.",
          "args": {
            "ledger": {
              "units": {
                "credits": {
                  "unit": "credits",
                  "description": "credits"
                }
              },
              "pools": {
                "promo": {
                  "pool": "promo",
                  "description": "promo"
                }
              },
              "limits": []
            },
            "l": {
              "unit": "credits",
              "owner": {
                "pool": {
                  "pool": "promo"
                }
              },
              "cap": 1
            }
          },
          "result": []
        },
        {
          "description": "A person owner has no problem of its own.",
          "args": {
            "ledger": {
              "units": {
                "credits": {
                  "unit": "credits",
                  "description": "credits"
                }
              },
              "pools": {
                "promo": {
                  "pool": "promo",
                  "description": "promo"
                }
              },
              "limits": []
            },
            "l": {
              "unit": "credits",
              "owner": {
                "principal": {
                  "principal": "alpha:ed"
                }
              },
              "scope": "a",
              "cap": 1
            }
          },
          "result": []
        },
        {
          "description": "A limit of a unit names no scope.",
          "args": {
            "ledger": {
              "units": {
                "credits": {
                  "unit": "credits",
                  "description": "credits"
                }
              },
              "pools": {
                "promo": {
                  "pool": "promo",
                  "description": "promo"
                }
              },
              "limits": []
            },
            "l": {
              "unit": "credits",
              "scope": "x",
              "cap": 1
            }
          },
          "result": [
            "ledger limit of credits: a limit of a unit names no scope"
          ]
        },
        {
          "description": "A scope of more than 128 bytes.",
          "args": {
            "ledger": {
              "units": {
                "credits": {
                  "unit": "credits",
                  "description": "credits"
                }
              },
              "pools": {
                "promo": {
                  "pool": "promo",
                  "description": "promo"
                }
              },
              "limits": []
            },
            "l": {
              "unit": "credits",
              "owner": {
                "principal": {
                  "principal": "alpha:ed"
                }
              },
              "scope": "sssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssss",
              "cap": 1
            }
          },
          "result": [
            "ledger limit of credits: a scope is at most 128 bytes"
          ]
        },
        {
          "description": "A floor above the cap.",
          "args": {
            "ledger": {
              "units": {
                "credits": {
                  "unit": "credits",
                  "description": "credits"
                }
              },
              "pools": {
                "promo": {
                  "pool": "promo",
