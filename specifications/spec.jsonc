          "type": "expression"
        },
        {
          "name": "version",
          "type": "u64"
        },
        {
          "name": "time-dependent",
          "type": "bool"
        },
        {
          "name": "refresh-seconds",
          "type": "u32",
          "optional": true
        },
        {
          "name": "defined-by",
