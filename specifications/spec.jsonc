    {
      "id": "field-count-problem",
      "description": "schema.rs TenantSchema::problems, the start of an object type: more than 100 fields is \"limit: <object> has <count> fields, more than the maximum of 100\".",
      "params": [
        {
          "name": "object",
          "type": "object-type-def"
        }
      ],
      "returns": "list<string>",
      "body": "if length(keys(object.fields)) > 100 then [format('limit: {} has {} fields, more than the maximum of 100', object.id, length(keys(object.fields)))] else []",
