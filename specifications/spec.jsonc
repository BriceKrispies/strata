    {
      "id": "check-version",
      "description": "transition.rs check_version: an expected version other than the record's is a VersionConflict, with the draft's evidence. It runs only after require, so that a principal who may not change a record learns nothing about its version.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "record",
          "type": "record"
        },
        {
          "name": "expected",
          "type": "option<u64>"
        }
      ],
      "returns": "draft",
      "errors": "rejection",
      "body": "match expected { Some(v) => if v != record.version then fail(call draft-reject(d.evidence, error-kind.version-conflict, format('record is at version {}, expected {}', record.version, v))) else d, None => d }",
      "examples": [
        {
          "description": "behaviour.rs a_stale_expected_version_is_a_conflict.",
          "args": {
            "d": {
              "fixture": "fx-draft-4",
              "with": {
                "evidence": [
                  {
                    "rule": "policy:writers_edit_own",
                    "passed": true,
                    "detail": "x"
                  }
                ]
              }
            },
            "record": {
              "id": 1,
              "object": "note",
              "version": 2,
              "created-by": "alpha:writer1",
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "slug": {
                  "str": "first"
                },
                "status": {
                  "str": "draft"
                },
                "title": {
                  "str": "First"
                }
              }
            },
            "expected": 1
          },
          "error": {
            "rejected": {
              "kind": "version-conflict",
              "message": "record is at version 2, expected 1",
              "evidence": [
                {
                  "rule": "policy:writers_edit_own",
                  "passed": true,
                  "detail": "x"
                },
                {
                  "rule": "intent:version_conflict",
                  "passed": false,
                  "detail": "record is at version 2, expected 1"
                }
              ],
              "missing": null
            }
          }
        },
