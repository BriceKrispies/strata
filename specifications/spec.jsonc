    {
      "id": "redact",
      "description": "read.rs redact: the record without the fields whose read condition (FieldDef.read) does not hold for the reader, evaluated with the record as record, old and new, no parameters, the reader and the roles of the reader, and the snapshot's lookup over the record's reference fields (rule-lookup). A condition that does not evaluate to exactly true hides the field, an evaluation error too, unless it failed because the snapshot does not cover a record it follows (rule-missing): that is InsufficientState naming the record, so the shell loads it and asks again (WG-5096). A field the record does not hold is not looked at; the system reads everything, and so does a record of an object type the schema does not declare.",
      "params": [
        {
          "name": "t",
          "type": "tenant-state"
        },
        {
          "name": "coverage",
          "type": "coverage"
        },
        {
          "name": "principal",
          "type": "principal"
        },
        {
          "name": "now",
          "type": "timestamp"
        },
        {
          "name": "r",
          "type": "record"
        }
      ],
      "returns": "record",
      "body": "match principal { system => r, _ => match get(t.schema.objects, r.object) { None => r, Some(def) => let scope = call record-scope(r) in let env = expr-env{record: scope, old: scope, new: scope, param: {}, now: value.time(now), principal: call principal-value(principal), has_role: call roles-of(t, principal)} in let reach = rule-reach{tenant: t, coverage, subject: subject{old: r, new: r}} in let lookup = call rule-lookup(reach) in let hidden = fold(f in values(def.fields), acc = [], match f.read { None => acc, Some(rule) => if get(r.fields, f.id) == null then acc else match eval(tenant-rule-language, rule, env, lookup) { Ok(x) => if x == value.bool(true) then acc else concat(acc, [f]), Err(_) => match call rule-missing(rule, reach) { Some(n) => fail(rejection.rejected(call insufficient(n))), None => concat(acc, [f]) } } }) in if hidden == [] then r else record{id: r.id, object: r.object, version: r.version, created-by: r.created-by, created-at: r.created-at, updated-at: r.updated-at, fields: fold(f in hidden, m = r.fields, remove(m, f.id))} } }",
      "examples": [
        {
          "description": "The owner holds the role the condition asks for and sees the field.",
          "args": {
            "t": {
              "fixture": "fx-tenant-state-23"
            },
            "coverage": "complete",
            "principal": {
              "user": "alpha:owner"
            },
            "now": 3000,
            "r": {
              "id": 2,
              "object": "post",
              "version": 1,
              "created-by": "alpha:writer",
              "created-at": 2000,
              "updated-at": 2000,
              "fields": {
                "author": {
                  "ref": 1
                },
                "status": {
                  "str": "published"
                },
                "title": {
                  "str": "B"
                }
              }
            }
          },
          "result": {
            "id": 2,
            "object": "post",
            "version": 1,
            "created-by": "alpha:writer",
            "created-at": 2000,
            "updated-at": 2000,
            "fields": {
              "author": {
                "ref": 1
              },
              "status": {
                "str": "published"
              },
              "title": {
                "str": "B"
              }
            }
          }
        },
        {
          "description": "An anonymous reader does not: the field is left out of the record.",
          "args": {
            "t": {
              "fixture": "fx-tenant-state-23"
            },
            "coverage": "complete",
            "principal": "anonymous",
            "now": 3000,
