    {
      "id": "change-member",
      "description": "transition.rs change_member (AssignRole when grant, RevokeRole otherwise): Manage on Members is authorised; the role must be declared (UnknownRole); public cannot be granted or revoked, since everyone holds it (InvalidIntent); revoking owner from the last principal that holds it is refused, since a tenant keeps at least one owner (InvalidIntent); a principal left with no roles has its sessions ended (Effect RevokeSessions); then a PutMember and a MemberChanged event.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "who",
          "type": "principal-id"
        },
        {
          "name": "role",
          "type": "role-id"
        },
        {
          "name": "grant",
          "type": "bool"
        },
        {
          "name": "texts",
          "type": "intent-texts"
        }
      ],
      "returns": "decided",
      "errors": "rejection",
      "let": [
        {
          "name": "d1",
          "expr": "try call require(d, action.manage, resource.members, subject{}, texts)"
        },
        {
          "name": "current",
          "expr": "match get(d1.tenant.members, who) { Some(rs) => rs, None => [] }"
        },
        {
          "name": "roles",
          "expr": "if grant then call set-of(concat(current, [role])) else filter(r in current, r != role)"
        },
        {
          "name": "owners",
          "expr": "fold(p in keys(d1.tenant.members), n = 0, match get(d1.tenant.members, p) { Some(rs) => if p != who && any(r in rs, r == 'owner') then n + 1 else n, None => n })"
        }
      ],
      "body": "if get(d1.tenant.schema.roles, role) == null then fail(call draft-reject(d1.evidence, error-kind.unknown-role, format('no role {}', role))) else if role == 'public' then fail(call draft-reject(d1.evidence, error-kind.invalid-intent, 'everyone already holds public')) else if !grant && role == 'owner' && owners == 0 then fail(call draft-reject(d1.evidence, error-kind.invalid-intent, 'a tenant keeps at least one owner')) else decided{draft: draft{tenant: d1.tenant, ctx: d1.ctx, coverage: d1.coverage, ops: concat(d1.ops, [delta-op.put-member{principal: who, roles}]), events: concat(d1.events, [event-body.member-changed{principal: who, roles}]), effects: if roles == [] then concat(d1.effects, [effect.revoke-sessions{principal: who}]) else d1.effects, evidence: d1.evidence, next-record: d1.next-record}, output: output.member}",
      "examples": [
        {
          "description": "behaviour.rs removing_the_last_role_asks_for_the_sessions_to_end_and_the_last_owner_stays: revoking writer1's only role.",
