    {
      "id": "operation-step-id",
      "description": "definitions.rs step_id: the id of a step of a tenant operation.",
      "params": [
        {
          "name": "step",
          "type": "tenant-operation-step"
        }
      ],
      "returns": "string",
      "body": "match step { create-record{id} => id, update-record{id} => id, delete-record{id} => id, post-ledger{id} => id }",
      "examples": [
        {
          "args": {
            "step": {
              "create-record": {
                "id": "copy",
                "object": "note",
                "fields": {
                  "title": {
                    "var": {
                      "scope": "record",
                      "field": "title"
                    }
                  },
                  "status": {
                    "lit": {
                      "str": "draft"
                    }
                  }
                }
              }
            }
          },
          "result": "copy"
        },
        {
          "args": {
            "step": {
              "delete-record": {
                "id": "drop",
                "object": "note",
                "record": {
                  "param": "note"
                }
              }
            }
          },
          "result": "drop"
        },
        {
          "args": {
            "step": {
              "post-ledger": {
                "id": "count",
                "owner": "invoker",
                "unit": "points",
                "scope": null,
                "amount": {
                  "lit": {
                    "int": 1
                  }
                },
                "reason": "r"
              }
            }
          },
          "result": "count"
        }
      ]
    },
    {
      "id": "operation-step-problems",
      "description": "definitions.rs operation_problems, one step: an id that is not a name, an id equal to an input name, the fields of a record step (written-problems), then its record, or the owner, scope and amount of a posting, that do not check. A posting step names a unit the tenant declares (definitions.rs ledger_unit_reference).",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "at",
          "type": "string"
        },
        {
          "name": "inputs",
          "type": "list<string>"
        },
        {
          "name": "step",
          "type": "tenant-operation-step"
        },
        {
          "name": "env",
          "type": "expr-check-env"
        }
      ],
      "returns": "list<string>",
      "let": [
        {
          "name": "id",
          "expr": "call operation-step-id(step)"
        },
        {
          "name": "sat",
          "expr": "format('{}.{}', at, id)"
        },
        {
          "name": "p1",
          "expr": "concat(if call is-param-name(id) then [] else [format('{}: step {:?} is not a name', at, id)], if any(i in inputs, i == id) then [format('{}: step {} has the name of an input', at, id)] else [])"
        }
      ],
      "body": "concat(p1, match step { create-record{object, fields} => call written-problems(schema, sat, object, fields, env), update-record{object, record, fields} => concat(call written-problems(schema, sat, object, fields, env), call expr-problem(sat, 'record', record, env)), delete-record{object, record} => concat(call written-problems(schema, sat, object, {}, env), call expr-problem(sat, 'record', record, env)), post-ledger{owner, scope, amount, unit} => concat(concat(concat(match owner { principal{principal: who} => call expr-problem(sat, 'owner', who, env), _ => [] }, match scope { Some(x) => call expr-problem(sat, 'scope', x, env), None => [] }), call expr-problem(sat, 'amount', amount, env)), if get(call ledger-of(schema).units, unit) == null then [format('{}: names ledger unit {}, which the tenant does not declare', sat, unit)] else []) })",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-10"
            },
            "at": "operation redeem",
            "inputs": [
              "note"
