          "title": {
            "type": "string",
            "label": "Title"
          },
          "level": {
            "type": "number",
            "required": true,
            "label": "Heading level"
          },
          "document": {
            "type": "ref",
            "ref": [
              "document"
            ],
            "required": true,
            "label": "Document"
          },
          "parent": {
            "type": "ref",
            "ref": [
              "section"
            ],
            "label": "Parent section"
          },
          "order": {
            "type": "number",
            "required": true,
            "label": "Order",
            "doc": "Position within the document."
          },
          "body": {
            "type": "text",
            "label": "Body",
            "doc": "The own Markdown of the section, verbatim. Lines imported as separate entities are replaced by one {{entity:<id>}} marker line each, which stands for that entity rendered from its properties."
          },
          "mentions": {
            "type": "list",
            "items": {
              "type": "ref",
              "ref": [
