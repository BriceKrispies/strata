    {"id":"audit-erasure","name":"An erasure seals audit entries","description":"Entries are appended, the entries of the principal are sealed, and the chain continues.","behaviors":["audit-chain-flow"],"steps":[
        {
          "at": 0,
          "event": "au-append",
          "payload": {
            "tenant-id": "acme"
          }
        },
        {
          "at": 1,
          "event": "au-erase",
          "payload": {
            "tenant-id": "acme"
          }
        },
        {
          "at": 2,
          "event": "au-append",
          "payload": {
            "tenant-id": "acme"
          }
