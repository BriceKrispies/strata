    {
      "id": "update-record",
      "description": "transition.rs update_record: the object type and the stored record; the candidate is the record with the given fields (a null clears one), the version one higher and updated now; Update is authorised (old the stored record, new the candidate) before anything else about the record is revealed, so authorisation comes before the version check; then each workflow of the object type in id order (workflow-step), then validate-record with old the stored record; accepted, it is a PutRecord and a RecordUpdated event.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "id",
          "type": "record-id"
        },
        {
          "name": "fields",
          "type": "map<field-id, value>"
        },
        {
          "name": "expected-version",
          "type": "option<u64>"
        },
        {
          "name": "texts",
          "type": "intent-texts"
        }
      ],
      "returns": "decided",
      "errors": "rejection",
      "let": [
        {
          "name": "def",
          "expr": "try call object-def(d, object)"
        },
        {
          "name": "old",
          "expr": "try call stored(d, object, id)"
        },
        {
          "name": "candidate",
          "expr": "record{id: old.id, object: old.object, version: old.version + 1, created-by: old.created-by, created-at: old.created-at, updated-at: d.ctx.now, fields: fold(k in keys(fields), m = old.fields, match get(fields, k) { Some(x) => if call value-is-null(x) then remove(m, k) else insert(m, k, x), None => m })}"
        },
        {
          "name": "d1",
          "expr": "try call require(d, action.update, resource.object(object), subject{old, new: candidate}, texts)"
        },
        {
          "name": "d2",
          "expr": "try call check-version(d1, old, expected-version)"
        },
        {
          "name": "flow",
          "expr": "fold(w in filter(w in values(d2.tenant.schema.workflows), w.object == object), acc = workflow-outcome{draft: d2, candidate}, try call workflow-step(acc.draft, old, acc.candidate, w))"
        },
        {
          "name": "evidence",
          "expr": "try call validation-into-result(try call validate-record(flow.draft.tenant, flow.draft.coverage, flow.draft.tenant.schema, def, flow.candidate, old, d.ctx.principal, d.ctx.now, match get(texts.constraints, object) { Some(m) => m, None => {} }), flow.draft.evidence)"
        }
      ],
      "body": "decided{draft: draft{tenant: flow.draft.tenant, ctx: flow.draft.ctx, coverage: flow.draft.coverage, ops: concat(flow.draft.ops, [delta-op.put-record(flow.candidate)]), events: concat(flow.draft.events, [event-body.record-updated{before: old, after: flow.candidate}]), effects: flow.draft.effects, evidence: evidence, next-record: flow.draft.next-record}, output: output.record{object, id, version: flow.candidate.version}}",
      "examples": [
        {
          "description": "behaviour.rs a_stale_expected_version_is_a_conflict: the first edit, by the note's writer.",
          "args": {
