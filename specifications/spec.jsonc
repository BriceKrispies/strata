    {
      "id": "kernel-read",
      "description": "crates/kernel/src/read.rs read, the pure body of contract answer-read (CT-003): the snapshot must be of the context's tenant (TenantMismatch \"snapshot is of another tenant\") and hold it (TenantNotFound \"no such tenant\"). A records request answers each named record that exists and that the principal may read (visible-in), refusing an unknown object type; a named query refuses an unknown query (UnknownQuery) and a parameter it does not declare (InvalidIntent), then answers one page (named-read). A records request naming more than 200 ids is refused with limit-exceeded. These rejections carry no evidence. Read policies, query filters and field read conditions follow a reference through the snapshot's lookup, and a record they need that the snapshot does not cover is InsufficientState naming it (WG-5096). Every row of either answer is trimmed to the fields whose read condition holds for the reader (redact, WG-5093).",
      "params": [
        {
          "name": "state",
          "type": "state"
        },
        {
          "name": "request",
          "type": "read-request"
        },
        {
          "name": "context",
          "type": "context"
        }
      ],
      "returns": "read-result",
      "errors": "rejection",
      "body": "if state.tenant-id != context.tenant then fail(rejection.rejected(domain-error{kind: error-kind.tenant-mismatch, message: 'snapshot is of another tenant', evidence: []})) else match state.tenant { None => fail(rejection.rejected(domain-error{kind: error-kind.tenant-not-found, message: 'no such tenant', evidence: []})), Some(t) => if t.id != context.tenant then fail(rejection.rejected(domain-error{kind: error-kind.tenant-not-found, message: 'no such tenant', evidence: []})) else match request { records{object, ids} => let rows = if length(ids) > 200 then fail(rejection.rejected(domain-error{kind: error-kind.limit-exceeded, message: format('{} ids in one read is more than the maximum of 200', length(ids)), evidence: []})) else if get(t.schema.objects, object) == null then fail(rejection.rejected(domain-error{kind: error-kind.unknown-object, message: format('no object type {}', object), evidence: []})) else fold(id in ids, acc = [], match try call lookup-record(t, state.coverage, object, id) { Some(r) => if try call visible-in(t, state.coverage, context.principal, r, context.now) then concat(acc, [r]) else acc, None => acc }) in read-result{rows: try call redact-rows(t, state.coverage, context.principal, context.now, rows), revision: t.revision, schema-version: t.schema.version}, named{query, params, page-size, cursor} => try call named-read(t, state.coverage, context, query, params, page-size, cursor) } }",
      "examples": [
        {
          "description": "A reader sees the published posts, in title order.",
          "args": {
            "state": {
              "fixture": "fx-state-5"
            },
            "request": {
              "named": {
                "query": "published",
                "params": {}
              }
            },
            "context": {
              "tenant": "alpha",
              "principal": "anonymous",
              "session": null,
              "now": 3000,
              "correlation": "c-1"
            }
          },
          "result": {
            "rows": [
              {
                "id": 2,
                "object": "post",
                "version": 1,
                "created-by": "alpha:writer",
                "created-at": 2000,
                "updated-at": 2000,
                "fields": {
                  "author": {
                    "ref": 1
                  },
                  "status": {
                    "str": "published"
                  },
                  "title": {
                    "str": "B"
                  }
                }
              },
              {
                "id": 4,
                "object": "post",
                "version": 1,
                "created-by": "alpha:owner",
                "created-at": 2002,
                "updated-at": 2002,
                "fields": {
