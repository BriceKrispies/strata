      "key": [
        "login"
      ],
      "fields": [
        {
          "name": "login",
          "type": "string",
          "personal": "identifier"
        },
        {
          "name": "principal",
          "type": "principal-id",
          "refersTo": "principal",
          "role": "subject",
          "onDelete": "restrict"
        },
        {
          "name": "display-name",
          "type": "display-name",
          "personal": "name"
        },
        {
          "name": "password-hash",
          "type": "hash",
          "classification": "credential"
        }
      ],
      "retention": "Until the login is removed or the tenant file is deleted. Erasing a subject (the contract erase-subject) removes the logins of the person through Store::remove_principal.",
      "erasure": {
        "point": "the removal of the login, or the deletion of the tenant file"
      },
      "description": "Table accounts of a tenant file: locally managed logins with their Argon2id password hash."
    },
    {
      "id": "rec-ledger-unit",
      "name": "Ledger unit",
      "owner": "runtime",
      "key": [
        "unit"
      ],
      "fields": [
        {
          "name": "unit",
          "type": "ledger-unit"
        },
        {
          "name": "description",
          "type": "string"
        },
        {
          "name": "declared-at",
          "type": "timestamp"
        },
        {
          "name": "expiry",
          "type": "ledger-expiry",
          "optional": true,
          "description": "How the credits of the unit expire, when they do (D-6553)."
        }
      ],
      "retention": "Kept for the life of the tenant. A unit that has an account is never removed, so that the entries of its accounts keep a unit to be read in (LDG-002).",
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target",
      "source": "d-5001",
      "description": "A unit the tenant has declared as metadata, such as points or stamps."
    },
    {
      "id": "rec-ledger-pool",
      "name": "Ledger pool",
      "owner": "runtime",
      "key": [
        "pool"
      ],
      "fields": [
        {
          "name": "pool",
          "type": "ledger-pool-name"
        },
        {
          "name": "description",
          "type": "string"
        },
        {
          "name": "declared-at",
          "type": "timestamp"
        }
      ],
      "retention": "Kept for the life of the tenant. A pool that has an account is never removed.",
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target",
      "source": "d-5001",
      "description": "A named tenant-level owner of accounts, such as a promotion budget."
    },
    {
      "id": "rec-ledger-account",
      "name": "Ledger account",
      "owner": "runtime",
      "key": [
        "account-id"
      ],
      "fields": [
        {
          "name": "account-id",
          "type": "ledger-account-id"
        },
        {
          "name": "owner-principal",
          "type": "principal-id",
          "refersTo": "principal",
          "role": "subject",
          "constraints": {
            "pattern": "^[A-Za-z0-9_:.-]+$",
            "maxLength": 96
          },
          "optional": true,
          "onDelete": "restrict",
          "description": "The principal that owns the account; absent for a pool, and cleared when the principal is erased (LDG-027)."
        },
        {
          "name": "owner-pool",
          "type": "ledger-pool-name",
          "refersTo": "rec-ledger-pool",
          "optional": true,
          "onDelete": "restrict",
          "description": "The pool that owns the account; absent for a principal."
        },
        {
          "name": "unit",
          "type": "ledger-unit",
          "refersTo": "rec-ledger-unit",
          "onDelete": "restrict"
        },
        {
          "name": "scope",
          "type": "ledger-scope",
          "description": "Chosen by the poster, empty by default (D-6551)."
        },
        {
          "name": "opened-at",
          "type": "timestamp"
        }
      ],
      "unique": [
        [
          "owner-principal",
          "owner-pool",
          "unit",
          "scope"
        ]
      ],
      "retention": "Kept for the life of the tenant. The principal of an account is cleared when the principal is erased and the account stays with its entries (LDG-027).",
      "erasure": {
        "point": "the erasure of the principal that owns the account clears the principal from the account; the account and its entries stay (LDG-027)"
      },
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target",
      "source": "d-5001",
      "description": "An owner and a unit. Exactly one of owner-principal and owner-pool is set until the principal is erased."
    },
    {
      "id": "rec-ledger-entry",
      "name": "Ledger entry",
      "owner": "runtime",
      "key": [
        "account-id",
        "sequence"
      ],
      "fields": [
        {
          "name": "account-id",
          "type": "ledger-account-id",
          "refersTo": "rec-ledger-account",
          "onDelete": "restrict"
        },
        {
          "name": "sequence",
          "type": "u64",
          "description": "The number of the entry in its account: 1, 2, 3, with no gap, in commit order (LDG-019)."
        },
        {
          "name": "amount",
          "type": "ledger-amount",
          "constraints": {
            "min": -9007199254740991,
            "max": 9007199254740991
          }
        },
        {
          "name": "idempotency-key",
          "type": "string",
          "constraints": {
            "maxLength": 128
          }
        },
        {
          "name": "reason",
          "type": "string",
          "constraints": {
            "maxLength": 256
          },
          "description": "A short reason the poster names; free text of a person does not belong in it."
        },
        {
          "name": "caused-by",
          "type": "principal-id",
          "refersTo": "principal",
          "role": "party",
          "constraints": {
            "pattern": "^[A-Za-z0-9_:.-]+$",
            "maxLength": 96
          },
          "optional": true,
          "onDelete": "restrict",
          "description": "The principal that caused the posting; absent only after that principal was erased (LDG-027)."
        },
        {
          "name": "at",
          "type": "timestamp",
          "description": "The time given to the decision as an input (D-5010)."
        },
        {
          "name": "corrects",
          "type": "u64",
          "optional": true,
          "description": "The number of the entry of the same account that this entry corrects (LDG-023)."
        },
        {
          "name": "revision",
          "type": "u64",
          "description": "The tenant revision of the commit that recorded the entry."
        }
      ],
      "unique": [
        [
          "account-id",
          "idempotency-key"
        ]
      ],
      "indexes": [
        {
          "name": "by-key",
          "fields": [
            "account-id",
            "idempotency-key"
          ]
        }
      ],
      "retention": "Kept for the life of the tenant. An entry is never changed or removed (LDG-022); the erasure of a principal clears that principal from it and keeps the rest (LDG-027, LDG-028).",
      "erasure": {
        "point": "the erasure of the principal that caused the entry clears caused-by; the amount, key, reason, number and time stay (LDG-027)"
      },
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target",
      "source": "d-5002",
      "description": "One entry of the journal of an account. Append-only."
    },
    {
      "id": "rec-ledger-balance",
      "name": "Ledger balance",
      "owner": "runtime",
      "key": [
        "account-id"
      ],
      "fields": [
        {
          "name": "account-id",
          "type": "ledger-account-id",
          "refersTo": "rec-ledger-account",
          "onDelete": "cascade"
        },
        {
          "name": "balance",
          "type": "ledger-amount",
          "constraints": {
            "min": -9007199254740991,
            "max": 9007199254740991
          }
        },
        {
          "name": "last-sequence",
          "type": "u64"
        },
        {
          "name": "period-start",
          "type": "timestamp",
          "optional": true,
          "description": "The start of the period whose credits period-credits counts."
        },
        {
          "name": "period-credits",
          "type": "u64",
          "optional": true,
          "description": "The credits posted in the period that starts at period-start."
        },
        {
          "name": "revision",
          "type": "u64"
        },
        {
          "name": "unit",
          "type": "ledger-unit",
          "description": "The unit of the account, kept for the ranked listing (LDG-1543)."
        },
        {
          "name": "scope",
          "type": "ledger-scope",
          "description": "The scope of the account, kept for the ranked listing."
        },
        {
          "name": "buckets",
          "type": "list<ledger-bucket>",
          "optional": true,
          "description": "For a unit with an expiry, the remaining credit of each period, oldest first, at most thirty-six (D-6553)."
        }
      ],
      "retention": "Derived from the entries of its account and rebuilt from them, so it is kept as long as the account is. Only the commit of a posting writes it, in the commit that records the entry; no contract sets it (LDG-021).",
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target",
      "source": "d-5003",
      "description": "The sum of the entries of an account, kept so that a decision loads one record and not the whole journal (K-100).",
      "indexes": [
        {
          "name": "ledger_balance_rank",
          "fields": [
            "unit",
            "scope",
            "balance"
          ]
        }
      ]
    },
    {
      "id": "rec-ledger-limit",
