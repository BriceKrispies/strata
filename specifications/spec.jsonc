      },
      {
        "entity": "claim",
        "name": "traces",
        "type": "list",
        "items": {
          "type": "ref",
          "ref": [
            "goal",
            "nonGoal",
            "constraint",
            "decision",
            "openQuestion"
          ]
        },
        "label": "Traces to"
      },
      {
        "entity": "claim",
        "name": "dependsOn",
        "type": "list",
        "items": {
