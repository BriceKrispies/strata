    {
      "id": "touched-objects",
      "description": "transition.rs touched_objects: the object types whose records are re-validated after the changes (a field, relationship, constraint or workflow changed on them), and the targets of the reference fields and relationships they introduce, in id order.",
      "params": [
        {
          "name": "changes",
          "type": "list<schema-change>"
        }
      ],
      "returns": "set<object-type-id>",
      "body": "call set-of(fold(c in changes, acc = [], concat(acc, match c { define-field{object, field} => concat([object], match call ref-target(field.ty) { Some(t) => [t], None => [] }), define-relationship{object, target} => [object, target], remove-field{object} => [object], define-constraint{object} => [object], remove-constraint{object} => [object], define-workflow(w) => [w.object], _ => [] })))",
      "examples": [
        {
          "args": {
            "changes": [
              {
                "define-relationship": {
                  "object": "note",
                  "field": "editor",
                  "label": "Editor",
                  "target": "person",
                  "on-delete": "restrict",
                  "required": false
                }
              },
              {
                "define-role": {
                  "id": "guest",
                  "label": "Guest"
                }
              },
              {
                "remove-field": {
                  "object": "note",
                  "field": "body"
                }
              }
            ]
          },
          "result": [
            "note",
            "person"
          ]
        },
        {
          "args": {
            "changes": [
              {
                "define-workflow": {
                  "id": "note_status",
                  "object": "note",
                  "field": "status",
                  "initial": [
                    "draft"
                  ],
                  "transitions": [
                    {
                      "name": "publish",
                      "from": "draft",
                      "to": "published",
                      "guard": {
                        "cmp": {
                          "op": "eq",
                          "left": "principal",
                          "right": {
                            "lit": {
                              "str": "alpha:editor"
                            }
                          }
                        }
                      },
                      "set": {
                        "published_at": "now"
                      }
                    },
                    {
                      "name": "unpublish",
                      "from": "published",
                      "to": "draft",
                      "guard": null,
                      "set": {
                        "published_at": {
                          "lit": "null"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "define-field": {
                  "object": "tag",
                  "field": {
                    "id": "who",
                    "label": "who",
                    "ty": {
                      "list": {
                        "ref": {
                          "target": "person",
                          "on-delete": "restrict"
                        }
                      }
                    },
                    "required": false,
                    "unique": false
                  }
                }
              }
            ]
          },
          "result": [
            "note",
            "person",
            "tag"
          ]
        },
        {
          "args": {
            "changes": [
              {
                "define-object": {
                  "id": "tag",
                  "label": "Tag"
                }
              }
            ]
          },
          "result": []
        },
        {
          "args": {
            "changes": [
              {
                "define-constraint": {
                  "object": "note",
                  "constraint": {
                    "id": "title_length",
                    "expr": {
                      "cmp": {
                        "op": "le",
                        "left": {
                          "len": {
                            "var": {
                              "scope": "new",
                              "field": "title"
                            }
                          }
                        },
                        "right": {
                          "lit": {
                            "int": 24
                          }
                        }
                      }
                    },
                    "message": "A title has at most 24 characters"
                  }
                }
              },
              {
                "remove-constraint": {
                  "object": "person",
                  "constraint": "x"
                }
              }
            ]
          },
          "result": [
            "note",
            "person"
          ]
        }
      ]
    },
    {
      "id": "lookup-all",
      "description": "rules.rs Lookup::all_of: every record of an object type, in id order; refused when the snapshot does not cover them.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "coverage",
          "type": "coverage"
        },
        {
          "name": "object",
          "type": "object-type-id"
        }
      ],
      "returns": "list<record>",
      "errors": "rejection",
      "let": [
        {
          "name": "wanted",
          "expr": "need.all-of(object)"
        }
      ],
      "body": "if call covers(coverage, wanted) then match get(tenant.records, object) { Some(rs) => values(rs), None => [] } else fail(rejection.rejected(call insufficient(wanted)))",
