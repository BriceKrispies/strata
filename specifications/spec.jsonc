    {
      "id": "finish",
      "description": "transition.rs Draft::finish: the revision one higher; the events numbered from the tenant's last event sequence, each stamped with the tenant, the new revision, the context's time, principal and correlation; one Publish effect per event, in order, before the requested effects; the delta based on the tenant's revision.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "output",
          "type": "output"
        }
      ],
      "returns": "transition-result",
      "let": [
        {
          "name": "revision",
          "expr": "d.tenant.revision + 1"
        },
        {
          "name": "numbered",
          "expr": "fold(b in d.events, acc = event-numbering{events: [], next: d.tenant.event-seq + 1}, event-numbering{events: concat(acc.events, [domain-event{tenant: d.tenant.id, seq: acc.next, revision, at: d.ctx.now, principal: d.ctx.principal, correlation: d.ctx.correlation, body: b}]), next: acc.next + 1})"
        }
      ],
      "body": "transition-result{delta: state-delta{tenant: d.tenant.id, base-revision: d.tenant.revision, new-revision: revision, next-record: d.next-record, event-seq: numbered.next - 1, ops: d.ops}, events: numbered.events, effects: concat(map(e in numbered.events, effect.publish{seq: e.seq}), d.effects), evidence: d.evidence, output}",
      "examples": [
        {
