    {
      "id": "delete-record",
      "description": "transition.rs delete_record: the object type and the stored record, Delete authorised (the record as old and new) before the version check; then for each referrer (schema referrers, in order) every record whose field refers to this one (rules.rs Lookup::by_field), except the record itself: a Restrict reference, or a required single reference, blocks the delete with StillReferenced; any other is cleared (removed from a list, unset otherwise; version one higher, updated now; reference:<object>.<field> \"cleared on ...\"), as a PutRecord and a RecordUpdated event; last the DeleteRecord and a RecordDeleted event.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "id",
          "type": "record-id"
        },
        {
          "name": "expected-version",
          "type": "option<u64>"
        },
        {
          "name": "texts",
          "type": "intent-texts"
        }
      ],
      "returns": "decided",
      "errors": "rejection",
      "let": [
        {
          "name": "def",
          "expr": "try call object-def(d, object)"
        },
        {
          "name": "old",
          "expr": "try call stored(d, object, id)"
        },
        {
          "name": "d1",
          "expr": "try call require(d, action.delete, resource.object(object), subject{old, new: old}, texts)"
        },
        {
          "name": "d2",
          "expr": "try call check-version(d1, old, expected-version)"
        },
        {
          "name": "target",
          "expr": "value.ref(id)"
        },
        {
          "name": "d3",
          "expr": "fold(rf in call referrers(d2.tenant.schema, object), da = d2, fold(r in filter(r in try call lookup-by-field(da.tenant, da.coverage, rf.object.id, rf.field.id, target), !(r.id == id && rf.object.id == object)), db = da, let rule = format('reference:{}.{}', rf.object.id, rf.field.id) in if rf.on-delete == on-delete.restrict || (rf.field.required && !rf.is-list) then fail(call draft-reject(concat(db.evidence, [check{rule, passed: false, detail: format('{} {} still refers to this record', rf.object.id, r.id)}]), error-kind.still-referenced, format('{} {} refers to {} {}', rf.object.id, r.id, object, id))) else let cleared = record{id: r.id, object: r.object, version: r.version + 1, created-by: r.created-by, created-at: r.created-at, updated-at: db.ctx.now, fields: match get(r.fields, rf.field.id) { Some(x) => match x { list(items) => insert(r.fields, rf.field.id, value.list(filter(i in items, i != target))), _ => remove(r.fields, rf.field.id) }, None => remove(r.fields, rf.field.id) }} in draft{tenant: db.tenant, ctx: db.ctx, coverage: db.coverage, ops: concat(db.ops, [delta-op.put-record(cleared)]), events: concat(db.events, [event-body.record-updated{before: r, after: cleared}]), effects: db.effects, evidence: concat(db.evidence, [check{rule, passed: true, detail: format('cleared on {} {}', rf.object.id, r.id)}]), next-record: db.next-record}))"
        }
      ],
      "body": "decided{draft: draft{tenant: d3.tenant, ctx: d3.ctx, coverage: d3.coverage, ops: concat(d3.ops, [delta-op.delete-record{object, id}]), events: concat(d3.events, [event-body.record-deleted{before: old}]), effects: d3.effects, evidence: d3.evidence, next-record: d3.next-record}, output: output.deleted{object, id}}",
