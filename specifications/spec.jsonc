    {
      "id": "role-permission-problems",
      "description": "schema.rs TenantSchema::problems, the permissions of roles (in role id order): a role that is not declared, the owner role (it holds every permission), and per permission (in order) a capability with a blank name, an object permission on an object type the schema does not declare, and one that names no action. A capability of the product form that is not declared, or that belongs to another product than the role, is a problem too (capability-grant-problem).",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "roles",
          "type": "list<role-id>"
        }
      ],
      "returns": "list<string>",
      "body": "match schema.role-permissions { None => [], Some(table) => fold(role in keys(table), ps = [], let at = format('role {}', role) in concat(concat(concat(ps, if any(r in roles, r == role) then [] else [format('{}: permissions of an unknown role', at)]), if role == 'owner' then [format('{}: the owner role holds every permission', at)] else []), match get(table, role) { Some(permissions) => fold(p in permissions, qs = [], concat(qs, match p { capability(name) => if trim(name) == '' then [format('{}: a capability needs a name', at)] else (match call capability-grant-problem(schema, role, name) { Some(problem) => [format('{}: {}', at, problem)], None => [] }), object{object: o, actions: acts} => concat(if get(schema.objects, o) == null then [format('{}: permission on unknown object type {}', at, o)] else [], if acts == [] then [format('{}: permission on {} names no action', at, o)] else []) })), None => [] })) }",
      "examples": [
        {
          "description": "An unknown role, the owner role, a blank capability name, an unknown object type and no action.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-5",
              "with": {
                "role-permissions": {
                  "ghost": [
                    {
                      "object": {
                        "object": "note",
                        "actions": [
                          "read"
                        ]
                      }
                    }
                  ],
                  "owner": [
                    {
                      "capability": "export"
                    }
                  ],
                  "writer": [
                    {
                      "capability": "  "
                    },
                    {
                      "object": {
                        "object": "nowhere",
                        "actions": []
                      }
                    },
                    {
                      "object": {
                        "object": "note",
                        "actions": [
                          "read",
                          "update"
                        ]
                      }
                    }
                  ]
                }
              }
            },
            "roles": [
              "editor",
              "owner",
              "public",
              "writer"
            ]
          },
          "result": [
            "role ghost: permissions of an unknown role",
            "role owner: the owner role holds every permission",
            "role writer: a capability needs a name",
            "role writer: permission on unknown object type nowhere",
            "role writer: permission on nowhere names no action"
          ]
        },
        {
          "description": "No permissions, no problem.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-5"
            },
            "roles": [
              "editor",
              "owner",
              "public",
              "writer"
            ]
          },
          "result": []
        },
        {
          "description": "A capability of the product form must be declared; a platform capability is not checked, and a declared one may be granted by a role of the tenant (D-6590).",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-31",
              "with": {
                "capabilities.member_tiers__promote.description": "d",
                "role-permissions": {
                  "editor": [
                    {
                      "capability": "member_tiers__promote"
                    },
                    {
                      "capability": "other__thing"
                    },
                    {
                      "capability": "content-edit"
                    }
                  ]
                }
              }
            },
            "roles": [
              "editor",
              "owner",
              "public",
              "writer"
            ]
          },
          "result": [
            "role editor: capability other__thing is neither a platform capability nor declared in the tenant"
          ]
        },
        {
          "description": "A role of another product may not grant the capability of a product.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-31",
              "with": {
                "roles.crm__agent": {
                  "id": "crm__agent",
                  "label": "Agent"
                },
                "capabilities.member_tiers__promote.description": "d",
                "role-permissions": {
                  "crm__agent": [
                    {
                      "capability": "member_tiers__promote"
                    }
                  ]
                }
              }
            },
            "roles": [
              "crm__agent",
              "editor",
              "owner",
              "public",
              "writer"
            ]
          },
          "result": [
            "role crm__agent: capability member_tiers__promote belongs to product member_tiers and role crm__agent to product crm"
          ]
        }
      ]
    },
    {
      "id": "team-problems",
      "description": "schema.rs TenantSchema::problems, the teams (in id order): per role of the team (in order) a role that is not declared, and the public role (everyone holds it already).",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "roles",
          "type": "list<role-id>"
        }
      ],
      "returns": "list<string>",
      "body": "match schema.teams { None => [], Some(teams) => fold(t in values(teams), ps = [], let at = format('team {}', t.id) in concat(ps, fold(role in t.roles, qs = [], concat(concat(qs, if any(r in roles, r == role) then [] else [format('{}: unknown role {}', at, role)]), if role == 'public' then [format('{}: everyone already holds public', at)] else [])))) }",
      "examples": [
        {
          "description": "A team with an unknown role and the public role.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-5",
              "with": {
                "teams": {
                  "desk": {
                    "id": "desk",
                    "label": "Desk",
                    "members": [],
                    "roles": [
                      "nope",
                      "public",
                      "writer"
                    ]
                  }
                }
              }
            },
            "roles": [
              "editor",
              "owner",
              "public",
              "writer"
            ]
          },
          "result": [
            "team desk: unknown role nope",
            "team desk: everyone already holds public"
          ]
        },
        {
          "description": "No teams.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-5"
            },
            "roles": [
              "editor",
              "owner",
              "public",
              "writer"
            ]
          },
          "result": []
        }
      ]
    },
    {
      "id": "invitation-problems",
      "description": "schema.rs TenantSchema::problems, the invitations (in id order): one that names no address, and per role (in order) a role that is not declared.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "roles",
          "type": "list<role-id>"
        }
      ],
      "returns": "list<string>",
      "body": "match schema.invitations { None => [], Some(invitations) => fold(i in values(invitations), ps = [], let at = format('invitation {}', i.id) in concat(concat(ps, if i.address == '' then [format('{}: names no address', at)] else []), fold(role in i.roles, qs = [], concat(qs, if any(r in roles, r == role) then [] else [format('{}: unknown role {}', at, role)])))) }",
      "examples": [
        {
          "description": "An invitation without an address and with an unknown role (the invitation ok has none).",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-5",
              "with": {
                "invitations": {
                  "welcome": {
                    "id": "welcome",
                    "address": "",
                    "roles": [
                      "ghost",
                      "writer"
                    ],
                    "created-by": "alpha:owner",
                    "redeemed-by": null
                  },
                  "ok": {
                    "id": "ok",
                    "address": "a@b.c",
                    "roles": [
                      "writer"
                    ],
                    "created-by": "alpha:owner",
                    "redeemed-by": null
                  }
                }
              }
            },
            "roles": [
              "editor",
              "owner",
              "public",
              "writer"
            ]
          },
          "result": [
            "invitation welcome: names no address",
            "invitation welcome: unknown role ghost"
          ]
        },
        {
          "description": "No invitations.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-5"
            },
            "roles": [
              "editor",
              "owner",
              "public",
              "writer"
            ]
          },
          "result": []
        }
      ]
    },
