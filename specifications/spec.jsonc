    {"id":"ui-impact-lab","name":"The Impact Lab projects a schema change, explains the differences, and leaves live data alone","verifies":["sim-003","sim-004","krn-009","krn-010","idn-022"],"description":"Journey of tests/e2e/site.spec.js, the test named \"the Impact Lab projects a schema change, explains the differences, and leaves live data alone\". Hand-written test keeps: that the diagnostics report lists at least four recent backend runs (numeric comparison on an API reply); that the first verdict read \"accepts the change\" before the re-run (asserted once, at the first run, instead); the screenshot.","steps":[{"goto":{"screen":"screen-sign-in"}},{"fill":{"form":"form-sign-in","field":"login","value":"tomasz"}},{"fill":{"form":"form-sign-in","field":"password","value":"strata-dev-tomasz"}},{"submit":{"form":"form-sign-in"}},{"expectRole":{"role":"heading","level":1,"name":"Writing desk"}},{"goto":{"screen":"screen-lab"}},{"expectRole":{"role":"heading","level":1,"name":"Your account cannot open this page"}},{"click":{"role":"button","name":"Sign out"}},{"expectText":{"text":"Signed out.","within":{"role":"region","name":"Messages"}}},{"goto":{"screen":"screen-sign-in"}},{"fill":{"form":"form-sign-in","field":"login","value":"admin"}},{"fill":{"form":"form-sign-in","field":"password","value":"strata-dev-admin"}},{"submit":{"form":"form-sign-in"}},{"expectRole":{"role":"heading","level":1,"name":"Writing desk"}},{"click":{"role":"link","name":"Impact Lab"}},{"expectRole":{"role":"heading","level":1,"name":"Impact Lab"}},{"expectText":{"pattern":"Fieldnotes at revision \\d+: schema version 2","within":{"role":"region","name":"Snapshot"}}},{"capture":{"name":"snapshot","from":"text","element":{"role":"region","name":"Snapshot"}}},{"click":{"role":"button","name":"Metadata"}},{"expectRole":{"role":"heading","level":2,"namePattern":"Post"}},{"expectRole":{"role":"row","namePattern":"post\\.excerpt string no no"}},{"expectText":{"text":"public_reads_published"}},{"axeScan":{}},{"click":{"role":"button","name":"Projection"}},{"fill":{"role":"textbox","name":"Proposed change","value":"require post.nonsense"}},{"click":{"role":"button","name":"Run the projection"}},{"expectText":{"text":"line 1: post has no field nonsense","within":{"role":"alert"}}},{"click":{"role":"button","name":"Require an excerpt on every article"}},{"expectAttribute":{"role":"textbox","name":"Proposed change","attribute":"value","value":"require post.excerpt"}},{"click":{"role":"checkbox","name":"Inject faults: lost commit races and dropped event deliveries"}},{"click":{"role":"button","name":"Run the projection"}},{"expectRole":{"role":"heading","level":2,"name":"What would change","timeoutMs":60000}},{"expectText":{"pattern":"The kernel accepts the change\\. \\d+ of 60 replayed operations then end differently\\.","within":{"role":"region","name":"What would change"}}},{"expectText":{"text":"Proven","within":{"role":"region","name":"What would change"}}},{"expectText":{"text":"Reproduced","within":{"role":"region","name":"What would change"}}},{"expectText":{"text":"Sound approximation","within":{"role":"region","name":"What would change"}}},{"expectText":{"text":"Estimated","within":{"role":"region","name":"What would change"}}},{"expectText":{"text":"Unknown","within":{"role":"region","name":"What would change"}}},{"expectRole":{"role":"row","namePattern":"post \\d+ Slow Software required:post\\.excerpt"}},{"expectText":{"text":"Rejected: MissingRequired","within":{"role":"row","namePattern":"first divergence"}}},{"expectText":{"text":"Smallest schedule found that still shows the first divergence"}},{"expectText":{"text":"Fails","within":{"role":"row","namePattern":"Every record has only known fields"}}},{"expectText":{"text":"Tenant isolation: every other tenant in the simulated world is identical in both executions."}},{"expectText":{"pattern":"60 of 6\\d steps agree when re-run against the bare kernel"}},{"expectText":{"pattern":"event deliveries dropped and retried; every event still arrived once, in order"}},{"axeScan":{}},{"click":{"role":"button","name":"Run the projection"}},{"expectText":{"text":"Projection finished","within":{"role":"region","name":"Messages"},"timeoutMs":60000}},{"click":{"role":"radio","name":"Refuse the change"}},{"click":{"role":"button","name":"Run the projection"}},{"expectText":{"pattern":"The kernel refuses the change: \\d+ existing record\\(s\\) would not conform to the new schema\\.","within":{"role":"region","name":"What would change"},"timeoutMs":60000}},{"click":{"role":"radio","name":"Leave them as they are"}},{"click":{"role":"radio","name":"What actually happened"}},{"click":{"role":"button","name":"Run the projection"}},{"expectText":{"pattern":"replayed operations then end differently","within":{"role":"region","name":"What would change"},"timeoutMs":60000}},{"expectText":{"text":"create record","within":{"role":"row","namePattern":"first divergence"}}},{"click":{"role":"button","name":"Evidence"}},{"click":{"role":"button","name":"Replay the journal"}},{"expectText":{"pattern":"committed operations replay to exactly the recorded result, and the replayed state is the live state\\."}},{"click":{"role":"button","name":"Diagnostics"}},{"expectRole":{"role":"heading","level":2,"name":"Kernel transitions"}},{"expectRole":{"role":"row","namePattern":"change_schema"}},{"capture":{"name":"sid","from":"cookie","cookie":"__Host-strata_sid"}},{"apiCall":{"method":"GET","path":"/api/diagnostics","expectStatus":200,"expectBodyExcludes":["${sid}","strata-dev-"]}},{"axeScan":{}},{"reload":{}},{"expectText":{"text":"${snapshot}","within":{"role":"region","name":"Snapshot"}}},{"click":{"role":"button","name":"Metadata"}},{"expectRole":{"role":"row","namePattern":"post\\.excerpt string no no"}}]},
    {"id":"ui-logs-hold-no-secrets","name":"No log line holds a password, a session token or a CSRF token","verifies":["idn-022"],"description":"Journey of tests/e2e/site.spec.js, the test named \"no log line holds a password, a session token or a CSRF token\". Hand-written test keeps: that the logs are longer than 1000 characters and that one correlation id appears in both the backend and the BFF log (cross-service log correlation).","steps":[{"goto":{"screen":"screen-sign-in"}},{"fill":{"form":"form-sign-in","field":"login","value":"ines"}},{"fill":{"form":"form-sign-in","field":"password","value":"strata-dev-ines"}},{"submit":{"form":"form-sign-in"}},{"expectRole":{"role":"heading","level":1,"name":"Writing desk"}},{"capture":{"name":"sid","from":"cookie","cookie":"__Host-strata_sid"}},{"apiCall":{"method":"GET","path":"/api/session","expectStatus":200,"capture":{"csrfToken":"session.csrf_token"}}},{"logScan":{"forbid":["${sid}","${csrfToken}","strata-dev-ines","strata-dev-admin","not-the-password"]}}]},
    {"id":"ui-sessions-list-and-revoke","name":"A person sees where they are signed in, signs out another session from the desk, and that session is refused from then on","verifies":["idn-012","idn-013"],"browsers":["here","elsewhere"],"description":"Journey of tests/e2e/site.spec.js, the test named \"a person sees where they are signed in and signs out another session from the desk\". Hand-written test keeps: that the page holds no session cookie value (the cookie is HttpOnly, and the page text is not readable by a step); the data-current marker of the rows (the step grammar reads no row attribute: the text \"Another device\" stands for it). Beyond it, the revoked session's next request is made through the API with the request token it held, so that it is the gateway, not the page, that refuses it. A lost revocation notice cannot be made by a step, so IDN-013's \"including when the notice is lost\" is shown only in that the refusal does not depend on the page.","steps":[{"goto":{"screen":"screen-sign-in"}},{"fill":{"form":"form-sign-in","field":"login","value":"tomasz"}},{"fill":{"form":"form-sign-in","field":"password","value":"strata-dev-tomasz"}},{"submit":{"form":"form-sign-in"}},{"expectRole":{"role":"heading","level":1,"name":"Writing desk"}},{"apiCall":{"method":"GET","path":"/api/session","as":"here","expectStatus":200,"capture":{"hereCsrf":"session.csrf_token"}}},{"apiCall":{"method":"POST","path":"/api/sessions/revoke-others","as":"here","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"${hereCsrf}"},"body":{},"expectStatus":200}},{"goto":{"screen":"screen-desk"}},{"expectCount":{"role":"row","within":{"role":"region","name":"Where you are signed in"},"count":2}},{"switchBrowser":"elsewhere"},{"goto":{"screen":"screen-sign-in"}},{"fill":{"form":"form-sign-in","field":"login","value":"tomasz"}},{"fill":{"form":"form-sign-in","field":"password","value":"strata-dev-tomasz"}},{"submit":{"form":"form-sign-in"}},{"expectRole":{"role":"heading","level":1,"name":"Writing desk"}},{"expectAttribute":{"role":"status","name":"Live connection","attribute":"data-connection","value":"open"}},{"apiCall":{"method":"GET","path":"/api/session","as":"elsewhere","expectStatus":200,"capture":{"elsewhereCsrf":"session.csrf_token"}}},{"expectCount":{"role":"row","within":{"role":"region","name":"Where you are signed in"},"count":3}},{"switchBrowser":"here"},{"goto":{"screen":"screen-desk"}},{"expectCount":{"role":"row","within":{"role":"region","name":"Where you are signed in"},"count":3}},{"expectText":{"text":"Another device","within":{"role":"region","name":"Where you are signed in"}}},{"click":{"role":"button","name":"Sign out that session","within":{"role":"region","name":"Where you are signed in"}}},{"expectText":{"text":"That session has been signed out.","within":{"role":"region","name":"Messages"}}},{"expectCount":{"role":"row","within":{"role":"region","name":"Where you are signed in"},"count":2}},{"expectText":{"text":"This is the only place you are signed in.","within":{"role":"region","name":"Where you are signed in"}}},{"switchBrowser":"elsewhere"},{"expectRole":{"role":"heading","level":1,"name":"Sign in to continue"}},{"apiCall":{"method":"POST","path":"/api/records","as":"elsewhere","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"${elsewhereCsrf}"},"body":{"op":"create","object":"category","fields":{"name":"Forged","slug":"forged-revoked"}},"expectStatus":401}},{"apiCall":{"method":"GET","path":"/api/session","as":"elsewhere","expectStatus":200,"expectJson":{"session.authenticated":false}}},{"switchBrowser":"here"},{"expectRole":{"role":"heading","level":1,"name":"Writing desk"}}]},
    {"id":"ui-sign-out-all-other-sessions","name":"A person signs out all their other sessions at once","verifies":["idn-012"],"browsers":["here","second","third"],"description":"Journey of tests/e2e/site.spec.js, the test named \"a person signs out all their other sessions at once\".","steps":[{"goto":{"screen":"screen-sign-in"}},{"fill":{"form":"form-sign-in","field":"login","value":"mirela"}},{"fill":{"form":"form-sign-in","field":"password","value":"strata-dev-mirela"}},{"submit":{"form":"form-sign-in"}},{"expectRole":{"role":"heading","level":1,"name":"Writing desk"}},{"apiCall":{"method":"GET","path":"/api/session","as":"here","expectStatus":200,"capture":{"hereCsrf":"session.csrf_token"}}},{"apiCall":{"method":"POST","path":"/api/sessions/revoke-others","as":"here","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"${hereCsrf}"},"body":{},"expectStatus":200}},{"switchBrowser":"second"},{"goto":{"screen":"screen-sign-in"}},{"fill":{"form":"form-sign-in","field":"login","value":"mirela"}},{"fill":{"form":"form-sign-in","field":"password","value":"strata-dev-mirela"}},{"submit":{"form":"form-sign-in"}},{"expectRole":{"role":"heading","level":1,"name":"Writing desk"}},{"expectAttribute":{"role":"status","name":"Live connection","attribute":"data-connection","value":"open"}},{"switchBrowser":"third"},{"goto":{"screen":"screen-sign-in"}},{"fill":{"form":"form-sign-in","field":"login","value":"mirela"}},{"fill":{"form":"form-sign-in","field":"password","value":"strata-dev-mirela"}},{"submit":{"form":"form-sign-in"}},{"expectRole":{"role":"heading","level":1,"name":"Writing desk"}},{"expectAttribute":{"role":"status","name":"Live connection","attribute":"data-connection","value":"open"}},{"switchBrowser":"here"},{"goto":{"screen":"screen-desk"}},{"expectCount":{"role":"row","within":{"role":"region","name":"Where you are signed in"},"count":4}},{"click":{"role":"button","name":"Sign out all other sessions","within":{"role":"region","name":"Where you are signed in"}}},{"expectText":{"text":"Signed out 2 other sessions.","within":{"role":"region","name":"Messages"}}},{"expectCount":{"role":"row","within":{"role":"region","name":"Where you are signed in"},"count":2}},{"switchBrowser":"second"},{"expectRole":{"role":"heading","level":1,"name":"Sign in to continue"}},{"switchBrowser":"third"},{"expectRole":{"role":"heading","level":1,"name":"Sign in to continue"}},{"switchBrowser":"here"},{"expectRole":{"role":"heading","level":1,"name":"Writing desk"}}]},
    {"id":"ui-login-lockout","name":"Ten wrong passwords lock a login for a while, whether or not it exists, and say the same thing for a login that does not exist","verifies":["idn-008","uxa-202"],"description":"Journey of tests/e2e/site.spec.js, the test named \"ten wrong passwords lock a login for a while, whether or not it exists\". Hand-written test keeps: that the locked attempt's response sets no cookie (the journey asserts that the session cookie is absent instead).","steps":[{"goto":{"screen":"screen-sign-in"}},{"apiCall":{"method":"GET","path":"/api/session","expectStatus":200,"capture":{"visitorCsrf":"session.csrf_token"}}},{"apiCall":{"method":"POST","path":"/api/login","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"${visitorCsrf}"},"body":{"login":"  Lockout-Probe ","password":"not-the-password"},"expectStatus":401,"expectJson":{"message":"The name or password is not right."}}},{"apiCall":{"method":"POST","path":"/api/login","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"${visitorCsrf}"},"body":{"login":"  Lockout-Probe ","password":"not-the-password"},"expectStatus":401,"expectJson":{"message":"The name or password is not right."}}},{"apiCall":{"method":"POST","path":"/api/login","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"${visitorCsrf}"},"body":{"login":"  Lockout-Probe ","password":"not-the-password"},"expectStatus":401,"expectJson":{"message":"The name or password is not right."}}},{"apiCall":{"method":"POST","path":"/api/login","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"${visitorCsrf}"},"body":{"login":"  Lockout-Probe ","password":"not-the-password"},"expectStatus":401,"expectJson":{"message":"The name or password is not right."}}},{"apiCall":{"method":"POST","path":"/api/login","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"${visitorCsrf}"},"body":{"login":"  Lockout-Probe ","password":"not-the-password"},"expectStatus":401,"expectJson":{"message":"The name or password is not right."}}},{"apiCall":{"method":"POST","path":"/api/login","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"${visitorCsrf}"},"body":{"login":"  Lockout-Probe ","password":"not-the-password"},"expectStatus":401,"expectJson":{"message":"The name or password is not right."}}},{"apiCall":{"method":"POST","path":"/api/login","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"${visitorCsrf}"},"body":{"login":"  Lockout-Probe ","password":"not-the-password"},"expectStatus":401,"expectJson":{"message":"The name or password is not right."}}},{"apiCall":{"method":"POST","path":"/api/login","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"${visitorCsrf}"},"body":{"login":"  Lockout-Probe ","password":"not-the-password"},"expectStatus":401,"expectJson":{"message":"The name or password is not right."}}},{"apiCall":{"method":"POST","path":"/api/login","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"${visitorCsrf}"},"body":{"login":"  Lockout-Probe ","password":"not-the-password"},"expectStatus":401,"expectJson":{"message":"The name or password is not right."}}},{"apiCall":{"method":"POST","path":"/api/login","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"${visitorCsrf}"},"body":{"login":"  Lockout-Probe ","password":"not-the-password"},"expectStatus":401,"expectJson":{"message":"The name or password is not right."}}},{"fill":{"form":"form-sign-in","field":"login","value":"LOCKOUT-PROBE"}},{"fill":{"form":"form-sign-in","field":"password","value":"not-the-password"}},{"submit":{"form":"form-sign-in"}},{"expectText":{"text":"Too many attempts","within":{"role":"alert"}}},{"apiCall":{"method":"POST","path":"/api/login","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"${visitorCsrf}"},"body":{"login":"  Lockout-Probe ","password":"not-the-password"},"expectStatus":429}},{"expectCookie":{"name":"__Host-strata_sid","absent":true}},{"fill":{"form":"form-sign-in","field":"login","value":"ines"}},{"fill":{"form":"form-sign-in","field":"password","value":"strata-dev-ines"}},{"submit":{"form":"form-sign-in"}},{"expectRole":{"role":"heading","level":1,"name":"Writing desk"}}]},
    {"id":"ui-bound-domain-password-refused","name":"A password for an address in a domain the identity provider decides for is refused, and the same password for the person's own login is accepted","verifies":["fed-009"],"description":"Journey of tests/e2e/site.spec.js, the test named \"a password for an address in a domain the provider decides for is refused\".","steps":[{"goto":{"screen":"screen-sign-in"}},{"fill":{"form":"form-sign-in","field":"login","value":"ines@bound.example"}},{"fill":{"form":"form-sign-in","field":"password","value":"strata-dev-ines"}},{"submit":{"form":"form-sign-in"}},{"expectText":{"text":"The name or password is not right.","within":{"role":"alert"}}},{"expectRole":{"role":"heading","level":1,"name":"Sign in"}},{"fill":{"form":"form-sign-in","field":"login","value":"ines"}},{"fill":{"form":"form-sign-in","field":"password","value":"strata-dev-ines"}},{"submit":{"form":"form-sign-in"}},{"expectRole":{"role":"heading","level":1,"name":"Writing desk"}}]},
    {"id":"ui-no-passkeys-at-ip-address","name":"A site reached by an address that is not a name offers no passkeys","description":"Journey of tests/e2e/site.spec.js, the test named \"a site reached by an address that is not a name offers no passkeys\".","steps":[{"goto":{"screen":"screen-sign-in"}},{"expectRole":{"role":"textbox","name":"Name"}},{"expectCount":{"role":"button","name":"Sign in with a passkey","count":0}},{"goto":{"screen":"screen-sign-in"}},{"fill":{"form":"form-sign-in","field":"login","value":"ines"}},{"fill":{"form":"form-sign-in","field":"password","value":"strata-dev-ines"}},{"submit":{"form":"form-sign-in"}},{"expectRole":{"role":"heading","level":1,"name":"Writing desk"}},{"expectCount":{"role":"region","name":"Passkeys","count":0}}]},
    {"id":"ui-oidc-sign-in","name":"The sign-in page offers the OpenID Connect provider, and signing in through it makes the person once","verifies":["fed-010","fed-011"],"description":"Journey of tests/e2e/site.spec.js, the test named \"the sign-in page offers the provider, and signing in through it makes the person once\". Hand-written test keeps: that the authorization callback was requested exactly once (a step counts requests only from a lower bound), and the replay of that callback address (a step cannot capture a request's address).","steps":[{"apiCall":{"method":"POST","path":"/__control","host":"127.0.0.1:4290","anonymous":true,"body":{"reset":true,"sub":"e2e-journey-nora","email":"nora@bound.example","email_verified":true,"name":"Nora Newcomer"}}},{"goto":{"screen":"screen-sign-in"}},{"click":{"role":"button","name":"Sign in with Mock Provider"}},{"expectRole":{"role":"heading","level":1,"name":"Writing desk"}},{"expectText":{"text":"Signed in as Nora Newcomer","within":{"role":"region","name":"Messages"}}},{"clickAction":{"action":"act-sign-out-desk"}},{"expectText":{"text":"Signed out.","within":{"role":"region","name":"Messages"}}},{"apiCall":{"method":"POST","path":"/__control","host":"127.0.0.1:4290","anonymous":true,"body":{"reset":true,"sub":"e2e-journey-nora","email":"nora@bound.example","email_verified":true,"name":"Someone Else"}}},{"goto":{"screen":"screen-sign-in"}},{"click":{"role":"button","name":"Sign in with Mock Provider"}},{"expectText":{"text":"Signed in as Nora Newcomer","within":{"role":"region","name":"Messages"}}},{"clickAction":{"action":"act-sign-out-desk"}},{"expectText":{"text":"Signed out.","within":{"role":"region","name":"Messages"}}}]},
    {"id":"ui-oidc-wrong-token","name":"An identity token that is wrong in any way signs no one in","verifies":["fed-003"],"description":"Journey of tests/e2e/site.spec.js, the test named \"an identity token that is wrong in any way signs no one in\".","steps":[{"apiCall":{"method":"POST","path":"/__control","host":"127.0.0.1:4290","anonymous":true,"body":{"reset":true,"sub":"e2e-wrong-audience","email":"x@bound.example","email_verified":true,"name":"Nobody","aud":"another-client"}}},{"goto":{"screen":"screen-sign-in"}},{"click":{"role":"button","name":"Sign in with Mock Provider"}},{"expectText":{"text":"not accepted","within":{"role":"alert"}}},{"expectRole":{"role":"heading","level":1,"name":"Sign in"}},{"apiCall":{"method":"POST","path":"/__control","host":"127.0.0.1:4290","anonymous":true,"body":{"reset":true,"sub":"e2e-wrong-nonce","email":"x@bound.example","email_verified":true,"name":"Nobody","nonce":"a-nonce-that-was-never-asked-for"}}},{"goto":{"screen":"screen-sign-in"}},{"click":{"role":"button","name":"Sign in with Mock Provider"}},{"expectText":{"text":"not accepted","within":{"role":"alert"}}},{"expectRole":{"role":"heading","level":1,"name":"Sign in"}},{"apiCall":{"method":"POST","path":"/__control","host":"127.0.0.1:4290","anonymous":true,"body":{"reset":true,"sub":"e2e-wrong-expiry","email":"x@bound.example","email_verified":true,"name":"Nobody","exp_offset":-3600}}},{"goto":{"screen":"screen-sign-in"}},{"click":{"role":"button","name":"Sign in with Mock Provider"}},{"expectText":{"text":"not accepted","within":{"role":"alert"}}},{"expectRole":{"role":"heading","level":1,"name":"Sign in"}},{"apiCall":{"method":"POST","path":"/__control","host":"127.0.0.1:4290","anonymous":true,"body":{"reset":true,"sub":"e2e-wrong-key","email":"x@bound.example","email_verified":true,"name":"Nobody","kid":"a-key-that-is-not-published"}}},{"goto":{"screen":"screen-sign-in"}},{"click":{"role":"button","name":"Sign in with Mock Provider"}},{"expectText":{"text":"not accepted","within":{"role":"alert"}}},{"expectRole":{"role":"heading","level":1,"name":"Sign in"}},{"apiCall":{"method":"POST","path":"/__control","host":"127.0.0.1:4290","anonymous":true,"body":{"reset":true,"deny":true}}},{"goto":{"screen":"screen-sign-in"}},{"click":{"role":"button","name":"Sign in with Mock Provider"}},{"expectText":{"text":"did not sign you in","within":{"role":"alert"}}}]},
    {"id":"ui-oidc-forged-callback","name":"A callback that no sign-in of this browser started is refused","verifies":["fed-001"],"description":"Journey of tests/e2e/site.spec.js, the test named \"a callback that no sign-in of this browser started is refused\".","steps":[{"goto":{"screen":"screen-sign-in"}},{"gotoPath":{"path":"/federation/oidc/callback?state=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef&code=a-code-nobody-issued"}},{"expectText":{"text":"not accepted","within":{"role":"alert"}}},{"expectRole":{"role":"heading","level":1,"name":"Sign in"}}]},
    {"id":"ui-saml-sign-in","name":"The sign-in page offers the SAML provider, and signing in through it makes the person once","verifies":["fed-010","fed-005"],"description":"Journey of tests/e2e/site.spec.js, the test named \"the sign-in page offers the SAML provider, and signing in through it makes the person once\". Hand-written test keeps: that the provider saw exactly one request (the journey reads what it saw and checks the address of the assertion consumer and the issuer, not the count), and that exactly one POST reached the assertion consumer.","steps":[{"apiCall":{"method":"POST","path":"/__control","host":"127.0.0.1:4291","anonymous":true,"body":{"reset":true,"sub":"e2e-saml-journey-sam","email":"sam@saml.example","name":"Sam Saml"}}},{"goto":{"screen":"screen-sign-in"}},{"click":{"role":"button","name":"Sign in with Mock SAML Provider"}},{"expectRole":{"role":"heading","level":1,"name":"Writing desk"}},{"expectText":{"text":"Signed in as Sam Saml","within":{"role":"region","name":"Messages"}}},{"apiCall":{"method":"GET","path":"/__seen","host":"127.0.0.1:4291","anonymous":true,"expectStatus":200,"expectBodyIncludes":["http://127.0.0.1:4200/federation/saml/acs","http://127.0.0.1:4200/federation/saml/metadata/mock"]}},{"clickAction":{"action":"act-sign-out-desk"}},{"expectText":{"text":"Signed out.","within":{"role":"region","name":"Messages"}}},{"apiCall":{"method":"POST","path":"/__control","host":"127.0.0.1:4291","anonymous":true,"body":{"reset":true,"sub":"e2e-saml-journey-sam","email":"sam@saml.example","name":"Someone Else"}}},{"goto":{"screen":"screen-sign-in"}},{"click":{"role":"button","name":"Sign in with Mock SAML Provider"}},{"expectText":{"text":"Signed in as Sam Saml","within":{"role":"region","name":"Messages"}}},{"clickAction":{"action":"act-sign-out-desk"}},{"expectText":{"text":"Signed out.","within":{"role":"region","name":"Messages"}}}]},
