    {
      "id": "m-next-job-created-with-completion",
      "kind": "invariant",
      "models": "sch-003",
      "statement": "A schedule that is not paused always has an open job: the next job exists as soon as the current one is recorded as completed.",
      "evaluate": {
        "method": "state-invariant",
        "scenarios": [
          "schedule-job-completes",
          "schedule-paused-while-job-runs",
