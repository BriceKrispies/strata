        },
        {
          "name": "literal",
          "type": "u64"
        },
        {
          "name": "params",
          "type": "map<string, string>"
        }
      ]
    },
    {
      "id": "route-pick",
      "name": "Route Pick",
      "kind": "struct",
      "description": "match_route so far: the best view found and its number of literal segments.",
      "fields": [
        {
          "name": "literal",
          "type": "u64"
        },
        {
          "name": "found",
          "type": "option<route-match>"
        }
      ]
    },
    {
      "id": "included-target",
      "name": "Included Target",
      "kind": "struct",
      "description": "substrate project.rs included_refs, one included field: the object type it refers to and the record ids the rows name, each once, in order.",
      "fields": [
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "ids",
          "type": "list<record-id>"
        }
      ]
    },
    {
      "id": "section-data",
      "name": "Section Data",
      "kind": "struct",
      "description": "strata_substrate::project::SectionData: the raw result of one view section, before projection; included holds the referenced records the principal may read, by referencing field.",
      "fields": [
        {
          "name": "single",
          "type": "bool"
        },
        {
          "name": "rows",
          "type": "list<record>"
        },
        {
          "name": "included",
          "type": "map<field-id, map<record-id, record>>"
        },
        {
          "name": "markdown",
          "type": "list<field-id>"
        }
      ]
    },
    {
      "id": "view-progress",
      "name": "View Progress",
      "kind": "struct",
      "description": "backend ops.rs view so far: the single rows of the sections evaluated (for later sections), the section data, and the revision read at.",
      "fields": [
        {
          "name": "done",
          "type": "map<string, option<record>>"
        },
        {
          "name": "sections",
          "type": "map<string, section-data>"
        },
        {
          "name": "revision",
          "type": "state-revision"
        }
      ]
    },
    {
      "id": "markdown-summary",
      "name": "Markdown Summary",
      "kind": "struct",
      "description": "What substrate markdown.rs gives for one Markdown source: the parsed blocks as JSON and word_count of them. The stand-in of parsing Markdown, which the function language cannot do (WG-4957).",
      "fields": [
        {
          "name": "blocks",
          "type": "plain-json"
        },
        {
          "name": "words",
          "type": "u64"
        }
      ]
    },
    {
      "id": "markdown-fold",
      "name": "Markdown Fold",
      "kind": "struct",
      "description": "project.rs project_row over the markdown fields: the blocks by field and the words counted.",
      "fields": [
        {
          "name": "blocks",
          "type": "map<string, plain-json>"
        },
        {
          "name": "words",
          "type": "u64"
        }
      ]
    },
    {
      "id": "team-id",
      "name": "team-id",
      "kind": "id",
      "repr": "string",
      "description": "kernel TeamId: a team of a tenant, a named set of principals that holds roles together; [a-z][a-z0-9_]*, at most 64 bytes.",
      "constraints": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "maxLength": 64
      }
    },
    {
      "id": "invitation-id",
      "name": "invitation-id",
      "kind": "id",
      "repr": "string",
      "description": "kernel InvitationId: an invitation of a tenant, chosen by whoever issues it; [A-Za-z0-9_:.-]+, at most 96 bytes.",
      "constraints": {
        "pattern": "^[A-Za-z0-9_:.-]+$",
        "maxLength": 96
      }
    },
    {
      "id": "capability-name",
      "name": "capability-name",
      "kind": "id",
      "repr": "string",
      "description": "The id of one of the platform's capabilities (a capability of this specification)."
    },
    {
      "id": "object-action",
      "name": "Object action",
      "kind": "enum",
      "values": [
        "read",
        "create",
        "update",
        "delete"
      ],
      "description": "strata_kernel::ObjectAction: an action on the records of one object type that a role's permission can name (read, create, update, delete); the kernel maps it to the policy Action of the same name."
    },
    {
      "id": "tenant-permission",
      "name": "Tenant permission",
      "kind": "struct",
      "metamodel": "definition",
      "fields": [
        {
          "name": "capability",
          "type": "capability-name",
          "optional": true
        },
        {
          "name": "object",
          "type": "object-type-id",
          "optional": true
        },
        {
          "name": "actions",
          "type": "list<object-action>",
          "optional": true
        }
      ],
      "description": "One permission of a tenant role (ADM-150): a capability, or actions on the records of an object type of the tenant's schema; exactly one of capability and object, and actions with object (kernel Permission)."
    },
    {
      "id": "tenant-role",
      "name": "Tenant role",
      "kind": "struct",
      "metamodel": "definition",
      "fields": [
        {
          "name": "id",
          "type": "role-id"
        },
        {
          "name": "label",
          "type": "string"
        },
        {
          "name": "permissions",
          "type": "list<tenant-permission>"
        }
      ],
      "description": "A role of a tenant, held as tenant data (ADM-150): a named set of permissions over the capabilities and the object types of the tenant's schema. The template's roles (the tenant roles of this specification) are where a tenant starts."
    },
    {
      "id": "role-assignment",
      "name": "Role assignment",
      "kind": "struct",
      "metamodel": "definition",
      "fields": [
        {
          "name": "role",
          "type": "role-id"
        },
        {
          "name": "principal",
          "type": "principal-id",
          "optional": true
        },
        {
          "name": "team",
          "type": "team-id",
          "optional": true
        }
      ],
      "description": "A tenant role assigned to a principal (a person, service or agent) or to a team; exactly one of principal and team (ADM-150). Refused unless the assigner holds a permission the role grants (ADM-152)."
    },
    {
      "id": "tenant-team",
      "name": "Team",
      "kind": "struct",
      "metamodel": "definition",
      "fields": [
        {
          "name": "id",
          "type": "team-id"
        },
        {
          "name": "label",
          "type": "string"
        },
        {
          "name": "members",
          "type": "list<principal-id>"
        },
        {
          "name": "roles",
          "type": "list<role-id>"
        }
      ],
      "description": "A team of a tenant, held as tenant data: its members hold its roles (ADM-151). A principal holds exactly the permissions of its own roles and of its teams' roles."
    },
    {
      "id": "tenant-invitation",
      "name": "Invitation",
      "kind": "struct",
      "metamodel": "definition",
      "fields": [
        {
          "name": "id",
          "type": "invitation-id"
        },
        {
          "name": "address",
          "type": "email-address"
        },
        {
          "name": "roles",
          "type": "list<role-id>"
        },
        {
          "name": "redeemed-by",
          "type": "principal-id",
          "optional": true
        }
      ],
      "description": "An invitation of a tenant: grants its roles to the one person who redeems it with the address it names, once (ADM-153)."
    },
    {
      "id": "permission",
      "name": "Permission",
      "kind": "union",
      "variants": [
        {
          "name": "capability",
          "newtype": true,
          "fields": [
            {
              "name": "value",
              "type": "string"
            }
          ]
        },
        {
          "name": "object",
          "fields": [
            {
              "name": "object",
              "type": "object-type-id"
            },
            {
              "name": "actions",
              "type": "set<object-action>"
            }
          ]
        }
      ],
      "encoding": {
        "tag": "external",
        "variantCase": "PascalCase"
      },
      "description": "strata_kernel::Permission: one entry of a tenant role's permission set (ADM-150): the name of a platform capability, which the kernel treats as an opaque string, or actions on an object type. A tenant bundle writes it untagged (a bare capability name, or {object, actions}); the bundle reader converts."
    },
    {
      "id": "grant",
      "name": "Grant",
      "kind": "union",
      "variants": [
        {
          "name": "capability",
          "newtype": true,
          "fields": [
            {
              "name": "value",
              "type": "string"
            }
          ]
        },
        {
          "name": "object",
          "tuple": true,
          "fields": [
            {
              "name": "object",
              "type": "object-type-id"
            },
            {
              "name": "action",
              "type": "object-action"
            }
          ]
        }
      ],
      "encoding": {
        "tag": "external",
        "variantCase": "PascalCase"
      },
      "description": "strata_kernel::Grant: one indivisible permission; a Permission is the set of grants it expands to. Object(ObjectTypeId, ObjectAction) is a tuple variant."
    },
