  // ---- Fault model -------------------------------------------------------------------------------
  "environments": [
    {"id":"env-local","name":"Local container stack","description":"Every component and its dependencies in containers on one machine (D-22).","guarantees":[{"aspect":"zone-count","value":1,"source":"d-22"},{"aspect":"clock-skew","value":0,"unit":"millisecond","source":"d-22"}]},
    {"id":"env-stage","name":"Stage environment","description":"The platform's pre-production environment, made from the same definitions as production with its own accounts and synthetic tenants only (REL-554, REL-556).","guarantees":[{"aspect":"zone-count","value":3,"source":"d-553"},{"aspect":"region-count","value":1,"source":"d-553"},{"aspect":"clock-skew","value":500,"unit":"millisecond","source":"a-clock-skew"}]},
    {"id":"env-production","name":"Production environment","description":"The platform's live environment, made from the same definitions as the stage environment and changed only through release records and audited operations (D-23, D-501, REL-561).","guarantees":[{"aspect":"zone-count","value":3,"source":"d-553"},{"aspect":"region-count","value":1,"source":"d-553"},{"aspect":"clock-skew","value":500,"unit":"millisecond","source":"a-clock-skew"}]},
    {"id":"env-cloud","name":"Cloud profile, one region","description":"The first cloud profile (D-23): managed containers across three zones, managed PostgreSQL with a standby, a content delivery network.","guarantees":[{"aspect":"zone-count","value":3,"source":"d-23"},{"aspect":"region-count","value":1,"source":"d-23"},{"aspect":"clock-skew","value":500,"unit":"millisecond","source":"a-clock-skew"},{"aspect":"message-duplication","value":"wake notices and purge calls may be delivered more than once","source":"d-12"},{"aspect":"storage-durability","value":"a confirmed commit survives the loss of one database node","source":"a-database-commit"}]}
  ],
  "failureModes": [
    {"id":"fm-worker-stalls","name":"A worker stalls while holding a lease","kind":"stop","target":"automation-worker","scope":"process","rate":{"value":1,"per":"day","source":"a-planning-rates"},"description":"A worker stops responding and later resumes with the lease it held.","modelling":"exercised"},
    {"id":"fm-revocation-notice-lost","name":"A revocation notice is lost","kind":"loss","target":"arc-identity-publishes-revocation","scope":"instance","rate":{"value":1,"per":"week","source":"a-planning-rates"},"description":"A gateway instance does not hear that a session was revoked.","modelling":"exercised"},
    {"id":"fm-purge-lost","name":"A purge is lost","kind":"loss","target":"runtime-calls-network-control","scope":"provider","rate":{"value":1,"per":"week","source":"a-planning-rates"},"description":"A purge call does not reach the content delivery network.","modelling":"exercised"},
    {"id":"fm-provisioning-step-fails","name":"A provisioning step fails","kind":"dependency-outage","target":"control-plane","scope":"instance","rate":{"value":1,"per":"month","source":"a-planning-rates"},"description":"Creating the database, applying the layout or installing the template fails.","modelling":"exercised"},
    {"id":"fm-provider-outage","name":"An identity provider is unreachable","kind":"dependency-outage","target":"external-identity-provider","scope":"provider","rate":{"value":2,"per":"year","source":"a-planning-rates"},"description":"A tenant's identity provider does not answer.","modelling":"exercised"},
    {"id":"fm-runtime-crash","name":"The runtime crashes between commit and publication","kind":"crash","target":"runtime","scope":"process","rate":{"value":1,"per":"month","source":"a-planning-rates"},"description":"A process stops after a transaction commits and before its events are published.","modelling":"exercised"},
    {"id":"fm-identity-outage","name":"The identity service does not answer","kind":"dependency-outage","target":"identity-service","scope":"zone","rate":{"value":2,"per":"year","source":"a-planning-rates"},"description":"Session lookups and sign-in flows get no answer.","modelling":"exercised"},
    {"id":"fm-control-database-outage","name":"The control database cannot be read","kind":"dependency-outage","target":"control-database","scope":"zone","rate":{"value":1,"per":"year","source":"a-planning-rates"},"description":"The tenant directory and the wake index cannot be read.","modelling":"not-modelled","modellingNote":"No behaviour model has the directory or the wake index; ARC-500 and D-528 answer it with directory copies served for 15 minutes."},
    {"id":"fm-database-failover","name":"A tenant database fails over mid-transaction","kind":"crash","target":"tenant-database","scope":"zone","rate":{"value":2,"per":"year","source":"a-planning-rates"},"description":"A tenant database fails over to its standby while a transaction is open.","modelling":"not-modelled","modellingNote":"No behaviour model has the standby; the commit models assume a-database-commit."},
    {"id":"fm-clock-step-back","name":"A component's clock steps backwards","kind":"clock-skew","target":"gateway","scope":"instance","rate":{"value":1,"per":"year","source":"a-planning-rates"},"description":"A component's wall clock steps backwards by more than the skew of its environment.","modelling":"not-modelled","modellingNote":"Ticks are logical time and no model has a clock that can step back; a-clock-skew bounds the skew instead."},
    {"id":"fm-cdn-outage","name":"The content delivery network is unavailable","kind":"dependency-outage","target":"delivery-network","scope":"provider","rate":{"value":1,"per":"year","source":"a-planning-rates"},"description":"Page renders fall through to the origin and add to its load.","modelling":"not-modelled","modellingNote":"No behaviour model has the fall-through of renders to the origin; the edge copy flow models the purge and the lifetime only."},
    {"id":"fm-mail-outage","name":"The mail service does not deliver","kind":"dependency-outage","target":"mail-service","scope":"provider","rate":{"value":4,"per":"year","source":"a-planning-rates"},"description":"Mail cannot be handed to the mail service.","modelling":"exercised"},
    {"id":"fm-key-service-outage","name":"The key service cannot unwrap keys","kind":"dependency-outage","target":"key-service","scope":"zone","rate":{"value":1,"per":"year","source":"a-planning-rates"},"description":"Wrapped tenant data keys cannot be unwrapped.","modelling":"not-modelled","modellingNote":"No behaviour model has the unwrapping of tenant keys."},
    {"id":"fm-poison-event","name":"A committed event keeps failing to publish","kind":"other","target":"runtime","scope":"instance","rate":{"value":1,"per":"month","source":"a-planning-rates"},"description":"Publication of one committed event is refused on every attempt.","modelling":"not-modelled","modellingNote":"No behaviour model has the retry and park of a failing event."},
    {"id":"fm-trigger-loop","name":"Events create jobs that create events","kind":"other","target":"automation-worker","scope":"instance","rate":{"value":1,"per":"month","source":"a-planning-rates"},"description":"A trigger's job creates an event that starts the trigger again.","modelling":"exercised"},
    {"id":"fm-automation-worker-partition","name":"An automation worker cannot reach its tenant database","kind":"partition","target":"automation-worker","scope":"instance","rate":{"value":1,"per":"month","source":"a-planning-rates"},"description":"An automation worker instance is cut off from a tenant database it leases work from.","modelling":"exercised"},
    {"id":"fm-bad-deploy","name":"A new version fails under real traffic","kind":"other","target":"runtime","scope":"zone","rate":{"value":4,"per":"year","source":"a-planning-rates"},"description":"A version that passes its health check fails when it takes real traffic.","modelling":"not-modelled","modellingNote":"The colour switch flow models verification and switch back, not a version that fails under real traffic."},
    {"id":"fm-bad-layout-change","name":"A layout change fails on some tenants","kind":"partial-apply","target":"tenant-database","scope":"instance","rate":{"value":1,"per":"month","source":"a-planning-rates"},"description":"A layout change fails on some tenant databases and succeeds on others.","modelling":"not-modelled","modellingNote":"The migration flow models one run over one tenant, not the waves of a layout change over many."},
    {"id":"fm-disk-full","name":"A tenant database volume is full","kind":"other","target":"tenant-database","scope":"instance","rate":{"value":4,"per":"year","source":"a-planning-rates"},"description":"The volume of a tenant database has no free space.","modelling":"not-modelled","modellingNote":"No behaviour model has storage capacity."},
    {"id":"fm-certificate-expiry","name":"A tenant domain certificate expires","kind":"other","target":"delivery-network","scope":"provider","rate":{"value":2,"per":"year","source":"a-planning-rates"},"description":"A tenant domain's certificate passes its expiry date unrenewed.","modelling":"not-modelled","modellingNote":"No behaviour model has certificates."},
    {"id":"fm-zone-loss","name":"A zone is lost","kind":"stop","target":"gateway","scope":"zone","rate":{"value":1,"per":"year","source":"a-planning-rates"},"description":"One of the three zones of the cloud profile is lost.","modelling":"not-modelled","modellingNote":"No behaviour model has zones; the cloud profile requirements (DEP-010) and the recovery drill answer it."},
    {"id":"fm-failed-switch","name":"A colour switch fails at the traffic switch","kind":"dependency-outage","target":"traffic-switch","scope":"zone","rate":{"value":1,"per":"year","source":"a-planning-rates"},"description":"The traffic switch does not apply a colour switch or a switch back that the release controller requested.","modelling":"exercised"},
    {"id":"fm-migration-interrupted","name":"A migration run stops between batches","kind":"crash","target":"automation-worker","scope":"instance","rate":{"value":1,"per":"month","source":"a-planning-rates"},"description":"A worker running a migration run stops after it commits a batch and before it records the next cursor.","modelling":"exercised","modellingNote":"Exercised by a negative, not by a scenario: the fault migration-crash-before-cursor is the stop that violates m-migration-converts-once in the design where a batch and its cursor are not committed together. The scenario migration-interrupted-resumed models the stop as the event mg-interrupted."},
    {"id":"fm-move-copy-fails","name":"A tenant move fails while copying","kind":"partial-apply","target":"tenant-database","scope":"instance","rate":{"value":2,"per":"year","source":"a-planning-rates"},"description":"The copy of a tenant database to its target stops before it is complete.","modelling":"exercised"},
    {"id":"fm-copy-store-outage","name":"The copy store is unreachable","kind":"dependency-outage","target":"copy-store","scope":"zone","rate":{"value":2,"per":"year","source":"a-planning-rates"},"description":"Stored view copies cannot be read or written.","modelling":"not-modelled","modellingNote":"No behaviour model has the copy store; the edge copy flow does not model a read that fails."},
    {"id":"fm-move-concurrent-write","name":"A write reaches a tenant while it is moved","kind":"concurrent-change","target":"tenant-database","scope":"instance","rate":{"value":1,"per":"month","source":"a-planning-rates"},"description":"A writer writes to the source of a move while its copy runs, or just as it is frozen.","modelling":"exercised"}
  ],
  "faultModels": [
    {"id":"fault-model-operations","name":"Operations fault model","environment":"env-cloud","description":"The failures of dependencies, data, load and change that the operations requirements answer. Their rates are planning estimates.","modes":["fm-identity-outage","fm-control-database-outage","fm-database-failover","fm-clock-step-back","fm-cdn-outage","fm-mail-outage","fm-key-service-outage","fm-poison-event","fm-trigger-loop","fm-automation-worker-partition","fm-bad-deploy","fm-bad-layout-change","fm-disk-full","fm-certificate-expiry","fm-zone-loss","fm-migration-interrupted","fm-move-copy-fails","fm-failed-switch","fm-move-concurrent-write"],"bounds":[{"scope":"zone","maxConcurrent":1,"source":"d-23"}]},
    {"id":"fault-model-launch","name":"Launch fault model","environment":"env-cloud","description":"The failures the design is meant to survive in the first cloud profile. Failures outside it, such as the loss of a region, are answered by a restore (NG-4).","modes":["fm-worker-stalls","fm-revocation-notice-lost","fm-purge-lost","fm-provisioning-step-fails","fm-provider-outage","fm-runtime-crash","fm-copy-store-outage","fm-mail-outage","fm-automation-worker-partition"],"bounds":[{"scope":"zone","maxConcurrent":1,"source":"d-23"}]}
  ],

  // ---- Data model: records and the copies made of them -------------------------------------------
  "types": [
    {
      "id": "tenant-id",
      "name": "tenant-id",
      "kind": "id",
      "repr": "string",
      "description": "Lower-case name, [a-z][a-z0-9_]*, at most 64 bytes (kernel TenantId).",
      "constraints": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "maxLength": 64
      }
    },
    {
      "id": "principal-id",
      "name": "principal-id",
      "kind": "id",
      "repr": "string",
      "description": "Assigned by the shell, opaque to the kernel (kernel PrincipalId).",
      "constraints": {
        "pattern": "^[A-Za-z0-9_:.-]+$",
        "maxLength": 96
      }
    },
    {
      "id": "session-id",
      "name": "session-id",
      "kind": "id",
      "repr": "string",
      "description": "The public identifier of a session, never the secret token (kernel SessionId).",
      "constraints": {
        "pattern": "^[A-Za-z0-9_:.-]+$",
        "maxLength": 96
      }
    },
    {
      "id": "object-type-id",
      "name": "object-type-id",
      "kind": "id",
      "repr": "string",
      "description": "An object type within a tenant (kernel ObjectTypeId).",
      "constraints": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "maxLength": 64
      },
      "metamodel": "object-id"
    },
    {
      "id": "workflow-id",
      "name": "workflow-id",
      "kind": "id",
      "repr": "string",
      "description": "A workflow of a tenant (kernel WorkflowId).",
      "constraints": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "maxLength": 64
      }
    },
    {"id":"record-id","name":"record-id","kind":"id","repr":"u64","description":"Allocated from the tenant counter (kernel RecordId)."},
    {"id":"placement-id","name":"placement-id","kind":"id","repr":"uuid"},
    {"id":"credential-id","name":"credential-id","kind":"id","repr":"uuid"},
    {"id":"link-id","name":"link-id","kind":"id","repr":"uuid"},
    {"id":"provider-id","name":"provider-id","kind":"id","repr":"uuid"},
    {"id":"challenge-id","name":"challenge-id","kind":"id","repr":"uuid"},
    {"id":"grant-id","name":"grant-id","kind":"id","repr":"uuid"},
    {"id":"job-id","name":"job-id","kind":"id","repr":"uuid"},
    {"id":"schedule-id","name":"schedule-id","kind":"id","repr":"uuid"},
    {"id":"run-id","name":"run-id","kind":"id","repr":"uuid"},
    {"id":"proposal-id","name":"proposal-id","kind":"id","repr":"uuid"},
    {"id":"submission-id","name":"submission-id","kind":"id","repr":"uuid"},
    {"id":"conversation-id","name":"conversation-id","kind":"id","repr":"uuid"},
    {"id":"turn-id","name":"turn-id","kind":"id","repr":"uuid"},
    {"id":"pending-id","name":"pending-id","kind":"id","repr":"uuid"},
    {"id":"consent-id","name":"consent-id","kind":"id","repr":"uuid"},
    {"id":"visitor-id","name":"visitor-id","kind":"id","repr":"uuid"},
    {"id":"log-id","name":"log-id","kind":"id","repr":"uuid"},
    {"id":"request-id","name":"request-id","kind":"id","repr":"uuid"},
    {"id":"key-id","name":"key-id","kind":"id","repr":"uuid"},
    {"id":"subprocessor-id","name":"subprocessor-id","kind":"id","repr":"uuid"},
    {"id":"hold-id","name":"hold-id","kind":"id","repr":"uuid"},
    {"id":"message-id","name":"message-id","kind":"id","repr":"uuid"},
    {"id":"release-id","name":"release-id","kind":"id","repr":"uuid"},
    {"id":"move-id","name":"move-id","kind":"id","repr":"uuid"},
    {"id":"correlation-id","name":"correlation-id","kind":"id","repr":"uuid"},
    {"id":"identifier","name":"identifier","kind":"id","repr":"uuid"},
    {"id":"cluster-id","name":"cluster-id","kind":"id","repr":"string"},
    {"id":"region-id","name":"region-id","kind":"id","repr":"string"},
    {"id":"database-id","name":"database-id","kind":"id","repr":"string"},
    {"id":"plan-id","name":"plan-id","kind":"id","repr":"string"},
    {"id":"form-id","name":"form-id","kind":"id","repr":"string"},
    {"id":"template-id","name":"template-id","kind":"id","repr":"string"},
    {"id":"environment-id","name":"environment-id","kind":"id","repr":"string"},
    {"id":"colour-id","name":"colour-id","kind":"id","repr":"string"},
    {"id":"migration-id","name":"migration-id","kind":"id","repr":"string"},
    {"id":"host","name":"host","kind":"scalar","repr":"string"},
    {"id":"display-name","name":"display-name","kind":"scalar","repr":"string"},
    {"id":"email-address","name":"email-address","kind":"scalar","repr":"string"},
    {"id":"hash","name":"hash","kind":"scalar","repr":"string","description":"A hash in text form, as the storage layer holds token hashes."},
    {"id":"external-subject","name":"external-subject","kind":"scalar","repr":"string"},
    {"id":"url","name":"url","kind":"scalar","repr":"string"},
    {"id":"domain","name":"domain","kind":"scalar","repr":"string"},
    {"id":"ip-address","name":"ip-address","kind":"scalar","repr":"string"},
    {"id":"address-text","name":"address-text","kind":"scalar","repr":"string"},
    {"id":"text","name":"text","kind":"scalar","repr":"string","description":"Free text."},
    {"id":"reference","name":"reference","kind":"scalar","repr":"string","description":"A reference to a record or a copy, in text form."},
    {
      "id": "wrapped-secret",
      "name": "wrapped-secret",
      "kind": "scalar",
      "repr": "bytes",
      "description": "A secret wrapped by the key service.",
      "sensitive": "secret"
    },
    {
      "id": "secret",
      "name": "secret",
      "kind": "scalar",
      "repr": "bytes",
      "description": "A sealed secret.",
      "sensitive": "secret"
    },
    {"id":"expression","name":"expression","kind":"scalar","repr":"string"},
    {
      "id": "value-map",
      "name": "value-map",
      "kind": "scalar",
      "repr": "string",
      "description": "A map of field values as JSON text.",
      "metamodel": "values"
    },
    {"id":"change-set","name":"change-set","kind":"scalar","repr":"string","description":"A set of changes as JSON text."},
    {"id":"structured-blocks","name":"structured-blocks","kind":"scalar","repr":"string","description":"Structured content blocks as JSON text."},
    {"id":"recurrence","name":"recurrence","kind":"scalar","repr":"string","description":"A recurrence rule."},
    {"id":"workflow-state","name":"workflow-state","kind":"scalar","repr":"string","description":"The state a tenant workflow gives a record; tenant-defined."},
    {"id":"tenant-lifecycle","name":"tenant-state","kind":"enum","values":["provisioning","active","suspended"]},
    {"id":"principal-state","name":"principal-state","kind":"enum","values":["active","suspended","erased"]},
    {"id":"certificate-state","name":"certificate-state","kind":"enum","values":["pending","valid","expired"]},
    {"id":"domain-state","name":"domain-state","kind":"enum","values":["pending","proved"]},
    {"id":"job-state","name":"job-state","kind":"enum","values":[
        "waiting",
        "leased",
        "completed",
        "failed",
        "cancelled",
        "unscheduled"
      ]},
    {"id":"run-state","name":"run-state","kind":"enum","values":[
        "running",
        "completed",
        "failed",
        "cancelled",
        "compensating",
        "awaiting-approval"
      ]},
    {"id":"proposal-state","name":"proposal-state","kind":"enum","values":["projecting","awaiting-approval","cleared","rejected","applied"]},
    {"id":"message-state","name":"message-state","kind":"enum","values":[
        "queued",
        "submitted",
        "sent",
        "failed",
        "discarded"
      ]},
    {"id":"release-state","name":"release-state","kind":"enum","values":["candidate","staged","live","rolled-back"]},
    {"id":"migration-state","name":"migration-state","kind":"enum","values":["not-started","running","stopped","complete"]},
    {"id":"move-state","name":"move-state","kind":"enum","values":["source-serves","copying","frozen","verified","target-serves"]},
    {"id":"principal-kind","name":"principal-kind","kind":"enum","values":["person","service","agent"]},
    {"id":"credential-kind","name":"credential-kind","kind":"enum","values":["password","passkey","totp"]},
    {"id":"provider-protocol","name":"provider-protocol","kind":"enum","values":["oidc","saml"]},
    {"id":"challenge-kind","name":"challenge-kind","kind":"enum","values":["link","oidc","saml"]},
    {"id":"conversation-state","name":"conversation-state","kind":"enum","values":["open","closed"]},
    {"id":"turn-state","name":"turn-state","kind":"enum","values":["streaming","complete","interrupted","failed"]},
    {"id":"pending-action-state","name":"pending-action-state","kind":"enum","values":["previewed","confirmed","applied","cancelled","refused"]},
    {"id":"consent-decision","name":"consent-decision","kind":"enum","values":["granted","refused","withdrawn"]},
    {"id":"signal-kind","name":"signal-kind","kind":"enum","values":["log","span","metric"]},
    {"id":"job-attempt-outcome","name":"job-attempt-outcome","kind":"enum","values":["completed","failed","cancelled"]},
    {"id":"subject-key-state","name":"subject-key-state","kind":"enum","values":["live","destroyed"]},
    {"id":"suppression-reason","name":"suppression-reason","kind":"enum","values":["bounce","complaint","unsubscribe"]},
    {"id":"rollback-class","name":"rollback-class","kind":"enum","values":["rollback-safe","roll-forward-only"]},
    {"id":"environment-kind","name":"environment-kind","kind":"enum","values":["stage","production"]},
    {"id":"access-report","name":"Access Report","kind":"struct","fields":[{"name":"tenant","type":"tenant-id"},{"name":"grants","type":"list<grant-id>"},{"name":"generated-at","type":"timestamp"}],"description":"The grants made to the data of a tenant."},
    {"id":"account","name":"Account","kind":"struct","fields":[{"name":"tenant","type":"tenant-id"},{"name":"login","type":"string"},{"name":"principal","type":"principal-id"},{"name":"display-name","type":"string"},{"name":"password-hash","type":"hash"}],"description":"strata_storage_api::Account: a locally managed login."},
    {"id":"action-preview","name":"Action Preview","kind":"struct","fields":[{"name":"pending","type":"pending-id"},{"name":"creates","type":"list<record-id>"},{"name":"changes","type":"list<record-id>"},{"name":"removes","type":"list<record-id>"},{"name":"views","type":"list<string>"},{"name":"preview-hash","type":"hash"},{"name":"valid-until","type":"timestamp"}],"description":"The preview of a pending action."},
    {"id":"adapter-capabilities","name":"Adapter Capabilities","kind":"struct","fields":[{"name":"adapter","type":"string"},{"name":"durable","type":"bool"},{"name":"isolation","type":"string"},{"name":"read-consistency","type":"string"},{"name":"notes","type":"list<string>"}],"description":"strata_storage_api::Capabilities: what an adapter actually provides."},
    {"id":"adapter-health","name":"Adapter Health","kind":"struct","fields":[{"name":"ok","type":"bool"},{"name":"detail","type":"string"},{"name":"tenants","type":"u64"},{"name":"outbox-pending","type":"u64"}],"description":"strata_storage_api::Health."},
    {"id":"agent-entry","name":"Agent Entry","kind":"struct","fields":[{"name":"agent","type":"principal-id"},{"name":"owner","type":"principal-id"},{"name":"purpose","type":"string"},{"name":"scopes","type":"list<string>"},{"name":"tier","type":"string"}],"description":"One agent of the registry."},
    {
      "id": "api-error",
      "name": "Api Error",
      "kind": "struct",
      "fields": [
        {
          "name": "code",
          "type": "error-code"
        },
        {
          "name": "message",
          "type": "string"
        },
        {
          "name": "kind",
          "type": "string",
          "optional": true
        },
        {
          "name": "failed",
          "type": "list<check>",
          "optional": true
        },
        {
          "name": "correlation",
          "type": "string"
        }
      ],
      "description": "strata_protocol::api::ErrorReply: the error body of every HTTP operation (system.generation.errorBody). kind and failed are left out when absent, and the correlation is the request's correlation id as given."
    },
    {"id":"archive-manifest","name":"Archive Manifest","kind":"struct","fields":[{"name":"files","type":"list<string>"},{"name":"hashes","type":"list<hash>"},{"name":"not-carried","type":"list<string>"}],"description":"The manifest of an archive."},
    {"id":"archive-ref","name":"Archive Ref","kind":"id","repr":"string","description":"A reference to an archive document produced by an export."},
    {"id":"audit-entry","name":"Audit Entry","kind":"struct","fields":[{"name":"seq","type":"u64"},{"name":"actor","type":"principal-id"},{"name":"on-behalf-of","type":"principal-id","optional":true},{"name":"action","type":"string"},{"name":"outcome","type":"string"},{"name":"correlation","type":"correlation-id"},{"name":"previous-hash","type":"hash"}],"description":"One entry of the hash-chained audit log."},
    {"id":"changelog-entry","name":"Changelog Entry","kind":"struct","fields":[{"name":"version","type":"string"},{"name":"description","type":"string"},{"name":"at","type":"timestamp"}],"description":"One entry of the changelog."},
    {"id":"commit","name":"Commit","kind":"struct","fields":[{"name":"delta","type":"state-delta"},{"name":"events","type":"list<domain-event>"},{"name":"journal","type":"journal-entry"},{"name":"revoke-sessions","type":"list<principal-id>"}],"description":"strata_storage_api::Commit: everything one accepted transition writes, applied atomically."},
    {"id":"copy-key","name":"Copy Key","kind":"scalar","repr":"string","description":"The key of a stored copy; it begins with the tenant identifier."},
    {"id":"deletion-certificate","name":"Deletion Certificate","kind":"struct","fields":[{"name":"tenant","type":"tenant-id"},{"name":"key-destroyed-at","type":"timestamp"},{"name":"images-removed","type":"list<timestamp>"}],"description":"The certificate of a tenant deletion."},
    {"id":"desk-article","name":"Desk Article","kind":"struct","fields":[{"name":"article-id","type":"record-id"},{"name":"version","type":"u64"},{"name":"title","type":"string"},{"name":"slug","type":"string"},{"name":"body","type":"string"},{"name":"status","type":"string"}],"description":"One article as the writing desk lists it: the identifier and version a change names, the fields a save repeats, and whether it is a draft or published."},
    {"id":"publication-fields","name":"Publication Fields","kind":"struct","fields":[{"name":"key","type":"string"},{"name":"name","type":"string"},{"name":"tagline","type":"string","optional":true},{"name":"about","type":"string","optional":true},{"name":"colophon","type":"string","optional":true},{"name":"accent","type":"string"},{"name":"paper","type":"string"}],"description":"The fields of the publication record as the BFF projects them (object publication of the tenant template), under the names the JSON uses."},
    {"id":"author-fields","name":"Author Fields","kind":"struct","fields":[{"name":"name","type":"string"},{"name":"slug","type":"string"},{"name":"title","type":"string","optional":true},{"name":"bio","type":"string","optional":true},{"name":"principal","type":"string","optional":true}],"description":"The fields of an author record as the BFF projects them (object author)."},
    {"id":"category-fields","name":"Category Fields","kind":"struct","fields":[{"name":"name","type":"string"},{"name":"slug","type":"string"},{"name":"description","type":"string","optional":true}],"description":"The fields of a topic record as the BFF projects them (object category)."},
    {"id":"post-fields","name":"Post Fields","kind":"struct","fields":[{"name":"title","type":"string"},{"name":"slug","type":"string"},{"name":"excerpt","type":"string","optional":true},{"name":"body","type":"string"},{"name":"author","type":"record-id"},{"name":"category","type":"record-id","optional":true},{"name":"tags","type":"list<string>","optional":true},{"name":"status","type":"string"},{"name":"featured","type":"bool","optional":true},{"name":"published-at","type":"timestamp","optional":true},{"name":"cover","type":"string","optional":true},{"name":"cover-alt","type":"string","optional":true}],"description":"The fields of an article record as the BFF projects them (object post). The specification names them in kebab-case like every other field; on the wire they are snake_case (published_at, cover_alt), as system.generation.wireCase says."},
    {"id":"author-record","name":"Author Record","kind":"struct","fields":[{"name":"id","type":"record-id"},{"name":"object","type":"string"},{"name":"version","type":"u64"},{"name":"created-at","type":"timestamp"},{"name":"updated-at","type":"timestamp"},{"name":"created-by","type":"principal-id","optional":true},{"name":"fields","type":"author-fields"}],"description":"An author record included in an article row (refs.author): the projection of a record without refs or blocks of its own (substrate project_record)."},
    {"id":"category-record","name":"Category Record","kind":"struct","fields":[{"name":"id","type":"record-id"},{"name":"object","type":"string"},{"name":"version","type":"u64"},{"name":"created-at","type":"timestamp"},{"name":"updated-at","type":"timestamp"},{"name":"created-by","type":"principal-id","optional":true},{"name":"fields","type":"category-fields"}],"description":"A topic record included in an article row (refs.category)."},
    {"id":"post-refs","name":"Post Refs","kind":"struct","fields":[{"name":"author","type":"author-record","optional":true},{"name":"category","type":"category-record","optional":true}],"description":"The records an article row includes through its reference fields (the view definition includes author and category); each is absent when the reference is empty."},
    {"id":"publication-row","name":"Publication Row","kind":"struct","fields":[{"name":"id","type":"record-id"},{"name":"object","type":"string"},{"name":"version","type":"u64"},{"name":"created-at","type":"timestamp"},{"name":"updated-at","type":"timestamp"},{"name":"created-by","type":"principal-id","optional":true},{"name":"fields","type":"publication-fields"},{"name":"refs","type":"json"},{"name":"blocks","type":"json","optional":true},{"name":"reading-minutes","type":"u32","optional":true}],"description":"One publication record as a view section holds it (substrate project_row): the record members, refs (an empty object here), blocks of its markdown fields and reading_minutes when it has any."},
    {"id":"author-row","name":"Author Row","kind":"struct","fields":[{"name":"id","type":"record-id"},{"name":"object","type":"string"},{"name":"version","type":"u64"},{"name":"created-at","type":"timestamp"},{"name":"updated-at","type":"timestamp"},{"name":"created-by","type":"principal-id","optional":true},{"name":"fields","type":"author-fields"},{"name":"refs","type":"json"},{"name":"blocks","type":"json","optional":true},{"name":"reading-minutes","type":"u32","optional":true}],"description":"One author record as a view section holds it; the markdown field bio is in blocks."},
    {"id":"category-row","name":"Category Row","kind":"struct","fields":[{"name":"id","type":"record-id"},{"name":"object","type":"string"},{"name":"version","type":"u64"},{"name":"created-at","type":"timestamp"},{"name":"updated-at","type":"timestamp"},{"name":"created-by","type":"principal-id","optional":true},{"name":"fields","type":"category-fields"},{"name":"refs","type":"json"},{"name":"blocks","type":"json","optional":true},{"name":"reading-minutes","type":"u32","optional":true}],"description":"One topic record as a view section holds it."},
    {"id":"post-row","name":"Post Row","kind":"struct","fields":[{"name":"id","type":"record-id"},{"name":"object","type":"string"},{"name":"version","type":"u64"},{"name":"created-at","type":"timestamp"},{"name":"updated-at","type":"timestamp"},{"name":"created-by","type":"principal-id","optional":true},{"name":"fields","type":"post-fields"},{"name":"refs","type":"post-refs"},{"name":"blocks","type":"json","optional":true},{"name":"reading-minutes","type":"u32","optional":true}],"description":"One article record as a view section holds it: its fields, the author and the topic it refers to (refs), and the blocks of its body with the reading time."},
    {"id":"view-theme","name":"View Theme","kind":"struct","fields":[{"name":"accent","type":"string"},{"name":"paper","type":"string"}],"description":"The resolved theme of a view: the accent and paper names the publication settings give, or the defaults when a setting is not one of the theme tokens."},
    {"id":"option-choice","name":"Option Choice","kind":"struct","fields":[{"name":"value","type":"string"},{"name":"label","type":"string"}],"description":"One entry of a choice control: the value the form submits and the label it shows."},
    {"id":"front-page-data","name":"Front Page Data","kind":"struct","fields":[{"name":"site","type":"publication-row","optional":true},{"name":"featured","type":"post-row","optional":true},{"name":"recent","type":"list<post-row>"},{"name":"categories","type":"list<category-row>"}],"description":"The sections of the front page view: the publication, the featured article, the recent articles and the topics."},
    {"id":"article-page-data","name":"Article Page Data","kind":"struct","fields":[{"name":"site","type":"publication-row","optional":true},{"name":"post","type":"post-row","optional":true},{"name":"recent","type":"list<post-row>"}],"description":"The sections of an article view: the publication, the article with this address (null when none) and the recent articles."},
    {"id":"topics-page-data","name":"Topics Page Data","kind":"struct","fields":[{"name":"site","type":"publication-row","optional":true},{"name":"categories","type":"list<category-row>"},{"name":"recent","type":"list<post-row>"}],"description":"The sections of the topic index view."},
    {"id":"topic-page-data","name":"Topic Page Data","kind":"struct","fields":[{"name":"site","type":"publication-row","optional":true},{"name":"category","type":"category-row","optional":true},{"name":"posts","type":"list<post-row>"},{"name":"categories","type":"list<category-row>"}],"description":"The sections of a topic view."},
    {"id":"authors-page-data","name":"Authors Page Data","kind":"struct","fields":[{"name":"site","type":"publication-row","optional":true},{"name":"authors","type":"list<author-row>"}],"description":"The sections of the author index view."},
    {"id":"author-page-data","name":"Author Page Data","kind":"struct","fields":[{"name":"site","type":"publication-row","optional":true},{"name":"author","type":"author-row","optional":true},{"name":"posts","type":"list<post-row>"}],"description":"The sections of an author view."},
    {"id":"search-page-data","name":"Search Page Data","kind":"struct","fields":[{"name":"site","type":"publication-row","optional":true},{"name":"results","type":"list<post-row>"}],"description":"The sections of the search view."},
    {"id":"about-page-data","name":"About Page Data","kind":"struct","fields":[{"name":"site","type":"publication-row","optional":true},{"name":"authors","type":"list<author-row>"}],"description":"The sections of the about view; the markdown fields about and colophon of the publication are in its blocks."},
    {"id":"site-page-data","name":"Site Page Data","kind":"struct","fields":[{"name":"site","type":"publication-row","optional":true}],"description":"The sections of a view that holds the publication alone (sign in, settings, the impact lab)."},
    {"id":"desk-page-data","name":"Desk Page Data","kind":"struct","fields":[{"name":"site","type":"publication-row","optional":true},{"name":"posts","type":"list<post-row>"}],"description":"The sections of the writing desk view."},
    {"id":"new-article-page-data","name":"New Article Page Data","kind":"struct","fields":[{"name":"site","type":"publication-row","optional":true},{"name":"categories","type":"list<category-row>"},{"name":"authors","type":"list<author-row>"}],"description":"The sections of the view for a new article."},
    {"id":"edit-article-page-data","name":"Edit Article Page Data","kind":"struct","fields":[{"name":"site","type":"publication-row","optional":true},{"name":"post","type":"post-row","optional":true},{"name":"categories","type":"list<category-row>"},{"name":"authors","type":"list<author-row>"}],"description":"The sections of the view for editing an article."},
    {"id":"domain-binding","name":"Domain Binding","kind":"struct","fields":[{"name":"host","type":"host"},{"name":"tenant","type":"tenant-id"},{"name":"certificate-state","type":"certificate-state"}],"description":"A domain name bound to a tenant."},
    {"id":"erasure-receipt","name":"Erasure Receipt","kind":"struct","fields":[{"name":"principal","type":"principal-id"},{"name":"records","type":"list<record-id>"},{"name":"at","type":"timestamp"}],"description":"The receipt of an erasure."},
    {
      "id": "error-code",
      "name": "Error Code",
      "kind": "enum",
      "values": [
        "unauthenticated",
        "forbidden",
        "not_found",
        "conflict",
        "invalid",
        "throttled",
        "unavailable",
        "internal"
      ],
      "description": "strata_protocol::api::ErrorCode, as it is written on the wire (snake_case); each has one HTTP status, the one system.generation.errorKinds gives the error kind of the same name."
    },
    {"id":"event-stream","name":"Event Stream","kind":"struct","fields":[{"name":"tenant","type":"tenant-id"},{"name":"position","type":"u64"}],"description":"A stream of notices, resumable from a position; a notice never carries record contents."},
    {"id":"executed-intent","name":"Executed Intent","kind":"struct","fields":[{"name":"transition","type":"transition-result"},{"name":"receipt","type":"receipt"},{"name":"conflicts","type":"u32"}],"description":"strata_storage_api::Executed."},
    {"id":"field-difference","name":"Field Difference","kind":"struct","fields":[{"name":"field","type":"string"},{"name":"draft","type":"string"},{"name":"published","type":"string"}],"description":"One field that differs between a draft and its published version."},
    {"id":"html-page","name":"Html Page","kind":"scalar","repr":"string","description":"A complete HTML document."},
    {"id":"identity-assertion","name":"Identity Assertion","kind":"struct","fields":[{"name":"tenant","type":"tenant-id"},{"name":"principal","type":"principal-id"},{"name":"session","type":"session-id"},{"name":"roles","type":"list<string>"},{"name":"authenticated-at","type":"timestamp"},{"name":"expires-at","type":"timestamp"},{"name":"signature","type":"bytes"}],"description":"An assertion signed by the identity service about one session."},
    {"id":"inbox-notice","name":"Inbox Notice","kind":"struct","fields":[{"name":"id","type":"string"},{"name":"kind","type":"string"},{"name":"body","type":"value-map"},{"name":"at","type":"timestamp"},{"name":"read","type":"bool"}],"description":"One notice of an inbox."},
    {"id":"job-outcome","name":"Job Outcome","kind":"enum","values":["succeeded","failed"],"description":"The outcome a worker reports for one attempt."},
    {"id":"job-summary","name":"Job Summary","kind":"struct","fields":[{"name":"job","type":"job-id"},{"name":"state","type":"job-state"},{"name":"due-at","type":"timestamp"},{"name":"attempts","type":"u32"},{"name":"errors","type":"list<string>"}],"description":"A job as the catalogue lists it."},
    {"id":"journal-entry","name":"Journal Entry","kind":"struct","fields":[{"name":"tenant","type":"tenant-id"},{"name":"base-revision","type":"state-revision","optional":true},{"name":"revision","type":"state-revision"},{"name":"kernel-version","type":"string"},{"name":"intent","type":"intent"},{"name":"context","type":"context"},{"name":"delta-hash","type":"hash"},{"name":"events-hash","type":"hash"}],"description":"strata_storage_api::JournalEntry: one accepted transition as decided, enough to run it again."},
    {"id":"journal-replay","name":"Journal Replay","kind":"struct","fields":[{"name":"tenant","type":"tenant-id"},{"name":"entries","type":"u64"},{"name":"agreed","type":"u64"},{"name":"first-mismatch","type":"string","optional":true},{"name":"replayed-hash","type":"hash"},{"name":"live-hash","type":"hash"},{"name":"matches-live","type":"bool"},{"name":"other-kernel-versions","type":"list<string>"}],"description":"strata_simulation::journal::JournalReplay."},
    {"id":"layout-outcome","name":"Layout Outcome","kind":"struct","fields":[{"name":"tenant","type":"tenant-id"},{"name":"applied","type":"bool"},{"name":"error","type":"string","optional":true}],"description":"The outcome of a layout change for one tenant."},
    {"id":"layout-phase","name":"Layout Phase","kind":"enum","values":["expanding","contracting"],"description":"The phases of a storage layout change."},
    {"id":"mail-log-entry","name":"Mail Log Entry","kind":"struct","fields":[{"name":"message","type":"message-id"},{"name":"recipient","type":"email-address"},{"name":"state","type":"message-state"},{"name":"at","type":"timestamp"}],"description":"One entry of the mail log."},
    {"id":"mapping-report","name":"Mapping Report","kind":"struct","fields":[{"name":"mappings","type":"list<string>"},{"name":"unmapped","type":"list<string>"}],"description":"What an import mapped and could not map."},
    {"id":"migration-plan","name":"Migration Plan","kind":"struct","fields":[{"name":"schema","type":"tenant-schema"},{"name":"summary","type":"list<string>"},{"name":"rewritten","type":"list<record>"},{"name":"violations","type":"list<violation>"}],"description":"strata_kernel::Migration: what schema changes would do."},
    {"id":"model-usage","name":"Model Usage","kind":"struct","fields":[{"name":"input-tokens","type":"u64"},{"name":"output-tokens","type":"u64"}],"description":"What a model request used."},
    {"id":"notice","name":"Notice","kind":"struct","fields":[{"name":"tenant","type":"tenant-id"},{"name":"id","type":"string"},{"name":"kind","type":"string"},{"name":"seq","type":"u64","optional":true}],"description":"A tenant-scoped notice: a reference to an event, a wake notice or a revocation."},
    {"id":"operation-entry","name":"Operation Entry","kind":"struct","fields":[{"name":"name","type":"string"},{"name":"version","type":"string"},{"name":"deprecation","type":"string"},{"name":"requirements","type":"list<string>"},{"name":"permitted","type":"bool"},{"name":"description","type":"string"}],"description":"One entry of the operation catalogue."},
    {"id":"operation-result","name":"Operation Result","kind":"struct","fields":[{"name":"state","type":"string"},{"name":"output","type":"value-map"},{"name":"changes","type":"list<string>"},{"name":"inverse","type":"string","optional":true},{"name":"checks","type":"list<check>"},{"name":"handle","type":"string","optional":true}],"description":"The result of invoking an operation."},
    {
      "id": "outbox-entry",
      "name": "Outbox Entry",
      "kind": "struct",
      "fields": [
        {
          "name": "position",
          "type": "u64"
        },
        {
          "name": "event",
          "type": "domain-event"
        }
      ],
      "description": "strata_storage_api::OutboxEntry: an event waiting to be handed to subscribers. position is per tenant (the tenant of the event), increasing in that tenant's commit order; the outboxes of different tenants are not ordered against each other."
    },
    {"id":"platform-description","name":"Platform Description","kind":"struct","fields":[{"name":"components","type":"list<string>"},{"name":"health","type":"value-map"},{"name":"configuration","type":"value-map"}],"description":"The topology, configuration and health of the platform."},
    {"id":"projection","name":"Projection","kind":"struct","fields":[{"name":"proposal","type":"projection-proposal"},{"name":"baseline-hash","type":"hash"},{"name":"branch-hash","type":"hash"},{"name":"diverged","type":"bool"},{"name":"counterexample","type":"string","optional":true},{"name":"findings","type":"list<string>"},{"name":"unmodelled","type":"list<string>"}],"description":"strata_simulation::project::Projection."},
    {"id":"projection-proposal","name":"Projection Proposal","kind":"struct","fields":[{"name":"tenant","type":"tenant-id"},{"name":"principal","type":"principal"},{"name":"changes","type":"list<schema-change>"},{"name":"existing-data","type":"existing-data"},{"name":"before-step","type":"u64"}],"description":"strata_simulation::project::Proposal."},
    {"id":"projection-summary","name":"Projection Summary","kind":"struct","fields":[{"name":"diverged","type":"bool"},{"name":"summary","type":"list<string>"},{"name":"first-difference","type":"string","optional":true}],"description":"A projection as an operation reports it."},
    {"id":"public-key","name":"Public Key","kind":"struct","fields":[{"name":"id","type":"key-id"},{"name":"algorithm","type":"string"},{"name":"key","type":"bytes"}],"description":"A published signing key."},
    {"id":"realm-policy","name":"Realm Policy","kind":"struct","fields":[{"name":"second-factor-required","type":"bool"},{"name":"password-sign-in","type":"bool"},{"name":"bound-domains","type":"list<domain>"},{"name":"create-on-first-sign-in","type":"bool"},{"name":"default-role","type":"string","optional":true}],"description":"The sign-in policy of a realm."},
    {
      "id": "receipt",
      "name": "Receipt",
      "kind": "struct",
      "fields": [
        {
          "name": "revision",
          "type": "state-revision"
        },
        {
          "name": "last-position",
          "type": "u64",
          "optional": true
        }
      ],
      "description": "strata_storage_api::Receipt. last-position is the outbox position, in the tenant's own outbox, of the last event written."
    },
    {"id":"record-version","name":"Record Version","kind":"struct","fields":[{"name":"version","type":"u64"},{"name":"at","type":"timestamp"},{"name":"author","type":"principal-id"}],"description":"One published version of a record."},
    {"id":"requirement-status","name":"Requirement Status","kind":"struct","fields":[{"name":"ref","type":"string"},{"name":"status","type":"string"},{"name":"evidence","type":"string","optional":true}],"description":"The verification status of one requirement."},
    {"id":"run-trace","name":"Run Trace","kind":"struct","fields":[{"name":"run","type":"request-id"},{"name":"agent","type":"principal-id"},{"name":"on-behalf-of","type":"principal-id","optional":true},{"name":"inputs","type":"list<string>"},{"name":"operations","type":"list<string>"}],"description":"The trace of one agent run."},
    {"id":"scenario","name":"Scenario","kind":"struct","fields":[{"name":"name","type":"string"},{"name":"seed","type":"u64"},{"name":"initial","type":"value-map"},{"name":"schedule","type":"list<value-map>"},{"name":"faults","type":"value-map"}],"description":"strata_simulation::engine::Scenario."},
    {"id":"schema-version","name":"Schema Version","kind":"id","repr":"u64","description":"The version of a tenant schema."},
    {"id":"scim-user","name":"Scim User","kind":"struct","fields":[{"name":"external-id","type":"string"},{"name":"email","type":"email-address"},{"name":"display-name","type":"display-name"},{"name":"active","type":"bool"}],"description":"A person as the provisioning endpoint exchanges it."},
    {"id":"search-hit","name":"Search Hit","kind":"struct","fields":[{"name":"record","type":"record-id"},{"name":"object","type":"object-type-id"},{"name":"title","type":"string"},{"name":"status","type":"string","optional":true}],"description":"One hit of a search."},
    {"id":"selector","name":"Selector","kind":"struct","fields":[{"name":"objects","type":"list<object-type-id>","optional":true}],"description":"strata_substrate::subscribe::Selector: what a subscriber wants to hear about; absent objects mean every object type."},
    {"id":"session-record","name":"Session Record","kind":"struct","fields":[{"name":"id","type":"session-id"},{"name":"token-hash","type":"hash"},{"name":"csrf-token","type":"secret"},{"name":"tenant","type":"tenant-id"},{"name":"principal","type":"principal-id"},{"name":"display-name","type":"string"},{"name":"created-at","type":"timestamp"},{"name":"last-seen-at","type":"timestamp"},{"name":"expires-at","type":"timestamp"},{"name":"revoked-at","type":"timestamp","optional":true}],"description":"strata_storage_api::SessionRecord: a server-side session; only the hash of its token is stored."},
    {"id":"session-summary","name":"Session Summary","kind":"struct","fields":[{"name":"id","type":"session-id"},{"name":"created-at","type":"timestamp"},{"name":"last-seen-at","type":"timestamp"},{"name":"expires-at","type":"timestamp"},{"name":"current","type":"bool"}],"description":"A session as its owner lists it."},
    {"id":"session-view","name":"Session View","kind":"struct","fields":[{"name":"authenticated","type":"bool"},{"name":"tenant","type":"tenant-id"},{"name":"tenant-name","type":"string"},{"name":"session-id","type":"session-id","optional":true},{"name":"principal","type":"principal-id","optional":true},{"name":"display-name","type":"display-name","optional":true},{"name":"roles","type":"list<string>"},{"name":"csrf-token","type":"secret","optional":true},{"name":"expires-at","type":"timestamp","optional":true},{"name":"may-manage-schema","type":"bool"}],"description":"strata_protocol::api::SessionView: a session as the browser may see it."},
    {"id":"snapshot-info","name":"Snapshot Info","kind":"struct","fields":[{"name":"tenant","type":"tenant-id"},{"name":"id","type":"u64"},{"name":"label","type":"string"},{"name":"revision","type":"state-revision"},{"name":"hash","type":"hash"},{"name":"created-at","type":"timestamp"}],"description":"strata_storage_api::SnapshotInfo."},
    {"id":"spend-entry","name":"Spend Entry","kind":"struct","fields":[{"name":"agent","type":"principal-id","optional":true},{"name":"tenant","type":"tenant-id","optional":true},{"name":"amount","type":"f64"}],"description":"The spend of one agent or tenant."},
    {"id":"state-revision","name":"State Revision","kind":"id","repr":"u64","description":"The revision of a tenant state; each accepted transition advances it by one."},
    {"id":"storage-migration","name":"Storage Migration","kind":"struct","fields":[{"name":"version","type":"u32"},{"name":"name","type":"string"},{"name":"applied-at","type":"timestamp"}],"description":"strata_storage_api::StorageMigration: a step in the layout history of an adapter."},
    {"id":"store-error","name":"Store Error","kind":"struct","fields":[{"name":"kind","type":"store-error-kind"},{"name":"message","type":"string"},{"name":"expected","type":"state-revision","optional":true},{"name":"found","type":"state-revision","optional":true}],"description":"strata_storage_api::StoreError."},
    {"id":"store-error-kind","name":"Store Error Kind","kind":"enum","values":["conflict","not-found","invalid","unavailable","corrupt"],"description":"strata_storage_api::StoreError variants."},
    {"id":"store-handle","name":"Store Handle","kind":"scalar","repr":"string","description":"An opened store of one adapter, held by the process that opened it; it implements the store contract."},
    {"id":"tenant-bundle","name":"Tenant Bundle","kind":"struct","fields":[{"name":"name","type":"string"},{"name":"version","type":"string"},{"name":"content","type":"value-map"}],"description":"substrate::bundle::Bundle: a tenant or a template as one document."},
    {"id":"tenant-directory-entry","name":"Tenant Directory Entry","kind":"struct","fields":[{"name":"tenant","type":"tenant-id"},{"name":"state","type":"tenant-lifecycle"},{"name":"kind","type":"tenant-kind"},{"name":"plan","type":"plan-id"},{"name":"placement","type":"placement-id"},{"name":"region","type":"region-id"},{"name":"fetched-at","type":"timestamp"}],"description":"A directory entry as the gateway holds it."},
    {"id":"tenant-kind","name":"Tenant Kind","kind":"enum","values":["production","staging","sandbox"],"description":"Whether a tenant is production, staging or sandbox."},
    {"id":"tenant-summary","name":"Tenant Summary","kind":"struct","fields":[{"name":"id","type":"tenant-id"},{"name":"name","type":"string"},{"name":"revision","type":"state-revision"},{"name":"schema-version","type":"u64"},{"name":"event-seq","type":"u64"},{"name":"records","type":"u64"}],"description":"strata_storage_api::TenantSummary."},
    {"id":"trace","name":"Trace","kind":"struct","fields":[{"name":"kernel-version","type":"string"},{"name":"scenario","type":"string"},{"name":"seed","type":"u64"},{"name":"final-hash","type":"hash"},{"name":"steps","type":"u64"},{"name":"hash","type":"hash"}],"description":"strata_simulation::engine::Trace."},
    {"id":"usage-count","name":"Usage Count","kind":"struct","fields":[{"name":"quantity","type":"string"},{"name":"count","type":"u64"}],"description":"A metered quantity counted for a period."},
    {
      "id": "view-data",
      "name": "View Data",
      "kind": "struct",
      "fields": [
        {
          "name": "view",
          "type": "view-id"
        },
        {
          "name": "title",
          "type": "string"
        },
        {
          "name": "params",
          "type": "map<string, string>"
        },
        {
          "name": "sections",
          "type": "map<string, section-data>"
        },
        {
          "name": "depends-on",
          "type": "set<object-type-id>"
        },
        {
          "name": "revision",
          "type": "state-revision"
        },
        {
          "name": "schema-version",
          "type": "schema-version"
        }
      ],
      "description": "strata_substrate::project::ViewData: the raw result of a view, what the backend hands the BFF (backend ops.rs view, contract read-view CT-264): the view, its title, the route parameters, each section's data, the object types whose changes can alter it, and the revision and schema version it was read at."
    },
    {"id":"violation","name":"Violation","kind":"struct","fields":[{"name":"object","type":"object-type-id"},{"name":"id","type":"record-id"},{"name":"check","type":"check"},{"name":"kind","type":"error-kind"}],"description":"strata_kernel::Violation: an existing record that does not conform to a proposed schema."},
    {"id":"wake-entry","name":"Wake Entry","kind":"struct","fields":[{"name":"tenant","type":"tenant-id"},{"name":"due-at","type":"timestamp"}],"description":"A wake index entry: a tenant and its next due time, with no content of a job."},
    {"id":"webhook-delivery","name":"Webhook Delivery","kind":"struct","fields":[{"name":"id","type":"string"},{"name":"endpoint","type":"string"},{"name":"status","type":"u16"},{"name":"attempts","type":"u32"},{"name":"at","type":"timestamp"}],"description":"One outbound webhook delivery."},
    {
      "id": "session-token",
      "name": "session-token",
      "kind": "scalar",
      "repr": "string",
      "sensitive": "token",
      "description": "The secret a session cookie carries; only its hash is stored, and it is never logged."
    },
    {
      "id": "field-id",
      "name": "field-id",
      "kind": "id",
      "repr": "string",
      "constraints": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "maxLength": 64
      },
      "description": "kernel FieldId: a field of an object type, [a-z][a-z0-9_]*, at most 64 bytes.",
      "metamodel": "field-id"
    },
    {
      "id": "role-id",
      "name": "role-id",
      "kind": "id",
      "repr": "string",
      "constraints": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "maxLength": 64
      },
      "description": "kernel RoleId: a role of a tenant, [a-z][a-z0-9_]*, at most 64 bytes."
    },
    {
      "id": "policy-id",
      "name": "policy-id",
      "kind": "id",
      "repr": "string",
      "constraints": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "maxLength": 64
      },
      "description": "kernel PolicyId: a policy of a tenant, [a-z][a-z0-9_]*, at most 64 bytes."
    },
    {
      "id": "constraint-id",
      "name": "constraint-id",
      "kind": "id",
      "repr": "string",
      "constraints": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "maxLength": 64
      },
      "description": "kernel ConstraintId: a constraint of an object type, [a-z][a-z0-9_]*, at most 64 bytes."
    },
    {
      "id": "query-id",
      "name": "query-id",
      "kind": "id",
      "repr": "string",
      "constraints": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "maxLength": 64
      },
      "description": "kernel QueryId: a named query of a tenant, [a-z][a-z0-9_]*, at most 64 bytes."
    },
    {
      "id": "view-id",
      "name": "view-id",
      "kind": "id",
      "repr": "string",
      "constraints": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "maxLength": 64
      },
      "description": "kernel ViewId: a view of a tenant, [a-z][a-z0-9_]*, at most 64 bytes."
    },
    {
      "id": "on-delete",
      "name": "On Delete",
      "kind": "union",
      "variants": [
        {
          "name": "restrict"
        },
        {
          "name": "set-null"
        }
      ],
      "encoding": {
        "tag": "external",
        "variantCase": "PascalCase"
      },
      "description": "strata_kernel::OnDelete."
    },
    {
      "id": "value",
      "name": "Value",
      "kind": "union",
      "variants": [
        {
          "name": "null"
        },
        {
          "name": "bool",
          "newtype": true,
          "fields": [
            {
              "name": "value",
              "type": "bool"
            }
          ]
        },
        {
          "name": "int",
          "newtype": true,
          "fields": [
            {
              "name": "value",
              "type": "i64"
            }
          ]
        },
        {
          "name": "str",
          "newtype": true,
          "fields": [
            {
              "name": "value",
              "type": "string"
            }
          ]
        },
        {
          "name": "time",
          "newtype": true,
          "fields": [
            {
              "name": "value",
              "type": "i64"
            }
          ]
        },
        {
          "name": "ref",
          "newtype": true,
          "fields": [
            {
              "name": "value",
              "type": "record-id"
            }
          ]
        },
        {
          "name": "list",
          "newtype": true,
          "fields": [
            {
              "name": "value",
              "type": "list<value>"
            }
          ]
        }
      ],
      "encoding": {
        "tag": "external",
        "variantCase": "PascalCase"
      },
      "description": "strata_kernel::Value: the typed value algebra."
    },
    {
      "id": "field-type",
      "name": "Field Type",
      "kind": "union",
      "variants": [
        {
          "name": "str"
        },
        {
          "name": "int"
        },
        {
          "name": "bool"
        },
        {
          "name": "time"
        },
        {
          "name": "ref",
          "fields": [
            {
              "name": "target",
              "type": "object-type-id"
            },
            {
              "name": "on-delete",
              "type": "on-delete"
            }
          ]
        },
        {
          "name": "list",
          "newtype": true,
          "fields": [
            {
              "name": "value",
              "type": "field-type"
            }
          ]
        }
      ],
      "encoding": {
        "tag": "external",
