        },
        {
          "name": "version",
          "type": "u64"
        },
        {
          "name": "changed-at",
          "type": "timestamp",
          "optional": true
        },
        {
          "name": "held",
          "type": "u64",
          "optional": true
        },
        {
          "name": "stored-at",
          "type": "timestamp",
          "optional": true
        },
        {
          "name": "copy-state",
          "type": "string"
        },
        {
          "name": "stored",
          "type": "bool",
          "optional": true
        }
      ],
      "retention": "Held by the origin and the edge for as long as the page is published.",
      "schemaVersion": 1,
      "description": "What the target delivery machines (origin-content-flow-impl, edge-copy-flow-impl) hold about one published page: its version and the state of its edge copy. The page content itself is a tenant record in tbl-records, described by the tenant schema.",
      "scope": "platform",
      "realisation": "target"
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-tenant-directory",
      "name": "Tenant directory (control database)",
      "scope": "platform",
      "key": [
        "id"
      ],
      "fields": [
        {
          "name": "id",
          "type": "tenant-id"
        },
        {
          "name": "state",
          "type": "tenant-file-state"
        },
        {
          "name": "file",
          "type": "string",
          "description": "The tenant database file, relative to the tenants directory."
        },
        {
          "name": "created-at",
          "type": "timestamp"
        }
      ],
      "retention": "Until the tenant is deleted; the row goes after its file. A row in the state provisioning, left by an install that did not finish, is removed with its file by the next start of the backend or the next open of that tenant.",
      "description": "Table tenant_directory of the control database: one row per tenant naming the file that holds everything the tenant owns (TEN-001), with its state: active, provisioning while an install is under way, or deleting while its file is being removed. A tenant in either of the last two states loads as absent. It holds no tenant content."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-session-directory",
      "name": "Session directory (control database)",
      "scope": "platform",
      "key": [
        "id"
      ],
      "unique": [
        [
          "token-hash"
        ]
      ],
      "fields": [
        {
          "name": "id",
          "type": "session-id"
        },
        {
          "name": "token-hash",
          "type": "hash",
          "classification": "credential"
        },
        {
          "name": "tenant",
          "type": "tenant-id"
        }
      ],
      "erasure": {
        "point": "the session is purged, or its tenant is deleted"
      },
      "retention": "As long as the session it points at.",
      "description": "Table session_directory of the control database: which tenant file holds a session, so that a session is found by its token hash or id without opening every tenant file. Token hashes are unique across tenants."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-control-migrations",
      "name": "Control migrations (control database)",
      "scope": "platform",
      "key": [
        "version"
      ],
      "fields": [
        {
          "name": "version",
          "type": "u32"
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "applied-at",
          "type": "timestamp"
        }
      ],
      "description": "Table control_migrations of the control database: the layout steps applied to it, each once. A file that has the old table storage_migrations or tenants is the old single-file layout and is refused with a message to delete it."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-tenant-migrations",
      "name": "Tenant migrations (tenant file)",
      "scope": "platform",
      "key": [
        "version"
      ],
      "fields": [
        {
          "name": "version",
          "type": "u32"
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "applied-at",
          "type": "timestamp"
        }
      ],
      "description": "Table tenant_migrations of a tenant file: the layout steps applied to that file, each once."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-tenant-header",
      "name": "Tenant header (tenant file)",
      "scope": "tenant-meta",
      "describedBy": "tenant-schema",
      "key": [
        "id"
      ],
      "fields": [
        {
          "name": "id",
          "type": "tenant-id"
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "revision",
          "type": "u64"
        },
        {
          "name": "next-record",
          "type": "u64"
        },
        {
          "name": "event-seq",
          "type": "u64"
        },
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "members",
          "type": "json",
          "description": "Principal ids with their role sets."
        }
      ],
      "description": "Table tenant of a tenant file: its single row holds the tenant header, with the current tenant schema as data. The row exists once the tenant is created."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-schema-history",
      "name": "Schema history (tenant file)",
      "scope": "tenant-meta",
      "describedBy": "tenant-schema",
      "key": [
        "version"
      ],
      "fields": [
        {
          "name": "version",
          "type": "u64"
        },
        {
          "name": "revision",
          "type": "u64"
        },
        {
          "name": "schema",
          "type": "tenant-schema"
        }
      ],
      "retention": "Every version is kept in the schema history, without its teams and invitations, which name people (D-7726); a tenant migration removed them from the rows written before.",
      "description": "Table schema_history of a tenant file: every version of the tenant schema, with the revision that introduced it."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-records",
      "name": "Records (tenant file)",
      "scope": "tenant-meta",
      "describedBy": "tenant-schema",
      "key": [
        "object",
        "id"
      ],
      "fields": [
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "id",
          "type": "record-id"
        },
        {
          "name": "version",
          "type": "u64"
        },
        {
          "name": "data",
          "type": "record",
          "description": "The canonical JSON of the record; its fields are those the tenant schema gives its object type."
        }
      ],
      "retention": "Until deleted by the tenant or removed by its retention rule (PRV-356), with every version (CMS-006). Every value of a declared personal field is stored sealed under the key of its subject (D-7720). Erasing a subject (the contract erase-subject) clears the fields the subject owns by a personal declaration, in batches of at most 100 records, rewrites their index rows in the same commit, and then destroys the subject key; a record past its retention is not deleted by it (WG-5116).",
      "erasure": {
        "point": "its deletion by the tenant, the end of its retention rule (PRV-356), or the deletion of the tenant file"
      },
      "description": "Table records of a tenant file: every record of every tenant object type, generically. Which object types exist and what fields they have is tenant data (the tenant schema), never a table of its own."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-record-index",
      "name": "Record index (tenant file)",
      "scope": "tenant-meta",
      "describedBy": "tenant-schema",
      "key": [
        "object",
        "field",
        "value",
        "id"
      ],
      "fields": [
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "field",
          "type": "field-id"
        },
        {
          "name": "value",
          "type": "string",
          "description": "The canonical JSON of one scalar field value or list element, up to 240 bytes."
        },
        {
          "name": "id",
          "type": "record-id",
          "refersTo": "tbl-records",
          "onDelete": "cascade"
        },
        {
          "name": "kind",
          "type": "i64",
          "optional": true,
          "description": "The variant of a single value in the order of Value (0 null, 1 bool, 2 int, 3 str, 4 time, 5 ref); absent for a list element (KRN-2525)."
        },
        {
          "name": "ord",
          "type": "i64",
          "optional": true,
          "description": "The number of an integer or a time value, its order key; absent for every other value (KRN-2525)."
        }
      ],
      "description": "Table record_index of a tenant file: one row per scalar field value and list element, so that uniqueness and reference lookups do not scan, with the order key of integers and times so that a planned named query reads a range of the index (KRN-2525). Tenant migration 16 added kind and ord and rebuilds the rows from the records. A sealed personal field has a row for each blind hash its token carries when it is searchable, without kind or ord, and none when it is not (D-7723, PRV-1588).",
      "indexes": [
        {
          "name": "record_index_ord",
          "fields": [
            "object",
            "field",
            "kind",
            "ord",
            "id"
          ]
        },
        {
          "name": "record_index_ord_desc",
          "fields": [
            "object",
            "field",
            "kind",
            "ord",
            "id"
          ]
        }
      ]
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-events",
      "name": "Events and outbox (tenant file)",
      "scope": "platform",
      "key": [
        "position"
      ],
      "unique": [
        [
          "seq"
        ]
      ],
      "fields": [
        {
          "name": "position",
          "type": "u64",
          "description": "The outbox position in this tenant file, increasing in commit order and never reused."
        },
        {
          "name": "seq",
          "type": "u64"
        },
        {
          "name": "revision",
          "type": "u64"
        },
        {
          "name": "data",
          "type": "domain-event",
          "personal": "other"
        },
        {
          "name": "published",
          "type": "bool"
        }
      ],
      "retention": "Until the tenant file is deleted, or a snapshot restore discards the events after it. Every value of a declared personal field in a record image is stored sealed under the key of its subject (D-7720), so the erasure of the subject, which destroys the key, makes it unreadable in every event and in the outbox without rewriting one; events written before the tenant was first sealed keep plain values (D-7724).",
      "erasure": {
        "point": "the destruction of the subject key, for each sealed personal value (D-350, D-7722); the deletion of the tenant file, or a snapshot restore that discards it, for the rest"
      },
      "description": "Table events of a tenant file: the event log, doubling as the tenant outbox through published, written in the same transaction as the state it describes."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-journal",
      "name": "Journal (tenant file)",
      "scope": "platform",
      "key": [
        "revision"
      ],
      "fields": [
        {
          "name": "revision",
          "type": "u64"
        },
        {
          "name": "data",
          "type": "journal-entry",
          "personal": "other"
        }
      ],
      "retention": "Until the tenant file is deleted, or a snapshot restore discards the entries after it. The field values of create-record and update-record intents of declared personal fields are stored sealed, and the delta and events hashes are over the sealed form (D-7720, D-7721); the erasure of the subject destroys the key, and a replay reports the entries it can no longer decide as redacted (PRV-361). The inputs of invoke-operation, the address of create-invitation and the entries written before the tenant was first sealed keep plain values (WG-5245, D-7724).",
      "erasure": {
        "point": "the destruction of the subject key, for each sealed personal value (D-350, D-7722); the deletion of the tenant file, or a snapshot restore that discards it, for the rest"
      },
      "description": "Table journal of a tenant file: every accepted transition as decided, enough to run it again."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-snapshots",
      "name": "Snapshots (tenant file)",
      "scope": "platform",
      "key": [
        "id"
      ],
      "fields": [
        {
          "name": "id",
          "type": "u64"
        },
        {
          "name": "label",
          "type": "string"
        },
        {
          "name": "revision",
          "type": "u64"
        },
        {
          "name": "hash",
          "type": "hash"
        },
        {
          "name": "created-at",
          "type": "timestamp"
        },
        {
          "name": "data",
          "type": "tenant-state",
          "personal": "other"
        }
      ],
      "retention": "Until the tenant file is deleted. Each snapshot holds the stored rows, so its declared personal fields are sealed and the destruction of a subject key makes them unreadable, also after a restore (D-7727). The members, teams and invitations of its time are kept plain, and a restore is to re-apply the later erasures (WG-5246).",
      "erasure": {
        "point": "the destruction of the subject key, for each sealed personal value (D-350); the deletion of the tenant file for the rest"
      },
      "description": "Table snapshots of a tenant file: copies of the complete tenant state."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-sessions",
      "name": "Sessions (tenant file)",
      "scope": "platform",
      "key": [
        "id"
      ],
      "unique": [
        [
          "token-hash"
        ]
      ],
      "indexes": [
        {
          "name": "sessions_principal",
          "fields": [
            "principal"
          ]
        }
      ],
      "fields": [
        {
          "name": "id",
          "type": "session-id"
        },
        {
          "name": "token-hash",
          "type": "hash",
          "classification": "credential"
        },
        {
          "name": "csrf-token",
          "type": "secret",
          "classification": "credential"
        },
        {
          "name": "principal",
          "type": "principal-id",
          "refersTo": "principal",
          "role": "subject",
          "onDelete": "restrict"
        },
        {
          "name": "display-name",
          "type": "display-name",
          "personal": "name"
        },
        {
          "name": "created-at",
          "type": "timestamp"
        },
        {
          "name": "last-seen-at",
          "type": "timestamp"
        },
        {
          "name": "expires-at",
          "type": "timestamp"
        },
        {
          "name": "revoked-at",
          "type": "timestamp",
          "optional": true
        }
      ],
      "retention": "Until purged after it ends, or the tenant file is deleted. Erasing a subject (the contract erase-subject) ends the sessions of the person in the commit that removes their roles; the rows are purged a day after they end.",
      "erasure": {
        "point": "the purge after the session ends, or the deletion of the tenant file"
      },
      "description": "Table sessions of a tenant file: server-side sessions of the tenant; only the hash of the token is stored."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
