          "from": "pc-open-i",
          "to": "pc-open-i",
          "on": "pc-change-requested",
          "guard": "holdsRecords <= event.recordsLimit && holdsFiles > event.filesLimit",
          "effects": [
            {
              "set": "refusedFor",
              "to": "'files'"
            },
            {
              "emit": "pc-refused-files",
              "to": "operator-console"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "pc-open-i": "pc-open"
        },
        "variables": {
          "holdsRecords": "holdsRecords",
          "holdsFiles": "holdsFiles",
          "planRecords": "planRecords",
          "planFiles": "planFiles",
          "refusedFor": "refusedFor"
        },
        "transitions": {
          "pc-change-i": "pc-change",
          "pc-refuse-records-i": "pc-refuse-records",
          "pc-refuse-files-i": "pc-refuse-files"
        }
      },
      "storage": {
        "record": "rec-plan-change",
        "key": "tenant-id",
        "creates": true
      },
      "instances": {
        "key": "tenant-id",
        "storedIn": "rec-plan-change",
        "max": 16
      }
    },
    {
      "id": "connection-quota-flow",
      "name": "Connection quota per tenant",
      "subject": "limit-store",
      "initial": "cq-open",
      "description": "The connection counters of two tenants, a and b, against a quota of two connections each. A tenant that exceeds its quota receives a throttling response and the other tenant is served. The model puts both tenants in one machine, so this one is a single unit and has no keyed instances.",
      "variables": [
        {
          "name": "connsA",
          "type": "number",
          "initial": 0
        },
        {
          "name": "connsB",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "cq-open",
          "name": "Serving"
        }
      ],
      "transitions": [
        {
          "id": "cq-throttle-everyone",
          "from": "cq-open",
          "to": "cq-open",
          "on": "cq-connection-requested",
          "guard": "connsA >= 2",
          "effects": [
            {
              "emit": "cq-throttled"
            }
          ],
          "faultOnly": true,
          "description": "Defect: throttles every tenant once one has exceeded its quota."
        },
        {
          "id": "cq-no-limit-a",
          "from": "cq-open",
          "to": "cq-open",
          "on": "cq-connection-requested",
          "guard": "event.tenant == 'a'",
          "effects": [
            {
              "set": "connsA",
              "to": "connsA + 1"
            },
            {
              "emit": "cq-served"
            }
          ],
          "faultOnly": true,
          "description": "Defect: opens a connection of tenant a whatever its quota."
        },
        {
          "id": "cq-serve-a",
          "from": "cq-open",
          "to": "cq-open",
          "on": "cq-connection-requested",
          "guard": "event.tenant == 'a' && connsA < 2",
          "effects": [
            {
              "set": "connsA",
              "to": "connsA + 1"
            },
            {
              "emit": "cq-served"
            }
          ]
        },
        {
          "id": "cq-throttle-a",
          "from": "cq-open",
          "to": "cq-open",
          "on": "cq-connection-requested",
          "guard": "event.tenant == 'a' && connsA >= 2",
          "effects": [
            {
              "emit": "cq-throttled"
            }
          ]
        },
        {
          "id": "cq-serve-b",
          "from": "cq-open",
          "to": "cq-open",
          "on": "cq-connection-requested",
          "guard": "event.tenant == 'b' && connsB < 2",
          "effects": [
            {
              "set": "connsB",
              "to": "connsB + 1"
            },
            {
              "emit": "cq-served"
            }
          ]
        },
        {
          "id": "cq-throttle-b",
          "from": "cq-open",
          "to": "cq-open",
          "on": "cq-connection-requested",
          "guard": "event.tenant == 'b' && connsB >= 2",
          "effects": [
            {
              "emit": "cq-throttled"
            }
          ]
        }
      ]
    },
    {
      "id": "connection-quota-flow-impl",
      "name": "Connection quota per tenant (implementation)",
      "level": "implementation",
      "subject": "limit-store",
      "refines": "connection-quota-flow",
      "description": "The connection counters of two tenants, a and b, against a quota of two connections each. A tenant that exceeds its quota receives a throttling response and the other tenant is served. The model puts both tenants in one machine, so this one is a single unit and has no keyed instances.",
      "initial": "cq-open-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "connsA",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "connsB",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        }
      ],
      "states": [
        {
          "id": "cq-open-i",
          "name": "Serving"
        }
      ],
      "transitions": [
        {
          "id": "cq-serve-a-i",
          "from": "cq-open-i",
          "to": "cq-open-i",
          "on": "cq-connection-requested",
          "guard": "event.tenant == 'a' && connsA < 2",
          "effects": [
            {
              "set": "connsA",
              "to": "connsA + 1"
            },
            {
              "emit": "cq-served",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "cq-throttle-a-i",
          "from": "cq-open-i",
          "to": "cq-open-i",
          "on": "cq-connection-requested",
          "guard": "event.tenant == 'a' && connsA >= 2",
          "effects": [
            {
              "emit": "cq-throttled",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "cq-serve-b-i",
          "from": "cq-open-i",
          "to": "cq-open-i",
          "on": "cq-connection-requested",
          "guard": "event.tenant == 'b' && connsB < 2",
          "effects": [
            {
              "set": "connsB",
              "to": "connsB + 1"
            },
            {
              "emit": "cq-served",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "cq-throttle-b-i",
          "from": "cq-open-i",
          "to": "cq-open-i",
          "on": "cq-connection-requested",
          "guard": "event.tenant == 'b' && connsB >= 2",
          "effects": [
            {
              "emit": "cq-throttled",
              "to": "gateway"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "cq-open-i": "cq-open"
        },
        "variables": {
          "connsA": "connsA",
          "connsB": "connsB"
        },
        "transitions": {
          "cq-serve-a-i": "cq-serve-a",
          "cq-throttle-a-i": "cq-throttle-a",
          "cq-serve-b-i": "cq-serve-b",
          "cq-throttle-b-i": "cq-throttle-b"
        }
      },
      "storage": {
        "record": "rec-connection-quota",
        "key": "scope",
        "creates": true
      }
    },
    {
      "id": "bootstrap-credential-flow",
      "name": "Bootstrap credential",
      "subject": "control-plane",
      "initial": "bc-none",
      "description": "The bootstrap credential that provisioning issues for the first owner of a tenant. One credential is issued; it is accepted once and refused after its first use and after its expiry.",
      "variables": [
        {
          "name": "issued",
          "type": "number",
          "initial": 0
        },
        {
          "name": "accepted",
          "type": "number",
          "initial": 0
        },
        {
          "name": "expired",
          "type": "boolean",
          "initial": false
        }
      ],
      "states": [
        {
          "id": "bc-none",
          "name": "Not issued"
        },
        {
          "id": "bc-issued",
          "name": "Issued"
        },
        {
          "id": "bc-used",
          "name": "Used"
        },
        {
          "id": "bc-expired",
          "name": "Expired"
        }
      ],
      "transitions": [
        {
          "id": "bc-accept-again",
          "from": "bc-used",
          "to": "bc-used",
          "on": "bc-presented",
          "effects": [
            {
              "set": "accepted",
              "to": "accepted + 1"
            },
            {
              "emit": "bc-accepted"
            }
          ],
          "faultOnly": true,
          "description": "Defect: accepts the credential again after its first use."
        },
        {
          "id": "bc-accept-expired",
          "from": "bc-expired",
          "to": "bc-expired",
          "on": "bc-presented",
          "effects": [
            {
              "set": "accepted",
              "to": "accepted + 1"
            },
            {
              "emit": "bc-accepted"
            }
          ],
          "faultOnly": true,
          "description": "Defect: accepts the credential after its expiry."
        },
        {
          "id": "bc-issue-again",
          "from": "bc-issued",
          "to": "bc-issued",
          "on": "bc-issue-requested",
          "effects": [
            {
              "set": "issued",
              "to": "issued + 1"
            },
            {
              "emit": "bc-credential-issued"
            }
          ],
          "faultOnly": true,
          "description": "Defect: issues a second credential."
        },
        {
          "id": "bc-issue",
          "from": "bc-none",
          "to": "bc-issued",
          "on": "bc-issue-requested",
          "effects": [
            {
              "set": "issued",
              "to": "issued + 1"
            },
            {
              "emit": "bc-credential-issued"
            }
          ]
        },
        {
          "id": "bc-issue-twice-refused",
          "from": "bc-issued",
          "to": "bc-issued",
          "on": "bc-issue-requested",
          "effects": [
            {
              "emit": "bc-refused"
            }
          ]
        },
        {
          "id": "bc-present-first",
          "from": "bc-issued",
          "to": "bc-used",
          "on": "bc-presented",
          "effects": [
            {
              "set": "accepted",
              "to": "accepted + 1"
            },
            {
              "emit": "bc-accepted"
            }
          ]
        },
        {
          "id": "bc-present-used",
          "from": "bc-used",
          "to": "bc-used",
          "on": "bc-presented",
          "effects": [
            {
              "emit": "bc-refused"
            }
          ]
        },
        {
          "id": "bc-present-expired",
          "from": "bc-expired",
          "to": "bc-expired",
          "on": "bc-presented",
          "effects": [
            {
              "emit": "bc-refused"
            }
          ]
        },
        {
          "id": "bc-present-none",
          "from": "bc-none",
          "to": "bc-none",
          "on": "bc-presented",
          "effects": [
            {
              "emit": "bc-refused"
            }
          ]
        },
        {
          "id": "bc-expire",
          "from": "bc-issued",
          "to": "bc-expired",
          "on": "bc-expiry-reached",
          "effects": [
            {
              "set": "expired",
              "to": true
            }
          ]
        }
      ]
    },
    {
      "id": "bootstrap-credential-flow-impl",
      "name": "Bootstrap credential (implementation)",
      "level": "implementation",
      "subject": "control-plane",
      "refines": "bootstrap-credential-flow",
      "description": "The bootstrap credential that provisioning issues for the first owner of a tenant. One credential is issued; it is accepted once and refused after its first use and after its expiry.",
      "initial": "bc-none-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "issued",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "accepted",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "expired",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        }
      ],
      "states": [
        {
          "id": "bc-none-i",
          "name": "Not issued",
          "ignores": [
            "bc-expiry-reached"
          ]
        },
        {
          "id": "bc-issued-i",
          "name": "Issued"
        },
        {
          "id": "bc-used-i",
          "name": "Used",
          "ignores": [
            "bc-issue-requested",
            "bc-expiry-reached"
          ]
        },
        {
          "id": "bc-expired-i",
          "name": "Expired",
          "ignores": [
            "bc-issue-requested",
            "bc-expiry-reached"
          ]
        }
      ],
      "transitions": [
        {
          "id": "bc-issue-i",
          "from": "bc-none-i",
          "to": "bc-issued-i",
          "on": "bc-issue-requested",
          "otherwise": true,
          "effects": [
            {
              "set": "issued",
              "to": "issued + 1"
            },
            {
              "emit": "bc-credential-issued",
              "to": "operator-console"
            }
          ]
        },
        {
          "id": "bc-issue-twice-refused-i",
          "from": "bc-issued-i",
          "to": "bc-issued-i",
          "on": "bc-issue-requested",
          "otherwise": true,
          "effects": [
            {
              "emit": "bc-refused",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "bc-present-first-i",
          "from": "bc-issued-i",
          "to": "bc-used-i",
          "on": "bc-presented",
          "otherwise": true,
          "effects": [
            {
              "set": "accepted",
              "to": "accepted + 1"
            },
            {
              "emit": "bc-accepted",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "bc-present-used-i",
          "from": "bc-used-i",
          "to": "bc-used-i",
          "on": "bc-presented",
          "otherwise": true,
          "effects": [
            {
              "emit": "bc-refused",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "bc-present-expired-i",
          "from": "bc-expired-i",
          "to": "bc-expired-i",
          "on": "bc-presented",
          "otherwise": true,
          "effects": [
            {
              "emit": "bc-refused",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "bc-present-none-i",
          "from": "bc-none-i",
          "to": "bc-none-i",
          "on": "bc-presented",
          "otherwise": true,
          "effects": [
            {
              "emit": "bc-refused",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "bc-expire-i",
          "from": "bc-issued-i",
          "to": "bc-expired-i",
          "on": "bc-expiry-reached",
          "otherwise": true,
          "effects": [
            {
              "set": "expired",
              "to": true
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "bc-none-i": "bc-none",
          "bc-issued-i": "bc-issued",
          "bc-used-i": "bc-used",
          "bc-expired-i": "bc-expired"
        },
        "variables": {
          "issued": "issued",
          "accepted": "accepted",
          "expired": "expired"
        },
        "transitions": {
          "bc-issue-i": "bc-issue",
          "bc-issue-twice-refused-i": "bc-issue-twice-refused",
          "bc-present-first-i": "bc-present-first",
          "bc-present-used-i": "bc-present-used",
          "bc-present-expired-i": "bc-present-expired",
          "bc-present-none-i": "bc-present-none",
          "bc-expire-i": "bc-expire"
        }
      },
      "storage": {
        "record": "rec-bootstrap-credential",
        "key": "tenant-id",
        "creates": true
      },
      "instances": {
        "key": "tenant-id",
        "storedIn": "rec-bootstrap-credential",
        "max": 16
      }
    },
    {
      "id": "placement-choice-flow",
      "name": "Placement by region",
      "subject": "control-plane",
      "initial": "rg-idle",
      "description": "A tenant is created with a region. Its database and its stored files are placed in that region when the region is one the platform offers (eu and us here); a region it does not offer refuses the creation and places nothing.",
      "variables": [
        {
          "name": "requested",
          "type": "string",
          "initial": ""
        },
        {
          "name": "dbRegion",
          "type": "string",
          "initial": ""
        },
        {
          "name": "filesRegion",
          "type": "string",
          "initial": ""
        },
        {
          "name": "placed",
          "type": "boolean",
          "initial": false
        }
      ],
      "states": [
        {
          "id": "rg-idle",
          "name": "Not placed"
        },
        {
          "id": "rg-placed",
          "name": "Placed",
          "terminal": true
        },
        {
          "id": "rg-unplaced",
          "name": "Refused",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "rg-place-in-default",
          "from": "rg-idle",
          "to": "rg-placed",
          "on": "rg-create-requested",
          "guard": "event.region == 'eu' || event.region == 'us'",
          "effects": [
            {
              "set": "requested",
              "to": "event.region"
            },
            {
              "set": "dbRegion",
              "to": "'us'"
            },
            {
              "set": "filesRegion",
              "to": "event.region"
            },
            {
              "set": "placed",
              "to": true
            },
            {
              "emit": "rg-tenant-placed"
            }
          ],
          "faultOnly": true,
          "description": "Defect: places the database in the default region."
        },
        {
          "id": "rg-place-files-in-default",
          "from": "rg-idle",
          "to": "rg-placed",
          "on": "rg-create-requested",
          "guard": "event.region == 'eu' || event.region == 'us'",
          "effects": [
            {
              "set": "requested",
              "to": "event.region"
            },
            {
              "set": "dbRegion",
              "to": "event.region"
            },
            {
              "set": "filesRegion",
              "to": "'us'"
            },
            {
              "set": "placed",
              "to": true
            },
            {
              "emit": "rg-tenant-placed"
            }
          ],
          "faultOnly": true,
          "description": "Defect: places the stored files in the default region."
        },
        {
          "id": "rg-place-unsupported",
          "from": "rg-idle",
          "to": "rg-placed",
          "on": "rg-create-requested",
          "guard": "event.region != 'eu' && event.region != 'us'",
          "effects": [
            {
              "set": "requested",
              "to": "event.region"
            },
            {
              "set": "dbRegion",
              "to": "'us'"
            },
            {
              "set": "filesRegion",
              "to": "'us'"
            },
            {
              "set": "placed",
              "to": true
            },
            {
              "emit": "rg-tenant-placed"
            }
          ],
          "faultOnly": true,
          "description": "Defect: places a tenant whose region is not offered."
        },
        {
          "id": "rg-place",
          "from": "rg-idle",
          "to": "rg-placed",
          "on": "rg-create-requested",
          "guard": "event.region == 'eu' || event.region == 'us'",
          "effects": [
            {
              "set": "requested",
              "to": "event.region"
            },
            {
              "set": "dbRegion",
              "to": "event.region"
            },
            {
              "set": "filesRegion",
              "to": "event.region"
            },
            {
              "set": "placed",
              "to": true
            },
            {
              "emit": "rg-tenant-placed"
            }
          ]
        },
        {
          "id": "rg-refuse",
          "from": "rg-idle",
          "to": "rg-unplaced",
          "on": "rg-create-requested",
          "guard": "event.region != 'eu' && event.region != 'us'",
          "effects": [
            {
              "emit": "rg-placement-refused"
            }
          ]
        }
      ]
    },
    {
      "id": "placement-choice-flow-impl",
      "name": "Placement by region (implementation)",
      "level": "implementation",
