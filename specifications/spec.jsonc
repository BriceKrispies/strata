    {
      "id": "floor-div",
      "description": "Division that rounds toward negative infinity (Rust i64::div_euclid for a positive divisor); the body language's / truncates toward zero.",
      "params": [
        {
          "name": "a",
          "type": "i64"
        },
        {
          "name": "b",
          "type": "i64"
        }
      ],
      "returns": "i64",
      "body": "if a >= 0 then a / b else 0 - ((0 - a + b - 1) / b)",
      "examples": [
        {
          "args": {
            "a": 7,
            "b": 2
          },
          "result": 3
        },
        {
          "args": {
            "a": 0,
            "b": 2
          },
          "result": 0
        },
        {
          "args": {
            "a": -1,
            "b": 2
          },
          "result": -1
        },
        {
          "args": {
            "a": -4,
            "b": 2
          },
          "result": -2
        },
        {
          "args": {
            "a": -7,
            "b": 2
          },
          "result": -4
        }
      ]
    },
    {
      "id": "floor-mod",
      "description": "The remainder that goes with floor-div (Rust i64::rem_euclid for a positive divisor): never negative.",
      "params": [
        {
          "name": "a",
          "type": "i64"
        },
        {
          "name": "b",
          "type": "i64"
        }
      ],
      "returns": "i64",
      "body": "a - call floor-div(a, b) * b",
      "examples": [
        {
          "args": {
            "a": 7,
            "b": 3
          },
          "result": 1
        },
        {
          "args": {
            "a": -1,
            "b": 7
          },
          "result": 6
        },
        {
          "args": {
            "a": -7,
            "b": 7
          },
          "result": 0
        }
      ]
    },
    {
      "id": "ledger-days-from-civil",
      "description": "ledger.rs days_from_civil: the days since 1970-01-01 of a civil date (proleptic Gregorian), after H. Hinnant.",
      "params": [
        {
          "name": "year",
          "type": "i64"
        },
        {
          "name": "month",
          "type": "i64"
        },
        {
          "name": "day",
          "type": "i64"
        }
      ],
      "returns": "i64",
      "let": [
        {
          "name": "y",
          "expr": "if month <= 2 then year - 1 else year"
        },
        {
          "name": "era",
          "expr": "call floor-div(y, 400)"
        },
        {
          "name": "yoe",
          "expr": "y - era * 400"
        },
        {
          "name": "mp",
          "expr": "(month + 9) % 12"
        },
        {
          "name": "doy",
          "expr": "(153 * mp + 2) / 5 + day - 1"
        },
        {
          "name": "doe",
          "expr": "yoe * 365 + yoe / 4 - yoe / 100 + doy"
        }
      ],
      "body": "era * 146097 + doe - 719468",
      "examples": [
        {
          "args": {
            "year": 1970,
            "month": 1,
            "day": 1
          },
          "result": 0
        },
        {
          "args": {
            "year": 1970,
            "month": 3,
            "day": 1
          },
          "result": 59
        },
        {
          "args": {
            "year": 2000,
            "month": 2,
            "day": 29
          },
          "result": 11016
        },
        {
          "args": {
            "year": 2024,
            "month": 12,
            "day": 31
          },
          "result": 20088
        },
        {
          "args": {
            "year": 1969,
            "month": 12,
            "day": 31
          },
          "result": -1
        },
        {
          "args": {
            "year": 1900,
            "month": 3,
            "day": 1
          },
          "result": -25508
        },
        {
          "args": {
            "year": 2100,
            "month": 3,
            "day": 1
          },
          "result": 47541
        },
        {
          "args": {
            "year": 100,
            "month": 1,
            "day": 1
          },
          "result": -683003
        }
      ]
    },
    {
      "id": "ledger-civil-month",
      "description": "ledger.rs civil_month: the civil year and month of a count of days since 1970-01-01.",
      "params": [
        {
          "name": "days",
          "type": "i64"
        }
      ],
      "returns": "civil-month",
      "let": [
        {
          "name": "z",
          "expr": "days + 719468"
        },
        {
          "name": "era",
          "expr": "call floor-div(z, 146097)"
        },
        {
          "name": "doe",
          "expr": "z - era * 146097"
        },
        {
          "name": "yoe",
          "expr": "(doe - doe / 1460 + doe / 36524 - doe / 146096) / 365"
        },
        {
          "name": "doy",
          "expr": "doe - (365 * yoe + yoe / 4 - yoe / 100)"
        },
        {
          "name": "mp",
          "expr": "(5 * doy + 2) / 153"
        },
        {
          "name": "month",
          "expr": "if mp < 10 then mp + 3 else mp - 9"
        }
      ],
      "body": "civil-month{year: yoe + era * 400 + (if month <= 2 then 1 else 0), month}",
      "examples": [
        {
          "args": {
            "days": 0
          },
          "result": {
            "year": 1970,
            "month": 1
          }
        },
        {
          "args": {
            "days": 59
          },
          "result": {
            "year": 1970,
            "month": 3
          }
        },
        {
          "args": {
            "days": 60
          },
          "result": {
            "year": 1970,
            "month": 3
          }
        },
        {
          "args": {
            "days": 365
          },
          "result": {
            "year": 1971,
            "month": 1
          }
        },
        {
          "args": {
            "days": -1
          },
          "result": {
            "year": 1969,
            "month": 12
          }
        },
        {
          "args": {
            "days": -719468
          },
          "result": {
            "year": 0,
            "month": 3
          }
        },
        {
          "args": {
            "days": 19782
          },
          "result": {
            "year": 2024,
            "month": 2
          }
        },
        {
          "args": {
            "days": 2932896
          },
          "result": {
            "year": 9999,
            "month": 12
          }
        }
      ]
    },
    {
      "id": "ledger-period-start",
      "description": "ledger.rs period_start: the start of the calendar period in UTC that contains an instant: the hour, the day, the week starting on Monday, or the month (D-5005, LDG-015). 1970-01-01 was a Thursday, three days after a Monday.",
      "params": [
        {
          "name": "period",
          "type": "ledger-period"
        },
        {
          "name": "at",
          "type": "i64"
        }
      ],
      "returns": "i64",
      "let": [
        {
          "name": "days",
          "expr": "call floor-div(at, 86400000)"
        }
      ],
      "body": "match period { hour => call floor-div(at, 3600000) * 3600000, day => days * 86400000, week => (days - call floor-mod(days + 3, 7)) * 86400000, month => call ledger-days-from-civil(call ledger-civil-month(days).year, call ledger-civil-month(days).month, 1) * 86400000 }",
