    {
      "id": "ledger-change-needs",
      "description": "ledger.rs schema_change_needs: the needs of the ledger changes of a schema change: whether an account names a unit or a pool being removed (LDG-1549).",
      "params": [
        {
          "name": "changes",
          "type": "list<schema-change>"
        }
      ],
      "returns": "list<need>",
      "body": "fold(c in changes, acc = [], match c { remove-ledger-definition(r) => match r { unit{unit} => concat(acc, [need.ledger(ledger-need.unit-used{unit})]), pool{pool} => concat(acc, [need.ledger(ledger-need.pool-used{pool})]), limit => acc }, _ => acc })",
      "examples": [
        {
          "args": {
            "changes": []
          },
          "result": []
        },
        {
          "args": {
            "changes": [
              {
                "remove-ledger-definition": {
                  "unit": {
                    "unit": "credits"
                  }
                }
              },
              {
                "remove-ledger-definition": {
                  "pool": {
                    "pool": "promo"
                  }
                }
              },
              {
                "remove-ledger-definition": {
                  "limit": {
                    "unit": "credits"
                  }
                }
              },
              {
                "declare-ledger-unit": {
                  "unit": "x",
                  "description": "x"
                }
              }
            ]
          },
          "result": [
            {
              "ledger": {
                "unit-used": {
                  "unit": "credits"
                }
              }
            },
            {
              "ledger": {
                "pool-used": {
                  "pool": "promo"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "ledger-removal-check",
      "description": "ledger.rs check_removals (LDG-1549): a unit or a pool that an account names is not removed. For each removal of a unit or a pool, in order: the snapshot must cover the need (unit-used, pool-used), or the change is InsufficientState naming it; an account that names it is StillReferenced \"ledger unit <id> is named by an account and is not removed\" with the failed check ledger:in-use after the evidence so far (no intent:<kind> check); otherwise ledger:in-use passes with \"no account names ledger unit <id>\". The accounts are those of the snapshot.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "changes",
          "type": "list<schema-change>"
        }
      ],
      "returns": "draft",
      "errors": "rejection",
      "let": [
        {
          "name": "accounts",
          "expr": "match d.tenant.ledger { Some(l) => values(l.accounts), None => [] }"
        }
      ],
      "body": "fold(c in changes, acc = d, match c { remove-ledger-definition(r) => match r { unit{unit} => try call ledger-removal-step(acc, need.ledger(ledger-need.unit-used{unit}), format('ledger unit {}', unit), any(a in accounts, a.unit == unit)), pool{pool} => try call ledger-removal-step(acc, need.ledger(ledger-need.pool-used{pool}), format('ledger pool {}', pool), any(a in accounts, match a.owner { Some(o) => match o { pool{pool: p} => p == pool, _ => false }, None => false })), limit => acc }, _ => acc })",
      "examples": [
        {
          "description": "No removal of a unit or a pool: nothing to check.",
          "args": {
            "d": {
              "fixture": "fx-draft-28"
            },
            "changes": [
              {
                "remove-ledger-definition": {
                  "limit": {
                    "unit": "credits"
                  }
                }
              },
              {
                "declare-ledger-unit": {
                  "unit": "x",
                  "description": "x"
                }
              }
            ]
          },
          "result": {
