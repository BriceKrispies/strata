// The Strata specification. One file, the authority for what the platform is to do.
// Exegra validates it, evaluates the m-... claims and runs the behaviour models.
// The gate (scripts/spec-gate.mjs) reconciles the requirements with the code and with recorded
// test results. See specifications/README.md.
{
  "specParts": [
    "intent.jsonc",
    "boundary.jsonc",
    "behaviour.jsonc",
    "requirements.jsonc",
    "functions.jsonc"
  ],
  "specSections": {
    "actions": "boundary.jsonc",
    "assumptions": "intent.jsonc",
    "behaviors": "behaviour.jsonc",
    "boundaries": "intent.jsonc",
    "capabilities": "boundary.jsonc",
    "caseTables": "requirements.jsonc",
    "claims": {"by":"kind","values":{"requirement":"requirements.jsonc"},"default":"behaviour.jsonc"},
    "components": "boundary.jsonc",
    "constraints": "intent.jsonc",
    "contracts": "boundary.jsonc",
    "copies": "boundary.jsonc",
    "decisions": "intent.jsonc",
    "delegations": "boundary.jsonc",
    "documents": "intent.jsonc",
    "environments": "intent.jsonc",
    "errorMessages": "boundary.jsonc",
    "events": "behaviour.jsonc",
    "exampleFixtures": "functions.jsonc",
    "exegra": "intent.jsonc",
    "failureModes": "behaviour.jsonc",
    "faultModels": "behaviour.jsonc",
    "faults": "behaviour.jsonc",
    "featureFlags": "boundary.jsonc",
    "forms": "boundary.jsonc",
    "functions": "functions.jsonc",
    "goals": "intent.jsonc",
    "grants": "boundary.jsonc",
    "languages": "boundary.jsonc",
    "liveBindings": "boundary.jsonc",
    "milestones": "intent.jsonc",
    "nonGoals": "intent.jsonc",
    "openQuestions": "intent.jsonc",
    "plans": "boundary.jsonc",
    "quotas": "boundary.jsonc",
    "records": "boundary.jsonc",
    "relationships": "boundary.jsonc",
    "releaseStages": "intent.jsonc",
    "retentions": "boundary.jsonc",
    "roles": "boundary.jsonc",
    "scenarios": "behaviour.jsonc",
    "screens": "boundary.jsonc",
    "sections": "intent.jsonc",
    "system": "intent.jsonc",
    "terms": "intent.jsonc",
    "tokenScopes": "boundary.jsonc",
    "types": "boundary.jsonc",
    "uiScenarios": "behaviour.jsonc",
    "validations": "boundary.jsonc",
    "views": "intent.jsonc",
    "vocabulary": "intent.jsonc"
  }
}
