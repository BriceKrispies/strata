    {
      "id": "ledger-intent-decision",
      "description": "ledger.rs decide_intent, the intent post-ledger (CT-281), as far as it is decided before an account is read (WG-5170): the principal holds ledger-post (the owner holds every capability; else Unauthorized with the failed permission:capability:ledger-post check), the intent names 1 to 8 postings (ledger:postings), and the first posting passes ledger-posting-precheck, whose refusal is the intent's. The result is the checks that passed. What follows reads the first posting's account, which is named by a uuid derived from the SHA-256 of the tenant, owner, unit and scope; the function language has neither (WG-5257, WG-5258), so intent-decision refuses it with ledger:decided_by_the_ledger_module after these checks.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "postings",
          "type": "list<ledger-posting-request>"
        }
      ],
      "returns": "list<check>",
      "errors": "rejection",
      "let": [
        {
          "name": "rule",
          "expr": "'permission:capability:ledger-post'"
        },
        {
          "name": "holds",
          "expr": "any(r in call roles-of(d.tenant, d.ctx.principal), r == 'owner') || any(g in call effective-permissions(d.tenant, d.ctx.principal), g == grant.capability('ledger-post'))"
        }
      ],
      "body": "if !holds then fail(rejection.rejected(domain-error{kind: error-kind.unauthorized, message: 'a posting needs the capability ledger-post', evidence: [check{rule, passed: false, detail: 'does not hold ledger-post'}]})) else let evidence = [check{rule, passed: true, detail: 'holds ledger-post'}] in if length(postings) == 0 || length(postings) > 8 then fail(rejection.rejected(call ledger-refused(evidence, error-kind.invalid-intent, 'ledger:postings', format('a posting change names 1 to {} postings, not {}', 8, length(postings))))) else fold(first in take(postings, 1), acc = evidence, try call ledger-posting-precheck(d.tenant, acc, first))",
      "examples": [
        {
          "description": "A principal without ledger-post is refused before any posting is looked at.",
          "args": {
            "d": {
              "fixture": "fx-draft-30",
              "with": {
                "ctx.principal.user": "alpha:reader"
              }
            },
            "postings": [
              {
                "owner": {
                  "principal": {
                    "principal": "alpha:owner"
                  }
                },
                "unit": "credits",
                "amount": 5,
                "idempotency-key": "k1",
                "reason": "a reward"
              }
            ]
          },
          "error": {
            "rejected": {
              "kind": "unauthorized",
              "message": "a posting needs the capability ledger-post",
              "evidence": [
                {
                  "rule": "permission:capability:ledger-post",
                  "passed": false,
                  "detail": "does not hold ledger-post"
                }
              ]
            }
          }
        },
        {
          "description": "No posting at all.",
          "args": {
            "d": {
              "fixture": "fx-draft-30"
            },
            "postings": []
          },
          "error": {
            "rejected": {
              "kind": "invalid-intent",
              "message": "ledger:postings: a posting change names 1 to 8 postings, not 0",
              "evidence": [
                {
                  "rule": "permission:capability:ledger-post",
                  "passed": true,
                  "detail": "holds ledger-post"
                },
                {
                  "rule": "ledger:postings",
                  "passed": false,
                  "detail": "a posting change names 1 to 8 postings, not 0"
                }
              ]
            }
          }
        },
        {
          "description": "Nine postings.",
          "args": {
