    {
      "id": "value-rank",
      "description": "The position of a value's variant in the derived order of Value (Null, Bool, Int, Str, Time, Ref, List), the most significant part of comparing two values.",
      "params": [
        {
          "name": "x",
          "type": "value"
        }
      ],
      "returns": "i64",
      "body": "match x { bool(_) => 1, int(_) => 2, str(_) => 3, time(_) => 4, ref(_) => 5, list(_) => 6, _ => 0 }",
      "examples": [
        {
          "args": {
            "x": "null"
          },
          "result": 0
        },
        {
          "args": {
            "x": {
              "str": "a"
            }
          },
          "result": 3
        },
        {
          "args": {
            "x": {
              "bool": true
            }
          },
          "result": 1
        },
        {
          "args": {
            "x": {
              "int": 3
            }
          },
          "result": 2
        },
        {
          "args": {
            "x": {
              "str": "a"
            }
          },
          "result": 3
        },
        {
          "args": {
            "x": {
              "time": 5
            }
          },
          "result": 4
        },
        {
          "args": {
            "x": {
              "ref": 1
            }
          },
          "result": 5
        },
        {
          "args": {
            "x": {
              "list": []
            }
          },
          "result": 6
        },
        {
          "args": {
            "x": "null"
          },
          "result": 0
        }
      ]
    },
    {
      "id": "value-number",
      "description": "The order within a variant of a value that is a bool (false before true), an integer, a time or a reference; 0 for any other value. A reference id above the largest i64 is not ordered (record ids are allocated from 1).",
      "params": [
        {
          "name": "x",
          "type": "value"
        }
      ],
      "returns": "i64",
      "body": "match x { bool(b) => if b then 1 else 0, int(i) => i, time(t) => t, ref(r) => r, _ => 0 }",
      "examples": [
        {
          "args": {
            "x": {
              "bool": true
            }
          },
          "result": 1
        },
        {
          "args": {
            "x": {
              "time": 7
            }
          },
          "result": 7
        },
        {
          "args": {
            "x": {
              "str": "a"
            }
          },
          "result": 0
        },
        {
          "args": {
            "x": {
              "int": 4
            }
          },
          "result": 4
        },
        {
          "args": {
            "x": {
              "ref": 9
            }
          },
          "result": 9
        },
        {
          "args": {
            "x": {
              "bool": false
            }
          },
          "result": 0
        }
      ]
    },
    {
      "id": "value-text",
      "description": "The order within the variant of a string value (by Unicode scalar values, as Rust orders str); the empty text for any other value.",
      "params": [
        {
          "name": "x",
          "type": "value"
        }
      ],
      "returns": "string",
      "body": "match x { str(s) => s, _ => '' }",
      "examples": [
        {
          "args": {
            "x": {
              "str": "b"
            }
          },
          "result": "b"
        },
        {
          "args": {
            "x": {
              "int": 1
            }
          },
          "result": ""
        }
      ]
    },
    {
      "id": "record-attribute",
      "description": "expr.rs attribute(Some(record), name): a system attribute or a field of a record, null when unset. A name that is not a field id reads as null here, where the kernel refuses it (an order key or a section attribute is checked by schema-problems first).",
      "params": [
        {
          "name": "r",
          "type": "record"
        },
        {
          "name": "field",
          "type": "string"
        }
      ],
      "returns": "value",
      "body": "match get(call record-scope(r), field) { Some(x) => x, None => call null-value() }",
      "examples": [
        {
          "args": {
            "r": {
              "id": 2,
              "object": "post",
              "version": 1,
              "created-by": "alpha:writer",
              "created-at": 2000,
