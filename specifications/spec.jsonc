    {
      "id": "resolve-setting",
      "description": "settings.rs resolve: the value of a setting for a principal and the level it came from, with the revision of the setting at the tenant (SET-010 to SET-014, SET-051); the platform revision is zero while the platform level is absent. A setting the schema does not define is UnknownObject \"no setting <id>\" with the failed check setting:is_defined.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "principal",
          "type": "principal"
        },
        {
          "name": "setting",
          "type": "setting-id"
        }
      ],
      "returns": "setting-resolution",
      "errors": "rejection",
      "body": "match get(call settings-of(tenant.schema), setting) { None => fail(rejection.rejected(domain-error{kind: error-kind.unknown-object, message: format('no setting {}', setting), evidence: [check{rule: 'setting:is_defined', passed: false, detail: format('no setting {}', setting)}]})), Some(def) => let f = call setting-found-of(tenant, def, principal) in setting-resolution{setting: def.id, value: f.value, source: f.source, team: f.team, platform-revision: 0, tenant-revision: call setting-revision-of(tenant, def.id)} }",
      "examples": [
        {
          "description": "A person in a team with an override.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-34"
            },
            "principal": {
              "user": "alpha:writer2"
            },
            "setting": "theme"
          },
          "result": {
            "setting": "theme",
            "value": {
              "str": "blue"
            },
            "source": "team",
            "team": "lab",
            "platform-revision": 0,
            "tenant-revision": 5
          }
        },
        {
