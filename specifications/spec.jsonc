          "fields": [
            {
              "name": "value",
              "type": "string"
            }
          ]
        }
      ]
    },
    {
      "id": "route-match",
      "name": "Route Match",
      "kind": "struct",
      "description": "substrate project.rs match_route: the view whose route matched, and the values of its :name segments.",
      "fields": [
        {
          "name": "view",
          "type": "view-def"
        },
        {
          "name": "params",
          "type": "map<string, string>"
        }
      ]
    },
    {
      "id": "route-try",
      "name": "Route Try",
