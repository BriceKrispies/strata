                  "role": "owner",
                  "resource": "schema",
                  "actions": [
                    "manage"
                  ],
                  "condition": null
                },
                "queries.zero": {
                  "id": "zero",
                  "object": "note",
                  "filter": null,
                  "params": [],
                  "order": [],
