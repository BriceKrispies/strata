    {
      "id": "code-spend-flow",
      "name": "One-time code",
      "subject": "identity-service",
      "initial": "cs-live",
      "description": "One one-time code. Five failed presentations (D-700) spend it: once spent it is refused even when the right code is presented. A right presentation within the limit is accepted and uses the code up.",
      "variables": [
        {
          "name": "failures",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "cs-live",
          "name": "Live"
        },
        {
          "id": "cs-spent",
          "name": "Spent"
        }
      ],
      "transitions": [
        {
          "id": "cs-accept-after-spent",
          "from": "cs-spent",
          "to": "cs-spent",
          "on": "cs-presented",
          "guard": "event.guess == 'right'",
          "effects": [
            {
              "emit": "cs-accepted"
            }
          ],
          "faultOnly": true,
          "description": "Defect: accepts the right code after the failures reached the limit."
        },
        {
          "id": "cs-right",
          "from": "cs-live",
          "to": "cs-spent",
          "on": "cs-presented",
          "guard": "event.guess == 'right'",
          "effects": [
            {
              "emit": "cs-accepted"
            }
          ]
        },
        {
          "id": "cs-wrong-last",
          "from": "cs-live",
          "to": "cs-spent",
          "on": "cs-presented",
          "guard": "event.guess == 'wrong' && failures == 4",
          "effects": [
            {
              "set": "failures",
              "to": "failures + 1"
            },
            {
              "emit": "cs-refused"
            }
          ]
        },
        {
          "id": "cs-wrong",
          "from": "cs-live",
          "to": "cs-live",
          "on": "cs-presented",
          "guard": "event.guess == 'wrong'",
          "effects": [
            {
              "set": "failures",
              "to": "failures + 1"
            },
            {
              "emit": "cs-refused"
            }
          ]
        },
        {
          "id": "cs-refuse-spent",
          "from": "cs-spent",
          "to": "cs-spent",
          "on": "cs-presented",
          "effects": [
            {
              "emit": "cs-refused"
            }
          ]
        }
      ],
      "realisation": "target"
    },
    {
      "level": "implementation",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "id": "code-spend-flow-impl",
      "name": "One-time code (implementation)",
      "subject": "identity-service",
      "initial": "cs-live-i",
      "description": "One one-time code as the identity service keeps it (rec-one-time-code): the count of failed presentations and whether it is spent. The fifth failure spends it.",
      "variables": [
        {
          "name": "failures",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        }
      ],
      "states": [
        {
          "id": "cs-live-i",
          "name": "Live"
        },
        {
          "id": "cs-spent-i",
          "name": "Spent"
        }
      ],
      "transitions": [
        {
          "id": "cs-right-i",
          "from": "cs-live-i",
          "to": "cs-spent-i",
          "on": "cs-presented",
          "guard": "event.guess == 'right'",
          "effects": [
            {
              "emit": "cs-accepted",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "cs-wrong-last-i",
          "from": "cs-live-i",
          "to": "cs-spent-i",
          "on": "cs-presented",
          "guard": "event.guess == 'wrong' && failures == 4",
          "effects": [
            {
              "set": "failures",
              "to": "failures + 1"
            },
            {
              "emit": "cs-refused",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "cs-wrong-i",
          "from": "cs-live-i",
          "to": "cs-live-i",
          "on": "cs-presented",
          "guard": "event.guess == 'wrong'",
          "effects": [
            {
              "set": "failures",
              "to": "failures + 1"
            },
            {
              "emit": "cs-refused",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "cs-refuse-spent-i",
          "from": "cs-spent-i",
          "to": "cs-spent-i",
          "on": "cs-presented",
          "effects": [
            {
              "emit": "cs-refused",
              "to": "web-application"
            }
          ],
          "otherwise": true
        }
      ],
      "refines": "code-spend-flow",
      "refinement": {
        "states": {
          "cs-live-i": "cs-live",
          "cs-spent-i": "cs-spent"
        },
        "variables": {
          "failures": "failures"
        },
        "transitions": {
          "cs-right-i": "cs-right",
          "cs-wrong-last-i": "cs-wrong-last",
          "cs-wrong-i": "cs-wrong",
          "cs-refuse-spent-i": "cs-refuse-spent"
        }
      },
      "storage": {
        "record": "rec-one-time-code",
        "key": "code-id",
        "creates": true
      },
      "realisation": "target"
    },
    {
      "id": "mfp-limit-flow",
      "name": "Second-factor prompt limit",
      "subject": "identity-service",
      "initial": "mfp-open",
      "description": "The second-factor prompts sent to one account. The limit starts at the platform default of 5 within one hour (D-700) and a realm may only tighten it. One model tick is one minute.",
      "variables": [
        {
          "name": "count",
          "type": "number",
          "initial": 0
        },
        {
          "name": "windowStart",
          "type": "number",
          "initial": 0
        },
        {
          "name": "limit",
          "type": "number",
          "initial": 5
        },
        {
          "name": "windowOpen",
          "type": "boolean",
          "initial": false
        }
      ],
      "states": [
        {
          "id": "mfp-open",
          "name": "Counting"
        }
      ],
      "transitions": [
        {
          "id": "mfp-accept-over",
          "from": "mfp-open",
          "to": "mfp-open",
          "on": "mfp-requested",
          "guard": "count >= limit && windowOpen && windowStart <= time && time - windowStart < 60",
          "effects": [
            {
              "set": "count",
              "to": "count + 1"
            },
            {
              "emit": "mfp-accepted"
            }
          ],
          "faultOnly": true,
          "description": "Defect: allows a request over the limit."
        },
        {
          "id": "mfp-new-window",
          "from": "mfp-open",
          "to": "mfp-open",
          "on": "mfp-requested",
          "guard": "!(windowOpen && windowStart <= time && time - windowStart < 60)",
          "effects": [
            {
              "set": "windowStart",
              "to": "time"
            },
            {
              "set": "windowOpen",
              "to": true
            },
            {
              "set": "count",
              "to": 1
            },
            {
              "emit": "mfp-accepted"
            }
          ]
        },
        {
          "id": "mfp-accept",
          "from": "mfp-open",
          "to": "mfp-open",
          "on": "mfp-requested",
          "guard": "count < limit",
          "effects": [
            {
              "set": "count",
              "to": "count + 1"
            },
            {
              "emit": "mfp-accepted"
            }
          ]
        },
        {
          "id": "mfp-refuse",
          "from": "mfp-open",
          "to": "mfp-open",
          "on": "mfp-requested",
          "effects": [
            {
              "emit": "mfp-refused"
            }
          ]
        },
        {
          "id": "mfp-tighten",
          "from": "mfp-open",
          "to": "mfp-open",
          "on": "mfp-tightened",
          "guard": "event.limit < limit",
          "effects": [
            {
              "set": "limit",
              "to": "event.limit"
            }
          ]
        }
      ],
      "realisation": "target"
    },
    {
      "level": "implementation",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
