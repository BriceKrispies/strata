    {"id":"tm-reconcile-requested","name":"Final synchronisation requested","description":"The writes the source accepted while the copy ran are applied to the target, with the source frozen.","payload":[{"name":"move-id","type":"move-id"}]},
    {"id":"src-attempt","name":"Password attempt from a source","description":"A password is presented for an account, from a source.","payload":[{"name":"source","type":"string"},{"name":"account","type":"string"},{"name":"guess","type":"string"}]},
    {"id":"src-accepted","name":"Attempt from a source accepted","description":"The password was evaluated and accepted.","delivery":"at-most-once"},
    {"id":"src-refused","name":"Attempt from a source refused","description":"The attempt was refused.","delivery":"at-most-once"},
    {"id":"ui-session-read","name":"Session read","description":"The session read answers, from the page or from a request, with whether the visit is signed in.","payload":[{"name":"authenticated","type":"u8"}]},
    {"id":"ui-signed-in","name":"Sign-in accepted","description":"The sign-in reply carries a session."},
    {"id":"ui-signed-out","name":"Sign-out answered","description":"The sign-out reply says the session ended."},
