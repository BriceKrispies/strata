    {
      "id": "refuse",
      "description": "transition.rs refuse: a rejection made before any rule of the tenant is consulted; it names the failed check.",
      "params": [
        {
          "name": "kind",
          "type": "error-kind"
        },
        {
          "name": "rule",
          "type": "string"
        },
        {
          "name": "message",
          "type": "string"
        }
      ],
      "returns": "domain-error",
      "body": "domain-error{kind, message, evidence: [check{rule, passed: false, detail: message}]}",
      "examples": [
        {
          "args": {
            "kind": "tenant-not-found",
            "rule": "tenant:exists",
            "message": "no such tenant"
          },
          "result": {
            "kind": "tenant-not-found",
            "message": "no such tenant",
            "evidence": [
              {
                "rule": "tenant:exists",
                "passed": false,
                "detail": "no such tenant"
              }
            ],
            "missing": null
          }
        }
      ]
    },
    {
      "id": "principal-debug",
      "description": "The Rust Debug text of a Principal ({:?}).",
      "params": [
        {
          "name": "p",
          "type": "principal"
        }
      ],
      "returns": "string",
      "body": "match p { system => 'System', anonymous => 'Anonymous', user(id) => format('User(PrincipalId(\"{}\"))', id) }",
      "examples": [
        {
          "args": {
            "p": {
              "user": "alpha:writer2"
            }
          },
          "result": "User(PrincipalId(\"alpha:writer2\"))"
        },
        {
          "args": {
            "p": "anonymous"
          },
          "result": "Anonymous"
        },
        {
          "args": {
            "p": "system"
          },
          "result": "System"
        }
      ]
    },
    {
      "id": "resource-debug",
      "description": "The Rust Debug text of a Resource ({resource:?}).",
      "params": [
        {
          "name": "r",
          "type": "resource"
        }
      ],
      "returns": "string",
      "body": "match r { object(o) => format('Object(ObjectTypeId(\"{}\"))', o), any-object => 'AnyObject', schema => 'Schema', members => 'Members' }",
      "examples": [
        {
          "args": {
            "r": {
              "object": "note"
            }
          },
          "result": "Object(ObjectTypeId(\"note\"))"
        },
        {
          "args": {
            "r": "members"
          },
          "result": "Members"
        },
        {
          "args": {
            "r": "any-object"
          },
          "result": "AnyObject"
        },
        {
          "args": {
            "r": "schema"
          },
          "result": "Schema"
        }
      ]
    },
    {
      "id": "revision-debug",
      "description": "The Rust Debug text of an Option<StateRevision>.",
      "params": [
        {
          "name": "r",
          "type": "option<state-revision>"
        }
      ],
      "returns": "string",
      "body": "match r { Some(n) => format('Some(StateRevision({}))', n), None => 'None' }",
      "examples": [
        {
          "args": {
            "r": 3
          },
          "result": "Some(StateRevision(3))"
        },
        {
          "args": {
            "r": null
          },
          "result": "None"
        }
      ]
    },
    {
      "id": "string-set-debug",
      "description": "The Rust Debug text of a BTreeSet<String> ({:?}): the items quoted, in order, between braces. Quotes and backslashes inside an item are not escaped (the body language has no string operations).",
      "params": [
        {
          "name": "items",
          "type": "set<string>"
        }
      ],
      "returns": "string",
      "body": "'{' + fold(s in items, acc = '', if acc == '' then format('\"{}\"', s) else acc + ', ' + format('\"{}\"', s)) + '}'",
      "examples": [
        {
          "args": {
            "items": [
              "draft"
            ]
          },
          "result": "{\"draft\"}"
        },
        {
          "args": {
            "items": [
              "a",
              "b"
            ]
          },
          "result": "{\"a\", \"b\"}"
        },
        {
          "args": {
            "items": []
          },
          "result": "{}"
        }
      ]
    },
    {
      "id": "join-semicolon",
      "description": "Vec<String>::join(\"; \") for the refusals of a workflow step, which are never empty.",
      "params": [
        {
          "name": "items",
          "type": "list<string>"
        }
      ],
      "returns": "string",
      "body": "fold(s in items, acc = '', if acc == '' then s else acc + '; ' + s)",
      "examples": [
        {
          "args": {
            "items": [
              "publish: guard is not true",
              "publish2: guard is not true"
            ]
          },
          "result": "publish: guard is not true; publish2: guard is not true"
        },
        {
          "args": {
            "items": [
              "x: y"
            ]
          },
          "result": "x: y"
        }
      ]
    },
    {
      "id": "genesis-schema",
      "description": "schema.rs TenantSchema::genesis: version 1, the built-in roles public (Everyone) and owner (Owner), nothing else.",
      "params": [],
      "returns": "tenant-schema",
      "body": "tenant-schema{version: 1, objects: {}, roles: insert(insert({}, 'owner', role-def{id: 'owner', label: 'Owner'}), 'public', role-def{id: 'public', label: 'Everyone'}), policies: {}, workflows: {}, queries: {}, views: {}}",
      "examples": [
        {
          "args": {},
          "result": {
            "version": 1,
            "objects": {},
            "roles": {
              "owner": {
                "id": "owner",
                "label": "Owner"
              },
              "public": {
                "id": "public",
                "label": "Everyone"
              }
            },
            "policies": {},
            "workflows": {},
            "queries": {},
            "views": {}
          }
        }
      ]
    },
    {
      "id": "policy-check-text",
      "description": "A check of rules.rs authorize as the kernel writes it: the detail printed from the outcome, the request and the printed condition (conditions holds it under the rule, policy:<id>). For a condition that failed to evaluate the kernel writes \"<condition>: <evaluation error>\"; policy-check does not carry the error, so the detail is \"<condition>: evaluation failed\" (a gap of WG-4938).",
      "params": [
        {
          "name": "c",
          "type": "policy-check"
        },
        {
          "name": "conditions",
          "type": "map<string, string>"
        }
      ],
      "returns": "check",
      "let": [
        {
          "name": "text",
          "expr": "match get(conditions, c.rule) { Some(t) => t, None => '' }"
        }
      ],
      "body": "check{rule: c.rule, passed: c.passed, detail: match c.outcome { owner => c.what, unconditional => c.what, held => format('{} where {}', c.what, text), is-false => format('{} is false', text), is-null => format('{} is null', text), failed => format('{}: evaluation failed', text), no-policy => format('no policy grants {}', c.what) }}",
      "examples": [
        {
          "args": {
            "c": {
              "rule": "policy:writers_edit_own",
              "passed": true,
              "what": "Update on Object(ObjectTypeId(\"note\"))",
              "outcome": "held",
              "condition": {
                "cmp": {
                  "op": "eq",
                  "left": {
                    "var": {
                      "scope": "record",
                      "field": "$created_by"
                    }
                  },
                  "right": "principal"
                }
              }
            },
            "conditions": {
              "policy:writers_edit_own": "(record.$created_by == principal)",
              "policy:public_reads_published": "(record.status == 'published')"
            }
          },
          "result": {
            "rule": "policy:writers_edit_own",
            "passed": true,
            "detail": "Update on Object(ObjectTypeId(\"note\")) where (record.$created_by == principal)"
          }
        },
        {
          "args": {
            "c": {
              "rule": "policy:writers_edit_own",
              "passed": false,
              "what": "Update on Object(ObjectTypeId(\"note\"))",
              "outcome": "is-false",
              "condition": {
                "cmp": {
                  "op": "eq",
                  "left": {
                    "var": {
                      "scope": "record",
                      "field": "$created_by"
                    }
                  },
                  "right": "principal"
                }
              }
            },
            "conditions": {
              "policy:writers_edit_own": "(record.$created_by == principal)",
              "policy:public_reads_published": "(record.status == 'published')"
            }
          },
          "result": {
            "rule": "policy:writers_edit_own",
            "passed": false,
            "detail": "(record.$created_by == principal) is false"
          }
        },
        {
          "args": {
            "c": {
              "rule": "policy:public_reads_published",
              "passed": false,
              "what": "Read on Object(ObjectTypeId(\"note\"))",
              "outcome": "is-null",
              "condition": {
                "cmp": {
                  "op": "eq",
                  "left": {
                    "var": {
                      "scope": "record",
                      "field": "status"
                    }
                  },
                  "right": {
                    "lit": {
                      "str": "published"
                    }
                  }
                }
              }
            },
            "conditions": {
              "policy:writers_edit_own": "(record.$created_by == principal)",
              "policy:public_reads_published": "(record.status == 'published')"
            }
          },
          "result": {
            "rule": "policy:public_reads_published",
            "passed": false,
            "detail": "(record.status == 'published') is null"
          }
        },
        {
          "args": {
            "c": {
              "rule": "policy:none",
              "passed": false,
              "what": "Manage on Members",
              "outcome": "no-policy",
              "condition": null
            },
            "conditions": {}
          },
          "result": {
            "rule": "policy:none",
            "passed": false,
            "detail": "no policy grants Manage on Members"
          }
        },
        {
          "args": {
            "c": {
              "rule": "policy:builtin_owner",
              "passed": true,
              "what": "Manage on Schema",
              "outcome": "owner",
              "condition": null
            },
            "conditions": {}
          },
          "result": {
            "rule": "policy:builtin_owner",
            "passed": true,
            "detail": "Manage on Schema"
          }
        },
        {
          "description": "A condition that could not be evaluated reads as an evaluation failure.",
          "args": {
            "c": {
              "rule": "policy:writers_edit_own",
              "passed": false,
              "what": "Update on Object(ObjectTypeId(\"note\"))",
              "outcome": "failed",
              "condition": {
                "cmp": {
                  "op": "eq",
                  "left": {
                    "var": {
                      "scope": "record",
                      "field": "$created_by"
                    }
                  },
                  "right": "principal"
                }
              }
            },
            "conditions": {
              "policy:writers_edit_own": "(record.$created_by == principal)",
              "policy:public_reads_published": "(record.status == 'published')"
            }
          },
          "result": {
            "rule": "policy:writers_edit_own",
            "passed": false,
            "detail": "(record.$created_by == principal): evaluation failed"
          }
        }
      ]
    },
    {
      "id": "require",
      "description": "transition.rs Draft::require: authorize the action on the resource against the tenant's own schema (rules.rs authorize; the spec's authorize has no lookup, see the gaps of WG-4938), add its checks to the evidence as the kernel writes them, and refuse with Unauthorized \"<principal:?> may not <action:?> <resource:?>\" when it is not allowed.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "action",
          "type": "action"
        },
        {
          "name": "resource",
          "type": "resource"
        },
        {
          "name": "subject",
          "type": "subject"
        },
        {
          "name": "texts",
          "type": "intent-texts"
        }
      ],
      "returns": "draft",
      "errors": "rejection",
      "let": [
        {
          "name": "decision",
          "expr": "call authorize(d.tenant, d.tenant.schema, d.ctx.principal, d.ctx.now, action, resource, subject)"
        },
        {
          "name": "evidence",
          "expr": "concat(d.evidence, map(c in decision.checks, call policy-check-text(c, texts.conditions)))"
        }
      ],
      "body": "if decision.allowed then draft{tenant: d.tenant, ctx: d.ctx, coverage: d.coverage, ops: d.ops, events: d.events, effects: d.effects, evidence: evidence, next-record: d.next-record} else fail(call draft-reject(evidence, error-kind.unauthorized, format('{} may not {} {}', call principal-debug(d.ctx.principal), call action-debug(action), call resource-debug(resource))))",
      "examples": [
        {
          "description": "behaviour.rs create_applies_defaults_and_allocates_the_next_id: writers_read_notes lets writer1 create a note.",
          "args": {
            "d": {
              "tenant": {
                "id": "alpha",
                "name": "alpha",
                "revision": 5,
                "next-record": 1,
                "event-seq": 5,
