      "id": "rec-signing-key-set",
      "name": "Signing key set",
      "owner": "identity-service",
      "key": [
        "key-set-id"
      ],
      "fields": [
        {
          "name": "key-set-id",
          "type": "string",
          "constraints": {
            "maxLength": 96
          }
        },
        {
          "name": "current-kid",
          "type": "string",
          "optional": true
        },
        {
          "name": "previous-kid",
          "type": "string",
          "optional": true
        }
      ],
      "retention": "Held for as long as tokens signed by its keys can be presented.",
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target"
    },
    {
      "id": "rec-identity-decision",
      "name": "Identity decision",
      "owner": "identity-service",
      "key": [
        "decision-id"
      ],
      "fields": [
        {
          "name": "decision-id",
          "type": "request-id"
        }
      ],
      "retention": "Nothing is kept: a decision is taken from its inputs and its row stands for the request only while it is answered.",
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target"
    },
    {
      "id": "rec-published-page",
      "name": "Published page (delivery model)",
      "owner": "runtime",
      "key": [
        "record-id"
      ],
      "fields": [
        {
          "name": "record-id",
          "type": "record-id"
        },
        {
          "name": "version",
          "type": "u64"
        },
        {
          "name": "changed-at",
          "type": "timestamp",
          "optional": true
        },
        {
          "name": "held",
          "type": "u64",
          "optional": true
        },
        {
          "name": "stored-at",
          "type": "timestamp",
          "optional": true
        },
        {
          "name": "copy-state",
          "type": "string"
        },
        {
          "name": "stored",
          "type": "bool",
          "optional": true
        }
      ],
      "retention": "Held by the origin and the edge for as long as the page is published.",
      "schemaVersion": 1,
      "description": "What the target delivery machines (origin-content-flow-impl, edge-copy-flow-impl) hold about one published page: its version and the state of its edge copy. The page content itself is a tenant record in tbl-records, described by the tenant schema.",
      "scope": "platform",
      "realisation": "target"
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-tenant-directory",
      "name": "Tenant directory (control database)",
      "scope": "platform",
      "key": [
        "id"
      ],
      "fields": [
        {
          "name": "id",
          "type": "tenant-id"
        },
        {
          "name": "state",
          "type": "tenant-file-state"
        },
        {
          "name": "file",
          "type": "string",
          "description": "The tenant database file, relative to the tenants directory."
        },
        {
          "name": "created-at",
          "type": "timestamp"
        }
      ],
      "retention": "Until the tenant is deleted; the row goes after its file.",
      "description": "Table tenant_directory of the control database: one row per tenant naming the file that holds everything the tenant owns (TEN-001). It holds no tenant content."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-session-directory",
      "name": "Session directory (control database)",
      "scope": "platform",
      "key": [
        "id"
      ],
      "unique": [
        [
          "token-hash"
        ]
      ],
      "fields": [
        {
          "name": "id",
          "type": "session-id"
        },
        {
          "name": "token-hash",
          "type": "hash",
          "classification": "credential"
        },
        {
          "name": "tenant",
          "type": "tenant-id"
        }
      ],
      "erasure": {
        "point": "the session is purged, or its tenant is deleted"
      },
      "retention": "As long as the session it points at.",
      "description": "Table session_directory of the control database: which tenant file holds a session, so that a session is found by its token hash or id without opening every tenant file. Token hashes are unique across tenants."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-control-migrations",
      "name": "Control migrations (control database)",
      "scope": "platform",
      "key": [
        "version"
      ],
      "fields": [
        {
          "name": "version",
          "type": "u32"
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "applied-at",
          "type": "timestamp"
        }
      ],
      "description": "Table control_migrations of the control database: the layout steps applied to it, each once. A file that has the old table storage_migrations or tenants is the old single-file layout and is refused with a message to delete it."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-tenant-migrations",
      "name": "Tenant migrations (tenant file)",
      "scope": "platform",
      "key": [
        "version"
      ],
      "fields": [
        {
          "name": "version",
          "type": "u32"
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "applied-at",
          "type": "timestamp"
        }
      ],
      "description": "Table tenant_migrations of a tenant file: the layout steps applied to that file, each once."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
