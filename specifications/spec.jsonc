              "featured_by_editors": "(is_null(principal) or has_role(editor) or has_role(owner) or ((not(is_null(new.featured)) and (new.featured == true)) == (not(is_null(old.featured)) and (old.featured == true))))",
              "published_at_by_editors": "(is_null(principal) or has_role(editor) or has_role(owner) or if(is_null(old.published_at), is_null(new.published_at), (not(is_null(new.published_at)) and (new.published_at == old.published_at))) or (not(is_null(old.status)) and (old.status == 'draft') and (new.status == 'published') and (new.published_at == now)))"
