                            }
                          }
                        }
                      },
                      "set": {
                        "published_at": "now"
                      }
                    },
                    {
                      "name": "unpublish",
                      "from": "published",
                      "to": "draft",
                      "guard": null,
                      "set": {
                        "published_at": {
                          "lit": "null"
                        }
                      }
                    }
                  ]
                }
