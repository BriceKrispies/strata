    {
      "id": "section-problems",
      "description": "schema.rs TenantSchema::problems, one section of a view: an unknown query (nothing else is checked); per argument (in name order) a parameter the query does not declare and a section source that is unknown, not single or itself depends on a section; an included field that is not a reference and a markdown field that is not a string.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "view",
          "type": "view-def"
        },
        {
          "name": "at",
          "type": "string"
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "sec",
          "type": "view-section"
        }
      ],
      "returns": "list<string>",
      "let": [
        {
          "name": "here",
          "expr": "format('{}.{}', at, name)"
        }
      ],
      "body": "match get(schema.queries, sec.query) { None => [format('{}: unknown query {}', here, sec.query)], Some(q) => concat(fold(arg in keys(sec.args), ps = [], concat(concat(ps, if any(p in q.params, p == arg) then [] else [format('{}: query has no parameter {}', here, arg)]), match get(sec.args, arg) { Some(src) => match src { section{section: other} => match get(view.sections, other) { Some(dep) => if !dep.single then [format('{}: section {} is not single', here, other)] else if any(a in values(dep.args), match a { section => true, _ => false }) then [format('{}: section {} itself depends on a section', here, other)] else [], None => [format('{}: unknown section {}', here, other)] }, _ => [] }, None => [] })), match get(schema.objects, q.object) { Some(o) => concat(fold(f in sec.include, ps = [], if match get(o.fields, f) { Some(d) => call ref-target(d.ty) != null, None => false } then ps else concat(ps, [format('{}: {} is not a reference field', here, f)])), fold(f in sec.markdown, ps = [], if match get(o.fields, f) { Some(d) => match d.ty { str => true, _ => false }, None => false } then ps else concat(ps, [format('{}: {} is not a string field', here, f)]))), None => [] }) }",
