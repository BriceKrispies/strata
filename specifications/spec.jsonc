  "behaviors": [
    {"id":"emailed-link-flow","name":"Emailed link","subject":"identity-service","initial":"ml-idle","description":"One sign-in link: issued, presented, accepted once in the requesting browser within its lifetime of 15 ticks.","variables":[{"name":"issuedAt","type":"number","initial":0},{"name":"sessions","type":"number","initial":0}],"states":[{"id":"ml-idle","name":"No link"},{"id":"ml-pending","name":"Link issued"},{"id":"ml-used","name":"Link used"}],"transitions":[{"id":"ml-issue","from":"ml-idle","to":"ml-pending","on":"ml-requested","effects":[{"set":"issuedAt","to":"time"},{"emit":"ml-mailed"}]},{"id":"ml-accept-unchecked","from":"ml-pending","to":"ml-used","on":"ml-presented","faultOnly":true,"guard":"event.token == 'good'","description":"Defect: accepts the right token without checking lifetime or browser.","effects":[{"set":"sessions","to":"sessions + 1"},{"emit":"ml-session-issued"}]},{"id":"ml-accept-untimed","from":"ml-pending","to":"ml-used","on":"ml-presented","faultOnly":true,"guard":"event.token == 'good' && event.browser == 'requester'","description":"Defect: accepts the right token without checking lifetime or browser.","effects":[{"set":"sessions","to":"sessions + 1"},{"emit":"ml-session-issued"}]},{"id":"ml-accept-unbrowsed","from":"ml-pending","to":"ml-used","on":"ml-presented","faultOnly":true,"guard":"event.token == 'good' && time - issuedAt <= 15","description":"Defect: accepts the right token without checking lifetime or browser.","effects":[{"set":"sessions","to":"sessions + 1"},{"emit":"ml-session-issued"}]},{"id":"ml-accept","from":"ml-pending","to":"ml-used","on":"ml-presented","guard":"event.token == 'good' && event.browser == 'requester' && time - issuedAt <= 15","effects":[{"set":"sessions","to":"sessions + 1"},{"emit":"ml-session-issued"}]},{"id":"ml-refuse-pending","from":"ml-pending","to":"ml-pending","on":"ml-presented","effects":[{"emit":"ml-refused"}]},{"id":"ml-accept-again","from":"ml-used","to":"ml-used","on":"ml-presented","faultOnly":true,"description":"Defect: accepts a link that was already used.","effects":[{"set":"sessions","to":"sessions + 1"},{"emit":"ml-session-issued"}]},{"id":"ml-refuse-used","from":"ml-used","to":"ml-used","on":"ml-presented","effects":[{"emit":"ml-refused"}]}]},
    {
      "id": "emailed-link-flow-impl",
      "name": "Emailed link (implementation)",
      "subject": "identity-service",
      "level": "implementation",
      "initial": "ml-idle-i",
      "description": "One sign-in link as the identity service keeps it: a challenge row (rec-challenge, keyed by challenge-id) holding the hash of the token, the browser binding and the expiry. The expiry is the time of issue plus the lifetime of 15 minutes (900000 ms, D-9) and the link is accepted through that time, in milliseconds. It is accepted once, only with the right token, in the browser that asked. The refinement reads one model tick as one minute (timeScale 60000), so the model lifetime of 15 ticks is the 15 minutes here, and the mapping gives the model its issue tick.",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "expiresAt",
          "type": "number",
          "initial": 900000,
          "repr": "timestamp"
        },
        {
          "name": "sessions",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        }
      ],
      "states": [
        {
          "id": "ml-idle-i",
          "name": "No link",
          "ignores": [
            "ml-presented"
          ]
        },
        {
          "id": "ml-pending-i",
          "name": "Link issued",
          "ignores": [
            "ml-requested"
          ]
        },
        {
          "id": "ml-used-i",
          "name": "Link used",
          "ignores": [
            "ml-requested"
          ]
        }
      ],
      "transitions": [
        {
          "id": "ml-issue-i",
          "from": "ml-idle-i",
          "to": "ml-pending-i",
          "on": "ml-requested",
          "otherwise": true,
          "effects": [
            {
              "set": "expiresAt",
              "to": "time + 900000"
            },
            {
              "emit": "ml-mailed",
              "to": "mail-service"
            }
          ]
        },
        {
          "id": "ml-accept-i",
          "from": "ml-pending-i",
          "to": "ml-used-i",
          "on": "ml-presented",
          "guard": "event.token == 'good' && event.browser == 'requester' && time <= expiresAt",
          "effects": [
            {
              "set": "sessions",
              "to": "sessions + 1"
            },
            {
              "emit": "ml-session-issued",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "ml-refuse-pending-i",
          "from": "ml-pending-i",
          "to": "ml-pending-i",
          "on": "ml-presented",
          "otherwise": true,
          "effects": [
            {
              "emit": "ml-refused",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "ml-refuse-used-i",
          "from": "ml-used-i",
          "to": "ml-used-i",
          "on": "ml-presented",
          "otherwise": true,
          "effects": [
            {
              "emit": "ml-refused",
              "to": "web-application"
            }
          ]
        }
      ],
      "refines": "emailed-link-flow",
      "refinement": {
        "states": {
          "ml-idle-i": "ml-idle",
          "ml-pending-i": "ml-pending",
          "ml-used-i": "ml-used"
        },
        "variables": {
          "issuedAt": "(expiresAt - 900000) / 60000",
          "sessions": "sessions"
        },
        "transitions": {
          "ml-issue-i": "ml-issue",
          "ml-accept-i": "ml-accept",
          "ml-refuse-pending-i": "ml-refuse-pending",
          "ml-refuse-used-i": "ml-refuse-used"
        },
        "timeScale": 60000
      },
      "storage": {
        "record": "rec-challenge",
        "key": "challenge-id",
        "fields": {
          "expiresAt": "expires-at"
        }
      }
    },
    {"id":"oidc-callback-flow","name":"OpenID Connect callback","subject":"identity-service","initial":"oidc-idle","description":"One sign-in through a provider. The pending request carries the state value s1.","variables":[{"name":"federatedSessions","type":"number","initial":0}],"states":[{"id":"oidc-idle","name":"No request"},{"id":"oidc-awaiting","name":"Awaiting callback"},{"id":"oidc-done","name":"Signed in","terminal":true}],"transitions":[{"id":"oidc-begin","from":"oidc-idle","to":"oidc-awaiting","on":"oidc-started","effects":[{"emit":"oidc-redirected"}]},{"id":"oidc-accept-any-state","from":"oidc-awaiting","to":"oidc-done","on":"oidc-callback","faultOnly":true,"description":"Defect: accepts a callback without comparing its state value.","effects":[{"set":"federatedSessions","to":"federatedSessions + 1"},{"emit":"oidc-session-issued"}]},{"id":"oidc-accept","from":"oidc-awaiting","to":"oidc-done","on":"oidc-callback","guard":"event.state == 's1'","effects":[{"set":"federatedSessions","to":"federatedSessions + 1"},{"emit":"oidc-session-issued"}]},{"id":"oidc-refuse","from":"oidc-awaiting","to":"oidc-awaiting","on":"oidc-callback","effects":[{"emit":"oidc-refused"}]}]},
    {
      "id": "oidc-callback-flow-impl",
      "name": "OpenID Connect callback (implementation)",
      "subject": "identity-service",
      "level": "implementation",
      "initial": "oidc-idle-i",
      "description": "One sign-in through a provider. The state value of the pending request is kept with its challenge (rec-challenge, keyed by challenge-id) and compared with the one the callback carries; a callback with another value is refused and the request stays open.",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "expectedState",
          "type": "string",
          "initial": "s1",
          "repr": "string"
        },
        {
          "name": "federatedSessions",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        }
      ],
      "states": [
        {
          "id": "oidc-idle-i",
          "name": "No request",
          "ignores": [
            "oidc-callback"
          ]
        },
        {
          "id": "oidc-awaiting-i",
          "name": "Awaiting the callback",
          "ignores": [
            "oidc-started"
          ]
        },
        {
          "id": "oidc-done-i",
          "name": "Signed in",
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "oidc-begin-i",
          "from": "oidc-idle-i",
          "to": "oidc-awaiting-i",
          "on": "oidc-started",
          "otherwise": true,
          "effects": [
            {
              "emit": "oidc-redirected",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "oidc-accept-i",
          "from": "oidc-awaiting-i",
          "to": "oidc-done-i",
          "on": "oidc-callback",
          "guard": "event.state == expectedState",
          "effects": [
            {
              "set": "federatedSessions",
              "to": "federatedSessions + 1"
            },
            {
              "emit": "oidc-session-issued",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "oidc-refuse-i",
          "from": "oidc-awaiting-i",
          "to": "oidc-awaiting-i",
          "on": "oidc-callback",
          "otherwise": true,
          "effects": [
            {
              "emit": "oidc-refused",
              "to": "web-application"
            }
          ]
        }
      ],
      "refines": "oidc-callback-flow",
      "refinement": {
        "states": {
          "oidc-idle-i": "oidc-idle",
          "oidc-awaiting-i": "oidc-awaiting",
          "oidc-done-i": "oidc-done"
        },
        "variables": {
          "federatedSessions": "federatedSessions"
        },
        "transitions": {
          "oidc-begin-i": "oidc-begin",
          "oidc-accept-i": "oidc-accept",
          "oidc-refuse-i": "oidc-refuse"
        }
      },
      "storage": {
        "record": "rec-challenge",
        "key": "challenge-id",
        "fields": {
          "expectedState": "expected-state",
          "federatedSessions": "federated-sessions"
        }
      }
    },
    {
      "id": "session-authority-flow",
      "name": "Session authority",
      "subject": "identity-service",
      "initial": "sa-live",
      "description": "The identity service's record of one session.",
      "variables": [
        {
          "name": "revoked",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "revokedAt",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "sa-live",
          "name": "Live"
        },
        {
          "id": "sa-revoked",
          "name": "Revoked"
        }
      ],
      "transitions": [
        {
          "id": "sa-revoke",
          "from": "sa-live",
          "to": "sa-revoked",
          "on": "sr-revoked",
          "effects": [
            {
              "set": "revoked",
              "to": true
            },
            {
              "set": "revokedAt",
              "to": "time"
            },
            {
              "emit": "sr-notice"
            }
          ]
        },
        {
          "id": "sa-answer-live",
          "from": "sa-live",
          "to": "sa-live",
          "on": "sr-lookup",
          "effects": [
            {
              "emit": "sr-lookup-answer",
              "payload": {
                "valid": true
              }
            },
            {
              "emit": "sr-session-valid"
            }
          ]
        },
        {
          "id": "sa-answer-revoked",
          "from": "sa-revoked",
          "to": "sa-revoked",
          "on": "sr-lookup",
          "effects": [
            {
              "emit": "sr-lookup-answer",
              "payload": {
                "valid": false
              }
            },
            {
              "emit": "sr-session-invalid"
            }
          ]
        },
        {
          "id": "sa-keep-on-auth",
          "from": "sa-live",
          "to": "sa-live",
          "on": "sr-authenticated",
          "guard": "event.sameBrowser",
          "effects": [],
          "faultOnly": true,
          "description": "Defect: the session stays live."
        },
        {
          "id": "sa-end-on-auth",
          "from": "sa-live",
          "to": "sa-revoked",
          "on": "sr-authenticated",
          "guard": "event.sameBrowser",
          "effects": [
            {
              "set": "revoked",
              "to": true
            },
            {
              "set": "revokedAt",
              "to": "time"
            },
            {
              "emit": "sr-notice"
            }
          ]
        },
        {
          "id": "sa-keep-on-password",
          "from": "sa-live",
          "to": "sa-live",
          "on": "sr-password-changed",
          "guard": "event.initiator == 'other'",
          "effects": [],
          "faultOnly": true,
          "description": "Defect: the session stays live."
        },
        {
          "id": "sa-end-on-password",
          "from": "sa-live",
          "to": "sa-revoked",
          "on": "sr-password-changed",
          "guard": "event.initiator == 'other'",
          "effects": [
            {
              "set": "revoked",
              "to": true
            },
            {
              "set": "revokedAt",
              "to": "time"
            },
            {
              "emit": "sr-notice"
            }
          ]
        },
        {
          "id": "sa-keep-on-recovery",
          "from": "sa-live",
          "to": "sa-live",
          "on": "sr-recovered",
          "effects": [],
          "faultOnly": true,
          "description": "Defect: the session stays live."
        },
        {
          "id": "sa-end-on-recovery",
          "from": "sa-live",
          "to": "sa-revoked",
          "on": "sr-recovered",
          "effects": [
            {
              "set": "revoked",
              "to": true
            },
            {
              "set": "revokedAt",
              "to": "time"
            },
            {
              "emit": "sr-notice"
            }
          ]
        },
        {
          "id": "sa-keep-on-signout",
          "from": "sa-live",
          "to": "sa-live",
          "on": "sr-signed-out",
          "effects": [],
          "faultOnly": true,
          "description": "Defect: the session stays live."
        },
        {
          "id": "sa-end-on-signout",
          "from": "sa-live",
          "to": "sa-revoked",
          "on": "sr-signed-out",
          "effects": [
            {
              "set": "revoked",
              "to": true
            },
            {
              "set": "revokedAt",
              "to": "time"
            },
            {
              "emit": "sr-notice"
            }
          ]
        },
        {
          "id": "sa-keep-on-deactivation",
          "from": "sa-live",
          "to": "sa-live",
          "on": "sr-deactivated",
          "effects": [],
          "faultOnly": true,
          "description": "Defect: the session stays live."
        },
        {
          "id": "sa-end-on-deactivation",
          "from": "sa-live",
          "to": "sa-revoked",
          "on": "sr-deactivated",
          "effects": [
            {
              "set": "revoked",
              "to": true
            },
            {
              "set": "revokedAt",
              "to": "time"
            },
            {
              "emit": "sr-notice"
            }
          ]
        },
        {
          "id": "sa-keep-on-owner",
          "from": "sa-live",
          "to": "sa-live",
          "on": "sr-owner-revoked",
          "guard": "event.target == 'this'",
          "effects": [],
          "faultOnly": true,
          "description": "Defect: the session stays live."
        },
        {
          "id": "sa-end-on-owner",
          "from": "sa-live",
          "to": "sa-revoked",
          "on": "sr-owner-revoked",
          "guard": "event.target == 'this'",
          "effects": [
            {
              "set": "revoked",
              "to": true
            },
            {
              "set": "revokedAt",
              "to": "time"
            },
            {
              "emit": "sr-notice"
            }
          ]
