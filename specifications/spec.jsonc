        },
        {
          "name": "prodPreviewed",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "prodRunStarted",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "prodChanged",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        }
      ],
      "states": [
        {
          "id": "sp-both-i",
          "name": "Staging and production"
