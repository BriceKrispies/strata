      "id": "prov-flow",
      "name": "Provisioning requests",
      "subject": "identity-service",
      "initial": "prov-open",
      "description": "A request to the provisioning endpoint. The provisioning token grants access to that endpoint of its own realm and to no other endpoint, and a request changes the roles of a principal only through the group mapping the realm declares.",
      "states": [
        {
          "id": "prov-open",
          "name": "Deciding"
