    {
      "id": "draft-save-flow",
      "name": "Saving a draft across a schema change",
      "subject": "runtime",
      "initial": "ds-open",
      "description": "An author saves a draft made under a schema version. A save under the current version succeeds; a save under a prior version is refused with the current version named, and the text of the draft is kept.",
      "variables": [
        {
          "name": "schemaVersion",
          "type": "number",
          "initial": 1
        },
        {
          "name": "saved",
          "type": "number",
          "initial": 0
        },
        {
          "name": "lastSavedAgainst",
          "type": "number",
          "initial": 0
        },
        {
          "name": "schemaAtSave",
          "type": "number",
          "initial": 0
        },
        {
          "name": "refusedNamed",
          "type": "number",
          "initial": 0
        },
        {
          "name": "draftText",
          "type": "string",
          "initial": "x"
        }
      ],
      "states": [
        {
          "id": "ds-open",
          "name": "Tenant serving"
        }
      ],
      "transitions": [
        {
          "id": "ds-save-stale",
          "from": "ds-open",
          "to": "ds-open",
          "on": "ds-save-requested",
          "guard": "event.draftVersion != schemaVersion",
          "effects": [
            {
              "set": "saved",
              "to": "saved + 1"
            },
            {
              "set": "lastSavedAgainst",
              "to": "event.draftVersion"
            },
            {
              "set": "schemaAtSave",
              "to": "schemaVersion"
            },
            {
              "emit": "ds-saved"
            }
          ],
          "faultOnly": true,
          "description": "Defect: saves a draft made under a prior schema version."
        },
        {
          "id": "ds-refusal-clears-draft",
          "from": "ds-open",
          "to": "ds-open",
          "on": "ds-save-requested",
          "guard": "event.draftVersion != schemaVersion",
          "effects": [
            {
              "set": "refusedNamed",
              "to": "schemaVersion"
            },
            {
              "set": "draftText",
              "to": "''"
            },
            {
              "emit": "ds-save-refused"
            }
          ],
          "faultOnly": true,
          "description": "Defect: the refusal discards the text of the draft."
        },
        {
          "id": "ds-schema-change",
          "from": "ds-open",
          "to": "ds-open",
          "on": "ds-schema-changed",
          "effects": [
            {
              "set": "schemaVersion",
              "to": "schemaVersion + 1"
            }
          ]
        },
        {
          "id": "ds-save",
          "from": "ds-open",
          "to": "ds-open",
          "on": "ds-save-requested",
          "guard": "event.draftVersion == schemaVersion",
          "effects": [
            {
              "set": "saved",
              "to": "saved + 1"
            },
            {
              "set": "lastSavedAgainst",
              "to": "event.draftVersion"
            },
            {
              "set": "schemaAtSave",
              "to": "schemaVersion"
            },
            {
              "emit": "ds-saved"
            }
          ]
        },
        {
          "id": "ds-save-refused-stale",
          "from": "ds-open",
          "to": "ds-open",
          "on": "ds-save-requested",
          "guard": "event.draftVersion != schemaVersion",
          "effects": [
            {
              "set": "refusedNamed",
              "to": "schemaVersion"
            },
            {
              "emit": "ds-save-refused"
            }
          ]
        }
      ]
    },
    {
      "id": "draft-save-flow-impl",
      "name": "Saving a draft across a schema change (implementation)",
      "level": "implementation",
      "subject": "runtime",
      "refines": "draft-save-flow",
      "description": "An author saves a draft made under a schema version. A save under the current version succeeds; a save under a prior version is refused with the current version named, and the text of the draft is kept.",
      "initial": "ds-open-i",
