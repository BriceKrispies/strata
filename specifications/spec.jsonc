    {
      "id": "decide-mutation",
      "description": "backend ops.rs mutate, one decision, the decide of contract mutate-record (CT-263): the mutation as an intent (coerce-mutation), its needs asked for first, then the kernel's decision (intent-decision). An InsufficientState rejection naming a need asks for it; any other rejection is answered as the error body (api-error-of, after hide-unreadable). An accepted transition is handed to the commit with its intent and the record reply.",
      "params": [
        {
          "name": "mutation",
          "type": "mutation"
        },
        {
          "name": "context",
          "type": "context"
        },
        {
          "name": "state",
          "type": "state"
        },
        {
          "name": "texts",
          "type": "intent-texts"
        },
        {
          "name": "times",
          "type": "map<string, i64>"
        }
      ],
      "returns": "accepted-intent",
      "errors": "api-failure",
      "let": [
        {
          "name": "intent",
          "expr": "try call coerce-mutation(mutation, state, context, times)"
        }
      ],
      "body": "match call first-missing(state.coverage, call needs(match state.tenant { Some(t) => t.schema, None => null }, intent)) { Some(n) => fail(api-failure.insufficient-state(n)), None => match call intent-decision(state, intent, context, texts) { Ok(tr) => accepted-intent{intent, transition: tr, reply: call mutation-reply-of(tr)}, Err(e) => match e { rejected(d) => match d.missing { Some(n) => if d.kind == error-kind.insufficient-state then fail(api-failure.insufficient-state(n)) else fail(api-failure.rejected(call api-error-of(call hide-unreadable(d, state, intent, context), context))), None => fail(api-failure.rejected(call api-error-of(call hide-unreadable(d, state, intent, context), context))) } } } }",
      "examples": [
