    {"id":"mail-timeout-then-retry","name":"The dispatcher times out and submits again","description":"The dispatcher gives up waiting before the acknowledgement arrives and submits the same key a second time.","behaviors":["mail-dispatch-flow","mail-adapter-flow"],"steps":[
        {
          "at": 0,
          "event": "em-due",
          "payload": {
            "key": "k1",
            "message-id": "00000000-0000-4000-8000-000000000007"
          }
        },
        {
          "at": 1,
          "event": "em-timeout",
          "note": "Before the acknowledgement, which takes two ticks.",
          "payload": {
            "message-id": "00000000-0000-4000-8000-000000000007"
          }
        }
      ]},
    {
      "id": "mail-timeout-then-retry-impl",
      "name": "The dispatcher times out and submits again (implementation)",
      "description": "The first acknowledgement is slow: its dispatch fails five times and it arrives 31 seconds after the submission (the runtime's backoff of 1, 2, 4, 8 and 16 seconds), after the dispatcher waited 30 seconds for it. The dispatcher times out and submits the same key a second time. Times are in milliseconds.",
      "behaviors": [
        "mail-dispatch-flow-impl",
        "mail-adapter-flow"
      ],
      "steps": [
        {
          "at": 0,
          "event": "em-due",
          "payload": {
            "key": "k1",
            "message-id": "00000000-0000-4000-8000-000000000008"
          }
        }
      ],
      "routes": [
        {
          "event": "em-due",
          "behavior": "mail-dispatch-flow-impl",
          "by": "key",
          "field": "message-id"
        }
      ],
      "timeUnit": "ms",
      "faults": [
        "first-acknowledgement-slow-impl"
      ]
    },
