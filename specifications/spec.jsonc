    {
      "id": "create-record",
      "description": "transition.rs create_record: the object type, the defaults (defaults), the candidate (the next record id, version 1, created by the user or no one, created and updated now), authorisation of Create with the candidate as new, the initial workflow states, then validate-record against the tenant's schema; accepted, it is a PutRecord, a RecordCreated event and the next record id moves on.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "fields",
          "type": "map<field-id, value>"
        }
      ],
      "returns": "decided",
      "errors": "rejection",
      "let": [
        {
          "name": "def",
          "expr": "try call object-def(d, object, action.create)"
        },
        {
          "name": "c",
          "expr": "d.ctx"
        },
        {
          "name": "filled",
          "expr": "try call defaults(def, fields, c.principal, c.now, d.tenant, d.evidence)"
        },
        {
          "name": "candidate",
          "expr": "record{id: d.next-record, object, version: 1, created-by: match c.principal { user(id) => id, _ => null }, created-at: c.now, updated-at: c.now, fields: filled.values}"
        },
        {
          "name": "d1",
          "expr": "try call require(draft{tenant: d.tenant, ctx: d.ctx, coverage: d.coverage, ops: d.ops, events: d.events, effects: d.effects, evidence: filled.evidence, next-record: d.next-record}, action.create, resource.object(object), subject{new: candidate})"
        },
        {
          "name": "d2",
          "expr": "try call initial-checks(d1, object, candidate)"
        },
        {
          "name": "evidence",
          "expr": "try call validation-into-result(try call validate-record(d2.tenant, d2.coverage, d2.tenant.schema, def, candidate, null, c.principal, c.now), d2.evidence)"
        }
      ],
      "body": "decided{draft: draft{tenant: d2.tenant, ctx: d2.ctx, coverage: d2.coverage, ops: concat(d2.ops, [delta-op.put-record(candidate)]), events: concat(d2.events, [event-body.record-created{record: candidate}]), effects: d2.effects, evidence: evidence, next-record: d2.next-record + 1}, output: output.record{object, id: candidate.id, version: 1}}",
