        "session-lifetime-flow-impl"
      ],
      "steps": [
        {
          "at": 0,
          "event": "sl-issued"
        },
        {
          "at": 10800000,
          "event": "sl-used",
          "payload": {
            "idleHours": 12,
            "absoluteHours": 336
          }
        }
      ],
      "timeUnit": "ms"
    },
