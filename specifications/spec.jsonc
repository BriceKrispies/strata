    {
      "id": "setting-value-check",
      "description": "settings.rs write_setting: the value of a write has the type of the setting: a null is TypeMismatch \"a null is no value of a setting; remove the override instead\"; another value is checked by setting-type-problem and refused with its kind as \"setting <id>: <problem>\" (setting:value_has_the_type); a removal has no value to check.",
      "params": [
        {
          "name": "def",
          "type": "setting-def"
        },
        {
          "name": "setting",
          "type": "setting-id"
        },
        {
          "name": "value",
          "type": "option<value>"
        },
        {
          "name": "evidence",
          "type": "list<check>"
        }
      ],
      "returns": "list<check>",
      "errors": "rejection",
      "body": "match value { None => evidence, Some(v) => match v { null => fail(call setting-refusal(evidence, error-kind.type-mismatch, 'setting:value_has_the_type', 'a null is no value of a setting; remove the override instead')), _ => match call setting-type-problem(def.type, v) { Some(p) => fail(call setting-refusal(evidence, p.kind, 'setting:value_has_the_type', format('setting {}: {}', setting, p.message))), None => concat(evidence, [check{rule: 'setting:value_has_the_type', passed: true, detail: def.type}]) } } }",
      "examples": [
        {
          "args": {
            "def": {
              "id": "theme",
              "label": "theme",
              "type": "string",
              "default": {
                "str": "light"
              },
              "levels": [
                "tenant",
                "team",
                "person"
              ]
            },
            "setting": "theme",
            "value": null,
            "evidence": []
          },
          "result": []
        },
        {
          "args": {
