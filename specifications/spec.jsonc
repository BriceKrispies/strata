              "to": "mail-dispatcher"
            }
          ]
        },
        {
          "id": "dr-note-i",
          "from": "dr-live-i",
          "to": "dr-live-i",
          "on": "dr-report",
          "guard": "event.valid",
          "effects": [
            {
              "set": "accepted",
              "to": "accepted + 1"
            }
          ]
        },
        {
          "id": "dr-reject-i",
          "from": "dr-live-i",
          "to": "dr-live-i",
          "on": "dr-report",
          "otherwise": true,
          "effects": [
            {
              "set": "rejected",
              "to": "rejected + 1"
            },
            {
