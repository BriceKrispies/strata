    {
      "id": "intent-texts",
      "name": "Intent texts",
      "kind": "struct",
      "description": "What the body language cannot compute but the kernel writes into evidence and decisions (WG-4957): the printed form (expr.rs Display) of each default, keyed by object type and field, of each constraint, keyed by object type and constraint, and of each policy condition, keyed by its rule policy:<id>; and whether the name of a CreateTenant is blank (str::trim is empty). The caller derives them from the schema and the intent.",
      "fields": [
        {
          "name": "defaults",
          "type": "map<object-type-id, map<field-id, string>>"
        },
        {
          "name": "constraints",
          "type": "map<object-type-id, map<constraint-id, string>>"
        },
        {
          "name": "conditions",
          "type": "map<string, string>"
        },
        {
          "name": "blank-name",
          "type": "bool"
        }
      ]
    },
    {
      "id": "schema-step",
      "name": "Schema step",
      "kind": "struct",
      "description": "transition.rs apply_change: the working copy after one change and the line that describes it.",
      "fields": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "line",
          "type": "string"
        }
      ]
    },
    {
      "id": "schema-problem",
      "name": "Schema change problem",
