    {
      "id": "capability-parts",
      "description": "capabilities.rs split_once(\"__\"): the text before the first two underscores in a row and the text after them, or none when there are none. The body language has no substring, so the characters are scanned with a lone underscore held back until the next character tells whether it begins the separator.",
      "params": [
        {
          "name": "id",
          "type": "string"
        }
      ],
      "returns": "option<capability-split>",
      "body": "let scan = fold(c in chars(id), s = split-scan{before: '', after: '', held: '', seen: false}, if s.seen then split-scan{before: s.before, after: s.after + c, held: '', seen: true} else if s.held == '_' then (if c == '_' then split-scan{before: s.before, after: '', held: '', seen: true} else split-scan{before: s.before + '_' + c, after: '', held: '', seen: false}) else (if c == '_' then split-scan{before: s.before, after: '', held: '_', seen: false} else split-scan{before: s.before + c, after: '', held: '', seen: false})) in if scan.seen then capability-split{namespace: scan.before, name: scan.after} else null",
      "examples": [
        {
          "args": {
            "id": "member_tiers__promote"
          },
          "result": {
            "namespace": "member_tiers",
            "name": "promote"
          }
        },
        {
          "args": {
            "id": "plain"
          },
          "result": null
        },
        {
          "description": "A lone underscore is no separator.",
          "args": {
            "id": "a_b_c"
          },
          "result": null
        },
        {
          "description": "Three underscores: the first two separate.",
          "args": {
            "id": "a___b"
          },
          "result": {
            "namespace": "a",
            "name": "_b"
          }
        },
        {
          "args": {
            "id": "trailing_"
          },
          "result": null
        },
        {
          "args": {
            "id": "__x"
          },
          "result": {
            "namespace": "",
            "name": "x"
          }
        },
        {
          "args": {
            "id": "a__"
          },
          "result": {
            "namespace": "a",
            "name": ""
          }
        },
        {
          "args": {
            "id": "a_b__c__d"
          },
          "result": {
            "namespace": "a_b",
            "name": "c__d"
          }
        }
      ]
    },
    {
      "id": "capability-namespace",
      "description": "capabilities.rs namespace_of: the namespace of an id of the product form (member_tiers__promote is in member_tiers), or none for an id of the platform form or one whose namespace or name is empty.",
      "params": [
        {
          "name": "id",
          "type": "string"
        }
      ],
      "returns": "option<string>",
      "body": "match call capability-parts(id) { Some(p) => if p.namespace != '' && p.name != '' then p.namespace else null, None => null }",
      "examples": [
        {
          "args": {
            "id": "member_tiers__promote"
          },
          "result": "member_tiers"
        },
        {
          "args": {
            "id": "plain"
          },
          "result": null
        },
        {
          "args": {
            "id": "__x"
          },
          "result": null
        },
        {
          "args": {
            "id": "a__"
          },
          "result": null
        }
      ]
    },
    {
      "id": "capability-grant-problem",
      "description": "capabilities.rs grant_problem: why a role may not grant a capability, or none (D-6590, D-6701): a capability of the product form (its id has two underscores in a row) must be declared in the tenant, and a role that belongs to a product (its id has a namespace) grants only the capabilities of that product. A role of the tenant's own, with no namespace, may grant any declared capability. A name of the platform form is the platform's.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "role",
          "type": "role-id"
        },
        {
          "name": "name",
          "type": "string"
        }
      ],
      "returns": "option<string>",
      "body": "match call capability-parts(name) { None => null, Some(_) => if get(call capabilities-of(schema), name) == null then format('capability {} is neither a platform capability nor declared in the tenant', name) else match call capability-namespace(role) { Some(of-role) => match call capability-namespace(name) { Some(of-capability) => if of-role != of-capability then format('capability {} belongs to product {} and role {} to product {}', name, of-capability, role, of-role) else null, None => null }, None => null } }",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-31"
            },
            "role": "editor",
            "name": "content-edit"
          },
          "result": null
        },
        {
          "description": "A capability of the product form nobody declared.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-31"
            },
            "role": "editor",
            "name": "other__thing"
          },
          "result": "capability other__thing is neither a platform capability nor declared in the tenant"
        },
        {
          "description": "A role of the tenant's own may grant a declared capability.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-31"
            },
            "role": "editor",
            "name": "member_tiers__promote"
          },
          "result": null
        },
        {
          "description": "A role of the same product.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-31"
            },
            "role": "member_tiers__host",
            "name": "member_tiers__promote"
          },
          "result": null
        },
        {
          "description": "A role of another product may not.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-31"
            },
            "role": "crm__agent",
            "name": "member_tiers__promote"
          },
          "result": "capability member_tiers__promote belongs to product member_tiers and role crm__agent to product crm"
        },
        {
          "description": "A name whose namespace is empty is declared but has none.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-6",
              "with": {
                "capabilities": {
                  "__x": {
                    "id": "__x",
                    "name": "X",
                    "description": "d"
                  }
                }
              }
            },
            "role": "crm__agent",
            "name": "__x"
          },
          "result": null
        }
      ]
    },
    {
      "id": "capability-problems",
      "description": "capabilities.rs declaration_problems (D-6590): the problems of the capabilities a schema declares, in the order of their ids: more than 200, then each: held under another key than its id; an id that is not a namespace and a name of lower-case letters, digits and underscores each starting with a letter, joined by two underscores, of at most 128 bytes; a blank name.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        }
      ],
      "returns": "list<string>",
      "body": "match schema.capabilities { None => [], Some(declared) => concat(call limit-count-problem('capabilities', length(keys(declared)), 200), fold(k in keys(declared), ps = [], concat(ps, fold(d in values(declared), qs = [], if get(declared, k) == d then call capability-def-problems(k, d) else qs)))) }",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-6"
            }
          },
          "result": []
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-31",
              "with": {
                "capabilities.member_tiers__promote.name": "Name",
                "capabilities.member_tiers__promote.description": "d"
              }
            }
          },
          "result": []
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-6",
              "with": {
                "capabilities": {
                  "a__b": {
                    "id": "a__b",
                    "name": "Name",
                    "description": "d"
                  },
                  "Bad": {
                    "id": "Bad",
                    "name": "Name",
                    "description": "d"
                  },
                  "c__d": {
                    "id": "c__d",
                    "name": " ",
                    "description": "d"
                  }
                }
              }
            }
          },
          "result": [
            "capability Bad: an id is a namespace and a name of lower-case letters, digits and underscores, joined by two underscores",
            "capability c__d: a capability needs a name"
          ]
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-6",
              "with": {
                "capabilities": {
                  "other__x": {
                    "id": "a__b",
                    "name": "Name",
                    "description": "d"
                  }
                }
              }
            }
          },
          "result": [
            "capability a__b: held under the key other__x"
          ]
        },
        {
          "description": "More than 200 capabilities.",
          "args": {
            "schema": {
              "version": 2,
              "objects": {
                "note": {
                  "id": "note",
                  "label": "Note",
                  "fields": {
                    "author": {
                      "id": "author",
                      "label": "Author",
                      "ty": {
                        "ref": {
                          "target": "person",
                          "on-delete": "set-null"
                        }
                      },
                      "required": false,
                      "unique": false
                    },
                    "body": {
