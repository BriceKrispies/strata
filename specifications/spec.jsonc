  "behaviors": [
    {"id":"emailed-link-flow","name":"Emailed link","subject":"identity-service","initial":"ml-idle","description":"One sign-in link: issued, presented, accepted once in the requesting browser within its lifetime of 15 ticks.","variables":[{"name":"issuedAt","type":"number","initial":0},{"name":"sessions","type":"number","initial":0}],"states":[{"id":"ml-idle","name":"No link"},{"id":"ml-pending","name":"Link issued"},{"id":"ml-used","name":"Link used"}],"transitions":[{"id":"ml-issue","from":"ml-idle","to":"ml-pending","on":"ml-requested","effects":[{"set":"issuedAt","to":"time"},{"emit":"ml-mailed"}]},{"id":"ml-accept-unchecked","from":"ml-pending","to":"ml-used","on":"ml-presented","faultOnly":true,"guard":"event.token == 'good'","description":"Defect: accepts the right token without checking lifetime or browser.","effects":[{"set":"sessions","to":"sessions + 1"},{"emit":"ml-session-issued"}]},{"id":"ml-accept-untimed","from":"ml-pending","to":"ml-used","on":"ml-presented","faultOnly":true,"guard":"event.token == 'good' && event.browser == 'requester'","description":"Defect: accepts the right token without checking lifetime or browser.","effects":[{"set":"sessions","to":"sessions + 1"},{"emit":"ml-session-issued"}]},{"id":"ml-accept-unbrowsed","from":"ml-pending","to":"ml-used","on":"ml-presented","faultOnly":true,"guard":"event.token == 'good' && time - issuedAt <= 15","description":"Defect: accepts the right token without checking lifetime or browser.","effects":[{"set":"sessions","to":"sessions + 1"},{"emit":"ml-session-issued"}]},{"id":"ml-accept","from":"ml-pending","to":"ml-used","on":"ml-presented","guard":"event.token == 'good' && event.browser == 'requester' && time - issuedAt <= 15","effects":[{"set":"sessions","to":"sessions + 1"},{"emit":"ml-session-issued"}]},{"id":"ml-refuse-pending","from":"ml-pending","to":"ml-pending","on":"ml-presented","effects":[{"emit":"ml-refused"}]},{"id":"ml-accept-again","from":"ml-used","to":"ml-used","on":"ml-presented","faultOnly":true,"description":"Defect: accepts a link that was already used.","effects":[{"set":"sessions","to":"sessions + 1"},{"emit":"ml-session-issued"}]},{"id":"ml-refuse-used","from":"ml-used","to":"ml-used","on":"ml-presented","effects":[{"emit":"ml-refused"}]}]},
    {"id":"emailed-link-flow-impl","name":"Emailed link (implementation)","subject":"identity-service","level":"implementation","initial":"ml-idle-i","description":"One sign-in link as the identity service keeps it: a challenge row (rec-challenge, keyed by challenge-id) holding the hash of the token, the browser binding and the expiry. The expiry is the tick of issue plus the lifetime of 15 ticks and the link is accepted through that tick. It is accepted once, only with the right token, in the browser that asked.","transaction":{"scope":"transition","isolation":"serializable"},"variables":[{"name":"expiresAt","type":"number","initial":15,"repr":"timestamp"},{"name":"sessions","type":"number","initial":0,"repr":"u32"}],"states":[{"id":"ml-idle-i","name":"No link","ignores":["ml-presented"]},{"id":"ml-pending-i","name":"Link issued","ignores":["ml-requested"]},{"id":"ml-used-i","name":"Link used","ignores":["ml-requested"]}],"transitions":[{"id":"ml-issue-i","from":"ml-idle-i","to":"ml-pending-i","on":"ml-requested","otherwise":true,"effects":[{"set":"expiresAt","to":"time + 15"},{"emit":"ml-mailed","to":"mail-service"}]},{"id":"ml-accept-i","from":"ml-pending-i","to":"ml-used-i","on":"ml-presented","guard":"event.token == 'good' && event.browser == 'requester' && time <= expiresAt","effects":[{"set":"sessions","to":"sessions + 1"},{"emit":"ml-session-issued","to":"web-application"}]},{"id":"ml-refuse-pending-i","from":"ml-pending-i","to":"ml-pending-i","on":"ml-presented","otherwise":true,"effects":[{"emit":"ml-refused","to":"web-application"}]},{"id":"ml-refuse-used-i","from":"ml-used-i","to":"ml-used-i","on":"ml-presented","otherwise":true,"effects":[{"emit":"ml-refused","to":"web-application"}]}],"refines":"emailed-link-flow","refinement":{"states":{"ml-idle-i":"ml-idle","ml-pending-i":"ml-pending","ml-used-i":"ml-used"},"variables":{"issuedAt":"expiresAt - 15","sessions":"sessions"},"transitions":{"ml-issue-i":"ml-issue","ml-accept-i":"ml-accept","ml-refuse-pending-i":"ml-refuse-pending","ml-refuse-used-i":"ml-refuse-used"}}},
    {"id":"oidc-callback-flow","name":"OpenID Connect callback","subject":"identity-service","initial":"oidc-idle","description":"One sign-in through a provider. The pending request carries the state value s1.","variables":[{"name":"federatedSessions","type":"number","initial":0}],"states":[{"id":"oidc-idle","name":"No request"},{"id":"oidc-awaiting","name":"Awaiting callback"},{"id":"oidc-done","name":"Signed in","terminal":true}],"transitions":[{"id":"oidc-begin","from":"oidc-idle","to":"oidc-awaiting","on":"oidc-started","effects":[{"emit":"oidc-redirected"}]},{"id":"oidc-accept-any-state","from":"oidc-awaiting","to":"oidc-done","on":"oidc-callback","faultOnly":true,"description":"Defect: accepts a callback without comparing its state value.","effects":[{"set":"federatedSessions","to":"federatedSessions + 1"},{"emit":"oidc-session-issued"}]},{"id":"oidc-accept","from":"oidc-awaiting","to":"oidc-done","on":"oidc-callback","guard":"event.state == 's1'","effects":[{"set":"federatedSessions","to":"federatedSessions + 1"},{"emit":"oidc-session-issued"}]},{"id":"oidc-refuse","from":"oidc-awaiting","to":"oidc-awaiting","on":"oidc-callback","effects":[{"emit":"oidc-refused"}]}]},
    {"id":"oidc-callback-flow-impl","name":"OpenID Connect callback (implementation)","subject":"identity-service","level":"implementation","initial":"oidc-idle-i","description":"One sign-in through a provider. The state value of the pending request is kept with its challenge (rec-challenge, keyed by challenge-id) and compared with the one the callback carries; a callback with another value is refused and the request stays open.","transaction":{"scope":"transition","isolation":"serializable"},"variables":[{"name":"expectedState","type":"string","initial":"s1","repr":"string"},{"name":"federatedSessions","type":"number","initial":0,"repr":"u32"}],"states":[{"id":"oidc-idle-i","name":"No request","ignores":["oidc-callback"]},{"id":"oidc-awaiting-i","name":"Awaiting the callback","ignores":["oidc-started"]},{"id":"oidc-done-i","name":"Signed in","terminal":true}],"transitions":[{"id":"oidc-begin-i","from":"oidc-idle-i","to":"oidc-awaiting-i","on":"oidc-started","otherwise":true,"effects":[{"emit":"oidc-redirected","to":"web-application"}]},{"id":"oidc-accept-i","from":"oidc-awaiting-i","to":"oidc-done-i","on":"oidc-callback","guard":"event.state == expectedState","effects":[{"set":"federatedSessions","to":"federatedSessions + 1"},{"emit":"oidc-session-issued","to":"web-application"}]},{"id":"oidc-refuse-i","from":"oidc-awaiting-i","to":"oidc-awaiting-i","on":"oidc-callback","otherwise":true,"effects":[{"emit":"oidc-refused","to":"web-application"}]}],"refines":"oidc-callback-flow","refinement":{"states":{"oidc-idle-i":"oidc-idle","oidc-awaiting-i":"oidc-awaiting","oidc-done-i":"oidc-done"},"variables":{"federatedSessions":"federatedSessions"},"transitions":{"oidc-begin-i":"oidc-begin","oidc-accept-i":"oidc-accept","oidc-refuse-i":"oidc-refuse"}}},
    {"id":"session-authority-flow","name":"Session authority","subject":"identity-service","initial":"sa-live","description":"The identity service's record of one session.","variables":[{"name":"revoked","type":"boolean","initial":false},{"name":"revokedAt","type":"number","initial":0}],"states":[{"id":"sa-live","name":"Live"},{"id":"sa-revoked","name":"Revoked"}],"transitions":[{"id":"sa-revoke","from":"sa-live","to":"sa-revoked","on":"sr-revoked","effects":[{"set":"revoked","to":true},{"set":"revokedAt","to":"time"},{"emit":"sr-notice"}]},{"id":"sa-answer-live","from":"sa-live","to":"sa-live","on":"sr-lookup","effects":[{"emit":"sr-lookup-answer","payload":{"valid":true}}]},{"id":"sa-answer-revoked","from":"sa-revoked","to":"sa-revoked","on":"sr-lookup","effects":[{"emit":"sr-lookup-answer","payload":{"valid":false}}]}]},
    {"id":"session-authority-flow-impl","name":"Session authority (implementation)","subject":"identity-service","level":"implementation","initial":"sa-live-i","description":"The identity service record of one session (rec-session, keyed by session-id): revoked-at is set at the revocation and a lookup answers from it. The revocation notice to the gateways may be lost; a lookup is never answered from a copy.","transaction":{"scope":"transition","isolation":"serializable"},"variables":[{"name":"revoked","type":"boolean","initial":false,"repr":"bool"},{"name":"revokedAt","type":"number","initial":0,"repr":"timestamp"}],"states":[{"id":"sa-live-i","name":"Session live"},{"id":"sa-revoked-i","name":"Session revoked","ignores":["sr-revoked"]}],"transitions":[{"id":"sa-revoke-i","from":"sa-live-i","to":"sa-revoked-i","on":"sr-revoked","otherwise":true,"effects":[{"set":"revoked","to":true},{"set":"revokedAt","to":"time"},{"emit":"sr-notice","to":"gateway"}]},{"id":"sa-answer-live-i","from":"sa-live-i","to":"sa-live-i","on":"sr-lookup","otherwise":true,"effects":[{"emit":"sr-lookup-answer","to":"gateway","payload":{"valid":true}}]},{"id":"sa-answer-revoked-i","from":"sa-revoked-i","to":"sa-revoked-i","on":"sr-lookup","otherwise":true,"effects":[{"emit":"sr-lookup-answer","to":"gateway","payload":{"valid":false}}]}],"refines":"session-authority-flow","refinement":{"states":{"sa-live-i":"sa-live","sa-revoked-i":"sa-revoked"},"variables":{"revoked":"revoked","revokedAt":"revokedAt"},"transitions":{"sa-revoke-i":"sa-revoke","sa-answer-live-i":"sa-answer-live","sa-answer-revoked-i":"sa-answer-revoked"}}},
    {"id":"gateway-session-flow","name":"Gateway session copy","subject":"gateway","initial":"gs-ready","description":"The gateway's copy of the session. It trusts the copy for 5 ticks, then asks again.","variables":[{"name":"valid","type":"boolean","initial":true},{"name":"checkedAt","type":"number","initial":0},{"name":"staleAccept","type":"boolean","initial":false}],"states":[{"id":"gs-ready","name":"Ready"},{"id":"gs-checking","name":"Asking the identity service"}],"transitions":[{"id":"gs-hear-revocation","from":"gs-ready","to":"gs-ready","on":"sr-notice","effects":[{"set":"valid","to":false}]},{"id":"gs-accept-without-recheck","from":"gs-ready","to":"gs-ready","on":"sr-request","faultOnly":true,"guard":"valid","description":"Defect: trusts the copy however old it is.","effects":[{"set":"staleAccept","to":"staleAccept || (session-authority-flow.revoked && time - session-authority-flow.revokedAt >= 5)"},{"emit":"sr-accepted"}]},{"id":"gs-accept-fresh","from":"gs-ready","to":"gs-ready","on":"sr-request","guard":"valid && time - checkedAt < 5","effects":[{"set":"staleAccept","to":"staleAccept || (session-authority-flow.revoked && time - session-authority-flow.revokedAt >= 5)"},{"emit":"sr-accepted"}]},{"id":"gs-refuse-known","from":"gs-ready","to":"gs-ready","on":"sr-request","guard":"!valid","effects":[{"emit":"sr-refused"}]},{"id":"gs-recheck","from":"gs-ready","to":"gs-checking","on":"sr-request","guard":"valid && time - checkedAt >= 5","effects":[{"emit":"sr-lookup"}]},{"id":"gs-recheck-live","from":"gs-checking","to":"gs-ready","on":"sr-lookup-answer","guard":"event.valid == true","effects":[{"set":"checkedAt","to":"time"},{"set":"staleAccept","to":"staleAccept || (session-authority-flow.revoked && time - session-authority-flow.revokedAt >= 5)"},{"emit":"sr-accepted"}]},{"id":"gs-recheck-revoked","from":"gs-checking","to":"gs-ready","on":"sr-lookup-answer","guard":"event.valid == false","effects":[{"set":"valid","to":false},{"emit":"sr-refused"}]}]},
    {"id":"gateway-session-flow-impl","name":"Gateway session copy (implementation)","subject":"gateway","level":"implementation","initial":"gs-ready-i","description":"The gateway copy of one session, held in the gateway process. It trusts the copy for 5 ticks after the last check, then asks the identity service again; a revocation notice marks the copy invalid at once. staleAccept is the observation variable of the revocation bound: it records an acceptance made 5 or more ticks after the revocation.","transaction":{"scope":"transition","isolation":"serializable"},"variables":[{"name":"valid","type":"boolean","initial":true,"repr":"bool"},{"name":"checkedAt","type":"number","initial":0,"repr":"timestamp"},{"name":"staleAccept","type":"boolean","initial":false,"repr":"bool"}],"states":[{"id":"gs-ready-i","name":"Copy held","ignores":["sr-lookup-answer"]},{"id":"gs-checking-i","name":"Asking the identity service","ignores":["sr-notice","sr-request"]}],"transitions":[{"id":"gs-hear-revocation-i","from":"gs-ready-i","to":"gs-ready-i","on":"sr-notice","otherwise":true,"effects":[{"set":"valid","to":false}]},{"id":"gs-accept-fresh-i","from":"gs-ready-i","to":"gs-ready-i","on":"sr-request","guard":"valid && time - checkedAt < 5","effects":[{"set":"staleAccept","to":"staleAccept || (session-authority-flow-impl.revoked && time - session-authority-flow-impl.revokedAt >= 5)"},{"emit":"sr-accepted","to":"web-application"}]},{"id":"gs-refuse-known-i","from":"gs-ready-i","to":"gs-ready-i","on":"sr-request","guard":"!valid","effects":[{"emit":"sr-refused","to":"web-application"}]},{"id":"gs-recheck-i","from":"gs-ready-i","to":"gs-checking-i","on":"sr-request","guard":"valid && time - checkedAt >= 5","effects":[{"emit":"sr-lookup","to":"identity-service"}]},{"id":"gs-recheck-live-i","from":"gs-checking-i","to":"gs-ready-i","on":"sr-lookup-answer","guard":"event.valid == true","effects":[{"set":"checkedAt","to":"time"},{"set":"staleAccept","to":"staleAccept || (session-authority-flow-impl.revoked && time - session-authority-flow-impl.revokedAt >= 5)"},{"emit":"sr-accepted","to":"web-application"}]},{"id":"gs-recheck-revoked-i","from":"gs-checking-i","to":"gs-ready-i","on":"sr-lookup-answer","guard":"event.valid == false","effects":[{"set":"valid","to":false},{"emit":"sr-refused","to":"web-application"}]}],"refines":"gateway-session-flow","refinement":{"states":{"gs-ready-i":"gs-ready","gs-checking-i":"gs-checking"},"variables":{"valid":"valid","checkedAt":"checkedAt","staleAccept":"staleAccept"},"transitions":{"gs-hear-revocation-i":"gs-hear-revocation","gs-accept-fresh-i":"gs-accept-fresh","gs-refuse-known-i":"gs-refuse-known","gs-recheck-i":"gs-recheck","gs-recheck-live-i":"gs-recheck-live","gs-recheck-revoked-i":"gs-recheck-revoked"}}},
    {"id":"job-lease-flow","name":"Job lease","subject":"automation-worker","initial":"jl-waiting","description":"One job. Every grant raises the token, and a result is recorded only with the current token.","variables":[{"name":"token","type":"number","initial":0},{"name":"completions","type":"number","initial":0},{"name":"acceptedToken","type":"number","initial":0}],"states":[{"id":"jl-waiting","name":"Waiting"},{"id":"jl-leased","name":"Leased"},{"id":"jl-done","name":"Completed"}],"transitions":[{"id":"jl-grant","from":"jl-waiting","to":"jl-leased","on":"job-due","effects":[{"set":"token","to":"token + 1"},{"emit":"lease-granted"}]},{"id":"jl-regrant","from":"jl-leased","to":"jl-leased","on":"lease-expired","effects":[{"set":"token","to":"token + 1"},{"emit":"lease-granted"}]},{"id":"jl-complete-any-token","from":"jl-leased","to":"jl-done","on":"work-reported","faultOnly":true,"description":"Defect: records a result without checking its token.","effects":[{"set":"completions","to":"completions + 1"},{"set":"acceptedToken","to":"event.token"},{"emit":"job-completed"}]},{"id":"jl-complete","from":"jl-leased","to":"jl-done","on":"work-reported","guard":"event.token == token","effects":[{"set":"completions","to":"completions + 1"},{"set":"acceptedToken","to":"event.token"},{"emit":"job-completed"}]},{"id":"jl-refuse-stale","from":"jl-leased","to":"jl-leased","on":"work-reported","effects":[{"emit":"result-refused"}]},{"id":"jl-refuse-after-done","from":"jl-done","to":"jl-done","on":"work-reported","effects":[{"emit":"result-refused"}]}]},
    {"id":"origin-content-flow","name":"Origin content","subject":"runtime","initial":"oc-live","description":"The published version of one page at the origin.","variables":[{"name":"version","type":"number","initial":1},{"name":"changedAt","type":"number","initial":0}],"states":[{"id":"oc-live","name":"Live"}],"transitions":[{"id":"oc-publish","from":"oc-live","to":"oc-live","on":"ec-published","effects":[{"set":"version","to":"version + 1"},{"set":"changedAt","to":"time"},{"emit":"ec-purge"}]},{"id":"oc-answer","from":"oc-live","to":"oc-live","on":"ec-origin-fetch","effects":[{"emit":"ec-origin-answer","payload":{"version":"version"}}]}]},
    {"id":"edge-copy-flow","name":"Edge copy","subject":"delivery-network","initial":"eg-ready","description":"The edge copy of the page. It is dropped by a purge and revalidated after a lifetime of 5 ticks.","variables":[{"name":"held","type":"number","initial":1},{"name":"storedAt","type":"number","initial":0},{"name":"staleServed","type":"boolean","initial":false}],"states":[{"id":"eg-ready","name":"Ready"},{"id":"eg-fetching","name":"Fetching from the origin"}],"transitions":[{"id":"eg-purge","from":"eg-ready","to":"eg-ready","on":"ec-purge","effects":[{"set":"held","to":0}]},{"id":"eg-serve-past-lifetime","from":"eg-ready","to":"eg-ready","on":"ec-request","faultOnly":true,"guard":"held > 0","description":"Defect: serves the copy however old it is.","effects":[{"set":"staleServed","to":"staleServed || (held != origin-content-flow.version && time - origin-content-flow.changedAt >= 5)"},{"emit":"ec-served"}]},{"id":"eg-serve","from":"eg-ready","to":"eg-ready","on":"ec-request","guard":"held > 0 && time - storedAt < 5","effects":[{"set":"staleServed","to":"staleServed || (held != origin-content-flow.version && time - origin-content-flow.changedAt >= 5)"},{"emit":"ec-served"}]},{"id":"eg-fetch","from":"eg-ready","to":"eg-fetching","on":"ec-request","effects":[{"emit":"ec-origin-fetch"}]},{"id":"eg-store","from":"eg-fetching","to":"eg-ready","on":"ec-origin-answer","effects":[{"set":"held","to":"event.version"},{"set":"storedAt","to":"time"},{"emit":"ec-served"}]}]},
    {"id":"provisioning-flow","name":"Tenant provisioning","subject":"control-plane","initial":"pv-idle","description":"Create the database, apply the layout, install the template, then report the tenant as active.","variables":[{"name":"database","type":"boolean","initial":false},{"name":"layout","type":"boolean","initial":false},{"name":"template","type":"boolean","initial":false},{"name":"active","type":"boolean","initial":false}],"states":[{"id":"pv-idle","name":"Idle"},{"id":"pv-creating","name":"Creating the database"},{"id":"pv-laying","name":"Applying the layout"},{"id":"pv-installing","name":"Installing the template"},{"id":"pv-active","name":"Active","terminal":true},{"id":"pv-failed","name":"Rolled back","terminal":true}],"transitions":[{"id":"pv-start","from":"pv-idle","to":"pv-creating","on":"pv-requested","effects":[{"emit":"pv-database-created"}]},{"id":"pv-activate-early","from":"pv-creating","to":"pv-active","on":"pv-database-created","faultOnly":true,"description":"Defect: reports the tenant active as soon as its database exists.","effects":[{"set":"database","to":true},{"set":"active","to":true},{"emit":"pv-activated"}]},{"id":"pv-created","from":"pv-creating","to":"pv-laying","on":"pv-database-created","effects":[{"set":"database","to":true},{"emit":"pv-layout-applied","after":2}]},{"id":"pv-laid","from":"pv-laying","to":"pv-installing","on":"pv-layout-applied","effects":[{"set":"layout","to":true},{"emit":"pv-template-installed","after":2}]},{"id":"pv-installed","from":"pv-installing","to":"pv-active","on":"pv-template-installed","effects":[{"set":"template","to":true},{"set":"active","to":true},{"emit":"pv-activated"}]},{"id":"pv-fail-laying","from":"pv-laying","to":"pv-failed","on":"pv-step-failed","effects":[{"set":"database","to":false},{"emit":"pv-rolled-back"}]},{"id":"pv-fail-installing","from":"pv-installing","to":"pv-failed","on":"pv-step-failed","effects":[{"set":"database","to":false},{"set":"layout","to":false},{"emit":"pv-rolled-back"}]}]},
    {"id":"proposal-flow","name":"Change proposal","subject":"agent-gateway","initial":"cp-idle","description":"A change is projected, then applied directly when policy classes it as safe, or after approval when it is risky.","variables":[{"name":"risky","type":"boolean","initial":false},{"name":"projected","type":"boolean","initial":false},{"name":"cleared","type":"boolean","initial":false},{"name":"applied","type":"boolean","initial":false}],"states":[{"id":"cp-idle","name":"No proposal"},{"id":"cp-projecting","name":"Projecting"},{"id":"cp-awaiting","name":"Awaiting approval"},{"id":"cp-ready","name":"Cleared"},{"id":"cp-closed","name":"Rejected"},{"id":"cp-done","name":"Applied","terminal":true}],"transitions":[{"id":"cp-open","from":"cp-idle","to":"cp-projecting","on":"cp-proposed","effects":[{"set":"risky","to":"event.risky"},{"emit":"cp-projected"}]},{"id":"cp-clear-safe","from":"cp-projecting","to":"cp-ready","on":"cp-projected","guard":"!risky","effects":[{"set":"projected","to":true},{"set":"cleared","to":true}]},{"id":"cp-hold-risky","from":"cp-projecting","to":"cp-awaiting","on":"cp-projected","guard":"risky","effects":[{"set":"projected","to":true}]},{"id":"cp-approve","from":"cp-awaiting","to":"cp-ready","on":"cp-approved","effects":[{"set":"cleared","to":true}]},{"id":"cp-reject","from":"cp-awaiting","to":"cp-closed","on":"cp-rejected"},{"id":"cp-apply-unapproved","from":"cp-awaiting","to":"cp-done","on":"cp-apply-requested","faultOnly":true,"description":"Defect: applies a risky change that nobody approved.","effects":[{"set":"applied","to":true},{"emit":"cp-applied"}]},{"id":"cp-refuse-awaiting","from":"cp-awaiting","to":"cp-awaiting","on":"cp-apply-requested","effects":[{"emit":"cp-refused"}]},{"id":"cp-apply-rejected","from":"cp-closed","to":"cp-done","on":"cp-apply-requested","faultOnly":true,"description":"Defect: applies a change that was rejected.","effects":[{"set":"applied","to":true},{"emit":"cp-applied"}]},{"id":"cp-refuse-closed","from":"cp-closed","to":"cp-closed","on":"cp-apply-requested","effects":[{"emit":"cp-refused"}]},{"id":"cp-apply","from":"cp-ready","to":"cp-done","on":"cp-apply-requested","effects":[{"set":"applied","to":true},{"emit":"cp-applied"}]}]},
    {"id":"arc-outbox-consumer-flow","name":"Notice subscriber","subject":"connector-runner","initial":"arc-oc-ready","description":"One subscriber receiving notices of one tenant. A notice whose sequence number is already applied is acknowledged and makes no further effect.","variables":[{"name":"applied","type":"number","initial":0},{"name":"effects","type":"number","initial":0}],"states":[{"id":"arc-oc-ready","name":"Ready"}],"transitions":[{"id":"arc-ob-apply","from":"arc-oc-ready","to":"arc-oc-ready","on":"arc-ob-delivered","guard":"event.seq > applied","effects":[{"set":"applied","to":"event.seq"},{"set":"effects","to":"effects + 1"},{"emit":"arc-ob-acknowledged"}]},{"id":"arc-ob-apply-again","from":"arc-oc-ready","to":"arc-oc-ready","on":"arc-ob-delivered","guard":"event.seq <= applied","faultOnly":true,"description":"Defect: makes the effect of a notice it has already applied.","effects":[{"set":"effects","to":"effects + 1"},{"emit":"arc-ob-acknowledged"}]},{"id":"arc-ob-skip-seen","from":"arc-oc-ready","to":"arc-oc-ready","on":"arc-ob-delivered","guard":"event.seq <= applied","effects":[{"emit":"arc-ob-acknowledged"}]}]},
    {"id":"arc-outbox-delivery-flow","name":"Outbox delivery after a stop","subject":"runtime","initial":"arc-od-idle","description":"A commit leaves events unpublished. The runtime that committed publishes them, or else the outbox job does.","variables":[{"name":"pending","type":"boolean","initial":false}],"states":[{"id":"arc-od-idle","name":"Nothing pending"},{"id":"arc-od-pending","name":"Events pending"},{"id":"arc-od-done","name":"Published","terminal":true}],"transitions":[{"id":"arc-od-commit","from":"arc-od-idle","to":"arc-od-pending","on":"rt-committed","effects":[{"set":"pending","to":true}]},{"id":"arc-od-publish-now","from":"arc-od-pending","to":"arc-od-done","on":"arc-ob-publish-now","effects":[{"set":"pending","to":false},{"emit":"arc-ob-published"}]},{"id":"arc-od-sweep","from":"arc-od-pending","to":"arc-od-done","on":"arc-ob-sweep-due","effects":[{"set":"pending","to":false},{"emit":"arc-ob-published"}]}]},
    {"id":"arc-rolling-change-flow","name":"Rolling change of format","subject":"runtime","initial":"arc-rc-old","description":"Two versions run together while a deployment replaces the older one. Commits are written in the older format until the older version has stopped.","variables":[{"name":"oldRunning","type":"boolean","initial":true},{"name":"newFormat","type":"boolean","initial":false}],"states":[{"id":"arc-rc-old","name":"Older version only"},{"id":"arc-rc-mixed","name":"Both versions running"},{"id":"arc-rc-new","name":"Newer version only"}],"transitions":[{"id":"arc-rl-start","from":"arc-rc-old","to":"arc-rc-mixed","on":"arc-rl-deploy-started"},{"id":"arc-rl-commit-early","from":"arc-rc-mixed","to":"arc-rc-mixed","on":"arc-rl-commit","faultOnly":true,"description":"Defect: writes the newer format while the older version still runs.","effects":[{"set":"newFormat","to":true},{"emit":"arc-rl-committed"}]},{"id":"arc-rl-commit-old","from":"arc-rc-mixed","to":"arc-rc-mixed","on":"arc-rl-commit","effects":[{"emit":"arc-rl-committed"}]},{"id":"arc-rl-finish","from":"arc-rc-mixed","to":"arc-rc-new","on":"arc-rl-deploy-finished","effects":[{"set":"oldRunning","to":false}]},{"id":"arc-rl-commit-new","from":"arc-rc-new","to":"arc-rc-new","on":"arc-rl-commit","effects":[{"set":"newFormat","to":true},{"emit":"arc-rl-committed"}]}]},
    {"id":"preview-link-flow","name":"Preview link","subject":"gateway","initial":"pl-idle","description":"One preview link, valid for 15 ticks from the tick of its pl-issue event (the tick its link is issued).","variables":[{"name":"issuedAt","type":"number","initial":0},{"name":"shown","type":"number","initial":0}],"states":[{"id":"pl-idle","name":"Not issued"},{"id":"pl-issued","name":"Issued"}],"transitions":[{"id":"pl-link-issued","from":"pl-idle","to":"pl-issued","on":"pl-issue","effects":[{"set":"issuedAt","to":"time"}],"faultOnly":false},{"id":"pl-show-expired","from":"pl-issued","to":"pl-issued","on":"pl-presented","faultOnly":true,"description":"Defect: shows the draft after its expiry.","effects":[{"set":"shown","to":"shown + 1"},{"emit":"pl-shown"}]},{"id":"pl-show","from":"pl-issued","to":"pl-issued","on":"pl-presented","guard":"time - issuedAt < 15","effects":[{"set":"shown","to":"shown + 1"},{"emit":"pl-shown"}]},{"id":"pl-refuse","from":"pl-issued","to":"pl-issued","on":"pl-presented","effects":[{"emit":"pl-refused"}]}]},
    {"id":"inbound-run-flow","name":"Inbound delivery","subject":"automation-worker","initial":"iw-idle","description":"One event key. The first delivery starts a run and a repeated delivery of the same event starts nothing.","variables":[{"name":"runs","type":"number","initial":0}],"states":[{"id":"iw-idle","name":"No delivery"},{"id":"iw-accepted","name":"Run started"}],"transitions":[{"id":"iw-first","from":"iw-idle","to":"iw-accepted","on":"iw-received","effects":[{"set":"runs","to":"runs + 1"},{"emit":"iw-run-started"}]},{"id":"iw-accept-again","from":"iw-accepted","to":"iw-accepted","on":"iw-received","faultOnly":true,"description":"Defect: starts a second run for a repeated delivery.","effects":[{"set":"runs","to":"runs + 1"},{"emit":"iw-run-started"}]},{"id":"iw-repeat","from":"iw-accepted","to":"iw-accepted","on":"iw-received","effects":[{"emit":"iw-ignored"}]}]},
    {"id":"cv-change-flow","name":"Confirmed change","subject":"conversation-service","initial":"cf-idle","description":"One change proposed by the assistant: previewed, then applied only after the person confirms it.","variables":[{"name":"previewed","type":"boolean","initial":false},{"name":"confirmed","type":"boolean","initial":false},{"name":"applied","type":"boolean","initial":false}],"states":[{"id":"cf-idle","name":"No change"},{"id":"cf-previewed","name":"Preview shown"},{"id":"cf-confirmed","name":"Confirmed"},{"id":"cf-applied","name":"Applied","terminal":true},{"id":"cf-cancelled","name":"Cancelled","terminal":true}],"transitions":[{"id":"cf-propose","from":"cf-idle","to":"cf-previewed","on":"cv-proposed","effects":[{"set":"previewed","to":true},{"emit":"cv-previewed"}]},{"id":"cf-confirm","from":"cf-previewed","to":"cf-confirmed","on":"cv-confirmed","effects":[{"set":"confirmed","to":true}]},{"id":"cf-apply","from":"cf-confirmed","to":"cf-applied","on":"cv-apply-requested","effects":[{"set":"applied","to":true},{"emit":"cv-applied"}]},{"id":"cf-apply-unconfirmed","from":"cf-previewed","to":"cf-applied","on":"cv-apply-requested","faultOnly":true,"description":"Defect: applies a previewed change that the person has not confirmed.","effects":[{"set":"applied","to":true},{"emit":"cv-applied"}]},{"id":"cf-refuse-unconfirmed","from":"cf-previewed","to":"cf-previewed","on":"cv-apply-requested","effects":[{"emit":"cv-refused"}]},{"id":"cf-cancel","from":"cf-previewed","to":"cf-cancelled","on":"cv-cancel","effects":[{"emit":"cv-cancelled"}]},{"id":"cf-refuse-cancelled","from":"cf-cancelled","to":"cf-cancelled","on":"cv-apply-requested","effects":[{"emit":"cv-refused"}]}]},
    {"id":"cv-authority-flow","name":"Operation under withdrawable permission","subject":"conversation-service","initial":"ca-waiting","description":"One operation the assistant runs for a person. It commits only while the permission the person holds at that moment allows it.","variables":[{"name":"permitted","type":"boolean","initial":true},{"name":"applied","type":"boolean","initial":false}],"states":[{"id":"ca-waiting","name":"Awaiting run"},{"id":"ca-done","name":"Committed","terminal":true}],"transitions":[{"id":"ca-withdraw","from":"ca-waiting","to":"ca-waiting","on":"cv-permission-withdrawn","effects":[{"set":"permitted","to":false}]},{"id":"ca-run","from":"ca-waiting","to":"ca-done","on":"cv-operation-run","guard":"permitted","effects":[{"set":"applied","to":true},{"emit":"cv-operation-committed"}]},{"id":"ca-run-stale","from":"ca-waiting","to":"ca-done","on":"cv-operation-run","faultOnly":true,"description":"Defect: runs the operation on the permission held when the preview was made.","effects":[{"set":"applied","to":true},{"emit":"cv-operation-committed"}]},{"id":"ca-refuse","from":"ca-waiting","to":"ca-waiting","on":"cv-operation-run","guard":"!permitted","effects":[{"emit":"cv-operation-refused"}]}]},
    {"id":"saml-assertion-flow","name":"SAML assertion use","subject":"identity-service","initial":"sa-fresh","description":"One SAML assertion. The first presentation yields a session, and a presentation after it is refused.","variables":[{"name":"sessions","type":"number","initial":0}],"states":[{"id":"sa-fresh","name":"Not presented"},{"id":"sa-spent","name":"Presented"}],"transitions":[{"id":"sam-accept-replay","from":"sa-spent","to":"sa-spent","on":"saml-response","faultOnly":true,"description":"Defect: accepts an assertion that was already used.","effects":[{"set":"sessions","to":"sessions + 1"},{"emit":"saml-session-issued"}]},{"id":"sam-accept","from":"sa-fresh","to":"sa-spent","on":"saml-response","effects":[{"set":"sessions","to":"sessions + 1"},{"emit":"saml-session-issued"}]},{"id":"sam-refuse","from":"sa-spent","to":"sa-spent","on":"saml-response","effects":[{"emit":"saml-refused"}]}]},
    {"id":"guess-throttle-flow","name":"Password guessing throttle","subject":"identity-service","initial":"gt-open","description":"Password attempts for one realm. Three failures close the throttle, and an attempt evaluated while it is closed is counted.","variables":[{"name":"failures","type":"number","initial":0},{"name":"throttled","type":"number","initial":0}],"states":[{"id":"gt-open","name":"Accepting attempts"}],"transitions":[{"id":"gt-ignore-throttle","from":"gt-open","to":"gt-open","on":"pw-attempt","faultOnly":true,"guard":"failures >= 3","description":"Defect: evaluates an attempt after the throttle has closed.","effects":[{"set":"throttled","to":"throttled + 1"},{"emit":"pw-refused"}]},{"id":"gt-refuse","from":"gt-open","to":"gt-open","on":"pw-attempt","guard":"failures >= 3","effects":[{"emit":"pw-refused"}]},{"id":"gt-wrong","from":"gt-open","to":"gt-open","on":"pw-attempt","guard":"failures < 3 && event.guess == 'wrong'","effects":[{"set":"failures","to":"failures + 1"},{"emit":"pw-refused"}]},{"id":"gt-right","from":"gt-open","to":"gt-open","on":"pw-attempt","guard":"failures < 3 && event.guess == 'right'","effects":[{"emit":"pw-accepted"}]}]},
    {"id":"trigger-chain-flow","name":"Trigger chain","subject":"automation-worker","initial":"tc-live","description":"Each change that starts a chain carries its hop count. A trigger creates a job while the hop count is within the hop limit of eight that D-700 states, and refuses the rest of the chain.","variables":[{"name":"accepted","type":"number","initial":0}],"states":[{"id":"tc-live","name":"Live"}],"transitions":[{"id":"tc-accept-unbounded","from":"tc-live","to":"tc-live","on":"tc-change","faultOnly":true,"description":"Defect: creates a job for every hop, so a loop of triggers never ends.","effects":[{"set":"accepted","to":"accepted + 1"},{"emit":"tc-job-created"},{"emit":"tc-change","after":1,"payload":{"hop":"event.hop + 1"}}]},{"id":"tc-accept","from":"tc-live","to":"tc-live","on":"tc-change","guard":"event.hop <= 8","effects":[{"set":"accepted","to":"accepted + 1"},{"emit":"tc-job-created"},{"emit":"tc-change","after":1,"payload":{"hop":"event.hop + 1"}}]},{"id":"tc-refuse-deep","from":"tc-live","to":"tc-live","on":"tc-change","guard":"event.hop > 8","effects":[{"emit":"tc-cut"}]}]},
    {"id":"gateway-outage-flow","name":"Gateway during identity outage","subject":"gateway","initial":"go-ready","description":"The gateway's copy of a session is refreshed from the identity service once it is 5 ticks old. While a lookup is unanswered, a request that needs a session is refused with the outage named, and is not accepted.","variables":[{"name":"checkedAt","type":"number","initial":0}],"states":[{"id":"go-ready","name":"Ready"},{"id":"go-checking","name":"Waiting for the identity service"}],"transitions":[{"id":"go-accept-fresh","from":"go-ready","to":"go-ready","on":"sr-request","guard":"time - checkedAt < 5","effects":[{"emit":"sr-accepted"}]},{"id":"go-recheck","from":"go-ready","to":"go-checking","on":"sr-request","guard":"time - checkedAt >= 5","effects":[{"emit":"sr-lookup"}]},{"id":"go-answer","from":"go-checking","to":"go-ready","on":"sr-lookup-answer","guard":"event.valid == true","effects":[{"set":"checkedAt","to":"time"},{"emit":"sr-accepted"}]},{"id":"go-answer-revoked","from":"go-checking","to":"go-ready","on":"sr-lookup-answer","guard":"event.valid == false","effects":[{"emit":"sr-refused"}]},{"id":"go-accept-unanswered","from":"go-checking","to":"go-checking","on":"sr-request","faultOnly":true,"description":"Defect: accepts a request while the identity service has not answered.","effects":[{"emit":"sr-accepted"}]},{"id":"go-refuse-outage","from":"go-checking","to":"go-checking","on":"sr-request","effects":[{"emit":"sr-unavailable"}]}]},
    {"id":"erasure-copy-flow","name":"Erased copy","subject":"copy-store","initial":"er-holding","description":"One copy of the personal data of an erased principal. A purge drops it. Once the lifetime of 5 ticks has passed after the erasure committed, a read revalidates the copy and drops it before it answers. Every answer states whether it carried the held personal data after that bound: the flag leak.","variables":[{"name":"erased","type":"boolean","initial":false},{"name":"erasedAt","type":"number","initial":0},{"name":"held","type":"boolean","initial":true},{"name":"leak","type":"boolean","initial":false}],"states":[{"id":"er-holding","name":"Copy holds the data"},{"id":"er-dropped","name":"Copy dropped"}],"transitions":[{"id":"er-commit","from":"er-holding","to":"er-holding","on":"er-erase-committed","effects":[{"set":"erased","to":true},{"set":"erasedAt","to":"time"}]},{"id":"er-purge","from":"er-holding","to":"er-dropped","on":"er-purge-sent","effects":[{"set":"held","to":false}]},{"id":"er-serve-stale","from":"er-holding","to":"er-holding","on":"er-read","faultOnly":true,"guard":"erased && time - erasedAt >= 5","effects":[{"set":"leak","to":"leak || (held && erased && time - erasedAt >= 5)"},{"emit":"er-served"}]},{"id":"er-serve-fresh","from":"er-holding","to":"er-holding","on":"er-read","guard":"!(erased && time - erasedAt >= 5)","effects":[{"set":"leak","to":"leak || (held && erased && time - erasedAt >= 5)"},{"emit":"er-served"}]},{"id":"er-revalidate","from":"er-holding","to":"er-dropped","on":"er-read","guard":"erased && time - erasedAt >= 5","effects":[{"set":"held","to":false},{"set":"leak","to":"leak || (held && erased && time - erasedAt >= 5)"},{"emit":"er-served"}]},{"id":"er-serve-dropped","from":"er-dropped","to":"er-dropped","on":"er-read","effects":[{"set":"leak","to":"leak || (held && erased && time - erasedAt >= 5)"},{"emit":"er-served"}]}]},
    {"id":"subject-key-flow","name":"Subject key","subject":"key-service","initial":"sk-live","description":"The sealed personal fields of one subject. Destroying the subject key makes them unreadable, so a read after destruction returns only the sealed form.","variables":[{"name":"shredRequested","type":"boolean","initial":false},{"name":"plainAfterShred","type":"boolean","initial":false}],"states":[{"id":"sk-live","name":"Key held"},{"id":"sk-shredded","name":"Key destroyed","terminal":true}],"transitions":[{"id":"sk-destroy-ignored","from":"sk-live","to":"sk-live","on":"sk-shred","faultOnly":true,"description":"Defect: reports the key destroyed and keeps it.","effects":[{"set":"shredRequested","to":true},{"emit":"sk-destroyed"}]},{"id":"sk-destroy","from":"sk-live","to":"sk-shredded","on":"sk-shred","effects":[{"set":"shredRequested","to":true},{"emit":"sk-destroyed"}]},{"id":"sk-read-plain","from":"sk-live","to":"sk-live","on":"sk-read","effects":[{"set":"plainAfterShred","to":"plainAfterShred || shredRequested"},{"emit":"sk-plain"}]},{"id":"sk-read-sealed","from":"sk-shredded","to":"sk-shredded","on":"sk-read","effects":[{"emit":"sk-sealed"}]}]},
    {"id":"audit-chain-flow","name":"Audit chain under erasure","subject":"audit-log","initial":"ac-open","description":"An append-only chain. Erasing a principal seals its entries, and the hash of each entry is computed over the sealed form, so the chain stays valid.","variables":[{"name":"chainOk","type":"boolean","initial":true},{"name":"sealed","type":"number","initial":0}],"states":[{"id":"ac-open","name":"Open"}],"transitions":[{"id":"ac-append","from":"ac-open","to":"ac-open","on":"au-append","effects":[{"emit":"au-appended"}]},{"id":"ac-rewrite","from":"ac-open","to":"ac-open","on":"au-erase","faultOnly":true,"description":"Defect: rewrites the entry in place, so the link of the next entry no longer matches.","effects":[{"set":"chainOk","to":false},{"emit":"au-sealed"}]},{"id":"ac-seal","from":"ac-open","to":"ac-open","on":"au-erase","effects":[{"set":"sealed","to":"sealed + 1"},{"emit":"au-sealed"}]}]},
    {"id":"agent-halt-flow","name":"Agent halt","subject":"agent-gateway","initial":"ah-running","description":"One agent: an anomaly halts it, and a halted agent applies nothing until a principal other than the agent resumes it.","variables":[],"states":[{"id":"ah-running","name":"Running"},{"id":"ah-stopped","name":"Halted"}],"transitions":[{"id":"ah-trip","from":"ah-running","to":"ah-stopped","on":"ah-anomaly","effects":[{"emit":"ah-halted"}]},{"id":"ah-apply","from":"ah-running","to":"ah-running","on":"ah-operation","effects":[{"emit":"ah-applied"}]},{"id":"ah-apply-halted","from":"ah-stopped","to":"ah-stopped","on":"ah-operation","faultOnly":true,"description":"Defect: applies an operation while the agent is halted.","effects":[{"emit":"ah-applied"}]},{"id":"ah-refuse-halted","from":"ah-stopped","to":"ah-stopped","on":"ah-operation","effects":[{"emit":"ah-refused"}]},{"id":"ah-resume-agent","from":"ah-stopped","to":"ah-running","on":"ah-resume"}]},
    {"id":"approval-separation-flow","name":"Approval separation","subject":"agent-gateway","initial":"sp-idle","description":"A proposal is cleared only by an approval from a principal other than its author.","variables":[{"name":"author","type":"string","initial":""}],"states":[{"id":"sp-idle","name":"No proposal"},{"id":"sp-open","name":"Awaiting approval"},{"id":"sp-done","name":"Cleared","terminal":true}],"transitions":[{"id":"sp-open-proposal","from":"sp-idle","to":"sp-open","on":"sp-proposed","effects":[{"set":"author","to":"event.author"}]},{"id":"sp-accept-self","from":"sp-open","to":"sp-done","on":"sp-approve","guard":"event.by == author","faultOnly":true,"description":"Defect: lets the author of a proposal approve it.","effects":[{"emit":"sp-cleared"}]},{"id":"sp-approve-other","from":"sp-open","to":"sp-done","on":"sp-approve","guard":"event.by != author","effects":[{"emit":"sp-cleared"}]},{"id":"sp-refuse-self","from":"sp-open","to":"sp-open","on":"sp-approve","guard":"event.by == author","effects":[{"emit":"sp-refused"}]}]},
    {"id":"token-render-flow","name":"Rendering a page with a reader-dependent token","subject":"runtime","initial":"tk-ready","description":"A page holds a token whose value depends on the reader. The design renders it for each reader and stores no shared copy.","variables":[{"name":"stored","type":"boolean","initial":false},{"name":"storedFor","type":"string","initial":""},{"name":"leak","type":"boolean","initial":false}],"states":[{"id":"tk-ready","name":"Ready"}],"transitions":[{"id":"tk-store-shared","from":"tk-ready","to":"tk-ready","on":"tk-request","faultOnly":true,"guard":"!stored","description":"Defect: stores the rendered page as a shared copy.","effects":[{"set":"stored","to":true},{"set":"storedFor","to":"event.reader"},{"emit":"tk-rendered"}]},{"id":"tk-serve-stored","from":"tk-ready","to":"tk-ready","on":"tk-request","guard":"stored","effects":[{"set":"leak","to":"leak || event.reader != storedFor"},{"emit":"tk-rendered"}]},{"id":"tk-render","from":"tk-ready","to":"tk-ready","on":"tk-request","effects":[{"emit":"tk-rendered"}]}]},
    {"id":"mail-dispatch-flow","name":"Mail dispatch","subject":"mail-dispatcher","initial":"md-idle","description":"One message with its idempotency key. The dispatcher submits it, and submits it again with the same key when no acknowledgement comes.","variables":[{"name":"submissions","type":"number","initial":0},{"name":"key","type":"string","initial":""}],"states":[{"id":"md-idle","name":"Idle"},{"id":"md-waiting","name":"Waiting for an acknowledgement"},{"id":"md-sent","name":"Recorded as sent"}],"transitions":[{"id":"md-submit","from":"md-idle","to":"md-waiting","on":"em-due","effects":[{"set":"submissions","to":"submissions + 1"},{"set":"key","to":"event.key"},{"emit":"em-submit","payload":{"key":"key"}}]},{"id":"md-resubmit","from":"md-waiting","to":"md-waiting","on":"em-timeout","effects":[{"set":"submissions","to":"submissions + 1"},{"emit":"em-submit","payload":{"key":"key"}}]},{"id":"md-record","from":"md-waiting","to":"md-sent","on":"em-ack","effects":[{"emit":"em-recorded"}]},{"id":"md-ignore-late-ack","from":"md-sent","to":"md-sent","on":"em-ack","effects":[]}]},
    {"id":"mail-adapter-flow","name":"Mail adapter","subject":"mail-service","initial":"ma-ready","description":"The adapter of the mail contract. It keeps a table of idempotency keys with two slots, k1 and k2. It delivers a key once and acknowledges every submission of it; a submission with the other key is a different message.","variables":[{"name":"seenK1","type":"boolean","initial":false},{"name":"seenK2","type":"boolean","initial":false},{"name":"delivered","type":"number","initial":0},{"name":"deliveredK1","type":"number","initial":0},{"name":"deliveredK2","type":"number","initial":0}],"states":[{"id":"ma-ready","name":"Ready"}],"transitions":[{"id":"ma-deliver-again","from":"ma-ready","to":"ma-ready","on":"em-submit","faultOnly":true,"guard":"event.key == 'k1' && seenK1","effects":[{"set":"delivered","to":"delivered + 1"},{"set":"deliveredK1","to":"deliveredK1 + 1"},{"emit":"em-ack"}]},{"id":"ma-deliver-again-k2","from":"ma-ready","to":"ma-ready","on":"em-submit","faultOnly":true,"guard":"event.key == 'k2' && seenK2","effects":[{"set":"delivered","to":"delivered + 1"},{"set":"deliveredK2","to":"deliveredK2 + 1"},{"emit":"em-ack"}]},{"id":"ma-treat-keys-alike","from":"ma-ready","to":"ma-ready","on":"em-submit","faultOnly":true,"guard":"event.key == 'k2' && seenK1 && !seenK2","effects":[{"set":"seenK2","to":true},{"emit":"em-ack","after":2}]},{"id":"ma-deliver-k1","from":"ma-ready","to":"ma-ready","on":"em-submit","guard":"event.key == 'k1' && !seenK1","effects":[{"set":"seenK1","to":true},{"set":"delivered","to":"delivered + 1"},{"set":"deliveredK1","to":"deliveredK1 + 1"},{"emit":"em-ack","after":2}]},{"id":"ma-deliver-k2","from":"ma-ready","to":"ma-ready","on":"em-submit","guard":"event.key == 'k2' && !seenK2","effects":[{"set":"seenK2","to":true},{"set":"delivered","to":"delivered + 1"},{"set":"deliveredK2","to":"deliveredK2 + 1"},{"emit":"em-ack","after":2}]},{"id":"ma-acknowledge-repeat","from":"ma-ready","to":"ma-ready","on":"em-submit","guard":"(event.key == 'k1' && seenK1) || (event.key == 'k2' && seenK2)","effects":[{"emit":"em-ack","after":2}]}]},
    {"id":"colour-switch-flow","name":"Colour switch","subject":"traffic-switch","initial":"cs-blue","description":"One component at the traffic switch. Blue is live. A release deploys green, green is verified, and a switch makes green live. A switch back returns to blue, which is still running. A withdrawn colour serves nothing.","variables":[{"name":"verified","type":"boolean","initial":false},{"name":"withdrawn","type":"boolean","initial":false}],"states":[{"id":"cs-blue","name":"Blue serves"},{"id":"cs-verifying","name":"Green deployed and verifying"},{"id":"cs-green","name":"Green serves"}],"transitions":[{"id":"cs-switch-unverified","from":"cs-verifying","to":"cs-green","on":"cs-switch-requested","guard":"!verified","faultOnly":true,"description":"Defect: moves public traffic to green before its verification has passed.","effects":[{"emit":"cs-traffic-green"}]},{"id":"cs-serve-withdrawn","from":"cs-blue","to":"cs-blue","on":"cs-request","guard":"withdrawn","faultOnly":true,"description":"Defect: serves a request from the withdrawn green colour after a switch back.","effects":[{"emit":"cs-served-withdrawn"}]},{"id":"cs-deploy","from":"cs-blue","to":"cs-verifying","on":"cs-green-deployed","effects":[]},{"id":"cs-verify","from":"cs-verifying","to":"cs-verifying","on":"cs-green-verified","effects":[{"set":"verified","to":true}]},{"id":"cs-refuse-unverified","from":"cs-verifying","to":"cs-verifying","on":"cs-switch-requested","guard":"!verified","effects":[{"emit":"cs-switch-refused"}]},{"id":"cs-switch","from":"cs-verifying","to":"cs-green","on":"cs-switch-requested","guard":"verified","effects":[{"emit":"cs-traffic-green"}]},{"id":"cs-serve-blue","from":"cs-blue","to":"cs-blue","on":"cs-request","effects":[{"emit":"cs-served-blue"}]},{"id":"cs-serve-verifying","from":"cs-verifying","to":"cs-verifying","on":"cs-request","effects":[{"emit":"cs-served-blue"}]},{"id":"cs-serve-green","from":"cs-green","to":"cs-green","on":"cs-request","effects":[{"emit":"cs-served-green"}]},{"id":"cs-rollback","from":"cs-green","to":"cs-blue","on":"cs-rollback-requested","effects":[{"set":"withdrawn","to":true},{"emit":"cs-traffic-blue"}]}]},
    {"id":"release-promotion-flow","name":"Release promotion","subject":"release-controller","initial":"rp-idle","description":"One release on its way to production. It is gated in stage, approved by two principals, and promoted. Production receives it only when both conditions hold.","variables":[{"name":"gated","type":"boolean","initial":false},{"name":"approvals","type":"number","initial":0},{"name":"live","type":"boolean","initial":false},{"name":"approver","type":"string","initial":""}],"states":[{"id":"rp-idle","name":"Not gated"},{"id":"rp-staged","name":"Gated in stage"},{"id":"rp-live","name":"Production live"}],"transitions":[{"id":"rp-promote-ungated","from":"rp-idle","to":"rp-live","on":"rp-promote-requested","guard":"approvals >= 2","faultOnly":true,"description":"Defect: promotes a release that has not passed its gate.","effects":[{"set":"live","to":true},{"emit":"rp-production-received"}]},{"id":"rp-promote-unapproved","from":"rp-staged","to":"rp-live","on":"rp-promote-requested","guard":"approvals < 2","faultOnly":true,"description":"Defect: promotes a release with fewer than two approvals.","effects":[{"set":"live","to":true},{"emit":"rp-production-received"}]},{"id":"rp-stage","from":"rp-idle","to":"rp-staged","on":"rp-stage-gated","effects":[{"set":"gated","to":true}]},{"id":"rp-approve-idle-first","from":"rp-idle","to":"rp-idle","on":"rp-approved","effects":[{"set":"approvals","to":"approvals + 1"},{"set":"approver","to":"event.by"}],"guard":"approvals == 0"},{"id":"rp-approve-idle-second","from":"rp-idle","to":"rp-idle","on":"rp-approved","effects":[{"set":"approvals","to":"approvals + 1"}],"guard":"approvals == 1 && event.by != approver"},{"id":"rp-approve-staged-first","from":"rp-staged","to":"rp-staged","on":"rp-approved","effects":[{"set":"approvals","to":"approvals + 1"},{"set":"approver","to":"event.by"}],"guard":"approvals == 0"},{"id":"rp-approve-staged-second","from":"rp-staged","to":"rp-staged","on":"rp-approved","effects":[{"set":"approvals","to":"approvals + 1"}],"guard":"approvals == 1 && event.by != approver"},{"id":"rp-refuse-idle","from":"rp-idle","to":"rp-idle","on":"rp-promote-requested","effects":[{"emit":"rp-promotion-refused"}]},{"id":"rp-refuse-staged","from":"rp-staged","to":"rp-staged","on":"rp-promote-requested","guard":"approvals < 2","effects":[{"emit":"rp-promotion-refused"}]},{"id":"rp-promote","from":"rp-staged","to":"rp-live","on":"rp-promote-requested","guard":"gated && approvals >= 2","effects":[{"set":"live","to":true},{"emit":"rp-production-received"}]}]},
    {"id":"migration-batch-flow","name":"Migration run in batches","subject":"automation-worker","initial":"mg-idle","description":"One migration run over three records. Each batch converts one record and commits the cursor with it. A run that stops resumes from its cursor.","variables":[{"name":"cursor","type":"number","initial":0},{"name":"converted","type":"number","initial":0}],"states":[{"id":"mg-idle","name":"Not started"},{"id":"mg-running","name":"Running"},{"id":"mg-stopped","name":"Stopped"},{"id":"mg-complete","name":"Complete"}],"transitions":[{"id":"mg-resume-restart","from":"mg-stopped","to":"mg-running","on":"mg-resumed","faultOnly":true,"description":"Defect: resumes from the first record, so records already converted are converted again.","effects":[{"set":"cursor","to":0}]},{"id":"mg-start","from":"mg-idle","to":"mg-running","on":"mg-started","effects":[]},{"id":"mg-batch-unsaved","from":"mg-running","to":"mg-stopped","on":"mg-batch-run","guard":"cursor == 1 && converted == 1","effects":[{"set":"converted","to":"converted + 1"}],"faultOnly":true},{"id":"mg-batch","from":"mg-running","to":"mg-running","on":"mg-batch-run","guard":"cursor < 3","effects":[{"set":"cursor","to":"cursor + 1"},{"set":"converted","to":"converted + 1"}]},{"id":"mg-finish","from":"mg-running","to":"mg-complete","on":"mg-batch-run","guard":"cursor >= 3","effects":[{"emit":"mg-done"}]},{"id":"mg-interrupt","from":"mg-running","to":"mg-stopped","on":"mg-interrupted","effects":[]},{"id":"mg-resume","from":"mg-stopped","to":"mg-running","on":"mg-resumed","effects":[]}]},
    {"id":"tenant-move-flow","name":"Tenant move","subject":"control-plane","initial":"tm-source","description":"One tenant moving between placements. The source serves while the copy runs, and a writer may write while it does. The source is frozen, the writes the copy missed are applied to the target (the final synchronisation), and the two state hashes are compared. A hash is modelled as the number of writes a side holds. The directory switches only when the comparison finds them equal.","variables":[{"name":"frozen","type":"boolean","initial":false},{"name":"sourceVersion","type":"number","initial":0},{"name":"targetVersion","type":"number","initial":0},{"name":"matched","type":"boolean","initial":false},{"name":"switched","type":"boolean","initial":false}],"states":[{"id":"tm-source","name":"Source serves"},{"id":"tm-copying","name":"Copying"},{"id":"tm-frozen","name":"Source frozen"},{"id":"tm-verified","name":"Hashes equal"},{"id":"tm-target","name":"Target serves"}],"transitions":[{"id":"tm-write-while-frozen","from":"tm-frozen","to":"tm-frozen","on":"tm-write-requested","faultOnly":true,"effects":[{"set":"sourceVersion","to":"sourceVersion + 1"},{"emit":"tm-write-accepted"}]},{"id":"tm-switch-unverified","from":"tm-frozen","to":"tm-target","on":"tm-switch-requested","faultOnly":true,"effects":[{"set":"switched","to":true},{"emit":"tm-directory-switched"}]},{"id":"tm-switch-on-failure","from":"tm-copying","to":"tm-target","on":"tm-copy-failed","faultOnly":true,"effects":[{"set":"switched","to":true},{"emit":"tm-directory-switched"}]},{"id":"tm-begin","from":"tm-source","to":"tm-copying","on":"tm-move-requested","effects":[{"set":"targetVersion","to":"sourceVersion"}]},{"id":"tm-write-source","from":"tm-source","to":"tm-source","on":"tm-write-requested","effects":[{"set":"sourceVersion","to":"sourceVersion + 1"},{"emit":"tm-write-accepted"}]},{"id":"tm-write-copying","from":"tm-copying","to":"tm-copying","on":"tm-write-requested","effects":[{"set":"sourceVersion","to":"sourceVersion + 1"},{"emit":"tm-write-accepted"}]},{"id":"tm-write-frozen","from":"tm-frozen","to":"tm-frozen","on":"tm-write-requested","effects":[{"emit":"tm-write-refused"}]},{"id":"tm-write-verified","from":"tm-verified","to":"tm-verified","on":"tm-write-requested","effects":[{"emit":"tm-write-refused"}]},{"id":"tm-freeze","from":"tm-copying","to":"tm-frozen","on":"tm-freeze-requested","effects":[{"set":"frozen","to":true}]},{"id":"tm-reconcile","from":"tm-frozen","to":"tm-frozen","on":"tm-reconcile-requested","effects":[{"set":"targetVersion","to":"sourceVersion"}]},{"id":"tm-hash-match","from":"tm-frozen","to":"tm-verified","on":"tm-hash-checked","guard":"sourceVersion == targetVersion","effects":[{"set":"matched","to":true}]},{"id":"tm-hash-mismatch","from":"tm-frozen","to":"tm-source","on":"tm-hash-checked","guard":"sourceVersion != targetVersion","effects":[{"set":"frozen","to":false},{"emit":"tm-move-failed"}]},{"id":"tm-abandon-copy","from":"tm-copying","to":"tm-source","on":"tm-copy-failed","effects":[{"emit":"tm-move-failed"}]},{"id":"tm-switch","from":"tm-verified","to":"tm-target","on":"tm-switch-requested","guard":"matched","effects":[{"set":"switched","to":true},{"emit":"tm-directory-switched"}]}]},
    {"id":"commit-flow","name":"Commit and publication","subject":"runtime","initial":"rc-idle","description":"An accepted intent is committed, and only then is its event published.","variables":[{"name":"committed","type":"boolean","initial":false},{"name":"published","type":"boolean","initial":false}],"states":[{"id":"rc-idle","name":"Idle"},{"id":"rc-deciding","name":"Deciding"},{"id":"rc-committing","name":"Committing"},{"id":"rc-done","name":"Published","terminal":true}],"transitions":[{"id":"rc-decide","from":"rc-idle","to":"rc-deciding","on":"rt-intent","effects":[{"emit":"rt-decided"}]},{"id":"rc-publish-early","from":"rc-deciding","to":"rc-committing","on":"rt-decided","faultOnly":true,"description":"Defect: publishes the event before the commit is confirmed.","effects":[{"set":"published","to":true},{"emit":"rt-published"},{"emit":"rt-committed","after":1}]},{"id":"rc-commit","from":"rc-deciding","to":"rc-committing","on":"rt-decided","effects":[{"emit":"rt-committed","after":1}]},{"id":"rc-publish","from":"rc-committing","to":"rc-done","on":"rt-committed","effects":[{"set":"committed","to":true},{"set":"published","to":true},{"emit":"rt-published"}]}]},
    {"id":"source-throttle-flow","name":"Per-source sign-in throttle","subject":"identity-service","initial":"st-open","description":"Password attempts from two sources, a and b, across many accounts. Once the failures from one source reach the threshold of 3, an attempt from that source is refused whatever its account. The threshold of 3 stands for the 100 failures of D-700, and the window of fifteen minutes is not modelled.","variables":[{"name":"failuresA","type":"number","initial":0},{"name":"failuresB","type":"number","initial":0},{"name":"evaluatedWhileThrottled","type":"number","initial":0}],"states":[{"id":"st-open","name":"Open"}],"transitions":[{"id":"st-evaluate-throttled","from":"st-open","to":"st-open","on":"src-attempt","faultOnly":true,"guard":"(event.source == 'a' && failuresA >= 3) || (event.source == 'b' && failuresB >= 3)","effects":[{"set":"evaluatedWhileThrottled","to":"evaluatedWhileThrottled + 1"},{"emit":"src-accepted"}]},{"id":"st-refuse-throttled","from":"st-open","to":"st-open","on":"src-attempt","guard":"(event.source == 'a' && failuresA >= 3) || (event.source == 'b' && failuresB >= 3)","effects":[{"emit":"src-refused"}]},{"id":"st-fail-a","from":"st-open","to":"st-open","on":"src-attempt","guard":"event.source == 'a' && event.guess == 'wrong'","effects":[{"set":"failuresA","to":"failuresA + 1"},{"emit":"src-refused"}]},{"id":"st-fail-b","from":"st-open","to":"st-open","on":"src-attempt","guard":"event.source == 'b' && event.guess == 'wrong'","effects":[{"set":"failuresB","to":"failuresB + 1"},{"emit":"src-refused"}]},{"id":"st-accept","from":"st-open","to":"st-open","on":"src-attempt","guard":"event.guess == 'right'","effects":[{"emit":"src-accepted"}]}]}
  ],
  "faults": [
    {"id":"defect-link-replay","name":"A used link is accepted again","kind":"enable-transition","transition":"ml-accept-again","description":"The defect that IDN-003 forbids."},
    {"id":"defect-link-unchecked","name":"A link is accepted without lifetime or browser checks","kind":"enable-transition","transition":"ml-accept-unchecked","description":"The defect that IDN-004 and IDN-005 forbid."},
    {"id":"link-acceptance-disabled","name":"Links cannot be accepted","kind":"disable-transition","transition":"ml-accept","description":"Shows that the acceptance claim can fail."},
    {"id":"defect-oidc-state-unchecked","name":"A callback is accepted without comparing its state","kind":"enable-transition","transition":"oidc-accept-any-state","description":"The defect that FED-001 forbids."},
    {"id":"oidc-acceptance-disabled","name":"Callbacks cannot be accepted","kind":"disable-transition","transition":"oidc-accept","description":"Shows that the acceptance claim can fail."},
    {"id":"revocation-notice-dropped","name":"The revocation notice is dropped","kind":"drop-event","event":"sr-notice","description":"A gateway does not hear about a revocation.","realises":"fm-revocation-notice-lost"},
    {"id":"defect-gateway-no-recheck","name":"The gateway trusts its session copy forever","kind":"enable-transition","transition":"gs-accept-without-recheck","description":"The defect that IDN-013 forbids."},
    {"id":"defect-result-token-unchecked","name":"A result is recorded without checking its token","kind":"enable-transition","transition":"jl-complete-any-token","description":"The defect that SCH-011 forbids."},
    {"id":"completion-disabled","name":"Results cannot be recorded","kind":"disable-transition","transition":"jl-complete","description":"Shows that the completion claim can fail."},
    {"id":"purge-dropped","name":"The purge is dropped","kind":"drop-event","event":"ec-purge","description":"The content delivery network does not hear about a change.","realises":"fm-purge-lost"},
    {"id":"defect-edge-ignores-lifetime","name":"The edge serves a copy past its lifetime","kind":"enable-transition","transition":"eg-serve-past-lifetime","description":"The defect that EDG-006 forbids."},
    {"id":"defect-early-activation","name":"A tenant is reported active before it is ready","kind":"enable-transition","transition":"pv-activate-early","description":"The defect that TEN-002 forbids."},
    {"id":"defect-apply-unapproved","name":"A risky change is applied without approval","kind":"enable-transition","transition":"cp-apply-unapproved","description":"The defect that AGT-011 forbids."},
    {"id":"defect-apply-rejected","name":"A rejected change is applied","kind":"enable-transition","transition":"cp-apply-rejected","description":"The defect that AGT-011 forbids, on a rejected proposal."},
    {"id":"arc-defect-outbox-duplicate-applied","name":"A redelivered notice makes its effect again","kind":"enable-transition","transition":"arc-ob-apply-again","description":"The defect that ARC-104 forbids."},
    {"id":"arc-publisher-stops","name":"The runtime stops before it publishes","kind":"disable-transition","transition":"arc-od-publish-now","description":"A runtime crashes after its commit and before its publication.","realises":"fm-runtime-crash"},
    {"id":"arc-recovery-disabled","name":"The outbox job does not publish","kind":"disable-transition","transition":"arc-od-sweep","description":"Shows that the recovery claim can fail."},
    {"id":"arc-defect-new-format-early","name":"A commit writes the newer format during a rolling deployment","kind":"enable-transition","transition":"arc-rl-commit-early","description":"The defect that ARC-106 forbids."},
    {"id":"defect-webhook-no-dedupe","name":"A repeated delivery starts a second run","kind":"enable-transition","transition":"iw-accept-again","description":"The defect that INT-151 forbids."},
    {"id":"defect-preview-unchecked","name":"A preview link shows the draft after its expiry","kind":"enable-transition","transition":"pl-show-expired","description":"The defect that CMS-159 forbids."},
    {"id":"defect-cv-apply-unconfirmed","name":"A preview is applied without confirmation","kind":"enable-transition","transition":"cf-apply-unconfirmed","description":"The defect that CNV-206 forbids."},
    {"id":"defect-cv-apply-stale","name":"An operation runs on a permission the person no longer holds","kind":"enable-transition","transition":"ca-run-stale","description":"The defect that CNV-203 forbids."},
    {"id":"cv-run-disabled","name":"Operations cannot be committed","kind":"disable-transition","transition":"ca-run","description":"Shows that the commit claim can fail."},
    {"id":"defect-saml-replay-accepted","name":"A used SAML assertion is accepted again","kind":"enable-transition","transition":"sam-accept-replay","description":"The defect that FED-006 forbids."},
    {"id":"defect-throttle-ignored","name":"A guess is evaluated after the throttle closes","kind":"enable-transition","transition":"gt-ignore-throttle","description":"The defect that IDN-250 forbids."},
    {"id":"identity-answer-dropped","name":"The identity service's answers are dropped","kind":"drop-event","event":"sr-lookup-answer","description":"The gateway never hears back from the identity service.","realises":"fm-identity-outage"},
    {"id":"defect-gateway-accepts-unanswered","name":"The gateway accepts while a lookup is unanswered","kind":"enable-transition","transition":"go-accept-unanswered","description":"The defect that IDN-300 forbids."},
    {"id":"outage-refusal-disabled","name":"Refusals during an outage cannot be sent","kind":"disable-transition","transition":"go-refuse-outage","description":"Shows that the refusal claim can fail."},
    {"id":"defect-trigger-loop-unbounded","name":"A chain of triggers has no hop limit","kind":"enable-transition","transition":"tc-accept-unbounded","description":"The defect that SCH-300 forbids."},
    {"id":"erasure-purge-dropped","name":"The purge of an erased copy is lost","kind":"drop-event","event":"er-purge-sent","description":"The copy never hears that its principal was erased. Its lifetime backstop must still stop it.","realises":"fm-purge-lost"},
    {"id":"defect-erasure-ignores-lifetime","name":"An erased copy is served past its lifetime","kind":"enable-transition","transition":"er-serve-stale","description":"The defect that CPY-013 forbids."},
    {"id":"defect-shred-ignored","name":"A key destruction is reported but not performed","kind":"enable-transition","transition":"sk-destroy-ignored","description":"The defect that PRV-358 forbids."},
    {"id":"defect-audit-rewrites-entry","name":"An audit entry is rewritten on erasure","kind":"enable-transition","transition":"ac-rewrite","description":"The defect that PRV-360 forbids."},
    {"id":"ah-trip-disabled","name":"An anomaly does not halt the agent","kind":"disable-transition","transition":"ah-trip","description":"Shows that the automatic halt claim can fail."},
    {"id":"defect-halt-ignored","name":"A halted agent applies operations","kind":"enable-transition","transition":"ah-apply-halted","description":"The defect that AGS-419 forbids."},
    {"id":"ah-apply-disabled","name":"Operations of a running agent are not applied","kind":"disable-transition","transition":"ah-apply","description":"Shows that the applied claim can fail."},
    {"id":"defect-self-approval-accepted","name":"An author approves their own proposal","kind":"enable-transition","transition":"sp-accept-self","description":"The defect that AGS-409 forbids."},
    {"id":"sp-other-approval-disabled","name":"Approval by another principal is refused","kind":"disable-transition","transition":"sp-approve-other","description":"Shows that the approval claim can fail."},
    {"id":"defect-token-stored-shared","name":"A reader-dependent page is stored as a shared copy","kind":"enable-transition","transition":"tk-store-shared","description":"The defect that CTK-017 forbids."},
    {"id":"defect-mail-delivered-again","name":"An accepted key is delivered again","kind":"enable-transition","transition":"ma-deliver-again","description":"The defect that EML-006 forbids."},
    {"id":"mail-recording-disabled","name":"Acknowledgements are not recorded","kind":"disable-transition","transition":"md-record","description":"Shows that the recording claim can fail."},
    {"id":"defect-switch-unverified","name":"Green takes traffic before verification","kind":"enable-transition","transition":"cs-switch-unverified","description":"The defect that REL-566 forbids."},
    {"id":"colour-switch-disabled","name":"A colour switch cannot be made","kind":"disable-transition","transition":"cs-switch","description":"Shows that the switch claim can fail."},
    {"id":"defect-serve-withdrawn","name":"The withdrawn colour serves after a switch back","kind":"enable-transition","transition":"cs-serve-withdrawn","description":"The defect that REL-577 forbids."},
    {"id":"colour-rollback-disabled","name":"A switch back cannot be made","kind":"disable-transition","transition":"cs-rollback","description":"Shows that the switch back claim can fail."},
    {"id":"defect-promote-ungated","name":"A release is promoted without its gate","kind":"enable-transition","transition":"rp-promote-ungated","description":"The defect that REL-557 forbids."},
    {"id":"defect-promote-unapproved","name":"A release is promoted with one approval","kind":"enable-transition","transition":"rp-promote-unapproved","description":"The defect that REL-560 forbids."},
    {"id":"promotion-disabled","name":"A gated release cannot be promoted","kind":"disable-transition","transition":"rp-promote","description":"Shows that the promotion claim can fail."},
    {"id":"defect-migration-restarts","name":"A stopped migration run restarts from the first record","kind":"enable-transition","transition":"mg-resume-restart","description":"The defect that MIG-554 forbids."},
    {"id":"migration-batches-disabled","name":"Batches of a migration run cannot be committed","kind":"disable-transition","transition":"mg-batch","description":"Shows that the completion claim can fail."},
    {"id":"defect-move-switch-unverified","name":"The directory switches before the hash is checked","kind":"enable-transition","transition":"tm-switch-unverified","description":"The defect that MIG-570 forbids."},
    {"id":"defect-write-during-freeze","name":"A write is accepted during the read-only window","kind":"enable-transition","transition":"tm-write-while-frozen","description":"The defect that MIG-568 forbids."},
    {"id":"defect-switch-on-failure","name":"The directory switches after a failed copy","kind":"enable-transition","transition":"tm-switch-on-failure","description":"The defect that MIG-571 forbids."},
    {"id":"move-switch-disabled","name":"The directory cannot switch a verified move","kind":"disable-transition","transition":"tm-switch","description":"Shows that the completion claim can fail."},
    {"id":"defect-link-lifetime-unchecked","name":"A link is accepted after its lifetime","kind":"enable-transition","transition":"ml-accept-untimed","description":"The defect that IDN-004 forbids, on its own: the browser check still runs."},
    {"id":"defect-link-browser-unchecked","name":"A link is accepted in a browser that did not request it","kind":"enable-transition","transition":"ml-accept-unbrowsed","description":"The defect that IDN-005 forbids, on its own: the lifetime check still runs."},
    {"id":"link-presentation-in-transit","name":"The link presentation arrives 20 ticks late","kind":"delay-event","event":"ml-presented","by":20,"description":"The presentation is delayed in transit past the lifetime of the link."},
    {"id":"preview-presentation-delayed","name":"The preview presentation arrives 20 ticks late","kind":"delay-event","event":"pl-presented","by":20,"description":"The presentation is delayed in transit past the expiry of the preview link."},
    {"id":"work-report-delayed-past-expiry","name":"The stalled worker's report arrives late","kind":"delay-event","event":"work-reported","by":6,"occurrence":1,"realises":"fm-worker-stalls","description":"The first report of the first worker is delayed past the lease expiry, so it reaches the job after the replacement holds the lease."},
    {"id":"provisioning-step-fails-late","name":"A provisioning step fails while the template is installed","kind":"inject-event","event":"pv-step-failed","at":3,"realises":"fm-provisioning-step-fails","description":"The template installation fails at tick 3, after the layout has been applied."},
    {"id":"commit-confirmation-delayed","name":"The commit confirmation arrives 4 ticks late","kind":"delay-event","event":"rt-committed","by":4,"description":"The confirmation of the commit is delayed; publication must still wait for it."},
    {"id":"read-delayed-past-shred","name":"A read arrives after the key is destroyed","kind":"delay-event","event":"sk-read","by":5,"occurrence":1,"description":"The read is delayed in transit until after the key is destroyed."},
    {"id":"cv-confirmation-delayed","name":"The confirmation arrives 3 ticks late","kind":"delay-event","event":"cv-confirmed","by":3,"occurrence":1,"description":"The person's confirmation is delayed, so the apply request arrives first."},
    {"id":"cv-run-delayed-past-withdrawal","name":"An operation request arrives after its permission is withdrawn","kind":"delay-event","event":"cv-operation-run","by":3,"occurrence":1,"description":"The run request is delayed in transit past the withdrawal of the permission."},
    {"id":"first-acknowledgement-lost","name":"The first acknowledgement is lost","kind":"drop-event","event":"em-ack","occurrence":1,"description":"The first acknowledgement of the mail adapter never reaches the dispatcher."},
    {"id":"operation-delayed-past-halt","name":"An operation arrives after the anomaly halts the agent","kind":"delay-event","event":"ah-operation","by":3,"occurrence":1,"description":"The operation is sent before the anomaly and delivered after the halt."},
    {"id":"first-delivery-delayed","name":"The first delivery of a notice arrives late","kind":"delay-event","event":"arc-ob-delivered","by":3,"occurrence":1,"description":"The first delivery is delayed; the redelivery arrives first."},
    {"id":"migration-crash-before-cursor","name":"A stop after a batch and before its cursor is recorded","kind":"enable-transition","transition":"mg-batch-unsaved","realises":"fm-migration-interrupted","description":"The worker stops after it commits the records of the second batch and before it records the cursor. This is the failure of a design that does not commit the records and the cursor together."},
    {"id":"approval-delivered-twice","name":"An approval is delivered a second time","kind":"inject-event","event":"rp-approved","at":1,"payload":{"by":"ada"},"description":"The same approval arrives twice; the second copy must not count as a second approver."},
    {"id":"gate-result-late","name":"The gate result arrives 3 ticks late","kind":"delay-event","event":"rp-stage-gated","by":3,"occurrence":1,"description":"The passing gate result is delayed; promotion requested before it arrives must be refused."},
    {"id":"move-copy-failure","name":"The copy stops while copying","kind":"inject-event","event":"tm-copy-failed","at":1,"realises":"fm-move-copy-fails","description":"The copy of the tenant database to its target stops before it is complete."},
    {"id":"defect-publish-before-commit","name":"An event is published before its commit","kind":"enable-transition","transition":"rc-publish-early","description":"The defect that RUN-005 forbids."},
    {"id":"link-presentation-repeated","name":"The link presentation is delivered twice","kind":"inject-event","event":"ml-presented","at":3,"payload":{"token":"good","browser":"requester"},"description":"The network delivers the presentation a second time."},
    {"id":"interceptor-presents-link","name":"Someone who intercepted the mail presents the link","kind":"inject-event","event":"ml-presented","at":2,"payload":{"token":"good","browser":"other"},"description":"A concurrent actor presents the link from a browser that did not request it."},
    {"id":"oidc-callback-dropped","name":"The provider's callback never arrives","kind":"drop-event","event":"oidc-callback","occurrence":1,"realises":"fm-provider-outage","description":"The identity provider does not answer: the first callback is lost."},
    {"id":"forged-callback-injected","name":"A forged callback arrives","kind":"inject-event","event":"oidc-callback","at":5,"payload":{"state":"forged"},"description":"A concurrent actor sends a callback whose state matches no pending request."},
    {"id":"approval-delayed","name":"The approval arrives 5 ticks late","kind":"delay-event","event":"cp-approved","by":5,"occurrence":1,"description":"The approval is sent, and an apply request overtakes it."},
    {"id":"apply-request-redelivered","name":"A late apply request is delivered","kind":"inject-event","event":"cp-apply-requested","at":3,"description":"An apply request that was queued before the rejection is delivered after it."},
    {"id":"deploy-finish-notice-delayed","name":"The notice that the older version stopped arrives 4 ticks late","kind":"delay-event","event":"arc-rl-deploy-finished","by":4,"occurrence":1,"description":"The older version has stopped, and the commit path hears it late."},
    {"id":"inbound-delivery-repeated","name":"The inbound delivery is repeated","kind":"inject-event","event":"iw-received","at":1,"payload":{"key":"d1"},"description":"The sender retries, or the network repeats the delivery."},
    {"id":"saml-response-repeated","name":"The SAML response is delivered twice","kind":"inject-event","event":"saml-response","at":1,"description":"The browser or the network presents the same response again."},
    {"id":"parallel-connection-guess","name":"A parallel connection from the same source guesses too","kind":"inject-event","event":"pw-attempt","at":1,"payload":{"guess":"wrong"},"description":"A second connection of the same source presents a wrong guess between the scripted ones."},
    {"id":"concurrent-reader","name":"A second reader asks while the first is served","kind":"inject-event","event":"tk-request","at":1,"payload":{"reader":"ben"},"description":"A concurrent reader asks for the page."},
    {"id":"verification-result-delayed","name":"The verification result arrives 4 ticks late","kind":"delay-event","event":"cs-green-verified","by":4,"occurrence":1,"description":"The release record names green as verified late, and a switch request arrives first."},
    {"id":"switch-instruction-dropped","name":"The switch instruction does not reach the traffic switch","kind":"drop-event","event":"cs-switch-requested","realises":"fm-failed-switch","description":"The traffic switch does not apply a colour switch that the release controller requested."},
    {"id":"public-request-delayed","name":"A public request arrives 3 ticks late","kind":"delay-event","event":"cs-request","by":3,"occurrence":1,"description":"A request sent before a switch back reaches the traffic switch after it."},
    {"id":"move-write-delayed","name":"A write sent during the copy arrives after the freeze","kind":"delay-event","event":"tm-write-requested","by":2,"occurrence":1,"realises":"fm-move-concurrent-write","description":"A concurrent writer sends a write while the copy runs, and it reaches the source after the source was frozen."},
    {"id":"switch-request-premature","name":"A switch request arrives before the hash is checked","kind":"inject-event","event":"tm-switch-requested","at":2,"description":"A repeated or early switch request reaches the directory while the source is frozen."},
    {"id":"reconcile-disabled","name":"The final synchronisation does not run","kind":"disable-transition","transition":"tm-reconcile","description":"Shows that applying the writes the copy missed is what lets a move with concurrent writes complete."},
    {"id":"freeze-disabled","name":"The source is not frozen","kind":"disable-transition","transition":"tm-freeze","description":"Shows that the freeze is what lets a move with concurrent writes complete."},
    {"id":"worker-report-dropped","name":"The report of a partitioned worker is lost","kind":"drop-event","event":"work-reported","occurrence":1,"realises":"fm-automation-worker-partition","description":"The worker cannot reach its tenant database, and its first report never arrives."},
    {"id":"first-submission-lost","name":"The first submission does not reach the mail provider","kind":"drop-event","event":"em-submit","occurrence":1,"realises":"fm-mail-outage","description":"The mail provider does not take the first submission."},
    {"id":"trigger-event-reentered","name":"An event created by a job re-enters the trigger with a high hop count","kind":"inject-event","event":"tc-change","at":3,"payload":{"hop":9},"realises":"fm-trigger-loop","description":"A job of the chain creates an event that starts the trigger again, carrying the count of the chain."},
    {"id":"erasure-request-redelivered","name":"The erasure request reaches the audit chain twice","kind":"inject-event","event":"au-erase","at":2,"description":"The erasure of a principal is delivered a second time."},
    {"id":"self-approval-repeated","name":"The author's approval is delivered twice","kind":"inject-event","event":"sp-approve","at":2,"payload":{"by":"ada"},"description":"The same approval by the author arrives again."},
    {"id":"defect-mail-delivered-again-k2","name":"An accepted key k2 is delivered again","kind":"enable-transition","transition":"ma-deliver-again-k2","description":"The defect that EML-006 forbids, for the second key."},
    {"id":"defect-keys-treated-alike","name":"A second key is treated as the first","kind":"enable-transition","transition":"ma-treat-keys-alike","description":"The defect that a key table which ignores the key makes: a message with a new key is acknowledged and not delivered."},
    {"id":"defect-source-throttle-ignored","name":"A guess from a throttled source is evaluated","kind":"enable-transition","transition":"st-evaluate-throttled","description":"The defect that IDN-250 forbids."},
    {"id":"source-acceptance-disabled","name":"A correct guess cannot be accepted","kind":"disable-transition","transition":"st-accept","description":"Shows that the isolation claim can fail."},
    {"id":"spray-continues","name":"The spray from the throttled source continues","kind":"inject-event","event":"src-attempt","at":5,"payload":{"source":"a","account":"q","guess":"right"},"description":"A concurrent connection of the throttled source tries another account."}
  ],
  "scenarios": [
    {"id":"link-used-twice","name":"A link is used, then presented again","description":"The second presentation is refused.","behaviors":["emailed-link-flow"],"steps":[{"at":0,"event":"ml-requested"},{"at":2,"event":"ml-presented","payload":{"token":"good","browser":"requester"},"note":"The person follows the link."},{"at":4,"event":"ml-presented","payload":{"token":"good","browser":"requester"},"note":"The same link again."}]},
    {"id":"link-used-twice-impl","name":"A link is used, then presented again (implementation)","description":"The second presentation is refused. The same scenario run on the implementation machines.","behaviors":["emailed-link-flow-impl"],"steps":[{"at":0,"event":"ml-requested"},{"at":2,"event":"ml-presented","payload":{"token":"good","browser":"requester"},"note":"The person follows the link."},{"at":4,"event":"ml-presented","payload":{"token":"good","browser":"requester"},"note":"The same link again."}]},
    {"id":"link-presented-late","name":"A link is presented after its lifetime","description":"The lifetime is 15 ticks.","behaviors":["emailed-link-flow"],"steps":[{"at":0,"event":"ml-requested"},{"at":30,"event":"ml-presented","payload":{"token":"good","browser":"requester"}}]},
    {"id":"link-presented-late-impl","name":"A link is presented after its lifetime (implementation)","description":"The lifetime is 15 ticks. The same scenario run on the implementation machines.","behaviors":["emailed-link-flow-impl"],"steps":[{"at":0,"event":"ml-requested"},{"at":30,"event":"ml-presented","payload":{"token":"good","browser":"requester"}}]},
    {"id":"link-presented-elsewhere","name":"A link is presented in another browser","description":"The link reached someone who did not ask for it.","behaviors":["emailed-link-flow"],"steps":[{"at":0,"event":"ml-requested"},{"at":2,"event":"ml-presented","payload":{"token":"good","browser":"other"}}]},
    {"id":"link-presented-elsewhere-impl","name":"A link is presented in another browser (implementation)","description":"The link reached someone who did not ask for it. The same scenario run on the implementation machines.","behaviors":["emailed-link-flow-impl"],"steps":[{"at":0,"event":"ml-requested"},{"at":2,"event":"ml-presented","payload":{"token":"good","browser":"other"}}]},
    {"id":"oidc-sign-in","name":"Sign-in through a provider","description":"The callback carries the pending state.","behaviors":["oidc-callback-flow"],"steps":[{"at":0,"event":"oidc-started"},{"at":3,"event":"oidc-callback","payload":{"state":"s1"}}]},
    {"id":"oidc-sign-in-impl","name":"Sign-in through a provider (implementation)","description":"The callback carries the pending state. The same scenario run on the implementation machines.","behaviors":["oidc-callback-flow-impl"],"steps":[{"at":0,"event":"oidc-started"},{"at":3,"event":"oidc-callback","payload":{"state":"s1"}}]},
    {"id":"oidc-forged-callback","name":"A forged callback","description":"The callback carries a state that matches no pending request.","behaviors":["oidc-callback-flow"],"steps":[{"at":0,"event":"oidc-started"},{"at":3,"event":"oidc-callback","payload":{"state":"forged"}}]},
    {"id":"oidc-forged-callback-impl","name":"A forged callback (implementation)","description":"The callback carries a state that matches no pending request. The same scenario run on the implementation machines.","behaviors":["oidc-callback-flow-impl"],"steps":[{"at":0,"event":"oidc-started"},{"at":3,"event":"oidc-callback","payload":{"state":"forged"}}]},
    {"id":"revocation-heard","name":"A revocation reaches the gateway","description":"The next request is refused.","behaviors":["session-authority-flow","gateway-session-flow"],"steps":[{"at":0,"event":"sr-request"},{"at":1,"event":"sr-revoked"},{"at":2,"event":"sr-request"}]},
    {"id":"revocation-heard-impl","name":"A revocation reaches the gateway (implementation)","description":"The next request is refused. The same scenario run on the implementation machines.","behaviors":["session-authority-flow-impl","gateway-session-flow-impl"],"steps":[{"at":0,"event":"sr-request"},{"at":1,"event":"sr-revoked"},{"at":2,"event":"sr-request"}]},
    {"id":"revocation-notice-lost","name":"The revocation notice is lost","description":"A request inside the bound is still accepted. A request after it makes the gateway ask again, and is refused.","behaviors":["session-authority-flow","gateway-session-flow"],"faults":["revocation-notice-dropped"],"steps":[{"at":0,"event":"sr-request"},{"at":1,"event":"sr-revoked"},{"at":3,"event":"sr-request","note":"Within the bound of 5 ticks."},{"at":10,"event":"sr-request","note":"After the bound."}]},
    {"id":"revocation-notice-lost-impl","name":"The revocation notice is lost (implementation)","description":"A request inside the bound is still accepted. A request after it makes the gateway ask again, and is refused. The same scenario run on the implementation machines.","behaviors":["session-authority-flow-impl","gateway-session-flow-impl"],"faults":["revocation-notice-dropped"],"steps":[{"at":0,"event":"sr-request"},{"at":1,"event":"sr-revoked"},{"at":3,"event":"sr-request","note":"Within the bound of 5 ticks."},{"at":10,"event":"sr-request","note":"After the bound."}]},
    {"id":"lease-takeover","name":"A stalled worker is replaced","description":"The first worker stalls, the lease expires, a second worker gets the job, and then both report.","behaviors":["job-lease-flow"],"steps":[{"at":0,"event":"job-due"},{"at":5,"event":"lease-expired"},{"at":6,"event":"work-reported","payload":{"token":1},"note":"The stalled worker wakes up."},{"at":7,"event":"work-reported","payload":{"token":2},"note":"The replacement finishes."}]},
    {"id":"page-purged","name":"A change purges the edge copy","description":"The next reader gets the new version.","behaviors":["origin-content-flow","edge-copy-flow"],"steps":[{"at":0,"event":"ec-request"},{"at":1,"event":"ec-published"},{"at":2,"event":"ec-request"}]},
    {"id":"page-purge-lost","name":"The purge is lost","description":"A reader inside the lifetime still gets the old version. A reader after it gets the new one.","behaviors":["origin-content-flow","edge-copy-flow"],"faults":["purge-dropped"],"steps":[{"at":0,"event":"ec-request"},{"at":1,"event":"ec-published"},{"at":3,"event":"ec-request","note":"within the lifetime of 5 ticks."},{"at":12,"event":"ec-request","note":"After the lifetime."}]},
    {"id":"tenant-provisioned","name":"A tenant is provisioned","description":"Every step succeeds.","behaviors":["provisioning-flow"],"steps":[{"at":0,"event":"pv-requested"}]},
    {"id":"tenant-provisioning-fails","name":"Provisioning fails while applying the layout","description":"The layout step fails and what was created is removed.","behaviors":["provisioning-flow"],"steps":[{"at":0,"event":"pv-requested"},{"at":1,"event":"pv-step-failed"}]},
    {"id":"safe-change-applied","name":"A safe change","description":"Policy classes the change as safe, so it is applied after its projection.","behaviors":["proposal-flow"],"steps":[{"at":0,"event":"cp-proposed","payload":{"risky":false}},{"at":1,"event":"cp-apply-requested"}]},
    {"id":"risky-change-approved","name":"A risky change, approved","description":"An apply before approval is refused. After approval it goes through.","behaviors":["proposal-flow"],"steps":[{"at":0,"event":"cp-proposed","payload":{"risky":true}},{"at":1,"event":"cp-apply-requested","note":"Too early."},{"at":2,"event":"cp-approved"},{"at":3,"event":"cp-apply-requested"}]},
    {"id":"risky-change-rejected","name":"A risky change, rejected","description":"The change is never applied.","behaviors":["proposal-flow"],"steps":[{"at":0,"event":"cp-proposed","payload":{"risky":true}},{"at":1,"event":"cp-rejected"},{"at":2,"event":"cp-apply-requested"}]},
    {"id":"arc-outbox-duplicate-delivery","name":"A notice is delivered twice","description":"The notice queue delivers one event notice again before it is acknowledged.","behaviors":["arc-outbox-consumer-flow"],"steps":[{"at":0,"event":"arc-ob-delivered","payload":{"seq":1}},{"at":2,"event":"arc-ob-delivered","payload":{"seq":1},"note":"The redelivery."}]},
    {"id":"arc-publisher-crashed-after-commit","name":"The publisher stops after a commit","description":"The runtime that committed stops before it publishes. The outbox job publishes later.","behaviors":["arc-outbox-delivery-flow"],"faults":["arc-publisher-stops"],"steps":[{"at":0,"event":"rt-committed"},{"at":1,"event":"arc-ob-publish-now"},{"at":5,"event":"arc-ob-sweep-due"}]},
    {"id":"arc-rolling-deploy-with-commit","name":"A commit during a rolling deployment","description":"The newer version starts and commits, the older version stops, and the newer version commits again.","behaviors":["arc-rolling-change-flow"],"steps":[{"at":0,"event":"arc-rl-deploy-started"},{"at":1,"event":"arc-rl-commit"},{"at":3,"event":"arc-rl-deploy-finished"},{"at":4,"event":"arc-rl-commit"}]},
    {"id":"inbound-repeated-delivery","name":"An inbound delivery repeated","description":"The same event arrives twice, and the second arrival starts nothing.","behaviors":["inbound-run-flow"],"steps":[{"at":0,"event":"iw-received","payload":{"key":"d1"}},{"at":2,"event":"iw-received","payload":{"key":"d1"},"note":"The sender retries."}]},
    {"id":"preview-presented-late","name":"A preview link presented after its expiry","description":"The link is presented 30 ticks after it was linked, past its 15-tick lifetime.","behaviors":["preview-link-flow"],"steps":[{"at":0,"event":"pl-issue"},{"at":30,"event":"pl-presented"}]},
    {"id":"cv-confirmed-apply","name":"A change is confirmed, then applied","description":"The apply follows the confirmation.","behaviors":["cv-change-flow"],"steps":[{"at":0,"event":"cv-proposed"},{"at":1,"event":"cv-confirmed"},{"at":2,"event":"cv-apply-requested"}]},
    {"id":"cv-unconfirmed-apply","name":"A change is applied before confirmation","description":"The apply is refused unless the change was confirmed.","behaviors":["cv-change-flow"],"steps":[{"at":0,"event":"cv-proposed"},{"at":1,"event":"cv-apply-requested","note":"Applied before the person confirmed."}]},
    {"id":"cv-cancelled-preview","name":"A preview is cancelled, then applied","description":"A cancelled change is refused.","behaviors":["cv-change-flow"],"steps":[{"at":0,"event":"cv-proposed"},{"at":1,"event":"cv-cancel"},{"at":2,"event":"cv-apply-requested"}]},
    {"id":"cv-withdrawn-before-run","name":"A permission is withdrawn before the operation runs","description":"The operation is refused after the permission is withdrawn.","behaviors":["cv-authority-flow"],"steps":[{"at":1,"event":"cv-permission-withdrawn"},{"at":2,"event":"cv-operation-run"}]},
    {"id":"cv-permitted-run","name":"An operation runs with its permission","description":"The operation commits.","behaviors":["cv-authority-flow"],"steps":[{"at":1,"event":"cv-operation-run"}]},
    {"id":"saml-replayed","name":"An assertion is presented twice","description":"The second presentation is refused.","behaviors":["saml-assertion-flow"],"steps":[{"at":0,"event":"saml-response"},{"at":2,"event":"saml-response","note":"The same assertion again."}]},
    {"id":"guesses-from-one-source","name":"Guesses from one source","description":"Wrong guesses arrive until the throttle closes, and then a right guess arrives.","behaviors":["guess-throttle-flow"],"steps":[{"at":0,"event":"pw-attempt","payload":{"guess":"wrong"}},{"at":1,"event":"pw-attempt","payload":{"guess":"wrong"}},{"at":2,"event":"pw-attempt","payload":{"guess":"wrong"}},{"at":3,"event":"pw-attempt","payload":{"guess":"wrong"},"note":"The fourth guess, after the throttle has closed."},{"at":4,"event":"pw-attempt","payload":{"guess":"right"}}]},
    {"id":"trigger-chain-runaway","name":"A chain of changes runs past the hop limit","description":"A change starts a chain: each accepted change emits the next one with its hop count raised by one. The chain is cut at the hop limit of eight; a second change at hop 12 arrives from outside and is refused.","behaviors":["trigger-chain-flow"],"steps":[{"at":0,"event":"tc-change","payload":{"hop":1}},{"at":2,"event":"tc-change","payload":{"hop":12},"note":"A change from outside the chain."}]},
    {"id":"identity-unreachable","name":"The identity service does not answer","description":"A request arrives after the gateway's copy of the session is older than its bound. The lookup is never answered, and the next request is refused with the outage named.","behaviors":["gateway-outage-flow","session-authority-flow"],"faults":["identity-answer-dropped"],"steps":[{"at":6,"event":"sr-request","note":"The copy is older than its bound, so the gateway asks."},{"at":8,"event":"sr-request","note":"The lookup is still unanswered."}]},
    {"id":"identity-unreachable-impl","name":"The identity service does not answer (implementation)","description":"A request arrives after the gateway's copy of the session is older than its bound. The lookup is never answered, and the next request is refused with the outage named. The same scenario run on the implementation machines.","behaviors":["gateway-outage-flow","session-authority-flow-impl"],"faults":["identity-answer-dropped"],"steps":[{"at":6,"event":"sr-request","note":"The copy is older than its bound, so the gateway asks."},{"at":8,"event":"sr-request","note":"The lookup is still unanswered."}]},
    {"id":"erasure-purged","name":"An erasure purges the copy","description":"The purge arrives, and later reads are answered without personal data.","behaviors":["erasure-copy-flow"],"steps":[{"at":0,"event":"er-erase-committed"},{"at":1,"event":"er-purge-sent"},{"at":2,"event":"er-read"},{"at":8,"event":"er-read","note":"After the bound of 5 ticks."}]},
    {"id":"erasure-purge-lost","name":"An erasure whose purge is lost","description":"The copy keeps its value. A read inside the bound is served from it. A read after the bound revalidates and is answered without personal data.","behaviors":["erasure-copy-flow"],"faults":["erasure-purge-dropped"],"steps":[{"at":0,"event":"er-erase-committed"},{"at":1,"event":"er-purge-sent"},{"at":2,"event":"er-read","note":"Within the bound."},{"at":8,"event":"er-read","note":"After the bound."}]},
    {"id":"subject-shredded","name":"A subject key is destroyed","description":"After destruction a read gets only the sealed form.","behaviors":["subject-key-flow"],"steps":[{"at":0,"event":"sk-shred"},{"at":2,"event":"sk-read"}]},
    {"id":"audit-erasure","name":"An erasure seals audit entries","description":"Entries are appended, the entries of the principal are sealed, and the chain continues.","behaviors":["audit-chain-flow"],"steps":[{"at":0,"event":"au-append"},{"at":1,"event":"au-erase"},{"at":2,"event":"au-append"}]},
    {"id":"anomaly-then-operation","name":"An anomaly, then an operation","description":"The anomaly halts the agent, and the operation that follows is refused.","behaviors":["agent-halt-flow"],"steps":[{"at":0,"event":"ah-anomaly"},{"at":2,"event":"ah-operation","note":"The agent asks again after the halt."}]},
    {"id":"operation-when-running","name":"An operation of a running agent","description":"No anomaly. The operation is applied.","behaviors":["agent-halt-flow"],"steps":[{"at":0,"event":"ah-operation"}]},
    {"id":"self-approval-attempted","name":"An author approves their own proposal","description":"The approval does not clear the proposal.","behaviors":["approval-separation-flow"],"steps":[{"at":0,"event":"sp-proposed","payload":{"author":"ada"}},{"at":1,"event":"sp-approve","payload":{"by":"ada"}}]},
    {"id":"other-approves","name":"A principal other than the author approves","description":"The approval clears the proposal.","behaviors":["approval-separation-flow"],"steps":[{"at":0,"event":"sp-proposed","payload":{"author":"ada"}},{"at":1,"event":"sp-approve","payload":{"by":"ben"}}]},
    {"id":"token-two-readers","name":"Two readers ask for a page with a reader-dependent token","description":"Each reader gets a rendering made for them.","behaviors":["token-render-flow"],"steps":[{"at":0,"event":"tk-request","payload":{"reader":"ada"}},{"at":1,"event":"tk-request","payload":{"reader":"ben"}}]},
    {"id":"mail-timeout-then-retry","name":"The dispatcher times out and submits again","description":"The dispatcher gives up waiting before the acknowledgement arrives and submits the same key a second time.","behaviors":["mail-dispatch-flow","mail-adapter-flow"],"steps":[{"at":0,"event":"em-due","payload":{"key":"k1"}},{"at":1,"event":"em-timeout","note":"Before the acknowledgement, which takes two ticks."}]},
    {"id":"switch-before-verification","name":"A switch is requested before the new colour is verified","description":"The release deploys green and asks for a switch before its verification passes. The switch is refused.","behaviors":["colour-switch-flow"],"steps":[{"at":0,"event":"cs-green-deployed"},{"at":1,"event":"cs-switch-requested"}]},
    {"id":"verified-switch","name":"A switch after verification","description":"The release deploys green, verifies it and asks for a switch.","behaviors":["colour-switch-flow"],"steps":[{"at":0,"event":"cs-green-deployed"},{"at":1,"event":"cs-green-verified"},{"at":2,"event":"cs-switch-requested"}]},
    {"id":"rollback-then-request","name":"A switch back, then a request","description":"Green is made live, then switched back to blue, and a public request arrives after the switch back.","behaviors":["colour-switch-flow"],"steps":[{"at":0,"event":"cs-green-deployed"},{"at":1,"event":"cs-green-verified"},{"at":2,"event":"cs-switch-requested"},{"at":3,"event":"cs-rollback-requested"},{"at":4,"event":"cs-request"}]},
    {"id":"release-promoted","name":"A gated release with two approvals","description":"The release passes its stage gate, gets two approvals and is promoted.","behaviors":["release-promotion-flow"],"steps":[{"at":0,"event":"rp-stage-gated"},{"at":1,"event":"rp-approved","payload":{"by":"ada"}},{"at":2,"event":"rp-approved","payload":{"by":"ben"}},{"at":3,"event":"rp-promote-requested"}]},
    {"id":"release-promote-without-gate","name":"A release with two approvals and no gate","description":"The release has two approvals but never passed its gate, and a promotion is requested.","behaviors":["release-promotion-flow"],"steps":[{"at":0,"event":"rp-approved","payload":{"by":"ada"}},{"at":1,"event":"rp-approved","payload":{"by":"ben"}},{"at":2,"event":"rp-promote-requested"}]},
    {"id":"release-promote-unapproved","name":"A gated release with one approval","description":"The release passes its gate and has one approval, and a promotion is requested.","behaviors":["release-promotion-flow"],"steps":[{"at":0,"event":"rp-stage-gated"},{"at":1,"event":"rp-approved","payload":{"by":"ada"}},{"at":2,"event":"rp-promote-requested"}]},
    {"id":"migration-interrupted-resumed","name":"A migration run stopped and resumed","description":"Two batches commit, the run stops, resumes and finishes.","behaviors":["migration-batch-flow"],"steps":[{"at":0,"event":"mg-started"},{"at":1,"event":"mg-batch-run"},{"at":2,"event":"mg-batch-run"},{"at":3,"event":"mg-interrupted"},{"at":4,"event":"mg-resumed"},{"at":5,"event":"mg-batch-run"},{"at":6,"event":"mg-batch-run"}]},
    {"id":"move-completes","name":"A move whose hash matches","description":"The source is frozen, the hash is computed from the state of each side and matches, and the directory switches.","behaviors":["tenant-move-flow"],"steps":[{"at":0,"event":"tm-move-requested"},{"at":1,"event":"tm-freeze-requested"},{"at":2,"event":"tm-hash-checked"},{"at":3,"event":"tm-switch-requested"}]},
    {"id":"move-switch-requested-early","name":"A directory switch requested before the hash is checked","description":"The source is frozen and a switch is requested with no hash check.","behaviors":["tenant-move-flow"],"steps":[{"at":0,"event":"tm-move-requested"},{"at":1,"event":"tm-freeze-requested"},{"at":2,"event":"tm-switch-requested"}]},
    {"id":"move-write-during-freeze","name":"A write during the read-only window","description":"A write arrives while the source is frozen.","behaviors":["tenant-move-flow"],"steps":[{"at":0,"event":"tm-move-requested"},{"at":1,"event":"tm-freeze-requested"},{"at":2,"event":"tm-write-requested"}]},
    {"id":"move-copy-fails","name":"A move whose copy fails","description":"The copy stops and a write arrives afterwards.","behaviors":["tenant-move-flow"],"steps":[{"at":0,"event":"tm-move-requested"},{"at":2,"event":"tm-write-requested"}],"faults":["move-copy-failure"]},
    {"id":"link-presented-after-delay","name":"A link presented in transit after its lifetime","description":"The link is presented at tick 2, but the presentation reaches the identity service 20 ticks later, after its lifetime.","behaviors":["emailed-link-flow"],"faults":["link-presentation-in-transit"],"steps":[{"at":0,"event":"ml-requested"},{"at":2,"event":"ml-presented","payload":{"token":"good","browser":"requester"},"note":"Sent at tick 2, delivered at tick 22."}]},
    {"id":"link-presented-after-delay-impl","name":"A link presented in transit after its lifetime (implementation)","description":"The link is presented at tick 2, but the presentation reaches the identity service 20 ticks later, after its lifetime. The same scenario run on the implementation machines.","behaviors":["emailed-link-flow-impl"],"faults":["link-presentation-in-transit"],"steps":[{"at":0,"event":"ml-requested"},{"at":2,"event":"ml-presented","payload":{"token":"good","browser":"requester"},"note":"Sent at tick 2, delivered at tick 22."}]},
    {"id":"preview-presentation-in-transit","name":"A preview presented in transit after its expiry","description":"The link is issued at tick 0 and presented at tick 2, but the presentation reaches the gateway 20 ticks later.","behaviors":["preview-link-flow"],"faults":["preview-presentation-delayed"],"steps":[{"at":0,"event":"pl-issue"},{"at":2,"event":"pl-presented","note":"Sent at tick 2, delivered at tick 22."}]},
    {"id":"lease-report-in-transit","name":"A stalled worker reports after its lease expired","description":"The first worker reports at tick 2, but the report is delayed by 6 ticks. The lease expires at tick 5 and the replacement holds token 2; the replacement reports at tick 9.","behaviors":["job-lease-flow"],"faults":["work-report-delayed-past-expiry"],"steps":[{"at":0,"event":"job-due"},{"at":2,"event":"work-reported","payload":{"token":1},"note":"Sent by the first worker, delivered at tick 8."},{"at":5,"event":"lease-expired"},{"at":9,"event":"work-reported","payload":{"token":2},"note":"The replacement finishes."}]},
    {"id":"tenant-provisioning-fails-late","name":"A provisioning step fails while installing the template","description":"The run requests a tenant; the template installation fails at tick 3, after the layout is applied.","behaviors":["provisioning-flow"],"faults":["provisioning-step-fails-late"],"steps":[{"at":0,"event":"pv-requested"}]},
    {"id":"intent-commit-confirmation-delayed","name":"A commit confirmation delayed before publication","description":"The intent is committed, and the confirmation of the commit is delayed by 4 ticks.","behaviors":["commit-flow"],"faults":["commit-confirmation-delayed"],"steps":[{"at":0,"event":"rt-intent"}]},
    {"id":"read-in-transit-past-shred","name":"A read delayed past the key destruction","description":"A read is sent at tick 0 and delayed by 5 ticks; the key is destroyed at tick 1.","behaviors":["subject-key-flow"],"faults":["read-delayed-past-shred"],"steps":[{"at":0,"event":"sk-read"},{"at":1,"event":"sk-shred"}]},
    {"id":"cv-confirmation-in-transit","name":"An apply that arrives before a delayed confirmation","description":"The change is proposed; the confirmation is sent at tick 1 but delayed by 3 ticks; an apply at tick 2 is refused and one at tick 5 is accepted.","behaviors":["cv-change-flow"],"faults":["cv-confirmation-delayed"],"steps":[{"at":0,"event":"cv-proposed"},{"at":1,"event":"cv-confirmed"},{"at":2,"event":"cv-apply-requested"},{"at":5,"event":"cv-apply-requested"}]},
    {"id":"cv-run-in-transit-past-withdrawal","name":"A run delayed past the withdrawal of its permission","description":"The run is requested at tick 1 and delayed by 3 ticks; the permission is withdrawn at tick 2.","behaviors":["cv-authority-flow"],"faults":["cv-run-delayed-past-withdrawal"],"steps":[{"at":1,"event":"cv-operation-run"},{"at":2,"event":"cv-permission-withdrawn"}]},
    {"id":"mail-first-acknowledgement-lost","name":"A message whose first acknowledgement is lost","description":"The message is submitted at tick 0; its first acknowledgement is lost; the dispatcher times out at tick 3 and submits it again.","behaviors":["mail-dispatch-flow","mail-adapter-flow"],"faults":["first-acknowledgement-lost"],"steps":[{"at":0,"event":"em-due","payload":{"key":"k1"}},{"at":3,"event":"em-timeout"}]},
    {"id":"operation-in-transit-at-halt","name":"An operation delivered after the halt","description":"The agent sends an operation at tick 0, delayed by 3 ticks; an anomaly halts the agent at tick 1.","behaviors":["agent-halt-flow"],"faults":["operation-delayed-past-halt"],"steps":[{"at":0,"event":"ah-operation"},{"at":1,"event":"ah-anomaly"}]},
    {"id":"arc-outbox-delayed-first-delivery","name":"A notice redelivered before its delayed first delivery","description":"The notice is delivered at tick 0, delayed by 3 ticks, and redelivered at tick 2.","behaviors":["arc-outbox-consumer-flow"],"faults":["first-delivery-delayed"],"steps":[{"at":0,"event":"arc-ob-delivered","payload":{"seq":1}},{"at":2,"event":"arc-ob-delivered","payload":{"seq":1},"note":"The redelivery arrives first."}]},
    {"id":"release-approval-duplicated","name":"One approval delivered twice","description":"The gate passes; one approver approves at tick 1 and the same approval arrives again at tick 1; promotion is requested at tick 2.","behaviors":["release-promotion-flow"],"faults":["approval-delivered-twice"],"steps":[{"at":0,"event":"rp-stage-gated"},{"at":1,"event":"rp-approved","payload":{"by":"ada"}},{"at":2,"event":"rp-promote-requested"}]},
    {"id":"gate-result-arrives-late","name":"A gate result that arrives after a promotion request","description":"Two approvals arrive at tick 0 and the gate result is delayed by 3 ticks; promotion is requested at tick 2, before the gate, and again at tick 4.","behaviors":["release-promotion-flow"],"faults":["gate-result-late"],"steps":[{"at":0,"event":"rp-stage-gated"},{"at":0,"event":"rp-approved","payload":{"by":"ada"}},{"at":0,"event":"rp-approved","payload":{"by":"ben"}},{"at":2,"event":"rp-promote-requested","note":"Before the gate has arrived."},{"at":4,"event":"rp-promote-requested"}]},
    {"id":"intent-committed","name":"An intent is committed and published","description":"The event follows the commit.","behaviors":["commit-flow"],"steps":[{"at":0,"event":"rt-intent"}]},
    {"id":"link-presentation-duplicated","name":"A link presentation delivered twice","description":"The person follows the link once; the network delivers the presentation again at tick 3.","behaviors":["emailed-link-flow"],"faults":["link-presentation-repeated"],"steps":[{"at":0,"event":"ml-requested"},{"at":2,"event":"ml-presented","payload":{"token":"good","browser":"requester"}}]},
    {"id":"link-presentation-duplicated-impl","name":"A link presentation delivered twice (implementation)","description":"The person follows the link once; the network delivers the presentation again at tick 3. The same scenario run on the implementation machines.","behaviors":["emailed-link-flow-impl"],"faults":["link-presentation-repeated"],"steps":[{"at":0,"event":"ml-requested"},{"at":2,"event":"ml-presented","payload":{"token":"good","browser":"requester"}}]},
    {"id":"link-intercepted","name":"A link presented by someone who intercepted it","description":"Nobody presents the link in the requesting browser; an interceptor presents it from another browser at tick 2.","behaviors":["emailed-link-flow"],"faults":["interceptor-presents-link"],"steps":[{"at":0,"event":"ml-requested"}]},
    {"id":"link-intercepted-impl","name":"A link presented by someone who intercepted it (implementation)","description":"Nobody presents the link in the requesting browser; an interceptor presents it from another browser at tick 2. The same scenario run on the implementation machines.","behaviors":["emailed-link-flow-impl"],"faults":["interceptor-presents-link"],"steps":[{"at":0,"event":"ml-requested"}]},
    {"id":"oidc-provider-silent-forged-callback","name":"The provider is silent and a forged callback arrives","description":"The genuine callback is lost; a forged one arrives at tick 5.","behaviors":["oidc-callback-flow"],"faults":["oidc-callback-dropped","forged-callback-injected"],"steps":[{"at":0,"event":"oidc-started"},{"at":3,"event":"oidc-callback","payload":{"state":"s1"}}]},
    {"id":"oidc-provider-silent-forged-callback-impl","name":"The provider is silent and a forged callback arrives (implementation)","description":"The genuine callback is lost; a forged one arrives at tick 5. The same scenario run on the implementation machines.","behaviors":["oidc-callback-flow-impl"],"faults":["oidc-callback-dropped","forged-callback-injected"],"steps":[{"at":0,"event":"oidc-started"},{"at":3,"event":"oidc-callback","payload":{"state":"s1"}}]},
    {"id":"risky-change-approval-in-transit","name":"An apply overtakes a delayed approval","description":"The approval is sent at tick 1 and arrives at tick 6; an apply at tick 2 is refused and one at tick 7 goes through.","behaviors":["proposal-flow"],"faults":["approval-delayed"],"steps":[{"at":0,"event":"cp-proposed","payload":{"risky":true}},{"at":1,"event":"cp-approved"},{"at":2,"event":"cp-apply-requested"},{"at":7,"event":"cp-apply-requested"}]},
    {"id":"rejected-change-apply-redelivered","name":"An apply request delivered after the rejection","description":"The proposal is rejected at tick 1; nothing asks for the apply except a request delivered at tick 3.","behaviors":["proposal-flow"],"faults":["apply-request-redelivered"],"steps":[{"at":0,"event":"cp-proposed","payload":{"risky":true}},{"at":1,"event":"cp-rejected"}]},
    {"id":"rolling-deploy-finish-delayed","name":"The notice that the older version stopped is late","description":"The deployment finishes at tick 2 but the notice arrives at tick 6; a commit at tick 3 is made while the older version still runs.","behaviors":["arc-rolling-change-flow"],"faults":["deploy-finish-notice-delayed"],"steps":[{"at":0,"event":"arc-rl-deploy-started"},{"at":2,"event":"arc-rl-deploy-finished"},{"at":3,"event":"arc-rl-commit"},{"at":7,"event":"arc-rl-commit"}]},
    {"id":"inbound-delivery-redelivered","name":"An inbound delivery repeated by the network","description":"One delivery is sent; the network repeats it at tick 1.","behaviors":["inbound-run-flow"],"faults":["inbound-delivery-repeated"],"steps":[{"at":0,"event":"iw-received","payload":{"key":"d1"}}]},
    {"id":"cv-apply-before-delayed-confirmation","name":"An apply request overtakes a delayed confirmation","description":"The confirmation is sent at tick 1 and arrives at tick 4; the apply at tick 2 is refused.","behaviors":["cv-change-flow"],"faults":["cv-confirmation-delayed"],"steps":[{"at":0,"event":"cv-proposed"},{"at":1,"event":"cv-confirmed"},{"at":2,"event":"cv-apply-requested"}]},
    {"id":"saml-response-redelivered","name":"A SAML response delivered twice","description":"The assertion is presented once and delivered again at tick 1.","behaviors":["saml-assertion-flow"],"faults":["saml-response-repeated"],"steps":[{"at":0,"event":"saml-response"}]},
    {"id":"guesses-on-parallel-connections","name":"A parallel connection adds a failure","description":"Two scripted wrong guesses and one on a parallel connection reach the threshold before the right guess at tick 4.","behaviors":["guess-throttle-flow"],"faults":["parallel-connection-guess"],"steps":[{"at":0,"event":"pw-attempt","payload":{"guess":"wrong"}},{"at":2,"event":"pw-attempt","payload":{"guess":"wrong"}},{"at":4,"event":"pw-attempt","payload":{"guess":"right"}}]},
    {"id":"token-reader-joins-concurrently","name":"A second reader asks between two requests of the first","description":"Ada asks twice; Ben asks at tick 1.","behaviors":["token-render-flow"],"faults":["concurrent-reader"],"steps":[{"at":0,"event":"tk-request","payload":{"reader":"ada"}},{"at":2,"event":"tk-request","payload":{"reader":"ada"}}]},
    {"id":"switch-before-delayed-verification","name":"A switch request overtakes a delayed verification result","description":"The verification result is sent at tick 1 and arrives at tick 5; the switch requested at tick 2 is refused.","behaviors":["colour-switch-flow"],"faults":["verification-result-delayed"],"steps":[{"at":0,"event":"cs-green-deployed"},{"at":1,"event":"cs-green-verified"},{"at":2,"event":"cs-switch-requested"}]},
    {"id":"switch-instruction-lost","name":"The switch instruction is lost","description":"The traffic switch never applies the switch that the release controller requested.","behaviors":["colour-switch-flow"],"faults":["switch-instruction-dropped"],"steps":[{"at":0,"event":"cs-green-deployed"},{"at":1,"event":"cs-green-verified"},{"at":3,"event":"cs-switch-requested"}]},
    {"id":"request-in-flight-at-switch-back","name":"A request sent before a switch back arrives after it","description":"The request is sent at tick 2 and arrives at tick 5, after the switch back at tick 3.","behaviors":["colour-switch-flow"],"faults":["public-request-delayed"],"steps":[{"at":0,"event":"cs-green-deployed"},{"at":1,"event":"cs-green-verified"},{"at":2,"event":"cs-switch-requested"},{"at":2,"event":"cs-request"},{"at":3,"event":"cs-rollback-requested"}]},
    {"id":"move-with-concurrent-write","name":"A move while a writer writes","description":"A write is accepted during the copy; the source is frozen, the missed write is applied to the target, the hashes are compared and the directory switches.","behaviors":["tenant-move-flow"],"steps":[{"at":0,"event":"tm-move-requested"},{"at":1,"event":"tm-write-requested"},{"at":2,"event":"tm-freeze-requested"},{"at":3,"event":"tm-reconcile-requested"},{"at":4,"event":"tm-hash-checked"},{"at":5,"event":"tm-switch-requested"}]},
    {"id":"move-write-in-flight","name":"A write arrives after the freeze","description":"The write is sent at tick 1 during the copy and arrives at tick 3, when the source is frozen. The target is synchronised and the directory switches.","behaviors":["tenant-move-flow"],"faults":["move-write-delayed"],"steps":[{"at":0,"event":"tm-move-requested"},{"at":1,"event":"tm-write-requested"},{"at":2,"event":"tm-freeze-requested"},{"at":3,"event":"tm-reconcile-requested"},{"at":5,"event":"tm-hash-checked"},{"at":6,"event":"tm-switch-requested"}]},
    {"id":"move-concurrent-write-early-switch","name":"A switch requested with no hash check after a concurrent write","description":"A write is accepted during the copy; the source is frozen and synchronised; a switch is requested and the hash was never checked.","behaviors":["tenant-move-flow"],"steps":[{"at":0,"event":"tm-move-requested"},{"at":1,"event":"tm-write-requested"},{"at":2,"event":"tm-freeze-requested"},{"at":3,"event":"tm-reconcile-requested"},{"at":4,"event":"tm-switch-requested"}]},
    {"id":"move-switch-request-premature","name":"A switch request arrives before the hash is checked","description":"The source is frozen; a switch request injected at tick 2 arrives before the hash check at tick 3.","behaviors":["tenant-move-flow"],"faults":["switch-request-premature"],"steps":[{"at":0,"event":"tm-move-requested"},{"at":1,"event":"tm-freeze-requested"},{"at":3,"event":"tm-hash-checked"},{"at":4,"event":"tm-switch-requested"}]},
    {"id":"lease-report-lost-in-partition","name":"A partitioned worker's report is lost","description":"The first report is lost; the lease expires and the replacement reports.","behaviors":["job-lease-flow"],"faults":["worker-report-dropped"],"steps":[{"at":0,"event":"job-due"},{"at":2,"event":"work-reported","payload":{"token":1}},{"at":5,"event":"lease-expired"},{"at":7,"event":"work-reported","payload":{"token":2}}]},
    {"id":"mail-first-submission-lost","name":"The first submission is lost","description":"The mail provider does not take the first submission; the dispatcher times out at tick 3 and submits it again with the same key.","behaviors":["mail-dispatch-flow","mail-adapter-flow"],"faults":["first-submission-lost"],"steps":[{"at":0,"event":"em-due","payload":{"key":"k1"}},{"at":3,"event":"em-timeout"}]},
    {"id":"mail-same-key-twice","name":"One key submitted twice","description":"The same key reaches the adapter twice.","behaviors":["mail-adapter-flow"],"steps":[{"at":0,"event":"em-submit","payload":{"key":"k1"}},{"at":2,"event":"em-submit","payload":{"key":"k1"}}]},
    {"id":"mail-two-keys","name":"Two keys, each submitted twice","description":"Two messages with different keys, each submitted twice.","behaviors":["mail-adapter-flow"],"steps":[{"at":0,"event":"em-submit","payload":{"key":"k1"}},{"at":1,"event":"em-submit","payload":{"key":"k2"}},{"at":2,"event":"em-submit","payload":{"key":"k2"}},{"at":3,"event":"em-submit","payload":{"key":"k1"}}]},
    {"id":"trigger-chain-reentered","name":"An event created by a job re-enters the trigger","description":"A chain runs to its limit of eight; a job-created event with hop 9 arrives at tick 3 and is refused.","behaviors":["trigger-chain-flow"],"faults":["trigger-event-reentered"],"steps":[{"at":0,"event":"tc-change","payload":{"hop":1}}]},
    {"id":"audit-erasure-redelivered","name":"The erasure request reaches the audit chain twice","description":"One erasure, delivered again at tick 2.","behaviors":["audit-chain-flow"],"faults":["erasure-request-redelivered"],"steps":[{"at":0,"event":"au-append"},{"at":1,"event":"au-erase"}]},
    {"id":"self-approval-redelivered","name":"The author's approval is delivered twice","description":"The author approves once; the approval arrives again at tick 2.","behaviors":["approval-separation-flow"],"faults":["self-approval-repeated"],"steps":[{"at":0,"event":"sp-proposed","payload":{"author":"ada"}},{"at":1,"event":"sp-approve","payload":{"by":"ada"}}]},
    {"id":"password-spray-one-source","name":"A password sprayed across accounts from one source","description":"Source a fails on three different accounts and is then refused on a fourth; source b is not affected. A concurrent connection of a tries one more account at tick 5.","behaviors":["source-throttle-flow"],"faults":["spray-continues"],"steps":[{"at":0,"event":"src-attempt","payload":{"source":"a","account":"x","guess":"wrong"}},{"at":1,"event":"src-attempt","payload":{"source":"a","account":"y","guess":"wrong"}},{"at":2,"event":"src-attempt","payload":{"source":"a","account":"z","guess":"wrong"}},{"at":3,"event":"src-attempt","payload":{"source":"a","account":"w","guess":"right"}},{"at":4,"event":"src-attempt","payload":{"source":"b","account":"x","guess":"right"}}]}
  ],

  // ---- Fault model -------------------------------------------------------------------------------
  "environments": [
    {"id":"env-local","name":"Local container stack","description":"Every component and its dependencies in containers on one machine (D-22).","guarantees":[{"aspect":"zone-count","value":1,"source":"d-22"},{"aspect":"clock-skew","value":0,"unit":"millisecond","source":"d-22"}]},
    {"id":"env-stage","name":"Stage environment","description":"The platform's pre-production environment, made from the same definitions as production with its own accounts and synthetic tenants only (REL-554, REL-556).","guarantees":[{"aspect":"zone-count","value":3,"source":"d-553"},{"aspect":"region-count","value":1,"source":"d-553"},{"aspect":"clock-skew","value":500,"unit":"millisecond","source":"a-clock-skew"}]},
    {"id":"env-production","name":"Production environment","description":"The platform's live environment, made from the same definitions as the stage environment and changed only through release records and audited operations (D-23, D-501, REL-561).","guarantees":[{"aspect":"zone-count","value":3,"source":"d-553"},{"aspect":"region-count","value":1,"source":"d-553"},{"aspect":"clock-skew","value":500,"unit":"millisecond","source":"a-clock-skew"}]},
    {"id":"env-cloud","name":"Cloud profile, one region","description":"The first cloud profile (D-23): managed containers across three zones, managed PostgreSQL with a standby, a content delivery network.","guarantees":[{"aspect":"zone-count","value":3,"source":"d-23"},{"aspect":"region-count","value":1,"source":"d-23"},{"aspect":"clock-skew","value":500,"unit":"millisecond","source":"a-clock-skew"},{"aspect":"message-duplication","value":"wake notices and purge calls may be delivered more than once","source":"d-12"},{"aspect":"storage-durability","value":"a confirmed commit survives the loss of one database node","source":"a-database-commit"}]}
  ],
  "failureModes": [
    {"id":"fm-worker-stalls","name":"A worker stalls while holding a lease","kind":"stop","target":"automation-worker","scope":"process","rate":{"value":1,"per":"day","source":"a-planning-rates"},"description":"A worker stops responding and later resumes with the lease it held.","modelling":"exercised"},
    {"id":"fm-revocation-notice-lost","name":"A revocation notice is lost","kind":"loss","target":"arc-identity-publishes-revocation","scope":"instance","rate":{"value":1,"per":"week","source":"a-planning-rates"},"description":"A gateway instance does not hear that a session was revoked.","modelling":"exercised"},
    {"id":"fm-purge-lost","name":"A purge is lost","kind":"loss","target":"runtime-calls-network-control","scope":"provider","rate":{"value":1,"per":"week","source":"a-planning-rates"},"description":"A purge call does not reach the content delivery network.","modelling":"exercised"},
    {"id":"fm-provisioning-step-fails","name":"A provisioning step fails","kind":"dependency-outage","target":"control-plane","scope":"instance","rate":{"value":1,"per":"month","source":"a-planning-rates"},"description":"Creating the database, applying the layout or installing the template fails.","modelling":"exercised"},
    {"id":"fm-provider-outage","name":"An identity provider is unreachable","kind":"dependency-outage","target":"external-identity-provider","scope":"provider","rate":{"value":2,"per":"year","source":"a-planning-rates"},"description":"A tenant's identity provider does not answer.","modelling":"exercised"},
    {"id":"fm-runtime-crash","name":"The runtime crashes between commit and publication","kind":"crash","target":"runtime","scope":"process","rate":{"value":1,"per":"month","source":"a-planning-rates"},"description":"A process stops after a transaction commits and before its events are published.","modelling":"exercised"},
    {"id":"fm-identity-outage","name":"The identity service does not answer","kind":"dependency-outage","target":"identity-service","scope":"zone","rate":{"value":2,"per":"year","source":"a-planning-rates"},"description":"Session lookups and sign-in flows get no answer.","modelling":"exercised"},
    {"id":"fm-control-database-outage","name":"The control database cannot be read","kind":"dependency-outage","target":"control-database","scope":"zone","rate":{"value":1,"per":"year","source":"a-planning-rates"},"description":"The tenant directory and the wake index cannot be read.","modelling":"not-modelled","modellingNote":"No behaviour model has the directory or the wake index; ARC-500 and D-528 answer it with directory copies served for 15 minutes."},
    {"id":"fm-database-failover","name":"A tenant database fails over mid-transaction","kind":"crash","target":"tenant-database","scope":"zone","rate":{"value":2,"per":"year","source":"a-planning-rates"},"description":"A tenant database fails over to its standby while a transaction is open.","modelling":"not-modelled","modellingNote":"No behaviour model has the standby; the commit models assume a-database-commit."},
    {"id":"fm-clock-step-back","name":"A component's clock steps backwards","kind":"clock-skew","target":"gateway","scope":"instance","rate":{"value":1,"per":"year","source":"a-planning-rates"},"description":"A component's wall clock steps backwards by more than the skew of its environment.","modelling":"not-modelled","modellingNote":"Ticks are logical time and no model has a clock that can step back; a-clock-skew bounds the skew instead."},
    {"id":"fm-cdn-outage","name":"The content delivery network is unavailable","kind":"dependency-outage","target":"delivery-network","scope":"provider","rate":{"value":1,"per":"year","source":"a-planning-rates"},"description":"Page renders fall through to the origin and add to its load.","modelling":"not-modelled","modellingNote":"No behaviour model has the fall-through of renders to the origin; the edge copy flow models the purge and the lifetime only."},
    {"id":"fm-mail-outage","name":"The mail service does not deliver","kind":"dependency-outage","target":"mail-service","scope":"provider","rate":{"value":4,"per":"year","source":"a-planning-rates"},"description":"Mail cannot be handed to the mail service.","modelling":"exercised"},
    {"id":"fm-key-service-outage","name":"The key service cannot unwrap keys","kind":"dependency-outage","target":"key-service","scope":"zone","rate":{"value":1,"per":"year","source":"a-planning-rates"},"description":"Wrapped tenant data keys cannot be unwrapped.","modelling":"not-modelled","modellingNote":"No behaviour model has the unwrapping of tenant keys."},
    {"id":"fm-poison-event","name":"A committed event keeps failing to publish","kind":"other","target":"runtime","scope":"instance","rate":{"value":1,"per":"month","source":"a-planning-rates"},"description":"Publication of one committed event is refused on every attempt.","modelling":"not-modelled","modellingNote":"No behaviour model has the retry and park of a failing event."},
    {"id":"fm-trigger-loop","name":"Events create jobs that create events","kind":"other","target":"automation-worker","scope":"instance","rate":{"value":1,"per":"month","source":"a-planning-rates"},"description":"A trigger's job creates an event that starts the trigger again.","modelling":"exercised"},
    {"id":"fm-automation-worker-partition","name":"An automation worker cannot reach its tenant database","kind":"partition","target":"automation-worker","scope":"instance","rate":{"value":1,"per":"month","source":"a-planning-rates"},"description":"An automation worker instance is cut off from a tenant database it leases work from.","modelling":"exercised"},
    {"id":"fm-bad-deploy","name":"A new version fails under real traffic","kind":"other","target":"runtime","scope":"zone","rate":{"value":4,"per":"year","source":"a-planning-rates"},"description":"A version that passes its health check fails when it takes real traffic.","modelling":"not-modelled","modellingNote":"The colour switch flow models verification and switch back, not a version that fails under real traffic."},
    {"id":"fm-bad-layout-change","name":"A layout change fails on some tenants","kind":"partial-apply","target":"tenant-database","scope":"instance","rate":{"value":1,"per":"month","source":"a-planning-rates"},"description":"A layout change fails on some tenant databases and succeeds on others.","modelling":"not-modelled","modellingNote":"The migration flow models one run over one tenant, not the waves of a layout change over many."},
    {"id":"fm-disk-full","name":"A tenant database volume is full","kind":"other","target":"tenant-database","scope":"instance","rate":{"value":4,"per":"year","source":"a-planning-rates"},"description":"The volume of a tenant database has no free space.","modelling":"not-modelled","modellingNote":"No behaviour model has storage capacity."},
    {"id":"fm-certificate-expiry","name":"A tenant domain certificate expires","kind":"other","target":"delivery-network","scope":"provider","rate":{"value":2,"per":"year","source":"a-planning-rates"},"description":"A tenant domain's certificate passes its expiry date unrenewed.","modelling":"not-modelled","modellingNote":"No behaviour model has certificates."},
    {"id":"fm-zone-loss","name":"A zone is lost","kind":"stop","target":"gateway","scope":"zone","rate":{"value":1,"per":"year","source":"a-planning-rates"},"description":"One of the three zones of the cloud profile is lost.","modelling":"not-modelled","modellingNote":"No behaviour model has zones; the cloud profile requirements (DEP-010) and the recovery drill answer it."},
    {"id":"fm-failed-switch","name":"A colour switch fails at the traffic switch","kind":"dependency-outage","target":"traffic-switch","scope":"zone","rate":{"value":1,"per":"year","source":"a-planning-rates"},"description":"The traffic switch does not apply a colour switch or a switch back that the release controller requested.","modelling":"exercised"},
    {"id":"fm-migration-interrupted","name":"A migration run stops between batches","kind":"crash","target":"automation-worker","scope":"instance","rate":{"value":1,"per":"month","source":"a-planning-rates"},"description":"A worker running a migration run stops after it commits a batch and before it records the next cursor.","modelling":"exercised","modellingNote":"Exercised by a negative, not by a scenario: the fault migration-crash-before-cursor is the stop that violates m-migration-converts-once in the design where a batch and its cursor are not committed together. The scenario migration-interrupted-resumed models the stop as the event mg-interrupted."},
    {"id":"fm-move-copy-fails","name":"A tenant move fails while copying","kind":"partial-apply","target":"tenant-database","scope":"instance","rate":{"value":2,"per":"year","source":"a-planning-rates"},"description":"The copy of a tenant database to its target stops before it is complete.","modelling":"exercised"},
    {"id":"fm-copy-store-outage","name":"The copy store is unreachable","kind":"dependency-outage","target":"copy-store","scope":"zone","rate":{"value":2,"per":"year","source":"a-planning-rates"},"description":"Stored view copies cannot be read or written.","modelling":"not-modelled","modellingNote":"No behaviour model has the copy store; the edge copy flow does not model a read that fails."},
    {"id":"fm-move-concurrent-write","name":"A write reaches a tenant while it is moved","kind":"concurrent-change","target":"tenant-database","scope":"instance","rate":{"value":1,"per":"month","source":"a-planning-rates"},"description":"A writer writes to the source of a move while its copy runs, or just as it is frozen.","modelling":"exercised"}
  ],
  "faultModels": [
    {"id":"fault-model-operations","name":"Operations fault model","environment":"env-cloud","description":"The failures of dependencies, data, load and change that the operations requirements answer. Their rates are planning estimates.","modes":["fm-identity-outage","fm-control-database-outage","fm-database-failover","fm-clock-step-back","fm-cdn-outage","fm-mail-outage","fm-key-service-outage","fm-poison-event","fm-trigger-loop","fm-automation-worker-partition","fm-bad-deploy","fm-bad-layout-change","fm-disk-full","fm-certificate-expiry","fm-zone-loss","fm-migration-interrupted","fm-move-copy-fails","fm-failed-switch","fm-move-concurrent-write"],"bounds":[{"scope":"zone","maxConcurrent":1,"source":"d-23"}]},
    {"id":"fault-model-launch","name":"Launch fault model","environment":"env-cloud","description":"The failures the design is meant to survive in the first cloud profile. Failures outside it, such as the loss of a region, are answered by a restore (NG-4).","modes":["fm-worker-stalls","fm-revocation-notice-lost","fm-purge-lost","fm-provisioning-step-fails","fm-provider-outage","fm-runtime-crash","fm-copy-store-outage","fm-mail-outage","fm-automation-worker-partition"],"bounds":[{"scope":"zone","maxConcurrent":1,"source":"d-23"}]}
  ],

  // ---- Data model: records and the copies made of them -------------------------------------------
  "types": [
    {"id":"tenant-id","name":"tenant-id","kind":"id","repr":"string","description":"Lower-case name, [a-z][a-z0-9_]*, at most 64 bytes (kernel TenantId)."},
    {"id":"principal-id","name":"principal-id","kind":"id","repr":"string","description":"Assigned by the shell, opaque to the kernel (kernel PrincipalId)."},
    {"id":"session-id","name":"session-id","kind":"id","repr":"string","description":"The public identifier of a session, never the secret token (kernel SessionId)."},
    {"id":"object-type-id","name":"object-type-id","kind":"id","repr":"string","description":"An object type within a tenant (kernel ObjectTypeId)."},
    {"id":"workflow-id","name":"workflow-id","kind":"id","repr":"string","description":"A workflow of a tenant (kernel WorkflowId)."},
    {"id":"record-id","name":"record-id","kind":"id","repr":"u64","description":"Allocated from the tenant counter (kernel RecordId)."},
    {"id":"placement-id","name":"placement-id","kind":"id","repr":"uuid"},
    {"id":"credential-id","name":"credential-id","kind":"id","repr":"uuid"},
    {"id":"link-id","name":"link-id","kind":"id","repr":"uuid"},
    {"id":"provider-id","name":"provider-id","kind":"id","repr":"uuid"},
    {"id":"challenge-id","name":"challenge-id","kind":"id","repr":"uuid"},
    {"id":"grant-id","name":"grant-id","kind":"id","repr":"uuid"},
    {"id":"job-id","name":"job-id","kind":"id","repr":"uuid"},
    {"id":"schedule-id","name":"schedule-id","kind":"id","repr":"uuid"},
    {"id":"run-id","name":"run-id","kind":"id","repr":"uuid"},
    {"id":"proposal-id","name":"proposal-id","kind":"id","repr":"uuid"},
    {"id":"submission-id","name":"submission-id","kind":"id","repr":"uuid"},
    {"id":"conversation-id","name":"conversation-id","kind":"id","repr":"uuid"},
    {"id":"turn-id","name":"turn-id","kind":"id","repr":"uuid"},
    {"id":"pending-id","name":"pending-id","kind":"id","repr":"uuid"},
    {"id":"consent-id","name":"consent-id","kind":"id","repr":"uuid"},
    {"id":"visitor-id","name":"visitor-id","kind":"id","repr":"uuid"},
    {"id":"log-id","name":"log-id","kind":"id","repr":"uuid"},
    {"id":"request-id","name":"request-id","kind":"id","repr":"uuid"},
    {"id":"key-id","name":"key-id","kind":"id","repr":"uuid"},
    {"id":"subprocessor-id","name":"subprocessor-id","kind":"id","repr":"uuid"},
    {"id":"hold-id","name":"hold-id","kind":"id","repr":"uuid"},
    {"id":"message-id","name":"message-id","kind":"id","repr":"uuid"},
    {"id":"release-id","name":"release-id","kind":"id","repr":"uuid"},
    {"id":"move-id","name":"move-id","kind":"id","repr":"uuid"},
    {"id":"correlation-id","name":"correlation-id","kind":"id","repr":"uuid"},
    {"id":"identifier","name":"identifier","kind":"id","repr":"uuid"},
    {"id":"cluster-id","name":"cluster-id","kind":"id","repr":"string"},
    {"id":"region-id","name":"region-id","kind":"id","repr":"string"},
    {"id":"database-id","name":"database-id","kind":"id","repr":"string"},
    {"id":"plan-id","name":"plan-id","kind":"id","repr":"string"},
    {"id":"form-id","name":"form-id","kind":"id","repr":"string"},
    {"id":"template-id","name":"template-id","kind":"id","repr":"string"},
    {"id":"environment-id","name":"environment-id","kind":"id","repr":"string"},
    {"id":"colour-id","name":"colour-id","kind":"id","repr":"string"},
    {"id":"migration-id","name":"migration-id","kind":"id","repr":"string"},
    {"id":"host","name":"host","kind":"scalar","repr":"string"},
    {"id":"display-name","name":"display-name","kind":"scalar","repr":"string"},
    {"id":"email-address","name":"email-address","kind":"scalar","repr":"string"},
    {"id":"hash","name":"hash","kind":"scalar","repr":"string","description":"A hash in text form, as the storage layer holds token hashes."},
    {"id":"external-subject","name":"external-subject","kind":"scalar","repr":"string"},
    {"id":"url","name":"url","kind":"scalar","repr":"string"},
    {"id":"domain","name":"domain","kind":"scalar","repr":"string"},
    {"id":"ip-address","name":"ip-address","kind":"scalar","repr":"string"},
    {"id":"address-text","name":"address-text","kind":"scalar","repr":"string"},
    {"id":"text","name":"text","kind":"scalar","repr":"string","description":"Free text."},
    {"id":"reference","name":"reference","kind":"scalar","repr":"string","description":"A reference to a record or a copy, in text form."},
    {"id":"wrapped-secret","name":"wrapped-secret","kind":"scalar","repr":"bytes","description":"A secret wrapped by the key service."},
    {"id":"secret","name":"secret","kind":"scalar","repr":"bytes","description":"A sealed secret."},
    {"id":"expression","name":"expression","kind":"scalar","repr":"string"},
    {"id":"schema","name":"schema","kind":"scalar","repr":"string","description":"A tenant schema as the JSON text that storage holds."},
    {"id":"value-map","name":"value-map","kind":"scalar","repr":"string","description":"A map of field values as JSON text."},
    {"id":"event-body","name":"event-body","kind":"scalar","repr":"string","description":"The body of a domain event as JSON text."},
    {"id":"change-set","name":"change-set","kind":"scalar","repr":"string","description":"A set of changes as JSON text."},
    {"id":"structured-blocks","name":"structured-blocks","kind":"scalar","repr":"string","description":"Structured content blocks as JSON text."},
    {"id":"recurrence","name":"recurrence","kind":"scalar","repr":"string","description":"A recurrence rule."},
    {"id":"workflow-state","name":"workflow-state","kind":"scalar","repr":"string","description":"The state a tenant workflow gives a record; tenant-defined."},
    {"id":"tenant-state","name":"tenant-state","kind":"enum","values":["provisioning","active","suspended"]},
    {"id":"principal-state","name":"principal-state","kind":"enum","values":["active","suspended","erased"]},
    {"id":"certificate-state","name":"certificate-state","kind":"enum","values":["pending","valid","expired"]},
    {"id":"domain-state","name":"domain-state","kind":"enum","values":["pending","proved"]},
    {"id":"job-state","name":"job-state","kind":"enum","values":["waiting","leased","completed","failed","cancelled"]},
    {"id":"run-state","name":"run-state","kind":"enum","values":["running","completed","failed","cancelled"]},
    {"id":"proposal-state","name":"proposal-state","kind":"enum","values":["projecting","awaiting-approval","cleared","rejected","applied"]},
    {"id":"message-state","name":"message-state","kind":"enum","values":["queued","submitted","sent","failed"]},
    {"id":"release-state","name":"release-state","kind":"enum","values":["candidate","staged","live","rolled-back"]},
    {"id":"migration-state","name":"migration-state","kind":"enum","values":["not-started","running","stopped","complete"]},
    {"id":"move-state","name":"move-state","kind":"enum","values":["source-serves","copying","frozen","verified","target-serves"]},
    {"id":"principal-kind","name":"principal-kind","kind":"enum","values":["person","service","agent"]},
    {"id":"credential-kind","name":"credential-kind","kind":"enum","values":["password","passkey","totp"]},
    {"id":"provider-protocol","name":"provider-protocol","kind":"enum","values":["oidc","saml"]},
    {"id":"challenge-kind","name":"challenge-kind","kind":"enum","values":["link","oidc","saml"]},
    {"id":"conversation-state","name":"conversation-state","kind":"enum","values":["open","closed"]},
    {"id":"turn-state","name":"turn-state","kind":"enum","values":["streaming","complete","interrupted","failed"]},
    {"id":"pending-action-state","name":"pending-action-state","kind":"enum","values":["previewed","confirmed","applied","cancelled","refused"]},
    {"id":"consent-decision","name":"consent-decision","kind":"enum","values":["granted","refused","withdrawn"]},
    {"id":"signal-kind","name":"signal-kind","kind":"enum","values":["log","span","metric"]},
    {"id":"job-attempt-outcome","name":"job-attempt-outcome","kind":"enum","values":["completed","failed","cancelled"]},
    {"id":"subject-key-state","name":"subject-key-state","kind":"enum","values":["live","destroyed"]},
    {"id":"suppression-reason","name":"suppression-reason","kind":"enum","values":["bounce","complaint","unsubscribe"]},
    {"id":"rollback-class","name":"rollback-class","kind":"enum","values":["rollback-safe","roll-forward-only"]},
    {"id":"environment-kind","name":"environment-kind","kind":"enum","values":["stage","production"]}
  ],
  "records": [
    {"id":"rec-tenant","name":"Tenant","owner":"control-plane","key":["tenant-id"],"fields":[{"name":"tenant-id","type":"tenant-id","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64}},{"name":"state","type":"tenant-state"},{"name":"plan","type":"plan-id"},{"name":"placement-id","type":"placement-id","refersTo":"rec-placement","onDelete":"restrict"}],"retention":"Until the tenant is deleted (TEN-011), with the certificate of PRV-354.","schemaVersion":1},
    {"id":"rec-placement","name":"Placement","owner":"control-plane","key":["placement-id"],"fields":[{"name":"placement-id","type":"placement-id"},{"name":"cluster","type":"cluster-id"},{"name":"region","type":"region-id"},{"name":"database","type":"database-id"}],"retention":"Until the tenant is deleted or moved.","schemaVersion":1},
    {"id":"rec-domain-binding","name":"Domain binding","owner":"control-plane","key":["host"],"fields":[{"name":"host","type":"host"},{"name":"tenant-id","type":"tenant-id","refersTo":"rec-tenant","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64},"onDelete":"cascade"},{"name":"certificate-state","type":"certificate-state"}],"retention":"Until the binding is removed (EDG-008).","schemaVersion":1},
    {"id":"rec-wake-entry","name":"Wake entry","owner":"control-plane","key":["tenant-id"],"fields":[{"name":"tenant-id","type":"tenant-id","refersTo":"rec-tenant","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64},"onDelete":"cascade"},{"name":"due-at","type":"timestamp"}],"retention":"Replaced on every change of the tenant's next due time.","schemaVersion":1},
    {"id":"rec-principal","name":"Principal","owner":"identity-service","key":["principal-id"],"fields":[{"name":"principal-id","type":"principal-id","refersTo":"principal","role":"subject","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"kind","type":"principal-kind"},{"name":"state","type":"principal-state"},{"name":"display-name","type":"display-name","personal":"name"},{"name":"email","type":"email-address","personal":"contact"}],"retention":"Until the principal is erased (PRV-353), with the tenant at the latest.","erasure":{"point":"the erasure of the principal (PRV-353), or the removal of the tenant if that comes first"},"schemaVersion":1},
    {"id":"rec-credential","name":"Credential","owner":"identity-service","key":["credential-id"],"fields":[{"name":"credential-id","type":"credential-id"},{"name":"principal-id","type":"principal-id","refersTo":"principal","role":"subject","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"kind","type":"credential-kind"},{"name":"secret-hash","type":"hash","personal":"credential"}],"retention":"Until replaced or the principal is erased.","erasure":{"point":"its replacement, or the erasure of the principal"},"schemaVersion":1},
    {"id":"rec-identity-link","name":"Identity link","owner":"identity-service","key":["link-id"],"fields":[{"name":"link-id","type":"link-id"},{"name":"principal-id","type":"principal-id","refersTo":"principal","role":"subject","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"provider-id","type":"provider-id","refersTo":"rec-provider-config","onDelete":"restrict"},{"name":"external-subject","type":"external-subject","personal":"identifier"}],"retention":"Until unlinked or the principal is erased.","erasure":{"point":"its unlinking, or the erasure of the principal"},"schemaVersion":1},
    {"id":"rec-provider-config","name":"Identity provider configuration","owner":"identity-service","key":["provider-id"],"fields":[{"name":"provider-id","type":"provider-id"},{"name":"protocol","type":"provider-protocol"},{"name":"issuer","type":"url"},{"name":"email-domain","type":"domain"},{"name":"client-secret","type":"wrapped-secret"}],"retention":"Until the tenant removes the provider.","schemaVersion":1},
    {"id":"rec-session","name":"Sign-in session","owner":"identity-service","key":["session-id"],"fields":[{"name":"session-id","type":"session-id","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96}},{"name":"principal-id","type":"principal-id","refersTo":"principal","role":"subject","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"secret-hash","type":"hash","personal":"credential"},{"name":"authenticated-at","type":"timestamp"},{"name":"expires-at","type":"timestamp"},{"name":"revoked-at","type":"timestamp","optional":true}],"retention":"A day after it ends, so that a revocation can be explained. It holds no network address in clear form and no user agent (PRV-364).","erasure":{"point":"the session ends","bound":1,"unit":"day"},"schemaVersion":1,"unique":[["secret-hash"]],"indexes":[{"name":"sessions_principal","fields":["principal-id"]}]},
    {"id":"rec-challenge","name":"Sign-in challenge","owner":"identity-service","key":["challenge-id"],"fields":[{"name":"challenge-id","type":"challenge-id"},{"name":"kind","type":"challenge-kind"},{"name":"token-hash","type":"hash","personal":"credential"},{"name":"principal-id","type":"principal-id","refersTo":"principal","role":"subject","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"browser-binding","type":"hash"},{"name":"expires-at","type":"timestamp"},{"name":"consumed","type":"bool"}],"retention":"Removed at its expiry or at its consumption, whichever comes first. The principal is named only when the address has an account (PRV-365).","erasure":{"point":"its expiry or its consumption, whichever comes first"},"schemaVersion":1},
    {"id":"rec-grant","name":"Grant","owner":"identity-service","key":["grant-id"],"fields":[{"name":"grant-id","type":"grant-id"},{"name":"principal-id","type":"principal-id","refersTo":"principal","role":"subject","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"delegator","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"optional":true,"onDelete":"restrict"},{"name":"scopes","type":"list<string>"},{"name":"revoked-at","type":"timestamp","optional":true},{"name":"expires-at","type":"timestamp"}],"retention":"Until revoked or its expiry passes, then removed with its last token.","schemaVersion":1},
    {"id":"rec-schema","name":"Tenant schema","owner":"runtime","key":["schema-version"],"fields":[{"name":"schema-version","type":"u64"},{"name":"definition","type":"schema"}],"retention":"Every version is kept in the schema history.","schemaVersion":1},
    {"id":"rec-content","name":"Content record","owner":"runtime","key":["object","record-id"],"fields":[{"name":"object","type":"object-type-id","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64}},{"name":"record-id","type":"record-id"},{"name":"version","type":"u64"},{"name":"status","type":"workflow-state"},{"name":"fields","type":"value-map","personal":"other"},{"name":"public-fields","type":"value-map"},{"name":"created-by","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"}],"retention":"Until deleted by the tenant or removed by its retention rule (PRV-356), with every version (CMS-006).","erasure":{"point":"its deletion by the tenant, or the end of its retention rule (PRV-356)"},"schemaVersion":1},
    {"id":"rec-event","name":"Domain event","owner":"runtime","key":["seq"],"fields":[{"name":"seq","type":"u64"},{"name":"revision","type":"u64"},{"name":"body","type":"event-body","personal":"other"},{"name":"actor","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"correlation","type":"correlation-id"}],"retention":"Within the restore window the tenant chooses (D-522), then truncated after a snapshot that carries the state hash at its start.","erasure":{"point":"truncation after the snapshot that closes the restore window the tenant chose (D-522)"},"schemaVersion":1},
    {"id":"rec-job","name":"Job","owner":"automation-worker","key":["job-id"],"fields":[{"name":"job-id","type":"job-id"},{"name":"due-at","type":"timestamp"},{"name":"state","type":"job-state"},{"name":"attempt","type":"u64"},{"name":"lease-token","type":"u64"},{"name":"idempotency-key","type":"string"}],"retention":"Thirty days after its outcome.","schemaVersion":1},
    {"id":"rec-schedule","name":"Schedule","owner":"automation-worker","key":["schedule-id"],"fields":[{"name":"schedule-id","type":"schedule-id"},{"name":"rule","type":"recurrence"},{"name":"paused","type":"bool"},{"name":"next-due","type":"timestamp"}],"retention":"Until removed by the tenant.","schemaVersion":1},
    {"id":"rec-workflow-run","name":"Workflow run","owner":"automation-worker","key":["run-id"],"fields":[{"name":"run-id","type":"run-id"},{"name":"workflow","type":"workflow-id","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64}},{"name":"state","type":"run-state"},{"name":"step","type":"u64"}],"retention":"Ninety days after it ends.","schemaVersion":1},
    {"id":"rec-audit-entry","name":"Audit entry","owner":"audit-log","key":["seq"],"fields":[{"name":"seq","type":"u64"},{"name":"actor","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"on-behalf-of","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"optional":true,"onDelete":"restrict"},{"name":"action","type":"string"},{"name":"outcome","type":"string"},{"name":"correlation","type":"correlation-id"},{"name":"previous-hash","type":"hash","optional":true}],"retention":"Under the audit retention of the tenant policy, which the platform defaults to one year. Principal identifiers are sealed (PRV-358), and the chain is kept over the sealed form (PRV-360).","schemaVersion":1},
    {"id":"rec-platform-audit-entry","name":"Platform audit entry","owner":"platform-audit-store","key":["seq"],"fields":[{"name":"seq","type":"u64"},{"name":"actor","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"action","type":"string"},{"name":"outcome","type":"string"},{"name":"correlation","type":"correlation-id"},{"name":"previous-hash","type":"hash","optional":true}],"retention":"Seven years after the entry (D-707), then removed. An entry names a platform operator or a service and no tenant content.","schemaVersion":1},
    {"id":"rec-proposal","name":"Change proposal","owner":"agent-gateway","key":["proposal-id"],"fields":[{"name":"proposal-id","type":"proposal-id"},{"name":"author","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"approver","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"optional":true,"onDelete":"restrict"},{"name":"change","type":"change-set","personal":"other"},{"name":"projected-at-revision","type":"u64"},{"name":"state","type":"proposal-state"}],"retention":"A year after it is closed.","erasure":{"point":"the proposal is closed","bound":365,"unit":"day"},"schemaVersion":1},
    {"id":"rec-submission","name":"Form submission","owner":"runtime","key":["submission-id"],"fields":[{"name":"submission-id","type":"submission-id"},{"name":"form","type":"form-id"},{"name":"submitted-at","type":"timestamp"},{"name":"email","type":"email-address","personal":"contact"},{"name":"values","type":"value-map","personal":"contact"}],"retention":"Until the retention period of its form ends (PRV-357).","erasure":{"point":"the end of the retention period of its form (PRV-357)"},"schemaVersion":1},
    {"id":"rec-cnv-conversation","name":"Conversation","owner":"conversation-service","key":["conversation-id"],"fields":[{"name":"conversation-id","type":"conversation-id"},{"name":"principal-id","type":"principal-id","refersTo":"principal","role":"subject","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"started-at","type":"timestamp"},{"name":"state","type":"conversation-state"}],"retention":"Until the person or the tenant deletes it, and with the tenant at the latest (CNV-229).","schemaVersion":1},
    {"id":"rec-cnv-turn","name":"Turn","owner":"conversation-service","key":["turn-id"],"fields":[{"name":"turn-id","type":"turn-id"},{"name":"conversation-id","type":"conversation-id","refersTo":"rec-cnv-conversation","onDelete":"restrict"},{"name":"actor","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"body","type":"structured-blocks","personal":"activity"},{"name":"state","type":"turn-state"},{"name":"correlation","type":"correlation-id"}],"retention":"Until its conversation is deleted (CNV-229).","erasure":{"point":"the deletion of its conversation (CNV-229)"},"schemaVersion":1},
    {"id":"rec-cnv-pending-action","name":"Pending action","owner":"conversation-service","key":["pending-id"],"fields":[{"name":"pending-id","type":"pending-id"},{"name":"conversation-id","type":"conversation-id","refersTo":"rec-cnv-conversation","onDelete":"restrict"},{"name":"person","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"assistant","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"change","type":"change-set"},{"name":"projected-at-revision","type":"u64"},{"name":"state","type":"pending-action-state"},{"name":"proposal-id","type":"proposal-id","refersTo":"rec-proposal","optional":true,"onDelete":"restrict"}],"retention":"Ninety days after it is closed.","schemaVersion":1},
    {"id":"rec-consent-record","name":"Consent record","owner":"runtime","key":["consent-id"],"fields":[{"name":"consent-id","type":"consent-id"},{"name":"subject","type":"visitor-id","personal":"identifier"},{"name":"purpose","type":"string"},{"name":"decision","type":"consent-decision"},{"name":"text-shown","type":"text"},{"name":"decided-at","type":"timestamp"}],"retention":"Kept while the consent holds, then one year after it is withdrawn, as evidence of the decision (PRV-375).","erasure":{"point":"the consent is withdrawn (PRV-375)","bound":365,"unit":"day"},"schemaVersion":1},
    {"id":"rec-log-line","name":"Log line","owner":"telemetry-pipeline","key":["log-id"],"fields":[{"name":"log-id","type":"log-id"},{"name":"signal","type":"signal-kind"},{"name":"tenant-id","type":"tenant-id","refersTo":"rec-tenant","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64},"onDelete":"restrict"},{"name":"correlation","type":"correlation-id"},{"name":"event-code","type":"string"},{"name":"client-address","type":"ip-address","personal":"identifier"}],"retention":"Fourteen days, then removed by the pipeline. The client address has its host part removed (PRV-363).","erasure":{"point":"the line is written","bound":14,"unit":"day"},"schemaVersion":1},
    {"id":"rec-cdn-access-log","name":"Access log of the content delivery network","owner":"delivery-network","key":["request-id"],"fields":[{"name":"request-id","type":"request-id"},{"name":"host","type":"host"},{"name":"path","type":"string","personal":"other"},{"name":"client-address","type":"ip-address","personal":"identifier"},{"name":"status","type":"u16"},{"name":"at","type":"timestamp"}],"retention":"Seven days, then removed by the network. The client address has its host part removed (PRV-363).","erasure":{"point":"the line is written","bound":7,"unit":"day"},"schemaVersion":1},
    {"id":"rec-job-attempt","name":"Job attempt","owner":"automation-worker","key":["job-id","attempt"],"fields":[{"name":"job-id","type":"job-id"},{"name":"attempt","type":"u64"},{"name":"started-at","type":"timestamp"},{"name":"outcome","type":"job-attempt-outcome"},{"name":"error-text","type":"text","personal":"other"}],"retention":"Thirty days after the outcome of the job, with the job (SCH-014).","erasure":{"point":"the outcome of the job (SCH-014)","bound":30,"unit":"day"},"schemaVersion":1},
    {"id":"rec-effect-record","name":"Effect record","owner":"automation-worker","key":["idempotency-key"],"fields":[{"name":"idempotency-key","type":"string"},{"name":"step","type":"string"},{"name":"target","type":"address-text","personal":"contact"},{"name":"outcome","type":"string"},{"name":"sent-at","type":"timestamp"}],"retention":"Ninety days after the outcome, or until the retry window of its job closes if that is later. No body is kept (PRV-366).","erasure":{"point":"ninety days after the outcome, or the close of the retry window of its job if that is later"},"schemaVersion":1},
    {"id":"rec-subject-key","name":"Subject key","owner":"key-service","key":["key-id"],"fields":[{"name":"key-id","type":"key-id"},{"name":"subject","type":"principal-id","refersTo":"principal","role":"subject","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"wrapped-key","type":"wrapped-secret"},{"name":"state","type":"subject-key-state"},{"name":"destroyed-at","type":"timestamp","optional":true}],"retention":"Until destroyed. Destruction removes the wrapped key and the subject, and keeps the key identifier and the time (PRV-358, PRV-362).","schemaVersion":1},
    {"id":"rec-subprocessor","name":"Subprocessor","owner":"control-plane","key":["subprocessor-id"],"fields":[{"name":"subprocessor-id","type":"subprocessor-id"},{"name":"name","type":"text"},{"name":"role","type":"string"},{"name":"region","type":"region-id"},{"name":"data-categories","type":"list<string>"},{"name":"transfer-basis","type":"text"}],"retention":"Kept while the subprocessor is used, and one year after it is removed, as the record of processing (PRV-373).","schemaVersion":1},
    {"id":"rec-restriction","name":"Restriction","owner":"subject-rights-service","key":["principal-id"],"fields":[{"name":"principal-id","type":"principal-id","refersTo":"principal","role":"subject","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"restricted-since","type":"timestamp"},{"name":"reason","type":"text"}],"retention":"Until lifted or the principal is erased (PRV-352).","schemaVersion":1},
    {"id":"rec-legal-hold","name":"Legal hold","owner":"runtime","key":["hold-id"],"fields":[{"name":"hold-id","type":"hold-id"},{"name":"scope","type":"text"},{"name":"set-by","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"reason","type":"text"},{"name":"released-at","type":"timestamp","optional":true}],"retention":"Until released by the tenant owner, then one year as the record of the hold (PRV-355).","schemaVersion":1},
    {"id":"rec-access-grant","name":"Access grant","owner":"identity-service","key":["grant-id"],"fields":[{"name":"grant-id","type":"grant-id"},{"name":"operator","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"issued-by","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"purpose","type":"text"},{"name":"expires-at","type":"timestamp"},{"name":"withdrawn-at","type":"timestamp","optional":true},{"name":"shown-to-tenant","type":"bool"}],"retention":"Kept in the tenant database for the life of the tenant, as the record of who read its data (PRV-370). It stops authorising anything when it expires or is withdrawn.","schemaVersion":1},
    {"id":"rec-file-bytes","name":"Stored file content","owner":"file-store","key":["content-hash"],"fields":[{"name":"content-hash","type":"hash"},{"name":"public-bytes","type":"bytes"},{"name":"private-bytes","type":"bytes","personal":"other"},{"name":"uploaded-by","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"}],"retention":"Until no record refers to it. Private bytes are removed when the uploader is erased (PRV-353).","erasure":{"point":"the removal of the last record that refers to it; private bytes at the erasure of the uploader (PRV-353)"},"schemaVersion":1},
    {"id":"rec-content-token","name":"Content token","owner":"runtime","key":["token-name"],"fields":[{"name":"token-name","type":"string"},{"name":"expression","type":"expression"},{"name":"fallback","type":"text"},{"name":"description","type":"text"}],"retention":"Every version is kept in the schema history.","schemaVersion":1},
    {"id":"rec-mail-template","name":"Mail template","owner":"runtime","key":["template-id"],"fields":[{"name":"template-id","type":"template-id"},{"name":"subject","type":"text"},{"name":"blocks","type":"structured-blocks"}],"retention":"Every version is kept in the schema history.","schemaVersion":1},
    {"id":"rec-mail-message","name":"Mail message","owner":"mail-dispatcher","key":["message-id"],"fields":[{"name":"message-id","type":"message-id"},{"name":"idempotency-key","type":"string"},{"name":"recipient","type":"principal-id","refersTo":"principal","role":"subject","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"address","type":"email-address","personal":"contact"},{"name":"template-id","type":"template-id","refersTo":"rec-mail-template","onDelete":"restrict"},{"name":"state","type":"message-state"},{"name":"attempts","type":"u64"},{"name":"provider-reference","type":"string","optional":true}],"retention":"Thirty days after its final state. The body is dropped when the provider accepts the message (EML-011).","erasure":{"point":"its final state (EML-011)","bound":30,"unit":"day"},"schemaVersion":1},
    {"id":"rec-mail-suppression","name":"Suppressed address","owner":"mail-dispatcher","key":["address-hash"],"fields":[{"name":"address-hash","type":"hash","personal":"contact"},{"name":"reason","type":"suppression-reason"},{"name":"recorded-at","type":"timestamp"}],"retention":"Until the tenant removes the entry. Held as a hash, so the list does not disclose the addresses on it.","erasure":{"point":"the removal of the entry by the tenant"},"schemaVersion":1},
    {"id":"rec-sender-domain","name":"Sender domain","owner":"mail-dispatcher","key":["domain"],"fields":[{"name":"domain","type":"domain"},{"name":"state","type":"domain-state"},{"name":"proved-at","type":"timestamp","optional":true},{"name":"signing-key","type":"wrapped-secret"}],"retention":"Until the tenant removes the domain.","schemaVersion":1},
    {"id":"rec-release-record","name":"Release record","owner":"release-controller","key":["release-id"],"fields":[{"name":"release-id","type":"release-id"},{"name":"environment","type":"environment-id","refersTo":"rec-platform-environment","onDelete":"restrict"},{"name":"commit","type":"string"},{"name":"image-digests","type":"list<string>"},{"name":"author","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"approvers","type":"list<principal-id>","refersTo":"principal","role":"party","onDelete":"restrict"},{"name":"gate-results","type":"list<string>"},{"name":"rollback-class","type":"rollback-class"},{"name":"live-colour","type":"colour-id"},{"name":"state","type":"release-state"}],"retention":"Three years after the release is superseded, as the record of change to the platform (REL-581).","schemaVersion":1},
    {"id":"rec-platform-environment","name":"Platform environment","owner":"release-controller","key":["environment-id"],"fields":[{"name":"environment-id","type":"environment-id"},{"name":"kind","type":"environment-kind"},{"name":"account","type":"string"},{"name":"region","type":"region-id"},{"name":"definition-commit","type":"string"},{"name":"live-colour","type":"colour-id"}],"retention":"For the life of the environment.","schemaVersion":1},
    {"id":"rec-migration-run","name":"Migration run","owner":"migration-job","key":["run-id"],"fields":[{"name":"run-id","type":"run-id"},{"name":"tenant-id","type":"tenant-id","refersTo":"rec-tenant","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64},"onDelete":"restrict"},{"name":"change","type":"migration-id"},{"name":"cursor","type":"u64"},{"name":"state","type":"migration-state"},{"name":"started-by","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"}],"retention":"Kept with the schema history of the tenant (MIG-556).","schemaVersion":1},
    {"id":"rec-tenant-move","name":"Tenant move","owner":"control-plane","key":["move-id"],"fields":[{"name":"move-id","type":"move-id"},{"name":"tenant-id","type":"tenant-id","refersTo":"rec-tenant","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64},"onDelete":"restrict"},{"name":"source-placement","type":"placement-id","refersTo":"rec-placement","onDelete":"restrict"},{"name":"target-placement","type":"placement-id","refersTo":"rec-placement","onDelete":"restrict"},{"name":"state","type":"move-state"},{"name":"source-hash","type":"hash"},{"name":"target-hash","type":"hash"},{"name":"frozen-at","type":"timestamp","optional":true}],"retention":"For the life of the tenant, as the record of its placement (MIG-570).","schemaVersion":1},
    {"id":"rec-file","name":"Stored file","owner":"file-store","key":["content-hash"],"fields":[{"name":"content-hash","type":"hash"},{"name":"size","type":"u64"},{"name":"media-type","type":"string"}],"retention":"Until no record refers to it.","schemaVersion":1},
    {"id":"rec-inbox-item","name":"inbox item","owner":"notification-service","key":["item-id"],"fields":[{"name":"item-id","type":"identifier"},{"name":"recipient","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"record-ref","type":"reference"},{"name":"state","type":"text"},{"name":"created-at","type":"timestamp"},{"name":"body","type":"text","personal":"other"}],"retention":"Until its recipient removes it or the record it names is erased (NTF-151).","erasure":{"point":"its removal by the recipient, or the erasure of the record it names (NTF-151)"},"schemaVersion":1},
    {"id":"rec-subscription","name":"subscription","owner":"notification-service","key":["subscription-id"],"fields":[{"name":"subscription-id","type":"identifier"},{"name":"subscriber","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"topic","type":"text"},{"name":"channel","type":"text"}],"retention":"Until the subscriber removes it or the subscriber is erased (NTF-151).","schemaVersion":1},
    {"id":"rec-webhook-subscription","name":"webhook subscription","owner":"automation-worker","key":["subscription-id"],"fields":[{"name":"subscription-id","type":"identifier"},{"name":"endpoint","type":"text"},{"name":"secret-sealed","type":"secret","personal":"credential"},{"name":"state","type":"text"}],"retention":"Until the owner removes it; the secret is sealed under the key of the tenant (SEC-003, WFL-010).","erasure":{"point":"its removal by the owner"},"schemaVersion":1},
    {"id":"rec-connector-secret","name":"connector secret","owner":"automation-worker","key":["secret-id"],"fields":[{"name":"secret-id","type":"identifier"},{"name":"sealed-value","type":"secret","personal":"credential"},{"name":"connector","type":"text"}],"retention":"Until the owner removes it; stored only encrypted, under a wrapping key held by the key service (SEC-003).","erasure":{"point":"its removal by the owner"},"schemaVersion":1},
    {"id":"rec-delivery-key","name":"delivery key","owner":"runtime","key":["key-id"],"fields":[{"name":"key-id","type":"identifier"},{"name":"site","type":"text"},{"name":"audience-class","type":"text"},{"name":"secret-hash","type":"hash","personal":"credential"},{"name":"revoked-at","type":"timestamp","optional":true}],"retention":"Until its owner removes it; a revoked key is refused on the terms of a revoked session (CMS-166, CMS-167).","erasure":{"point":"its removal by the owner"},"schemaVersion":1},
    {"id":"rec-form","name":"form","owner":"runtime","key":["form-id"],"fields":[{"name":"form-id","type":"form-id"},{"name":"definition","type":"text"},{"name":"notice-subscriptions","type":"text"}],"retention":"Until the form is removed.","schemaVersion":1},
    {"id":"rec-redirect","name":"redirect","owner":"runtime","key":["from-address"],"fields":[{"name":"from-address","type":"text"},{"name":"to-address","type":"text"},{"name":"created-by","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"}],"retention":"Until the site is removed (CMS-161, CMS-162, MIG-577).","schemaVersion":1},
    {"id":"rec-feature-flag","name":"feature flag","owner":"release-controller","key":["flag-id","tenant-id"],"fields":[{"name":"flag-id","type":"identifier"},{"name":"tenant-id","type":"tenant-id","refersTo":"rec-tenant","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64},"onDelete":"cascade"},{"name":"enabled","type":"bool"},{"name":"release-id","type":"text"}],"retention":"Until the release that set it is removed from the release records (OPS-328, AGT-420).","schemaVersion":1},
    {"id":"rec-plan","name":"plan","owner":"control-plane","key":["plan-id"],"fields":[{"name":"plan-id","type":"identifier"},{"name":"tenant-id","type":"tenant-id","refersTo":"rec-tenant","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64},"onDelete":"cascade"},{"name":"quotas","type":"text"},{"name":"grace-period","type":"text"}],"retention":"The tenant lifecycle; the plan is kept for the grace period it states (BIL-150, ADM-160).","schemaVersion":1},
    {"id":"rec-usage-meter","name":"usage meter","owner":"limit-store","key":["tenant-id","measure","window"],"fields":[{"name":"tenant-id","type":"tenant-id","refersTo":"rec-tenant","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64},"onDelete":"cascade"},{"name":"measure","type":"text"},{"name":"window","type":"text"},{"name":"value","type":"u64"}],"retention":"Kept for the billing and reporting window the plan states (OPS-345).","schemaVersion":1},
    {"id":"rec-erasure-receipt","name":"erasure receipt","owner":"subject-rights-service","key":["request-id"],"fields":[{"name":"request-id","type":"identifier"},{"name":"principal-id","type":"principal-id","refersTo":"principal","role":"subject","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"record-ref","type":"reference"},{"name":"copy-ref","type":"reference"},{"name":"erasure-point","type":"text"},{"name":"at","type":"timestamp"}],"retention":"Kept as the receipt of the erasure it records (PRV-353).","schemaVersion":1}
  ],
  "copies": [
    {"id":"copy-compiled-schema","name":"Compiled schema","of":["rec-schema"],"heldBy":"runtime","scope":"internal","freshness":{"bound":"zero","mechanism":"keyed by tenant and schema version, so a new version is a new entry","source":"d-14"},"description":"copy-classes: compiled-schema.","erasure":{"point":"dropped when the tenant is deleted or the process ends"}},
    {"id":"copy-directory-entry","name":"Directory entry","of":["rec-tenant","rec-placement","rec-domain-binding"],"fields":["rec-tenant.tenant-id","state","cluster","region","database","host"],"heldBy":"gateway","scope":"internal","freshness":{"bound":15,"unit":"minute","mechanism":"refreshed from the tenant directory; served for at most 15 minutes after the control plane was last reached","source":"arc-500"},"description":"copy-classes: directory-entry.","erasure":{"point":"the next refresh after a tenant is deleted"}},
    {"id":"copy-session-assertion","name":"Session assertion","of":["rec-session"],"fields":["session-id","rec-session.principal-id","authenticated-at","expires-at"],"heldBy":"gateway","scope":"per-session","freshness":{"bound":5,"unit":"second","mechanism":"revocation notice, and a recheck when the copy is older than the bound","source":"idn-014"},"erasure":{"point":"the revocation notice, or the next recheck","bound":5,"unit":"second","source":"idn-014"},"dependsOnAuthority":true,"description":"copy-classes: session-assertion."},
    {"id":"copy-public-view","name":"Public view","of":["rec-content"],"fields":["object","record-id","version","status","public-fields"],"heldBy":"copy-store","scope":"shared","freshness":{"bound":"zero","mechanism":"the key contains the revision of every object type the view depends on","source":"d-14"},"description":"copy-classes: public-view. Holds published fields only and no principal.","erasure":{"point":"superseded by the commit of the deletion"}},
    {"id":"copy-audience-view","name":"Audience view","of":["rec-content"],"heldBy":"copy-store","scope":"per-principal","freshness":{"bound":"zero","mechanism":"the key contains the audience class and the revision of every object type the view depends on","source":"d-15"},"erasure":{"point":"superseded by the commit of the deletion, removed by tag within the bound","bound":2,"unit":"second","source":"cpy-009"},"dependsOnAuthority":true,"description":"copy-classes: audience-view."},
    {"id":"copy-edge-page","name":"Edge page","of":["rec-content"],"fields":["object","record-id","version","status","public-fields"],"heldBy":"delivery-network","scope":"shared","freshness":{"bound":5,"unit":"second","mechanism":"surrogate-key purge sent by the commit, with the lifetime as backstop","source":"edg-007"},"description":"copy-classes: edge-page.","erasure":{"point":"the purge sent by the commit of the deletion"}},
    {"id":"copy-runtime-directory-entry","name":"Directory entry held by the runtime","of":["rec-tenant","rec-placement","rec-domain-binding"],"fields":["rec-tenant.tenant-id","state","cluster","region","database","host"],"heldBy":"runtime","scope":"internal","freshness":{"bound":15,"unit":"minute","mechanism":"refreshed from the tenant directory; served for at most 15 minutes after the control plane was last reached","source":"arc-500"},"description":"copy-classes: directory-entry. The runtime holds the placement it opens a tenant database with.","erasure":{"point":"the next refresh after a tenant is deleted"}},
    {"id":"copy-cnv-model-context","name":"Model request context","of":["rec-cnv-turn","rec-content"],"heldBy":"model-provider","scope":"per-principal","freshness":{"bound":"zero","mechanism":"built from the current records for each request and held by the provider only for that request","source":"cnv-233"},"erasure":{"point":"the end of the request, or the retention the tenant contract sets with the provider, whichever is earlier","source":"cnv-235"},"dependsOnAuthority":true,"description":"The content of one model request, as far as the tenant policy permits it for the person served."},
    {"id":"copy-tenant-backup","name":"Tenant backup image","of":["rec-principal","rec-credential","rec-identity-link","rec-provider-config","rec-session","rec-challenge","rec-grant","rec-schema","rec-content","rec-event","rec-job","rec-job-attempt","rec-schedule","rec-workflow-run","rec-audit-entry","rec-proposal","rec-consent-record","rec-effect-record","rec-restriction","rec-legal-hold","rec-file","rec-file-bytes","rec-access-grant","rec-submission","rec-cnv-conversation","rec-cnv-turn","rec-cnv-pending-action","rec-mail-template","rec-mail-message","rec-mail-suppression","rec-sender-domain","rec-content-token","rec-migration-run","rec-delivery-key","rec-form","rec-redirect","rec-inbox-item","rec-subscription","rec-webhook-subscription","rec-connector-secret","rec-erasure-receipt"],"heldBy":"backup-archive","scope":"internal","freshness":{"bound":24,"unit":"hour","mechanism":"a new image is taken at each backup, and a restore reads the newest image","source":"d-25"},"erasure":{"point":"destruction of the subject key that seals each personal field of the image (PRV-358), and removal of the image at the end of its retention (D-351)","bound":35,"unit":"day","source":"d-706"},"description":"Encrypted images of a tenant database and of its files. A snapshot of tenant state is an image of this kind."},
    {"id":"copy-control-backup","name":"Control database backup image","of":["rec-tenant","rec-placement","rec-domain-binding","rec-wake-entry","rec-subprocessor","rec-plan"],"heldBy":"backup-archive","scope":"internal","freshness":{"bound":24,"unit":"hour","mechanism":"a new image is taken at each backup","source":"d-2"},"erasure":{"point":"removal of the image at the end of its retention (D-351); the operator identifiers in the access grants are sealed as PRV-358 requires","bound":35,"unit":"day","source":"d-706"},"description":"Encrypted images of the control database, which holds no tenant content."},
    {"id":"copy-tenant-export","name":"Tenant export archive","of":["rec-principal","rec-credential","rec-identity-link","rec-provider-config","rec-session","rec-challenge","rec-grant","rec-schema","rec-content","rec-event","rec-job","rec-job-attempt","rec-schedule","rec-workflow-run","rec-audit-entry","rec-proposal","rec-consent-record","rec-effect-record","rec-restriction","rec-legal-hold","rec-file","rec-file-bytes","rec-submission","rec-cnv-conversation","rec-cnv-turn","rec-cnv-pending-action","rec-mail-template","rec-mail-message","rec-mail-suppression","rec-sender-domain","rec-content-token","rec-migration-run","rec-delivery-key","rec-form","rec-redirect","rec-inbox-item","rec-subscription","rec-webhook-subscription","rec-connector-secret","rec-erasure-receipt"],"heldBy":"file-store","scope":"internal","freshness":{"bound":7,"unit":"day","mechanism":"a point-in-time archive that is not refreshed; it is removed at the end of its download window","source":"d-351"},"erasure":{"point":"removal of the archive at the end of its download window, or earlier at the tenant's request; the sealed fields are covered by PRV-358","bound":7,"unit":"day","source":"d-351"},"description":"The archive of a tenant export (TEN-010), written to the file namespace of the tenant."},
    {"id":"copy-mail-outbox","name":"Mail provider outbox","of":["rec-mail-message"],"fields":["address"],"heldBy":"mail-service","scope":"internal","freshness":{"bound":30,"unit":"day","mechanism":"the provider keeps each message for its own retention and then removes it","source":"d-9"},"erasure":{"point":"deletion by the provider at the end of its retention, and on the request of the controller","bound":30,"unit":"day","source":"d-9"},"description":"The provider holds the recipient address of each message it accepted, for its own retention. Messages carry the sign-in link; its token exists in no record in plain form, only as its hash."},
    {"id":"copy-support-snapshot","name":"Support view","of":["rec-principal","rec-identity-link"],"heldBy":"operator-console","scope":"per-principal","freshness":{"bound":1,"unit":"hour","mechanism":"a view made for one access grant and ended when the grant ends","source":"prv-367"},"erasure":{"point":"the end of the access grant, or the erasure of the principal (PRV-353)","bound":1,"unit":"hour","source":"prv-367"},"dependsOnAuthority":true,"description":"A view that a support engineer reads under an access grant."},
    {"id":"copy-telemetry-backend","name":"Telemetry backend","of":["rec-log-line"],"heldBy":"telemetry-pipeline","scope":"internal","freshness":{"bound":14,"unit":"day","mechanism":"lines are removed at the end of their retention","source":"prv-363"},"erasure":{"point":"removal at the end of retention","bound":14,"unit":"day","source":"prv-363"},"description":"The store of the telemetry export, which the pipeline itself keeps."},
    {"id":"copy-private-media","name":"Private media","of":["rec-file-bytes"],"fields":["content-hash","private-bytes"],"heldBy":"delivery-network","scope":"per-principal","freshness":{"bound":"zero","mechanism":"the address is derived from the content, and a signed address expires","source":"edg-012"},"erasure":{"point":"the purge sent when the file is deleted or its uploader is erased","bound":5,"unit":"second","source":"edg-007"},"dependsOnAuthority":true,"description":"Private files, served through signed addresses for the requesting principal."},
    {"id":"copy-edge-public-media","name":"Public media","of":["rec-file-bytes"],"fields":["content-hash","public-bytes"],"heldBy":"delivery-network","scope":"shared","freshness":{"bound":"zero","mechanism":"the address is derived from the content","source":"d-16"},"erasure":{"point":"the purge sent when the file is deleted","bound":5,"unit":"second","source":"edg-007"},"description":"Files that the tenant marked public. Holds no personal field."},
    {"id":"copy-live-colour","name":"Live colour routing","of":["rec-platform-environment"],"fields":["environment-id","live-colour"],"heldBy":"traffic-switch","scope":"internal","freshness":{"bound":"zero","mechanism":"pushed by the release controller at each colour switch","source":"d-556"},"description":"The colour that the public traffic of each environment reaches. It holds no personal field.","erasure":{"point":"not applicable: holds no personal field"}},
    {"id":"copy-move-replica","name":"Move replica","of":["rec-content","rec-event","rec-principal"],"heldBy":"postgres-adapter","scope":"internal","freshness":{"bound":"zero","mechanism":"verified by state hash before the placement switch, after which it is the tenant database","source":"d-576"},"erasure":{"point":"removal of the source database at the end of its retention (MIG-572)"},"description":"The copy of a tenant database that a move makes until the placement switch."},
    {"id":"copy-edge-media","name":"Edge media","of":["rec-file"],"heldBy":"delivery-network","scope":"shared","freshness":{"bound":"zero","mechanism":"the address is derived from the content","source":"d-16"},"description":"copy-classes: edge-media.","erasure":{"point":"the purge sent when the file is deleted"}},
    {"id":"copy-search-entries","name":"Search entries","of":["rec-content"],"fields":["record-id","status","fields"],"heldBy":"search-index","scope":"internal","freshness":{"bound":"the commit of the record","mechanism":"an entry follows the commit that changed its record, including the commit of its deletion","source":"srh-152"},"erasure":{"point":"the commit of the deletion of the record","source":"srh-152"},"description":"Search entries are read through the authority filter (SRH-150) and are never served as stored."}
  ]
}
