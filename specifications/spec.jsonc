  "uiScenarios": [
    {"id":"ui-front-page","name":"The front page shows the featured essay and the earlier ones","verifies":["cms-002","cms-003"],"description":"Journey of tests/e2e/site.spec.js, the test named \"the front page shows the featured essay and the earlier ones\". Hand-written test keeps: that the first of the earlier essays is \"The Second Hundred Hours\" (position among siblings); the full-page screenshot, which asserts nothing.","steps":[{"goto":{"screen":"screen-front-page"}},{"expectTitle":{"text":"Fieldnotes"}},{"expectRole":{"role":"heading","level":1,"name":"Fieldnotes"}},{"expectRole":{"role":"heading","level":2,"name":"The Jig Is the Work"}},{"expectCount":{"role":"article","within":{"role":"region","name":"Earlier essays"},"count":5}},{"expectNoText":{"text":"Notes Toward a Workbench"}},{"expectRole":{"role":"img","namePattern":"plywood fixture holding a chair leg"}},{"expectAttribute":{"attribute":"data-accent","value":"moss"}}]},
    {"id":"ui-first-paint-bootstrap","name":"The first paint comes from the server-rendered bootstrap","description":"Journey of tests/e2e/site.spec.js, the test named \"the first paint comes from the server-rendered bootstrap, without a request for the view\".","steps":[{"recordRequests":"views"},{"goto":{"screen":"screen-article","params":{"slug":"slow-software"}}},{"expectRole":{"role":"heading","level":1,"name":"Slow Software"}},{"expectNoRequest":{"log":"views","path":"/api/view"}}]},
    {"id":"ui-follow-link-no-reload","name":"Following a link opens the article without a page load","verifies":["cms-004"],"description":"Journey of tests/e2e/site.spec.js, the test named \"following a link opens the article without a page load and moves focus to it\".","steps":[{"goto":{"screen":"screen-front-page"}},{"mark":"loaded"},{"click":{"role":"link","name":"What the Kiln Decides"}},{"expectScreen":{"screen":"screen-article","params":{"slug":"what-the-kiln-decides"}}},{"expectRole":{"role":"heading","level":1,"name":"What the Kiln Decides"}},{"expectTitle":{"text":"What the Kiln Decides — Fieldnotes"}},{"expectRole":{"role":"main","name":"Content","state":"focused"}},{"expectRole":{"role":"link","name":"Mirela Ashby","within":{"role":"complementary","name":"About this essay"}}},{"expectText":{"text":"You do not finish a pot","within":{"role":"blockquote"}}},{"expectNoReload":"loaded"},{"back":{}},{"expectRole":{"role":"heading","level":2,"name":"The Jig Is the Work"}},{"expectNoReload":"loaded"}]},
    {"id":"ui-browse-and-search","name":"Topics, authors, about and search all work","verifies":["srh-150"],"description":"Journey of tests/e2e/site.spec.js, the test named \"topics, authors, about and search all work\".","steps":[{"goto":{"screen":"screen-topics"}},{"click":{"role":"link","name":"Design"}},{"expectRole":{"role":"heading","level":1,"name":"Design"}},{"expectCount":{"role":"article","count":2}},{"click":{"role":"link","name":"Authors","within":{"role":"navigation","name":"Sections"}}},{"click":{"role":"link","name":"Tomasz Wren"}},{"expectRole":{"role":"heading","level":1,"name":"Tomasz Wren"}},{"expectCount":{"role":"article","count":2}},{"click":{"role":"link","name":"About","within":{"role":"navigation","name":"Sections"}}},{"expectRole":{"role":"heading","level":1,"name":"About Fieldnotes"}},{"expectRole":{"role":"heading","name":"Colophon"}},{"fill":{"form":"form-search","field":"q","value":"kiln"}},{"press":"Enter"},{"expectScreen":{"screen":"screen-search","params":{"q":"kiln"}}},{"expectText":{"text":"1 essay mentions “kiln”."}},{"expectRole":{"role":"heading","name":"What the Kiln Decides","within":{"role":"article"}}},{"goto":{"screen":"screen-search","params":{"q":"zzzz"}}},{"expectText":{"text":"Nothing mentions “zzzz”."}}]},
    {"id":"ui-unknown-address","name":"An unknown address says so, with the right status","description":"Journey of tests/e2e/site.spec.js, the test named \"an unknown address says so, with the right status\".","steps":[{"gotoPath":{"path":"/posts/no-such-essay"}},{"expectStatus":200},{"expectRole":{"role":"heading","level":1,"name":"There is nothing at this address"}},{"gotoPath":{"path":"/no/such/route"}},{"expectStatus":404}]},
    {"id":"ui-requests-from-worker-to-bff","name":"Every application request comes from the worker and goes to the BFF only","verifies":["run-003"],"description":"Journey of tests/e2e/site.spec.js, the test named \"every application request comes from the worker and goes to the BFF only\". Hand-written test keeps: that exactly one worker exists (worker count); the check that the main thread itself calls fetch, WebSocket and XMLHttpRequest never, which the worker-origin assertions below cover for the application's own requests.","steps":[{"recordRequests":"app"},{"goto":{"screen":"screen-front-page"}},{"click":{"role":"link","name":"Drawing the Thing You Mean"}},{"expectRole":{"role":"heading","level":1,"name":"Drawing the Thing You Mean"}},{"click":{"role":"link","name":"Topics","within":{"role":"navigation","name":"Sections"}}},{"expectRole":{"role":"heading","level":1,"name":"Topics"}},{"expectAttribute":{"role":"status","name":"Live connection","attribute":"data-connection","value":"open"}},{"expectRequests":{"log":"app","to":"/api/view","atLeast":2,"fromWorker":true}},{"expectRequests":{"log":"app","to":"^ws://","atLeast":1,"fromWorker":true}},{"expectRequests":{"log":"app","to":"^(http|ws)://127\\.0\\.0\\.1:4200/","only":true}},{"apiCall":{"method":"POST","host":"127.0.0.1:4201","path":"/internal/view","anonymous":true,"body":{"path":"/"},"expectStatus":401}}]},
    {
      "id": "ui-sign-in-and-out",
      "name": "Signing in with a wrong password explains itself; signing in and out works",
      "verifies": [
        "uxa-202",
        "gwy-003",
        "idn-261",
        "idn-262"
      ],
      "description": "Journey of tests/e2e/site.spec.js, the test named \"signing in with a wrong password explains itself; signing in and out works\". Hand-written test keeps: that the Password field is focused and emptied after a refusal (a password input has no WAI-ARIA role to address it by); that document.cookie is empty (the cookie's httpOnly attribute is asserted instead).",
      "steps": [
        {
          "goto": {
            "screen": "screen-sign-in"
          }
        },
        {
          "fill": {
            "form": "form-sign-in",
            "field": "login",
            "value": "ines"
          }
        },
        {
          "fill": {
            "form": "form-sign-in",
            "field": "password",
            "value": "not-the-password"
          }
        },
        {
          "submit": {
            "form": "form-sign-in"
          }
        },
        {
          "expectText": {
            "text": "The name or password is not right.",
            "within": {
              "role": "alert"
            }
          }
        },
        {
          "fill": {
            "form": "form-sign-in",
            "field": "password",
            "value": "strata-dev-ines"
          }
        },
        {
          "press": "Enter"
        },
        {
          "expectRole": {
            "role": "heading",
            "level": 1,
            "name": "Writing desk"
          }
        },
        {
          "expectText": {
            "text": "Signed in as Inès Okafor.",
            "within": {
              "role": "region",
              "name": "Messages"
            }
          }
        },
        {
          "expectLog": {
            "service": "backend",
            "event": "session-started",
            "fields": {
              "tenant": "fieldnotes",
              "principal": "user:ines",
              "method": "password"
            }
          }
        },
        {
          "expectCookie": {
            "name": "__Host-strata_sid",
            "attributes": {
              "httpOnly": true,
              "secure": true,
              "sameSite": "Strict",
              "path": "/",
              "hostPrefix": true
            }
          }
        },
        {
          "expectText": {
            "text": "Draft",
            "within": {
              "role": "row",
              "namePattern": "Notes Toward a Workbench"
            }
          }
        },
        {
          "clickAction": {
            "action": "act-sign-out-desk"
          }
        },
        {
          "expectText": {
            "text": "Signed out.",
            "within": {
              "role": "region",
              "name": "Messages"
            }
          }
        },
        {
          "expectLog": {
            "service": "backend",
            "event": "session-ended",
            "fields": {
              "tenant": "fieldnotes"
            }
          }
        },
        {
          "expectRole": {
            "role": "link",
            "name": "Sign in",
            "within": {
              "role": "banner"
            }
          }
        },
        {
          "expectRole": {
            "role": "heading",
            "level": 2,
            "name": "The Jig Is the Work"
          }
        },
        {
          "expectCookie": {
            "name": "__Host-strata_sid",
            "absent": true
          }
        },
        {
          "goto": {
            "screen": "screen-desk"
          }
        },
        {
          "expectRole": {
            "role": "heading",
            "level": 1,
            "name": "Sign in to continue"
          }
        }
      ]
    },
    {"id":"ui-forged-requests-refused","name":"Requests that skip the page are refused","verifies":["gwy-002"],"browsers":["visitor"],"description":"Journey of tests/e2e/site.spec.js, the test named \"requests that skip the page are refused: no session, no CSRF token, foreign origin\".","steps":[{"apiCall":{"method":"POST","path":"/api/records","anonymous":true,"headers":{"origin":"http://127.0.0.1:4200"},"body":{"op":"create","object":"category","fields":{"name":"Forged","slug":"forged"}},"expectStatus":401}},{"goto":{"screen":"screen-sign-in"}},{"fill":{"form":"form-sign-in","field":"login","value":"ines"}},{"fill":{"form":"form-sign-in","field":"password","value":"strata-dev-ines"}},{"submit":{"form":"form-sign-in"}},{"expectRole":{"role":"heading","level":1,"name":"Writing desk"}},{"apiCall":{"method":"POST","path":"/api/records","headers":{"origin":"http://127.0.0.1:4200"},"body":{"op":"create","object":"category","fields":{"name":"Forged","slug":"forged"}},"expectStatus":403}},{"apiCall":{"method":"POST","path":"/api/records","headers":{"origin":"http://evil.example","x-csrf-token":"x"},"body":{"op":"create","object":"category","fields":{"name":"Forged","slug":"forged"}},"expectStatus":403}},{"goto":{"screen":"screen-topics"}},{"expectNoText":{"text":"Forged"}}]},
    {
      "id": "ui-author-writes-publishes-live",
      "name": "An author signs in, writes a draft, publishes it live to readers, unpublishes, deletes and signs out, and the backend logs each step",
      "verifies": [
        "cms-154",
        "cms-003",
        "cms-011",
        "uxa-201",
        "uxa-212",
        "run-001",
        "obs-001"
      ],
      "browsers": [
        "reader",
        "author",
        "visitor"
      ],
      "description": "Journey of tests/e2e/site.spec.js, the test named \"an author writes a draft, sees validation from the kernel, publishes, and readers see it live\", extended into the whole round trip with the backend's structured log lines after each step (WG-4897): sign-in, draft, publish, the reader refreshed live, unpublish, delete and sign-out, each line linked by its correlation to a request a browser sent, and no secret in any line. Hand-written test keeps: the screenshots, which assert nothing.",
      "steps": [
        {
          "goto": {
            "screen": "screen-front-page"
          }
        },
        {
          "mark": "loaded"
        },
        {
          "expectAttribute": {
            "role": "status",
            "name": "Live connection",
            "attribute": "data-connection",
            "value": "open"
          }
        },
        {
          "switchBrowser": "author"
        },
        {
          "goto": {
            "screen": "screen-sign-in"
          }
        },
        {
          "fill": {
            "form": "form-sign-in",
            "field": "login",
            "value": "tomasz"
          }
        },
        {
          "fill": {
            "form": "form-sign-in",
            "field": "password",
            "value": "strata-dev-tomasz"
          }
        },
        {
          "submit": {
            "form": "form-sign-in"
          }
        },
        {
          "expectRole": {
            "role": "heading",
            "level": 1,
            "name": "Writing desk"
          }
        },
        {
          "expectLog": {
            "service": "backend",
            "event": "session-started",
            "fields": {
              "tenant": "fieldnotes",
              "principal": "user:tomasz",
              "method": "password"
            }
          }
        },
        {
          "capture": {
            "name": "authorSession",
            "from": "cookie",
            "cookie": "__Host-strata_sid"
          }
        },
        {
          "apiCall": {
            "method": "GET",
            "path": "/api/session",
            "expectStatus": 200,
            "capture": {
              "authorCsrf": "session.csrf_token"
            }
          }
        },
        {
          "click": {
            "role": "link",
            "name": "Write a new article"
          }
        },
        {
          "expectRole": {
            "role": "heading",
            "level": 1,
            "name": "New article"
          }
        },
        {
          "fill": {
            "form": "form-new-article-save",
            "field": "title",
            "value": "On Sharpening"
          }
        },
        {
          "fill": {
            "form": "form-new-article-save",
            "field": "body",
            "value": "A first paragraph written by a test.\n\n## A heading\n\nAnd a second one."
          }
        },
        {
          "submit": {
            "form": "form-new-article-save"
          }
        },
        {
          "expectText": {
            "text": "Draft saved.",
            "within": {
              "role": "region",
              "name": "Messages"
            }
          }
        },
        {
          "expectLog": {
            "service": "backend",
            "event": "record-created",
            "fields": {
              "tenant": "fieldnotes",
              "object": "post"
            }
          }
        },
        {
          "expectRole": {
            "role": "heading",
            "level": 1,
            "name": "Edit article"
          }
        },
        {
          "expectScreen": {
            "screen": "screen-desk-edit",
            "params": {
              "slug": "on-sharpening"
            }
          }
        },
        {
          "expectAttribute": {
            "role": "textbox",
            "name": "Address",
            "attribute": "value",
            "value": "on-sharpening"
          }
        },
        {
          "switchBrowser": "reader"
        },
        {
          "expectNoText": {
            "text": "On Sharpening"
          }
        },
        {
          "switchBrowser": "visitor"
        },
        {
          "goto": {
            "screen": "screen-article",
            "params": {
              "slug": "on-sharpening"
            }
          }
        },
        {
          "expectRole": {
            "role": "heading",
            "level": 1,
            "name": "There is nothing at this address"
          }
        },
        {
          "switchBrowser": "author"
        },
        {
          "fill": {
            "form": "form-edit-article-save-draft",
            "field": "slug",
            "value": "Not A Slug"
          }
        },
        {
          "fill": {
            "form": "form-edit-article-save-draft",
            "field": "excerpt",
            "value": ""
          }
        },
        {
          "submit": {
            "form": "form-edit-article-save-draft"
          }
        },
        {
          "expectText": {
            "text": "2 fields need attention before this can be saved.",
            "within": {
              "role": "alert"
            }
          }
        },
        {
          "expectAttribute": {
            "role": "textbox",
            "name": "Address",
            "attribute": "aria-invalid",
            "value": "true"
          }
        },
        {
          "expectRole": {
            "role": "textbox",
            "name": "Address",
            "state": "focused"
          }
        },
        {
          "expectText": {
            "text": "A slug uses lower-case letters, digits and single hyphens, at most 80 characters."
          }
        },
        {
          "expectText": {
            "text": "An excerpt has at most 280 characters."
          }
        },
        {
          "fill": {
            "form": "form-edit-article-save-draft",
            "field": "slug",
            "value": "on-sharpening"
          }
        },
        {
          "fill": {
            "form": "form-edit-article-save-draft",
            "field": "excerpt",
            "value": "A dull edge is a decision somebody put off."
          }
        },
        {
          "click": {
            "role": "button",
            "name": "Preview"
          }
        },
        {
          "expectRole": {
            "role": "heading",
            "level": 2,
            "name": "A heading",
            "within": {
              "role": "region",
              "name": "Preview"
            }
          }
        },
        {
          "click": {
            "role": "button",
            "name": "Write"
          }
        },
        {
          "focus": {
            "role": "textbox",
            "name": "Text"
          }
        },
        {
          "press": "Control+End"
        },
        {
          "click": {
            "role": "button",
            "name": "Bold"
          }
        },
        {
          "expectAttribute": {
            "role": "textbox",
            "name": "Text",
            "attribute": "value",
            "pattern": "\\*\\*bold text\\*\\*$"
          }
        },
        {
          "submit": {
            "form": "form-edit-article-publish"
          }
        },
        {
          "expectText": {
            "text": "Published.",
            "within": {
              "role": "region",
              "name": "Messages"
            }
          }
        },
        {
          "expectText": {
            "text": "Published",
            "within": {
              "role": "group",
              "name": "Article state"
            }
          }
        },
        {
          "expectLog": {
            "service": "backend",
            "event": "record-updated",
            "fields": {
              "tenant": "fieldnotes",
              "object": "post",
              "transition": "publish"
            }
          }
        },
        {
          "switchBrowser": "reader"
        },
        {
          "waitFor": {
            "event": "ui-notice-received"
          }
        },
        {
          "expectRole": {
            "role": "heading",
            "name": "On Sharpening"
          }
        },
        {
          "expectText": {
            "text": "A dull edge is a decision somebody put off."
          }
        },
        {
          "expectNoReload": "loaded"
        },
        {
          "click": {
            "role": "link",
            "name": "On Sharpening"
          }
        },
        {
          "expectText": {
            "text": "bold text",
            "within": {
              "role": "strong"
            }
          }
        },
        {
          "switchBrowser": "author"
        },
        {
          "click": {
            "role": "link",
            "name": "Back to the desk"
          }
        },
        {
          "clickAction": {
            "action": "act-desk-unpublish",
            "item": {
              "title": "On Sharpening"
            }
          }
        },
        {
          "expectText": {
            "text": "Moved back to drafts.",
            "within": {
              "role": "region",
              "name": "Messages"
            }
          }
        },
        {
          "expectLog": {
            "service": "backend",
            "event": "record-updated",
            "fields": {
              "tenant": "fieldnotes",
              "object": "post",
              "transition": "unpublish"
            }
          }
        },
        {
          "switchBrowser": "reader"
        },
        {
          "waitFor": {
            "event": "ui-notice-received"
          }
        },
        {
          "expectRole": {
            "role": "heading",
            "level": 1,
            "name": "There is nothing at this address"
          }
        },
        {
          "expectNoReload": "loaded"
        },
        {
          "switchBrowser": "author"
        },
        {
          "clickAction": {
            "action": "act-desk-delete",
            "item": {
              "title": "On Sharpening"
            },
            "confirm": true
          }
        },
        {
          "expectText": {
            "text": "Deleted.",
            "within": {
              "role": "region",
              "name": "Messages"
            }
          }
        },
        {
          "expectLog": {
            "service": "backend",
            "event": "record-deleted",
            "fields": {
              "tenant": "fieldnotes",
              "object": "post"
            }
          }
        },
        {
          "expectCount": {
            "role": "row",
            "namePattern": "On Sharpening",
            "count": 0
          }
        },
        {
          "clickAction": {
            "action": "act-sign-out-desk"
          }
        },
        {
          "expectText": {
            "text": "Signed out.",
            "within": {
              "role": "region",
              "name": "Messages"
            }
          }
        },
        {
          "expectLog": {
            "service": "backend",
            "event": "session-ended",
            "fields": {
              "tenant": "fieldnotes"
            }
          }
        },
        {
          "expectCookie": {
            "name": "__Host-strata_sid",
            "absent": true
          }
        },
        {
          "logScan": {
            "forbid": [
              "${authorSession}",
              "${authorCsrf}",
              "strata-dev-"
            ]
          }
        }
      ]
    },
    {"id":"ui-author-cannot-edit-others","name":"An author cannot edit another author’s article; an editor can","verifies":["krn-003","krn-004"],"description":"Journey of tests/e2e/site.spec.js, the test named \"an author cannot edit another author’s article; an editor can\".","steps":[{"goto":{"screen":"screen-sign-in"}},{"fill":{"form":"form-sign-in","field":"login","value":"mirela"}},{"fill":{"form":"form-sign-in","field":"password","value":"strata-dev-mirela"}},{"submit":{"form":"form-sign-in"}},{"expectRole":{"role":"heading","level":1,"name":"Writing desk"}},{"expectCount":{"role":"row","namePattern":"The Jig Is the Work","count":0}},{"expectRole":{"role":"row","namePattern":"What the Kiln Decides"}},{"goto":{"screen":"screen-desk-edit","params":{"slug":"notes-toward-a-workbench"}}},{"expectRole":{"role":"heading","level":1,"name":"There is nothing at this address"}},{"apiCall":{"method":"GET","path":"/api/session","expectStatus":200,"capture":{"csrf":"session.csrf_token"}}},{"apiCall":{"method":"POST","path":"/api/records","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"${csrf}"},"body":{"op":"update","object":"post","id":15,"fields":{"title":"Taken over"}},"expectStatus":404,"expectJson":{"code":"not_found"}}},{"apiCall":{"method":"POST","path":"/api/records","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"${csrf}"},"body":{"op":"update","object":"post","id":9999,"fields":{"title":"Taken over"}},"expectStatus":404,"expectJson":{"code":"not_found"}}},{"apiCall":{"method":"POST","path":"/api/records","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"${csrf}"},"body":{"op":"update","object":"post","id":14,"fields":{"title":"Taken over"}},"expectStatus":403,"expectJson":{"failed.0.rule":"policy:authors_own_posts"}}}]},
    {"id":"ui-session-ends","name":"A session that ends is noticed at once and the page falls back to signed out","verifies":[],"description":"Journey of tests/e2e/site.spec.js, the test named \"a session that ends is noticed at once and the page falls back to signed out\".","steps":[{"goto":{"screen":"screen-sign-in"}},{"fill":{"form":"form-sign-in","field":"login","value":"admin"}},{"fill":{"form":"form-sign-in","field":"password","value":"strata-dev-admin"}},{"submit":{"form":"form-sign-in"}},{"expectRole":{"role":"heading","level":1,"name":"Writing desk"}},{"expectAttribute":{"role":"status","name":"Live connection","attribute":"data-connection","value":"open"}},{"mark":"loaded"},{"apiCall":{"method":"GET","path":"/api/session","expectStatus":200,"capture":{"csrf":"session.csrf_token"}}},{"apiCall":{"method":"POST","path":"/api/dev/expire-session","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"${csrf}"},"expectJson":{"expired":true}}},{"expectText":{"text":"Your session has expired. Sign in again to keep writing.","within":{"role":"region","name":"Messages"}}},{"expectRole":{"role":"heading","level":1,"name":"Sign in to continue"}},{"expectNoReload":"loaded"},{"apiCall":{"method":"POST","path":"/api/records","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"stale"},"body":{"op":"delete","object":"post","id":9},"expectStatus":401}}]},
    {"id":"ui-reconnect-catches-up","name":"After losing the connection the page reconnects and catches up on what it missed","verifies":["run-001"],"browsers":["reader","author"],"description":"Journey of tests/e2e/site.spec.js, the test named \"after losing the connection the page reconnects and catches up on what it missed\". Hand-written test keeps: the drop of the socket through the page's test hook (window.__strataDropSocket) and the check that the connection then reads \"waiting\"; offline alone does not close an open socket, so the scenario goes offline and publishes, then back online, and asserts only what the reader shows afterwards.","steps":[{"goto":{"screen":"screen-front-page"}},{"mark":"loaded"},{"expectAttribute":{"role":"status","name":"Live connection","attribute":"data-connection","value":"open"}},{"goOffline":{}},{"switchBrowser":"author"},{"goto":{"screen":"screen-sign-in"}},{"fill":{"form":"form-sign-in","field":"login","value":"mirela"}},{"fill":{"form":"form-sign-in","field":"password","value":"strata-dev-mirela"}},{"submit":{"form":"form-sign-in"}},{"expectRole":{"role":"heading","level":1,"name":"Writing desk"}},{"click":{"role":"link","name":"Write a new article"}},{"expectRole":{"role":"heading","level":1,"name":"New article"}},{"fill":{"form":"form-new-article-save","field":"title","value":"While You Were Away"}},{"fill":{"form":"form-new-article-save","field":"body","value":"A first paragraph written by a test.\n\n## A heading\n\nAnd a second one."}},{"submit":{"form":"form-new-article-save"}},{"expectText":{"text":"Draft saved.","within":{"role":"region","name":"Messages"}}},{"expectRole":{"role":"heading","level":1,"name":"Edit article"}},{"submit":{"form":"form-edit-article-publish"}},{"expectText":{"text":"Published.","within":{"role":"region","name":"Messages"}}},{"switchBrowser":"reader"},{"expectNoText":{"text":"While You Were Away"}},{"goOnline":{}},{"expectAttribute":{"role":"status","name":"Live connection","attribute":"data-connection","value":"open","timeoutMs":20000}},{"expectRole":{"role":"heading","name":"While You Were Away"}},{"expectNoReload":"loaded"},{"switchBrowser":"author"},{"submit":{"form":"form-edit-article-unpublish"}},{"switchBrowser":"reader"},{"expectCount":{"role":"heading","name":"While You Were Away","count":0}}]},
    {"id":"ui-settings-restyle-live","name":"Tenant settings are data: changing the accent restyles every open page live","verifies":["cms-005"],"browsers":["reader","editor"],"description":"Journey of tests/e2e/site.spec.js, the test named \"tenant settings are data: changing the accent restyles every open page live\". Hand-written test keeps: the computed value of the --accent custom property (#4f6140 for moss, #6b3f5b for plum), which is computed CSS; the data-accent attribute is asserted instead; the screenshot.","steps":[{"goto":{"screen":"screen-about"}},{"mark":"loaded"},{"switchBrowser":"editor"},{"goto":{"screen":"screen-sign-in"}},{"fill":{"form":"form-sign-in","field":"login","value":"ines"}},{"fill":{"form":"form-sign-in","field":"password","value":"strata-dev-ines"}},{"submit":{"form":"form-sign-in"}},{"expectRole":{"role":"heading","level":1,"name":"Writing desk"}},{"click":{"role":"link","name":"Publication settings"}},{"click":{"role":"radio","name":"Plum"}},{"fill":{"form":"form-settings","field":"tagline","value":"Essays on making things, and what they teach."}},{"submit":{"form":"form-settings"}},{"expectText":{"text":"Settings saved.","within":{"role":"region","name":"Messages"}}},{"switchBrowser":"reader"},{"expectAttribute":{"attribute":"data-accent","value":"plum"}},{"expectText":{"text":"Essays on making things, and what they teach.","within":{"role":"contentinfo"}}},{"expectNoReload":"loaded"},{"switchBrowser":"editor"},{"apiCall":{"method":"GET","path":"/api/session","expectStatus":200,"capture":{"csrf":"session.csrf_token"}}},{"apiCall":{"method":"POST","path":"/api/records","headers":{"origin":"http://127.0.0.1:4200","x-csrf-token":"${csrf}"},"body":{"op":"update","object":"publication","id":1,"fields":{"accent":"red;background:url(//evil)"}},"expectStatus":422,"expectJson":{"failed.0.rule":"constraint:publication.accent_token"}}},{"click":{"role":"radio","name":"Moss"}},{"fill":{"form":"form-settings","field":"tagline","value":"Essays on