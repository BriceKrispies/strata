      "initial": "td-live-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "database",
          "type": "boolean",
          "initial": true,
          "repr": "bool"
        },
        {
          "name": "files",
          "type": "boolean",
          "initial": true,
          "repr": "bool"
        },
        {
          "name": "key",
          "type": "boolean",
          "initial": true,
          "repr": "bool"
        },
        {
          "name": "deleted",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        }
      ],
      "states": [
        {
          "id": "td-live-i",
          "name": "Live",
          "ignores": [
            "td-database-removed",
            "td-files-removed",
            "td-key-destroyed",
            "td-step-failed"
          ]
        },
        {
          "id": "td-removing-database-i",
          "name": "Removing the database",
          "ignores": [
            "td-delete-requested",
            "td-files-removed",
            "td-key-destroyed"
          ]
        },
        {
          "id": "td-removing-files-i",
