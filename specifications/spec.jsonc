    {
      "id": "scope-record",
      "description": "The record a scope of a rule reads in rules.rs authorize: record is the old record, or the new one when there is none; old and new are themselves.",
      "params": [
        {
          "name": "subject",
          "type": "subject"
        },
        {
          "name": "s",
          "type": "scope"
        }
      ],
      "returns": "option<record>",
      "body": "match s { record => if subject.old == null then subject.new else subject.old, old => subject.old, new => subject.new }",
      "examples": [
        {
          "args": {
            "subject": {
              "new": {
                "id": 7,
                "object": "post",
                "version": 1,
                "created-by": "user:ann",
                "created-at": 1800000000000,
                "updated-at": 1800000000000,
                "fields": {
                  "author": {
                    "ref": 2
                  },
                  "title": {
                    "str": "Hello"
                  }
                }
              }
            },
            "s": "record"
          },
          "result": {
            "id": 7,
            "object": "post",
            "version": 1,
            "created-by": "user:ann",
            "created-at": 1800000000000,
            "updated-at": 1800000000000,
            "fields": {
              "author": {
                "ref": 2
              },
              "title": {
                "str": "Hello"
              }
            }
          }
        },
        {
          "args": {
            "subject": {
              "new": {
                "id": 7,
                "object": "post",
                "version": 1,
                "created-by": "user:ann",
                "created-at": 1800000000000,
                "updated-at": 1800000000000,
                "fields": {
                  "author": {
                    "ref": 2
                  },
                  "title": {
                    "str": "Hello"
                  }
                }
              }
            },
            "s": "old"
          },
          "result": null
        },
        {
          "args": {
            "subject": {
              "old": {
                "id": 7,
                "object": "post",
                "version": 1,
                "created-by": "user:ann",
                "created-at": 1800000000000,
                "updated-at": 1800000000000,
                "fields": {
                  "title": {
                    "str": "Hello"
                  }
                }
              },
              "new": {
                "id": 7,
                "object": "post",
                "version": 1,
                "created-by": "user:ann",
                "created-at": 1800000000000,
                "updated-at": 1800000000000,
