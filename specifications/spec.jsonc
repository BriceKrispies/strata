        {
          "name": "permanent-refusal",
          "condition": "The provider refused for a permanent reason; the message is recorded as failed with the reason (EML-008).",
          "kind": "invalid"
        },
        {
          "name": "suppressed",
          "condition": "The address is on the suppression list of the tenant; the message is recorded as suppressed and left unsent (EML-018).",
          "kind": "forbidden"
        }
      ],
      "exposure": "local"
    },
