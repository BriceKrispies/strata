    {
      "id": "field-shape",
      "description": "expr.rs shape_of_type: the shape check gives a field of a type.",
      "params": [
        {
          "name": "ty",
          "type": "field-type"
        }
      ],
      "returns": "string",
      "body": "match ty { str => 'str', int => 'int', bool => 'bool', time => 'time', ref => 'ref', list(_) => 'list' }",
      "examples": [
        {
          "args": {
            "ty": "time"
          },
          "result": "time"
        },
        {
          "args": {
            "ty": {
              "list": "int"
            }
          },
          "result": "list"
        },
        {
          "args": {
            "ty": "bool"
          },
          "result": "bool"
        }
      ]
    },
    {
      "id": "field-shapes",
      "description": "The fields of a check environment: the shape of each field of an object type.",
      "params": [
        {
          "name": "fields",
          "type": "map<field-id, field-def>"
        }
      ],
      "returns": "map<string, string>",
      "body": "fold(f in values(fields), m = {}, insert(m, f.id, call field-shape(f.ty)))",
      "examples": [
        {
          "args": {
            "fields": {
              "name": {
                "id": "name",
                "label": "name",
                "ty": "str",
                "required": true,
                "unique": false
              }
            }
          },
          "result": {
            "name": "str"
          }
        },
        {
          "args": {
            "fields": {}
          },
          "result": {}
        }
      ]
    },
    {
      "id": "shape-debug",
      "description": "The Rust Debug name of an expr.rs Shape ({shape:?}).",
      "params": [
        {
          "name": "shape",
          "type": "string"
        }
      ],
      "returns": "string",
      "body": "if shape == 'bool' then 'Bool' else if shape == 'int' then 'Int' else if shape == 'str' then 'Str' else if shape == 'time' then 'Time' else if shape == 'ref' then 'Ref' else if shape == 'list' then 'List' else 'Any'",
      "examples": [
        {
          "args": {
            "shape": "int"
          },
          "result": "Int"
        },
        {
          "args": {
            "shape": "any"
          },
          "result": "Any"
        },
        {
          "args": {
            "shape": "bool"
          },
          "result": "Bool"
        },
        {
          "args": {
            "shape": "str"
          },
          "result": "Str"
        },
        {
          "args": {
            "shape": "time"
          },
          "result": "Time"
        },
        {
          "args": {
            "shape": "ref"
          },
          "result": "Ref"
        },
        {
          "args": {
            "shape": "list"
          },
          "result": "List"
        }
      ]
    },
    {
      "id": "action-debug",
      "description": "The Rust Debug name of an Action ({action:?}).",
      "params": [
        {
          "name": "a",
          "type": "action"
        }
      ],
      "returns": "string",
      "body": "match a { read => 'Read', create => 'Create', update => 'Update', delete => 'Delete', manage => 'Manage' }",
      "examples": [
        {
          "args": {
            "a": "manage"
          },
          "result": "Manage"
        },
        {
          "args": {
            "a": "read"
          },
          "result": "Read"
        }
      ]
    },
    {
      "id": "text-starts-with",
      "description": "Rust str::starts_with, read through the rule language's starts_with primitive (the body language has no string operations).",
      "params": [
        {
          "name": "text",
          "type": "string"
        },
        {
          "name": "prefix",
          "type": "string"
        }
      ],
      "returns": "bool",
      "body": "match eval(tenant-rule-language, expr.starts-with{text: expr.lit(value.str(text)), prefix: expr.lit(value.str(prefix))}, expr-env{record: null, old: null, new: null, param: {}, now: value.int(0), principal: value.int(0), has_role: []}) { Ok(r) => match r { bool(b) => b, _ => false }, Err(e) => false }",
      "examples": [
        {
          "args": {
            "text": "/posts/:slug",
            "prefix": "/"
          },
          "result": true
        },
        {
          "args": {
            "text": "posts",
            "prefix": "/"
          },
          "result": false
        },
        {
          "args": {
            "text": "@ines",
            "prefix": "@"
          },
          "result": true
        },
        {
          "args": {
            "text": "",
            "prefix": "@"
          },
          "result": false
        }
      ]
    },
    {
      "id": "object-problems",
      "description": "schema.rs TenantSchema::problems, the loop over object types: per field (in id order) an unknown reference target, a list of lists, a unique list, a default that does not check without fields; then per constraint (in id order) a check error or a shape other than Bool or Any.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "roles",
          "type": "list<role-id>"
        },
        {
          "name": "object",
          "type": "object-type-def"
        }
      ],
      "returns": "list<string>",
      "let": [
        {
          "name": "env",
          "expr": "expr-check-env{fields: call field-shapes(object.fields), params: [], roles}"
        },
        {
          "name": "bare",
          "expr": "expr-check-env{fields: {}, params: [], roles}"
        },
        {
          "name": "field-problems",
          "expr": "fold(f in values(object.fields), ps = [], let at = format('{}.{}', object.id, f.id) in concat(concat(concat(ps, match call ref-target(f.ty) { Some(t) => if get(schema.objects, t) == null then [format('{}: refers to unknown object type {}', at, t)] else [], None => [] }), match f.ty { list(inner) => concat(match inner { list(_) => [format('{}: nested lists are not supported', at)], _ => [] }, if f.unique then [format('{}: a list field cannot be unique', at)] else []), _ => [] }), match f.default { Some(d) => match check(tenant-rule-language, d, bare) { Ok(_) => [], Err(e) => [format('{}: default: {}', at, e)] }, None => [] }))"
        }
      ],
      "body": "fold(c in values(object.constraints), ps = field-problems, concat(ps, match check(tenant-rule-language, c.expr, env) { Ok(s) => if s == 'bool' || s == 'any' then [] else [format('{}.{}: constraint is {}, not a truth value', object.id, c.id, call shape-debug(s))], Err(e) => [format('{}.{}: {}', object.id, c.id, e)] }))",
      "examples": [
        {
          "args": {
            "schema": {
              "version": 2,
              "objects": {
                "note": {
                  "id": "note",
                  "label": "Note",
                  "fields": {
                    "author": {
                      "id": "author",
                      "label": "Author",
                      "ty": {
                        "ref": {
                          "target": "person",
                          "on-delete": "set-null"
                        }
                      },
                      "required": false,
                      "unique": false
                    },
                    "body": {
                      "id": "body",
                      "label": "body",
                      "ty": "str",
                      "required": false,
                      "unique": false
                    },
                    "published_at": {
                      "id": "published_at",
                      "label": "published_at",
                      "ty": "time",
                      "required": false,
                      "unique": false
                    },
                    "rank": {
                      "id": "rank",
                      "label": "rank",
                      "ty": "int",
                      "required": false,
                      "unique": false
                    },
                    "slug": {
                      "id": "slug",
                      "label": "slug",
                      "ty": "str",
                      "required": true,
                      "unique": true
                    },
                    "status": {
                      "id": "status",
                      "label": "status",
                      "ty": "str",
                      "required": true,
                      "unique": false,
                      "default": {
                        "lit": {
                          "str": "draft"
                        }
                      }
                    },
                    "title": {
