    {
      "id": "role-permissions-with",
      "description": "TenantSchemaExt::set_role_permissions: the table of permissions with those of one role replaced; none removes the role's entry, and a table left empty is none, as the genesis schema holds it.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "role",
          "type": "role-id"
        },
        {
          "name": "permissions",
          "type": "list<permission>"
        }
      ],
      "returns": "option<map<role-id, list<permission>>>",
      "let": [
        {
          "name": "table",
          "expr": "match schema.role-permissions { Some(t) => t, None => {} }"
        },
        {
          "name": "next",
          "expr": "if permissions == [] then remove(table, role) else insert(table, role, permissions)"
        }
      ],
      "body": "if keys(next) == [] then null else next",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-8"
            },
            "role": "editor",
            "permissions": [
              {
                "object": {
                  "object": "note",
                  "actions": [
                    "read",
                    "update"
                  ]
                }
              },
              {
                "capability": "content-write"
              }
            ]
          },
          "result": {
            "editor": [
              {
                "object": {
                  "object": "note",
                  "actions": [
                    "read",
                    "update"
                  ]
                }
              },
              {
                "capability": "content-write"
              }
            ]
          }
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-20"
            },
            "role": "writer",
            "permissions": []
          },
          "result": {
            "editor": [
              {
                "object": {
                  "object": "note",
                  "actions": [
                    "read",
                    "update"
                  ]
                }
              },
              {
                "capability": "content-write"
              }
            ]
          }
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-8",
              "with": {
                "role-permissions": {
                  "writer": [
                    {
                      "object": {
                        "object": "note",
