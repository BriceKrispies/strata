          },
          "source": {
            "type": "string",
            "label": "Source",
            "doc": "File and line in the repository where this was imported from."
          }
        }
      },
      "goal": {
        "label": "Goal",
        "section": "goals",
        "shape": "diamond",
        "color": "green",
        "doc": "A goal of the white paper (G-n): one observable outcome with the release stage that first requires it.",
