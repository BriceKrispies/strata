                              "field": "$created_by"
                            }
                          },
                          "right": "principal"
                        }
                      },
                      "set": {
                        "published_at": "now"
                      }
                    },
                    {
                      "name": "unpublish",
                      "from": "published",
                      "to": "draft",
                      "set": {
                        "published_at": {
                          "lit": "null"
                        }
                      }
                    }
                  ]
