// The Strata specification. One file, the authority for what the platform is to do.
// Exegra validates it, evaluates the m-... claims and runs the behaviour models.
// Concordance renders the documents below, lints the requirements and reconciles them with
// the code and with recorded test results. See specifications/README.md.
{
  "exegra": "0.1",

  "system": {"id":"strata","name":"Strata","version":"0.2-draft","description":"Strata is a multi-tenant automation and content platform in which every tenant has a database of its own. Tenant structure is versioned data interpreted by one pure kernel. The platform is built so that agents can observe, explain and change it through the same typed, authorised operations people use, with every change simulated before it is applied and recorded after."},

  "vocabulary": {
    "entityKinds": {
      "document": {
        "label": "Document",
        "section": "documents",
        "shape": "box",
        "color": "slate",
        "doc": "One Markdown file of the specification.",
        "properties": {
          "path": {
            "type": "string",
            "required": true,
            "label": "Path",
            "doc": "Relative to the repository root."
          },
          "title": {
            "type": "string",
            "label": "Title",
            "doc": "The first heading of the file."
          },
          "role": {
            "type": "enum",
            "values": [
              "whitepaper",
              "roadmap",
              "requirements",
              "cases",
              "glossary",
              "index"
            ],
            "required": true,
            "label": "Role"
          },
          "source": {
            "type": "string",
            "label": "Source",
            "doc": "File and line in the repository where this was imported from."
          }
        }
      },
      "section": {
        "label": "Section",
        "section": "sections",
        "shape": "chamfer",
        "color": "neutral",
        "doc": "One heading of a document and the Markdown under it, up to the next heading. Level 0 is the text before the first heading of a file.",
