      },
      "variables": [
        {
          "name": "recordsUsed",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "filesUsed",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "refusedFor",
          "type": "string",
          "initial": "",
          "repr": "string"
