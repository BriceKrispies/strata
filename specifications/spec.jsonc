          "description": "Whether list-my-segments shows the segment to its members (SEG-1540)."
        },
        {
          "name": "indexable",
          "type": "bool",
          "description": "Whether the time-dependent predicate is refreshed through wake records (SEG-1545)."
        },
        {
          "name": "member-count",
