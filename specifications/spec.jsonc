      },
      {
        "entity": "claim",
        "name": "ref",
        "type": "string",
        "label": "Specification id",
        "doc": "The identifier as written in the the project specification."
      },
      {
        "entity": "claim",
        "name": "source",
        "type": "string",
        "label": "Source",
        "doc": "File and line in the repository where this was imported from."
      },
      {
        "entity": "claim",
        "name": "inSection",
        "type": "ref",
        "ref": [
          "section"
        ],
        "label": "In section",
        "doc": "The section whose body holds the marker of this requirement."
      },
      {
        "entity": "claim",
        "name": "area",
        "type": "string",
        "label": "Specification area",
        "doc": "The numbered specification directory the requirement is written in."
      },
      {
        "entity": "claim",
        "name": "section",
        "type": "string",
        "label": "Section",
        "doc": "The nearest heading above the requirement."
      },
      {
        "entity": "claim",
        "name": "lifecycle",
        "type": "enum",
        "values": [
          "active",
          "retired"
        ],
        "label": "Lifecycle",
        "doc": "retired when the requirement carries \"Status: retired\"."
      },
      {
        "entity": "claim",
        "name": "boundary",
        "type": "ref",
        "ref": [
          "boundary"
        ],
        "label": "Boundary"
      },
      {
        "entity": "claim",
        "name": "boundaryDetail",
        "type": "text",
        "label": "Boundary detail",
