    {
      "id": "event-numbering",
      "name": "Event numbering",
      "kind": "struct",
      "description": "transition.rs Draft::finish: the events numbered so far and the next sequence number.",
      "fields": [
        {
          "name": "events",
          "type": "list<domain-event>"
        },
        {
          "name": "next",
