    {
      "id": "require-definition-authority",
      "description": "transition.rs require_definition_authority: beyond Manage on Schema, a change of a trigger or an automation needs the capability automations-define (WFL-1520), checked once and first; then, in the order of the changes, every run-as role of a defined automation is one the principal may confer (require-conferrable, ADM-152, WFL-1528) and the definer of a tenant operation holds every power its steps use (require-operation-powers). A change of a setting definition needs the capability setting-define, checked after the capability of automations (settings.rs SETTING_DEFINE). A change of the ledger declarations needs the capability ledger-configure, checked after setting-define (ledger.rs LEDGER_CONFIGURE).",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "changes",
          "type": "list<schema-change>"
        }
      ],
      "returns": "draft",
      "errors": "rejection",
      "let": [
        {
          "name": "automation",
          "expr": "any(c in changes, match c { define-trigger => true, remove-trigger => true, define-automation => true, remove-automation => true, _ => false })"
        },
        {
          "name": "d1",
          "expr": "if automation then try call require-capability(d, 'automations-define') else d"
        },
        {
          "name": "setting",
          "expr": "any(c in changes, match c { define-setting => true, remove-setting => true, _ => false })"
        },
        {
          "name": "d1b",
          "expr": "if setting then try call require-capability(d1, 'setting-define') else d1"
        },
        {
          "name": "ledger",
          "expr": "any(c in changes, match c { declare-ledger-unit => true, declare-ledger-pool => true, set-ledger-limit => true, remove-ledger-definition => true, _ => false })"
        },
        {
          "name": "d1c",
          "expr": "if ledger then try call require-capability(d1b, 'ledger-configure') else d1b"
        }
      ],
      "body": "fold(c in changes, acc = d1c, match c { define-automation(a) => try call require-conferrable(acc, map(r in a.run-as.roles, r)), define-operation(op) => try call require-operation-powers(acc, op), _ => acc })",
      "examples": [
