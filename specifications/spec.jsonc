    {
      "id": "decide-trigger",
      "description": "triggers.rs decide: one trigger whose event matches an event, in the state after the transition: the effect it appends, or none (D-7200). In order: a paused trigger appends nothing; a missing automation declines with automation-removed and a suspended one with run-as-suspended, whatever the condition; an event about a record the automation principal may not read appends nothing (trigger-scopes-of); then decide-run.",
      "params": [
        {
          "name": "after",
          "type": "tenant-state"
        },
        {
          "name": "ctx",
          "type": "context"
        },
        {
          "name": "hop",
          "type": "u32"
        },
        {
          "name": "event",
          "type": "domain-event"
        },
        {
          "name": "trigger",
          "type": "trigger-def"
        }
      ],
      "returns": "option<effect>",
      "body": "if (match trigger.paused { Some(p) => p, None => false }) then null else match get(call automations-of(after.schema), trigger.automation) { None => call trigger-decline(trigger, event, hop, automation-exception-reason.automation-removed, format('automation {} does not exist', trigger.automation)), Some(a) => match a.suspended-for { Some(role) => call trigger-decline(trigger, event, hop, automation-exception-reason.run-as-suspended, format('automation {} is suspended: its definer may not confer role {}', a.id, role)), None => match call trigger-scopes-of(after, principal.user(format('automation:{}', a.id)), ctx.now, event.body) { None => null, Some(s) => call decide-run(after, ctx, hop, event, trigger, a, s) } } }",
      "examples": [
        {
          "description": "An automation that holds editor reads the record: the run starts.",
          "args": {
