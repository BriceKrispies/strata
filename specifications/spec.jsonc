    {"id":"mail-first-acknowledgement-lost","name":"A message whose first acknowledgement is lost","description":"The message is submitted at tick 0; its first acknowledgement is lost; the dispatcher times out at tick 3 and submits it again.","behaviors":["mail-dispatch-flow","mail-adapter-flow"],"faults":["first-acknowledgement-lost"],"steps":[
        {
          "at": 0,
          "event": "em-due",
          "payload": {
            "key": "k1",
            "message-id": "00000000-0000-4000-8000-000000000007"
          }
        },
        {
          "at": 3,
          "event": "em-timeout",
          "payload": {
            "message-id": "00000000-0000-4000-8000-000000000007"
          }
        }
      ]},
    {
      "id": "mail-first-acknowledgement-lost-impl",
      "name": "A message whose first acknowledgement arrives after the timeout (implementation)",
      "description": "The message is submitted at 0; its first acknowledgement is retried for 63 seconds, since an at-least-once message is never lost; the dispatcher times out after 30 seconds and submits it again before the acknowledgement arrives. Times are in milliseconds.",
      "behaviors": [
        "mail-dispatch-flow-impl",
        "mail-adapter-flow"
      ],
      "faults": [
        "first-acknowledgement-retried-impl"
      ],
      "steps": [
        {
          "at": 0,
          "event": "em-due",
          "payload": {
            "key": "k1",
            "message-id": "00000000-0000-4000-8000-000000000008"
          }
        }
      ],
      "routes": [
        {
          "event": "em-due",
          "behavior": "mail-dispatch-flow-impl",
          "by": "key",
          "field": "message-id"
        }
      ],
