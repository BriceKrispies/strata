    },
    {
      "id": "first-acknowledgement-retried-impl",
      "name": "The first acknowledgement is retried for a minute",
      "kind": "retry-event",
      "event": "em-ack",
      "attempts": 6,
      "occurrence": 1,
      "description": "The first acknowledgement of the mail adapter fails six dispatches and arrives 63 seconds late (the runtime's backoff of 1 to 32 seconds): an at-least-once message is never lost, so the implementation twin of a lost acknowledgement is one that arrives after the dispatcher has given up waiting."
    },
    {
      "id": "first-submission-retried-impl",
      "name": "The first submission is retried through an outage",
      "kind": "retry-event",
      "event": "em-submit",
      "attempts": 6,
      "occurrence": 1,
      "realises": "fm-mail-outage",
      "description": "The mail provider does not take the first submission for a minute: its dispatch fails six times and it reaches the provider 63 seconds late (the runtime's backoff of 1 to 32 seconds)."
    },
    {
      "id": "commit-confirmation-retried-impl",
      "name": "The commit confirmation is retried once",
      "kind": "retry-event",
      "event": "rt-committed",
      "attempts": 1,
      "description": "The first dispatch of the commit confirmation fails and it arrives after the runtime's first backoff of 1 second; publication must still wait for it."
    },
    {
      "id": "first-delivery-retried-impl",
      "name": "The first delivery of a notice is retried twice",
      "kind": "retry-event",
      "event": "arc-ob-delivered",
      "attempts": 2,
      "occurrence": 1,
      "description": "The first dispatch of the notice fails twice and it arrives 3 seconds late (the runtime's backoff of 1 and 2 seconds); the redelivery arrives first."
    }
  ],
  "scenarios": [
    {"id":"link-used-twice","name":"A link is used, then presented again","description":"The second presentation is refused.","behaviors":["emailed-link-flow"],"steps":[{"at":0,"event":"ml-requested"},{"at":2,"event":"ml-presented","payload":{"token":"good","browser":"requester"},"note":"The person follows the link."},{"at":4,"event":"ml-presented","payload":{"token":"good","browser":"requester"},"note":"The same link again."}]},
    {"id":"link-used-twice-impl","name":"A link is used, then presented again (implementation)","description":"The link is followed 2 minutes after it was requested and presented again 2 minutes later; the second presentation is refused. Times are in milliseconds. The same scenario run on the implementation machines.","behaviors":["emailed-link-flow-impl"],"steps":[{"at":0,"event":"ml-requested"},{"at":120000,"event":"ml-presented","payload":{"token":"good","browser":"requester"},"note":"The person follows the link."},{"at":240000,"event":"ml-presented","payload":{"token":"good","browser":"requester"},"note":"The same link again."}],"timeUnit":"ms"},
    {"id":"link-presented-late","name":"A link is presented after its lifetime","description":"The lifetime is 15 ticks.","behaviors":["emailed-link-flow"],"steps":[{"at":0,"event":"ml-requested"},{"at":30,"event":"ml-presented","payload":{"token":"good","browser":"requester"}}]},
    {"id":"link-presented-late-impl","name":"A link is presented after its lifetime (implementation)","description":"The lifetime is 15 minutes; the link is presented 30 minutes after it was requested. Times are in milliseconds. The same scenario run on the implementation machines.","behaviors":["emailed-link-flow-impl"],"steps":[{"at":0,"event":"ml-requested"},{"at":1800000,"event":"ml-presented","payload":{"token":"good","browser":"requester"}}],"timeUnit":"ms"},
    {"id":"link-presented-elsewhere","name":"A link is presented in another browser","description":"The link reached someone who did not ask for it.","behaviors":["emailed-link-flow"],"steps":[{"at":0,"event":"ml-requested"},{"at":2,"event":"ml-presented","payload":{"token":"good","browser":"other"}}]},
    {"id":"link-presented-elsewhere-impl","name":"A link is presented in another browser (implementation)","description":"The link reached someone who did not ask for it, who presents it 2 minutes after the request. Times are in milliseconds. The same scenario run on the implementation machines.","behaviors":["emailed-link-flow-impl"],"steps":[{"at":0,"event":"ml-requested"},{"at":120000,"event":"ml-presented","payload":{"token":"good","browser":"other"}}],"timeUnit":"ms"},
    {"id":"oidc-sign-in","name":"Sign-in through a provider","description":"The callback carries the pending state.","behaviors":["oidc-callback-flow"],"steps":[{"at":0,"event":"oidc-started"},{"at":3,"event":"oidc-callback","payload":{"state":"s1"}}]},
    {"id":"oidc-sign-in-impl","name":"Sign-in through a provider (implementation)","description":"The callback carries the pending state. The same scenario run on the implementation machines.","behaviors":["oidc-callback-flow-impl"],"steps":[{"at":0,"event":"oidc-started"},{"at":3,"event":"oidc-callback","payload":{"state":"s1"}}]},
    {"id":"oidc-forged-callback","name":"A forged callback","description":"The callback carries a state that matches no pending request.","behaviors":["oidc-callback-flow"],"steps":[{"at":0,"event":"oidc-started"},{"at":3,"event":"oidc-callback","payload":{"state":"forged"}}]},
    {"id":"oidc-forged-callback-impl","name":"A forged callback (implementation)","description":"The callback carries a state that matches no pending request. The same scenario run on the implementation machines.","behaviors":["oidc-callback-flow-impl"],"steps":[{"at":0,"event":"oidc-started"},{"at":3,"event":"oidc-callback","payload":{"state":"forged"}}]},
    {"id":"revocation-heard","name":"A revocation reaches the gateway","description":"The next request is refused.","behaviors":["session-authority-flow","gateway-session-flow"],"steps":[
        {
          "at": 0,
          "event": "sr-request",
          "payload": {
            "session-id": "s_1"
          }
        },
        {
          "at": 1,
          "event": "sr-revoked"
        },
        {
          "at": 2,
          "event": "sr-request",
          "payload": {
            "session-id": "s_1"
          }
        }
      ]},
    {"id":"revocation-heard-impl","name":"A revocation reaches the gateway (implementation)","description":"A request is accepted, the session is revoked 2 seconds later and the gateway hears of it; the next request, a second after that, is refused. Times are in milliseconds. The same scenario run on the implementation machines.","behaviors":["session-authority-flow-impl","gateway-session-flow-impl"],"steps":[
        {
          "at": 0,
          "event": "sr-request",
          "payload": {
            "session-id": "s_1"
          }
        },
        {
          "at": 2000,
          "event": "sr-revoked"
        },
        {
          "at": 3000,
          "event": "sr-request",
          "payload": {
            "session-id": "s_1"
          }
        }
      ],"timeUnit":"ms"},
    {"id":"revocation-notice-lost","name":"The revocation notice is lost","description":"A request inside the bound is still accepted. A request after it makes the gateway ask again, and is refused.","behaviors":["session-authority-flow","gateway-session-flow"],"faults":["revocation-notice-dropped"],"steps":[
        {
          "at": 0,
          "event": "sr-request",
          "payload": {
            "session-id": "s_1"
          }
        },
        {
          "at": 1,
          "event": "sr-revoked"
        },
        {
          "at": 3,
          "event": "sr-request",
          "note": "Within the bound of 5 ticks.",
          "payload": {
            "session-id": "s_1"
          }
        },
        {
          "at": 10,
          "event": "sr-request",
          "note": "After the bound.",
          "payload": {
            "session-id": "s_1"
          }
        }
      ]},
    {"id":"revocation-notice-lost-impl","name":"The revocation notice is lost (implementation)","description":"The session is revoked 1 second after a request and the notice is lost. A request 2 seconds after the revocation, inside the bound of 5 seconds, is still accepted from the copy. A request at 10 seconds makes the gateway ask again, and is refused. Times are in milliseconds. The same scenario run on the implementation machines.","behaviors":["session-authority-flow-impl","gateway-session-flow-impl"],"faults":["revocation-notice-dropped"],"steps":[
        {
          "at": 0,
          "event": "sr-request",
          "payload": {
            "session-id": "s_1"
          }
        },
        {
          "at": 1000,
          "event": "sr-revoked"
        },
        {
          "at": 3000,
          "event": "sr-request",
          "note": "Within the bound of 5 seconds.",
          "payload": {
            "session-id": "s_1"
          }
        },
        {
          "at": 10000,
          "event": "sr-request",
          "note": "After the bound.",
          "payload": {
            "session-id": "s_1"
          }
        }
      ],"timeUnit":"ms"},
    {"id":"lease-takeover","name":"A stalled worker is replaced","description":"The first worker stalls, the lease expires, a second worker gets the job, and then both report.","behaviors":["job-lease-flow"],"steps":[{"at":0,"event":"job-due"},{"at":5,"event":"lease-expired"},{"at":6,"event":"work-reported","payload":{"token":1},"note":"The stalled worker wakes up."},{"at":7,"event":"work-reported","payload":{"token":2},"note":"The replacement finishes."}]},
    {"id":"lease-takeover-impl","name":"A stalled worker is replaced (implementation)","description":"The first worker stalls, the lease of 60 seconds expires by its timer, a second worker gets the job, and then both report. Times are in milliseconds. The same scenario run on the implementation machines.","behaviors":["job-lease-flow-impl"],"steps":[{"at":0,"event":"job-due"},{"at":60001,"event":"work-reported","payload":{"token":1},"note":"The stalled worker wakes up."},{"at":60002,"event":"work-reported","payload":{"token":2},"note":"The replacement finishes."}],"timeUnit":"ms"},
    {"id":"page-purged","name":"A change purges the edge copy","description":"The next reader gets the new version.","behaviors":["origin-content-flow","edge-copy-flow"],"steps":[{"at":0,"event":"ec-request"},{"at":1,"event":"ec-published"},{"at":2,"event":"ec-request"}]},
    {"id":"page-purged-impl","name":"A change purges the edge copy (implementation)","description":"A page is read, changed a second later and purged at the edge; the next reader, a second after the change, gets the new version. Times are in milliseconds. The same scenario run on the implementation machines.","behaviors":["origin-content-flow-impl","edge-copy-flow-impl"],"steps":[{"at":0,"event":"ec-request"},{"at":1000,"event":"ec-published"},{"at":2000,"event":"ec-request"}],"timeUnit":"ms"},
    {"id":"page-purge-lost","name":"The purge is lost","description":"A reader inside the lifetime still gets the old version. A reader after it gets the new one.","behaviors":["origin-content-flow","edge-copy-flow"],"faults":["purge-dropped"],"steps":[{"at":0,"event":"ec-request"},{"at":1,"event":"ec-published"},{"at":3,"event":"ec-request","note":"within the lifetime of 5 ticks."},{"at":12,"event":"ec-request","note":"After the lifetime."}]},
    {"id":"page-purge-lost-impl","name":"The purge is lost (implementation)","description":"The page changes 1 second after a read and the purge is lost. A reader 2 seconds after the change, inside the lifetime of 5 seconds, still gets the old version. A reader at 10 seconds gets the new one. Times are in milliseconds. The same scenario run on the implementation machines.","behaviors":["origin-content-flow-impl","edge-copy-flow-impl"],"faults":["purge-dropped"],"steps":[{"at":0,"event":"ec-request"},{"at":1000,"event":"ec-published"},{"at":3000,"event":"ec-request","note":"within the lifetime of 5 seconds."},{"at":10000,"event":"ec-request","note":"After the lifetime."}],"timeUnit":"ms"},
    {"id":"tenant-provisioned","name":"A tenant is provisioned","description":"Every step succeeds.","behaviors":["provisioning-flow"],"steps":[{"at":0,"event":"pv-requested"}]},
    {"id":"tenant-provisioned-impl","name":"A tenant is provisioned (implementation)","description":"Every step succeeds. The same scenario run on the implementation machines.","behaviors":["provisioning-flow-impl"],"steps":[{"at":0,"event":"pv-requested"}],"timeUnit":"ms"},
    {"id":"tenant-provisioning-fails","name":"Provisioning fails while applying the layout","description":"The layout step fails and what was created is removed.","behaviors":["provisioning-flow"],"steps":[{"at":0,"event":"pv-requested"},{"at":1,"event":"pv-step-failed"}]},
    {"id":"tenant-provisioning-fails-impl","name":"Provisioning fails while applying the layout (implementation)","description":"The layout step fails and what was created is removed. The same scenario run on the implementation machines.","behaviors":["provisioning-flow-impl"],"steps":[{"at":0,"event":"pv-requested"},{"at":2500,"event":"pv-step-failed"}],"timeUnit":"ms"},
    {"id":"safe-change-applied","name":"A safe change","description":"Policy classes the change as safe, so it is applied after its projection.","behaviors":["proposal-flow"],"steps":[{"at":0,"event":"cp-proposed","payload":{"risky":false}},{"at":1,"event":"cp-apply-requested"}]},
    {"id":"safe-change-applied-impl","name":"A safe change (implementation)","description":"Policy classes the change as safe, so it is applied after its projection. The same scenario run on the implementation machines.","behaviors":["proposal-flow-impl"],"steps":[{"at":0,"event":"cp-proposed","payload":{"risky":false}},{"at":1,"event":"cp-apply-requested"}]},
    {"id":"risky-change-approved","name":"A risky change, approved","description":"An apply before approval is refused. After approval it goes through.","behaviors":["proposal-flow"],"steps":[{"at":0,"event":"cp-proposed","payload":{"risky":true}},{"at":1,"event":"cp-apply-requested","note":"Too early."},{"at":2,"event":"cp-approved"},{"at":3,"event":"cp-apply-requested"}]},
    {"id":"risky-change-approved-impl","name":"A risky change, approved (implementation)","description":"An apply before approval is refused. After approval it goes through. The same scenario run on the implementation machines.","behaviors":["proposal-flow-impl"],"steps":[{"at":0,"event":"cp-proposed","payload":{"risky":true}},{"at":1,"event":"cp-apply-requested","note":"Too early."},{"at":2,"event":"cp-approved"},{"at":3,"event":"cp-apply-requested"}]},
    {"id":"risky-change-rejected","name":"A risky change, rejected","description":"The change is never applied.","behaviors":["proposal-flow"],"steps":[{"at":0,"event":"cp-proposed","payload":{"risky":true}},{"at":1,"event":"cp-rejected"},{"at":2,"event":"cp-apply-requested"}]},
    {"id":"risky-change-rejected-impl","name":"A risky change, rejected (implementation)","description":"The change is never applied. The same scenario run on the implementation machines.","behaviors":["proposal-flow-impl"],"steps":[{"at":0,"event":"cp-proposed","payload":{"risky":true}},{"at":1,"event":"cp-rejected"},{"at":2,"event":"cp-apply-requested"}]},
    {"id":"arc-outbox-duplicate-delivery","name":"A notice is delivered twice","description":"The notice queue delivers one event notice again before it is acknowledged.","behaviors":["arc-outbox-consumer-flow"],"steps":[{"at":0,"event":"arc-ob-delivered","payload":{"seq":1}},{"at":2,"event":"arc-ob-delivered","payload":{"seq":1},"note":"The redelivery."}]},
    {"id":"arc-outbox-duplicate-delivery-impl","name":"A notice is delivered twice (implementation)","description":"The notice queue delivers one event notice again before it is acknowledged. The same scenario run on the implementation machines.","behaviors":["arc-outbox-consumer-flow-impl"],"steps":[{"at":0,"event":"arc-ob-delivered","payload":{"seq":1}},{"at":2,"event":"arc-ob-delivered","payload":{"seq":1},"note":"The redelivery."}]},
    {"id":"arc-publisher-crashed-after-commit","name":"The publisher stops after a commit","description":"The runtime that committed stops before it publishes. The outbox job publishes later.","behaviors":["arc-outbox-delivery-flow"],"faults":["arc-publisher-stops"],"steps":[{"at":0,"event":"rt-committed"},{"at":1,"event":"arc-ob-publish-now"},{"at":5,"event":"arc-ob-sweep-due"}]},
    {
      "id": "arc-publisher-crashed-after-commit-impl",
      "name": "The publisher stops after a commit (implementation)",
      "description": "The runtime that committed stops before it publishes. The outbox job publishes at its sweep, 10 seconds after the commit. Times are in milliseconds. The same scenario run on the implementation machines.",
      "behaviors": [
        "arc-outbox-delivery-flow-impl"
      ],
      "faults": [
        "arc-publisher-stops-impl"
      ],
      "steps": [
