      "id": "switch-with-a-request-in-flight",
      "name": "A switch while a request is in flight",
      "description": "The address is resolved, request r1 begins, the directory switches, the address is resolved again, request r2 begins, and both complete.",
      "behaviors": [
        "placement-switch-flow"
      ],
      "steps": [
        {
          "at": 0,
          "event": "ps-address-resolved",
          "payload": {
            "tenant-id": "t1"
          }
        },
        {
          "at": 1,
          "event": "ps-request-begun",
          "payload": {
            "tenant-id": "t1",
            "req": "r1"
          }
        },
        {
          "at": 2,
          "event": "ps-switched",
          "payload": {
            "tenant-id": "t1"
          }
        },
        {
          "at": 3,
          "event": "ps-address-resolved",
          "payload": {
            "tenant-id": "t1"
          }
        },
        {
          "at": 4,
          "event": "ps-request-begun",
          "payload": {
            "tenant-id": "t1",
            "req": "r2"
          }
        },
        {
          "at": 5,
          "event": "ps-request-completed",
          "payload": {
            "tenant-id": "t1",
            "req": "r1"
          }
        },
        {
          "at": 6,
          "event": "ps-request-completed",
          "payload": {
            "tenant-id": "t1",
            "req": "r2"
          }
        }
      ]
    },
