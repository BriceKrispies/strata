        "a-model-abstraction"
      ]
    },
    {
      "id": "m-sign-up-response-uniform",
      "kind": "temporal",
      "models": "idn-256",
      "statement": "A sign-up for an address that has an account never receives a response that reveals it.",
      "evaluate": {
