    {
      "id": "realm-rate-flow",
      "name": "Realm failure rate",
      "subject": "identity-service",
      "initial": "rl-open",
      "description": "The failed password attempts of one realm across all accounts. Once the failures within the window of 15 minutes reach the realm limit (1000 by default, D-700) every attempt is slowed, whichever account and source it comes from, until the window has passed. One model tick is one minute.",
      "variables": [
        {
          "name": "failures",
          "type": "number",
          "initial": 0
        },
        {
          "name": "windowStart",
          "type": "number",
          "initial": 0
        },
        {
          "name": "limit",
          "type": "number",
          "initial": 1000
        },
        {
          "name": "windowOpen",
          "type": "boolean",
          "initial": false
        }
      ],
      "states": [
        {
          "id": "rl-open",
          "name": "Counting"
        }
      ],
      "transitions": [
        {
          "id": "rl-fail-new-window",
          "from": "rl-open",
          "to": "rl-open",
          "on": "rl-failed",
          "guard": "!(windowOpen && windowStart <= time && time - windowStart < 15)",
          "effects": [
            {
              "set": "windowStart",
              "to": "time"
            },
            {
              "set": "windowOpen",
              "to": true
            },
            {
              "set": "failures",
              "to": 1
            }
          ]
        },
        {
          "id": "rl-fail",
          "from": "rl-open",
          "to": "rl-open",
          "on": "rl-failed",
          "effects": [
            {
              "set": "failures",
              "to": "failures + 1"
            }
          ]
        },
        {
          "id": "rl-attempt-fast-over",
          "from": "rl-open",
          "to": "rl-open",
          "on": "rl-attempt",
          "guard": "failures >= limit && windowOpen && windowStart <= time && time - windowStart < 15",
          "effects": [
            {
              "emit": "rl-immediate"
            }
          ],
          "faultOnly": true,
          "description": "Defect: answers at once although the rate is above the limit."
        },
        {
          "id": "rl-attempt-slow",
          "from": "rl-open",
          "to": "rl-open",
          "on": "rl-attempt",
          "guard": "failures >= limit && windowOpen && windowStart <= time && time - windowStart < 15",
          "effects": [
            {
              "emit": "rl-slowed"
            }
          ]
        },
        {
          "id": "rl-attempt-fast",
          "from": "rl-open",
          "to": "rl-open",
          "on": "rl-attempt",
          "effects": [
            {
              "emit": "rl-immediate"
            }
          ]
        },
        {
          "id": "rl-tighten",
          "from": "rl-open",
          "to": "rl-open",
          "on": "rl-tightened",
          "guard": "event.limit < limit",
          "effects": [
            {
              "set": "limit",
              "to": "event.limit"
            }
          ]
        }
      ]
    },
