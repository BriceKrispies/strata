    {
      "id": "intent-decision",
      "description": "transition.rs transition, the body of contract decide-intent (CT-001) through kernel-transition, and the decision of execute-intent (CT-031, execute-decide) and mutate-record (CT-263, decide-mutation): decide an intent against a snapshot, purely. The snapshot must be of the context's tenant (TenantMismatch, tenant:snapshot_matches_context); CreateTenant needs no tenant (TenantExists, tenant:does_not_exist), every other intent an existing one (TenantNotFound, tenant:exists) that is the context's (TenantMismatch, \"snapshot holds another tenant\"). Then the intent's own function fills a fresh draft (the dispatch's CreateTenant arm cannot be reached), and finish makes the transition. texts are the printed expressions and the blank-name fact (intent-texts).",
      "params": [
        {
          "name": "state",
          "type": "state"
        },
        {
          "name": "intent",
          "type": "intent"
        },
        {
          "name": "ctx",
          "type": "context"
        },
        {
          "name": "texts",
          "type": "intent-texts"
        }
      ],
      "returns": "transition-result",
      "errors": "rejection",
      "body": "if state.tenant-id != ctx.tenant then fail(rejection.rejected(call refuse(error-kind.tenant-mismatch, 'tenant:snapshot_matches_context', format('snapshot is of {}, context names {}', state.tenant-id, ctx.tenant)))) else match intent { create-tenant{name, owner} => match state.tenant { None => try call create-tenant(ctx, name, owner, texts.blank-name), Some(_) => fail(rejection.rejected(call refuse(error-kind.tenant-exists, 'tenant:does_not_exist', 'the tenant already exists'))) }, _ => match state.tenant { None => fail(rejection.rejected(call refuse(error-kind.tenant-not-found, 'tenant:exists', 'no such tenant'))), Some(t) => if t.id != ctx.tenant then fail(rejection.rejected(call refuse(error-kind.tenant-mismatch, 'tenant:snapshot_matches_context', 'snapshot holds another tenant'))) else let d = draft{tenant: t, ctx, coverage: state.coverage, ops: [], events: [], effects: [], evidence: [], next-record: t.next-record} in let done = match intent { create-tenant => fail(rejection.rejected(call refuse(error-kind.tenant-exists, 'tenant:does_not_exist', 'the tenant already exists'))), change-schema{changes, expected-version, existing} => try call change-schema(d, changes, expected-version, existing, texts), assign-role{principal: p, role} => try call change-member(d, p, role, true, texts), revoke-role{principal: p, role} => try call change-member(d, p, role, false, texts), create-record{object, fields} => try call create-record(d, object, fields, texts), update-record{object, id, fields, expected-version} => try call update-record(d, object, id, fields, expected-version, texts), delete-record{object, id, expected-version} => try call delete-record(d, object, id, expected-version, texts) } in call finish(done.draft, done.output) } }",
      "examples": [
