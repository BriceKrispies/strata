      "name": "Credential requests after the window",
      "description": "The limit is tightened to 1; a request in the window is accepted and another one after the window is accepted as well.",
      "behaviors": [
        "tcl-limit-flow"
      ],
      "steps": [
        {
          "at": 0,
          "event": "tcl-tightened",
          "payload": {
            "limit": 1
          }
        },
        {
          "at": 1,
          "event": "tcl-requested"
        },
        {
          "at": 62,
          "event": "tcl-requested"
        }
      ]
    },
    {
      "id": "tcl-window-passes-impl",
      "name": "Credential requests after the window (implementation)",
      "description": "The limit is tightened to 1; a request in the window is accepted and another one after the window is accepted as well. The same scenario run on the implementation machine. Times are in milliseconds.",
      "behaviors": [
        "tcl-limit-flow-impl"
      ],
      "steps": [
        {
          "at": 0,
          "event": "tcl-tightened",
          "payload": {
            "limit": 1
          }
        },
        {
          "at": 1000,
          "event": "tcl-requested"
        },
        {
          "at": 62000,
          "event": "tcl-requested"
        }
      ],
      "timeUnit": "ms"
    },
    {
      "id": "realm-spray-above-rate",
      "name": "A realm sprayed above its rate",
      "description": "The realm tightens its limit to 3; three failures arrive from different accounts and the next attempt follows within the window.",
      "behaviors": [
        "realm-rate-flow"
      ],
      "steps": [
        {
          "at": 0,
          "event": "rl-tightened",
          "payload": {
            "limit": 3
          }
        },
        {
          "at": 1,
          "event": "rl-failed"
        },
        {
          "at": 2,
          "event": "rl-failed"
        },
        {
          "at": 3,
          "event": "rl-failed"
        },
        {
          "at": 4,
          "event": "rl-attempt"
        }
      ]
    },
