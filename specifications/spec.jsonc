        "variables": {
          "messages": "messages",
          "htmlParts": "htmlParts",
          "textParts": "textParts",
          "rawMarkup": "rawMarkup"
        },
        "transitions": {
          "rd-render-t-i": "rd-render-t"
        }
      },
      "storage": {
        "record": "rec-mail-render",
        "key": "render-id",
        "fields": {
          "htmlParts": "html-parts",
          "textParts": "text-parts",
          "rawMarkup": "raw-markup"
        },
        "creates": true
      },
      "realisation": "target"
    },
    {
      "id": "delivery-report-flow",
      "name": "Delivery report",
      "subject": "mail-dispatcher",
      "initial": "dr-live",
      "description": "The reports of the mail provider. A report is accepted only when its signature is the one of the provider the deployment is configured for. An accepted report of a permanent bounce or a complaint adds the address to the suppression list of the tenant; other accepted reports add nothing.",
      "variables": [
        {
          "name": "accepted",
          "type": "number",
          "initial": 0
        },
        {
          "name": "mustSuppress",
          "type": "number",
          "initial": 0
        },
        {
          "name": "suppressed",
          "type": "number",
          "initial": 0
        },
        {
          "name": "rejected",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "dr-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "dr-accept-forged",
          "from": "dr-live",
          "to": "dr-live",
          "on": "dr-report",
          "description": "Defect: acts on a report whose signature is not the provider signature.",
          "guard": "!event.valid && (event.kind == 'bounce-permanent' || event.kind == 'complaint')",
          "faultOnly": true,
          "effects": [
            {
              "set": "suppressed",
              "to": "suppressed + 1"
            },
            {
              "emit": "dr-suppressed"
            }
          ]
        },
        {
          "id": "dr-ignore-complaint",
          "from": "dr-live",
          "to": "dr-live",
          "on": "dr-report",
          "description": "Defect: a complaint does not add the address to the suppression list.",
          "guard": "event.valid && event.kind == 'complaint'",
          "faultOnly": true,
          "effects": [
            {
              "set": "accepted",
              "to": "accepted + 1"
            },
            {
              "set": "mustSuppress",
              "to": "mustSuppress + 1"
            }
          ]
        },
        {
          "id": "dr-suppress",
          "from": "dr-live",
          "to": "dr-live",
          "on": "dr-report",
          "guard": "event.valid && (event.kind == 'bounce-permanent' || event.kind == 'complaint')",
          "effects": [
            {
              "set": "accepted",
              "to": "accepted + 1"
            },
            {
              "set": "mustSuppress",
              "to": "mustSuppress + 1"
            },
            {
              "set": "suppressed",
              "to": "suppressed + 1"
            },
            {
              "emit": "dr-suppressed"
            }
          ]
        },
        {
          "id": "dr-note",
          "from": "dr-live",
          "to": "dr-live",
          "on": "dr-report",
          "guard": "event.valid",
          "effects": [
            {
              "set": "accepted",
              "to": "accepted + 1"
            }
          ]
        },
        {
          "id": "dr-reject",
          "from": "dr-live",
          "to": "dr-live",
          "on": "dr-report",
          "effects": [
            {
              "set": "rejected",
              "to": "rejected + 1"
            },
            {
              "emit": "dr-rejected"
            }
          ]
        }
      ]
    },
    {
      "id": "delivery-report-flow-impl",
      "name": "Delivery report (implementation)",
      "level": "implementation",
      "subject": "mail-dispatcher",
      "refines": "delivery-report-flow",
