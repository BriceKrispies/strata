    {
      "id": "visible",
      "description": "crates/kernel/src/read.rs visible, the pure body of contract check-record-visibility (CT-005): whether a principal may read a stored record, the decision read makes per row: authorize Read on the record's object type, against the tenant's own schema, with the record as old and new and no lookup.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "principal",
          "type": "principal"
        },
        {
          "name": "record",
          "type": "record"
        },
        {
          "name": "now",
          "type": "timestamp"
        }
      ],
      "returns": "bool",
      "body": "(call authorize(tenant, tenant.schema, principal, now, action.read, resource.object(record.object), subject{old: record, new: record})).allowed",
      "examples": [
        {
          "description": "A published post is visible to anyone.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-1"
            },
            "principal": "anonymous",
            "record": {
              "fixture": "fx-record-1"
            },
            "now": 1800000000000
          },
          "result": true
        },
        {
          "description": "A draft is not visible to the public.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-1"
            },
            "principal": "anonymous",
            "record": {
              "fixture": "fx-record-2"
            },
            "now": 1800000000000
          },
          "result": false
        },
        {
          "description": "Its author sees her draft (authors_own_posts).",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-1"
            },
            "principal": {
              "user": "user:ann"
            },
            "record": {
              "fixture": "fx-record-2"
            },
            "now": 1800000000000
          },
          "result": true
        },
        {
          "description": "Another author does not.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-1"
            },
            "principal": {
              "user": "user:bob"
            },
            "record": {
              "fixture": "fx-record-2"
            },
            "now": 1800000000000
          },
          "result": false
        },
        {
          "description": "The owner sees everything.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-1"
            },
            "principal": {
              "user": "user:admin"
            },
            "record": {
              "fixture": "fx-record-2"
            },
            "now": 1800000000000
          },
          "result": true
        },
        {
          "description": "The system holds no role, so it sees nothing through policies.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-1"
            },
            "principal": "system",
            "record": {
              "fixture": "fx-record-1"
            },
            "now": 1800000000000
          },
          "result": false
        }
      ]
    },
    {
      "id": "value-is-null",
      "description": "value.rs Value::is_null.",
      "params": [
        {
          "name": "x",
          "type": "value"
        }
      ],
      "returns": "bool",
      "body": "match x { bool(_) => false, int(_) => false, str(_) => false, time(_) => false, ref(_) => false, list(_) => false, _ => true }",
      "examples": [
        {
          "args": {
            "x": "null"
          },
          "result": true
        },
        {
          "args": {
            "x": {
              "int": 0
            }
          },
          "result": false
        },
        {
          "args": {
            "x": {
              "list": []
            }
          },
          "result": false
        }
      ]
    },
    {
      "id": "value-kind",
      "description": "value.rs Value::kind: the name of a value's shape, for messages.",
      "params": [
        {
          "name": "x",
          "type": "value"
        }
      ],
      "returns": "string",
      "body": "match x { bool(_) => 'bool', int(_) => 'int', str(_) => 'string', time(_) => 'timestamp', ref(_) => 'reference', list(_) => 'list', _ => 'null' }",
      "examples": [
        {
          "args": {
            "x": {
              "int": 3
            }
          },
          "result": "int"
        },
        {
          "args": {
            "x": {
              "time": 1
            }
          },
          "result": "timestamp"
        },
        {
          "args": {
            "x": {
              "ref": 1
            }
          },
          "result": "reference"
        },
        {
          "args": {
            "x": "null"
          },
          "result": "null"
        },
        {
          "args": {
            "x": {
              "str": "a"
            }
          },
          "result": "string"
        },
        {
          "args": {
            "x": {
              "bool": true
            }
          },
          "result": "bool"
        },
        {
          "args": {
            "x": {
              "list": []
            }
          },
          "result": "list"
        }
      ]
    },
    {
      "id": "field-type-scalar-name",
      "description": "value.rs FieldType::name of a type that is not a list; a list is named list (its element type is named by field-type-name).",
      "params": [
        {
          "name": "ty",
          "type": "field-type"
        }
      ],
      "returns": "string",
      "body": "match ty { str => 'string', int => 'int', bool => 'bool', time => 'timestamp', ref{target} => format('reference<{}>', target), list(_) => 'list', file => 'file', language => 'language' }",
      "examples": [
        {
          "args": {
            "ty": "str"
          },
          "result": "string"
        },
        {
          "args": {
            "ty": "time"
          },
          "result": "timestamp"
        },
        {
          "args": {
            "ty": {
              "ref": {
                "target": "person",
                "on-delete": "set-null"
              }
            }
          },
          "result": "reference<person>"
        },
        {
          "args": {
            "ty": {
              "list": "int"
            }
          },
          "result": "list"
        },
        {
          "args": {
            "ty": {
              "file": {
                "media-types": [
                  "image/png"
                ],
                "max-bytes": 5242880,
                "renditions": []
              }
            }
          },
          "result": "file"
        },
        {
          "args": {
            "ty": "language"
          },
          "result": "language"
        }
      ]
    },
    {
      "id": "field-type-name",
      "description": "value.rs FieldType::name. A list of lists, which schema problems refuse, is named list<list> (no recursion in functions).",
      "params": [
        {
          "name": "ty",
          "type": "field-type"
        }
      ],
      "returns": "string",
      "body": "match ty { list(inner) => format('list<{}>', call field-type-scalar-name(inner)), _ => call field-type-scalar-name(ty) }",
      "examples": [
        {
          "args": {
            "ty": "int"
          },
          "result": "int"
        },
        {
          "args": {
            "ty": {
              "list": "str"
            }
          },
          "result": "list<string>"
        },
        {
          "args": {
            "ty": {
              "list": {
                "ref": {
                  "target": "tag",
                  "on-delete": "restrict"
                }
              }
            }
          },
          "result": "list<reference<tag>>"
        }
      ]
    },
    {
      "id": "scalar-admits",
      "description": "value.rs FieldType::admits for a type that is not a list. A list type here is an element type of a list of lists, which schema problems refuse; it admits nothing.",
      "params": [
        {
          "name": "ty",
          "type": "field-type"
        },
        {
          "name": "x",
          "type": "value"
        }
      ],
      "returns": "bool",
      "body": "match ty { str => match x { str(_) => true, _ => false }, int => match x { int(_) => true, _ => false }, bool => match x { bool(_) => true, _ => false }, time => match x { time(_) => true, _ => false }, ref => match x { ref(_) => true, _ => false }, list(_) => false, file => match x { str(_) => true, _ => false }, language => match x { str(_) => true, _ => false } }",
      "examples": [
        {
          "args": {
            "ty": "str",
            "x": {
              "str": "a"
            }
          },
          "result": true
        },
        {
          "args": {
            "ty": "str",
            "x": {
              "int": 3
            }
          },
          "result": false
        },
        {
          "args": {
            "ty": "time",
            "x": {
              "int": 3
            }
          },
          "result": false
        },
        {
          "args": {
            "ty": {
              "ref": {
                "target": "person",
                "on-delete": "set-null"
              }
            },
            "x": {
              "ref": 1
            }
          },
          "result": true
        },
        {
          "args": {
            "ty": "str",
            "x": {
              "str": "a"
            }
          },
          "result": true
        },
        {
          "args": {
            "ty": "str",
            "x": "null"
          },
          "result": false
        },
        {
          "args": {
            "ty": "int",
            "x": {
              "int": 3
            }
          },
          "result": true
        },
        {
          "args": {
            "ty": "int",
            "x": "null"
          },
          "result": false
        },
        {
          "args": {
            "ty": "bool",
            "x": {
              "bool": true
            }
          },
          "result": true
        },
        {
          "args": {
            "ty": "bool",
            "x": "null"
          },
          "result": false
        },
        {
          "args": {
            "ty": "time",
            "x": {
              "time": 5
            }
          },
          "result": true
        },
        {
          "args": {
            "ty": "time",
            "x": "null"
          },
          "result": false
        },
        {
          "args": {
            "ty": {
              "ref": {
                "target": "person",
                "on-delete": "set-null"
              }
            },
            "x": {
              "ref": 1
            }
          },
          "result": true
        },
        {
          "args": {
            "ty": {
              "ref": {
                "target": "person",
                "on-delete": "set-null"
              }
            },
            "x": "null"
          },
          "result": false
        },
        {
          "args": {
            "ty": {
              "list": "int"
            },
            "x": {
              "int": 3
            }
          },
          "result": false
        },
        {
          "args": {
            "ty": {
              "list": "int"
            },
            "x": {
              "list": []
            }
          },
          "result": false
        },
        {
          "args": {
            "ty": {
              "list": "int"
            },
            "x": "null"
          },
          "result": false
        },
        {
          "args": {
            "ty": {
              "file": {
                "media-types": [
                  "image/png"
                ],
                "max-bytes": 5242880,
                "renditions": []
              }
            },
            "x": {
              "str": "a1b2"
            }
          },
          "result": true
        },
        {
          "args": {
            "ty": {
              "file": {
                "media-types": [
                  "image/png"
                ],
                "max-bytes": 5242880,
                "renditions": []
              }
            },
            "x": {
              "int": 3
            }
          },
          "result": false
        },
        {
          "args": {
            "ty": "language",
            "x": {
              "str": "fr-ca"
            }
          },
          "result": true
        },
        {
          "args": {
            "ty": "language",
            "x": {
              "int": 3
            }
          },
          "result": false
        }
      ]
    },
    {
      "id": "field-type-admits",
      "description": "value.rs FieldType::admits: whether a non-null value has the type; a list admits a list whose items all have its element type.",
      "params": [
        {
          "name": "ty",
          "type": "field-type"
        },
        {
          "name": "x",
          "type": "value"
        }
      ],
      "returns": "bool",
      "body": "match ty { list(inner) => match x { list(items) => all(i in items, call scalar-admits(inner, i)), _ => false }, _ => call scalar-admits(ty, x) }",
      "examples": [
        {
          "args": {
            "ty": {
              "list": "str"
            },
            "x": {
              "list": [
                {
                  "str": "a"
                },
                {
                  "str": "b"
                }
              ]
            }
          },
          "result": true
        },
        {
          "args": {
            "ty": {
              "list": "str"
            },
            "x": {
              "list": [
                {
                  "str": "a"
                },
                {
                  "int": 1
                }
              ]
            }
          },
          "result": false
        },
        {
          "args": {
            "ty": {
              "list": "str"
            },
            "x": {
              "str": "a"
            }
          },
          "result": false
        },
        {
          "args": {
            "ty": "bool",
            "x": {
              "bool": true
            }
          },
          "result": true
        }
      ]
    },
    {
      "id": "ref-target",
      "description": "value.rs FieldType::ref_target: the object type a field refers to, directly or as list elements.",
      "params": [
        {
          "name": "ty",
          "type": "field-type"
        }
      ],
      "returns": "option<object-type-id>",
      "body": "match ty { ref{target} => target, list(inner) => match inner { ref{target} => target, _ => null }, _ => null }",
      "examples": [
        {
          "args": {
            "ty": {
              "ref": {
                "target": "person",
                "on-delete": "set-null"
              }
            }
          },
          "result": "person"
        },
        {
          "args": {
            "ty": {
              "list": {
                "ref": {
                  "target": "tag",
                  "on-delete": "restrict"
                }
              }
            }
          },
          "result": "tag"
        },
        {
          "args": {
            "ty": {
              "list": "str"
            }
          },
          "result": null
        }
      ]
    },
    {
      "id": "refs-in",
      "description": "value.rs refs_in: the record ids a value refers to (a reference, or the references in a list).",
      "params": [
        {
          "name": "x",
          "type": "value"
        }
      ],
      "returns": "list<record-id>",
      "body": "match x { ref(id) => [id], list(items) => fold(i in items, acc = [], concat(acc, match i { ref(id) => [id], _ => [] })), _ => [] }",
      "examples": [
        {
          "args": {
            "x": {
              "ref": 3
            }
          },
          "result": [
            3
          ]
        },
        {
          "args": {
            "x": {
              "list": [
                {
                  "ref": 1
                },
                {
                  "ref": 4
                }
              ]
            }
          },
          "result": [
            1,
            4
          ]
        },
        {
          "args": {
            "x": {
              "str": "a"
            }
          },
          "result": []
        },
        {
          "args": {
            "x": {
              "list": [
                {
                  "ref": 1
                },
                {
                  "int": 2
                }
              ]
            }
          },
          "result": [
            1
          ]
        }
      ]
    },
    {
      "id": "value-debug-leaf",
      "description": "The Rust Debug text of a value that is not a list (a list is written List([..]) without its items).",
      "params": [
        {
          "name": "x",
          "type": "value"
        }
      ],
      "returns": "string",
      "body": "match x { bool(b) => format('Bool({})', b), int(n) => format('Int({})', n), str(s) => format('Str(\"{}\")', s), time(t) => format('Time({})', t), ref(id) => format('Ref(RecordId({}))', id), list(_) => 'List([..])', _ => 'Null' }",
      "examples": [
        {
          "args": {
            "x": {
              "str": "first"
            }
          },
          "result": "Str(\"first\")"
        },
        {
          "args": {
            "x": {
              "ref": 3
            }
          },
          "result": "Ref(RecordId(3))"
        },
        {
          "args": {
            "x": "null"
          },
          "result": "Null"
        },
        {
          "args": {
            "x": {
              "bool": true
            }
          },
          "result": "Bool(true)"
        },
        {
          "args": {
            "x": {
              "time": 9
            }
          },
          "result": "Time(9)"
        },
        {
          "args": {
            "x": {
              "list": []
            }
          },
          "result": "List([..])"
        }
      ]
    },
    {
      "id": "value-debug",
      "description": "The Rust Debug text of a value ({value:?}), as the kernel writes it into a Need. A list is written with its items one level deep.",
      "params": [
        {
          "name": "x",
          "type": "value"
        }
      ],
      "returns": "string",
      "body": "match x { list(items) => format('List([{}])', fold(i in items, acc = '', let t = call value-debug-leaf(i) in if acc == '' then t else acc + ', ' + t)), _ => call value-debug-leaf(x) }",
      "examples": [
        {
          "args": {
            "x": {
              "int": -2
            }
          },
          "result": "Int(-2)"
        },
        {
          "args": {
            "x": {
              "list": [
                {
                  "str": "a"
                },
                {
                  "int": 1
                }
              ]
            }
          },
          "result": "List([Str(\"a\"), Int(1)])"
        }
      ]
    },
    {
      "id": "need-debug",
      "description": "The Rust Debug text of a Need ({need:?}).",
      "params": [
        {
          "name": "wanted",
          "type": "need"
        }
      ],
      "returns": "string",
      "body": "match wanted { record{object, id} => format('Record { object: ObjectTypeId(\"{}\"), id: RecordId({}) }', object, id), by-field{object, field, value} => format('ByField { object: ObjectTypeId(\"{}\"), field: FieldId(\"{}\"), value: {} }', object, field, call value-debug(value)), all-of(object) => format('AllOf(ObjectTypeId(\"{}\"))', object), page-of{object, after, limit} => format('PageOf { object: ObjectTypeId(\"{}\"), after: {:?}, limit: {} }', object, after, limit), by-fields{object, fields} => format('ByFields { object: ObjectTypeId(\"{}\"), fields: {{}} }', object, fold(k in keys(fields), acc = '', match get(fields, k) { Some(x) => if acc == '' then format('FieldId(\"{}\"): {}', k, call value-debug(x)) else format('{}, FieldId(\"{}\"): {}', acc, k, call value-debug(x)), None => acc })), index-page{object, field, lower, upper, descending, after, limit} => format('IndexPage { object: ObjectTypeId(\"{}\"), field: FieldId(\"{}\"), lower: IndexBound { value: {}, inclusive: {} }, upper: IndexBound { value: {}, inclusive: {} }, descending: {}, after: {}, limit: {} }', object, field, call value-debug(lower.value), lower.inclusive, call value-debug(upper.value), upper.inclusive, descending, match after { Some(p) => format('Some(IndexPosition { value: {}, id: RecordId({}) })', call value-debug(p.value), p.id), None => 'None' }, limit), pair-page{object, field, value, order, descending, after, limit} => format('PairPage { object: ObjectTypeId(\"{}\"), field: FieldId(\"{}\"), value: {}, order: {:?}, descending: {}, after: {}, limit: {} }', object, field, call value-debug(value), order, descending, match after { Some(p) => format('Some(IndexPosition { value: {}, id: RecordId({}) })', call value-debug(p.value), p.id), None => 'None' }, limit), ledger(l) => format('Ledger({})', match l { account{account} => format('Account { account: LedgerAccountId({}) }', account), entry-by-key{account, key} => format('EntryByKey { account: LedgerAccountId({}), key: {:?} }', account, key), entries{account, after, limit} => format('Entries { account: LedgerAccountId({}), after: {:?}, limit: {} }', account, after, limit), ranked{unit, scope, order, offset, limit} => format('Ranked { unit: LedgerUnit(\"{}\"), scope: LedgerScope(\"{}\"), order: {:?}, offset: {}, limit: {} }', unit, scope, order, offset, limit), unit-used{unit} => format('UnitUsed { unit: LedgerUnit(\"{}\") }', unit), pool-used{pool} => format('PoolUsed { pool: LedgerPoolName(\"{}\") }', pool), limit{owner, unit, scope} => format('Limit { owner: {:?}, unit: LedgerUnit(\"{}\"), scope: LedgerScope(\"{}\") }', owner, unit, scope), limits => 'Limits', expiring{unit, cutoff, limit} => format('Expiring { unit: LedgerUnit(\"{}\"), cutoff: {}, limit: {} }', unit, cutoff, limit) }) }",
      "examples": [
        {
          "args": {
            "wanted": {
              "by-field": {
                "object": "note",
                "field": "slug",
                "value": {
                  "str": "first"
                }
              }
            }
          },
          "result": "ByField { object: ObjectTypeId(\"note\"), field: FieldId(\"slug\"), value: Str(\"first\") }"
        },
        {
          "args": {
            "wanted": {
              "record": {
                "object": "person",
                "id": 99
              }
            }
          },
          "result": "Record { object: ObjectTypeId(\"person\"), id: RecordId(99) }"
        },
        {
          "args": {
            "wanted": {
              "all-of": "note"
            }
          },
          "result": "AllOf(ObjectTypeId(\"note\"))"
        },
        {
          "args": {
            "wanted": {
              "page-of": {
                "object": "note",
                "after": 3,
                "limit": 50
              }
            }
          },
          "result": "PageOf { object: ObjectTypeId(\"note\"), after: Some(RecordId(3)), limit: 50 }"
        }
      ]
    },
    {
      "id": "covers",
      "description": "state.rs Coverage::covers: a complete snapshot covers every need; a partial one covers the needs it loaded, and a record, field, window, index page or pair page lookup of an object type it loaded whole.",
      "params": [
        {
          "name": "coverage",
          "type": "coverage"
        },
        {
          "name": "wanted",
          "type": "need"
        }
      ],
      "returns": "bool",
      "body": "match coverage { complete => true, partial(loaded) => any(n in loaded, n == wanted) || match wanted { record{object} => any(n in loaded, n == need.all-of(object)), by-field{object} => any(n in loaded, n == need.all-of(object)), page-of{object} => any(n in loaded, n == need.all-of(object)), by-fields{object} => any(n in loaded, n == need.all-of(object)), index-page{object} => any(n in loaded, n == need.all-of(object)), pair-page{object} => any(n in loaded, n == need.all-of(object)), _ => false } }",
      "examples": [
        {
          "args": {
            "coverage": "complete",
            "wanted": {
              "all-of": "note"
            }
          },
          "result": true
        },
        {
          "description": "behaviour.rs a_thin_snapshot_is_refused_with_the_missing_need: an empty partial snapshot covers nothing.",
          "args": {
            "coverage": {
              "partial": []
            },
            "wanted": {
              "by-field": {
                "object": "note",
                "field": "slug",
                "value": {
                  "str": "first"
                }
              }
            }
          },
          "result": false
        },
        {
          "args": {
            "coverage": {
              "partial": [
                {
                  "all-of": "note"
                }
              ]
            },
            "wanted": {
              "record": {
                "object": "note",
                "id": 1
              }
            }
          },
          "result": true
        },
        {
          "args": {
            "coverage": {
              "partial": [
                {
                  "all-of": "note"
                }
              ]
            },
            "wanted": {
              "record": {
                "object": "person",
                "id": 1
              }
            }
          },
          "result": false
        },
        {
          "args": {
            "coverage": {
              "partial": [
                {
                  "record": {
                    "object": "note",
                    "id": 1
                  }
                }
              ]
            },
            "wanted": {
              "all-of": "note"
            }
          },
          "result": false
        },
        {
          "description": "A window of an object type is covered by the object type loaded whole, and by that window only.",
          "args": {
            "coverage": {
              "partial": [
                {
                  "all-of": "note"
                }
              ]
            },
            "wanted": {
              "page-of": {
                "object": "note",
                "after": null,
                "limit": 5
              }
            }
          },
          "result": true
        },
        {
          "args": {
            "coverage": {
              "partial": [
                {
                  "page-of": {
                    "object": "note",
                    "after": null,
                    "limit": 5
                  }
                }
              ]
            },
            "wanted": {
              "page-of": {
                "object": "note",
                "after": null,
                "limit": 5
              }
            }
          },
          "result": true
        },
        {
          "args": {
            "coverage": {
              "partial": [
                {
                  "page-of": {
                    "object": "note",
                    "after": null,
                    "limit": 5
                  }
                }
              ]
            },
            "wanted": {
              "page-of": {
                "object": "note",
                "after": 2,
                "limit": 5
              }
            }
          },
          "result": false
        },
        {
          "description": "An index page of an object type is covered by the object type loaded whole (KRN-2525).",
          "args": {
            "coverage": {
              "partial": [
                {
                  "all-of": "note"
                }
              ]
            },
            "wanted": {
              "index-page": {
                "object": "note",
                "field": "rank",
                "lower": {
                  "value": {
                    "int": 1
                  },
                  "inclusive": true
                },
                "upper": {
                  "value": {
                    "int": 9
                  },
                  "inclusive": true
                },
                "descending": false,
                "after": null,
                "limit": 200
              }
            }
          },
          "result": true
        },
        {
          "description": "A pair page of an object type is covered by the object type loaded whole (KRN-2921).",
          "args": {
            "coverage": {
              "partial": [
                {
                  "all-of": "note"
                }
              ]
            },
            "wanted": {
              "pair-page": {
                "object": "note",
                "field": "title",
                "value": {
                  "str": "A"
                },
                "order": "$created_at",
                "descending": true,
                "after": null,
                "limit": 200
              }
            }
          },
          "result": true
        },
        {
          "description": "A pair page is not covered by another pair page of the same object type (KRN-2921).",
          "args": {
            "coverage": {
              "partial": [
                {
                  "pair-page": {
                    "object": "note",
                    "field": "title",
                    "value": {
                      "str": "A"
                    },
                    "order": "$created_at",
                    "descending": true,
                    "after": null,
                    "limit": 200
                  }
                }
              ]
            },
            "wanted": {
              "pair-page": {
                "object": "note",
                "field": "title",
                "value": {
                  "str": "B"
                },
                "order": "$created_at",
                "descending": true,
                "after": null,
                "limit": 200
              }
            }
          },
          "result": false
        }
      ]
    },
    {
      "id": "insufficient",
      "description": "rules.rs insufficient: the error of a lookup the snapshot does not cover, naming the need.",
      "params": [
        {
          "name": "wanted",
          "type": "need"
        }
      ],
      "returns": "domain-error",
      "let": [
        {
          "name": "text",
          "expr": "call need-debug(wanted)"
        }
      ],
      "body": "domain-error{kind: error-kind.insufficient-state, message: format('the snapshot does not cover {}', text), evidence: [check{rule: 'coverage', passed: false, detail: text}], missing: wanted}",
      "examples": [
        {
          "args": {
            "wanted": {
              "by-field": {
                "object": "note",
                "field": "slug",
                "value": {
                  "str": "first"
                }
              }
            }
          },
          "result": {
            "kind": "insufficient-state",
            "message": "the snapshot does not cover ByField { object: ObjectTypeId(\"note\"), field: FieldId(\"slug\"), value: Str(\"first\") }",
            "evidence": [
              {
                "rule": "coverage",
                "passed": false,
                "detail": "ByField { object: ObjectTypeId(\"note\"), field: FieldId(\"slug\"), value: Str(\"first\") }"
              }
            ],
            "missing": {
              "by-field": {
                "object": "note",
                "field": "slug",
                "value": {
                  "str": "first"
                }
              }
            }
          }
        }
      ]
    },
    {
      "id": "lookup-record",
      "description": "rules.rs Lookup::record: the record of an object type with an id, refused when the snapshot does not cover it.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "coverage",
          "type": "coverage"
        },
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "id",
          "type": "record-id"
        }
      ],
      "returns": "option<record>",
      "errors": "rejection",
      "let": [
        {
          "name": "wanted",
          "expr": "need.record{object, id}"
        }
      ],
      "body": "if call covers(coverage, wanted) then match get(tenant.records, object) { Some(rs) => get(rs, id), None => null } else fail(rejection.rejected(call insufficient(wanted)))",
      "examples": [
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-4"
            },
            "coverage": "complete",
            "object": "person",
            "id": 1
          },
          "result": {
            "id": 1,
            "object": "person",
            "version": 1,
            "created-by": "alpha:editor",
            "created-at": 1001,
            "updated-at": 1001,
            "fields": {
              "name": {
                "str": "Ada"
              }
            }
          }
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-4"
            },
            "coverage": "complete",
            "object": "person",
            "id": 99
          },
          "result": null
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-4"
            },
            "coverage": {
              "partial": []
            },
            "object": "person",
            "id": 99
          },
          "error": {
            "rejected": {
              "kind": "insufficient-state",
              "message": "the snapshot does not cover Record { object: ObjectTypeId(\"person\"), id: RecordId(99) }",
              "evidence": [
                {
                  "rule": "coverage",
                  "passed": false,
                  "detail": "Record { object: ObjectTypeId(\"person\"), id: RecordId(99) }"
                }
              ],
              "missing": {
                "record": {
                  "object": "person",
                  "id": 99
                }
              }
            }
          }
        }
      ]
    },
    {
      "id": "lookup-by-field",
      "description": "rules.rs Lookup::by_field: the records of an object type whose field equals a value, or holds it when the field is a list (an unset field is null), in id order; refused when the snapshot does not cover the question.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "coverage",
          "type": "coverage"
        },
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "field",
          "type": "field-id"
        },
        {
          "name": "wanted-value",
          "type": "value"
        }
      ],
      "returns": "list<record>",
      "errors": "rejection",
      "let": [
        {
          "name": "wanted",
          "expr": "need.by-field{object, field, value: wanted-value}"
        }
      ],
      "body": "if call covers(coverage, wanted) then match get(tenant.records, object) { Some(rs) => filter(r in values(rs), match get(r.fields, field) { Some(x) => match x { list(items) => any(i in items, i == wanted-value), _ => x == wanted-value }, None => call value-is-null(wanted-value) }), None => [] } else fail(rejection.rejected(call insufficient(wanted)))",
      "examples": [
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-5"
            },
            "coverage": "complete",
            "object": "note",
            "field": "slug",
            "wanted-value": {
              "str": "first"
            }
          },
          "result": [
            {
              "id": 1,
              "object": "note",
              "version": 1,
              "created-by": "alpha:writer1",
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "title": {
                  "str": "First"
                },
                "slug": {
                  "str": "first"
                },
                "status": {
                  "str": "draft"
                }
              }
            }
          ]
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-5"
            },
            "coverage": {
              "partial": [
                {
                  "all-of": "note"
                }
              ]
            },
            "object": "note",
            "field": "slug",
            "wanted-value": {
              "str": "other"
            }
          },
          "result": []
        },
        {
          "description": "behaviour.rs a_thin_snapshot_is_refused_with_the_missing_need",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-5"
            },
            "coverage": {
              "partial": []
            },
            "object": "note",
            "field": "slug",
            "wanted-value": {
              "str": "first"
            }
          },
          "error": {
            "rejected": {
              "kind": "insufficient-state",
              "message": "the snapshot does not cover ByField { object: ObjectTypeId(\"note\"), field: FieldId(\"slug\"), value: Str(\"first\") }",
              "evidence": [
                {
                  "rule": "coverage",
                  "passed": false,
                  "detail": "ByField { object: ObjectTypeId(\"note\"), field: FieldId(\"slug\"), value: Str(\"first\") }"
                }
              ],
              "missing": {
                "by-field": {
                  "object": "note",
                  "field": "slug",
                  "value": {
                    "str": "first"
                  }
                }
              }
            }
          }
        },
        {
          "description": "A list field holds the wanted value among its items.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-5",
              "with": {
                "records.note.1.fields.slug": {
                  "list": [
                    {
                      "str": "first"
                    }
                  ]
                }
              }
            },
            "coverage": "complete",
            "object": "note",
            "field": "slug",
            "wanted-value": {
              "str": "first"
            }
          },
          "result": [
            {
              "id": 1,
              "object": "note",
              "version": 1,
              "created-by": "alpha:writer1",
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "slug": {
                  "list": [
                    {
                      "str": "first"
                    }
                  ]
                },
                "status": {
                  "str": "draft"
                },
                "title": {
                  "str": "First"
                }
              }
            }
          ]
        },
        {
          "description": "A record without the field matches only a wanted null.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-6"
            },
            "coverage": "complete",
            "object": "note",
            "field": "slug",
            "wanted-value": {
              "str": "first"
            }
          },
          "result": []
        },
        {
          "description": "A record without the field matches a wanted null.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-6"
            },
            "coverage": "complete",
            "object": "note",
            "field": "slug",
            "wanted-value": "null"
          },
          "result": [
            {
              "id": 1,
              "object": "note",
              "version": 1,
              "created-by": "alpha:writer1",
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "status": {
                  "str": "draft"
                },
                "title": {
                  "str": "First"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "workflow-has-state",
      "description": "schema.rs WorkflowDef::states contains a state: an initial state, or the source or target of a transition.",
      "params": [
        {
          "name": "workflow",
          "type": "workflow-def"
        },
        {
          "name": "state",
          "type": "string"
        }
      ],
      "returns": "bool",
      "body": "any(s in workflow.initial, s == state) || any(t in workflow.transitions, t.from == state || t.to == state)",
      "examples": [
        {
          "args": {
            "workflow": {
              "fixture": "fx-workflow-def-1"
            },
            "state": "published"
          },
          "result": true
        },
        {
          "args": {
            "workflow": {
              "fixture": "fx-workflow-def-1"
            },
            "state": "archived"
          },
          "result": false
        }
      ]
    },
    {
      "id": "principal-value",
      "description": "expr.rs eval, Expr::Principal: the acting principal's id as a string for a user; null for an anonymous or system principal.",
      "params": [
        {
          "name": "who",
          "type": "principal"
        }
      ],
      "returns": "value",
      "body": "match who { user(id) => value.str(id), _ => call null-value() }",
      "examples": [
        {
          "args": {
            "who": {
              "user": "alpha:writer1"
            }
          },
          "result": {
            "str": "alpha:writer1"
          }
        },
        {
          "args": {
            "who": "anonymous"
          },
          "result": "null"
        }
      ]
    },
    {
      "id": "outcome-pass",
      "description": "rules.rs Validation::pass.",
      "params": [
        {
          "name": "acc",
          "type": "validation-outcome"
        },
        {
          "name": "rule",
          "type": "string"
        },
        {
          "name": "detail",
          "type": "string"
        }
      ],
      "returns": "validation-outcome",
      "body": "validation-outcome{passed: concat(acc.passed, [check{rule, passed: true, detail}]), failed: acc.failed}",
      "examples": [
        {
          "args": {
            "acc": {
              "passed": [],
              "failed": []
            },
            "rule": "type:note.title",
            "detail": "string"
          },
          "result": {
            "passed": [
              {
                "rule": "type:note.title",
                "passed": true,
                "detail": "string"
              }
            ],
            "failed": []
          }
        }
      ]
    },
    {
      "id": "outcome-fail",
      "description": "rules.rs Validation::fail.",
      "params": [
        {
          "name": "acc",
          "type": "validation-outcome"
        },
        {
          "name": "kind",
          "type": "error-kind"
        },
        {
          "name": "rule",
          "type": "string"
        },
        {
          "name": "detail",
          "type": "string"
        }
      ],
      "returns": "validation-outcome",
      "body": "validation-outcome{passed: acc.passed, failed: concat(acc.failed, [validation-failure{check: check{rule, passed: false, detail}, kind}])}",
      "examples": [
        {
          "args": {
            "acc": {
              "passed": [],
              "failed": []
            },
            "kind": "unknown-field",
            "rule": "field:note.nope",
            "detail": "no such field"
          },
          "result": {
            "passed": [],
            "failed": [
              {
                "check": {
                  "rule": "field:note.nope",
                  "passed": false,
                  "detail": "no such field"
                },
                "kind": "unknown-field"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "unknown-field-checks",
      "description": "rules.rs validate_record, first loop: a candidate field the object type does not declare is field:<object>.<field>, UnknownField. start is the outcome so far (the record limit of validate-record).",
      "params": [
        {
          "name": "object",
          "type": "object-type-def"
        },
        {
          "name": "candidate",
          "type": "record"
        },
        {
          "name": "start",
          "type": "validation-outcome"
        }
      ],
      "returns": "validation-outcome",
      "body": "fold(f in keys(candidate.fields), acc = start, if get(object.fields, f) == null then call outcome-fail(acc, error-kind.unknown-field, format('field:{}.{}', object.id, f), 'no such field') else acc)",
      "examples": [
        {
          "args": {
            "object": {
              "fixture": "fx-object-type-def-1"
            },
            "candidate": {
              "id": 2,
              "object": "note",
              "version": 1,
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "title": {
                  "str": "T"
                },
                "slug": {
                  "str": "x"
                },
                "nope": {
                  "str": "y"
                }
              }
            },
            "start": {
              "passed": [],
              "failed": []
            }
          },
          "result": {
            "passed": [],
            "failed": [
              {
                "check": {
                  "rule": "field:note.nope",
                  "passed": false,
                  "detail": "no such field"
                },
                "kind": "unknown-field"
              }
            ]
          }
        },
        {
          "args": {
            "object": {
              "fixture": "fx-object-type-def-1"
            },
            "candidate": {
              "id": 1,
              "object": "note",
              "version": 1,
              "created-by": "alpha:writer1",
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "title": {
                  "str": "First"
                },
                "slug": {
                  "str": "first"
                },
                "status": {
                  "str": "draft"
                }
              }
            },
            "start": {
              "passed": [],
              "failed": []
            }
          },
          "result": {
            "passed": [],
            "failed": []
          }
        }
      ]
    },
    {
      "id": "field-step",
      "description": "rules.rs validate_record, second loop, one declared field: required:, then type: (a wrong type skips the rest of the field), unique: (the clashing record is named only to a principal who may read it: read.rs visible, against the tenant's own schema), and reference: per referenced id. Between required and type: limit-step (a limit the value breaks skips the rest of the field).",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "coverage",
          "type": "coverage"
        },
        {
          "name": "object",
          "type": "object-type-def"
        },
        {
          "name": "candidate",
          "type": "record"
        },
        {
          "name": "principal",
          "type": "principal"
        },
        {
          "name": "now",
          "type": "timestamp"
        },
        {
          "name": "acc",
          "type": "validation-outcome"
        },
        {
          "name": "field",
          "type": "field-def"
        }
      ],
      "returns": "validation-outcome",
      "errors": "rejection",
      "let": [
        {
          "name": "x",
          "expr": "match get(candidate.fields, field.id) { Some(y) => y, None => call null-value() }"
        },
        {
          "name": "at",
          "expr": "format('{}.{}', object.id, field.id)"
        }
      ],
      "body": "if call value-is-null(x) then (if field.required then call outcome-fail(acc, error-kind.missing-required, format('required:{}', at), 'a value is required') else acc) else let a1 = if field.required then call outcome-pass(acc, format('required:{}', at), 'present') else acc in let l1 = call limit-step(a1, at, field, x, 65536, 1000, 200) in if length(l1.failed) != length(a1.failed) then l1 else if !call field-type-admits(field.ty, x) then call outcome-fail(a1, error-kind.type-mismatch, format('type:{}', at), format('expected {}, found {}', call field-type-name(field.ty), call value-kind(x))) else let a2 = call outcome-pass(a1, format('type:{}', at), call field-type-name(field.ty)) in let a3 = if field.unique then (match find(o in try call lookup-by-field(tenant, coverage, object.id, field.id, x), o.id != candidate.id) { Some(o) => if call visible(tenant, principal, o, now) then call outcome-fail(a2, error-kind.unique-violated, format('unique:{}', at), format('record {} already has this value', o.id)) else call outcome-fail(a2, error-kind.unique-violated, format('unique:{}', at), 'another record already has this value'), None => call outcome-pass(a2, format('unique:{}', at), 'no other record has this value') }) else a2 in match call ref-target(field.ty) { Some(target) => fold(id in call refs-in(x), a = a3, match try call lookup-record(tenant, coverage, target, id) { Some(_) => call outcome-pass(a, format('reference:{}', at), format('{} {} exists', target, id)), None => call outcome-fail(a, error-kind.dangling-reference, format('reference:{}', at), format('{} {} does not exist', target, id)) }), None => a3 }",
      "examples": [
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-4"
            },
            "coverage": "complete",
            "object": {
              "fixture": "fx-object-type-def-1"
            },
            "candidate": {
              "id": 1,
              "object": "note",
              "version": 1,
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "slug": {
                  "str": "x"
                }
              }
            },
            "acc": {
              "passed": [],
              "failed": []
            },
            "field": {
              "id": "title",
              "label": "title",
              "ty": "str",
              "required": true,
              "unique": false
            },
            "principal": {
              "user": "alpha:writer1"
            },
            "now": 5001
          },
          "result": {
            "passed": [],
            "failed": [
              {
                "check": {
                  "rule": "required:note.title",
                  "passed": false,
                  "detail": "a value is required"
                },
                "kind": "missing-required"
              }
            ]
          }
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-4"
            },
            "coverage": "complete",
            "object": {
              "fixture": "fx-object-type-def-1"
            },
            "candidate": {
              "id": 1,
              "object": "note",
              "version": 1,
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "title": {
                  "int": 3
                }
              }
            },
            "acc": {
              "passed": [],
              "failed": []
            },
            "field": {
              "id": "title",
              "label": "title",
              "ty": "str",
              "required": true,
              "unique": false
            },
            "principal": {
              "user": "alpha:writer1"
            },
            "now": 5001
          },
          "result": {
            "passed": [
              {
                "rule": "required:note.title",
                "passed": true,
                "detail": "present"
              }
            ],
            "failed": [
              {
                "check": {
                  "rule": "type:note.title",
                  "passed": false,
                  "detail": "expected string, found int"
                },
                "kind": "type-mismatch"
              }
            ]
          }
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-4"
            },
            "coverage": "complete",
            "object": {
              "fixture": "fx-object-type-def-1"
            },
            "candidate": {
              "id": 1,
              "object": "note",
              "version": 1,
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {}
            },
            "acc": {
              "passed": [],
              "failed": []
            },
            "field": {
              "id": "body",
              "label": "body",
              "ty": "str",
              "required": false,
              "unique": false
            },
            "principal": {
              "user": "alpha:writer1"
            },
            "now": 5001
          },
          "result": {
            "passed": [],
            "failed": []
          }
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-4"
            },
            "coverage": "complete",
            "object": {
              "fixture": "fx-object-type-def-1"
            },
            "candidate": {
              "id": 2,
              "object": "note",
              "version": 1,
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "author": {
                  "ref": 1
                }
              }
            },
            "acc": {
              "passed": [],
              "failed": []
            },
            "field": {
              "id": "author",
              "label": "Author",
              "ty": {
                "ref": {
                  "target": "person",
                  "on-delete": "set-null"
                }
              },
              "required": false,
              "unique": false
            },
            "principal": {
              "user": "alpha:writer1"
            },
            "now": 5001
          },
          "result": {
            "passed": [
              {
                "rule": "type:note.author",
                "passed": true,
                "detail": "reference<person>"
              },
              {
                "rule": "reference:note.author",
                "passed": true,
                "detail": "person 1 exists"
              }
            ],
            "failed": []
          }
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-4"
            },
            "coverage": {
              "partial": []
            },
            "object": {
              "fixture": "fx-object-type-def-1"
            },
            "candidate": {
              "id": 2,
              "object": "note",
              "version": 1,
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "author": {
                  "ref": 99
                }
              }
            },
            "acc": {
              "passed": [],
              "failed": []
            },
            "field": {
              "id": "author",
              "label": "Author",
              "ty": {
                "ref": {
                  "target": "person",
                  "on-delete": "set-null"
                }
              },
              "required": false,
              "unique": false
            },
            "principal": {
              "user": "alpha:writer1"
            },
            "now": 5001
          },
          "error": {
            "rejected": {
              "kind": "insufficient-state",
              "message": "the snapshot does not cover Record { object: ObjectTypeId(\"person\"), id: RecordId(99) }",
              "evidence": [
                {
                  "rule": "coverage",
                  "passed": false,
                  "detail": "Record { object: ObjectTypeId(\"person\"), id: RecordId(99) }"
                }
              ],
              "missing": {
                "record": {
                  "object": "person",
                  "id": 99
                }
              }
            }
          }
        }
      ]
    },
    {
      "id": "workflow-checks",
      "description": "rules.rs validate_record, workflow loop: for each workflow of the object type (in id order) whose field holds a string, workflow_state:<workflow> passes when the string is a state of the workflow and fails with WorkflowViolation otherwise.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "object",
          "type": "object-type-def"
        },
        {
          "name": "candidate",
          "type": "record"
        },
        {
          "name": "acc",
          "type": "validation-outcome"
        }
      ],
      "returns": "validation-outcome",
      "body": "fold(w in filter(w in values(schema.workflows), w.object == object.id), a = acc, match get(candidate.fields, w.field) { Some(x) => match x { str(state) => if call workflow-has-state(w, state) then call outcome-pass(a, format('workflow_state:{}', w.id), format('{} is a state', state)) else call outcome-fail(a, error-kind.workflow-violation, format('workflow_state:{}', w.id), format('{} is not a state', state)), _ => a }, None => a })",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-2"
            },
            "object": {
              "fixture": "fx-object-type-def-1"
            },
            "candidate": {
              "id": 1,
              "object": "note",
              "version": 1,
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "status": {
                  "str": "archived"
                }
              }
            },
            "acc": {
              "passed": [],
              "failed": []
            }
          },
          "result": {
            "passed": [],
            "failed": [
              {
                "check": {
                  "rule": "workflow_state:note_status",
                  "passed": false,
                  "detail": "archived is not a state"
                },
                "kind": "workflow-violation"
              }
            ]
          }
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-2"
            },
            "object": {
              "fixture": "fx-object-type-def-1"
            },
            "candidate": {
              "id": 1,
