    {
      "id": "section-problems",
      "description": "schema.rs TenantSchema::problems, one section of a view: an unknown query (nothing else is checked); per argument (in name order) a parameter the query does not declare and a section source that is unknown, not single or itself depends on a section; an included field that is not a reference and a markdown field that is not a string.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "view",
          "type": "view-def"
        },
        {
          "name": "at",
          "type": "string"
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "sec",
          "type": "view-section"
        }
      ],
      "returns": "list<string>",
      "let": [
        {
          "name": "here",
          "expr": "format('{}.{}', at, name)"
        }
      ],
      "body": "match get(schema.queries, sec.query) { None => [format('{}: unknown query {}', here, sec.query)], Some(q) => concat(fold(arg in keys(sec.args), ps = [], concat(concat(ps, if any(p in q.params, p == arg) then [] else [format('{}: query has no parameter {}', here, arg)]), match get(sec.args, arg) { Some(src) => match src { section{section: other} => match get(view.sections, other) { Some(dep) => if !dep.single then [format('{}: section {} is not single', here, other)] else if any(a in values(dep.args), match a { section => true, _ => false }) then [format('{}: section {} itself depends on a section', here, other)] else [], None => [format('{}: unknown section {}', here, other)] }, _ => [] }, None => [] })), match get(schema.objects, q.object) { Some(o) => concat(fold(f in sec.include, ps = [], if match get(o.fields, f) { Some(d) => call ref-target(d.ty) != null, None => false } then ps else concat(ps, [format('{}: {} is not a reference field', here, f)])), fold(f in sec.markdown, ps = [], if match get(o.fields, f) { Some(d) => match d.ty { str => true, _ => false }, None => false } then ps else concat(ps, [format('{}: {} is not a string field', here, f)]))), None => [] }) }",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-5"
            },
            "view": {
              "fixture": "fx-view-def-1"
            },
            "at": "view note",
            "name": "note",
            "sec": {
              "query": "note_by_slug",
              "args": {
                "slug": {
                  "route": "slug"
                }
              },
              "include": [
                "author"
              ],
              "markdown": [
                "body"
              ],
              "single": true
            }
          },
          "result": []
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-5"
            },
            "view": {
              "fixture": "fx-view-def-2"
            },
            "at": "view bad",
            "name": "b",
            "sec": {
              "query": "note_by_slug",
              "args": {
                "slug": {
                  "section": {
                    "section": "a",
                    "attribute": "slug"
                  }
                },
                "x": {
                  "const": {
                    "str": "1"
                  }
                }
              },
              "include": [
                "title"
              ],
              "markdown": [
                "rank"
              ],
              "single": false
            }
          },
          "result": [
            "view bad.b: section a is not single",
            "view bad.b: query has no parameter x",
            "view bad.b: title is not a reference field",
            "view bad.b: rank is not a string field"
          ]
        }
      ]
    },
    {
      "id": "view-problems",
      "description": "schema.rs TenantSchema::problems, one view: a route that does not start with /, a route an earlier view (in id order) took, then each section in name order.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "view",
          "type": "view-def"
        },
        {
          "name": "taken",
          "type": "list<string>"
        }
      ],
      "returns": "list<string>",
      "let": [
        {
          "name": "at",
          "expr": "format('view {}', view.id)"
        },
        {
          "name": "p1",
          "expr": "concat(if call text-starts-with(view.route, '/') then [] else [format('{}: route must start with /', at)], if any(r in taken, r == view.route) then [format('{}: route {} is already taken', at, view.route)] else [])"
        }
      ],
      "body": "fold(name in keys(view.sections), ps = p1, match get(view.sections, name) { None => ps, Some(s) => concat(ps, call section-problems(schema, view, at, name, s)) })",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-5"
            },
            "view": {
              "fixture": "fx-view-def-1"
            },
            "taken": [
              "/"
            ]
          },
          "result": []
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-5"
            },
            "view": {
              "fixture": "fx-view-def-1",
              "with": {
                "id": "again"
              }
            },
            "taken": [
              "/notes/:slug"
            ]
          },
          "result": [
            "view again: route /notes/:slug is already taken"
          ]
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-5"
            },
            "view": {
              "fixture": "fx-view-def-2"
            },
            "taken": []
          },
          "result": [
            "view bad: route must start with /",
            "view bad.b: section a is not single",
            "view bad.b: query has no parameter x",
            "view bad.b: title is not a reference field",
            "view bad.b: rank is not a string field",
            "view bad.c: section d itself depends on a section",
            "view bad.d: unknown section zz",
            "view bad.e: unknown query nothing"
          ]
        }
      ]
    },
    {
      "id": "schema-problems",
      "description": "schema.rs TenantSchema::problems: every problem of a schema in the order of the kernel's loop: the limits (object types, policies, queries, the limit of each query), object types (the field count, then per field and constraint, the retention), the permissions of roles, teams, invitations, policies, workflows, queries, views, then the composite unique constraints of each object type, the triggers, the automations and the tenant operations (definitions.rs), each in id order; the roles known are the schema's declared roles (genesis declares public and owner). Then the settings and the capabilities the schema declares (setting-problems, capability-problems). The ledger declarations follow (ledger-problems).",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        }
      ],
      "returns": "list<string>",
      "let": [
        {
          "name": "roles",
          "expr": "keys(schema.roles)"
        },
        {
          "name": "p-objects",
          "expr": "fold(o in values(schema.objects), ps = [], concat(ps, call object-problems(schema, roles, o)))"
        },
        {
          "name": "p-policies",
          "expr": "fold(p in values(schema.policies), ps = [], concat(ps, call policy-problems(schema, roles, p)))"
        },
        {
          "name": "p-workflows",
          "expr": "fold(w in values(schema.workflows), ps = [], concat(ps, call workflow-problems(schema, roles, w)))"
        },
        {
          "name": "p-queries",
          "expr": "fold(q in values(schema.queries), ps = [], concat(ps, call query-problems(schema, roles, q)))"
        },
        {
          "name": "scan",
          "expr": "fold(w in values(schema.views), acc = route-scan{problems: [], routes: []}, route-scan{problems: concat(acc.problems, call view-problems(schema, w, acc.routes)), routes: concat(acc.routes, [w.route])})"
        },
        {
          "name": "p-uniques",
          "expr": "fold(o in values(schema.objects), ps = [], concat(ps, call unique-problems(o)))"
        },
        {
          "name": "p-triggers",
          "expr": "call trigger-problems(schema, roles)"
        },
        {
          "name": "p-automations",
          "expr": "call automation-problems(schema, roles)"
        },
        {
          "name": "p-operations",
          "expr": "call operation-problems(schema, roles)"
        },
        {
          "name": "p-limits",
          "expr": "call schema-limit-problems(schema)"
        },
        {
          "name": "p-role-permissions",
          "expr": "call role-permission-problems(schema, roles)"
        },
        {
          "name": "p-teams",
          "expr": "call team-problems(schema, roles)"
        },
        {
          "name": "p-invitations",
          "expr": "call invitation-problems(schema, roles)"
        },
        {
          "name": "p-settings",
          "expr": "call setting-problems(schema)"
        },
        {
          "name": "p-capabilities",
          "expr": "call capability-problems(schema)"
        },
        {
          "name": "p-ledger",
          "expr": "call ledger-problems(schema)"
        }
      ],
      "body": "concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(concat(p-limits, p-objects), p-role-permissions), p-teams), p-invitations), p-policies), p-workflows), p-queries), scan.problems), p-uniques), p-triggers), p-automations), p-operations), p-settings), p-capabilities), p-ledger)",
      "examples": [
        {
          "description": "testkit.rs notes_schema (objects, workflow and queries).",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-5"
            }
          },
          "result": []
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-5",
              "with": {
                "objects.note.constraints.broken": {
                  "id": "broken",
                  "expr": {
                    "cmp": {
                      "op": "eq",
                      "left": {
                        "var": {
                          "scope": "new",
                          "field": "no_such_field"
                        }
                      },
                      "right": {
                        "lit": {
                          "str": "x"
                        }
                      }
                    }
                  },
                  "message": "never"
                },
                "policies.boss": {
                  "id": "boss",
                  "role": "owner",
                  "resource": "members",
                  "actions": [
                    "manage"
                  ]
                },
                "workflows.w": {
                  "id": "w",
                  "object": "tag",
                  "field": "status",
                  "initial": [
                    "draft"
                  ],
                  "transitions": [
                    {
                      "name": "publish",
                      "from": "draft",
                      "to": "published",
                      "guard": {
                        "cmp": {
                          "op": "eq",
                          "left": {
                            "var": {
                              "scope": "old",
                              "field": "$created_by"
                            }
                          },
                          "right": "principal"
                        }
                      },
                      "set": {
                        "published_at": "now"
                      }
                    },
                    {
                      "name": "unpublish",
                      "from": "published",
                      "to": "draft",
                      "set": {
                        "published_at": {
                          "lit": "null"
                        }
                      }
                    }
                  ]
                },
                "queries.q": {
                  "id": "q",
                  "object": "tag",
                  "params": [],
                  "order": []
                },
                "views.a": {
                  "id": "a",
                  "route": "/notes/:slug",
                  "title": "Note",
                  "sections": {
                    "note": {
                      "query": "note_by_slug",
                      "args": {
                        "slug": {
                          "route": "slug"
                        }
                      },
                      "include": [
                        "author"
                      ],
                      "markdown": [
                        "body"
                      ],
                      "single": true
                    },
                    "more": {
                      "query": "notes_by_rank",
                      "args": {},
                      "include": [],
                      "markdown": [],
                      "single": false
                    }
                  }
                },
                "views.b": {
                  "id": "b",
                  "route": "/notes/:slug",
                  "title": "Note",
                  "sections": {
                    "note": {
                      "query": "note_by_slug",
                      "args": {
                        "slug": {
                          "route": "slug"
                        }
                      },
                      "include": [
                        "author"
                      ],
                      "markdown": [
                        "body"
                      ],
                      "single": true
                    },
                    "more": {
                      "query": "notes_by_rank",
                      "args": {},
                      "include": [],
                      "markdown": [],
                      "single": false
                    }
                  }
                }
              }
            }
          },
          "result": [
            "note.broken: unknown field no_such_field",
            "policy boss: the owner role needs no policy",
            "workflow w: unknown object type tag",
            "query q: unknown object type tag",
            "view b: route /notes/:slug is already taken"
          ]
        },
        {
          "description": "A schema with a problem of each kind the kernel states, in its order: the limit of a query, a read condition, the permissions of roles, a team, an invitation, a policy (WG-5095, WG-5077).",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-5",
              "with": {
                "objects.note.fields.title.read": {
                  "len": {
