        },
        {
          "name": "revision",
          "type": "u64"
        },
        {
          "name": "next-record",
          "type": "u64"
        },
        {
          "name": "event-seq",
          "type": "u64"
        },
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "members",
          "type": "json",
          "description": "Principal ids with their role sets."
        }
      ],
      "description": "Table tenant of a tenant file: its single row holds the tenant header, with the current tenant schema as data. The row exists once the tenant is created."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-schema-history",
      "name": "Schema history (tenant file)",
