          ]
        }
      ],
      "refinement": {
        "states": {
          "sp-both-i": "sp-both"
        },
        "variables": {
          "stagingApplied": "stagingApplied",
          "prodPreviewed": "prodPreviewed",
          "prodRunStarted": "prodRunStarted",
          "prodChanged": "prodChanged"
        },
        "transitions": {
          "sp-staging-i": "sp-staging",
          "sp-preview-i": "sp-preview",
          "sp-promote-i": "sp-promote",
          "sp-promote-refused-unpreviewed-i": "sp-promote-refused-unpreviewed"
        }
      },
      "storage": {
        "record": "rec-staging-promotion",
        "key": "tenant-id",
        "creates": true
      },
      "instances": {
        "key": "tenant-id",
        "storedIn": "rec-staging-promotion",
        "max": 16
      }
    },
    {
      "id": "field-change-flow",
      "name": "Field added and field renamed",
      "subject": "migration-job",
      "initial": "fc-open",
      "description": "Two schema changes of one tenant. A new field takes, for each existing record, the value of the expression its change declares (here the base of the record times a factor of 2). A rename keeps the values under the new name and a request under the old name is refused.",
      "variables": [
        {
          "name": "base1",
          "type": "number",
          "initial": 1
        },
        {
          "name": "base2",
          "type": "number",
          "initial": 5
        },
        {
          "name": "factor",
          "type": "number",
          "initial": 2
        },
        {
          "name": "newField1",
          "type": "number",
          "initial": 0
        },
        {
          "name": "newField2",
          "type": "number",
          "initial": 0
        },
        {
          "name": "added",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "oldName",
          "type": "string",
          "initial": "title"
        },
        {
          "name": "fieldName",
          "type": "string",
          "initial": "title"
        },
        {
          "name": "value",
          "type": "string",
          "initial": "v1"
        },
        {
          "name": "renamed",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "lastServedName",
          "type": "string",
          "initial": ""
        },
        {
          "name": "lastServedValue",
          "type": "string",
          "initial": ""
        }
      ],
      "states": [
        {
          "id": "fc-open",
          "name": "Tenant serving"
        }
      ],
      "transitions": [
        {
          "id": "fc-field-defaulted",
          "from": "fc-open",
          "to": "fc-open",
          "on": "fc-field-added",
          "effects": [
            {
              "set": "added",
              "to": true
            }
          ],
          "faultOnly": true,
          "description": "Defect: gives each existing record the default value instead of the value of the expression."
        },
        {
          "id": "fc-rename-drops-values",
          "from": "fc-open",
          "to": "fc-open",
          "on": "fc-rename-applied",
          "effects": [
            {
              "set": "fieldName",
              "to": "event.newName"
            },
            {
              "set": "value",
              "to": "''"
            },
            {
              "set": "renamed",
              "to": true
            },
            {
              "set": "lastServedName",
              "to": "''"
            }
          ],
          "faultOnly": true,
          "description": "Defect: the rename loses the values of the existing records."
        },
        {
          "id": "fc-old-name-still-served",
          "from": "fc-open",
          "to": "fc-open",
          "on": "fc-read-requested",
          "guard": "renamed && event.name == oldName",
          "effects": [
            {
              "set": "lastServedName",
              "to": "event.name"
            },
            {
              "set": "lastServedValue",
              "to": "value"
            },
            {
              "emit": "fc-served"
            }
          ],
          "faultOnly": true,
          "description": "Defect: a request under the old name is still answered after the rename."
        },
        {
          "id": "fc-add-field",
          "from": "fc-open",
          "to": "fc-open",
          "on": "fc-field-added",
          "effects": [
            {
              "set": "newField1",
              "to": "base1 * factor"
            },
            {
              "set": "newField2",
              "to": "base2 * factor"
            },
            {
              "set": "added",
              "to": true
            }
          ]
        },
        {
          "id": "fc-rename",
          "from": "fc-open",
          "to": "fc-open",
          "on": "fc-rename-applied",
          "effects": [
            {
              "set": "fieldName",
              "to": "event.newName"
            },
            {
              "set": "renamed",
              "to": true
            },
            {
              "set": "lastServedName",
              "to": "''"
            }
          ]
        },
        {
          "id": "fc-read",
          "from": "fc-open",
          "to": "fc-open",
          "on": "fc-read-requested",
          "guard": "event.name == fieldName",
          "effects": [
            {
              "set": "lastServedName",
              "to": "event.name"
            },
            {
              "set": "lastServedValue",
              "to": "value"
            },
            {
              "emit": "fc-served"
            }
          ]
        },
        {
          "id": "fc-read-unknown-name",
          "from": "fc-open",
          "to": "fc-open",
          "on": "fc-read-requested",
          "guard": "event.name != fieldName",
          "effects": [
            {
              "emit": "fc-read-refused"
            }
          ]
        }
      ]
    },
    {
      "id": "field-change-flow-impl",
      "name": "Field added and field renamed (implementation)",
      "level": "implementation",
      "subject": "migration-job",
      "refines": "field-change-flow",
      "description": "Two schema changes of one tenant. A new field takes, for each existing record, the value of the expression its change declares (here the base of the record times a factor of 2). A rename keeps the values under the new name and a request under the old name is refused.",
      "initial": "fc-open-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "base1",
          "type": "number",
          "initial": 1,
          "repr": "u64"
        },
        {
          "name": "base2",
          "type": "number",
          "initial": 5,
          "repr": "u64"
        },
        {
          "name": "factor",
          "type": "number",
          "initial": 2,
          "repr": "u64"
        },
        {
          "name": "newField1",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "newField2",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "added",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "oldName",
          "type": "string",
          "initial": "title",
          "repr": "string"
        },
        {
          "name": "fieldName",
          "type": "string",
          "initial": "title",
          "repr": "string"
        },
        {
          "name": "value",
          "type": "string",
          "initial": "v1",
          "repr": "string"
        },
        {
          "name": "renamed",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "lastServedName",
          "type": "string",
          "initial": "",
          "repr": "string"
        },
        {
          "name": "lastServedValue",
          "type": "string",
          "initial": "",
          "repr": "string"
        }
      ],
      "states": [
        {
          "id": "fc-open-i",
          "name": "Tenant serving"
        }
      ],
      "transitions": [
        {
          "id": "fc-add-field-i",
          "from": "fc-open-i",
          "to": "fc-open-i",
          "on": "fc-field-added",
          "otherwise": true,
          "effects": [
            {
              "set": "newField1",
              "to": "base1 * factor"
            },
            {
              "set": "newField2",
              "to": "base2 * factor"
            },
            {
              "set": "added",
              "to": true
            }
          ]
        },
        {
          "id": "fc-rename-i",
          "from": "fc-open-i",
          "to": "fc-open-i",
          "on": "fc-rename-applied",
          "otherwise": true,
          "effects": [
            {
              "set": "fieldName",
              "to": "event.newName"
            },
            {
              "set": "renamed",
              "to": true
            },
            {
              "set": "lastServedName",
              "to": "''"
            }
          ]
        },
        {
          "id": "fc-read-i",
          "from": "fc-open-i",
          "to": "fc-open-i",
          "on": "fc-read-requested",
          "guard": "event.name == fieldName",
          "effects": [
            {
              "set": "lastServedName",
              "to": "event.name"
            },
            {
              "set": "lastServedValue",
              "to": "value"
            },
            {
              "emit": "fc-served",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "fc-read-unknown-name-i",
          "from": "fc-open-i",
          "to": "fc-open-i",
          "on": "fc-read-requested",
          "guard": "event.name != fieldName",
          "effects": [
            {
              "emit": "fc-read-refused",
              "to": "gateway"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "fc-open-i": "fc-open"
        },
        "variables": {
          "base1": "base1",
          "base2": "base2",
          "factor": "factor",
          "newField1": "newField1",
          "newField2": "newField2",
          "added": "added",
          "oldName": "oldName",
          "fieldName": "fieldName",
          "value": "value",
          "renamed": "renamed",
          "lastServedName": "lastServedName",
          "lastServedValue": "lastServedValue"
        },
        "transitions": {
          "fc-add-field-i": "fc-add-field",
          "fc-rename-i": "fc-rename",
          "fc-read-i": "fc-read",
          "fc-read-unknown-name-i": "fc-read-unknown-name"
        }
      },
      "storage": {
        "record": "rec-field-change",
        "key": "tenant-id",
        "creates": true
      },
      "instances": {
        "key": "tenant-id",
        "storedIn": "rec-field-change",
        "max": 16
      }
    },
    {
      "id": "draft-save-flow",
      "name": "Saving a draft across a schema change",
      "subject": "runtime",
      "initial": "ds-open",
      "description": "An author saves a draft made under a schema version. A save under the current version succeeds; a save under a prior version is refused with the current version named, and the text of the draft is kept.",
      "variables": [
        {
          "name": "schemaVersion",
          "type": "number",
          "initial": 1
        },
        {
          "name": "saved",
          "type": "number",
          "initial": 0
        },
        {
          "name": "lastSavedAgainst",
          "type": "number",
          "initial": 0
        },
        {
          "name": "schemaAtSave",
          "type": "number",
          "initial": 0
        },
        {
          "name": "refusedNamed",
          "type": "number",
          "initial": 0
        },
        {
          "name": "draftText",
          "type": "string",
          "initial": "x"
        }
      ],
      "states": [
        {
          "id": "ds-open",
          "name": "Tenant serving"
        }
      ],
      "transitions": [
        {
          "id": "ds-save-stale",
          "from": "ds-open",
          "to": "ds-open",
          "on": "ds-save-requested",
          "guard": "event.draftVersion != schemaVersion",
          "effects": [
            {
              "set": "saved",
              "to": "saved + 1"
            },
            {
              "set": "lastSavedAgainst",
              "to": "event.draftVersion"
            },
            {
              "set": "schemaAtSave",
              "to": "schemaVersion"
            },
            {
              "emit": "ds-saved"
            }
          ],
          "faultOnly": true,
          "description": "Defect: saves a draft made under a prior schema version."
        },
        {
          "id": "ds-refusal-clears-draft",
          "from": "ds-open",
          "to": "ds-open",
          "on": "ds-save-requested",
          "guard": "event.draftVersion != schemaVersion",
          "effects": [
            {
              "set": "refusedNamed",
              "to": "schemaVersion"
            },
            {
              "set": "draftText",
              "to": "''"
            },
            {
              "emit": "ds-save-refused"
            }
          ],
          "faultOnly": true,
          "description": "Defect: the refusal discards the text of the draft."
        },
        {
          "id": "ds-schema-change",
          "from": "ds-open",
          "to": "ds-open",
          "on": "ds-schema-changed",
          "effects": [
            {
              "set": "schemaVersion",
              "to": "schemaVersion + 1"
            }
          ]
        },
        {
          "id": "ds-save",
          "from": "ds-open",
          "to": "ds-open",
          "on": "ds-save-requested",
          "guard": "event.draftVersion == schemaVersion",
          "effects": [
            {
              "set": "saved",
              "to": "saved + 1"
            },
            {
              "set": "lastSavedAgainst",
              "to": "event.draftVersion"
            },
            {
              "set": "schemaAtSave",
              "to": "schemaVersion"
            },
            {
              "emit": "ds-saved"
            }
          ]
        },
        {
          "id": "ds-save-refused-stale",
          "from": "ds-open",
          "to": "ds-open",
          "on": "ds-save-requested",
          "guard": "event.draftVersion != schemaVersion",
          "effects": [
            {
              "set": "refusedNamed",
              "to": "schemaVersion"
            },
            {
              "emit": "ds-save-refused"
            }
          ]
        }
      ]
    },
    {
      "id": "draft-save-flow-impl",
      "name": "Saving a draft across a schema change (implementation)",
      "level": "implementation",
      "subject": "runtime",
      "refines": "draft-save-flow",
      "description": "An author saves a draft made under a schema version. A save under the current version succeeds; a save under a prior version is refused with the current version named, and the text of the draft is kept.",
      "initial": "ds-open-i",
      "transaction": {
        "scope": "transition",
