      },
      "storage": {
        "record": "rec-trigger-run",
        "key": "correlation",
        "creates": true
      }
    },
    {
      "id": "lease-reach-flow",
      "name": "Lease and reach of the tenant database",
      "subject": "automation-worker",
      "initial": "lr-live",
      "description": "One job and one worker. The worker takes a lease on a due job only while it can reach the tenant database of the job; while it cannot, the job stays for another worker.",
      "variables": [
        {
          "name": "token",
          "type": "number",
          "initial": 0
        },
        {
          "name": "reachable",
          "type": "boolean",
          "initial": true
        }
      ],
      "states": [
        {
          "id": "lr-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "lr-grant-unreachable",
          "from": "lr-live",
          "to": "lr-live",
          "on": "lr-job-due",
          "description": "Defect: takes a lease although the tenant database cannot be reached.",
          "guard": "!reachable",
          "faultOnly": true,
          "effects": [
            {
              "set": "token",
              "to": "token + 1"
            },
            {
              "emit": "lr-lease-granted"
            }
          ]
        },
        {
          "id": "lr-grant",
          "from": "lr-live",
          "to": "lr-live",
          "on": "lr-job-due",
          "guard": "reachable",
          "effects": [
            {
              "set": "token",
              "to": "token + 1"
            },
            {
              "emit": "lr-lease-granted"
            }
          ]
        },
        {
          "id": "lr-skip",
          "from": "lr-live",
          "to": "lr-live",
          "on": "lr-job-due",
          "guard": "!reachable",
          "effects": [
            {
              "emit": "lr-lease-skipped"
            }
          ]
        },
        {
          "id": "lr-lose-database",
          "from": "lr-live",
          "to": "lr-live",
          "on": "lr-unreachable",
          "effects": [
            {
              "set": "reachable",
              "to": false
            }
          ]
        },
        {
          "id": "lr-regain-database",
          "from": "lr-live",
          "to": "lr-live",
          "on": "lr-reachable",
          "effects": [
            {
              "set": "reachable",
              "to": true
            }
          ]
        }
      ]
    },
    {
      "id": "lease-reach-flow-impl",
      "name": "Lease and reach of the tenant database (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "lease-reach-flow",
      "description": "One job and one worker. The worker takes a lease on a due job only while it can reach the tenant database of the job; while it cannot, the job stays for another worker.",
      "initial": "lr-live-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "token",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "reachable",
          "type": "boolean",
          "initial": true,
          "repr": "bool"
        }
      ],
      "states": [
        {
          "id": "lr-live-i",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "lr-grant-i",
          "from": "lr-live-i",
          "to": "lr-live-i",
          "on": "lr-job-due",
          "guard": "reachable",
          "effects": [
            {
              "set": "token",
              "to": "token + 1"
            },
            {
              "emit": "lr-lease-granted",
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "lr-skip-i",
          "from": "lr-live-i",
          "to": "lr-live-i",
          "on": "lr-job-due",
          "guard": "!reachable",
          "effects": [
            {
              "emit": "lr-lease-skipped",
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "lr-lose-database-i",
          "from": "lr-live-i",
          "to": "lr-live-i",
          "on": "lr-unreachable",
          "otherwise": true,
          "effects": [
            {
              "set": "reachable",
              "to": false
            }
          ]
        },
        {
          "id": "lr-regain-database-i",
          "from": "lr-live-i",
          "to": "lr-live-i",
          "on": "lr-reachable",
          "otherwise": true,
          "effects": [
            {
              "set": "reachable",
              "to": true
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "lr-live-i": "lr-live"
        },
        "variables": {
          "token": "token",
          "reachable": "reachable"
        },
        "transitions": {
          "lr-grant-i": "lr-grant",
          "lr-skip-i": "lr-skip",
          "lr-lose-database-i": "lr-lose-database",
          "lr-regain-database-i": "lr-regain-database"
        }
      },
      "storage": {
        "record": "rec-lease-attempt",
        "key": "job-id",
        "creates": true
      }
    },
    {
      "id": "job-admission-flow",
      "name": "Job admission",
      "subject": "automation-worker",
      "initial": "ad-live",
      "description": "The due jobs of one tenant are released to workers at the admission rate of 100 jobs a minute (D-700). A burst waits in a backlog that is released once a minute, 100 jobs at most. A due job of another tenant is released to a worker at once and never waits behind the backlog, so its start stays within the start budget. A tick is a second; the budget is modelled as the 5 seconds of SCH-002.",
      "variables": [
        {
          "name": "backlog",
          "type": "number",
          "initial": 0
        },
        {
          "name": "released",
          "type": "number",
          "initial": 0
        },
        {
          "name": "batch",
          "type": "number",
          "initial": 0
        },
        {
          "name": "rate",
          "type": "number",
          "initial": 100
        },
        {
          "name": "ticking",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "otherDueAt",
          "type": "number",
          "initial": 0
        },
        {
          "name": "otherStartedAt",
          "type": "number",
          "initial": 0
        },
        {
          "name": "budget",
          "type": "number",
          "initial": 5
        }
      ],
      "states": [
        {
          "id": "ad-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "ad-burst-first",
          "from": "ad-live",
          "to": "ad-live",
          "on": "ad-burst",
          "guard": "!ticking",
          "effects": [
            {
              "set": "backlog",
              "to": "backlog + event.jobs"
            },
            {
              "set": "ticking",
              "to": true
            },
            {
              "emit": "ad-tick",
              "after": 60
            }
          ]
        },
        {
          "id": "ad-burst-more",
          "from": "ad-live",
          "to": "ad-live",
          "on": "ad-burst",
          "effects": [
            {
              "set": "backlog",
              "to": "backlog + event.jobs"
            }
          ]
        },
        {
          "id": "ad-release-all",
          "from": "ad-live",
          "to": "ad-live",
          "on": "ad-tick",
          "description": "Defect: releases the whole backlog at once.",
          "guard": "backlog > 0",
          "faultOnly": true,
          "effects": [
            {
              "set": "released",
              "to": "released + backlog"
            },
            {
              "set": "batch",
              "to": "backlog"
            },
            {
              "set": "backlog",
              "to": 0
            },
            {
              "set": "ticking",
              "to": false
            }
          ]
        },
        {
          "id": "ad-release-full",
          "from": "ad-live",
          "to": "ad-live",
          "on": "ad-tick",
          "guard": "backlog > rate",
          "effects": [
            {
              "set": "released",
              "to": "released + rate"
            },
            {
              "set": "batch",
              "to": "rate"
            },
            {
              "set": "backlog",
              "to": "backlog - rate"
            },
            {
              "emit": "ad-tick",
              "after": 60
            }
          ]
        },
        {
          "id": "ad-release-rest",
          "from": "ad-live",
          "to": "ad-live",
          "on": "ad-tick",
          "guard": "backlog > 0",
          "effects": [
            {
              "set": "released",
              "to": "released + backlog"
            },
            {
              "set": "batch",
              "to": "backlog"
            },
            {
              "set": "backlog",
              "to": 0
            },
            {
              "set": "ticking",
              "to": false
            }
          ]
        },
        {
          "id": "ad-idle",
          "from": "ad-live",
          "to": "ad-live",
          "on": "ad-tick",
          "effects": [
            {
              "set": "ticking",
              "to": false
            }
          ]
        },
        {
          "id": "ad-other-queued",
          "from": "ad-live",
          "to": "ad-live",
          "on": "ad-other-due",
          "description": "Defect: the job of another tenant is released behind the backlog.",
          "faultOnly": true,
          "effects": [
            {
              "set": "otherDueAt",
              "to": "time"
            },
            {
              "set": "otherStartedAt",
              "to": "time + backlog * 60 / rate"
            },
            {
              "emit": "ad-other-started"
            }
          ]
        },
        {
          "id": "ad-other-started-t",
          "from": "ad-live",
          "to": "ad-live",
          "on": "ad-other-due",
          "effects": [
            {
              "set": "otherDueAt",
              "to": "time"
            },
            {
              "set": "otherStartedAt",
              "to": "time"
            },
            {
              "emit": "ad-other-started"
            }
          ]
        }
      ]
    },
    {
      "id": "job-admission-flow-impl",
      "name": "Job admission (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "job-admission-flow",
      "description": "The job admission of one tenant (rec-job-admission, keyed by tenant-id). The backlog of due jobs is released once a minute, at most the admission rate of 100 jobs; a job of another tenant is started at the moment it is due. Times are in milliseconds.",
      "initial": "ad-live-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "backlog",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "released",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "batch",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "rate",
          "type": "number",
          "initial": 100,
          "repr": "u64"
        },
        {
          "name": "ticking",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "otherDueAt",
          "type": "number",
          "initial": 0,
          "repr": "timestamp"
        },
        {
          "name": "otherStartedAt",
          "type": "number",
          "initial": 0,
          "repr": "timestamp"
        },
        {
          "name": "budget",
          "type": "number",
          "initial": 5000,
          "repr": "duration"
        }
      ],
      "states": [
        {
          "id": "ad-live-i",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "ad-burst-first-i",
          "from": "ad-live-i",
          "to": "ad-live-i",
          "on": "ad-burst",
          "guard": "!ticking",
          "effects": [
            {
              "set": "backlog",
              "to": "backlog + event.jobs"
            },
            {
              "set": "ticking",
              "to": true
            },
            {
              "emit": "ad-tick",
              "after": 60000,
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "ad-burst-more-i",
          "from": "ad-live-i",
          "to": "ad-live-i",
          "on": "ad-burst",
          "otherwise": true,
          "effects": [
            {
              "set": "backlog",
              "to": "backlog + event.jobs"
            }
          ]
        },
        {
          "id": "ad-release-full-i",
          "from": "ad-live-i",
          "to": "ad-live-i",
          "on": "ad-tick",
          "guard": "backlog > rate",
          "effects": [
            {
              "set": "released",
              "to": "released + rate"
            },
            {
              "set": "batch",
              "to": "rate"
            },
            {
              "set": "backlog",
              "to": "backlog - rate"
            },
            {
              "emit": "ad-tick",
              "after": 60000,
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "ad-release-rest-i",
          "from": "ad-live-i",
          "to": "ad-live-i",
          "on": "ad-tick",
          "guard": "backlog > 0",
          "effects": [
            {
              "set": "released",
              "to": "released + backlog"
            },
            {
              "set": "batch",
              "to": "backlog"
            },
            {
              "set": "backlog",
              "to": 0
            },
            {
              "set": "ticking",
              "to": false
            }
          ]
        },
        {
          "id": "ad-idle-i",
          "from": "ad-live-i",
          "to": "ad-live-i",
          "on": "ad-tick",
          "otherwise": true,
          "effects": [
            {
              "set": "ticking",
              "to": false
            }
          ]
        },
        {
          "id": "ad-other-started-t-i",
          "from": "ad-live-i",
          "to": "ad-live-i",
          "on": "ad-other-due",
          "otherwise": true,
          "effects": [
            {
              "set": "otherDueAt",
              "to": "time"
            },
            {
              "set": "otherStartedAt",
              "to": "time"
            },
            {
              "emit": "ad-other-started",
              "to": "automation-worker"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "ad-live-i": "ad-live"
        },
        "variables": {
          "backlog": "backlog",
          "released": "released",
          "batch": "batch",
          "rate": "rate",
          "ticking": "ticking",
          "otherDueAt": "otherDueAt / 1000",
          "otherStartedAt": "otherStartedAt / 1000",
          "budget": "budget / 1000"
        },
        "transitions": {
          "ad-burst-first-i": "ad-burst-first",
          "ad-burst-more-i": "ad-burst-more",
          "ad-release-full-i": "ad-release-full",
          "ad-release-rest-i": "ad-release-rest",
          "ad-idle-i": "ad-idle",
          "ad-other-started-t-i": "ad-other-started-t"
        },
        "timeScale": 1000
      },
      "storage": {
        "record": "rec-job-admission",
        "key": "tenant-id",
        "fields": {
          "otherDueAt": "other-due-at",
          "otherStartedAt": "other-started-at"
        },
        "creates": true
      }
    },
    {
      "id": "wake-flow",
      "name": "Wake scan",
      "subject": "automation-worker",
      "initial": "wk-live",
      "description": "The worker scans the wake index for tenants with due work. It queries the tenant database of a tenant that has an entry in the index and queries no other.",
      "variables": [
        {
          "name": "scans",
          "type": "number",
          "initial": 0
        },
        {
          "name": "awakeScans",
          "type": "number",
          "initial": 0
        },
        {
          "name": "queries",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "wk-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "wk-query-idle-tenant",
          "from": "wk-live",
          "to": "wk-live",
          "on": "wk-scan",
          "description": "Defect: queries the database of a tenant that has no entry.",
          "guard": "!event.awake",
          "faultOnly": true,
          "effects": [
            {
              "set": "scans",
              "to": "scans + 1"
            },
            {
              "set": "queries",
              "to": "queries + 1"
            },
            {
              "emit": "wk-query"
            }
          ]
        },
        {
          "id": "wk-scan-awake",
          "from": "wk-live",
          "to": "wk-live",
          "on": "wk-scan",
          "guard": "event.awake",
          "effects": [
            {
              "set": "scans",
              "to": "scans + 1"
            },
            {
              "set": "awakeScans",
              "to": "awakeScans + 1"
            },
            {
              "set": "queries",
              "to": "queries + 1"
            },
            {
              "emit": "wk-query"
            }
          ]
        },
        {
          "id": "wk-scan-idle",
          "from": "wk-live",
          "to": "wk-live",
          "on": "wk-scan",
          "effects": [
            {
              "set": "scans",
              "to": "scans + 1"
            }
          ]
        }
      ]
    },
    {
      "id": "wake-flow-impl",
      "name": "Wake scan (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "wake-flow",
      "description": "The worker scans the wake index for tenants with due work. It queries the tenant database of a tenant that has an entry in the index and queries no other.",
      "initial": "wk-live-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "scans",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "awakeScans",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "queries",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        }
      ],
      "states": [
        {
          "id": "wk-live-i",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "wk-scan-awake-i",
          "from": "wk-live-i",
          "to": "wk-live-i",
          "on": "wk-scan",
          "guard": "event.awake",
          "effects": [
            {
              "set": "scans",
              "to": "scans + 1"
            },
            {
              "set": "awakeScans",
              "to": "awakeScans + 1"
            },
            {
              "set": "queries",
              "to": "queries + 1"
            },
            {
              "emit": "wk-query",
              "to": "tenant-database"
            }
          ]
        },
        {
          "id": "wk-scan-idle-i",
          "from": "wk-live-i",
          "to": "wk-live-i",
          "on": "wk-scan",
          "otherwise": true,
          "effects": [
            {
              "set": "scans",
              "to": "scans + 1"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "wk-live-i": "wk-live"
        },
        "variables": {
          "scans": "scans",
          "awakeScans": "awakeScans",
          "queries": "queries"
        },
        "transitions": {
          "wk-scan-awake-i": "wk-scan-awake",
          "wk-scan-idle-i": "wk-scan-idle"
        }
      },
      "storage": {
        "record": "rec-wake-scan",
        "key": "scan-id",
        "fields": {
          "awakeScans": "awake-scans"
        },
        "creates": true
      }
    },
    {
      "id": "bulk-change-flow",
      "name": "Bulk change",
      "subject": "automation-worker",
      "initial": "bk-running",
      "description": "One bulk job over many records. Each record it processes has its outcome recorded in the same step, success or failure, so when the job stops the recorded outcomes are exactly the records it touched.",
      "variables": [
        {
          "name": "processed",
          "type": "number",
          "initial": 0
        },
        {
          "name": "recorded",
          "type": "number",
          "initial": 0
        },
        {
          "name": "failed",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "bk-running",
          "name": "Running"
        },
        {
          "id": "bk-stopped",
          "name": "Stopped"
        }
      ],
      "transitions": [
        {
          "id": "bk-process-unrecorded",
          "from": "bk-running",
          "to": "bk-running",
          "on": "bk-process",
          "description": "Defect: the outcome of a record that changed is not recorded.",
          "guard": "event.ok",
          "faultOnly": true,
          "effects": [
            {
              "set": "processed",
              "to": "processed + 1"
            }
          ]
        },
        {
          "id": "bk-process-ok",
          "from": "bk-running",
          "to": "bk-running",
          "on": "bk-process",
          "guard": "event.ok",
          "effects": [
            {
              "set": "processed",
              "to": "processed + 1"
            },
            {
              "set": "recorded",
              "to": "recorded + 1"
            },
            {
              "emit": "bk-outcome-recorded"
            }
          ]
        },
        {
          "id": "bk-process-failed",
          "from": "bk-running",
          "to": "bk-running",
          "on": "bk-process",
          "effects": [
            {
              "set": "processed",
              "to": "processed + 1"
            },
            {
              "set": "recorded",
              "to": "recorded + 1"
            },
            {
              "set": "failed",
              "to": "failed + 1"
            },
            {
              "emit": "bk-outcome-recorded"
            }
          ]
        },
        {
          "id": "bk-interrupt-t",
          "from": "bk-running",
          "to": "bk-stopped",
          "on": "bk-interrupt",
          "effects": []
        },
        {
          "id": "bk-resume-t",
          "from": "bk-stopped",
          "to": "bk-running",
          "on": "bk-resume",
          "effects": []
        }
      ]
    },
    {
      "id": "bulk-change-flow-impl",
      "name": "Bulk change (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "bulk-change-flow",
      "description": "One bulk job over many records. Each record it processes has its outcome recorded in the same step, success or failure, so when the job stops the recorded outcomes are exactly the records it touched.",
      "initial": "bk-running-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "processed",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "recorded",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "failed",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        }
      ],
      "states": [
        {
          "id": "bk-running-i",
          "name": "Running",
          "ignores": [
            "bk-resume"
          ]
        },
        {
          "id": "bk-stopped-i",
          "name": "Stopped",
          "ignores": [
            "bk-process",
            "bk-interrupt"
          ]
        }
      ],
      "transitions": [
        {
          "id": "bk-process-ok-i",
          "from": "bk-running-i",
          "to": "bk-running-i",
          "on": "bk-process",
          "guard": "event.ok",
          "effects": [
            {
              "set": "processed",
              "to": "processed + 1"
            },
            {
              "set": "recorded",
              "to": "recorded + 1"
            },
            {
              "emit": "bk-outcome-recorded",
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "bk-process-failed-i",
          "from": "bk-running-i",
          "to": "bk-running-i",
          "on": "bk-process",
          "otherwise": true,
          "effects": [
            {
              "set": "processed",
              "to": "processed + 1"
            },
            {
              "set": "recorded",
              "to": "recorded + 1"
            },
            {
              "set": "failed",
              "to": "failed + 1"
            },
            {
              "emit": "bk-outcome-recorded",
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "bk-interrupt-t-i",
          "from": "bk-running-i",
          "to": "bk-stopped-i",
          "on": "bk-interrupt",
          "otherwise": true,
          "effects": []
        },
        {
          "id": "bk-resume-t-i",
          "from": "bk-stopped-i",
          "to": "bk-running-i",
          "on": "bk-resume",
          "otherwise": true,
          "effects": []
        }
      ],
      "refinement": {
        "states": {
          "bk-running-i": "bk-running",
          "bk-stopped-i": "bk-stopped"
        },
        "variables": {
          "processed": "processed",
          "recorded": "recorded",
          "failed": "failed"
        },
        "transitions": {
          "bk-process-ok-i": "bk-process-ok",
          "bk-process-failed-i": "bk-process-failed",
          "bk-interrupt-t-i": "bk-interrupt-t",
          "bk-resume-t-i": "bk-resume-t"
        }
      },
      "storage": {
        "record": "rec-bulk-change",
        "key": "job-id",
        "stateValues": {
          "bk-running-i": "running",
          "bk-stopped-i": "stopped"
        },
        "creates": true
      }
    },
    {
      "id": "workflow-definition-flow",
      "name": "Workflow definition schema version",
      "subject": "automation-worker",
      "initial": "wd-live",
      "description": "One workflow definition, stored as tenant metadata. Saving it stamps it with the schema version in force, and a schema migration re-stamps it with the new version, so a stored definition is always under the current schema version.",
      "variables": [
        {
          "name": "schemaNow",
          "type": "number",
          "initial": 1
        },
        {
          "name": "saved",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "savedUnder",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "wd-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "wd-save-unversioned",
          "from": "wd-live",
          "to": "wd-live",
          "on": "wd-save",
          "description": "Defect: stores the definition without the schema version.",
          "faultOnly": true,
          "effects": [
            {
              "set": "saved",
              "to": true
            }
          ]
        },
        {
          "id": "wd-save-t",
          "from": "wd-live",
          "to": "wd-live",
          "on": "wd-save",
          "effects": [
            {
              "set": "saved",
              "to": true
            },
            {
              "set": "savedUnder",
              "to": "schemaNow"
            }
          ]
        },
        {
          "id": "wd-migrate-skips-definition",
          "from": "wd-live",
          "to": "wd-live",
          "on": "wd-migrate",
          "description": "Defect: a migration leaves the stored definition under the old version.",
          "guard": "saved",
          "faultOnly": true,
          "effects": [
            {
              "set": "schemaNow",
              "to": "event.version"
            }
          ]
        },
        {
          "id": "wd-migrate-saved",
          "from": "wd-live",
          "to": "wd-live",
          "on": "wd-migrate",
          "guard": "saved",
          "effects": [
            {
              "set": "schemaNow",
              "to": "event.version"
            },
            {
              "set": "savedUnder",
              "to": "event.version"
            }
          ]
        },
        {
          "id": "wd-migrate-unsaved",
          "from": "wd-live",
          "to": "wd-live",
          "on": "wd-migrate",
          "effects": [
            {
              "set": "schemaNow",
              "to": "event.version"
            }
          ]
        }
      ]
    },
    {
      "id": "workflow-definition-flow-impl",
      "name": "Workflow definition schema version (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "workflow-definition-flow",
      "description": "One workflow definition, stored as tenant metadata. Saving it stamps it with the schema version in force, and a schema migration re-stamps it with the new version, so a stored definition is always under the current schema version.",
      "initial": "wd-live-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "schemaNow",
          "type": "number",
          "initial": 1,
          "repr": "u64"
        },
        {
          "name": "saved",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "savedUnder",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        }
      ],
      "states": [
        {
          "id": "wd-live-i",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "wd-save-t-i",
          "from": "wd-live-i",
          "to": "wd-live-i",
          "on": "wd-save",
          "otherwise": true,
          "effects": [
            {
              "set": "saved",
              "to": true
            },
            {
              "set": "savedUnder",
              "to": "schemaNow"
            }
          ]
        },
        {
          "id": "wd-migrate-saved-i",
          "from": "wd-live-i",
          "to": "wd-live-i",
          "on": "wd-migrate",
          "guard": "saved",
          "effects": [
            {
              "set": "schemaNow",
              "to": "event.version"
            },
            {
              "set": "savedUnder",
              "to": "event.version"
            }
          ]
        },
        {
          "id": "wd-migrate-unsaved-i",
          "from": "wd-live-i",
          "to": "wd-live-i",
          "on": "wd-migrate",
          "otherwise": true,
          "effects": [
            {
              "set": "schemaNow",
              "to": "event.version"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "wd-live-i": "wd-live"
        },
        "variables": {
          "schemaNow": "schemaNow",
          "saved": "saved",
          "savedUnder": "savedUnder"
        },
        "transitions": {
          "wd-save-t-i": "wd-save-t",
          "wd-migrate-saved-i": "wd-migrate-saved",
          "wd-migrate-unsaved-i": "wd-migrate-unsaved"
        }
      },
      "storage": {
        "record": "rec-workflow-definition",
        "key": "workflow-id",
        "fields": {
          "schemaNow": "schema-now",
          "savedUnder": "saved-under"
        },
        "creates": true
      }
    },
    {
      "id": "workflow-activation-flow",
      "name": "Workflow activation",
      "subject": "automation-worker",
      "initial": "wa-draft",
      "description": "One workflow definition in draft. A projection of it can be run. Activation is refused until a projection has run, and refused when the definition names a trigger or action outside the published catalogue.",
      "variables": [
        {
          "name": "projections",
          "type": "number",
          "initial": 0
        },
        {
          "name": "catalogued",
          "type": "boolean",
          "initial": false
        }
      ],
      "states": [
        {
          "id": "wa-draft",
          "name": "Draft"
        },
        {
          "id": "wa-active",
          "name": "Active"
        }
      ],
      "transitions": [
        {
          "id": "wa-project-t",
          "from": "wa-draft",
          "to": "wa-draft",
          "on": "wa-project",
          "effects": [
            {
              "set": "projections",
              "to": "projections + 1"
            }
          ]
        },
        {
          "id": "wa-activate-unprojected",
          "from": "wa-draft",
          "to": "wa-active",
          "on": "wa-activate",
          "description": "Defect: activates a definition that no projection has covered.",
          "guard": "projections == 0",
          "faultOnly": true,
          "effects": [
            {
              "set": "catalogued",
              "to": "event.inCatalogue"
            },
            {
              "emit": "wa-activated"
            }
          ]
        },
        {
          "id": "wa-activate-uncatalogued",
          "from": "wa-draft",
          "to": "wa-active",
          "on": "wa-activate",
          "description": "Defect: activates a definition that names something outside the catalogue.",
          "guard": "!event.inCatalogue",
          "faultOnly": true,
          "effects": [
            {
              "set": "catalogued",
              "to": "event.inCatalogue"
            },
            {
              "emit": "wa-activated"
            }
          ]
        },
        {
          "id": "wa-activate-t",
          "from": "wa-draft",
          "to": "wa-active",
          "on": "wa-activate",
          "guard": "projections > 0 && event.inCatalogue",
          "effects": [
            {
              "set": "catalogued",
              "to": "event.inCatalogue"
            },
            {
              "emit": "wa-activated"
            }
          ]
        },
        {
          "id": "wa-refuse",
          "from": "wa-draft",
          "to": "wa-draft",
          "on": "wa-activate",
          "effects": [
            {
              "emit": "wa-refused"
            }
          ]
        }
      ]
    },
    {
      "id": "workflow-activation-flow-impl",
      "name": "Workflow activation (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "workflow-activation-flow",
      "description": "One workflow definition in draft. A projection of it can be run. Activation is refused until a projection has run, and refused when the definition names a trigger or action outside the published catalogue.",
      "initial": "wa-draft-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "projections",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "catalogued",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        }
      ],
      "states": [
        {
          "id": "wa-draft-i",
          "name": "Draft"
        },
        {
          "id": "wa-active-i",
          "name": "Active",
          "ignores": [
            "wa-project",
            "wa-activate"
          ]
        }
      ],
      "transitions": [
        {
          "id": "wa-project-t-i",
          "from": "wa-draft-i",
          "to": "wa-draft-i",
          "on": "wa-project",
          "otherwise": true,
          "effects": [
            {
              "set": "projections",
              "to": "projections + 1"
            }
          ]
        },
        {
          "id": "wa-activate-t-i",
          "from": "wa-draft-i",
          "to": "wa-active-i",
          "on": "wa-activate",
          "guard": "projections > 0 && event.inCatalogue",
          "effects": [
            {
              "set": "catalogued",
              "to": "event.inCatalogue"
            },
            {
              "emit": "wa-activated",
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "wa-refuse-i",
          "from": "wa-draft-i",
          "to": "wa-draft-i",
          "on": "wa-activate",
          "otherwise": true,
          "effects": [
            {
              "emit": "wa-refused",
              "to": "automation-worker"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "wa-draft-i": "wa-draft",
          "wa-active-i": "wa-active"
        },
        "variables": {
          "projections": "projections",
          "catalogued": "catalogued"
        },
        "transitions": {
          "wa-project-t-i": "wa-project-t",
          "wa-activate-t-i": "wa-activate-t",
          "wa-refuse-i": "wa-refuse"
        }
      },
      "storage": {
        "record": "rec-workflow-activation",
        "key": "workflow-id",
        "stateValues": {
          "wa-draft-i": "draft",
          "wa-active-i": "active"
        },
        "creates": true
      }
    },
    {
      "id": "template-install-flow",
      "name": "Template install",
      "subject": "runtime",
      "initial": "ti-offered",
      "description": "One platform template or integration offered to a tenant. The tenant reviews the projection of the changes it makes, and the install is refused until it has.",
      "variables": [
        {
          "name": "reviews",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "ti-offered",
          "name": "Offered"
        },
        {
          "id": "ti-installed",
          "name": "Installed"
        }
      ],
      "transitions": [
        {
          "id": "ti-review-t",
          "from": "ti-offered",
          "to": "ti-offered",
          "on": "ti-review",
          "effects": [
            {
              "set": "reviews",
              "to": "reviews + 1"
            }
          ]
        },
        {
          "id": "ti-install-unreviewed",
          "from": "ti-offered",
          "to": "ti-installed",
          "on": "ti-install",
          "description": "Defect: installs a template whose projection nobody reviewed.",
          "guard": "reviews == 0",
          "faultOnly": true,
          "effects": [
            {
              "emit": "ti-template-installed"
            }
          ]
        },
        {
          "id": "ti-install-t",
          "from": "ti-offered",
          "to": "ti-installed",
          "on": "ti-install",
          "guard": "reviews > 0",
          "effects": [
            {
              "emit": "ti-template-installed"
            }
          ]
        },
        {
          "id": "ti-refuse",
          "from": "ti-offered",
          "to": "ti-offered",
          "on": "ti-install",
          "effects": [
            {
              "emit": "ti-refused"
            }
          ]
        }
      ]
    },
    {
      "id": "template-install-flow-impl",
      "name": "Template install (implementation)",
      "level": "implementation",
      "subject": "runtime",
      "refines": "template-install-flow",
      "description": "One platform template or integration offered to a tenant. The tenant reviews the projection of the changes it makes, and the install is refused until it has.",
      "initial": "ti-offered-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "reviews",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        }
      ],
      "states": [
        {
          "id": "ti-offered-i",
          "name": "Offered"
        },
        {
          "id": "ti-installed-i",
          "name": "Installed",
          "ignores": [
            "ti-review",
            "ti-install"
          ]
        }
      ],
      "transitions": [
        {
          "id": "ti-review-t-i",
          "from": "ti-offered-i",
          "to": "ti-offered-i",
          "on": "ti-review",
          "otherwise": true,
          "effects": [
            {
              "set": "reviews",
              "to": "reviews + 1"
            }
          ]
        },
        {
          "id": "ti-install-t-i",
          "from": "ti-offered-i",
          "to": "ti-installed-i",
          "on": "ti-install",
          "guard": "reviews > 0",
          "effects": [
            {
              "emit": "ti-template-installed",
              "to": "runtime"
            }
          ]
        },
        {
          "id": "ti-refuse-i",
          "from": "ti-offered-i",
          "to": "ti-offered-i",
          "on": "ti-install",
          "otherwise": true,
          "effects": [
            {
              "emit": "ti-refused",
              "to": "runtime"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "ti-offered-i": "ti-offered",
          "ti-installed-i": "ti-installed"
        },
        "variables": {
          "reviews": "reviews"
        },
        "transitions": {
          "ti-review-t-i": "ti-review-t",
          "ti-install-t-i": "ti-install-t",
          "ti-refuse-i": "ti-refuse"
        }
      },
      "storage": {
        "record": "rec-template-install",
        "key": "install-id",
        "stateValues": {
          "ti-offered-i": "offered",
          "ti-installed-i": "installed"
        },
        "creates": true
      }
    },
    {
      "id": "workflow-run-flow",
      "name": "Workflow run",
      "subject": "automation-worker",
      "initial": "wr-running",
      "description": "One workflow run of three steps. Each step executes and records the step reached in the same step. A process restart loses the process and nothing else: the next step is the one after the last recorded step, so no step runs twice and none is skipped.",
      "variables": [
        {
          "name": "step",
          "type": "number",
          "initial": 0
        },
        {
          "name": "executions",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "wr-running",
          "name": "Running"
        },
        {
          "id": "wr-completed",
          "name": "Completed"
        }
      ],
      "transitions": [
        {
          "id": "wr-restart-from-start",
          "from": "wr-running",
          "to": "wr-running",
          "on": "wr-restart",
          "description": "Defect: a restarted process begins the run again.",
          "faultOnly": true,
          "effects": [
            {
              "set": "step",
              "to": 0
            }
          ]
        },
        {
          "id": "wr-restart-t",
          "from": "wr-running",
          "to": "wr-running",
          "on": "wr-restart",
          "effects": []
        },
        {
          "id": "wr-finish",
          "from": "wr-running",
          "to": "wr-completed",
          "on": "wr-advance",
          "guard": "step == 2",
          "effects": [
            {
              "set": "executions",
              "to": "executions + 1"
            },
            {
              "set": "step",
              "to": "step + 1"
            },
            {
              "emit": "wr-run-finished"
            }
          ]
        },
        {
          "id": "wr-advance-t",
          "from": "wr-running",
          "to": "wr-running",
          "on": "wr-advance",
          "guard": "step < 2",
          "effects": [
            {
              "set": "executions",
              "to": "executions + 1"
            },
            {
              "set": "step",
              "to": "step + 1"
            }
          ]
        }
      ]
    },
    {
      "id": "workflow-run-flow-impl",
      "name": "Workflow run (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "workflow-run-flow",
      "description": "One workflow run of three steps. Each step executes and records the step reached in the same step. A process restart loses the process and nothing else: the next step is the one after the last recorded step, so no step runs twice and none is skipped.",
      "initial": "wr-running-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "step",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "executions",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        }
      ],
      "states": [
        {
          "id": "wr-running-i",
          "name": "Running"
        },
        {
          "id": "wr-completed-i",
          "name": "Completed",
          "ignores": [
            "wr-restart",
            "wr-advance"
          ]
        }
      ],
      "transitions": [
        {
          "id": "wr-restart-t-i",
          "from": "wr-running-i",
          "to": "wr-running-i",
          "on": "wr-restart",
          "otherwise": true,
          "effects": []
        },
        {
          "id": "wr-finish-i",
          "from": "wr-running-i",
          "to": "wr-completed-i",
          "on": "wr-advance",
          "guard": "step == 2",
          "effects": [
            {
              "set": "executions",
              "to": "executions + 1"
            },
            {
              "set": "step",
              "to": "step + 1"
            },
            {
              "emit": "wr-run-finished",
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "wr-advance-t-i",
          "from": "wr-running-i",
          "to": "wr-running-i",
          "on": "wr-advance",
          "guard": "step < 2",
          "effects": [
            {
              "set": "executions",
              "to": "executions + 1"
            },
            {
              "set": "step",
              "to": "step + 1"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "wr-running-i": "wr-running",
          "wr-completed-i": "wr-completed"
        },
        "variables": {
          "step": "step",
          "executions": "executions"
        },
        "transitions": {
          "wr-restart-t-i": "wr-restart-t",
          "wr-finish-i": "wr-finish",
          "wr-advance-t-i": "wr-advance-t"
        }
      },
      "storage": {
        "record": "rec-workflow-run",
        "key": "run-id",
        "stateValues": {
          "wr-running-i": "running",
          "wr-completed-i": "completed"
        }
      }
    },
    {
      "id": "workflow-compensation-flow",
      "name": "Workflow compensation",
      "subject": "automation-worker",
      "initial": "wc-running",
      "description": "One workflow run of up to three steps whose next step fails. The run compensates the steps that completed, newest first, and only those. A compensation of step k is a separate delivery, so the order of the deliveries is the order of compensation.",
      "variables": [
        {
          "name": "completed",
          "type": "number",
          "initial": 0
        },
        {
          "name": "compensated",
          "type": "number",
          "initial": 0
        },
        {
          "name": "lastComp",
          "type": "number",
          "initial": 0
        },
        {
          "name": "prevComp",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "wc-running",
          "name": "Running"
        },
        {
          "id": "wc-compensating",
          "name": "Compensating"
        },
        {
          "id": "wc-failed",
          "name": "Failed and compensated"
        }
      ],
      "transitions": [
        {
          "id": "wc-count-step",
          "from": "wc-running",
          "to": "wc-running",
          "on": "wc-step-done",
          "effects": [
            {
              "set": "completed",
              "to": "completed + 1"
            }
          ]
        },
        {
          "id": "wc-fail-oldest-first",
          "from": "wc-running",
          "to": "wc-compensating",
          "on": "wc-step-failed",
          "description": "Defect: compensates the oldest completed step first.",
          "guard": "completed == 2",
          "faultOnly": true,
          "effects": [
            {
              "emit": "wc-compensate",
              "after": 1,
              "payload": {
                "step": 1
              }
            },
            {
              "emit": "wc-compensate",
              "after": 2,
              "payload": {
                "step": 2
              }
            }
          ]
        },
        {
          "id": "wc-fail-nothing-done",
          "from": "wc-running",
          "to": "wc-failed",
          "on": "wc-step-failed",
          "guard": "completed == 0",
          "effects": [
            {
              "emit": "wc-compensation-finished"
            }
          ]
        },
        {
          "id": "wc-fail-one-done",
          "from": "wc-running",
          "to": "wc-compensating",
          "on": "wc-step-failed",
          "guard": "completed == 1",
          "effects": [
            {
              "emit": "wc-compensate",
              "after": 1,
              "payload": {
                "step": 1
              }
            }
          ]
        },
        {
          "id": "wc-fail-two-done",
          "from": "wc-running",
          "to": "wc-compensating",
          "on": "wc-step-failed",
          "guard": "completed == 2",
          "effects": [
            {
              "emit": "wc-compensate",
              "after": 1,
              "payload": {
                "step": 2
              }
            },
            {
              "emit": "wc-compensate",
              "after": 2,
              "payload": {
                "step": 1
              }
            }
          ]
        },
        {
          "id": "wc-fail-three-done",
          "from": "wc-running",
          "to": "wc-compensating",
          "on": "wc-step-failed",
          "guard": "completed >= 3",
          "effects": [
            {
              "emit": "wc-compensate",
              "after": 1,
              "payload": {
                "step": 3
              }
            },
            {
              "emit": "wc-compensate",
              "after": 2,
              "payload": {
                "step": 2
              }
            },
            {
              "emit": "wc-compensate",
              "after": 3,
              "payload": {
                "step": 1
              }
            }
          ]
        },
        {
          "id": "wc-compensate-last",
          "from": "wc-compensating",
          "to": "wc-failed",
          "on": "wc-compensate",
          "guard": "compensated + 1 == completed",
          "effects": [
            {
              "set": "compensated",
              "to": "compensated + 1"
            },
            {
              "set": "prevComp",
              "to": "lastComp"
            },
            {
              "set": "lastComp",
              "to": "event.step"
            },
            {
              "emit": "wc-compensation-finished"
            }
          ]
        },
        {
          "id": "wc-compensate-step",
          "from": "wc-compensating",
          "to": "wc-compensating",
          "on": "wc-compensate",
          "effects": [
            {
              "set": "compensated",
              "to": "compensated + 1"
            },
            {
              "set": "prevComp",
              "to": "lastComp"
            },
            {
              "set": "lastComp",
              "to": "event.step"
            }
          ]
        }
      ]
    },
    {
      "id": "workflow-compensation-flow-impl",
      "name": "Workflow compensation (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "workflow-compensation-flow",
      "description": "One workflow run of up to three steps whose next step fails. The run compensates the steps that completed, newest first, and only those. A compensation of step k is a separate delivery, so the order of the deliveries is the order of compensation.",
      "initial": "wc-running-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "completed",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "compensated",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "lastComp",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "prevComp",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        }
      ],
      "states": [
        {
          "id": "wc-running-i",
          "name": "Running",
          "ignores": [
            "wc-compensate"
          ]
        },
        {
          "id": "wc-compensating-i",
          "name": "Compensating",
          "ignores": [
            "wc-step-done",
            "wc-step-failed"
          ]
        },
        {
          "id": "wc-failed-i",
          "name": "Failed and compensated",
          "ignores": [
            "wc-step-done",
            "wc-step-failed",
            "wc-compensate"
          ]
        }
      ],
      "transitions": [
        {
          "id": "wc-count-step-i",
          "from": "wc-running-i",
          "to": "wc-running-i",
          "on": "wc-step-done",
          "otherwise": true,
          "effects": [
            {
              "set": "completed",
              "to": "completed + 1"
            }
          ]
        },
        {
          "id": "wc-fail-nothing-done-i",
          "from": "wc-running-i",
          "to": "wc-failed-i",
          "on": "wc-step-failed",
          "guard": "completed == 0",
          "effects": [
            {
              "emit": "wc-compensation-finished",
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "wc-fail-one-done-i",
          "from": "wc-running-i",
          "to": "wc-compensating-i",
          "on": "wc-step-failed",
          "guard": "completed == 1",
          "effects": [
            {
              "emit": "wc-compensate",
              "after": 1,
              "payload": {
                "step": 1
              },
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "wc-fail-two-done-i",
          "from": "wc-running-i",
          "to": "wc-compensating-i",
          "on": "wc-step-failed",
          "guard": "completed == 2",
          "effects": [
            {
              "emit": "wc-compensate",
              "after": 1,
              "payload": {
                "step": 2
              },
              "to": "automation-worker"
            },
            {
              "emit": "wc-compensate",
              "after": 2,
              "payload": {
                "step": 1
              },
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "wc-fail-three-done-i",
          "from": "wc-running-i",
          "to": "wc-compensating-i",
          "on": "wc-step-failed",
          "guard": "completed >= 3",
          "effects": [
            {
              "emit": "wc-compensate",
              "after": 1,
              "payload": {
                "step": 3
              },
              "to": "automation-worker"
            },
            {
              "emit": "wc-compensate",
              "after": 2,
              "payload": {
                "step": 2
              },
              "to": "automation-worker"
            },
            {
              "emit": "wc-compensate",
              "after": 3,
              "payload": {
                "step": 1
              },
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "wc-compensate-last-i",
          "from": "wc-compensating-i",
          "to": "wc-failed-i",
          "on": "wc-compensate",
          "guard": "compensated + 1 == completed",
          "effects": [
            {
              "set": "compensated",
              "to": "compensated + 1"
            },
            {
              "set": "prevComp",
              "to": "lastComp"
            },
            {
              "set": "lastComp",
              "to": "event.step"
            },
            {
              "emit": "wc-compensation-finished",
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "wc-compensate-step-i",
          "from": "wc-compensating-i",
          "to": "wc-compensating-i",
          "on": "wc-compensate",
          "otherwise": true,
          "effects": [
            {
              "set": "compensated",
              "to": "compensated + 1"
            },
            {
              "set": "prevComp",
              "to": "lastComp"
            },
            {
              "set": "lastComp",
              "to": "event.step"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "wc-running-i": "wc-running",
          "wc-compensating-i": "wc-compensating",
          "wc-failed-i": "wc-failed"
        },
        "variables": {
          "completed": "completed",
          "compensated": "compensated",
          "lastComp": "lastComp",
          "prevComp": "prevComp"
        },
        "transitions": {
          "wc-count-step-i": "wc-count-step",
          "wc-fail-nothing-done-i": "wc-fail-nothing-done",
          "wc-fail-one-done-i": "wc-fail-one-done",
          "wc-fail-two-done-i": "wc-fail-two-done",
          "wc-fail-three-done-i": "wc-fail-three-done",
          "wc-compensate-last-i": "wc-compensate-last",
          "wc-compensate-step-i": "wc-compensate-step"
        }
      },
      "storage": {
        "record": "rec-workflow-run",
        "key": "run-id",
        "fields": {
          "lastComp": "last-comp",
          "prevComp": "prev-comp"
        },
        "stateValues": {
          "wc-running-i": "running",
          "wc-compensating-i": "compensating",
          "wc-failed-i": "failed"
        }
      }
    },
    {
      "id": "approval-flow",
      "name": "Workflow approval",
      "subject": "automation-worker",
      "initial": "wp-waiting",
      "description": "One workflow run waiting for approval. An approval carries the decision of the policy of the step on the principal who gave it. The run continues after an approval that the policy permits, and an approval that it does not permit is refused and leaves the run waiting.",
      "variables": [
        {
          "name": "permittedApprovals",
          "type": "number",
          "initial": 0
        },
        {
          "name": "refusedApprovals",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "wp-waiting",
          "name": "Waiting for approval"
        },
        {
          "id": "wp-continued",
          "name": "Continued"
        }
      ],
      "transitions": [
        {
          "id": "wp-continue-unpermitted",
          "from": "wp-waiting",
          "to": "wp-continued",
          "on": "wp-approve",
          "description": "Defect: any approval continues the run.",
          "guard": "!event.permitted",
          "faultOnly": true,
          "effects": [
            {
              "emit": "wp-run-continued"
            }
          ]
        },
        {
          "id": "wp-continue",
          "from": "wp-waiting",
          "to": "wp-continued",
          "on": "wp-approve",
          "guard": "event.permitted",
          "effects": [
            {
              "set": "permittedApprovals",
              "to": "permittedApprovals + 1"
            },
            {
              "emit": "wp-run-continued"
            }
          ]
        },
        {
          "id": "wp-refuse-approval",
          "from": "wp-waiting",
          "to": "wp-waiting",
          "on": "wp-approve",
          "effects": [
            {
              "set": "refusedApprovals",
              "to": "refusedApprovals + 1"
            },
            {
              "emit": "wp-approval-refused"
            }
          ]
        }
      ]
    },
    {
      "id": "approval-flow-impl",
      "name": "Workflow approval (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "approval-flow",
      "description": "One workflow run waiting for approval. An approval carries the decision of the policy of the step on the principal who gave it. The run continues after an approval that the policy permits, and an approval that it does not permit is refused and leaves the run waiting.",
      "initial": "wp-waiting-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "permittedApprovals",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "refusedApprovals",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        }
      ],
      "states": [
        {
          "id": "wp-waiting-i",
          "name": "Waiting for approval"
        },
        {
          "id": "wp-continued-i",
          "name": "Continued",
          "ignores": [
            "wp-approve"
          ]
        }
      ],
      "transitions": [
        {
          "id": "wp-continue-i",
          "from": "wp-waiting-i",
          "to": "wp-continued-i",
          "on": "wp-approve",
          "guard": "event.permitted",
          "effects": [
            {
              "set": "permittedApprovals",
              "to": "permittedApprovals + 1"
            },
            {
              "emit": "wp-run-continued",
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "wp-refuse-approval-i",
          "from": "wp-waiting-i",
          "to": "wp-waiting-i",
          "on": "wp-approve",
          "otherwise": true,
          "effects": [
            {
              "set": "refusedApprovals",
              "to": "refusedApprovals + 1"
            },
            {
              "emit": "wp-approval-refused",
              "to": "automation-worker"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "wp-waiting-i": "wp-waiting",
          "wp-continued-i": "wp-continued"
        },
        "variables": {
          "permittedApprovals": "permittedApprovals",
          "refusedApprovals": "refusedApprovals"
        },
        "transitions": {
          "wp-continue-i": "wp-continue",
          "wp-refuse-approval-i": "wp-refuse-approval"
        }
      },
      "storage": {
        "record": "rec-workflow-run",
        "key": "run-id",
        "fields": {
          "permittedApprovals": "permitted-approvals",
          "refusedApprovals": "refused-approvals"
        },
        "stateValues": {
          "wp-waiting-i": "awaiting-approval",
          "wp-continued-i": "running"
        }
      }
    },
    {
      "id": "approval-inbox-flow",
      "name": "Approval task delivery",
      "subject": "notification-service",
      "initial": "ni-live",
      "description": "An approval step creates a task. For each principal, the policy of the step says whether the principal is named, and the task appears in the inbox of a principal that is named and of no other.",
      "variables": [
        {
          "name": "namedEvaluated",
          "type": "number",
          "initial": 0
        },
        {
          "name": "itemsNamed",
          "type": "number",
          "initial": 0
        },
        {
          "name": "itemsOther",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "ni-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "ni-deliver-to-unnamed",
          "from": "ni-live",
          "to": "ni-live",
          "on": "ni-evaluate",
          "description": "Defect: the task is put into the inbox of a principal the policy does not name.",
          "guard": "!event.named",
          "faultOnly": true,
          "effects": [
            {
              "set": "itemsOther",
              "to": "itemsOther + 1"
            },
            {
              "emit": "ni-item-delivered"
            }
          ]
        },
        {
          "id": "ni-drop-for-named",
          "from": "ni-live",
          "to": "ni-live",
          "on": "ni-evaluate",
          "description": "Defect: a named principal gets no item.",
          "guard": "event.named",
          "faultOnly": true,
          "effects": [
            {
              "set": "namedEvaluated",
              "to": "namedEvaluated + 1"
            }
          ]
        },
        {
          "id": "ni-deliver",
          "from": "ni-live",
          "to": "ni-live",
          "on": "ni-evaluate",
          "guard": "event.named",
          "effects": [
            {
              "set": "namedEvaluated",
              "to": "namedEvaluated + 1"
            },
            {
              "set": "itemsNamed",
              "to": "itemsNamed + 1"
            },
            {
              "emit": "ni-item-delivered"
            }
          ]
        },
        {
          "id": "ni-no-item",
          "from": "ni-live",
          "to": "ni-live",
          "on": "ni-evaluate",
          "effects": []
        }
      ]
    },
    {
      "id": "approval-inbox-flow-impl",
      "name": "Approval task delivery (implementation)",
      "level": "implementation",
      "subject": "notification-service",
      "refines": "approval-inbox-flow",
      "description": "An approval step creates a task. For each principal, the policy of the step says whether the principal is named, and the task appears in the inbox of a principal that is named and of no other.",
      "initial": "ni-live-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "namedEvaluated",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "itemsNamed",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "itemsOther",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        }
      ],
      "states": [
        {
          "id": "ni-live-i",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "ni-deliver-i",
          "from": "ni-live-i",
          "to": "ni-live-i",
          "on": "ni-evaluate",
          "guard": "event.named",
          "effects": [
            {
              "set": "namedEvaluated",
              "to": "namedEvaluated + 1"
            },
            {
              "set": "itemsNamed",
              "to": "itemsNamed + 1"
            },
            {
              "emit": "ni-item-delivered",
              "to": "notification-service"
            }
          ]
        },
        {
          "id": "ni-no-item-i",
          "from": "ni-live-i",
          "to": "ni-live-i",
          "on": "ni-evaluate",
          "otherwise": true,
          "effects": []
        }
      ],
      "refinement": {
        "states": {
          "ni-live-i": "ni-live"
        },
        "variables": {
          "namedEvaluated": "namedEvaluated",
          "itemsNamed": "itemsNamed",
          "itemsOther": "itemsOther"
        },
        "transitions": {
          "ni-deliver-i": "ni-deliver",
          "ni-no-item-i": "ni-no-item"
        }
      },
      "storage": {
        "record": "rec-approval-task",
        "key": "task-id",
        "fields": {
          "namedEvaluated": "named-evaluated",
          "itemsNamed": "items-named",
          "itemsOther": "items-other"
        },
        "creates": true
      }
    },
    {
      "id": "call-step-flow",
      "name": "External call step",
      "subject": "connector-runner",
      "initial": "cs-open",
      "description": "One workflow step that calls an external address. The step writes the call to an outbox in its transaction. The connector runner reads the outbox, so it sees the call only after the transaction commits and never when it aborts.",
      "variables": [
        {
          "name": "calls",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "cs-open",
          "name": "Transaction open"
        },
        {
          "id": "cs-committed",
          "name": "Committed"
        },
        {
          "id": "cs-aborted",
          "name": "Rolled back"
        }
      ],
      "transitions": [
        {
          "id": "cs-call-uncommitted",
          "from": "cs-open",
          "to": "cs-open",
          "on": "cs-runner-poll",
          "description": "Defect: the runner calls before the transaction of the step has committed.",
          "faultOnly": true,
          "effects": [
            {
              "set": "calls",
              "to": "calls + 1"
            },
            {
              "emit": "cs-call-made"
            }
          ]
        },
        {
          "id": "cs-commit-t",
          "from": "cs-open",
          "to": "cs-committed",
          "on": "cs-commit",
          "effects": []
        },
        {
          "id": "cs-abort-t",
          "from": "cs-open",
          "to": "cs-aborted",
          "on": "cs-abort",
          "effects": []
        },
        {
          "id": "cs-call",
          "from": "cs-committed",
          "to": "cs-committed",
          "on": "cs-runner-poll",
          "effects": [
            {
              "set": "calls",
              "to": "calls + 1"
            },
            {
              "emit": "cs-call-made"
            }
          ]
        }
      ]
    },
    {
      "id": "call-step-flow-impl",
      "name": "External call step (implementation)",
      "level": "implementation",
      "subject": "connector-runner",
      "refines": "call-step-flow",
      "description": "One workflow step that calls an external address. The step writes the call to an outbox in its transaction. The connector runner reads the outbox, so it sees the call only after the transaction commits and never when it aborts.",
      "initial": "cs-open-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "calls",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        }
      ],
      "states": [
        {
          "id": "cs-open-i",
          "name": "Transaction open",
          "ignores": [
            "cs-runner-poll"
          ]
        },
        {
          "id": "cs-committed-i",
          "name": "Committed",
          "ignores": [
            "cs-commit",
            "cs-abort"
          ]
        },
        {
          "id": "cs-aborted-i",
          "name": "Rolled back",
          "ignores": [
            "cs-commit",
            "cs-abort",
            "cs-runner-poll"
          ]
        }
      ],
      "transitions": [
        {
          "id": "cs-commit-t-i",
          "from": "cs-open-i",
          "to": "cs-committed-i",
          "on": "cs-commit",
          "otherwise": true,
          "effects": []
        },
        {
          "id": "cs-abort-t-i",
          "from": "cs-open-i",
          "to": "cs-aborted-i",
          "on": "cs-abort",
          "otherwise": true,
          "effects": []
        },
        {
          "id": "cs-call-i",
          "from": "cs-committed-i",
          "to": "cs-committed-i",
          "on": "cs-runner-poll",
          "otherwise": true,
          "effects": [
            {
              "set": "calls",
              "to": "calls + 1"
            },
            {
              "emit": "cs-call-made",
              "to": "outbound-gate"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "cs-open-i": "cs-open",
          "cs-committed-i": "cs-committed",
          "cs-aborted-i": "cs-aborted"
        },
        "variables": {
          "calls": "calls"
        },
        "transitions": {
          "cs-commit-t-i": "cs-commit-t",
          "cs-abort-t-i": "cs-abort-t",
          "cs-call-i": "cs-call"
        }
      },
      "storage": {
        "record": "rec-call-step",
        "key": "step-id",
        "stateValues": {
          "cs-open-i": "open",
          "cs-committed-i": "committed",
          "cs-aborted-i": "aborted"
        },
        "creates": true
      }
    },
    {
      "id": "outbound-call-flow",
      "name": "Outbound call",
      "subject": "outbound-gate",
      "initial": "oc-idle",
      "description": "One outbound call through the outbound gate. The gate judges the address it resolved: a call connects only to a public address, and a redirect is followed only to a public address. Response bytes are counted against the size limit of the connector policy and the call ends when the limit would be passed or after the time of the policy, 30 seconds here; the size is modelled as 1 MiB. A tick is a second.",
      "variables": [
        {
          "name": "connectedNet",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "redirectNet",
          "type": "string",
          "initial": "none"
        },
        {
          "name": "received",
          "type": "number",
          "initial": 0
        },
        {
          "name": "limit",
          "type": "number",
          "initial": 1048576
        }
      ],
      "states": [
        {
          "id": "oc-idle",
          "name": "Not connected"
        },
        {
          "id": "oc-open",
          "name": "Connected"
        },
        {
          "id": "oc-ended",
          "name": "Ended"
        }
      ],
      "transitions": [
        {
          "id": "oc-connect-any-address",
          "from": "oc-idle",
          "to": "oc-open",
          "on": "oc-request",
          "description": "Defect: connects to an address that is not public.",
          "guard": "event.net != 'public'",
          "faultOnly": true,
          "effects": [
            {
              "set": "connectedNet",
              "to": "event.net"
            },
            {
              "emit": "oc-connected"
            }
          ]
        },
        {
          "id": "oc-connect",
          "from": "oc-idle",
          "to": "oc-open",
          "on": "oc-request",
          "guard": "event.net == 'public'",
          "effects": [
            {
              "set": "connectedNet",
              "to": "event.net"
            },
            {
              "emit": "oc-connected"
            },
            {
              "emit": "oc-timeout",
              "after": 30
            }
          ]
        },
        {
          "id": "oc-refuse-address",
          "from": "oc-idle",
          "to": "oc-idle",
          "on": "oc-request",
          "effects": [
            {
              "emit": "oc-refused"
            }
          ]
        },
        {
          "id": "oc-follow-any-redirect",
          "from": "oc-open",
          "to": "oc-open",
          "on": "oc-redirect",
          "description": "Defect: follows a redirect to an address that is not public.",
          "guard": "event.net != 'public'",
          "faultOnly": true,
          "effects": [
            {
              "set": "redirectNet",
              "to": "event.net"
            }
          ]
        },
        {
          "id": "oc-follow-redirect",
          "from": "oc-open",
          "to": "oc-open",
          "on": "oc-redirect",
          "guard": "event.net == 'public'",
          "effects": [
            {
              "set": "redirectNet",
              "to": "event.net"
            }
          ]
        },
        {
          "id": "oc-refuse-redirect",
          "from": "oc-open",
          "to": "oc-ended",
          "on": "oc-redirect",
          "effects": [
            {
              "emit": "oc-refused"
            }
          ]
        },
        {
          "id": "oc-accept-oversize",
          "from": "oc-open",
          "to": "oc-open",
          "on": "oc-chunk",
          "description": "Defect: keeps reading past the size limit.",
          "guard": "received + event.bytes > limit",
          "faultOnly": true,
          "effects": [
            {
              "set": "received",
              "to": "received + event.bytes"
            }
          ]
        },
        {
          "id": "oc-receive",
          "from": "oc-open",
          "to": "oc-open",
          "on": "oc-chunk",
          "guard": "received + event.bytes <= limit",
          "effects": [
            {
              "set": "received",
              "to": "received + event.bytes"
            }
          ]
        },
        {
          "id": "oc-end-oversize",
          "from": "oc-open",
          "to": "oc-ended",
          "on": "oc-chunk",
          "effects": [
            {
              "emit": "oc-ended-size"
            }
          ]
        },
        {
          "id": "oc-end-timeout",
          "from": "oc-open",
          "to": "oc-ended",
          "on": "oc-timeout",
          "effects": [
            {
              "emit": "oc-ended-time"
            }
          ]
        }
      ]
    },
    {
      "id": "outbound-call-flow-impl",
      "name": "Outbound call (implementation)",
      "level": "implementation",
      "subject": "outbound-gate",
      "refines": "outbound-call-flow",
      "description": "One outbound call at the outbound gate (rec-outbound-call). The address the gate resolved is judged once, and only a public address is connected to or followed through a redirect; a private, link-local or loopback address is refused. Response bytes are counted against the size limit of the connector policy (1048576 bytes); a chunk that would pass it, or the end of the 30 second call time, ends the call. Times are in milliseconds.",
      "initial": "oc-idle-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "connectedNet",
          "type": "string",
          "initial": "none",
          "repr": "string"
        },
        {
          "name": "redirectNet",
          "type": "string",
          "initial": "none",
          "repr": "string"
        },
        {
          "name": "received",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "limit",
          "type": "number",
          "initial": 1048576,
          "repr": "u64"
        }
      ],
      "states": [
        {
          "id": "oc-idle-i",
          "name": "Not connected",
          "ignores": [
            "oc-redirect",
            "oc-chunk",
            "oc-timeout"
          ]
        },
        {
          "id": "oc-open-i",
          "name": "Connected",
          "ignores": [
            "oc-request"
          ]
        },
        {
          "id": "oc-ended-i",
          "name": "Ended",
          "ignores": [
            "oc-request",
            "oc-redirect",
            "oc-chunk",
            "oc-timeout"
          ]
        }
      ],
      "transitions": [
        {
          "id": "oc-connect-i",
          "from": "oc-idle-i",
          "to": "oc-open-i",
          "on": "oc-request",
          "guard": "event.net == 'public'",
          "effects": [
            {
              "set": "connectedNet",
              "to": "event.net"
            },
            {
              "emit": "oc-connected",
              "to": "outbound-gate"
            },
            {
              "emit": "oc-timeout",
              "after": 30000,
              "to": "outbound-gate"
            }
          ]
        },
        {
          "id": "oc-refuse-address-i",
          "from": "oc-idle-i",
          "to": "oc-idle-i",
          "on": "oc-request",
          "otherwise": true,
          "effects": [
            {
              "emit": "oc-refused",
              "to": "outbound-gate"
            }
          ]
        },
        {
          "id": "oc-follow-redirect-i",
          "from": "oc-open-i",
          "to": "oc-open-i",
          "on": "oc-redirect",
          "guard": "event.net == 'public'",
          "effects": [
            {
              "set": "redirectNet",
              "to": "event.net"
            }
          ]
        },
        {
          "id": "oc-refuse-redirect-i",
          "from": "oc-open-i",
          "to": "oc-ended-i",
          "on": "oc-redirect",
          "otherwise": true,
          "effects": [
            {
              "emit": "oc-refused",
              "to": "outbound-gate"
            }
          ]
        },
        {
          "id": "oc-receive-i",
          "from": "oc-open-i",
          "to": "oc-open-i",
          "on": "oc-chunk",
          "guard": "received + event.bytes <= limit",
          "effects": [
            {
              "set": "received",
              "to": "received + event.bytes"
            }
          ]
        },
        {
          "id": "oc-end-oversize-i",
          "from": "oc-open-i",
          "to": "oc-ended-i",
          "on": "oc-chunk",
          "otherwise": true,
          "effects": [
            {
              "emit": "oc-ended-size",
              "to": "outbound-gate"
            }
          ]
        },
        {
          "id": "oc-end-timeout-i",
          "from": "oc-open-i",
          "to": "oc-ended-i",
          "on": "oc-timeout",
          "otherwise": true,
          "effects": [
            {
              "emit": "oc-ended-time",
              "to": "outbound-gate"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "oc-idle-i": "oc-idle",
          "oc-open-i": "oc-open",
          "oc-ended-i": "oc-ended"
        },
        "variables": {
          "connectedNet": "connectedNet",
          "redirectNet": "redirectNet",
          "received": "received",
          "limit": "limit"
        },
        "transitions": {
          "oc-connect-i": "oc-connect",
          "oc-refuse-address-i": "oc-refuse-address",
          "oc-follow-redirect-i": "oc-follow-redirect",
          "oc-refuse-redirect-i": "oc-refuse-redirect",
          "oc-receive-i": "oc-receive",
          "oc-end-oversize-i": "oc-end-oversize",
          "oc-end-timeout-i": "oc-end-timeout"
        },
        "timeScale": 1000
      },
      "storage": {
        "record": "rec-outbound-call",
        "key": "call-id",
        "fields": {
          "connectedNet": "connected-net",
          "redirectNet": "redirect-net"
        },
        "stateValues": {
          "oc-idle-i": "idle",
          "oc-open-i": "open",
          "oc-ended-i": "ended"
        },
        "creates": true
      }
    },
    {
      "id": "webhook-delivery-flow",
      "name": "Outbound webhook delivery",
      "subject": "automation-worker",
      "initial": "wh-live",
      "description": "The deliveries of one subscription. Each attempt is signed with the secret of the subscription it goes to and is written to the delivery log in the same step; the response status is logged when the response arrives. A server error is retried after 5 seconds, up to three attempts. A tick is a second.",
      "variables": [
        {
          "name": "target",
          "type": "string",
          "initial": ""
        },
        {
          "name": "signedBy",
          "type": "string",
          "initial": ""
        },
        {
          "name": "attempts",
          "type": "number",
          "initial": 0
        },
        {
          "name": "logAttempts",
          "type": "number",
          "initial": 0
        },
        {
          "name": "lastStatus",
          "type": "number",
          "initial": 0
        },
        {
          "name": "logStatus",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "wh-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "wh-send-unsigned",
          "from": "wh-live",
          "to": "wh-live",
          "on": "wh-send",
          "description": "Defect: posts the body without a signature.",
          "faultOnly": true,
          "effects": [
            {
              "set": "target",
              "to": "event.subscription"
            },
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "logAttempts",
              "to": "logAttempts + 1"
            },
            {
              "set": "signedBy",
              "to": "''"
            },
            {
              "emit": "wh-posted"
            }
          ]
        },
        {
          "id": "wh-send-unlogged",
          "from": "wh-live",
          "to": "wh-live",
          "on": "wh-send",
          "description": "Defect: posts the attempt without writing it to the delivery log.",
          "faultOnly": true,
          "effects": [
            {
              "set": "target",
              "to": "event.subscription"
            },
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "signedBy",
              "to": "event.subscription"
            },
            {
              "emit": "wh-posted"
            }
          ]
        },
        {
          "id": "wh-send-t",
          "from": "wh-live",
          "to": "wh-live",
          "on": "wh-send",
          "effects": [
            {
              "set": "target",
              "to": "event.subscription"
            },
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "logAttempts",
              "to": "logAttempts + 1"
            },
            {
              "set": "signedBy",
              "to": "event.subscription"
            },
            {
              "emit": "wh-posted"
            }
          ]
        },
        {
          "id": "wh-respond-unlogged",
          "from": "wh-live",
          "to": "wh-live",
          "on": "wh-response",
          "description": "Defect: the response status is not written to the delivery log.",
          "faultOnly": true,
          "effects": [
            {
              "set": "lastStatus",
              "to": "event.status"
            }
          ]
        },
        {
          "id": "wh-respond-retry",
          "from": "wh-live",
          "to": "wh-live",
          "on": "wh-response",
          "guard": "event.status >= 500 && attempts < 3",
          "effects": [
            {
              "set": "lastStatus",
              "to": "event.status"
            },
            {
              "set": "logStatus",
              "to": "event.status"
            },
            {
              "emit": "wh-send",
              "after": 5,
              "payload": {
                "subscription": "target"
              }
            }
          ]
        },
        {
          "id": "wh-respond",
          "from": "wh-live",
          "to": "wh-live",
          "on": "wh-response",
          "effects": [
            {
              "set": "lastStatus",
              "to": "event.status"
            },
            {
              "set": "logStatus",
              "to": "event.status"
            }
          ]
        }
      ]
    },
    {
      "id": "webhook-delivery-flow-impl",
      "name": "Outbound webhook delivery (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "webhook-delivery-flow",
      "description": "The outbound webhook deliveries of the automation worker (rec-webhook-delivery). An attempt records the secret that signed it, which is the secret of the subscription it goes to, and the attempt count in the log; a response records its status in the log, and a server error schedules another attempt 5 seconds later, up to three. Times are in milliseconds.",
      "initial": "wh-live-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "target",
          "type": "string",
          "initial": "",
          "repr": "string"
        },
        {
          "name": "signedBy",
          "type": "string",
          "initial": "",
          "repr": "string"
        },
        {
          "name": "attempts",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "logAttempts",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "lastStatus",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "logStatus",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        }
      ],
      "states": [
        {
          "id": "wh-live-i",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "wh-send-t-i",
          "from": "wh-live-i",
          "to": "wh-live-i",
          "on": "wh-send",
          "otherwise": true,
          "effects": [
            {
              "set": "target",
              "to": "event.subscription"
            },
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "logAttempts",
              "to": "logAttempts + 1"
            },
            {
              "set": "signedBy",
              "to": "event.subscription"
            },
            {
              "emit": "wh-posted",
              "to": "external-endpoint"
            }
          ]
        },
        {
          "id": "wh-respond-retry-i",
          "from": "wh-live-i",
          "to": "wh-live-i",
          "on": "wh-response",
          "guard": "event.status >= 500 && attempts < 3",
          "effects": [
            {
              "set": "lastStatus",
              "to": "event.status"
            },
            {
              "set": "logStatus",
              "to": "event.status"
            },
            {
              "emit": "wh-send",
              "after": 5000,
              "payload": {
                "subscription": "target"
              },
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "wh-respond-i",
          "from": "wh-live-i",
          "to": "wh-live-i",
          "on": "wh-response",
          "otherwise": true,
          "effects": [
            {
              "set": "lastStatus",
              "to": "event.status"
            },
            {
              "set": "logStatus",
              "to": "event.status"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "wh-live-i": "wh-live"
        },
        "variables": {
          "target": "target",
          "signedBy": "signedBy",
          "attempts": "attempts",
          "logAttempts": "logAttempts",
          "lastStatus": "lastStatus",
          "logStatus": "logStatus"
        },
        "transitions": {
          "wh-send-t-i": "wh-send-t",
          "wh-respond-retry-i": "wh-respond-retry",
          "wh-respond-i": "wh-respond"
        },
        "timeScale": 1000
      },
      "storage": {
        "record": "rec-webhook-delivery",
        "key": "delivery-id",
        "fields": {
          "signedBy": "signed-by",
          "logAttempts": "log-attempts",
          "lastStatus": "last-status",
          "logStatus": "log-status"
        },
        "creates": true
      }
    },
    {
      "id": "scheduled-publication-flow",
      "name": "Scheduled publication",
      "subject": "automation-worker",
      "initial": "sp-draft",
      "description": "One content record that is published 8 ticks after it is saved. Saving the record creates a job; the record is published by that job when it runs at or after the time, and by nothing else. A tick is a second.",
      "variables": [
        {
          "name": "publishAt",
          "type": "number",
          "initial": 0
        },
        {
          "name": "jobRuns",
          "type": "number",
          "initial": 0
        },
        {
          "name": "publishedAt",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "sp-draft",
          "name": "Draft"
        },
        {
          "id": "sp-scheduled",
          "name": "Scheduled"
        },
        {
          "id": "sp-published",
          "name": "Published"
        }
      ],
      "transitions": [
        {
          "id": "sp-publish-at-save",
          "from": "sp-draft",
          "to": "sp-published",
          "on": "sp-save",
          "description": "Defect: publishes the record when it is saved, not by a job.",
          "faultOnly": true,
          "effects": [
            {
              "set": "publishedAt",
              "to": "time"
            },
            {
              "emit": "sp-record-published"
            }
          ]
        },
        {
          "id": "sp-schedule",
          "from": "sp-draft",
          "to": "sp-scheduled",
          "on": "sp-save",
          "effects": [
            {
              "set": "publishAt",
              "to": "time + 8"
            }
          ]
        },
        {
          "id": "sp-publish",
          "from": "sp-scheduled",
          "to": "sp-published",
          "on": "sp-job-run",
          "guard": "time >= publishAt",
          "effects": [
            {
              "set": "jobRuns",
              "to": "jobRuns + 1"
            },
            {
              "set": "publishedAt",
              "to": "time"
            },
            {
              "emit": "sp-record-published"
            }
          ]
        },
        {
          "id": "sp-job-early",
          "from": "sp-scheduled",
          "to": "sp-scheduled",
          "on": "sp-job-run",
          "effects": []
        }
      ]
    },
    {
      "id": "scheduled-publication-flow-impl",
      "name": "Scheduled publication (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "scheduled-publication-flow",
      "description": "One content record with a publication time (rec-scheduled-publication). Saving it with a publication time schedules a job; the record becomes published when that job runs at or after the publication time, and not otherwise. Times are in milliseconds.",
      "initial": "sp-draft-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "publishAt",
          "type": "number",
          "initial": 0,
          "repr": "timestamp"
        },
        {
          "name": "jobRuns",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "publishedAt",
          "type": "number",
          "initial": 0,
          "repr": "timestamp"
        }
      ],
      "states": [
        {
          "id": "sp-draft-i",
          "name": "Draft",
          "ignores": [
            "sp-job-run"
          ]
        },
        {
          "id": "sp-scheduled-i",
          "name": "Scheduled",
          "ignores": [
            "sp-save"
          ]
        },
        {
          "id": "sp-published-i",
          "name": "Published",
          "ignores": [
            "sp-save",
            "sp-job-run"
          ]
        }
      ],
      "transitions": [
        {
          "id": "sp-schedule-i",
          "from": "sp-draft-i",
          "to": "sp-scheduled-i",
          "on": "sp-save",
          "otherwise": true,
          "effects": [
            {
              "set": "publishAt",
              "to": "time + 8000"
            }
          ]
        },
        {
          "id": "sp-publish-i",
          "from": "sp-scheduled-i",
          "to": "sp-published-i",
          "on": "sp-job-run",
          "guard": "time >= publishAt",
          "effects": [
            {
              "set": "jobRuns",
              "to": "jobRuns + 1"
            },
            {
              "set": "publishedAt",
              "to": "time"
            },
            {
              "emit": "sp-record-published",
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "sp-job-early-i",
          "from": "sp-scheduled-i",
          "to": "sp-scheduled-i",
          "on": "sp-job-run",
          "otherwise": true,
          "effects": []
        }
      ],
      "refinement": {
        "states": {
          "sp-draft-i": "sp-draft",
          "sp-scheduled-i": "sp-scheduled",
          "sp-published-i": "sp-published"
        },
        "variables": {
          "publishAt": "publishAt / 1000",
          "jobRuns": "jobRuns",
          "publishedAt": "publishedAt / 1000"
        },
        "transitions": {
          "sp-schedule-i": "sp-schedule",
          "sp-publish-i": "sp-publish",
          "sp-job-early-i": "sp-job-early"
        },
        "timeScale": 1000
      },
      "storage": {
        "record": "rec-scheduled-publication",
        "key": "record-id",
        "fields": {
          "publishAt": "publish-at",
          "jobRuns": "job-runs",
          "publishedAt": "published-at"
        },
        "stateValues": {
          "sp-draft-i": "draft",
          "sp-scheduled-i": "scheduled",
          "sp-published-i": "published"
        },
        "creates": true
      }
    },
    {
      "id": "inbound-signature-flow",
      "name": "Inbound webhook signature",
      "subject": "automation-worker",
      "initial": "is-live",
      "description": "The inbound webhook of one endpoint. A delivery carries the result of checking its signature against the secret of the endpoint; a delivery whose signature does not match starts no run.",
      "variables": [
        {
          "name": "runs",
          "type": "number",
          "initial": 0
        },
        {
          "name": "rejected",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "is-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "is-start-forged",
          "from": "is-live",
          "to": "is-live",
          "on": "is-received",
          "description": "Defect: starts a run for a delivery whose signature does not match.",
          "guard": "!event.valid",
          "faultOnly": true,
          "effects": [
            {
              "set": "runs",
              "to": "runs + 1"
            },
            {
              "emit": "is-run-started"
            }
          ]
        },
        {
          "id": "is-start",
          "from": "is-live",
          "to": "is-live",
          "on": "is-received",
          "guard": "event.valid",
          "effects": [
            {
              "set": "runs",
              "to": "runs + 1"
            },
            {
              "emit": "is-run-started"
            }
          ]
        },
        {
          "id": "is-reject",
          "from": "is-live",
          "to": "is-live",
          "on": "is-received",
          "effects": [
            {
              "set": "rejected",
              "to": "rejected + 1"
            },
            {
              "emit": "is-rejected"
            }
          ]
        }
      ]
    },
    {
      "id": "inbound-signature-flow-impl",
      "name": "Inbound webhook signature (implementation)",
      "level": "implementation",
      "subject": "automation-worker",
      "refines": "inbound-signature-flow",
      "description": "The inbound webhook of one endpoint. A delivery carries the result of checking its signature against the secret of the endpoint; a delivery whose signature does not match starts no run.",
      "initial": "is-live-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "runs",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "rejected",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        }
      ],
      "states": [
        {
          "id": "is-live-i",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "is-start-i",
          "from": "is-live-i",
          "to": "is-live-i",
          "on": "is-received",
          "guard": "event.valid",
          "effects": [
            {
              "set": "runs",
              "to": "runs + 1"
            },
            {
              "emit": "is-run-started",
              "to": "automation-worker"
            }
          ]
        },
        {
          "id": "is-reject-i",
          "from": "is-live-i",
          "to": "is-live-i",
          "on": "is-received",
          "otherwise": true,
          "effects": [
            {
              "set": "rejected",
              "to": "rejected + 1"
            },
            {
              "emit": "is-rejected",
              "to": "external-endpoint"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "is-live-i": "is-live"
        },
        "variables": {
          "runs": "runs",
          "rejected": "rejected"
        },
        "transitions": {
          "is-start-i": "is-start",
          "is-reject-i": "is-reject"
        }
      },
      "storage": {
        "record": "rec-inbound-delivery",
        "key": "delivery-id",
        "creates": true
      }
    },
    {
      "id": "mail-enqueue-flow",
      "name": "Mail job of a change",
      "subject": "mail-dispatcher",
      "initial": "me-live",
      "description": "One tenant whose changes request mail. Committing a change creates its mail job in the same step; a change whose transaction rolls back creates none.",
      "variables": [
        {
          "name": "committed",
          "type": "number",
          "initial": 0
        },
        {
          "name": "jobs",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "me-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "me-commit-split",
          "from": "me-live",
          "to": "me-live",
          "on": "me-commit",
          "description": "Defect: creates the mail job in a step after the commit.",
          "faultOnly": true,
          "effects": [
            {
              "set": "committed",
              "to": "committed + 1"
            },
            {
              "emit": "me-create-job",
              "after": 1
            }
          ]
        },
        {
          "id": "me-commit-t",
          "from": "me-live",
          "to": "me-live",
          "on": "me-commit",
          "effects": [
            {
              "set": "committed",
              "to": "committed + 1"
            },
            {
              "set": "jobs",
              "to": "jobs + 1"
            },
            {
              "emit": "me-job-created"
            }
          ]
        },
        {
          "id": "me-abort-enqueues",
          "from": "me-live",
          "to": "me-live",
          "on": "me-abort",
          "description": "Defect: creates the mail job before the outcome of the transaction is known.",
          "faultOnly": true,
          "effects": [
            {
              "set": "jobs",
              "to": "jobs + 1"
            }
          ]
        },
        {
          "id": "me-abort-t",
          "from": "me-live",
          "to": "me-live",
          "on": "me-abort",
          "effects": []
        },
        {
          "id": "me-create-job-late",
          "from": "me-live",
          "to": "me-live",
          "on": "me-create-job",
          "effects": [
            {
              "set": "jobs",
              "to": "jobs + 1"
            },
            {
              "emit": "me-job-created"
            }
          ]
        }
      ]
    },
    {
      "id": "mail-enqueue-flow-impl",
      "name": "Mail job of a change (implementation)",
      "level": "implementation",
      "subject": "mail-dispatcher",
      "refines": "mail-enqueue-flow",
      "description": "One tenant whose changes request mail. Committing a change creates its mail job in the same step; a change whose transaction rolls back creates none.",
      "initial": "me-live-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "committed",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "jobs",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        }
      ],
      "states": [
        {
          "id": "me-live-i",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "me-commit-t-i",
          "from": "me-live-i",
          "to": "me-live-i",
          "on": "me-commit",
          "otherwise": true,
          "effects": [
            {
              "set": "committed",
              "to": "committed + 1"
            },
            {
              "set": "jobs",
              "to": "jobs + 1"
            },
            {
              "emit": "me-job-created",
              "to": "mail-dispatcher"
            }
          ]
        },
        {
          "id": "me-abort-t-i",
          "from": "me-live-i",
          "to": "me-live-i",
          "on": "me-abort",
          "otherwise": true,
          "effects": []
        }
      ],
      "refinement": {
        "states": {
          "me-live-i": "me-live"
        },
        "variables": {
          "committed": "committed",
          "jobs": "jobs"
        },
        "transitions": {
          "me-commit-t-i": "me-commit-t",
          "me-abort-t-i": "me-abort-t"
        }
      },
      "storage": {
        "record": "rec-mail-request",
        "key": "change-id",
        "creates": true
      }
    },
    {
      "id": "mail-attempt-flow",
      "name": "Mail attempt",
      "subject": "mail-dispatcher",
      "initial": "mt-queued",
      "description": "One queued message. Each attempt reads the credential of the mail provider from the key service before it submits. A message that carries a sign-in link is discarded unsent when its link has expired by the time of the attempt. The provider then accepts the message, refuses it temporarily, which leaves it queued, or refuses it permanently, which records it as failed with the reason and ends its attempts.",
      "variables": [
        {
          "name": "attempts",
          "type": "number",
          "initial": 0
        },
        {
          "name": "credentialReads",
          "type": "number",
          "initial": 0
        },
        {
          "name": "failReason",
          "type": "string",
          "initial": ""
        },
        {
          "name": "attemptsAtFail",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "mt-queued",
          "name": "Queued"
        },
        {
          "id": "mt-sent",
          "name": "Sent"
        },
        {
          "id": "mt-failed",
          "name": "Failed"
        },
        {
          "id": "mt-discarded",
          "name": "Discarded"
        }
      ],
      "transitions": [
        {
          "id": "mt-send-expired-link",
          "from": "mt-queued",
          "to": "mt-sent",
          "on": "mt-attempt",
          "description": "Defect: sends a message whose sign-in link has expired.",
          "guard": "event.link && time > event.expiresAt",
          "faultOnly": true,
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "credentialReads",
              "to": "credentialReads + 1"
            },
            {
              "emit": "mt-message-sent"
            }
          ]
        },
        {
          "id": "mt-discard-expired-link",
          "from": "mt-queued",
          "to": "mt-discarded",
          "on": "mt-attempt",
          "guard": "event.link && time > event.expiresAt",
          "effects": [
            {
              "emit": "mt-message-discarded"
            }
          ]
        },
        {
          "id": "mt-submit-cached-credential",
          "from": "mt-queued",
          "to": "mt-sent",
          "on": "mt-attempt",
          "description": "Defect: submits with a credential kept from an earlier attempt, without reading the key service.",
          "guard": "event.result == 'accepted'",
          "faultOnly": true,
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "emit": "mt-message-sent"
            }
          ]
        },
        {
          "id": "mt-accepted",
          "from": "mt-queued",
          "to": "mt-sent",
          "on": "mt-attempt",
          "guard": "event.result == 'accepted'",
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "credentialReads",
              "to": "credentialReads + 1"
            },
            {
              "emit": "mt-credential-read"
            },
            {
              "emit": "mt-message-sent"
            }
          ]
        },
        {
          "id": "mt-temporary-fails",
          "from": "mt-queued",
          "to": "mt-failed",
          "on": "mt-attempt",
          "description": "Defect: a temporary refusal records the message as failed.",
          "guard": "event.result == 'temporary'",
          "faultOnly": true,
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "credentialReads",
              "to": "credentialReads + 1"
            },
            {
              "set": "failReason",
              "to": "event.result"
            },
            {
              "set": "attemptsAtFail",
              "to": "attempts"
            },
            {
              "emit": "mt-message-failed"
            }
          ]
        },
        {
          "id": "mt-temporary",
          "from": "mt-queued",
          "to": "mt-queued",
          "on": "mt-attempt",
          "guard": "event.result == 'temporary'",
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "credentialReads",
              "to": "credentialReads + 1"
            },
            {
              "emit": "mt-credential-read"
            }
          ]
        },
        {
          "id": "mt-permanent-without-reason",
          "from": "mt-queued",
          "to": "mt-failed",
          "on": "mt-attempt",
          "description": "Defect: a permanent refusal records the message as failed without its reason.",
          "guard": "event.result == 'permanent'",
          "faultOnly": true,
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "credentialReads",
              "to": "credentialReads + 1"
            },
            {
              "set": "attemptsAtFail",
              "to": "attempts"
            },
            {
              "emit": "mt-message-failed"
            }
          ]
        },
        {
          "id": "mt-permanent",
          "from": "mt-queued",
          "to": "mt-failed",
          "on": "mt-attempt",
          "guard": "event.result == 'permanent'",
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "credentialReads",
              "to": "credentialReads + 1"
            },
            {
              "set": "failReason",
              "to": "event.reason"
            },
            {
              "set": "attemptsAtFail",
              "to": "attempts"
            },
            {
              "emit": "mt-credential-read"
            },
            {
              "emit": "mt-message-failed"
            }
          ]
        },
        {
          "id": "mt-attempt-after-failure",
          "from": "mt-failed",
          "to": "mt-failed",
          "on": "mt-attempt",
          "description": "Defect: a message recorded as failed is attempted again.",
          "faultOnly": true,
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "credentialReads",
              "to": "credentialReads + 1"
            }
          ]
        }
      ]
    },
    {
      "id": "mail-attempt-flow-impl",
      "name": "Mail attempt (implementation)",
      "level": "implementation",
      "subject": "mail-dispatcher",
      "refines": "mail-attempt-flow",
      "description": "One message of the mail outbox (rec-mail-message, keyed by message-id) at an attempt. The attempt reads the credential from the key service, submits the message and counts the attempt. When the message carries a sign-in link and the time of the attempt is past the expiry of the link, the message is discarded and nothing is submitted. A temporary refusal leaves the message queued, a permanent one records it as failed with the reason given by the provider, and a message that is sent, failed or discarded takes no further attempt. Times are those of the link expiry, in milliseconds.",
      "initial": "mt-queued-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "attempts",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "credentialReads",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "failReason",
          "type": "string",
          "initial": "",
          "repr": "string"
        },
        {
          "name": "attemptsAtFail",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        }
      ],
      "states": [
        {
          "id": "mt-queued-i",
          "name": "Queued"
        },
        {
          "id": "mt-sent-i",
          "name": "Sent",
          "ignores": [
            "mt-attempt"
          ]
        },
        {
          "id": "mt-failed-i",
          "name": "Failed",
          "ignores": [
            "mt-attempt"
          ]
        },
        {
          "id": "mt-discarded-i",
          "name": "Discarded",
          "ignores": [
            "mt-attempt"
          ]
        }
      ],
      "transitions": [
        {
          "id": "mt-discard-expired-link-i",
          "from": "mt-queued-i",
          "to": "mt-discarded-i",
          "on": "mt-attempt",
          "guard": "event.link && time > event.expiresAt",
          "effects": [
            {
              "emit": "mt-message-discarded",
              "to": "mail-dispatcher"
            }
          ]
        },
        {
          "id": "mt-accepted-i",
          "from": "mt-queued-i",
          "to": "mt-sent-i",
          "on": "mt-attempt",
          "guard": "event.result == 'accepted'",
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "credentialReads",
              "to": "credentialReads + 1"
            },
            {
              "emit": "mt-credential-read",
              "to": "key-service"
            },
            {
              "emit": "mt-message-sent",
              "to": "mail-dispatcher"
            }
          ]
        },
        {
          "id": "mt-temporary-i",
          "from": "mt-queued-i",
          "to": "mt-queued-i",
          "on": "mt-attempt",
          "guard": "event.result == 'temporary'",
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "credentialReads",
              "to": "credentialReads + 1"
            },
            {
              "emit": "mt-credential-read",
              "to": "key-service"
            }
          ]
        },
        {
          "id": "mt-permanent-i",
          "from": "mt-queued-i",
          "to": "mt-failed-i",
          "on": "mt-attempt",
          "guard": "event.result == 'permanent'",
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "credentialReads",
              "to": "credentialReads + 1"
            },
            {
              "set": "failReason",
              "to": "event.reason"
            },
            {
              "set": "attemptsAtFail",
              "to": "attempts"
            },
            {
              "emit": "mt-credential-read",
              "to": "key-service"
            },
            {
              "emit": "mt-message-failed",
              "to": "mail-dispatcher"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "mt-queued-i": "mt-queued",
          "mt-sent-i": "mt-sent",
          "mt-failed-i": "mt-failed",
          "mt-discarded-i": "mt-discarded"
        },
        "variables": {
          "attempts": "attempts",
          "credentialReads": "credentialReads",
          "failReason": "failReason",
          "attemptsAtFail": "attemptsAtFail"
        },
        "transitions": {
          "mt-discard-expired-link-i": "mt-discard-expired-link",
          "mt-accepted-i": "mt-accepted",
          "mt-temporary-i": "mt-temporary",
          "mt-permanent-i": "mt-permanent"
        }
      },
      "storage": {
        "record": "rec-mail-message",
        "key": "message-id",
        "fields": {
          "credentialReads": "credential-reads",
          "failReason": "fail-reason",
          "attemptsAtFail": "attempts-at-fail"
        },
        "stateValues": {
          "mt-queued-i": "queued",
          "mt-sent-i": "sent",
          "mt-failed-i": "failed",
          "mt-discarded-i": "discarded"
        }
      }
    },
    {
      "id": "mail-quota-flow",
      "name": "Mail quota",
      "subject": "mail-dispatcher",
      "initial": "mq-live",
      "description": "The release of mail by the dispatcher for two tenants, a and b, each with a quota of two bulk messages. A message beyond the quota of its tenant is held. Sign-in mail is never held, and a tenant within its quota is not held because another tenant exceeded its own.",
      "variables": [
        {
          "name": "quota",
          "type": "number",
          "initial": 2
        },
        {
          "name": "usedA",
          "type": "number",
          "initial": 0
        },
        {
          "name": "usedB",
          "type": "number",
          "initial": 0
        },
        {
          "name": "heldA",
          "type": "number",
          "initial": 0
        },
        {
          "name": "heldB",
          "type": "number",
          "initial": 0
        },
        {
          "name": "signins",
          "type": "number",
          "initial": 0
        },
        {
          "name": "signinsSent",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "mq-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "mq-hold-signin",
          "from": "mq-live",
          "to": "mq-live",
          "on": "mq-release",
          "description": "Defect: holds sign-in mail while a tenant is over its quota.",
          "guard": "event.signin && usedA >= quota",
          "faultOnly": true,
          "effects": [
            {
              "set": "signins",
              "to": "signins + 1"
            },
            {
              "emit": "mq-held"
            }
          ]
        },
        {
          "id": "mq-hold-within-quota",
          "from": "mq-live",
          "to": "mq-live",
          "on": "mq-release",
          "description": "Defect: holds the mail of a tenant within its quota because another tenant is over its own.",
          "guard": "!event.signin && event.tenant == 'b' && usedA >= quota",
          "faultOnly": true,
          "effects": [
            {
              "set": "heldB",
              "to": "heldB + 1"
            },
            {
              "emit": "mq-held"
            }
          ]
        },
        {
          "id": "mq-send-over-quota",
          "from": "mq-live",
          "to": "mq-live",
          "on": "mq-release",
          "description": "Defect: releases mail beyond the quota of its tenant.",
          "guard": "!event.signin && event.tenant == 'a' && usedA >= quota",
          "faultOnly": true,
          "effects": [
            {
              "set": "usedA",
              "to": "usedA + 1"
            },
            {
              "emit": "mq-sent"
            }
          ]
        },
        {
          "id": "mq-send-signin",
          "from": "mq-live",
          "to": "mq-live",
          "on": "mq-release",
          "guard": "event.signin",
          "effects": [
            {
              "set": "signins",
              "to": "signins + 1"
            },
            {
              "set": "signinsSent",
              "to": "signinsSent + 1"
            },
            {
              "emit": "mq-sent"
            }
          ]
        },
        {
          "id": "mq-send-a",
          "from": "mq-live",
          "to": "mq-live",
          "on": "mq-release",
          "guard": "event.tenant == 'a' && usedA < quota",
          "effects": [
            {
              "set": "usedA",
              "to": "usedA + 1"
            },
            {
              "emit": "mq-sent"
            }
          ]
        },
        {
          "id": "mq-send-b",
          "from": "mq-live",
          "to": "mq-live",
          "on": "mq-release",
          "guard": "event.tenant == 'b' && usedB < quota",
          "effects": [
            {
              "set": "usedB",
              "to": "usedB + 1"
            },
            {
              "emit": "mq-sent"
            }
          ]
        },
        {
          "id": "mq-hold-a",
          "from": "mq-live",
          "to": "mq-live",
          "on": "mq-release",
          "guard": "event.tenant == 'a'",
          "effects": [
            {
              "set": "heldA",
              "to": "heldA + 1"
            },
            {
              "emit": "mq-held"
            }
          ]
        },
        {
          "id": "mq-hold-b",
          "from": "mq-live",
          "to": "mq-live",
          "on": "mq-release",
          "effects": [
            {
              "set": "heldB",
              "to": "heldB + 1"
            },
            {
              "emit": "mq-held"
            }
          ]
        }
      ]
    },
    {
      "id": "mail-quota-flow-impl",
      "name": "Mail quota (implementation)",
      "level": "implementation",
      "subject": "mail-dispatcher",
      "refines": "mail-quota-flow",
      "description": "The release of mail by the dispatcher for two tenants, a and b, each with a quota of two bulk messages. A message beyond the quota of its tenant is held. Sign-in mail is never held, and a tenant within its quota is not held because another tenant exceeded its own.",
      "initial": "mq-live-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "quota",
          "type": "number",
          "initial": 2,
          "repr": "u32"
        },
        {
          "name": "usedA",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "usedB",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "heldA",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "heldB",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "signins",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "signinsSent",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        }
      ],
      "states": [
        {
          "id": "mq-live-i",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "mq-send-signin-i",
          "from": "mq-live-i",
          "to": "mq-live-i",
          "on": "mq-release",
          "guard": "event.signin",
          "effects": [
            {
              "set": "signins",
              "to": "signins + 1"
            },
            {
              "set": "signinsSent",
              "to": "signinsSent + 1"
            },
            {
              "emit": "mq-sent",
              "to": "mail-dispatcher"
            }
          ]
        },
        {
          "id": "mq-send-a-i",
          "from": "mq-live-i",
          "to": "mq-live-i",
          "on": "mq-release",
          "guard": "event.tenant == 'a' && usedA < quota",
          "effects": [
            {
              "set": "usedA",
              "to": "usedA + 1"
            },
            {
              "emit": "mq-sent",
              "to": "mail-dispatcher"
            }
          ]
        },
        {
          "id": "mq-send-b-i",
          "from": "mq-live-i",
          "to": "mq-live-i",
          "on": "mq-release",
          "guard": "event.tenant == 'b' && usedB < quota",
          "effects": [
            {
              "set": "usedB",
              "to": "usedB + 1"
            },
            {
              "emit": "mq-sent",
              "to": "mail-dispatcher"
            }
          ]
        },
        {
          "id": "mq-hold-a-i",
          "from": "mq-live-i",
          "to": "mq-live-i",
          "on": "mq-release",
          "guard": "event.tenant == 'a'",
          "effects": [
            {
              "set": "heldA",
              "to": "heldA + 1"
            },
            {
              "emit": "mq-held",
              "to": "mail-dispatcher"
            }
          ]
        },
        {
          "id": "mq-hold-b-i",
          "from": "mq-live-i",
          "to": "mq-live-i",
          "on": "mq-release",
          "otherwise": true,
          "effects": [
            {
              "set": "heldB",
              "to": "heldB + 1"
            },
            {
              "emit": "mq-held",
              "to": "mail-dispatcher"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "mq-live-i": "mq-live"
        },
        "variables": {
          "quota": "quota",
          "usedA": "usedA",
          "usedB": "usedB",
          "heldA": "heldA",
          "heldB": "heldB",
          "signins": "signins",
          "signinsSent": "signinsSent"
        },
        "transitions": {
          "mq-send-signin-i": "mq-send-signin",
          "mq-send-a-i": "mq-send-a",
          "mq-send-b-i": "mq-send-b",
          "mq-hold-a-i": "mq-hold-a",
          "mq-hold-b-i": "mq-hold-b"
        }
      },
      "storage": {
        "record": "rec-mail-quota",
        "key": "tenant-id",
        "fields": {
          "usedA": "used-a",
          "usedB": "used-b",
          "heldA": "held-a",
          "heldB": "held-b",
          "signinsSent": "signins-sent"
        },
        "creates": true
      }
    },
    {
      "id": "mail-provider-flow",
      "name": "Mail provider selection",
      "subject": "mail-dispatcher",
      "initial": "mp-live",
      "description": "The dispatcher sends through the provider that the configuration names at the moment of the send. A change of the configured provider takes effect on the next send, with no restart and so no new image.",
      "variables": [
        {
          "name": "configured",
          "type": "string",
          "initial": "provider-1"
        },
        {
          "name": "startupProvider",
          "type": "string",
          "initial": "provider-1"
        },
        {
          "name": "usedProvider",
          "type": "string",
          "initial": ""
        },
        {
          "name": "configuredAtSend",
          "type": "string",
          "initial": ""
        },
        {
          "name": "sends",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "mp-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "mp-send-startup-provider",
          "from": "mp-live",
          "to": "mp-live",
          "on": "mp-send",
          "description": "Defect: the provider is fixed when the process starts, so a change needs a restart or a new image.",
          "faultOnly": true,
          "effects": [
            {
              "set": "sends",
              "to": "sends + 1"
            },
            {
              "set": "usedProvider",
              "to": "startupProvider"
            },
            {
              "set": "configuredAtSend",
              "to": "configured"
            },
            {
              "emit": "mp-posted"
            }
          ]
        },
        {
          "id": "mp-send-t",
          "from": "mp-live",
          "to": "mp-live",
          "on": "mp-send",
          "effects": [
            {
              "set": "sends",
              "to": "sends + 1"
            },
            {
              "set": "usedProvider",
              "to": "configured"
            },
            {
              "set": "configuredAtSend",
              "to": "configured"
            },
            {
              "emit": "mp-posted"
            }
          ]
        },
        {
          "id": "mp-configure-t",
          "from": "mp-live",
          "to": "mp-live",
          "on": "mp-configure",
          "effects": [
            {
              "set": "configured",
              "to": "event.provider"
            }
          ]
        }
      ]
    },
    {
      "id": "mail-provider-flow-impl",
      "name": "Mail provider selection (implementation)",
      "level": "implementation",
      "subject": "mail-dispatcher",
      "refines": "mail-provider-flow",
      "description": "The dispatcher sends through the provider that the configuration names at the moment of the send. A change of the configured provider takes effect on the next send, with no restart and so no new image.",
      "initial": "mp-live-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "configured",
          "type": "string",
          "initial": "provider-1",
          "repr": "string"
        },
        {
          "name": "startupProvider",
          "type": "string",
          "initial": "provider-1",
          "repr": "string"
        },
        {
          "name": "usedProvider",
          "type": "string",
          "initial": "",
          "repr": "string"
        },
        {
          "name": "configuredAtSend",
          "type": "string",
          "initial": "",
          "repr": "string"
        },
        {
          "name": "sends",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        }
      ],
      "states": [
        {
          "id": "mp-live-i",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "mp-send-t-i",
          "from": "mp-live-i",
          "to": "mp-live-i",
          "on": "mp-send",
          "otherwise": true,
          "effects": [
            {
              "set": "sends",
              "to": "sends + 1"
            },
            {
              "set": "usedProvider",
              "to": "configured"
            },
            {
              "set": "configuredAtSend",
              "to": "configured"
            },
            {
              "emit": "mp-posted",
              "to": "mail-service"
            }
          ]
        },
        {
          "id": "mp-configure-t-i",
          "from": "mp-live-i",
          "to": "mp-live-i",
          "on": "mp-configure",
          "otherwise": true,
          "effects": [
            {
              "set": "configured",
              "to": "event.provider"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "mp-live-i": "mp-live"
        },
        "variables": {
          "configured": "configured",
          "startupProvider": "startupProvider",
          "usedProvider": "usedProvider",
          "configuredAtSend": "configuredAtSend",
          "sends": "sends"
        },
        "transitions": {
          "mp-send-t-i": "mp-send-t",
          "mp-configure-t-i": "mp-configure-t"
        }
      },
      "storage": {
        "record": "rec-mail-provider-use",
        "key": "use-id",
        "fields": {
          "startupProvider": "startup-provider",
          "usedProvider": "used-provider",
          "configuredAtSend": "configured-at-send"
        },
        "creates": true
      }
    },
    {
      "id": "mail-log-read-flow",
      "name": "Mail log read",
      "subject": "mail-dispatcher",
      "initial": "mr-live",
      "description": "A read of the mail log. The read carries the decision of the policies of the tenant on the principal who asks. A permitted read returns the state of the message; a read that is not permitted is refused and returns none.",
      "variables": [
        {
          "name": "returned",
          "type": "number",
          "initial": 0
        },
        {
          "name": "denied",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "mr-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "mr-return-to-unpermitted",
          "from": "mr-live",
          "to": "mr-live",
          "on": "mr-read",
          "description": "Defect: returns the state of a message to a principal the policies do not permit.",
          "guard": "!event.permitted",
          "faultOnly": true,
          "effects": [
            {
              "set": "returned",
              "to": "returned + 1"
            },
            {
              "emit": "mr-state-returned"
            }
          ]
        },
        {
          "id": "mr-return",
          "from": "mr-live",
          "to": "mr-live",
          "on": "mr-read",
          "guard": "event.permitted",
          "effects": [
            {
              "set": "returned",
              "to": "returned + 1"
            },
            {
              "emit": "mr-state-returned"
            }
          ]
        },
        {
          "id": "mr-deny",
          "from": "mr-live",
          "to": "mr-live",
          "on": "mr-read",
          "effects": [
            {
              "set": "denied",
              "to": "denied + 1"
            },
            {
              "emit": "mr-denied"
            }
          ]
        }
      ]
    },
    {
      "id": "mail-log-read-flow-impl",
      "name": "Mail log read (implementation)",
      "level": "implementation",
      "subject": "mail-dispatcher",
      "refines": "mail-log-read-flow",
      "description": "A read of the mail log. The read carries the decision of the policies of the tenant on the principal who asks. A permitted read returns the state of the message; a read that is not permitted is refused and returns none.",
      "initial": "mr-live-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "returned",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "denied",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        }
      ],
      "states": [
        {
          "id": "mr-live-i",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "mr-return-i",
          "from": "mr-live-i",
          "to": "mr-live-i",
          "on": "mr-read",
          "guard": "event.permitted",
          "effects": [
            {
              "set": "returned",
              "to": "returned + 1"
            },
            {
              "emit": "mr-state-returned",
              "to": "mail-dispatcher"
            }
          ]
        },
        {
          "id": "mr-deny-i",
          "from": "mr-live-i",
          "to": "mr-live-i",
          "on": "mr-read",
          "otherwise": true,
          "effects": [
            {
              "set": "denied",
              "to": "denied + 1"
            },
            {
              "emit": "mr-denied",
              "to": "mail-dispatcher"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "mr-live-i": "mr-live"
        },
        "variables": {
          "returned": "returned",
          "denied": "denied"
        },
        "transitions": {
          "mr-return-i": "mr-return",
          "mr-deny-i": "mr-deny"
        }
      },
      "storage": {
        "record": "rec-mail-log-read",
        "key": "read-id",
        "creates": true
      }
    },
    {
      "id": "sender-domain-flow",
      "name": "Sender domain",
      "subject": "mail-dispatcher",
      "initial": "sd-pending",
      "description": "One tenant sending mail. Until the tenant proves control of a domain, its mail goes from an address of the platform that names the tenant and is signed with the key of the platform. After the proof, its mail goes from an address on the domain and is signed with a key published under that domain.",
      "variables": [
        {
          "name": "lastFrom",
          "type": "string",
          "initial": ""
        },
        {
          "name": "lastSignedBy",
          "type": "string",
          "initial": ""
        }
      ],
      "states": [
        {
          "id": "sd-pending",
          "name": "Domain not proved"
        },
        {
          "id": "sd-proved",
          "name": "Domain proved"
        }
      ],
      "transitions": [
        {
          "id": "sd-prove",
          "from": "sd-pending",
          "to": "sd-proved",
          "on": "sd-verify",
          "guard": "event.dnsOk",
          "effects": []
        },
        {
          "id": "sd-proof-missing",
          "from": "sd-pending",
          "to": "sd-pending",
          "on": "sd-verify",
          "effects": []
        },
        {
          "id": "sd-send-unproved-from-domain",
          "from": "sd-pending",
          "to": "sd-pending",
          "on": "sd-send",
          "description": "Defect: sends from the domain of the tenant before the tenant proved control of it.",
          "faultOnly": true,
          "effects": [
            {
              "set": "lastFrom",
              "to": "'tenant-domain'"
            },
            {
              "set": "lastSignedBy",
              "to": "'tenant-key'"
            },
            {
              "emit": "sd-sent-tenant"
            }
          ]
        },
        {
          "id": "sd-send-from-platform",
          "from": "sd-pending",
          "to": "sd-pending",
          "on": "sd-send",
          "effects": [
            {
              "set": "lastFrom",
              "to": "'platform'"
            },
            {
              "set": "lastSignedBy",
              "to": "'platform-key'"
            },
            {
              "emit": "sd-sent-platform"
            }
          ]
        },
        {
          "id": "sd-send-unsigned",
          "from": "sd-proved",
          "to": "sd-proved",
          "on": "sd-send",
          "description": "Defect: sends from the tenant domain without the signature of its key.",
          "faultOnly": true,
          "effects": [
            {
              "set": "lastFrom",
              "to": "'tenant-domain'"
            },
            {
              "set": "lastSignedBy",
              "to": "''"
            },
            {
              "emit": "sd-sent-tenant"
            }
          ]
        },
        {
          "id": "sd-send-from-domain",
          "from": "sd-proved",
          "to": "sd-proved",
          "on": "sd-send",
          "effects": [
            {
              "set": "lastFrom",
              "to": "'tenant-domain'"
            },
            {
              "set": "lastSignedBy",
              "to": "'tenant-key'"
            },
            {
              "emit": "sd-sent-tenant"
            }
          ]
        }
      ]
    },
    {
      "id": "sender-domain-flow-impl",
      "name": "Sender domain (implementation)",
      "level": "implementation",
      "subject": "mail-dispatcher",
      "refines": "sender-domain-flow",
      "description": "One tenant sending mail. Until the tenant proves control of a domain, its mail goes from an address of the platform that names the tenant and is signed with the key of the platform. After the proof, its mail goes from an address on the domain and is signed with a key published under that domain.",
      "initial": "sd-pending-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "lastFrom",
          "type": "string",
          "initial": "",
          "repr": "string"
        },
        {
          "name": "lastSignedBy",
          "type": "string",
          "initial": "",
          "repr": "string"
        }
      ],
      "states": [
        {
          "id": "sd-pending-i",
          "name": "Domain not proved"
        },
        {
          "id": "sd-proved-i",
          "name": "Domain proved",
          "ignores": [
            "sd-verify"
          ]
        }
      ],
      "transitions": [
        {
          "id": "sd-prove-i",
          "from": "sd-pending-i",
          "to": "sd-proved-i",
          "on": "sd-verify",
          "guard": "event.dnsOk",
          "effects": []
        },
        {
          "id": "sd-proof-missing-i",
          "from": "sd-pending-i",
          "to": "sd-pending-i",
          "on": "sd-verify",
          "otherwise": true,
          "effects": []
        },
        {
          "id": "sd-send-from-platform-i",
          "from": "sd-pending-i",
          "to": "sd-pending-i",
          "on": "sd-send",
          "otherwise": true,
          "effects": [
            {
              "set": "lastFrom",
              "to": "'platform'"
            },
            {
              "set": "lastSignedBy",
              "to": "'platform-key'"
            },
            {
              "emit": "sd-sent-platform",
              "to": "mail-dispatcher"
            }
          ]
        },
        {
          "id": "sd-send-from-domain-i",
          "from": "sd-proved-i",
          "to": "sd-proved-i",
          "on": "sd-send",
          "otherwise": true,
          "effects": [
            {
              "set": "lastFrom",
              "to": "'tenant-domain'"
            },
            {
              "set": "lastSignedBy",
              "to": "'tenant-key'"
            },
            {
              "emit": "sd-sent-tenant",
              "to": "mail-dispatcher"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "sd-pending-i": "sd-pending",
          "sd-proved-i": "sd-proved"
        },
        "variables": {
          "lastFrom": "lastFrom",
          "lastSignedBy": "lastSignedBy"
        },
        "transitions": {
          "sd-prove-i": "sd-prove",
          "sd-proof-missing-i": "sd-proof-missing",
          "sd-send-from-platform-i": "sd-send-from-platform",
          "sd-send-from-domain-i": "sd-send-from-domain"
        }
      },
      "storage": {
        "record": "rec-sender-domain",
        "key": "domain",
        "fields": {
          "lastFrom": "last-from",
          "lastSignedBy": "last-signed-by"
        },
        "stateValues": {
          "sd-pending-i": "pending",
          "sd-proved-i": "proved"
        }
      }
    },
    {
      "id": "mail-render-flow",
      "name": "Mail rendering",
      "subject": "runtime",
      "initial": "rd-live",
      "description": "The rendering of one message from its structured blocks. Every message gets an HTML part and a plain text part, and the text of the tenant in the blocks is escaped, so no tenant markup reaches a mail client.",
      "variables": [
        {
          "name": "messages",
          "type": "number",
          "initial": 0
        },
        {
          "name": "htmlParts",
          "type": "number",
          "initial": 0
        },
        {
          "name": "textParts",
          "type": "number",
          "initial": 0
        },
        {
          "name": "rawMarkup",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "rd-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "rd-render-html-only",
          "from": "rd-live",
          "to": "rd-live",
          "on": "rd-render",
          "description": "Defect: renders an HTML part and no plain text part.",
          "faultOnly": true,
          "effects": [
            {
              "set": "messages",
              "to": "messages + 1"
            },
            {
              "set": "htmlParts",
              "to": "htmlParts + 1"
            },
            {
              "emit": "rd-rendered"
            }
          ]
        },
        {
          "id": "rd-render-unescaped",
          "from": "rd-live",
          "to": "rd-live",
          "on": "rd-render",
          "description": "Defect: passes the markup of a tenant through to the HTML part.",
          "guard": "event.hasMarkup",
          "faultOnly": true,
          "effects": [
            {
              "set": "messages",
              "to": "messages + 1"
            },
            {
              "set": "htmlParts",
              "to": "htmlParts + 1"
            },
            {
              "set": "textParts",
              "to": "textParts + 1"
            },
            {
              "set": "rawMarkup",
              "to": "rawMarkup + 1"
            },
            {
              "emit": "rd-rendered"
            }
          ]
        },
        {
          "id": "rd-render-t",
          "from": "rd-live",
          "to": "rd-live",
          "on": "rd-render",
          "effects": [
            {
              "set": "messages",
              "to": "messages + 1"
            },
            {
              "set": "htmlParts",
              "to": "htmlParts + 1"
            },
            {
              "set": "textParts",
              "to": "textParts + 1"
            },
            {
              "emit": "rd-rendered"
            }
          ]
        }
      ]
    },
    {
      "id": "mail-render-flow-impl",
      "name": "Mail rendering (implementation)",
      "level": "implementation",
      "subject": "runtime",
      "refines": "mail-render-flow",
      "description": "The rendering of one message from its structured blocks. Every message gets an HTML part and a plain text part, and the text of the tenant in the blocks is escaped, so no tenant markup reaches a mail client.",
      "initial": "rd-live-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "messages",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "htmlParts",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "textParts",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "rawMarkup",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        }
      ],
      "states": [
        {
          "id": "rd-live-i",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "rd-render-t-i",
          "from": "rd-live-i",
          "to": "rd-live-i",
          "on": "rd-render",
          "otherwise": true,
          "effects": [
            {
              "set": "messages",
              "to": "messages + 1"
            },
            {
              "set": "htmlParts",
              "to": "htmlParts + 1"
            },
            {
              "set": "textParts",
              "to": "textParts + 1"
            },
            {
              "emit": "rd-rendered",
              "to": "runtime"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "rd-live-i": "rd-live"
        },
        "variables": {
          "messages": "messages",
          "htmlParts": "htmlParts",
          "textParts": "textParts",
          "rawMarkup": "rawMarkup"
        },
        "transitions": {
          "rd-render-t-i": "rd-render-t"
        }
      },
      "storage": {
        "record": "rec-mail-render",
        "key": "render-id",
        "fields": {
          "htmlParts": "html-parts",
          "textParts": "text-parts",
          "rawMarkup": "raw-markup"
        },
        "creates": true
      }
    },
    {
      "id": "delivery-report-flow",
      "name": "Delivery report",
      "subject": "mail-dispatcher",
      "initial": "dr-live",
      "description": "The reports of the mail provider. A report is accepted only when its signature is the one of the provider the deployment is configured for. An accepted report of a permanent bounce or a complaint adds the address to the suppression list of the tenant; other accepted reports add nothing.",
      "variables": [
        {
          "name": "accepted",
          "type": "number",
          "initial": 0
        },
        {
          "name": "mustSuppress",
          "type": "number",
          "initial": 0
        },
        {
          "name": "suppressed",
          "type": "number",
          "initial": 0
        },
        {
          "name": "rejected",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "dr-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "dr-accept-forged",
          "from": "dr-live",
          "to": "dr-live",
          "on": "dr-report",
          "description": "Defect: acts on a report whose signature is not the provider signature.",
          "guard": "!event.valid && (event.kind == 'bounce-permanent' || event.kind == 'complaint')",
          "faultOnly": true,
          "effects": [
            {
              "set": "suppressed",
              "to": "suppressed + 1"
            },
            {
              "emit": "dr-suppressed"
            }
          ]
        },
        {
          "id": "dr-ignore-complaint",
          "from": "dr-live",
          "to": "dr-live",
          "on": "dr-report",
          "description": "Defect: a complaint does not add the address to the suppression list.",
          "guard": "event.valid && event.kind == 'complaint'",
          "faultOnly": true,
          "effects": [
            {
              "set": "accepted",
              "to": "accepted + 1"
            },
            {
              "set": "mustSuppress",
              "to": "mustSuppress + 1"
            }
          ]
        },
        {
          "id": "dr-suppress",
          "from": "dr-live",
          "to": "dr-live",
          "on": "dr-report",
          "guard": "event.valid && (event.kind == 'bounce-permanent' || event.kind == 'complaint')",
          "effects": [
            {
              "set": "accepted",
              "to": "accepted + 1"
            },
            {
              "set": "mustSuppress",
              "to": "mustSuppress + 1"
            },
            {
              "set": "suppressed",
              "to": "suppressed + 1"
            },
            {
              "emit": "dr-suppressed"
            }
          ]
        },
        {
          "id": "dr-note",
          "from": "dr-live",
          "to": "dr-live",
          "on": "dr-report",
          "guard": "event.valid",
          "effects": [
            {
              "set": "accepted",
              "to": "accepted + 1"
            }
          ]
        },
        {
          "id": "dr-reject",
          "from": "dr-live",
          "to": "dr-live",
          "on": "dr-report",
          "effects": [
            {
              "set": "rejected",
              "to": "rejected + 1"
            },
            {
              "emit": "dr-rejected"
            }
          ]
        }
      ]
    },
    {
      "id": "delivery-report-flow-impl",
      "name": "Delivery report (implementation)",
      "level": "implementation",
      "subject": "mail-dispatcher",
      "refines": "delivery-report-flow",
      "description": "The reports of the mail provider. A report is accepted only when its signature is the one of the provider the deployment is configured for. An accepted report of a permanent bounce or a complaint adds the address to the suppression list of the tenant; other accepted reports add nothing.",
      "initial": "dr-live-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "accepted",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "mustSuppress",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "suppressed",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        },
        {
          "name": "rejected",
          "type": "number",
          "initial": 0,
          "repr": "u32"
        }
      ],
      "states": [
        {
          "id": "dr-live-i",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "dr-suppress-i",
          "from": "dr-live-i",
          "to": "dr-live-i",
          "on": "dr-report",
          "guard": "event.valid && (event.kind == 'bounce-permanent' || event.kind == 'complaint')",
          "effects": [
            {
              "set": "accepted",
              "to": "accepted + 1"
            },
            {
              "set": "mustSuppress",
              "to": "mustSuppress + 1"
            },
            {
              "set": "suppressed",
              "to": "suppressed + 1"
            },
            {
              "emit": "dr-suppressed",
              "to": "mail-dispatcher"
            }
          ]
        },
        {
          "id": "dr-note-i",
          "from": "dr-live-i",
          "to": "dr-live-i",
          "on": "dr-report",
          "guard": "event.valid",
          "effects": [
            {
              "set": "accepted",
              "to": "accepted + 1"
            }
          ]
        },
        {
          "id": "dr-reject-i",
          "from": "dr-live-i",
          "to": "dr-live-i",
          "on": "dr-report",
          "otherwise": true,
          "effects": [
            {
              "set": "rejected",
              "to": "rejected + 1"
            },
            {
              "emit": "dr-rejected",
              "to": "mail-dispatcher"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "dr-live-i": "dr-live"
        },
        "variables": {
          "accepted": "accepted",
          "mustSuppress": "mustSuppress",
          "suppressed": "suppressed",
          "rejected": "rejected"
        },
        "transitions": {
          "dr-suppress-i": "dr-suppress",
          "dr-note-i": "dr-note",
          "dr-reject-i": "dr-reject"
        }
      },
      "storage": {
        "record": "rec-delivery-report",
        "key": "report-id",
        "fields": {
          "mustSuppress": "must-suppress"
        },
        "creates": true
      }
    },
    {
      "id": "audience-mail-flow",
      "name": "Audience mail",
      "subject": "mail-dispatcher",
      "initial": "am-live",
      "description": "The mail of a tenant to an audience. Each such message carries an unsubscribe header and a link, and following the link unsubscribes the recipient whether or not the recipient is signed in.",
      "variables": [
        {
          "name": "audienceSent",
          "type": "number",
          "initial": 0
        },
        {
          "name": "withUnsubscribe",
          "type": "number",
          "initial": 0
        },
        {
          "name": "unsubscribed",
          "type": "number",
          "initial": 0
        },
        {
          "name": "clicks",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "am-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "am-send-without-header",
          "from": "am-live",
          "to": "am-live",
          "on": "am-send",
          "description": "Defect: audience mail leaves without an unsubscribe header and link.",
          "guard": "event.audience",
          "faultOnly": true,
          "effects": [
            {
              "set": "audienceSent",
              "to": "audienceSent + 1"
            },
            {
              "emit": "am-sent"
            }
          ]
        },
        {
          "id": "am-send-audience",
          "from": "am-live",
          "to": "am-live",
          "on": "am-send",
          "guard": "event.audience",
          "effects": [
            {
              "set": "audienceSent",
              "to": "audienceSent + 1"
            },
            {
              "set": "withUnsubscribe",
              "to": "withUnsubscribe + 1"
            },
            {
              "emit": "am-sent"
            }
          ]
        },
        {
          "id": "am-send-transactional",
          "from": "am-live",
          "to": "am-live",
          "on": "am-send",
          "effects": [
            {
              "emit": "am-sent"
            }
          ]
        },
        {
          "id": "am-click-needs-session",
          "from": "am-live",
          "to": "am-live",
          "on": "am-click",
          "description": "Defect: the unsubscribe link asks for a sign-in first.",
          "guard": "!event.signedIn",
          "faultOnly": true,
          "effects": [
            {
              "set": "clicks",
              "to": "clicks + 1"
            }
          ]
        },
        {
          "id": "am-unsubscribe",
          "from": "am-live",
          "to": "am-live",
          "on": "am-click",
          "effects": [
            {
              "set": "clicks",
              "to": "clicks + 1"
            },
            {
              "set": "unsubscribed",
              "to": "unsubscribed + 1"
            },
            {
              "emit": "am-unsubscribed"
            }
          ]
        }
      ]
    },
    {
      "id": "audience-mail-flow-impl",
      "name": "Audience mail (implementation)",
      "level": "implementation",
      "subject": "mail-dispatcher",
      "refines": "audience-mail-flow",
      "description": "The mail of a tenant to an audience. Each such message carries an unsubscribe header and a link, and following the link unsubscribes the recipient whether or not the recipient is signed in.",
      "initial": "am-live-i",
      "transaction": {
