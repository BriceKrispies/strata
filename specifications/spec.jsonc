    },
    {
      "id": "m-request-after-switch-uses-target",
      "kind": "temporal",
      "models": "mig-586",
      "statement": "A request that begins after the switch uses the target placement while the earlier request completes on the source.",
      "evaluate": {
        "method": "eventually",
        "scenarios": [
