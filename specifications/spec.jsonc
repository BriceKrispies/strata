    {
      "id": "sus-limit-flow",
      "name": "Sign-up limit per source",
      "subject": "identity-service",
      "initial": "sus-open",
      "description": "The sign-up requests from one source. The limit starts at the platform default of 20 within one hour (D-700) and a realm may only tighten it. One model tick is one minute.",
      "variables": [
        {
          "name": "count",
          "type": "number",
          "initial": 0
        },
        {
          "name": "windowStart",
          "type": "number",
          "initial": 0
        },
        {
          "name": "limit",
          "type": "number",
          "initial": 20
        },
        {
          "name": "windowOpen",
          "type": "boolean",
          "initial": false
        }
      ],
      "states": [
        {
          "id": "sus-open",
          "name": "Counting"
        }
      ],
      "transitions": [
        {
          "id": "sus-accept-over",
          "from": "sus-open",
          "to": "sus-open",
          "on": "sus-requested",
          "guard": "count >= limit && windowOpen && windowStart <= time && time - windowStart < 60",
          "effects": [
            {
              "set": "count",
              "to": "count + 1"
            },
            {
              "emit": "sus-accepted"
            }
          ],
          "faultOnly": true,
          "description": "Defect: allows a request over the limit."
        },
        {
          "id": "sus-new-window",
          "from": "sus-open",
          "to": "sus-open",
          "on": "sus-requested",
          "guard": "!(windowOpen && windowStart <= time && time - windowStart < 60)",
          "effects": [
            {
              "set": "windowStart",
              "to": "time"
            },
            {
              "set": "windowOpen",
              "to": true
            },
            {
              "set": "count",
              "to": 1
            },
            {
              "emit": "sus-accepted"
            }
          ]
        },
        {
          "id": "sus-accept",
          "from": "sus-open",
          "to": "sus-open",
          "on": "sus-requested",
          "guard": "count < limit",
          "effects": [
            {
              "set": "count",
              "to": "count + 1"
            },
            {
              "emit": "sus-accepted"
            }
          ]
        },
        {
          "id": "sus-refuse",
          "from": "sus-open",
          "to": "sus-open",
          "on": "sus-requested",
          "effects": [
            {
              "emit": "sus-refused"
            }
          ]
        },
        {
          "id": "sus-tighten",
          "from": "sus-open",
          "to": "sus-open",
          "on": "sus-tightened",
          "guard": "event.limit < limit",
          "effects": [
            {
              "set": "limit",
              "to": "event.limit"
            }
          ]
        }
      ],
      "realisation": "target"
    },
