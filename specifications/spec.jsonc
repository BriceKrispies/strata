    {
      "id": "assemble-view",
      "description": "crates/backend/src/ops.rs view, the decide of contract read-view (CT-264): the tenant (not_found \"no site <tenant>\"), the view whose route matches the path (match-route; not_found \"nothing at <path>\"), every record of the object types it depends on (view-needs) asked for first, then each section in evaluation order (section-order, view-section-step) read from the one snapshot. segments and routes are the path and the routes split (stand-ins of WG-4957).",
      "params": [
        {
          "name": "path",
          "type": "string"
        },
        {
          "name": "request",
          "type": "map<string, string>"
        },
        {
          "name": "context",
          "type": "context"
        },
        {
          "name": "state",
          "type": "state"
        },
        {
          "name": "texts",
          "type": "intent-texts"
        },
        {
          "name": "segments",
          "type": "list<string>"
        },
        {
          "name": "routes",
          "type": "map<view-id, list<route-segment>>"
        }
      ],
      "returns": "view-data",
      "errors": "api-failure",
      "let": [
        {
          "name": "site",
          "expr": "match state.tenant { Some(t) => t, None => fail(api-failure.rejected(api-error{code: error-code.not-found, message: format('no site {}', context.tenant), failed: [], correlation: context.correlation})) }"
        },
        {
          "name": "found",
          "expr": "match call match-route(site.schema, segments, routes) { Some(m) => m, None => fail(api-failure.rejected(api-error{code: error-code.not-found, message: format('nothing at {}', path), failed: [], correlation: context.correlation})) }"
        },
        {
          "name": "depends",
          "expr": "call view-needs(site.schema, found.view)"
        },
        {
          "name": "progress",
          "expr": "match call first-missing(state.coverage, map(o in depends, need.all-of(o))) { Some(n) => fail(api-failure.insufficient-state(n)), None => fold(name in call section-order(found.view), acc = view-progress{done: {}, sections: {}, revision: site.revision}, match get(found.view.sections, name) { None => acc, Some(s) => try call view-section-step(site, state, texts, context, found.params, request, name, s, acc) }) }"
        }
      ],
      "body": "view-data{view: found.view.id, title: found.view.title, params: found.params, sections: progress.sections, depends-on: depends, revision: progress.revision, schema-version: site.schema.version}",
