      "scope": "source-address",
      "contract": "accept-site-invitation",
      "limit": 20,
      "window": "1 h",
      "onExceed": "throttle",
      "heldBy": "limit-store"
    },
    {
      "id": "q-accept-owner-invitation",
      "description": "Anonymous calls of accept-owner-invitation from one source address; the invitation and the realm have their own limits (IDN-1682).",
      "scope": "source-address",
      "contract": "accept-owner-invitation",
      "limit": 100,
      "window": "15 min",
      "onExceed": "refuse",
      "error": "throttled",
      "heldBy": "limit-store"
    },
    {
      "id": "q-sign-in-with-password-burst",
      "description": "Anonymous calls of sign-in-with-password from one source address in one minute: the burst limit that sits beside the fifteen-minute budget of q-sign-in-with-password (IDN-250, D-700, D-7800). The two measure different things, so both are stated.",
      "scope": "source-address",
      "contract": "sign-in-with-password",
      "limit": 30,
      "window": "1 min",
      "onExceed": "refuse",
      "error": "throttled",
      "heldBy": "limit-store"
    },
    {
      "id": "q-run-lab-projection",
      "description": "Calls of run-lab-projection by one signed-in principal: a projection replays the history of the tenant, so it is expensive.",
      "scope": "principal",
      "contract": "run-lab-projection",
      "limit": 10,
      "window": "15 min",
      "onExceed": "refuse",
      "error": "throttled",
      "heldBy": "limit-store"
    },
    {
      "id": "q-verify-lab-proofs",
      "description": "Calls of verify-lab-proofs by one signed-in principal: a verification builds the Lean project.",
      "scope": "principal",
      "contract": "verify-lab-proofs",
      "limit": 5,
      "window": "1 h",
      "onExceed": "refuse",
      "error": "throttled",
      "heldBy": "limit-store"
    },
    {
      "id": "q-issue-access-token",
      "description": "Calls of issue-access-token from one source address: each call checks a client secret with a memory-hard hash.",
      "scope": "source-address",
      "contract": "issue-access-token",
      "limit": 120,
      "window": "1 min",
      "onExceed": "refuse",
      "error": "throttled",
      "heldBy": "limit-store"
    }
  ]
,
