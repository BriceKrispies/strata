          "id": "prov-accept-without-endpoint",
          "from": "prov-open",
          "to": "prov-open",
          "on": "prov-presented",
          "faultOnly": true,
          "guard": "(event.realm == event.tokenRealm) && (event.roleChange != 'direct') && (!(event.endpoint == 'provisioning'))",
          "description": "Defect: accepts although the condition \"is for the provisioning endpoint\" does not hold.",
          "effects": [
            {
              "emit": "prov-accepted"
            }
          ]
        },
        {
          "id": "prov-accept-without-realm",
          "from": "prov-open",
          "to": "prov-open",
          "on": "prov-presented",
          "faultOnly": true,
          "guard": "(event.endpoint == 'provisioning') && (event.roleChange != 'direct') && (!(event.realm == event.tokenRealm))",
          "description": "Defect: accepts although the condition \"is for the realm of the token\" does not hold.",
          "effects": [
            {
              "emit": "prov-accepted"
            }
          ]
        },
        {
          "id": "prov-accept-without-mapping",
          "from": "prov-open",
          "to": "prov-open",
          "on": "prov-presented",
          "faultOnly": true,
          "guard": "(event.endpoint == 'provisioning') && (event.realm == event.tokenRealm) && (!(event.roleChange != 'direct'))",
          "description": "Defect: accepts although the condition \"changes roles only through the group mapping\" does not hold.",
          "effects": [
            {
              "emit": "prov-accepted"
            }
          ]
        },
        {
          "id": "prov-accept",
          "from": "prov-open",
          "to": "prov-open",
          "on": "prov-presented",
          "guard": "(event.endpoint == 'provisioning') && (event.realm == event.tokenRealm) && (event.roleChange != 'direct')",
          "effects": [
            {
              "emit": "prov-accepted"
            }
          ]
        },
        {
          "id": "prov-refuse",
          "from": "prov-open",
          "to": "prov-open",
          "on": "prov-presented",
          "effects": [
            {
              "emit": "prov-refused"
            }
