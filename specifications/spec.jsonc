    {
      "id": "stored",
      "description": "transition.rs stored, for an intent that does action on the record: the stored record (rules.rs Lookup::record); a lookup the snapshot does not cover is InsufficientState. When there is none, the action is authorised on the object type with no record to test (require), so that a caller who could not act on it gets Unauthorized, the same as for a record that exists, and only a caller who could learns UnknownRecord.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "id",
          "type": "record-id"
        },
        {
          "name": "action",
          "type": "action"
        }
      ],
      "returns": "record",
      "errors": "rejection",
      "body": "match found { Some(r) => r, None => fail(call draft-reject(d1.evidence, error-kind.unknown-record, format('no {} {}', object, id))) }",
      "examples": [
        {
          "args": {
            "d": {
              "fixture": "fx-draft-5"
            },
            "object": "note",
            "id": 1,
            "action": "update"
          },
          "result": {
            "id": 1,
            "object": "note",
            "version": 1,
            "created-by": "alpha:writer1",
            "created-at": 5000,
            "updated-at": 5000,
            "fields": {
              "slug": {
                "str": "first"
              },
              "status": {
                "str": "draft"
              },
              "title": {
                "str": "First"
              }
            }
          }
        },
        {
          "description": "behaviour.rs every_rejection_lists_at_least_one_failed_check: unknown record, for an editor, who may update any note and so learns that it is missing.",
          "args": {
            "d": {
              "fixture": "fx-draft-6"
            },
            "object": "note",
            "id": 42,
            "action": "update"
          },
          "error": {
            "rejected": {
              "kind": "unknown-record",
              "message": "no note 42",
              "evidence": [
                {
                  "rule": "policy:editors_manage_notes",
                  "passed": true,
                  "detail": "Update on Object(ObjectTypeId(\"note\"))"
                },
                {
                  "rule": "intent:unknown_record",
                  "passed": false,
                  "detail": "no note 42"
                }
              ],
              "missing": null
            }
          }
        },
        {
          "args": {
            "d": {
              "fixture": "fx-draft-7"
            },
            "object": "note",
            "id": 1,
            "action": "update"
          },
          "error": {
            "rejected": {
              "kind": "insufficient-state",
              "message": "the snapshot does not cover Record { object: ObjectTypeId(\"note\"), id: RecordId(1) }",
              "evidence": [
                {
                  "rule": "coverage",
                  "passed": false,
                  "detail": "Record { object: ObjectTypeId(\"note\"), id: RecordId(1) }"
                }
              ],
              "missing": {
                "record": {
                  "object": "note",
                  "id": 1
                }
              }
            }
          }
        },
        {
          "description": "A caller whose permission needs the record to be tested (writers edit only their own notes) gets Unauthorized for a record that does not exist, as for one that does: only a caller who could act on it learns that it is missing.",
          "args": {
            "d": {
              "fixture": "fx-draft-5"
            },
            "object": "note",
            "id": 42,
            "action": "update"
          },
          "error": {
            "rejected": {
              "kind": "unauthorized",
              "message": "User(PrincipalId(\"alpha:writer1\")) may not Update Object(ObjectTypeId(\"note\"))",
              "evidence": [
                {
                  "rule": "policy:writers_edit_own",
                  "passed": false,
                  "detail": "(record.$created_by == principal) is null"
                }
              ],
              "missing": null
            }
          }
        }
      ],
      "let": [
        {
          "name": "found",
          "expr": "try call lookup-record(d.tenant, d.coverage, object, id)"
        },
        {
          "name": "d1",
          "expr": "match found { Some(_) => d, None => try call require(d, action, resource.object(object), subject{}) }"
        }
      ]
    },
    {
      "id": "create-tenant",
      "description": "transition.rs create_tenant: only the system creates a tenant (policy:builtin_system); a name that is blank after trimming (str::trim().is_empty(), trim(name) == '') is InvalidIntent intent:tenant_has_name; otherwise revision 1 and event 1: the tenant, the genesis schema and the owner holding the owner role.",
      "params": [
        {
          "name": "c",
          "type": "context"
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "owner",
          "type": "principal-id"
        }
      ],
      "returns": "transition-result",
      "errors": "rejection",
      "body": "match c.principal { system => if trim(name) == '' then fail(rejection.rejected(call refuse(error-kind.invalid-intent, 'intent:tenant_has_name', 'a tenant needs a name'))) else transition-result{delta: state-delta{tenant: c.tenant, new-revision: 1, next-record: 1, event-seq: 1, ops: [delta-op.create-tenant{name}, delta-op.put-schema(call genesis-schema()), delta-op.put-member{principal: owner, roles: ['owner']}]}, events: [domain-event{tenant: c.tenant, seq: 1, revision: 1, at: c.now, principal: c.principal, correlation: c.correlation, body: event-body.tenant-created{name}}], effects: [effect.publish{seq: 1}], evidence: [check{rule: 'policy:builtin_system', passed: true, detail: 'CreateTenant'}], output: output.tenant}, _ => fail(rejection.rejected(domain-error{kind: error-kind.unauthorized, message: 'only the system creates tenants', evidence: [check{rule: 'policy:builtin_system', passed: false, detail: 'CreateTenant'}]})) }",
      "examples": [
        {
          "description": "behaviour.rs only_the_system_creates_tenants_and_a_tenant_is_created_once.",
          "args": {
            "c": {
              "tenant": "gamma",
              "principal": "system",
              "session": null,
              "now": 5001,
              "correlation": "test-5001"
            },
            "name": "Gamma",
            "owner": "gamma:owner"
          },
          "result": {
            "delta": {
              "tenant": "gamma",
              "base-revision": null,
              "new-revision": 1,
              "next-record": 1,
              "event-seq": 1,
              "ops": [
                {
                  "create-tenant": {
                    "name": "Gamma"
                  }
                },
                {
                  "put-schema": {
                    "version": 1,
                    "objects": {},
                    "roles": {
                      "owner": {
                        "id": "owner",
                        "label": "Owner"
                      },
                      "public": {
                        "id": "public",
                        "label": "Everyone"
                      }
                    },
                    "policies": {},
                    "workflows": {},
                    "queries": {},
                    "views": {}
                  }
                },
                {
                  "put-member": {
                    "principal": "gamma:owner",
                    "roles": [
                      "owner"
                    ]
                  }
                }
              ]
            },
            "events": [
              {
                "tenant": "gamma",
                "seq": 1,
                "revision": 1,
                "at": 5001,
                "principal": "system",
                "correlation": "test-5001",
                "body": {
                  "tenant-created": {
                    "name": "Gamma"
                  }
                }
              }
            ],
            "effects": [
              {
                "publish": {
                  "seq": 1
                }
              }
            ],
            "evidence": [
              {
                "rule": "policy:builtin_system",
                "passed": true,
                "detail": "CreateTenant"
              }
            ],
            "output": "tenant"
          }
        },
        {
          "description": "behaviour.rs only_the_system_creates_tenants_and_a_tenant_is_created_once: refused to a user, the owner of another tenant.",
          "args": {
            "c": {
              "tenant": "gamma",
              "principal": {
                "user": "alpha:owner"
              },
              "session": null,
              "now": 1,
              "correlation": "test-1"
            },
            "name": "Gamma",
            "owner": "gamma:owner"
          },
          "error": {
            "rejected": {
              "kind": "unauthorized",
              "message": "only the system creates tenants",
              "evidence": [
                {
                  "rule": "policy:builtin_system",
                  "passed": false,
                  "detail": "CreateTenant"
                }
              ],
              "missing": null
            }
          }
        },
        {
          "description": "behaviour.rs every_rejection_lists_at_least_one_failed_check: tenant without a name (\" \").",
          "args": {
            "c": {
              "tenant": "gamma",
              "principal": "system",
              "session": null,
              "now": 5001,
              "correlation": "test-5001"
            },
            "name": " ",
            "owner": "gamma:owner"
          },
          "error": {
            "rejected": {
              "kind": "invalid-intent",
              "message": "a tenant needs a name",
              "evidence": [
                {
                  "rule": "intent:tenant_has_name",
                  "passed": false,
                  "detail": "a tenant needs a name"
                }
              ],
              "missing": null
            }
          }
        }
      ]
    },
    {
      "id": "initial-refusal",
      "description": "transition.rs create_record, a record that does not start in an initial state of a workflow: the failed workflow:<id>:initial check and WorkflowViolation.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "workflow",
          "type": "workflow-def"
        },
        {
          "name": "x",
          "type": "value"
        }
      ],
      "returns": "rejection",
      "body": "call draft-reject(concat(d.evidence, [check{rule: format('workflow:{}:initial', workflow.id), passed: false, detail: format('a new record must start in one of {}', call string-set-debug(workflow.initial))}]), error-kind.workflow-violation, format('{} is not an initial state of {}', call value-debug(x), workflow.id))",
      "examples": [
        {
          "args": {
            "d": {
              "fixture": "fx-draft-8"
            },
            "workflow": {
              "fixture": "fx-workflow-def-2"
            },
            "x": {
              "str": "published"
            }
          },
          "result": {
            "rejected": {
              "kind": "workflow-violation",
              "message": "Str(\"published\") is not an initial state of note_status",
              "evidence": [
                {
                  "rule": "workflow:note_status:initial",
                  "passed": false,
                  "detail": "a new record must start in one of {\"draft\"}"
                }
              ],
              "missing": null
            }
          }
        }
      ]
    },
    {
      "id": "initial-checks",
      "description": "transition.rs create_record, the workflows of the object type (in id order): the field must hold a string that is an initial state (workflow:<id>:initial, \"starts in <state>\").",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "candidate",
          "type": "record"
        }
      ],
      "returns": "draft",
      "errors": "rejection",
      "body": "fold(w in filter(w in values(d.tenant.schema.workflows), w.object == object), acc = d, let x = match get(candidate.fields, w.field) { Some(y) => y, None => call null-value() } in match x { str(s) => if any(i in w.initial, i == s) then draft{tenant: acc.tenant, ctx: acc.ctx, coverage: acc.coverage, ops: acc.ops, events: acc.events, effects: acc.effects, evidence: concat(acc.evidence, [check{rule: format('workflow:{}:initial', w.id), passed: true, detail: format('starts in {}', s)}]), next-record: acc.next-record} else fail(call initial-refusal(acc, w, x)), _ => fail(call initial-refusal(acc, w, x)) })",
      "examples": [
        {
