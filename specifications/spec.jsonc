    {
      "id": "execute-intent",
      "name": "Decide an intent and commit it",
      "ref": "CT-031",
      "realisation": "derived",
      "implementedBy": "store-contract",
      "auth": {
        "scheme": "in-process",
        "description": "Local call inside the platform process; no network credential"
      },
      "idempotent": false,
      "timeoutMs": 300,
      "inputs": [
        {
          "name": "tenant",
          "type": "tenant-id",
          "description": "The tenant to load: the context's."
        },
        {
          "name": "intent",
          "type": "intent"
        },
        {
          "name": "context",
          "type": "context"
        }
      ],
      "outputs": [
        {
          "name": "transition",
          "type": "transition-result"
        },
        {
          "name": "receipt",
          "type": "receipt"
        }
      ],
      "postconditions": [
        "The needs the kernel names are loaded, the intent is decided and the commit is applied atomically (storage-api execute): at most 32 needs beyond the first load are asked for (MAX_NEED_ROUNDS), and a commit that lost a race is decided again on the new state at most 8 times (MAX_CONFLICT_RETRIES).",
        "A state-changing intent is confirmed as committed within 300 ms at the 99th percentile (OPS-334).",
        "The number of retried commits, which storage-api Executed reports as conflicts, is not an output of the derivation."
      ],
      "errors": [
        {
          "name": "domain",
          "condition": "The kernel rejected the intent; the store is unchanged.",
          "type": "domain-error",
          "kind": "invalid"
        },
        {
          "name": "store",
          "condition": "The store failed.",
          "type": "store-error",
          "kind": "unavailable"
        },
        {
          "name": "domain",
          "condition": "The kernel rejected the intent; the store is unchanged. Its HTTP status, where one is served, is error-code-of of its kind.",
          "type": "domain-error",
          "kind": "invalid"
        },
        {
          "name": "insufficient-state",
          "condition": "The decision asked for more needs than needRounds allows, or for one it was already given.",
          "type": "need",
          "kind": "internal"
        },
        {
          "name": "conflict",
          "condition": "Every commit lost its race to another one, retries times over; nothing is changed.",
          "type": "store-error",
          "kind": "conflict"
        },
        {
          "name": "invalid",
          "condition": "The commit is malformed, or its events do not continue the tenant event sequence without a gap; nothing is changed.",
          "type": "store-error",
          "kind": "invalid"
        },
        {
          "name": "unavailable",
          "condition": "The store could not do the work right now (busy, I/O); safe to retry.",
          "type": "store-error",
          "kind": "unavailable"
        },
        {
          "name": "corrupt",
          "condition": "Stored data could not be read back; not safe to ignore.",
          "type": "store-error",
          "kind": "internal"
        },
        {
          "name": "fault",
          "condition": "An integer overflow in the decision (a revision, an event sequence, a version or a record id past its type); never in practice.",
          "kind": "internal"
        }
      ],
      "exposure": "local",
      "derivation": {
        "kind": "command",
        "needs": "header-needs",
        "load": "load-decision-snapshot",
        "decide": "execute-decide",
