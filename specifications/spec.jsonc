    {
      "id": "ledger-period-cap-of",
      "description": "ledger.rs limits_of: a cap per period and its period are one limit: both are set or the limit has none.",
      "params": [
        {
          "name": "l",
          "type": "ledger-limit"
        }
      ],
      "returns": "option<ledger-period-cap>",
      "body": "match l.period-cap { Some(c) => match l.period { Some(p) => ledger-period-cap{cap: c, period: p}, None => null }, None => null }",
      "examples": [
        {
          "args": {
            "l": {
              "unit": "credits",
              "period-cap": 5,
              "period": "day"
            }
          },
          "result": {
            "cap": 5,
            "period": "day"
          }
        },
        {
          "args": {
            "l": {
              "unit": "credits",
              "period-cap": 5
            }
          },
          "result": null
        },
        {
          "args": {
            "l": {
              "unit": "credits",
              "period": "day"
            }
          },
          "result": null
        },
        {
          "args": {
            "l": {
              "unit": "credits"
            }
          },
          "result": null
        }
      ]
    },
    {
      "id": "ledger-limits-of",
      "description": "ledger.rs limits_of: the limits that apply to the account of an owner, unit and scope under a schema: each of the own limits of the account and, for each one the account does not set, the limit of its unit (LDG-012). The limit of the account is the first of the unit with that owner and scope; that of the unit the first with no owner.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "owner",
          "type": "ledger-owner"
        },
        {
          "name": "unit",
          "type": "ledger-unit"
        },
        {
          "name": "scope",
          "type": "string"
        }
      ],
      "returns": "ledger-limits-applying",
      "let": [
        {
          "name": "of-unit",
          "expr": "find(l in call ledger-of(schema).limits, l.unit == unit && l.owner == null)"
        },
        {
          "name": "of-account",
          "expr": "find(l in call ledger-of(schema).limits, l.unit == unit && l.owner == owner && call ledger-scope-text(l.scope) == scope)"
        },
        {
          "name": "acc-floor",
          "expr": "match of-account { Some(a) => a.floor, None => null }"
        },
        {
          "name": "acc-cap",
          "expr": "match of-account { Some(a) => a.cap, None => null }"
        },
        {
          "name": "acc-period",
          "expr": "match of-account { Some(a) => call ledger-period-cap-of(a), None => null }"
        },
        {
          "name": "unit-floor",
          "expr": "match of-unit { Some(u) => u.floor, None => null }"
        },
        {
          "name": "unit-cap",
          "expr": "match of-unit { Some(u) => u.cap, None => null }"
        },
        {
          "name": "unit-period",
          "expr": "match of-unit { Some(u) => call ledger-period-cap-of(u), None => null }"
        }
      ],
      "body": "ledger-limits-applying{floor: if acc-floor != null then acc-floor else unit-floor, cap: if acc-cap != null then acc-cap else unit-cap, period-cap: if acc-period != null then acc-period else unit-period}",
      "examples": [
        {
          "description": "A schema that declares nothing has no limit.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-6"
            },
            "owner": {
              "principal": {
                "principal": "alpha:ed"
              }
            },
            "unit": "credits",
            "scope": ""
          },
          "result": {}
        },
        {
          "description": "The limits of the unit.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-32",
              "with": {
                "ledger.limits": [
                  {
                    "unit": "credits",
                    "floor": 0,
                    "cap": 100,
                    "period-cap": 10,
                    "period": "day"
                  }
                ]
              }
            },
            "owner": {
              "principal": {
                "principal": "alpha:ed"
              }
            },
            "unit": "credits",
            "scope": ""
          },
          "result": {
            "floor": 0,
            "cap": 100,
            "period-cap": {
              "cap": 10,
              "period": "day"
            }
          }
        },
        {
          "description": "The account's cap replaces the unit's, the other limits are the unit's.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-33"
            },
            "owner": {
              "principal": {
                "principal": "alpha:ed"
              }
            },
            "unit": "credits",
            "scope": "promo"
          },
          "result": {
            "floor": 0,
            "cap": 5,
            "period-cap": {
              "cap": 10,
              "period": "day"
            }
          }
        },
        {
          "description": "An account of another scope has only the unit's limits.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-33"
            },
            "owner": {
              "principal": {
                "principal": "alpha:ed"
              }
            },
            "unit": "credits",
            "scope": ""
          },
          "result": {
            "floor": 0,
            "cap": 100,
            "period-cap": {
              "cap": 10,
              "period": "day"
            }
          }
        },
        {
          "description": "An account of another owner has only the unit's limits.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-33"
            },
            "owner": {
              "principal": {
                "principal": "alpha:ob"
              }
            },
            "unit": "credits",
            "scope": "promo"
          },
          "result": {
            "floor": 0,
            "cap": 100,
            "period-cap": {
              "cap": 10,
              "period": "day"
            }
          }
        },
        {
          "description": "A limit of an account with a period but no cap per period leaves the unit's.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-33",
              "with": {
                "ledger.limits.1": {
                  "unit": "credits",
                  "owner": {
                    "principal": {
                      "principal": "alpha:ed"
                    }
                  },
                  "period": "week"
                }
              }
            },
            "owner": {
              "principal": {
                "principal": "alpha:ed"
              }
            },
            "unit": "credits",
            "scope": ""
          },
          "result": {
            "floor": 0,
            "cap": 100,
            "period-cap": {
              "cap": 10,
              "period": "day"
            }
          }
        },
        {
          "description": "The account's period cap replaces the unit's.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-33",
              "with": {
                "ledger.limits.1": {
                  "unit": "credits",
                  "owner": {
                    "principal": {
                      "principal": "alpha:ed"
                    }
                  },
                  "period-cap": 3,
                  "period": "week"
                }
              }
            },
            "owner": {
              "principal": {
                "principal": "alpha:ed"
              }
            },
            "unit": "credits",
            "scope": ""
          },
          "result": {
            "floor": 0,
            "cap": 100,
            "period-cap": {
              "cap": 3,
              "period": "week"
            }
          }
        },
        {
          "description": "The account's floor replaces the unit's.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-33",
              "with": {
                "ledger.limits.1": {
                  "unit": "credits",
                  "owner": {
                    "principal": {
                      "principal": "alpha:ed"
                    }
                  },
                  "floor": -3
                }
              }
            },
            "owner": {
              "principal": {
                "principal": "alpha:ed"
              }
            },
            "unit": "credits",
            "scope": ""
          },
          "result": {
            "floor": -3,
            "cap": 100,
            "period-cap": {
              "cap": 10,
              "period": "day"
            }
          }
        },
        {
          "description": "No limit of the unit: only the account's.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-32",
              "with": {
                "ledger.limits": [
                  {
                    "unit": "credits",
                    "owner": {
                      "principal": {
                        "principal": "alpha:ed"
                      }
                    },
                    "scope": "promo",
                    "cap": 5
                  }
                ]
              }
            },
            "owner": {
              "principal": {
                "principal": "alpha:ed"
              }
            },
            "unit": "credits",
            "scope": "promo"
          },
          "result": {
            "cap": 5
          }
        },
        {
          "description": "A limit of another unit is not read.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-32",
              "with": {
                "ledger.limits": [
                  {
                    "unit": "points",
                    "floor": 1
                  }
                ]
              }
            },
            "owner": {
              "principal": {
                "principal": "alpha:ed"
              }
            },
            "unit": "credits",
            "scope": ""
          },
          "result": {}
        }
      ]
    },
    {
      "id": "mentions-field",
      "description": "schema.rs mentions_field: whether an expression reads a field of a record (a scope read of a name that is not a $ system attribute, or any read through a reference), in any branch, whether it runs or not. Structural recursion: every call of itself is on a field of a variant matched from e, or an item of a list such a field holds (WG-5133).",
      "params": [
        {
          "name": "e",
          "type": "expr"
        }
      ],
      "returns": "bool",
      "body": "match e { var{field: f} => !startsWith(f, '$'), through => true, not(a) => call mentions-field(a), is-null(a) => call mentions-field(a), len(a) => call mentions-field(a), lower(a) => call mentions-field(a), is-slug(a) => call mentions-field(a), text(a) => call mentions-field(a), duration{amount} => call mentions-field(amount), and(items) => any(i in items, call mentions-field(i)), or(items) => any(i in items, call mentions-field(i)), cmp{left, right} => call mentions-field(left) || call mentions-field(right), in{item, list: l} => call mentions-field(item) || call mentions-field(l), contains{haystack, needle} => call mentions-field(haystack) || call mentions-field(needle), starts-with{text: t, prefix} => call mentions-field(t) || call mentions-field(prefix), arith{left, right} => call mentions-field(left) || call mentions-field(right), ms-between{from: a, to: b} => call mentions-field(a) || call mentions-field(b), concat{left, right} => call mentions-field(left) || call mentions-field(right), if{condition: c, then: a, else: b} => call mentions-field(c) || call mentions-field(a) || call mentions-field(b), _ => false }",
      "examples": [
        {
          "description": "A system attribute is not a field.",
          "args": {
            "e": {
              "cmp": {
                "op": "eq",
                "left": {
                  "var": {
                    "scope": "record",
                    "field": "$created_by"
                  }
                },
                "right": "principal"
              }
            }
          },
          "result": false
        },
        {
          "description": "A field read in a branch that never runs is a field read.",
          "args": {
            "e": {
              "if": {
                "condition": {
                  "lit": {
                    "bool": true
                  }
                },
                "then": {
                  "lit": {
                    "bool": true
                  }
                },
                "else": {
                  "cmp": {
                    "op": "eq",
                    "left": {
                      "var": {
                        "scope": "record",
                        "field": "status"
                      }
                    },
                    "right": {
                      "lit": {
                        "str": "x"
                      }
                    }
                  }
                }
              }
            }
          },
          "result": true
        },
        {
          "description": "A read through a reference reads a field.",
          "args": {
            "e": {
              "not": {
                "is-null": {
                  "through": {
                    "scope": "record",
                    "reference": "author",
                    "field": "name"
                  }
                }
              }
            }
          },
          "result": true
        },
        {
          "description": "Deep in an and of an or.",
          "args": {
            "e": {
              "and": [
                {
                  "has-role": "writer"
                },
                {
                  "or": [
                    {
                      "lit": {
                        "bool": false
                      }
                    },
                    {
                      "cmp": {
                        "op": "gt",
                        "left": {
                          "len": {
                            "lower": {
                              "var": {
                                "scope": "record",
                                "field": "title"
                              }
                            }
                          }
                        },
                        "right": {
                          "lit": {
                            "int": 3
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            }
          },
          "result": true
        },
        {
          "description": "Every other operator is walked into, operand by operand: none of these reads a field.",
          "args": {
            "e": {
              "and": [
                {
                  "is-slug": {
                    "lit": {
                      "str": "a"
                    }
                  }
                },
                {
                  "text": {
                    "lit": {
                      "int": 1
                    }
                  }
                },
                {
                  "duration": {
                    "unit": "days",
                    "amount": {
                      "lit": {
                        "int": 1
                      }
                    }
                  }
                },
                {
                  "in": {
                    "item": {
                      "lit": {
                        "int": 1
                      }
                    },
                    "list": {
                      "lit": {
                        "list": []
                      }
                    }
                  }
                },
                {
                  "contains": {
                    "haystack": {
                      "lit": {
                        "str": "ab"
                      }
                    },
                    "needle": {
                      "lit": {
                        "str": "a"
                      }
                    }
                  }
                },
                {
                  "starts-with": {
                    "text": {
                      "lit": {
                        "str": "ab"
                      }
                    },
                    "prefix": {
                      "lit": {
                        "str": "a"
                      }
                    }
                  }
                },
                {
                  "arith": {
                    "op": "add",
                    "left": {
                      "lit": {
                        "int": 1
                      }
                    },
                    "right": {
                      "lit": {
                        "int": 2
                      }
                    }
                  }
                },
                {
                  "ms-between": {
                    "from": "now",
                    "to": "now"
                  }
                },
                {
                  "concat": {
                    "left": {
                      "lit": {
                        "str": "a"
                      }
                    },
                    "right": {
                      "lit": {
                        "str": "b"
                      }
                    }
                  }
                }
              ]
            }
          },
          "result": false
        },
        {
          "description": "A field read as the operand of a concatenation in a duration is found.",
          "args": {
            "e": {
              "duration": {
                "unit": "hours",
                "amount": {
                  "concat": {
                    "left": {
                      "lit": {
                        "str": "a"
                      }
                    },
                    "right": {
                      "var": {
                        "scope": "record",
                        "field": "title"
                      }
                    }
                  }
                }
              }
            }
          },
          "result": true
        },
        {
          "description": "Literals, parameters, now, the principal and role tests read no field.",
          "args": {
            "e": {
              "and": [
                {
                  "has-role": "writer"
                },
                {
                  "cmp": {
                    "op": "eq",
                    "left": {
                      "param": "x"
                    },
                    "right": "now"
                  }
                }
              ]
            }
          },
          "result": false
        }
      ]
    },
    {
      "id": "visible-in",
      "description": "crates/kernel/src/read.rs visible_in: visible with the snapshot's lookup, the decision read makes per row: authorize Read on the record's object type, against the tenant's own schema, with the record as old and new (authorize-needing with the snapshot's coverage), so a Read policy that follows a reference is decided on the record it reaches. A policy that needs a record the snapshot does not cover is InsufficientState naming it, not a denial (WG-5096).",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "coverage",
          "type": "coverage"
        },
        {
          "name": "principal",
          "type": "principal"
        },
        {
          "name": "record",
          "type": "record"
        },
        {
          "name": "now",
          "type": "timestamp"
        }
      ],
      "returns": "bool",
      "errors": "rejection",
      "let": [
        {
          "name": "decision",
          "expr": "call authorize-needing(tenant, tenant.schema, principal, now, action.read, resource.object(record.object), subject{old: record, new: record}, coverage)"
        }
      ],
      "body": "if decision.allowed then true else match decision.needed { Some(n) => fail(rejection.rejected(call insufficient(n))), None => false }",
      "examples": [
        {
          "description": "A published post is visible to anyone.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-1"
            },
            "coverage": "complete",
            "principal": "anonymous",
            "record": {
              "fixture": "fx-record-1"
            },
            "now": 1800000000000
          },
          "result": true
        },
        {
          "description": "A draft is not visible to the public.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-1"
            },
            "coverage": "complete",
            "principal": "anonymous",
            "record": {
              "fixture": "fx-record-2"
            },
            "now": 1800000000000
          },
          "result": false
        },
        {
          "description": "Its author sees her draft (authors_own_posts).",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-1"
            },
            "coverage": "complete",
            "principal": {
              "user": "user:ann"
            },
            "record": {
              "fixture": "fx-record-2"
            },
            "now": 1800000000000
          },
          "result": true
        },
        {
          "description": "Another author does not.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-1"
            },
            "coverage": "complete",
            "principal": {
              "user": "user:bob"
            },
            "record": {
              "fixture": "fx-record-2"
            },
            "now": 1800000000000
          },
          "result": false
        },
        {
          "description": "The owner sees everything.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-1"
            },
            "coverage": "complete",
            "principal": {
              "user": "user:admin"
            },
            "record": {
              "fixture": "fx-record-2"
            },
            "now": 1800000000000
          },
          "result": true
        },
        {
          "description": "The system holds no role, so it sees nothing through policies.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-1"
            },
            "coverage": "complete",
            "principal": "system",
            "record": {
              "fixture": "fx-record-1"
            },
            "now": 1800000000000
          },
          "result": false
        },
        {
          "description": "A Read policy that follows a reference is decided on the record it reaches.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-39"
            },
            "coverage": "complete",
            "principal": "anonymous",
            "record": {
              "id": 2,
              "object": "post",
              "version": 1,
              "created-by": "alpha:writer",
              "created-at": 2000,
              "updated-at": 2000,
              "fields": {
                "author": {
                  "ref": 1
                },
                "status": {
                  "str": "published"
                },
                "title": {
                  "str": "B"
                }
              }
            },
            "now": 3000
          },
          "result": true
        },
        {
          "description": "When the snapshot does not cover that record the answer is InsufficientState naming it, not a denial.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-39"
            },
            "coverage": {
              "partial": []
            },
            "principal": "anonymous",
            "record": {
              "id": 2,
              "object": "post",
              "version": 1,
              "created-by": "alpha:writer",
              "created-at": 2000,
              "updated-at": 2000,
              "fields": {
                "author": {
                  "ref": 1
                },
                "status": {
                  "str": "published"
                },
                "title": {
                  "str": "B"
                }
              }
            },
            "now": 3000
          },
          "error": {
            "rejected": {
              "kind": "insufficient-state",
              "message": "the snapshot does not cover Record { object: ObjectTypeId(\"person\"), id: RecordId(1) }",
              "evidence": [
                {
                  "rule": "coverage",
                  "passed": false,
                  "detail": "Record { object: ObjectTypeId(\"person\"), id: RecordId(1) }"
                }
              ],
              "missing": {
                "record": {
                  "object": "person",
                  "id": 1
                }
              }
            }
          }
        },
        {
          "description": "A record whose reference is empty is not visible under that policy: the hop is null, and nothing is needed.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-39"
            },
            "coverage": {
              "partial": []
            },
            "principal": "anonymous",
            "record": {
              "id": 4,
              "object": "post",
              "version": 1,
              "created-by": "alpha:owner",
              "created-at": 2002,
              "updated-at": 2002,
              "fields": {
                "status": {
                  "str": "published"
                },
                "title": {
                  "str": "C"
                }
              }
            },
            "now": 3000
          },
          "result": false
        }
      ]
    },
    {
      "id": "ledger-refused",
      "description": "ledger.rs refused: a refusal after the checks in evidence, naming the rule that failed: the message is \"<rule>: <message>\" and the failed check is added to the evidence.",
      "params": [
        {
          "name": "evidence",
          "type": "list<check>"
        },
        {
          "name": "kind",
          "type": "error-kind"
        },
        {
          "name": "rule",
          "type": "string"
        },
        {
          "name": "message",
          "type": "string"
        }
      ],
      "returns": "domain-error",
      "body": "domain-error{kind, message: format('{}: {}', rule, message), evidence: concat(evidence, [check{rule, passed: false, detail: message}])}",
      "examples": [
        {
          "args": {
            "evidence": [
              {
                "rule": "ledger:unit",
                "passed": true,
                "detail": "unit credits is declared"
              }
            ],
            "kind": "invalid-intent",
            "rule": "ledger:invalid-amount",
            "message": "not 0"
          },
          "result": {
            "kind": "invalid-intent",
            "message": "ledger:invalid-amount: not 0",
            "evidence": [
              {
                "rule": "ledger:unit",
                "passed": true,
                "detail": "unit credits is declared"
              },
              {
                "rule": "ledger:invalid-amount",
                "passed": false,
                "detail": "not 0"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "ledger-posting-precheck",
      "description": "ledger.rs post_after, the checks a posting makes before it reads its account (WG-5170): the unit is declared (ledger:unit, else UnknownRecord ledger:unknown-unit), the owner is a member or a declared pool (ledger:owner, else UnknownRecord ledger:unknown-owner), the amount is a whole number from -(2^53-1) to 2^53-1 other than 0 (ledger:invalid-amount), the idempotency key is 1 to 128 bytes and does not start with expiry: (ledger:invalid-key), the reason is at most 256 bytes (ledger:invalid-reason) and the scope at most 128 bytes (ledger:invalid-scope). The evidence given is extended with the checks that passed; a failed check refuses with them. What follows, the account (named by a uuid derived from the SHA-256 of the tenant, owner, unit and scope), is not stated here.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "evidence",
          "type": "list<check>"
        },
        {
          "name": "request",
          "type": "ledger-posting-request"
        }
      ],
      "returns": "list<check>",
      "errors": "rejection",
      "let": [
        {
          "name": "decl",
          "expr": "call ledger-of(tenant.schema)"
        },
        {
          "name": "key",
          "expr": "request.idempotency-key"
        },
        {
          "name": "a",
          "expr": "request.amount"
        }
      ],
      "body": "if get(decl.units, request.unit) == null then fail(rejection.rejected(call ledger-refused(evidence, error-kind.unknown-record, 'ledger:unknown-unit', format('the tenant declares no ledger unit {}', request.unit)))) else let e1 = concat(evidence, [check{rule: 'ledger:unit', passed: true, detail: format('unit {} is declared', request.unit)}]) in let owner-problem = match request.owner { principal{principal: p} => if get(tenant.members, p) == null then format('the tenant has no principal {}', p) else '', pool{pool: q} => if get(decl.pools, q) == null then format('the tenant declares no ledger pool {}', q) else '' } in if owner-problem != '' then fail(rejection.rejected(call ledger-refused(e1, error-kind.unknown-record, 'ledger:unknown-owner', owner-problem))) else let e2 = concat(e1, [check{rule: 'ledger:owner', passed: true, detail: 'the owner exists'}]) in if a == 0 || a > 9007199254740991 || a < -9007199254740991 then fail(rejection.rejected(call ledger-refused(e2, error-kind.invalid-intent, 'ledger:invalid-amount', format('an amount is a whole number from -{} to {} other than 0, not {}', 9007199254740991, 9007199254740991, a)))) else if key == '' || call utf8-length(key) > 128 then fail(rejection.rejected(call ledger-refused(e2, error-kind.invalid-intent, 'ledger:invalid-key', 'an idempotency key is 1 to 128 bytes'))) else if startsWith(key, 'expiry:') then fail(rejection.rejected(call ledger-refused(e2, error-kind.invalid-intent, 'ledger:invalid-key', 'the key prefix expiry: belongs to the expiry of credits'))) else if call utf8-length(request.reason) > 256 then fail(rejection.rejected(call ledger-refused(e2, error-kind.invalid-intent, 'ledger:invalid-reason', 'a reason is at most 256 bytes'))) else if call utf8-length(call ledger-scope-text(request.scope)) > 128 then fail(rejection.rejected(call ledger-refused(e2, error-kind.invalid-intent, 'ledger:invalid-scope', 'a scope is at most 128 bytes'))) else e2",
      "examples": [
        {
          "description": "Every check before the account passes: the unit is declared and the owner is a member.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-40"
            },
            "evidence": [
              {
                "rule": "permission:capability:ledger-post",
                "passed": true,
                "detail": "holds ledger-post"
              }
            ],
            "request": {
              "owner": {
                "principal": {
                  "principal": "alpha:owner"
                }
              },
              "unit": "credits",
              "amount": 5,
              "idempotency-key": "k1",
              "reason": "a reward"
            }
          },
          "result": [
            {
              "rule": "permission:capability:ledger-post",
              "passed": true,
              "detail": "holds ledger-post"
            },
            {
              "rule": "ledger:unit",
              "passed": true,
              "detail": "unit credits is declared"
            },
            {
              "rule": "ledger:owner",
              "passed": true,
              "detail": "the owner exists"
            }
          ]
        },
        {
          "description": "A pool the tenant declares is an owner.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-40"
            },
            "evidence": [
              {
                "rule": "permission:capability:ledger-post",
                "passed": true,
                "detail": "holds ledger-post"
              }
            ],
            "request": {
              "owner": {
                "pool": {
                  "pool": "promo"
                }
              },
              "unit": "credits",
              "amount": -5,
              "idempotency-key": "k1",
              "reason": "a reward",
              "scope": "spring"
            }
          },
          "result": [
            {
              "rule": "permission:capability:ledger-post",
              "passed": true,
              "detail": "holds ledger-post"
            },
            {
              "rule": "ledger:unit",
              "passed": true,
              "detail": "unit credits is declared"
            },
            {
              "rule": "ledger:owner",
              "passed": true,
              "detail": "the owner exists"
            }
          ]
        },
        {
          "description": "A unit the tenant does not declare.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-40"
            },
            "evidence": [
              {
