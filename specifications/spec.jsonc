              "version": 1,
              "created-by": "alpha:writer1",
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "slug": {
                  "str": "n1"
                },
                "status": {
                  "str": "draft"
                },
                "title": {
                  "str": "First"
                }
              }
            },
            "new": {
              "id": 1,
              "object": "note",
              "version": 1,
              "created-by": "alpha:writer1",
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "slug": {
                  "str": "n1"
                },
                "status": {
                  "str": "published"
                },
                "title": {
                  "str": "First"
                }
              }
            }
          }
        },
        {
          "description": "An update of a record the principal cannot read afterwards is not observed.",
          "args": {
            "t": {
              "fixture": "fx-tenant-state-26"
            },
            "principal": {
              "user": "automation:quiet"
            },
            "now": 6000,
            "body": {
              "fixture": "fx-event-body-5"
            }
          },
          "result": null
        },
        {
          "description": "A deletion binds old.",
          "args": {
            "t": {
              "fixture": "fx-tenant-state-26"
            },
            "principal": {
              "user": "automation:award"
            },
            "now": 6000,
            "body": {
              "fixture": "fx-event-body-6"
            }
          },
          "result": {
            "old": {
              "id": 1,
              "object": "note",
              "version": 1,
              "created-by": "alpha:writer1",
              "created-at": 5000,
