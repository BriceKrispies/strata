              "fixture": "fx-tenant-state-31"
            },
            "setting": "theme",
            "value": {
              "str": "x"
            },
            "current": null,
            "evidence": []
          },
          "result": []
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-31"
            },
            "setting": "theme",
            "value": null,
            "current": {
              "setting": "theme",
              "level": "tenant",
              "subject": "alpha",
              "value": {
                "str": "dark"
              },
              "revision": 1,
              "set-by": "alpha:owner",
              "set-at": 4000
            },
            "evidence": []
          },
          "result": []
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-31"
            },
            "setting": "theme",
            "value": null,
            "current": null,
            "evidence": []
          },
          "error": {
            "rejected": {
