          "name": "problem",
          "newtype": true,
          "fields": [
            {
              "name": "text",
              "type": "string"
            }
          ]
        }
      ],
      "encoding": {
        "tag": "external",
        "variantCase": "PascalCase"
      }
    },
    {
      "id": "migration-progress",
      "name": "Migration progress",
      "kind": "struct",
      "description": "transition.rs plan_migration, the loop over the changes: the working copy, the summary and the evidence so far.",
