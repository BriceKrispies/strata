    {
      "id": "value-is-null",
      "description": "value.rs Value::is_null.",
      "params": [
        {
          "name": "x",
          "type": "value"
        }
      ],
      "returns": "bool",
      "body": "match x { bool(_) => false, int(_) => false, str(_) => false, time(_) => false, ref(_) => false, list(_) => false, _ => true }",
      "examples": [
        {
          "args": {
            "x": "null"
          },
          "result": true
        },
        {
          "args": {
            "x": {
              "int": 0
            }
          },
          "result": false
        },
        {
          "args": {
            "x": {
              "list": []
            }
          },
          "result": false
        }
      ]
    },
    {
      "id": "value-kind",
      "description": "value.rs Value::kind: the name of a value's shape, for messages.",
      "params": [
        {
          "name": "x",
          "type": "value"
        }
      ],
      "returns": "string",
      "body": "match x { bool(_) => 'bool', int(_) => 'int', str(_) => 'string', time(_) => 'timestamp', ref(_) => 'reference', list(_) => 'list', _ => 'null' }",
      "examples": [
        {
          "args": {
            "x": {
              "int": 3
            }
          },
          "result": "int"
        },
        {
          "args": {
            "x": {
              "time": 1
            }
          },
          "result": "timestamp"
        },
        {
          "args": {
            "x": {
              "ref": 1
            }
          },
          "result": "reference"
        },
        {
          "args": {
            "x": "null"
          },
          "result": "null"
        },
        {
          "args": {
            "x": {
              "str": "a"
            }
          },
          "result": "string"
        },
        {
          "args": {
            "x": {
              "bool": true
            }
          },
          "result": "bool"
        },
        {
          "args": {
            "x": {
              "list": []
            }
          },
          "result": "list"
        }
      ]
    },
    {
      "id": "field-type-scalar-name",
      "description": "value.rs FieldType::name of a type that is not a list; a list is named list (its element type is named by field-type-name).",
      "params": [
        {
          "name": "ty",
          "type": "field-type"
        }
      ],
      "returns": "string",
      "body": "match ty { str => 'string', int => 'int', bool => 'bool', time => 'timestamp', ref{target} => format('reference<{}>', target), list(_) => 'list' }",
      "examples": [
        {
          "args": {
            "ty": "str"
          },
          "result": "string"
        },
        {
          "args": {
            "ty": "time"
          },
          "result": "timestamp"
        },
        {
          "args": {
            "ty": {
              "ref": {
                "target": "person",
                "on-delete": "set-null"
              }
            }
          },
          "result": "reference<person>"
        },
        {
          "args": {
            "ty": {
              "list": "int"
            }
          },
          "result": "list"
        }
      ]
    },
    {
      "id": "field-type-name",
      "description": "value.rs FieldType::name. A list of lists, which schema problems refuse, is named list<list> (no recursion in functions).",
      "params": [
        {
          "name": "ty",
          "type": "field-type"
        }
      ],
      "returns": "string",
      "body": "match ty { list(inner) => format('list<{}>', call field-type-scalar-name(inner)), _ => call field-type-scalar-name(ty) }",
      "examples": [
        {
          "args": {
            "ty": "int"
          },
          "result": "int"
        },
        {
          "args": {
            "ty": {
              "list": "str"
            }
          },
          "result": "list<string>"
        },
        {
          "args": {
            "ty": {
              "list": {
                "ref": {
                  "target": "tag",
                  "on-delete": "restrict"
                }
              }
            }
          },
          "result": "list<reference<tag>>"
        }
      ]
    },
    {
      "id": "scalar-admits",
      "description": "value.rs FieldType::admits for a type that is not a list. A list type here is an element type of a list of lists, which schema problems refuse; it admits nothing.",
      "params": [
        {
          "name": "ty",
          "type": "field-type"
        },
        {
          "name": "x",
          "type": "value"
        }
      ],
      "returns": "bool",
      "body": "match ty { str => match x { str(_) => true, _ => false }, int => match x { int(_) => true, _ => false }, bool => match x { bool(_) => true, _ => false }, time => match x { time(_) => true, _ => false }, ref => match x { ref(_) => true, _ => false }, list(_) => false }",
      "examples": [
        {
          "args": {
            "ty": "str",
            "x": {
              "str": "a"
            }
          },
          "result": true
        },
        {
          "args": {
            "ty": "str",
            "x": {
              "int": 3
            }
          },
          "result": false
        },
        {
          "args": {
            "ty": "time",
            "x": {
              "int": 3
            }
          },
          "result": false
        },
        {
          "args": {
            "ty": {
              "ref": {
                "target": "person",
                "on-delete": "set-null"
              }
            },
            "x": {
              "ref": 1
            }
          },
          "result": true
        },
        {
          "args": {
            "ty": "str",
            "x": {
              "str": "a"
            }
          },
          "result": true
        },
        {
          "args": {
            "ty": "str",
            "x": "null"
          },
          "result": false
        },
        {
          "args": {
            "ty": "int",
            "x": {
              "int": 3
            }
          },
          "result": true
        },
        {
          "args": {
            "ty": "int",
            "x": "null"
          },
          "result": false
        },
        {
          "args": {
            "ty": "bool",
            "x": {
              "bool": true
            }
          },
          "result": true
        },
        {
          "args": {
            "ty": "bool",
            "x": "null"
          },
          "result": false
        },
        {
          "args": {
            "ty": "time",
            "x": {
              "time": 5
            }
          },
          "result": true
        },
        {
          "args": {
            "ty": "time",
            "x": "null"
          },
          "result": false
        },
        {
          "args": {
            "ty": {
              "ref": {
                "target": "person",
                "on-delete": "set-null"
              }
            },
            "x": {
              "ref": 1
            }
          },
          "result": true
        },
        {
          "args": {
            "ty": {
              "ref": {
                "target": "person",
                "on-delete": "set-null"
              }
            },
            "x": "null"
          },
          "result": false
        },
        {
          "args": {
            "ty": {
              "list": "int"
            },
            "x": {
              "int": 3
            }
          },
          "result": false
        },
        {
          "args": {
            "ty": {
              "list": "int"
            },
            "x": {
              "list": []
            }
          },
          "result": false
        },
        {
          "args": {
            "ty": {
              "list": "int"
            },
            "x": "null"
          },
          "result": false
        }
      ]
    },
    {
      "id": "field-type-admits",
      "description": "value.rs FieldType::admits: whether a non-null value has the type; a list admits a list whose items all have its element type.",
      "params": [
        {
          "name": "ty",
          "type": "field-type"
        },
        {
          "name": "x",
          "type": "value"
        }
      ],
      "returns": "bool",
      "body": "match ty { list(inner) => match x { list(items) => all(i in items, call scalar-admits(inner, i)), _ => false }, _ => call scalar-admits(ty, x) }",
      "examples": [
        {
          "args": {
            "ty": {
              "list": "str"
            },
            "x": {
              "list": [
                {
                  "str": "a"
                },
                {
                  "str": "b"
                }
              ]
            }
          },
          "result": true
        },
        {
          "args": {
            "ty": {
              "list": "str"
            },
            "x": {
              "list": [
                {
                  "str": "a"
                },
                {
                  "int": 1
                }
              ]
            }
          },
          "result": false
        },
        {
          "args": {
            "ty": {
              "list": "str"
            },
            "x": {
              "str": "a"
            }
          },
          "result": false
        },
        {
          "args": {
            "ty": "bool",
            "x": {
              "bool": true
            }
          },
          "result": true
        }
      ]
    },
    {
      "id": "ref-target",
      "description": "value.rs FieldType::ref_target: the object type a field refers to, directly or as list elements.",
      "params": [
        {
          "name": "ty",
          "type": "field-type"
        }
      ],
      "returns": "option<object-type-id>",
      "body": "match ty { ref{target} => target, list(inner) => match inner { ref{target} => target, _ => null }, _ => null }",
      "examples": [
        {
          "args": {
            "ty": {
              "ref": {
                "target": "person",
                "on-delete": "set-null"
              }
            }
          },
          "result": "person"
        },
        {
          "args": {
            "ty": {
              "list": {
                "ref": {
                  "target": "tag",
                  "on-delete": "restrict"
                }
              }
            }
          },
          "result": "tag"
        },
        {
          "args": {
            "ty": {
              "list": "str"
            }
          },
          "result": null
        }
      ]
    },
    {
      "id": "refs-in",
      "description": "value.rs refs_in: the record ids a value refers to (a reference, or the references in a list).",
      "params": [
        {
          "name": "x",
          "type": "value"
        }
      ],
      "returns": "list<record-id>",
      "body": "match x { ref(id) => [id], list(items) => fold(i in items, acc = [], concat(acc, match i { ref(id) => [id], _ => [] })), _ => [] }",
      "examples": [
        {
          "args": {
            "x": {
              "ref": 3
            }
          },
          "result": [
            3
          ]
        },
        {
          "args": {
            "x": {
              "list": [
                {
                  "ref": 1
                },
                {
                  "ref": 4
                }
              ]
            }
          },
          "result": [
            1,
            4
          ]
        },
        {
          "args": {
            "x": {
              "str": "a"
            }
          },
          "result": []
        },
        {
          "args": {
            "x": {
              "list": [
                {
                  "ref": 1
                },
                {
                  "int": 2
                }
              ]
            }
          },
          "result": [
            1
          ]
        }
      ]
    },
    {
      "id": "value-debug-leaf",
      "description": "The Rust Debug text of a value that is not a list (a list is written List([..]) without its items).",
      "params": [
        {
          "name": "x",
          "type": "value"
        }
      ],
      "returns": "string",
      "body": "match x { bool(b) => format('Bool({})', b), int(n) => format('Int({})', n), str(s) => format('Str(\"{}\")', s), time(t) => format('Time({})', t), ref(id) => format('Ref(RecordId({}))', id), list(_) => 'List([..])', _ => 'Null' }",
      "examples": [
        {
          "args": {
            "x": {
              "str": "first"
            }
          },
          "result": "Str(\"first\")"
        },
        {
          "args": {
            "x": {
              "ref": 3
            }
          },
          "result": "Ref(RecordId(3))"
        },
        {
          "args": {
            "x": "null"
          },
          "result": "Null"
        },
        {
          "args": {
            "x": {
              "bool": true
            }
          },
          "result": "Bool(true)"
        },
        {
          "args": {
            "x": {
              "time": 9
            }
          },
          "result": "Time(9)"
        },
        {
          "args": {
            "x": {
              "list": []
            }
          },
          "result": "List([..])"
        }
      ]
    },
    {
      "id": "value-debug",
      "description": "The Rust Debug text of a value ({value:?}), as the kernel writes it into a Need. A list is written with its items one level deep.",
      "params": [
        {
          "name": "x",
          "type": "value"
        }
      ],
      "returns": "string",
      "body": "match x { list(items) => format('List([{}])', fold(i in items, acc = '', let t = call value-debug-leaf(i) in if acc == '' then t else acc + ', ' + t)), _ => call value-debug-leaf(x) }",
      "examples": [
        {
          "args": {
            "x": {
              "int": -2
            }
          },
          "result": "Int(-2)"
        },
        {
          "args": {
            "x": {
              "list": [
                {
                  "str": "a"
                },
                {
                  "int": 1
                }
              ]
            }
          },
          "result": "List([Str(\"a\"), Int(1)])"
        }
      ]
    },
    {
      "id": "need-debug",
      "description": "The Rust Debug text of a Need ({need:?}).",
      "params": [
        {
          "name": "wanted",
          "type": "need"
        }
      ],
      "returns": "string",
      "body": "match wanted { record{object, id} => format('Record { object: ObjectTypeId(\"{}\"), id: RecordId({}) }', object, id), by-field{object, field, value} => format('ByField { object: ObjectTypeId(\"{}\"), field: FieldId(\"{}\"), value: {} }', object, field, call value-debug(value)), all-of(object) => format('AllOf(ObjectTypeId(\"{}\"))', object) }",
      "examples": [
        {
          "args": {
            "wanted": {
              "by-field": {
                "object": "note",
                "field": "slug",
                "value": {
                  "str": "first"
                }
              }
            }
          },
          "result": "ByField { object: ObjectTypeId(\"note\"), field: FieldId(\"slug\"), value: Str(\"first\") }"
        },
        {
          "args": {
            "wanted": {
              "record": {
                "object": "person",
                "id": 99
              }
            }
          },
          "result": "Record { object: ObjectTypeId(\"person\"), id: RecordId(99) }"
        },
        {
          "args": {
            "wanted": {
              "all-of": "note"
            }
          },
          "result": "AllOf(ObjectTypeId(\"note\"))"
        }
      ]
    },
    {
      "id": "covers",
      "description": "state.rs Coverage::covers: a complete snapshot covers every need; a partial one covers the needs it loaded, and a record or field lookup of an object type it loaded whole.",
      "params": [
        {
          "name": "coverage",
          "type": "coverage"
        },
        {
          "name": "wanted",
          "type": "need"
        }
      ],
      "returns": "bool",
      "body": "match coverage { complete => true, partial(loaded) => any(n in loaded, n == wanted) || match wanted { record{object} => any(n in loaded, n == need.all-of(object)), by-field{object} => any(n in loaded, n == need.all-of(object)), all-of(_) => false } }",
      "examples": [
        {
          "args": {
            "coverage": "complete",
            "wanted": {
              "all-of": "note"
            }
          },
          "result": true
        },
        {
          "description": "behaviour.rs a_thin_snapshot_is_refused_with_the_missing_need: an empty partial snapshot covers nothing.",
          "args": {
            "coverage": {
              "partial": []
            },
            "wanted": {
              "by-field": {
                "object": "note",
                "field": "slug",
                "value": {
                  "str": "first"
                }
              }
            }
          },
          "result": false
        },
        {
          "args": {
            "coverage": {
              "partial": [
                {
                  "all-of": "note"
                }
              ]
            },
            "wanted": {
              "record": {
                "object": "note",
                "id": 1
              }
            }
          },
          "result": true
        },
        {
          "args": {
            "coverage": {
              "partial": [
                {
                  "all-of": "note"
                }
              ]
            },
            "wanted": {
              "record": {
                "object": "person",
                "id": 1
              }
            }
          },
          "result": false
        },
        {
          "args": {
            "coverage": {
              "partial": [
                {
                  "record": {
                    "object": "note",
                    "id": 1
                  }
                }
              ]
            },
            "wanted": {
              "all-of": "note"
            }
          },
          "result": false
        }
      ]
    },
    {
      "id": "insufficient",
      "description": "rules.rs insufficient: the error of a lookup the snapshot does not cover, naming the need.",
      "params": [
        {
          "name": "wanted",
          "type": "need"
        }
      ],
      "returns": "domain-error",
      "let": [
        {
          "name": "text",
          "expr": "call need-debug(wanted)"
        }
      ],
      "body": "domain-error{kind: error-kind.insufficient-state, message: format('the snapshot does not cover {}', text), evidence: [check{rule: 'coverage', passed: false, detail: text}], missing: wanted}",
      "examples": [
        {
          "args": {
            "wanted": {
              "by-field": {
                "object": "note",
                "field": "slug",
                "value": {
                  "str": "first"
                }
              }
            }
          },
          "result": {
            "kind": "insufficient-state",
            "message": "the snapshot does not cover ByField { object: ObjectTypeId(\"note\"), field: FieldId(\"slug\"), value: Str(\"first\") }",
            "evidence": [
              {
                "rule": "coverage",
                "passed": false,
                "detail": "ByField { object: ObjectTypeId(\"note\"), field: FieldId(\"slug\"), value: Str(\"first\") }"
              }
            ],
            "missing": {
              "by-field": {
                "object": "note",
                "field": "slug",
                "value": {
                  "str": "first"
                }
              }
            }
          }
        }
      ]
    },
    {
      "id": "lookup-record",
      "description": "rules.rs Lookup::record: the record of an object type with an id, refused when the snapshot does not cover it.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "coverage",
          "type": "coverage"
        },
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "id",
          "type": "record-id"
        }
      ],
      "returns": "option<record>",
      "errors": "rejection",
      "let": [
        {
          "name": "wanted",
          "expr": "need.record{object, id}"
        }
      ],
      "body": "if call covers(coverage, wanted) then match get(tenant.records, object) { Some(rs) => get(rs, id), None => null } else fail(rejection.rejected(call insufficient(wanted)))",
