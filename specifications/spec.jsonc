    {
      "id": "team-role",
      "description": "transition.rs team_role: assign a role to a team or revoke it. Authorised as Manage on Members; the team must exist, the role must exist and not be public, and the role must be one the principal may confer, granted or revoked (require-conferrable). A revocation must leave the tenant an owner, counting the owners through teams (owner-lost). A member left with no role at all by a revocation has its sessions revoked.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "team",
          "type": "team-id"
        },
        {
          "name": "role",
          "type": "role-id"
        },
        {
          "name": "grant",
          "type": "bool"
        }
      ],
      "returns": "decided",
      "errors": "rejection",
      "let": [
        {
          "name": "d1",
          "expr": "try call require(d, action.manage, resource.members, subject{})"
        },
        {
          "name": "def0",
          "expr": "try call team-of(d1, team)"
        }
      ],
      "body": "if get(d1.tenant.schema.roles, role) == null then fail(call draft-reject(d1.evidence, error-kind.unknown-role, format('no role {}', role))) else if role == 'public' then fail(call draft-reject(d1.evidence, error-kind.invalid-intent, 'everyone already holds public')) else let d2 = try call require-conferrable(d1, [role]) in let def = team-def{id: def0.id, label: def0.label, members: def0.members, roles: if grant then call set-of(concat(def0.roles, [role])) else filter(r in def0.roles, r != role)} in let after = call schema-with-team(d2.tenant.schema, def) in let lost = if grant then [] else filter(m in def.members, (match get(d2.tenant.members, m) { Some(rs) => rs == [], None => true }) && call assigned-roles({}, after, m) == []) in if !grant && call owner-lost(d2.tenant.members, d2.tenant.schema, d2.tenant.members, after) then fail(call draft-reject(d2.evidence, error-kind.invalid-intent, 'a tenant keeps at least one owner')) else decided{draft: call put-team(draft{tenant: d2.tenant, ctx: d2.ctx, coverage: d2.coverage, ops: d2.ops, events: d2.events, effects: concat(d2.effects, map(p in lost, effect.revoke-sessions{principal: p})), evidence: d2.evidence, next-record: d2.next-record}, d2.tenant.schema, def), output: output.member}",
      "examples": [
        {
          "description": "Revoking the only role of a team member with no role of its own ends its sessions.",
          "args": {
            "d": {
              "fixture": "fx-draft-17"
            },
            "team": "desk",
            "role": "editor",
            "grant": false
          },
          "result": {
            "draft": {
              "tenant": {
                "id": "alpha",
                "name": "alpha",
                "revision": 5,
                "next-record": 1,
                "event-seq": 5,
                "schema": {
                  "version": 2,
                  "objects": {},
                  "roles": {
                    "editor": {
                      "id": "editor",
                      "label": "Editor"
                    },
                    "owner": {
                      "id": "owner",
                      "label": "Owner"
                    },
                    "public": {
                      "id": "public",
                      "label": "Everyone"
                    },
                    "writer": {
                      "id": "writer",
                      "label": "Writer"
                    }
                  },
                  "teams": {
                    "desk": {
                      "id": "desk",
                      "label": "Desk",
                      "members": [
                        "alpha:guest"
                      ],
                      "roles": [
                        "editor"
                      ]
                    }
                  },
                  "policies": {},
                  "workflows": {},
                  "queries": {},
                  "views": {}
                },
                "members": {
                  "alpha:editor": [
                    "editor"
                  ],
                  "alpha:owner": [
                    "owner"
                  ],
                  "alpha:writer1": [
                    "writer"
                  ],
                  "alpha:writer2": [
                    "writer"
                  ]
                },
                "records": {}
              },
              "ctx": {
                "tenant": "alpha",
                "principal": {
                  "user": "alpha:owner"
                },
                "now": 5000,
                "correlation": "test-5000"
              },
              "coverage": "complete",
              "ops": [
                {
                  "put-schema": {
                    "version": 2,
                    "objects": {},
                    "roles": {
                      "editor": {
                        "id": "editor",
                        "label": "Editor"
                      },
                      "owner": {
                        "id": "owner",
                        "label": "Owner"
                      },
                      "public": {
                        "id": "public",
                        "label": "Everyone"
