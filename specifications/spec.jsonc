    {
      "id": "kernel-read",
      "description": "crates/kernel/src/read.rs read, the pure body of contract answer-read (CT-003): the snapshot must be of the context's tenant (TenantMismatch \"snapshot is of another tenant\") and hold it (TenantNotFound \"no such tenant\"). A records request answers each named record that exists and that the principal may read (visible), refusing an unknown object type; a named query refuses an unknown query (UnknownQuery) and a parameter it does not declare (InvalidIntent), then keeps every record of its object type the principal may read whose filter holds (evaluates to exactly true; an evaluation error is Evaluation with a failed query:<id> check), sorted by its order keys and then by id, and at most its limit. These rejections carry no evidence. A filter that follows a reference fails to evaluate here, as it does without a lookup (WG-4957). texts.conditions holds the printed filter under query:<id> (the print gap of WG-4957).",
      "params": [
        {
          "name": "state",
          "type": "state"
        },
        {
          "name": "request",
          "type": "read-request"
        },
        {
          "name": "context",
          "type": "context"
        },
        {
          "name": "texts",
          "type": "intent-texts"
        }
      ],
      "returns": "read-result",
      "errors": "rejection",
      "body": "if state.tenant-id != context.tenant then fail(rejection.rejected(domain-error{kind: error-kind.tenant-mismatch, message: 'snapshot is of another tenant', evidence: []})) else match state.tenant { None => fail(rejection.rejected(domain-error{kind: error-kind.tenant-not-found, message: 'no such tenant', evidence: []})), Some(t) => if t.id != context.tenant then fail(rejection.rejected(domain-error{kind: error-kind.tenant-not-found, message: 'no such tenant', evidence: []})) else read-result{rows: match request { records{object, ids} => if get(t.schema.objects, object) == null then fail(rejection.rejected(domain-error{kind: error-kind.unknown-object, message: format('no object type {}', object), evidence: []})) else fold(id in ids, acc = [], match try call lookup-record(t, state.coverage, object, id) { Some(r) => if call visible(t, context.principal, r, context.now) then concat(acc, [r]) else acc, None => acc }), named{query, params} => match get(t.schema.queries, query) { None => fail(rejection.rejected(domain-error{kind: error-kind.unknown-query, message: format('no query {}', query), evidence: []})), Some(def) => match find(k in keys(params), !any(p in def.params, p == k)) { Some(extra) => fail(rejection.rejected(domain-error{kind: error-kind.invalid-intent, message: format('query {} has no parameter {}', query, extra), evidence: []})), None => let roles = call roles-of(t, context.principal) in let kept = fold(r in try call lookup-all(t, state.coverage, def.object), acc = [], if !call visible(t, context.principal, r, context.now) then acc else match def.filter { None => concat(acc, [r]), Some(filter) => match eval(tenant-rule-language, filter, expr-env{record: call record-scope(r), old: call record-scope(r), new: call record-scope(r), param: params, now: value.time(context.now), principal: call principal-value(context.principal), has_role: roles}) { Ok(x) => if x == value.bool(true) then concat(acc, [r]) else acc, Err(e) => fail(rejection.rejected(domain-error{kind: error-kind.evaluation, message: format('query {}: {}', query, e), evidence: [check{rule: format('query:{}', query), passed: false, detail: match get(texts.conditions, format('query:{}', query)) { Some(text) => text, None => '' }}]})) } }) in let sorted = call order-rows(kept, def.order) in match def.limit { Some(n) => take(sorted, n), None => sorted } } } }, revision: t.revision, schema-version: t.schema.version} }",
      "examples": [
        {
          "description": "A reader sees the published posts, in title order.",
          "args": {
            "state": {
              "tenant-id": "alpha",
              "tenant": {
                "id": "alpha",
                "name": "Alpha",
                "revision": 5,
                "next-record": 5,
                "event-seq": 5,
                "schema": {
                  "version": 2,
                  "objects": {
                    "person": {
                      "id": "person",
                      "label": "Person",
                      "fields": {
                        "name": {
                          "id": "name",
                          "label": "name",
                          "ty": "str",
                          "required": true,
                          "unique": false
                        }
                      },
                      "constraints": {}
                    },
                    "post": {
                      "id": "post",
                      "label": "Post",
                      "fields": {
                        "author": {
                          "id": "author",
                          "label": "author",
                          "ty": {
                            "ref": {
                              "target": "person",
                              "on-delete": "set-null"
                            }
                          },
                          "required": false,
                          "unique": false
                        },
                        "status": {
                          "id": "status",
                          "label": "status",
                          "ty": "str",
                          "required": false,
                          "unique": false
                        },
                        "title": {
