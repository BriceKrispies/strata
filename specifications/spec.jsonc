            "label": "Mentions",
            "doc": "Goals, non-goals, boundaries, decisions, constraints, open questions and components named in the text."
          }
        }
      },
      "boundary": {
        "label": "Boundary",
        "section": "boundaries",
        "shape": "pipe",
        "color": "teal",
        "doc": "A public or internal boundary of the white paper (B-n): the surfaces at which requirements may be stated.",
        "properties": {
