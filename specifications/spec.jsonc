            "label": "Contracts",
            "doc": "The contracts this boundary offers, one for each operation: the interface that code is generated from."
          }
        }
      },
      "decision": {
        "label": "Decision",
        "section": "decisions",
        "shape": "capsule",
        "color": "violet",
        "doc": "A decision of the white paper (D-n).",
        "properties": {
          "title": {
            "type": "string",
            "required": true,
            "label": "Title"
          },
          "statement": {
