      "refinement": {
        "states": {
          "asrt-open-i": "asrt-open"
        },
        "variables": {},
        "transitions": {
          "asrt-accept-i": "asrt-accept",
          "asrt-refuse-i": "asrt-refuse"
        }
      },
      "storage": {
        "record": "rec-identity-decision",
        "key": "decision-id",
        "creates": true
      }
    },
    {
      "id": "session-lifetime-flow",
      "name": "Session lifetime",
      "subject": "identity-service",
      "initial": "sl-new",
      "description": "One session and its two lifetimes. The session is accepted only while the time since it was last used is within the idle lifetime and the time since sign-in is within the absolute lifetime; a session past either is ended and refused from then on. The realm gives both lifetimes; the shorter one ends the session first. One model tick is one hour.",
      "variables": [
        {
          "name": "issuedAt",
          "type": "number",
          "initial": 0
        },
        {
          "name": "lastUsed",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "sl-live",
          "name": "Live"
        },
        {
          "id": "sl-over",
          "name": "Ended"
        },
        {
          "id": "sl-new",
          "name": "Not yet issued"
        }
      ],
      "transitions": [
        {
          "id": "sl-issue",
          "from": "sl-new",
          "to": "sl-live",
          "on": "sl-issued",
          "effects": [
            {
              "set": "issuedAt",
              "to": "time"
            },
            {
              "set": "lastUsed",
              "to": "time"
            }
          ]
        },
        {
          "id": "sl-accept-idle-expired",
          "from": "sl-live",
          "to": "sl-live",
          "on": "sl-used",
          "guard": "lastUsed <= time && time - lastUsed > event.idleHours && issuedAt <= time && time - issuedAt <= event.absoluteHours",
          "effects": [
            {
              "set": "lastUsed",
              "to": "time"
            },
            {
              "emit": "sl-session-valid"
            }
          ],
          "faultOnly": true,
          "description": "Defect: ignores the idle lifetime."
        },
        {
          "id": "sl-accept-absolute-expired",
          "from": "sl-live",
          "to": "sl-live",
          "on": "sl-used",
          "guard": "lastUsed <= time && time - lastUsed <= event.idleHours && issuedAt <= time && time - issuedAt > event.absoluteHours",
          "effects": [
            {
              "set": "lastUsed",
              "to": "time"
            },
            {
              "emit": "sl-session-valid"
            }
          ],
          "faultOnly": true,
          "description": "Defect: ignores the absolute lifetime."
        },
        {
          "id": "sl-accept",
          "from": "sl-live",
          "to": "sl-live",
          "on": "sl-used",
          "guard": "lastUsed <= time && time - lastUsed <= event.idleHours && issuedAt <= time && time - issuedAt <= event.absoluteHours",
          "effects": [
            {
              "set": "lastUsed",
              "to": "time"
            },
            {
              "emit": "sl-session-valid"
            }
          ]
        },
        {
          "id": "sl-expire",
          "from": "sl-live",
          "to": "sl-over",
          "on": "sl-used",
          "effects": [
            {
              "emit": "sl-session-ended"
            }
          ]
        },
        {
          "id": "sl-refuse-ended",
          "from": "sl-over",
          "to": "sl-over",
          "on": "sl-used",
          "effects": [
            {
              "emit": "sl-session-ended"
            }
          ]
        }
      ]
    },
    {
      "level": "implementation",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "id": "session-lifetime-flow-impl",
      "name": "Session lifetime (implementation)",
      "subject": "identity-service",
      "initial": "sl-new-i",
      "description": "The lifetimes of one session as the identity service keeps them (rec-session-lifetime): the time of sign-in and the time of last use, in milliseconds, against the idle and absolute lifetimes that the realm gives in hours. The refinement reads one model tick as one hour (timeScale 3600000).",
      "variables": [
        {
          "name": "issuedAt",
          "type": "number",
          "initial": 0,
          "repr": "timestamp"
        },
        {
          "name": "lastUsed",
          "type": "number",
          "initial": 0,
          "repr": "timestamp"
        }
      ],
      "states": [
        {
          "id": "sl-live-i",
          "name": "Live",
          "ignores": [
            "sl-issued"
          ]
        },
        {
          "id": "sl-over-i",
          "name": "Ended",
          "ignores": [
            "sl-issued"
          ]
        },
        {
          "id": "sl-new-i",
          "name": "Not yet issued",
          "ignores": [
            "sl-used"
          ]
        }
      ],
      "transitions": [
        {
          "id": "sl-issue-i",
          "from": "sl-new-i",
          "to": "sl-live-i",
          "on": "sl-issued",
          "effects": [
            {
              "set": "issuedAt",
              "to": "time"
            },
            {
              "set": "lastUsed",
              "to": "time"
            }
          ],
          "otherwise": true
        },
        {
          "id": "sl-accept-i",
          "from": "sl-live-i",
          "to": "sl-live-i",
          "on": "sl-used",
          "guard": "lastUsed <= time && time - lastUsed <= event.idleHours * 3600000 && issuedAt <= time && time - issuedAt <= event.absoluteHours * 3600000",
          "effects": [
            {
              "set": "lastUsed",
              "to": "time"
            },
            {
              "emit": "sl-session-valid",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "sl-expire-i",
          "from": "sl-live-i",
          "to": "sl-over-i",
          "on": "sl-used",
          "effects": [
            {
              "emit": "sl-session-ended",
              "to": "gateway"
            }
          ],
          "otherwise": true
        },
        {
          "id": "sl-refuse-ended-i",
          "from": "sl-over-i",
          "to": "sl-over-i",
          "on": "sl-used",
          "effects": [
            {
              "emit": "sl-session-ended",
              "to": "gateway"
            }
          ],
          "otherwise": true
        }
      ],
      "refines": "session-lifetime-flow",
      "refinement": {
        "states": {
          "sl-live-i": "sl-live",
          "sl-over-i": "sl-over",
          "sl-new-i": "sl-new"
        },
        "variables": {
          "issuedAt": "issuedAt / 3600000",
          "lastUsed": "lastUsed / 3600000"
        },
        "transitions": {
          "sl-accept-i": "sl-accept",
          "sl-expire-i": "sl-expire",
          "sl-refuse-ended-i": "sl-refuse-ended",
          "sl-issue-i": "sl-issue"
        },
        "timeScale": 3600000
      },
      "storage": {
        "record": "rec-session-lifetime",
        "key": "session-id",
        "fields": {
          "issuedAt": "issued-at",
          "lastUsed": "last-used-at"
        },
        "creates": true
      }
    },
    {
      "id": "second-factor-flow",
      "name": "Second factor",
      "subject": "identity-service",
      "initial": "sf-start",
      "description": "One sign-in under a realm policy. When the realm asks for a second factor, the first factor alone issues no session: the sign-in waits, and only a verified second factor issues it.",
      "states": [
        {
          "id": "sf-start",
          "name": "First factor pending"
        },
        {
          "id": "sf-awaiting",
          "name": "Waiting for the second factor"
        },
        {
          "id": "sf-done",
          "name": "Signed in"
        }
      ],
      "transitions": [
        {
          "id": "sf-issue-without-second",
          "from": "sf-start",
          "to": "sf-done",
          "on": "sf-primary",
          "guard": "event.secondRequired",
          "effects": [
            {
              "emit": "sf-session-issued"
            }
          ],
          "faultOnly": true,
          "description": "Defect: issues the session on the first factor alone."
        },
        {
          "id": "sf-await",
          "from": "sf-start",
          "to": "sf-awaiting",
          "on": "sf-primary",
          "guard": "event.secondRequired",
          "effects": [
            {
              "emit": "sf-second-asked"
            }
          ]
        },
        {
          "id": "sf-primary-only",
          "from": "sf-start",
          "to": "sf-done",
          "on": "sf-primary",
          "effects": [
            {
              "emit": "sf-session-issued"
            }
          ]
        },
        {
          "id": "sf-second-ok",
          "from": "sf-awaiting",
          "to": "sf-done",
          "on": "sf-second",
          "guard": "event.valid",
          "effects": [
            {
              "emit": "sf-session-issued"
            }
          ]
        },
        {
          "id": "sf-second-bad",
          "from": "sf-awaiting",
          "to": "sf-awaiting",
          "on": "sf-second",
          "effects": [
            {
              "emit": "sf-refused"
            }
          ]
        }
      ]
    },
    {
      "level": "implementation",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "id": "second-factor-flow-impl",
      "name": "Second factor (implementation)",
      "subject": "identity-service",
      "initial": "sf-start-i",
      "description": "One sign-in attempt as the identity service keeps it (rec-sign-in-attempt): the state says whether the first factor is verified and the second is awaited. No session is issued from the waiting state except by a verified second factor.",
      "states": [
        {
          "id": "sf-start-i",
          "name": "First factor pending",
          "ignores": [
            "sf-second"
          ]
        },
        {
          "id": "sf-awaiting-i",
          "name": "Waiting for the second factor",
          "ignores": [
            "sf-primary"
          ]
        },
        {
          "id": "sf-done-i",
          "name": "Signed in",
          "ignores": [
            "sf-primary",
            "sf-second"
          ]
        }
      ],
      "transitions": [
        {
          "id": "sf-await-i",
          "from": "sf-start-i",
          "to": "sf-awaiting-i",
          "on": "sf-primary",
          "guard": "event.secondRequired",
          "effects": [
            {
              "emit": "sf-second-asked",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "sf-primary-only-i",
          "from": "sf-start-i",
          "to": "sf-done-i",
          "on": "sf-primary",
          "effects": [
            {
              "emit": "sf-session-issued",
              "to": "web-application"
            }
          ],
          "otherwise": true
        },
        {
          "id": "sf-second-ok-i",
          "from": "sf-awaiting-i",
          "to": "sf-done-i",
          "on": "sf-second",
          "guard": "event.valid",
          "effects": [
            {
              "emit": "sf-session-issued",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "sf-second-bad-i",
          "from": "sf-awaiting-i",
          "to": "sf-awaiting-i",
          "on": "sf-second",
          "effects": [
            {
              "emit": "sf-refused",
              "to": "web-application"
            }
          ],
          "otherwise": true
        }
      ],
      "refines": "second-factor-flow",
      "refinement": {
        "states": {
          "sf-start-i": "sf-start",
          "sf-awaiting-i": "sf-awaiting",
          "sf-done-i": "sf-done"
        },
        "variables": {},
        "transitions": {
          "sf-await-i": "sf-await",
          "sf-primary-only-i": "sf-primary-only",
          "sf-second-ok-i": "sf-second-ok",
          "sf-second-bad-i": "sf-second-bad"
        }
      },
      "storage": {
        "record": "rec-sign-in-attempt",
        "key": "attempt-id",
        "creates": true
      }
    },
    {
      "id": "recovery-flow",
      "name": "Account recovery",
      "subject": "identity-service",
      "initial": "rc-none",
      "description": "One account recovery. The request tells every registered contact of the account at once, the recovery completes only after the delay of 24 hours (D-700) and only once every contact was told, and completing it does not switch off the second factor, so the next sign-in still asks for it. One model tick is one hour.",
      "variables": [
        {
          "name": "contacts",
          "type": "number",
          "initial": 0
        },
        {
          "name": "notified",
          "type": "number",
          "initial": 0
        },
        {
          "name": "requestedAt",
          "type": "number",
          "initial": 0
        },
        {
          "name": "secondFactor",
          "type": "boolean",
          "initial": true
        }
      ],
      "states": [
        {
          "id": "rc-none",
          "name": "No recovery"
        },
        {
          "id": "rc-waiting",
          "name": "Waiting out the delay"
        },
        {
          "id": "rc-recovered",
          "name": "Recovered"
        }
      ],
      "transitions": [
        {
          "id": "rc-request-unnotified",
          "from": "rc-none",
          "to": "rc-waiting",
          "on": "rc-requested",
          "effects": [
            {
              "set": "contacts",
              "to": "event.contacts"
            },
            {
              "set": "requestedAt",
              "to": "time"
            }
          ],
          "faultOnly": true,
          "description": "Defect: starts the recovery without telling the contacts."
        },
        {
          "id": "rc-request",
          "from": "rc-none",
          "to": "rc-waiting",
          "on": "rc-requested",
          "effects": [
            {
              "set": "contacts",
              "to": "event.contacts"
            },
            {
              "set": "notified",
              "to": "event.contacts"
            },
            {
              "set": "requestedAt",
              "to": "time"
            },
            {
              "emit": "rc-notice"
            }
          ]
        },
        {
          "id": "rc-complete-early",
          "from": "rc-waiting",
          "to": "rc-recovered",
          "on": "rc-completion-asked",
          "guard": "requestedAt <= time && time - requestedAt < 24",
          "effects": [
            {
              "emit": "rc-completed"
            }
          ],
          "faultOnly": true,
          "description": "Defect: completes before the delay has passed."
        },
        {
          "id": "rc-complete-unnotified",
          "from": "rc-waiting",
          "to": "rc-recovered",
          "on": "rc-completion-asked",
          "guard": "requestedAt <= time && time - requestedAt >= 24 && notified != contacts",
          "effects": [
            {
              "emit": "rc-completed"
            }
          ],
          "faultOnly": true,
          "description": "Defect: completes without every contact having been told."
        },
        {
          "id": "rc-complete-drops-factor",
          "from": "rc-waiting",
          "to": "rc-recovered",
          "on": "rc-completion-asked",
          "guard": "requestedAt <= time && time - requestedAt >= 24 && notified == contacts",
          "effects": [
            {
              "set": "secondFactor",
              "to": false
            },
            {
              "emit": "rc-completed"
            }
          ],
          "faultOnly": true,
          "description": "Defect: switches the second factor off when it completes."
        },
        {
          "id": "rc-complete",
          "from": "rc-waiting",
          "to": "rc-recovered",
          "on": "rc-completion-asked",
          "guard": "requestedAt <= time && time - requestedAt >= 24 && notified == contacts",
          "effects": [
            {
              "emit": "rc-completed"
            }
          ]
        },
        {
          "id": "rc-complete-refuse",
          "from": "rc-waiting",
          "to": "rc-waiting",
          "on": "rc-completion-asked",
          "effects": [
            {
              "emit": "rc-too-early"
            }
          ]
        },
        {
          "id": "rc-sign-in-factor",
          "from": "rc-recovered",
          "to": "rc-recovered",
          "on": "rc-signed-in",
          "guard": "secondFactor",
          "effects": [
            {
              "emit": "rc-second-factor-asked"
            }
          ]
        },
        {
          "id": "rc-sign-in-session",
          "from": "rc-recovered",
          "to": "rc-recovered",
          "on": "rc-signed-in",
          "effects": [
            {
              "emit": "rc-session-issued"
            }
          ]
        }
      ]
    },
    {
      "level": "implementation",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "id": "recovery-flow-impl",
      "name": "Account recovery (implementation)",
      "subject": "identity-service",
      "initial": "rc-none-i",
      "description": "One account recovery as the identity service keeps it (rec-recovery-request): the number of contacts, the number told, the time of the request in milliseconds and whether the second factor is in force. The delay of 24 hours is 86400000 ms; the refinement reads one model tick as one hour (timeScale 3600000).",
      "variables": [
        {
          "name": "contacts",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "notified",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "requestedAt",
          "type": "number",
          "initial": 0,
          "repr": "timestamp"
        },
        {
          "name": "secondFactor",
          "type": "boolean",
          "initial": true,
          "repr": "bool"
        }
      ],
      "states": [
        {
          "id": "rc-none-i",
          "name": "No recovery",
          "ignores": [
            "rc-completion-asked",
            "rc-signed-in"
          ]
        },
        {
          "id": "rc-waiting-i",
          "name": "Waiting out the delay",
          "ignores": [
            "rc-requested",
            "rc-signed-in"
          ]
        },
        {
          "id": "rc-recovered-i",
          "name": "Recovered",
          "ignores": [
            "rc-requested",
            "rc-completion-asked"
          ]
        }
      ],
      "transitions": [
        {
          "id": "rc-request-i",
          "from": "rc-none-i",
          "to": "rc-waiting-i",
          "on": "rc-requested",
          "effects": [
            {
              "set": "contacts",
              "to": "event.contacts"
            },
            {
              "set": "notified",
              "to": "event.contacts"
            },
            {
              "set": "requestedAt",
              "to": "time"
            },
            {
              "emit": "rc-notice",
              "to": "mail-service"
            }
          ],
          "otherwise": true
        },
        {
          "id": "rc-complete-i",
          "from": "rc-waiting-i",
          "to": "rc-recovered-i",
          "on": "rc-completion-asked",
          "guard": "requestedAt <= time && time - requestedAt >= 86400000 && notified == contacts",
          "effects": [
            {
              "emit": "rc-completed",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "rc-complete-refuse-i",
          "from": "rc-waiting-i",
          "to": "rc-waiting-i",
          "on": "rc-completion-asked",
          "effects": [
            {
              "emit": "rc-too-early",
              "to": "web-application"
            }
          ],
          "otherwise": true
        },
        {
          "id": "rc-sign-in-factor-i",
          "from": "rc-recovered-i",
          "to": "rc-recovered-i",
          "on": "rc-signed-in",
          "guard": "secondFactor",
          "effects": [
            {
              "emit": "rc-second-factor-asked",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "rc-sign-in-session-i",
          "from": "rc-recovered-i",
          "to": "rc-recovered-i",
          "on": "rc-signed-in",
          "effects": [
            {
              "emit": "rc-session-issued",
              "to": "web-application"
            }
          ],
          "otherwise": true
        }
      ],
      "refines": "recovery-flow",
      "refinement": {
        "states": {
          "rc-none-i": "rc-none",
          "rc-waiting-i": "rc-waiting",
          "rc-recovered-i": "rc-recovered"
        },
        "variables": {
          "contacts": "contacts",
          "notified": "notified",
          "requestedAt": "requestedAt / 3600000",
          "secondFactor": "secondFactor"
        },
        "transitions": {
          "rc-request-i": "rc-request",
          "rc-complete-i": "rc-complete",
          "rc-complete-refuse-i": "rc-complete-refuse",
          "rc-sign-in-factor-i": "rc-sign-in-factor",
          "rc-sign-in-session-i": "rc-sign-in-session"
        },
        "timeScale": 3600000
      },
      "storage": {
        "record": "rec-recovery-request",
        "key": "recovery-id",
        "fields": {
          "requestedAt": "requested-at",
          "secondFactor": "second-factor"
        },
        "creates": true
      }
    },
    {
      "id": "code-spend-flow",
      "name": "One-time code",
      "subject": "identity-service",
      "initial": "cs-live",
      "description": "One one-time code. Five failed presentations (D-700) spend it: once spent it is refused even when the right code is presented. A right presentation within the limit is accepted and uses the code up.",
      "variables": [
        {
          "name": "failures",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "cs-live",
          "name": "Live"
        },
        {
          "id": "cs-spent",
          "name": "Spent"
        }
      ],
      "transitions": [
        {
          "id": "cs-accept-after-spent",
          "from": "cs-spent",
          "to": "cs-spent",
          "on": "cs-presented",
          "guard": "event.guess == 'right'",
          "effects": [
            {
              "emit": "cs-accepted"
            }
          ],
          "faultOnly": true,
          "description": "Defect: accepts the right code after the failures reached the limit."
        },
        {
          "id": "cs-right",
          "from": "cs-live",
          "to": "cs-spent",
          "on": "cs-presented",
          "guard": "event.guess == 'right'",
          "effects": [
            {
              "emit": "cs-accepted"
            }
          ]
        },
        {
          "id": "cs-wrong-last",
          "from": "cs-live",
          "to": "cs-spent",
          "on": "cs-presented",
          "guard": "event.guess == 'wrong' && failures == 4",
          "effects": [
            {
              "set": "failures",
              "to": "failures + 1"
            },
            {
              "emit": "cs-refused"
            }
          ]
        },
        {
          "id": "cs-wrong",
          "from": "cs-live",
          "to": "cs-live",
          "on": "cs-presented",
          "guard": "event.guess == 'wrong'",
          "effects": [
            {
              "set": "failures",
              "to": "failures + 1"
            },
            {
              "emit": "cs-refused"
            }
          ]
        },
        {
          "id": "cs-refuse-spent",
          "from": "cs-spent",
          "to": "cs-spent",
          "on": "cs-presented",
          "effects": [
            {
              "emit": "cs-refused"
            }
          ]
        }
      ]
    },
    {
      "level": "implementation",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "id": "code-spend-flow-impl",
      "name": "One-time code (implementation)",
      "subject": "identity-service",
      "initial": "cs-live-i",
      "description": "One one-time code as the identity service keeps it (rec-one-time-code): the count of failed presentations and whether it is spent. The fifth failure spends it.",
      "variables": [
        {
          "name": "failures",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        }
      ],
      "states": [
        {
          "id": "cs-live-i",
          "name": "Live"
        },
        {
          "id": "cs-spent-i",
          "name": "Spent"
        }
      ],
      "transitions": [
        {
          "id": "cs-right-i",
          "from": "cs-live-i",
          "to": "cs-spent-i",
          "on": "cs-presented",
          "guard": "event.guess == 'right'",
          "effects": [
            {
              "emit": "cs-accepted",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "cs-wrong-last-i",
          "from": "cs-live-i",
          "to": "cs-spent-i",
          "on": "cs-presented",
          "guard": "event.guess == 'wrong' && failures == 4",
          "effects": [
            {
              "set": "failures",
              "to": "failures + 1"
            },
            {
              "emit": "cs-refused",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "cs-wrong-i",
          "from": "cs-live-i",
          "to": "cs-live-i",
          "on": "cs-presented",
          "guard": "event.guess == 'wrong'",
          "effects": [
            {
              "set": "failures",
              "to": "failures + 1"
            },
            {
              "emit": "cs-refused",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "cs-refuse-spent-i",
          "from": "cs-spent-i",
          "to": "cs-spent-i",
          "on": "cs-presented",
          "effects": [
            {
              "emit": "cs-refused",
              "to": "web-application"
            }
          ],
          "otherwise": true
        }
      ],
      "refines": "code-spend-flow",
      "refinement": {
        "states": {
          "cs-live-i": "cs-live",
          "cs-spent-i": "cs-spent"
        },
        "variables": {
          "failures": "failures"
        },
        "transitions": {
          "cs-right-i": "cs-right",
          "cs-wrong-last-i": "cs-wrong-last",
          "cs-wrong-i": "cs-wrong",
          "cs-refuse-spent-i": "cs-refuse-spent"
        }
      },
      "storage": {
        "record": "rec-one-time-code",
        "key": "code-id",
        "creates": true
      }
    },
    {
      "id": "mfp-limit-flow",
      "name": "Second-factor prompt limit",
      "subject": "identity-service",
      "initial": "mfp-open",
      "description": "The second-factor prompts sent to one account. The limit starts at the platform default of 5 within one hour (D-700) and a realm may only tighten it. One model tick is one minute.",
      "variables": [
        {
          "name": "count",
          "type": "number",
          "initial": 0
        },
        {
          "name": "windowStart",
          "type": "number",
          "initial": 0
        },
        {
          "name": "limit",
          "type": "number",
          "initial": 5
        },
        {
          "name": "windowOpen",
          "type": "boolean",
          "initial": false
        }
      ],
      "states": [
        {
          "id": "mfp-open",
          "name": "Counting"
        }
      ],
      "transitions": [
        {
          "id": "mfp-accept-over",
          "from": "mfp-open",
          "to": "mfp-open",
          "on": "mfp-requested",
          "guard": "count >= limit && windowOpen && windowStart <= time && time - windowStart < 60",
          "effects": [
            {
              "set": "count",
              "to": "count + 1"
            },
            {
              "emit": "mfp-accepted"
            }
          ],
          "faultOnly": true,
          "description": "Defect: allows a request over the limit."
        },
        {
          "id": "mfp-new-window",
          "from": "mfp-open",
          "to": "mfp-open",
          "on": "mfp-requested",
          "guard": "!(windowOpen && windowStart <= time && time - windowStart < 60)",
          "effects": [
            {
              "set": "windowStart",
              "to": "time"
            },
            {
              "set": "windowOpen",
              "to": true
            },
            {
              "set": "count",
              "to": 1
            },
            {
              "emit": "mfp-accepted"
            }
          ]
        },
        {
          "id": "mfp-accept",
          "from": "mfp-open",
          "to": "mfp-open",
          "on": "mfp-requested",
          "guard": "count < limit",
          "effects": [
            {
              "set": "count",
              "to": "count + 1"
            },
            {
              "emit": "mfp-accepted"
            }
          ]
        },
        {
          "id": "mfp-refuse",
          "from": "mfp-open",
          "to": "mfp-open",
          "on": "mfp-requested",
          "effects": [
            {
              "emit": "mfp-refused"
            }
          ]
        },
        {
          "id": "mfp-tighten",
          "from": "mfp-open",
          "to": "mfp-open",
          "on": "mfp-tightened",
          "guard": "event.limit < limit",
          "effects": [
            {
              "set": "limit",
              "to": "event.limit"
            }
          ]
        }
      ]
    },
    {
