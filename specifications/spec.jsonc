    {
      "id": "error-code-of",
      "description": "backend app.rs ApiError::domain, the error code of a kernel rejection: Unauthorized is unauthenticated for an anonymous caller (no session) and forbidden otherwise; TenantNotFound, UnknownObject, UnknownRecord and UnknownQuery are not_found; VersionConflict and SchemaConflict conflict; TenantMismatch and InsufficientState internal; every other kind invalid. The status of each code is system.generation.errorKinds of WG-4893 (401, 403, 404, 409, 500, 422). The backend test crates/backend/tests/spec_agreement.rs (a_kernel_rejection_is_answered_with_the_code_and_status_the_specification_states) compares the generated function with ApiError::domain for every kind and checks each status against system.generation.errorKinds.",
      "params": [
        {
          "name": "kind",
          "type": "error-kind"
        },
        {
          "name": "anonymous",
          "type": "bool"
        }
      ],
      "returns": "error-code",
      "body": "match kind { unauthorized => if anonymous then error-code.unauthenticated else error-code.forbidden, tenant-not-found => error-code.not_found, unknown-object => error-code.not_found, unknown-record => error-code.not_found, unknown-query => error-code.not_found, version-conflict => error-code.conflict, schema-conflict => error-code.conflict, tenant-mismatch => error-code.internal, insufficient-state => error-code.internal, _ => error-code.invalid }",
      "examples": [
        {
          "args": {
            "kind": "unauthorized",
            "anonymous": true
          },
          "result": "unauthenticated"
        },
        {
          "args": {
            "kind": "unauthorized",
            "anonymous": false
          },
          "result": "forbidden"
        },
        {
          "args": {
            "kind": "unknown-query",
            "anonymous": false
          },
          "result": "not_found"
        },
        {
          "args": {
            "kind": "schema-conflict",
            "anonymous": true
          },
          "result": "conflict"
        },
        {
          "args": {
            "kind": "insufficient-state",
            "anonymous": false
          },
          "result": "internal"
        },
        {
          "args": {
            "kind": "unique-violated",
            "anonymous": false
          },
          "result": "invalid"
        },
        {
          "args": {
            "kind": "tenant-not-found",
            "anonymous": false
          },
          "result": "not_found"
        },
        {
          "args": {
            "kind": "unknown-object",
            "anonymous": false
          },
          "result": "not_found"
        },
        {
          "args": {
            "kind": "tenant-mismatch",
            "anonymous": false
          },
          "result": "internal"
        }
      ]
    },
    {
      "id": "api-error-of",
      "description": "backend app.rs ApiError::domain: a kernel rejection as the error body (ErrorReply): its code (error-code-of, anonymous when the context has no session), message, the Debug name of its kind, the checks that failed, and the request's correlation id, which the route sets (with_correlation).",
      "params": [
        {
          "name": "error",
          "type": "domain-error"
        },
        {
          "name": "context",
          "type": "context"
        }
      ],
      "returns": "api-error",
      "body": "api-error{code: call error-code-of(error.kind, context.session == null), message: error.message, kind: call error-kind-debug(error.kind), failed: filter(c in error.evidence, !c.passed), correlation: context.correlation}",
      "examples": [
        {
          "args": {
            "error": {
              "kind": "unauthorized",
              "message": "Anonymous may not Create Object(ObjectTypeId(\"post\"))",
              "evidence": [
                {
                  "rule": "policy:none",
                  "passed": false,
                  "detail": "no policy grants Create on Object(ObjectTypeId(\"post\"))"
                }
              ]
            },
            "context": {
              "tenant": "alpha",
              "principal": "anonymous",
              "session": null,
              "now": 3000,
              "correlation": "c-1"
            }
          },
          "result": {
            "code": "unauthenticated",
            "message": "Anonymous may not Create Object(ObjectTypeId(\"post\"))",
            "kind": "Unauthorized",
            "failed": [
              {
                "rule": "policy:none",
                "passed": false,
                "detail": "no policy grants Create on Object(ObjectTypeId(\"post\"))"
              }
            ],
            "correlation": "c-1"
          }
        },
        {
          "args": {
            "error": {
              "kind": "version-conflict",
              "message": "record is at version 2, expected 1",
              "evidence": [
                {
                  "rule": "policy:builtin_owner",
                  "passed": true,
                  "detail": "Update on Object(ObjectTypeId(\"post\"))"
                },
                {
                  "rule": "record:version",
                  "passed": false,
                  "detail": "record is at version 2, expected 1"
                }
              ]
            },
            "context": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:owner"
              },
              "session": "s-1",
              "now": 3000,
              "correlation": "c-1"
            }
          },
          "result": {
            "code": "conflict",
            "message": "record is at version 2, expected 1",
            "kind": "VersionConflict",
            "failed": [
              {
                "rule": "record:version",
                "passed": false,
                "detail": "record is at version 2, expected 1"
              }
            ],
            "correlation": "c-1"
          }
        }
      ]
    },
    {
      "id": "store-error-code",
      "description": "backend app.rs From<StoreError> for ApiError: Conflict is conflict, NotFound not_found, Invalid invalid, Unavailable unavailable, Corrupt internal. The backend test crates/backend/tests/spec_agreement.rs (a_store_failure_is_answered_with_the_code_the_specification_states) compares the generated function and the generic messages of store-api-error with From<StoreError> for ApiError.",
      "params": [
        {
          "name": "kind",
          "type": "store-error-kind"
        }
      ],
      "returns": "error-code",
      "body": "match kind { conflict => error-code.conflict, not-found => error-code.not_found, invalid => error-code.invalid, unavailable => error-code.unavailable, corrupt => error-code.internal }",
      "examples": [
        {
          "args": {
            "kind": "conflict"
          },
          "result": "conflict"
        },
        {
          "args": {
            "kind": "corrupt"
          },
          "result": "internal"
        },
        {
          "args": {
            "kind": "not-found"
          },
          "result": "not_found"
        },
        {
          "args": {
            "kind": "invalid"
          },
          "result": "invalid"
        }
      ]
    },
    {
      "id": "store-api-error",
      "description": "backend app.rs From<StoreError> for ApiError and ApiError::hidden: a store failure as the error body, with the generic message of its code (the detail is logged, not sent), no kind and no checks.",
      "params": [
        {
          "name": "error",
          "type": "store-error"
        },
        {
          "name": "context",
          "type": "context"
        }
      ],
      "returns": "api-error",
      "body": "let code = call store-error-code(error.kind) in api-error{code, message: match code { conflict => 'Someone else changed this at the same moment. Try again.', unavailable => 'The service is not available right now.', not_found => 'That could not be found.', invalid => 'The request could not be stored.', _ => 'Something went wrong on our side.' }, failed: [], correlation: context.correlation}",
      "examples": [
        {
          "args": {
            "error": {
              "kind": "unavailable",
              "message": "disk full"
            },
            "context": {
              "tenant": "alpha",
              "principal": "anonymous",
              "session": null,
              "now": 3000,
              "correlation": "c-1"
            }
          },
          "result": {
            "code": "unavailable",
            "message": "The service is not available right now.",
            "kind": null,
            "failed": [],
            "correlation": "c-1"
          }
        },
        {
          "args": {
            "error": {
              "kind": "corrupt",
              "message": "bad row"
            },
            "context": {
              "tenant": "alpha",
              "principal": "anonymous",
              "session": null,
              "now": 3000,
              "correlation": "c-1"
            }
          },
          "result": {
            "code": "internal",
            "message": "Something went wrong on our side.",
            "kind": null,
            "failed": [],
            "correlation": "c-1"
          }
        },
        {
          "args": {
            "error": {
              "kind": "conflict",
              "message": "m"
            },
            "context": {
              "tenant": "alpha",
              "principal": "anonymous",
              "session": null,
              "now": 3000,
              "correlation": "c-1"
            }
          },
          "result": {
            "code": "conflict",
            "message": "Someone else changed this at the same moment. Try again.",
            "failed": [],
            "correlation": "c-1"
          }
        },
        {
          "args": {
            "error": {
              "kind": "not-found",
              "message": "m"
            },
            "context": {
              "tenant": "alpha",
              "principal": "anonymous",
              "session": null,
              "now": 3000,
              "correlation": "c-1"
            }
          },
          "result": {
            "code": "not_found",
            "message": "That could not be found.",
            "failed": [],
            "correlation": "c-1"
          }
        },
        {
          "args": {
            "error": {
              "kind": "invalid",
              "message": "m"
            },
            "context": {
              "tenant": "alpha",
              "principal": "anonymous",
              "session": null,
              "now": 3000,
              "correlation": "c-1"
            }
          },
          "result": {
            "code": "invalid",
            "message": "The request could not be stored.",
            "failed": [],
            "correlation": "c-1"
          }
        }
      ]
    },
    {
      "id": "read-needs",
      "description": "crates/kernel/src/read.rs read_needs, the pure body of contract plan-read-needs (CT-004): a window of at most 200 records of the object type a named query reads after its cursor when the query is served by a window (KRN-1286), else the first 10001 records of it, to decide the scan bound (KRN-1288); nothing for an unknown query or a read the kernel refuses; each record a records request names, nothing for one that names more than 200.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "request",
          "type": "read-request"
        }
      ],
      "returns": "list<need>",
      "body": "match request { named{query, page-size, cursor} => match get(schema.queries, query) { Some(def) => if length(call query-page-errors(def, page-size, cursor)) == 0 then [need.page-of{object: def.object, after: call cursor-after(cursor), limit: if call query-windowed(def) then 200 else 10001}] else [], None => [] }, records{object, ids} => if length(ids) > 200 then [] else map(id in ids, need.record{object, id}) }",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-16"
            },
            "request": {
              "named": {
                "query": "published",
                "params": {}
              }
            }
          },
          "result": [
            {
              "page-of": {
                "object": "post",
                "after": null,
                "limit": 10001
              }
            }
          ]
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-16"
            },
            "request": {
              "records": {
                "object": "person",
                "ids": [
                  1,
                  3
                ]
              }
            }
          },
          "result": [
            {
              "record": {
                "object": "person",
                "id": 1
              }
            },
            {
              "record": {
                "object": "person",
                "id": 3
              }
            }
          ]
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-16"
            },
            "request": {
              "named": {
                "query": "nothing",
                "params": {}
              }
            }
          },
          "result": []
        },
        {
          "description": "A query with no filter and no order is served by a window of at most 200 records.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-17"
            },
            "request": {
              "named": {
                "query": "all_posts",
                "params": {}
              }
            }
          },
          "result": [
            {
              "page-of": {
                "object": "post",
                "after": null,
                "limit": 200
              }
            }
          ]
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-17"
            },
            "request": {
              "named": {
                "query": "all_posts",
                "params": {},
                "page-size": 10,
                "cursor": {
                  "after": 3
                }
              }
            }
          },
          "result": [
            {
              "page-of": {
                "object": "post",
                "after": 3,
                "limit": 200
              }
            }
          ]
        },
        {
          "description": "A page size the kernel refuses needs nothing.",
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-17"
            },
            "request": {
              "named": {
                "query": "all_posts",
                "params": {},
                "page-size": 0
              }
            }
          },
          "result": []
        },
        {
          "description": "A read that names more than 200 ids needs nothing.",
          "args": {
