    {
      "id": "operation-problems",
      "description": "definitions.rs operation_problems (D-6546 to D-6549, OPR-1549): the problems of each tenant operation in id order.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "roles",
          "type": "list<role-id>"
        }
      ],
      "returns": "list<string>",
      "body": "fold(op in values(call operations-of(schema)), ps = [], concat(ps, call operation-def-problems(schema, roles, op)))",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-10",
              "with": {
                "operations": {
                  "redeem": {
                    "id": "redeem",
                    "label": "Redeem",
                    "inputs": [
                      {
                        "name": "note",
                        "ty": {
                          "ref": {
                            "target": "note",
                            "on-delete": "restrict"
                          }
                        },
                        "required": true
                      }
                    ],
                    "invokers": {
                      "signed-in": true,
                      "roles": []
                    },
                    "subject": {
                      "object": "note",
                      "input": "note"
                    },
                    "conditions": [
                      {
                        "id": "drafted",
                        "expr": {
                          "cmp": {
                            "op": "eq",
                            "left": {
                              "var": {
                                "scope": "record",
                                "field": "status"
                              }
                            },
                            "right": {
                              "lit": {
                                "str": "draft"
                              }
                            }
                          }
                        },
                        "error": "not-draft",
                        "message": "Only a draft."
                      }
                    ],
                    "steps": [
                      {
                        "create-record": {
                          "id": "copy",
                          "object": "note",
                          "fields": {
                            "title": {
                              "var": {
                                "scope": "record",
                                "field": "title"
                              }
                            },
                            "status": {
                              "lit": {
                                "str": "draft"
                              }
                            }
                          }
                        }
                      },
                      {
                        "update-record": {
                          "id": "touch",
                          "object": "note",
                          "record": {
                            "param": "copy"
                          },
                          "fields": {
                            "rank": {
                              "lit": {
                                "int": 1
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            },
            "roles": [
              "editor",
              "owner",
              "public"
            ]
          },
          "result": []
        }
      ]
    },
    {
      "id": "holds-power",
      "description": "rules.rs holds_power (D-6547): whether a principal holds an action on a resource without a condition, which is holds-policy-power with no condition: the owner does, a role permission on the object type gives it, and so does a policy of one of its roles that names the action, reaches the resource and has no condition.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "principal",
          "type": "principal"
        },
        {
          "name": "action",
          "type": "action"
        },
        {
          "name": "resource",
          "type": "resource"
        }
      ],
      "returns": "bool",
      "body": "call holds-policy-power(tenant, principal, action, resource, null)",
      "examples": [
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-21"
            },
            "principal": {
              "user": "alpha:owner"
            },
            "action": "delete",
            "resource": {
              "object": "note"
            }
          },
          "result": true
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-21"
            },
            "principal": {
              "user": "alpha:editor"
            },
            "action": "create",
            "resource": {
              "object": "note"
            }
          },
          "result": true
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-21"
            },
            "principal": {
              "user": "alpha:writer1"
            },
            "action": "create",
            "resource": {
              "object": "note"
            }
          },
          "result": false
        },
        {
          "description": "An unconditional policy gives the power.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-22"
            },
            "principal": {
              "user": "alpha:writer1"
            },
            "action": "update",
            "resource": {
              "object": "note"
            }
          },
          "result": true
        },
        {
          "description": "A conditional policy does not.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-22"
            },
            "principal": {
              "user": "alpha:writer1"
            },
            "action": "read",
            "resource": {
              "object": "tag"
            }
          },
          "result": false
        },
        {
          "description": "A role permission is never Manage.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-22"
            },
            "principal": {
              "user": "alpha:writer1"
            },
            "action": "manage",
            "resource": {
              "object": "note"
            }
          },
          "result": false
        },
        {
          "description": "A role permission of read.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-22"
            },
            "principal": {
              "user": "alpha:writer1"
            },
            "action": "read",
            "resource": {
              "object": "note"
            }
          },
          "result": true
        },
        {
          "description": "Manage on the schema comes only from a policy.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-22"
            },
            "principal": {
              "user": "alpha:writer1"
            },
            "action": "manage",
            "resource": "schema"
          },
          "result": false
        }
      ]
    },
    {
      "id": "operation-lacks",
      "description": "transition.rs require_operation_powers: what the definer of a tenant operation lacks (D-6547, OPR-1547): each action on an object type a record step uses that it does not hold (holds-power), once, in step order, written <Action> on <Resource>; then capability ledger-post when a step posts and the definer, not an owner, does not hold it.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "principal",
          "type": "principal"
        },
        {
          "name": "op",
          "type": "tenant-operation-def"
        }
      ],
      "returns": "list<string>",
      "let": [
        {
          "name": "actions",
          "expr": "fold(s in op.steps, acc = [], let one = match s { create-record{object} => if call holds-power(tenant, principal, action.create, resource.object(object)) then [] else [format('{} on {}', call action-debug(action.create), call resource-debug(resource.object(object)))], update-record{object} => if call holds-power(tenant, principal, action.update, resource.object(object)) then [] else [format('{} on {}', call action-debug(action.update), call resource-debug(resource.object(object)))], delete-record{object} => if call holds-power(tenant, principal, action.delete, resource.object(object)) then [] else [format('{} on {}', call action-debug(action.delete), call resource-debug(resource.object(object)))], post-ledger => [] } in fold(x in one, acc2 = acc, if any(y in acc2, y == x) then acc2 else concat(acc2, [x])))"
        },
        {
          "name": "posts",
          "expr": "any(s in op.steps, match s { post-ledger => true, _ => false })"
        },
        {
          "name": "holds-post",
          "expr": "any(r in call roles-of(tenant, principal), r == 'owner') || any(g in call effective-permissions(tenant, principal), g == grant.capability('ledger-post'))"
        }
      ],
      "body": "concat(actions, if posts && !holds-post then ['capability ledger-post'] else [])",
      "examples": [
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-21"
            },
            "principal": {
              "user": "alpha:owner"
            },
            "op": {
              "fixture": "fx-tenant-operation-def-2"
            }
          },
          "result": []
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-21"
            },
            "principal": {
              "user": "alpha:editor"
            },
            "op": {
              "fixture": "fx-tenant-operation-def-2"
            }
          },
          "result": [
            "Update on Object(ObjectTypeId(\"note\"))",
            "capability ledger-post"
          ]
        },
        {
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-21"
            },
            "principal": {
              "user": "alpha:writer1"
            },
            "op": {
              "fixture": "fx-tenant-operation-def-1"
            }
          },
          "result": [
            "Create on Object(ObjectTypeId(\"note\"))",
            "Update on Object(ObjectTypeId(\"note\"))"
          ]
        },
        {
          "description": "Each lacked power once, in step order.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-21"
            },
            "principal": {
              "user": "alpha:editor"
            },
            "op": {
              "fixture": "fx-tenant-operation-def-1",
              "with": {
                "steps": [
                  {
                    "delete-record": {
                      "id": "a",
                      "object": "note",
                      "record": {
                        "param": "note"
                      }
                    }
                  },
                  {
                    "delete-record": {
                      "id": "b",
                      "object": "note",
                      "record": {
                        "param": "note"
                      }
                    }
                  },
                  {
                    "create-record": {
                      "id": "c",
                      "object": "note",
                      "fields": {}
                    }
                  }
                ]
              }
            }
          },
          "result": [
            "Delete on Object(ObjectTypeId(\"note\"))"
          ]
        },
        {
          "description": "An owner holds every power.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-21"
            },
            "principal": {
              "user": "alpha:owner"
            },
            "op": {
              "fixture": "fx-tenant-operation-def-1",
              "with": {
                "steps": [
                  {
                    "delete-record": {
                      "id": "a",
                      "object": "note",
                      "record": {
                        "param": "note"
                      }
                    }
                  }
                ]
              }
            }
          },
          "result": []
        }
      ]
    },
    {
      "id": "require-capability",
      "description": "transition.rs require_capability: the acting principal holds a capability (the owner holds every one); the check permission:capability:<name> is evidence, and a principal without it is refused as Unauthorized.",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "name",
          "type": "string"
        }
      ],
      "returns": "draft",
      "errors": "rejection",
      "let": [
        {
          "name": "rule",
          "expr": "format('permission:capability:{}', name)"
        },
        {
          "name": "holds",
          "expr": "any(r in call roles-of(d.tenant, d.ctx.principal), r == 'owner') || any(g in call effective-permissions(d.tenant, d.ctx.principal), g == grant.capability(name))"
        }
      ],
      "body": "if holds then draft{tenant: d.tenant, ctx: d.ctx, coverage: d.coverage, ops: d.ops, events: d.events, effects: d.effects, evidence: concat(d.evidence, [check{rule, passed: true, detail: format('holds {}', name)}]), next-record: d.next-record} else fail(call draft-reject(concat(d.evidence, [check{rule, passed: false, detail: format('does not hold {}', name)}]), error-kind.unauthorized, format('the change needs the capability {}', name)))",
      "examples": [
        {
          "args": {
            "d": {
              "fixture": "fx-draft-21"
            },
            "name": "automations-define"
          },
          "result": {
            "tenant": {
              "id": "alpha",
              "name": "alpha",
              "revision": 5,
              "next-record": 4,
              "event-seq": 5,
              "schema": {
                "version": 2,
                "objects": {
                  "note": {
                    "id": "note",
                    "label": "Note",
                    "fields": {
                      "rank": {
                        "id": "rank",
                        "label": "rank",
                        "ty": "int",
                        "required": false,
                        "unique": false
                      },
                      "status": {
                        "id": "status",
                        "label": "status",
                        "ty": "str",
                        "required": true,
                        "unique": false
                      },
                      "tags": {
                        "id": "tags",
                        "label": "tags",
                        "ty": {
                          "list": "str"
                        },
                        "required": false,
                        "unique": false
                      },
                      "title": {
                        "id": "title",
                        "label": "title",
                        "ty": "str",
                        "required": true,
                        "unique": false
                      }
                    },
                    "constraints": {}
                  }
                },
                "roles": {
                  "editor": {
                    "id": "editor",
                    "label": "Editor"
                  },
                  "owner": {
                    "id": "owner",
                    "label": "Owner"
                  },
                  "public": {
                    "id": "public",
                    "label": "Everyone"
                  },
                  "writer": {
                    "id": "writer",
                    "label": "Writer"
                  }
                },
                "policies": {},
                "workflows": {
                  "note_status": {
                    "id": "note_status",
                    "object": "note",
                    "field": "status",
                    "initial": [
                      "draft"
                    ],
                    "transitions": [
                      {
                        "name": "publish",
                        "from": "draft",
                        "to": "published",
                        "set": {}
                      }
                    ]
                  }
                },
                "queries": {},
                "views": {},
                "role-permissions": {
                  "editor": [
                    {
                      "object": {
                        "object": "note",
                        "actions": [
                          "read",
                          "create"
                        ]
                      }
                    },
                    {
                      "capability": "automations-define"
                    }
                  ],
                  "writer": [
                    {
                      "object": {
                        "object": "note",
                        "actions": [
                          "read"
                        ]
                      }
                    }
                  ]
                }
              },
              "members": {
                "alpha:editor": [
                  "editor"
                ],
                "alpha:owner": [
                  "owner"
                ],
                "alpha:writer1": [
                  "writer"
                ]
              },
              "records": {
                "note": {
                  "1": {
                    "id": 1,
                    "object": "note",
                    "version": 1,
                    "created-by": "alpha:writer1",
                    "created-at": 5000,
                    "updated-at": 5000,
                    "fields": {
                      "status": {
                        "str": "draft"
                      },
                      "title": {
                        "str": "First"
                      }
                    }
                  },
                  "2": {
                    "id": 2,
                    "object": "note",
                    "version": 1,
                    "created-by": "alpha:writer1",
                    "created-at": 5000,
                    "updated-at": 5000,
                    "fields": {
                      "status": {
                        "str": "draft"
                      },
                      "title": {
                        "str": "Second"
                      }
                    }
                  }
                }
              }
            },
            "ctx": {
              "tenant": "alpha",
              "principal": {
                "user": "alpha:editor"
              },
              "now": 5000,
              "correlation": "test-5000"
            },
            "coverage": "complete",
            "ops": [],
