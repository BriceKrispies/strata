    {
      "id": "validate-record",
      "description": "rules.rs validate_record: validate a whole candidate record (of the schema it reads only the workflows, so the examples give no others): unknown fields, then per declared field (in id order) required, type, unique and reference, then workflow states, and the constraints only when nothing failed. old is the stored record on update. The roles are rules.rs roles_of(lookup.tenant, principal); a unique clash names the other record only when read.rs visible lets the principal read it. texts holds the printed constraint expressions (the print gap of WG-4957).",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "coverage",
          "type": "coverage"
        },
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "object",
          "type": "object-type-def"
        },
        {
          "name": "candidate",
          "type": "record"
        },
        {
          "name": "old",
          "type": "option<record>"
        },
        {
          "name": "principal",
          "type": "principal"
        },
        {
          "name": "now",
          "type": "timestamp"
        },
        {
          "name": "texts",
          "type": "map<constraint-id, string>"
        }
      ],
      "returns": "validation-outcome",
      "errors": "rejection",
      "let": [
        {
          "name": "roles",
          "expr": "call roles-of(tenant, principal)"
        },
        {
          "name": "unknown",
          "expr": "call unknown-field-checks(object, candidate)"
        },
        {
          "name": "checked",
          "expr": "fold(f in values(object.fields), a = unknown, try call field-step(tenant, coverage, object, candidate, principal, now, a, f))"
        },
        {
          "name": "flows",
          "expr": "call workflow-checks(schema, object, candidate, checked)"
        }
      ],
      "body": "if flows.failed == [] then call constraint-checks(object, candidate, old, principal, now, roles, texts, flows) else flows",
      "examples": [
        {
          "description": "behaviour.rs create_applies_defaults_and_allocates_the_next_id: a valid note.",
          "args": {
