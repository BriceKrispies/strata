    {
      "id": "authorize-needing",
      "description": "crates/kernel/src/rules.rs authorize_needing: authorize with the snapshot's lookup when coverage is given (the coverage of the snapshot the decision is made on), and none when it is not. A condition follows a reference through rule-lookup; a condition that fails to evaluate denies, as in authorize, and the first record such a condition needs that the snapshot does not cover is needed, so the caller answers InsufficientState naming it rather than deny on a record that was merely not loaded. needed is none when the decision is allowed.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "principal",
          "type": "principal"
        },
        {
          "name": "now",
          "type": "timestamp"
        },
        {
          "name": "action",
          "type": "action"
        },
        {
          "name": "resource",
          "type": "resource"
        },
        {
          "name": "subject",
          "type": "subject"
        },
        {
          "name": "coverage",
          "type": "option<coverage>"
        }
      ],
      "returns": "policy-decision",
      "let": [
        {
          "name": "roles",
          "expr": "call roles-of(tenant, principal)"
        },
        {
          "name": "what",
          "expr": "call request-text(action, resource)"
        }
      ],
      "body": "if any(r in roles, r == 'owner') then policy-decision{allowed: true, checks: [policy-check{rule: 'policy:builtin_owner', passed: true, what, outcome: policy-outcome.owner}]} else if (match resource { object(_) => any(g in call effective-permissions(tenant, principal), call grant-allows(g, action, resource)), _ => false }) then policy-decision{allowed: true, checks: [policy-check{rule: 'permission:role', passed: true, what, outcome: policy-outcome.unconditional}]} else let env = expr-env{record: call scope-of(if subject.old == null then subject.new else subject.old), old: call scope-of(subject.old), new: call scope-of(subject.new), param: {}, now: value.time(now), principal: match principal { user(id) => value.str(id), _ => call null-value() }, has_role: roles} in let reach = match coverage { Some(cv) => rule-reach{tenant, coverage: cv, subject}, None => null } in let lookup = match reach { Some(r) => call rule-lookup(r), None => {} } in let state = fold(p in values(schema.policies), acc = policy-progress{granted: null, checks: []}, if acc.granted != null || !call policy-applies(p, roles, action, resource) then acc else call policy-step(p, env, acc, what, lookup, reach)) in match state.granted { Some(c) => policy-decision{allowed: true, checks: [c]}, None => policy-decision{allowed: false, needed: state.needed, checks: if state.checks == [] then [policy-check{rule: 'policy:none', passed: false, what, outcome: policy-outcome.no-policy}] else state.checks} }",
      "examples": [
        {
          "description": "publication_template.rs an_author_cannot_publish_under_another_authors_byline: with the lookup, ann files a post under her own byline; authors_write_posts holds on the author record.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-25"
            },
            "schema": {
              "fixture": "fx-tenant-schema-29"
            },
            "principal": {
              "user": "user:ann"
            },
            "now": 1800000000000,
            "action": "create",
            "resource": {
              "object": "post"
            },
            "subject": {
              "new": {
                "id": 7,
                "object": "post",
                "version": 1,
                "created-by": "user:ann",
                "created-at": 1800000000000,
                "updated-at": 1800000000000,
                "fields": {
                  "author": {
                    "ref": 2
                  },
                  "title": {
                    "str": "Hello"
                  }
                }
              }
            },
            "coverage": "complete"
          },
          "result": {
            "allowed": true,
            "checks": [
              {
                "rule": "policy:authors_write_posts",
                "passed": true,
                "what": "Create on Object(ObjectTypeId(\"post\"))",
                "outcome": "held",
                "condition": {
                  "cmp": {
                    "op": "eq",
                    "left": {
                      "through": {
                        "scope": "new",
                        "reference": "author",
                        "field": "principal"
                      }
                    },
                    "right": "principal"
                  }
                }
              }
            ]
          }
        },
        {
          "description": "Bob files a post under ann's byline: the author record's principal is not bob, so policy:authors_write_posts is false.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-25"
            },
            "schema": {
              "fixture": "fx-tenant-schema-29"
            },
            "principal": {
              "user": "user:bob"
            },
            "now": 1800000000000,
            "action": "create",
            "resource": {
              "object": "post"
            },
            "subject": {
              "new": {
                "id": 7,
                "object": "post",
                "version": 1,
                "created-by": "user:ann",
                "created-at": 1800000000000,
                "updated-at": 1800000000000,
                "fields": {
                  "author": {
                    "ref": 2
                  },
                  "title": {
                    "str": "Hello"
                  }
                }
              }
            },
            "coverage": "complete"
          },
          "result": {
            "allowed": false,
            "checks": [
              {
                "rule": "policy:authors_write_posts",
                "passed": false,
                "what": "Create on Object(ObjectTypeId(\"post\"))",
                "outcome": "is-false",
                "condition": {
                  "cmp": {
                    "op": "eq",
                    "left": {
                      "through": {
                        "scope": "new",
                        "reference": "author",
                        "field": "principal"
                      }
                    },
                    "right": "principal"
                  }
                }
              }
            ]
          }
        },
        {
          "description": "The snapshot holds the post but not the author record: the condition fails to evaluate, and the decision names the author record as needed.",
