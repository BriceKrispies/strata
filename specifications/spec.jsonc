        },
        {
          "name": "field",
          "type": "field-id"
        },
        {
          "name": "value",
          "type": "string",
          "description": "The canonical JSON of one scalar field value or list element, up to 240 bytes."
        },
        {
          "name": "id",
          "type": "record-id",
          "refersTo": "tbl-records",
          "onDelete": "cascade"
        }
      ],
      "description": "Table record_index of a tenant file: one row per scalar field value and list element, so that uniqueness and reference lookups do not scan."
    },
