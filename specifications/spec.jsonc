    {
      "id": "change-schema",
      "description": "transition.rs change_schema: Manage on Schema is authorised; a stale expected version is SchemaConflict; no changes is InvalidIntent; more than 200 changes in one intent is LimitExceeded (KRN-1283); then the authority a change of definitions asks (require-definition-authority: automations-define for triggers and automations, the run-as roles of an automation under ADM-152, the step powers of a tenant operation under D-6547); then plan-migration, whose refusal keeps its kind, message and missing need with the draft's evidence before its own. The change's lines pass as schema:change, and every violation is a failed check existing:<object>/<id>:<rule>; in Reject mode any record that would not conform refuses the change with MigrationRejected (\"<n> existing record(s) ...\"), in Grandfather mode it is accepted: the new schema, the rewritten records (each with its RecordUpdated event after the SchemaChanged event, the record one version higher and updated now) and a SchemaChanged event counting the records that do not conform. The definitions of triggers and automations are stamped with their definer and time first (stamp-definitions, D-7204). After the plan, the overrides, revisions and events a change of setting definitions brings (setting-change-effects) follow the schema change in the delta and the events. After the authority, a unit or a pool an account names is not removed (ledger-removal-check, LDG-1549).",
      "params": [
        {
          "name": "d",
          "type": "draft"
        },
        {
          "name": "changes",
          "type": "list<schema-change>"
        },
        {
          "name": "expected-version",
          "type": "option<schema-version>"
        },
        {
          "name": "existing",
          "type": "existing-data"
        }
      ],
      "returns": "decided",
      "errors": "rejection",
      "let": [
        {
          "name": "d1",
          "expr": "try call require(d, action.manage, resource.schema, subject{})"
        },
        {
          "name": "current",
          "expr": "d1.tenant.schema.version"
        },
        {
          "name": "stale",
          "expr": "match expected-version { Some(e) => e != current, None => false }"
        },
        {
          "name": "stamped",
          "expr": "call stamp-definitions(changes, d.ctx)"
        }
      ],
      "body": "if stale then fail(call draft-reject(d1.evidence, error-kind.schema-conflict, format('schema is at version {}, expected {}', current, match expected-version { Some(e) => e, None => 0 }))) else if changes == [] then fail(call draft-reject(d1.evidence, error-kind.invalid-intent, 'no changes given')) else if length(changes) > 200 then fail(call draft-reject(d1.evidence, error-kind.limit-exceeded, format('{} changes in one schema change is more than the maximum of 200', length(changes)))) else let d2 = try call require-definition-authority(d1, stamped) in let d3 = try call ledger-removal-check(d2, stamped) in let plan = match call plan-migration(d3.tenant, d3.coverage, stamped, d3.ctx.now) { Ok(m) => m, Err(e) => match e { rejected(err) => fail(rejection.rejected(domain-error{kind: err.kind, message: err.message, evidence: concat(d3.evidence, err.evidence), missing: err.missing})) } } in let fx = try call setting-change-effects(d3.tenant, stamped, d3.evidence) in let affected = fold(a in fold(k in sortBy(k in map(x in plan.violations, format('{}/{}', x.object, x.id)), k), ks = [], if any(a in ks, a == k) then ks else concat(ks, [k])), n = 0, n + 1) in let evidence = concat(concat(d3.evidence, map(l in plan.summary, check{rule: 'schema:change', passed: true, detail: l})), map(x in plan.violations, check{rule: format('existing:{}/{}:{}', x.object, x.id, x.check.rule), passed: false, detail: x.check.detail})) in if existing == existing-data.reject && affected > 0 then fail(call draft-reject(evidence, error-kind.migration-rejected, format('{} existing record(s) would not conform to the new schema', affected))) else decided{draft: draft{tenant: d3.tenant, ctx: d3.ctx, coverage: d3.coverage, ops: concat(concat(concat(d3.ops, [delta-op.put-schema(plan.schema)]), fx.ops), map(r in plan.rewritten, delta-op.put-record(r))), events: concat(concat(concat(d3.events, [event-body.schema-changed{version: plan.schema.version, summary: plan.summary, grandfathered: affected}]), fx.events), map(r in plan.rewritten, event-body.record-updated{before: fold(b in values(match get(d3.tenant.records, r.object) { Some(m) => m, None => {} }), acc = r, if b.id == r.id then b else acc), after: r})), effects: d3.effects, evidence: evidence, next-record: d3.next-record}, output: output.schema{version: plan.schema.version}}",
      "examples": [
        {
          "description": "behaviour.rs a_strict_migration_is_rejected_when_existing_records_would_not_conform.",
          "args": {
            "d": {
              "fixture": "fx-draft-14"
            },
            "changes": [
              {
                "define-field": {
                  "object": "note",
                  "field": {
                    "id": "rank",
                    "label": "rank",
                    "ty": "int",
                    "required": true,
                    "unique": false
                  }
                }
              }
            ],
            "expected-version": null,
            "existing": "reject"
          },
          "error": {
            "rejected": {
              "kind": "migration-rejected",
              "message": "2 existing record(s) would not conform to the new schema",
              "evidence": [
                {
                  "rule": "policy:builtin_owner",
                  "passed": true,
                  "detail": "Manage on Schema"
                },
                {
                  "rule": "schema:change",
                  "passed": true,
                  "detail": "redefine field note.rank"
                },
                {
                  "rule": "existing:note/1:required:note.rank",
                  "passed": false,
                  "detail": "a value is required"
                },
                {
                  "rule": "existing:note/2:required:note.rank",
                  "passed": false,
                  "detail": "a value is required"
                }
              ],
              "missing": null
            }
          }
        },
