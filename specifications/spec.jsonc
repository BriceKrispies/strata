    {
      "id": "unique-step",
      "description": "rules.rs validate_record, one composite unique constraint (CMS-1554, CMS-1555): nothing when a field of it has no value; otherwise one lookup of the records with the same values (lookup-by-fields), and a clash with another record fails unique:<object>.<constraint> as UniqueViolated, naming the other record only when the principal may read it.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "coverage",
          "type": "coverage"
        },
        {
          "name": "object",
          "type": "object-type-def"
        },
        {
          "name": "candidate",
          "type": "record"
        },
        {
          "name": "principal",
          "type": "principal"
        },
        {
          "name": "now",
          "type": "timestamp"
        },
        {
          "name": "acc",
          "type": "validation-outcome"
        },
        {
          "name": "u",
          "type": "unique-def"
        }
      ],
      "returns": "validation-outcome",
      "errors": "rejection",
      "let": [
        {
          "name": "wanted",
          "expr": "fold(f in u.fields, m = {}, match get(candidate.fields, f) { Some(x) => if call value-is-null(x) then m else insert(m, f, x), None => m })"
        },
        {
          "name": "rule",
          "expr": "format('unique:{}.{}', object.id, u.id)"
        }
      ],
      "body": "if length(keys(wanted)) != length(u.fields) then acc else match find(o in try call lookup-by-fields(tenant, coverage, object.id, wanted), o.id != candidate.id) { Some(o) => if call visible(tenant, principal, o, now) then call outcome-fail(acc, error-kind.unique-violated, rule, format('{}: record {} already has these values', u.message, o.id)) else call outcome-fail(acc, error-kind.unique-violated, rule, format('{}: another record already has these values', u.message)), None => call outcome-pass(acc, rule, 'no other record has these values') }",
      "examples": [
        {
          "description": "No other record holds the values.",
          "args": {
            "tenant": {
              "fixture": "fx-tenant-state-21"
            },
            "coverage": "complete",
            "object": {
              "fixture": "fx-object-type-def-4"
            },
            "candidate": {
              "id": 3,
              "object": "note",
              "version": 1,
              "created-by": "alpha:writer1",
              "created-at": 5000,
              "updated-at": 5000,
              "fields": {
                "status": {
                  "str": "draft"
                },
                "title": {
                  "str": "Third"
                }
              }
            },
            "principal": {
              "user": "alpha:owner"
            },
            "now": 5000,
            "acc": {
              "passed": [],
              "failed": []
            },
            "u": {
              "id": "title_status",
              "fields": [
                "title",
                "status"
              ],
              "message": "One note per title and status."
            }
          },
          "result": {
            "passed": [
              {
                "rule": "unique:note.title_status",
                "passed": true,
                "detail": "no other record has these values"
              }
            ],
            "failed": []
          }
        },
        {
          "description": "Another record holds the values (CMS-1554).",
