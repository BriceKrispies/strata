    {
      "id": "workflow-problems",
      "description": "schema.rs TenantSchema::problems, one workflow: an unknown object type (nothing else is checked), a field that is unknown or not a string, no initial state, and per transition a guard and each set expression (in field order) that does not check, and a set field the type does not declare.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "roles",
          "type": "list<role-id>"
        },
        {
          "name": "workflow",
          "type": "workflow-def"
        }
      ],
      "returns": "list<string>",
      "let": [
        {
          "name": "at",
          "expr": "format('workflow {}', workflow.id)"
        }
      ],
      "body": "match get(schema.objects, workflow.object) { None => [format('{}: unknown object type {}', at, workflow.object)], Some(o) => let env = expr-check-env{fields: call field-shapes(o.fields), params: [], roles} in concat(concat(match get(o.fields, workflow.field) { Some(f) => match f.ty { str => [], _ => [format('{}: field {} is not a string', at, workflow.field)] }, None => [format('{}: unknown field {}', at, workflow.field)] }, if workflow.initial == [] then [format('{}: no initial state', at)] else []), fold(t in workflow.transitions, ps = [], concat(concat(ps, match t.guard { Some(g) => match check(tenant-rule-language, g, env) { Ok(_) => [], Err(e) => [format('{}.{}: guard: {}', at, t.name, e)] }, None => [] }), fold(k in keys(t.set), qs = [], concat(concat(qs, if get(o.fields, k) == null then [format('{}.{}: sets unknown field {}', at, t.name, k)] else []), match get(t.set, k) { Some(e2) => match check(tenant-rule-language, e2, env) { Ok(_) => [], Err(e) => [format('{}.{}: set {}: {}', at, t.name, k, e)] }, None => [] }))))) }",
      "examples": [
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-4"
            },
            "roles": [
              "editor",
              "owner",
              "public",
              "writer"
            ],
            "workflow": {
              "fixture": "fx-workflow-def-1"
            }
          },
          "result": []
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-4"
            },
            "roles": [
              "editor",
              "owner",
              "public",
              "writer"
            ],
            "workflow": {
              "fixture": "fx-workflow-def-1",
              "with": {
                "id": "w",
                "object": "tag"
              }
            }
          },
          "result": [
            "workflow w: unknown object type tag"
          ]
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-4"
            },
            "roles": [
              "editor",
              "owner",
              "public",
              "writer"
            ],
            "workflow": {
              "id": "w",
              "object": "note",
              "field": "rank",
              "initial": [],
              "transitions": [
                {
                  "name": "go",
                  "from": "a",
                  "to": "b",
                  "guard": {
                    "cmp": {
                      "op": "eq",
                      "left": {
                        "param": "p"
                      },
                      "right": {
                        "lit": {
                          "str": "x"
                        }
                      }
                    }
                  },
                  "set": {
                    "colour": {
                      "lit": {
                        "str": "red"
                      }
                    },
                    "rank": {
                      "var": {
                        "scope": "old",
                        "field": "nope"
                      }
                    }
                  }
                }
              ]
            }
          },
          "result": [
            "workflow w: field rank is not a string",
            "workflow w: no initial state",
            "workflow w.go: guard: undeclared parameter p",
            "workflow w.go: sets unknown field colour",
            "workflow w.go: set rank: unknown field nope"
          ]
        },
        {
          "args": {
            "schema": {
              "fixture": "fx-tenant-schema-4"
            },
            "roles": [
              "editor",
              "owner",
              "public",
              "writer"
            ],
            "workflow": {
              "fixture": "fx-workflow-def-1",
              "with": {
                "id": "w",
                "field": "mood"
              }
            }
          },
          "result": [
            "workflow w: unknown field mood"
          ]
        }
      ]
    },
    {
      "id": "query-problems",
      "description": "schema.rs TenantSchema::problems, one query: an unknown object type (nothing else is checked), a filter that does not check against the fields and the query's parameters, and each order key read as record.<field> that does not check.",
      "params": [
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "roles",
          "type": "list<role-id>"
        },
        {
          "name": "query",
          "type": "query-def"
        }
      ],
      "returns": "list<string>",
      "let": [
        {
          "name": "at",
          "expr": "format('query {}', query.id)"
        }
      ],
      "body": "match get(schema.objects, query.object) { None => [format('{}: unknown object type {}', at, query.object)], Some(o) => let env = expr-check-env{fields: call field-shapes(o.fields), params: query.params, roles} in concat(match query.filter { Some(fl) => match check(tenant-rule-language, fl, env) { Ok(_) => [], Err(e) => [format('{}: filter: {}', at, e)] }, None => [] }, fold(k in query.order, ps = [], match check(tenant-rule-language, expr.var{scope: scope.record, field: k.field}, env) { Ok(_) => ps, Err(e) => concat(ps, [format('{}: order: {}', at, e)]) })) }",
      "examples": [
        {
