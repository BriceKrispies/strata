    {
      "id": "job-admission-burst-of-350",
      "name": "A tenant schedules 350 jobs for one minute",
      "description": "A burst of 250 jobs becomes due at tick 0, 100 more at tick 30, and a job of another tenant is due at tick 10, while the backlog is being released.",
      "behaviors": [
        "job-admission-flow"
      ],
      "steps": [
        {
          "at": 0,
          "event": "ad-burst",
          "payload": {
            "jobs": 250
          }
        },
        {
          "at": 10,
          "event": "ad-other-due"
        },
        {
          "at": 30,
          "event": "ad-burst",
          "payload": {
            "jobs": 100
          }
        }
      ]
    },
    {
      "id": "job-admission-burst-of-350-impl",
      "name": "A tenant schedules 350 jobs for one minute (implementation)",
      "description": "A burst of 250 jobs becomes due at tick 0, 100 more at tick 30, and a job of another tenant is due at tick 10, while the backlog is being released. The same scenario run on the implementation machine; times are in milliseconds, 1000 ms to a model tick.",
      "behaviors": [
        "job-admission-flow-impl"
      ],
      "steps": [
        {
          "at": 0,
          "event": "ad-burst",
          "payload": {
            "jobs": 250
          }
        },
        {
          "at": 10000,
          "event": "ad-other-due"
        },
        {
          "at": 30000,
          "event": "ad-burst",
          "payload": {
            "jobs": 100
          }
        }
      ],
      "timeUnit": "ms"
