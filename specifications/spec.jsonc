          },
          "result": "TenantNotFound"
        },
        {
          "args": {
            "kind": "unauthorized"
          },
          "result": "Unauthorized"
        },
        {
          "args": {
            "kind": "unknown-object"
          },
          "result": "UnknownObject"
        },
        {
          "args": {
            "kind": "unknown-field"
          },
          "result": "UnknownField"
        },
        {
          "args": {
            "kind": "unknown-record"
          },
          "result": "UnknownRecord"
        },
        {
          "args": {
            "kind": "unknown-role"
          },
          "result": "UnknownRole"
        },
        {
          "args": {
            "kind": "unknown-query"
          },
