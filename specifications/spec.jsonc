          "type": "timestamp"
        },
        {
          "name": "last-seen-at",
          "type": "timestamp"
        },
        {
          "name": "expires-at",
          "type": "timestamp"
        },
        {
          "name": "revoked-at",
          "type": "timestamp",
          "optional": true
        }
      ],
      "retention": "Until purged after it ends, or the tenant file is deleted.",
      "erasure": {
        "point": "the purge after the session ends, or the deletion of the tenant file"
      },
      "description": "Table sessions of a tenant file: server-side sessions of the tenant; only the hash of the token is stored."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
