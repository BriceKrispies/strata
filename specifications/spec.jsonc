            "limit-key": "account-1"
          }
        },
        {
          "at": 1,
          "event": "pw-attempt",
          "payload": {
            "guess": "wrong",
            "limit-key": "account-1"
          }
        },
        {
          "at": 2,
          "event": "pw-attempt",
          "payload": {
            "guess": "wrong",
            "limit-key": "account-1"
          }
        },
        {
          "at": 3,
          "event": "pw-attempt",
          "payload": {
            "guess": "wrong",
            "limit-key": "account-1"
          },
          "note": "The fourth guess, after the throttle has closed."
        },
        {
          "at": 4,
          "event": "pw-attempt",
          "payload": {
