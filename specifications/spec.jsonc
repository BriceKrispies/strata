      },
      "storage": {
        "record": "rec-identity-decision",
        "key": "decision-id",
        "creates": true
      },
      "realisation": "target"
    },
    {
      "id": "ledger-posting-flow",
      "name": "Post to a ledger account",
      "subject": "runtime",
      "initial": "ldg-open",
      "realisation": "target",
      "description": "One account with a floor of 0 and a cap of 10, and postings in turn. A key already recorded is answered from its entry, and a posting that would pass the floor or the cap is refused and changes nothing. The model remembers two keys, k1 and k2, which are the keys of the postings that it accepts; a refused posting records no key. The journal total is what the entries add up to, and the balance is derived from it.",
      "variables": [
        {
          "name": "balance",
          "type": "number",
          "initial": 0
        },
        {
          "name": "journal",
          "type": "number",
          "initial": 0
        },
        {
          "name": "entries",
          "type": "number",
          "initial": 0
        },
        {
          "name": "keysApplied",
          "type": "number",
          "initial": 0
        },
        {
          "name": "cap",
          "type": "number",
          "initial": 10
        },
        {
          "name": "floor",
          "type": "number",
          "initial": 0
        },
        {
          "name": "seenK1",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "seenK2",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "last",
          "type": "number",
          "initial": 0
        },
        {
          "name": "replayed",
          "type": "number",
          "initial": -1
        }
      ],
      "states": [
        {
          "id": "ldg-open",
          "name": "Accepting postings"
        }
      ],
      "transitions": [
        {
          "id": "ldg-dup-applies-again",
          "from": "ldg-open",
          "to": "ldg-open",
          "on": "ldg-post-requested",
          "guard": "event.key == 'k1' && seenK1",
          "faultOnly": true,
          "description": "Defect: a key that was recorded is applied again.",
          "effects": [
            {
              "set": "balance",
              "to": "balance + event.amount"
            },
            {
              "set": "journal",
              "to": "journal + event.amount"
            },
            {
              "set": "entries",
              "to": "entries + 1"
            },
            {
              "set": "last",
              "to": "event.amount"
            },
            {
              "emit": "ldg-entry-recorded"
            }
          ]
        },
        {
          "id": "ldg-cap-ignored",
          "from": "ldg-open",
          "to": "ldg-open",
          "on": "ldg-post-requested",
          "guard": "balance + event.amount > cap && event.amount > 0",
          "faultOnly": true,
          "description": "Defect: a posting that passes the cap is applied.",
          "effects": [
            {
              "set": "balance",
              "to": "balance + event.amount"
            },
            {
              "set": "journal",
              "to": "journal + event.amount"
            },
            {
              "set": "entries",
              "to": "entries + 1"
            },
            {
              "set": "last",
              "to": "event.amount"
            },
            {
              "emit": "ldg-entry-recorded"
            }
          ]
        },
        {
          "id": "ldg-floor-ignored",
          "from": "ldg-open",
          "to": "ldg-open",
          "on": "ldg-post-requested",
          "guard": "balance + event.amount < floor && event.amount < 0",
          "faultOnly": true,
          "description": "Defect: a posting that passes the floor is applied.",
          "effects": [
            {
              "set": "balance",
              "to": "balance + event.amount"
            },
            {
              "set": "journal",
              "to": "journal + event.amount"
            },
            {
              "set": "entries",
              "to": "entries + 1"
            },
            {
              "set": "last",
              "to": "event.amount"
            },
            {
              "emit": "ldg-entry-recorded"
            }
          ]
        },
        {
          "id": "ldg-adjust-sets-balance",
          "from": "ldg-open",
          "to": "ldg-open",
          "on": "ldg-adjust-requested",
          "faultOnly": true,
          "description": "Defect: an operation sets the balance without an entry.",
          "effects": [
            {
              "set": "balance",
              "to": "event.value"
            }
          ]
        },
        {
          "id": "ldg-replay-drops-last",
          "from": "ldg-open",
          "to": "ldg-open",
          "on": "ldg-replay-requested",
          "faultOnly": true,
          "description": "Defect: the replay leaves out the last entry.",
          "effects": [
            {
              "set": "replayed",
              "to": "journal - last"
            },
            {
              "emit": "ldg-replayed"
            }
          ]
        },
        {
          "id": "ldg-replay",
          "from": "ldg-open",
          "to": "ldg-open",
          "on": "ldg-replay-requested",
          "effects": [
            {
              "set": "replayed",
              "to": "journal"
            },
            {
              "emit": "ldg-replayed"
            }
          ]
        },
        {
          "id": "ldg-key-k1-answered",
          "from": "ldg-open",
          "to": "ldg-open",
          "on": "ldg-post-requested",
          "guard": "event.key == 'k1' && seenK1",
          "effects": [
            {
              "emit": "ldg-post-replayed"
            }
          ]
        },
        {
          "id": "ldg-key-k2-answered",
          "from": "ldg-open",
          "to": "ldg-open",
          "on": "ldg-post-requested",
          "guard": "event.key == 'k2' && seenK2",
          "effects": [
            {
              "emit": "ldg-post-replayed"
            }
          ]
        },
        {
          "id": "ldg-refuse-floor",
          "from": "ldg-open",
          "to": "ldg-open",
          "on": "ldg-post-requested",
          "guard": "balance + event.amount < floor && event.amount < 0",
          "effects": [
            {
              "emit": "ldg-refused-floor"
            }
          ]
        },
        {
          "id": "ldg-refuse-cap",
          "from": "ldg-open",
          "to": "ldg-open",
          "on": "ldg-post-requested",
          "guard": "balance + event.amount > cap && event.amount > 0",
          "effects": [
            {
              "emit": "ldg-refused-cap"
            }
          ]
        },
        {
          "id": "ldg-accept-k1",
          "from": "ldg-open",
          "to": "ldg-open",
          "on": "ldg-post-requested",
          "guard": "event.key == 'k1'",
          "effects": [
            {
              "set": "balance",
              "to": "balance + event.amount"
            },
            {
              "set": "journal",
              "to": "journal + event.amount"
            },
            {
              "set": "entries",
              "to": "entries + 1"
            },
            {
              "set": "last",
              "to": "event.amount"
            },
            {
              "set": "keysApplied",
              "to": "keysApplied + 1"
            },
            {
              "set": "seenK1",
              "to": true
            },
            {
              "emit": "ldg-entry-recorded"
            }
          ]
        },
        {
          "id": "ldg-accept-k2",
          "from": "ldg-open",
          "to": "ldg-open",
          "on": "ldg-post-requested",
          "guard": "event.key == 'k2'",
          "effects": [
            {
              "set": "balance",
              "to": "balance + event.amount"
            },
            {
              "set": "journal",
              "to": "journal + event.amount"
            },
            {
              "set": "entries",
              "to": "entries + 1"
            },
            {
              "set": "last",
              "to": "event.amount"
            },
            {
              "set": "keysApplied",
              "to": "keysApplied + 1"
            },
            {
              "set": "seenK2",
              "to": true
            },
            {
              "emit": "ldg-entry-recorded"
            }
          ]
        }
      ]
    },
    {
      "id": "ledger-concurrent-flow",
      "name": "Concurrent postings under a cap",
      "subject": "runtime",
      "initial": "ldg-race-open",
      "realisation": "target",
      "description": "One account with a cap of 10 and two posters that read the same snapshot and commit through the revision guard. A commit whose snapshot is not the current revision is not applied: the posting is decided again on the new state, one tick later, as the store contract retries a commit that lost its race (D-5009).",
      "variables": [
        {
          "name": "balance",
          "type": "number",
          "initial": 0
        },
        {
          "name": "cap",
          "type": "number",
          "initial": 10
        },
        {
          "name": "revision",
          "type": "number",
          "initial": 0
        },
        {
          "name": "posted",
          "type": "number",
          "initial": 0
        },
        {
          "name": "refused",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "ldg-race-open",
          "name": "Accepting commits"
        }
      ],
      "transitions": [
        {
          "id": "ldg-race-blind",
          "from": "ldg-race-open",
          "to": "ldg-race-open",
          "on": "ldg-attempt",
          "guard": "event.seen + event.amount <= cap",
          "faultOnly": true,
          "description": "Defect: the commit is not guarded by the revision, so a posting decided on a stale snapshot is applied.",
          "effects": [
            {
              "set": "balance",
              "to": "balance + event.amount"
            },
            {
              "set": "revision",
              "to": "revision + 1"
            },
            {
              "set": "posted",
              "to": "posted + 1"
            },
            {
              "emit": "ldg-race-posted"
            }
          ]
        },
        {
          "id": "ldg-race-refuse-stale",
          "from": "ldg-race-open",
          "to": "ldg-race-open",
          "on": "ldg-attempt",
          "guard": "event.snapshot != revision",
          "faultOnly": true,
          "description": "Defect: a commit that lost its race is refused, not decided again.",
          "effects": [
            {
              "set": "refused",
              "to": "refused + 1"
            },
            {
              "emit": "ldg-race-refused"
            }
          ]
        },
        {
          "id": "ldg-race-retry",
          "from": "ldg-race-open",
          "to": "ldg-race-open",
          "on": "ldg-attempt",
          "guard": "event.snapshot != revision",
          "effects": [
            {
              "emit": "ldg-race-conflict"
            },
            {
              "emit": "ldg-attempt",
              "after": 1,
              "payload": {
                "poster": "event.poster",
                "amount": "event.amount",
                "snapshot": "revision",
                "seen": "balance"
              }
            }
          ]
        },
        {
          "id": "ldg-race-commit",
          "from": "ldg-race-open",
          "to": "ldg-race-open",
          "on": "ldg-attempt",
          "guard": "event.snapshot == revision && balance + event.amount <= cap",
          "effects": [
            {
              "set": "balance",
              "to": "balance + event.amount"
            },
            {
              "set": "revision",
              "to": "revision + 1"
            },
            {
              "set": "posted",
              "to": "posted + 1"
            },
            {
              "emit": "ldg-race-posted"
            }
          ]
        },
        {
          "id": "ldg-race-refuse",
          "from": "ldg-race-open",
          "to": "ldg-race-open",
          "on": "ldg-attempt",
          "guard": "event.snapshot == revision && balance + event.amount > cap",
          "effects": [
            {
              "set": "refused",
              "to": "refused + 1"
            },
            {
              "emit": "ldg-race-refused"
            }
          ]
        }
      ]
    },
    {
      "id": "ledger-commit-flow",
      "name": "Commit a change with its posting",
      "subject": "runtime",
      "initial": "ldg-commit-open",
      "realisation": "target",
      "description": "A change that posts one entry. Committing it records the entry and its domain event in the same step; rolling it back records neither.",
      "variables": [
        {
          "name": "changes",
          "type": "number",
          "initial": 0
        },
        {
          "name": "entries",
          "type": "number",
          "initial": 0
        },
        {
          "name": "published",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "ldg-commit-open",
          "name": "Accepting changes"
        }
      ],
      "transitions": [
        {
          "id": "ldg-commit-split",
          "from": "ldg-commit-open",
          "to": "ldg-commit-open",
          "on": "ldg-change-committed",
          "faultOnly": true,
          "description": "Defect: the entry is recorded in a step after the commit.",
          "effects": [
            {
              "set": "changes",
              "to": "changes + 1"
            },
            {
              "emit": "ldg-posting-late",
              "after": 1
            }
          ]
        },
        {
          "id": "ldg-rollback-posts",
          "from": "ldg-commit-open",
          "to": "ldg-commit-open",
          "on": "ldg-change-rolled-back",
          "faultOnly": true,
          "description": "Defect: the entry is recorded before the outcome of the transaction is known.",
          "effects": [
            {
              "set": "entries",
              "to": "entries + 1"
            }
          ]
        },
        {
          "id": "ldg-rollback-publishes",
          "from": "ldg-commit-open",
          "to": "ldg-commit-open",
          "on": "ldg-change-rolled-back",
          "faultOnly": true,
          "description": "Defect: the event is published before the outcome of the transaction is known.",
          "effects": [
            {
              "set": "published",
              "to": "published + 1"
            },
            {
              "emit": "ledger-entry-posted"
            }
          ]
        },
        {
          "id": "ldg-commit-t",
          "from": "ldg-commit-open",
          "to": "ldg-commit-open",
          "on": "ldg-change-committed",
          "effects": [
            {
              "set": "changes",
              "to": "changes + 1"
            },
            {
              "set": "entries",
              "to": "entries + 1"
            },
            {
              "set": "published",
              "to": "published + 1"
            },
            {
              "emit": "ledger-entry-posted"
            }
          ]
        },
        {
          "id": "ldg-rollback-t",
          "from": "ldg-commit-open",
          "to": "ldg-commit-open",
          "on": "ldg-change-rolled-back",
          "effects": []
        },
        {
          "id": "ldg-posting-late-t",
          "from": "ldg-commit-open",
          "to": "ldg-commit-open",
          "on": "ldg-posting-late",
          "effects": [
            {
              "set": "entries",
              "to": "entries + 1"
            },
            {
              "set": "published",
              "to": "published + 1"
            },
            {
              "emit": "ledger-entry-posted"
            }
          ]
        }
      ]
    },
    {
      "id": "segment-membership-flow",
      "name": "Segment membership of one person",
      "subject": "kernel",
      "initial": "sg-live",
      "description": "One person and one segment. Each committed change says whether the predicate holds on the state it leaves. The decision that commits the change writes the entry or exit event in the same step and moves the membership; a change that leaves membership as it was writes nothing, a rolled back change does nothing, and an erasure removes the person for good.",
      "variables": [
        {
          "name": "member",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "holds",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "erased",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "committed",
          "type": "number",
          "initial": 0
        },
        {
          "name": "entries",
          "type": "number",
          "initial": 0
        },
        {
          "name": "exits",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "sg-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "sg-enter-without-event",
          "from": "sg-live",
          "to": "sg-live",
          "on": "sg-record-changed",
          "description": "Defect: the member is recorded and no entry event is written.",
          "guard": "!erased && event.holds && !member",
          "faultOnly": true,
          "effects": [
            {
              "set": "committed",
              "to": "committed + 1"
            },
            {
              "set": "holds",
              "to": true
            },
            {
              "set": "member",
              "to": true
            }
          ]
        },
        {
          "id": "sg-enter-split",
          "from": "sg-live",
          "to": "sg-live",
          "on": "sg-record-changed",
          "description": "Defect: the entry event is written in a step after the commit.",
          "guard": "!erased && event.holds && !member",
          "faultOnly": true,
          "effects": [
            {
              "set": "committed",
              "to": "committed + 1"
            },
            {
              "set": "holds",
              "to": true
            },
            {
              "set": "member",
              "to": true
            },
            {
              "emit": "sg-write-entry",
              "after": 1
            }
          ]
        },
        {
          "id": "sg-change-event-every-time",
          "from": "sg-live",
          "to": "sg-live",
          "on": "sg-record-changed",
          "description": "Defect: an entry event is written for a change that leaves a member a member.",
          "guard": "!erased && event.holds && member",
          "faultOnly": true,
          "effects": [
            {
              "set": "committed",
              "to": "committed + 1"
            },
            {
              "set": "entries",
              "to": "entries + 1"
            },
            {
              "emit": "sg-entered"
            }
          ]
        },
        {
          "id": "sg-change-skips-evaluation",
          "from": "sg-live",
          "to": "sg-live",
          "on": "sg-record-changed",
          "description": "Defect: the change is committed and the predicate is not evaluated for the person.",
          "guard": "!erased",
          "faultOnly": true,
          "effects": [
            {
              "set": "committed",
              "to": "committed + 1"
            },
            {
              "set": "holds",
              "to": "event.holds"
            }
          ]
        },
        {
          "id": "sg-change-enters-erased",
          "from": "sg-live",
          "to": "sg-live",
          "on": "sg-record-changed",
          "description": "Defect: a change enters a person who was erased.",
          "guard": "erased && event.holds",
          "faultOnly": true,
          "effects": [
            {
              "set": "member",
              "to": true
            },
            {
              "set": "entries",
              "to": "entries + 1"
            },
            {
              "emit": "sg-entered"
            }
          ]
        },
        {
          "id": "sg-enter",
          "from": "sg-live",
          "to": "sg-live",
          "on": "sg-record-changed",
          "guard": "!erased && event.holds && !member",
          "effects": [
            {
              "set": "committed",
              "to": "committed + 1"
            },
            {
              "set": "holds",
              "to": true
            },
            {
              "set": "member",
              "to": true
            },
            {
              "set": "entries",
              "to": "entries + 1"
            },
            {
              "emit": "sg-entered"
            }
          ]
        },
        {
          "id": "sg-exit",
          "from": "sg-live",
          "to": "sg-live",
          "on": "sg-record-changed",
          "guard": "!erased && !event.holds && member",
          "effects": [
            {
              "set": "committed",
              "to": "committed + 1"
            },
            {
              "set": "holds",
              "to": false
            },
            {
              "set": "member",
              "to": false
            },
            {
              "set": "exits",
              "to": "exits + 1"
            },
            {
              "emit": "sg-exited"
            }
          ]
        },
        {
          "id": "sg-unchanged",
          "from": "sg-live",
          "to": "sg-live",
          "on": "sg-record-changed",
          "description": "The membership is as it was: no event.",
          "guard": "!erased",
          "effects": [
            {
              "set": "committed",
              "to": "committed + 1"
            },
            {
              "set": "holds",
              "to": "event.holds"
            }
          ]
        },
        {
          "id": "sg-predicate-change-skips-evaluation",
          "from": "sg-live",
          "to": "sg-live",
          "on": "sg-predicate-changed",
          "description": "Defect: the batch of a changed predicate does not evaluate the person.",
          "guard": "!erased",
          "faultOnly": true,
          "effects": [
            {
              "set": "committed",
              "to": "committed + 1"
            },
            {
              "set": "holds",
              "to": "event.holds"
            }
          ]
        },
        {
          "id": "sg-predicate-enter",
          "from": "sg-live",
          "to": "sg-live",
          "on": "sg-predicate-changed",
          "guard": "!erased && event.holds && !member",
          "effects": [
            {
              "set": "committed",
              "to": "committed + 1"
            },
            {
              "set": "holds",
              "to": true
            },
            {
              "set": "member",
              "to": true
            },
            {
              "set": "entries",
              "to": "entries + 1"
            },
            {
              "emit": "sg-entered"
            }
          ]
        },
        {
          "id": "sg-predicate-exit",
          "from": "sg-live",
          "to": "sg-live",
          "on": "sg-predicate-changed",
          "guard": "!erased && !event.holds && member",
          "effects": [
            {
              "set": "committed",
              "to": "committed + 1"
            },
            {
              "set": "holds",
              "to": false
            },
            {
              "set": "member",
              "to": false
            },
            {
              "set": "exits",
              "to": "exits + 1"
            },
            {
              "emit": "sg-exited"
            }
          ]
        },
        {
          "id": "sg-predicate-unchanged",
          "from": "sg-live",
          "to": "sg-live",
          "on": "sg-predicate-changed",
          "description": "The membership is as it was: no event.",
          "guard": "!erased",
          "effects": [
            {
              "set": "committed",
              "to": "committed + 1"
            },
            {
              "set": "holds",
              "to": "event.holds"
            }
          ]
        },
        {
          "id": "sg-rollback-enters",
          "from": "sg-live",
          "to": "sg-live",
          "on": "sg-rolled-back",
          "description": "Defect: the entry event is written before the outcome of the transaction is known.",
          "guard": "event.holds && !member && !erased",
          "faultOnly": true,
          "effects": [
            {
              "set": "holds",
              "to": true
            },
            {
              "set": "member",
              "to": true
            },
            {
              "set": "entries",
              "to": "entries + 1"
            },
            {
              "emit": "sg-entered"
            }
          ]
        },
        {
          "id": "sg-rollback-t",
          "from": "sg-live",
          "to": "sg-live",
          "on": "sg-rolled-back",
          "effects": []
        },
        {
          "id": "sg-erase-leaves-member",
          "from": "sg-live",
          "to": "sg-live",
          "on": "sg-erased",
          "description": "Defect: the erasure is recorded and the membership stays.",
          "guard": "member",
          "faultOnly": true,
          "effects": [
            {
              "set": "committed",
              "to": "committed + 1"
            },
            {
              "set": "erased",
              "to": true
            }
          ]
        },
        {
          "id": "sg-erase-member",
          "from": "sg-live",
          "to": "sg-live",
          "on": "sg-erased",
          "guard": "member",
          "effects": [
            {
              "set": "committed",
              "to": "committed + 1"
            },
            {
              "set": "erased",
              "to": true
            },
            {
              "set": "member",
              "to": false
            },
            {
              "set": "holds",
              "to": false
            },
            {
              "set": "exits",
              "to": "exits + 1"
            },
            {
              "emit": "sg-exited"
            }
          ]
        },
        {
          "id": "sg-erase-nonmember",
          "from": "sg-live",
          "to": "sg-live",
          "on": "sg-erased",
          "guard": "!member",
          "effects": [
            {
              "set": "committed",
              "to": "committed + 1"
            },
            {
              "set": "erased",
              "to": true
            },
            {
              "set": "holds",
              "to": false
            }
          ]
        },
        {
          "id": "sg-write-entry-late",
          "from": "sg-live",
          "to": "sg-live",
          "on": "sg-write-entry",
          "effects": [
            {
              "set": "entries",
              "to": "entries + 1"
            },
            {
              "emit": "sg-entered"
            }
          ]
        }
      ],
      "realisation": "target"
    },
    {
      "id": "segment-refresh-flow",
      "name": "Refresh of a time-dependent segment",
      "subject": "automation-worker",
      "initial": "sg-refresh-live",
      "description": "One person and one segment whose predicate reads the time. Time changes the value of the predicate without any change committing; the refresh job evaluates the person at the time it is given, so the person enters or leaves at the first refresh after the change.",
      "variables": [
        {
          "name": "member",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "holds",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "entries",
          "type": "number",
          "initial": 0
        },
        {
          "name": "exits",
          "type": "number",
          "initial": 0
        },
        {
          "name": "refreshes",
          "type": "number",
          "initial": 0
        },
        {
          "name": "staleIntervals",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "sg-refresh-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "sg-time-moves",
          "from": "sg-refresh-live",
          "to": "sg-refresh-live",
          "on": "sg-time-passes",
          "effects": [
            {
              "set": "holds",
              "to": "event.holds"
            }
          ]
        },
        {
          "id": "sg-refresh-enters-always",
          "from": "sg-refresh-live",
          "to": "sg-refresh-live",
          "on": "sg-refresh-due",
          "description": "Defect: the refresh enters a person whatever the predicate gives.",
          "guard": "!member",
          "faultOnly": true,
          "effects": [
            {
              "set": "refreshes",
              "to": "refreshes + 1"
            },
            {
              "set": "member",
              "to": true
            },
            {
              "set": "entries",
              "to": "entries + 1"
            },
            {
              "emit": "sg-entered"
            }
          ]
        },
        {
          "id": "sg-refresh-skips",
          "from": "sg-refresh-live",
          "to": "sg-refresh-live",
          "on": "sg-refresh-due",
          "description": "Defect: the job runs and does not evaluate the person.",
          "guard": "holds != member",
          "faultOnly": true,
          "effects": [
            {
              "set": "refreshes",
              "to": "refreshes + 1"
            },
            {
              "set": "staleIntervals",
              "to": "staleIntervals + 1"
            }
          ]
        },
        {
          "id": "sg-refresh-enters",
          "from": "sg-refresh-live",
          "to": "sg-refresh-live",
          "on": "sg-refresh-due",
          "guard": "holds && !member",
          "effects": [
            {
              "set": "refreshes",
              "to": "refreshes + 1"
            },
            {
              "set": "member",
              "to": true
            },
            {
              "set": "entries",
              "to": "entries + 1"
            },
            {
              "emit": "sg-entered"
            }
          ]
        },
        {
          "id": "sg-refresh-exits",
          "from": "sg-refresh-live",
          "to": "sg-refresh-live",
          "on": "sg-refresh-due",
          "guard": "!holds && member",
          "effects": [
            {
              "set": "refreshes",
              "to": "refreshes + 1"
            },
            {
              "set": "member",
              "to": false
            },
            {
              "set": "exits",
              "to": "exits + 1"
            },
            {
              "emit": "sg-exited"
            }
          ]
        },
        {
          "id": "sg-refresh-unchanged",
          "from": "sg-refresh-live",
          "to": "sg-refresh-live",
          "on": "sg-refresh-due",
          "description": "The value is what membership already says: no event.",
          "effects": [
            {
              "set": "refreshes",
              "to": "refreshes + 1"
            }
          ]
        }
      ],
      "realisation": "target"
    },
    {
      "id": "segment-rebuild-flow",
      "name": "Batches of a changed predicate",
      "subject": "automation-worker",
      "initial": "sg-rebuild-live",
      "description": "One segment whose predicate changes. Each change raises the version and starts batches of at most one hundred persons, each its own step that carries its version. A batch of a superseded version writes nothing, and the batches end when every person was evaluated.",
      "variables": [
        {
          "name": "version",
          "type": "number",
          "initial": 0
        },
        {
          "name": "total",
          "type": "number",
          "initial": 0
        },
        {
          "name": "remaining",
          "type": "number",
          "initial": 0
        },
        {
          "name": "evaluated",
          "type": "number",
          "initial": 0
        },
        {
          "name": "batches",
          "type": "number",
          "initial": 0
        },
        {
          "name": "widest",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "sg-rebuild-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "sg-rebuild-start",
          "from": "sg-rebuild-live",
          "to": "sg-rebuild-live",
          "on": "sg-predicate-redefined",
          "effects": [
            {
              "set": "version",
              "to": "version + 1"
            },
            {
              "set": "total",
              "to": "event.people"
            },
            {
              "set": "remaining",
              "to": "event.people"
            },
            {
              "set": "evaluated",
              "to": 0
            },
            {
              "set": "batches",
              "to": 0
            },
            {
              "set": "widest",
              "to": 0
            },
            {
              "emit": "sg-batch-due",
              "after": 1,
              "payload": {
                "version": "version"
              }
            }
          ]
        },
        {
          "id": "sg-batch-small",
          "from": "sg-rebuild-live",
          "to": "sg-rebuild-live",
          "on": "sg-batch-due",
          "description": "Defect: a batch evaluates one person, so the batches never end in time.",
          "guard": "event.version == version && remaining > 100",
          "faultOnly": true,
          "effects": [
            {
              "set": "remaining",
              "to": "remaining - 1"
            },
            {
              "set": "evaluated",
              "to": "evaluated + 1"
            },
            {
              "set": "batches",
              "to": "batches + 1"
            },
            {
              "emit": "sg-batch-due",
              "after": 1,
              "payload": {
                "version": "event.version"
              }
            }
          ]
        },
        {
          "id": "sg-batch-unbounded",
          "from": "sg-rebuild-live",
          "to": "sg-rebuild-live",
          "on": "sg-batch-due",
          "description": "Defect: one transaction evaluates every remaining person.",
          "guard": "event.version == version && remaining > 100",
          "faultOnly": true,
          "effects": [
            {
              "set": "widest",
              "to": "remaining"
            },
            {
              "set": "evaluated",
              "to": "evaluated + remaining"
            },
            {
              "set": "remaining",
              "to": 0
            },
            {
              "set": "batches",
              "to": "batches + 1"
            },
            {
              "emit": "sg-rebuilt"
            }
          ]
        },
        {
          "id": "sg-stale-batch-writes",
          "from": "sg-rebuild-live",
          "to": "sg-rebuild-live",
          "on": "sg-batch-due",
          "description": "Defect: a batch of a superseded version writes its events.",
          "guard": "event.version != version",
          "faultOnly": true,
          "effects": [
            {
              "set": "evaluated",
              "to": "evaluated + 100"
            }
          ]
        },
        {
          "id": "sg-batch-full",
          "from": "sg-rebuild-live",
          "to": "sg-rebuild-live",
          "on": "sg-batch-due",
          "guard": "event.version == version && remaining > 100",
          "effects": [
            {
              "set": "remaining",
              "to": "remaining - 100"
            },
            {
              "set": "evaluated",
              "to": "evaluated + 100"
            },
            {
              "set": "batches",
              "to": "batches + 1"
            },
            {
              "set": "widest",
              "to": 100
            },
            {
              "emit": "sg-batch-due",
              "after": 1,
              "payload": {
                "version": "event.version"
              }
            }
          ]
        },
        {
          "id": "sg-batch-last",
          "from": "sg-rebuild-live",
          "to": "sg-rebuild-live",
          "on": "sg-batch-due",
          "guard": "event.version == version && remaining > 0 && remaining <= 100",
          "effects": [
            {
              "set": "evaluated",
              "to": "evaluated + remaining"
            },
            {
              "set": "remaining",
              "to": 0
            },
            {
              "set": "batches",
              "to": "batches + 1"
            },
            {
              "emit": "sg-rebuilt"
            }
          ]
        },
        {
          "id": "sg-batch-superseded",
          "from": "sg-rebuild-live",
          "to": "sg-rebuild-live",
          "on": "sg-batch-due",
          "guard": "event.version != version",
          "effects": [
            {
              "emit": "sg-batch-dropped"
            }
          ]
        }
      ],
      "realisation": "target"
    },
    {
      "id": "segment-chain-flow",
      "name": "Chain through a segment and a workflow",
      "subject": "automation-worker",
      "initial": "sg-chain-live",
      "description": "A workflow edits a record that a segment predicate reads, so each edit changes membership and each event starts the workflow again. The event carries the hop count of the edit plus one; a trigger creates a job while the hop count is within the limit of eight that D-700 states, and past it the membership is still updated and no job is created.",
      "variables": [
        {
          "name": "jobs",
          "type": "number",
          "initial": 0
        },
        {
          "name": "edits",
          "type": "number",
          "initial": 0
        },
        {
          "name": "updates",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "sg-chain-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "sg-chain-unbounded",
          "from": "sg-chain-live",
          "to": "sg-chain-live",
          "on": "sg-chain-edit",
          "description": "Defect: the event does not carry the hop count, so the chain never ends.",
          "faultOnly": true,
          "effects": [
            {
              "set": "edits",
              "to": "edits + 1"
            },
            {
              "set": "updates",
              "to": "updates + 1"
            },
            {
              "set": "jobs",
              "to": "jobs + 1"
            },
            {
              "emit": "sg-chain-job"
            },
            {
              "emit": "sg-chain-edit",
              "after": 1,
              "payload": {
                "hop": 1
              }
            }
          ]
        },
        {
          "id": "sg-chain-cut-drops-update",
          "from": "sg-chain-live",
          "to": "sg-chain-live",
          "on": "sg-chain-edit",
          "description": "Defect: past the hop limit the membership is not updated.",
          "guard": "event.hop > 8",
          "faultOnly": true,
          "effects": [
            {
              "set": "edits",
              "to": "edits + 1"
            },
            {
              "emit": "sg-chain-cut"
            }
          ]
        },
        {
          "id": "sg-chain-accept",
          "from": "sg-chain-live",
          "to": "sg-chain-live",
          "on": "sg-chain-edit",
          "guard": "event.hop <= 8",
          "effects": [
            {
              "set": "edits",
              "to": "edits + 1"
            },
            {
              "set": "updates",
              "to": "updates + 1"
            },
            {
              "set": "jobs",
              "to": "jobs + 1"
            },
            {
              "emit": "sg-chain-job"
            },
            {
              "emit": "sg-chain-edit",
              "after": 1,
              "payload": {
                "hop": "event.hop + 1"
              }
            }
          ]
        },
        {
          "id": "sg-chain-cut-t",
          "from": "sg-chain-live",
          "to": "sg-chain-live",
          "on": "sg-chain-edit",
          "guard": "event.hop > 8",
          "effects": [
            {
              "set": "edits",
              "to": "edits + 1"
            },
            {
              "set": "updates",
              "to": "updates + 1"
            },
            {
              "emit": "sg-chain-cut"
            }
          ]
        }
      ],
      "realisation": "target"
    },
    {
      "id": "st-resolution-flow",
      "name": "Setting resolution under concurrent changes",
      "subject": "runtime",
      "initial": "st-res-open",
      "description": "One setting with an override at the tenant level, at the team level of two teams, alpha and beta, and at the person level. A value of 0 means that no override exists. Writes name the revision they expect, a read takes the most specific permitted override and orders the teams by identifier, closing the team level and locking the tenant level close levels without deleting what they hold (D-5041, D-5042, D-5043, D-5045).",
      "variables": [
        {
          "name": "tenantValue",
          "type": "number",
          "initial": 0
        },
        {
          "name": "teamAlpha",
          "type": "number",
          "initial": 0
        },
        {
          "name": "teamBeta",
          "type": "number",
          "initial": 0
        },
        {
          "name": "personValue",
          "type": "number",
          "initial": 0
        },
        {
          "name": "revision",
          "type": "number",
          "initial": 0
        },
        {
          "name": "teamAllowed",
          "type": "number",
          "initial": 1
        },
        {
          "name": "lockLevel",
          "type": "number",
          "initial": 0
        },
        {
          "name": "reads",
          "type": "number",
          "initial": 0
        },
        {
          "name": "from",
          "type": "number",
          "initial": 0
        },
        {
          "name": "value",
          "type": "number",
          "initial": 0
        },
        {
          "name": "seenPerson",
          "type": "number",
          "initial": 0
        },
        {
          "name": "seenTeamAlpha",
          "type": "number",
          "initial": 0
        },
        {
          "name": "seenTeamBeta",
          "type": "number",
          "initial": 0
        },
        {
          "name": "seenTenant",
          "type": "number",
          "initial": 0
        },
        {
          "name": "seenLocked",
          "type": "number",
          "initial": 0
        },
        {
          "name": "seenTeamAllowed",
          "type": "number",
          "initial": 1
        },
        {
          "name": "committed",
          "type": "number",
          "initial": 0
        },
        {
          "name": "lost",
          "type": "number",
          "initial": 0
        },
        {
          "name": "badWrites",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "st-res-open",
          "name": "Open"
        }
      ],
      "transitions": [
        {
          "id": "st-close-team-level",
          "from": "st-res-open",
          "to": "st-res-open",
          "on": "st-team-level-closed",
          "effects": [
            {
              "set": "teamAllowed",
              "to": "0"
            }
          ]
        },
        {
          "id": "st-lock",
          "from": "st-res-open",
          "to": "st-res-open",
          "on": "st-tenant-lock-set",
          "effects": [
            {
              "set": "lockLevel",
              "to": "1"
            }
          ]
        },
        {
          "id": "st-unlock",
          "from": "st-res-open",
          "to": "st-res-open",
          "on": "st-tenant-lock-lifted",
          "effects": [
            {
              "set": "lockLevel",
              "to": "0"
            }
          ]
        },
        {
          "id": "st-accept-stale",
          "from": "st-res-open",
          "to": "st-res-open",
          "on": "st-write-asked",
          "guard": "event.expected != revision",
          "faultOnly": true,
          "description": "Defect: commits a write that names an older revision, and overwrites a change its writer had not seen.",
          "effects": [
            {
              "set": "lost",
              "to": "lost + 1"
            },
            {
              "set": "revision",
              "to": "revision + 1"
            },
            {
              "emit": "st-committed"
            }
          ]
        },
        {
          "id": "st-accept-closed",
          "from": "st-res-open",
          "to": "st-res-open",
          "on": "st-write-asked",
          "guard": "event.level == 'team' && teamAllowed == 0 && event.expected == revision",
          "faultOnly": true,
          "description": "Defect: commits a write at a level the definition closed.",
          "effects": [
            {
              "set": "badWrites",
              "to": "badWrites + 1"
            },
            {
              "set": "revision",
              "to": "revision + 1"
            },
            {
              "emit": "st-committed"
            }
          ]
        },
        {
          "id": "st-accept-locked",
          "from": "st-res-open",
          "to": "st-res-open",
          "on": "st-write-asked",
          "guard": "lockLevel == 1 && event.level != 'tenant' && event.expected == revision",
          "faultOnly": true,
          "description": "Defect: commits a write below a lock.",
          "effects": [
            {
              "set": "badWrites",
              "to": "badWrites + 1"
            },
            {
              "set": "revision",
              "to": "revision + 1"
            },
            {
              "emit": "st-committed"
            }
          ]
        },
        {
          "id": "st-write-conflict",
          "from": "st-res-open",
          "to": "st-res-open",
          "on": "st-write-asked",
          "guard": "event.expected != revision",
          "effects": [
            {
              "emit": "st-conflict"
            }
          ]
        },
        {
          "id": "st-write-closed",
          "from": "st-res-open",
          "to": "st-res-open",
          "on": "st-write-asked",
          "guard": "event.level == 'team' && teamAllowed == 0",
          "effects": [
            {
              "emit": "st-refused"
            }
          ]
        },
        {
          "id": "st-write-locked",
          "from": "st-res-open",
          "to": "st-res-open",
          "on": "st-write-asked",
          "guard": "lockLevel == 1 && event.level != 'tenant'",
          "effects": [
            {
              "emit": "st-refused"
            }
          ]
        },
        {
          "id": "st-write-tenant",
          "from": "st-res-open",
          "to": "st-res-open",
          "on": "st-write-asked",
          "guard": "event.level == 'tenant'",
          "effects": [
            {
              "set": "tenantValue",
              "to": "event.value"
            },
            {
              "set": "revision",
              "to": "revision + 1"
            },
            {
              "set": "committed",
              "to": "committed + 1"
            },
            {
              "emit": "st-committed"
            }
          ]
        },
        {
          "id": "st-write-team-alpha",
          "from": "st-res-open",
          "to": "st-res-open",
          "on": "st-write-asked",
          "guard": "event.level == 'team' && event.subject == 'alpha'",
          "effects": [
            {
              "set": "teamAlpha",
              "to": "event.value"
            },
            {
              "set": "revision",
              "to": "revision + 1"
            },
            {
              "set": "committed",
              "to": "committed + 1"
            },
            {
              "emit": "st-committed"
            }
          ]
        },
        {
          "id": "st-write-team-beta",
          "from": "st-res-open",
          "to": "st-res-open",
          "on": "st-write-asked",
          "guard": "event.level == 'team' && event.subject == 'beta'",
          "effects": [
            {
              "set": "teamBeta",
              "to": "event.value"
            },
            {
              "set": "revision",
              "to": "revision + 1"
            },
            {
              "set": "committed",
              "to": "committed + 1"
            },
            {
              "emit": "st-committed"
            }
          ]
        },
        {
          "id": "st-write-person",
          "from": "st-res-open",
          "to": "st-res-open",
          "on": "st-write-asked",
          "guard": "event.level == 'person'",
          "effects": [
            {
              "set": "personValue",
              "to": "event.value"
            },
            {
              "set": "revision",
              "to": "revision + 1"
            },
            {
              "set": "committed",
              "to": "committed + 1"
            },
            {
              "emit": "st-committed"
            }
          ]
        },
        {
          "id": "st-read-team-before-person",
          "from": "st-res-open",
          "to": "st-res-open",
          "on": "st-read-asked",
          "guard": "teamAlpha > 0",
          "faultOnly": true,
          "description": "Defect: answers from a team although the person holds an override.",
          "effects": [
            {
              "set": "reads",
              "to": "reads + 1"
            },
            {
              "set": "seenPerson",
              "to": "personValue"
            },
            {
              "set": "seenTeamAlpha",
              "to": "teamAlpha"
            },
            {
              "set": "seenTeamBeta",
              "to": "teamBeta"
            },
            {
              "set": "seenTenant",
              "to": "tenantValue"
            },
            {
              "set": "seenLocked",
              "to": "lockLevel"
            },
            {
              "set": "seenTeamAllowed",
              "to": "teamAllowed"
            },
            {
              "set": "from",
              "to": "2"
            },
            {
              "set": "value",
              "to": "teamAlpha"
            },
            {
              "emit": "st-answered"
            }
          ]
        },
        {
          "id": "st-read-latest-team",
          "from": "st-res-open",
          "to": "st-res-open",
          "on": "st-read-asked",
          "guard": "teamBeta > 0",
          "faultOnly": true,
          "description": "Defect: answers from the team that was written last instead of the team whose identifier comes first.",
          "effects": [
            {
              "set": "reads",
              "to": "reads + 1"
            },
            {
              "set": "seenPerson",
              "to": "personValue"
            },
            {
              "set": "seenTeamAlpha",
              "to": "teamAlpha"
            },
            {
              "set": "seenTeamBeta",
              "to": "teamBeta"
            },
            {
              "set": "seenTenant",
              "to": "tenantValue"
            },
            {
              "set": "seenLocked",
              "to": "lockLevel"
            },
            {
              "set": "seenTeamAllowed",
              "to": "teamAllowed"
            },
            {
              "set": "from",
              "to": "2"
            },
            {
              "set": "value",
              "to": "teamBeta"
            },
            {
              "emit": "st-answered"
            }
          ]
        },
        {
          "id": "st-read-person",
          "from": "st-res-open",
          "to": "st-res-open",
          "on": "st-read-asked",
          "guard": "personValue > 0 && lockLevel == 0",
          "effects": [
            {
              "set": "reads",
              "to": "reads + 1"
            },
            {
              "set": "seenPerson",
              "to": "personValue"
            },
            {
              "set": "seenTeamAlpha",
              "to": "teamAlpha"
            },
            {
              "set": "seenTeamBeta",
              "to": "teamBeta"
            },
            {
              "set": "seenTenant",
              "to": "tenantValue"
            },
            {
              "set": "seenLocked",
              "to": "lockLevel"
            },
            {
              "set": "seenTeamAllowed",
              "to": "teamAllowed"
            },
            {
              "set": "from",
              "to": "3"
            },
            {
              "set": "value",
              "to": "personValue"
            },
            {
              "emit": "st-answered"
            }
          ]
        },
        {
          "id": "st-read-team-alpha",
          "from": "st-res-open",
          "to": "st-res-open",
          "on": "st-read-asked",
          "guard": "teamAlpha > 0 && teamAllowed == 1 && lockLevel == 0",
          "effects": [
            {
              "set": "reads",
              "to": "reads + 1"
            },
            {
              "set": "seenPerson",
              "to": "personValue"
            },
            {
              "set": "seenTeamAlpha",
              "to": "teamAlpha"
            },
            {
              "set": "seenTeamBeta",
              "to": "teamBeta"
            },
            {
              "set": "seenTenant",
              "to": "tenantValue"
            },
            {
              "set": "seenLocked",
              "to": "lockLevel"
            },
            {
              "set": "seenTeamAllowed",
              "to": "teamAllowed"
            },
            {
              "set": "from",
              "to": "2"
            },
            {
              "set": "value",
              "to": "teamAlpha"
            },
            {
              "emit": "st-answered"
            }
          ]
        },
        {
          "id": "st-read-team-beta",
          "from": "st-res-open",
          "to": "st-res-open",
          "on": "st-read-asked",
          "guard": "teamBeta > 0 && teamAllowed == 1 && lockLevel == 0",
          "effects": [
            {
              "set": "reads",
              "to": "reads + 1"
            },
            {
              "set": "seenPerson",
              "to": "personValue"
            },
            {
              "set": "seenTeamAlpha",
              "to": "teamAlpha"
            },
            {
              "set": "seenTeamBeta",
              "to": "teamBeta"
            },
            {
              "set": "seenTenant",
              "to": "tenantValue"
            },
            {
              "set": "seenLocked",
              "to": "lockLevel"
            },
            {
              "set": "seenTeamAllowed",
              "to": "teamAllowed"
            },
            {
              "set": "from",
              "to": "2"
            },
            {
              "set": "value",
              "to": "teamBeta"
            },
            {
              "emit": "st-answered"
            }
          ]
        },
        {
          "id": "st-read-tenant",
          "from": "st-res-open",
          "to": "st-res-open",
          "on": "st-read-asked",
          "guard": "tenantValue > 0",
          "effects": [
            {
              "set": "reads",
              "to": "reads + 1"
            },
            {
              "set": "seenPerson",
              "to": "personValue"
            },
            {
              "set": "seenTeamAlpha",
              "to": "teamAlpha"
            },
            {
              "set": "seenTeamBeta",
              "to": "teamBeta"
            },
            {
              "set": "seenTenant",
              "to": "tenantValue"
            },
            {
              "set": "seenLocked",
              "to": "lockLevel"
            },
            {
              "set": "seenTeamAllowed",
              "to": "teamAllowed"
            },
            {
              "set": "from",
              "to": "1"
            },
            {
              "set": "value",
              "to": "tenantValue"
            },
            {
              "emit": "st-answered"
            }
          ]
        },
        {
          "id": "st-read-default",
          "from": "st-res-open",
          "to": "st-res-open",
          "on": "st-read-asked",
          "effects": [
            {
              "set": "reads",
              "to": "reads + 1"
            },
            {
              "set": "seenPerson",
              "to": "personValue"
            },
            {
              "set": "seenTeamAlpha",
              "to": "teamAlpha"
            },
            {
              "set": "seenTeamBeta",
              "to": "teamBeta"
            },
            {
              "set": "seenTenant",
              "to": "tenantValue"
            },
            {
              "set": "seenLocked",
              "to": "lockLevel"
            },
            {
              "set": "seenTeamAllowed",
              "to": "teamAllowed"
            },
            {
              "set": "from",
              "to": "0"
            },
            {
              "set": "value",
              "to": "0"
            },
            {
              "emit": "st-answered"
            }
          ]
        }
      ]
    },
    {
      "id": "ag-copy-flow",
      "name": "Aggregate result copy",
      "subject": "copy-store",
      "initial": "ag-open",
      "description": "One aggregate of one named query. A request names the audience class of the reader and the number of records the aggregate would examine. The stored result is keyed by the revision of the object types it reads and by the audience class: a commit makes a new key, a result of another class is not served, and an aggregate that would examine more than its bound is refused and never answered in part (D-5062, D-5064, D-5065).",
      "variables": [
        {
          "name": "revision",
          "type": "number",
          "initial": 0
        },
        {
          "name": "hasCopy",
          "type": "number",
          "initial": 0
        },
        {
          "name": "storedRevision",
          "type": "number",
          "initial": 0
        },
        {
          "name": "copyClass",
          "type": "number",
          "initial": 0
        },
        {
          "name": "bound",
          "type": "number",
          "initial": 100
        },
        {
          "name": "asks",
          "type": "number",
          "initial": 0
        },
        {
          "name": "askedRevision",
          "type": "number",
          "initial": 0
        },
        {
          "name": "askedClass",
          "type": "number",
          "initial": 0
        },
        {
          "name": "servedRevision",
          "type": "number",
          "initial": 0
        },
        {
          "name": "servedClass",
          "type": "number",
          "initial": 0
        },
        {
          "name": "computed",
          "type": "number",
          "initial": 0
        },
        {
          "name": "servedFromCopy",
          "type": "number",
          "initial": 0
        },
        {
          "name": "partial",
          "type": "number",
          "initial": 0
        },
        {
          "name": "refusedBound",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "ag-open",
          "name": "Open"
        }
      ],
      "transitions": [
        {
          "id": "ag-commit",
          "from": "ag-open",
          "to": "ag-open",
          "on": "ag-record-committed",
          "effects": [
            {
              "set": "revision",
              "to": "revision + 1"
            }
          ]
        },
        {
          "id": "ag-serve-stale",
          "from": "ag-open",
          "to": "ag-open",
          "on": "ag-asked",
          "guard": "hasCopy == 1 && copyClass == event.class && event.scan <= bound",
          "faultOnly": true,
          "description": "Defect: serves the stored result without comparing the revision of the key.",
          "effects": [
            {
              "set": "asks",
              "to": "asks + 1"
            },
            {
              "set": "askedRevision",
              "to": "revision"
            },
            {
              "set": "askedClass",
              "to": "event.class"
            },
            {
              "set": "servedRevision",
              "to": "storedRevision"
            },
            {
              "set": "servedClass",
              "to": "copyClass"
            },
            {
              "set": "servedFromCopy",
              "to": "servedFromCopy + 1"
            },
            {
              "emit": "ag-served-from-copy"
            }
          ]
        },
        {
          "id": "ag-serve-other-class",
          "from": "ag-open",
          "to": "ag-open",
          "on": "ag-asked",
          "guard": "hasCopy == 1 && storedRevision == revision && event.scan <= bound",
          "faultOnly": true,
          "description": "Defect: serves the stored result to a principal of another audience class.",
          "effects": [
            {
              "set": "asks",
              "to": "asks + 1"
            },
            {
              "set": "askedRevision",
              "to": "revision"
            },
            {
              "set": "askedClass",
              "to": "event.class"
            },
            {
              "set": "servedRevision",
              "to": "storedRevision"
            },
            {
              "set": "servedClass",
              "to": "copyClass"
            },
            {
              "set": "servedFromCopy",
              "to": "servedFromCopy + 1"
            },
            {
              "emit": "ag-served-from-copy"
            }
          ]
        },
        {
          "id": "ag-answer-partial",
          "from": "ag-open",
          "to": "ag-open",
          "on": "ag-asked",
          "guard": "event.scan > bound",
          "faultOnly": true,
          "description": "Defect: answers from the records up to the bound instead of refusing.",
          "effects": [
            {
              "set": "asks",
              "to": "asks + 1"
            },
            {
              "set": "askedRevision",
              "to": "revision"
            },
            {
              "set": "askedClass",
              "to": "event.class"
            },
            {
              "set": "partial",
              "to": "partial + 1"
            },
            {
              "emit": "ag-partial-answered"
            }
          ]
        },
        {
          "id": "ag-refuse-bound",
          "from": "ag-open",
          "to": "ag-open",
          "on": "ag-asked",
          "guard": "event.scan > bound",
          "effects": [
            {
              "set": "refusedBound",
              "to": "refusedBound + 1"
            },
            {
              "emit": "ag-refused-bound"
            }
          ]
        },
        {
          "id": "ag-serve-copy",
          "from": "ag-open",
          "to": "ag-open",
          "on": "ag-asked",
          "guard": "hasCopy == 1 && storedRevision == revision && copyClass == event.class",
          "effects": [
            {
              "set": "asks",
              "to": "asks + 1"
            },
            {
              "set": "askedRevision",
              "to": "revision"
            },
            {
              "set": "askedClass",
              "to": "event.class"
            },
            {
              "set": "servedRevision",
              "to": "storedRevision"
            },
            {
              "set": "servedClass",
              "to": "copyClass"
            },
            {
              "set": "servedFromCopy",
              "to": "servedFromCopy + 1"
            },
            {
              "emit": "ag-served-from-copy"
            }
          ]
        },
        {
          "id": "ag-compute",
          "from": "ag-open",
          "to": "ag-open",
          "on": "ag-asked",
          "effects": [
            {
              "set": "asks",
              "to": "asks + 1"
            },
            {
              "set": "askedRevision",
              "to": "revision"
            },
            {
              "set": "askedClass",
              "to": "event.class"
            },
            {
              "set": "computed",
              "to": "computed + 1"
            },
            {
              "set": "hasCopy",
              "to": "1"
            },
            {
              "set": "storedRevision",
              "to": "revision"
            },
            {
              "set": "copyClass",
              "to": "event.class"
            },
            {
              "set": "servedRevision",
              "to": "revision"
            },
            {
              "set": "servedClass",
              "to": "event.class"
            },
            {
              "emit": "ag-computed"
            }
          ]
        }
      ]
    },
    {
      "id": "promotion-redeem-flow",
      "name": "Redeem a promotion through a tenant operation",
      "subject": "runtime",
      "initial": "opr-open",
      "realisation": "target",
      "description": "One promotion with a stock of 2 in a pool account with a floor of 0, a limit of one redemption per person counted in each person's account, an eligible segment and a window. Persons a, b and d invoke the redeem operation with keys a1, a2, b1 and d1; the event says whether the person is a member of the segment. An accepted invocation commits the redemption record, the debit of the pool and the credit of the person's count together (OPR-1541); a refused one changes nothing.",
      "variables": [
        {
          "name": "stock",
          "type": "number",
          "initial": 2
        },
        {
          "name": "poolDebits",
          "type": "number",
          "initial": 0
        },
        {
          "name": "redemptions",
          "type": "number",
          "initial": 0
        },
        {
          "name": "counta",
          "type": "number",
          "initial": 0
        },
        {
          "name": "countb",
          "type": "number",
          "initial": 0
        },
        {
          "name": "countd",
          "type": "number",
          "initial": 0
        },
        {
          "name": "limit",
          "type": "number",
          "initial": 1
        },
        {
          "name": "open",
          "type": "boolean",
          "initial": true
        },
        {
          "name": "nonMember",
          "type": "number",
          "initial": 0
        },
        {
          "name": "keysApplied",
          "type": "number",
          "initial": 0
        },
        {
          "name": "seenA1",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "seenB1",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "seenD1",
          "type": "boolean",
          "initial": false
        }
      ],
      "states": [
        {
          "id": "opr-open",
          "name": "Accepting invocations"
        }
      ],
      "transitions": [
        {
          "id": "opr-replay-applies-again",
          "from": "opr-open",
          "to": "opr-open",
          "on": "opr-redeem-requested",
          "guard": "event.key == 'a1' && seenA1",
          "faultOnly": true,
          "description": "Defect: a repeated key is applied again.",
          "effects": [
            {
              "set": "stock",
              "to": "stock - 1"
            },
            {
              "set": "poolDebits",
              "to": "poolDebits + 1"
            },
            {
              "set": "counta",
              "to": "counta + 1"
            },
            {
              "set": "redemptions",
              "to": "redemptions + 1"
            },
            {
              "emit": "opr-redeem-committed"
            }
          ]
        },
        {
          "id": "opr-segment-ignored",
          "from": "opr-open",
          "to": "opr-open",
          "on": "opr-redeem-requested",
          "guard": "!event.member",
          "faultOnly": true,
          "description": "Defect: the segment condition is not checked.",
          "effects": [
            {
              "set": "stock",
              "to": "stock - 1"
            },
            {
              "set": "poolDebits",
              "to": "poolDebits + 1"
            },
            {
              "set": "counta",
              "to": "counta + 1"
            },
            {
              "set": "redemptions",
              "to": "redemptions + 1"
            },
            {
              "set": "nonMember",
              "to": "nonMember + 1"
            },
            {
              "emit": "opr-redeem-committed"
            }
          ]
        },
        {
          "id": "opr-partial-commit",
          "from": "opr-open",
          "to": "opr-open",
          "on": "opr-redeem-requested",
          "guard": "stock < 1",
          "faultOnly": true,
          "description": "Defect: the redemption record and the person's count commit although the debit of the pool was refused.",
          "effects": [
            {
              "set": "redemptions",
              "to": "redemptions + 1"
            },
            {
              "set": "countd",
              "to": "countd + 1"
            },
            {
              "emit": "opr-refused-pool"
            }
          ]
        },
        {
          "id": "opr-pool-floor-ignored",
          "from": "opr-open",
          "to": "opr-open",
          "on": "opr-redeem-requested",
          "guard": "stock < 1",
          "faultOnly": true,
          "description": "Defect: a debit past the floor of the pool is applied.",
          "effects": [
            {
              "set": "stock",
              "to": "stock - 1"
            },
            {
              "set": "poolDebits",
              "to": "poolDebits + 1"
            },
            {
              "set": "countd",
              "to": "countd + 1"
            },
            {
              "set": "redemptions",
              "to": "redemptions + 1"
            },
            {
              "emit": "opr-redeem-committed"
            }
          ]
        },
        {
          "id": "opr-replay-a1",
          "from": "opr-open",
          "to": "opr-open",
          "on": "opr-redeem-requested",
          "guard": "event.key == 'a1' && seenA1",
          "effects": [
            {
              "emit": "opr-redeem-replayed"
            }
          ]
        },
        {
          "id": "opr-replay-b1",
          "from": "opr-open",
          "to": "opr-open",
          "on": "opr-redeem-requested",
          "guard": "event.key == 'b1' && seenB1",
          "effects": [
            {
              "emit": "opr-redeem-replayed"
            }
          ]
        },
        {
          "id": "opr-replay-d1",
          "from": "opr-open",
          "to": "opr-open",
          "on": "opr-redeem-requested",
          "guard": "event.key == 'd1' && seenD1",
          "effects": [
            {
              "emit": "opr-redeem-replayed"
            }
          ]
        },
        {
          "id": "opr-refuse-segment",
          "from": "opr-open",
          "to": "opr-open",
          "on": "opr-redeem-requested",
          "guard": "!event.member",
          "effects": [
            {
              "emit": "opr-refused-condition"
            }
          ]
        },
        {
          "id": "opr-refuse-window",
          "from": "opr-open",
          "to": "opr-open",
          "on": "opr-redeem-requested",
          "guard": "!open",
          "effects": [
            {
              "emit": "opr-refused-condition"
            }
          ]
        },
        {
          "id": "opr-refuse-limit-a",
          "from": "opr-open",
          "to": "opr-open",
          "on": "opr-redeem-requested",
          "guard": "event.person == 'a' && counta >= limit",
          "effects": [
            {
              "emit": "opr-refused-limit"
            }
          ]
        },
        {
          "id": "opr-refuse-limit-b",
          "from": "opr-open",
          "to": "opr-open",
          "on": "opr-redeem-requested",
          "guard": "event.person == 'b' && countb >= limit",
          "effects": [
            {
              "emit": "opr-refused-limit"
            }
          ]
        },
        {
          "id": "opr-refuse-limit-d",
          "from": "opr-open",
          "to": "opr-open",
          "on": "opr-redeem-requested",
          "guard": "event.person == 'd' && countd >= limit",
          "effects": [
            {
              "emit": "opr-refused-limit"
            }
          ]
        },
        {
          "id": "opr-refuse-pool",
          "from": "opr-open",
          "to": "opr-open",
          "on": "opr-redeem-requested",
          "guard": "stock < 1",
          "effects": [
            {
              "emit": "opr-refused-pool"
            }
          ]
        },
        {
          "id": "opr-commit-a",
          "from": "opr-open",
          "to": "opr-open",
          "on": "opr-redeem-requested",
          "guard": "event.person == 'a'",
          "effects": [
            {
              "set": "stock",
              "to": "stock - 1"
            },
            {
              "set": "poolDebits",
              "to": "poolDebits + 1"
            },
            {
              "set": "counta",
              "to": "counta + 1"
            },
            {
              "set": "redemptions",
              "to": "redemptions + 1"
            },
            {
              "set": "keysApplied",
              "to": "keysApplied + 1"
            },
            {
              "set": "seenA1",
              "to": "seenA1 || event.key == 'a1'"
            },
            {
              "emit": "opr-redeem-committed"
            }
          ]
        },
        {
          "id": "opr-commit-b",
          "from": "opr-open",
          "to": "opr-open",
          "on": "opr-redeem-requested",
          "guard": "event.person == 'b'",
          "effects": [
            {
              "set": "stock",
              "to": "stock - 1"
            },
            {
              "set": "poolDebits",
              "to": "poolDebits + 1"
            },
            {
              "set": "countb",
              "to": "countb + 1"
            },
            {
              "set": "redemptions",
              "to": "redemptions + 1"
            },
            {
              "set": "keysApplied",
              "to": "keysApplied + 1"
            },
            {
              "set": "seenB1",
              "to": "seenB1 || event.key == 'b1'"
            },
            {
              "emit": "opr-redeem-committed"
            }
          ]
        },
        {
          "id": "opr-commit-d",
          "from": "opr-open",
          "to": "opr-open",
          "on": "opr-redeem-requested",
          "guard": "event.person == 'd'",
          "effects": [
            {
              "set": "stock",
              "to": "stock - 1"
            },
            {
              "set": "poolDebits",
              "to": "poolDebits + 1"
            },
            {
              "set": "countd",
              "to": "countd + 1"
            },
            {
              "set": "redemptions",
              "to": "redemptions + 1"
            },
            {
              "set": "keysApplied",
              "to": "keysApplied + 1"
            },
            {
              "set": "seenD1",
              "to": "seenD1 || event.key == 'd1'"
            },
            {
              "emit": "opr-redeem-committed"
            }
          ]
        },
        {
          "id": "opr-close-window",
          "from": "opr-open",
          "to": "opr-open",
          "on": "opr-window-closed",
          "effects": [
            {
              "set": "open",
              "to": false
            }
          ]
        }
      ]
    },
    {
      "id": "automation-run-as-flow",
      "name": "Run-as authority of one automation",
      "subject": "automation-worker",
      "initial": "ra-active",
      "description": "One automation and its definer. A step runs only while the automation is active. A change that leaves the definer unable to confer a role of the run-as suspends the automation in its own transaction; a suspended automation parks its steps and becomes active again only when a principal who may confer every role defines it again (WFL-1528, WFL-1529).",
      "variables": [
        {
          "name": "ran",
          "type": "number",
          "initial": 0
        },
        {
          "name": "parked",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "ra-active",
          "name": "Active"
        },
        {
          "id": "ra-suspended-state",
          "name": "Suspended"
        }
      ],
      "transitions": [
        {
          "id": "ra-run",
          "from": "ra-active",
          "to": "ra-active",
          "on": "ra-step",
          "effects": [
            {
              "set": "ran",
              "to": "ran + 1"
            },
            {
              "emit": "ra-ran"
            }
          ]
        },
        {
          "id": "ra-keep",
          "from": "ra-active",
          "to": "ra-active",
          "on": "ra-authority",
          "guard": "event.holds"
        },
        {
          "id": "ra-lose",
          "from": "ra-active",
          "to": "ra-suspended-state",
          "on": "ra-authority",
          "guard": "!event.holds",
          "effects": [
            {
              "emit": "ra-suspended"
            }
          ]
        },
        {
          "id": "ra-run-while-suspended",
          "from": "ra-suspended-state",
          "to": "ra-suspended-state",
          "on": "ra-step",
          "faultOnly": true,
          "description": "Defect: a step runs on the authority the definer no longer has.",
          "effects": [
            {
              "set": "ran",
              "to": "ran + 1"
            },
            {
              "emit": "ra-ran"
            }
          ]
        },
        {
          "id": "ra-park",
          "from": "ra-suspended-state",
          "to": "ra-suspended-state",
          "on": "ra-step",
          "effects": [
            {
              "set": "parked",
              "to": "parked + 1"
            },
            {
              "emit": "ra-parked"
            }
          ]
        },
        {
          "id": "ra-resume",
          "from": "ra-suspended-state",
          "to": "ra-active",
          "on": "ra-redefine",
          "guard": "event.holds"
        },
        {
          "id": "ra-refuse",
          "from": "ra-suspended-state",
          "to": "ra-suspended-state",
          "on": "ra-redefine",
          "guard": "!event.holds",
          "effects": [
            {
              "emit": "ra-refused"
            }
          ]
        }
      ],
      "realisation": "target"
    },
    {
      "id": "automation-wait-hop-flow",
      "name": "Hop count across a wait",
      "subject": "automation-worker",
      "initial": "awh-live",
      "description": "An automation whose run waits five ticks and then changes a record that starts the automation again. The run keeps the hop count of its event through the wait and the change it commits carries that count plus one, so the loop ends at the hop limit of eight that D-700 states, however long each run waits (SCH-1533). Past the limit the trigger writes a declined record (SCH-1532).",
      "variables": [
        {
          "name": "runs",
          "type": "number",
          "initial": 0
        },
        {
          "name": "declined",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "awh-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "wh-start",
          "from": "awh-live",
          "to": "awh-live",
          "on": "wh-event",
          "guard": "event.hop <= 8",
          "effects": [
            {
              "set": "runs",
              "to": "runs + 1"
            },
            {
              "emit": "wh-run"
            },
            {
              "emit": "wh-event",
              "after": 5,
              "payload": {
                "hop": "event.hop + 1"
              }
            }
          ]
        },
        {
          "id": "wh-wait-resets",
          "from": "awh-live",
          "to": "awh-live",
          "on": "wh-event",
          "guard": "event.hop <= 8",
          "faultOnly": true,
          "description": "Defect: the wait starts the run's count again, so the loop never ends.",
          "effects": [
            {
              "set": "runs",
              "to": "runs + 1"
            },
            {
              "emit": "wh-run"
            },
            {
              "emit": "wh-event",
              "after": 5,
              "payload": {
                "hop": 1
              }
            }
          ]
        },
        {
          "id": "wh-decline",
          "from": "awh-live",
          "to": "awh-live",
          "on": "wh-event",
          "guard": "event.hop > 8",
          "effects": [
            {
              "set": "declined",
              "to": "declined + 1"
            },
            {
              "emit": "wh-declined"
            }
          ]
        }
      ],
      "realisation": "target"
    },
    {
      "id": "automation-job-quota-flow",
      "name": "Job quota at the commit that creates a job",
      "subject": "automation-worker",
      "initial": "jq-live",
      "description": "One tenant whose plan allows two jobs a day, scaled down from D-508. Every commit commits; a job within the quota is created due as usual and a job past it is held for the next quota day with a held record, where it counts against that day (SCH-1535).",
      "variables": [
        {
          "name": "commits",
          "type": "number",
          "initial": 0
        },
        {
          "name": "today",
          "type": "number",
          "initial": 0
        },
        {
          "name": "held",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "jq-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "jq-create",
          "from": "jq-live",
          "to": "jq-live",
          "on": "jq-commit",
          "guard": "today < 2",
          "effects": [
            {
              "set": "commits",
              "to": "commits + 1"
            },
            {
              "set": "today",
              "to": "today + 1"
            },
            {
              "emit": "jq-job"
            }
          ]
        },
        {
          "id": "jq-hold",
          "from": "jq-live",
          "to": "jq-live",
          "on": "jq-commit",
          "guard": "today >= 2",
          "effects": [
            {
              "set": "commits",
              "to": "commits + 1"
            },
            {
              "set": "held",
              "to": "held + 1"
            },
            {
              "emit": "jq-held"
            }
          ]
        },
        {
          "id": "jq-refuse-change",
          "from": "jq-live",
          "to": "jq-live",
          "on": "jq-commit",
          "guard": "today >= 2",
          "faultOnly": true,
          "description": "Defect: the job quota refuses the change that would create the job.",
          "effects": [
            {
              "emit": "jq-refused"
            }
          ]
        },
        {
          "id": "jq-new-day",
          "from": "jq-live",
          "to": "jq-live",
          "on": "jq-day",
          "effects": [
            {
              "set": "today",
              "to": "held"
            },
            {
              "set": "held",
              "to": "0"
            }
          ]
        }
      ],
      "realisation": "target"
    },
    {
      "id": "automation-step-key-flow",
      "name": "One step attempted three times",
      "subject": "automation-worker",
      "initial": "ask-live",
      "description": "One step whose first attempt applies its effect and loses its result. Every attempt carries the same derived key (SCH-1524), so the second and third attempts are answered with the recorded effect and the effect is applied once.",
      "variables": [
        {
          "name": "attempts",
          "type": "number",
          "initial": 0
        },
        {
          "name": "effects",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "ask-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "sk-apply",
          "from": "ask-live",
          "to": "ask-live",
          "on": "sk-attempt",
          "guard": "effects == 0",
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "effects",
              "to": "effects + 1"
            },
            {
              "emit": "sk-applied"
            }
          ]
        },
        {
          "id": "sk-answer",
          "from": "ask-live",
          "to": "ask-live",
          "on": "sk-attempt",
          "guard": "effects > 0",
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "emit": "sk-answered"
            }
          ]
        },
        {
          "id": "sk-key-per-attempt",
          "from": "ask-live",
          "to": "ask-live",
          "on": "sk-attempt",
          "guard": "effects > 0",
          "faultOnly": true,
          "description": "Defect: the key changes with the attempt, so a retry applies the effect again.",
          "effects": [
            {
              "set": "attempts",
              "to": "attempts + 1"
            },
            {
              "set": "effects",
              "to": "effects + 1"
            },
            {
              "emit": "sk-applied"
            }
          ]
        }
      ],
      "realisation": "target"
    },
    {
      "id": "catalogue-invocation-flow",
      "name": "Catalogue invocation",
      "subject": "agent-gateway",
      "initial": "ci-ready",
      "description": "An operation of the catalogue runs a contract only for a caller that holds the capability and a role that the contract requires (AGT-1209, D-6210).",
      "variables": [],
      "states": [
        {
          "id": "ci-ready",
          "name": "Ready"
        }
      ],
      "transitions": [
        {
          "id": "ci-apply-unchecked",
          "from": "ci-ready",
          "to": "ci-ready",
          "on": "ci-invoked",
          "faultOnly": true,
          "description": "Defect: runs the contract without checking the capability and the role of the contract.",
          "effects": [
            {
              "emit": "ci-applied"
            }
          ]
        },
        {
          "id": "ci-apply",
          "from": "ci-ready",
          "to": "ci-ready",
          "on": "ci-invoked",
          "guard": "event.capability == 'held'",
          "effects": [
            {
              "emit": "ci-applied"
            }
          ]
        },
        {
          "id": "ci-refuse",
          "from": "ci-ready",
          "to": "ci-ready",
          "on": "ci-invoked",
          "effects": [
            {
              "emit": "ci-refused"
            }
          ]
        }
      ],
      "realisation": "target"
    }
  ],
  "faults": [
    {"id":"defect-link-replay","name":"A used link is accepted again","kind":"enable-transition","transition":"ml-accept-again","description":"The defect that IDN-003 forbids."},
    {"id":"defect-link-unchecked","name":"A link is accepted without lifetime or browser checks","kind":"enable-transition","transition":"ml-accept-unchecked","description":"The defect that IDN-004 and IDN-005 forbid."},
    {"id":"link-acceptance-disabled","name":"Links cannot be accepted","kind":"disable-transition","transition":"ml-accept","description":"Shows that the acceptance claim can fail."},
    {"id":"defect-oidc-state-unchecked","name":"A callback is accepted without comparing its state","kind":"enable-transition","transition":"oidc-accept-any-state","description":"The defect that FED-001 forbids."},
    {"id":"oidc-acceptance-disabled","name":"Callbacks cannot be accepted","kind":"disable-transition","transition":"oidc-accept","description":"Shows that the acceptance claim can fail."},
    {"id":"revocation-notice-dropped","name":"The revocation notice is dropped","kind":"drop-event","event":"sr-notice","description":"A gateway does not hear about a revocation.","realises":"fm-revocation-notice-lost"},
    {"id":"defect-gateway-no-recheck","name":"The gateway trusts its session copy forever","kind":"enable-transition","transition":"gs-accept-without-recheck","description":"The defect that IDN-013 forbids."},
    {"id":"defect-result-token-unchecked","name":"A result is recorded without checking its token","kind":"enable-transition","transition":"jl-complete-any-token","description":"The defect that SCH-011 forbids."},
    {"id":"completion-disabled","name":"Results cannot be recorded","kind":"disable-transition","transition":"jl-complete","description":"Shows that the completion claim can fail."},
    {"id":"purge-dropped","name":"The purge is dropped","kind":"drop-event","event":"ec-purge","description":"The content delivery network does not hear about a change.","realises":"fm-purge-lost"},
    {"id":"defect-edge-ignores-lifetime","name":"The edge serves a copy past its lifetime","kind":"enable-transition","transition":"eg-serve-past-lifetime","description":"The defect that EDG-006 forbids."},
    {"id":"defect-early-activation","name":"A tenant is reported active before it is ready","kind":"enable-transition","transition":"pv-activate-early","description":"The defect that TEN-002 forbids."},
    {"id":"defect-apply-unapproved","name":"A risky change is applied without approval","kind":"enable-transition","transition":"cp-apply-unapproved","description":"The defect that AGT-011 forbids."},
    {"id":"defect-apply-rejected","name":"A rejected change is applied","kind":"enable-transition","transition":"cp-apply-rejected","description":"The defect that AGT-011 forbids, on a rejected proposal."},
    {"id":"arc-defect-outbox-duplicate-applied","name":"A redelivered notice makes its effect again","kind":"enable-transition","transition":"arc-ob-apply-again","description":"The defect that ARC-104 forbids."},
    {"id":"arc-publisher-stops","name":"The runtime stops before it publishes","kind":"disable-transition","transition":"arc-od-publish-now","description":"A runtime crashes after its commit and before its publication.","realises":"fm-runtime-crash"},
    {"id":"arc-publisher-stops-impl","name":"The runtime stops between its commit and its publication (implementation)","kind":"lose-event","description":"The runtime that committed stops after the commit and before it dispatches its publish-now signal, an at-most-once message, which is lost (lose-event): the runtime cannot switch a transition of the machine off, but it can lose this message.","event":"arc-ob-publish-now"},
    {"id":"arc-recovery-disabled","name":"The outbox job does not publish","kind":"disable-transition","transition":"arc-od-sweep","description":"Shows that the recovery claim can fail."},
    {"id":"arc-defect-new-format-early","name":"A commit writes the newer format during a rolling deployment","kind":"enable-transition","transition":"arc-rl-commit-early","description":"The defect that ARC-106 forbids."},
    {"id":"defect-webhook-no-dedupe","name":"A repeated delivery starts a second run","kind":"enable-transition","transition":"iw-accept-again","description":"The defect that INT-151 forbids."},
    {"id":"defect-preview-unchecked","name":"A preview link shows the draft after its expiry","kind":"enable-transition","transition":"pl-show-expired","description":"The defect that CMS-159 forbids."},
    {"id":"defect-cv-apply-unconfirmed","name":"A preview is applied without confirmation","kind":"enable-transition","transition":"cf-apply-unconfirmed","description":"The defect that CNV-206 forbids."},
    {"id":"defect-cv-apply-stale","name":"An operation runs on a permission the person no longer holds","kind":"enable-transition","transition":"ca-run-stale","description":"The defect that CNV-203 forbids."},
    {"id":"cv-run-disabled","name":"Operations cannot be committed","kind":"disable-transition","transition":"ca-run","description":"Shows that the commit claim can fail."},
    {"id":"defect-saml-replay-accepted","name":"A used SAML assertion is accepted again","kind":"enable-transition","transition":"sam-accept-replay","description":"The defect that FED-006 forbids."},
    {"id":"defect-throttle-ignored","name":"A guess is evaluated after the throttle closes","kind":"enable-transition","transition":"gt-ignore-throttle","description":"The defect that IDN-250 forbids."},
    {"id":"identity-answer-dropped","name":"The identity service's answers are dropped","kind":"drop-event","event":"sr-lookup-answer","description":"The gateway never hears back from the identity service.","realises":"fm-identity-outage"},
    {"id":"defect-gateway-accepts-unanswered","name":"The gateway accepts while a lookup is unanswered","kind":"enable-transition","transition":"go-accept-unanswered","description":"The defect that IDN-300 forbids."},
    {"id":"outage-refusal-disabled","name":"Refusals during an outage cannot be sent","kind":"disable-transition","transition":"go-refuse-outage","description":"Shows that the refusal claim can fail."},
