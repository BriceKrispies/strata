    {
      "id": "redact-rows",
      "description": "read.rs read, the last step: every row as the reader receives it (redact), with the snapshot's lookup; the first InsufficientState of a row ends the read.",
      "params": [
        {
          "name": "t",
          "type": "tenant-state"
        },
        {
          "name": "coverage",
          "type": "coverage"
        },
        {
          "name": "principal",
          "type": "principal"
        },
        {
          "name": "now",
          "type": "timestamp"
        },
        {
          "name": "rows",
          "type": "list<record>"
        }
      ],
      "returns": "list<record>",
      "body": "map(r in rows, try call redact(t, coverage, principal, now, r))",
      "examples": [
        {
          "args": {
            "t": {
              "fixture": "fx-tenant-state-23"
            },
            "coverage": "complete",
            "principal": "anonymous",
            "now": 3000,
