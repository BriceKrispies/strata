    {
      "id": "fx-object-type-def-2",
      "type": "object-type-def",
      "value": {
        "id": "post",
        "label": "Post",
        "fields": {
          "author": {
            "id": "author",
            "label": "Author",
            "ty": {
              "ref": {
                "target": "author",
                "on-delete": "restrict"
              }
            },
            "required": true,
            "unique": false
          },
          "body": {
            "id": "body",
            "label": "Body",
            "ty": "str",
            "required": true,
            "unique": false
          },
          "excerpt": {
            "id": "excerpt",
            "label": "Excerpt",
            "ty": "str",
            "required": false,
            "unique": false
          },
          "featured": {
            "id": "featured",
            "label": "Featured",
            "ty": "bool",
            "required": false,
            "unique": false
          },
          "published_at": {
            "id": "published_at",
            "label": "Published",
            "ty": "time",
            "required": false,
            "unique": false
          },
          "slug": {
            "id": "slug",
            "label": "Slug",
            "ty": "str",
            "required": true,
            "unique": true
          },
          "status": {
            "id": "status",
            "label": "Status",
            "ty": "str",
            "required": true,
            "unique": false,
            "default": {
              "lit": {
                "str": "draft"
              }
            }
          },
          "title": {
            "id": "title",
            "label": "Title",
            "ty": "str",
            "required": true,
            "unique": false
          }
        },
        "constraints": {
          "author_fixed": {
            "id": "author_fixed",
            "expr": {
              "or": [
                {
                  "is-null": "principal"
                },
                {
                  "has-role": "editor"
                },
                {
                  "has-role": "owner"
                },
                {
                  "is-null": {
                    "var": {
                      "scope": "old",
                      "field": "$id"
                    }
                  }
                },
                {
                  "cmp": {
                    "op": "eq",
                    "left": {
                      "var": {
                        "scope": "new",
                        "field": "author"
                      }
                    },
                    "right": {
                      "var": {
                        "scope": "old",
                        "field": "author"
                      }
                    }
                  }
                }
              ]
            },
            "message": "Only an editor changes whose byline a post carries"
          },
          "excerpt_length": {
            "id": "excerpt_length",
            "expr": {
              "cmp": {
                "op": "le",
                "left": {
                  "len": {
                    "var": {
                      "scope": "new",
                      "field": "excerpt"
                    }
                  }
                },
                "right": {
                  "lit": {
                    "int": 280
                  }
                }
              }
            },
            "message": "An excerpt has at most 280 characters"
          },
          "featured_by_editors": {
            "id": "featured_by_editors",
            "expr": {
              "or": [
                {
                  "is-null": "principal"
                },
                {
                  "has-role": "editor"
                },
                {
                  "has-role": "owner"
                },
                {
                  "cmp": {
                    "op": "eq",
                    "left": {
                      "and": [
                        {
                          "not": {
                            "is-null": {
                              "var": {
                                "scope": "new",
                                "field": "featured"
                              }
                            }
                          }
                        },
                        {
                          "cmp": {
                            "op": "eq",
                            "left": {
                              "var": {
                                "scope": "new",
                                "field": "featured"
                              }
                            },
                            "right": {
                              "lit": {
                                "bool": true
                              }
                            }
                          }
                        }
                      ]
                    },
                    "right": {
                      "and": [
                        {
                          "not": {
                            "is-null": {
                              "var": {
                                "scope": "old",
                                "field": "featured"
                              }
                            }
                          }
                        },
                        {
                          "cmp": {
                            "op": "eq",
                            "left": {
                              "var": {
                                "scope": "old",
                                "field": "featured"
                              }
                            },
                            "right": {
                              "lit": {
                                "bool": true
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              ]
            },
            "message": "Only an editor features a post"
          },
          "published_at_by_editors": {
            "id": "published_at_by_editors",
            "expr": {
              "or": [
                {
                  "is-null": "principal"
                },
                {
                  "has-role": "editor"
                },
                {
                  "has-role": "owner"
                },
                {
                  "if": {
                    "condition": {
                      "is-null": {
                        "var": {
                          "scope": "old",
                          "field": "published_at"
                        }
                      }
                    },
                    "then": {
                      "is-null": {
                        "var": {
                          "scope": "new",
                          "field": "published_at"
                        }
                      }
                    },
                    "else": {
                      "and": [
                        {
                          "not": {
                            "is-null": {
                              "var": {
                                "scope": "new",
                                "field": "published_at"
                              }
                            }
                          }
                        },
                        {
                          "cmp": {
                            "op": "eq",
                            "left": {
                              "var": {
                                "scope": "new",
                                "field": "published_at"
                              }
                            },
                            "right": {
                              "var": {
                                "scope": "old",
                                "field": "published_at"
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                {
                  "and": [
                    {
                      "not": {
                        "is-null": {
                          "var": {
                            "scope": "old",
                            "field": "status"
                          }
                        }
                      }
                    },
                    {
                      "cmp": {
                        "op": "eq",
                        "left": {
                          "var": {
                            "scope": "old",
                            "field": "status"
                          }
                        },
                        "right": {
                          "lit": {
                            "str": "draft"
                          }
                        }
                      }
                    },
                    {
                      "cmp": {
                        "op": "eq",
                        "left": {
                          "var": {
                            "scope": "new",
                            "field": "status"
                          }
                        },
                        "right": {
                          "lit": {
                            "str": "published"
                          }
                        }
                      }
                    },
                    {
                      "cmp": {
                        "op": "eq",
                        "left": {
                          "var": {
                            "scope": "new",
                            "field": "published_at"
                          }
                        },
                        "right": "now"
                      }
                    }
                  ]
                }
              ]
            },
            "message": "Only an editor sets when a post was published; publishing stamps the time itself"
          }
        }
      },
      "description": "Example value of type object-type-def, shared by 5 example argument(s) (WG-4963)."
