              "ref": {
                "target": "author",
                "on-delete": "restrict"
              }
            },
            "j": {
              "string": "@nobody"
            },
            "refs": {},
            "times": {}
          },
          "error": {
            "message": "unknown record key @nobody"
          }
        },
        {
          "args": {
            "ty": {
              "ref": {
                "target": "author",
                "on-delete": "restrict"
              }
            },
            "j": {
              "string": "ines"
            },
            "refs": {},
            "times": {}
          },
          "error": {
            "message": "expected reference<author>, got \"ines\""
          }
        },
        {
          "args": {
            "ty": "str",
            "j": {
              "object": {
                "a": {
                  "number": {
                    "pos-int": 1
                  }
                }
              }
            },
            "refs": {},
            "times": {}
