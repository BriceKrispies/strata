            },
            {
              "emit": "mr-denied",
              "to": "mail-dispatcher"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "mr-live-i": "mr-live"
        },
        "variables": {
          "returned": "returned",
          "denied": "denied"
        },
        "transitions": {
          "mr-return-i": "mr-return",
          "mr-deny-i": "mr-deny"
        }
      },
      "storage": {
        "record": "rec-mail-log-read",
        "key": "read-id",
        "creates": true
      }
    },
    {
      "id": "sender-domain-flow",
      "name": "Sender domain",
      "subject": "mail-dispatcher",
      "initial": "sd-pending",
      "description": "One tenant sending mail. Until the tenant proves control of a domain, its mail goes from an address of the platform that names the tenant and is signed with the key of the platform. After the proof, its mail goes from an address on the domain and is signed with a key published under that domain.",
      "variables": [
        {
          "name": "lastFrom",
          "type": "string",
          "initial": ""
        },
        {
          "name": "lastSignedBy",
          "type": "string",
          "initial": ""
        }
      ],
      "states": [
        {
          "id": "sd-pending",
          "name": "Domain not proved"
        },
        {
          "id": "sd-proved",
          "name": "Domain proved"
        }
      ],
      "transitions": [
        {
          "id": "sd-prove",
          "from": "sd-pending",
          "to": "sd-proved",
          "on": "sd-verify",
          "guard": "event.dnsOk",
          "effects": []
        },
        {
          "id": "sd-proof-missing",
          "from": "sd-pending",
          "to": "sd-pending",
          "on": "sd-verify",
          "effects": []
        },
        {
          "id": "sd-send-unproved-from-domain",
          "from": "sd-pending",
          "to": "sd-pending",
          "on": "sd-send",
          "description": "Defect: sends from the domain of the tenant before the tenant proved control of it.",
          "faultOnly": true,
          "effects": [
            {
              "set": "lastFrom",
              "to": "'tenant-domain'"
            },
            {
              "set": "lastSignedBy",
              "to": "'tenant-key'"
            },
            {
              "emit": "sd-sent-tenant"
            }
          ]
        },
        {
          "id": "sd-send-from-platform",
          "from": "sd-pending",
          "to": "sd-pending",
          "on": "sd-send",
          "effects": [
            {
              "set": "lastFrom",
              "to": "'platform'"
            },
            {
              "set": "lastSignedBy",
              "to": "'platform-key'"
            },
            {
              "emit": "sd-sent-platform"
            }
          ]
        },
        {
          "id": "sd-send-unsigned",
          "from": "sd-proved",
          "to": "sd-proved",
          "on": "sd-send",
          "description": "Defect: sends from the tenant domain without the signature of its key.",
          "faultOnly": true,
          "effects": [
            {
              "set": "lastFrom",
              "to": "'tenant-domain'"
            },
            {
              "set": "lastSignedBy",
              "to": "''"
            },
            {
              "emit": "sd-sent-tenant"
            }
          ]
        },
        {
          "id": "sd-send-from-domain",
          "from": "sd-proved",
          "to": "sd-proved",
          "on": "sd-send",
          "effects": [
            {
              "set": "lastFrom",
              "to": "'tenant-domain'"
            },
            {
              "set": "lastSignedBy",
              "to": "'tenant-key'"
            },
            {
              "emit": "sd-sent-tenant"
            }
          ]
        }
      ]
    },
    {
      "id": "sender-domain-flow-impl",
      "name": "Sender domain (implementation)",
      "level": "implementation",
      "subject": "mail-dispatcher",
      "refines": "sender-domain-flow",
      "description": "One tenant sending mail. Until the tenant proves control of a domain, its mail goes from an address of the platform that names the tenant and is signed with the key of the platform. After the proof, its mail goes from an address on the domain and is signed with a key published under that domain.",
      "initial": "sd-pending-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "lastFrom",
          "type": "string",
          "initial": "",
          "repr": "string"
        },
        {
          "name": "lastSignedBy",
          "type": "string",
          "initial": "",
          "repr": "string"
        }
      ],
      "states": [
        {
          "id": "sd-pending-i",
          "name": "Domain not proved"
        },
        {
          "id": "sd-proved-i",
          "name": "Domain proved",
          "ignores": [
            "sd-verify"
          ]
        }
      ],
      "transitions": [
        {
          "id": "sd-prove-i",
          "from": "sd-pending-i",
          "to": "sd-proved-i",
          "on": "sd-verify",
          "guard": "event.dnsOk",
          "effects": []
        },
        {
          "id": "sd-proof-missing-i",
          "from": "sd-pending-i",
          "to": "sd-pending-i",
          "on": "sd-verify",
          "otherwise": true,
          "effects": []
        },
        {
          "id": "sd-send-from-platform-i",
          "from": "sd-pending-i",
          "to": "sd-pending-i",
          "on": "sd-send",
          "otherwise": true,
          "effects": [
            {
              "set": "lastFrom",
              "to": "'platform'"
            },
            {
              "set": "lastSignedBy",
              "to": "'platform-key'"
            },
            {
              "emit": "sd-sent-platform",
              "to": "mail-dispatcher"
            }
          ]
        },
        {
          "id": "sd-send-from-domain-i",
          "from": "sd-proved-i",
          "to": "sd-proved-i",
          "on": "sd-send",
          "otherwise": true,
          "effects": [
            {
              "set": "lastFrom",
              "to": "'tenant-domain'"
            },
            {
              "set": "lastSignedBy",
              "to": "'tenant-key'"
            },
            {
              "emit": "sd-sent-tenant",
              "to": "mail-dispatcher"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "sd-pending-i": "sd-pending",
          "sd-proved-i": "sd-proved"
        },
        "variables": {
          "lastFrom": "lastFrom",
          "lastSignedBy": "lastSignedBy"
        },
        "transitions": {
          "sd-prove-i": "sd-prove",
          "sd-proof-missing-i": "sd-proof-missing",
          "sd-send-from-platform-i": "sd-send-from-platform",
          "sd-send-from-domain-i": "sd-send-from-domain"
        }
      },
      "storage": {
        "record": "rec-sender-domain",
        "key": "domain",
        "fields": {
          "lastFrom": "last-from",
          "lastSignedBy": "last-signed-by"
        },
        "stateValues": {
          "sd-pending-i": "pending",
          "sd-proved-i": "proved"
        }
      }
    },
    {
      "id": "mail-render-flow",
      "name": "Mail rendering",
      "subject": "runtime",
      "initial": "rd-live",
      "description": "The rendering of one message from its structured blocks. Every message gets an HTML part and a plain text part, and the text of the tenant in the blocks is escaped, so no tenant markup reaches a mail client.",
      "variables": [
        {
          "name": "messages",
          "type": "number",
          "initial": 0
        },
        {
          "name": "htmlParts",
          "type": "number",
          "initial": 0
        },
        {
          "name": "textParts",
          "type": "number",
          "initial": 0
        },
        {
          "name": "rawMarkup",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "rd-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "rd-render-html-only",
          "from": "rd-live",
          "to": "rd-live",
          "on": "rd-render",
          "description": "Defect: renders an HTML part and no plain text part.",
          "faultOnly": true,
          "effects": [
            {
              "set": "messages",
              "to": "messages + 1"
            },
            {
              "set": "htmlParts",
              "to": "htmlParts + 1"
            },
            {
              "emit": "rd-rendered"
            }
          ]
        },
        {
          "id": "rd-render-unescaped",
          "from": "rd-live",
          "to": "rd-live",
          "on": "rd-render",
          "description": "Defect: passes the markup of a tenant through to the HTML part.",
          "guard": "event.hasMarkup",
          "faultOnly": true,
          "effects": [
            {
              "set": "messages",
              "to": "messages + 1"
            },
            {
              "set": "htmlParts",
              "to": "htmlParts + 1"
            },
            {
              "set": "textParts",
              "to": "textParts + 1"
            },
            {
              "set": "rawMarkup",
              "to": "rawMarkup + 1"
            },
            {
              "emit": "rd-rendered"
            }
          ]
        },
        {
          "id": "rd-render-t",
          "from": "rd-live",
          "to": "rd-live",
          "on": "rd-render",
          "effects": [
            {
              "set": "messages",
              "to": "messages + 1"
            },
            {
              "set": "htmlParts",
              "to": "htmlParts + 1"
            },
            {
              "set": "textParts",
              "to": "textParts + 1"
            },
            {
              "emit": "rd-rendered"
            }
          ]
        }
      ]
    },
    {
      "id": "mail-render-flow-impl",
      "name": "Mail rendering (implementation)",
      "level": "implementation",
      "subject": "runtime",
      "refines": "mail-render-flow",
