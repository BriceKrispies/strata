    {
      "id": "policy-applies",
      "description": "The match of rules.rs authorize and may_attempt: the policy names a role held, the action and the resource, where AnyObject covers every Object; the condition aside.",
      "params": [
        {
          "name": "policy",
          "type": "policy-def"
        },
        {
          "name": "roles",
          "type": "set<role-id>"
        },
        {
          "name": "action",
          "type": "action"
        },
        {
          "name": "resource",
          "type": "resource"
        }
      ],
      "returns": "bool",
      "body": "any(r in roles, r == policy.role) && any(a in policy.actions, a == action) && match policy.resource { any-object => match resource { object(_) => true, _ => policy.resource == resource }, _ => policy.resource == resource }",
      "examples": [
        {
          "description": "authors_own_posts covers an author updating a post.",
          "args": {
            "policy": {
              "id": "authors_own_posts",
              "role": "author",
              "resource": {
                "object": "post"
              },
              "actions": [
                "read",
                "update",
                "delete"
              ],
              "condition": {
                "cmp": {
                  "op": "eq",
                  "left": {
                    "var": {
                      "scope": "record",
                      "field": "$created_by"
                    }
                  },
                  "right": "principal"
                }
              }
            },
            "roles": [
              "author",
              "public"
            ],
            "action": "update",
            "resource": {
              "object": "post"
            }
          },
          "result": true
        },
        {
          "description": "authors_own_posts does not cover create.",
          "args": {
            "policy": {
              "id": "authors_own_posts",
              "role": "author",
              "resource": {
                "object": "post"
              },
              "actions": [
                "read",
                "update",
                "delete"
              ],
              "condition": {
                "cmp": {
                  "op": "eq",
                  "left": {
                    "var": {
                      "scope": "record",
                      "field": "$created_by"
                    }
                  },
                  "right": "principal"
                }
              }
            },
            "roles": [
              "author",
              "public"
            ],
            "action": "create",
            "resource": {
              "object": "post"
            }
          },
          "result": false
        },
        {
          "description": "A role not held.",
          "args": {
            "policy": {
              "id": "editors_run_posts",
              "role": "editor",
              "resource": {
                "object": "post"
              },
              "actions": [
                "read",
                "create",
                "update",
                "delete"
              ]
            },
            "roles": [
              "author",
              "public"
            ],
            "action": "update",
            "resource": {
              "object": "post"
            }
          },
          "result": false
        },
        {
          "description": "Another object type.",
          "args": {
            "policy": {
              "id": "public_reads_published",
              "role": "public",
              "resource": {
                "object": "post"
              },
              "actions": [
                "read"
              ],
              "condition": {
                "cmp": {
                  "op": "eq",
                  "left": {
                    "var": {
                      "scope": "record",
                      "field": "status"
                    }
                  },
                  "right": {
                    "lit": {
                      "str": "published"
                    }
                  }
                }
              }
            },
            "roles": [
              "public"
            ],
            "action": "read",
            "resource": {
              "object": "author"
            }
          },
          "result": false
        },
        {
          "description": "An AnyObject policy matches any object.",
          "args": {
            "policy": {
              "id": "auditors_read_all",
              "role": "auditor",
              "resource": "any-object",
              "actions": [
                "read"
              ]
            },
            "roles": [
              "auditor",
              "public"
            ],
            "action": "read",
            "resource": {
              "object": "category"
            }
          },
          "result": true
        },
        {
          "description": "An AnyObject policy does not match the schema.",
          "args": {
            "policy": {
              "id": "auditors_read_all",
              "role": "auditor",
              "resource": "any-object",
              "actions": [
                "read"
              ]
            },
            "roles": [
              "auditor",
              "public"
            ],
            "action": "read",
            "resource": "schema"
          },
          "result": false
        }
      ]
    },
    {
      "id": "may-attempt",
      "description": "crates/kernel/src/rules.rs may_attempt: whether some policy of the tenant schema could grant the action, conditions aside; the owner may do anything. For user interfaces; the decision is authorize.",
      "params": [
        {
          "name": "tenant",
          "type": "tenant-state"
        },
        {
          "name": "principal",
          "type": "principal"
        },
        {
          "name": "action",
          "type": "action"
        },
        {
          "name": "resource",
          "type": "resource"
        }
      ],
      "returns": "bool",
      "let": [
        {
          "name": "roles",
          "expr": "call roles-of(tenant, principal)"
        }
      ],
      "body": "any(r in roles, r == 'owner') || any(p in values(tenant.schema.policies), call policy-applies(p, roles, action, resource))",
