      ],"submitLabel":"Search","onSuccess":{"navigate":{"screen":"screen-search","params":{"q":"response.q"}}},"onError":{"show":"inline"}},
    {"id":"form-new-article-save","screen":"screen-desk-new","contract":"create-article","fields":[
        {
          "name": "title",
          "input": "title",
          "label": "Title",
          "control": "text"
        },
        {
          "name": "slug",
          "input": "slug",
          "label": "Address",
          "control": "text",
          "derive": "form.title",
          "transform": "slug",
          "until": "edited"
        },
        {
          "name": "excerpt",
          "input": "excerpt",
          "label": "Excerpt",
          "control": "textarea"
        },
        {
          "name": "body",
          "input": "body",
          "label": "Text",
          "control": "textarea"
        },
        {
          "name": "category",
          "input": "category",
          "label": "Topic",
          "control": "select",
          "optionsFrom": {
            "path": "topics",
            "value": "value",
            "label": "label"
          }
        },
        {
          "name": "author",
          "input": "author",
          "label": "Author",
          "control": "select",
          "optionsFrom": {
            "path": "authors",
            "value": "value",
            "label": "label"
          },
          "initial": {
            "path": "data.authors",
            "where": {
              "field": "fields.principal",
              "equals": "principal.id"
            },
            "value": "id"
          }
        },
        {
          "name": "tags",
          "input": "tags",
          "label": "Tags",
          "control": "text"
        },
        {
          "name": "cover",
          "input": "cover",
          "label": "Image",
          "control": "select",
          "options": [
            {
              "value": "",
              "label": "No cover"
            },
            {
              "value": "/media/jig.svg",
              "label": "Fixture and chair leg"
            },
            {
              "value": "/media/margin.svg",
              "label": "Open book with margins"
            },
            {
              "value": "/media/kiln.svg",
              "label": "Kiln mouth and pots"
            },
            {
              "value": "/media/slow.svg",
              "label": "Growth rings"
            },
            {
              "value": "/media/drawing.svg",
              "label": "Three sketched doors"
            },
            {
              "value": "/media/hours.svg",
              "label": "Row of cylinders"
            }
          ]
        },
        {
          "name": "cover-alt",
          "input": "cover-alt",
          "label": "Description of the image",
          "control": "textarea"
        },
        {
          "name": "featured",
          "input": "featured",
          "label": "Feature at the top of the front page",
          "control": "checkbox"
        }
      ],"submitLabel":"Save draft","onSuccess":{
