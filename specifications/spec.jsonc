    {"id":"lease-report-in-transit","name":"A stalled worker reports after its lease expired","description":"The first worker reports at tick 2, but the report is delayed by 6 ticks. The lease expires at tick 5 and the replacement holds token 2; the replacement reports at tick 9.","behaviors":["job-lease-flow"],"faults":["work-report-delayed-past-expiry"],"steps":[{"at":0,"event":"job-due"},{"at":2,"event":"work-reported","payload":{"token":1},"note":"Sent by the first worker, delivered at tick 8."},{"at":5,"event":"lease-expired"},{"at":9,"event":"work-reported","payload":{"token":2},"note":"The replacement finishes."}]},
    {"id":"lease-report-in-transit-impl","name":"A stalled worker reports after its lease expired (implementation)","description":"The first worker reports at 2 ms, but the report is delayed by 62 seconds. The lease expires at 60 seconds and the replacement holds token 2; the replacement reports after the late report. Times are in milliseconds. The same scenario run on the implementation machines.","behaviors":["job-lease-flow-impl"],"faults":["work-report-delayed-past-expiry-impl"],"steps":[{"at":0,"event":"job-due"},{"at":2,"event":"work-reported","payload":{"token":1},"note":"Sent by the first worker, delivered at 62002 ms."},{"at":62009,"event":"work-reported","payload":{"token":2},"note":"The replacement finishes."}],"timeUnit":"ms"},
