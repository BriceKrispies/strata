        {
          "description": "behaviour.rs writers_edit_only_their_own_notes; with a stale expected version too, the refusal is Unauthorized: authorisation comes before the version check.",
          "args": {
            "d": {
              "fixture": "fx-draft-2"
            },
            "object": "note",
            "id": 1,
            "fields": {
              "title": {
                "str": "Mine now"
              }
            },
            "expected-version": 7
          },
          "error": {
            "rejected": {
              "kind": "unauthorized",
              "message": "User(PrincipalId(\"alpha:writer2\")) may not Update Object(ObjectTypeId(\"note\"))",
              "evidence": [
                {
                  "rule": "policy:writers_edit_own",
                  "passed": false,
                  "detail": "(record.$created_by == principal) is false"
                }
              ],
              "missing": null
            }
          }
        },
        {
          "description": "behaviour.rs every_rejection_lists_at_least_one_failed_check: stale version.",
          "args": {
            "d": {
              "fixture": "fx-draft-5"
            },
            "object": "note",
            "id": 1,
            "fields": {
              "body": {
                "str": "two"
              }
            },
            "expected-version": 7
          },
          "error": {
            "rejected": {
              "kind": "version-conflict",
              "message": "record is at version 1, expected 7",
              "evidence": [
                {
                  "rule": "policy:writers_edit_own",
                  "passed": true,
                  "detail": "Update on Object(ObjectTypeId(\"note\")) where (record.$created_by == principal)"
                },
                {
                  "rule": "intent:version_conflict",
                  "passed": false,
                  "detail": "record is at version 1, expected 7"
                }
              ],
              "missing": null
            }
          }
        },
        {
          "description": "behaviour.rs every_rejection_lists_at_least_one_failed_check: unknown record, for the editor, who may update any note and so learns that it is missing.",
          "args": {
            "d": {
              "fixture": "fx-draft-6"
            },
            "object": "note",
            "id": 42,
            "fields": {
              "title": {
                "str": "x"
              }
            },
            "expected-version": null
          },
          "error": {
            "rejected": {
              "kind": "unknown-record",
              "message": "no note 42",
              "evidence": [
                {
                  "rule": "policy:editors_manage_notes",
                  "passed": true,
                  "detail": "Update on Object(ObjectTypeId(\"note\"))"
                },
                {
                  "rule": "intent:unknown_record",
                  "passed": false,
                  "detail": "no note 42"
                }
              ],
              "missing": null
            }
          }
        },
        {
          "description": "behaviour.rs every_rejection_lists_at_least_one_failed_check: workflow (the writer may not publish).",
          "args": {
            "d": {
              "fixture": "fx-draft-5"
            },
            "object": "note",
            "id": 1,
            "fields": {
              "status": {
                "str": "published"
              }
            },
            "expected-version": null
          },
          "error": {
            "rejected": {
              "kind": "workflow-violation",
              "message": "publish: guard is not true",
              "evidence": [
                {
                  "rule": "policy:writers_edit_own",
                  "passed": true,
                  "detail": "Update on Object(ObjectTypeId(\"note\")) where (record.$created_by == principal)"
                },
                {
                  "rule": "workflow:note_status",
                  "passed": false,
                  "detail": "publish: guard is not true"
                }
              ],
              "missing": null
            }
          }
        },
        {
          "description": "Clearing a required field is MissingRequired.",
          "args": {
            "d": {
              "fixture": "fx-draft-5"
            },
            "object": "note",
            "id": 1,
            "fields": {
              "title": "null"
            },
            "expected-version": null
          },
          "error": {
            "rejected": {
              "kind": "missing-required",
              "message": "required:note.title: a value is required",
              "evidence": [
                {
                  "rule": "policy:writers_edit_own",
                  "passed": true,
                  "detail": "Update on Object(ObjectTypeId(\"note\")) where (record.$created_by == principal)"
                },
                {
                  "rule": "required:note.slug",
                  "passed": true,
                  "detail": "present"
                },
                {
                  "rule": "type:note.slug",
                  "passed": true,
                  "detail": "string"
                },
                {
                  "rule": "unique:note.slug",
                  "passed": true,
                  "detail": "no other record has this value"
                },
                {
                  "rule": "required:note.status",
                  "passed": true,
                  "detail": "present"
                },
                {
                  "rule": "type:note.status",
                  "passed": true,
                  "detail": "string"
                },
                {
                  "rule": "workflow_state:note_status",
                  "passed": true,
                  "detail": "draft is a state"
                },
                {
                  "rule": "required:note.title",
                  "passed": false,
                  "detail": "a value is required"
                }
              ],
              "missing": null
            }
          }
        },
        {
          "description": "Authorisation comes before the lookup: writer1 edits only their own notes, which cannot be tested for a record that does not exist, so the refusal is Unauthorized, as it is for a record that exists; it does not say the record is missing.",
          "args": {
            "d": {
              "fixture": "fx-draft-5"
            },
            "object": "note",
            "id": 42,
            "fields": {
              "title": {
                "str": "x"
              }
            },
            "expected-version": null
          },
          "error": {
            "rejected": {
              "kind": "unauthorized",
              "message": "User(PrincipalId(\"alpha:writer1\")) may not Update Object(ObjectTypeId(\"note\"))",
              "evidence": [
                {
                  "rule": "policy:writers_edit_own",
                  "passed": false,
                  "detail": "(record.$created_by == principal) is null"
                }
              ],
              "missing": null
