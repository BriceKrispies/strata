    {"id":"doc-tenant-migrations","path":"specifications/02-tenancy/tenant-migrations.md","title":"Tenant migrations","role":"requirements"},
    {"id":"doc-cases-environment-parity","path":"specifications/08-platform/cases/environment-parity.md","title":"Environment parity","role":"cases"},
