        },
        {
          "name": "confirmed",
          "type": "bool"
        },
        {
          "name": "last-step",
          "type": "u64",
          "description": "The latest time step accepted; a code of that step or an earlier one is refused."
        },
        {
          "name": "created-at",
          "type": "timestamp"
        }
      ],
      "retention": "Until the person removes the factor, the account of the person is removed, or the tenant file is deleted. Removing or deprovisioning the account removes it in the same operation (the SCIM delete and Store::remove_principal); a deactivated account keeps them, and no sign-in method accepts them for it. Erasing a subject (the contract erase-subject) removes them through Store::remove_principal, in the same erasure as the records of the subject.",
      "erasure": {
        "point": "the removal of the factor by its owner, the removal of the account, or the deletion of the tenant file"
      },
      "description": "Table totp_factors of a tenant file: the secret of a person's authenticator application, sealed with AES-256-GCM (IDN-018)."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
