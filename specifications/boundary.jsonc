          "type": "setting-id"
        },
        {
          "name": "label",
          "type": "string"
        },
        {
          "name": "type",
          "type": "setting-type"
        },
        {
          "name": "default",
          "type": "value"
        },
        {
          "name": "levels",
          "type": "list<setting-level>"
        },
        {
          "name": "locked-by",
          "type": "setting-level",
          "optional": true
        },
        {
          "name": "release-id",
          "type": "release-id"
        }
      ],
      "retention": "Until the release that defined it is removed from the release records (SET-005, D-5047).",
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target"
    },
    {
      "id": "rec-setting-platform-value",
      "name": "platform setting value",
      "owner": "control-plane",
      "key": [
        "setting-id"
      ],
      "fields": [
        {
          "name": "setting-id",
          "type": "setting-id"
        },
        {
          "name": "value",
          "type": "value"
        },
        {
          "name": "revision",
          "type": "u64"
        },
        {
          "name": "set-by",
          "type": "principal-id",
          "refersTo": "principal",
          "role": "party",
          "constraints": {
            "pattern": "^[A-Za-z0-9_:.-]+$",
            "maxLength": 96
          },
          "onDelete": "restrict"
        },
        {
          "name": "set-at",
          "type": "timestamp"
        }
      ],
      "retention": "Until the platform override is removed; the revision stays with the definition (SET-030, SET-051).",
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target"
    },
    {
      "id": "rec-setting-override",
      "name": "setting override",
      "owner": "runtime",
      "key": [
        "tenant-id",
        "setting-id",
        "level",
        "subject"
      ],
      "fields": [
        {
          "name": "tenant-id",
          "type": "tenant-id",
          "refersTo": "rec-tenant",
          "constraints": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 64
          },
          "onDelete": "cascade"
        },
        {
          "name": "setting-id",
          "type": "setting-id"
        },
        {
          "name": "level",
          "type": "setting-level"
        },
        {
          "name": "subject",
          "type": "text"
        },
        {
          "name": "value",
          "type": "value",
          "personal": "other"
        },
        {
          "name": "revision",
          "type": "u64"
        },
        {
          "name": "set-by",
          "type": "principal-id",
          "refersTo": "principal",
          "role": "party",
          "constraints": {
            "pattern": "^[A-Za-z0-9_:.-]+$",
            "maxLength": 96
          },
          "onDelete": "restrict"
        },
        {
          "name": "set-at",
          "type": "timestamp"
        }
      ],
      "retention": "Until the override is removed, with the team or the person it belongs to at the latest, and with the tenant (SET-022, SET-034).",
      "erasure": {
        "point": "the removal of the override, the deletion of its team, or the erasure of the person it belongs to (PRV-353)"
      },
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target"
    },
    {
      "id": "rec-setting-revision",
      "name": "setting revision",
      "owner": "runtime",
      "key": [
        "tenant-id",
        "setting-id"
      ],
      "fields": [
        {
          "name": "tenant-id",
          "type": "tenant-id",
          "refersTo": "rec-tenant",
          "constraints": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 64
          },
          "onDelete": "cascade"
        },
        {
          "name": "setting-id",
          "type": "setting-id"
        },
        {
          "name": "revision",
          "type": "u64"
        }
      ],
      "retention": "Until the setting is removed from the tenant schema and no override of it remains (SET-051).",
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target"
    },
    {
      "id": "rec-setting-change",
      "name": "setting change",
      "owner": "audit-log",
      "key": [
        "seq"
      ],
      "fields": [
        {
          "name": "seq",
          "type": "u64",
          "refersTo": "rec-audit-entry",
          "onDelete": "restrict"
        },
        {
          "name": "setting-id",
          "type": "setting-id"
        },
        {
          "name": "level",
          "type": "setting-level"
        },
        {
          "name": "subject",
          "type": "text"
        },
        {
          "name": "previous",
          "type": "value",
          "optional": true,
          "personal": "other"
        },
        {
          "name": "new",
          "type": "value",
          "optional": true,
          "personal": "other"
        },
        {
          "name": "correlation",
          "type": "correlation-id"
        }
      ],
      "retention": "Under the audit retention of the tenant policy, which the platform defaults to one year (SET-042, OPS-329). Personal values are sealed (PRV-358).",
      "erasure": {
        "point": "sealed with the other personal fields of the audit chain (PRV-358), and removed at the end of the audit retention"
      },
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target"
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-login-throttle",
      "name": "Sign-in throttle counters (tenant file)",
      "scope": "platform",
      "key": [
        "key"
      ],
      "indexes": [
        {
          "name": "login_throttle_expiry",
          "fields": [
            "expires-at"
          ]
        }
      ],
      "fields": [
        {
          "name": "key",
          "type": "string",
          "personal": "identifier",
          "description": "account:<method>:<hash of the login>, source:<method>:<source address> or realm:<method>."
        },
        {
          "name": "failures",
          "type": "u64"
        },
        {
          "name": "window-start",
          "type": "timestamp"
        },
        {
          "name": "locked-until",
          "type": "timestamp"
        },
        {
          "name": "expires-at",
          "type": "timestamp"
        }
      ],
      "retention": "Until the window runs out: the sweep every ten minutes removes rows whose expires-at has passed, and a successful sign-in clears its own row.",
      "erasure": {
        "point": "the sweep after expires-at, the clearing by a successful sign-in, or the deletion of the tenant file"
      },
      "description": "Table login_throttle of a tenant file: counters of failed sign-ins per account, per source address and per realm, with the time until which each is locked (IDN-008)."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-passkeys",
      "name": "Passkeys (tenant file)",
      "scope": "platform",
      "key": [
        "id"
      ],
      "indexes": [
        {
          "name": "passkeys_principal",
          "fields": [
            "principal",
            "created-at"
          ]
        }
      ],
      "fields": [
        {
          "name": "id",
          "type": "string"
        },
        {
          "name": "principal",
          "type": "principal-id",
          "refersTo": "principal",
          "role": "subject",
          "onDelete": "restrict"
        },
        {
          "name": "rp-id",
          "type": "string"
        },
        {
          "name": "label",
          "type": "string",
          "personal": "other",
          "description": "The name the person gave the passkey."
        },
        {
          "name": "credential",
          "type": "string",
          "classification": "internal",
          "description": "The credential record: public key and signature counter, no private key."
        },
        {
          "name": "created-at",
          "type": "timestamp"
        },
        {
          "name": "last-used-at",
          "type": "timestamp",
          "optional": true
        }
      ],
      "retention": "Until the person removes the passkey, the account of the person is removed, or the tenant file is deleted. Removing or deprovisioning the account removes them in the same operation (the SCIM delete and Store::remove_principal); a deactivated account keeps them, and no sign-in method accepts them for it. Erasing a subject (the contract erase-subject) removes them through Store::remove_principal, in the same erasure as the records of the subject.",
      "erasure": {
        "point": "the removal of the passkey by its owner, the removal of the account, or the deletion of the tenant file"
      },
      "description": "Table passkeys of a tenant file: the public credentials registered by a person (IDN-007)."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-passkey-challenges",
      "name": "Passkey challenges (tenant file)",
      "scope": "platform",
      "key": [
        "id-hash"
      ],
      "indexes": [
        {
          "name": "passkey_challenges_expiry",
          "fields": [
            "expires-at"
          ]
        }
      ],
      "fields": [
        {
          "name": "id-hash",
          "type": "hash",
          "classification": "credential"
        },
        {
          "name": "ceremony",
          "type": "string"
        },
        {
          "name": "session",
          "type": "session-id",
          "optional": true
        },
        {
          "name": "principal",
          "type": "principal-id",
          "refersTo": "principal",
          "role": "subject",
          "optional": true,
          "onDelete": "set-null"
        },
        {
          "name": "origin",
          "type": "string"
        },
        {
          "name": "state",
          "type": "string",
          "classification": "internal"
        },
        {
          "name": "expires-at",
          "type": "timestamp"
        }
      ],
