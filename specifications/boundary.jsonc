        },
        {
          "name": "requested-realm",
          "type": "string",
          "optional": true
        },
        {
          "name": "offered-realm",
          "type": "string",
          "optional": true
        }
      ],
      "retention": "Removed when the page has been served.",
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target"
    },
    {
      "id": "rec-grant-copy",
      "name": "Grant copy",
      "owner": "gateway",
      "key": [
        "grant-id"
      ],
      "fields": [
        {
          "name": "grant-id",
          "type": "grant-id",
          "refersTo": "rec-grant",
          "onDelete": "cascade"
        },
        {
          "name": "copy-revoked",
          "type": "bool",
          "optional": true
        },
        {
          "name": "checked-at",
          "type": "timestamp",
          "optional": true
        },
        {
          "name": "checked",
          "type": "bool",
          "optional": true
        }
      ],
      "retention": "Held while tokens of the grant are in use at the gateway and dropped with the grant.",
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target"
    },
    {
      "id": "rec-signing-key-set",
      "name": "Signing key set",
      "owner": "identity-service",
      "key": [
        "key-set-id"
      ],
      "fields": [
        {
          "name": "key-set-id",
          "type": "string",
          "constraints": {
            "maxLength": 96
          }
        },
        {
          "name": "current-kid",
          "type": "string",
          "optional": true
        },
        {
          "name": "previous-kid",
          "type": "string",
          "optional": true
        }
      ],
      "retention": "Held for as long as tokens signed by its keys can be presented.",
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target"
    },
    {
      "id": "rec-identity-decision",
      "name": "Identity decision",
      "owner": "identity-service",
      "key": [
        "decision-id"
      ],
      "fields": [
        {
          "name": "decision-id",
          "type": "request-id"
        }
      ],
      "retention": "Nothing is kept: a decision is taken from its inputs and its row stands for the request only while it is answered.",
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target"
    },
    {
      "id": "rec-published-page",
      "name": "Published page (delivery model)",
      "owner": "runtime",
      "key": [
        "record-id"
      ],
      "fields": [
        {
          "name": "record-id",
          "type": "record-id"
        },
        {
          "name": "version",
          "type": "u64"
        },
        {
          "name": "changed-at",
          "type": "timestamp",
          "optional": true
        },
        {
          "name": "held",
          "type": "u64",
          "optional": true
        },
        {
          "name": "stored-at",
          "type": "timestamp",
          "optional": true
        },
        {
          "name": "copy-state",
          "type": "string"
        },
        {
          "name": "stored",
          "type": "bool",
          "optional": true
        }
      ],
      "retention": "Held by the origin and the edge for as long as the page is published.",
      "schemaVersion": 1,
      "description": "What the target delivery machines (origin-content-flow-impl, edge-copy-flow-impl) hold about one published page: its version and the state of its edge copy. The page content itself is a tenant record in tbl-records, described by the tenant schema.",
      "scope": "platform",
      "realisation": "target"
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-tenant-directory",
      "name": "Tenant directory (control database)",
      "scope": "platform",
      "key": [
        "id"
      ],
      "fields": [
        {
          "name": "id",
          "type": "tenant-id"
        },
        {
          "name": "state",
          "type": "tenant-file-state"
        },
        {
          "name": "file",
          "type": "string",
          "description": "The tenant database file, relative to the tenants directory."
        },
        {
          "name": "created-at",
          "type": "timestamp"
        }
      ],
      "retention": "Until the tenant is deleted; the row goes after its file. A row in the state provisioning, left by an install that did not finish, is removed with its file by the next start of the backend or the next open of that tenant.",
      "description": "Table tenant_directory of the control database: one row per tenant naming the file that holds everything the tenant owns (TEN-001), with its state: active, provisioning while an install is under way, or deleting while its file is being removed. A tenant in either of the last two states loads as absent. It holds no tenant content."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-session-directory",
      "name": "Session directory (control database)",
      "scope": "platform",
      "key": [
        "id"
      ],
      "unique": [
        [
          "token-hash"
        ]
      ],
      "fields": [
        {
          "name": "id",
          "type": "session-id"
        },
        {
          "name": "token-hash",
          "type": "hash",
          "classification": "credential"
        },
        {
          "name": "tenant",
          "type": "tenant-id"
        }
      ],
      "erasure": {
        "point": "the session is purged, or its tenant is deleted"
      },
      "retention": "As long as the session it points at.",
      "description": "Table session_directory of the control database: which tenant file holds a session, so that a session is found by its token hash or id without opening every tenant file. Token hashes are unique across tenants."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-generation",
      "name": "Tenant generation (tenant file)",
      "scope": "platform",
      "key": ["id"],
      "fields": [
        { "name": "id", "type": "i64", "description": "Always 1: the table holds one row." },
        { "name": "nonce", "type": "string", "description": "128 bits as 32 hex digits, drawn at create, restore, import and lease acquisition." },
        { "name": "counter", "type": "i64", "description": "Raised by every write transaction that changes what a load returns for the tenant." },
        { "name": "fence", "type": "i64", "description": "The lease's fence token; compared on counter-raising writes made under a lease (WG-5401)." }
      ],
      "retention": "As long as the tenant file; it goes with the file.",
      "description": "Table generation of a tenant file: the tenant's generation, a nonce and a counter, which a load returns in its own read transaction and a commit compares in its own write transaction (docs/working-set.md, item 1). It holds no tenant content."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-control-migrations",
      "name": "Control migrations (control database)",
      "scope": "platform",
      "key": [
        "version"
      ],
      "fields": [
        {
          "name": "version",
          "type": "u32"
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "applied-at",
          "type": "timestamp"
        }
      ],
      "description": "Table control_migrations of the control database: the layout steps applied to it, each once. A file that has the old table storage_migrations or tenants is the old single-file layout and is refused with a message to delete it."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-tenant-migrations",
      "name": "Tenant migrations (tenant file)",
      "scope": "platform",
      "key": [
        "version"
      ],
      "fields": [
        {
          "name": "version",
          "type": "u32"
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "applied-at",
          "type": "timestamp"
        }
      ],
      "description": "Table tenant_migrations of a tenant file: the layout steps applied to that file, each once."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "runtime",
      "id": "tbl-runtime-migrations",
      "name": "Runtime migrations (runtime database)",
      "scope": "platform",
      "key": [
        "version"
      ],
      "fields": [
        {
          "name": "version",
          "type": "u32"
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "applied-at",
          "type": "timestamp"
        }
      ],
      "description": "Table runtime_migrations of a runtime database: the layout steps applied to the machine tables, each once."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-tenant-header",
      "name": "Tenant header (tenant file)",
      "scope": "tenant-meta",
      "describedBy": "tenant-schema",
      "key": [
        "id"
      ],
      "fields": [
        {
          "name": "id",
          "type": "tenant-id"
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "revision",
          "type": "u64"
        },
        {
          "name": "next-record",
          "type": "u64"
        },
        {
          "name": "event-seq",
          "type": "u64"
        },
        {
          "name": "schema",
          "type": "tenant-schema"
        },
        {
          "name": "members",
          "type": "json",
          "description": "Principal ids with their role sets."
        }
      ],
      "description": "Table tenant of a tenant file: its single row holds the tenant header, with the current tenant schema as data. The row exists once the tenant is created."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-schema-history",
      "name": "Schema history (tenant file)",
      "scope": "tenant-meta",
      "describedBy": "tenant-schema",
      "key": [
        "version"
      ],
      "fields": [
        {
          "name": "version",
          "type": "u64"
        },
        {
          "name": "revision",
          "type": "u64"
        },
        {
          "name": "schema",
          "type": "tenant-schema"
        }
      ],
      "retention": "Every version is kept in the schema history, without its teams and invitations, which name people (D-7726); a tenant migration removed them from the rows written before.",
      "description": "Table schema_history of a tenant file: every version of the tenant schema, with the revision that introduced it."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-records",
      "name": "Records (tenant file)",
      "scope": "tenant-meta",
      "describedBy": "tenant-schema",
      "key": [
        "object",
        "id"
      ],
      "fields": [
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "id",
          "type": "record-id"
        },
        {
          "name": "version",
          "type": "u64"
        },
        {
          "name": "data",
          "type": "record",
          "description": "The canonical JSON of the record; its fields are those the tenant schema gives its object type."
        }
      ],
      "retention": "Until deleted by the tenant or removed by its retention rule (PRV-356), with every version (CMS-006). Every value of a declared personal field is stored sealed under the key of its subject (D-7720). Erasing a subject (the contract erase-subject) clears the fields the subject owns by a personal declaration, in batches of at most 100 records, rewrites their index rows in the same commit, and then destroys the subject key; a record past its retention is not deleted by it (WG-5116).",
      "erasure": {
        "point": "its deletion by the tenant, the end of its retention rule (PRV-356), or the deletion of the tenant file"
      },
      "description": "Table records of a tenant file: every record of every tenant object type, generically. Which object types exist and what fields they have is tenant data (the tenant schema), never a table of its own."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-record-index",
      "name": "Record index (tenant file)",
      "scope": "tenant-meta",
      "describedBy": "tenant-schema",
      "key": [
        "object",
        "field",
        "value",
        "id"
      ],
      "fields": [
        {
          "name": "object",
          "type": "object-type-id"
        },
        {
          "name": "field",
          "type": "field-id"
        },
        {
          "name": "value",
          "type": "string",
          "description": "The canonical JSON of one scalar field value or list element, up to 240 bytes."
        },
        {
          "name": "id",
          "type": "record-id",
          "refersTo": "tbl-records",
          "onDelete": "cascade"
        },
        {
          "name": "kind",
          "type": "i64",
          "optional": true,
          "description": "The variant of a single value in the order of Value (0 null, 1 bool, 2 int, 3 str, 4 time, 5 ref); absent for a list element (KRN-2525)."
        },
        {
          "name": "ord",
          "type": "i64",
          "optional": true,
          "description": "The number of an integer or a time value, its order key; absent for every other value (KRN-2525)."
        }
      ],
      "description": "Table record_index of a tenant file: one row per scalar field value and list element, so that uniqueness and reference lookups do not scan, with the order key of integers and times so that a planned named query reads a range of the index (KRN-2525). Tenant migration 16 added kind and ord and rebuilds the rows from the records. A sealed personal field has a row for each blind hash its token carries when it is searchable, without kind or ord, and none when it is not (D-7723, PRV-1588).",
      "indexes": [
        {
          "name": "record_index_ord",
          "fields": [
            "object",
            "field",
            "kind",
            "ord",
            "id"
          ]
        },
        {
          "name": "record_index_ord_desc",
          "fields": [
            "object",
            "field",
            "kind",
            "ord",
            "id"
          ]
        }
      ]
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-events",
      "name": "Events and outbox (tenant file)",
      "scope": "platform",
      "key": [
        "position"
      ],
      "unique": [
        [
          "seq"
        ]
      ],
      "fields": [
        {
          "name": "position",
          "type": "u64",
          "description": "The outbox position in this tenant file, increasing in commit order and never reused."
        },
        {
          "name": "seq",
          "type": "u64"
        },
        {
          "name": "revision",
          "type": "u64"
        },
        {
          "name": "data",
          "type": "domain-event",
          "personal": "other"
        },
        {
          "name": "published",
          "type": "bool"
        }
      ],
      "retention": "Until the tenant file is deleted, or a snapshot restore discards the events after it. Every value of a declared personal field in a record image is stored sealed under the key of its subject (D-7720), so the erasure of the subject, which destroys the key, makes it unreadable in every event and in the outbox without rewriting one; events written before the tenant was first sealed keep plain values (D-7724).",
      "erasure": {
        "point": "the destruction of the subject key, for each sealed personal value (D-350, D-7722); the deletion of the tenant file, or a snapshot restore that discards it, for the rest"
      },
      "description": "Table events of a tenant file: the event log, doubling as the tenant outbox through published, written in the same transaction as the state it describes."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-journal",
      "name": "Journal (tenant file)",
      "scope": "platform",
      "key": [
        "revision"
      ],
      "fields": [
        {
          "name": "revision",
          "type": "u64"
        },
        {
          "name": "data",
          "type": "journal-entry",
          "personal": "other"
        }
      ],
      "retention": "Until the tenant file is deleted, or a snapshot restore discards the entries after it. The field values of create-record and update-record intents of declared personal fields are stored sealed, and the delta and events hashes are over the sealed form (D-7720, D-7721); the erasure of the subject destroys the key, and a replay reports the entries it can no longer decide as redacted (PRV-361). The inputs of invoke-operation, the address of create-invitation and the entries written before the tenant was first sealed keep plain values (WG-5245, D-7724).",
      "erasure": {
        "point": "the destruction of the subject key, for each sealed personal value (D-350, D-7722); the deletion of the tenant file, or a snapshot restore that discards it, for the rest"
      },
      "description": "Table journal of a tenant file: every accepted transition as decided, enough to run it again."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-snapshots",
      "name": "Snapshots (tenant file)",
      "scope": "platform",
      "key": [
        "id"
      ],
      "fields": [
        {
          "name": "id",
          "type": "u64"
        },
        {
          "name": "label",
          "type": "string"
        },
        {
          "name": "revision",
          "type": "u64"
        },
        {
          "name": "hash",
          "type": "hash"
        },
        {
          "name": "created-at",
          "type": "timestamp"
        },
        {
          "name": "data",
          "type": "tenant-state",
          "personal": "other"
        }
      ],
      "retention": "Until the tenant file is deleted. Each snapshot holds the stored rows, so its declared personal fields are sealed and the destruction of a subject key makes them unreadable, also after a restore (D-7727). The members, teams and invitations of its time are kept plain, and a restore is to re-apply the later erasures (WG-5246).",
      "erasure": {
        "point": "the destruction of the subject key, for each sealed personal value (D-350); the deletion of the tenant file for the rest"
      },
      "description": "Table snapshots of a tenant file: copies of the complete tenant state."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-sessions",
      "name": "Sessions (tenant file)",
      "scope": "platform",
      "key": [
        "id"
      ],
      "unique": [
        [
          "token-hash"
        ]
      ],
      "indexes": [
        {
          "name": "sessions_principal",
          "fields": [
            "principal"
          ]
        }
      ],
      "fields": [
        {
          "name": "id",
          "type": "session-id"
        },
        {
          "name": "token-hash",
          "type": "hash",
          "classification": "credential"
        },
        {
          "name": "csrf-token",
          "type": "secret",
          "classification": "credential"
        },
        {
          "name": "principal",
          "type": "principal-id",
          "refersTo": "principal",
          "role": "subject",
          "onDelete": "restrict"
        },
        {
          "name": "display-name",
          "type": "display-name",
          "personal": "name"
        },
        {
          "name": "created-at",
          "type": "timestamp"
        },
        {
          "name": "last-seen-at",
          "type": "timestamp"
        },
        {
          "name": "expires-at",
          "type": "timestamp"
        },
        {
          "name": "revoked-at",
          "type": "timestamp",
          "optional": true
        }
      ],
      "retention": "Until purged after it ends, or the tenant file is deleted. Erasing a subject (the contract erase-subject) ends the sessions of the person in the commit that removes their roles; the rows are purged a day after they end.",
      "erasure": {
        "point": "the purge after the session ends, or the deletion of the tenant file"
      },
      "description": "Table sessions of a tenant file: server-side sessions of the tenant; only the hash of the token is stored."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-accounts",
      "name": "Accounts (tenant file)",
      "scope": "platform",
      "key": [
        "login"
      ],
      "fields": [
        {
          "name": "login",
          "type": "string",
          "personal": "identifier"
        },
        {
          "name": "principal",
          "type": "principal-id",
          "refersTo": "principal",
          "role": "subject",
          "onDelete": "restrict"
        },
        {
          "name": "display-name",
          "type": "display-name",
          "personal": "name"
        },
        {
          "name": "password-hash",
          "type": "hash",
          "classification": "credential"
        }
      ],
      "retention": "Until the login is removed or the tenant file is deleted. Erasing a subject (the contract erase-subject) removes the logins of the person through Store::remove_principal.",
      "erasure": {
        "point": "the removal of the login, or the deletion of the tenant file"
      },
      "description": "Table accounts of a tenant file: locally managed logins with their Argon2id password hash."
    },
    {
      "id": "rec-ledger-unit",
      "name": "Ledger unit",
      "owner": "runtime",
      "key": [
        "unit"
      ],
      "fields": [
        {
          "name": "unit",
          "type": "ledger-unit"
        },
        {
          "name": "description",
          "type": "string"
        },
        {
          "name": "declared-at",
          "type": "timestamp"
        },
        {
          "name": "expiry",
          "type": "ledger-expiry",
          "optional": true,
          "description": "How the credits of the unit expire, when they do (D-6553)."
        }
      ],
      "retention": "Kept for the life of the tenant. A unit that has an account is never removed, so that the entries of its accounts keep a unit to be read in (LDG-002).",
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target",
      "source": "d-5001",
      "description": "A unit the tenant has declared as metadata, such as points or stamps."
    },
    {
      "id": "rec-ledger-pool",
      "name": "Ledger pool",
      "owner": "runtime",
      "key": [
        "pool"
      ],
      "fields": [
        {
          "name": "pool",
          "type": "ledger-pool-name"
        },
        {
          "name": "description",
          "type": "string"
        },
        {
          "name": "declared-at",
          "type": "timestamp"
        }
      ],
      "retention": "Kept for the life of the tenant. A pool that has an account is never removed.",
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target",
      "source": "d-5001",
      "description": "A named tenant-level owner of accounts, such as a promotion budget."
    },
    {
      "id": "rec-ledger-account",
      "name": "Ledger account",
      "owner": "runtime",
      "key": [
        "account-id"
      ],
      "fields": [
        {
          "name": "account-id",
          "type": "ledger-account-id"
        },
        {
          "name": "owner-principal",
          "type": "principal-id",
          "refersTo": "principal",
          "role": "subject",
          "constraints": {
            "pattern": "^[A-Za-z0-9_:.-]+$",
            "maxLength": 96
          },
          "optional": true,
          "onDelete": "restrict",
          "description": "The principal that owns the account; absent for a pool, and cleared when the principal is erased (LDG-027)."
        },
        {
          "name": "owner-pool",
          "type": "ledger-pool-name",
          "refersTo": "rec-ledger-pool",
          "optional": true,
          "onDelete": "restrict",
          "description": "The pool that owns the account; absent for a principal."
        },
        {
          "name": "unit",
          "type": "ledger-unit",
          "refersTo": "rec-ledger-unit",
          "onDelete": "restrict"
        },
        {
          "name": "scope",
          "type": "ledger-scope",
          "description": "Chosen by the poster, empty by default (D-6551)."
        },
        {
          "name": "opened-at",
          "type": "timestamp"
        }
      ],
      "unique": [
        [
          "owner-principal",
          "owner-pool",
          "unit",
          "scope"
        ]
      ],
      "retention": "Kept for the life of the tenant. The principal of an account is cleared when the principal is erased and the account stays with its entries (LDG-027).",
      "erasure": {
        "point": "the erasure of the principal that owns the account clears the principal from the account; the account and its entries stay (LDG-027)"
      },
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target",
      "source": "d-5001",
      "description": "An owner and a unit. Exactly one of owner-principal and owner-pool is set until the principal is erased."
    },
    {
      "id": "rec-ledger-entry",
      "name": "Ledger entry",
      "owner": "runtime",
      "key": [
        "account-id",
        "sequence"
      ],
      "fields": [
        {
          "name": "account-id",
          "type": "ledger-account-id",
          "refersTo": "rec-ledger-account",
          "onDelete": "restrict"
        },
        {
          "name": "sequence",
          "type": "u64",
          "description": "The number of the entry in its account: 1, 2, 3, with no gap, in commit order (LDG-019)."
        },
        {
          "name": "amount",
          "type": "ledger-amount",
          "constraints": {
            "min": -9007199254740991,
            "max": 9007199254740991
          }
        },
        {
          "name": "idempotency-key",
          "type": "string",
          "constraints": {
            "maxLength": 128
          }
        },
        {
          "name": "reason",
          "type": "string",
          "constraints": {
            "maxLength": 256
          },
          "description": "A short reason the poster names; free text of a person does not belong in it."
        },
        {
          "name": "caused-by",
          "type": "principal-id",
          "refersTo": "principal",
          "role": "party",
          "constraints": {
            "pattern": "^[A-Za-z0-9_:.-]+$",
            "maxLength": 96
          },
          "optional": true,
          "onDelete": "restrict",
          "description": "The principal that caused the posting; absent only after that principal was erased (LDG-027)."
        },
        {
          "name": "at",
          "type": "timestamp",
          "description": "The time given to the decision as an input (D-5010)."
        },
        {
          "name": "corrects",
          "type": "u64",
          "optional": true,
          "description": "The number of the entry of the same account that this entry corrects (LDG-023)."
        },
        {
          "name": "revision",
          "type": "u64",
          "description": "The tenant revision of the commit that recorded the entry."
        }
      ],
      "unique": [
        [
          "account-id",
          "idempotency-key"
        ]
      ],
      "indexes": [
        {
          "name": "by-key",
          "fields": [
            "account-id",
            "idempotency-key"
          ]
        }
      ],
      "retention": "Kept for the life of the tenant. An entry is never changed or removed (LDG-022); the erasure of a principal clears that principal from it and keeps the rest (LDG-027, LDG-028).",
      "erasure": {
        "point": "the erasure of the principal that caused the entry clears caused-by; the amount, key, reason, number and time stay (LDG-027)"
      },
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target",
      "source": "d-5002",
      "description": "One entry of the journal of an account. Append-only."
    },
    {
      "id": "rec-ledger-balance",
      "name": "Ledger balance",
      "owner": "runtime",
      "key": [
        "account-id"
      ],
      "fields": [
        {
          "name": "account-id",
          "type": "ledger-account-id",
          "refersTo": "rec-ledger-account",
          "onDelete": "cascade"
        },
        {
          "name": "balance",
          "type": "ledger-amount",
          "constraints": {
            "min": -9007199254740991,
            "max": 9007199254740991
          }
        },
        {
          "name": "last-sequence",
          "type": "u64"
        },
        {
          "name": "period-start",
          "type": "timestamp",
          "optional": true,
          "description": "The start of the period whose credits period-credits counts."
        },
        {
          "name": "period-credits",
          "type": "u64",
          "optional": true,
          "description": "The credits posted in the period that starts at period-start."
        },
        {
          "name": "revision",
          "type": "u64"
        },
        {
          "name": "unit",
          "type": "ledger-unit",
          "description": "The unit of the account, kept for the ranked listing (LDG-1543)."
        },
        {
          "name": "scope",
          "type": "ledger-scope",
          "description": "The scope of the account, kept for the ranked listing."
        },
        {
          "name": "buckets",
          "type": "list<ledger-bucket>",
          "optional": true,
          "description": "For a unit with an expiry, the remaining credit of each period, oldest first, at most thirty-six (D-6553)."
        }
      ],
      "retention": "Derived from the entries of its account and rebuilt from them, so it is kept as long as the account is. Only the commit of a posting writes it, in the commit that records the entry; no contract sets it (LDG-021).",
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target",
      "source": "d-5003",
      "description": "The sum of the entries of an account, kept so that a decision loads one record and not the whole journal (K-100).",
      "indexes": [
        {
          "name": "ledger_balance_rank",
          "fields": [
            "unit",
            "scope",
            "balance"
          ]
        }
      ]
    },
    {
      "id": "rec-ledger-limit",
      "name": "Ledger limit",
      "owner": "runtime",
      "key": [
        "limit-id"
      ],
      "fields": [
        {
          "name": "limit-id",
          "type": "string",
          "constraints": {
            "maxLength": 160
          },
          "description": "The unit, and the account when the limit is the limit of one account."
        },
        {
          "name": "unit",
          "type": "ledger-unit",
          "refersTo": "rec-ledger-unit",
          "onDelete": "restrict"
        },
        {
          "name": "account-id",
          "type": "ledger-account-id",
          "refersTo": "rec-ledger-account",
          "optional": true,
          "onDelete": "restrict",
          "description": "Set when the limit is that of one account and not of the whole unit."
        },
        {
          "name": "floor",
          "type": "ledger-amount",
          "optional": true
        },
        {
          "name": "cap",
          "type": "ledger-amount",
          "optional": true
        },
        {
          "name": "period-cap",
          "type": "u64",
          "optional": true
        },
        {
          "name": "period",
          "type": "ledger-period",
          "optional": true,
          "description": "Required when period-cap is set."
        },
        {
          "name": "set-at",
          "type": "timestamp"
        }
      ],
      "unique": [
        [
          "unit",
          "account-id"
        ]
      ],
      "retention": "Kept for the life of the tenant; a new declaration replaces the previous one for the postings after it and rewrites no entry (LDG-016).",
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target",
      "source": "d-5005",
      "description": "The floor, the cap and the cap per period a tenant declares for a unit or for one account of it."
    },
    {
      "id": "rec-segment",
      "name": "Segment",
      "owner": "runtime",
      "key": [
        "segment-id"
      ],
      "fields": [
        {
          "name": "segment-id",
          "type": "segment-id"
        },
        {
          "name": "name",
          "type": "string"
        },
        {
          "name": "subject-type",
          "type": "object-type-id"
        },
        {
          "name": "predicate",
          "type": "expression"
        },
        {
          "name": "version",
          "type": "u64"
        },
        {
          "name": "time-dependent",
          "type": "bool"
        },
        {
          "name": "refresh-seconds",
          "type": "u32",
          "optional": true
        },
        {
          "name": "defined-by",
          "type": "principal-id",
          "refersTo": "principal",
          "role": "party",
          "optional": true,
          "onDelete": "set-null"
        },
        {
          "name": "principal-field",
          "type": "field-id",
          "description": "The required unique string field of the subject type that holds the principal of the person (SEG-1548)."
        },
        {
          "name": "visible-to-members",
          "type": "bool",
          "description": "Whether list-my-segments shows the segment to its members (SEG-1540)."
        },
        {
          "name": "indexable",
          "type": "bool",
          "description": "Whether the time-dependent predicate is refreshed through wake records (SEG-1545)."
        },
        {
          "name": "member-count",
          "type": "u64",
          "description": "The number of memberships, kept by the commits that change them (SEG-1541)."
        },
        {
          "name": "refresh-skipped-at",
          "type": "timestamp",
          "optional": true,
          "description": "The time of the last refresh skipped for want of job quota (SEG-1544)."
        },
        {
          "name": "schema-version",
          "type": "schema-version",
          "description": "The schema version the definition was checked against (SEG-001)."
        }
      ],
      "unique": [
        [
          "name"
        ]
      ],
      "retention": "Until removed by the tenant; every version is kept in the schema history.",
      "schemaVersion": 1,
      "scope": "tenant-meta",
      "describedBy": "tenant-schema",
      "realisation": "target"
    },
    {
      "id": "rec-segment-membership",
      "name": "Segment membership",
      "owner": "runtime",
      "key": [
        "segment-id",
        "principal-id"
      ],
      "fields": [
        {
          "name": "segment-id",
          "type": "segment-id",
          "refersTo": "rec-segment",
          "onDelete": "cascade"
        },
        {
          "name": "principal-id",
          "type": "principal-id",
          "refersTo": "principal",
          "role": "subject",
          "constraints": {
            "pattern": "^[A-Za-z0-9_:.-]+$",
            "maxLength": 96
          },
          "onDelete": "cascade"
        },
        {
          "name": "version",
          "type": "u64"
        },
        {
          "name": "since",
          "type": "timestamp"
        }
      ],
      "retention": "While the person is a member: removed when the person exits, when the segment is removed and when the person is erased.",
      "erasure": {
        "point": "the transaction that records the erasure of the principal (SEG-036)"
      },
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target"
    },
    {
      "id": "rec-segment-batch",
      "name": "Segment batch",
      "owner": "automation-worker",
      "key": [
        "segment-id",
        "scope"
      ],
      "fields": [
        {
          "name": "segment-id",
          "type": "segment-id",
          "refersTo": "rec-segment",
          "onDelete": "cascade"
        },
        {
          "name": "scope",
          "type": "string",
          "description": "all, ref:<field>:<record> or due: which persons the continuation evaluates (d-7282)."
        },
        {
          "name": "version",
          "type": "u64"
        },
        {
          "name": "cursor",
          "type": "record-id",
          "optional": true
        },
        {
          "name": "reason",
          "type": "segment-reason"
        },
        {
          "name": "hop",
          "type": "u64",
          "description": "The hop count of the change that caused it (SEG-031)."
        },
        {
          "name": "at",
          "type": "timestamp"
        }
      ],
      "retention": "Until the batches of the version end or a newer version supersedes it.",
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target"
    },
    {
      "id": "rec-setting-definition",
      "name": "setting definition",
      "owner": "release-controller",
      "key": [
        "setting-id"
      ],
      "fields": [
