              "value": "/media/slow.svg",
              "label": "Growth rings"
            },
            {
              "value": "/media/drawing.svg",
              "label": "Three sketched doors"
            },
            {
              "value": "/media/hours.svg",
              "label": "Row of cylinders"
            }
          ],
          "initial": {
            "path": "data.post.fields.cover"
          }
        },
        {
          "name": "cover-alt",
          "input": "cover-alt",
          "label": "Description of the image",
          "control": "textarea",
          "initial": {
            "path": "data.post.fields.cover-alt"
          }
        },
        {
          "name": "featured",
          "input": "featured",
          "label": "Feature at the top of the front page",
          "control": "checkbox",
          "initial": {
            "path": "data.post.fields.featured"
          }
        }
      ],"arguments":{"article":"view.article-id","expected-version":"view.article-version","status":"'draft'"},"submitLabel":"Unpublish","onSuccess":{
        "navigate": {
          "screen": "screen-desk-edit",
          "params": {
            "slug": "response.slug"
          }
        },
        "toast": "Moved back to drafts.",
        "view": {
          "article-id": "response.article-id",
          "article-version": "response.version"
        }
      },"onError":{
        "show": "inline",
        "announce": "Some fields need attention."
      }},
    {"id":"form-settings","screen":"screen-desk-settings","contract":"save-site-settings","fields":[
        {
          "name": "name",
          "input": "name",
          "label": "Name",
          "control": "text",
          "initial": {
            "path": "data.site.fields.name"
          }
        },
        {
          "name": "tagline",
          "input": "tagline",
          "label": "Tagline",
          "control": "text",
          "initial": {
            "path": "data.site.fields.tagline"
          }
        },
        {
          "name": "accent",
          "input": "accent",
          "label": "Accent colour",
          "control": "radio",
          "optionsFrom": {
            "path": "accents"
          },
          "initial": {
            "path": "data.site.fields.accent"
          }
        },
        {
          "name": "paper",
          "input": "paper",
          "label": "Paper",
          "control": "radio",
          "optionsFrom": {
            "path": "papers"
          },
          "initial": {
            "path": "data.site.fields.paper"
          }
        }
      ],"arguments":{"publication":"view.publication-id","expected-version":"view.publication-version"},"submitLabel":"Save settings","onSuccess":{
        "toast": "Settings saved.",
        "view": {
          "publication-version": "response.version"
        }
      },"onError":{
        "show": "inline",
        "announce": "Some fields need attention."
      }},
    {
      "id": "form-accept-invitation",
      "screen": "screen-sign-in",
      "contract": "accept-owner-invitation",
      "fields": [
        {
          "name": "password",
          "input": "password",
          "label": "New password",
          "control": "password"
        }
      ],
      "arguments": {
        "challenge": "local.invitation_challenge",
        "token": "local.invitation_token"
      },
      "submitLabel": "Set password",
      "onSuccess": {
        "navigate": {
          "screen": "screen-sign-in"
        },
        "toast": "Your password is set. Sign in as ${response.login}."
      },
      "onError": {
        "show": "inline"
      }
    }
  ],
  "actions": [
    {
      "id": "act-sign-out-desk",
      "screen": "screen-desk",
      "label": "Sign out",
      "contract": "sign-out-of-site",
      "onSuccess": {
        "navigate": {
          "screen": "screen-front-page"
        },
        "toast": "Signed out."
      },
      "onError": {
        "show": "toast"
      },
      "alsoOn": {
        "auth": "session"
      }
    },
    {
      "id": "act-sign-out-front-page",
      "screen": "screen-front-page",
      "label": "Sign out",
      "contract": "sign-out-of-site",
      "onSuccess": {
        "toast": "Signed out."
      },
      "onError": {
        "show": "toast"
      },
      "alsoOn": {
        "auth": "none"
      }
    },
    {"id":"act-preview-new","screen":"screen-desk-new","label":"Preview","contract":"preview-markdown","form":"form-new-article-save","arguments":{"markdown":"form.body"},"result":{"into":"preview","output":"blocks"},"onSuccess":{},"onError":{"show":"inline"}},
    {"id":"act-preview-edit","screen":"screen-desk-edit","label":"Preview","contract":"preview-markdown","form":"form-edit-article-save-draft","arguments":{"markdown":"form.body"},"result":{"into":"preview","output":"blocks"},"onSuccess":{},"onError":{"show":"inline"}},
    {
      "id": "act-desk-publish",
      "screen": "screen-desk",
      "label": "Publish ${item.title}",
      "contract": "update-article",
      "forEach": "articles",
      "arguments": {
        "article": "item.article-id",
        "expected-version": "item.version",
        "title": "item.title",
        "slug": "item.slug",
        "body": "item.body",
        "status": "'published'"
      },
      "onSuccess": {
        "toast": "Published."
      },
      "onError": {
        "show": "toast",
        "prefix": "Not done. "
      },
      "uiName": "post.publish",
      "uiMarker": "published",
      "uiRowKey": "article_id",
      "uiLabelKey": "publish"
    },
    {
      "id": "act-desk-unpublish",
      "screen": "screen-desk",
      "label": "Unpublish ${item.title}",
      "contract": "update-article",
      "forEach": "articles",
      "arguments": {
        "article": "item.article-id",
        "expected-version": "item.version",
        "title": "item.title",
        "slug": "item.slug",
        "body": "item.body",
        "status": "'draft'"
      },
      "onSuccess": {
        "toast": "Moved back to drafts."
      },
      "onError": {
        "show": "toast",
        "prefix": "Not done. "
      },
      "uiName": "post.unpublish",
      "uiMarker": "draft",
      "uiRowKey": "article_id",
      "uiLabelKey": "unpublish"
    },
    {
      "id": "act-desk-delete",
      "screen": "screen-desk",
      "label": "Delete ${item.title}",
      "contract": "delete-article",
      "forEach": "articles",
      "arguments": {
        "article": "item.article-id",
        "expected-version": "item.version"
      },
      "confirm": "Confirm deleting ${item.title}",
      "onSuccess": {
        "toast": "Deleted."
      },
      "onError": {
        "show": "toast",
        "prefix": "Not done. "
      },
      "confirmAnnounce": "Press Confirm delete to remove the article for good.",
      "uiName": "post.delete",
      "uiAsk": "post.ask_delete",
      "uiMarker": "deleted",
      "uiRowKey": "article_id",
      "uiLabelKey": "remove"
    }
  ],
