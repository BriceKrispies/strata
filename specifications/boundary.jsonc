  "retentions": [
    {"id":"ret-principal","description":"The structured form of the prose retention of rec-principal.","record":"rec-principal","until":"ev-principal-erased","then":"delete","source":"prv-353"},
    {"id":"ret-credential","description":"The structured form of the prose retention of rec-credential.","record":"rec-credential","until":"ev-credential-ended","then":"delete","source":"prv-353"},
    {"id":"ret-identity-link","description":"The structured form of the prose retention of rec-identity-link.","record":"rec-identity-link","until":"ev-identity-link-ended","then":"delete","source":"prv-353"},
    {"id":"ret-session","description":"The structured form of the prose retention of rec-session.","record":"rec-session","until":"ev-session-retention-elapsed","then":"delete","source":"prv-364"},
    {"id":"ret-challenge","description":"The structured form of the prose retention of rec-challenge.","record":"rec-challenge","until":"ev-challenge-closed","then":"delete","source":"prv-365"},
    {"id":"ret-content","description":"The structured form of the prose retention of tenant records (tbl-records).","record":"tbl-records","until":"ev-content-removed","then":"delete","source":"prv-356"},
    {"id":"ret-event","description":"The structured form of the prose retention of rec-event.","record":"rec-event","until":"ev-restore-window-closed","then":"delete","source":"d-522"},
    {"id":"ret-proposal","description":"The structured form of the prose retention of rec-proposal.","record":"rec-proposal","until":"ev-proposal-retention-elapsed","then":"delete"},
    {"id":"ret-cnv-turn","description":"The structured form of the prose retention of rec-cnv-turn.","record":"rec-cnv-turn","until":"ev-conversation-deleted","then":"delete","source":"cnv-229"},
    {"id":"ret-consent-record","description":"The structured form of the prose retention of rec-consent-record.","record":"rec-consent-record","until":"ev-consent-retention-elapsed","then":"delete","source":"prv-375"},
    {"id":"ret-log-line","description":"The structured form of the prose retention of rec-log-line.","record":"rec-log-line","keepFor":"14 d","then":"delete","source":"prv-363"},
    {"id":"ret-cdn-access-log","description":"The structured form of the prose retention of rec-cdn-access-log.","record":"rec-cdn-access-log","keepFor":"7 d","then":"delete","source":"prv-363"},
    {"id":"ret-job-attempt","description":"The structured form of the prose retention of rec-job-attempt.","record":"rec-job-attempt","until":"ev-job-attempt-retention-elapsed","then":"delete","source":"sch-014"},
    {"id":"ret-effect-record","description":"The structured form of the prose retention of rec-effect-record.","record":"rec-effect-record","until":"ev-effect-retention-elapsed","then":"delete","source":"prv-366"},
    {"id":"ret-file-bytes","description":"The structured form of the prose retention of rec-file-bytes.","record":"rec-file-bytes","until":"ev-file-bytes-unreferenced","then":"delete","source":"prv-353"},
    {"id":"ret-mail-message","description":"The structured form of the prose retention of rec-mail-message.","record":"rec-mail-message","until":"ev-mail-retention-elapsed","then":"delete","source":"eml-011"},
    {"id":"ret-mail-suppression","description":"The structured form of the prose retention of rec-mail-suppression.","record":"rec-mail-suppression","until":"ev-suppression-removed","then":"delete"},
    {"id":"ret-inbox-item","description":"The structured form of the prose retention of rec-inbox-item.","record":"rec-inbox-item","until":"ev-inbox-item-ended","then":"delete","source":"ntf-151"},
    {"id":"ret-webhook-subscription","description":"The structured form of the prose retention of rec-webhook-subscription.","record":"rec-webhook-subscription","until":"ev-webhook-removed","then":"delete","source":"sec-003"},
    {"id":"ret-connector-secret","description":"The structured form of the prose retention of rec-connector-secret.","record":"rec-connector-secret","until":"ev-connector-secret-removed","then":"delete","source":"sec-003"},
    {"id":"ret-delivery-key","description":"The structured form of the prose retention of rec-delivery-key.","record":"rec-delivery-key","until":"ev-delivery-key-removed","then":"delete","source":"cms-166"},
    {"id":"ret-tbl-session-directory","description":"How long tbl-session-directory keeps its rows: a row goes with the session it points at.","record":"tbl-session-directory","until":"ev-session-retention-elapsed","then":"delete","source":"ten-001"},
    {"id":"ret-tbl-sessions","description":"How long tbl-sessions keeps its rows: a session is purged after it ends.","record":"tbl-sessions","until":"ev-session-retention-elapsed","then":"delete","source":"ten-001"},
    {"id":"ret-tbl-events","description":"How long tbl-events keeps its rows: until the tenant is deleted with its file.","record":"tbl-events","until":"td-tenant-deleted","then":"delete","source":"ten-001"},
    {"id":"ret-tbl-journal","description":"How long tbl-journal keeps its rows: until the tenant is deleted with its file.","record":"tbl-journal","until":"td-tenant-deleted","then":"delete","source":"ten-001"},
    {"id":"ret-tbl-snapshots","description":"How long tbl-snapshots keeps its rows: until the tenant is deleted with its file.","record":"tbl-snapshots","until":"td-tenant-deleted","then":"delete","source":"ten-001"},
    {"id":"ret-tbl-accounts","description":"How long tbl-accounts keeps its rows: until the tenant is deleted with its file.","record":"tbl-accounts","until":"td-tenant-deleted","then":"delete","source":"ten-001"},
    {"id":"ret-ledger-account","description":"The structured form of the prose retention of rec-ledger-account: the principal is cleared, the account stays.","record":"rec-ledger-account","until":"ev-principal-erased","then":"anonymise","fields":["owner-principal"],"source":"ldg-027"},
    {"id":"ret-ledger-entry","description":"The structured form of the prose retention of rec-ledger-entry: the principal that caused the entry is cleared, the entry stays.","record":"rec-ledger-entry","until":"ev-principal-erased","then":"anonymise","fields":["caused-by"],"source":"ldg-027"},
    {"id":"ret-setting-override","description":"The structured form of the prose retention of rec-setting-override.","record":"rec-setting-override","until":"ev-setting-override-ended","then":"delete","source":"d-5048"},
    {"id":"ret-setting-change","description":"The structured form of the prose retention of rec-setting-change.","record":"rec-setting-change","until":"ev-setting-change-retention-elapsed","then":"delete","source":"ops-329"},
    {"id":"ret-tbl-login-throttle","description":"How long tbl-login-throttle keeps its rows: the latest bound is the deletion of the tenant with its file; the record states the earlier ends its rows have in code.","record":"tbl-login-throttle","until":"td-tenant-deleted","then":"delete","source":"ten-001"},
    {"id":"ret-tbl-passkeys","description":"How long tbl-passkeys keeps its rows: the latest bound is the deletion of the tenant with its file; the record states the earlier ends its rows have in code.","record":"tbl-passkeys","until":"td-tenant-deleted","then":"delete","source":"ten-001"},
    {"id":"ret-tbl-passkey-challenges","description":"How long tbl-passkey-challenges keeps its rows: the latest bound is the deletion of the tenant with its file; the record states the earlier ends its rows have in code.","record":"tbl-passkey-challenges","until":"td-tenant-deleted","then":"delete","source":"ten-001"},
    {"id":"ret-tbl-sign-in-links","description":"How long tbl-sign-in-links keeps its rows: the latest bound is the deletion of the tenant with its file; the record states the earlier ends its rows have in code.","record":"tbl-sign-in-links","until":"td-tenant-deleted","then":"delete","source":"ten-001"},
    {"id":"ret-tbl-oidc-flows","description":"How long tbl-oidc-flows keeps its rows: the latest bound is the deletion of the tenant with its file; the record states the earlier ends its rows have in code.","record":"tbl-oidc-flows","until":"td-tenant-deleted","then":"delete","source":"ten-001"},
    {"id":"ret-tbl-federated-identities","description":"How long tbl-federated-identities keeps its rows: the latest bound is the deletion of the tenant with its file; the record states the earlier ends its rows have in code.","record":"tbl-federated-identities","until":"td-tenant-deleted","then":"delete","source":"ten-001"},
    {"id":"ret-tbl-totp-factors","description":"How long tbl-totp-factors keeps its rows: the latest bound is the deletion of the tenant with its file; the record states the earlier ends its rows have in code.","record":"tbl-totp-factors","until":"td-tenant-deleted","then":"delete","source":"ten-001"},
    {"id":"ret-tbl-recovery-codes","description":"How long tbl-recovery-codes keeps its rows: the latest bound is the deletion of the tenant with its file; the record states the earlier ends its rows have in code.","record":"tbl-recovery-codes","until":"td-tenant-deleted","then":"delete","source":"ten-001"},
    {"id":"ret-tbl-pending-sign-ins","description":"How long tbl-pending-sign-ins keeps its rows: the latest bound is the deletion of the tenant with its file; the record states the earlier ends its rows have in code.","record":"tbl-pending-sign-ins","until":"td-tenant-deleted","then":"delete","source":"ten-001"},
    {"id":"ret-tbl-recovery-requests","description":"How long tbl-recovery-requests keeps its rows: the latest bound is the deletion of the tenant with its file; the record states the earlier ends its rows have in code.","record":"tbl-recovery-requests","until":"td-tenant-deleted","then":"delete","source":"ten-001"},
    {"id":"ret-tbl-saml-requests","description":"How long tbl-saml-requests keeps its rows: the latest bound is the deletion of the tenant with its file; the record states the earlier ends its rows have in code.","record":"tbl-saml-requests","until":"td-tenant-deleted","then":"delete","source":"ten-001"},
    {"id":"ret-tbl-saml-assertions","description":"How long tbl-saml-assertions keeps its rows: the latest bound is the deletion of the tenant with its file; the record states the earlier ends its rows have in code.","record":"tbl-saml-assertions","until":"td-tenant-deleted","then":"delete","source":"ten-001"},
    {"id":"ret-tbl-identity-docs","description":"How long tbl-identity-docs keeps its rows: the latest bound is the deletion of the tenant with its file; the record states the earlier ends its rows have in code.","record":"tbl-identity-docs","until":"td-tenant-deleted","then":"delete","source":"ten-001"},
    {"id":"ret-webhook-endpoint","description":"The structured form of the prose retention of rec-webhook-endpoint.","record":"rec-webhook-endpoint","until":"ev-webhook-endpoint-removed","then":"delete","source":"sec-003"},
    {"id":"ret-workflow-step-run","description":"The structured form of the prose retention of rec-workflow-step-run.","record":"rec-workflow-step-run","until":"ev-workflow-step-run-retention-elapsed","then":"delete","source":"wfl-1531"},
    {"id":"ret-tbl-runtime-records","description":"How long tbl-runtime-records keeps its rows: the row of a finished instance goes 90 days after its last save; the row of any other instance is kept until the database file is deleted, which is the latest bound; the record states the ends its rows have in code.","record":"tbl-runtime-records","until":"td-tenant-deleted","then":"delete","source":"ten-001"},
    {"id":"ret-tbl-runtime-outbox","description":"How long tbl-runtime-outbox keeps its rows: a row goes when it is dispatched, or when its tenth failed dispatch moves it to the dead letters; the latest bound is the deletion of the database file; the record states the ends its rows have in code.","record":"tbl-runtime-outbox","until":"td-tenant-deleted","then":"delete","source":"ten-001"},
    {"id":"ret-tbl-runtime-timers","description":"How long tbl-runtime-timers keeps its rows: a row goes when its timer fires, is cancelled or is replaced; the latest bound is the deletion of the database file; the record states the ends its rows have in code.","record":"tbl-runtime-timers","until":"td-tenant-deleted","then":"delete","source":"ten-001"},
    {"id":"ret-tbl-runtime-queue","description":"How long tbl-runtime-queue keeps its rows: a row goes when it is handled or dead-lettered; the latest bound is the deletion of the database file; the record states the ends its rows have in code.","record":"tbl-runtime-queue","until":"td-tenant-deleted","then":"delete","source":"ten-001"},
    {"id":"ret-tbl-runtime-dead-letters","description":"How long tbl-runtime-dead-letters keeps its rows: 90 days after the row was moved there, deleted by the next write that moves a row there and by the purge; the record states the ends its rows have in code.","record":"tbl-runtime-dead-letters","then":"delete","source":"ten-001","keepFor":"90 d"},
    {"id":"ret-tbl-idempotency","description":"How long tbl-idempotency keeps its rows: a row goes with the first commit after the time its entry states (twenty-four hours, seven days for an invocation of a tenant operation, and longer than the retries of a step for an automation step, D-7701); the latest bound is the deletion of the tenant with its file; the record states the ends its rows have in code.","record":"tbl-idempotency","until":"td-tenant-deleted","then":"delete","source":"ten-001"},
    {"id":"ret-tbl-audit-log","description":"How long tbl-audit-log keeps its rows: nothing removes a row before the tenant file is deleted; the record states the ends its rows have in code.","record":"tbl-audit-log","until":"td-tenant-deleted","then":"delete","source":"ten-001"},
    {"id":"ret-tbl-jobs","description":"How long tbl-jobs keeps its rows: a row goes thirty days after the job ended (completed, failed or cancelled); a job that has not ended is never removed. The janitor makes one call that removes them (D-7703, SCH-2703).","record":"tbl-jobs","then":"delete","source":"ten-001","keepFor":"30 d"},
    {"id":"ret-tbl-automation-runs","description":"How long tbl-automation-runs keeps its rows: a row goes ninety days after the run ended; a run that has not ended is never removed. The janitor makes one call that removes them (D-7703, SCH-2703).","record":"tbl-automation-runs","then":"delete","source":"ten-001","keepFor":"90 d"},
    {"id":"ret-tbl-automation-steps","description":"How long tbl-automation-steps keeps its rows: the rows of a run go with the run, ninety days after it ended. The janitor makes one call that removes them (D-7703, SCH-2703).","record":"tbl-automation-steps","then":"delete","source":"ten-001","keepFor":"90 d"},
    {"id":"ret-tbl-automation-exceptions","description":"How long tbl-automation-exceptions keeps its rows: a declined or held row goes ninety days after it was written, and a parked or dead-lettered row goes ninety days after it was written once the tenant owner has settled it; an unsettled parked or dead-lettered row is never removed (OPS-348). The janitor makes one call that removes them (D-7703, SCH-2703).","record":"tbl-automation-exceptions","then":"delete","source":"ten-001","keepFor":"90 d"},
    {"id":"ret-tbl-schedules","description":"How long tbl-schedules keeps its rows: until the tenant file is deleted; no operation removes a schedule yet.","record":"tbl-schedules","until":"td-tenant-deleted","then":"delete","source":"ten-001"},
    {"id":"ret-tbl-automation-run-keys","description":"How long tbl-automation-run-keys keeps its rows: while the automation exists; the rows of a removed automation go with its removal, and the latest bound is the deletion of the tenant file.","record":"tbl-automation-run-keys","until":"td-tenant-deleted","then":"delete","source":"ten-001"},
    {"id":"ret-tbl-platform-settings","description":"How long tbl-platform-settings keeps its rows: until the platform value is removed; the revision stays with the definition (SET-030, SET-051).","record":"tbl-platform-settings","until":"ev-setting-override-ended","then":"delete","source":"d-5048"},
    {"id":"ret-tbl-setting-overrides","description":"How long tbl-setting-overrides keeps its rows: until the override is removed, with the team or the person it belongs to at the latest, and with the tenant file.","record":"tbl-setting-overrides","until":"td-tenant-deleted","then":"delete","source":"ten-001"},
    {"id":"ret-tbl-segments","description":"How long tbl-segments keeps its rows: until the segment is removed by the tenant; the latest bound is the deletion of the tenant file.","record":"tbl-segments","until":"td-tenant-deleted","then":"delete","source":"ten-001"},
    {"id":"ret-tbl-segment-batches","description":"How long tbl-segment-batches keeps its rows: until the batches of the version end or a newer version supersedes it; the latest bound is the deletion of the tenant file.","record":"tbl-segment-batches","until":"td-tenant-deleted","then":"delete","source":"ten-001"},
    {"id":"ret-tbl-segment-events","description":"How long tbl-segment-events keeps its rows: until the job worker has handed the event on and the retention of the event log has passed; the latest bound is the deletion of the tenant file.","record":"tbl-segment-events","until":"td-tenant-deleted","then":"delete","source":"ten-001"},
    {"id":"ret-notification-preference","description":"The structured form of the prose retention of rec-notification-preference.","record":"rec-notification-preference","until":"ev-principal-erased","then":"delete","source":"ntf-3100"},
    {"id":"ret-notification-digest","description":"How long rec-notification-digest keeps its markers: until the tenant file is deleted, which is the latest bound; no sweep removes a marker yet.","record":"rec-notification-digest","until":"td-tenant-deleted","then":"delete","source":"d-8100"}
  ],
  "types": [
    {"id":"tenant-id","name":"tenant-id","kind":"id","repr":"string","description":"Lower-case name, [a-z][a-z0-9_]*, at most 64 bytes (kernel TenantId).","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64}},
    {"id":"principal-id","name":"principal-id","kind":"id","repr":"string","description":"Assigned by the shell, opaque to the kernel (kernel PrincipalId).","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96}},
    {"id":"session-id","name":"session-id","kind":"id","repr":"string","description":"The public identifier of a session, never the secret token (kernel SessionId).","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96}},
    {"id":"object-type-id","name":"object-type-id","kind":"id","repr":"string","description":"An object type within a tenant (kernel ObjectTypeId).","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64},"metamodel":"object-id"},
    {"id":"workflow-id","name":"workflow-id","kind":"id","repr":"string","description":"A workflow of a tenant (kernel WorkflowId).","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64}},
    {"id":"record-id","name":"record-id","kind":"id","repr":"u64","description":"Allocated from the tenant counter (kernel RecordId)."},
    {"id":"placement-id","name":"placement-id","kind":"id","repr":"uuid"},
    {"id":"credential-id","name":"credential-id","kind":"id","repr":"uuid"},
    {"id":"link-id","name":"link-id","kind":"id","repr":"uuid"},
    {"id":"provider-id","name":"provider-id","kind":"id","repr":"uuid"},
    {"id":"challenge-id","name":"challenge-id","kind":"id","repr":"uuid"},
    {"id":"grant-id","name":"grant-id","kind":"id","repr":"uuid"},
    {"id":"job-id","name":"job-id","kind":"id","repr":"uuid"},
    {"id":"schedule-id","name":"schedule-id","kind":"id","repr":"uuid"},
    {"id":"run-id","name":"run-id","kind":"id","repr":"uuid"},
    {"id":"proposal-id","name":"proposal-id","kind":"id","repr":"uuid"},
    {"id":"submission-id","name":"submission-id","kind":"id","repr":"uuid"},
    {"id":"conversation-id","name":"conversation-id","kind":"id","repr":"uuid"},
    {"id":"turn-id","name":"turn-id","kind":"id","repr":"uuid"},
    {"id":"pending-id","name":"pending-id","kind":"id","repr":"uuid"},
    {"id":"consent-id","name":"consent-id","kind":"id","repr":"uuid"},
    {"id":"visitor-id","name":"visitor-id","kind":"id","repr":"uuid"},
    {"id":"log-id","name":"log-id","kind":"id","repr":"uuid"},
    {"id":"request-id","name":"request-id","kind":"id","repr":"uuid"},
    {"id":"key-id","name":"key-id","kind":"id","repr":"uuid"},
    {"id":"subprocessor-id","name":"subprocessor-id","kind":"id","repr":"uuid"},
    {"id":"hold-id","name":"hold-id","kind":"id","repr":"uuid"},
    {"id":"message-id","name":"message-id","kind":"id","repr":"uuid"},
    {"id":"release-id","name":"release-id","kind":"id","repr":"uuid"},
    {"id":"move-id","name":"move-id","kind":"id","repr":"uuid"},
    {"id":"correlation-id","name":"correlation-id","kind":"id","repr":"uuid"},
    {"id":"identifier","name":"identifier","kind":"id","repr":"uuid"},
    {"id":"cluster-id","name":"cluster-id","kind":"id","repr":"string"},
    {"id":"cell-id","name":"cell-id","kind":"id","repr":"string"},
    {"id":"region-id","name":"region-id","kind":"id","repr":"string"},
    {"id":"database-id","name":"database-id","kind":"id","repr":"string"},
    {"id":"plan-id","name":"plan-id","kind":"id","repr":"string"},
    {"id":"form-id","name":"form-id","kind":"id","repr":"string"},
    {"id":"template-id","name":"template-id","kind":"id","repr":"string"},
    {"id":"environment-id","name":"environment-id","kind":"id","repr":"string"},
    {"id":"colour-id","name":"colour-id","kind":"id","repr":"string"},
    {"id":"migration-id","name":"migration-id","kind":"id","repr":"string"},
    {"id":"host","name":"host","kind":"scalar","repr":"string"},
    {"id":"display-name","name":"display-name","kind":"scalar","repr":"string"},
    {"id":"email-address","name":"email-address","kind":"scalar","repr":"string"},
    {"id":"hash","name":"hash","kind":"scalar","repr":"string","description":"A hash in text form, as the storage layer holds token hashes."},
    {"id":"external-subject","name":"external-subject","kind":"scalar","repr":"string"},
    {"id":"url","name":"url","kind":"scalar","repr":"string"},
    {"id":"domain","name":"domain","kind":"scalar","repr":"string"},
    {"id":"ip-address","name":"ip-address","kind":"scalar","repr":"string"},
    {"id":"address-text","name":"address-text","kind":"scalar","repr":"string"},
    {"id":"text","name":"text","kind":"scalar","repr":"string","description":"Free text."},
    {"id":"reference","name":"reference","kind":"scalar","repr":"string","description":"A reference to a record or a copy, in text form."},
    {
      "id": "wrapped-secret",
      "name": "wrapped-secret",
      "kind": "scalar",
      "repr": "bytes",
      "description": "A secret wrapped by the key service.",
      "sensitive": "secret"
    },
    {
      "id": "secret",
      "name": "secret",
      "kind": "scalar",
      "repr": "bytes",
      "description": "A sealed secret.",
      "sensitive": "secret"
    },
    {"id":"expression","name":"expression","kind":"scalar","repr":"string"},
    {"id":"value-map","name":"value-map","kind":"scalar","repr":"string","description":"A map of field values as JSON text.","metamodel":"values"},
    {"id":"change-set","name":"change-set","kind":"scalar","repr":"string","description":"A set of changes as JSON text."},
    {"id":"structured-blocks","name":"structured-blocks","kind":"scalar","repr":"string","description":"Structured content blocks as JSON text: a list of template-block (D-7900), the blocks that constrained Markdown parses into, with the inline nodes token and value in a template."},
    {"id":"recurrence","name":"recurrence","kind":"scalar","repr":"string","description":"A recurrence rule: the RRULE value of RFC 5545 section 3.3.10 in the subset of SCH-1574, with the added part TZID."},
    {"id":"workflow-state","name":"workflow-state","kind":"scalar","repr":"string","description":"The state a tenant workflow gives a record; tenant-defined."},
    {"id":"tenant-lifecycle","name":"tenant-state","kind":"enum","values":["provisioning","active","suspended","moving","restoring","deleting"]},
    {"id":"principal-state","name":"principal-state","kind":"enum","values":["active","suspended","erased"]},
    {"id":"certificate-state","name":"certificate-state","kind":"enum","values":["pending","valid","expired"]},
    {"id":"domain-state","name":"domain-state","kind":"enum","values":["pending","proved"]},
    {"id":"job-state","name":"job-state","kind":"enum","values":[
        "waiting",
        "leased",
        "completed",
        "failed",
        "cancelled",
        "unscheduled"
      ]},
    {
      "id": "run-state",
      "name": "run-state",
      "kind": "enum",
      "values": [
        "running",
        "completed",
        "failed",
        "cancelled",
        "compensating",
        "awaiting-approval",
        "waiting",
        "suspended"
      ]
    },
    {"id":"proposal-state","name":"proposal-state","kind":"enum","values":["projecting","awaiting-approval","cleared","rejected","applied"]},
    {
      "id": "message-state",
      "name": "message-state",
      "kind": "enum",
      "values": [
        "queued",
        "submitted",
        "sent",
        "failed",
        "discarded",
        "held",
        "suppressed",
        "delivered",
        "bounced",
        "complained"
      ],
      "description": "The state of a message. queued, submitted, sent, failed and discarded as before; held when the allowance or the complaint breaker holds it (EML-1563, EML-1564), suppressed when the suppression list stopped it (EML-018), and delivered, bounced and complained when a delivery report said so (EML-1567)."
    },
    {"id":"release-state","name":"release-state","kind":"enum","values":["candidate","staged","live","rolled-back"]},
    {"id":"migration-state","name":"migration-state","kind":"enum","values":["not-started","running","stopped","complete"]},
    {"id":"move-state","name":"move-state","kind":"enum","values":["source-serves","copying","frozen","verified","target-serves"]},
    {"id":"principal-kind","name":"principal-kind","kind":"enum","values":["person","service","agent"]},
    {"id":"credential-kind","name":"credential-kind","kind":"enum","values":["password","passkey","totp"]},
    {"id":"provider-protocol","name":"provider-protocol","kind":"enum","values":["oidc","saml"]},
    {"id":"identity-provider-kind","name":"Identity provider kind","kind":"union","encoding":{"tag":"internal","tagField":"kind","variantCase":"kebab-case"},"description":"The kinds of identity provider behind the federation seam (D-8218, FED-2645), with the fields each kind requires and allows. The configuration file writes each field name with underscores for hyphens (issuer-template is issuer_template), and an entry of STRATA_OIDC_CONFIG that names no kind is oidc. Every entry also carries the fields common to all kinds: id, label, enabled, domains, create_on_first_sign_in, default_role and link_verified_email, and, for every kind but saml, client_id, client_secret_env and scopes. oidc: discovery at the issuer, which tokens must equal exactly; subject-claim defaults to sub (FED-2649); email-verification defaults to claim (FED-2654); domain-claim, when set, is the claim that must equal a bound domain (Google: hd, FED-2655); response-mode, client-secret-jwt and name-from-form-post are the options of Sign in with Apple (D-8219, FED-2656 to FED-2658), and client-secret-jwt excludes client_secret_env. oidc-issuer-template: issuer-template holds {tid} once; metadata-url is the discovery document, whose issuer is not compared; allowed-directories lists directory IDs or is exactly [\"any\"] (FED-2646); directory-claim defaults to tid and subject-claim to oid (FED-2648); email-verification defaults to never. oauth2-userinfo: there is no identity token; subject-claim names the field of the userinfo answer that is the stable subject (FED-2650); emails-url, when set, is the list whose primary verified entry is the verified address, and without it no address is verified (FED-2654); email-claim defaults to email and name-claim to name. saml: the fields of H-050.","variants":[{"name":"oidc","fields":[{"name":"issuer","type":"url"},{"name":"algorithms","type":"list<string>","optional":true},{"name":"subject-claim","type":"string","optional":true},{"name":"email-verification","type":"email-verification","optional":true},{"name":"domain-claim","type":"string","optional":true},{"name":"response-mode","type":"oidc-response-mode","optional":true},{"name":"client-secret-jwt","type":"client-secret-jwt","optional":true},{"name":"name-from-form-post","type":"bool","optional":true}]},{"name":"oidc-issuer-template","fields":[{"name":"issuer-template","type":"string"},{"name":"metadata-url","type":"url"},{"name":"allowed-directories","type":"list<string>"},{"name":"directory-claim","type":"string","optional":true},{"name":"subject-claim","type":"string","optional":true},{"name":"algorithms","type":"list<string>","optional":true},{"name":"email-verification","type":"email-verification","optional":true}]},{"name":"oauth2-userinfo","fields":[{"name":"authorization-url","type":"url"},{"name":"token-url","type":"url"},{"name":"userinfo-url","type":"url"},{"name":"subject-claim","type":"string"},{"name":"emails-url","type":"url","optional":true},{"name":"email-claim","type":"string","optional":true},{"name":"name-claim","type":"string","optional":true}]},{"name":"saml","fields":[{"name":"idp-entity-id","type":"string"},{"name":"sso-url","type":"url"},{"name":"certificates","type":"list<string>","optional":true},{"name":"certificate-files","type":"list<string>","optional":true},{"name":"sp-entity-id","type":"string","optional":true},{"name":"email-attribute","type":"string","optional":true},{"name":"name-attribute","type":"string","optional":true},{"name":"email-verified","type":"bool","optional":true},{"name":"skew-secs","type":"u32","optional":true}]}]},
    {"id":"client-secret-jwt","name":"Client secret JWT","kind":"struct","fields":[{"name":"team-id","type":"string"},{"name":"key-id","type":"string"},{"name":"signing-key-env","type":"string"}],"description":"How a provider that takes a signed client secret is authenticated (Sign in with Apple, D-8219, FED-2658). team-id is the iss of the secret and key-id its kid; signing-key-env names the environment variable that holds the ES256 private key in PEM, read when the process starts. A name that is not set stops the process from starting."},
    {"id":"email-verification","name":"email-verification","kind":"enum","values":["claim","never"]},
    {"id":"oidc-response-mode","name":"oidc-response-mode","kind":"enum","values":["query","form_post"]},
    {"id":"challenge-kind","name":"challenge-kind","kind":"enum","values":["link","oidc","saml"]},
    {"id":"conversation-state","name":"conversation-state","kind":"enum","values":["open","closed"]},
    {"id":"turn-state","name":"turn-state","kind":"enum","values":["streaming","complete","interrupted","failed"]},
    {"id":"pending-action-state","name":"pending-action-state","kind":"enum","values":["previewed","confirmed","applied","cancelled","refused"]},
    {"id":"consent-decision","name":"consent-decision","kind":"enum","values":["granted","refused","withdrawn"]},
    {"id":"signal-kind","name":"signal-kind","kind":"enum","values":["log","span","metric"]},
    {"id":"job-attempt-outcome","name":"job-attempt-outcome","kind":"enum","values":["completed","failed","cancelled"]},
    {"id":"subject-key-state","name":"subject-key-state","kind":"enum","values":["live","destroyed"]},
    {"id":"suppression-reason","name":"suppression-reason","kind":"enum","values":["bounce","complaint","unsubscribe"]},
    {"id":"rollback-class","name":"rollback-class","kind":"enum","values":["rollback-safe","roll-forward-only"]},
    {"id":"environment-kind","name":"environment-kind","kind":"enum","values":["stage","production"]},
    {"id":"access-report","name":"Access Report","kind":"struct","fields":[{"name":"tenant","type":"tenant-id"},{"name":"grants","type":"list<grant-id>"},{"name":"generated-at","type":"timestamp"}],"description":"The grants made to the data of a tenant."},
    {"id":"account","name":"Account","kind":"struct","fields":[{"name":"tenant","type":"tenant-id"},{"name":"login","type":"string"},{"name":"principal","type":"principal-id"},{"name":"display-name","type":"string"},{"name":"password-hash","type":"hash"}],"description":"strata_storage_api::Account: a locally managed login."},
    {"id":"action-preview","name":"Action Preview","kind":"struct","fields":[{"name":"pending","type":"pending-id"},{"name":"creates","type":"list<record-id>"},{"name":"changes","type":"list<record-id>"},{"name":"removes","type":"list<record-id>"},{"name":"views","type":"list<string>"},{"name":"preview-hash","type":"hash"},{"name":"valid-until","type":"timestamp"}],"description":"The preview of a pending action."},
    {"id":"adapter-capabilities","name":"Adapter Capabilities","kind":"struct","fields":[{"name":"adapter","type":"string"},{"name":"durable","type":"bool"},{"name":"isolation","type":"string"},{"name":"read-consistency","type":"string"},{"name":"notes","type":"list<string>"}],"description":"strata_storage_api::Capabilities: what an adapter actually provides."},
    {"id":"adapter-health","name":"Adapter Health","kind":"struct","fields":[{"name":"ok","type":"bool"},{"name":"detail","type":"string"},{"name":"tenants","type":"u64"},{"name":"outbox-pending","type":"u64"}],"description":"strata_storage_api::Health."},
    {"id":"agent-entry","name":"Agent Entry","kind":"struct","fields":[{"name":"agent","type":"principal-id"},{"name":"owner","type":"principal-id"},{"name":"purpose","type":"string"},{"name":"scopes","type":"list<string>"},{"name":"tier","type":"string"}],"description":"One agent of the registry."},
    {"id":"api-error","name":"Api Error","kind":"struct","fields":[{"name":"code","type":"error-code"},{"name":"message","type":"string"},{"name":"kind","type":"string","optional":true},{"name":"failed","type":"list<check>","optional":true},{"name":"correlation","type":"string"}],"description":"strata_protocol::api::ErrorReply: the error body of every HTTP operation (system.generation.errorBody). kind and failed are left out when absent, and the correlation is the request's correlation id as given."},
    {"id":"archive-manifest","name":"Archive Manifest","kind":"struct","fields":[{"name":"files","type":"list<string>"},{"name":"hashes","type":"list<hash>"},{"name":"not-carried","type":"list<string>"}],"description":"The manifest of an archive."},
    {"id":"archive-ref","name":"Archive Ref","kind":"id","repr":"string","description":"A reference to an archive document produced by an export."},
    {"id":"audit-entry","name":"Audit Entry","kind":"struct","fields":[{"name":"seq","type":"u64"},{"name":"actor","type":"principal-id"},{"name":"on-behalf-of","type":"principal-id","optional":true},{"name":"action","type":"string"},{"name":"outcome","type":"string"},{"name":"correlation","type":"correlation-id"},{"name":"previous-hash","type":"hash"}],"description":"One entry of the hash-chained audit log."},
    {"id":"changelog-entry","name":"Changelog Entry","kind":"struct","fields":[{"name":"version","type":"string"},{"name":"description","type":"string"},{"name":"at","type":"timestamp"}],"description":"One entry of the changelog."},
    {"id":"commit","name":"Commit","kind":"struct","fields":[{"name":"delta","type":"state-delta"},{"name":"events","type":"list<domain-event>"},{"name":"journal","type":"journal-entry"},{"name":"revoke-sessions","type":"list<principal-id>"}],"description":"strata_storage_api::Commit: everything one accepted transition writes, applied atomically."},
    {"id":"copy-key","name":"Copy Key","kind":"scalar","repr":"string","description":"The key of a stored copy; it begins with the tenant identifier."},
    {"id":"deletion-certificate","name":"Deletion Certificate","kind":"struct","fields":[{"name":"tenant","type":"tenant-id"},{"name":"key-destroyed-at","type":"timestamp"},{"name":"images-removed","type":"list<timestamp>"},{"name":"exports-removed","type":"list<timestamp>"},{"name":"source-database-removed-at","type":"timestamp","optional":true},{"name":"forks-removed","type":"list<tenant-id>"},{"name":"key-service-state-removed-at","type":"timestamp"}],"description":"The certificate of a tenant deletion."},
    {"id":"desk-article","name":"Desk Article","kind":"struct","fields":[{"name":"article-id","type":"record-id"},{"name":"version","type":"u64"},{"name":"title","type":"string"},{"name":"slug","type":"string"},{"name":"body","type":"string"},{"name":"status","type":"string"}],"description":"One article as the writing desk lists it: the identifier and version a change names, the fields a save repeats, and whether it is a draft or published."},
    {"id":"publication-fields","name":"Publication Fields","kind":"struct","fields":[{"name":"key","type":"string"},{"name":"name","type":"string"},{"name":"tagline","type":"string","optional":true},{"name":"about","type":"string","optional":true},{"name":"colophon","type":"string","optional":true},{"name":"accent","type":"string"},{"name":"paper","type":"string"}],"description":"The fields of the publication record as the BFF projects them (object publication of the tenant template), under the names the JSON uses."},
    {"id":"author-fields","name":"Author Fields","kind":"struct","fields":[{"name":"name","type":"string"},{"name":"slug","type":"string"},{"name":"title","type":"string","optional":true},{"name":"bio","type":"string","optional":true},{"name":"principal","type":"string","optional":true}],"description":"The fields of an author record as the BFF projects them (object author)."},
    {"id":"category-fields","name":"Category Fields","kind":"struct","fields":[{"name":"name","type":"string"},{"name":"slug","type":"string"},{"name":"description","type":"string","optional":true}],"description":"The fields of a topic record as the BFF projects them (object category)."},
    {"id":"post-fields","name":"Post Fields","kind":"struct","fields":[{"name":"title","type":"string"},{"name":"slug","type":"string"},{"name":"excerpt","type":"string","optional":true},{"name":"body","type":"string"},{"name":"author","type":"record-ref"},{"name":"category","type":"record-ref","optional":true},{"name":"tags","type":"list<string>","optional":true},{"name":"status","type":"string"},{"name":"featured","type":"bool","optional":true},{"name":"published-at","type":"timestamp","optional":true},{"name":"cover","type":"string","optional":true},{"name":"cover-alt","type":"string","optional":true}],"description":"The fields of an article record as the BFF projects them (object post). The specification names them in kebab-case like every other field; on the wire they are snake_case (published_at, cover_alt), as system.generation.wireCase says."},
    {"id":"person-entry","name":"Person Entry","kind":"struct","fields":[{"name":"name","type":"string","optional":true},{"name":"avatar","type":"string","optional":true},{"name":"self","type":"bool","optional":true}],"description":"What a view reply says of one person it names, under the person's handle in the reply's people table: the display name and avatar the reader may know (null when not), and self on the reader's own entry (WG-5463)."},
    {"id":"person-ref","name":"Person Ref","kind":"struct","fields":[{"name":"person","type":"string"}],"description":"A person value of a view reply (the author of a record): an opaque handle, per reply, into the reply's people table. The principal itself is never sent (WG-5463)."},
    {"id":"record-ref-target","name":"Record Ref Target","kind":"struct","fields":[{"name":"object","type":"string"},{"name":"id","type":"record-id"},{"name":"title","type":"string","optional":true}],"description":"The target of a reference the reader may read: its object type, its id and its title (the title field of the object type), absent when the target has none."},
    {"id":"record-ref","name":"Record Ref","kind":"struct","fields":[{"name":"ref","type":"record-ref-target","optional":true}],"description":"A reference field of a view reply: its target, or no target when the reader may not read it (the reply sends no id then)."},
    {"id":"author-record","name":"Author Record","kind":"struct","fields":[{"name":"id","type":"record-id"},{"name":"object","type":"string"},{"name":"version","type":"u64"},{"name":"created-at","type":"timestamp"},{"name":"updated-at","type":"timestamp"},{"name":"created-by","type":"person-ref","optional":true},{"name":"fields","type":"author-fields"}],"description":"An author record included in an article row (refs.author): the projection of a record without refs or blocks of its own (substrate project_record)."},
    {"id":"category-record","name":"Category Record","kind":"struct","fields":[{"name":"id","type":"record-id"},{"name":"object","type":"string"},{"name":"version","type":"u64"},{"name":"created-at","type":"timestamp"},{"name":"updated-at","type":"timestamp"},{"name":"created-by","type":"person-ref","optional":true},{"name":"fields","type":"category-fields"}],"description":"A topic record included in an article row (refs.category)."},
    {"id":"post-refs","name":"Post Refs","kind":"struct","fields":[{"name":"author","type":"author-record","optional":true},{"name":"category","type":"category-record","optional":true}],"description":"The records an article row includes through its reference fields (the view definition includes author and category); each is absent when the reference is empty."},
    {"id":"publication-row","name":"Publication Row","kind":"struct","fields":[{"name":"id","type":"record-id"},{"name":"object","type":"string"},{"name":"version","type":"u64"},{"name":"created-at","type":"timestamp"},{"name":"updated-at","type":"timestamp"},{"name":"created-by","type":"person-ref","optional":true},{"name":"fields","type":"publication-fields"},{"name":"refs","type":"json"},{"name":"blocks","type":"json","optional":true},{"name":"reading-minutes","type":"u32","optional":true}],"description":"One publication record as a view section holds it (substrate project_row): the record members, refs (an empty object here), blocks of its markdown fields and reading_minutes when it has any."},
    {"id":"author-row","name":"Author Row","kind":"struct","fields":[{"name":"id","type":"record-id"},{"name":"object","type":"string"},{"name":"version","type":"u64"},{"name":"created-at","type":"timestamp"},{"name":"updated-at","type":"timestamp"},{"name":"created-by","type":"person-ref","optional":true},{"name":"fields","type":"author-fields"},{"name":"refs","type":"json"},{"name":"blocks","type":"json","optional":true},{"name":"reading-minutes","type":"u32","optional":true}],"description":"One author record as a view section holds it; the markdown field bio is in blocks."},
    {"id":"category-row","name":"Category Row","kind":"struct","fields":[{"name":"id","type":"record-id"},{"name":"object","type":"string"},{"name":"version","type":"u64"},{"name":"created-at","type":"timestamp"},{"name":"updated-at","type":"timestamp"},{"name":"created-by","type":"person-ref","optional":true},{"name":"fields","type":"category-fields"},{"name":"refs","type":"json"},{"name":"blocks","type":"json","optional":true},{"name":"reading-minutes","type":"u32","optional":true}],"description":"One topic record as a view section holds it."},
    {"id":"post-row","name":"Post Row","kind":"struct","fields":[{"name":"id","type":"record-id"},{"name":"object","type":"string"},{"name":"version","type":"u64"},{"name":"created-at","type":"timestamp"},{"name":"updated-at","type":"timestamp"},{"name":"created-by","type":"person-ref","optional":true},{"name":"fields","type":"post-fields"},{"name":"refs","type":"post-refs"},{"name":"blocks","type":"json","optional":true},{"name":"reading-minutes","type":"u32","optional":true}],"description":"One article record as a view section holds it: its fields, the author and the topic it refers to (refs), and the blocks of its body with the reading time."},
    {"id":"view-theme","name":"View Theme","kind":"struct","fields":[{"name":"accent","type":"string"},{"name":"paper","type":"string"},{"name":"theme","type":"string","optional":true}],"description":"The resolved theme of a view: the accent and paper names the publication settings give, and the design-system preset (theme, left out while it is the default fieldnotes), or the defaults when a setting is not one of the theme tokens."},
    {"id":"option-choice","name":"Option Choice","kind":"struct","fields":[{"name":"value","type":"string"},{"name":"label","type":"string"}],"description":"One entry of a choice control: the value the form submits and the label it shows."},
    {"id":"front-page-data","name":"Front Page Data","kind":"struct","fields":[{"name":"site","type":"publication-row","optional":true},{"name":"featured","type":"post-row","optional":true},{"name":"recent","type":"list<post-row>"},{"name":"categories","type":"list<category-row>"}],"description":"The sections of the front page view: the publication, the featured article, the recent articles and the topics."},
    {"id":"article-page-data","name":"Article Page Data","kind":"struct","fields":[{"name":"site","type":"publication-row","optional":true},{"name":"post","type":"post-row","optional":true},{"name":"recent","type":"list<post-row>"}],"description":"The sections of an article view: the publication, the article with this address (null when none) and the recent articles."},
    {"id":"topics-page-data","name":"Topics Page Data","kind":"struct","fields":[{"name":"site","type":"publication-row","optional":true},{"name":"categories","type":"list<category-row>"},{"name":"recent","type":"list<post-row>"}],"description":"The sections of the topic index view."},
    {"id":"topic-page-data","name":"Topic Page Data","kind":"struct","fields":[{"name":"site","type":"publication-row","optional":true},{"name":"category","type":"category-row","optional":true},{"name":"posts","type":"list<post-row>"},{"name":"categories","type":"list<category-row>"}],"description":"The sections of a topic view."},
    {"id":"authors-page-data","name":"Authors Page Data","kind":"struct","fields":[{"name":"site","type":"publication-row","optional":true},{"name":"authors","type":"list<author-row>"}],"description":"The sections of the author index view."},
    {"id":"author-page-data","name":"Author Page Data","kind":"struct","fields":[{"name":"site","type":"publication-row","optional":true},{"name":"author","type":"author-row","optional":true},{"name":"posts","type":"list<post-row>"}],"description":"The sections of an author view."},
    {"id":"search-page-data","name":"Search Page Data","kind":"struct","fields":[{"name":"site","type":"publication-row","optional":true},{"name":"results","type":"list<post-row>"}],"description":"The sections of the search view."},
    {"id":"about-page-data","name":"About Page Data","kind":"struct","fields":[{"name":"site","type":"publication-row","optional":true},{"name":"authors","type":"list<author-row>"}],"description":"The sections of the about view; the markdown fields about and colophon of the publication are in its blocks."},
    {"id":"site-page-data","name":"Site Page Data","kind":"struct","fields":[{"name":"site","type":"publication-row","optional":true}],"description":"The sections of a view that holds the publication alone (sign in, settings, the impact lab)."},
    {"id":"desk-page-data","name":"Desk Page Data","kind":"struct","fields":[{"name":"site","type":"publication-row","optional":true},{"name":"posts","type":"list<post-row>"}],"description":"The sections of the writing desk view."},
    {"id":"new-article-page-data","name":"New Article Page Data","kind":"struct","fields":[{"name":"site","type":"publication-row","optional":true},{"name":"categories","type":"list<category-row>"},{"name":"authors","type":"list<author-row>"}],"description":"The sections of the view for a new article."},
    {"id":"edit-article-page-data","name":"Edit Article Page Data","kind":"struct","fields":[{"name":"site","type":"publication-row","optional":true},{"name":"post","type":"post-row","optional":true},{"name":"categories","type":"list<category-row>"},{"name":"authors","type":"list<author-row>"}],"description":"The sections of the view for editing an article."},
    {"id":"domain-binding","name":"Domain Binding","kind":"struct","fields":[{"name":"host","type":"host"},{"name":"tenant","type":"tenant-id"},{"name":"certificate-state","type":"certificate-state"}],"description":"A domain name bound to a tenant."},
    {"id":"erasure-receipt","name":"Erasure Receipt","kind":"struct","fields":[{"name":"request","type":"string"},{"name":"principal","type":"principal-id"},{"name":"at","type":"timestamp"},{"name":"records","type":"list<record-id>"},{"name":"changed","type":"list<erased-record>"},{"name":"reached","type":"list<string>"},{"name":"not-reached","type":"list<string>"},{"name":"complete","type":"bool"},{"name":"batches","type":"u32"},{"name":"batch-bound","type":"u64"}],"description":"The receipt of an erasure (PRV-353). reached and not-reached are sentences that name a copy, what happened to it or why it was not reached, and the task that closes the gap; changed names each record changed and the fields cleared, never their values. complete is true only when no copy is left unreached, which is false until the subject key of D-350 is built. batches is the number of commits the erasure took and batch-bound the most records one commit changes. reached also states the restriction of processing that was in force on the principal and each legal hold that kept a record unchanged (PRV-2463); not-reached lists each record a hold kept."},
    {"id":"error-code","name":"Error Code","kind":"enum","values":["unauthenticated","forbidden","not_found","conflict","invalid","throttled","unavailable","internal"],"description":"strata_protocol::api::ErrorCode, as it is written on the wire (snake_case); each has one HTTP status, the one system.generation.errorKinds gives the error kind of the same name."},
    {"id":"event-stream","name":"Event Stream","kind":"struct","fields":[{"name":"tenant","type":"tenant-id"},{"name":"position","type":"u64"}],"description":"A stream of notices, resumable from a position; a notice never carries record contents."},
    {"id":"executed-intent","name":"Executed Intent","kind":"struct","fields":[{"name":"transition","type":"transition-result"},{"name":"receipt","type":"receipt"},{"name":"conflicts","type":"u32"}],"description":"strata_storage_api::Executed."},
    {"id":"field-difference","name":"Field Difference","kind":"struct","fields":[{"name":"field","type":"string"},{"name":"draft","type":"string"},{"name":"published","type":"string"}],"description":"One field that differs between a draft and its published version."},
    {"id":"html-page","name":"Html Page","kind":"scalar","repr":"string","description":"A complete HTML document."},
    {"id":"identity-assertion","name":"Identity Assertion","kind":"struct","fields":[{"name":"tenant","type":"tenant-id"},{"name":"principal","type":"principal-id"},{"name":"session","type":"session-id"},{"name":"roles","type":"list<string>"},{"name":"authenticated-at","type":"timestamp"},{"name":"expires-at","type":"timestamp"},{"name":"signature","type":"bytes"}],"description":"An assertion signed by the identity service about one session."},
    {"id":"inbox-notice","name":"Inbox Notice","kind":"struct","fields":[{"name":"id","type":"string"},{"name":"kind","type":"string"},{"name":"body","type":"value-map"},{"name":"at","type":"timestamp"},{"name":"read","type":"bool"},{"name":"topic","type":"inbox-topic"},{"name":"category","type":"message-category-id","optional":true},{"name":"reference","type":"send-reference","optional":true},{"name":"read-at","type":"timestamp","optional":true}],"description":"One notice of an inbox. topic follows the grammar of NTF-1568; read is true from the moment the recipient marks the notice read until the recipient marks it unread (NTF-1569)."},
    {"id":"job-outcome","name":"Job Outcome","kind":"enum","values":["succeeded","failed"],"description":"The outcome a worker reports for one attempt."},
    {"id":"job-summary","name":"Job Summary","kind":"struct","fields":[{"name":"job","type":"job-id"},{"name":"state","type":"job-state"},{"name":"due-at","type":"timestamp"},{"name":"attempts","type":"u32"},{"name":"errors","type":"list<string>"}],"description":"A job as the catalogue lists it."},
    {"id":"journal-entry","name":"Journal Entry","kind":"struct","fields":[{"name":"tenant","type":"tenant-id"},{"name":"base-revision","type":"state-revision","optional":true},{"name":"revision","type":"state-revision"},{"name":"kernel-version","type":"string"},{"name":"intent","type":"intent"},{"name":"context","type":"context"},{"name":"delta-hash","type":"hash"},{"name":"events-hash","type":"hash"}],"description":"strata_storage_api::JournalEntry: one accepted transition as decided, enough to run it again."},
    {"id":"journal-replay","name":"Journal Replay","kind":"struct","fields":[{"name":"tenant","type":"tenant-id"},{"name":"entries","type":"u64"},{"name":"agreed","type":"u64"},{"name":"first-mismatch","type":"string","optional":true},{"name":"replayed-hash","type":"hash"},{"name":"live-hash","type":"hash"},{"name":"matches-live","type":"bool"},{"name":"other-kernel-versions","type":"list<string>"}],"description":"strata_simulation::journal::JournalReplay."},
    {"id":"layout-outcome","name":"Layout Outcome","kind":"struct","fields":[{"name":"tenant","type":"tenant-id"},{"name":"applied","type":"bool"},{"name":"error","type":"string","optional":true}],"description":"The outcome of a layout change for one tenant."},
    {"id":"layout-phase","name":"Layout Phase","kind":"enum","values":["expanding","contracting"],"description":"The phases of a storage layout change."},
    {"id":"mail-log-entry","name":"Mail Log Entry","kind":"struct","fields":[{"name":"message","type":"message-id"},{"name":"recipient","type":"email-address"},{"name":"state","type":"message-state"},{"name":"at","type":"timestamp"},{"name":"category","type":"message-category-id","optional":true},{"name":"template","type":"template-id","optional":true},{"name":"send","type":"send-id","optional":true},{"name":"reference","type":"send-reference","optional":true},{"name":"allowance-class","type":"allowance-class","optional":true}],"description":"One entry of the mail log. category, template, send, reference and allowance-class come from the request that made the message (EML-1565); the entry holds no body (EML-011)."},
    {"id":"mapping-report","name":"Mapping Report","kind":"struct","fields":[{"name":"mappings","type":"list<string>"},{"name":"unmapped","type":"list<string>"}],"description":"What an import mapped and could not map."},
    {"id":"migration-plan","name":"Migration Plan","kind":"struct","fields":[{"name":"schema","type":"tenant-schema"},{"name":"summary","type":"list<string>"},{"name":"rewritten","type":"list<record>"},{"name":"violations","type":"list<violation>"}],"description":"strata_kernel::Migration: what schema changes would do."},
    {"id":"model-usage","name":"Model Usage","kind":"struct","fields":[{"name":"input-tokens","type":"u64"},{"name":"output-tokens","type":"u64"}],"description":"What a model request used."},
    {"id":"notice","name":"Notice","kind":"struct","fields":[{"name":"tenant","type":"tenant-id"},{"name":"id","type":"string"},{"name":"kind","type":"string"},{"name":"seq","type":"u64","optional":true}],"description":"A tenant-scoped notice: a reference to an event, a wake notice or a revocation."},
    {"id":"operation-entry","name":"Operation Entry","kind":"struct","fields":[{"name":"name","type":"string"},{"name":"version","type":"string"},{"name":"deprecation","type":"string"},{"name":"requirements","type":"list<string>"},{"name":"permitted","type":"bool"},{"name":"description","type":"string"}],"description":"One entry of the operation catalogue."},
    {"id":"operation-result","name":"Operation Result","kind":"struct","fields":[{"name":"state","type":"string"},{"name":"output","type":"value-map"},{"name":"changes","type":"list<string>"},{"name":"inverse","type":"string","optional":true},{"name":"checks","type":"list<check>"},{"name":"handle","type":"string","optional":true}],"description":"The result of invoking an operation."},
    {"id":"outbox-entry","name":"Outbox Entry","kind":"struct","fields":[{"name":"position","type":"u64"},{"name":"event","type":"domain-event"}],"description":"strata_storage_api::OutboxEntry: an event waiting to be handed to subscribers. position is per tenant (the tenant of the event), increasing in that tenant's commit order; the outboxes of different tenants are not ordered against each other."},
    {"id":"platform-description","name":"Platform Description","kind":"struct","fields":[{"name":"components","type":"list<string>"},{"name":"health","type":"value-map"},{"name":"configuration","type":"value-map"}],"description":"The topology, configuration and health of the platform."},
    {"id":"projection","name":"Projection","kind":"struct","fields":[{"name":"proposal","type":"projection-proposal"},{"name":"baseline-hash","type":"hash"},{"name":"branch-hash","type":"hash"},{"name":"diverged","type":"bool"},{"name":"counterexample","type":"string","optional":true},{"name":"findings","type":"list<string>"},{"name":"unmodelled","type":"list<string>"}],"description":"strata_simulation::project::Projection."},
    {"id":"projection-proposal","name":"Projection Proposal","kind":"struct","fields":[{"name":"tenant","type":"tenant-id"},{"name":"principal","type":"principal"},{"name":"changes","type":"list<schema-change>"},{"name":"existing-data","type":"existing-data"},{"name":"before-step","type":"u64"}],"description":"strata_simulation::project::Proposal."},
    {"id":"projection-summary","name":"Projection Summary","kind":"struct","fields":[{"name":"diverged","type":"bool"},{"name":"summary","type":"list<string>"},{"name":"first-difference","type":"string","optional":true}],"description":"A projection as an operation reports it."},
    {"id":"public-key","name":"Public Key","kind":"struct","fields":[{"name":"kid","type":"string"},{"name":"kty","type":"string"},{"name":"crv","type":"string"},{"name":"alg","type":"string"},{"name":"use","type":"string"},{"name":"x","type":"string"},{"name":"y","type":"string"}],"description":"A published signing key as a member of a JSON Web Key Set (RFC 7517): the key id, the key type and curve, the algorithm, the use (sig) and the coordinates of the public point; relying parties read the set at the well-known address."},
    {"id":"realm-policy","name":"Realm Policy","kind":"struct","fields":[{"name":"second-factor-required","type":"bool"},{"name":"password-sign-in","type":"bool"},{"name":"bound-domains","type":"list<domain>"},{"name":"create-on-first-sign-in","type":"bool"},{"name":"default-role","type":"string","optional":true},{"name":"forbid-platform-access","type":"bool","optional":true},{"name":"settings","type":"realm-settings","optional":true}],"description":"The sign-in policy of a realm. settings holds the numbers and switches of the realm (D-6594)."},
    {"id":"receipt","name":"Receipt","kind":"struct","fields":[{"name":"revision","type":"state-revision"},{"name":"last-position","type":"u64","optional":true}],"description":"strata_storage_api::Receipt. last-position is the outbox position, in the tenant's own outbox, of the last event written."},
    {"id":"record-version","name":"Record Version","kind":"struct","fields":[{"name":"version","type":"u64"},{"name":"at","type":"timestamp"},{"name":"author","type":"principal-id"}],"description":"One published version of a record."},
    {"id":"requirement-status","name":"Requirement Status","kind":"struct","fields":[{"name":"ref","type":"string"},{"name":"status","type":"string"},{"name":"evidence","type":"string","optional":true}],"description":"The verification status of one requirement."},
    {"id":"run-trace","name":"Run Trace","kind":"struct","fields":[{"name":"run","type":"request-id"},{"name":"agent","type":"principal-id"},{"name":"on-behalf-of","type":"principal-id","optional":true},{"name":"inputs","type":"list<string>"},{"name":"operations","type":"list<string>"}],"description":"The trace of one agent run."},
    {"id":"scenario","name":"Scenario","kind":"struct","fields":[{"name":"name","type":"string"},{"name":"seed","type":"u64"},{"name":"initial","type":"value-map"},{"name":"schedule","type":"list<value-map>"},{"name":"faults","type":"value-map"}],"description":"strata_simulation::engine::Scenario."},
    {"id":"schema-version","name":"Schema Version","kind":"id","repr":"u64","description":"The version of a tenant schema."},
    {"id":"scim-user","name":"Scim User","kind":"struct","fields":[{"name":"external-id","type":"string"},{"name":"email","type":"email-address"},{"name":"display-name","type":"display-name"},{"name":"active","type":"bool"}],"description":"A person as the provisioning endpoint exchanges it."},
    {"id":"search-hit","name":"Search Hit","kind":"struct","fields":[{"name":"record","type":"record-id"},{"name":"object","type":"object-type-id"},{"name":"title","type":"string"},{"name":"status","type":"string","optional":true}],"description":"One hit of a search."},
    {"id":"selector","name":"Selector","kind":"struct","fields":[{"name":"objects","type":"list<object-type-id>","optional":true},{"name":"kinds","type":"list<event-kind>","optional":true},{"name":"segments","type":"list<segment-id>","optional":true},{"name":"units","type":"list<ledger-unit>","optional":true},{"name":"transitions","type":"list<string>","optional":true}],"description":"What a subscriber wants to hear about. Every member is optional and an absent member matches everything. Members combine as AND, and the values of one member as OR (SCH-1575). objects limits record events to those object types; kinds to those event kinds; segments to the entry and exit events of those segments; units to the ledger events of those units; transitions to record updates that fired one of those named workflow transitions."},
    {"id":"session-record","name":"Session Record","kind":"struct","fields":[{"name":"id","type":"session-id"},{"name":"token-hash","type":"hash"},{"name":"csrf-token","type":"secret"},{"name":"tenant","type":"tenant-id"},{"name":"principal","type":"principal-id"},{"name":"display-name","type":"string"},{"name":"created-at","type":"timestamp"},{"name":"last-seen-at","type":"timestamp"},{"name":"expires-at","type":"timestamp"},{"name":"revoked-at","type":"timestamp","optional":true}],"description":"strata_storage_api::SessionRecord: a server-side session; only the hash of its token is stored."},
    {"id":"session-summary","name":"Session Summary","kind":"struct","fields":[{"name":"id","type":"session-id"},{"name":"created-at","type":"timestamp"},{"name":"last-seen-at","type":"timestamp"},{"name":"expires-at","type":"timestamp"},{"name":"current","type":"bool"}],"description":"A session as its owner lists it."},
    {"id":"session-view","name":"Session View","kind":"struct","fields":[{"name":"authenticated","type":"bool"},{"name":"tenant","type":"tenant-id"},{"name":"tenant-name","type":"string"},{"name":"theme","type":"string","optional":true},{"name":"session-id","type":"session-id","optional":true},{"name":"principal","type":"principal-id","optional":true},{"name":"display-name","type":"display-name","optional":true},{"name":"roles","type":"list<string>"},{"name":"csrf-token","type":"secret","optional":true},{"name":"expires-at","type":"timestamp","optional":true},{"name":"may","type":"map<string, list<string>>"},{"name":"may-manage-schema","type":"bool"}],"description":"strata_protocol::api::SessionView: a session as the browser may see it. may holds the actions some policy could grant the principal, by object type: it decides what to offer, and the kernel decides each request for real."},
    {"id":"session-state","name":"session-state","kind":"enum","values":["anonymous","active","expired","revoked"]},
    {"id":"snapshot-info","name":"Snapshot Info","kind":"struct","fields":[{"name":"tenant","type":"tenant-id"},{"name":"id","type":"u64"},{"name":"label","type":"string"},{"name":"revision","type":"state-revision"},{"name":"hash","type":"hash"},{"name":"created-at","type":"timestamp"}],"description":"strata_storage_api::SnapshotInfo."},
    {"id":"spend-entry","name":"Spend Entry","kind":"struct","fields":[{"name":"agent","type":"principal-id","optional":true},{"name":"tenant","type":"tenant-id","optional":true},{"name":"amount","type":"f64"}],"description":"The spend of one agent or tenant."},
    {"id":"state-revision","name":"State Revision","kind":"id","repr":"u64","description":"The revision of a tenant state; each accepted transition advances it by one."},
    {"id":"storage-migration","name":"Storage Migration","kind":"struct","fields":[{"name":"version","type":"u32"},{"name":"name","type":"string"},{"name":"applied-at","type":"timestamp"}],"description":"strata_storage_api::StorageMigration: a step in the layout history of an adapter."},
    {"id":"store-error","name":"Store Error","kind":"struct","fields":[{"name":"kind","type":"store-error-kind"},{"name":"message","type":"string"},{"name":"expected","type":"state-revision","optional":true},{"name":"found","type":"state-revision","optional":true}],"description":"strata_storage_api::StoreError."},
    {"id":"store-error-kind","name":"Store Error Kind","kind":"enum","values":["conflict","not-found","invalid","unavailable","corrupt"],"description":"strata_storage_api::StoreError variants."},
    {"id":"store-handle","name":"Store Handle","kind":"scalar","repr":"string","description":"An opened store of one adapter, held by the process that opened it; it implements the store contract."},
    {"id":"tenant-bundle","name":"Tenant Bundle","kind":"struct","fields":[{"name":"name","type":"string"},{"name":"version","type":"string"},{"name":"product","type":"product-id","optional":true},{"name":"platform","type":"platform-compat","optional":true},{"name":"content","type":"bundle-sections"}],"description":"substrate::bundle::Bundle: a tenant or a template as one document. content is typed sections (D-6580); a product bundle names its product and the platform releases it supports. Fields. product: The product that owns what the bundle installs. A bundle of a platform template has none, and its entities belong to the tenant. platform: The platform releases the bundle supports; install refuses a platform outside them (D-6583)."},
    {"id":"tenant-directory-entry","name":"Tenant Directory Entry","kind":"struct","fields":[{"name":"tenant","type":"tenant-id"},{"name":"state","type":"tenant-lifecycle"},{"name":"suspension-reason","type":"tenant-suspension-reason","optional":true},{"name":"kind","type":"tenant-kind"},{"name":"plan","type":"plan-id"},{"name":"placement","type":"placement-id"},{"name":"region","type":"region-id"},{"name":"fetched-at","type":"timestamp"}],"description":"A directory entry as the gateway holds it."},
    {"id":"tenant-kind","name":"Tenant Kind","kind":"enum","values":["production","staging","sandbox","fork"],"description":"Whether a tenant is production, staging, sandbox or a fork of another tenant."},
    {"id":"tenant-summary","name":"Tenant Summary","kind":"struct","fields":[{"name":"id","type":"tenant-id"},{"name":"name","type":"string"},{"name":"revision","type":"state-revision"},{"name":"schema-version","type":"u64"},{"name":"event-seq","type":"u64"},{"name":"records","type":"u64"}],"description":"strata_storage_api::TenantSummary."},
    {"id":"trace","name":"Trace","kind":"struct","fields":[{"name":"kernel-version","type":"string"},{"name":"scenario","type":"string"},{"name":"seed","type":"u64"},{"name":"final-hash","type":"hash"},{"name":"steps","type":"u64"},{"name":"hash","type":"hash"}],"description":"strata_simulation::engine::Trace."},
    {"id":"usage-count","name":"Usage Count","kind":"struct","fields":[{"name":"quantity","type":"string"},{"name":"count","type":"u64"}],"description":"A metered quantity counted for a period."},
    {"id":"view-data","name":"View Data","kind":"struct","fields":[{"name":"view","type":"view-id"},{"name":"title","type":"string"},{"name":"params","type":"map<string, string>"},{"name":"sections","type":"map<string, section-data>"},{"name":"people","type":"map<string, person-entry>","optional":true},{"name":"depends-on","type":"set<object-type-id>"},{"name":"revision","type":"state-revision"},{"name":"schema-version","type":"schema-version"}],"description":"strata_substrate::project::ViewData: the raw result of a view, what the backend hands the BFF (backend ops.rs view, contract read-view CT-264): the view, its title, the route parameters, each section's data, the object types whose changes can alter it, and the revision and schema version it was read at."},
    {"id":"violation","name":"Violation","kind":"struct","fields":[{"name":"object","type":"object-type-id"},{"name":"id","type":"record-id"},{"name":"check","type":"check"},{"name":"kind","type":"error-kind"}],"description":"strata_kernel::Violation: an existing record that does not conform to a proposed schema."},
    {"id":"wake-entry","name":"Wake Entry","kind":"struct","fields":[{"name":"tenant","type":"tenant-id"},{"name":"due-at","type":"timestamp"}],"description":"A wake index entry: a tenant and its next due time, with no content of a job."},
    {"id":"webhook-delivery","name":"Webhook Delivery","kind":"struct","fields":[{"name":"id","type":"string"},{"name":"endpoint","type":"string"},{"name":"subscription","type":"string"},{"name":"status","type":"u16"},{"name":"attempts","type":"u32"},{"name":"at","type":"timestamp"},{"name":"state","type":"string"},{"name":"outcome","type":"string","optional":true}],"description":"One outbound webhook delivery (INT-152). endpoint is the target without query, user name or password (WFL-254); status is the status of the last answer, 0 before one or when the last attempt had none; state is queued, retrying, delivered or failed; outcome is why the last attempt did not deliver: status <n>, or address-refused, redirect-refused, too-large, timed-out or unreachable."},
    {
      "id": "session-token",
      "name": "session-token",
      "kind": "scalar",
      "repr": "string",
      "sensitive": "token",
      "description": "The secret a session cookie carries; only its hash is stored, and it is never logged."
    },
    {"id":"field-id","name":"field-id","kind":"id","repr":"string","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64},"description":"kernel FieldId: a field of an object type, [a-z][a-z0-9_]*, at most 64 bytes.","metamodel":"field-id"},
    {"id":"role-id","name":"role-id","kind":"id","repr":"string","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64},"description":"kernel RoleId: a role of a tenant, [a-z][a-z0-9_]*, at most 64 bytes."},
    {"id":"policy-id","name":"policy-id","kind":"id","repr":"string","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64},"description":"kernel PolicyId: a policy of a tenant, [a-z][a-z0-9_]*, at most 64 bytes."},
    {"id":"constraint-id","name":"constraint-id","kind":"id","repr":"string","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64},"description":"kernel ConstraintId: a constraint of an object type, [a-z][a-z0-9_]*, at most 64 bytes."},
    {"id":"query-id","name":"query-id","kind":"id","repr":"string","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64},"description":"kernel QueryId: a named query of a tenant, [a-z][a-z0-9_]*, at most 64 bytes."},
    {"id":"view-id","name":"view-id","kind":"id","repr":"string","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64},"description":"kernel ViewId: a view of a tenant, [a-z][a-z0-9_]*, at most 64 bytes."},
    {"id":"on-delete","name":"On Delete","kind":"union","variants":[{"name":"restrict"},{"name":"set-null"}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"strata_kernel::OnDelete."},
    {"id":"value","name":"Value","kind":"union","variants":[{"name":"null"},{"name":"bool","newtype":true,"fields":[{"name":"value","type":"bool"}]},{"name":"int","newtype":true,"fields":[{"name":"value","type":"i64"}]},{"name":"str","newtype":true,"fields":[{"name":"value","type":"string"}]},{"name":"time","newtype":true,"fields":[{"name":"value","type":"i64"}]},{"name":"ref","newtype":true,"fields":[{"name":"value","type":"record-id"}]},{"name":"list","newtype":true,"fields":[{"name":"value","type":"list<value>"}]}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"strata_kernel::Value: the typed value algebra."},
    {"id":"field-type","name":"Field Type","kind":"union","variants":[{"name":"str"},{"name":"int"},{"name":"bool"},{"name":"time"},{"name":"ref","fields":[{"name":"target","type":"object-type-id"},{"name":"on-delete","type":"on-delete"}]},{"name":"list","newtype":true,"fields":[{"name":"value","type":"field-type"}]},{"name":"file","fields":[{"name":"media-types","type":"list<string>"},{"name":"max-bytes","type":"u64"},{"name":"renditions","type":"list<rendition-def>"}]},{"name":"language"}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"strata_kernel::FieldType. file holds the content hash of a stored file and declares the media types it accepts, its size cap and its renditions (D-6587, D-6589). language holds a language-tag (D-6593)."},
    {"id":"scope","name":"Scope","kind":"union","variants":[{"name":"record"},{"name":"old"},{"name":"new"}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"strata_kernel::Scope."},
    {"id":"cmp-op","name":"Cmp Op","kind":"union","variants":[{"name":"eq"},{"name":"ne"},{"name":"lt"},{"name":"le"},{"name":"gt"},{"name":"ge"}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"strata_kernel::CmpOp."},
    {"id":"expr","name":"Expr","kind":"union","variants":[{"name":"lit","newtype":true,"fields":[{"name":"value","type":"value"}]},{"name":"var","tuple":true,"fields":[{"name":"scope","type":"scope"},{"name":"field","type":"string"}]},{"name":"through","tuple":true,"fields":[{"name":"scope","type":"scope"},{"name":"reference","type":"string"},{"name":"field","type":"string"}]},{"name":"param","newtype":true,"fields":[{"name":"value","type":"string"}]},{"name":"now"},{"name":"principal"},{"name":"has-role","newtype":true,"fields":[{"name":"value","type":"role-id"}]},{"name":"not","newtype":true,"fields":[{"name":"value","type":"expr"}]},{"name":"and","newtype":true,"fields":[{"name":"value","type":"list<expr>"}]},{"name":"or","newtype":true,"fields":[{"name":"value","type":"list<expr>"}]},{"name":"cmp","tuple":true,"fields":[{"name":"op","type":"cmp-op"},{"name":"left","type":"expr"},{"name":"right","type":"expr"}]},{"name":"in","tuple":true,"fields":[{"name":"item","type":"expr"},{"name":"list","type":"expr"}]},{"name":"is-null","newtype":true,"fields":[{"name":"value","type":"expr"}]},{"name":"len","newtype":true,"fields":[{"name":"value","type":"expr"}]},{"name":"lower","newtype":true,"fields":[{"name":"value","type":"expr"}]},{"name":"contains","tuple":true,"fields":[{"name":"haystack","type":"expr"},{"name":"needle","type":"expr"}]},{"name":"starts-with","tuple":true,"fields":[{"name":"text","type":"expr"},{"name":"prefix","type":"expr"}]},{"name":"is-slug","newtype":true,"fields":[{"name":"value","type":"expr"}]},{"name":"if","tuple":true,"fields":[{"name":"condition","type":"expr"},{"name":"then","type":"expr"},{"name":"else","type":"expr"}]},{"name":"arith","tuple":true,"fields":[{"name":"op","type":"arith-op"},{"name":"left","type":"expr"},{"name":"right","type":"expr"}]},{"name":"ms-between","tuple":true,"fields":[{"name":"from","type":"expr"},{"name":"to","type":"expr"}]},{"name":"duration","tuple":true,"fields":[{"name":"unit","type":"duration-unit"},{"name":"amount","type":"expr"}]},{"name":"concat","tuple":true,"fields":[{"name":"left","type":"expr"},{"name":"right","type":"expr"}]},{"name":"text","newtype":true,"fields":[{"name":"value","type":"expr"}]}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"strata_kernel::Expr: the tenant expression language. Var(Scope, String), Through(Scope, String, String), Cmp(CmpOp, Box<Expr>, Box<Expr>), In, Contains, StartsWith (Box<Expr>, Box<Expr>), If(Box<Expr>, Box<Expr>, Box<Expr>), Arith(ArithOp, Box<Expr>, Box<Expr>), MsBetween and Concat (Box<Expr>, Box<Expr>) and Duration(DurationUnit, Box<Expr>) are tuple variants, written as serde writes them: {\"Cmp\": [\"Eq\", a, b]}."},
    {"id":"field-def","name":"Field Def","kind":"struct","fields":[{"name":"id","type":"field-id"},{"name":"label","type":"string"},{"name":"ty","type":"field-type"},{"name":"required","type":"bool"},{"name":"unique","type":"bool"},{"name":"default","type":"option<expr>"},{"name":"read","type":"expr","optional":true},{"name":"personal","type":"personal-declaration","optional":true}],"description":"strata_kernel::FieldDef. read is a per-field read rule (D-6586); personal declares personal data (D-6584). Fields. read: When present, a principal may read the field only when the expression is true for that principal and the record. Absent: whoever may read the record may read the field. The kernel evaluates it on every read path (D-6586, KRN-1589). personal: The personal data of the field (D-6584). Present, the field is sealed under the key of its subject.","metamodel":"definition"},
    {"id":"constraint-def","name":"Constraint Def","kind":"struct","fields":[{"name":"id","type":"constraint-id"},{"name":"expr","type":"expr"},{"name":"message","type":"string"}],"description":"strata_kernel::ConstraintDef.","metamodel":"definition"},
    {"id":"object-type-def","name":"Object Type Def","kind":"struct","fields":[{"name":"id","type":"object-type-id"},{"name":"label","type":"string"},{"name":"fields","type":"map<field-id, field-def>"},{"name":"constraints","type":"map<constraint-id, constraint-def>"},{"name":"retention","type":"retention-rule","optional":true},{"name":"publication","type":"publication-def","optional":true},{"name":"language-field","type":"field-id","optional":true},{"name":"translation-group","type":"field-id","optional":true},{"name":"unique","type":"map<constraint-id, unique-def>","optional":true},{"name":"searchable","type":"list<field-id>","optional":true}],"description":"strata_kernel::ObjectTypeDef. A schema without retention, publication, language declarations or unique constraints reads and hashes as before. Fields. retention: Required when the type has a field with a personal declaration; otherwise the type takes the default rule of the tenant policy (PRV-356, D-6584). publication: The publication state and time of a content type (D-6592). language-field: The language field that holds the language of each record (D-6593). translation-group: Records of the type with the same value in this field are translations of one another (D-6593). unique: The composite unique constraints of the type (D-6558), changed by define-unique and remove-unique; left out while empty. searchable: The text fields of the type that the search index holds (D-7780); changed by set-searchable and clear-searchable, absent while none is declared, so a schema that declares none hashes as before.","metamodel":"definition"},
    {"id":"role-def","name":"Role Def","kind":"struct","fields":[{"name":"id","type":"role-id"},{"name":"label","type":"string"}],"description":"strata_kernel::RoleDef."},
    {"id":"action","name":"Action","kind":"union","variants":[{"name":"read"},{"name":"create"},{"name":"update"},{"name":"delete"},{"name":"manage"}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"strata_kernel::Action."},
    {"id":"resource","name":"Resource","kind":"union","variants":[{"name":"object","newtype":true,"fields":[{"name":"value","type":"object-type-id"}]},{"name":"any-object"},{"name":"schema"},{"name":"members"},{"name":"ledger","fields":[{"name":"unit","type":"ledger-unit","optional":true}]}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"strata_kernel::Resource. ledger is the ledger, or the ledger of one unit when unit is given: a policy over it permits read of accounts and entries, and its condition reads owner, pool, unit and scope of the account and amount, reason, caused_by and at of an entry (D-6550, LDG-1540)."},
    {"id":"policy-def","name":"Policy Def","kind":"struct","fields":[{"name":"id","type":"policy-id"},{"name":"role","type":"role-id"},{"name":"resource","type":"resource"},{"name":"actions","type":"set<action>"},{"name":"condition","type":"option<expr>"}],"description":"strata_kernel::PolicyDef: actions is a BTreeSet<Action>."},
    {"id":"workflow-transition","name":"Workflow Transition","kind":"struct","fields":[{"name":"name","type":"string"},{"name":"from","type":"string"},{"name":"to","type":"string"},{"name":"guard","type":"option<expr>"},{"name":"set","type":"map<field-id, expr>"}],"description":"strata_kernel::WorkflowTransition."},
    {"id":"workflow-def","name":"Workflow Def","kind":"struct","fields":[{"name":"id","type":"workflow-id"},{"name":"object","type":"object-type-id"},{"name":"field","type":"field-id"},{"name":"initial","type":"set<string>"},{"name":"transitions","type":"list<workflow-transition>"}],"description":"strata_kernel::WorkflowDef: initial is a BTreeSet<String>."},
    {"id":"order-key","name":"Order Key","kind":"struct","fields":[{"name":"field","type":"string"},{"name":"descending","type":"bool"}],"description":"strata_kernel::OrderKey."},
    {"id":"query-def","name":"Query Def","kind":"struct","fields":[{"name":"id","type":"query-id"},{"name":"object","type":"object-type-id"},{"name":"filter","type":"option<expr>"},{"name":"params","type":"set<string>"},{"name":"order","type":"list<order-key>"},{"name":"limit","type":"option<u32>"},{"name":"aggregates","type":"list<aggregate-def>","optional":true},{"name":"declared-fields","type":"list<field-id>","optional":true}],"description":"strata_kernel::QueryDef: params is a BTreeSet<String>. aggregates are the aggregates the query declares (AGG-001) and declared-fields the fields that a request filter or an aggregate may name (D-5060, CMS-165); both are absent in a query stored before aggregates and read as none."},
    {"id":"arg-source","name":"Arg Source","kind":"union","variants":[{"name":"route","newtype":true,"fields":[{"name":"value","type":"string"}]},{"name":"request","newtype":true,"fields":[{"name":"value","type":"string"}]},{"name":"const","newtype":true,"fields":[{"name":"value","type":"value"}]},{"name":"section","fields":[{"name":"section","type":"string"},{"name":"attribute","type":"string"}]},{"name":"setting","newtype":true,"fields":[{"name":"value","type":"setting-id"}]}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"strata_kernel::ArgSource. setting: the argument is the value of the setting resolved for the reader (SET-1540, D-6557); null when the tenant does not define it. The view that holds one depends on the revisions of the setting and on the class of the reader (SET-050, SET-053)."},
    {"id":"view-section","name":"View Section","kind":"struct","fields":[{"name":"query","type":"query-id"},{"name":"args","type":"map<string, arg-source>"},{"name":"include","type":"list<field-id>"},{"name":"markdown","type":"list<field-id>"},{"name":"single","type":"bool"},{"name":"aggregate","type":"aggregate-id","optional":true}],"description":"strata_kernel::ViewSection. aggregate names an aggregate of the query: the section then delivers its result for the reader in place of rows (D-5067, AGG-041)."},
    {"id":"view-def","name":"View Def","kind":"struct","fields":[{"name":"id","type":"view-id"},{"name":"route","type":"string"},{"name":"title","type":"string"},{"name":"sections","type":"map<string, view-section>"}],"description":"strata_kernel::ViewDef."},
    {"id":"tenant-schema","name":"Tenant Schema","kind":"struct","fields":[{"name":"version","type":"schema-version"},{"name":"objects","type":"map<object-type-id, object-type-def>"},{"name":"roles","type":"map<role-id, role-def>"},{"name":"role-permissions","type":"map<role-id, list<permission>>","optional":true},{"name":"teams","type":"map<team-id, team-def>","optional":true},{"name":"invitations","type":"map<invitation-id, invitation-def>","optional":true},{"name":"policies","type":"map<policy-id, policy-def>"},{"name":"workflows","type":"map<workflow-id, workflow-def>"},{"name":"queries","type":"map<query-id, query-def>"},{"name":"views","type":"map<view-id, view-def>"},{"name":"triggers","type":"map<trigger-id, trigger-def>","optional":true},{"name":"automations","type":"map<workflow-id, automation-def>","optional":true},{"name":"operations","type":"map<tenant-operation-id, tenant-operation-def>","optional":true},{"name":"settings","type":"map<setting-id, setting-def>","optional":true},{"name":"capabilities","type":"map<capability-name, capability-def>","optional":true},{"name":"ledger","type":"ledger-declarations","optional":true},{"name":"mail-templates","type":"map<template-id, mail-template-decl>","optional":true},{"name":"notice-templates","type":"map<template-id, notice-template-decl>","optional":true},{"name":"tokens","type":"map<string, token-decl>","optional":true},{"name":"products","type":"map<product-id, installed-product>","optional":true},{"name":"ui","type":"map<string, ui-element>","optional":true}],"description":"strata_kernel::TenantSchema. ui holds the interface elements of the tenant by id (D-8250), changed by the schema changes define-ui-element and remove-ui-element; it is left out while empty. role-permissions, teams, invitations, triggers, automations and operations are left out while empty, so a schema without them reads and hashes as before, and a stored schema written before they existed decodes with none; a role without an entry in role-permissions grants none. Teams and invitations change through their own intents, not through ChangeSchema, and do not raise the schema version. Triggers, automations (D-6537) and tenant operations (D-6546) change through the schema changes define-trigger, remove-trigger, define-automation, remove-automation, define-operation and remove-operation, which raise the schema version; an automation id and a field workflow id never coincide (D-6521). ledger holds the units, pools and limits of the tenant ledger (ledger-declarations, D-5001, D-5005); it is left out while nothing is declared.","metamodel":"tenant-schema"},
    {"id":"principal","name":"Principal","kind":"union","variants":[{"name":"system"},{"name":"anonymous"},{"name":"user","newtype":true,"fields":[{"name":"value","type":"principal-id"}]}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"strata_kernel::Principal."},
    {"id":"record","name":"Record","kind":"struct","fields":[{"name":"id","type":"record-id"},{"name":"object","type":"object-type-id"},{"name":"version","type":"u64"},{"name":"created-by","type":"option<principal-id>"},{"name":"created-at","type":"timestamp"},{"name":"updated-at","type":"timestamp"},{"name":"fields","type":"map<field-id, value>"}],"description":"strata_kernel::Record: one record of an object type."},
    {"id":"tenant-state","name":"Tenant State","kind":"struct","fields":[{"name":"id","type":"tenant-id"},{"name":"name","type":"string"},{"name":"revision","type":"state-revision"},{"name":"next-record","type":"u64"},{"name":"event-seq","type":"u64"},{"name":"schema","type":"shared<tenant-schema>"},{"name":"members","type":"map<principal-id, set<role-id>>"},{"name":"records","type":"map<object-type-id, map<record-id, shared<record>>>"},{"name":"setting-values","type":"shared<setting-values>","optional":true},{"name":"ledger","type":"ledger-state","optional":true}],"description":"strata_kernel::TenantState: members is BTreeMap<PrincipalId, BTreeSet<RoleId>>; the schema and every record are shared<T> (Arc<T>), so a new state shares what it did not change with the one before it. ledger is the part of the tenant ledger the snapshot holds (ledger-state); it is left out while the tenant has no account, so a state without one reads and hashes as before."},
    {"id":"need","name":"Need","kind":"union","variants":[{"name":"record","fields":[{"name":"object","type":"object-type-id"},{"name":"id","type":"record-id"}]},{"name":"by-field","fields":[{"name":"object","type":"object-type-id"},{"name":"field","type":"field-id"},{"name":"value","type":"value"}]},{"name":"all-of","newtype":true,"fields":[{"name":"value","type":"object-type-id"}]},{"name":"page-of","fields":[{"name":"object","type":"object-type-id"},{"name":"after","type":"record-id","optional":true},{"name":"limit","type":"u32"}]},{"name":"by-fields","fields":[{"name":"object","type":"object-type-id"},{"name":"fields","type":"map<field-id, value>"}]},{"name":"ledger","newtype":true,"fields":[{"name":"value","type":"ledger-need"}]},{"name":"index-page","fields":[{"name":"object","type":"object-type-id"},{"name":"field","type":"field-id"},{"name":"lower","type":"index-bound"},{"name":"upper","type":"index-bound"},{"name":"descending","type":"bool"},{"name":"after","type":"index-position","optional":true},{"name":"limit","type":"u32"}]},{"name":"pair-page","fields":[{"name":"object","type":"object-type-id"},{"name":"field","type":"field-id"},{"name":"value","type":"value"},{"name":"order","type":"string"},{"name":"descending","type":"bool"},{"name":"after","type":"index-position","optional":true},{"name":"limit","type":"u32"}]}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"strata_kernel::Need: a piece of state a decision or read needs. page-of is at most limit records of an object type with a record id above after, in id order (KRN-1286). by-fields is the records of an object type whose every named field holds its value: the one lookup of a composite unique constraint (D-6558, CMS-1557). index-page is at most limit records of an object type whose value of field is a single value (not null, not a list) between lower and upper, in the order of that value (reversed when descending) and then the record id ascending, after the position after: the candidates of a planned named query (KRN-2520, KRN-2525). pair-page is at most limit records of an object type whose value of field is the single value value, in the order of their value of the attribute order (a field, $created_at or $updated_at; a missing value is null, the least), reversed when descending, and then the record id ascending, after the position after: the candidates of a pair plan (KRN-2920, KRN-2921)."},
    {"id":"coverage","name":"Coverage","kind":"union","variants":[{"name":"complete"},{"name":"partial","newtype":true,"fields":[{"name":"value","type":"set<need>"}]}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"strata_kernel::Coverage: partial holds a BTreeSet<Need>."},
    {"id":"state","name":"State","kind":"struct","fields":[{"name":"tenant-id","type":"tenant-id"},{"name":"tenant","type":"option<shared<tenant-state>>"},{"name":"coverage","type":"coverage"}],"description":"strata_kernel::State: the snapshot a transition or read runs against."},
    {"id":"context","name":"Context","kind":"struct","fields":[{"name":"tenant","type":"tenant-id"},{"name":"principal","type":"principal"},{"name":"session","type":"option<session-id>"},{"name":"now","type":"timestamp"},{"name":"correlation","type":"string"},{"name":"verified-address","type":"string","optional":true},{"name":"idempotency-key","type":"string","optional":true},{"name":"language","type":"language-tag","optional":true},{"name":"hop","type":"u32","optional":true}],"description":"strata_kernel::Context: the explicit environment of a transition. verified-address is the address the shell has verified for the acting person (the signed-in account's verified address), filled by the shell and never by an intent or its caller; only the redemption of an invitation reads it (ADM-153). language is the language of the reader (D-6593). Fields. language: The language of the reader for this request, chosen by the gateway and never by an intent: the language the request names, else the setting of the person, else the Accept-Language header, else the default of the tenant (D-6593). hop is the hop count of the change (D-7202): absent or zero for a change of a person or a schedule, the hop of the run plus one for a change an automated step commits; the automation worker sets it, never an intent or its caller. Every event of the transition carries it, and a trigger declines a run past the hop limit (SCH-300)."},
    {"id":"existing-data","name":"Existing Data","kind":"union","variants":[{"name":"reject"},{"name":"grandfather"}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"strata_kernel::ExistingData: how a schema change treats records that do not conform."},
    {"id":"schema-change","name":"Schema Change","kind":"union","variants":[{"name":"define-object","fields":[{"name":"id","type":"object-type-id"},{"name":"label","type":"string"}]},{"name":"define-field","fields":[{"name":"object","type":"object-type-id"},{"name":"field","type":"field-def"}]},{"name":"define-relationship","fields":[{"name":"object","type":"object-type-id"},{"name":"field","type":"field-id"},{"name":"label","type":"string"},{"name":"target","type":"object-type-id"},{"name":"on-delete","type":"on-delete"},{"name":"required","type":"bool"}]},{"name":"remove-field","fields":[{"name":"object","type":"object-type-id"},{"name":"field","type":"field-id"}]},{"name":"define-constraint","fields":[{"name":"object","type":"object-type-id"},{"name":"constraint","type":"constraint-def"}]},{"name":"remove-constraint","fields":[{"name":"object","type":"object-type-id"},{"name":"constraint","type":"constraint-id"}]},{"name":"define-role","newtype":true,"fields":[{"name":"value","type":"role-def"}]},{"name":"define-role-permissions","fields":[{"name":"role","type":"role-id"},{"name":"permissions","type":"list<permission>"}]},{"name":"define-policy","newtype":true,"fields":[{"name":"value","type":"policy-def"}]},{"name":"remove-policy","newtype":true,"fields":[{"name":"value","type":"policy-id"}]},{"name":"define-workflow","newtype":true,"fields":[{"name":"value","type":"workflow-def"}]},{"name":"remove-workflow","newtype":true,"fields":[{"name":"value","type":"workflow-id"}]},{"name":"define-query","newtype":true,"fields":[{"name":"value","type":"query-def"}]},{"name":"remove-query","newtype":true,"fields":[{"name":"value","type":"query-id"}]},{"name":"define-view","newtype":true,"fields":[{"name":"value","type":"view-def"}]},{"name":"remove-view","newtype":true,"fields":[{"name":"value","type":"view-id"}]},{"name":"define-trigger","newtype":true,"fields":[{"name":"value","type":"trigger-def"}]},{"name":"remove-trigger","newtype":true,"fields":[{"name":"value","type":"trigger-id"}]},{"name":"define-automation","newtype":true,"fields":[{"name":"value","type":"automation-def"}]},{"name":"remove-automation","newtype":true,"fields":[{"name":"value","type":"workflow-id"}]},{"name":"define-operation","newtype":true,"fields":[{"name":"value","type":"tenant-operation-def"}]},{"name":"remove-operation","newtype":true,"fields":[{"name":"value","type":"tenant-operation-id"}]},{"name":"define-unique","fields":[{"name":"object","type":"object-type-id"},{"name":"unique","type":"unique-def"}]},{"name":"remove-unique","fields":[{"name":"object","type":"object-type-id"},{"name":"unique","type":"constraint-id"}]},{"name":"define-setting","newtype":true,"fields":[{"name":"value","type":"setting-def"}]},{"name":"remove-setting","newtype":true,"fields":[{"name":"value","type":"setting-id"}]},{"name":"define-capability","newtype":true,"fields":[{"name":"value","type":"capability-def"}]},{"name":"remove-capability","newtype":true,"fields":[{"name":"value","type":"capability-name"}]},{"name":"declare-ledger-unit","newtype":true,"fields":[{"name":"value","type":"ledger-unit-decl"}]},{"name":"declare-ledger-pool","newtype":true,"fields":[{"name":"value","type":"ledger-pool-decl"}]},{"name":"set-ledger-limit","newtype":true,"fields":[{"name":"value","type":"ledger-limit"}]},{"name":"remove-ledger-definition","newtype":true,"fields":[{"name":"value","type":"ledger-definition-ref"}]},{"name":"set-retention","fields":[{"name":"object","type":"object-type-id"},{"name":"retention","type":"retention-rule"}]},{"name":"clear-retention","fields":[{"name":"object","type":"object-type-id"}]},{"name":"set-publication","fields":[{"name":"object","type":"object-type-id"},{"name":"publication","type":"publication-def"}]},{"name":"clear-publication","fields":[{"name":"object","type":"object-type-id"}]},{"name":"set-language-field","fields":[{"name":"object","type":"object-type-id"},{"name":"field","type":"field-id"}]},{"name":"clear-language-field","fields":[{"name":"object","type":"object-type-id"}]},{"name":"set-translation-group","fields":[{"name":"object","type":"object-type-id"},{"name":"field","type":"field-id"}]},{"name":"clear-translation-group","fields":[{"name":"object","type":"object-type-id"}]},{"name":"remove-object","fields":[{"name":"id","type":"object-type-id"},{"name":"delete-records","type":"bool"}]},{"name":"remove-role","newtype":true,"fields":[{"name":"value","type":"role-id"}]},{"name":"define-mail-template","newtype":true,"fields":[{"name":"value","type":"mail-template-decl"}]},{"name":"remove-mail-template","newtype":true,"fields":[{"name":"value","type":"template-id"}]},{"name":"define-notice-template","newtype":true,"fields":[{"name":"value","type":"notice-template-decl"}]},{"name":"remove-notice-template","newtype":true,"fields":[{"name":"value","type":"template-id"}]},{"name":"define-token","newtype":true,"fields":[{"name":"value","type":"token-decl"}]},{"name":"remove-token","newtype":true,"fields":[{"name":"value","type":"string"}]},{"name":"record-product","newtype":true,"fields":[{"name":"value","type":"installed-product"}]},{"name":"remove-product","newtype":true,"fields":[{"name":"value","type":"product-id"}]},{"name":"set-searchable","fields":[{"name":"object","type":"object-type-id"},{"name":"fields","type":"list<field-id>"}]},{"name":"clear-searchable","fields":[{"name":"object","type":"object-type-id"}]},{"name":"rename-field","fields":[{"name":"object","type":"object-type-id"},{"name":"from","type":"field-id"},{"name":"to","type":"field-id"}]},{"name":"move-field","fields":[{"name":"object","type":"object-type-id"},{"name":"field","type":"field-id"},{"name":"via","type":"field-id"},{"name":"to-field","type":"field-id"}]},{"name":"retype-field","fields":[{"name":"object","type":"object-type-id"},{"name":"field","type":"field-id"},{"name":"ty","type":"field-type"},{"name":"encode","type":"expr"},{"name":"decode","type":"expr"},{"name":"deprecation-ends","type":"timestamp","optional":true}]},{"name":"define-ui-element","fields":[{"name":"id","type":"string"},{"name":"element","type":"ui-element"}]},{"name":"remove-ui-element","newtype":true,"fields":[{"name":"value","type":"string"}]}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"strata_kernel::SchemaChange: one edit of a tenant schema. rename-field, move-field and retype-field are decided by the kernel alone (D-8212..D-8217): a rename and a move are adaptable and rewrite every dependent that reads the field (MIG-560, MIG-608), a retype is breaking and is accepted only where every dependent it reaches is pinned and decode undoes encode on the data (MIG-596, MIG-597). define-ui-element is define-or-replace of an interface element in tenant-schema.ui, and removing one that does not exist is refused (D-8250). define-trigger, define-automation and define-operation are define-or-replace; removing one that does not exist is refused, and an automation is not removed while a trigger names it (D-6539). define-unique and remove-unique add and remove a composite unique constraint of an object type (D-6558). declare-ledger-unit, declare-ledger-pool and set-ledger-limit are define-or-replace in tenant-schema.ledger and need the capability ledger-configure; remove-ledger-definition removes a unit or a pool that no account names, or a limit (LDG-1549, D-6554)."},
    {"id":"intent","name":"Intent","kind":"union","variants":[{"name":"create-tenant","fields":[{"name":"name","type":"string"},{"name":"owner","type":"principal-id"}]},{"name":"change-schema","fields":[{"name":"changes","type":"list<schema-change>"},{"name":"expected-version","type":"option<schema-version>"},{"name":"existing","type":"existing-data"}]},{"name":"assign-role","fields":[{"name":"principal","type":"principal-id"},{"name":"role","type":"role-id"}]},{"name":"revoke-role","fields":[{"name":"principal","type":"principal-id"},{"name":"role","type":"role-id"}]},{"name":"define-team","fields":[{"name":"team","type":"team-id"},{"name":"label","type":"string"}]},{"name":"assign-team-role","fields":[{"name":"team","type":"team-id"},{"name":"role","type":"role-id"}]},{"name":"revoke-team-role","fields":[{"name":"team","type":"team-id"},{"name":"role","type":"role-id"}]},{"name":"add-team-member","fields":[{"name":"team","type":"team-id"},{"name":"principal","type":"principal-id"}]},{"name":"remove-team-member","fields":[{"name":"team","type":"team-id"},{"name":"principal","type":"principal-id"}]},{"name":"create-invitation","fields":[{"name":"invitation","type":"invitation-id"},{"name":"address","type":"string"},{"name":"roles","type":"set<role-id>"}]},{"name":"redeem-invitation","fields":[{"name":"invitation","type":"invitation-id"}]},{"name":"revoke-invitation","fields":[{"name":"invitation","type":"invitation-id"}]},{"name":"create-record","fields":[{"name":"object","type":"object-type-id"},{"name":"fields","type":"map<field-id, value>"}]},{"name":"update-record","fields":[{"name":"object","type":"object-type-id"},{"name":"id","type":"record-id"},{"name":"fields","type":"map<field-id, value>"},{"name":"expected-version","type":"option<u64>"}]},{"name":"delete-record","fields":[{"name":"object","type":"object-type-id"},{"name":"id","type":"record-id"},{"name":"expected-version","type":"option<u64>"}]},{"name":"erase-subject","fields":[{"name":"subject","type":"principal-id"},{"name":"resume-object","type":"option<object-type-id>"},{"name":"resume-after","type":"option<record-id>"},{"name":"held-objects","type":"list<object-type-id>"},{"name":"addressed-invitations","type":"list<invitation-id>"}]},{"name":"write-setting","fields":[{"name":"setting","type":"setting-id"},{"name":"level","type":"setting-level"},{"name":"team","type":"option<team-id>"},{"name":"value","type":"option<value>"},{"name":"expected-revision","type":"u64"}]},{"name":"invoke-operation","fields":[{"name":"operation","type":"tenant-operation-id"},{"name":"inputs","type":"map<string, value>"},{"name":"idempotency-key","type":"string"}]},{"name":"post-ledger","fields":[{"name":"postings","type":"list<ledger-posting-request>"}]},{"name":"expire-ledger","fields":[{"name":"unit","type":"ledger-unit"},{"name":"cutoff","type":"timestamp"}]},{"name":"expire-records","fields":[{"name":"object","type":"object-type-id"},{"name":"ids","type":"list<record-id>"}]}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"strata_kernel::Intent: one request to change a tenant. write-setting sets (with a value) or removes (without one) the override of a setting at the tenant, a team or the person of the caller, against the revision the caller read it at (D-5044, D-5045). expire-ledger expires the credits of the buckets of a unit that started at or before cutoff, for at most one hundred accounts (D-6553, contract expire-ledger-credits); the system or a holder of ledger-configure decides it, and its answer lists the postings it made."},
    {"id":"check","name":"Check","kind":"struct","fields":[{"name":"rule","type":"string"},{"name":"passed","type":"bool"},{"name":"detail","type":"string"}],"description":"strata_kernel::Check: one evaluated rule."},
    {"id":"error-kind","name":"Error Kind","kind":"union","variants":[{"name":"tenant-mismatch"},{"name":"tenant-exists"},{"name":"tenant-not-found"},{"name":"unauthorized"},{"name":"unknown-object"},{"name":"unknown-field"},{"name":"unknown-record"},{"name":"unknown-role"},{"name":"unknown-query"},{"name":"type-mismatch"},{"name":"missing-required"},{"name":"constraint-violated"},{"name":"unique-violated"},{"name":"dangling-reference"},{"name":"still-referenced"},{"name":"workflow-violation"},{"name":"version-conflict"},{"name":"schema-conflict"},{"name":"invalid-schema"},{"name":"migration-rejected"},{"name":"insufficient-state"},{"name":"evaluation"},{"name":"invalid-intent"},{"name":"limit-exceeded"},{"name":"idempotency-mismatch"}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"strata_kernel::ErrorKind."},
    {"id":"domain-error","name":"Domain Error","kind":"struct","fields":[{"name":"kind","type":"error-kind"},{"name":"message","type":"string"},{"name":"evidence","type":"list<check>"},{"name":"missing","type":"option<need>"}],"description":"strata_kernel::DomainError: a rejection with the checks that led to it."},
    {"id":"delta-op","name":"Delta Op","kind":"union","variants":[{"name":"create-tenant","fields":[{"name":"name","type":"string"}]},{"name":"put-schema","newtype":true,"fields":[{"name":"value","type":"shared<tenant-schema>"}]},{"name":"put-member","fields":[{"name":"principal","type":"principal-id"},{"name":"roles","type":"set<role-id>"}]},{"name":"put-record","newtype":true,"fields":[{"name":"value","type":"shared<record>"}]},{"name":"delete-record","fields":[{"name":"object","type":"object-type-id"},{"name":"id","type":"record-id"}]},{"name":"put-setting-override","newtype":true,"fields":[{"name":"value","type":"setting-override"}]},{"name":"delete-setting-override","fields":[{"name":"setting","type":"setting-id"},{"name":"level","type":"setting-level"},{"name":"subject","type":"string"}]},{"name":"put-setting-revision","fields":[{"name":"setting","type":"setting-id"},{"name":"revision","type":"u64"}]},{"name":"ledger","newtype":true,"fields":[{"name":"value","type":"ledger-delta"}]}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"strata_kernel::DeltaOp: one change to a tenant state; roles is a BTreeSet<RoleId>. ledger is a change to the tenant ledger (ledger-delta)."},
    {"id":"state-delta","name":"State Delta","kind":"struct","fields":[{"name":"tenant","type":"tenant-id"},{"name":"base-revision","type":"option<state-revision>"},{"name":"new-revision","type":"state-revision"},{"name":"next-record","type":"u64"},{"name":"event-seq","type":"u64"},{"name":"ops","type":"list<delta-op>"}],"description":"strata_kernel::StateDelta: the logical change of one accepted transition."},
    {"id":"event-body","name":"Event Body","kind":"union","variants":[{"name":"tenant-created","fields":[{"name":"name","type":"string"}]},{"name":"schema-changed","fields":[{"name":"version","type":"schema-version"},{"name":"summary","type":"list<string>"},{"name":"grandfathered","type":"u64"}]},{"name":"member-changed","fields":[{"name":"principal","type":"principal-id"},{"name":"roles","type":"set<role-id>"}]},{"name":"record-created","fields":[{"name":"record","type":"shared<record>"}]},{"name":"record-updated","fields":[{"name":"before","type":"shared<record>"},{"name":"after","type":"shared<record>"},{"name":"transitions","type":"map<workflow-id, string>","optional":true}]},{"name":"record-deleted","fields":[{"name":"before","type":"shared<record>"}]},{"name":"automation-suspended","fields":[{"name":"automation","type":"workflow-id"},{"name":"definer","type":"principal-id"},{"name":"role","type":"role-id"}]},{"name":"setting-changed","fields":[{"name":"setting","type":"setting-id"},{"name":"level","type":"setting-level"},{"name":"subject","type":"string"}]},{"name":"ledger-entry-posted","fields":[{"name":"account","type":"ledger-account-id"},{"name":"owner","type":"ledger-owner"},{"name":"unit","type":"ledger-unit"},{"name":"scope","type":"ledger-scope"},{"name":"amount","type":"ledger-amount"},{"name":"balance","type":"ledger-amount"},{"name":"balance-before","type":"ledger-amount"},{"name":"entry-sequence","type":"u64"},{"name":"reason","type":"string"}]}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"strata_kernel::EventBody: the body of a domain event; roles is a BTreeSet<RoleId>. ledger-entry-posted is one entry recorded in an account (LDG-010, D-5008); owner is personal and is never logged."},
    {"id":"domain-event","name":"Domain Event","kind":"struct","fields":[{"name":"tenant","type":"tenant-id"},{"name":"seq","type":"u64"},{"name":"revision","type":"state-revision"},{"name":"at","type":"timestamp"},{"name":"principal","type":"principal"},{"name":"correlation","type":"string"},{"name":"body","type":"event-body"}],"description":"strata_kernel::DomainEvent: a fact about an accepted transition; its sequence is gapless per tenant."},
    {"id":"effect","name":"Effect","kind":"union","variants":[{"name":"publish","fields":[{"name":"seq","type":"u64"}]},{"name":"revoke-sessions","fields":[{"name":"principal","type":"principal-id"}]},{"name":"start-automation","newtype":true,"fields":[{"name":"value","type":"automation-start"}]},{"name":"decline-automation","newtype":true,"fields":[{"name":"value","type":"automation-decline"}]}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"strata_kernel::Effect: something the adapters do after commit. start-automation and decline-automation are the outcome of a trigger that matched an event of the transition (D-7200): the automation worker creates the job of the run, or writes the declined exception record, in the commit of the transition (SCH-004, SCH-1532)."},
    {"id":"output","name":"Output","kind":"union","variants":[{"name":"tenant"},{"name":"schema","fields":[{"name":"version","type":"schema-version"}]},{"name":"member"},{"name":"record","fields":[{"name":"object","type":"object-type-id"},{"name":"id","type":"record-id"},{"name":"version","type":"u64"}]},{"name":"deleted","fields":[{"name":"object","type":"object-type-id"},{"name":"id","type":"record-id"}]},{"name":"erased","fields":[{"name":"changed","type":"list<erased-record>"},{"name":"member-removed","type":"bool"},{"name":"teams","type":"list<team-id>"},{"name":"invitations","type":"list<invitation-id>"},{"name":"not-erased","type":"list<string>"},{"name":"more","type":"bool"},{"name":"next-object","type":"option<object-type-id>"},{"name":"next-after","type":"option<record-id>"}]},{"name":"setting","fields":[{"name":"setting","type":"setting-id"},{"name":"revision","type":"u64"}]},{"name":"operation","fields":[{"name":"operation","type":"tenant-operation-id"},{"name":"created","type":"list<record-id>"},{"name":"changed","type":"list<record-id>"},{"name":"deleted","type":"list<record-id>"},{"name":"entries","type":"list<ledger-entry>"}]},{"name":"ledger-posted","fields":[{"name":"results","type":"list<ledger-posting-result>"}]},{"name":"expired","fields":[{"name":"object","type":"object-type-id"},{"name":"deleted","type":"list<record-id>"},{"name":"kept","type":"list<string>"}]}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"strata_kernel::Output: what an accepted transition tells its caller. operation is the output of an accepted invocation of a tenant operation: the records its steps created, the other records they changed and the records they deleted, each once in step order, and the ledger entries its postings made (OPR-1541)."},
    {"id":"transition-result","name":"Transition Result","kind":"struct","fields":[{"name":"delta","type":"state-delta"},{"name":"events","type":"list<domain-event>"},{"name":"effects","type":"list<effect>"},{"name":"evidence","type":"list<check>"},{"name":"output","type":"output"}],"description":"strata_kernel::Transition: the result of an accepted transition."},
    {"id":"read-request","name":"Read Request","kind":"union","variants":[{"name":"named","fields":[{"name":"query","type":"query-id"},{"name":"params","type":"map<string, value>"},{"name":"page-size","type":"u32","optional":true},{"name":"cursor","type":"page-cursor","optional":true}]},{"name":"records","fields":[{"name":"object","type":"object-type-id"},{"name":"ids","type":"list<record-id>"}]}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"strata_kernel::ReadRequest."},
    {"id":"read-result","name":"Read Result","kind":"struct","fields":[{"name":"rows","type":"list<shared<record>>"},{"name":"revision","type":"state-revision"},{"name":"schema-version","type":"schema-version"},{"name":"next","type":"page-cursor","optional":true}],"description":"strata_kernel::ReadResult."},
    {"id":"subject","name":"Subject","kind":"struct","fields":[{"name":"old","type":"option<record>"},{"name":"new","type":"option<record>"}],"description":"strata_kernel::rules::Subject: the records a policy condition may read; record is old, else new."},
    {"id":"policy-outcome","name":"Policy outcome","kind":"union","variants":[{"name":"owner"},{"name":"unconditional"},{"name":"held"},{"name":"is-false"},{"name":"is-null"},{"name":"failed"},{"name":"no-policy"}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"Why a policy check of rules.rs authorize passed or failed; it fixes the kernel check detail: owner and unconditional \"<what>\"; held \"<what> where <condition>\"; is-false and is-null \"<condition> is false\" / \"is null\"; failed \"<condition>: <evaluation error>\"; no-policy \"no policy grants <what>\"."},
    {"id":"policy-check","name":"Policy check","kind":"struct","fields":[{"name":"rule","type":"string"},{"name":"passed","type":"bool"},{"name":"what","type":"string"},{"name":"outcome","type":"policy-outcome"},{"name":"condition","type":"option<expr>"}],"description":"One check of rules.rs authorize: the kernel Check (rule, passed) with the parts its detail is printed from (what, the outcome and the condition) instead of the printed detail; see policy-outcome."},
    {"id":"policy-progress","name":"Policy progress","kind":"struct","fields":[{"name":"granted","type":"option<policy-check>"},{"name":"checks","type":"list<policy-check>"},{"name":"needed","type":"option<need>"}],"description":"The state of the policy loop of rules.rs authorize: the check that granted, once one has, and the failed checks so far. needed is the first record a condition that failed to evaluate needs and the snapshot does not cover (rules.rs authorize_needing)."},
    {"id":"policy-decision","name":"Policy decision","kind":"struct","fields":[{"name":"allowed","type":"bool"},{"name":"checks","type":"list<policy-check>"},{"name":"needed","type":"option<need>"}],"description":"The (bool, Vec<Check>, Option<Need>) that rules.rs authorize_needing returns: whether the action is allowed, the checks, and the record a failed condition needs that the snapshot does not cover; authorize drops the need."},
    {"id":"tenant-file-state","name":"Tenant file state","kind":"enum","values":["active","provisioning","deleting"],"description":"The state of a tenant in the SQLite control database: active; provisioning (an install has made its first commit and not its last: it loads as absent, and the next start of the backend or open of the tenant removes it); or deleting (its file is being removed; it loads as absent, and the next open finishes the removal)."},
    {"id":"validation-failure","name":"Validation failure","kind":"struct","description":"strata_kernel rules.rs Failure: a failed check together with the error it maps to.","fields":[{"name":"check","type":"check"},{"name":"kind","type":"error-kind"}]},
    {"id":"validation-outcome","name":"Validation outcome","kind":"struct","description":"strata_kernel rules.rs Validation: the outcome of validating one record against a schema.","fields":[{"name":"passed","type":"list<check>"},{"name":"failed","type":"list<validation-failure>"}]},
    {"id":"rejection","name":"Rejection","kind":"union","description":"A kernel DomainError as the failure of a function (functions fail with a union): Result<_, DomainError> is a function that fails with rejection.rejected.","variants":[{"name":"rejected","newtype":true,"fields":[{"name":"error","type":"domain-error"}]}],"encoding":{"tag":"external","variantCase":"PascalCase"}},
    {"id":"expr-env","name":"Expression environment","kind":"struct","description":"strata_kernel expr.rs Env as the environment of eval(tenant-rule-language, ...): one field per scope of the language. record, old and new are a record's fields and system attributes ($id, $version, $created_by, $created_at, $updated_at), null when there is no record; param the supplied parameters; now a time value; principal the acting user's id as a string, or null; has_role the roles held. The kernel's lookup (following a reference) has no field: see the report of WG-4937.","fields":[{"name":"record","type":"option<map<string, value>>"},{"name":"old","type":"option<map<string, value>>"},{"name":"new","type":"option<map<string, value>>"},{"name":"param","type":"map<string, value>"},{"name":"now","type":"value"},{"name":"principal","type":"value"},{"name":"has_role","type":"list<string>"}]},
    {"id":"expr-check-env","name":"Expression check environment","kind":"struct","description":"strata_kernel expr.rs TypeEnv as the environment of check(tenant-rule-language, ...): the shape of each field at the definition site (str, int, bool, time, ref, list), the declared parameters and roles. TypeEnv.objects (for checking a reference hop) has no field: check gives a hop the any shape.","fields":[{"name":"fields","type":"map<string, string>"},{"name":"params","type":"list<string>"},{"name":"roles","type":"list<string>"}]},
    {"id":"defaults-outcome","name":"Defaults outcome","kind":"struct","description":"The field values create_record goes on with after applying defaults (transition.rs), and the draft evidence with a default: check per applied default.","fields":[{"name":"values","type":"map<field-id, value>"},{"name":"evidence","type":"list<check>"}]},
    {"id":"route-scan","name":"Route scan","kind":"struct","description":"schema.rs problems: the problems found so far over the views, and the routes already taken.","fields":[{"name":"problems","type":"list<string>"},{"name":"routes","type":"list<string>"}]},
    {"id":"json-number","name":"JSON number","kind":"union","description":"serde_json::Number: a non-negative integer, a negative integer or a float, as serde_json holds it.","variants":[{"name":"pos-int","newtype":true,"fields":[{"name":"value","type":"u64"}]},{"name":"neg-int","newtype":true,"fields":[{"name":"value","type":"i64"}]},{"name":"float","newtype":true,"fields":[{"name":"value","type":"f64"}]}],"encoding":{"tag":"external","variantCase":"PascalCase"}},
    {"id":"plain-json","name":"Plain JSON","kind":"union","description":"serde_json::Value: the plain JSON clients send for field values (substrate plain.rs). An object is a BTreeMap, as serde_json without preserve_order holds it.","variants":[{"name":"null"},{"name":"bool","newtype":true,"fields":[{"name":"value","type":"bool"}]},{"name":"number","newtype":true,"fields":[{"name":"value","type":"json-number"}]},{"name":"string","newtype":true,"fields":[{"name":"value","type":"string"}]},{"name":"array","newtype":true,"fields":[{"name":"value","type":"list<plain-json>"}]},{"name":"object","newtype":true,"fields":[{"name":"value","type":"map<string, plain-json>"}]}],"encoding":{"tag":"external","variantCase":"PascalCase"}},
    {"id":"plain-error","name":"Plain conversion error","kind":"union","description":"The Err(String) of substrate plain.rs coerce and coerce_fields.","variants":[{"name":"message","newtype":true,"fields":[{"name":"text","type":"string"}]}],"encoding":{"tag":"external","variantCase":"PascalCase"}},
    {"id":"draft","name":"Draft","kind":"struct","description":"transition.rs Draft: what one transition has gathered so far. The kernel's Lookup is the tenant with the coverage.","fields":[{"name":"tenant","type":"tenant-state"},{"name":"ctx","type":"context"},{"name":"coverage","type":"coverage"},{"name":"ops","type":"list<delta-op>"},{"name":"events","type":"list<event-body>"},{"name":"effects","type":"list<effect>"},{"name":"evidence","type":"list<check>"},{"name":"next-record","type":"u64"}]},
    {"id":"decided","name":"Decided intent","kind":"struct","description":"What a per-intent function of transition.rs leaves: the draft it filled and the Output it answers.","fields":[{"name":"draft","type":"draft"},{"name":"output","type":"output"}]},
    {"id":"schema-step","name":"Schema step","kind":"struct","description":"transition.rs apply_change: the working copy after one change and the line that describes it.","fields":[{"name":"schema","type":"tenant-schema"},{"name":"line","type":"string"}]},
    {"id":"schema-problem","name":"Schema change problem","kind":"union","description":"The Err(String) of transition.rs apply_change.","variants":[{"name":"problem","newtype":true,"fields":[{"name":"text","type":"string"}]}],"encoding":{"tag":"external","variantCase":"PascalCase"}},
    {"id":"migration-progress","name":"Migration progress","kind":"struct","description":"transition.rs plan_migration, the loop over the changes: the working copy, the summary and the evidence so far.","fields":[{"name":"schema","type":"tenant-schema"},{"name":"summary","type":"list<string>"},{"name":"evidence","type":"list<check>"}]},
    {"id":"workflow-search","name":"Workflow search","kind":"struct","description":"transition.rs update_record, the loop over a workflow's transitions: the one that fired, if any, and why the others were refused.","fields":[{"name":"fired","type":"option<workflow-transition>"},{"name":"refused","type":"list<string>"}]},
    {"id":"workflow-outcome","name":"Workflow outcome","kind":"struct","description":"transition.rs update_record after one workflow: the draft and the candidate with the fired transition's assignments.","fields":[{"name":"draft","type":"draft"},{"name":"candidate","type":"record"}]},
    {"id":"referrer","name":"Referrer","kind":"struct","description":"schema.rs TenantSchema::referrers: a reference field that points at an object type, with whether it is a list and what deleting the target does.","fields":[{"name":"object","type":"object-type-def"},{"name":"field","type":"field-def"},{"name":"is-list","type":"bool"},{"name":"on-delete","type":"on-delete"}]},
    {"id":"event-numbering","name":"Event numbering","kind":"struct","description":"transition.rs Draft::finish: the events numbered so far and the next sequence number.","fields":[{"name":"events","type":"list<domain-event>"},{"name":"next","type":"u64"}]},
    {"id":"mutation","name":"Mutation","kind":"union","encoding":{"tag":"internal","tagField":"op","variantCase":"snake_case"},"description":"strata_protocol::api::Mutation: a record mutation with plain JSON field values, the body of POST /api/records ({\"op\": \"create\" | \"update\" | \"delete\", object, id, fields, expected_version}); the backend coerces the fields by field type. The fields are plain-json, which the function language can take apart; on the wire they are raw JSON, which plain-json's external encoding is not (a gap of WG-4939: plain-json needs an untagged encoding).","variants":[{"name":"create","fields":[{"name":"object","type":"string"},{"name":"fields","type":"map<string, plain-json>"}]},{"name":"update","fields":[{"name":"object","type":"string"},{"name":"id","type":"u64"},{"name":"fields","type":"map<string, plain-json>"},{"name":"expected-version","type":"u64","optional":true}]},{"name":"delete","fields":[{"name":"object","type":"string"},{"name":"id","type":"u64"},{"name":"expected-version","type":"u64","optional":true}]}]},
    {"id":"mutation-reply","name":"Mutation Reply","kind":"struct","description":"strata_protocol::api::MutationReply: what an accepted record mutation answers. version is absent after a delete; event-seq is the tenant event sequence after the change; checks-passed counts the evidence of the transition.","fields":[{"name":"object","type":"string"},{"name":"id","type":"u64"},{"name":"version","type":"u64","optional":true},{"name":"revision","type":"u64"},{"name":"event-seq","type":"u64"},{"name":"checks-passed","type":"u64"}]},
    {"id":"accepted-intent","name":"Accepted Intent","kind":"struct","description":"What a decision of execute-intent and mutate-record hands its commit (commit-accepted, CT-262): the intent and the transition the kernel accepted, which storage-api Commit::of turns into the commit, and the record reply when the transition changed a record.","fields":[{"name":"intent","type":"intent"},{"name":"transition","type":"transition-result"},{"name":"reply","type":"mutation-reply","optional":true}]},
    {"id":"execute-failure","name":"Execute Failure","kind":"union","encoding":{"tag":"external","variantCase":"PascalCase"},"description":"Why a decision of execute-intent or execute-read did not go through: the kernel rejected it, or the snapshot lacked a need, which the derivation loads before deciding again (storage-api execute and query).","variants":[{"name":"domain","newtype":true,"fields":[{"name":"value","type":"domain-error"}]},{"name":"insufficient-state","newtype":true,"fields":[{"name":"value","type":"need"}]}]},
    {"id":"api-failure","name":"Api Failure","kind":"union","encoding":{"tag":"external","variantCase":"PascalCase"},"description":"Why a decision of mutate-record or read-view did not go through: a refusal answered with the error body (backend ApiError), or the snapshot lacked a need, which the derivation loads before deciding again.","variants":[{"name":"refused","newtype":true,"fields":[{"name":"value","type":"api-error"}]},{"name":"insufficient-state","newtype":true,"fields":[{"name":"value","type":"need"}]}]},
    {"id":"route-segment","name":"Route Segment","kind":"union","encoding":{"tag":"external","variantCase":"PascalCase"},"description":"One segment of a view route as substrate project.rs match_route reads it: a literal, or :name, a parameter. The stand-in of splitting a route at / and stripping the :, which the function language cannot do yet (WG-4957).","variants":[{"name":"literal","newtype":true,"fields":[{"name":"value","type":"string"}]},{"name":"param","newtype":true,"fields":[{"name":"value","type":"string"}]}]},
    {"id":"route-match","name":"Route Match","kind":"struct","description":"substrate project.rs match_route: the view whose route matched, and the values of its :name segments.","fields":[{"name":"view","type":"view-def"},{"name":"params","type":"map<string, string>"}]},
    {"id":"route-try","name":"Route Try","kind":"struct","description":"match_route over one view: the segment reached, whether every segment so far matched, the literal segments matched, and the parameters read.","fields":[{"name":"at","type":"u64"},{"name":"ok","type":"bool"},{"name":"literal","type":"u64"},{"name":"params","type":"map<string, string>"}]},
    {"id":"route-pick","name":"Route Pick","kind":"struct","description":"match_route so far: the best view found and its number of literal segments.","fields":[{"name":"literal","type":"u64"},{"name":"found","type":"option<route-match>"}]},
    {"id":"included-target","name":"Included Target","kind":"struct","description":"substrate project.rs included_refs, one included field: the object type it refers to and the record ids the rows name, each once, in order.","fields":[{"name":"object","type":"object-type-id"},{"name":"ids","type":"list<record-id>"}]},
    {"id":"section-data","name":"Section Data","kind":"struct","description":"strata_substrate::project::SectionData: the raw result of one view section, before projection; included holds the referenced records the principal may read, by referencing field. aggregate is the result of the aggregate a section names, in place of rows (D-5067).","fields":[{"name":"single","type":"bool"},{"name":"rows","type":"list<record>"},{"name":"included","type":"map<field-id, map<record-id, record>>"},{"name":"markdown","type":"list<field-id>"},{"name":"aggregate","type":"aggregate-result","optional":true}]},
    {"id":"view-progress","name":"View Progress","kind":"struct","description":"backend ops.rs view so far: the single rows of the sections evaluated (for later sections), the section data, and the revision read at.","fields":[{"name":"done","type":"map<string, option<record>>"},{"name":"sections","type":"map<string, section-data>"},{"name":"revision","type":"state-revision"}]},
    {"id":"markdown-summary","name":"Markdown Summary","kind":"struct","description":"What substrate markdown.rs gives for one Markdown source: the parsed blocks as JSON and word_count of them. The stand-in of parsing Markdown, which the function language cannot do (WG-4957).","fields":[{"name":"blocks","type":"plain-json"},{"name":"words","type":"u64"}]},
    {"id":"markdown-fold","name":"Markdown Fold","kind":"struct","description":"project.rs project_row over the markdown fields: the blocks by field and the words counted.","fields":[{"name":"blocks","type":"map<string, plain-json>"},{"name":"words","type":"u64"}]},
    {"id":"team-id","name":"team-id","kind":"id","repr":"string","description":"kernel TeamId: a team of a tenant, a named set of principals that holds roles together; [a-z][a-z0-9_]*, at most 64 bytes.","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64}},
    {"id":"invitation-id","name":"invitation-id","kind":"id","repr":"string","description":"kernel InvitationId: an invitation of a tenant, chosen by whoever issues it; [A-Za-z0-9_:.-]+, at most 96 bytes.","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96}},
    {"id":"capability-name","name":"capability-name","kind":"id","repr":"string","description":"The id of one of the platform's capabilities (a capability of this specification)."},
    {"id":"object-action","name":"Object action","kind":"enum","values":["read","create","update","delete"],"description":"strata_kernel::ObjectAction: an action on the records of one object type that a role's permission can name (read, create, update, delete); the kernel maps it to the policy Action of the same name."},
    {"id":"tenant-permission","name":"Tenant permission","kind":"struct","metamodel":"definition","fields":[{"name":"capability","type":"capability-name","optional":true},{"name":"object","type":"object-type-id","optional":true},{"name":"actions","type":"list<object-action>","optional":true}],"description":"One permission of a tenant role (ADM-150): a capability, or actions on the records of an object type of the tenant's schema; exactly one of capability and object, and actions with object (kernel Permission)."},
    {"id":"tenant-role","name":"Tenant role","kind":"struct","metamodel":"definition","fields":[{"name":"id","type":"role-id"},{"name":"label","type":"string"},{"name":"permissions","type":"list<tenant-permission>"}],"description":"A role of a tenant, held as tenant data (ADM-150): a named set of permissions over the capabilities and the object types of the tenant's schema. The template's roles (the tenant roles of this specification) are where a tenant starts."},
    {"id":"role-assignment","name":"Role assignment","kind":"struct","metamodel":"definition","fields":[{"name":"role","type":"role-id"},{"name":"principal","type":"principal-id","optional":true},{"name":"team","type":"team-id","optional":true}],"description":"A tenant role assigned to a principal (a person, service or agent) or to a team; exactly one of principal and team (ADM-150). Refused unless the assigner holds a permission the role grants (ADM-152)."},
    {"id":"tenant-team","name":"Team","kind":"struct","metamodel":"definition","fields":[{"name":"id","type":"team-id"},{"name":"label","type":"string"},{"name":"members","type":"list<principal-id>"},{"name":"roles","type":"list<role-id>"}],"description":"A team of a tenant, held as tenant data: its members hold its roles (ADM-151). A principal holds exactly the permissions of its own roles and of its teams' roles."},
    {"id":"tenant-invitation","name":"Invitation","kind":"struct","metamodel":"definition","fields":[{"name":"id","type":"invitation-id"},{"name":"address","type":"email-address"},{"name":"roles","type":"list<role-id>"},{"name":"redeemed-by","type":"principal-id","optional":true}],"description":"An invitation of a tenant: grants its roles to the one person who redeems it with the address it names, once (ADM-153)."},
    {"id":"permission","name":"Permission","kind":"union","variants":[{"name":"capability","newtype":true,"fields":[{"name":"value","type":"string"}]},{"name":"object","fields":[{"name":"object","type":"object-type-id"},{"name":"actions","type":"set<object-action>"}]}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"strata_kernel::Permission: one entry of a tenant role's permission set (ADM-150): the name of a platform capability, which the kernel treats as an opaque string, or actions on an object type. A bundle that specc writes from a product file writes it as this union does ({\"Capability\": \"<name>\"}); the bundle reader also accepts the untagged form of a whole-tenant bundle (a bare capability name, or {object, actions}) and converts it."},
    {"id":"grant","name":"Grant","kind":"union","variants":[{"name":"capability","newtype":true,"fields":[{"name":"value","type":"string"}]},{"name":"object","tuple":true,"fields":[{"name":"object","type":"object-type-id"},{"name":"action","type":"object-action"}]}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"strata_kernel::Grant: one indivisible permission; a Permission is the set of grants it expands to. Object(ObjectTypeId, ObjectAction) is a tuple variant."},
    {"id":"team-def","name":"Team Def","kind":"struct","fields":[{"name":"id","type":"team-id"},{"name":"label","type":"string"},{"name":"members","type":"set<principal-id>"},{"name":"roles","type":"set<role-id>"}],"description":"strata_kernel::TeamDef: a named set of principals that holds roles together (ADM-151); every member holds the team's roles."},
    {"id":"invitation-def","name":"Invitation Def","kind":"struct","fields":[{"name":"id","type":"invitation-id"},{"name":"address","type":"string"},{"name":"roles","type":"set<role-id>"},{"name":"created-by","type":"principal-id"},{"name":"redeemed-by","type":"option<principal-id>"},{"name":"expires-at","type":"timestamp","optional":true},{"name":"revoked-by","type":"principal-id","optional":true}],"description":"strata_kernel::InvitationDef: an offer of roles to the one person who redeems it with the address it names, once (ADM-153). The address is normalised: trimmed and lower-cased. expires-at is the time from which it cannot be redeemed, fourteen days after it was issued (ADM-1082); an invitation that records none cannot be redeemed. revoked-by is who withdrew it before it was redeemed (ADM-1083)."},
    {"id":"ledger-unit","name":"Ledger unit","kind":"id","repr":"string","description":"The name of a unit a tenant declares: lower case, [a-z][a-z0-9_-]*, at most 64 bytes.","constraints":{"pattern":"^[a-z][a-z0-9_-]*$","maxLength":64}},
    {"id":"ledger-pool-name","name":"Ledger pool name","kind":"id","repr":"string","description":"The name of a pool a tenant declares, such as a promotion budget: lower case, [a-z][a-z0-9_-]*, at most 64 bytes.","constraints":{"pattern":"^[a-z][a-z0-9_-]*$","maxLength":64}},
    {"id":"ledger-account-id","name":"Ledger account id","kind":"id","repr":"uuid","description":"Derived from the tenant, the owner and the unit of the account (D-5001), not drawn at random."},
    {"id":"ledger-amount","name":"Ledger amount","kind":"scalar","repr":"i64","description":"A signed whole number of the smallest step of a unit, from -(2^53-1) to 2^53-1 (D-5004)."},
    {"id":"ledger-period","name":"Ledger period","kind":"enum","values":["hour","day","week","month"],"description":"The calendar period of a cap per period, in UTC; a week starts on Monday (D-5005)."},
    {"id":"ledger-owner","name":"Ledger owner","kind":"union","variants":[{"name":"principal","fields":[{"name":"principal","type":"principal-id"}]},{"name":"pool","fields":[{"name":"pool","type":"ledger-pool-name"}]}],"encoding":{"tag":"external","variantCase":"snake_case"},"description":"Whose account it is: a principal of the tenant, or a named pool of the tenant."},
    {"id":"ledger-entry","name":"Ledger entry","kind":"struct","description":"One entry of the journal of an account.","fields":[{"name":"account","type":"ledger-account-id"},{"name":"sequence","type":"u64"},{"name":"amount","type":"ledger-amount"},{"name":"idempotency-key","type":"string"},{"name":"reason","type":"string"},{"name":"caused-by","type":"principal-id","optional":true},{"name":"at","type":"timestamp"},{"name":"corrects","type":"u64","optional":true}]},
    {"id":"ledger-balance","name":"Ledger balance","kind":"struct","description":"The balance of an account as of the entry numbered last-sequence.","fields":[{"name":"account","type":"ledger-account-id"},{"name":"unit","type":"ledger-unit"},{"name":"balance","type":"ledger-amount"},{"name":"last-sequence","type":"u64"},{"name":"scope","type":"ledger-scope","optional":true}]},
    {"id":"ledger-limit","name":"Ledger limit","kind":"struct","description":"The limits declared for a unit, or for one account of it.","fields":[{"name":"unit","type":"ledger-unit"},{"name":"owner","type":"ledger-owner","optional":true},{"name":"floor","type":"ledger-amount","optional":true},{"name":"cap","type":"ledger-amount","optional":true},{"name":"period-cap","type":"u64","optional":true},{"name":"period","type":"ledger-period","optional":true},{"name":"scope","type":"ledger-scope","optional":true}]},
    {"id":"ledger-posting-request","name":"Ledger posting request","kind":"struct","description":"What a posting asks of the kernel.","fields":[{"name":"owner","type":"ledger-owner"},{"name":"unit","type":"ledger-unit"},{"name":"amount","type":"ledger-amount"},{"name":"idempotency-key","type":"string"},{"name":"reason","type":"string"},{"name":"corrects","type":"u64","optional":true},{"name":"scope","type":"ledger-scope","optional":true}]},
    {"id":"ledger-posting-result","name":"Ledger posting result","kind":"struct","description":"The entry a posting made or found, and the balance after it.","fields":[{"name":"entry","type":"ledger-entry"},{"name":"balance","type":"ledger-balance"},{"name":"replayed","type":"bool"}]},
    {"id":"segment-id","name":"segment-id","kind":"id","repr":"uuid"},
    {"id":"segment-direction","name":"segment-direction","kind":"enum","values":["entered","exited"],"description":"Which way a person crossed the predicate of a segment."},
    {"id":"segment-reason","name":"segment-reason","kind":"enum","values":["change","predicate-change","refresh","erasure"],"description":"What made the membership change: a committed change to the person's records, a change of the predicate, a scheduled refresh, or the erasure of the person."},
    {"id":"segment-membership-event","name":"Segment membership event","kind":"struct","fields":[{"name":"segment","type":"segment-id"},{"name":"person","type":"principal-id","sensitive":"personal"},{"name":"direction","type":"segment-direction"},{"name":"reason","type":"segment-reason"},{"name":"version","type":"u64"},{"name":"revision","type":"state-revision"},{"name":"hop","type":"u64"}],"description":"The body of an entry or exit event (D-5023): written in the transaction of the change, carrying the hop count of the change plus one (SEG-031). After an erasure the person is named in sealed form (SEG-038)."},
    {"id":"segment-member","name":"Segment member","kind":"struct","fields":[{"name":"person","type":"principal-id"},{"name":"since","type":"timestamp"},{"name":"version","type":"u64"}],"description":"One member in the answer of list-segment-members: the person, when the person entered and the version of the predicate that decided it."},
    {"id":"segment-test-result","name":"Segment test result","kind":"struct","fields":[{"name":"member","type":"bool"},{"name":"reads","type":"list<string>"}],"description":"The answer of test-segment-predicate: whether the person satisfies the predicate, and the names of the fields it read."},
    {"id":"setting-id","name":"setting-id","kind":"id","repr":"string","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64},"description":"A setting of the platform or of a tenant, [a-z][a-z0-9_]*, at most 64 bytes. A tenant setting never takes the name of a platform setting (SET-003)."},
    {"id":"setting-level","name":"setting-level","kind":"enum","values":["platform","tenant","team","person"],"description":"A level at which a setting can be overridden, from the least to the most specific (D-5040)."},
    {"id":"setting-source","name":"setting-source","kind":"enum","values":["default","platform","tenant","team","person"],"description":"Where the value of a read came from: the default of the definition or the override of a level (SET-012)."},
    {"id":"setting-type","name":"setting-type","kind":"scalar","repr":"string","constraints":{"pattern":"^[a-z][a-z0-9_-]*$","maxLength":64},"description":"The type of a setting: bool, i64, string or timestamp, or the id of a declared type of kind id, scalar or enum that the kernel holds (SET-001, D-5046, D-7901). f64 is named by the specification and refused by the kernel, which holds no float. The characters of a ledger-unit: a type id may hold a hyphen."},
    {"id":"setting-def","name":"Setting Def","kind":"struct","metamodel":"definition","fields":[{"name":"id","type":"setting-id"},{"name":"label","type":"string"},{"name":"type","type":"setting-type"},{"name":"default","type":"value"},{"name":"levels","type":"set<setting-level>"},{"name":"locked-by","type":"setting-level","optional":true}],"description":"A definition of a setting (SET-001): its name, type, default and the levels that may override it. locked-by is platform or tenant and closes every level below it (SET-023). A definition is metadata: a tenant's definitions are part of its schema, and the platform's come with a release (D-5047)."},
    {"id":"setting-resolution","name":"Setting Resolution","kind":"struct","fields":[{"name":"setting","type":"setting-id"},{"name":"value","type":"value"},{"name":"source","type":"setting-source"},{"name":"team","type":"team-id","optional":true},{"name":"platform-revision","type":"u64"},{"name":"tenant-revision","type":"u64"}],"description":"The answer of a read of a setting for a principal: the value, the level it came from, the team when that level is team, and the two revisions a stored copy that depends on the setting is keyed by (SET-010, SET-012, SET-050)."},
    {"id":"aggregate-id","name":"aggregate-id","kind":"id","repr":"string","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64},"description":"An aggregate of a named query of a tenant, [a-z][a-z0-9_]*, at most 64 bytes, unique within its query."},
    {"id":"aggregate-kind","name":"aggregate-kind","kind":"enum","values":["count","sum","minimum","maximum","top"],"description":"What an aggregate computes (AGG-001): count counts records, sum adds the values of a field, minimum and maximum take the least and greatest value, top lists the records with the greatest or least value."},
    {"id":"aggregate-def","name":"Aggregate Def","kind":"struct","metamodel":"definition","fields":[{"name":"id","type":"aggregate-id"},{"name":"kind","type":"aggregate-kind"},{"name":"field","type":"field-id","optional":true},{"name":"group-by","type":"field-id","optional":true},{"name":"n","type":"u32","optional":true},{"name":"descending","type":"bool"},{"name":"scan-bound","type":"u32"}],"description":"The declaration of an aggregate in a named query (AGG-001). field is the field a sum, minimum or maximum reads and the field a top list ranks by, and a count has none. group-by is a declared field. n is the length of a top list, one to one hundred, and descending puts the greatest value first. scan-bound is the number of records the aggregate may examine, at most ten thousand (D-5062)."},
    {"id":"aggregate-group","name":"Aggregate Group","kind":"struct","fields":[{"name":"key","type":"value","optional":true},{"name":"value","type":"value","optional":true},{"name":"rows","type":"list<value-map>"}],"description":"One group of an aggregate result: the value of the group field (absent for the group of records with no value, and for an ungrouped aggregate), the count, sum, minimum or maximum, and for a top aggregate the records in rank order."},
    {"id":"aggregate-result","name":"Aggregate Result","kind":"struct","fields":[{"name":"query","type":"query-id"},{"name":"aggregate","type":"aggregate-id"},{"name":"groups","type":"list<aggregate-group>"},{"name":"scanned","type":"u32"},{"name":"depends-on","type":"set<object-type-id>"},{"name":"revision","type":"state-revision"},{"name":"schema-version","type":"schema-version"}],"description":"The result of an aggregate for one reader: its groups in ascending order of the group value, the number of records examined, the object types the result depends on (AGG-042) and the revision and schema version it was computed at."},
    {"id":"page-cursor","name":"Page Cursor","kind":"union","variants":[{"name":"after","newtype":true,"fields":[{"name":"value","type":"record-id"}]},{"name":"offset","newtype":true,"fields":[{"name":"value","type":"u32"}]},{"name":"at","newtype":true,"fields":[{"name":"value","type":"index-position"}]}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"strata_kernel::PageCursor: where the next page of a named query read starts. after continues a window of the object type, or a query planned on an equality, in id order after a record id; offset continues a sorted scan after that many rows (KRN-1285); at continues a query planned on the index of the field it orders by after an index position (KRN-2521)."},
    {"id":"tenant-suspension-reason","name":"tenant-suspension-reason","kind":"enum","values":["payment-overdue","trial-ended","owner-request","abuse","legal-order","security-incident"],"description":"Why a tenant is suspended. The first three are commercial reasons and the last three are takedown reasons (TEN-1220)."},
    {"id":"message-category-id","name":"message-category-id","kind":"id","repr":"string","constraints":{"pattern":"^[a-z][a-z0-9-]*$","maxLength":48},"description":"The name of a message category a tenant declares: lower case letters, digits and hyphens, beginning with a letter, at most 48 bytes. The names all and promotional are reserved (EML-1562)."},
    {"id":"message-category-purpose","name":"message-category-purpose","kind":"enum","values":["required","transactional","promotional"],"description":"What a category is for (D-6562). required: mail the person cannot turn off, such as a security or billing notice. transactional: mail that follows from something the person did. promotional: mail sent to an audience, which carries the unsubscribe of EML-020."},
    {"id":"allowance-class","name":"allowance-class","kind":"enum","values":["sign-in","transactional","bulk"],"description":"The class of a message for the mail allowance of the tenant (EML-1563). Only the platform sets sign-in; a product chooses transactional or bulk."},
    {"id":"send-channel","name":"send-channel","kind":"enum","values":["mail","inbox","both"],"description":"Where a send delivers: an email, an inbox notice, or both."},
    {"id":"send-state","name":"send-state","kind":"enum","values":["accepted","sending","complete"],"description":"The progress of a send: accepted when its first job is committed, sending while batches remain, complete when every batch has run."},
    {"id":"notice-state","name":"notice-state","kind":"enum","values":["unread","read"],"description":"The state of an inbox notice, used to filter a list (NTF-1569)."},
    {"id":"notification-channel","name":"notification-channel","kind":"enum","values":["mail","inbox"],"description":"A channel a person sets a preference for."},
    {"id":"notification-mode","name":"notification-mode","kind":"enum","values":["on","off","digest"],"description":"A preference for one category on one channel (NTF-1571, NTF-1572)."},
    {"id":"digest-period","name":"digest-period","kind":"enum","values":["daily","weekly"],"description":"How often a digest is delivered (NTF-1572)."},
    {"id":"event-field-type","name":"event-field-type","kind":"enum","values":["string","number","bool","timestamp","principal-id","record-id"],"description":"The scalar types a field of a declared event kind may have (SCH-1576)."},
    {"id":"send-zone","name":"send-zone","kind":"enum","values":["recipient","tenant"],"description":"Whose time zone a local time of a send is read in (SCH-1573)."},
    {"id":"mail-count-by","name":"mail-count-by","kind":"enum","values":["reference","category","template"],"description":"What count-mail-messages groups by (EML-1565)."},
    {"id":"send-id","name":"send-id","kind":"id","repr":"uuid","description":"The identifier of one send."},
    {"id":"send-reference","name":"send-reference","kind":"id","repr":"string","constraints":{"pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]*$","maxLength":64},"description":"A campaign or correlation reference a sender attaches to a send: at most 64 bytes of letters, digits and . _ : -. It is carried on every message of the send and in the mail log (EML-1565). It is not an analytics key and no visitor is followed by it (NG-8)."},
    {"id":"inbox-topic","name":"inbox-topic","kind":"id","repr":"string","constraints":{"pattern":"^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){0,3}$","maxLength":96},"description":"The topic of a notice: one to four labels of lower case letters, digits and hyphens joined by dots, each beginning with a letter, at most 96 bytes (NTF-1568)."},
    {"id":"event-kind","name":"event-kind","kind":"id","repr":"string","constraints":{"pattern":"^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){0,3}$","maxLength":96},"description":"The kind of a domain event: a platform kind such as mail-bounced, or a kind a tenant declares, which begins with app. (SCH-1576)."},
    {"id":"time-zone","name":"time-zone","kind":"id","repr":"string","constraints":{"pattern":"^[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+){0,2}$","maxLength":64},"description":"A name of the IANA time zone database, such as Europe/Paris or UTC (SCH-1573). The database version is the one the platform release carries (D-6567)."},
    {"id":"local-time","name":"local-time","kind":"id","repr":"string","constraints":{"pattern":"^([01][0-9]|2[0-3]):[0-5][0-9]$","maxLength":5},"description":"A wall-clock time of day, HH:MM on a 24 hour clock, read in a time zone (SCH-1573)."},
    {"id":"send-time","name":"Send Time","kind":"struct","fields":[{"name":"at","type":"timestamp","optional":true},{"name":"local-time","type":"local-time","optional":true},{"name":"zone","type":"send-zone","optional":true}],"description":"When a send delivers. at and local-time are alternatives; both absent means now. A send names at most one of them. at: An instant in UTC. The send does not begin before it. local-time: A wall-clock time of day. Each recipient receives the message at the next occurrence of this time in the zone named by zone, at or after the start of the send (SCH-1573). zone: Whose zone local-time is read in; recipient when absent."},
    {"id":"send-recipient","name":"Send Recipient","kind":"union","variants":[{"name":"principal","fields":[{"name":"principal","type":"principal-id"}]},{"name":"address","fields":[{"name":"address","type":"email-address"}]},{"name":"segment","fields":[{"name":"segment","type":"segment-id"}]}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"Who a send is for: a principal of the tenant, a single email address, or every member of a segment (D-5020). An address has no inbox, so a send to an address delivers by mail only."},
    {"id":"send-message-step","name":"Send Message Step","kind":"struct","fields":[{"name":"channel","type":"send-channel"},{"name":"template","type":"template-id"},{"name":"recipient","type":"send-recipient"},{"name":"category","type":"message-category-id"},{"name":"allowance-class","type":"allowance-class","optional":true},{"name":"topic","type":"inbox-topic","optional":true},{"name":"values","type":"value-map","optional":true},{"name":"reference","type":"send-reference","optional":true},{"name":"deliver","type":"send-time","optional":true},{"name":"idempotency-key","type":"string","optional":true}],"description":"The fields of the workflow step send-message: exactly the inputs of the contract send-message other than tenant. The step catalogue lists the step with these fields (INT-153). idempotency-key: When absent, the run identifier and the step identifier joined by a colon, so a replayed step sends once (EML-1560)."},
    {"id":"send-digest-step","name":"Send Digest Step","kind":"struct","fields":[{"name":"category","type":"message-category-id"},{"name":"template","type":"template-id"},{"name":"since","type":"timestamp"},{"name":"until","type":"timestamp"},{"name":"recipient","type":"send-recipient","optional":true},{"name":"reference","type":"send-reference","optional":true},{"name":"idempotency-key","type":"string","optional":true}],"description":"The fields of the workflow step send-digest: exactly the inputs of the contract send-digest other than tenant (NTF-1572). recipient: Absent means every person who holds a notice of the category in the window."},
    {"id":"emit-event-step","name":"Emit Event Step","kind":"struct","fields":[{"name":"kind","type":"event-kind"},{"name":"payload","type":"value-map"},{"name":"idempotency-key","type":"string","optional":true}],"description":"The fields of the workflow step emit-event: exactly the inputs of the contract emit-event other than tenant (SCH-1576)."},
    {"id":"event-field-def","name":"Event Field Def","kind":"struct","fields":[{"name":"name","type":"string"},{"name":"type","type":"event-field-type"},{"name":"personal","type":"bool","optional":true}],"description":"One field of a declared event kind. personal: True when the field holds personal data: it is never logged and is delivered only to readers of the kind."},
    {"id":"mail-count","name":"Mail Count","kind":"struct","fields":[{"name":"group","type":"string","optional":true},{"name":"state","type":"message-state"},{"name":"count","type":"u64"}],"description":"The number of messages in one state for one value of a grouping field (EML-1565). group: The value of the grouping field; absent for messages that have none."},
    {"id":"send-progress","name":"Send Progress","kind":"struct","fields":[{"name":"send","type":"send-id"},{"name":"state","type":"send-state"},{"name":"batches","type":"u32"}],"description":"What a sender learns about the size of a send. batches: The number of batches the send was cut into when it was accepted: the recipients divided by one hundred, rounded up (EML-1561)."},
    {"id":"product-id","name":"product-id","kind":"id","repr":"string","description":"The id of a product, the lower-case words of its product file joined by hyphens, at most 64 bytes. A tenant id derived from it replaces each hyphen by an underscore (D-6582).","constraints":{"pattern":"^[a-z][a-z0-9-]*$","maxLength":64}},
    {"id":"platform-compat","name":"Platform Compat","kind":"struct","fields":[{"name":"min","type":"string"},{"name":"below","type":"string","optional":true}],"description":"The platform releases a bundle is written for: from min up to, and excluding, below (D-6583). Fields. below: The first platform release the bundle does not support; absent when no later release is excluded."},
    {"id":"entity-kind","name":"Entity Kind","kind":"enum","values":["object","role","capability","policy","workflow","query","view","segment","setting","ledger-unit","ledger-pool","ledger-limit","mail-template","notice-template","token","trigger","automation","operation","ui-element"],"description":"The kinds of tenant-declared entity a product can own (D-6580). ui-element is an element of the interface definition (D-8250). trigger, automation and operation are filled by the triggers, automations and composite operations of WG-5031 and WG-5032."},
    {"id":"entity-ref","name":"Entity Ref","kind":"struct","fields":[{"name":"kind","type":"entity-kind"},{"name":"id","type":"string"}],"description":"One tenant entity named by its kind and its id in the tenant."},
    {"id":"installed-product","name":"Installed Product","kind":"struct","fields":[{"name":"product","type":"product-id"},{"name":"version","type":"string"},{"name":"platform","type":"platform-compat","optional":true},{"name":"owns","type":"list<entity-ref>"},{"name":"schema-version","type":"schema-version","optional":true}],"description":"A product installed in a tenant: its bundle version, the platform releases it declared and every entity it owns, which is what a removal finds (D-6582). Fields. platform: Absent when the bundle declared no platform range. schema-version: The schema version the install produced, which an install of the same product and version again returns (D-6583, INT-1922)."},
    {"id":"ui-element","name":"UI Element","kind":"union","variants":[{"name":"screen","newtype":true,"fields":[{"name":"value","type":"ui-screen"}]},{"name":"form","newtype":true,"fields":[{"name":"value","type":"ui-form"}]},{"name":"action","newtype":true,"fields":[{"name":"value","type":"ui-action"}]},{"name":"live-binding","newtype":true,"fields":[{"name":"value","type":"ui-live-binding"}]},{"name":"error-message","newtype":true,"fields":[{"name":"value","type":"ui-error-message"}]},{"name":"presentation","newtype":true,"fields":[{"name":"value","type":"ui-presentation"}]}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"One element of the interface definition of a tenant (D-8250): a screen, a form, an action, a live binding, an error message or a presentation, held in tenant-schema.ui by its id, which is in the namespace of the product that installs it. Every reference between elements and to the schema is checked when the schema that holds it is checked (strata_kernel::ui)."},
    {"id":"ui-screen","name":"UI Screen","kind":"struct","fields":[{"name":"route","type":"string"},{"name":"view","type":"view-id"},{"name":"title","type":"string"},{"name":"kind","type":"ui-screen-kind"},{"name":"auth","type":"ui-auth"},{"name":"query","type":"list<string>"}],"description":"A screen of a tenant (D-8250). Fields. route: The path pattern it answers: /segment/... where a segment is a literal or :param; it is the route of its view. view: The view of the tenant schema whose data it shows. title: The page title; ${path} parts are read from the view model. kind: How the interpreter lays it out. query: The query parameters it passes to its view."},
    {"id":"ui-screen-kind","name":"UI Screen Kind","kind":"enum","values":["list","detail","editor","settings"],"description":"How the interpreter of the web application lays out a tenant screen: list draws the rows of each section, detail the fields of one record, editor and settings put the forms first (D-8250)."},
    {"id":"ui-auth","name":"UI Auth","kind":"enum","values":["anyone","session"],"description":"Who may open a tenant screen: anyone, or a signed-in person (a visitor without a session is asked to sign in)."},
    {"id":"ui-form","name":"UI Form","kind":"struct","fields":[{"name":"screen","type":"string"},{"name":"operation","type":"tenant-operation-id"},{"name":"fields","type":"list<ui-field>"},{"name":"submit-label","type":"string"},{"name":"on-success","type":"ui-outcome"},{"name":"on-error","type":"ui-error-display"}],"description":"A form on a tenant screen whose submission invokes a tenant operation with the values of its fields as the operation's inputs (D-8250)."},
    {"id":"ui-field","name":"UI Field","kind":"struct","fields":[{"name":"name","type":"string"},{"name":"input","type":"string"},{"name":"label","type":"string"},{"name":"control","type":"ui-control"},{"name":"options","type":"list<ui-option>","optional":true},{"name":"trim","type":"bool","optional":true}],"description":"One control of a form: the input of the operation it fills, its accessible name, its control and, for a select or radio, its choices. trim: the value is trimmed before it is sent."},
    {"id":"ui-control","name":"UI Control","kind":"enum","values":["text","textarea","password","checkbox","select","radio","date","number"],"description":"The controls the interpreter of the web application draws."},
    {"id":"ui-option","name":"UI Option","kind":"struct","fields":[{"name":"value","type":"string"},{"name":"label","type":"string"}],"description":"One choice of a select or radio control."},
    {"id":"ui-outcome","name":"UI Outcome","kind":"struct","fields":[{"name":"toast","type":"string","optional":true},{"name":"navigate","type":"string","optional":true}],"description":"What a page does when a form or an action succeeds: a message, a navigation to a screen of the same tenant (by its id), both, or neither (the view is read again)."},
    {"id":"ui-error-display","name":"UI Error Display","kind":"enum","values":["inline","toast"],"description":"Where a refusal is shown: beside the form, or as a message."},
    {"id":"ui-action","name":"UI Action","kind":"struct","fields":[{"name":"screen","type":"string"},{"name":"label","type":"string"},{"name":"operation","type":"tenant-operation-id"},{"name":"form","type":"string","optional":true},{"name":"arguments","type":"map<string, string>"},{"name":"confirm","type":"string","optional":true},{"name":"on-success","type":"ui-outcome"},{"name":"on-error","type":"ui-error-display"}],"description":"A button on a tenant screen that invokes a tenant operation. arguments: operation input -> form.<field> of the form it names, or route.<param>. confirm: the button asks for a second press with this text."},
    {"id":"ui-live-binding","name":"UI Live Binding","kind":"struct","fields":[{"name":"screen","type":"string"},{"name":"event","type":"ui-live-event"},{"name":"kinds","type":"list<string>"},{"name":"objects","type":"bool"}],"description":"When an open tenant screen reads its view again. event notice: a notice whose kind is in kinds (schema, membership), or, with objects, one about a record of an object type the view depends on. event session-ended: the session ended."},
    {"id":"ui-live-event","name":"UI Live Event","kind":"enum","values":["notice","session-ended"],"description":"The events a live binding of a tenant screen listens to."},
    {"id":"ui-display-type","name":"UI Display Type","kind":"enum","values":["text","rich-text","datetime","date","duration","count","number","money","percent","boolean","status","choice","person","reference","references","tags","language","media","url","email","code"],"description":"The display types of the design system (docs/design-system.md, Display types): how the interpreter draws the value of a field. Each applies to certain field types, which the kernel checks when a presentation is defined."},
    {"id":"ui-field-display","name":"UI Field Display","kind":"struct","fields":[{"name":"display","type":"ui-display-type"},{"name":"props","type":"map<string, string>","optional":true}],"description":"How one field of an object type is drawn: its display type and the props that display type takes (for example style=relative for a datetime), each a string."},
    {"id":"ui-presentation","name":"UI Presentation","kind":"struct","fields":[{"name":"object","type":"object-type-id"},{"name":"title","type":"field-id","optional":true},{"name":"fields","type":"map<field-id, ui-field-display>"}],"description":"The presentation of one object type (D-8250): the field whose text titles a record, and the display type of each field it declares. A field that names none is drawn by its type. The kernel checks that the object type and every named field exist and that each display type applies to the field type (ui.binding.unknown-object, ui.binding.unknown-field, ui.binding.display-type, ui.binding.title)."},
    {"id":"ui-error-message","name":"UI Error Message","kind":"struct","fields":[{"name":"on","type":"ui-error-on"},{"name":"kinds","type":"list<string>"},{"name":"text","type":"string"},{"name":"fallback","type":"string","optional":true},{"name":"field","type":"ui-error-field","optional":true},{"name":"applies-to","type":"list<string>"}],"description":"The wording of a refusal of a tenant form or action: of a failed check of one of kinds (on check) or of an error code (on error); empty kinds words every other one. applies-to: the forms and actions it words, before the messages for all; empty: all of them."},
    {"id":"ui-error-on","name":"UI Error On","kind":"enum","values":["check","error"],"description":"What an error message words: a failed check of the reply, or its error code."},
    {"id":"ui-error-field","name":"UI Error Field","kind":"enum","values":["name","prefix"],"description":"The field of a form an error message is shown on: the field the check names, or the field whose name starts the check's name."},
    {"id":"segment-key","name":"segment-key","kind":"id","repr":"string","description":"The id of a segment inside a bundle, [a-z][a-z0-9_]*, at most 64 bytes. The segment-id of an installed segment is derived from the tenant and this key (D-6583).","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64}},
    {"id":"segment-decl","name":"Segment Decl","kind":"struct","fields":[{"name":"name","type":"string"},{"name":"subject-type","type":"object-type-id"},{"name":"predicate","type":"expression"},{"name":"refresh-seconds","type":"u32","optional":true},{"name":"principal-field","type":"field-id","optional":true},{"name":"visible-to-members","type":"bool","optional":true}],"description":"A segment as a bundle declares it; the same inputs as define-segment, without the id, which is derived from the tenant and the key (D-6582). Fields. refresh-seconds: Required when the predicate reads the time: at least 60 and at most 86400 (define-segment). principal-field: The required unique string field of the subject type that holds the principal (SEG-1548); the field principal when absent. visible-to-members: Whether its members may list it; false when absent (SEG-1540)."},
    {"id":"ledger-unit-decl","name":"Ledger Unit Decl","kind":"struct","fields":[{"name":"unit","type":"ledger-unit"},{"name":"description","type":"string"},{"name":"expiry","type":"ledger-expiry","optional":true}],"description":"A ledger unit as a bundle declares it; the inputs of declare-ledger-unit. expiry, when the unit has one, says how its credits expire (D-6553); an expiry is one to thirty-six periods."},
    {"id":"ledger-pool-decl","name":"Ledger Pool Decl","kind":"struct","fields":[{"name":"pool","type":"ledger-pool-name"},{"name":"description","type":"string"}],"description":"A ledger pool as a bundle declares it; the inputs of declare-ledger-pool."},
    {"id":"mail-template-decl","name":"Mail Template Decl","kind":"struct","fields":[{"name":"template","type":"template-id"},{"name":"subject","type":"string"},{"name":"body","type":"structured-blocks"}],"description":"A mail template as a bundle declares it; the inputs of define-mail-template."},
    {"id":"notice-template-decl","name":"Notice Template Decl","kind":"struct","fields":[{"name":"template","type":"template-id"},{"name":"title","type":"string"},{"name":"body","type":"structured-blocks"}],"description":"A notice template as a bundle declares it: the text of an inbox notice that names the template, with the token syntax of a mail template."},
    {"id":"token-decl","name":"Token Decl","kind":"struct","fields":[{"name":"name","type":"string"},{"name":"expression","type":"expression"},{"name":"fallback","type":"string"}],"description":"A token as a bundle declares it; the inputs of define-token."},
    {"id":"capability-def","name":"Capability Def","kind":"struct","fields":[{"name":"id","type":"capability-name"},{"name":"name","type":"string"},{"name":"description","type":"string"}],"description":"A capability a product declares (D-6590). The id begins with the namespace of its product, and the capability guards only the operations of that product."},
    {"id":"bundle-sections","name":"Bundle Sections","kind":"struct","fields":[{"name":"objects","type":"map<object-type-id, object-type-def>","optional":true},{"name":"roles","type":"map<role-id, role-def>","optional":true},{"name":"role-permissions","type":"map<role-id, list<permission>>","optional":true},{"name":"capabilities","type":"list<capability-def>","optional":true},{"name":"policies","type":"map<policy-id, policy-def>","optional":true},{"name":"queries","type":"map<query-id, query-def>","optional":true},{"name":"views","type":"map<view-id, view-def>","optional":true},{"name":"workflows","type":"map<workflow-id, workflow-def>","optional":true},{"name":"segments","type":"map<segment-key, segment-decl>","optional":true},{"name":"settings","type":"list<setting-def>","optional":true},{"name":"ledger-units","type":"list<ledger-unit-decl>","optional":true},{"name":"ledger-pools","type":"list<ledger-pool-decl>","optional":true},{"name":"ledger-limits","type":"list<ledger-limit>","optional":true},{"name":"mail-templates","type":"list<mail-template-decl>","optional":true},{"name":"notice-templates","type":"list<notice-template-decl>","optional":true},{"name":"tokens","type":"list<token-decl>","optional":true},{"name":"triggers","type":"list<trigger-def>","optional":true},{"name":"automations","type":"list<automation-def>","optional":true},{"name":"operations","type":"list<tenant-operation-def>","optional":true},{"name":"event-kinds","type":"list<event-kind-decl>","optional":true},{"name":"ui","type":"map<string, ui-element>","optional":true}],"description":"ui: The interface elements of the product, by id (D-8250, INT-3250). The sections of a tenant bundle, one for each kind of entity a tenant declares (D-6580). A section a bundle does not use is left out. Every entry is declared metadata, never code (INT-155), and every id in it is local to the product: install namespaces it (D-6582). Fields. objects: Record types, with their fields, constraints, retention, publication and language declarations. settings: Setting definitions of the product (SET-001); a definition with the name of a platform definition is refused (SET-003). ledger-limits: The pools and limits of the product, applied after its units and pools exist. triggers: The triggers of the product (D-6520, WFL-1520). automations: The automations of the product (D-6521). operations: The composite operations of the product (D-6546). event-kinds: The event kinds the product declares, which a trigger may select (SCH-1576, INT-3203)."},
    {"id":"personal-kind","name":"Personal Kind","kind":"enum","values":["name","email-address","phone-number","postal-address","identifier","date-of-birth","location","financial","special-category","free-text","file","other"],"description":"The kind of personal data a field holds (PRV-379). free-text is prose that a person wrote, rich text included; file is a file a person supplied; special-category is health, belief, biometric and the other categories that law names."},
    {"id":"data-subject","name":"Data Subject","kind":"union","variants":[{"name":"creator"},{"name":"field","fields":[{"name":"field","type":"field-id"}]}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"Whose data a field holds. creator: the principal that created the record. field: the principal named by another field of the same record, which holds a principal id or a reference to the record of a person (D-6584)."},
    {"id":"personal-declaration","name":"Personal Declaration","kind":"struct","fields":[{"name":"kind","type":"personal-kind"},{"name":"subject","type":"data-subject"},{"name":"searchable","type":"bool"}],"description":"The personal data of a field of a tenant record type. The field is sealed under the key of its subject (PRV-358). Fields. searchable: True when the search index may hold the field. Default false: the index holds no value of a personal field that is not searchable (D-6585)."},
    {"id":"retention-start","name":"Retention Start","kind":"union","variants":[{"name":"created"},{"name":"last-changed"},{"name":"field","fields":[{"name":"field","type":"field-id"}]}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"What a retention period counts from: the creation of the record, its last change, or a timestamp field of the record."},
    {"id":"retention-rule","name":"Retention Rule","kind":"struct","fields":[{"name":"days","type":"u32"},{"name":"from","type":"retention-start"}],"description":"How long records of a type are kept; a record whose period has ended is deleted by a scheduled job (PRV-357), with the reach of an erasure (PRV-1586). Fields. days: The period the type asks for; the tenant policy sets it within the bounds of the platform (PRV-356)."},
    {"id":"rendition-def","name":"Rendition Def","kind":"struct","fields":[{"name":"name","type":"string"},{"name":"width","type":"u32"},{"name":"height","type":"u32"},{"name":"format","type":"string"}],"description":"A rendition a file field declares: a name, the largest width and height in pixels, and the output media type. Produced by a job of the upload scanner (CMS-009, D-6589)."},
    {"id":"language-tag","name":"language-tag","kind":"id","repr":"string","description":"A language by its BCP 47 tag in lower case for the language and the script or region as written: en, fr-ca, zh-hant.","constraints":{"pattern":"^[a-z]{2,3}(-[a-z0-9]{2,8})*$","maxLength":35}},
    {"id":"publication-def","name":"Publication Def","kind":"struct","fields":[{"name":"state-field","type":"field-id"},{"name":"draft","type":"string"},{"name":"published","type":"string"},{"name":"withdrawn","type":"string"},{"name":"in-review","type":"string","optional":true},{"name":"approved","type":"string","optional":true},{"name":"time-field","type":"field-id","optional":true},{"name":"review-workflow","type":"workflow-id","optional":true},{"name":"review-run-field","type":"field-id","optional":true}],"description":"The publication state and time of a content type (D-6592). A type that declares it has the contracts publish-content, withdraw-content, submit-for-review and schedule-publication; every state named is a state of the workflow of state-field. Fields. state-field: The workflow field of the type that holds its publication state. in-review: The state of a record submitted for review; absent when the type is not marked for review. approved: The state of a record whose review ended in approval; absent when the type is not marked for review. time-field: A timestamp field that holds the publication time; a record with a value in it is published at that time (WFL-011). review-workflow: The workflow whose run is the review of a record (CMS-156). review-run-field: The field that holds the run-id of the review in progress."},
    {"id":"tenant-catalogue","name":"Tenant Catalogue","kind":"struct","fields":[{"name":"products","type":"map<product-id, installed-product>","optional":true},{"name":"capabilities","type":"map<capability-name, capability-def>","optional":true},{"name":"segments","type":"map<segment-key, segment-decl>","optional":true},{"name":"settings","type":"map<setting-id, setting-def>","optional":true},{"name":"ledger-units","type":"map<ledger-unit, ledger-unit-decl>","optional":true},{"name":"ledger-pools","type":"map<ledger-pool-name, ledger-pool-decl>","optional":true},{"name":"ledger-limits","type":"list<ledger-limit>","optional":true},{"name":"mail-templates","type":"map<template-id, mail-template-decl>","optional":true},{"name":"notice-templates","type":"map<template-id, notice-template-decl>","optional":true},{"name":"tokens","type":"map<string, token-decl>","optional":true}],"description":"What a tenant declares beyond its schema: the products installed with the entities each owns, the capabilities, segments, setting definitions, ledger units, pools and limits, mail and notice templates and tokens (D-6580, D-6582). It is held beside the tenant schema and changes in the same commit as the schema, so a product installs, upgrades or removes as one change (D-6581). The tenant schema and schema-change are unchanged, so no schema hash changes and no kernel function over a schema change has to. Fields. products: The products installed in the tenant, each with the entities it owns (D-6582). capabilities: Capabilities of installed products (D-6590). Superseded for products, mail templates, notice templates and tokens by D-7341: the kernel holds them as members of tenant-schema, changed by schema changes of one change-schema intent; this type states the sections of the catalogue that a product may fill."},
    {"id":"tenant-config-change","name":"Tenant Config Change","kind":"union","variants":[{"name":"define-capability","newtype":true,"fields":[{"name":"value","type":"capability-def"}]},{"name":"remove-capability","newtype":true,"fields":[{"name":"value","type":"capability-name"}]},{"name":"define-segment","fields":[{"name":"key","type":"segment-key"},{"name":"segment","type":"segment-decl"}]},{"name":"remove-segment","newtype":true,"fields":[{"name":"value","type":"segment-key"}]},{"name":"define-setting","newtype":true,"fields":[{"name":"value","type":"setting-def"}]},{"name":"remove-setting","newtype":true,"fields":[{"name":"value","type":"setting-id"}]},{"name":"declare-ledger-unit","newtype":true,"fields":[{"name":"value","type":"ledger-unit-decl"}]},{"name":"declare-ledger-pool","newtype":true,"fields":[{"name":"value","type":"ledger-pool-decl"}]},{"name":"set-ledger-limit","newtype":true,"fields":[{"name":"value","type":"ledger-limit"}]},{"name":"remove-ledger-limit","newtype":true,"fields":[{"name":"value","type":"ledger-limit"}]},{"name":"define-mail-template","newtype":true,"fields":[{"name":"value","type":"mail-template-decl"}]},{"name":"remove-mail-template","newtype":true,"fields":[{"name":"value","type":"template-id"}]},{"name":"define-notice-template","newtype":true,"fields":[{"name":"value","type":"notice-template-decl"}]},{"name":"remove-notice-template","newtype":true,"fields":[{"name":"value","type":"template-id"}]},{"name":"define-token","newtype":true,"fields":[{"name":"value","type":"token-decl"}]},{"name":"remove-token","newtype":true,"fields":[{"name":"value","type":"string"}]}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"The edits of the tenant catalogue that a bundle makes: capabilities, segments, settings, ledger units, pools and limits, mail and notice templates and tokens. They commit together with the schema-change edits of the same product change (D-6581). The platform session contracts define-segment, declare-ledger-unit, declare-ledger-pool, set-ledger-limit, setting-save-definition, define-mail-template and define-token stay and lower onto these edits."},
    {"id":"product-change","name":"Product Change","kind":"union","variants":[{"name":"install","fields":[{"name":"product","type":"product-id"},{"name":"version","type":"string"},{"name":"platform","type":"platform-compat"},{"name":"schema","type":"list<schema-change>"},{"name":"config","type":"list<tenant-config-change>"}]},{"name":"upgrade","fields":[{"name":"product","type":"product-id"},{"name":"from","type":"string"},{"name":"to","type":"string"},{"name":"platform","type":"platform-compat"},{"name":"schema","type":"list<schema-change>"},{"name":"config","type":"list<tenant-config-change>"},{"name":"removes","type":"list<entity-ref>"}]},{"name":"remove","fields":[{"name":"product","type":"product-id"},{"name":"delete-records","type":"bool"}]}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"The change that installs, upgrades or removes one product (D-6581). install and upgrade carry the schema edits and the catalogue edits of the bundle, with ids already namespaced; they are applied together or not at all, in one commit that raises the schema version once. upgrade names the entities of the earlier version that the new one drops. remove carries no edits: the kernel finds the entities the product owns in the catalogue (D-6582). Superseded for products, mail templates, notice templates and tokens by D-7341: the kernel holds them as members of tenant-schema, changed by schema changes of one change-schema intent; this type states the sections of the catalogue that a product may fill."},
    {"id":"config-bound","name":"Config Bound","kind":"enum","values":["platform-fixed","tightenable"],"description":"Who may change a configuration value. platform-fixed: only a platform release changes it. tightenable: the platform holds a default as data, and a realm or a tenant may set a value only on the stricter side of it, never the looser (D-535, D-6594). Each value below states which it is."},
    {"id":"registration-mode","name":"Registration Mode","kind":"enum","values":["open","closed"],"description":"Whether sign-up (CT-057) accepts a new address. closed refuses it with the invalid error; an invitation still creates an account."},
    {"id":"password-policy","name":"Password Policy","kind":"struct","fields":[{"name":"min-length","type":"u32","optional":true},{"name":"breached-list","type":"bool","optional":true}],"description":"The password rules of a realm. Fields. min-length: tightenable: a realm may raise the minimum the platform holds, never lower it. breached-list: platform-fixed true: the breached-password check always applies (IDN-252)."},
    {"id":"realm-settings","name":"Realm Settings","kind":"struct","fields":[{"name":"lockout-failures","type":"u32","optional":true},{"name":"lockout-seconds","type":"u32","optional":true},{"name":"source-failures","type":"u32","optional":true},{"name":"source-window-seconds","type":"u32","optional":true},{"name":"realm-slowdown-failures","type":"u32","optional":true},{"name":"session-idle-seconds","type":"u32","optional":true},{"name":"session-absolute-seconds","type":"u32","optional":true},{"name":"allowed-second-factors","type":"list<credential-kind>","optional":true},{"name":"second-factor-prompts-per-hour","type":"u32","optional":true},{"name":"links-per-address-per-hour","type":"u32","optional":true},{"name":"recovery-delay-seconds","type":"u32","optional":true},{"name":"network-context-recheck","type":"bool","optional":true},{"name":"password","type":"password-policy","optional":true},{"name":"registration","type":"registration-mode","optional":true}],"description":"The numbers and switches of a realm that the text names (D-535, D-700, D-6594). A value left out takes the platform default, which the platform holds as data and changes only by a release. The platform also holds a floor and a ceiling for each number; a value outside them is refused with the invalid error. Fields. lockout-failures: tightenable (lower only). Failed password attempts before an account is refused; the platform default is ten (D-700). lockout-seconds: tightenable (higher only). Seconds an account is refused after the failures; the platform default is thirty (D-700). source-failures: tightenable (lower only). Failed attempts from one source in its window before the source is refused; the platform default is one hundred (D-700). source-window-seconds: tightenable (higher only). The window of source-failures; the platform default is nine hundred (D-700). realm-slowdown-failures: tightenable (lower only). Failures across the realm in the window before attempts are slowed; the platform default is one thousand (D-700). session-idle-seconds: tightenable (lower only). Idle lifetime of a session; the platform default is twelve hours (IDN-259, D-700). session-absolute-seconds: tightenable (lower only). Absolute lifetime of a session; the platform default is fourteen days (IDN-259, D-700). allowed-second-factors: tightenable (a subset only): password is never a second factor. The platform default is passkey and totp (IDN-267, IDN-268). second-factor-prompts-per-hour: tightenable (lower only). Second-factor prompts to one account in an hour; the platform default is five (D-700). links-per-address-per-hour: tightenable (lower only). Sign-in links to one address in an hour; the platform default is five (D-700). recovery-delay-seconds: tightenable (higher only). Delay before account recovery completes; the platform default is twenty-four hours (IDN-265, D-700). network-context-recheck: tightenable (true only). A sensitive operation needs a fresh authentication when the session appears from another network context (IDN-260); the platform default is true. registration: tightenable (closed only). The platform default is open."},
    {"id":"file-limits","name":"File Limits","kind":"struct","fields":[{"name":"max-bytes","type":"u64","optional":true},{"name":"max-decompressed-bytes","type":"u64","optional":true},{"name":"address-max-seconds","type":"u32","optional":true}],"description":"The file limits of a tenant. Fields. max-bytes: tightenable (lower only). The largest file of the tenant; the platform maximum is 104857600 bytes (D-6589). max-decompressed-bytes: tightenable (lower only), at most the limit of the plan (CMS-263). address-max-seconds: tightenable (lower only). The longest expiry of a signed address; the platform maximum is 3600 seconds (D-6588)."},
    {"id":"tenant-settings","name":"Tenant Settings","kind":"struct","fields":[{"name":"audit-retention-days","type":"u32","optional":true},{"name":"outbound-allow-list","type":"list<domain>","optional":true},{"name":"webhook-max-body-bytes","type":"u64","optional":true},{"name":"files","type":"file-limits","optional":true},{"name":"default-language","type":"language-tag","optional":true},{"name":"fallback-languages","type":"list<language-tag>","optional":true},{"name":"forbid-platform-access","type":"bool","optional":true},{"name":"breach-notice-hours","type":"u32","optional":true},{"name":"retention-default-days","type":"u32","optional":true}],"description":"The configuration of a tenant beyond its realm (D-6594). A value left out takes the platform default. Fields. audit-retention-days: tightenable (higher only, up to the platform maximum). How long the audit log of the tenant is kept; the platform minimum is held as data. outbound-allow-list: tightenable (a subset only). The addresses a connector, a webhook or an agent may call (AGS-429); the platform adds none by default. webhook-max-body-bytes: tightenable (lower only). The largest webhook body the tenant accepts. default-language: The language a reader gets when the request names none (D-6593). Set by the tenant. fallback-languages: The languages tried, in order, when a record lacks the language asked for (CMS-010). forbid-platform-access: tightenable (true only). A grant of platform access to the tenant is refused (PRV-369); the platform default is false. breach-notice-hours: tightenable (lower only). The period within which a breach is reported to the owner (PRV-380). retention-default-days: The retention a record type without its own rule takes (PRV-356), within the platform bounds."},
    {"id":"tenant-operation-id","name":"tenant-operation-id","kind":"id","repr":"string","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64},"description":"A tenant operation, [a-z][a-z0-9_]*, at most 64 bytes, unique within its tenant; the operation catalogue lists it as tenant.<id> (D-6549)."},
    {"id":"tenant-operation-input","name":"Tenant operation input","kind":"struct","fields":[{"name":"name","type":"string"},{"name":"ty","type":"field-type"},{"name":"required","type":"bool"},{"name":"label","type":"string","optional":true}],"description":"One typed input of a tenant operation. Its value is read in the operation's expressions as param.<name>, coerced by its field type; a missing required input refuses the invocation (OPR-1540)."},
    {"id":"tenant-operation-invokers","name":"Tenant operation invokers","kind":"struct","fields":[{"name":"signed-in","type":"bool"},{"name":"roles","type":"set<role-id>"}],"description":"Who may invoke a tenant operation (D-6547): every signed-in person of the tenant when signed-in is true, and the holders of the named roles."},
    {"id":"tenant-operation-subject","name":"Tenant operation subject","kind":"struct","fields":[{"name":"object","type":"object-type-id"},{"name":"input","type":"string"}],"description":"The record a tenant operation loads before its conditions: the record of the object type whose id is the named input, read as the record scope of its conditions and steps. An invocation whose subject does not exist, or that the invoker may not read, is refused with not-found."},
    {"id":"tenant-operation-condition","name":"Tenant operation condition","kind":"struct","fields":[{"name":"id","type":"string"},{"name":"expr","type":"expr"},{"name":"error","type":"string"},{"name":"message","type":"string"}],"description":"A condition of a tenant operation, evaluated on the state before any step; false or null refuses the invocation with the code error and the message (OPR-1542)."},
    {"id":"tenant-operation-posting-owner","name":"Tenant operation posting owner","kind":"union","encoding":{"tag":"external","variantCase":"PascalCase"},"variants":[{"name":"invoker"},{"name":"pool","fields":[{"name":"pool","type":"ledger-pool-name"}]},{"name":"principal","fields":[{"name":"principal","type":"expr"}]}],"description":"Whose account a posting step posts to: the invoker's, a pool's, or the principal an expression names."},
    {"id":"tenant-operation-step","name":"Tenant operation step","kind":"union","encoding":{"tag":"external","variantCase":"PascalCase"},"variants":[{"name":"create-record","fields":[{"name":"id","type":"string"},{"name":"object","type":"object-type-id"},{"name":"fields","type":"map<field-id, expr>"}]},{"name":"update-record","fields":[{"name":"id","type":"string"},{"name":"object","type":"object-type-id"},{"name":"record","type":"expr"},{"name":"fields","type":"map<field-id, expr>"}]},{"name":"delete-record","fields":[{"name":"id","type":"string"},{"name":"object","type":"object-type-id"},{"name":"record","type":"expr"}]},{"name":"post-ledger","fields":[{"name":"id","type":"string"},{"name":"owner","type":"tenant-operation-posting-owner"},{"name":"unit","type":"ledger-unit"},{"name":"scope","type":"option<expr>"},{"name":"amount","type":"expr"},{"name":"reason","type":"string"}]}],"description":"One step of a tenant operation (D-6546). Expressions are in the tenant rule language over the inputs (param), the subject record (record), the invoker (principal, has_role), now, balance, in_segment and setting. A later step reads the id of the record an earlier create-record step made as param.<step id> (D-6548)."},
    {"id":"tenant-operation-def","name":"Tenant Operation Def","kind":"struct","metamodel":"definition","fields":[{"name":"id","type":"tenant-operation-id"},{"name":"label","type":"string"},{"name":"inputs","type":"list<tenant-operation-input>"},{"name":"invokers","type":"tenant-operation-invokers"},{"name":"subject","type":"option<tenant-operation-subject>"},{"name":"conditions","type":"list<tenant-operation-condition>"},{"name":"steps","type":"list<tenant-operation-step>"}],"description":"A tenant operation as tenant metadata (D-6546): the value of tenant-schema.operations, written by the schema changes define-operation and remove-operation. At most sixteen steps, at most eight of them post-ledger, each condition at most two hundred nodes (OPR-1549). Defining one is refused unless the definer holds, without a condition, each action on an object type its record steps use and ledger-post when it posts (OPR-1547)."},
    {"id":"tenant-operation-invocation","name":"Tenant operation invocation","kind":"struct","fields":[{"name":"operation","type":"tenant-operation-id"},{"name":"inputs","type":"map<string, value>"},{"name":"dry-run","type":"bool","optional":true}],"description":"One request to run a tenant operation: the operation, its inputs and whether it is a dry run. The idempotency key is the input idempotency-key of the contracts invoke-tenant-operation and decide-tenant-operation, beside it (D-6595). The kernel intent invoke-operation carries the operation, the inputs and that key."},
    {"id":"tenant-operation-result","name":"Tenant operation result","kind":"struct","fields":[{"name":"operation","type":"tenant-operation-id"},{"name":"replayed","type":"bool"},{"name":"created","type":"list<record-id>"},{"name":"changed","type":"list<record-id>"},{"name":"deleted","type":"list<record-id>"},{"name":"entries","type":"list<ledger-entry>"},{"name":"revision","type":"state-revision"}],"description":"What an accepted invocation changed, in step order; replayed when it is the recorded result of an earlier invocation with the same key (OPR-1544)."},
    {"id":"unique-def","name":"Unique Def","kind":"struct","metamodel":"definition","fields":[{"name":"id","type":"constraint-id"},{"name":"fields","type":"list<field-id>"},{"name":"message","type":"string"}],"description":"A composite unique constraint of a tenant object type over two to four of its fields (D-6558), held in object-type-def.unique and changed by the schema changes define-unique and remove-unique. A create or update that gives two records of the type equal values in every field is refused naming the constraint (CMS-1554); a record with null in any of the fields is not constrained (CMS-1555)."},
    {"id":"ledger-scope","name":"Ledger scope","kind":"scalar","repr":"string","constraints":{"maxLength":128},"description":"The scope of a ledger account that the poster chooses, such as the id of a promotion; empty by default (D-6551). It holds no personal data."},
    {"id":"ledger-expiry","name":"Ledger expiry","kind":"struct","fields":[{"name":"period","type":"ledger-period"},{"name":"periods","type":"u32"}],"description":"How credits of a unit expire (D-6553): a credit expires when the given number of periods, one to thirty-six, after the period that contains it have ended."},
    {"id":"ledger-bucket","name":"Ledger bucket","kind":"struct","fields":[{"name":"period-start","type":"timestamp"},{"name":"remaining","type":"u64"}],"description":"The credit of one period that an account has not yet spent or expired (D-6553)."},
    {"id":"ledger-order","name":"ledger-order","kind":"enum","values":["greatest-first","least-first"],"description":"The order of a ranked listing of accounts."},
    {"id":"ledger-account-rank","name":"Ledger account rank","kind":"struct","fields":[{"name":"owner","type":"ledger-owner"},{"name":"scope","type":"ledger-scope"},{"name":"balance","type":"ledger-amount"},{"name":"last-sequence","type":"u64"}],"description":"One account in a ranked listing (LDG-1543)."},
    {"id":"ledger-definitions","name":"Ledger definitions","kind":"struct","fields":[{"name":"units","type":"list<ledger-unit>"},{"name":"pools","type":"list<ledger-pool-name>"},{"name":"limits","type":"list<ledger-limit>"}],"description":"The units, pools and limits a tenant has declared (LDG-1548)."},
    {"id":"ledger-definition-ref","name":"Ledger definition ref","kind":"union","encoding":{"tag":"external","variantCase":"snake_case"},"variants":[{"name":"unit","fields":[{"name":"unit","type":"ledger-unit"}]},{"name":"pool","fields":[{"name":"pool","type":"ledger-pool-name"}]},{"name":"limit","fields":[{"name":"unit","type":"ledger-unit"},{"name":"owner","type":"ledger-owner","optional":true},{"name":"scope","type":"ledger-scope","optional":true}]}],"description":"A unit, a pool or a limit to remove (LDG-1549)."},
    {"id":"segment-summary","name":"Segment summary","kind":"struct","fields":[{"name":"segment","type":"segment-id"},{"name":"name","type":"string"},{"name":"since","type":"timestamp"}],"description":"A segment the caller belongs to, in the answer of list-my-segments (SEG-1540)."},
    {"id":"segment-count","name":"Segment count","kind":"struct","fields":[{"name":"segment","type":"segment-id"},{"name":"count","type":"u64"},{"name":"examined","type":"u32"}],"description":"The answer of count-segment-members: the members the reader may read, and the memberships examined (0 when the kept count answered)."},
    {"id":"segment-preview","name":"Segment preview","kind":"struct","fields":[{"name":"matched","type":"u32"},{"name":"examined","type":"u32"}],"description":"The counts in the answer of preview-segment-predicate (SEG-1542); the cursor of the next persons is its next output."},
    {"id":"trigger-id","name":"trigger-id","kind":"id","repr":"string","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64},"description":"A trigger of a tenant, [a-z][a-z0-9_]*, at most 64 bytes (D-6520)."},
    {"id":"step-name","name":"step-name","kind":"id","repr":"string","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64},"description":"The name of one step of an automation, [a-z][a-z0-9_]*, at most 64 bytes. The outputs of the step are bound in later steps as param.<step-name>_<output> (D-6523)."},
    {"id":"trigger-event","name":"Trigger event","kind":"union","encoding":{"tag":"external","variantCase":"PascalCase"},"description":"The published catalogue of the events a trigger may subscribe to (INT-153, D-6522). Each variant names a domain event kind and what narrows it. The parameters each binds for the condition and the run are stated in D-6523: record events bind the scopes old and new; every event binds param.seq, param.at and param.hop. declared-event selects the events of a kind that a tenant declares (SCH-1576): the kind begins with app., and the event binds param.kind.","variants":[{"name":"record-created","fields":[{"name":"object","type":"object-type-id"}]},{"name":"record-updated","fields":[{"name":"object","type":"object-type-id"},{"name":"transition","type":"string","optional":true}]},{"name":"record-deleted","fields":[{"name":"object","type":"object-type-id"}]},{"name":"segment-entered","fields":[{"name":"segment","type":"segment-id"}]},{"name":"segment-exited","fields":[{"name":"segment","type":"segment-id"}]},{"name":"ledger-posted","fields":[{"name":"unit","type":"ledger-unit"}]},{"name":"setting-changed","fields":[{"name":"setting","type":"setting-id"}]},{"name":"schedule-due","fields":[{"name":"schedule","type":"schedule-id"}]},{"name":"inbound-webhook","fields":[{"name":"endpoint","type":"string"}]},{"name":"declared-event","fields":[{"name":"kind","type":"event-kind"}]}]},
    {"id":"trigger-def","name":"Trigger definition","kind":"struct","description":"A trigger as tenant metadata (WFL-1520), held in tenant-schema.triggers and changed by define-trigger and remove-trigger: the event it subscribes to, a condition in the tenant rule language evaluated in the transaction of the event (D-6524), and the automation it starts. An automation is named by a workflow-id (D-6521). The kernel refuses a trigger whose automation, object type or transition does not exist, or whose condition does not check against the parameters its event binds (D-6523) as a truth value; a tenant holds at most one hundred. defined-by and defined-at are written by define-trigger from the context, never from the input (D-7204, WFL-2201).","fields":[{"name":"id","type":"trigger-id"},{"name":"on","type":"trigger-event"},{"name":"condition","type":"expr","optional":true},{"name":"automation","type":"workflow-id"},{"name":"paused","type":"bool","optional":true},{"name":"defined-by","type":"principal-id","optional":true},{"name":"defined-at","type":"timestamp","optional":true}]},
    {"id":"run-as","name":"Run-as authority","kind":"struct","description":"The authority of an automation (D-6525): the tenant roles its automation principal, automation:<workflow-id>, holds. Each role must be one the definer may confer under ADM-152 when the automation is defined, and is checked again whenever the definer's authority changes (WFL-1529).","fields":[{"name":"roles","type":"set<role-id>"}]},
    {"id":"step-retry","name":"Step retry policy","kind":"struct","description":"How a failed attempt of a step is retried (SCH-1525, D-6529): at most attempts attempts in all, from 1 to 10 (default 5); the delay before the second attempt is first-delay (default 10 seconds) and doubles for each later attempt up to max-delay (default one hour, at most one day). Durations are in milliseconds.","fields":[{"name":"attempts","type":"u32"},{"name":"first-delay","type":"duration","optional":true},{"name":"max-delay","type":"duration","optional":true}]},
    {"id":"automation-step","name":"Automation step","kind":"union","encoding":{"tag":"external","variantCase":"PascalCase"},"description":"The published step catalogue (D-506, INT-153, D-6522): every kind of step an automation may name, with its typed inputs. An expression input is an expression of the tenant rule language (written as text in a product file), evaluated against the run's parameters (D-6523). The outputs of each kind are the variant of automation-step-result of the same name. post-ledger carries out a posting in the atomic operation form that WG-5032 specifies; send-mail and create-notice carry out the send that WG-5033 specifies; call-webhook is a signed delivery through the outbound gate (WFL-010, WFL-250). send-mail names exactly one target: to (an expression that gives a principal id, or an address when it holds an @), address (an expression that gives an address) or segment, and create-notice exactly one of to and segment, because an address has no inbox (NTF-3200). send-digest has the fields of send-digest-step (NTF-1572); its template is a mail template, and its recipient, when present, is a principal or a segment, never an address.","variants":[{"name":"create-record","fields":[{"name":"object","type":"object-type-id"},{"name":"fields","type":"map<field-id, expr>"}]},{"name":"update-record","fields":[{"name":"object","type":"object-type-id"},{"name":"record","type":"expr"},{"name":"fields","type":"map<field-id, expr>"}]},{"name":"delete-record","fields":[{"name":"object","type":"object-type-id"},{"name":"record","type":"expr"}]},{"name":"post-ledger","fields":[{"name":"owner","type":"expr"},{"name":"unit","type":"ledger-unit"},{"name":"amount","type":"expr"},{"name":"reason","type":"string"}]},{"name":"send-mail","fields":[{"name":"template","type":"template-id"},{"name":"to","type":"expr","optional":true},{"name":"address","type":"expr","optional":true},{"name":"segment","type":"segment-id","optional":true},{"name":"category","type":"string","optional":true}]},{"name":"create-notice","fields":[{"name":"template","type":"template-id"},{"name":"to","type":"expr","optional":true},{"name":"segment","type":"segment-id","optional":true},{"name":"record","type":"expr","optional":true}]},{"name":"send-digest","fields":[{"name":"category","type":"message-category-id"},{"name":"template","type":"template-id"},{"name":"since","type":"timestamp"},{"name":"until","type":"timestamp"},{"name":"recipient","type":"send-recipient","optional":true},{"name":"reference","type":"send-reference","optional":true},{"name":"idempotency-key","type":"string","optional":true}]},{"name":"call-webhook","fields":[{"name":"subscription","type":"identifier"},{"name":"body","type":"map<string, expr>"}]},{"name":"wait-for","fields":[{"name":"duration","type":"duration"}]},{"name":"wait-until","fields":[{"name":"at","type":"expr"}]},{"name":"branch","fields":[{"name":"condition","type":"expr"},{"name":"object","type":"object-type-id","optional":true},{"name":"record","type":"expr","optional":true},{"name":"then","type":"step-name"},{"name":"else","type":"step-name"}]},{"name":"fan-out","fields":[{"name":"segment","type":"segment-id"},{"name":"batch","type":"u32"},{"name":"each","type":"step-name"}]},{"name":"request-approval","fields":[{"name":"policy","type":"policy-id"},{"name":"timeout","type":"duration"},{"name":"approved","type":"step-name"},{"name":"refused","type":"step-name"}]},{"name":"end"},{"name":"invoke-operation","fields":[{"name":"operation","type":"tenant-operation-id"},{"name":"inputs","type":"map<string, expr>"}]}]},
    {"id":"automation-step-result","name":"Automation step result","kind":"union","encoding":{"tag":"external","variantCase":"PascalCase"},"description":"The typed outputs of a completed step, one variant for each variant of automation-step (WFL-1523). Each field is bound in later steps as param.<step-name>_<field>, with hyphens written as underscores.","variants":[{"name":"create-record","fields":[{"name":"record","type":"record-id"},{"name":"version","type":"u64"}]},{"name":"update-record","fields":[{"name":"version","type":"u64"}]},{"name":"delete-record"},{"name":"post-ledger","fields":[{"name":"entry-sequence","type":"u64"},{"name":"balance","type":"ledger-amount"}]},{"name":"send-mail","fields":[{"name":"message","type":"identifier"}]},{"name":"create-notice","fields":[{"name":"item","type":"identifier"}]},{"name":"send-digest","fields":[{"name":"messages","type":"u32"}]},{"name":"call-webhook","fields":[{"name":"delivery","type":"identifier"},{"name":"status","type":"u32"}]},{"name":"wait-for"},{"name":"wait-until"},{"name":"branch","fields":[{"name":"taken","type":"step-name"}]},{"name":"fan-out","fields":[{"name":"members","type":"u64"},{"name":"batches","type":"u32"}]},{"name":"request-approval","fields":[{"name":"approved","type":"bool"},{"name":"by","type":"option<principal-id>","optional":true}]},{"name":"end"},{"name":"invoke-operation","fields":[{"name":"created","type":"list<record-id>"},{"name":"changed","type":"list<record-id>"},{"name":"deleted","type":"list<record-id>"}]}]},
    {"id":"automation-step-def","name":"Automation step definition","kind":"struct","description":"One named step of an automation: its action from the catalogue, the step that follows it (none for end, branch, fan-out's members and request-approval, which name their own), its retry policy, the time one attempt may take (default 60 seconds, at most 15 minutes; waits and approvals have no attempt time), and the step that undoes it when a later step fails (WFL-005).","fields":[{"name":"action","type":"automation-step"},{"name":"next","type":"step-name","optional":true},{"name":"retry","type":"step-retry","optional":true},{"name":"timeout","type":"duration","optional":true},{"name":"compensate","type":"step-name","optional":true}]},
    {"id":"automation-def","name":"Automation definition","kind":"struct","description":"An automation as tenant metadata (D-6520, D-6521): a workflow of declared steps that the automation worker runs, one job per step attempt (D-526). id shares the namespace of workflow-def ids: a tenant has no field workflow and automation with one id. run-key, when present, is evaluated on the starting event and an automation starts one run per distinct value for as long as it exists (SCH-1536). At most 50 steps. Held in tenant-schema.automations and changed by define-automation and remove-automation; its expressions read the parameters of D-6523, param.member in a fan-out and param.<step>_<output> for each output of each of its steps. defined-by and defined-at are written by define-automation from the context, never from the input: the acting person (none for the system) and the time (D-7204, WFL-2201). suspended-for, when present, is the role of the run-as the definer may no longer confer: the automation is suspended, its principal holds no run-as role and its triggers decline with run-as-suspended, until a principal who may confer every role defines it again (D-6526, WFL-1529). state, when present, is draft until activate-workflow activates the automation (WFL-2684, D-7681); an automation without a state is active.","fields":[{"name":"id","type":"workflow-id"},{"name":"label","type":"string"},{"name":"run-as","type":"run-as"},{"name":"run-key","type":"expr","optional":true},{"name":"start","type":"step-name"},{"name":"steps","type":"map<step-name, automation-step-def>"},{"name":"defined-by","type":"principal-id","optional":true},{"name":"defined-at","type":"timestamp","optional":true},{"name":"suspended-for","type":"role-id","optional":true},{"name":"state","type":"automation-state","optional":true}]},
    {"id":"automation-state","name":"automation-state","kind":"enum","values":["draft","active","suspended"],"description":"An automation is a draft until activate-workflow activates it (WFL-002), active while it may start runs, and suspended when its definer can no longer confer a role of its run-as (WFL-1529)."},
    {"id":"step-run-state","name":"step-run-state","kind":"enum","values":["due","leased","waiting","completed","failed","compensated","cancelled"],"description":"Where one step of a run is: due as a job, leased by a worker, waiting for its time or an approval, or ended."},
    {"id":"automation-exception-kind","name":"automation-exception-kind","kind":"enum","values":["declined","held","parked","dead-lettered"],"description":"declined: a trigger created no job; held: a job was created due at the next day of the job quota (SCH-1535); parked: an event that kept failing was set aside (D-519); dead-lettered: a step exhausted its attempts (SCH-1525)."},
    {"id":"automation-exception-reason","name":"automation-exception-reason","kind":"enum","values":["hop-limit","job-quota","run-as-suspended","automation-inactive","automation-removed","run-key-repeated","condition-failed","event-parked","attempts-exhausted","definition-changed"],"description":"Why an exception record was written (SCH-1532). condition-failed is a condition that could not be evaluated (a missing field, a type error); a condition that is false writes nothing (D-6530)."},
    {"id":"exception-action","name":"exception-action","kind":"enum","values":["release","drop"],"description":"What the tenant owner does with a parked or dead-lettered exception: release it (the event is offered again, or the step gets a new attempt) or drop it."},
    {"id":"automation-run-summary","name":"Automation run summary","kind":"struct","description":"A run as list-automation-runs answers it.","fields":[{"name":"run","type":"run-id"},{"name":"automation","type":"workflow-id"},{"name":"trigger","type":"option<trigger-id>","optional":true},{"name":"state","type":"run-state"},{"name":"step","type":"option<step-name>","optional":true},{"name":"hop","type":"u64"},{"name":"caused-by","type":"principal-id"},{"name":"on-behalf-of","type":"option<principal-id>","optional":true},{"name":"started-at","type":"timestamp"},{"name":"ended-at","type":"option<timestamp>","optional":true},{"name":"error","type":"option<string>","optional":true},{"name":"started-by","type":"option<principal-id>","optional":true}]},
    {"id":"automation-step-summary","name":"Automation step summary","kind":"struct","description":"One step of a run as list-automation-steps answers it.","fields":[{"name":"sequence","type":"u64"},{"name":"step","type":"step-name"},{"name":"member","type":"option<principal-id>","optional":true},{"name":"state","type":"step-run-state"},{"name":"attempts","type":"u32"},{"name":"result","type":"option<automation-step-result>","optional":true},{"name":"errors","type":"list<string>"},{"name":"started-at","type":"timestamp"},{"name":"ended-at","type":"option<timestamp>","optional":true},{"name":"approval","type":"option<automation-approval>","optional":true}]},
    {"id":"automation-exception-summary","name":"Automation exception summary","kind":"struct","description":"One exception record as list-automation-exceptions answers it.","fields":[{"name":"exception","type":"identifier"},{"name":"kind","type":"automation-exception-kind"},{"name":"reason","type":"automation-exception-reason"},{"name":"trigger","type":"option<trigger-id>","optional":true},{"name":"automation","type":"option<workflow-id>","optional":true},{"name":"run","type":"option<run-id>","optional":true},{"name":"step","type":"option<step-name>","optional":true},{"name":"event-seq","type":"option<u64>","optional":true},{"name":"hop","type":"option<u64>","optional":true},{"name":"at","type":"timestamp"},{"name":"detail","type":"string"},{"name":"settled","type":"bool"}]},
    {"id":"arith-op","name":"Arith Op","kind":"union","variants":[{"name":"add"},{"name":"sub"},{"name":"mul"}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"strata_kernel::ArithOp: the operator of checked integer and time arithmetic (D-6540, D-6541)."},
    {"id":"duration-unit","name":"Duration Unit","kind":"union","variants":[{"name":"days"},{"name":"hours"},{"name":"minutes"}],"encoding":{"tag":"external","variantCase":"PascalCase"},"description":"strata_kernel::DurationUnit: the unit days, hours and minutes count in milliseconds (D-6541)."},
    {"id":"operation-scan","name":"Operation scan","kind":"struct","description":"definitions.rs operation_problems, the loop over the steps of a tenant operation: the problems found so far and the parameters the next step may read (the inputs and the ids of the create steps before it).","fields":[{"name":"problems","type":"list<string>"},{"name":"params","type":"list<string>"}]},
    {"id":"aggregate-request","name":"aggregate-request","kind":"struct","fields":[{"name":"query","type":"query-id"},{"name":"aggregate","type":"aggregate-id"},{"name":"params","type":"map<string, value>"},{"name":"filter","type":"map<field-id, value>"}],"description":"strata_kernel::aggregates::run: the request for one aggregate of a named query (AGG-003). params are the arguments of the query, and filter holds the fields the result is narrowed by, each to a value the field has: a field that the query does not declare is refused (AGG-004). It is a type of its own, not a variant of read-request, because the answer is an aggregate-result and not rows."},
    {"id":"erased-record","name":"Erased Record","kind":"struct","fields":[{"name":"object","type":"object-type-id"},{"name":"id","type":"record-id"},{"name":"fields","type":"list<field-id>"}],"description":"One record changed by the erasure of a subject: its object type, its id and the names of the fields cleared. It never holds a value."},
    {"id":"automation-start","name":"Automation start","kind":"struct","description":"What the kernel hands the automation worker for a trigger that starts a run (D-7200): the trigger and its automation, the sequence of the event that started it, the hop count of that event (D-6531), the automation principal its steps act as (caused-by, WFL-1530), the definer whose authority bounds it (on-behalf-of, none for an automation the system defined), the schema version the run starts on (MIG-562), the SHA-256 in hexadecimal of the canonical JSON of the run key value when the automation declares one (D-6534; the worker refuses a repeated key), and the parameters the event binds (D-6523: seq, at, hop and, for record-updated, transition). The record scopes of the event are read from the event by its sequence. Carried by the effect start-automation.","fields":[{"name":"trigger","type":"trigger-id"},{"name":"automation","type":"workflow-id"},{"name":"event-seq","type":"u64"},{"name":"hop","type":"u32"},{"name":"caused-by","type":"principal-id"},{"name":"on-behalf-of","type":"principal-id","optional":true},{"name":"definition-version","type":"schema-version"},{"name":"run-key","type":"string","optional":true},{"name":"params","type":"map<string, value>"}]},
    {"id":"automation-decline","name":"Automation decline","kind":"struct","description":"What the kernel hands the automation worker for a trigger that matched an event and starts no run for a reason that is recorded (D-7200, SCH-1532): the trigger and its automation, the event sequence, its hop count, the reason (hop-limit, run-as-suspended, automation-removed or condition-failed) and a detail of at most 256 characters that names ids and limits only, never a field value. The worker writes it as a declined rec-automation-exception in the commit of the transition. Carried by the effect decline-automation.","fields":[{"name":"trigger","type":"trigger-id"},{"name":"automation","type":"workflow-id"},{"name":"event-seq","type":"u64"},{"name":"hop","type":"u32"},{"name":"reason","type":"automation-exception-reason"},{"name":"detail","type":"string"}]},
    {"id":"setting-override","name":"Setting Override","kind":"struct","fields":[{"name":"setting","type":"setting-id"},{"name":"level","type":"setting-level"},{"name":"subject","type":"string"},{"name":"value","type":"value"},{"name":"revision","type":"u64"},{"name":"set-by","type":"principal-id"},{"name":"set-at","type":"timestamp"}],"description":"One override of a setting at the tenant, a team or a person (D-5040, D-5045): the value, the revision of the setting at the write that made it, and who set it and when. subject is the id of the tenant, of the team or of the person, by the level. The revision is the one a later write names (SET-025). The value is personal data at the person level and is never written to an event or a log (SET-1543). Held in tenant-state.setting-values."},
    {"id":"setting-values","name":"Setting Values","kind":"struct","fields":[{"name":"overrides","type":"map<string, setting-override>"},{"name":"revisions","type":"map<setting-id, u64>"}],"description":"The data of the settings of a tenant: the overrides by the key \"<setting>/<level>/<subject>\", and the revision of each setting at the tenant (SET-051). A revision rises by one at every change of the definition or of an override of its setting, never falls and is never reused, so a write that names the revision it read cannot overwrite a change made after it (SET-025, SET-2303)."},
    {"id":"ledger-period-total","name":"Ledger period total","kind":"struct","description":"The credits posted to an account in the calendar period (UTC) that starts at start, kept for each of the four periods so that a cap per period set later counts the credits already posted in its period (LDG-014, LDG-015, LDG-016).","fields":[{"name":"period","type":"ledger-period"},{"name":"start","type":"timestamp"},{"name":"credits","type":"u64"}]},
    {"id":"ledger-account","name":"Ledger account","kind":"struct","description":"kernel ledger.rs: the header of a ledger account (records rec-ledger-account and rec-ledger-balance as the kernel holds them): its derived id, owner, unit and scope, the balance and the number of its last entry, and the credits of the current periods. A decision loads it without loading the entries (D-5003, K-100). owner is absent once the principal that owned the account has been erased (LDG-027). buckets is the remaining credit of each period, oldest first, kept only for a unit that declares an expiry and absent when none remains (D-6553); the index of accounts due to expire orders by the start of the first.","fields":[{"name":"account","type":"ledger-account-id"},{"name":"owner","type":"ledger-owner","optional":true},{"name":"unit","type":"ledger-unit"},{"name":"scope","type":"ledger-scope"},{"name":"balance","type":"ledger-amount"},{"name":"last-sequence","type":"u64"},{"name":"opened-at","type":"timestamp"},{"name":"periods","type":"list<ledger-period-total>"},{"name":"buckets","type":"list<ledger-bucket>","optional":true}]},
    {"id":"ledger-state","name":"Ledger state","kind":"struct","description":"kernel ledger.rs: the part of the tenant ledger a snapshot holds (tenant-state.ledger): account headers keyed by the text of their id, and for each account (keyed the same way) the entries loaded, in the order of their numbers. A complete snapshot holds every account and every entry; a partial one holds what its ledger needs named. limits holds the limits of single accounts the snapshot holds (WG-5172, D-6554): they live in the ledger and not in the schema, and a snapshot holds the one a decision named by its need.","fields":[{"name":"accounts","type":"map<string, ledger-account>"},{"name":"entries","type":"map<string, list<ledger-entry>>"},{"name":"limits","type":"list<ledger-limit>","optional":true}]},
    {"id":"ledger-limit-walk","name":"Ledger limit walk","kind":"struct","description":"kernel ledger.rs check_limits: where the check of the account limits among a list of schema changes stands. evidence is the evidence of the draft and the checks written so far; held, once a change has needed them, the limits of single accounts the tenant holds as the changes before it leave them.","fields":[{"name":"evidence","type":"list<check>"},{"name":"held","type":"list<ledger-limit>","optional":true}]},
    {"id":"ledger-declarations","name":"Ledger declarations","kind":"struct","description":"kernel ledger.rs: the units, pools and limits of units a tenant has declared (tenant-schema.ledger), changed by the schema changes declare-ledger-unit, declare-ledger-pool, set-ledger-limit and remove-ledger-definition. At most 64 units and 64 pools (LDG-1550). A limit without an owner is the limit of its unit (LDG-011, LDG-012). The limit of one account is not held here: it is kept in the ledger (ledger-state.limits), at most 10,000 of them (LDG-1550, D-7881).","fields":[{"name":"units","type":"map<ledger-unit, ledger-unit-decl>"},{"name":"pools","type":"map<ledger-pool-name, ledger-pool-decl>"},{"name":"limits","type":"list<ledger-limit>"}]},
    {"id":"ledger-need","name":"Ledger need","kind":"union","encoding":{"tag":"external","variantCase":"PascalCase"},"description":"kernel ledger.rs: a piece of the ledger a decision or read needs (need.ledger). account is the header of one account; entry-by-key the entry of an account with that idempotency key, when there is one; entries at most limit entries of an account numbered above after, in order; ranked the first offset + limit accounts of a unit and scope in order of balance, equal balances in ascending order of the owner (LDG-1543); unit-used and pool-used one account of the unit or of the pool, when there is one (LDG-1549). limit is the limit of the one account of that owner, unit and scope, when it has one (D-6554); limits every limit of single accounts, to count and to list them; expiring at most limit accounts of the unit whose oldest bucket starts at or before cutoff, in order of that start and then of the account id, found through an index (D-6553).","variants":[{"name":"account","fields":[{"name":"account","type":"ledger-account-id"}]},{"name":"entry-by-key","fields":[{"name":"account","type":"ledger-account-id"},{"name":"key","type":"string"}]},{"name":"entries","fields":[{"name":"account","type":"ledger-account-id"},{"name":"after","type":"u64","optional":true},{"name":"limit","type":"u32"}]},{"name":"ranked","fields":[{"name":"unit","type":"ledger-unit"},{"name":"scope","type":"ledger-scope"},{"name":"order","type":"ledger-order"},{"name":"offset","type":"u32"},{"name":"limit","type":"u32"}]},{"name":"unit-used","fields":[{"name":"unit","type":"ledger-unit"}]},{"name":"pool-used","fields":[{"name":"pool","type":"ledger-pool-name"}]},{"name":"limit","fields":[{"name":"owner","type":"ledger-owner"},{"name":"unit","type":"ledger-unit"},{"name":"scope","type":"ledger-scope"}]},{"name":"limits"},{"name":"expiring","fields":[{"name":"unit","type":"ledger-unit"},{"name":"cutoff","type":"i64"},{"name":"limit","type":"u32"}]}]},
    {"id":"ledger-delta","name":"Ledger delta","kind":"union","encoding":{"tag":"external","variantCase":"PascalCase"},"description":"kernel ledger.rs: one change to the ledger (delta-op.ledger). put-account writes the header of an account; append-entry adds an entry, numbered one above the last of its account. No change rewrites or removes an entry (LDG-022), and only the commit of a posting writes a header (LDG-021). put-limit writes the limit of one account and remove-limit removes it; the commit of a schema change that sets or removes such a limit writes them (WG-5172).","variants":[{"name":"put-account","newtype":true,"fields":[{"name":"value","type":"ledger-account"}]},{"name":"append-entry","newtype":true,"fields":[{"name":"value","type":"ledger-entry"}]},{"name":"put-limit","newtype":true,"fields":[{"name":"value","type":"ledger-limit"}]},{"name":"remove-limit","fields":[{"name":"owner","type":"ledger-owner"},{"name":"unit","type":"ledger-unit"},{"name":"scope","type":"ledger-scope"}]}]},
    {"id":"index-bound","name":"Index Bound","kind":"struct","fields":[{"name":"value","type":"value"},{"name":"inclusive","type":"bool"}],"description":"strata_kernel::query_plan::IndexBound: one end of the values an index page holds, in the order of Value; inclusive says whether the value itself is held (KRN-2525)."},
    {"id":"index-position","name":"Index Position","kind":"struct","fields":[{"name":"value","type":"value"},{"name":"id","type":"record-id"}],"description":"strata_kernel::query_plan::IndexPosition: a place in the order of an index page, the value of the indexed field and the record id (KRN-2521, KRN-2525)."},
    {"id":"referrer-hit","name":"Referrer hit","kind":"struct","description":"transition.rs delete_record: a record whose field refers to the record being deleted, with the referrer (field) that does.","fields":[{"name":"referrer","type":"referrer"},{"name":"record","type":"record"}]},
    {"id":"delete-scan","name":"Delete scan","kind":"struct","description":"transition.rs delete_record, the loop over the referrers of the deleted record: the draft with the evidence so far, and the records found that refer to it, one entry per referrer field and record.","fields":[{"name":"draft","type":"draft"},{"name":"hits","type":"list<referrer-hit>"}]},
    {"id":"search-found","name":"search-found","kind":"struct","fields":[{"name":"object","type":"object-type-id"},{"name":"id","type":"record-id"},{"name":"status","type":"string","optional":true},{"name":"matched","type":"list<field-id>"},{"name":"fields","type":"value-map"}],"description":"One hit of a search as the gateway answers it: the record as the reader may read it (fields holds only the fields the reader may read, as plain JSON), the fields in which the query matched, each one the reader may read (SRH-1590), and the publication state of the record when its type has one (SRH-151). The kernel type of a hit is strata_kernel::search::SearchHit."},
    {"id":"search-page","name":"search-page","kind":"struct","fields":[{"name":"hits","type":"list<search-found>"},{"name":"next","type":"string","optional":true},{"name":"examined","type":"u32"},{"name":"revision","type":"state-revision"},{"name":"schema-version","type":"schema-version"}],"description":"One page of a search: the hits in ascending order of object type and record id, the cursor of the page after (absent when the candidates ended), the number of candidates the kernel examined to make the page (at most 1000, SRH-2787) and the revision and schema version it was decided at. strata_kernel::search::SearchResult."},
    {"id":"schedule-summary","name":"Schedule Summary","kind":"struct","fields":[{"name":"schedule","type":"schedule-id"},{"name":"rule","type":"recurrence"},{"name":"paused","type":"bool"},{"name":"next-due","type":"timestamp"}],"description":"A schedule as the catalogue lists it."},
    {"id":"automation-approval","name":"Automation approval","kind":"struct","description":"The approval a request-approval step waits for (WFL-2680): the policy of the step, the roles it names (who may approve, besides holding workflow-approve), when it was requested and its deadline, the person whose action started the run (who may not approve, WFL-2681) and the decision once there is one.","fields":[{"name":"policy","type":"policy-id"},{"name":"roles","type":"list<role-id>"},{"name":"requested-at","type":"timestamp"},{"name":"deadline","type":"timestamp"},{"name":"started-by","type":"option<principal-id>","optional":true},{"name":"decision","type":"option<automation-approval-decision>","optional":true}]},
    {"id":"automation-approval-decision","name":"Automation approval decision","kind":"struct","description":"The one decision on an approval (WFL-2683): approved or refused, by whom (none when the deadline passed), the comment, when, and whether it is the deadline that decided (WFL-2682).","fields":[{"name":"approved","type":"bool"},{"name":"by","type":"option<principal-id>","optional":true},{"name":"comment","type":"option<string>","optional":true},{"name":"at","type":"timestamp"},{"name":"timed-out","type":"bool"}]},
    {"id":"template-value-type","name":"Template Value Type","kind":"enum","values":["str","int","bool","time"],"description":"The type a template declares for a value it places: the shape of the value that the sender supplies (D-7900)."},
    {"id":"template-inline","name":"Template Inline","kind":"union","encoding":{"tag":"internal","tagField":"type","variantCase":"snake_case"},"variants":[{"name":"text","fields":[{"name":"text","type":"string"}]},{"name":"em","fields":[{"name":"children","type":"list<template-inline>"}]},{"name":"strong","fields":[{"name":"children","type":"list<template-inline>"}]},{"name":"code","fields":[{"name":"text","type":"string"}]},{"name":"link","fields":[{"name":"href","type":"string"},{"name":"children","type":"list<template-inline>"}]},{"name":"token","fields":[{"name":"name","type":"string"}]},{"name":"value","fields":[{"name":"name","type":"string"},{"name":"value-type","type":"template-value-type"}]}],"description":"An inline node of a template body (D-7900): the inlines of constrained Markdown, and token and value. text and code hold text; em, strong and link hold inlines, at most 8 deep. link: href is a web (http, https) or mail (mailto) address, a path of the site or a fragment, with no space or control character (CMS-250). token: name is the name of a content token the tenant defines (CTK-005); it is replaced when the template is rendered by a text node with the value of the token for the reader (CTK-015). value: name is a value the sender supplies, value-type its type; a name is placed with one type only. Checked by strata_kernel::blocks::analyse."},
    {"id":"template-block","name":"Template Block","kind":"union","encoding":{"tag":"internal","tagField":"type","variantCase":"snake_case"},"variants":[{"name":"heading","fields":[{"name":"level","type":"u8"},{"name":"inlines","type":"list<template-inline>"}]},{"name":"paragraph","fields":[{"name":"inlines","type":"list<template-inline>"}]},{"name":"quote","fields":[{"name":"blocks","type":"list<template-block>"}]},{"name":"list","fields":[{"name":"ordered","type":"bool"},{"name":"items","type":"list<list<template-inline>>"}]},{"name":"code","fields":[{"name":"lang","type":"string"},{"name":"text","type":"string"}]},{"name":"figure","fields":[{"name":"src","type":"string"},{"name":"alt","type":"string"},{"name":"caption","type":"string"}]},{"name":"rule"}],"description":"A block of a template body (D-7900): the blocks of constrained Markdown. A body is a JSON list of them, the text of structured-blocks. heading: level is 2, 3 or 4. quote: quotes nest at most 8 deep. code: lang holds letters and digits only. figure: src is a path under /media/. A body holds at most 5000 nodes. Checked by strata_kernel::blocks::analyse and rendered by strata_kernel::blocks::render."},
    {"id":"rule-reach","name":"Rule reach","kind":"struct","description":"What a rule may follow a reference into, as the kernel's Lookup gives it (crates/kernel/src/rules.rs Lookup): the tenant snapshot, its coverage, and the request's old and new records, whose single reference fields the rule follows.","fields":[{"name":"tenant","type":"tenant-state"},{"name":"coverage","type":"coverage"},{"name":"subject","type":"subject"}]},
    {"id":"trigger-scopes","name":"trigger-scopes","kind":"struct","fields":[{"name":"record","type":"option<record>"},{"name":"old","type":"option<record>"},{"name":"new","type":"option<record>"}],"description":"triggers.rs Scopes: the records an event binds for a condition and a run key (D-6523), as the automation principal may observe them: record-created binds record and new, record-updated old and new, record-deleted old."},
    {"id":"lost-authority","name":"lost-authority","kind":"struct","fields":[{"name":"automation","type":"workflow-id"},{"name":"definer","type":"principal-id"},{"name":"role","type":"role-id"},{"name":"detail","type":"string"}],"description":"triggers.rs LostAuthority: an automation whose definer may no longer confer a role of its run-as, the first such role in id order, and what the conferral check says the definer lacks."},
    {"id":"trigger-suspension","name":"trigger-suspension","kind":"struct","fields":[{"name":"after","type":"tenant-state"},{"name":"result","type":"transition-result"}],"description":"triggers.rs suspend_lost: the state after the change with its automations suspended, and the transition with the PutSchema and the AutomationSuspended events added."},
    {"id":"lead-effects","name":"lead-effects","kind":"struct","fields":[{"name":"lead","type":"list<effect>"},{"name":"rest","type":"list<effect>"},{"name":"open","type":"bool"}],"description":"The leading Publish effects of a list of effects and the others: where triggers.rs append_events places the Publish effect of an event it appends."},
    {"id":"setting-problem","name":"setting-problem","kind":"struct","fields":[{"name":"kind","type":"error-kind"},{"name":"message","type":"string"}],"description":"settings.rs type_problem: why a value is not a value of a setting type, with the kind of the refusal."},
    {"id":"setting-found","name":"setting-found","kind":"struct","fields":[{"name":"source","type":"setting-source"},{"name":"team","type":"option<team-id>"},{"name":"value","type":"value"}],"description":"settings.rs resolve_definition: the level a value of a setting came from, the team when that level is team, and the value."},
    {"id":"setting-effects-acc","name":"setting-effects-acc","kind":"struct","fields":[{"name":"ops","type":"list<delta-op>"},{"name":"events","type":"list<event-body>"},{"name":"revisions","type":"map<setting-id, u64>"},{"name":"types","type":"map<setting-id, string>"},{"name":"emptied","type":"list<setting-id>"},{"name":"problem","type":"option<string>"}],"description":"settings.rs schema_change_effects, as a fold over the changes: the operations and events so far, the revision each setting reached, the type each setting has after the changes so far (the empty text for a removed one), the settings whose overrides a removal deleted, and the first problem."},
    {"id":"setting-effects","name":"setting-effects","kind":"struct","fields":[{"name":"ops","type":"list<delta-op>"},{"name":"events","type":"list<event-body>"}],"description":"settings.rs SchemaEffects: what a change of setting definitions does to the overrides and the events, beyond the schema."},
    {"id":"capability-split","name":"capability-split","kind":"struct","fields":[{"name":"namespace","type":"string"},{"name":"name","type":"string"}],"description":"capabilities.rs split_once(\"__\"): the text before the first two underscores in a row and the text after them."},
    {"id":"split-scan","name":"split-scan","kind":"struct","fields":[{"name":"before","type":"string"},{"name":"after","type":"string"},{"name":"held","type":"string"},{"name":"seen","type":"bool"}],"description":"The state of the scan of an id for its first two underscores in a row: the text before, the text after, a lone underscore not yet placed, and whether the separator was seen."},
    {"id":"ledger-limits-applying","name":"ledger-limits-applying","kind":"struct","fields":[{"name":"floor","type":"option<ledger-amount>"},{"name":"cap","type":"option<ledger-amount>"},{"name":"period-cap","type":"option<ledger-period-cap>"}],"description":"ledger.rs Limits: the limits that apply to one account: each of the account's own limits and, for each one it does not set, the limit of its unit (LDG-012)."},
    {"id":"ledger-period-cap","name":"ledger-period-cap","kind":"struct","fields":[{"name":"cap","type":"u64"},{"name":"period","type":"ledger-period"}],"description":"ledger.rs Limits.period_cap: a cap per period and its period, which are one limit."},
    {"id":"civil-month","name":"civil-month","kind":"struct","fields":[{"name":"year","type":"i64"},{"name":"month","type":"i64"}],"description":"The civil year and month of a count of days since 1970-01-01 (proleptic Gregorian)."},
    {"id":"event-kind-decl","name":"Event Kind Decl","kind":"struct","fields":[{"name":"kind","type":"event-kind"},{"name":"fields","type":"list<event-field-def>"},{"name":"readers","type":"list<role-id>"}],"description":"An event kind as a bundle declares it; the inputs of declare-event-kind other than tenant (SCH-1576, INT-3203). kind: Begins with app. and a name. fields: The payload, at most 16 fields of the scalar types. readers: The roles that may read an event of the kind."},
    {"id":"editor-field-rule","name":"Editor Field Rule","kind":"struct","fields":[{"name":"id","type":"string"},{"name":"label","type":"string"},{"name":"type","type":"string"},{"name":"type-name","type":"string"},{"name":"required","type":"bool"},{"name":"unique","type":"bool"}],"description":"One field of an object type that the reader may read, as strata_kernel::editor_rules::record_rules describes it to the editor: its identifier, label, shape as the rule language checker names it (bool, int, str, time, ref or list), the name of its declared type, whether it is required and whether it is unique."},
    {"id":"editor-limits","name":"Editor Limits","kind":"struct","fields":[{"name":"string-bytes","type":"u64"},{"name":"list-items","type":"u64"},{"name":"unique-bytes","type":"u64"},{"name":"record-bytes","type":"u64"}],"description":"The size limits the kernel holds every record to, in bytes or items: the longest string, the longest list, the longest unique value and the largest record."},
    {"id":"editor-constraint","name":"Editor Constraint","kind":"struct","fields":[{"name":"id","type":"string"},{"name":"rule","type":"string"},{"name":"message","type":"string"}],"description":"A constraint of an object type that the editor may evaluate: its identifier, its rule as printed text of the tenant rule language, and the message the kernel answers when the rule does not hold. A constraint that reads a field the reader may not read, or follows a reference, is not sent."},
    {"id":"editor-transition","name":"Editor Transition","kind":"struct","fields":[{"name":"name","type":"string"},{"name":"from","type":"string"},{"name":"to","type":"string"},{"name":"guard","type":"string","optional":true},{"name":"server-decides","type":"bool"},{"name":"sets","type":"list<string>"}],"description":"A transition of a workflow that leaves the current state of the record: its name, the states it joins, its guard as printed text (absent when the server decides it: server-decides), and the readable fields it sets."},
    {"id":"editor-workflow","name":"Editor Workflow","kind":"struct","fields":[{"name":"id","type":"string"},{"name":"field","type":"string"},{"name":"initial","type":"string"},{"name":"state","type":"string","optional":true},{"name":"transitions","type":"list<editor-transition>"}],"description":"A workflow on a readable field of the object type: its identifier, its field, its initial state, the state the edited record is in (absent for a new record) and the transitions out of that state."},
    {"id":"editor-record-rules","name":"Editor Record Rules","kind":"struct","fields":[{"name":"object","type":"string"},{"name":"fields","type":"list<editor-field-rule>"},{"name":"limits","type":"editor-limits"},{"name":"constraints","type":"list<editor-constraint>"},{"name":"workflows","type":"list<editor-workflow>"}],"description":"What the kernel will check on a record of one object type, told to the editor for one reader (strata_kernel::editor_rules::record_rules, CMS-2960): the object type, its readable fields with their shapes, the size limits, the constraints with their rule text and messages, and the workflows. It names nothing of a field the reader may not read."}
  ],
  "records": [
    {"id":"rec-tenant","name":"Tenant","owner":"control-plane","key":["tenant-id"],"fields":[{"name":"tenant-id","type":"tenant-id","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64}},{"name":"state","type":"tenant-lifecycle"},{"name":"plan","type":"plan-id"},{"name":"placement-id","type":"placement-id","refersTo":"rec-placement","onDelete":"restrict"},{"name":"database-created","type":"bool","optional":true},{"name":"layout-applied","type":"bool","optional":true},{"name":"template-installed","type":"bool","optional":true},{"name":"activated","type":"bool","optional":true},{"name":"flow-state","type":"string"},{"name":"suspension-reason","type":"tenant-suspension-reason","optional":true},{"name":"provisioning-attempts","type":"u64","optional":true},{"name":"expires-at","type":"u64","optional":true},{"name":"forked-from","type":"tenant-id","optional":true,"refersTo":"rec-tenant","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64},"onDelete":"cascade"},{"name":"sandbox-starter-key","type":"string","optional":true}],"retention":"Until the tenant is deleted (TEN-011), with the certificate of PRV-354.","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-placement","name":"Placement","owner":"control-plane","key":["placement-id"],"fields":[{"name":"placement-id","type":"placement-id"},{"name":"cell","type":"cell-id"},{"name":"cluster","type":"cluster-id","optional":true},{"name":"region","type":"region-id"},{"name":"database","type":"database-id","optional":true}],"retention":"Until the tenant is deleted or moved.","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-domain-binding","name":"Domain binding","owner":"control-plane","key":["host"],"fields":[{"name":"host","type":"host"},{"name":"tenant-id","type":"tenant-id","refersTo":"rec-tenant","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64},"onDelete":"cascade"},{"name":"certificate-state","type":"certificate-state"},{"name":"taken-down","type":"bool","optional":true}],"retention":"Until the binding is removed (EDG-008).","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-wake-entry","name":"Wake entry","owner":"control-plane","key":["tenant-id"],"fields":[{"name":"tenant-id","type":"tenant-id","refersTo":"rec-tenant","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64},"onDelete":"cascade"},{"name":"due-at","type":"timestamp"}],"retention":"Replaced on every change of the tenant's next due time.","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-principal","name":"Principal","owner":"identity-service","key":["principal-id"],"fields":[{"name":"principal-id","type":"principal-id","refersTo":"principal","role":"subject","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"kind","type":"principal-kind"},{"name":"state","type":"principal-state"},{"name":"display-name","type":"display-name","personal":"name"},{"name":"email","type":"email-address","personal":"contact"}],"retention":"Until the principal is erased (PRV-353), with the tenant at the latest.","erasure":{"point":"the erasure of the principal (PRV-353), or the removal of the tenant if that comes first"},"schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-credential","name":"Credential","owner":"identity-service","key":["credential-id"],"fields":[{"name":"credential-id","type":"credential-id"},{"name":"principal-id","type":"principal-id","refersTo":"principal","role":"subject","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"kind","type":"credential-kind"},{"name":"secret-hash","type":"hash","personal":"credential"}],"retention":"Until replaced or the principal is erased.","erasure":{"point":"its replacement, or the erasure of the principal"},"schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-identity-link","name":"Identity link","owner":"identity-service","key":["link-id"],"fields":[{"name":"link-id","type":"link-id"},{"name":"principal-id","type":"principal-id","refersTo":"principal","role":"subject","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"provider-id","type":"provider-id","refersTo":"rec-provider-config","onDelete":"restrict"},{"name":"external-subject","type":"external-subject","personal":"identifier"}],"retention":"Until unlinked or the principal is erased.","erasure":{"point":"its unlinking, or the erasure of the principal"},"schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-provider-config","name":"Identity provider configuration","owner":"identity-service","key":["provider-id"],"fields":[{"name":"provider-id","type":"provider-id"},{"name":"protocol","type":"provider-protocol"},{"name":"issuer","type":"url"},{"name":"email-domain","type":"domain"},{"name":"client-secret","type":"wrapped-secret"}],"retention":"Until the tenant removes the provider.","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-session","name":"Sign-in session","owner":"identity-service","key":["session-id"],"fields":[{"name":"session-id","type":"session-id","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96}},{"name":"principal-id","type":"principal-id","refersTo":"principal","role":"subject","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"secret-hash","type":"hash","personal":"credential"},{"name":"authenticated-at","type":"timestamp"},{"name":"expires-at","type":"timestamp"},{"name":"revoked-at","type":"timestamp","optional":true},{"name":"revoked","type":"bool","optional":true},{"name":"state","type":"string"}],"retention":"A day after it ends, so that a revocation can be explained. It holds no network address in clear form and no user agent (PRV-364).","erasure":{"point":"the session ends","bound":1,"unit":"day"},"schemaVersion":1,"unique":[["secret-hash"]],"indexes":[{"name":"sessions_principal","fields":["principal-id"]}],"scope":"platform","realisation":"target"},
    {"id":"rec-challenge","name":"Sign-in challenge","owner":"identity-service","key":["challenge-id"],"fields":[{"name":"challenge-id","type":"challenge-id"},{"name":"kind","type":"challenge-kind"},{"name":"token-hash","type":"hash","personal":"credential"},{"name":"principal-id","type":"principal-id","refersTo":"principal","role":"subject","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"browser-binding","type":"hash"},{"name":"expires-at","type":"timestamp"},{"name":"consumed","type":"bool"},{"name":"state","type":"string"},{"name":"sessions","type":"u32","optional":true},{"name":"expected-state","type":"string","optional":true},{"name":"federated-sessions","type":"u32","optional":true}],"retention":"Removed at its expiry or at its consumption, whichever comes first. The principal is named only when the address has an account (PRV-365).","erasure":{"point":"its expiry or its consumption, whichever comes first"},"schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-grant","name":"Grant","owner":"identity-service","key":["grant-id"],"fields":[{"name":"grant-id","type":"grant-id"},{"name":"principal-id","type":"principal-id","refersTo":"principal","role":"subject","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"delegator","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"optional":true,"onDelete":"restrict"},{"name":"scopes","type":"list<string>"},{"name":"revoked-at","type":"timestamp","optional":true},{"name":"expires-at","type":"timestamp"}],"retention":"Until revoked or its expiry passes, then removed with its last token.","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-event","name":"Domain event","owner":"runtime","key":["seq"],"fields":[{"name":"seq","type":"u64"},{"name":"revision","type":"u64"},{"name":"body","type":"event-body","personal":"other"},{"name":"actor","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"correlation","type":"correlation-id"},{"name":"pending","type":"bool","optional":true},{"name":"state","type":"string"}],"retention":"Within the restore window the tenant chooses (D-522), then truncated after a snapshot that carries the state hash at its start.","erasure":{"point":"truncation after the snapshot that closes the restore window the tenant chose (D-522)"},"schemaVersion":1,"scope":"platform","realisation":"target"},
    {
      "id": "rec-job",
      "name": "Job",
      "owner": "automation-worker",
      "key": [
        "job-id"
      ],
      "fields": [
        {
          "name": "job-id",
          "type": "job-id"
        },
        {
          "name": "due-at",
          "type": "timestamp"
        },
        {
          "name": "state",
          "type": "job-state"
        },
        {
          "name": "attempt",
          "type": "u64"
        },
        {
          "name": "lease-token",
          "type": "u64"
        },
        {
          "name": "idempotency-key",
          "type": "string"
        },
        {
          "name": "completions",
          "type": "u32",
          "optional": true
        },
        {
          "name": "accepted-token",
          "type": "u64",
          "optional": true
        },
        {
          "name": "errors",
          "type": "u32",
          "optional": true
        },
        {
          "name": "failed-at",
          "type": "timestamp",
          "optional": true
        },
        {
          "name": "gap",
          "type": "i64",
          "optional": true
        },
        {
          "name": "prev-gap",
          "type": "i64",
          "optional": true
        },
        {
          "name": "offered-at",
          "type": "timestamp",
          "optional": true
        },
        {
          "name": "cancelled",
          "type": "bool",
          "optional": true
        },
        {
          "name": "attempts-at-cancel",
          "type": "u64",
          "optional": true
        },
        {
          "name": "failed",
          "type": "bool",
          "optional": true
        }
      ],
      "retention": "Thirty days after its outcome.",
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target"
    },
    {
      "id": "rec-schedule",
      "name": "Schedule",
      "owner": "automation-worker",
      "key": [
        "schedule-id"
      ],
      "fields": [
        {
          "name": "schedule-id",
          "type": "schedule-id"
        },
        {
          "name": "rule",
          "type": "recurrence"
        },
        {
          "name": "paused",
          "type": "bool"
        },
        {
          "name": "next-due",
          "type": "timestamp"
        },
        {
          "name": "created",
          "type": "u64",
          "optional": true
        },
        {
          "name": "completions",
          "type": "u64",
          "optional": true
        },
        {
          "name": "created-at-pause",
          "type": "u64",
          "optional": true
        }
      ],
      "retention": "Until removed by the tenant.",
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target",
      "description": "A recurring schedule of a tenant. Realised by a row of tbl-schedules."
    },
    {
      "id": "rec-workflow-run",
      "name": "Workflow run",
      "owner": "automation-worker",
      "key": [
        "run-id"
      ],
      "fields": [
        {
          "name": "run-id",
          "type": "run-id"
        },
        {
          "name": "workflow",
          "type": "workflow-id",
          "constraints": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 64
          }
        },
        {
          "name": "state",
          "type": "run-state"
        },
        {
          "name": "step",
          "type": "u64"
        },
        {
          "name": "executions",
          "type": "u64",
          "optional": true
        },
        {
          "name": "completed",
          "type": "u64",
          "optional": true
        },
        {
          "name": "compensated",
          "type": "u64",
          "optional": true
        },
        {
          "name": "last-comp",
          "type": "u64",
          "optional": true
        },
        {
          "name": "prev-comp",
          "type": "u64",
          "optional": true
        },
        {
          "name": "permitted-approvals",
          "type": "u32",
          "optional": true
        },
        {
          "name": "refused-approvals",
          "type": "u32",
          "optional": true
        },
        {
          "name": "trigger",
          "type": "trigger-id",
          "optional": true,
          "constraints": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 64
          }
        },
        {
          "name": "event-seq",
          "type": "u64",
          "optional": true
        },
        {
          "name": "definition-version",
          "type": "u64",
          "optional": true
        },
        {
          "name": "hop",
          "type": "u64",
          "optional": true
        },
        {
          "name": "current-step",
          "type": "step-name",
          "optional": true,
          "constraints": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 64
          }
        },
        {
          "name": "caused-by",
          "type": "principal-id",
          "optional": true,
          "constraints": {
            "pattern": "^[A-Za-z0-9_:.-]+$",
            "maxLength": 96
          },
          "description": "The automation principal its steps act as (WFL-1530)."
        },
        {
          "name": "on-behalf-of",
          "type": "principal-id",
          "refersTo": "principal",
          "role": "party",
          "constraints": {
            "pattern": "^[A-Za-z0-9_:.-]+$",
            "maxLength": 96
          },
          "optional": true,
          "onDelete": "set-null",
          "description": "The definer whose authority bounds the run (WFL-1530)."
        },
        {
          "name": "started-at",
          "type": "timestamp",
          "optional": true
        },
        {
          "name": "ended-at",
          "type": "timestamp",
          "optional": true
        },
        {
          "name": "error",
          "type": "string",
          "optional": true,
          "constraints": {
            "maxLength": 256
          }
        }
      ],
      "retention": "Ninety days after it ends.",
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target"
    },
    {"id":"rec-audit-entry","name":"Audit entry","owner":"audit-log","key":["seq"],"fields":[{"name":"seq","type":"u64"},{"name":"actor","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"on-behalf-of","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"optional":true,"onDelete":"restrict"},{"name":"action","type":"string"},{"name":"outcome","type":"string"},{"name":"correlation","type":"correlation-id"},{"name":"previous-hash","type":"hash","optional":true},{"name":"target","type":"string"},{"name":"entry-hash","type":"hash"}],"retention":"At least one year, as the audit retention of the tenant policy, which the platform defaults to one year and a tenant can lengthen and cannot shorten (D-539, D-6208). Principal identifiers are sealed (PRV-358), and the chain is kept over the sealed form (PRV-360).","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-platform-audit-entry","name":"Platform audit entry","owner":"platform-audit-store","key":["seq"],"fields":[{"name":"seq","type":"u64"},{"name":"actor","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"action","type":"string"},{"name":"outcome","type":"string"},{"name":"correlation","type":"correlation-id"},{"name":"previous-hash","type":"hash","optional":true},{"name":"tenant","type":"tenant-id","optional":true,"constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64}},{"name":"target","type":"string"},{"name":"entry-hash","type":"hash"}],"retention":"Seven years after the entry (D-707), then removed. An entry names a platform operator or a service and no tenant content.","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-proposal","name":"Change proposal","owner":"agent-gateway","key":["proposal-id"],"fields":[{"name":"proposal-id","type":"proposal-id"},{"name":"author","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"approver","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"optional":true,"onDelete":"restrict"},{"name":"change","type":"change-set","personal":"other"},{"name":"projected-at-revision","type":"u64"},{"name":"state","type":"proposal-state"},{"name":"risky","type":"bool","optional":true},{"name":"projected","type":"bool","optional":true},{"name":"cleared","type":"bool","optional":true},{"name":"applied","type":"bool","optional":true},{"name":"flow-state","type":"string"},{"name":"approval-state","type":"string"}],"retention":"A year after it is closed.","erasure":{"point":"the proposal is closed","bound":365,"unit":"day"},"schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-cnv-conversation","name":"Conversation","owner":"conversation-service","key":["conversation-id"],"fields":[{"name":"conversation-id","type":"conversation-id"},{"name":"principal-id","type":"principal-id","refersTo":"principal","role":"subject","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"started-at","type":"timestamp"},{"name":"state","type":"conversation-state"}],"retention":"Until the person or the tenant deletes it, and with the tenant at the latest (CNV-229).","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-cnv-turn","name":"Turn","owner":"conversation-service","key":["turn-id"],"fields":[{"name":"turn-id","type":"turn-id"},{"name":"conversation-id","type":"conversation-id","refersTo":"rec-cnv-conversation","onDelete":"restrict"},{"name":"actor","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"body","type":"structured-blocks","personal":"activity"},{"name":"state","type":"turn-state"},{"name":"correlation","type":"correlation-id"}],"retention":"Until its conversation is deleted (CNV-229).","erasure":{"point":"the deletion of its conversation (CNV-229)"},"schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-cnv-pending-action","name":"Pending action","owner":"conversation-service","key":["pending-id"],"fields":[{"name":"pending-id","type":"pending-id"},{"name":"conversation-id","type":"conversation-id","refersTo":"rec-cnv-conversation","onDelete":"restrict"},{"name":"person","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"assistant","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"change","type":"change-set"},{"name":"projected-at-revision","type":"u64"},{"name":"state","type":"pending-action-state"},{"name":"proposal-id","type":"proposal-id","refersTo":"rec-proposal","optional":true,"onDelete":"restrict"},{"name":"previewed","type":"bool","optional":true},{"name":"confirmed","type":"bool","optional":true},{"name":"applied","type":"bool","optional":true},{"name":"flow-state","type":"string"}],"retention":"Ninety days after it is closed.","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-cnv-operation","name":"Assistant operation","owner":"conversation-service","key":["operation-id"],"fields":[{"name":"operation-id","type":"string"},{"name":"permitted","type":"bool"},{"name":"applied","type":"bool"},{"name":"state","type":"string"}],"retention":"As long as the operation it tracks exists.","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-consent-record","name":"Consent record","owner":"runtime","key":["consent-id"],"fields":[{"name":"consent-id","type":"consent-id"},{"name":"subject","type":"visitor-id","personal":"identifier"},{"name":"purpose","type":"string"},{"name":"decision","type":"consent-decision"},{"name":"text-shown","type":"text"},{"name":"decided-at","type":"timestamp"}],"retention":"Kept while the consent holds, then one year after it is withdrawn, as evidence of the decision (PRV-375).","erasure":{"point":"the consent is withdrawn (PRV-375)","bound":365,"unit":"day"},"schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-log-line","name":"Log line","owner":"telemetry-pipeline","key":["log-id"],"fields":[{"name":"log-id","type":"log-id"},{"name":"signal","type":"signal-kind"},{"name":"tenant-id","type":"tenant-id","refersTo":"rec-tenant","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64},"onDelete":"restrict"},{"name":"correlation","type":"correlation-id"},{"name":"event-code","type":"string"},{"name":"client-address","type":"ip-address","personal":"identifier"}],"retention":"Fourteen days, then removed by the pipeline. The client address has its host part removed (PRV-363).","erasure":{"point":"the line is written","bound":14,"unit":"day"},"schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-cdn-access-log","name":"Access log of the content delivery network","owner":"delivery-network","key":["request-id"],"fields":[{"name":"request-id","type":"request-id"},{"name":"host","type":"host"},{"name":"path","type":"string","personal":"other"},{"name":"client-address","type":"ip-address","personal":"identifier"},{"name":"status","type":"u16"},{"name":"at","type":"timestamp"}],"retention":"Seven days, then removed by the network. The client address has its host part removed (PRV-363).","erasure":{"point":"the line is written","bound":7,"unit":"day"},"schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-job-attempt","name":"Job attempt","owner":"automation-worker","key":["job-id","attempt"],"fields":[{"name":"job-id","type":"job-id"},{"name":"attempt","type":"u64"},{"name":"started-at","type":"timestamp"},{"name":"outcome","type":"job-attempt-outcome"},{"name":"error-text","type":"text","personal":"other"}],"retention":"Thirty days after the outcome of the job, with the job (SCH-014).","erasure":{"point":"the outcome of the job (SCH-014)","bound":30,"unit":"day"},"schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-effect-record","name":"Effect record","owner":"automation-worker","key":["idempotency-key"],"fields":[{"name":"idempotency-key","type":"string"},{"name":"step","type":"string"},{"name":"target","type":"address-text","personal":"contact"},{"name":"outcome","type":"string"},{"name":"sent-at","type":"timestamp"},{"name":"runs","type":"u32","optional":true},{"name":"run-state","type":"string"},{"name":"delivered-k1","type":"u64","optional":true},{"name":"delivered-k2","type":"u64","optional":true}],"retention":"Ninety days after the outcome, or until the retry window of its job closes if that is later. No body is kept (PRV-366).","erasure":{"point":"ninety days after the outcome, or the close of the retry window of its job if that is later"},"schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-subject-key","name":"Subject key","owner":"key-service","key":["key-id"],"fields":[{"name":"key-id","type":"key-id"},{"name":"subject","type":"principal-id","refersTo":"principal","role":"subject","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"wrapped-key","type":"wrapped-secret"},{"name":"state","type":"subject-key-state"},{"name":"destroyed-at","type":"timestamp","optional":true},{"name":"key-state","type":"string","optional":true}],"retention":"Until destroyed. Destruction removes the wrapped key and the subject, and keeps the key identifier and the time (PRV-358, PRV-362).","schemaVersion":1,"scope":"platform","realisation":"target","description":"Held today in the tenant database as identity documents (kind subject-key by key id, kind subject-key-of from the principal to its live key), wrapped under the tenant key, which the key service wraps (D-7722, crates/backend/src/subject_keys.rs)."},
    {"id":"rec-subprocessor","name":"Subprocessor","owner":"control-plane","key":["subprocessor-id"],"fields":[{"name":"subprocessor-id","type":"subprocessor-id"},{"name":"name","type":"text"},{"name":"role","type":"string"},{"name":"region","type":"region-id"},{"name":"data-categories","type":"list<string>"},{"name":"transfer-basis","type":"text"}],"retention":"Kept while the subprocessor is used, and one year after it is removed, as the record of processing (PRV-373).","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-restriction","name":"Restriction","owner":"subject-rights-service","key":["principal-id"],"fields":[{"name":"principal-id","type":"principal-id","refersTo":"principal","role":"subject","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"restricted-since","type":"timestamp"},{"name":"reason","type":"text"}],"retention":"Until lifted or the principal is erased (PRV-352). Kept as a document of the kind restriction in tbl-identity-docs, under the principal.","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-legal-hold","name":"Legal hold","owner":"runtime","key":["hold-id"],"fields":[{"name":"hold-id","type":"hold-id"},{"name":"subject","type":"principal-id","optional":true,"refersTo":"principal","role":"subject","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict","description":"The person the hold covers, or absent when it covers a record type."},{"name":"object","type":"string","optional":true,"description":"The record type the hold covers, or absent when it covers a person."},{"name":"set-by","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"set-at","type":"timestamp"},{"name":"reason","type":"text"},{"name":"released-at","type":"timestamp","optional":true}],"retention":"Until released by the tenant owner, then kept as the record of the hold until the tenant file is deleted (PRV-355). Kept as a document of the kind legal-hold in tbl-identity-docs.","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-access-grant","name":"Access grant","owner":"identity-service","key":["grant-id"],"fields":[{"name":"grant-id","type":"grant-id"},{"name":"operator","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"issued-by","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"purpose","type":"text"},{"name":"expires-at","type":"timestamp"},{"name":"withdrawn-at","type":"timestamp","optional":true},{"name":"shown-to-tenant","type":"bool"},{"name":"scope","type":"list<string>"}],"retention":"Kept in the tenant database for the life of the tenant, as the record of who read its data (PRV-370). It stops authorising anything when it expires or is withdrawn.","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-file-bytes","name":"Stored file content","owner":"file-store","key":["content-hash"],"fields":[{"name":"content-hash","type":"hash"},{"name":"public-bytes","type":"bytes"},{"name":"private-bytes","type":"bytes","personal":"other"},{"name":"uploaded-by","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"}],"retention":"Until no record refers to it. Private bytes are removed when the uploader is erased (PRV-353).","erasure":{"point":"the removal of the last record that refers to it; private bytes at the erasure of the uploader (PRV-353)"},"schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-content-token","name":"Content token","owner":"runtime","key":["token-name"],"fields":[{"name":"token-name","type":"string"},{"name":"expression","type":"expression"},{"name":"fallback","type":"text"},{"name":"description","type":"text"}],"retention":"Every version is kept in the schema history.","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-mail-template","name":"Mail template","owner":"runtime","key":["template-id"],"fields":[{"name":"template-id","type":"template-id"},{"name":"subject","type":"text"},{"name":"blocks","type":"structured-blocks"}],"retention":"Every version is kept in the schema history.","schemaVersion":1,"scope":"platform","realisation":"target"},
    {
      "id": "rec-mail-message",
      "name": "Mail message",
      "owner": "mail-dispatcher",
      "key": [
        "message-id"
      ],
      "fields": [
        {
          "name": "message-id",
          "type": "message-id"
        },
        {
          "name": "idempotency-key",
          "type": "string"
        },
        {
          "name": "recipient",
          "type": "principal-id",
          "refersTo": "principal",
          "role": "subject",
          "constraints": {
            "pattern": "^[A-Za-z0-9_:.-]+$",
            "maxLength": 96
          },
          "onDelete": "restrict"
        },
        {
          "name": "address",
          "type": "email-address",
          "personal": "contact"
        },
        {
          "name": "template-id",
          "type": "template-id",
          "refersTo": "rec-mail-template",
          "onDelete": "restrict"
        },
        {
          "name": "state",
          "type": "message-state"
        },
        {
          "name": "attempts",
          "type": "u64"
        },
        {
          "name": "provider-reference",
          "type": "string",
          "optional": true
        },
        {
          "name": "credential-reads",
          "type": "u64",
          "optional": true
        },
        {
          "name": "fail-reason",
          "type": "string",
          "optional": true
        },
        {
          "name": "attempts-at-fail",
          "type": "u64",
          "optional": true
        },
        {
          "name": "category",
          "type": "message-category-id",
          "optional": true
        },
        {
          "name": "allowance-class",
          "type": "allowance-class",
          "optional": true
        },
        {
          "name": "send-id",
          "type": "send-id",
          "optional": true
        },
        {
          "name": "reference",
          "type": "send-reference",
          "optional": true
        }
      ],
      "retention": "Thirty days after its final state. The body is dropped when the provider accepts the message (EML-011).",
      "erasure": {
        "point": "its final state (EML-011)",
        "bound": 30,
        "unit": "day"
      },
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target",
      "description": "Kept by the mail dispatcher as documents of kind mail-message in the tenant's small-document table (crates/backend/src/dispatch/store.rs); a table of its own is WG-5216. Each document also holds the hash of the address, the period it was counted in, and its created and final times; it never holds a body."
    },
    {"id":"rec-mail-suppression","name":"Suppressed address","owner":"mail-dispatcher","key":["address-hash","category"],"fields":[{"name":"address-hash","type":"hash","personal":"contact"},{"name":"category","type":"text","description":"A category name, * for the whole address, or *promotional for every promotional category (D-6562)."},{"name":"reason","type":"suppression-reason"},{"name":"recorded-at","type":"timestamp"}],"retention":"Until the tenant removes the entry. Held as a hash, so the list does not disclose the addresses on it.","erasure":{"point":"the removal of the entry by the tenant"},"schemaVersion":1,"scope":"platform","realisation":"target","description":"Kept by the mail dispatcher as documents of kind mail-suppression in the tenant's small-document table (crates/backend/src/dispatch/store.rs); a table of its own is WG-5216."},
    {
      "id": "rec-sender-domain",
      "name": "Sender domain",
      "owner": "mail-dispatcher",
      "key": [
        "domain"
      ],
      "fields": [
        {
          "name": "domain",
          "type": "domain"
        },
        {
          "name": "state",
          "type": "domain-state"
        },
        {
          "name": "proved-at",
          "type": "timestamp",
          "optional": true
        },
        {
          "name": "signing-key",
          "type": "wrapped-secret"
        },
        {
          "name": "last-from",
          "type": "string",
          "optional": true
        },
        {
          "name": "last-signed-by",
          "type": "string",
          "optional": true
        }
      ],
      "retention": "Until the tenant removes the domain.",
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target"
    },
    {"id":"rec-release-record","name":"Release record","owner":"release-controller","key":["release-id"],"fields":[{"name":"release-id","type":"release-id"},{"name":"environment","type":"environment-id","refersTo":"rec-platform-environment","onDelete":"restrict"},{"name":"commit","type":"string"},{"name":"image-digests","type":"list<string>"},{"name":"author","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"approvers","type":"list<principal-id>","refersTo":"principal","role":"party","onDelete":"restrict"},{"name":"gate-results","type":"list<string>"},{"name":"rollback-class","type":"rollback-class"},{"name":"live-colour","type":"colour-id"},{"name":"state","type":"release-state"},{"name":"gated","type":"bool","optional":true},{"name":"approval-count","type":"u32","optional":true},{"name":"live","type":"bool","optional":true},{"name":"approver","type":"principal-id","optional":true}],"retention":"Three years after the release is superseded, as the record of change to the platform (REL-581).","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-rolling-change","name":"Rolling change","owner":"runtime","key":["release-id"],"fields":[{"name":"release-id","type":"release-id"},{"name":"oldRunning","type":"bool"},{"name":"newFormat","type":"bool"},{"name":"state","type":"string"}],"retention":"As long as the release it tracks exists.","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-platform-environment","name":"Platform environment","owner":"release-controller","key":["environment-id"],"fields":[{"name":"environment-id","type":"environment-id"},{"name":"kind","type":"environment-kind"},{"name":"account","type":"string"},{"name":"region","type":"region-id"},{"name":"definition-commit","type":"string"},{"name":"live-colour","type":"colour-id"},{"name":"green-verified","type":"bool"},{"name":"green-withdrawn","type":"bool"},{"name":"state","type":"string"}],"retention":"For the life of the environment.","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-migration-run","name":"Migration run","owner":"migration-job","key":["run-id"],"fields":[{"name":"run-id","type":"run-id"},{"name":"tenant-id","type":"tenant-id","refersTo":"rec-tenant","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64},"onDelete":"restrict"},{"name":"change","type":"migration-id"},{"name":"cursor","type":"u64"},{"name":"state","type":"migration-state"},{"name":"started-by","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"}],"retention":"Kept with the schema history of the tenant (MIG-556).","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-tenant-move","name":"Tenant move","owner":"control-plane","key":["move-id"],"fields":[{"name":"move-id","type":"move-id"},{"name":"tenant-id","type":"tenant-id","refersTo":"rec-tenant","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64},"onDelete":"restrict"},{"name":"source-placement","type":"placement-id","refersTo":"rec-placement","onDelete":"restrict"},{"name":"target-placement","type":"placement-id","refersTo":"rec-placement","onDelete":"restrict"},{"name":"state","type":"move-state"},{"name":"source-hash","type":"hash"},{"name":"target-hash","type":"hash"},{"name":"frozen-at","type":"timestamp","optional":true},{"name":"frozen","type":"bool","optional":true},{"name":"source-version","type":"u64","optional":true},{"name":"target-version","type":"u64","optional":true},{"name":"matched","type":"bool","optional":true},{"name":"switched","type":"bool","optional":true}],"retention":"For the life of the tenant, as the record of its placement (MIG-570).","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-file","name":"Stored file","owner":"file-store","key":["content-hash"],"fields":[{"name":"content-hash","type":"hash"},{"name":"size","type":"u64"},{"name":"media-type","type":"string"}],"retention":"Until no record refers to it.","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-inbox-item","name":"inbox item","owner":"notification-service","key":["item-id"],"fields":[{"name":"item-id","type":"identifier"},{"name":"recipient","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"record-ref","type":"reference"},{"name":"state","type":"text"},{"name":"created-at","type":"timestamp"},{"name":"body","type":"text","personal":"other"},{"name":"topic","type":"text"},{"name":"category","type":"message-category-id","optional":true},{"name":"reference","type":"send-reference","optional":true},{"name":"read-at","type":"timestamp","optional":true}],"retention":"Until its recipient removes it or the record it names is erased (NTF-151).","erasure":{"point":"its removal by the recipient, or the erasure of the record it names (NTF-151)"},"schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-subscription","name":"subscription","owner":"notification-service","key":["subscription-id"],"fields":[{"name":"subscription-id","type":"identifier"},{"name":"subscriber","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"topic","type":"text"},{"name":"channel","type":"text"}],"retention":"Until the subscriber removes it or the subscriber is erased (NTF-151).","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-webhook-subscription","name":"webhook subscription","owner":"automation-worker","key":["subscription-id"],"fields":[{"name":"subscription-id","type":"identifier"},{"name":"endpoint","type":"text"},{"name":"secret-sealed","type":"secret","personal":"credential"},{"name":"state","type":"text"}],"retention":"Until the owner removes it; the secret is sealed under the key of the tenant (SEC-003, WFL-010).","erasure":{"point":"its removal by the owner"},"schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-connector-secret","name":"connector secret","owner":"automation-worker","key":["secret-id"],"fields":[{"name":"secret-id","type":"identifier"},{"name":"sealed-value","type":"secret","personal":"credential"},{"name":"connector","type":"text"}],"retention":"Until the owner removes it; stored only encrypted, under a wrapping key held by the key service (SEC-003).","erasure":{"point":"its removal by the owner"},"schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-delivery-key","name":"delivery key","owner":"runtime","key":["key-id"],"fields":[{"name":"key-id","type":"identifier"},{"name":"site","type":"text"},{"name":"audience-class","type":"text"},{"name":"secret-hash","type":"hash","personal":"credential"},{"name":"revoked-at","type":"timestamp","optional":true}],"retention":"Until its owner removes it; a revoked key is refused on the terms of a revoked session (CMS-166, CMS-167).","erasure":{"point":"its removal by the owner"},"schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-form","name":"form","owner":"runtime","key":["form-id"],"fields":[{"name":"form-id","type":"form-id"},{"name":"definition","type":"text"},{"name":"notice-subscriptions","type":"text"}],"retention":"Until the form is removed.","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-redirect","name":"redirect","owner":"runtime","key":["from-address"],"fields":[{"name":"from-address","type":"text"},{"name":"to-address","type":"text"},{"name":"created-by","type":"principal-id","refersTo":"principal","role":"party","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"}],"retention":"Until the site is removed (CMS-161, CMS-162, MIG-577).","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-feature-flag","name":"feature flag","owner":"release-controller","key":["flag-id","tenant-id"],"fields":[{"name":"flag-id","type":"identifier"},{"name":"tenant-id","type":"tenant-id","refersTo":"rec-tenant","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64},"onDelete":"cascade"},{"name":"enabled","type":"bool"},{"name":"release-id","type":"text"}],"retention":"Until the release that set it is removed from the release records (OPS-328, AGT-420).","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-plan","name":"plan","owner":"control-plane","key":["plan-id"],"fields":[{"name":"plan-id","type":"identifier"},{"name":"tenant-id","type":"tenant-id","refersTo":"rec-tenant","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64},"onDelete":"cascade"},{"name":"quotas","type":"text"},{"name":"grace-period","type":"text"}],"retention":"The tenant lifecycle; the plan is kept for the grace period it states (BIL-150, ADM-160).","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-usage-meter","name":"usage meter","owner":"limit-store","key":["tenant-id","measure","window"],"fields":[{"name":"tenant-id","type":"tenant-id","refersTo":"rec-tenant","constraints":{"pattern":"^[a-z][a-z0-9_]*$","maxLength":64},"onDelete":"cascade"},{"name":"measure","type":"text"},{"name":"window","type":"text"},{"name":"value","type":"u64"}],"retention":"Kept for the billing and reporting window the plan states (OPS-345).","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-erasure-receipt","name":"erasure receipt","owner":"subject-rights-service","key":["request-id"],"fields":[{"name":"request-id","type":"identifier"},{"name":"principal-id","type":"principal-id","refersTo":"principal","role":"subject","constraints":{"pattern":"^[A-Za-z0-9_:.-]+$","maxLength":96},"onDelete":"restrict"},{"name":"record-ref","type":"reference"},{"name":"copy-ref","type":"reference"},{"name":"erasure-point","type":"text"},{"name":"at","type":"timestamp"}],"retention":"Kept as the receipt of the erasure it records (PRV-353).","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-limit-counter","name":"limit counter","owner":"limit-store","key":["limit-key"],"fields":[{"name":"limit-key","type":"string","constraints":{"maxLength":128}},{"name":"failures","type":"u64"},{"name":"closed-at","type":"timestamp","optional":true},{"name":"throttle-state","type":"string"},{"name":"failures-a","type":"u64","optional":true},{"name":"failures-b","type":"u64","optional":true}],"retention":"Kept while the window of the limit is open and dropped when it expires.","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-copy-entry","name":"copy entry","owner":"copy-store","key":["copy-ref"],"fields":[{"name":"copy-ref","type":"reference"},{"name":"erased","type":"bool"},{"name":"erased-at","type":"timestamp","optional":true},{"name":"held","type":"bool"},{"name":"state","type":"string"}],"retention":"Held until the copy is dropped by a purge or by its lifetime.","schemaVersion":1,"scope":"platform","realisation":"target"},
    {"id":"rec-trigger-chain","name":"trigger chain","owner":"automation-worker","key":["correlation"],"fields":[{"name":"correlation","type":"correlation-id"},{"name":"accepted","type":"u64"}],"retention":"Kept as long as the jobs the chain created.","schemaVersion":1,"scope":"platform","realisation":"target"},
    {
      "id": "rec-session-copy",
      "name": "session copy",
      "owner": "gateway",
      "key": [
        "session-id"
      ],
      "fields": [
        {
          "name": "session-id",
          "type": "session-id",
          "refersTo": "rec-session",
          "onDelete": "cascade"
        },
        {
          "name": "checked-at",
          "type": "timestamp"
        },
        {
          "name": "valid",
          "type": "bool",
          "optional": true
        },
        {
          "name": "session-state",
          "type": "string"
        },
        {
          "name": "outage-state",
          "type": "string"
        },
        {
          "name": "checked",
          "type": "bool",
