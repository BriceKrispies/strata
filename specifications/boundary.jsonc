        "provider-id"
      ],
      "fields": [
        {
          "name": "provider-id",
          "type": "provider-id",
          "refersTo": "rec-provider-config",
          "onDelete": "cascade"
        },
        {
          "name": "known-kid",
          "type": "string",
          "optional": true
        }
      ],
      "retention": "Held while the provider is configured.",
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target"
    },
    {
      "id": "rec-federated-signup",
      "name": "Federated first sign-in",
      "owner": "identity-service",
      "key": [
        "signup-id"
      ],
      "fields": [
        {
          "name": "signup-id",
          "type": "request-id"
        },
        {
          "name": "role",
          "type": "string",
          "optional": true
        },
        {
          "name": "default-role",
          "type": "string",
          "optional": true
        }
      ],
      "retention": "Removed when the first sign-in completes.",
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target"
    },
    {
      "id": "rec-sign-in-page",
      "name": "Sign-in page request",
      "owner": "identity-service",
      "key": [
        "page-id"
      ],
      "fields": [
        {
          "name": "page-id",
