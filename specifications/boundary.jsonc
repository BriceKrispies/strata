      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-segment-events",
      "name": "Segment events (tenant file)",
      "scope": "platform",
      "key": [
        "position"
      ],
      "fields": [
        {
          "name": "position",
          "type": "u64",
          "description": "The place of the event in the ordered log of the tenant."
        },
        {
          "name": "data",
          "type": "json",
          "personal": "other",
          "description": "The entry or exit event as canonical JSON (rec-segment-event)."
        },
        {
          "name": "published",
          "type": "bool"
        }
      ],
      "retention": "Until the job worker has handed the event on and the retention of the event log has passed.",
      "erasure": {
        "point": "the deletion of the tenant file"
      },
      "description": "Table segment_events of a tenant file: the entry and exit events, written in the transaction that changes the membership, that the job worker reads as its outbox (rec-segment-event, d-7280)."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-object-revisions",
      "name": "Object revisions (tenant file)",
      "scope": "tenant-meta",
      "describedBy": "tenant-schema",
      "key": [
        "object"
      ],
      "fields": [
        {
          "name": "object",
          "type": "object-type-id",
          "description": "The object type; the empty string counts toward every type."
        },
        {
          "name": "revision",
          "type": "u64"
        }
      ],
      "retention": "Until the tenant file is deleted: the counter only rises.",
      "erasure": {
        "point": "the deletion of the tenant file"
      },
      "description": "Table object_revisions of a tenant file: the change counter of each object type, raised in the commit that writes or deletes a record of the type."
    },
    {
      "id": "rec-notification-digest",
      "name": "Notification digest",
      "owner": "notification-service",
      "key": [
        "digest-id"
      ],
      "fields": [
        {
          "name": "digest-id",
          "type": "identifier",
          "description": "Derived from the tenant, the person, the category, the channel and the start of the period."
        },
        {
          "name": "person",
          "type": "principal-id",
          "refersTo": "principal",
          "role": "party",
          "constraints": {
            "pattern": "^[A-Za-z0-9_:.-]+$",
            "maxLength": 96
          },
          "onDelete": "cascade"
        },
        {
          "name": "category",
          "type": "message-category-id"
        },
        {
          "name": "channel",
          "type": "notification-channel"
        },
        {
          "name": "period-start",
          "type": "timestamp"
        },
        {
          "name": "made-at",
          "type": "timestamp"
        }
      ],
      "retention": "Until the tenant file is deleted; no sweep removes a marker yet.",
      "erasure": {
        "point": "the deletion of the tenant file"
      },
      "schemaVersion": 1,
      "scope": "platform",
      "realisation": "target",
      "source": "d-8100",
      "description": "The marker that a digest was made for a period (NTF-3101), kept as documents of kind notice-digest (crates/backend/src/inbox/digest.rs); its id is the id of the inbox item of the digest and the idempotency key of the mail of it."
    }
  ],
  "copies": [
    {"id":"copy-compiled-schema","name":"Compiled schema","of":["tbl-schema-history"],"heldBy":"runtime","scope":"internal","freshness":{"bound":"zero","mechanism":"keyed by tenant and schema version, so a new version is a new entry","source":"d-14"},"description":"copy-classes: compiled-schema.","erasure":{"point":"dropped when the tenant is deleted or the process ends"}},
    {"id":"copy-directory-entry","name":"Directory entry","of":["rec-tenant","rec-placement","rec-domain-binding"],"fields":["rec-tenant.tenant-id","state","suspension-reason","cell","cluster","region","database","host"],"heldBy":"gateway","scope":"internal","freshness":{"bound":15,"unit":"minute","mechanism":"refreshed from the tenant directory; served for at most 15 minutes after the control plane was last reached","source":"arc-500"},"description":"copy-classes: directory-entry. An entry of an active tenant is served for at most 15 minutes (ARC-500); an entry in any other state, for at most 60 seconds (ARC-1229). The cell is what the gateway routes by (STO-007).","erasure":{"point":"the next refresh after a tenant is deleted, within 60 seconds (ARC-1229)"}},
    {"id":"copy-session-assertion","name":"Session assertion","of":["rec-session"],"fields":["session-id","rec-session.principal-id","authenticated-at","expires-at"],"heldBy":"gateway","scope":"per-session","freshness":{"bound":5,"unit":"second","mechanism":"revocation notice, and a recheck when the copy is older than the bound","source":"idn-014"},"erasure":{"point":"the revocation notice, or the next recheck","bound":5,"unit":"second","source":"idn-014"},"dependsOnAuthority":true,"description":"copy-classes: session-assertion."},
    {"id":"copy-public-view","name":"Public view","of":["tbl-records"],"fields":["object","id","version","data"],"heldBy":"copy-store","scope":"shared","freshness":{"bound":"zero","mechanism":"the key contains the revision of every object type the view depends on","source":"d-14"},"description":"copy-classes: public-view. Holds the published fields of tenant records (the policy of the tenant schema decides which) and no principal.","erasure":{"point":"superseded by the commit of the deletion"}},
    {"id":"copy-audience-view","name":"Audience view","of":["tbl-records"],"heldBy":"copy-store","scope":"per-principal","freshness":{"bound":"zero","mechanism":"the key contains the audience class and the revision of every object type the view depends on","source":"d-15"},"erasure":{"point":"superseded by the commit of the deletion, removed by tag within the bound","bound":2,"unit":"second","source":"cpy-009"},"dependsOnAuthority":true,"description":"copy-classes: audience-view."},
    {"id":"copy-edge-page","name":"Edge page","of":["rec-published-page"],"fields":["record-id","version"],"heldBy":"delivery-network","scope":"shared","freshness":{"bound":5,"unit":"second","mechanism":"surrogate-key purge sent by the commit, with the lifetime as backstop","source":"edg-007"},"description":"copy-classes: edge-page. The published page as the edge holds it; its content is the published fields of a tenant record in tbl-records.","erasure":{"point":"the purge sent by the commit of the deletion"}},
    {"id":"copy-runtime-directory-entry","name":"Directory entry held by the runtime","of":["rec-tenant","rec-placement","rec-domain-binding"],"fields":["rec-tenant.tenant-id","state","cell","cluster","region","database","host"],"heldBy":"runtime","scope":"internal","freshness":{"bound":15,"unit":"minute","mechanism":"refreshed from the tenant directory; served for at most 15 minutes after the control plane was last reached","source":"arc-500"},"description":"copy-classes: directory-entry. The runtime holds the cell and the placement it opens a tenant database with.","erasure":{"point":"the next refresh after a tenant is deleted"}},
    {"id":"copy-cnv-model-context","name":"Model request context","of":["rec-cnv-turn","tbl-records"],"heldBy":"model-provider","scope":"per-principal","freshness":{"bound":"zero","mechanism":"built from the current records for each request and held by the provider only for that request","source":"cnv-233"},"erasure":{"point":"the end of the request, or the retention the tenant contract sets with the provider, whichever is earlier","source":"cnv-235"},"dependsOnAuthority":true,"description":"The content of one model request, as far as the tenant policy permits it for the person served."},
    {"id":"copy-tenant-backup","name":"Tenant backup image","of":["rec-principal","rec-credential","rec-identity-link","rec-provider-config","rec-session","rec-challenge","rec-grant","tbl-schema-history","tbl-records","rec-event","rec-job","rec-job-attempt","rec-schedule","rec-workflow-run","rec-audit-entry","rec-proposal","rec-consent-record","rec-effect-record","rec-restriction","rec-legal-hold","rec-file","rec-file-bytes","rec-access-grant","rec-cnv-conversation","rec-cnv-turn","rec-cnv-pending-action","rec-mail-template","rec-mail-message","rec-mail-suppression","rec-sender-domain","rec-content-token","rec-migration-run","rec-delivery-key","rec-form","rec-redirect","rec-inbox-item","rec-subscription","rec-webhook-subscription","rec-connector-secret","rec-erasure-receipt"],"heldBy":"backup-archive","scope":"internal","freshness":{"bound":24,"unit":"hour","mechanism":"a new image is taken at each backup, and a restore reads the newest image","source":"d-25"},"erasure":{"point":"destruction of the subject key that seals each personal field of the image (PRV-358), and removal of the image at the end of its retention (D-351)","bound":35,"unit":"day","source":"d-706"},"description":"Encrypted images of a tenant database and of its files. A snapshot of tenant state is an image of this kind. An image holds the subject keys wrapped as they were when it was taken, so an image older than a key destruction opens the erased fields until it is removed; a restore re-applies the destructions recorded after its point (D-7727). On a SQLite cell the image is the stream of the tenant file under the key of its tenant. On a PostgreSQL cell it is the instance-level snapshot or point-in-time recovery of the managed database, which is not under the key of its tenant and holds other tenants too, so the key destruction below does not reach it and its erasure point is the end of its retention (D-8303)."},
    {"id":"copy-control-backup","name":"Control database backup image","of":["rec-tenant","rec-placement","rec-domain-binding","rec-wake-entry","rec-subprocessor","rec-plan"],"heldBy":"backup-archive","scope":"internal","freshness":{"bound":24,"unit":"hour","mechanism":"a new image is taken at each backup","source":"d-2"},"erasure":{"point":"removal of the image at the end of its retention (D-351); the operator identifiers in the access grants are sealed as PRV-358 requires","bound":35,"unit":"day","source":"d-706"},"description":"Encrypted images of the control database, which holds no tenant content."},
    {"id":"copy-tenant-export","name":"Tenant export archive","of":["rec-principal","rec-identity-link","tbl-schema-history","tbl-records","rec-event","rec-job","rec-job-attempt","rec-schedule","rec-workflow-run","rec-audit-entry","rec-proposal","rec-consent-record","rec-effect-record","rec-restriction","rec-legal-hold","rec-file","rec-file-bytes","rec-cnv-conversation","rec-cnv-turn","rec-cnv-pending-action","rec-mail-template","rec-mail-message","rec-mail-suppression","rec-sender-domain","rec-content-token","rec-migration-run","rec-form","rec-redirect","rec-inbox-item","rec-subscription","rec-webhook-subscription","rec-erasure-receipt"],"heldBy":"file-store","scope":"internal","freshness":{"bound":7,"unit":"day","mechanism":"a point-in-time archive that is not refreshed; it is removed at the end of its download window","source":"d-351"},"erasure":{"point":"removal of the archive at the end of its download window, or earlier at the tenant's request; the sealed fields are covered by PRV-358","bound":7,"unit":"day","source":"d-351"},"description":"The archive of a tenant export (TEN-010), written to the file namespace of the tenant. It holds no credential, session, challenge, API grant, provider secret, connector secret or delivery key (TEN-1200, D-6200). Its personal fields are in their sealed form and its subject keys only wrapped by the key service, never in clear and never a destroyed one; an import re-applies the key destructions recorded after its point (D-7727)."},
    {"id":"copy-mail-outbox","name":"Mail provider outbox","of":["rec-mail-message"],"fields":["address"],"heldBy":"mail-service","scope":"internal","freshness":{"bound":30,"unit":"day","mechanism":"the provider keeps each message for its own retention and then removes it","source":"d-9"},"erasure":{"point":"deletion by the provider at the end of its retention, and on the request of the controller","bound":30,"unit":"day","source":"d-9"},"description":"The provider holds the recipient address of each message it accepted, for its own retention. Messages carry the sign-in link; its token exists in no record in plain form, only as its hash."},
    {"id":"copy-support-snapshot","name":"Support view","of":["rec-principal","rec-identity-link"],"heldBy":"operator-console","scope":"per-principal","freshness":{"bound":1,"unit":"hour","mechanism":"a view made for one access grant and ended when the grant ends","source":"prv-367"},"erasure":{"point":"the end of the access grant, or the erasure of the principal (PRV-353)","bound":1,"unit":"hour","source":"prv-367"},"dependsOnAuthority":true,"description":"A view that a support engineer reads under an access grant."},
    {"id":"copy-telemetry-backend","name":"Telemetry backend","of":["rec-log-line"],"heldBy":"telemetry-pipeline","scope":"internal","freshness":{"bound":14,"unit":"day","mechanism":"lines are removed at the end of their retention","source":"prv-363"},"erasure":{"point":"removal at the end of retention","bound":14,"unit":"day","source":"prv-363"},"description":"The store of the telemetry export, which the pipeline itself keeps."},
    {"id":"copy-private-media","name":"Private media","of":["rec-file-bytes"],"fields":["content-hash","private-bytes"],"heldBy":"delivery-network","scope":"per-principal","freshness":{"bound":"zero","mechanism":"the address is derived from the content, and a signed address expires","source":"edg-012"},"erasure":{"point":"the purge sent when the file is deleted or its uploader is erased","bound":5,"unit":"second","source":"edg-007"},"dependsOnAuthority":true,"description":"Private files, served through signed addresses for the requesting principal."},
    {"id":"copy-edge-public-media","name":"Public media","of":["rec-file-bytes"],"fields":["content-hash","public-bytes"],"heldBy":"delivery-network","scope":"shared","freshness":{"bound":"zero","mechanism":"the address is derived from the content","source":"d-16"},"erasure":{"point":"the purge sent when the file is deleted","bound":5,"unit":"second","source":"edg-007"},"description":"Files that the tenant marked public. Holds no personal field."},
    {"id":"copy-live-colour","name":"Live colour routing","of":["rec-platform-environment"],"fields":["environment-id","live-colour"],"heldBy":"traffic-switch","scope":"internal","freshness":{"bound":"zero","mechanism":"pushed by the release controller at each colour switch","source":"d-556"},"description":"The colour that the public traffic of each environment reaches. It holds no personal field.","erasure":{"point":"not applicable: holds no personal field"}},
    {"id":"copy-move-replica","name":"Move replica","of":["tbl-records","rec-event","rec-principal"],"heldBy":"cell","scope":"internal","freshness":{"bound":"zero","mechanism":"verified by state hash before the placement switch, after which it is the tenant database","source":"d-576"},"erasure":{"point":"removal of the source database at the end of its retention (MIG-572)"},"description":"The copy of a tenant database that a move makes in the target cell, on either backend, until the placement switch."},
    {"id":"copy-edge-media","name":"Edge media","of":["rec-file"],"heldBy":"delivery-network","scope":"shared","freshness":{"bound":"zero","mechanism":"the address is derived from the content","source":"d-16"},"description":"copy-classes: edge-media.","erasure":{"point":"the purge sent when the file is deleted"}},
    {"id":"copy-search-entries","name":"Search entries","of":["tbl-records"],"fields":["id","data"],"heldBy":"search-index","scope":"internal","freshness":{"bound":"the commit of the record","mechanism":"an entry follows the commit that changed its record, including the commit of its deletion","source":"srh-152"},"erasure":{"point":"the commit of the deletion of the record","source":"srh-152"},"description":"Search entries are read through the authority filter (SRH-150) and are never served as stored."},
    {"id":"copy-aggregate-result","name":"Aggregate result","of":["tbl-records"],"heldBy":"copy-store","scope":"per-principal","freshness":{"bound":"zero","mechanism":"the key contains the audience class and the revision of every object type the aggregate reads","source":"d-5064"},"erasure":{"point":"superseded by the commit of the deletion, removed by tag within the bound","bound":2,"unit":"second","source":"cpy-009"},"dependsOnAuthority":true,"description":"copy-classes: aggregate-result."}
  ],
  "errorMessages": [
    {
      "id": "em-check-required",
      "on": "check",
      "kinds": [
        "required"
      ],
      "text": "This is required.",
      "field": "name"
    },
    {
      "id": "em-check-unique",
      "on": "check",
      "kinds": [
        "unique"
      ],
      "text": "Another entry already uses this value.",
      "field": "name"
    },
    {
      "id": "em-check-form",
      "on": "check",
      "kinds": [
        "type",
        "input"
      ],
      "text": "This value is not in the expected form.",
      "field": "name"
    },
    {
      "id": "em-check-reference",
      "on": "check",
      "kinds": [
        "reference"
      ],
      "text": "The chosen entry no longer exists.",
      "field": "name"
    },
    {
      "id": "em-check-constraint",
      "on": "check",
      "kinds": [
        "constraint"
      ],
      "text": "${check.statement}.",
      "field": "prefix",
      "description": "A constraint is named for the field it guards: title_length is about title. Its detail ends with the rule in brackets, which is left out."
    },
    {
      "id": "em-check-workflow",
      "on": "check",
      "kinds": [
        "workflow",
        "workflow_state"
      ],
      "text": "That change of status is not allowed from here."
    },
    {
      "id": "em-check-policy",
      "on": "check",
      "kinds": [
        "policy"
      ],
      "text": "You are not allowed to do this."
    },
    {
      "id": "em-check-other",
      "on": "check",
      "text": "${check.detail}",
      "description": "A failed check of any other kind is shown as the kernel words it."
    },
    {
      "id": "em-error-conflict",
      "on": "error",
      "kinds": [
        "conflict"
      ],
      "text": "This was changed somewhere else since you opened it. Reload to see the latest version."
    },
    {
      "id": "em-error-session-ended",
      "on": "error",
      "kinds": [
        "unauthenticated"
      ],
      "text": "Your session has ended. Sign in again to save."
    },
    {
      "id": "em-error-other",
      "on": "error",
      "text": "${error.message}",
      "fallback": "That did not work. Try again."
    },
    {
      "id": "em-sign-in-refused",
      "on": "error",
      "kinds": [
        "throttled",
        "unauthenticated"
      ],
      "appliesTo": [
        "form-sign-in"
      ],
      "text": "${error.message}",
      "description": "Wrong credentials and a throttled caller are worded by the gateway, which does not say which credential was wrong (UXA-202)."
    },
    {
      "id": "em-sign-in-failed",
      "on": "error",
      "appliesTo": [
        "form-sign-in"
      ],
      "text": "Signing in did not work. Try again."
    },
    {
      "id": "em-sign-out-failed",
      "on": "error",
      "appliesTo": [
        "act-sign-out-desk",
        "act-sign-out-front-page"
      ],
      "text": "Signing out did not work. Try again."
    },
    {
      "id": "em-invitation-refused",
      "on": "error",
      "kinds": [
        "unauthenticated"
      ],
      "appliesTo": [
        "form-accept-invitation"
      ],
      "text": "That invitation was not accepted. Ask for a new one.",
      "description": "A wrong, a used, an expired and a foreign-origin invitation are answered alike, so the page says one thing for all four and does not say which part was wrong (IDN-1682)."
    },
    {
      "id": "em-invitation-password",
      "on": "error",
      "kinds": [
        "invalid"
      ],
      "appliesTo": [
        "form-accept-invitation"
      ],
      "text": "Choose a password of at least 10 characters.",
      "description": "The server refused the password the page let through."
    },
    {
      "id": "em-invitation-throttled",
      "on": "error",
      "kinds": [
        "throttled"
      ],
      "appliesTo": [
        "form-accept-invitation"
      ],
      "text": "${error.message}",
      "description": "A throttled caller is worded by the gateway."
    },
    {
      "id": "em-invitation-failed",
      "on": "error",
      "appliesTo": [
        "form-accept-invitation"
      ],
      "text": "Your password could not be set just now. Try again."
    }
  ],
