    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "runtime",
      "scope": "platform",
      "id": "tbl-runtime-records",
      "name": "Machine records (runtime database)",
      "key": [
        "collection",
        "key"
      ],
      "fields": [
        {
          "name": "collection",
          "type": "string",
          "description": "The machine the record belongs to."
        },
        {
          "name": "key",
          "type": "string",
          "description": "The key of the instance of the machine, as JSON text.",
          "personal": "identifier"
        },
        {
          "name": "version",
          "type": "u64",
          "description": "Raised by one on each save of the instance."
        },
        {
          "name": "data",
          "type": "json",
          "personal": "other",
          "description": "The state and variables of the instance, as JSON text."
        },
        {
          "name": "updated-at",
          "type": "timestamp",
          "optional": true,
          "description": "The time of the step that last saved the instance. A row written before this column existed takes the time of the first open of the database that sees it. The retention of a finished instance counts from it."
        }
      ],
      "retention": "A save replaces the row of its collection and key in place. The purge of the runtime (System::purge) deletes the row of an instance that is in a terminal state of its machine once 90 days have passed since its updated-at, and deletes no other row: the row of an instance that has not finished, and the row of the one instance of an unkeyed machine that creates its records, stay until the database file that holds them is deleted. The backend janitor calls the purge every 600 seconds.",
      "erasure": {
        "point": "the purge of a finished instance, 90 days after its last save, or the deletion of the database file"
      },
      "description": "Table runtime_records of a runtime database: the state of every instance of every machine, one row per machine and key, written in the transaction of the transition that changed it. The runtime keeps its machine tables in the database file the host gives it (Database::open), which belongs to one tenant (runtime_tenant).",
      "indexes": [
        {
          "name": "runtime_records_updated",
          "fields": [
            "collection",
            "updated-at"
          ]
        }
      ]
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "runtime",
      "scope": "platform",
      "id": "tbl-runtime-outbox",
      "name": "Machine outbox (runtime database)",
      "key": [
        "id"
      ],
      "indexes": [
        {
          "name": "runtime_outbox_due",
          "fields": [
            "source",
            "next-attempt-at"
          ]
        },
        {
          "name": "runtime_outbox_not_before",
          "fields": [
            "source",
            "not-before",
            "id"
          ]
        }
      ],
      "fields": [
        {
          "name": "id",
          "type": "u64",
          "description": "Assigned on insert and never reused."
        },
        {
          "name": "source",
          "type": "string",
          "description": "The emitting machine."
        },
        {
          "name": "key",
          "type": "string",
          "description": "The emitting instance, as JSON text.",
          "personal": "identifier"
        },
        {
          "name": "receiver",
          "type": "string"
        },
        {
          "name": "event",
          "type": "json",
          "personal": "other",
          "description": "The event, as JSON text."
        },
        {
          "name": "created-at",
          "type": "timestamp",
          "description": "When the transition committed."
        },
        {
          "name": "attempts",
          "type": "u64",
          "description": "Failed dispatches so far."
        },
        {
          "name": "next-attempt-at",
          "type": "timestamp",
          "description": "When the outbox may next hand the row out for dispatch."
        },
        {
          "name": "last-error",
          "type": "string",
          "optional": true,
          "description": "Why the last dispatch failed."
        },
        {
          "name": "delivery",
          "type": "string",
          "description": "at-least-once or at-most-once."
        },
        {
          "name": "not-before",
          "type": "timestamp",
          "description": "The earliest time it may be dispatched; later than created-at for a delayed emit."
        }
      ],
      "retention": "Until dispatched or spent: a row is deleted when its dispatch succeeds (at-least-once) or when a host claims it to dispatch it once (at-most-once). A row whose dispatch fails keeps attempts, next-attempt-at and last-error up to date after each failure; the dispatch that fails for the tenth time (RetryPolicy::max_attempts) deletes the row and writes it to runtime_dead_letters with its receiver, the number of attempts and the last error. With the default retry policy the ten attempts are spread over 511 seconds.",
      "erasure": {
        "point": "the successful dispatch, the claim or the dead-lettering of the row, or the deletion of the database file"
      },
      "description": "Table runtime_outbox of a runtime database: events a machine emitted, written in the transaction of the transition that emitted them and dispatched after it commits, so that an at-least-once emit survives a stop and a delayed emit waits for its time. The runtime keeps its machine tables in the database file the host gives it (Database::open), which belongs to one tenant (runtime_tenant)."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "runtime",
      "scope": "platform",
      "id": "tbl-runtime-timers",
      "name": "Machine timers (runtime database)",
      "key": [
        "id"
      ],
      "unique": [
        [
          "machine",
          "key",
          "name"
        ]
      ],
      "indexes": [
        {
          "name": "runtime_timers_due",
          "fields": [
            "machine",
            "fire-at"
          ]
        }
      ],
      "fields": [
        {
          "name": "id",
          "type": "u64"
        },
        {
          "name": "machine",
          "type": "string"
        },
        {
          "name": "key",
          "type": "string",
          "description": "The instance, as JSON text.",
          "personal": "identifier"
        },
        {
          "name": "name",
          "type": "string",
          "description": "The timer name; setting a timer of the same machine, key and name replaces the earlier one."
        },
        {
          "name": "fire-at",
          "type": "timestamp"
        },
        {
          "name": "event",
          "type": "json",
          "personal": "other",
          "description": "The event the timer delivers when it fires, as JSON text."
        }
      ],
      "retention": "Until the timer fires, is cancelled or is replaced: a fired timer is deleted when the host takes it, cancel-timer deletes it, and a new timer of the same machine, key and name deletes the earlier row first.",
      "erasure": {
        "point": "the firing, the cancellation or the replacement of the timer, or the deletion of the database file"
      },
      "description": "Table runtime_timers of a runtime database: the timers machines have set, one row per machine, key and name. The runtime keeps its machine tables in the database file the host gives it (Database::open), which belongs to one tenant (runtime_tenant)."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "runtime",
      "scope": "platform",
      "id": "tbl-runtime-queue",
      "name": "System queue (runtime database)",
      "key": [
        "seq"
      ],
      "indexes": [
        {
          "name": "runtime_queue_order",
          "fields": [
            "due",
            "seq"
          ]
        },
        {
          "name": "runtime_queue_timer",
          "fields": [
            "target-machine",
            "target-key",
            "timer"
          ]
        }
      ],
      "fields": [
        {
          "name": "seq",
          "type": "u64",
          "description": "Assigned on insert; entries due at the same time are taken in this order."
        },
        {
          "name": "due",
          "type": "timestamp"
        },
        {
          "name": "event",
          "type": "json",
          "personal": "other",
          "description": "The event, as JSON text."
        },
        {
          "name": "target-machine",
          "type": "string",
          "optional": true
        },
        {
          "name": "target-key",
          "type": "string",
          "optional": true,
          "personal": "identifier"
        },
        {
          "name": "timer",
          "type": "string",
          "optional": true,
          "description": "The timer that put the entry on the queue, when one did."
        },
        {
          "name": "source",
          "type": "string"
        },
        {
          "name": "source-key",
          "type": "string",
          "personal": "identifier"
        }
      ],
      "retention": "Until the entry is taken: the host deletes the row in the transaction that handles it or moves it to runtime_dead_letters, and the cancellation of a timer deletes the entry that timer put on the queue.",
      "erasure": {
        "point": "the handling of the entry, its move to the dead letters, the cancellation of its timer, or the deletion of the database file"
      },
      "description": "Table runtime_queue of a runtime database: the system queue of events waiting to be delivered in order of due time. The runtime keeps its machine tables in the database file the host gives it (Database::open), which belongs to one tenant (runtime_tenant)."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "runtime",
      "scope": "platform",
      "id": "tbl-runtime-dead-letters",
      "name": "Dead letters (runtime database)",
      "key": [
        "id"
      ],
      "fields": [
        {
          "name": "id",
          "type": "u64"
        },
        {
          "name": "seq",
          "type": "u64",
          "description": "The seq the entry had in runtime_queue; for an outbox message that spent its attempts, the id it had in runtime_outbox."
        },
        {
          "name": "due",
          "type": "timestamp",
          "description": "When the entry was due; for an outbox message, its not-before time."
        },
        {
          "name": "event",
          "type": "json",
          "personal": "other",
          "description": "The event, as JSON text."
        },
        {
          "name": "target-machine",
          "type": "string",
          "optional": true
        },
        {
          "name": "target-key",
          "type": "string",
          "optional": true,
          "personal": "identifier"
        },
        {
          "name": "timer",
          "type": "string",
          "optional": true,
          "description": "The timer that put the entry on the queue, when one did."
        },
        {
          "name": "source",
          "type": "string"
        },
        {
          "name": "source-key",
          "type": "string",
          "personal": "identifier"
        },
        {
          "name": "error",
          "type": "string",
          "description": "Why the entry could not be handled. For an outbox message: its receiver, the number of attempts made and the error of the last one."
        },
        {
          "name": "at",
          "type": "timestamp",
          "description": "When it was moved here."
        }
      ],
      "retention": "Ninety days after the row was moved here (at). Every write that moves a row here (a queue entry that failed, an outbox message that spent its attempts) deletes, in the same transaction, each row whose at is more than 90 days before that write; the purge of the runtime (System::purge) deletes the rows past the same bound in one transaction, and the backend janitor calls it every 600 seconds, so a row goes when nothing further fails as well. A row stays until then so that someone can read why a queue entry failed or why an outbox message was given up; nothing else removes a row. These rows are platform operating data of the runtime, with no list for a tenant owner to release or drop them from (OPS-348 and D-519 concern the domain events and automation exceptions a tenant owner sees), so the retention rule of PRV-356 applies.",
      "erasure": {
        "point": "the next write that moves a row here after the row is 90 days old, the purge, or the deletion of the database file"
      },
      "description": "Table runtime_dead_letters of a runtime database: queue entries that failed, moved out of runtime_queue with the reason, kept so that someone can read why. The runtime keeps its machine tables in the database file the host gives it (Database::open), which belongs to one tenant (runtime_tenant).",
      "indexes": [
        {
          "name": "runtime_dead_letters_at",
          "fields": [
            "at"
          ]
        }
      ]
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "runtime",
      "scope": "platform",
      "id": "tbl-runtime-tenant",
      "name": "Owner of the machine tables (runtime database)",
      "key": [
        "only-row"
      ],
      "fields": [
        {
          "name": "only-row",
          "type": "u32",
          "description": "Always 1: the table holds at most one row."
        },
        {
          "name": "tenant",
          "type": "tenant-id",
          "description": "The tenant the machine tables of this database belong to."
        }
      ],
      "retention": "Written by the first open of the database for a tenant and kept until the database file is deleted; an open for another tenant is refused and writes nothing.",
      "erasure": {
        "point": "the deletion of the database file"
      },
      "description": "Table runtime_tenant of a runtime database: the one tenant that owns the machine tables of the file, so that two tenants cannot share them."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-idempotency",
      "name": "Idempotency keys (tenant file)",
      "scope": "platform",
      "key": [
        "principal",
        "key"
      ],
      "indexes": [
        {
          "name": "idempotency_recorded",
          "fields": [
            "recorded-at"
          ]
        },
        {
          "name": "idempotency_expires",
          "fields": [
            "expires-at"
          ]
        }
      ],
      "fields": [
        {
          "name": "principal",
          "type": "string",
          "personal": "identifier",
          "description": "The principal that chose the key, as canonical JSON."
        },
        {
          "name": "key",
          "type": "string",
          "description": "The idempotency key the caller chose."
        },
        {
          "name": "request-hash",
          "type": "hash",
          "description": "The canonical hash of the intent the key was first used with."
        },
        {
          "name": "recorded-at",
          "type": "timestamp",
          "description": "The time of the commit that recorded the key; the retention counts from here."
        },
        {
          "name": "revision",
          "type": "u64",
          "description": "The state revision the commit made."
        },
        {
          "name": "last-position",
          "type": "u64",
          "optional": true,
          "description": "The outbox position of the last event the commit wrote, when it wrote any."
        },
        {
          "name": "result",
          "type": "json",
          "personal": "other",
          "description": "The first result of the request, as JSON text, without the delta operations, the events and the effects."
        },
        {
          "name": "expires-at",
          "type": "timestamp",
          "description": "When the entry is past its retention: recorded-at and the retention its request stated (D-7701): twenty-four hours, seven days for an invocation of a tenant operation, and for an automation step the longest retry of the step and ninety days."
        }
      ],
      "retention": "Stated by each entry in expires-at (D-7701): twenty-four hours from recorded-at for a request of a person or service, seven days for an invocation of a tenant operation (its run record, rec-tenant-operation-run), and for the record change of an automation step the longest the step can retry plus ninety days. A lookup ignores a row past it, and every commit of the tenant deletes the rows past it in its own transaction, so a row of a tenant that does not commit again stays until its next commit or the deletion of the tenant file.",
      "erasure": {
        "point": "the first commit of the tenant after the retention has passed, or the deletion of the tenant file"
      },
      "description": "Table idempotency of a tenant file: the first result recorded under each idempotency key of a principal, in the transaction of the commit it describes, so that a repeat of the same request inside the retention returns that result and changes nothing (D-6595)."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-audit-log",
      "name": "Security audit trail (tenant file)",
      "scope": "platform",
      "key": [
        "seq"
      ],
      "indexes": [
        {
          "name": "audit_log_kind",
          "fields": [
            "kind",
            "seq"
          ]
        }
      ],
      "fields": [
        {
          "name": "seq",
          "type": "u64",
          "description": "Assigned on insert, in the order the entries were written."
        },
        {
          "name": "at",
          "type": "timestamp"
        },
        {
          "name": "kind",
          "type": "string",
          "description": "decision for an authentication decision, audit for any other security event."
        },
        {
          "name": "event",
          "type": "string",
          "description": "The event name, such as auth.decision or signing_key.compromised."
        },
        {
          "name": "correlation",
          "type": "correlation-id"
        },
        {
          "name": "data",
          "type": "json",
          "personal": "other",
          "description": "What the entry records, as JSON text the store does not read; the members that name a person are sealed under that person's key (D-7725)."
        },
        {
          "name": "chain",
          "type": "hash",
          "optional": true,
          "description": "The hash of the chain value of the line before and of this line as stored (strata_storage_api::audit_chain); absent on a line written before the chain existed (D-7725, PRV-360)."
        }
      ],
      "retention": "Until the tenant file is deleted: the store only appends entries and reads them back newest first, and nothing removes or shortens them, so the trail outlasts the audit retention of one year (RUN-1380). An entry is never rewritten; the members that name a person are sealed under that person's key, so the erasure of the person makes them unreadable and the chain over the sealed form still verifies (D-7725, PRV-359).",
      "erasure": {
        "point": "the deletion of the tenant file"
      },
      "description": "Table audit_log of a tenant file: every authentication decision and security audit event of the tenant, written before the request that caused it is answered, so that it survives a restart (RUN-1380)."
    },
    {
      "schemaVersion": 1,
      "realisation": "shipped",
      "owner": "sqlite-adapter",
      "id": "tbl-jobs",
      "name": "Automation worker jobs (tenant file)",
      "scope": "platform",
      "key": [
        "seq"
      ],
      "unique": [
        [
          "id"
        ],
        [
          "key"
        ]
      ],
      "indexes": [
        {
          "name": "jobs_due",
          "fields": [
            "due-at"
          ]
        }
      ],
      "fields": [
        {
          "name": "seq",
          "type": "u64",
          "description": "Assigned on insert, in the order the jobs were created: the cursor of a listing."
        },
        {
          "name": "id",
          "type": "job-id",
          "description": "Derived from the tenant and the key, so that a repeat of a key names the same job."
        },
        {
          "name": "key",
          "type": "string",
          "description": "The job is created once for its key within the tenant (SCH-004)."
        },
        {
          "name": "state",
          "type": "job-state"
        },
        {
          "name": "due-at",
          "type": "timestamp",
          "description": "When a waiting job is due; for a leased job, when its lease expires (SCH-010)."
        },
        {
          "name": "data",
          "type": "json",
          "personal": "other",
          "description": "The whole job as canonical JSON: what it does, its attempts, its retry policy, its fencing token and the error of each failed attempt (SCH-014)."
        }
      ],
      "retention": "Thirty days after the job ended (rec-job): the janitor removes an ended job past it (D-7703). A job that has not ended stays until the tenant file is deleted.",
      "erasure": {
        "point": "the deletion of the tenant file"
      },
      "description": "Table jobs of a tenant file: the due work of the automation worker (rec-job, SCH-001 to SCH-015). A job is created once for its key, in the commit that causes it or alone; it is leased with a fencing token and an expiry, reported once, retried after a growing delay up to the attempts of its policy, and failed, completed or cancelled for good."
    },
    {
      "schemaVersion": 1,
