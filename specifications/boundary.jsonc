      "limit": 20,
      "window": "1 h",
      "onExceed": "refuse",
      "error": "throttled",
      "heldBy": "limit-store"
    },
    {
      "id": "q-cancel-recovery",
      "description": "Anonymous calls of cancel-recovery from one source address.",
      "scope": "source-address",
      "contract": "cancel-recovery",
      "limit": 20,
      "window": "1 h",
      "onExceed": "refuse",
      "error": "throttled",
      "heldBy": "limit-store"
    },
    {
