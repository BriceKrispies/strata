  "featureFlags": [
    {
      "id": "assistant-flag",
      "name": "Assistant",
      "description": "The conversational assistant is released per tenant: off for a tenant unless the release record of the flag enables it there (OPS-328).",
      "gates": [
        "assistant-converse"
      ],
      "default": "off",
      "source": "ops-328"
    }
  ],
  "delegations": [
    {
      "id": "assistant",
      "name": "Assistant",
      "description": "The conversation service acts for a person with a delegated token that names the person (D-200, TOK-003, CNV-201): it calls only catalogue operations, and never more than the person holds (TOK-004, CNV-202).",
      "from": "operations",
      "to": "agent",
      "capabilities": [
        "catalogue-read",
        "operation-invoke",
        "change-propose",
        "change-undo",
        "records-read",
        "token-exchange"
      ],
      "source": "cnv-201"
    },
    {
      "id": "tenant-agent",
      "name": "Tenant agent",
      "description": "An agent of a tenant acts through the agent gateway for the person who registered it, within the scopes of its token and the purpose of its delegation (AGS-406..408).",
      "from": "operations",
      "to": "agent",
      "capabilities": [
        "catalogue-read",
        "operation-invoke",
        "change-propose",
        "change-undo",
        "records-read",
        "events-subscribe",
        "agents-read",
        "flags-manage",
        "token-exchange"
      ],
      "source": "ags-406"
    },
    {
      "id": "operating-agent",
      "name": "Platform operating agent",
      "description": "The platform operating agent acts for an operator, within the platform operations scope.",
      "from": "platform-operations",
      "to": "agent",
      "capabilities": [
        "platform-describe",
        "requirements-read",
        "releases-read",
        "diagnostics-run",
        "agent-spend-report",
        "release-deploy",
        "release-drift-report"
      ]
    }
  ],
