      }
    },
    {
      "id": "fieldnotes",
      "summary": "Fieldnotes' editorial look, unchanged: Fraunces, Newsreader and Instrument Sans on warm papers, five accents, three papers.",
      "defaults": {"accent": "moss", "paper": "linen"},
      "acceptedShortfalls": [
        {"pair": "border-strong on surface", "scheme": "light", "floor": 2.9, "reason": "Fieldnotes keeps its rule-strong colour unchanged on screen; its edge measures just under 3 to 1 here."},
        {"pair": "border-strong on surface-sunk", "scheme": "light", "floor": 2.6, "reason": "Fieldnotes keeps its rule-strong colour unchanged on screen; its edge measures just under 3 to 1 here."},
        {"pair": "border-strong on surface-raised", "scheme": "dark", "floor": 2.8, "reason": "Fieldnotes keeps its rule-strong colour unchanged on screen; its edge measures just under 3 to 1 here."},
        {"pair": "border-strong on surface-overlay", "scheme": "dark", "floor": 2.8, "reason": "Fieldnotes keeps its rule-strong colour unchanged on screen; its edge measures just under 3 to 1 here."},
        {"pair": "control-border on surface", "scheme": "light", "floor": 2.9, "reason": "Fieldnotes keeps its rule-strong colour unchanged on screen; its edge measures just under 3 to 1 here."},
        {"pair": "control-border on surface-sunk", "scheme": "light", "floor": 2.6, "reason": "Fieldnotes keeps its rule-strong colour unchanged on screen; its edge measures just under 3 to 1 here."},
        {"pair": "control-border on surface-raised", "scheme": "dark", "floor": 2.8, "reason": "Fieldnotes keeps its rule-strong colour unchanged on screen; its edge measures just under 3 to 1 here."},
        {"pair": "control-border on surface-overlay", "scheme": "dark", "floor": 2.8, "reason": "Fieldnotes keeps its rule-strong colour unchanged on screen; its edge measures just under 3 to 1 here."}
      ],
      "shared": {
        "swatch-moss": "#4f6140", "swatch-clay": "#8a4a31", "swatch-ink": "#2f4a5c", "swatch-ochre": "#765610", "swatch-plum": "#6b3f5b",
        "swatch-linen": "#efeadf", "swatch-stone": "#e9e8e3", "swatch-chalk": "#f6f4ee", "qr-ground": "#ffffff",
        "font-display": "'Fraunces Variable', 'Iowan Old Style', 'Palatino Linotype', Georgia, serif",
        "font-text": "'Newsreader Variable', 'Iowan Old Style', Georgia, serif",
        "font-ui": "'Instrument Sans Variable', 'Segoe UI', system-ui, sans-serif",
        "font-code": "ui-monospace, 'Cascadia Mono', Consolas, monospace",
        "text-xs": "0.8125rem", "text-sm": "0.9375rem",
        "text-md": "clamp(1.0625rem, 0.98rem + 0.35vw, 1.1875rem)",
        "text-lg": "clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem)",
        "text-xl": "clamp(1.6rem, 1.3rem + 1.3vw, 2.25rem)",
        "text-2xl": "clamp(2.1rem, 1.5rem + 2.8vw, 3.5rem)",
        "text-3xl": "clamp(2.6rem, 1.4rem + 5.6vw, 5.75rem)",
        "leading-tight": "1.02", "leading-snug": "1.22", "leading-text": "1.62", "tracking-display": "-0.022em",
        "space-1": "0.25rem", "space-2": "0.5rem", "space-3": "0.75rem", "space-4": "1rem", "space-5": "1.5rem",
        "space-6": "2rem", "space-7": "3rem", "space-8": "4.5rem", "space-9": "7rem", "density": "1",
        "radius-1": "2px", "radius-2": "4px", "radius-3": "6px", "border-hair": "1px", "border-rule": "2px",
        "ease": "cubic-bezier(0.2, 0.7, 0.2, 1)", "dur-quick": "120ms", "dur-settle": "520ms",
        "size-control": "2.75rem", "width-page": "76rem", "width-measure": "36rem", "width-margin": "11.5rem", "width-form": "30rem",
        "gutter": "clamp(1.25rem, 0.6rem + 3vw, 3rem)"
      },
      "light": {
        "surface": "#efeadf", "surface-sunk": "#e4ddcd", "surface-raised": "#f7f3ea", "surface-overlay": "{surface-raised}",
        "text": "#23211c", "text-muted": "#5c574b", "text-on-accent": "#f7f3ea", "text-on-danger": "{surface}", "link": "{text}",
        "border": "#cdc5b1", "border-strong": "#8f8873", "control-border": "{border-strong}", "focus": "#1d4f91",
        "accent": "#4f6140", "accent-strong": "#3c4b30", "accent-wash": "#dbe0cb",
        "tone-neutral-fg": "{text-muted}", "tone-neutral-bg": "{surface-sunk}",
        "tone-info-fg": "{accent-strong}", "tone-info-bg": "{accent-wash}",
        "tone-success-fg": "#3d5a2a", "tone-success-bg": "#dfe8cf",
        "tone-warning-fg": "{text}", "tone-warning-bg": "#f1e2bd",
        "tone-danger-fg": "#8c2f1f", "tone-danger-bg": "#f4ddd6",
        "shadow-1": "0 1px 0 rgb(35 33 28 / 0.06)",
        "shadow-2": "0 1px 0 rgb(35 33 28 / 0.06), 0 12px 28px -18px rgb(35 33 28 / 0.45)",
        "shadow-3": "0 1px 0 rgb(35 33 28 / 0.08), 0 20px 40px -20px rgb(35 33 28 / 0.55)",
        "image-dim": "1"
      },
      "dark": {
        "surface": "#1b1d19", "surface-sunk": "#151713", "surface-raised": "#252822", "surface-overlay": "{surface-raised}",
        "text": "#e9e4d6", "text-muted": "#aaa594", "text-on-accent": "#1b1d19", "text-on-danger": "{surface}", "link": "{text}",
        "border": "#3a3d35", "border-strong": "#6e7164", "control-border": "{border-strong}", "focus": "#9cc3f5",
        "accent": "#a9bc8f", "accent-strong": "#c3d3ac", "accent-wash": "#2c3326",
        "tone-neutral-fg": "{text-muted}", "tone-neutral-bg": "{surface-sunk}",
        "tone-info-fg": "{accent-strong}", "tone-info-bg": "{accent-wash}",
        "tone-success-fg": "#b4d39a", "tone-success-bg": "#26331f",
        "tone-warning-fg": "{text}", "tone-warning-bg": "#3b3420",
        "tone-danger-fg": "#f0a394", "tone-danger-bg": "#3d2520",
        "shadow-1": "0 1px 0 rgb(0 0 0 / 0.4)",
        "shadow-2": "0 1px 0 rgb(0 0 0 / 0.4), 0 14px 30px -16px rgb(0 0 0 / 0.8)",
        "shadow-3": "0 1px 0 rgb(0 0 0 / 0.5), 0 24px 44px -18px rgb(0 0 0 / 0.9)",
        "image-dim": "0.86"
      },
      "variants": {
        "paper": {
          "stone": {
            "light": {"surface": "#e9e8e3", "surface-sunk": "#dcdbd4", "surface-raised": "#f3f2ee", "border": "#c5c4ba", "border-strong": "#86857a", "text-muted": "#55554c"},
            "dark": {"surface": "#1c1d1e", "surface-sunk": "#151617", "surface-raised": "#26282a", "border": "#3a3c3e"}
          },
          "chalk": {
            "light": {"surface": "#f6f4ee", "surface-sunk": "#eae7dd", "surface-raised": "#fdfcf8", "border": "#d6d2c5", "border-strong": "#8f8b7c"},
            "dark": {"surface": "#201f1c", "surface-sunk": "#181714", "surface-raised": "#2b2a26", "border": "#403e38"}
          }
        },
        "accent": {
          "clay": {
            "light": {"accent": "#8a4a31", "accent-strong": "#6f3a25", "accent-wash": "#ecd8cb"},
            "dark": {"accent": "#dba58c", "accent-strong": "#ecc1ad", "accent-wash": "#3a2a22"}
          },
          "ink": {
            "light": {"accent": "#2f4a5c", "accent-strong": "#223746", "accent-wash": "#d3dde2"},
            "dark": {"accent": "#9fbbcd", "accent-strong": "#bfd4e1", "accent-wash": "#232e35"}
          },
          "ochre": {
            "light": {"accent": "#765610", "accent-strong": "#5c430b", "accent-wash": "#ecdfb8"},
            "dark": {"accent": "#d6b563", "accent-strong": "#e6cd8f", "accent-wash": "#37301b"}
          },
          "plum": {
            "light": {"accent": "#6b3f5b", "accent-strong": "#532f46", "accent-wash": "#e5d5de"},
            "dark": {"accent": "#cda5c0", "accent-strong": "#e0c3d6", "accent-wash": "#35262f"}
          }
        }
      }
    }
  ],
  "bindings": [
    {
      "id": "setting", "since": "1.0",
      "summary": {"en": "A setting of the tenant or the platform, by its id, and the level the viewer writes (tenant or person). Shows the value the viewer reads and where it comes from, in words; writes through the setting contract of that level and reads the setting again on each notice of its change."},
      "binds": ["setting"],
      "states": ["loading", "ready", "error"],
      "props": {
        "setting": {"type": "setting-id"},
        "level": {"enum": ["tenant", "person"]}
      },
      "control": {
        "closed-list": "select",
        "reference": "text (the record id, until the records of the object type are served)",
        "range": "number",
        "bool": "switch",
        "other": "text"
      },
      "readOnlyWhen": "the viewer may not write the level, or a lock closes it; the reason is said in words"
    }
  ],
  "templates": [
    {
      "id": "settings", "since": "1.0", "layout": "settings",
      "summary": {"en": "The Settings screen: one section per product area, each setting with its value, its source and the controls of the levels the viewer may write. Every tenant has it at /settings for a signed-in person."},
      "regions": ["main"],
      "bindsEach": "setting",
      "sectionTitle": "area",
      "states": ["loading", "ready", "error"],
      "emptyWords": {"title": "No settings yet", "text": "When your organisation or the platform defines a setting, it appears here."}
    }
  ]
}
