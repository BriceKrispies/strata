        "tone-danger-fg": "#ff9d94", "tone-danger-bg": "#3d1512",
        "shadow-1": "0 1px 2px rgb(0 0 0 / 0.4)",
        "shadow-2": "0 2px 8px -1px rgb(0 0 0 / 0.5), 0 1px 3px rgb(0 0 0 / 0.4)",
        "shadow-3": "0 14px 32px -8px rgb(0 0 0 / 0.7), 0 4px 8px -4px rgb(0 0 0 / 0.5)",
