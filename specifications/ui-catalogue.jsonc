    {"id":"border","group":"Lines","type":"colour"},
    {"id":"border-strong","group":"Lines","type":"colour"},
    {"id":"control-border","group":"Lines","type":"colour"},
    {"id":"focus","group":"Lines","type":"colour"},
    {"id":"accent","group":"Accent","type":"colour"},
    {"id":"accent-strong","group":"Accent","type":"colour"},
    {"id":"accent-wash","group":"Accent","type":"colour"},
    {"id":"tone-neutral-fg","group":"Tones","type":"colour"},
    {"id":"tone-neutral-bg","group":"Tones","type":"colour"},
    {"id":"tone-info-fg","group":"Tones","type":"colour"},
    {"id":"tone-info-bg","group":"Tones","type":"colour"},
    {"id":"tone-success-fg","group":"Tones","type":"colour"},
    {"id":"tone-success-bg","group":"Tones","type":"colour"},
    {"id":"tone-warning-fg","group":"Tones","type":"colour"},
    {"id":"tone-warning-bg","group":"Tones","type":"colour"},
    {"id":"tone-danger-fg","group":"Tones","type":"colour"},
    {"id":"tone-danger-bg","group":"Tones","type":"colour"},
    {"id":"swatch-moss","group":"Fixed","type":"colour"},
    {"id":"swatch-clay","group":"Fixed","type":"colour"},
    {"id":"swatch-ink","group":"Fixed","type":"colour"},
    {"id":"swatch-ochre","group":"Fixed","type":"colour"},
    {"id":"swatch-plum","group":"Fixed","type":"colour"},
    {"id":"swatch-linen","group":"Fixed","type":"colour"},
    {"id":"swatch-stone","group":"Fixed","type":"colour"},
    {"id":"swatch-chalk","group":"Fixed","type":"colour"},
    {"id":"qr-ground","group":"Fixed","type":"colour"},
    {"id":"font-display","group":"Type","type":"family"},
    {"id":"font-text","group":"Type","type":"family"},
    {"id":"font-ui","group":"Type","type":"family"},
    {"id":"font-code","group":"Type","type":"family"},
    {"id":"text-xs","group":"Type","type":"length"},
    {"id":"text-sm","group":"Type","type":"length"},
    {"id":"text-md","group":"Type","type":"length"},
    {"id":"text-lg","group":"Type","type":"length"},
    {"id":"text-xl","group":"Type","type":"length"},
    {"id":"text-2xl","group":"Type","type":"length"},
    {"id":"text-3xl","group":"Type","type":"length"},
    {"id":"leading-tight","group":"Type","type":"number"},
    {"id":"leading-snug","group":"Type","type":"number"},
    {"id":"leading-text","group":"Type","type":"number"},
    {"id":"tracking-display","group":"Type","type":"length"},
    {"id":"space-1","group":"Space","type":"length"},
    {"id":"space-2","group":"Space","type":"length"},
    {"id":"space-3","group":"Space","type":"length"},
    {"id":"space-4","group":"Space","type":"length"},
    {"id":"space-5","group":"Space","type":"length"},
    {"id":"space-6","group":"Space","type":"length"},
    {"id":"space-7","group":"Space","type":"length"},
    {"id":"space-8","group":"Space","type":"length"},
    {"id":"space-9","group":"Space","type":"length"},
    {"id":"density","group":"Space","type":"number"},
    {"id":"radius-1","group":"Shape","type":"length"},
    {"id":"radius-2","group":"Shape","type":"length"},
    {"id":"radius-3","group":"Shape","type":"length"},
    {"id":"border-hair","group":"Shape","type":"length"},
    {"id":"border-rule","group":"Shape","type":"length"},
    {"id":"shadow-1","group":"Elevation","type":"shadow"},
    {"id":"shadow-2","group":"Elevation","type":"shadow"},
    {"id":"shadow-3","group":"Elevation","type":"shadow"},
    {"id":"image-dim","group":"Elevation","type":"number"},
    {"id":"ease","group":"Motion","type":"easing"},
    {"id":"dur-quick","group":"Motion","type":"duration","reduced":"0ms"},
    {"id":"dur-settle","group":"Motion","type":"duration","reduced":"0ms"},
    {"id":"size-control","group":"Size","type":"length"},
    {"id":"width-page","group":"Size","type":"length"},
    {"id":"width-measure","group":"Size","type":"length"},
    {"id":"width-margin","group":"Size","type":"length"},
    {"id":"width-form","group":"Size","type":"length"},
    {"id":"gutter","group":"Size","type":"length"}
  ],
  "contrastPairs": [
    {"fg":"text","on":["surface","surface-sunk","surface-raised","surface-overlay"],"min":4.5},
    {"fg":"text-muted","on":["surface","surface-sunk","surface-raised","surface-overlay"],"min":4.5},
    {"fg":"link","on":["surface","surface-sunk","surface-raised","surface-overlay"],"min":4.5},
    {"fg":"text-on-accent","on":["accent"],"min":4.5},
    {"fg":"text-on-danger","on":["tone-danger-fg"],"min":4.5},
    {"fg":"tone-neutral-fg","on":["tone-neutral-bg"],"min":4.5},
    {"fg":"tone-info-fg","on":["tone-info-bg"],"min":4.5},
    {"fg":"tone-success-fg","on":["tone-success-bg"],"min":4.5},
    {"fg":"tone-warning-fg","on":["tone-warning-bg"],"min":4.5},
    {"fg":"tone-danger-fg","on":["tone-danger-bg"],"min":4.5},
    {"fg":"border-strong","on":["surface","surface-sunk","surface-raised","surface-overlay"],"min":3},
    {"fg":"control-border","on":["surface","surface-sunk","surface-raised","surface-overlay"],"min":3},
    {"fg":"focus","on":["surface","surface-sunk","surface-raised","surface-overlay"],"min":3},
    {"fg":"accent","on":["surface","surface-sunk","surface-raised","surface-overlay"],"min":3}
  ],
  "themes": [
    {
      "id": "neutral",
      "summary": "The neutral base: system font stack (no font file), cool grey ramp, one blue accent, comfortable radii, clear elevation for cards.",
      "shared": {
        "swatch-moss": "#4f6140", "swatch-clay": "#8a4a31", "swatch-ink": "#2f4a5c", "swatch-ochre": "#765610", "swatch-plum": "#6b3f5b",
        "swatch-linen": "#efeadf", "swatch-stone": "#e9e8e3", "swatch-chalk": "#f6f4ee", "qr-ground": "#ffffff",
        "font-display": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
        "font-text": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
        "font-ui": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
        "font-code": "ui-monospace, 'Cascadia Mono', 'SF Mono', Consolas, monospace",
        "text-xs": "0.75rem", "text-sm": "0.875rem", "text-md": "1rem", "text-lg": "1.25rem", "text-xl": "1.5rem",
        "text-2xl": "1.875rem", "text-3xl": "2.25rem",
        "leading-tight": "1.15", "leading-snug": "1.3", "leading-text": "1.55", "tracking-display": "-0.01em",
        "space-1": "0.25rem", "space-2": "0.5rem", "space-3": "0.75rem", "space-4": "1rem", "space-5": "1.5rem",
        "space-6": "2rem", "space-7": "3rem", "space-8": "4.5rem", "space-9": "7rem", "density": "1",
        "radius-1": "4px", "radius-2": "8px", "radius-3": "12px", "border-hair": "1px", "border-rule": "2px",
        "image-dim": "1",
        "ease": "cubic-bezier(0.2, 0, 0, 1)", "dur-quick": "120ms", "dur-settle": "280ms",
        "size-control": "2.5rem", "width-page": "72rem", "width-measure": "40rem", "width-margin": "12rem", "width-form": "28rem",
        "gutter": "clamp(1rem, 0.5rem + 2.5vw, 2rem)"
      },
      "light": {
        "surface": "#f6f7f9", "surface-sunk": "#eceef2", "surface-raised": "#ffffff", "surface-overlay": "#ffffff",
        "text": "#141821", "text-muted": "#4b5565", "text-on-accent": "#ffffff", "text-on-danger": "#ffffff", "link": "#1d4ed8",
        "border": "#dde1e8", "border-strong": "#6b7587", "control-border": "#6b7587", "focus": "#1d4ed8",
        "accent": "#1d4ed8", "accent-strong": "#1e40af", "accent-wash": "#e1e9fd",
        "tone-neutral-fg": "#3b4455", "tone-neutral-bg": "#e8ebf0",
        "tone-info-fg": "#1e40af", "tone-info-bg": "#e1e9fd",
        "tone-success-fg": "#166534", "tone-success-bg": "#dcf3e4",
        "tone-warning-fg": "#7a4a05", "tone-warning-bg": "#fbecc8",
        "tone-danger-fg": "#b42318", "tone-danger-bg": "#fde4e1",
        "shadow-1": "0 1px 2px rgb(16 24 40 / 0.06), 0 1px 1px rgb(16 24 40 / 0.04)",
        "shadow-2": "0 2px 6px -1px rgb(16 24 40 / 0.1), 0 1px 3px rgb(16 24 40 / 0.06)",
        "shadow-3": "0 12px 28px -8px rgb(16 24 40 / 0.22), 0 4px 8px -4px rgb(16 24 40 / 0.1)"
      },
      "dark": {
        "surface": "#0f1219", "surface-sunk": "#0a0d12", "surface-raised": "#171b24", "surface-overlay": "#1e2431",
        "text": "#e8ebf1", "text-muted": "#a3adbd", "text-on-accent": "#0b1020", "text-on-danger": "#1a0705", "link": "#8fb0ff",
        "border": "#283040", "border-strong": "#7d889c", "control-border": "#7d889c", "focus": "#9db8ff",
        "accent": "#7ea2ff", "accent-strong": "#a8c0ff", "accent-wash": "#1a2542",
        "tone-neutral-fg": "#c3cad6", "tone-neutral-bg": "#232a37",
        "tone-info-fg": "#a8c0ff", "tone-info-bg": "#1a2542",
        "tone-success-fg": "#86d9a3", "tone-success-bg": "#12301f",
