    {
      "id": "m-each-tenant-changed-separately",
      "kind": "temporal",
      "models": "ten-014",
      "statement": "The change is applied to each tenant database separately, with the outcome recorded for each: a failure for tenant a is recorded as failed and tenant b is changed.",
      "evaluate": {
        "method": "eventually",
        "scenarios": [
