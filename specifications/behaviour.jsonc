      ],
      "refines": "oidcv-flow",
      "refinement": {
        "states": {
          "oidcv-open-i": "oidcv-open"
        },
        "variables": {},
        "transitions": {
          "oidcv-accept-i": "oidcv-accept",
          "oidcv-refuse-i": "oidcv-refuse"
        }
      },
      "storage": {
        "record": "rec-identity-decision",
        "key": "decision-id",
        "creates": true
      },
      "realisation": "target"
    },
    {
      "id": "oidcs-flow",
      "name": "OpenID Connect sign-in start",
      "subject": "identity-service",
      "initial": "oidcs-open",
      "description": "The identity service starts an OpenID Connect sign-in only with the authorization code flow and a proof key.",
      "states": [
        {
          "id": "oidcs-open",
          "name": "Deciding"
        }
      ],
      "transitions": [
        {
          "id": "oidcs-accept-without-flow",
          "from": "oidcs-open",
