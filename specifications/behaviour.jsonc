    {
      "id": "lease-reach-flow",
      "name": "Lease and reach of the tenant database",
      "subject": "automation-worker",
      "initial": "lr-live",
      "description": "One job and one worker. The worker takes a lease on a due job only while it can reach the tenant database of the job; while it cannot, the job stays for another worker.",
      "variables": [
        {
          "name": "token",
          "type": "number",
          "initial": 0
        },
        {
          "name": "reachable",
          "type": "boolean",
          "initial": true
        }
      ],
      "states": [
        {
          "id": "lr-live",
          "name": "Live"
        }
      ],
      "transitions": [
        {
          "id": "lr-grant-unreachable",
          "from": "lr-live",
          "to": "lr-live",
          "on": "lr-job-due",
          "description": "Defect: takes a lease although the tenant database cannot be reached.",
          "guard": "!reachable",
          "faultOnly": true,
          "effects": [
            {
              "set": "token",
              "to": "token + 1"
            },
            {
              "emit": "lr-lease-granted"
            }
          ]
        },
        {
          "id": "lr-grant",
          "from": "lr-live",
          "to": "lr-live",
          "on": "lr-job-due",
          "guard": "reachable",
          "effects": [
            {
              "set": "token",
              "to": "token + 1"
            },
            {
              "emit": "lr-lease-granted"
            }
          ]
        },
        {
          "id": "lr-skip",
          "from": "lr-live",
          "to": "lr-live",
          "on": "lr-job-due",
          "guard": "!reachable",
          "effects": [
            {
              "emit": "lr-lease-skipped"
            }
          ]
        },
        {
          "id": "lr-lose-database",
          "from": "lr-live",
          "to": "lr-live",
          "on": "lr-unreachable",
          "effects": [
            {
              "set": "reachable",
              "to": false
            }
          ]
        },
        {
          "id": "lr-regain-database",
          "from": "lr-live",
          "to": "lr-live",
          "on": "lr-reachable",
          "effects": [
            {
              "set": "reachable",
              "to": true
            }
          ]
        }
      ]
    },
    {
