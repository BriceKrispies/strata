    {
      "id": "idp-outage-flow",
      "name": "Identity provider outage",
      "subject": "identity-service",
      "initial": "io-up",
      "description": "An external identity provider of the realm. While it is down, sign-in through it is refused with the outage named, and every other sign-in method of the realm keeps working.",
      "states": [
        {
          "id": "io-up",
          "name": "Provider answering"
        },
        {
          "id": "io-down",
          "name": "Provider down"
        }
      ],
      "transitions": [
        {
          "id": "io-go-down",
          "from": "io-up",
          "to": "io-down",
          "on": "io-outage",
          "effects": []
        },
        {
          "id": "io-sign-in-up",
          "from": "io-up",
          "to": "io-up",
          "on": "io-sign-in",
          "effects": [
            {
              "emit": "io-session-issued"
            }
          ]
        },
        {
          "id": "io-fail-all",
          "from": "io-down",
          "to": "io-down",
          "on": "io-sign-in",
          "guard": "event.method != 'federated'",
          "effects": [
            {
              "emit": "io-unavailable"
            }
          ],
          "faultOnly": true,
          "description": "Defect: refuses every method while the provider is down."
        },
        {
          "id": "io-sign-in-other",
          "from": "io-down",
          "to": "io-down",
          "on": "io-sign-in",
          "guard": "event.method != 'federated'",
          "effects": [
            {
              "emit": "io-session-issued"
            }
          ]
        },
        {
          "id": "io-sign-in-federated",
          "from": "io-down",
          "to": "io-down",
          "on": "io-sign-in",
          "effects": [
            {
              "emit": "io-unavailable"
            }
          ]
        }
      ],
      "realisation": "target"
    },
    {
      "level": "implementation",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "id": "idp-outage-flow-impl",
      "name": "Identity provider outage (implementation)",
      "subject": "identity-service",
      "initial": "io-up-i",
      "description": "The health of one identity provider as the identity service keeps it (rec-provider-health). While it is down only the sign-in through it fails; the other methods are answered as before.",
      "states": [
        {
          "id": "io-up-i",
          "name": "Provider answering"
        },
        {
          "id": "io-down-i",
          "name": "Provider down",
          "ignores": [
            "io-outage"
          ]
        }
      ],
      "transitions": [
        {
          "id": "io-go-down-i",
          "from": "io-up-i",
          "to": "io-down-i",
          "on": "io-outage",
          "effects": [],
          "otherwise": true
        },
        {
          "id": "io-sign-in-up-i",
          "from": "io-up-i",
          "to": "io-up-i",
          "on": "io-sign-in",
          "effects": [
            {
              "emit": "io-session-issued",
              "to": "web-application"
            }
          ],
          "otherwise": true
        },
        {
          "id": "io-sign-in-other-i",
          "from": "io-down-i",
          "to": "io-down-i",
          "on": "io-sign-in",
          "guard": "event.method != 'federated'",
          "effects": [
            {
              "emit": "io-session-issued",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "io-sign-in-federated-i",
          "from": "io-down-i",
          "to": "io-down-i",
          "on": "io-sign-in",
          "effects": [
            {
              "emit": "io-unavailable",
              "to": "web-application"
            }
          ],
          "otherwise": true
        }
      ],
      "refines": "idp-outage-flow",
      "refinement": {
        "states": {
          "io-up-i": "io-up",
          "io-down-i": "io-down"
        },
