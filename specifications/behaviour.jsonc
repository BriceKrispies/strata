  "events": [
    {"id":"ml-requested","name":"Link requested","description":"A person asks for a sign-in link."},
    {"id":"ml-mailed","name":"Link mailed","description":"The identity service sends the link.","delivery":"at-least-once"},
    {"id":"ml-presented","name":"Link presented","description":"A browser presents a link.","payload":[{"name":"token","type":"string"},{"name":"browser","type":"string"}]},
    {"id":"ml-session-issued","name":"Session issued from a link","description":"The link was accepted.","delivery":"at-most-once"},
    {"id":"ml-refused","name":"Link refused","description":"The link was not accepted.","delivery":"at-most-once"},
    {"id":"oidc-started","name":"OpenID Connect sign-in started","description":"A person chooses a provider."},
    {"id":"oidc-redirected","name":"Redirected to the provider","description":"The browser is sent to the provider with a state value.","delivery":"at-most-once"},
    {"id":"oidc-callback","name":"Callback received","description":"A callback arrives.","payload":[{"name":"state","type":"string"}]},
    {"id":"oidc-session-issued","name":"Session issued from a provider","description":"The callback was accepted and the token verified.","delivery":"at-most-once"},
    {"id":"oidc-refused","name":"Callback refused","description":"The callback was not accepted.","delivery":"at-most-once"},
    {"id":"sr-revoked","name":"Session revoked","description":"A session is revoked."},
    {"id":"sr-notice","name":"Revocation notice","description":"The runtime tells the WebSocket connections of a session that it ended (a session notice), and the connections close. Gateways that keep a copy learn of it at their next check.","delivery":"at-most-once"},
    {"id":"sr-request","name":"Request with the session","description":"A request arrives at the gateway carrying the session.","payload":[{"name":"session-id","type":"session-id"}]},
    {"id":"sr-lookup","name":"Session lookup","description":"The gateway asks the identity service about the session.","delivery":"at-least-once"},
    {"id":"sr-lookup-answer","name":"Session lookup answer","description":"The identity service answers.","payload":[{"name":"valid","type":"bool"}],"delivery":"at-most-once"},
    {"id":"sr-accepted","name":"Request accepted","description":"The gateway treated the session as valid.","delivery":"at-most-once"},
    {"id":"sr-refused","name":"Request refused","description":"The gateway refused the session.","delivery":"at-most-once"},
    {"id":"job-due","name":"Job due","description":"A job reaches its due time."},
    {"id":"lease-granted","name":"Lease granted","description":"A worker is given the job under a new token.","delivery":"at-least-once"},
    {"id":"lease-expired","name":"Lease expired","description":"The lease ran out with no result.","elapsed":true},
    {"id":"work-reported","name":"Work reported","description":"A worker reports a result with the token it holds.","payload":[{"name":"token","type":"u64"}]},
    {"id":"job-completed","name":"Job completed","description":"The result was recorded.","delivery":"at-most-once"},
    {"id":"result-refused","name":"Result refused","description":"The result was not recorded.","delivery":"at-most-once"},
    {"id":"ec-published","name":"Content published","description":"A change to a published record commits."},
    {"id":"ec-purge","name":"Purge","description":"The surrogate keys of the changed record are purged.","delivery":"at-most-once"},
    {"id":"ec-request","name":"Reader request","description":"A reader asks the edge for the page."},
    {"id":"ec-origin-fetch","name":"Origin fetch","description":"The edge asks the origin.","delivery":"at-least-once"},
    {"id":"ec-origin-answer","name":"Origin answer","description":"The origin answers with the current version.","payload":[{"name":"version","type":"u64"}],"delivery":"at-most-once"},
    {"id":"ec-served","name":"Page served","description":"The edge answers the reader.","delivery":"at-most-once"},
    {"id":"pv-requested","name":"Tenant requested","description":"A tenant is to be provisioned."},
    {"id":"pv-database-created","name":"Database created","description":"The tenant database exists.","delivery":"at-least-once"},
    {"id":"pv-layout-applied","name":"Layout applied","description":"The storage layout is in place.","delivery":"at-least-once"},
    {"id":"pv-template-installed","name":"Template installed","description":"The template was installed through kernel intents.","delivery":"at-least-once"},
    {"id":"pv-activated","name":"Tenant activated","description":"The directory reports the tenant as active.","delivery":"at-most-once"},
    {"id":"pv-step-failed","name":"Provisioning step failed","description":"A step of provisioning failed."},
    {"id":"pv-rolled-back","name":"Provisioning rolled back","description":"What was created has been removed.","delivery":"at-most-once"},
    {"id":"cp-proposed","name":"Change proposed","description":"A change is submitted.","payload":[{"name":"risky","type":"bool"}]},
    {"id":"cp-projected","name":"Change projected","description":"The projection of the change has run.","delivery":"at-least-once"},
    {"id":"cp-approved","name":"Proposal approved","description":"A permitted principal approved."},
    {"id":"cp-rejected","name":"Proposal rejected","description":"A permitted principal rejected."},
    {"id":"cp-apply-requested","name":"Apply requested","description":"Someone asks for the change to be applied."},
    {"id":"cp-applied","name":"Change applied","description":"The change was committed.","delivery":"at-least-once"},
    {"id":"cp-refused","name":"Apply refused","description":"The change was not committed.","delivery":"at-most-once"},
    {"id":"rt-intent","name":"Intent received","description":"The runtime receives an intent.","payload":[{"name":"correlation","type":"correlation-id"}]},
    {"id":"rt-decided","name":"Transition decided","description":"The kernel accepted the intent.","delivery":"at-most-once"},
    {"id":"rt-committed","name":"Commit confirmed","description":"The store confirmed the commit.","delivery":"at-least-once"},
    {"id":"arc-ob-delivered","name":"Notice delivered","description":"The notice queue delivers an event notice to a subscriber.","payload":[{"name":"seq","type":"u64"}],"delivery":"at-least-once"},
    {"id":"arc-ob-acknowledged","name":"Notice acknowledged","description":"The subscriber acknowledges the notice.","delivery":"at-most-once"},
    {"id":"arc-ob-publish-now","name":"Publish now","description":"The runtime that committed publishes the events it committed.","delivery":"at-most-once"},
    {"id":"arc-ob-sweep-due","name":"Outbox job due","description":"The outbox job of a tenant comes due.","elapsed":true},
    {"id":"arc-ob-published","name":"Events published","description":"The unpublished events of the tenant were handed to subscribers.","delivery":"at-least-once"},
    {"id":"arc-rl-deploy-started","name":"Rolling deployment started","description":"A newer version starts beside the older one."},
    {"id":"arc-rl-commit","name":"Commit requested","description":"A running version makes a commit."},
    {"id":"arc-rl-committed","name":"Commit written","description":"The commit was written in the format of the version that made it.","delivery":"at-most-once"},
    {"id":"arc-rl-deploy-finished","name":"Rolling deployment finished","description":"The older version has stopped."},
    {"id":"pl-presented","name":"Preview link presented","description":"A reader presents a preview link."},
    {"id":"pl-shown","name":"Draft shown from a preview link","description":"The draft was shown to the reader.","delivery":"at-most-once"},
    {"id":"pl-refused","name":"Preview link refused","description":"The link was not accepted.","delivery":"at-most-once"},
    {"id":"iw-received","name":"Inbound delivery received","description":"An inbound webhook delivery arrives with its event key.","payload":[{"name":"key","type":"string"}],"delivery":"at-least-once"},
    {"id":"iw-run-started","name":"Workflow run started","description":"A run was started from an inbound delivery.","delivery":"at-most-once"},
    {"id":"iw-ignored","name":"Repeated delivery ignored","description":"A repeated delivery started nothing.","delivery":"at-most-once"},
    {"id":"cv-proposed","name":"Change proposed","description":"The assistant proposes a change for a preview."},
    {"id":"cv-previewed","name":"Preview shown","description":"The preview of a proposed change is shown.","delivery":"at-most-once"},
    {"id":"cv-confirmed","name":"Preview confirmed","description":"The person confirms the preview."},
    {"id":"cv-cancel","name":"Preview cancelled","description":"The person cancels or replaces the preview."},
    {"id":"cv-cancelled","name":"Proposal cancelled","description":"The proposed change is withdrawn.","delivery":"at-most-once"},
    {"id":"cv-apply-requested","name":"Apply requested","description":"The assistant asks for the change to be applied."},
    {"id":"cv-applied","name":"Change applied","description":"The change was committed.","delivery":"at-least-once"},
    {"id":"cv-refused","name":"Apply refused","description":"The change was not applied.","delivery":"at-most-once"},
    {"id":"cv-permission-withdrawn","name":"Permission withdrawn","description":"The person loses a permission during a conversation."},
    {"id":"cv-operation-run","name":"Operation run","description":"The assistant runs an operation for the person."},
    {"id":"cv-operation-committed","name":"Operation committed","description":"The operation committed its change.","delivery":"at-most-once"},
    {"id":"cv-operation-refused","name":"Operation refused","description":"The operation was refused.","delivery":"at-most-once"},
    {"id":"saml-response","name":"SAML response presented","description":"A browser presents a SAML response with its assertion.","delivery":"at-least-once"},
    {"id":"saml-session-issued","name":"Session issued from a SAML assertion","description":"The assertion was accepted.","delivery":"at-most-once"},
    {"id":"saml-refused","name":"SAML response refused","description":"The assertion was not accepted.","delivery":"at-most-once"},
    {"id":"pw-attempt","name":"Password attempt","description":"A password is presented for an account.","payload":[{"name":"guess","type":"string"},{"name":"limit-key","type":"string"}]},
    {"id":"pw-accepted","name":"Password accepted","description":"The password was accepted.","delivery":"at-most-once"},
    {"id":"pw-refused","name":"Password refused","description":"The password attempt was refused.","delivery":"at-most-once"},
    {"id":"sr-unavailable","name":"Refused for identity outage","description":"A request that needs a session is refused because the identity service did not answer.","delivery":"at-most-once"},
    {"id":"tc-change","name":"Chained change","description":"A committed change that may start a chain of triggers.","payload":[{"name":"hop","type":"u64"},{"name":"correlation","type":"correlation-id"}],"delivery":"at-least-once"},
    {"id":"tc-job-created","name":"Job created by a chain","description":"A trigger in a chain created a job.","delivery":"at-most-once"},
    {"id":"tc-cut","name":"Chain cut","description":"A chain reached its hop limit and creates no job.","delivery":"at-most-once"},
    {"id":"er-erase-committed","name":"Erasure committed","description":"The erasure of a principal commits in the tenant database.","payload":[{"name":"copy-ref","type":"reference"}]},
    {"id":"er-purge-sent","name":"Purge of the erased copy","description":"The purge of the erased copy is sent.","payload":[{"name":"copy-ref","type":"reference"}]},
    {"id":"er-read","name":"Reader request for the copy","description":"A reader asks for the copy.","payload":[{"name":"copy-ref","type":"reference"}]},
    {"id":"er-served","name":"Copy answered","description":"The copy answers the reader.","delivery":"at-most-once"},
    {"id":"sk-shred","name":"Subject key destruction requested","description":"The key of one subject is to be destroyed.","payload":[{"name":"key-id","type":"key-id"}]},
    {"id":"sk-destroyed","name":"Subject key destroyed","description":"The key service reports the destruction.","delivery":"at-least-once"},
    {"id":"sk-read","name":"Sealed field read","description":"A read of a sealed personal field.","payload":[{"name":"key-id","type":"key-id"}]},
    {"id":"sk-plain","name":"Plain value returned","description":"The personal value is returned in plain form.","delivery":"at-most-once"},
    {"id":"sk-sealed","name":"Sealed value returned","description":"Only the sealed form is returned.","delivery":"at-most-once"},
    {"id":"au-append","name":"Audit entry appended","description":"An entry is appended to the audit chain.","payload":[{"name":"tenant-id","type":"tenant-id"}]},
    {"id":"au-appended","name":"Audit entry recorded","description":"The entry is linked into the chain.","delivery":"at-most-once"},
    {"id":"au-erase","name":"Erasure reaches the audit chain","description":"The entries of an erased principal are to be sealed.","payload":[{"name":"tenant-id","type":"tenant-id"}]},
    {"id":"au-sealed","name":"Audit entries sealed","description":"The entries of the principal are sealed.","delivery":"at-least-once"},
    {"id":"ah-anomaly","name":"Anomaly rule trips","description":"A rule of the tenant (error spike, violated invariant or mass deletion) trips for an agent.","payload":[{"name":"principal-id","type":"principal-id"}]},
    {"id":"ah-halted","name":"Agent halted","description":"The agent is halted.","delivery":"at-least-once"},
    {"id":"ah-operation","name":"Agent operation requested","description":"The agent asks for an operation.","payload":[{"name":"principal-id","type":"principal-id"}]},
    {"id":"ah-applied","name":"Agent operation applied","description":"The operation was applied.","delivery":"at-most-once"},
    {"id":"ah-refused","name":"Agent operation refused","description":"The operation was refused because the agent is halted.","delivery":"at-most-once"},
    {"id":"ah-resume","name":"Agent resumed","description":"A principal other than the agent resumes it.","payload":[{"name":"principal-id","type":"principal-id"}]},
    {"id":"sp-proposed","name":"Proposal opened","description":"A proposal is opened by its author.","payload":[{"name":"author","type":"principal-id"},{"name":"proposal-id","type":"proposal-id"}]},
    {"id":"sp-approve","name":"Approval given","description":"A principal approves a proposal.","payload":[{"name":"by","type":"principal-id"},{"name":"proposal-id","type":"proposal-id"}]},
    {"id":"sp-cleared","name":"Proposal cleared","description":"The proposal is cleared for application.","delivery":"at-least-once"},
    {"id":"sp-refused","name":"Approval refused","description":"The approval does not count toward clearing the proposal.","delivery":"at-most-once"},
    {"id":"tk-request","name":"Page requested","description":"A reader asks for a page that holds a token whose value depends on the reader.","payload":[{"name":"reader","type":"string"}]},
    {"id":"tk-rendered","name":"Page rendered","description":"The page is answered.","delivery":"at-most-once"},
    {"id":"em-due","name":"Mail job due","description":"A mail job reaches the dispatcher, with its idempotency key.","payload":[{"name":"key","type":"string"},{"name":"message-id","type":"message-id"}]},
    {"id":"em-submit","name":"Message submitted","description":"The dispatcher hands the message to the adapter with its idempotency key.","payload":[{"name":"key","type":"string"}],"delivery":"at-least-once"},
    {"id":"em-ack","name":"Message accepted","description":"The adapter acknowledges the message.","delivery":"at-least-once"},
    {"id":"em-timeout","name":"No acknowledgement","description":"The dispatcher has waited for an acknowledgement and has none.","payload":[{"name":"message-id","type":"message-id"}],"elapsed":true},
    {"id":"em-recorded","name":"Message recorded as sent","description":"The dispatcher records the message as sent.","delivery":"at-most-once"},
    {"id":"cs-green-deployed","name":"Green deployed","description":"The release controller deploys the new colour beside the live one.","payload":[{"name":"environment-id","type":"environment-id"}]},
    {"id":"cs-green-verified","name":"Green verified","description":"The release record names the new colour as verified against production dependencies.","payload":[{"name":"environment-id","type":"environment-id"}]},
    {"id":"cs-switch-requested","name":"Switch requested","description":"The release controller asks the traffic switch to make green live.","payload":[{"name":"environment-id","type":"environment-id"}]},
    {"id":"cs-switch-refused","name":"Switch refused","description":"The traffic switch refuses a switch to a colour that is not verified.","delivery":"at-most-once"},
    {"id":"cs-traffic-green","name":"Public traffic to green","description":"The traffic switch sends public requests to green.","delivery":"at-least-once"},
    {"id":"cs-traffic-blue","name":"Public traffic to blue","description":"The traffic switch sends public requests back to blue.","delivery":"at-least-once"},
    {"id":"cs-rollback-requested","name":"Switch back requested","description":"The release controller asks the traffic switch to return to blue.","payload":[{"name":"environment-id","type":"environment-id"}]},
    {"id":"cs-request","name":"Public request","description":"A public request reaches the traffic switch.","payload":[{"name":"environment-id","type":"environment-id"}]},
    {"id":"cs-served-blue","name":"Request served by blue","description":"A public request is answered by the blue colour.","delivery":"at-most-once"},
    {"id":"cs-served-green","name":"Request served by green","description":"A public request is answered by the green colour.","delivery":"at-most-once"},
    {"id":"cs-served-withdrawn","name":"Request served by withdrawn colour","description":"A public request is answered by a colour that a switch back withdrew.","delivery":"at-most-once"},
    {"id":"rp-stage-gated","name":"Gated in stage","description":"A release records a passing result for every gate of the stage environment.","payload":[{"name":"release-id","type":"release-id"}]},
    {"id":"rp-approved","name":"Approval given","description":"A principal approves a production release.","payload":[{"name":"by","type":"principal-id"},{"name":"release-id","type":"release-id"}]},
    {"id":"rp-promote-requested","name":"Promotion requested","description":"The release controller asks to promote a release to production.","payload":[{"name":"release-id","type":"release-id"}]},
    {"id":"rp-production-received","name":"Production received release","description":"The production environment takes the release.","delivery":"at-least-once"},
    {"id":"rp-promotion-refused","name":"Promotion refused","description":"The release controller refuses a promotion.","delivery":"at-most-once"},
    {"id":"mg-started","name":"Migration run started","description":"A migration run begins for one tenant.","payload":[{"name":"run-id","type":"run-id"}]},
    {"id":"mg-batch-run","name":"Batch run","description":"A worker commits one batch of a migration run with its cursor.","payload":[{"name":"run-id","type":"run-id"}]},
    {"id":"mg-done","name":"Migration run complete","description":"Every record of the run has been converted.","delivery":"at-least-once"},
    {"id":"mg-interrupted","name":"Migration run stopped","description":"A worker stops during a migration run.","payload":[{"name":"run-id","type":"run-id"}]},
    {"id":"mg-resumed","name":"Migration run resumed","description":"A worker takes up a stopped migration run.","payload":[{"name":"run-id","type":"run-id"}]},
    {"id":"tm-move-requested","name":"Move requested","description":"A move of a tenant to another placement is requested.","payload":[{"name":"move-id","type":"move-id"}]},
    {"id":"tm-write-requested","name":"Write requested","description":"A write to the moving tenant is requested.","payload":[{"name":"move-id","type":"move-id"}]},
    {"id":"tm-write-accepted","name":"Write accepted","description":"A write to the moving tenant is committed.","delivery":"at-most-once"},
    {"id":"tm-write-refused","name":"Write refused","description":"A write to the moving tenant is refused during its read-only window.","delivery":"at-most-once"},
    {"id":"tm-freeze-requested","name":"Freeze requested","description":"The read-only window of the move begins.","payload":[{"name":"move-id","type":"move-id"}]},
    {"id":"tm-hash-checked","name":"Hash checked","description":"The target state hash is compared with the source state hash. The comparison is computed from the state of each side.","payload":[{"name":"move-id","type":"move-id"}]},
    {"id":"tm-switch-requested","name":"Switch requested","description":"The directory is asked to switch the tenant to its target placement.","payload":[{"name":"move-id","type":"move-id"}]},
    {"id":"tm-directory-switched","name":"Directory switched","description":"The directory names the target placement for the tenant.","delivery":"at-least-once"},
    {"id":"tm-copy-failed","name":"Copy failed","description":"The copy of the tenant database to the target stops.","payload":[{"name":"move-id","type":"move-id"}]},
    {"id":"tm-move-failed","name":"Move failed","description":"The move ends and the tenant stays on its source placement.","delivery":"at-most-once"},
    {"id":"pl-issue","name":"Preview link issued","description":"A preview link is issued for a draft; its expiry starts."},
    {"id":"rt-published","name":"Event published","description":"The domain event was handed to subscribers.","delivery":"at-least-once"},
    {"id":"tm-reconcile-requested","name":"Final synchronisation requested","description":"The writes the source accepted while the copy ran are applied to the target, with the source frozen.","payload":[{"name":"move-id","type":"move-id"}]},
    {"id":"src-attempt","name":"Password attempt from a source","description":"A password is presented for an account, from a source.","payload":[{"name":"source","type":"string"},{"name":"account","type":"string"},{"name":"guess","type":"string"}]},
    {"id":"src-accepted","name":"Attempt from a source accepted","description":"The password was evaluated and accepted.","delivery":"at-most-once"},
    {"id":"src-refused","name":"Attempt from a source refused","description":"The attempt was refused.","delivery":"at-most-once"},
    {"id":"ui-session-read","name":"Session read","description":"The session read answers, from the page or from a request, with whether the visit is signed in.","payload":[{"name":"authenticated","type":"u8"}]},
    {"id":"ui-signed-in","name":"Sign-in accepted","description":"The sign-in reply carries a session."},
    {"id":"ui-signed-out","name":"Sign-out answered","description":"The sign-out reply says the session ended."},
    {"id":"ui-session-ended","name":"Session ended","description":"A session frame says the session expired or was revoked."},
    {"id":"ui-session-requested","name":"Session read requested","description":"The web application asks the gateway for the session again.","delivery":"at-least-once"},
    {"id":"ui-notice-received","name":"Notice received","description":"A notice frame arrives on the live connection. kind is upsert or remove (a record of the object type object changed), schema or membership (object is empty).","payload":[{"name":"kind","type":"string"},{"name":"object","type":"string"}]},
    {"id":"ui-live-start","name":"Live connection started","description":"The page starts and opens the socket."},
    {"id":"ui-live-welcome","name":"Welcome frame","description":"The server accepts the socket and says where its event log stands and how often it wants a ping (heartbeat-ms).","payload":[{"name":"head","type":"u64"},{"name":"heartbeat-ms","type":"u32"}]},
    {"id":"ui-live-frame","name":"Event frame","description":"The server sends one event frame: its number on this connection and its sequence in the log.","payload":[{"name":"n","type":"u64"},{"name":"seq","type":"u64"}]},
    {"id":"ui-live-pong","name":"Pong frame","description":"The server answers a ping with the head of its event log.","payload":[{"name":"head","type":"u64"}]},
    {"id":"ui-live-heartbeat-due","name":"Heartbeat due","description":"The heartbeat interval passed.","elapsed":true},
    {"id":"ui-live-closed","name":"Socket closed","description":"The socket closed or failed to open."},
    {"id":"ui-live-reconnect-due","name":"Reconnect due","description":"The back-off interval passed.","elapsed":true},
    {"id":"ui-live-reset","name":"Connection identity changed","description":"A sign-in or sign-out ends the identity the socket was opened with."},
    {"id":"ui-live-subscribe","name":"Subscribe sent","description":"The client subscribes to the site, after the last sequence it saw (0 on the first connection).","payload":[{"name":"after","type":"u64"}],"delivery":"at-least-once"},
    {"id":"ui-live-ack","name":"Frame acknowledged","description":"The client acknowledges an event frame by its number.","payload":[{"name":"n","type":"u64"}],"delivery":"at-most-once"},
    {"id":"ui-live-ping","name":"Ping sent","description":"The client pings the server.","delivery":"at-most-once"},
    {"id":"ui-live-close-requested","name":"Close requested","description":"The client asks the socket to close.","delivery":"at-most-once"},
    {"id":"ui-form-submitted","name":"Form submitted","description":"A person submits a form; complete says whether every required field holds a value.","payload":[{"name":"complete","type":"u8"}]},
    {"id":"ui-form-accepted","name":"Submission accepted","description":"The reply to the submitted request says it was accepted."},
    {"id":"ui-form-refused","name":"Submission refused","description":"The reply to the submitted request is a refusal or the site could not be reached."},
    {"id":"ui-request-sent","name":"Request sent","description":"The client sends the request of a form to the gateway.","delivery":"at-most-once"},
    {"id":"ev-principal-erased","name":"Principal erased","description":"An erasure request for a principal has been carried out (PRV-353); the principal record and what is keyed by it end here. The removal of the tenant ends it too, at the latest.","payload":[{"name":"principal-id","type":"principal-id"}]},
    {"id":"ev-credential-ended","name":"Credential ended","description":"A credential was replaced by a new one or its principal was erased (PRV-353).","payload":[{"name":"credential-id","type":"credential-id"}]},
    {"id":"ev-identity-link-ended","name":"Identity link ended","description":"An identity link was unlinked or its principal was erased (PRV-353).","payload":[{"name":"link-id","type":"link-id"}]},
    {"id":"ev-session-retention-elapsed","name":"Session retention elapsed","description":"A day has passed since a session ended, so a revocation could be explained until now (PRV-364).","payload":[{"name":"session-id","type":"session-id"}]},
    {"id":"ev-challenge-closed","name":"Challenge closed","description":"A challenge expired or was consumed, whichever came first (PRV-365).","payload":[{"name":"challenge-id","type":"challenge-id"}]},
    {"id":"ev-content-removed","name":"Content removed","description":"The tenant deleted a content record or its retention rule ended it (PRV-356); every version goes with it (CMS-006).","payload":[{"name":"object","type":"object-type-id"},{"name":"record-id","type":"record-id"}]},
    {"id":"ev-restore-window-closed","name":"Restore window closed","description":"A snapshot closed the restore window the tenant chose (D-522); the log before it is truncated.","payload":[{"name":"upto-seq","type":"u64"}]},
    {"id":"ev-proposal-retention-elapsed","name":"Proposal retention elapsed","description":"A year has passed since a proposal was closed.","payload":[{"name":"proposal-id","type":"proposal-id"}]},
    {"id":"ev-conversation-deleted","name":"Conversation deleted","description":"A conversation was deleted (CNV-229); its turns go with it.","payload":[{"name":"turn-id","type":"turn-id"}]},
    {"id":"ev-consent-retention-elapsed","name":"Consent retention elapsed","description":"A year has passed since a consent was withdrawn (PRV-375).","payload":[{"name":"consent-id","type":"consent-id"}]},
    {"id":"ev-job-attempt-retention-elapsed","name":"Job attempt retention elapsed","description":"Thirty days have passed since the outcome of a job (SCH-014).","payload":[{"name":"job-id","type":"job-id"}]},
    {"id":"ev-effect-retention-elapsed","name":"Effect retention elapsed","description":"Ninety days have passed since the outcome of an effect, and the retry window of its job has closed (PRV-366).","payload":[{"name":"idempotency-key","type":"string"}]},
    {"id":"ev-file-bytes-unreferenced","name":"File bytes unreferenced","description":"No record refers to a file any more, or the uploader of private bytes was erased (PRV-353).","payload":[{"name":"content-hash","type":"hash"}]},
    {"id":"ev-mail-retention-elapsed","name":"Mail retention elapsed","description":"Thirty days have passed since a message reached its final state (EML-011).","payload":[{"name":"message-id","type":"message-id"}]},
    {"id":"ev-suppression-removed","name":"Suppression removed","description":"The tenant removed an entry of its suppression list.","payload":[{"name":"address-hash","type":"hash"}]},
    {"id":"ev-inbox-item-ended","name":"Inbox item ended","description":"The recipient removed an inbox item, or the record it names was erased (NTF-151).","payload":[{"name":"item-id","type":"identifier"}]},
    {"id":"ev-webhook-removed","name":"Webhook subscription removed","description":"The owner removed a webhook subscription (SEC-003, WFL-010).","payload":[{"name":"subscription-id","type":"identifier"}]},
    {"id":"ev-connector-secret-removed","name":"Connector secret removed","description":"The owner removed a connector secret (SEC-003).","payload":[{"name":"secret-id","type":"identifier"}]},
    {"id":"ev-delivery-key-removed","name":"Delivery key removed","description":"The owner removed a delivery key (CMS-166, CMS-167).","payload":[{"name":"key-id","type":"identifier"}]},
    {
      "id": "jr-poll",
      "name": "Job poll",
      "description": "A worker polls for due jobs, or a failed job comes due again.",
      "delivery": "at-least-once"
    },
    {
      "id": "jr-attempt-failed",
