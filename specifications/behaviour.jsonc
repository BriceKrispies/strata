    {
      "id": "fedl-flow",
      "name": "Linking a federated identity",
      "subject": "identity-service",
      "initial": "fedl-open",
      "description": "A federated identity is linked to an existing principal only after that principal has authenticated, and an email address that the provider asserts links only when the provider marks it verified.",
      "states": [
        {
          "id": "fedl-open",
          "name": "Deciding"
        }
      ],
      "transitions": [
        {
          "id": "fedl-accept-without-authenticated",
