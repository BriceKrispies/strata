    {
      "id": "ledger-posting-past-limits",
      "name": "Postings past the cap and the floor",
      "behaviors": [
        "ledger-posting-flow"
      ],
      "description": "With a floor of 0 and a cap of 10: 8 is posted, 5 would pass the cap, a debit of 9 would pass the floor, and a debit of 3 fits.",
      "steps": [
        {
          "at": 0,
          "event": "ldg-post-requested",
          "payload": {
            "key": "k1",
            "amount": 8
          }
        },
        {
          "at": 1,
          "event": "ldg-post-requested",
          "payload": {
            "key": "k3",
            "amount": 5
          }
        },
        {
          "at": 2,
          "event": "ldg-post-requested",
          "payload": {
            "key": "k3",
            "amount": -9
          }
        },
        {
          "at": 3,
          "event": "ldg-post-requested",
          "payload": {
            "key": "k2",
            "amount": -3
          }
        }
      ]
    },
    {
      "id": "ledger-two-postings-race-a-cap",
      "name": "Two postings that together pass the cap",
      "behaviors": [
        "ledger-concurrent-flow"
      ],
      "description": "Poster a and poster b each post 6 against a cap of 10. Both read revision 0 and balance 0; each fits alone, both do not.",
      "steps": [
        {
          "at": 0,
          "event": "ldg-attempt",
          "payload": {
            "poster": "a",
            "amount": 6,
            "snapshot": 0,
            "seen": 0
          }
        },
        {
          "at": 0,
          "event": "ldg-attempt",
          "payload": {
            "poster": "b",
            "amount": 6,
            "snapshot": 0,
            "seen": 0
          },
          "note": "Read the same snapshot as a."
        }
      ]
    },
    {
      "id": "ledger-two-postings-race-and-fit",
      "name": "Two postings that together fit",
      "behaviors": [
        "ledger-concurrent-flow"
      ],
      "description": "Poster a posts 3 and poster b posts 4 against a cap of 10, both on the snapshot of revision 0. The second commit loses its race and fits after the first.",
      "steps": [
        {
          "at": 0,
          "event": "ldg-attempt",
          "payload": {
            "poster": "a",
            "amount": 3,
            "snapshot": 0,
            "seen": 0
          }
        },
        {
          "at": 0,
          "event": "ldg-attempt",
          "payload": {
            "poster": "b",
            "amount": 4,
            "snapshot": 0,
            "seen": 0
          },
          "note": "Read the same snapshot as a."
        }
      ]
    },
