      "statement": "A tenant restored to a point holds the state whose hash the journal recorded at that point, not the writes made after it.",
      "evaluate": {
        "method": "state-invariant",
        "scenarios": [
          "restore-to-a-point"
        ],
        "expr": "point-in-time-flow.restored => point-in-time-flow.restoredTo == point-in-time-flow.journalPoint",
        "negatives": [
          {
            "scenario": "restore-to-a-point",
            "faults": [
              "defect-restore-to-latest"
            ]
          }
        ]
      },
      "faultModel": "fault-model-operations",
      "assumptions": [
        "a-model-abstraction"
      ],
      "faultBasis": "fault"
    },
    {
      "id": "m-point-in-time-flow-refined",
      "kind": "temporal",
      "models": "ten-015",
      "statement": "The implementation machine of Point-in-time restore refines its model: every step it takes is a step the model takes from the mapped state, or a step the model does not see.",
      "evaluate": {
        "method": "refines",
        "behavior": "point-in-time-flow-impl",
        "scenarios": [
          "restore-to-a-point-impl"
        ]
      },
      "faultModel": "fault-model-operations",
      "assumptions": [
        "a-model-abstraction"
      ],
      "faultBasis": "restatement"
    },
    {
      "id": "m-served-only-after-matching-replay",
      "kind": "invariant",
      "models": "mig-566",
      "statement": "A tenant served by the newer version has a replay that reached the hash its journal records.",
      "evaluate": {
        "method": "state-invariant",
        "scenarios": [
          "replay-reaches-the-recorded-hash",
          "replay-reaches-another-hash",
          "serving-requested-without-replay"
        ],
        "expr": "kernel-upgrade-flow.servedByNew => kernel-upgrade-flow.replayed && kernel-upgrade-flow.replayedHash == kernel-upgrade-flow.journalHash",
        "negatives": [
          {
            "scenario": "replay-reaches-another-hash",
            "faults": [
              "defect-switch-unchecked"
            ]
          },
          {
            "scenario": "serving-requested-without-replay",
            "faults": [
              "defect-switch-unchecked"
            ]
          }
        ]
      },
      "faultModel": "fault-model-operations",
      "assumptions": [
        "a-model-abstraction"
      ],
      "faultBasis": "fault"
    },
    {
      "id": "m-mismatching-replay-never-served",
      "kind": "temporal",
      "models": "mig-566",
      "statement": "A tenant whose replay does not reach the recorded hash is not served by the newer version.",
      "evaluate": {
        "method": "never",
        "scenarios": [
          "replay-reaches-another-hash",
          "serving-requested-without-replay"
        ],
        "occurs": {
          "event": "ku-served-by-new"
        },
        "negatives": [
          {
            "scenario": "replay-reaches-another-hash",
            "faults": [
              "defect-switch-unchecked"
            ]
          }
        ]
      },
      "faultModel": "fault-model-operations",
      "assumptions": [
        "a-model-abstraction"
      ],
      "faultBasis": "fault"
    },
    {
      "id": "m-matching-replay-is-served",
      "kind": "temporal",
      "models": "mig-566",
      "statement": "A tenant whose replay reaches the recorded hash is served by the newer version.",
      "evaluate": {
        "method": "eventually",
        "scenarios": [
          "replay-reaches-the-recorded-hash"
        ],
        "occurs": {
          "event": "ku-served-by-new"
        },
        "negatives": [
          {
            "scenario": "replay-reaches-the-recorded-hash",
            "faults": [
