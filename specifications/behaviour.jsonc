        ],
        "expr": "layout-rollout-flow.outcomeA != 'failed' || (layout-rollout-flow.layoutA == 1 && layout-rollout-flow.servingA)",
        "negatives": [
          {
            "scenario": "layout-change-fails-for-one-tenant",
            "faults": [
