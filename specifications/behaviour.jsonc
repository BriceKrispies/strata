    {
      "id": "ledger-entry-posted",
      "name": "Ledger entry posted",
      "description": "strata_kernel::EventBody::LedgerEntryPosted: an entry was recorded in an account. Recorded in the commit of the entry and published from the outbox after it (RUN-005), so a trigger can subscribe to it (SCH-004). The owner is personal data and is never logged.",
      "domain": true,
      "payload": [
        {
          "name": "tenant",
          "type": "tenant-id"
        },
        {
          "name": "seq",
          "type": "u64"
        },
        {
          "name": "revision",
          "type": "state-revision"
        },
        {
          "name": "account",
          "type": "ledger-account-id"
        },
        {
          "name": "unit",
          "type": "ledger-unit"
        },
        {
          "name": "owner",
          "type": "ledger-owner",
          "sensitive": "personal"
        },
        {
          "name": "amount",
          "type": "ledger-amount"
        },
        {
          "name": "balance",
          "type": "ledger-amount"
        },
        {
          "name": "entry-sequence",
          "type": "u64"
        },
        {
          "name": "reason",
          "type": "string"
        }
      ],
      "logging": {
        "logged": true,
        "service": "backend",
        "level": "info",
        "name": "ledger.posted",
        "tenant": "tenant",
        "fields": [
          {
            "field": "seq"
          },
          {
            "field": "revision"
          },
          {
            "field": "unit"
          },
          {
            "field": "amount"
          },
          {
            "field": "entry-sequence"
          }
        ]
      },
      "delivery": "at-least-once"
    },
