          "payload": {
            "session-id": "s_1"
          }
        }
      ]},
    {"id":"erasure-purged","name":"An erasure purges the copy","description":"The purge arrives, and later reads are answered without personal data.","behaviors":["erasure-copy-flow"],"steps":[
        {
          "at": 0,
          "event": "er-erase-committed",
          "payload": {
            "copy-ref": "copy-1"
          }
        },
        {
          "at": 1,
          "event": "er-purge-sent",
          "payload": {
            "copy-ref": "copy-1"
          }
        },
        {
          "at": 2,
          "event": "er-read",
          "payload": {
            "copy-ref": "copy-1"
          }
        },
        {
          "at": 8,
          "event": "er-read",
          "note": "After the bound of 5 ticks.",
          "payload": {
            "copy-ref": "copy-1"
          }
        }
      ]},
    {"id":"erasure-purged-impl","name":"An erasure purges the copy (implementation)","description":"The purge arrives half a second after the erasure commits, and later reads, at 1 and 4 seconds, are answered without personal data. Times are in milliseconds.","behaviors":["erasure-copy-flow-impl"],"steps":[{"at":0,"event":"er-erase-committed","payload":{"copy-ref":"copy-1"}},{"at":500,"event":"er-purge-sent","payload":{"copy-ref":"copy-1"}},{"at":1000,"event":"er-read","payload":{"copy-ref":"copy-1"}},{"at":4000,"event":"er-read","note":"After the bound of 2 seconds.","payload":{"copy-ref":"copy-1"}}],"routes":[{"event":"er-erase-committed","behavior":"erasure-copy-flow-impl","by":"key","field":"copy-ref"},{"event":"er-purge-sent","behavior":"erasure-copy-flow-impl","by":"key","field":"copy-ref"},{"event":"er-read","behavior":"erasure-copy-flow-impl","by":"key","field":"copy-ref"}],"timeUnit":"ms"},
    {"id":"erasure-purge-lost","name":"An erasure whose purge is lost","description":"The copy keeps its value. A read inside the bound is served from it. A read after the bound revalidates and is answered without personal data.","behaviors":["erasure-copy-flow"],"faults":["erasure-purge-dropped"],"steps":[
        {
          "at": 0,
          "event": "er-erase-committed",
          "payload": {
            "copy-ref": "copy-1"
          }
        },
        {
          "at": 1,
          "event": "er-purge-sent",
          "payload": {
            "copy-ref": "copy-1"
          }
        },
        {
          "at": 2,
          "event": "er-read",
          "note": "Within the bound.",
          "payload": {
            "copy-ref": "copy-1"
          }
        },
        {
          "at": 8,
          "event": "er-read",
          "note": "After the bound.",
          "payload": {
            "copy-ref": "copy-1"
          }
        }
      ]},
    {"id":"erasure-purge-lost-impl","name":"An erasure whose purge is lost (implementation)","description":"The purge sent half a second after the erasure is lost, and the copy keeps its value. A read at 1 second, inside the bound of 2 seconds, is served from it. A read at 4 seconds revalidates and is answered without personal data. Times are in milliseconds.","behaviors":["erasure-copy-flow-impl"],"faults":["erasure-purge-dropped"],"steps":[{"at":0,"event":"er-erase-committed","payload":{"copy-ref":"copy-1"}},{"at":500,"event":"er-purge-sent","payload":{"copy-ref":"copy-1"}},{"at":1000,"event":"er-read","note":"Within the bound.","payload":{"copy-ref":"copy-1"}},{"at":4000,"event":"er-read","note":"After the bound of 2 seconds.","payload":{"copy-ref":"copy-1"}}],"routes":[{"event":"er-erase-committed","behavior":"erasure-copy-flow-impl","by":"key","field":"copy-ref"},{"event":"er-purge-sent","behavior":"erasure-copy-flow-impl","by":"key","field":"copy-ref"},{"event":"er-read","behavior":"erasure-copy-flow-impl","by":"key","field":"copy-ref"}],"timeUnit":"ms"},
