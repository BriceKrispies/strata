    {"id":"m-guessing-throttled","kind":"invariant","models":"idn-008","statement":"A guess that arrives after ten failed guesses is refused, because the model counts the failures against one account (D-700).","evaluate":{"method":"state-invariant","scenarios":["guesses-from-one-source","guesses-on-parallel-connections"],"expr":"guess-throttle-flow.throttled == 0","negatives":[{"scenario":"guesses-from-one-source","faults":["defect-throttle-ignored"]},{"scenario":"guesses-on-parallel-connections","faults":["defect-throttle-ignored"]}]},"faultModel":"fault-model-launch","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
