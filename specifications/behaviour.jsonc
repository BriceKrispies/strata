    {
      "id": "provider-keys-flow",
      "name": "Provider signing keys",
      "subject": "identity-service",
      "initial": "jw-open",
      "description": "The signing keys of one provider as the identity service knows them. A token that names a key it does not know makes it fetch the provider metadata again; when the metadata holds the key it is learned and the token is verified, otherwise the token is rejected.",
      "variables": [
        {
          "name": "knownKid",
          "type": "string",
          "initial": "k1"
        }
      ],
      "states": [
        {
          "id": "jw-open",
          "name": "Keys known"
        }
      ],
      "transitions": [
        {
          "id": "jw-reject-unknown",
          "from": "jw-open",
          "to": "jw-open",
          "on": "jw-token",
          "guard": "event.kid != knownKid",
          "effects": [
            {
              "emit": "jw-rejected"
            }
          ],
          "faultOnly": true,
          "description": "Defect: rejects an unknown key without fetching the metadata."
        },
        {
          "id": "jw-refresh-known",
          "from": "jw-open",
          "to": "jw-open",
          "on": "jw-token",
          "guard": "event.kid == knownKid",
          "effects": [
            {
              "emit": "jw-refreshed"
            }
          ],
          "faultOnly": true,
          "description": "Defect: fetches the metadata for a key that is already known."
        },
        {
          "id": "jw-verify",
          "from": "jw-open",
          "to": "jw-open",
          "on": "jw-token",
          "guard": "event.kid == knownKid",
          "effects": [
            {
              "emit": "jw-verified"
            }
          ]
        },
        {
          "id": "jw-refresh",
          "from": "jw-open",
          "to": "jw-open",
          "on": "jw-token",
          "guard": "event.metadataHas",
          "effects": [
            {
              "set": "knownKid",
              "to": "event.kid"
            },
            {
              "emit": "jw-refreshed"
            },
            {
              "emit": "jw-verified"
            }
          ]
        },
        {
          "id": "jw-reject",
          "from": "jw-open",
          "to": "jw-open",
          "on": "jw-token",
          "effects": [
            {
              "emit": "jw-rejected"
            }
          ]
        }
      ],
      "realisation": "target"
    },
    {
      "level": "implementation",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "id": "provider-keys-flow-impl",
      "name": "Provider signing keys (implementation)",
      "subject": "identity-service",
      "initial": "jw-open-i",
      "description": "The key identifier of one provider as the identity service holds it (rec-provider-keys). An unknown identifier is looked up in the provider metadata, reached through the outbound gate.",
      "variables": [
        {
          "name": "knownKid",
          "type": "string",
          "initial": "k1",
          "repr": "string"
        }
      ],
      "states": [
        {
          "id": "jw-open-i",
          "name": "Keys known"
        }
      ],
      "transitions": [
        {
          "id": "jw-verify-i",
          "from": "jw-open-i",
          "to": "jw-open-i",
          "on": "jw-token",
          "guard": "event.kid == knownKid",
          "effects": [
            {
              "emit": "jw-verified",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "jw-refresh-i",
          "from": "jw-open-i",
          "to": "jw-open-i",
          "on": "jw-token",
          "guard": "event.metadataHas",
          "effects": [
            {
              "set": "knownKid",
              "to": "event.kid"
            },
            {
              "emit": "jw-refreshed",
              "to": "outbound-gate"
            },
            {
              "emit": "jw-verified",
              "to": "web-application"
            }
          ]
        },
        {
          "id": "jw-reject-i",
          "from": "jw-open-i",
          "to": "jw-open-i",
          "on": "jw-token",
          "effects": [
            {
              "emit": "jw-rejected",
              "to": "web-application"
            }
          ],
          "otherwise": true
        }
      ],
      "refines": "provider-keys-flow",
      "refinement": {
        "states": {
          "jw-open-i": "jw-open"
        },
        "variables": {
          "knownKid": "knownKid"
        },
        "transitions": {
          "jw-verify-i": "jw-verify",
          "jw-refresh-i": "jw-refresh",
          "jw-reject-i": "jw-reject"
        }
      },
      "storage": {
        "record": "rec-provider-keys",
        "key": "provider-id",
        "fields": {
          "knownKid": "known-kid"
        },
        "creates": true
      },
      "realisation": "target"
    },
