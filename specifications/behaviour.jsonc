          "guard": "(event.flow == 'code') && (!(event.pkce))",
          "description": "Defect: accepts although the condition \"carries a proof key\" does not hold.",
          "effects": [
            {
              "emit": "oidcs-accepted"
            }
          ]
        },
        {
          "id": "oidcs-accept",
          "from": "oidcs-open",
          "to": "oidcs-open",
          "on": "oidcs-presented",
          "guard": "(event.flow == 'code') && (event.pkce)",
          "effects": [
            {
              "emit": "oidcs-accepted"
            }
          ]
        },
        {
          "id": "oidcs-refuse",
          "from": "oidcs-open",
          "to": "oidcs-open",
          "on": "oidcs-presented",
          "effects": [
            {
              "emit": "oidcs-refused"
            }
          ]
        }
      ],
      "realisation": "target"
