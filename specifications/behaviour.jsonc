      ],
      "faultBasis": "restatement"
    },
    {
      "id": "m-apply-needs-a-preview",
      "kind": "invariant",
      "models": "mig-550",
      "statement": "A schema change is applied to the tenant only after it was previewed on a copy.",
      "evaluate": {
        "method": "state-invariant",
        "scenarios": [
          "change-previewed-and-applied",
          "change-applied-without-preview"
        ],
        "expr": "schema-change-flow.started => schema-change-flow.previewRef != ''",
        "negatives": [
