          "from": "oidcv-open-i",
          "to": "oidcv-open-i",
          "on": "oidcv-presented",
          "guard": "(event.issuer == 'configured') && (event.audience == 'this-client') && (event.signature == 'valid') && (event.nonce == 'match') && (event.alg == event.configuredAlg) && (event.keyOwner == event.provider)",
          "effects": [
            {
              "emit": "oidcv-accepted",
              "to": "web-application"
