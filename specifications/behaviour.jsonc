          "from": "td-removing-files-i",
          "to": "td-destroying-key-i",
          "on": "td-files-removed",
          "otherwise": true,
          "effects": [
            {
              "set": "files",
              "to": false
            }
          ]
        },
        {
          "id": "td-key-gone-i",
          "from": "td-destroying-key-i",
          "to": "td-deleted-i",
          "on": "td-key-destroyed",
          "otherwise": true,
          "effects": [
            {
              "set": "key",
              "to": false
            },
            {
              "set": "deleted",
              "to": true
            },
            {
              "emit": "td-tenant-deleted",
              "to": "operator-console"
            }
          ]
        },
        {
          "id": "td-fail-database-i",
          "from": "td-removing-database-i",
          "to": "td-retained-i",
          "on": "td-step-failed",
          "otherwise": true,
          "effects": [
            {
              "emit": "td-deletion-failed",
              "to": "operator-console"
            }
          ]
        },
        {
          "id": "td-fail-files-i",
          "from": "td-removing-files-i",
          "to": "td-retained-i",
          "on": "td-step-failed",
          "otherwise": true,
          "effects": [
            {
              "emit": "td-deletion-failed",
