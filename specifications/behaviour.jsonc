    {"id":"concurrent-rename-lands","name":"A rename commits between the proposal and the commit of a dependent","kind":"inject-event","event":"cch-rename-committed","at":1,"description":"A concurrent actor renames the field after both changes were proposed from the same base revision."},
    {"id":"defect-stale-classification","name":"Defect: applies a change with the class and name it had at its base revision","kind":"enable-transition","transition":"cch-commit-stale","description":"Defect: applies a change with the class and name it had at its base revision."},
