    {
      "id": "fedp-flow",
      "name": "Sign-in method for a bound domain",
      "subject": "identity-service",
      "initial": "fedp-open",
      "description": "A sign-in attempt for an address. When the realm binds the email domain of the address to an identity provider, password and emailed-link sign-in are refused for it and only the provider sign-in is allowed.",
      "states": [
        {
          "id": "fedp-open",
          "name": "Deciding"
        }
      ],
      "transitions": [
        {
          "id": "fedp-accept-without-domain",
          "from": "fedp-open",
          "to": "fedp-open",
          "on": "fedp-presented",
          "faultOnly": true,
          "guard": "(!(!event.domainBound || event.method == 'federated'))",
          "description": "Defect: accepts although the condition \"is not a password or emailed-link sign-in for a bound domain\" does not hold.",
          "effects": [
            {
              "emit": "fedp-accepted"
            }
          ]
        },
        {
          "id": "fedp-accept",
          "from": "fedp-open",
          "to": "fedp-open",
          "on": "fedp-presented",
          "guard": "(!event.domainBound || event.method == 'federated')",
          "effects": [
            {
              "emit": "fedp-accepted"
            }
          ]
        },
        {
          "id": "fedp-refuse",
          "from": "fedp-open",
          "to": "fedp-open",
          "on": "fedp-presented",
          "effects": [
            {
              "emit": "fedp-refused"
            }
          ]
        }
      ],
      "realisation": "target"
    },
