          "pc-refuse-records-i": "pc-refuse-records",
          "pc-refuse-files-i": "pc-refuse-files"
        }
      },
      "storage": {
        "record": "rec-plan-change",
        "key": "tenant-id",
        "creates": true
      },
      "instances": {
        "key": "tenant-id",
        "storedIn": "rec-plan-change",
        "max": 16
      }
    },
    {
      "id": "connection-quota-flow",
      "name": "Connection quota per tenant",
      "subject": "limit-store",
      "initial": "cq-open",
      "description": "The connection counters of two tenants, a and b, against a quota of two connections each. A tenant that exceeds its quota receives a throttling response and the other tenant is served. The model puts both tenants in one machine, so this one is a single unit and has no keyed instances.",
      "variables": [
        {
          "name": "connsA",
          "type": "number",
          "initial": 0
        },
        {
          "name": "connsB",
          "type": "number",
          "initial": 0
        }
      ],
      "states": [
        {
          "id": "cq-open",
          "name": "Serving"
        }
      ],
      "transitions": [
        {
          "id": "cq-throttle-everyone",
          "from": "cq-open",
          "to": "cq-open",
          "on": "cq-connection-requested",
          "guard": "connsA >= 2",
          "effects": [
            {
              "emit": "cq-throttled"
            }
          ],
          "faultOnly": true,
          "description": "Defect: throttles every tenant once one has exceeded its quota."
        },
        {
          "id": "cq-no-limit-a",
          "from": "cq-open",
          "to": "cq-open",
          "on": "cq-connection-requested",
          "guard": "event.tenant == 'a'",
          "effects": [
            {
              "set": "connsA",
              "to": "connsA + 1"
            },
            {
              "emit": "cq-served"
            }
          ],
          "faultOnly": true,
          "description": "Defect: opens a connection of tenant a whatever its quota."
        },
        {
          "id": "cq-serve-a",
          "from": "cq-open",
          "to": "cq-open",
          "on": "cq-connection-requested",
          "guard": "event.tenant == 'a' && connsA < 2",
          "effects": [
            {
              "set": "connsA",
              "to": "connsA + 1"
            },
            {
              "emit": "cq-served"
            }
          ]
        },
        {
          "id": "cq-throttle-a",
          "from": "cq-open",
          "to": "cq-open",
          "on": "cq-connection-requested",
          "guard": "event.tenant == 'a' && connsA >= 2",
          "effects": [
            {
              "emit": "cq-throttled"
            }
          ]
        },
        {
          "id": "cq-serve-b",
          "from": "cq-open",
          "to": "cq-open",
          "on": "cq-connection-requested",
          "guard": "event.tenant == 'b' && connsB < 2",
          "effects": [
            {
              "set": "connsB",
              "to": "connsB + 1"
            },
            {
              "emit": "cq-served"
            }
          ]
        },
        {
          "id": "cq-throttle-b",
          "from": "cq-open",
          "to": "cq-open",
          "on": "cq-connection-requested",
          "guard": "event.tenant == 'b' && connsB >= 2",
          "effects": [
            {
              "emit": "cq-throttled"
            }
          ]
        }
      ]
    },
    {
      "id": "connection-quota-flow-impl",
      "name": "Connection quota per tenant (implementation)",
      "level": "implementation",
      "subject": "limit-store",
      "refines": "connection-quota-flow",
      "description": "The connection counters of two tenants, a and b, against a quota of two connections each. A tenant that exceeds its quota receives a throttling response and the other tenant is served. The model puts both tenants in one machine, so this one is a single unit and has no keyed instances.",
      "initial": "cq-open-i",
      "transaction": {
        "scope": "transition",
