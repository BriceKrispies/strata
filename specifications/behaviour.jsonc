      "assumptions": [
        "a-model-abstraction"
      ],
      "faultBasis": "fault"
    },
    {
      "id": "m-run-record-holds-preview-batches-and-principal",
      "kind": "temporal",
      "models": "mig-556",
      "statement": "A completed run records the preview it was applied from, its batches and the principal that started it.",
      "evaluate": {
        "method": "eventually",
        "scenarios": [
          "change-previewed-and-applied"
        ],
        "expr": "schema-change-flow.batches == 2 && schema-change-flow.startedBy == 'alice' && schema-change-flow.previewRef == 'preview-1'",
        "negatives": [
