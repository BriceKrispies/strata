    {
      "id": "first-acknowledgement-retried-impl",
      "name": "The first acknowledgement is retried for a minute",
      "kind": "retry-event",
      "event": "em-ack",
      "attempts": 6,
      "occurrence": 1,
      "description": "The first acknowledgement of the mail adapter fails six dispatches and arrives 63 seconds late (the runtime's backoff of 1 to 32 seconds): an at-least-once message is never lost, so the implementation twin of a lost acknowledgement is one that arrives after the dispatcher has given up waiting."
    },
    {
      "id": "first-submission-retried-impl",
      "name": "The first submission is retried through an outage",
      "kind": "retry-event",
      "event": "em-submit",
      "attempts": 6,
      "occurrence": 1,
      "realises": "fm-mail-outage",
      "description": "The mail provider does not take the first submission for a minute: its dispatch fails six times and it reaches the provider 63 seconds late (the runtime's backoff of 1 to 32 seconds)."
    },
    {
      "id": "commit-confirmation-retried-impl",
      "name": "The commit confirmation is retried once",
      "kind": "retry-event",
      "event": "rt-committed",
      "attempts": 1,
      "description": "The first dispatch of the commit confirmation fails and it arrives after the runtime's first backoff of 1 second; publication must still wait for it."
    },
    {
      "id": "first-delivery-retried-impl",
      "name": "The first delivery of a notice is retried twice",
      "kind": "retry-event",
      "event": "arc-ob-delivered",
      "attempts": 2,
      "occurrence": 1,
      "description": "The first dispatch of the notice fails twice and it arrives 3 seconds late (the runtime's backoff of 1 and 2 seconds); the redelivery arrives first."
    },
    {
      "id": "arc-idle-sweep-disabled",
