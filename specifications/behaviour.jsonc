      "id": "arc-idle-sweep-publishes-foreign-commit",
      "name": "An event committed by another writer is published by the idle sweep",
      "description": "No runtime committed through this hook: the events were committed by another replica or a command line tool. The outbox job still publishes them.",
      "behaviors": [
        "arc-outbox-delivery-flow"
      ],
      "steps": [
        {
          "at": 0,
          "event": "arc-ob-sweep-due",
          "note": "The idle sweep; no rt-committed came before."
        }
      ]
    },
    {
      "id": "arc-idle-sweep-publishes-foreign-commit-impl",
      "name": "An event committed by another writer is published by the idle sweep (implementation)",
      "description": "The backend calls the commit hook once at start-up and the kick publishes at once; from then on the machine is idle and no commit hook of this runtime runs. The idle sweep fires at 501 ms and again at 1001 ms, so an event another writer committed in between is published within 500 ms. Times are in milliseconds. The same scenario run on the implementation machines.",
      "behaviors": [
        "arc-outbox-delivery-flow-impl"
      ],
      "steps": [
        {
          "at": 0,
          "event": "rt-committed",
          "note": "The start-up call."
        },
        {
          "at": 1,
          "event": "arc-ob-publish-now"
        }
      ],
      "timeUnit": "ms",
      "stopAt": "1100 ms"
    },
    {
      "id": "ledger-posting-retried",
      "name": "A posting is retried, then the journal is replayed",
      "behaviors": [
        "ledger-posting-flow"
      ],
      "description": "Key k1 posts 5 and is posted again with the same key, key k2 posts 3, a request to set the balance arrives, and the journal is replayed.",
      "steps": [
        {
          "at": 0,
          "event": "ldg-post-requested",
          "payload": {
            "key": "k1",
            "amount": 5
          }
        },
        {
          "at": 1,
          "event": "ldg-post-requested",
          "payload": {
            "key": "k1",
            "amount": 5
          },
          "note": "The retry."
        },
        {
          "at": 2,
          "event": "ldg-post-requested",
          "payload": {
            "key": "k2",
            "amount": 3
          }
        },
        {
          "at": 3,
          "event": "ldg-adjust-requested",
          "payload": {
            "value": 99
          }
        },
        {
          "at": 4,
          "event": "ldg-replay-requested"
        }
      ]
    },
