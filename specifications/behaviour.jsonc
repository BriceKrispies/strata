        {
          "name": "limit",
          "type": "number",
          "initial": 20
        },
        {
          "name": "windowOpen",
          "type": "boolean",
          "initial": false
        }
      ],
      "states": [
        {
          "id": "sus-open",
          "name": "Counting"
        }
      ],
      "transitions": [
        {
          "id": "sus-accept-over",
          "from": "sus-open",
          "to": "sus-open",
          "on": "sus-requested",
          "guard": "count >= limit && windowOpen && windowStart <= time && time - windowStart < 60",
          "effects": [
            {
              "set": "count",
              "to": "count + 1"
            },
            {
              "emit": "sus-accepted"
            }
          ],
          "faultOnly": true,
          "description": "Defect: allows a request over the limit."
        },
        {
          "id": "sus-new-window",
          "from": "sus-open",
          "to": "sus-open",
          "on": "sus-requested",
          "guard": "!(windowOpen && windowStart <= time && time - windowStart < 60)",
          "effects": [
            {
              "set": "windowStart",
              "to": "time"
            },
            {
              "set": "windowOpen",
              "to": true
            },
            {
              "set": "count",
              "to": 1
            },
            {
              "emit": "sus-accepted"
            }
          ]
        },
        {
          "id": "sus-accept",
          "from": "sus-open",
          "to": "sus-open",
          "on": "sus-requested",
          "guard": "count < limit",
          "effects": [
            {
              "set": "count",
              "to": "count + 1"
            },
            {
              "emit": "sus-accepted"
            }
          ]
        },
        {
          "id": "sus-refuse",
          "from": "sus-open",
          "to": "sus-open",
          "on": "sus-requested",
          "effects": [
            {
              "emit": "sus-refused"
            }
          ]
        },
        {
          "id": "sus-tighten",
          "from": "sus-open",
          "to": "sus-open",
          "on": "sus-tightened",
          "guard": "event.limit < limit",
          "effects": [
            {
              "set": "limit",
              "to": "event.limit"
            }
          ]
        }
      ],
      "realisation": "target"
    },
