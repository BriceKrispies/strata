    {"id":"m-operator-console-private","kind":"structural","models":"thr-253","statement":"No public component and no gateway has a path to the operator console.","evaluate":{"method":"no-relationship","from":["gateway","delivery-network","delivery-network-control","agent-gateway","external-identity-provider","web-application","agent","external-endpoint","traffic-switch","agent-traffic-switch"],"to":"operator-console","transitive":true},"assumptions":["a-model-abstraction"]},
    {"id":"m-connector-runner-isolated","kind":"structural","models":"wfl-256","statement":"The connector runner has no path to a platform component other than the outbound gate and the key service; components outside the platform (category external) are reached only through the outbound gate.","evaluate":{"method":"no-relationship","from":"connector-runner","to":["kernel","substrate","store-contract","sqlite-adapter","postgres-adapter","tenant-database","control-plane","control-database","identity-service","runtime","gateway","automation-worker","copy-store","file-store","agent-gateway","telemetry-pipeline","audit-log","web-application","simulator","verification","agent","limit-store","backup-archive","fleet-reporting","product-module","notice-queue","search-index","notification-service","conversation-service","local-model-adapter","operator-console","upload-scanner","mail-dispatcher","release-controller","release-pipeline","image-registry","traffic-switch","subject-rights-service","agent-traffic-switch","migration-job","platform-audit-store","cell","tenant-replication"],"transitive":true},"assumptions":["a-model-abstraction"]},
    {"id":"m-trigger-chain-bounded","kind":"invariant","models":"sch-300","statement":"A chain of triggers creates no more jobs than the hop limit of eight (D-700) allows.","evaluate":{"method":"state-invariant","scenarios":["trigger-chain-runaway","trigger-chain-reentered"],"expr":"trigger-chain-flow.accepted <= 8","negatives":[{"scenario":"trigger-chain-runaway","faults":["defect-trigger-loop-unbounded"]},{"scenario":"trigger-chain-reentered","faults":["defect-trigger-loop-unbounded"]}]},"faultModel":"fault-model-operations","assumptions":["a-model-abstraction"],"faultBasis":"fault"},
