    {"id":"defect-rewrites-before-inputs","name":"Defect: rewrites the joint dependent before the entities it depends on","kind":"enable-transition","transition":"dsp-rewrite-d-early","description":"Defect: rewrites the joint dependent before the entities it depends on."},
    {"id":"removal-requested-early","name":"A removal is requested before the dependent has migrated","kind":"inject-event","event":"rpn-removal-requested","at":0,"description":"The owner asks to remove the old shape while a pin on it remains."},
    {"id":"defect-removes-under-pin","name":"Defect: removes the old shape while a pin on it remains","kind":"enable-transition","transition":"rpn-remove-under-pin","description":"Defect: removes the old shape while a pin on it remains."},
    {"id":"defect-window-closes-silently","name":"Defect: ends a pin at the close of the window without reporting the dependent","kind":"enable-transition","transition":"rpn-window-close-silent","description":"Defect: ends a pin at the close of the window without reporting the dependent."},
