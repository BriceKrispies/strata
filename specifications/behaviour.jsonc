            ]
          }
        ]
      },
      "faultModel": "fault-model-operations",
      "assumptions": [
        "a-model-abstraction"
      ],
      "faultBasis": "fault"
    },
    {
      "id": "m-kernel-upgrade-flow-refined",
      "kind": "temporal",
      "models": "mig-566",
      "statement": "The implementation machine of Serving under a newer kernel refines its model: every step it takes is a step the model takes from the mapped state, or a step the model does not see.",
      "evaluate": {
        "method": "refines",
        "behavior": "kernel-upgrade-flow-impl",
        "scenarios": [
          "replay-reaches-the-recorded-hash-impl",
          "replay-reaches-another-hash-impl",
          "serving-requested-without-replay-impl"
        ]
      },
      "faultModel": "fault-model-operations",
      "assumptions": [
        "a-model-abstraction"
      ],
      "faultBasis": "restatement"
    },
    {
      "id": "m-request-completes-on-its-placement",
      "kind": "invariant",
      "models": "mig-586",
      "statement": "A request completes on the placement it began on.",
      "evaluate": {
        "method": "state-invariant",
        "scenarios": [
          "switch-with-a-request-in-flight"
        ],
        "expr": "(placement-switch-flow.r1DoneOn == '' || placement-switch-flow.r1DoneOn == placement-switch-flow.r1On) && (placement-switch-flow.r2DoneOn == '' || placement-switch-flow.r2DoneOn == placement-switch-flow.r2On)",
        "negatives": [
          {
            "scenario": "switch-with-a-request-in-flight",
            "faults": [
              "defect-complete-on-current"
            ]
          }
        ]
      },
      "faultModel": "fault-model-operations",
      "assumptions": [
        "a-model-abstraction"
      ],
      "faultBasis": "fault"
    },
    {
      "id": "m-request-after-switch-uses-target",
      "kind": "temporal",
      "models": "mig-586",
      "statement": "A request that begins after the switch uses the target placement while the earlier request completes on the source.",
      "evaluate": {
        "method": "eventually",
        "scenarios": [
          "switch-with-a-request-in-flight"
        ],
        "expr": "placement-switch-flow.r2On == 'target' && placement-switch-flow.r1DoneOn == 'source'",
        "negatives": [
          {
            "scenario": "switch-with-a-request-in-flight",
            "faults": [
              "defect-begin-on-source"
            ]
          },
          {
            "scenario": "switch-with-a-request-in-flight",
            "faults": [
              "defect-complete-on-current"
            ]
          }
        ]
      },
      "faultModel": "fault-model-operations",
      "assumptions": [
        "a-model-abstraction"
      ],
      "faultBasis": "fault"
    },
    {
      "id": "m-address-resolves-to-the-same-tenant",
      "kind": "invariant",
      "models": "ten-013",
      "statement": "The address of the tenant resolves to the same tenant before and after the switch.",
      "evaluate": {
        "method": "state-invariant",
        "scenarios": [
          "switch-with-a-request-in-flight"
        ],
        "expr": "placement-switch-flow.resolvedTenant == '' || placement-switch-flow.resolvedTenant == placement-switch-flow.addressTenant",
        "negatives": [
          {
            "scenario": "switch-with-a-request-in-flight",
            "faults": [
              "defect-resolve-by-placement"
