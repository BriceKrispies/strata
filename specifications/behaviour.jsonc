              "set": "formerAddresses",
              "to": "formerAddresses + event.formers"
            },
            {
              "set": "redirects",
              "to": "redirects + event.formers"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "im-open-i": "im-open"
        },
        "variables": {
          "holdsR1": "holdsR1",
          "holdsR2": "holdsR2",
          "held": "held",
          "updates": "updates",
          "formerAddresses": "formerAddresses",
          "redirects": "redirects"
        },
        "transitions": {
          "im-create-r1-i": "im-create-r1",
          "im-update-r1-i": "im-update-r1",
          "im-create-r2-i": "im-create-r2",
          "im-update-r2-i": "im-update-r2",
          "im-page-i": "im-page"
        }
      },
      "storage": {
        "record": "rec-import",
        "key": "tenant-id",
        "creates": true
      },
      "instances": {
