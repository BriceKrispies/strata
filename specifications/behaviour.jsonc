        "expr": "field-change-flow.added && field-change-flow.newField1 == field-change-flow.base1 * field-change-flow.factor && field-change-flow.newField2 == field-change-flow.base2 * field-change-flow.factor",
        "negatives": [
          {
            "scenario": "field-added-to-existing-records",
            "faults": [
