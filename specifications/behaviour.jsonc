    {
      "id": "m-stopped-run-keeps-its-cursor-and-serves",
      "kind": "invariant",
      "models": "mig-581",
      "statement": "A run the tenant owner stops has its cursor recorded, and the tenant keeps serving its readers.",
      "evaluate": {
