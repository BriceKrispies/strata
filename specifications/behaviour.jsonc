    {"id":"ui-theme-cycle","name":"The theme control cycles device, light and dark, and is remembered","description":"Journey of tests/e2e/site.spec.js, the test named \"the theme control cycles device, light and dark, and is remembered\". Hand-written test keeps: the full-page screenshot.","steps":[{"emulate":{"colorScheme":"dark"}},{"goto":{"screen":"screen-front-page"}},{"expectAttribute":{"attribute":"data-scheme","value":"dark"}},{"click":{"role":"button","namePattern":"Change theme"}},{"expectAttribute":{"attribute":"data-scheme","value":"light"}},{"click":{"role":"button","namePattern":"Change theme"}},{"expectAttribute":{"attribute":"data-scheme","value":"dark"}},{"emulate":{"colorScheme":"light"}},{"reload":{}},{"expectAttribute":{"attribute":"data-scheme","value":"dark"}},{"axeScan":{}}]},
    {"id":"ui-keyboard-only","name":"The whole site can be used from the keyboard","description":"Journey of tests/e2e/site.spec.js, the test named \"the whole site can be used from the keyboard\". Hand-written test keeps: typing the name and the password key by key (the scenario fills them and presses Enter); the computed outline style of a focused toolbar link (computed CSS).","steps":[{"goto":{"screen":"screen-front-page"}},{"press":"Tab"},{"expectRole":{"role":"link","name":"Skip to the content","state":"focused"}},{"press":"Enter"},{"expectRole":{"role":"main","name":"Content","state":"focused"}},{"press":"Tab"},{"expectRole":{"role":"link","name":"The Jig Is the Work","state":"focused"}},{"press":"Enter"},{"expectRole":{"role":"heading","level":1,"name":"The Jig Is the Work"}},{"goto":{"screen":"screen-sign-in"}},{"focus":{"role":"textbox","name":"Name"}},{"fill":{"form":"form-sign-in","field":"login","value":"tomasz"}},{"fill":{"form":"form-sign-in","field":"password","value":"strata-dev-tomasz"}},{"press":"Enter"},{"expectRole":{"role":"heading","level":1,"name":"Writing desk"}}]},
    {"id":"ui-phone-layout","name":"On a phone the layout folds, the menu opens and closes, and nothing overflows","viewport":{"width":390,"height":844},"description":"Journey of tests/e2e/site.spec.js, the test named \"on a phone the layout folds, the menu opens and closes, and nothing overflows\". Hand-written test keeps: that on a phone the notes of the first entry sit above its title (position of the first entry among siblings; the format has no per-entry element); the full-page screenshot.","steps":[{"emulate":{"touch":true,"mobile":true}},{"goto":{"screen":"screen-front-page"}},{"expectRole":{"role":"navigation","name":"Sections","state":"hidden"}},{"expectAttribute":{"role":"button","name":"Menu","attribute":"aria-expanded","value":"false"}},{"click":{"role":"button","name":"Menu"}},{"expectRole":{"role":"navigation","name":"Sections","state":"visible"}},{"expectAttribute":{"role":"button","name":"Close menu","attribute":"aria-expanded","value":"true"}},{"press":"Escape"},{"expectRole":{"role":"navigation","name":"Sections","state":"hidden"}},{"click":{"role":"button","name":"Menu"}},{"click":{"role":"link","name":"Topics","within":{"role":"navigation","name":"Sections"}}},{"expectRole":{"role":"heading","level":1,"name":"Topics"}},{"expectRole":{"role":"navigation","name":"Sections","state":"hidden"}},{"goto":{"screen":"screen-front-page"}},{"expectNoOverflow":{}},{"goto":{"screen":"screen-article","params":{"slug":"a-margin-is-a-promise"}}},{"expectNoOverflow":{}},{"goto":{"screen":"screen-about"}},{"expectNoOverflow":{}},{"goto":{"screen":"screen-sign-in"}},{"expectNoOverflow":{}},{"goto":{"screen":"screen-front-page"}},{"axeScan":{}}]},
