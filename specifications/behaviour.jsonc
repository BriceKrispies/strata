        },
        "creates": true
      }
    },
    {
      "id": "tenant-suspension-flow",
      "name": "Tenant suspension",
      "subject": "control-plane",
      "initial": "ts-active",
      "description": "One tenant on its trial or plan. A write is accepted while the tenant is active and refused while it is suspended. A trial that ends without a chosen plan suspends the tenant and keeps all of its records; a trial that ends after a plan was chosen does not.",
      "variables": [
        {
          "name": "records",
          "type": "number",
          "initial": 0
        },
        {
          "name": "suspended",
          "type": "boolean",
          "initial": false
        },
        {
          "name": "recordsAtSuspend",
          "type": "number",
          "initial": 0
        },
        {
          "name": "planChosen",
          "type": "boolean",
          "initial": false
        }
      ],
      "states": [
        {
          "id": "ts-active",
          "name": "Trial or plan in force"
        },
        {
          "id": "ts-suspended",
          "name": "Suspended"
        }
      ],
      "transitions": [
        {
          "id": "ts-write-while-suspended",
          "from": "ts-suspended",
          "to": "ts-suspended",
          "on": "ts-write-requested",
          "effects": [
            {
              "set": "records",
              "to": "records + 1"
            },
            {
              "emit": "ts-write-accepted"
            }
          ],
          "faultOnly": true,
          "description": "Defect: accepts a write while the tenant is suspended."
        },
        {
          "id": "ts-suspend-despite-plan",
          "from": "ts-active",
          "to": "ts-suspended",
          "on": "ts-trial-ended",
          "guard": "planChosen",
          "effects": [
            {
              "set": "suspended",
              "to": true
            },
            {
              "set": "recordsAtSuspend",
              "to": "records"
            },
            {
              "emit": "ts-tenant-suspended"
            }
          ],
          "faultOnly": true,
          "description": "Defect: suspends the tenant at the end of the trial although a plan was chosen."
        },
        {
          "id": "ts-trial-wipes",
          "from": "ts-active",
          "to": "ts-suspended",
          "on": "ts-trial-ended",
          "guard": "!planChosen",
          "effects": [
            {
              "set": "recordsAtSuspend",
              "to": "records"
            },
            {
              "set": "records",
              "to": 0
            },
            {
              "set": "suspended",
              "to": true
            },
            {
              "emit": "ts-tenant-suspended"
            }
          ],
          "faultOnly": true,
          "description": "Defect: removes the records of the tenant when the trial ends."
        },
        {
          "id": "ts-write",
          "from": "ts-active",
          "to": "ts-active",
          "on": "ts-write-requested",
          "effects": [
            {
              "set": "records",
              "to": "records + 1"
            },
            {
              "emit": "ts-write-accepted"
            }
          ]
        },
        {
          "id": "ts-write-refused-suspended",
          "from": "ts-suspended",
          "to": "ts-suspended",
          "on": "ts-write-requested",
          "effects": [
            {
              "emit": "ts-write-refused"
            }
          ]
        },
        {
          "id": "ts-plan",
          "from": "ts-active",
          "to": "ts-active",
          "on": "ts-plan-chosen",
          "effects": [
            {
              "set": "planChosen",
              "to": true
            }
          ]
        },
        {
          "id": "ts-trial-lapses",
          "from": "ts-active",
          "to": "ts-suspended",
          "on": "ts-trial-ended",
          "guard": "!planChosen",
          "effects": [
            {
              "set": "suspended",
              "to": true
            },
            {
              "set": "recordsAtSuspend",
              "to": "records"
            },
            {
              "emit": "ts-tenant-suspended"
            }
          ]
        },
        {
          "id": "ts-trial-kept",
          "from": "ts-active",
          "to": "ts-active",
          "on": "ts-trial-ended",
          "guard": "planChosen",
          "effects": []
        }
      ]
    },
    {
      "id": "tenant-suspension-flow-impl",
      "name": "Tenant suspension (implementation)",
      "level": "implementation",
      "subject": "control-plane",
      "refines": "tenant-suspension-flow",
      "description": "One tenant on its trial or plan. A write is accepted while the tenant is active and refused while it is suspended. A trial that ends without a chosen plan suspends the tenant and keeps all of its records; a trial that ends after a plan was chosen does not.",
      "initial": "ts-active-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "records",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "suspended",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        },
        {
          "name": "recordsAtSuspend",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "planChosen",
          "type": "boolean",
          "initial": false,
          "repr": "bool"
        }
      ],
      "states": [
        {
          "id": "ts-active-i",
          "name": "Trial or plan in force"
        },
        {
          "id": "ts-suspended-i",
          "name": "Suspended",
          "ignores": [
            "ts-plan-chosen",
            "ts-trial-ended"
          ]
        }
      ],
      "transitions": [
        {
          "id": "ts-write-i",
          "from": "ts-active-i",
          "to": "ts-active-i",
          "on": "ts-write-requested",
          "otherwise": true,
          "effects": [
            {
              "set": "records",
              "to": "records + 1"
            },
            {
              "emit": "ts-write-accepted",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "ts-write-refused-suspended-i",
          "from": "ts-suspended-i",
          "to": "ts-suspended-i",
          "on": "ts-write-requested",
          "otherwise": true,
          "effects": [
            {
              "emit": "ts-write-refused",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "ts-plan-i",
          "from": "ts-active-i",
          "to": "ts-active-i",
          "on": "ts-plan-chosen",
          "otherwise": true,
          "effects": [
            {
              "set": "planChosen",
              "to": true
            }
          ]
        },
        {
          "id": "ts-trial-lapses-i",
          "from": "ts-active-i",
          "to": "ts-suspended-i",
          "on": "ts-trial-ended",
          "guard": "!planChosen",
          "effects": [
            {
              "set": "suspended",
              "to": true
            },
            {
              "set": "recordsAtSuspend",
              "to": "records"
            },
            {
              "emit": "ts-tenant-suspended",
              "to": "operator-console"
            }
          ]
        },
        {
          "id": "ts-trial-kept-i",
          "from": "ts-active-i",
          "to": "ts-active-i",
          "on": "ts-trial-ended",
          "guard": "planChosen",
          "effects": []
        }
      ],
      "refinement": {
        "states": {
          "ts-active-i": "ts-active",
          "ts-suspended-i": "ts-suspended"
        },
        "variables": {
          "records": "records",
          "suspended": "suspended",
          "recordsAtSuspend": "recordsAtSuspend",
          "planChosen": "planChosen"
        },
        "transitions": {
          "ts-write-i": "ts-write",
          "ts-write-refused-suspended-i": "ts-write-refused-suspended",
          "ts-plan-i": "ts-plan",
          "ts-trial-lapses-i": "ts-trial-lapses",
          "ts-trial-kept-i": "ts-trial-kept"
        }
      },
      "storage": {
        "record": "rec-tenant-suspension",
        "key": "tenant-id",
        "creates": true
      },
      "instances": {
        "key": "tenant-id",
        "storedIn": "rec-tenant-suspension",
        "max": 16
      }
    },
    {
      "id": "write-quota-flow",
      "name": "Write against plan quotas",
      "subject": "limit-store",
      "initial": "wq-open",
      "description": "One tenant writing records and files against the quotas of its plan: two records and one file here. A write that would exceed a quota is refused, and the refusal names the quota it would exceed.",
      "variables": [
        {
          "name": "recordsUsed",
          "type": "number",
          "initial": 0
        },
        {
          "name": "filesUsed",
          "type": "number",
          "initial": 0
        },
        {
          "name": "refusedFor",
          "type": "string",
          "initial": ""
        }
      ],
      "states": [
        {
          "id": "wq-open",
          "name": "Accepting writes"
        }
      ],
      "transitions": [
        {
          "id": "wq-ignore-record-quota",
          "from": "wq-open",
          "to": "wq-open",
          "on": "wq-write-requested",
          "guard": "event.kind == 'record'",
          "effects": [
            {
              "set": "recordsUsed",
              "to": "recordsUsed + 1"
            },
            {
              "emit": "wq-write-accepted"
            }
          ],
          "faultOnly": true,
          "description": "Defect: accepts a record whatever the quota."
        },
        {
          "id": "wq-name-wrong-quota",
          "from": "wq-open",
          "to": "wq-open",
          "on": "wq-write-requested",
          "guard": "event.kind == 'record' && recordsUsed >= 2",
          "effects": [
            {
              "set": "refusedFor",
              "to": "'files'"
            },
            {
              "emit": "wq-refused-files"
            }
          ],
          "faultOnly": true,
          "description": "Defect: refuses a record naming the file quota."
        },
        {
          "id": "wq-record-accepted",
          "from": "wq-open",
          "to": "wq-open",
          "on": "wq-write-requested",
          "guard": "event.kind == 'record' && recordsUsed < 2",
          "effects": [
            {
              "set": "recordsUsed",
              "to": "recordsUsed + 1"
            },
            {
              "emit": "wq-write-accepted"
            }
          ]
        },
        {
          "id": "wq-record-refused",
          "from": "wq-open",
          "to": "wq-open",
          "on": "wq-write-requested",
          "guard": "event.kind == 'record' && recordsUsed >= 2",
          "effects": [
            {
              "set": "refusedFor",
              "to": "'records'"
            },
            {
              "emit": "wq-refused-records"
            }
          ]
        },
        {
          "id": "wq-file-accepted",
          "from": "wq-open",
          "to": "wq-open",
          "on": "wq-write-requested",
          "guard": "event.kind == 'file' && filesUsed < 1",
          "effects": [
            {
              "set": "filesUsed",
              "to": "filesUsed + 1"
            },
            {
              "emit": "wq-write-accepted"
            }
          ]
        },
        {
          "id": "wq-file-refused",
          "from": "wq-open",
          "to": "wq-open",
          "on": "wq-write-requested",
          "guard": "event.kind == 'file' && filesUsed >= 1",
          "effects": [
            {
              "set": "refusedFor",
              "to": "'files'"
            },
            {
              "emit": "wq-refused-files"
            }
          ]
        }
      ]
    },
    {
      "id": "write-quota-flow-impl",
      "name": "Write against plan quotas (implementation)",
      "level": "implementation",
      "subject": "limit-store",
      "refines": "write-quota-flow",
      "description": "One tenant writing records and files against the quotas of its plan: two records and one file here. A write that would exceed a quota is refused, and the refusal names the quota it would exceed.",
      "initial": "wq-open-i",
      "transaction": {
        "scope": "transition",
        "isolation": "serializable"
      },
      "variables": [
        {
          "name": "recordsUsed",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "filesUsed",
          "type": "number",
          "initial": 0,
          "repr": "u64"
        },
        {
          "name": "refusedFor",
          "type": "string",
          "initial": "",
          "repr": "string"
        }
      ],
      "states": [
        {
          "id": "wq-open-i",
          "name": "Accepting writes"
        }
      ],
      "transitions": [
        {
          "id": "wq-record-accepted-i",
          "from": "wq-open-i",
          "to": "wq-open-i",
          "on": "wq-write-requested",
          "guard": "event.kind == 'record' && recordsUsed < 2",
          "effects": [
            {
              "set": "recordsUsed",
              "to": "recordsUsed + 1"
            },
            {
              "emit": "wq-write-accepted",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "wq-record-refused-i",
          "from": "wq-open-i",
          "to": "wq-open-i",
          "on": "wq-write-requested",
          "guard": "event.kind == 'record' && recordsUsed >= 2",
          "effects": [
            {
              "set": "refusedFor",
              "to": "'records'"
            },
            {
              "emit": "wq-refused-records",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "wq-file-accepted-i",
          "from": "wq-open-i",
          "to": "wq-open-i",
          "on": "wq-write-requested",
          "guard": "event.kind == 'file' && filesUsed < 1",
          "effects": [
            {
              "set": "filesUsed",
              "to": "filesUsed + 1"
            },
            {
              "emit": "wq-write-accepted",
              "to": "gateway"
            }
          ]
        },
        {
          "id": "wq-file-refused-i",
          "from": "wq-open-i",
          "to": "wq-open-i",
          "on": "wq-write-requested",
          "guard": "event.kind == 'file' && filesUsed >= 1",
          "effects": [
            {
              "set": "refusedFor",
              "to": "'files'"
            },
            {
              "emit": "wq-refused-files",
              "to": "gateway"
            }
          ]
        }
      ],
      "refinement": {
        "states": {
          "wq-open-i": "wq-open"
        },
        "variables": {
          "recordsUsed": "recordsUsed",
          "filesUsed": "filesUsed",
          "refusedFor": "refusedFor"
        },
        "transitions": {
          "wq-record-accepted-i": "wq-record-accepted",
          "wq-record-refused-i": "wq-record-refused",
          "wq-file-accepted-i": "wq-file-accepted",
          "wq-file-refused-i": "wq-file-refused"
        }
      },
      "storage": {
        "record": "rec-write-quota",
        "key": "tenant-id",
        "creates": true
      },
      "instances": {
        "key": "tenant-id",
        "storedIn": "rec-write-quota",
        "max": 16
      }
    },
    {
      "id": "plan-change-flow",
      "name": "Plan change",
      "subject": "control-plane",
      "initial": "pc-open",
      "description": "A tenant that holds three records and one file asks for a plan with different quotas. The change is refused while the tenant holds more of a metered quantity than the new plan allows, and the refusal names that quantity.",
      "variables": [
        {
          "name": "holdsRecords",
          "type": "number",
          "initial": 3
        },
        {
          "name": "holdsFiles",
          "type": "number",
          "initial": 1
        },
        {
          "name": "planRecords",
          "type": "number",
          "initial": 10
        },
        {
          "name": "planFiles",
          "type": "number",
          "initial": 5
        },
        {
          "name": "refusedFor",
          "type": "string",
          "initial": ""
        }
      ],
      "states": [
        {
          "id": "pc-open",
          "name": "Plan in force"
        }
      ],
      "transitions": [
        {
          "id": "pc-change-ignoring-holdings",
          "from": "pc-open",
          "to": "pc-open",
          "on": "pc-change-requested",
          "effects": [
            {
              "set": "planRecords",
              "to": "event.recordsLimit"
            },
            {
              "set": "planFiles",
              "to": "event.filesLimit"
            },
            {
              "emit": "pc-plan-changed"
            }
          ],
          "faultOnly": true,
          "description": "Defect: changes the plan whatever the tenant holds."
        },
        {
          "id": "pc-name-wrong-quantity",
          "from": "pc-open",
          "to": "pc-open",
          "on": "pc-change-requested",
          "guard": "holdsRecords > event.recordsLimit",
          "effects": [
            {
              "set": "refusedFor",
              "to": "'files'"
            },
            {
              "emit": "pc-refused-files"
            }
          ],
          "faultOnly": true,
          "description": "Defect: names the file quantity when the records exceed the plan."
        },
        {
          "id": "pc-name-wrong-quantity-files",
          "from": "pc-open",
          "to": "pc-open",
          "on": "pc-change-requested",
          "guard": "holdsRecords <= event.recordsLimit && holdsFiles > event.filesLimit",
          "effects": [
            {
              "set": "refusedFor",
              "to": "'records'"
            },
            {
              "emit": "pc-refused-records"
            }
          ],
          "faultOnly": true,
          "description": "Defect: names the record quantity when the files exceed the plan."
        },
        {
          "id": "pc-change",
          "from": "pc-open",
          "to": "pc-open",
          "on": "pc-change-requested",
          "guard": "holdsRecords <= event.recordsLimit && holdsFiles <= event.filesLimit",
          "effects": [
            {
              "set": "planRecords",
              "to": "event.recordsLimit"
            },
            {
              "set": "planFiles",
              "to": "event.filesLimit"
            },
            {
              "emit": "pc-plan-changed"
            }
          ]
        },
        {
          "id": "pc-refuse-records",
          "from": "pc-open",
          "to": "pc-open",
          "on": "pc-change-requested",
          "guard": "holdsRecords > event.recordsLimit",
          "effects": [
            {
              "set": "refusedFor",
              "to": "'records'"
            },
            {
              "emit": "pc-refused-records"
            }
          ]
        },
        {
          "id": "pc-refuse-files",
          "from": "pc-open",
          "to": "pc-open",
          "on": "pc-change-requested",
          "guard": "holdsRecords <= event.recordsLimit && holdsFiles > event.filesLimit",
          "effects": [
            {
              "set": "refusedFor",
              "to": "'files'"
            },
            {
              "emit": "pc-refused-files"
            }
          ]
        }
      ]
    },
    {
      "id": "plan-change-flow-impl",
      "name": "Plan change (implementation)",
      "level": "implementation",
      "subject": "control-plane",
      "refines": "plan-change-flow",
      "description": "A tenant that holds three records and one file asks for a plan with different quotas. The change is refused while the tenant holds more of a metered quantity than the new plan allows, and the refusal names that quantity.",
      "initial": "pc-open-i",
