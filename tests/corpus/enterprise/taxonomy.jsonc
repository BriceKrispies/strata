{
  // The taxonomy module: category and tag trees, the seven-level region hierarchy and audience segments. It depends only on the product-module owner.
  "product": {
    "id": "taxonomy",
    "name": "Taxonomy",
    "description": "Categories, tags, regions and audiences that other modules classify content and people by.",
    "version": "1.0.0",
    "platform": { "min": "0.2" },
    "imports": {
      "spec": "../../../specifications/spec.jsonc",
      "entities": ["product-module", "ui-notice-received", "ui-session-ended", "api-error"]
    }
  },



  "objects": [
    { "id": "taxonomy__category", "label": "Category",
      "fields": {
        "name": { "id": "name", "label": "Name", "ty": "Str", "required": true, "unique": false },
        "slug": { "id": "slug", "label": "Slug", "ty": "Str", "required": true, "unique": true },
        "status": { "id": "status", "label": "Status", "ty": "Str", "required": true, "unique": false },
        "description": { "id": "description", "label": "Description", "ty": "Str", "required": false, "unique": false },
        "parent": { "id": "parent", "label": "Parent category", "ty": { "Ref": { "target": "taxonomy__category", "on-delete": "Restrict" } }, "required": false, "unique": false } },
      "constraints": {},
      "retention": { "days": 3650, "from": "Created" } },
    { "id": "taxonomy__tag", "label": "Tag",
      "fields": {
        "label": { "id": "label", "label": "Label", "ty": "Str", "required": true, "unique": true },
        "kind": { "id": "kind", "label": "Kind", "ty": "Str", "required": true, "unique": false },
        "status": { "id": "status", "label": "Status", "ty": "Str", "required": true, "unique": false } },
      "constraints": {},
      "retention": { "days": 3650, "from": "Created" } },
    { "id": "taxonomy__region", "label": "Region",
      "fields": {
        "name": { "id": "name", "label": "Name", "ty": "Str", "required": true, "unique": false },
        "level": { "id": "level", "label": "Level", "ty": "Str", "required": true, "unique": false },
        "continent": { "id": "continent", "label": "Continent", "ty": "Str", "required": true, "unique": false },
        "region_code": { "id": "region_code", "label": "Region code", "ty": "Str", "required": true, "unique": true },
        "parent": { "id": "parent", "label": "Parent region", "ty": { "Ref": { "target": "taxonomy__region", "on-delete": "Restrict" } }, "required": false, "unique": false } },
      "constraints": {},
      "retention": { "days": 3650, "from": "Created" } },
    { "id": "taxonomy__audience", "label": "Audience",
      "fields": {
        "label": { "id": "label", "label": "Label", "ty": "Str", "required": true, "unique": true },
        "kind": { "id": "kind", "label": "Kind", "ty": "Str", "required": true, "unique": false },
        "age_band": { "id": "age_band", "label": "Age band", "ty": "Str", "required": false, "unique": false },
        "region": { "id": "region", "label": "Region", "ty": "Str", "required": false, "unique": false },
        "active": { "id": "active", "label": "Active", "ty": "Bool", "required": true, "unique": false },
        "days_since_visit": { "id": "days_since_visit", "label": "Days since visit", "ty": "Int", "required": false, "unique": false } },
      "constraints": {},
      "retention": { "days": 730, "from": "Created" } }
  ],

  "workflows": [
    { "id": "taxonomy__category_lifecycle", "object": "taxonomy__category", "field": "status", "initial": ["proposed"],
      "transitions": [
        { "name": "approve", "from": "proposed", "to": "active", "guard": "old.status == 'proposed'", "set": {} },
        { "name": "retire", "from": "active", "to": "retired", "set": {} },
        { "name": "restore", "from": "retired", "to": "active", "set": {} } ] }
  ],

  "roles": [
    { "id": "taxonomy__category_curator", "name": "Category curator", "description": "Maintains the category tree for the whole tenant.", "level": "tenant", "holders": ["person", "team"], "capabilities": ["taxonomy__browse", "taxonomy__curate"] },
    { "id": "taxonomy__region_editor_emea", "name": "Region editor, EMEA", "description": "Edits the European regions only.", "level": "tenant", "holders": ["person", "team"], "capabilities": ["taxonomy__browse", "taxonomy__region_edit"] },
    { "id": "taxonomy__region_editor_amer", "name": "Region editor, Americas", "description": "Edits the regions of North and South America only.", "level": "tenant", "holders": ["person", "team"], "capabilities": ["taxonomy__browse", "taxonomy__region_edit"] },
    { "id": "taxonomy__tag_steward", "name": "Tag steward", "description": "Merges duplicate tags and retires unused ones.", "level": "tenant", "holders": ["person"], "capabilities": ["taxonomy__browse", "taxonomy__curate"] },
    { "id": "taxonomy__member", "name": "Member", "description": "Any member of the tenant who reads what the product shares with everyone.", "level": "tenant",
      "holders": ["person", "team"], "capabilities": [] }
  ],

  "capabilities": [
    { "id": "taxonomy__browse", "name": "Browse taxonomy", "description": "See categories, tags, regions and audiences." },
    { "id": "taxonomy__curate", "name": "Curate taxonomy", "description": "Change categories and tags." },
    { "id": "taxonomy__region_edit", "name": "Edit regions", "description": "Change regions within the scope of the role." }
  ],

  "policies": [
    { "id": "taxonomy__curator_categories", "role": "taxonomy__category_curator", "resource": { "Object": "taxonomy__category" }, "actions": ["Create", "Read", "Update"] },
    { "id": "taxonomy__emea_regions", "role": "taxonomy__region_editor_emea", "resource": { "Object": "taxonomy__region" }, "actions": ["Create", "Read", "Update"], "condition": "record.continent == 'europe'" },
    { "id": "taxonomy__amer_regions", "role": "taxonomy__region_editor_amer", "resource": { "Object": "taxonomy__region" }, "actions": ["Create", "Read", "Update"], "condition": "record.continent == 'americas'" },
    { "id": "taxonomy__steward_tags", "role": "taxonomy__tag_steward", "resource": { "Object": "taxonomy__tag" }, "actions": ["Read", "Update", "Delete"] },
    { "id": "taxonomy__member_active_audiences", "role": "taxonomy__member", "resource": { "Object": "taxonomy__audience" }, "actions": ["Read"], "condition": "record.active == true" }
  ],

  "queries": [
    { "id": "taxonomy__categories_all", "object": "taxonomy__category", "params": [], "order": [ { "field": "name", "descending": false } ], "limit": 200 },
    { "id": "taxonomy__regions_world", "object": "taxonomy__region", "filter": "record.level == 'world'", "params": [], "order": [ { "field": "name", "descending": false } ], "limit": 10 },
    { "id": "taxonomy__regions_continent", "object": "taxonomy__region", "filter": "record.level == 'continent'", "params": [], "order": [ { "field": "name", "descending": false } ], "limit": 20 },
    { "id": "taxonomy__regions_country", "object": "taxonomy__region", "filter": "record.level == 'country'", "params": [], "order": [ { "field": "name", "descending": false } ], "limit": 200 },
    { "id": "taxonomy__regions_region", "object": "taxonomy__region", "filter": "record.level == 'region'", "params": [], "order": [ { "field": "name", "descending": false } ], "limit": 200 },
    { "id": "taxonomy__regions_district", "object": "taxonomy__region", "filter": "record.level == 'district'", "params": [], "order": [ { "field": "name", "descending": false } ], "limit": 200 },
    { "id": "taxonomy__regions_city", "object": "taxonomy__region", "filter": "record.level == 'city'", "params": [], "order": [ { "field": "name", "descending": false } ], "limit": 200 },
    { "id": "taxonomy__regions_postcode", "object": "taxonomy__region", "filter": "record.level == 'postcode'", "params": [], "order": [ { "field": "region_code", "descending": false } ], "limit": 200 }
  ],

  "views": [
    { "id": "taxonomy__category_board", "route": "/taxonomy/board", "title": "Category board",
      "sections": { "main": { "query": "taxonomy__categories_all", "args": {}, "include": [], "markdown": [], "single": false } } },
    {"id":"taxonomy__category_tree_view","route":"/taxonomy/categories","title":"Categories","sections":{"main":{"query":"taxonomy__categories_all","args":{},"include":[],"markdown":[],"single":false}}},
    {"id":"taxonomy__category_editor_view","route":"/taxonomy/categories/:category_id","title":"Edit category","sections":{"main":{"query":"taxonomy__categories_all","args":{},"include":[],"markdown":[],"single":false}}},
    {"id":"taxonomy__region_list_view","route":"/taxonomy/regions","title":"Regions","sections":{"main":{"query":"taxonomy__regions_region","args":{},"include":[],"markdown":[],"single":false}}},
    {"id":"taxonomy__region_editor_view","route":"/taxonomy/regions/:region_id","title":"Edit region","sections":{"main":{"query":"taxonomy__regions_region","args":{},"include":[],"markdown":[],"single":false}}},
    {"id":"taxonomy__tag_list_view","route":"/taxonomy/tags","title":"Tags","sections":{"main":{"query":"taxonomy__categories_all","args":{},"include":[],"markdown":[],"single":false}}},
    {"id":"taxonomy__audience_list_view","route":"/taxonomy/audiences","title":"Audiences","sections":{"main":{"query":"taxonomy__categories_all","args":{},"include":[],"markdown":[],"single":false}}}
  ],

  "segments": [
    { "id": "taxonomy__active_adults", "name": "Active adults", "subject-type": "taxonomy__audience", "principal-field": "label", "predicate": "record.active == true and record.age_band == 'adult'" },
    { "id": "taxonomy__lapsed_audience", "name": "Lapsed audience", "subject-type": "taxonomy__audience", "principal-field": "label", "predicate": "record.days_since_visit > 90" },
    { "id": "taxonomy__european_audience", "name": "European audience", "subject-type": "taxonomy__audience", "principal-field": "label", "predicate": "record.region == 'europe'" }
  ],

  "settings": [
    { "id": "taxonomy__max_tree_depth", "label": "Maximum category depth", "type": "i64", "default": {"Int": 8}, "levels": ["tenant"] },
    { "id": "taxonomy__default_region", "label": "Default region code", "type": "string", "default": {"Str": "world"}, "levels": ["tenant", "team"] }
  ],


  "screens": [
    { "id": "taxonomy__category_tree", "name": "Category tree", "route": "/taxonomy/categories", "viewModel": "taxonomy__category_tree_view", "kind": "taxonomy.list", "auth": "session", "description": "The category tree, with parents and children.", "viewName": "taxonomy_category_tree", "title": "Categories" },
    { "id": "taxonomy__category_editor", "name": "Category editor", "route": "/taxonomy/categories/:category_id", "viewModel": "taxonomy__category_editor_view", "kind": "taxonomy.editor", "auth": "session", "description": "Edit one category and its parent.", "viewName": "taxonomy_category_editor", "title": "Edit category" },
    { "id": "taxonomy__region_list", "name": "Region list", "route": "/taxonomy/regions", "viewModel": "taxonomy__region_list_view", "kind": "taxonomy.list", "auth": "session", "description": "The regions of the hierarchy, by level.", "viewName": "taxonomy_region_list", "title": "Regions" },
    { "id": "taxonomy__region_editor", "name": "Region editor", "route": "/taxonomy/regions/:region_id", "viewModel": "taxonomy__region_editor_view", "kind": "taxonomy.editor", "auth": "session", "description": "Edit one region and its parent.", "viewName": "taxonomy_region_editor", "title": "Edit region" },
    { "id": "taxonomy__tag_list", "name": "Tag list", "route": "/taxonomy/tags", "viewModel": "taxonomy__tag_list_view", "kind": "taxonomy.list", "auth": "session", "description": "The tags in use, with a merge action for duplicates.", "viewName": "taxonomy_tag_list", "title": "Tags" },
    { "id": "taxonomy__audience_list", "name": "Audience list", "route": "/taxonomy/audiences", "viewModel": "taxonomy__audience_list_view", "kind": "taxonomy.list", "auth": "session", "description": "The audiences defined for the tenant.", "viewName": "taxonomy_audience_list", "title": "Audiences" }
  ],

  "forms": [
    { "id": "taxonomy__form_category_editor", "screen": "taxonomy__category_editor", "contract": "taxonomy__submit_category",
      "fields": [
        { "name": "name", "input": "name", "label": "Name", "control": "text" },
        { "name": "slug", "input": "slug", "label": "Slug", "control": "text", "normalize": "trim" },
        { "name": "parent", "input": "parent", "label": "Parent category", "control": "text" },
        { "name": "description", "input": "description", "label": "Description", "control": "textarea" } ],
      "submitLabel": "Save category", "onSuccess": { "navigate": { "screen": "taxonomy__category_tree" }, "toast": "Category saved." },
      "onError": { "show": "inline" } },
    { "id": "taxonomy__form_move_category", "screen": "taxonomy__category_tree", "contract": "taxonomy__apply_move",
      "fields": [
        { "name": "category", "input": "category", "label": "Category", "control": "text" },
        { "name": "parent", "input": "parent", "label": "New parent", "control": "text" } ],
      "submitLabel": "Move", "onSuccess": { "toast": "Category moved." }, "onError": { "show": "toast" } },
    { "id": "taxonomy__form_region_editor", "screen": "taxonomy__region_editor", "contract": "taxonomy__submit_region",
      "fields": [
        { "name": "name", "input": "name", "label": "Name", "control": "text" },
        { "name": "region_code", "input": "region_code", "label": "Region code", "control": "text", "normalize": "trim" },
        { "name": "level", "input": "level", "label": "Level", "control": "text" },
        { "name": "continent", "input": "continent", "label": "Continent", "control": "text" },
        { "name": "parent", "input": "parent", "label": "Parent region", "control": "text" } ],
      "submitLabel": "Save region", "onSuccess": { "navigate": { "screen": "taxonomy__region_list" }, "toast": "Region saved." },
      "onError": { "show": "inline" } },
    { "id": "taxonomy__form_merge_tags", "screen": "taxonomy__tag_list", "contract": "taxonomy__apply_merge",
      "fields": [
        { "name": "keep", "input": "keep", "label": "Keep this tag", "control": "text" },
        { "name": "drop", "input": "drop", "label": "Merge this duplicate into it", "control": "text" } ],
      "submitLabel": "Merge", "onSuccess": { "toast": "Tags merged." }, "onError": { "show": "toast" } }
  ],

  "actions": [
    { "id": "taxonomy__action_save_category", "screen": "taxonomy__category_editor", "label": "Save category", "contract": "taxonomy__submit_category", "form": "taxonomy__form_category_editor",
      "arguments": { "name": "form.name", "slug": "form.slug", "parent": "form.parent", "description": "form.description" },
      "onSuccess": { "toast": "Category saved." }, "onError": { "show": "inline" } },
    { "id": "taxonomy__action_move_category", "screen": "taxonomy__category_tree", "label": "Move category", "contract": "taxonomy__apply_move", "form": "taxonomy__form_move_category",
      "arguments": { "category": "form.category", "parent": "form.parent" },
      "onSuccess": { "toast": "Category moved." }, "onError": { "show": "toast" } },
    { "id": "taxonomy__action_merge_tags", "screen": "taxonomy__tag_list", "label": "Merge tags", "contract": "taxonomy__apply_merge", "form": "taxonomy__form_merge_tags",
      "arguments": { "keep": "form.keep", "drop": "form.drop" },
      "onSuccess": { "toast": "Tags merged." }, "onError": { "show": "toast" } }
  ],

  "liveBindings": [
    { "id": "taxonomy__live_category_tree", "screen": "taxonomy__category_tree", "event": "ui-notice-received", "refresh": "whole",
      "when": { "any": ["event.kind == 'membership'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "taxonomy__live_category_tree_ended", "screen": "taxonomy__category_tree", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "taxonomy__live_category_editor", "screen": "taxonomy__category_editor", "event": "ui-notice-received", "refresh": "whole",
      "when": { "any": ["event.kind == 'membership'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "taxonomy__live_category_editor_ended", "screen": "taxonomy__category_editor", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "taxonomy__live_region_list", "screen": "taxonomy__region_list", "event": "ui-notice-received", "refresh": "whole",
      "when": { "any": ["event.kind == 'membership'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "taxonomy__live_region_list_ended", "screen": "taxonomy__region_list", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "taxonomy__live_region_editor", "screen": "taxonomy__region_editor", "event": "ui-notice-received", "refresh": "whole",
      "when": { "any": ["event.kind == 'membership'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "taxonomy__live_region_editor_ended", "screen": "taxonomy__region_editor", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "taxonomy__live_tag_list", "screen": "taxonomy__tag_list", "event": "ui-notice-received", "refresh": "whole",
      "when": { "any": ["event.kind == 'membership'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "taxonomy__live_tag_list_ended", "screen": "taxonomy__tag_list", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "taxonomy__live_audience_list", "screen": "taxonomy__audience_list", "event": "ui-notice-received", "refresh": "whole",
      "when": { "any": ["event.kind == 'membership'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "taxonomy__live_audience_list_ended", "screen": "taxonomy__audience_list", "event": "ui-session-ended", "refresh": "whole" }
  ],

  "operations": [
    { "id": "taxonomy__move_category", "label": "Move a category under a new parent",
      "conditions": [],
      "inputs": [ { "name": "category", "ty": { "Ref": { "target": "taxonomy__category", "on-delete": "Restrict" } }, "required": true, "label": "The category" },
                  { "name": "parent", "ty": "Str", "required": false, "label": "The new parent" } ],
      "invokers": { "signed-in": true, "roles": ["taxonomy__category_curator"] },
      "subject": { "object": "taxonomy__category", "input": "category" },
      "steps": [
        { "UpdateRecord": { "id": "set_parent", "object": "taxonomy__category", "record": "record.$id", "fields": { "parent": "param.parent" } } } ] },
    { "id": "taxonomy__merge_tags", "label": "Merge a duplicate tag into another",
      "inputs": [ { "name": "keep", "ty": { "Ref": { "target": "taxonomy__tag", "on-delete": "Restrict" } }, "required": true, "label": "The tag to keep" },
                  { "name": "drop", "ty": "Str", "required": true, "label": "The duplicate to remove" } ],
      "invokers": { "signed-in": true, "roles": ["taxonomy__tag_steward"] },
      "subject": { "object": "taxonomy__tag", "input": "keep" },
      "conditions": [ { "id": "distinct", "expr": "param.keep != param.drop", "error": "same-tag", "message": "Choose two different tags." } ],
      "steps": [
        { "UpdateRecord": { "id": "mark_kept", "object": "taxonomy__tag", "record": "record.$id", "fields": { "status": "'canonical'" } } },
        { "DeleteRecord": { "id": "remove_duplicate", "object": "taxonomy__tag", "record": "param.drop" } } ] },
    {"id":"taxonomy__submit_category","label":"Save a category","inputs":[{"name":"name","ty":"Str","required":false,"label":"name"},{"name":"slug","ty":"Str","required":false,"label":"slug"},{"name":"parent","ty":"Str","required":false,"label":"parent"},{"name":"description","ty":"Str","required":false,"label":"description"}],"invokers":{"signed-in":true,"roles":[]},"conditions":[],"steps":[]},
    {"id":"taxonomy__apply_move","label":"Move a category","inputs":[{"name":"category","ty":"Str","required":false,"label":"category"},{"name":"parent","ty":"Str","required":false,"label":"parent"}],"invokers":{"signed-in":true,"roles":[]},"conditions":[],"steps":[]},
    {"id":"taxonomy__submit_region","label":"Save a region","inputs":[{"name":"name","ty":"Str","required":false,"label":"name"},{"name":"region_code","ty":"Str","required":false,"label":"region code"},{"name":"level","ty":"Str","required":false,"label":"level"},{"name":"continent","ty":"Str","required":false,"label":"continent"},{"name":"parent","ty":"Str","required":false,"label":"parent"}],"invokers":{"signed-in":true,"roles":[]},"conditions":[],"steps":[]},
    {"id":"taxonomy__apply_merge","label":"Merge a duplicate tag","inputs":[{"name":"keep","ty":"Str","required":false,"label":"keep"},{"name":"drop","ty":"Str","required":false,"label":"drop"}],"invokers":{"signed-in":true,"roles":[]},"conditions":[],"steps":[]}
  ],

  "triggers": [
    { "id": "taxonomy__on_category_created", "on": { "RecordCreated": { "object": "taxonomy__category" } },
      "condition": "param.hop < 4", "automation": "taxonomy__notify_category_created" }
  ],

  "automations": [
    { "id": "taxonomy__notify_category_created", "label": "Tell the curator that a new category was created",
      "run-as": { "roles": ["taxonomy__category_curator"] }, "run-key": "param.owner",
      "start": "notify",
      "steps": {
        "notify": { "action": { "SendMail": { "template": "taxonomy__category_mail", "to": "param.owner", "category": "transactional" } }, "next": "done", "timeout": 30000 },
        "done": { "action": "End" } } }
  ],

  "mailTemplates": [
    { "id": "taxonomy__category_mail", "subject": "A new category is waiting for approval", "body": "[{\"type\":\"paragraph\",\"inlines\":[{\"type\":\"text\",\"text\":\"A new category was created and is proposed.\"}]}]" }
  ],

  "noticeTemplates": [
    { "id": "taxonomy__category_notice", "title": "Category created", "body": "[{\"type\":\"paragraph\",\"inlines\":[{\"type\":\"text\",\"text\":\"A new category was created.\"}]}]" }
  ],


  "errorMessages": [
    { "id": "taxonomy__error_code_taken", "on": "check", "kinds": ["unique"], "text": "Another region already uses this code.", "field": { "name": "region_code" } },
    { "id": "taxonomy__error_tree_changed", "on": "error", "kinds": ["conflict"], "text": "The category tree changed while you were editing. Reload to see the latest version." }
  ],

  "claims": [
    { "id": "taxonomy__category-no-cycle", "kind": "structural", "statement": "A category SHALL NOT be its own ancestor in the category tree.",
      "subjects": ["product-module"], "rationale": "The tree is walked from the root, and a cycle would never end.", "evaluate": { "method": "external-evidence" } },
    { "id": "taxonomy__merge-leaves-one", "kind": "structural", "statement": "A tag merge SHALL leave exactly one live tag where there were two.",
      "subjects": ["product-module"], "rationale": "Two live copies of one tag would split its usage.", "evaluate": { "method": "external-evidence" } }
  ]
}
