{
  // Contacts, accounts, leads, consent and campaign touches for the sales tenant; depends on the platform consent-record capability.
  "product": {
    "id": "crm",
    "name": "CRM",
    "description": "Contacts, accounts and leads with consent and campaign history.",
    "version": "1.0.0",
    "platform": { "min": "0.2" },
    "imports": {
      "spec": "../../../specifications/spec.jsonc",
      "entities": ["product-module", "ui-notice-received", "ui-session-ended", "api-error", "consent-record"]
    }
  },
  "screens": [
    { "id": "crm__contact_list", "name": "Contacts", "route": "/crm/contacts", "viewModel": "crm__contact_list_view", "kind": "crm.list", "auth": "session", "description": "The contacts in the rep's region, by last name.", "viewName": "crm_contact_list", "title": "Contacts" },
    { "id": "crm__contact_editor", "name": "Contact editor", "route": "/crm/contacts/:id", "viewModel": "crm__contact_editor_view", "kind": "crm.editor", "auth": "session", "description": "Edit one contact and its details.", "viewName": "crm_contact_editor", "title": "Contact" },
    { "id": "crm__account_list", "name": "Accounts", "route": "/crm/accounts", "viewModel": "crm__account_list_view", "kind": "crm.list", "auth": "session", "description": "The accounts with their parent accounts.", "viewName": "crm_account_list", "title": "Accounts" },
    { "id": "crm__lead_board_screen", "name": "Lead board", "route": "/crm/leads", "viewModel": "crm__lead_board_screen_view", "kind": "crm.list", "auth": "session", "description": "Leads by status, with qualify and save actions.", "viewName": "crm_lead_board", "title": "Leads" },
    { "id": "crm__consent_screen", "name": "Consent", "route": "/crm/consent", "viewModel": "crm__consent_screen_view", "kind": "crm.list", "auth": "session", "description": "Consent records across contacts.", "viewName": "crm_consent_list", "title": "Consent" },
    { "id": "crm__settings_screen", "name": "CRM settings", "route": "/crm/settings", "viewModel": "crm__settings_screen_view", "kind": "crm.settings", "auth": "session", "description": "Tenant defaults for the CRM.", "viewName": "crm_settings", "title": "CRM settings" }
  ],
  "forms": [
    { "id": "crm__contact_form", "screen": "crm__contact_editor", "contract": "crm__save_contact",
      "fields": [
        { "name": "first_name", "input": "first_name", "label": "Given name", "control": "text", "normalize": "trim" },
        { "name": "last_name", "input": "last_name", "label": "Family name", "control": "text", "normalize": "trim" },
        { "name": "email", "input": "email", "label": "Email", "control": "text", "normalize": "trim" },
        { "name": "phone", "input": "phone", "label": "Phone", "control": "text" },
        { "name": "mobile", "input": "mobile", "label": "Mobile", "control": "text" },
        { "name": "job_title", "input": "job_title", "label": "Job title", "control": "text" },
        { "name": "department", "input": "department", "label": "Department", "control": "text" },
        { "name": "company", "input": "company", "label": "Company", "control": "text" },
        { "name": "website", "input": "website", "label": "Website", "control": "text" },
        { "name": "street", "input": "street", "label": "Street address", "control": "text" },
        { "name": "city", "input": "city", "label": "City", "control": "text" },
        { "name": "region", "input": "region", "label": "Region", "control": "text" },
        { "name": "postal_code", "input": "postal_code", "label": "Postal code", "control": "text" },
        { "name": "country", "input": "country", "label": "Country", "control": "text" },
        { "name": "preferred_language", "input": "preferred_language", "label": "Language", "control": "text" },
        { "name": "time_zone", "input": "time_zone", "label": "Time zone", "control": "text" },
        { "name": "lead_source", "input": "lead_source", "label": "Lead source", "control": "text" },
        { "name": "lifecycle_stage", "input": "lifecycle_stage", "label": "Lifecycle stage", "control": "text" },
        { "name": "owner_team", "input": "owner_team", "label": "Owning team", "control": "text" },
        { "name": "territory", "input": "territory", "label": "Territory", "control": "text" },
        { "name": "do_not_call", "input": "do_not_call", "label": "Do not call", "control": "checkbox" },
        { "name": "do_not_email", "input": "do_not_email", "label": "Do not email", "control": "checkbox" },
        { "name": "newsletter_opt_in", "input": "newsletter_opt_in", "label": "Newsletter", "control": "checkbox" },
        { "name": "event_opt_in", "input": "event_opt_in", "label": "Events", "control": "checkbox" },
        { "name": "decision_maker", "input": "decision_maker", "label": "Decision maker", "control": "checkbox" },
        { "name": "budget_band", "input": "budget_band", "label": "Budget band", "control": "text" },
        { "name": "industry", "input": "industry", "label": "Industry", "control": "text" },
        { "name": "employee_count", "input": "employee_count", "label": "Employee count", "control": "text" },
        { "name": "annual_revenue", "input": "annual_revenue", "label": "Annual revenue band", "control": "text" },
        { "name": "linkedin_url", "input": "linkedin_url", "label": "Profile link", "control": "text" },
        { "name": "twitter_handle", "input": "twitter_handle", "label": "Social handle", "control": "text" },
        { "name": "assistant_name", "input": "assistant_name", "label": "Assistant name", "control": "text" },
        { "name": "assistant_email", "input": "assistant_email", "label": "Assistant email", "control": "text" },
        { "name": "reports_to", "input": "reports_to", "label": "Reports to", "control": "text" },
        { "name": "interests", "input": "interests", "label": "Interests", "control": "textarea" },
        { "name": "pain_points", "input": "pain_points", "label": "Pain points", "control": "textarea" },
        { "name": "notes", "input": "notes", "label": "Notes", "control": "textarea" },
        { "name": "last_contact_summary", "input": "last_contact_summary", "label": "Last contact summary", "control": "textarea" },
        { "name": "next_step", "input": "next_step", "label": "Next step", "control": "text" },
        { "name": "next_step_date", "input": "next_step_date", "label": "Next step date", "control": "text" },
        { "name": "preferred_channel", "input": "preferred_channel", "label": "Preferred channel", "control": "text" },
        { "name": "contact_window", "input": "contact_window", "label": "Contact window", "control": "text" },
        { "name": "accessibility_notes", "input": "accessibility_notes", "label": "Accessibility notes", "control": "textarea" },
        { "name": "partner_referral", "input": "partner_referral", "label": "Partner referral", "control": "text" },
        { "name": "referral_code", "input": "referral_code", "label": "Referral code", "control": "text" },
        { "name": "nps_band", "input": "nps_band", "label": "NPS band", "control": "text" },
        { "name": "support_plan", "input": "support_plan", "label": "Support plan", "control": "text" },
        { "name": "renewal_month", "input": "renewal_month", "label": "Renewal month", "control": "text" },
        { "name": "tags", "input": "tags", "label": "Tags", "control": "text" },
        { "name": "external_reference", "input": "external_reference", "label": "External reference", "control": "text" } ],
      "submitLabel": "Save contact", "onSuccess": { "navigate": { "screen": "crm__contact_list" }, "toast": "Contact saved." }, "onError": { "show": "inline" } },
    { "id": "crm__lead_form", "screen": "crm__lead_board_screen", "contract": "crm__save_lead",
      "fields": [
        { "name": "company", "input": "company", "label": "Company", "control": "text", "normalize": "trim" },
        { "name": "contact_email", "input": "contact_email", "label": "Contact email", "control": "text", "normalize": "trim" },
        { "name": "source", "input": "source", "label": "Source", "control": "text" },
        { "name": "estimated_value", "input": "estimated_value", "label": "Estimated value", "control": "text" },
        { "name": "notes", "input": "notes", "label": "Notes", "control": "textarea" } ],
      "submitLabel": "Save lead", "onSuccess": { "toast": "Lead saved." }, "onError": { "show": "inline" } },
    { "id": "crm__consent_form", "screen": "crm__consent_screen", "contract": "crm__record_consent",
      "fields": [
        { "name": "contact", "input": "contact", "label": "Contact reference", "control": "text" },
        { "name": "purpose", "input": "purpose", "label": "Purpose", "control": "text" },
        { "name": "channel", "input": "channel", "label": "Channel", "control": "text" },
        { "name": "granted", "input": "granted", "label": "Consent granted", "control": "checkbox" },
        { "name": "note", "input": "note", "label": "Note", "control": "textarea" } ],
      "submitLabel": "Record consent", "onSuccess": { "toast": "Consent recorded." }, "onError": { "show": "inline" } },
    { "id": "crm__merge_form", "screen": "crm__contact_list", "contract": "crm__request_merge",
      "fields": [
        { "name": "keep", "input": "keep", "label": "Keep this contact", "control": "text" },
        { "name": "duplicate", "input": "duplicate", "label": "Merge this duplicate into it", "control": "text" },
        { "name": "reason", "input": "reason", "label": "Reason", "control": "textarea" } ],
      "submitLabel": "Merge", "onSuccess": { "toast": "Contacts merged." }, "onError": { "show": "inline" } }
  ],
  "actions": [
    { "id": "crm__action_save_contact", "screen": "crm__contact_editor", "label": "Save contact", "contract": "crm__save_contact", "form": "crm__contact_form", "arguments": { "first_name": "form.first_name", "last_name": "form.last_name", "email": "form.email", "phone": "form.phone" }, "onSuccess": { "toast": "Contact saved." }, "onError": { "show": "inline" } },
    { "id": "crm__action_merge", "screen": "crm__contact_list", "label": "Merge", "contract": "crm__request_merge", "form": "crm__merge_form", "arguments": { "keep": "form.keep", "duplicate": "form.duplicate" }, "onSuccess": { "toast": "Contacts merged." }, "onError": { "show": "toast" } },
    { "id": "crm__action_qualify", "screen": "crm__lead_board_screen", "label": "Qualify", "contract": "crm__qualify_lead", "onSuccess": { "toast": "Lead qualified." }, "onError": { "show": "toast" } },
    { "id": "crm__action_save_lead", "screen": "crm__lead_board_screen", "label": "Save lead", "contract": "crm__save_lead", "form": "crm__lead_form", "arguments": { "company": "form.company", "contact_email": "form.contact_email", "source": "form.source" }, "onSuccess": { "toast": "Lead saved." }, "onError": { "show": "inline" } },
    { "id": "crm__action_record_consent", "screen": "crm__consent_screen", "label": "Record consent", "contract": "crm__record_consent", "form": "crm__consent_form", "arguments": { "contact": "form.contact", "purpose": "form.purpose", "channel": "form.channel", "granted": "form.granted" }, "onSuccess": { "toast": "Consent recorded." }, "onError": { "show": "inline" } }
  ],
  "liveBindings": [
    { "id": "crm__live_contact_list", "screen": "crm__contact_list", "event": "ui-notice-received", "refresh": "whole", "when": { "any": ["event.kind == 'membership'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "crm__live_contact_list_ended", "screen": "crm__contact_list", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "crm__live_contact_editor", "screen": "crm__contact_editor", "event": "ui-notice-received", "refresh": "whole", "when": { "any": ["event.kind == 'membership'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "crm__live_contact_editor_ended", "screen": "crm__contact_editor", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "crm__live_account_list", "screen": "crm__account_list", "event": "ui-notice-received", "refresh": "whole", "when": { "any": ["event.kind == 'membership'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "crm__live_account_list_ended", "screen": "crm__account_list", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "crm__live_lead_board", "screen": "crm__lead_board_screen", "event": "ui-notice-received", "refresh": "whole", "when": { "any": ["event.kind == 'membership'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "crm__live_lead_board_ended", "screen": "crm__lead_board_screen", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "crm__live_consent", "screen": "crm__consent_screen", "event": "ui-notice-received", "refresh": "whole", "when": { "any": ["event.kind == 'membership'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "crm__live_consent_ended", "screen": "crm__consent_screen", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "crm__live_settings", "screen": "crm__settings_screen", "event": "ui-notice-received", "refresh": "whole", "when": { "any": ["event.kind == 'membership'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "crm__live_settings_ended", "screen": "crm__settings_screen", "event": "ui-session-ended", "refresh": "whole" }
  ],
  "errorMessages": [
    { "id": "crm__error_duplicate_email", "on": "check", "kinds": ["unique"], "text": "Another contact already uses this email address.", "field": { "name": "email" } },
    { "id": "crm__error_conflict", "on": "error", "kinds": ["conflict"], "text": "This contact was changed elsewhere. Reload to see the latest version." }
  ],
  "roles": [
    { "id": "crm__rep_emea", "name": "Sales rep, EMEA", "description": "Works contacts and leads in the EMEA territory.", "level": "tenant",
      "holders": ["person", "team"], "capabilities": ["crm__work_contacts", "crm__work_emea"] },
    { "id": "crm__rep_apac", "name": "Sales rep, APAC", "description": "Works contacts and leads in the APAC territory.", "level": "tenant",
      "holders": ["person", "team"], "capabilities": ["crm__work_contacts", "crm__work_apac"] },
    { "id": "crm__rep_amer", "name": "Sales rep, AMER", "description": "Works contacts and leads in the AMER territory.", "level": "tenant",
      "holders": ["person", "team"], "capabilities": ["crm__work_contacts", "crm__work_amer"] },
    { "id": "crm__admin", "name": "CRM administrator", "description": "Merges contacts, reads consent and changes CRM settings.", "level": "tenant",
      "holders": ["person"], "capabilities": ["crm__administer", "crm__work_contacts", "consent-record"] }
  ],
  "claims": [
    { "id": "crm__merge-keeps-history", "kind": "structural",
      "statement": "A contact merge SHALL retain the surviving contact and its consent history.",
      "subjects": ["product-module"],
      "rationale": "Consent evidence must not be lost when duplicates are merged.",
      "evaluate": { "method": "external-evidence" } },
    { "id": "crm__consent-before-marketing", "kind": "structural",
      "statement": "A marketing email SHALL NOT be sent to a contact without a granted marketing consent record.",
      "subjects": ["product-module"],
      "rationale": "Marketing mail is only lawful with recorded consent.",
      "evaluate": { "method": "external-evidence" } }
  ],
  "capabilities": [
    { "id": "crm__work_contacts", "name": "Work contacts", "description": "Read and edit contacts, accounts and leads in the territories granted." },
    { "id": "crm__work_emea", "name": "Work EMEA", "description": "Work records in the EMEA territory." },
    { "id": "crm__work_apac", "name": "Work APAC", "description": "Work records in the APAC territory." },
    { "id": "crm__work_amer", "name": "Work AMER", "description": "Work records in the AMER territory." },
    { "id": "crm__administer", "name": "Administer the CRM", "description": "Merge contacts, read consent and change tenant defaults." }
  ],
  "objects": [
    { "id": "crm__contact", "label": "Contact",
      "fields": {
        "first_name": { "id": "first_name", "label": "Given name", "ty": "Str", "required": true, "unique": false,
          "personal": { "kind": "name", "subject": { "Field": { "field": "first_name" } }, "searchable": true } },
        "last_name": { "id": "last_name", "label": "Family name", "ty": "Str", "required": true, "unique": false,
          "personal": { "kind": "name", "subject": { "Field": { "field": "last_name" } }, "searchable": true } },
        "email": { "id": "email", "label": "Email", "ty": "Str", "required": false, "unique": true,
          "personal": { "kind": "email-address", "subject": { "Field": { "field": "email" } }, "searchable": true } },
        "phone": { "id": "phone", "label": "Phone", "ty": "Str", "required": false, "unique": false,
          "personal": { "kind": "phone-number", "subject": { "Field": { "field": "phone" } }, "searchable": false } },
        "company": { "id": "company", "label": "Company", "ty": "Str", "required": false, "unique": false },
        "job_title": { "id": "job_title", "label": "Job title", "ty": "Str", "required": false, "unique": false },
        "territory": { "id": "territory", "label": "Territory", "ty": "Str", "required": true, "unique": false },
        "lifecycle_stage": { "id": "lifecycle_stage", "label": "Lifecycle stage", "ty": "Str", "required": false, "unique": false },
        "account": { "id": "account", "label": "Account", "ty": { "Ref": { "target": "crm__account", "on-delete": "Restrict" } }, "required": false, "unique": false },
        "merged_from": { "id": "merged_from", "label": "Merged from", "ty": "Str", "required": false, "unique": false },
        "do_not_email": { "id": "do_not_email", "label": "Do not email", "ty": "Bool", "required": true, "unique": false },
        "do_not_call": { "id": "do_not_call", "label": "Do not call", "ty": "Bool", "required": true, "unique": false } },
      "constraints": {},
      "retention": { "days": 1095, "from": "Created" } },
    { "id": "crm__account", "label": "Account",
      "fields": {
        "name": { "id": "name", "label": "Name", "ty": "Str", "required": true, "unique": false },
        "parent": { "id": "parent", "label": "Parent account", "ty": { "Ref": { "target": "crm__account", "on-delete": "Restrict" } }, "required": false, "unique": false },
        "primary_contact": { "id": "primary_contact", "label": "Primary contact", "ty": { "Ref": { "target": "crm__contact", "on-delete": "Restrict" } }, "required": false, "unique": false },
        "region": { "id": "region", "label": "Region", "ty": "Str", "required": true, "unique": false },
        "industry": { "id": "industry", "label": "Industry", "ty": "Str", "required": false, "unique": false },
        "billing_city": { "id": "billing_city", "label": "Billing city", "ty": "Str", "required": false, "unique": false } },
      "constraints": {},
      "retention": { "days": 2555, "from": "Created" } },
    { "id": "crm__lead", "label": "Lead",
      "fields": {
        "company": { "id": "company", "label": "Company", "ty": "Str", "required": true, "unique": false },
        "contact_email": { "id": "contact_email", "label": "Contact email", "ty": "Str", "required": false, "unique": false,
          "personal": { "kind": "email-address", "subject": { "Field": { "field": "contact_email" } }, "searchable": true } },
        "status": { "id": "status", "label": "Status", "ty": "Str", "required": true, "unique": false },
        "source": { "id": "source", "label": "Source", "ty": "Str", "required": false, "unique": false },
        "estimated_value": { "id": "estimated_value", "label": "Estimated value", "ty": "Int", "required": false, "unique": false },
        "budget_band": { "id": "budget_band", "label": "Budget band", "ty": "Str", "required": false, "unique": false } },
      "constraints": {},
      "retention": { "days": 730, "from": "Created" } },
    { "id": "crm__consent_record", "label": "Consent record",
      "fields": {
        "contact": { "id": "contact", "label": "Contact", "ty": { "Ref": { "target": "crm__contact", "on-delete": "Restrict" } }, "required": true, "unique": false },
        "purpose": { "id": "purpose", "label": "Purpose", "ty": "Str", "required": true, "unique": false },
        "channel": { "id": "channel", "label": "Channel", "ty": "Str", "required": true, "unique": false },
        "granted": { "id": "granted", "label": "Granted", "ty": "Bool", "required": true, "unique": false },
        "captured_at": { "id": "captured_at", "label": "Captured", "ty": "Time", "required": true, "unique": false },
        "subject_email": { "id": "subject_email", "label": "Subject email", "ty": "Str", "required": false, "unique": false,
          "personal": { "kind": "email-address", "subject": { "Field": { "field": "subject_email" } }, "searchable": false } } },
      "constraints": {},
      "retention": { "days": 1095, "from": "Created" } },
    { "id": "crm__campaign_touch", "label": "Campaign touch",
      "fields": {
        "contact": { "id": "contact", "label": "Contact", "ty": { "Ref": { "target": "crm__contact", "on-delete": "Restrict" } }, "required": false, "unique": false },
        "campaign": { "id": "campaign", "label": "Campaign", "ty": "Str", "required": true, "unique": false },
        "channel": { "id": "channel", "label": "Channel", "ty": "Str", "required": true, "unique": false },
        "touched_at": { "id": "touched_at", "label": "Touched", "ty": "Time", "required": true, "unique": false },
        "outcome": { "id": "outcome", "label": "Outcome", "ty": "Str", "required": false, "unique": false } },
      "constraints": {},
      "retention": { "days": 730, "from": "Created" } }
  ],
  "policies": [
    { "id": "crm__emea_contacts", "role": "crm__rep_emea", "resource": { "Object": "crm__contact" }, "actions": ["Read", "Update"], "condition": "record.territory == 'emea'" },
    { "id": "crm__apac_contacts", "role": "crm__rep_apac", "resource": { "Object": "crm__contact" }, "actions": ["Read", "Update"], "condition": "record.territory == 'apac'" },
    { "id": "crm__amer_contacts", "role": "crm__rep_amer", "resource": { "Object": "crm__contact" }, "actions": ["Read", "Update"], "condition": "record.territory == 'amer'" },
    { "id": "crm__admin_contacts", "role": "crm__admin", "resource": { "Object": "crm__contact" }, "actions": ["Create", "Read", "Update", "Delete"] },
    { "id": "crm__admin_consent", "role": "crm__admin", "resource": { "Object": "crm__consent_record" }, "actions": ["Read"] }
  ],
  "queries": [
    { "id": "crm__open_leads", "object": "crm__lead", "filter": "record.status == 'new' or record.status == 'working'", "params": [], "order": [ { "field": "company", "descending": false } ], "limit": 100 },
    { "id": "crm__contacts_by_territory", "object": "crm__contact", "filter": "record.territory == param.territory", "params": ["territory"], "order": [ { "field": "last_name", "descending": false } ], "limit": 200 }
  ],
  "views": [
    { "id": "crm__lead_board", "route": "/crm/board", "title": "Lead board",
      "sections": { "main": { "query": "crm__open_leads", "args": {}, "include": [], "markdown": [], "single": false } } },
    {"id":"crm__contact_list_view","route":"/crm/contacts","title":"Contacts","sections":{"main":{"query":"crm__contacts_by_territory","args":{"territory":{"Const":{"Str":"x"}}},"include":[],"markdown":[],"single":false}}},
    {"id":"crm__contact_editor_view","route":"/crm/contacts/:id","title":"Contact","sections":{"main":{"query":"crm__contacts_by_territory","args":{"territory":{"Const":{"Str":"x"}}},"include":[],"markdown":[],"single":false}}},
    {"id":"crm__account_list_view","route":"/crm/accounts","title":"Accounts","sections":{"main":{"query":"crm__open_leads","args":{},"include":[],"markdown":[],"single":false}}},
    {"id":"crm__lead_board_screen_view","route":"/crm/leads","title":"Leads","sections":{"main":{"query":"crm__open_leads","args":{},"include":[],"markdown":[],"single":false}}},
    {"id":"crm__consent_screen_view","route":"/crm/consent","title":"Consent","sections":{"main":{"query":"crm__open_leads","args":{},"include":[],"markdown":[],"single":false}}},
    {"id":"crm__settings_screen_view","route":"/crm/settings","title":"CRM settings","sections":{"main":{"query":"crm__open_leads","args":{},"include":[],"markdown":[],"single":false}}}
  ],
  "workflows": [
    { "id": "crm__lead_lifecycle", "object": "crm__lead", "field": "status", "initial": ["new"],
      "transitions": [
        { "name": "start_work", "from": "new", "to": "working", "set": {} },
        { "name": "qualify", "from": "working", "to": "qualified", "guard": "old.status == 'working'", "set": {} },
        { "name": "convert", "from": "qualified", "to": "converted", "guard": "old.status == 'qualified'", "set": {} },
        { "name": "disqualify", "from": "working", "to": "disqualified", "guard": "old.status == 'working'", "set": {} } ] }
  ],
  "settings": [
    { "id": "crm__default_region", "label": "Default region for new records", "type": "string", "default": {"Str": "emea"}, "levels": ["tenant", "team"] },
    { "id": "crm__retention_days", "label": "Default retention for contacts", "type": "i64", "default": {"Int": 1095}, "levels": ["tenant"] }
  ],
  "mailTemplates": [
    { "id": "crm__qualified_mail", "subject": "Thank you for your enquiry",
      "body": "[{\"type\":\"paragraph\",\"inlines\":[{\"type\":\"text\",\"text\":\"Thank you for your enquiry. A member of our team will be in touch shortly.\"}]}]" }
  ],
  "noticeTemplates": [
    { "id": "crm__lead_notice", "title": "Lead qualified",
      "body": "[{\"type\":\"paragraph\",\"inlines\":[{\"type\":\"text\",\"text\":\"A lead in your territory was qualified.\"}]}]" }
  ],
  "triggers": [
    { "id": "crm__on_lead_qualified", "on": { "RecordUpdated": { "object": "crm__lead", "transition": "qualify" } }, "automation": "crm__lead_qualified_follow_up" }
  ],
  "automations": [
    { "id": "crm__lead_qualified_follow_up", "label": "Wait three days after a lead is qualified, then send the follow-up mail",
      "run-as": { "roles": ["crm__rep_emea", "crm__rep_apac", "crm__rep_amer"] },
      "start": "wait",
      "steps": {
        "wait": { "action": { "WaitFor": { "duration": 259200000 } }, "next": "mail" },
        "mail": { "action": { "SendMail": { "template": "crm__qualified_mail", "to": "param.owner", "category": "transactional" } }, "next": "done", "timeout": 30000 },
        "done": { "action": "End" } } }
  ],
  "operations": [
    { "id": "crm__merge_contacts", "label": "Merge a duplicate contact into a survivor",
      "inputs": [
        { "name": "keep", "ty": { "Ref": { "target": "crm__contact", "on-delete": "Restrict" } }, "required": true, "label": "Contact to keep" },
        { "name": "duplicate", "ty": "Str", "required": true, "label": "Duplicate to remove" } ],
      "invokers": { "signed-in": true, "roles": ["crm__admin"] },
      "subject": { "object": "crm__contact", "input": "keep" },
      "conditions": [ { "id": "not_self", "expr": "text(record.$id) != param.duplicate", "error": "same-contact", "message": "A contact cannot be merged into itself." } ],
      "steps": [
        { "UpdateRecord": { "id": "keep_survivor", "object": "crm__contact", "record": "record.$id", "fields": { "merged_from": "param.duplicate" } } },
        { "DeleteRecord": { "id": "drop_duplicate", "object": "crm__contact", "record": "param.duplicate" } } ] },
    { "id": "crm__convert_lead", "label": "Convert a qualified lead to an account and a contact",
      "inputs": [ { "name": "lead", "ty": { "Ref": { "target": "crm__lead", "on-delete": "Restrict" } }, "required": true, "label": "The lead" } ],
      "invokers": { "signed-in": true, "roles": ["crm__rep_emea", "crm__rep_apac", "crm__rep_amer"] },
      "subject": { "object": "crm__lead", "input": "lead" },
      "conditions": [ { "id": "qualified_only", "expr": "record.status == 'qualified'", "error": "not-qualified", "message": "Only a qualified lead can be converted." } ],
      "steps": [
        { "CreateRecord": { "id": "new_account", "object": "crm__account", "fields": { "name": "record.company", "region": "'emea'" } } },
        { "CreateRecord": { "id": "new_contact", "object": "crm__contact", "fields": { "email": "record.contact_email", "lifecycle_stage": "'customer'", "territory": "'emea'" } } },
        { "UpdateRecord": { "id": "mark_converted", "object": "crm__lead", "record": "record.$id", "fields": { "status": "'converted'" } } } ] },
    {"id":"crm__save_contact","label":"Save a contact","inputs":[{"name":"first_name","ty":"Str","required":false,"label":"first name"},{"name":"last_name","ty":"Str","required":false,"label":"last name"},{"name":"email","ty":"Str","required":false,"label":"email"},{"name":"phone","ty":"Str","required":false,"label":"phone"},{"name":"mobile","ty":"Str","required":false,"label":"mobile"},{"name":"job_title","ty":"Str","required":false,"label":"job title"},{"name":"department","ty":"Str","required":false,"label":"department"},{"name":"company","ty":"Str","required":false,"label":"company"},{"name":"website","ty":"Str","required":false,"label":"website"},{"name":"street","ty":"Str","required":false,"label":"street"},{"name":"city","ty":"Str","required":false,"label":"city"},{"name":"region","ty":"Str","required":false,"label":"region"},{"name":"postal_code","ty":"Str","required":false,"label":"postal code"},{"name":"country","ty":"Str","required":false,"label":"country"},{"name":"preferred_language","ty":"Str","required":false,"label":"preferred language"},{"name":"time_zone","ty":"Str","required":false,"label":"time zone"},{"name":"lead_source","ty":"Str","required":false,"label":"lead source"},{"name":"lifecycle_stage","ty":"Str","required":false,"label":"lifecycle stage"},{"name":"owner_team","ty":"Str","required":false,"label":"owner team"},{"name":"territory","ty":"Str","required":false,"label":"territory"},{"name":"do_not_call","ty":"Bool","required":false,"label":"do not call"},{"name":"do_not_email","ty":"Bool","required":false,"label":"do not email"},{"name":"newsletter_opt_in","ty":"Bool","required":false,"label":"newsletter opt in"},{"name":"event_opt_in","ty":"Bool","required":false,"label":"event opt in"},{"name":"decision_maker","ty":"Bool","required":false,"label":"decision maker"},{"name":"budget_band","ty":"Str","required":false,"label":"budget band"},{"name":"industry","ty":"Str","required":false,"label":"industry"},{"name":"employee_count","ty":"Str","required":false,"label":"employee count"},{"name":"annual_revenue","ty":"Str","required":false,"label":"annual revenue"},{"name":"linkedin_url","ty":"Str","required":false,"label":"linkedin url"},{"name":"twitter_handle","ty":"Str","required":false,"label":"twitter handle"},{"name":"assistant_name","ty":"Str","required":false,"label":"assistant name"},{"name":"assistant_email","ty":"Str","required":false,"label":"assistant email"},{"name":"reports_to","ty":"Str","required":false,"label":"reports to"},{"name":"interests","ty":"Str","required":false,"label":"interests"},{"name":"pain_points","ty":"Str","required":false,"label":"pain points"},{"name":"notes","ty":"Str","required":false,"label":"notes"},{"name":"last_contact_summary","ty":"Str","required":false,"label":"last contact summary"},{"name":"next_step","ty":"Str","required":false,"label":"next step"},{"name":"next_step_date","ty":"Str","required":false,"label":"next step date"},{"name":"preferred_channel","ty":"Str","required":false,"label":"preferred channel"},{"name":"contact_window","ty":"Str","required":false,"label":"contact window"},{"name":"accessibility_notes","ty":"Str","required":false,"label":"accessibility notes"},{"name":"partner_referral","ty":"Str","required":false,"label":"partner referral"},{"name":"referral_code","ty":"Str","required":false,"label":"referral code"},{"name":"nps_band","ty":"Str","required":false,"label":"nps band"},{"name":"support_plan","ty":"Str","required":false,"label":"support plan"},{"name":"renewal_month","ty":"Str","required":false,"label":"renewal month"},{"name":"tags","ty":"Str","required":false,"label":"tags"},{"name":"external_reference","ty":"Str","required":false,"label":"external reference"}],"invokers":{"signed-in":true,"roles":[]},"conditions":[],"steps":[]},
    {"id":"crm__save_lead","label":"Save a lead","inputs":[{"name":"company","ty":"Str","required":false,"label":"company"},{"name":"contact_email","ty":"Str","required":false,"label":"contact email"},{"name":"source","ty":"Str","required":false,"label":"source"},{"name":"estimated_value","ty":"Str","required":false,"label":"estimated value"},{"name":"notes","ty":"Str","required":false,"label":"notes"}],"invokers":{"signed-in":true,"roles":[]},"conditions":[],"steps":[]},
    {"id":"crm__record_consent","label":"Record a consent","inputs":[{"name":"contact","ty":"Str","required":false,"label":"contact"},{"name":"purpose","ty":"Str","required":false,"label":"purpose"},{"name":"channel","ty":"Str","required":false,"label":"channel"},{"name":"granted","ty":"Bool","required":false,"label":"granted"},{"name":"note","ty":"Str","required":false,"label":"note"}],"invokers":{"signed-in":true,"roles":[]},"conditions":[],"steps":[]},
    {"id":"crm__request_merge","label":"Request a contact merge","inputs":[{"name":"keep","ty":"Str","required":false,"label":"keep"},{"name":"duplicate","ty":"Str","required":false,"label":"duplicate"},{"name":"reason","ty":"Str","required":false,"label":"reason"}],"invokers":{"signed-in":true,"roles":[]},"conditions":[],"steps":[]},
    {"id":"crm__qualify_lead","label":"Qualify a lead","inputs":[],"invokers":{"signed-in":true,"roles":[]},"conditions":[],"steps":[]}
  ],
  "eventKinds": [
    { "id": "crm__lead_qualified", "kind": "app.crm-lead-qualified",
      "fields": [ { "name": "lead", "type": "string" }, { "name": "qualified_at", "type": "timestamp" } ],
      "readers": ["crm__rep_emea", "crm__rep_apac", "crm__rep_amer"] }
  ]
}
