        { "name": "slot_35_default", "input": "slot_35_default", "label": "Slot 35 default value", "control": "text" },
        { "name": "slot_36_label", "input": "slot_36_label", "label": "Slot 36 label", "control": "text" },
        { "name": "slot_36_default", "input": "slot_36_default", "label": "Slot 36 default value", "control": "text" },
        { "name": "slot_37_label", "input": "slot_37_label", "label": "Slot 37 label", "control": "text" },
        { "name": "slot_37_default", "input": "slot_37_default", "label": "Slot 37 default value", "control": "text" },
