      "submitLabel": "Save draft", "onSuccess": { "toast": "Form saved." }, "onError": { "show": "inline" } },
    { "id": "forms__submission_form", "screen": "forms__respond_screen", "contract": "forms__submit_form",
      "fields": [
        { "name": "respondent_name", "input": "respondent_name", "label": "Your name", "control": "text", "normalize": "trim" },
        { "name": "respondent_email", "input": "respondent_email", "label": "Your email", "control": "text", "normalize": "trim" },
        { "name": "consent_given", "input": "consent_given", "label": "I agree to be contacted about this request", "control": "checkbox" },
        { "name": "q01_company_name", "input": "q01_company_name", "label": "Company name", "control": "text" },
        { "name": "q02_job_title", "input": "q02_job_title", "label": "Job title", "control": "text" },
        { "name": "q03_department", "input": "q03_department", "label": "Department", "control": "text" },
        { "name": "q04_team_size", "input": "q04_team_size", "label": "Team size", "control": "text" },
        { "name": "q05_regulated_sector", "input": "q05_regulated_sector", "label": "Works in a regulated sector", "control": "checkbox" },
        { "name": "q06_primary_country", "input": "q06_primary_country", "label": "Primary country", "control": "text" },
        { "name": "q07_region", "input": "q07_region", "label": "Region", "control": "text" },
        { "name": "q08_billing_entity", "input": "q08_billing_entity", "label": "Billing entity", "control": "text" },
        { "name": "q09_vat_number", "input": "q09_vat_number", "label": "VAT number", "control": "text" },
        { "name": "q10_industry_sector", "input": "q10_industry_sector", "label": "Industry sector", "control": "text" },
        { "name": "q11_annual_spend_band", "input": "q11_annual_spend_band", "label": "Annual spend band", "control": "text" },
        { "name": "q12_current_platform", "input": "q12_current_platform", "label": "Current platform", "control": "text" },
        { "name": "q13_implementation_timeline", "input": "q13_implementation_timeline", "label": "Implementation timeline", "control": "text" },
        { "name": "q14_pilot_needed", "input": "q14_pilot_needed", "label": "Pilot needed", "control": "checkbox" },
        { "name": "q15_use_case_summary", "input": "q15_use_case_summary", "label": "Use case summary", "control": "textarea" },
        { "name": "q16_pain_points", "input": "q16_pain_points", "label": "Current pain points", "control": "textarea" },
        { "name": "q17_integrations", "input": "q17_integrations", "label": "Integrations required", "control": "textarea" },
        { "name": "q18_data_residency", "input": "q18_data_residency", "label": "Data residency requirement", "control": "text" },
        { "name": "q19_security_questionnaire", "input": "q19_security_questionnaire", "label": "Security questionnaire attached", "control": "checkbox" },
        { "name": "q20_procurement_route", "input": "q20_procurement_route", "label": "Procurement route", "control": "text" },
        { "name": "q21_preferred_contact", "input": "q21_preferred_contact", "label": "Preferred contact method", "control": "text" },
        { "name": "q22_call_window", "input": "q22_call_window", "label": "Preferred call window", "control": "text" },
        { "name": "q23_accessibility_needs", "input": "q23_accessibility_needs", "label": "Accessibility needs", "control": "textarea" },
        { "name": "q24_event_dietary", "input": "q24_event_dietary", "label": "Dietary needs for event", "control": "textarea" },
        { "name": "q25_attending_in_person", "input": "q25_attending_in_person", "label": "Attending in person", "control": "checkbox" },
        { "name": "q26_badge_name", "input": "q26_badge_name", "label": "Badge name", "control": "text" },
        { "name": "q27_guest_count", "input": "q27_guest_count", "label": "Guest count", "control": "text" },
        { "name": "q28_session_interest_1", "input": "q28_session_interest_1", "label": "Session interest 1", "control": "text" },
        { "name": "q29_session_interest_2", "input": "q29_session_interest_2", "label": "Session interest 2", "control": "text" },
        { "name": "q30_session_interest_3", "input": "q30_session_interest_3", "label": "Session interest 3", "control": "text" },
        { "name": "q31_previous_attendee", "input": "q31_previous_attendee", "label": "Previous attendee", "control": "checkbox" },
        { "name": "q32_referral_source", "input": "q32_referral_source", "label": "Referral source", "control": "text" },
        { "name": "q33_campaign_code", "input": "q33_campaign_code", "label": "Campaign code", "control": "text" },
        { "name": "q34_newsletter_optin", "input": "q34_newsletter_optin", "label": "Accept newsletter", "control": "checkbox" },
        { "name": "q35_newsletter_topics", "input": "q35_newsletter_topics", "label": "Newsletter topics", "control": "textarea" },
        { "name": "q36_language", "input": "q36_language", "label": "Language", "control": "text" },
        { "name": "q37_time_zone", "input": "q37_time_zone", "label": "Time zone", "control": "text" },
        { "name": "q38_support_tier", "input": "q38_support_tier", "label": "Support tier", "control": "text" },
        { "name": "q39_open_tickets", "input": "q39_open_tickets", "label": "Open tickets", "control": "text" },
        { "name": "q40_incident_contact", "input": "q40_incident_contact", "label": "Incident contact", "control": "text" },
        { "name": "q41_escalation_notes", "input": "q41_escalation_notes", "label": "Escalation notes", "control": "textarea" },
        { "name": "q42_warranty_period", "input": "q42_warranty_period", "label": "Warranty period", "control": "text" },
        { "name": "q43_serial_number", "input": "q43_serial_number", "label": "Serial number", "control": "text" },
        { "name": "q44_install_address", "input": "q44_install_address", "label": "Installation address", "control": "text" },
        { "name": "q45_install_postcode", "input": "q45_install_postcode", "label": "Installation postcode", "control": "text" },
        { "name": "q46_access_instructions", "input": "q46_access_instructions", "label": "Access instructions", "control": "textarea" },
        { "name": "q47_parking_needed", "input": "q47_parking_needed", "label": "Parking needed", "control": "checkbox" },
        { "name": "q48_delivery_notes", "input": "q48_delivery_notes", "label": "Delivery notes", "control": "textarea" },
        { "name": "q49_delivery_window", "input": "q49_delivery_window", "label": "Preferred delivery window", "control": "text" },
        { "name": "q50_gift_message", "input": "q50_gift_message", "label": "Gift message", "control": "textarea" },
        { "name": "q51_order_reference", "input": "q51_order_reference", "label": "Order reference", "control": "text" },
        { "name": "q52_invoice_reference", "input": "q52_invoice_reference", "label": "Invoice reference", "control": "text" },
        { "name": "q53_payment_terms", "input": "q53_payment_terms", "label": "Payment terms", "control": "text" },
        { "name": "q54_additional_comments", "input": "q54_additional_comments", "label": "Additional comments", "control": "textarea" },
        { "name": "q55_status_page_subscribe", "input": "q55_status_page_subscribe", "label": "Subscribe to status page", "control": "checkbox" },
        { "name": "q56_notify_changes", "input": "q56_notify_changes", "label": "Notify on changes", "control": "checkbox" },
        { "name": "q57_anything_else", "input": "q57_anything_else", "label": "Anything else we should know", "control": "textarea" } ],
      "submitLabel": "Send", "onSuccess": { "navigate": { "screen": "forms__submission_list" }, "toast": "Thank you. Your response was received." }, "onError": { "show": "inline" } },
    { "id": "forms__consent_form", "screen": "forms__respond_screen", "contract": "forms__record_consent",
      "fields": [
        { "name": "submission", "input": "submission", "label": "Submission reference", "control": "text" },
        { "name": "purpose", "input": "purpose", "label": "Purpose", "control": "text" },
        { "name": "granted", "input": "granted", "label": "Consent granted", "control": "checkbox" } ],
      "submitLabel": "Record consent", "onSuccess": { "toast": "Consent recorded." }, "onError": { "show": "inline" } },
    { "id": "forms__partner_webhook_form", "screen": "forms__builder_screen", "contract": "forms__manage_webhook_subscription",
      "fields": [
        { "name": "endpoint", "input": "endpoint", "label": "Endpoint name", "control": "text" },
        { "name": "target_url", "input": "target_url", "label": "Target address", "control": "text", "normalize": "trim" },
        { "name": "enabled", "input": "enabled", "label": "Enabled", "control": "checkbox" },
        { "name": "secret_hint", "input": "secret_hint", "label": "Secret hint", "control": "text" } ],
      "submitLabel": "Save subscription", "onSuccess": { "toast": "Subscription saved." }, "onError": { "show": "inline" } }
  ],
  "actions": [
    { "id": "forms__action_save_builder", "screen": "forms__builder_screen", "label": "Save draft", "contract": "forms__save_form_builder", "form": "forms__form_builder", "arguments": { "name": "form.form_name", "description": "form.form_description" }, "onSuccess": { "toast": "Draft saved." }, "onError": { "show": "inline" } },
    { "id": "forms__action_publish", "screen": "forms__definition_list", "label": "Publish", "contract": "forms__publish_form_definition", "onSuccess": { "toast": "Published." }, "onError": { "show": "toast" } },
    { "id": "forms__action_submit_response", "screen": "forms__respond_screen", "label": "Send", "contract": "forms__submit_form", "form": "forms__submission_form", "arguments": { "respondent_name": "form.respondent_name", "respondent_email": "form.respondent_email", "consent_given": "form.consent_given" }, "onSuccess": { "toast": "Response sent." }, "onError": { "show": "inline" } }
  ],
  "liveBindings": [
    { "id": "forms__live_definition_list", "screen": "forms__definition_list", "event": "ui-notice-received", "refresh": "whole", "when": { "any": ["event.kind == 'membership'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "forms__live_definition_list_ended", "screen": "forms__definition_list", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "forms__live_builder", "screen": "forms__builder_screen", "event": "ui-notice-received", "refresh": "whole", "when": { "any": ["event.kind == 'membership'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "forms__live_builder_ended", "screen": "forms__builder_screen", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "forms__live_respond", "screen": "forms__respond_screen", "event": "ui-notice-received", "refresh": "whole", "when": { "any": ["event.kind == 'membership'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "forms__live_respond_ended", "screen": "forms__respond_screen", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "forms__live_submission_list", "screen": "forms__submission_list", "event": "ui-notice-received", "refresh": "whole", "when": { "any": ["event.kind == 'membership'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "forms__live_submission_list_ended", "screen": "forms__submission_list", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "forms__live_submission_detail", "screen": "forms__submission_detail", "event": "ui-notice-received", "refresh": "whole", "when": { "any": ["event.kind == 'membership'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "forms__live_submission_detail_ended", "screen": "forms__submission_detail", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "forms__live_consent_log", "screen": "forms__consent_log", "event": "ui-notice-received", "refresh": "whole", "when": { "any": ["event.kind == 'membership'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "forms__live_consent_log_ended", "screen": "forms__consent_log", "event": "ui-session-ended", "refresh": "whole" }
  ],
  "errorMessages": [
    { "id": "forms__error_slug_taken", "on": "check", "kinds": ["unique"], "text": "Another form already uses this slug.", "field": "slug" },
    { "id": "forms__error_not_editable", "on": "error", "kinds": ["workflow"], "text": "This form is published and can no longer be edited. Create a new version." }
  ],
  "events": [
    { "id": "forms__submission_received_event", "name": "Submission received", "description": "A respondent sent a form submission.", "payload": [ { "name": "definition", "type": "string" }, { "name": "submitted_at", "type": "timestamp" } ] },
    { "id": "forms__form_published_event", "name": "Form published", "description": "A form definition went live.", "payload": [ { "name": "definition", "type": "string" } ] },
    { "id": "forms__form_retired_event", "name": "Form retired", "description": "A form definition was taken out of use.", "payload": [ { "name": "definition", "type": "string" } ] }
  ],
  "contracts": [
    { "id": "forms__read_definitions", "name": "Read the form definitions", "realisation": "facade",
      "auth": { "scheme": "session", "description": "A signed-in form owner", "requires": ["forms__build"] },
      "idempotent": true, "timeoutMs": 2000, "inputs": [ { "name": "status", "type": "string" } ], "outputs": [ { "name": "view", "type": "json" } ],
      "postconditions": ["The answer is the list of form definitions with the status named."],
      "errors": [ { "name": "unauthenticated", "condition": "No valid session accompanies the request.", "type": "api-error", "kind": "unauthenticated" } ] },
    { "id": "forms__read_builder", "name": "Read the form builder", "realisation": "facade",
      "auth": { "scheme": "session", "description": "A signed-in form owner", "requires": ["forms__build"] },
      "idempotent": true, "timeoutMs": 2000, "inputs": [ { "name": "slug", "type": "string" } ], "outputs": [ { "name": "view", "type": "json" } ],
      "postconditions": ["The answer is the draft form and its field settings."],
      "errors": [ { "name": "unauthenticated", "condition": "No valid session accompanies the request.", "type": "api-error", "kind": "unauthenticated" } ] },
    { "id": "forms__read_respondent_form", "name": "Read a form for a respondent", "realisation": "facade",
      "auth": { "scheme": "session", "description": "A signed-in respondent", "requires": ["form-submit"] },
      "idempotent": true, "timeoutMs": 2000, "inputs": [ { "name": "slug", "type": "string" } ], "outputs": [ { "name": "view", "type": "json" } ],
      "postconditions": ["The answer is the published form the respondent asked for."],
      "errors": [ { "name": "unauthenticated", "condition": "No valid session accompanies the request.", "type": "api-error", "kind": "unauthenticated" } ] },
    { "id": "forms__read_submission_board", "name": "Read the submission board", "realisation": "facade",
      "auth": { "scheme": "session", "description": "A signed-in compliance reviewer", "requires": ["forms__review"] },
      "idempotent": true, "timeoutMs": 2000, "inputs": [ { "name": "definition", "type": "string" } ], "outputs": [ { "name": "view", "type": "json" } ],
      "postconditions": ["The answer is the submissions of the definition named, newest first."],
      "errors": [ { "name": "unauthenticated", "condition": "No valid session accompanies the request.", "type": "api-error", "kind": "unauthenticated" } ] },
    { "id": "forms__read_consent_log", "name": "Read the consent log", "realisation": "facade",
      "auth": { "scheme": "session", "description": "A signed-in compliance reviewer", "requires": ["forms__review"] },
      "idempotent": true, "timeoutMs": 2000, "inputs": [ { "name": "purpose", "type": "string" } ], "outputs": [ { "name": "view", "type": "json" } ],
      "postconditions": ["The answer is the consent captures for the purpose named."],
      "errors": [ { "name": "unauthenticated", "condition": "No valid session accompanies the request.", "type": "api-error", "kind": "unauthenticated" } ] },
    { "id": "forms__save_form_builder", "name": "Save a form draft", "realisation": "facade",
      "auth": { "scheme": "session", "description": "A signed-in form owner", "requires": ["forms__build"] },
      "idempotent": false, "timeoutMs": 3000, "inputs": [ { "name": "name", "type": "string" }, { "name": "description", "type": "string" } ], "outputs": [ { "name": "definition", "type": "u64" } ],
      "postconditions": ["The draft form definition holds the name and description given."],
      "errors": [ { "name": "unauthenticated", "condition": "No valid session accompanies the request.", "type": "api-error", "kind": "unauthenticated" } ] },
    { "id": "forms__publish_form_definition", "name": "Publish a form definition", "realisation": "facade",
      "auth": { "scheme": "session", "description": "A signed-in form owner", "requires": ["forms__publish"] },
      "idempotent": true, "timeoutMs": 3000, "inputs": [], "outputs": [ { "name": "definition", "type": "u64" } ],
      "postconditions": ["The selected draft form is published and its version is recorded."],
      "errors": [ { "name": "unauthenticated", "condition": "No valid session accompanies the request.", "type": "api-error", "kind": "unauthenticated" } ] },
    { "id": "forms__submit_form", "name": "Submit a form response", "realisation": "facade",
      "auth": { "scheme": "session", "description": "A signed-in respondent", "requires": ["form-submit"] },
      "idempotent": false, "timeoutMs": 5000,
      "inputs": [ { "name": "respondent_name", "type": "string" }, { "name": "respondent_email", "type": "string" }, { "name": "consent_given", "type": "bool" } ],
      "outputs": [ { "name": "submission", "type": "u64" } ],
      "postconditions": ["The submission is stored against the published form version."],
      "errors": [ { "name": "unauthenticated", "condition": "No valid session accompanies the request.", "type": "api-error", "kind": "unauthenticated" } ] },
    { "id": "forms__receive_partner_webhook", "name": "Receive a partner webhook", "realisation": "facade",
      "auth": { "scheme": "session", "description": "A partner request signed with the webhook secret", "requires": ["webhook-receive"] },
      "idempotent": true, "timeoutMs": 3000, "inputs": [ { "name": "payload", "type": "json" } ], "outputs": [ { "name": "accepted", "type": "bool" } ],
      "postconditions": ["A signed partner payload is recorded and acknowledged."],
      "errors": [ { "name": "unauthenticated", "condition": "No valid session accompanies the request.", "type": "api-error", "kind": "unauthenticated" } ] },
    { "id": "forms__manage_webhook_subscription", "name": "Manage a webhook subscription", "realisation": "facade",
      "auth": { "scheme": "session", "description": "A signed-in form owner", "requires": ["webhooks-manage"] },
      "idempotent": true, "timeoutMs": 3000,
      "inputs": [ { "name": "endpoint", "type": "string" }, { "name": "target_url", "type": "string" }, { "name": "enabled", "type": "bool" } ],
      "outputs": [ { "name": "subscription", "type": "u64" } ],
      "postconditions": ["The subscription points at the target address given and is enabled as asked."],
      "errors": [ { "name": "unauthenticated", "condition": "No valid session accompanies the request.", "type": "api-error", "kind": "unauthenticated" } ] },
    { "id": "forms__record_consent", "name": "Record a consent capture", "realisation": "facade",
      "auth": { "scheme": "session", "description": "A signed-in respondent", "requires": ["consent-record"] },
      "idempotent": false, "timeoutMs": 3000,
      "inputs": [ { "name": "submission", "type": "string" }, { "name": "purpose", "type": "string" }, { "name": "granted", "type": "bool" } ],
      "outputs": [ { "name": "consent", "type": "u64" } ],
      "postconditions": ["A consent capture is stored with the time it was given."],
      "errors": [ { "name": "unauthenticated", "condition": "No valid session accompanies the request.", "type": "api-error", "kind": "unauthenticated" } ] }
  ],
  "roles": [
    { "id": "forms__form_owner", "name": "Form owner", "description": "Builds, publishes and retires forms for a team.", "level": "tenant",
      "holders": ["person", "team"], "capabilities": ["forms__build", "forms__publish", "webhooks-manage"] },
    { "id": "forms__compliance_reviewer", "name": "Compliance reviewer", "description": "Reads submissions, consent captures and attachments.", "level": "tenant",
      "holders": ["person", "team"], "capabilities": ["forms__review", "consent-record"] },
    { "id": "forms__respondent", "name": "Respondent", "description": "Completes and sends a published form.", "level": "tenant",
      "holders": ["person"], "capabilities": ["form-submit"] }
  ],
  "claims": [
    { "id": "forms__submission-retention-follows-consent", "kind": "structural",
      "statement": "A submission with a consent capture SHALL NOT be removed before the consent capture is removed.",
      "subjects": ["product-module"],
      "rationale": "Consent evidence must outlive the answers it covers.",
      "evaluate": { "method": "external-evidence" } },
    { "id": "forms__published-form-is-versioned", "kind": "structural",
      "statement": "A published form definition SHALL NOT change its fields without a new form version.",
      "subjects": ["product-module"],
      "rationale": "Submissions refer to the version they were answered against.",
      "evaluate": { "method": "external-evidence" } }
  ],
  "capabilities": [
    { "id": "forms__build", "name": "Build forms", "description": "Create and edit draft form definitions." },
    { "id": "forms__publish", "name": "Publish forms", "description": "Make a form definition live for respondents." },
    { "id": "forms__review", "name": "Review submissions", "description": "Read submissions, consent captures and attachments." }
  ],
  "objects": [
    { "id": "forms__form_definition", "label": "Form definition",
      "fields": {
        "name": { "id": "name", "label": "Name", "ty": "Str", "required": true, "unique": false },
        "slug": { "id": "slug", "label": "Slug", "ty": "Str", "required": true, "unique": true },
        "status": { "id": "status", "label": "Status", "ty": "Str", "required": true, "unique": false },
        "owner_team": { "id": "owner_team", "label": "Owner team", "ty": "Str", "required": false, "unique": false },
        "published_at": { "id": "published_at", "label": "Published", "ty": "Time", "required": false, "unique": false },
        "retired_at": { "id": "retired_at", "label": "Retired", "ty": "Time", "required": false, "unique": false } },
      "constraints": {},
      "retention": { "days": 2555, "from": "Created" } },
    { "id": "forms__form_submission", "label": "Form submission",
      "fields": {
        "definition": { "id": "definition", "label": "Form", "ty": { "Ref": { "target": "forms__form_definition", "on-delete": "Restrict" } }, "required": true, "unique": false },
        "channel": { "id": "channel", "label": "Channel", "ty": "Str", "required": false, "unique": false },
        "submitted_at": { "id": "submitted_at", "label": "Submitted", "ty": "Time", "required": true, "unique": false },
        "respondent_name": { "id": "respondent_name", "label": "Respondent name", "ty": "Str", "required": false, "unique": false,
          "personal": { "kind": "name", "subject": { "Field": { "field": "respondent_name" } }, "searchable": false } },
        "respondent_email": { "id": "respondent_email", "label": "Respondent email", "ty": "Str", "required": false, "unique": false,
          "personal": { "kind": "email-address", "subject": { "Field": { "field": "respondent_email" } }, "searchable": false } },
        "consent_given": { "id": "consent_given", "label": "Consent given", "ty": "Bool", "required": true, "unique": false },
        "q01_company_name": { "id": "q01_company_name", "label": "Company name", "ty": "Str", "required": false, "unique": false },
        "q02_job_title": { "id": "q02_job_title", "label": "Job title", "ty": "Str", "required": false, "unique": false },
        "q03_department": { "id": "q03_department", "label": "Department", "ty": "Str", "required": false, "unique": false },
        "q04_team_size": { "id": "q04_team_size", "label": "Team size", "ty": "Str", "required": false, "unique": false },
        "q05_regulated_sector": { "id": "q05_regulated_sector", "label": "Works in a regulated sector", "ty": "Bool", "required": false, "unique": false },
        "q06_primary_country": { "id": "q06_primary_country", "label": "Primary country", "ty": "Str", "required": false, "unique": false },
        "q07_region": { "id": "q07_region", "label": "Region", "ty": "Str", "required": false, "unique": false },
        "q08_billing_entity": { "id": "q08_billing_entity", "label": "Billing entity", "ty": "Str", "required": false, "unique": false },
        "q09_vat_number": { "id": "q09_vat_number", "label": "VAT number", "ty": "Str", "required": false, "unique": false },
        "q10_industry_sector": { "id": "q10_industry_sector", "label": "Industry sector", "ty": "Str", "required": false, "unique": false },
        "q11_annual_spend_band": { "id": "q11_annual_spend_band", "label": "Annual spend band", "ty": "Str", "required": false, "unique": false },
        "q12_current_platform": { "id": "q12_current_platform", "label": "Current platform", "ty": "Str", "required": false, "unique": false },
        "q13_implementation_timeline": { "id": "q13_implementation_timeline", "label": "Implementation timeline", "ty": "Str", "required": false, "unique": false },
        "q14_pilot_needed": { "id": "q14_pilot_needed", "label": "Pilot needed", "ty": "Bool", "required": false, "unique": false },
        "q15_use_case_summary": { "id": "q15_use_case_summary", "label": "Use case summary", "ty": "Str", "required": false, "unique": false },
        "q16_pain_points": { "id": "q16_pain_points", "label": "Current pain points", "ty": "Str", "required": false, "unique": false },
        "q17_integrations": { "id": "q17_integrations", "label": "Integrations required", "ty": "Str", "required": false, "unique": false },
        "q18_data_residency": { "id": "q18_data_residency", "label": "Data residency requirement", "ty": "Str", "required": false, "unique": false },
        "q19_security_questionnaire": { "id": "q19_security_questionnaire", "label": "Security questionnaire attached", "ty": "Bool", "required": false, "unique": false },
        "q20_procurement_route": { "id": "q20_procurement_route", "label": "Procurement route", "ty": "Str", "required": false, "unique": false },
        "q21_preferred_contact": { "id": "q21_preferred_contact", "label": "Preferred contact method", "ty": "Str", "required": false, "unique": false },
        "q22_call_window": { "id": "q22_call_window", "label": "Preferred call window", "ty": "Str", "required": false, "unique": false },
        "q23_accessibility_needs": { "id": "q23_accessibility_needs", "label": "Accessibility needs", "ty": "Str", "required": false, "unique": false },
        "q24_event_dietary": { "id": "q24_event_dietary", "label": "Dietary needs for event", "ty": "Str", "required": false, "unique": false },
        "q25_attending_in_person": { "id": "q25_attending_in_person", "label": "Attending in person", "ty": "Bool", "required": false, "unique": false },
        "q26_badge_name": { "id": "q26_badge_name", "label": "Badge name", "ty": "Str", "required": false, "unique": false },
        "q27_guest_count": { "id": "q27_guest_count", "label": "Guest count", "ty": "Str", "required": false, "unique": false },
        "q28_session_interest_1": { "id": "q28_session_interest_1", "label": "Session interest 1", "ty": "Str", "required": false, "unique": false },
        "q29_session_interest_2": { "id": "q29_session_interest_2", "label": "Session interest 2", "ty": "Str", "required": false, "unique": false },
        "q30_session_interest_3": { "id": "q30_session_interest_3", "label": "Session interest 3", "ty": "Str", "required": false, "unique": false },
        "q31_previous_attendee": { "id": "q31_previous_attendee", "label": "Previous attendee", "ty": "Bool", "required": false, "unique": false },
        "q32_referral_source": { "id": "q32_referral_source", "label": "Referral source", "ty": "Str", "required": false, "unique": false },
        "q33_campaign_code": { "id": "q33_campaign_code", "label": "Campaign code", "ty": "Str", "required": false, "unique": false },
        "q34_newsletter_optin": { "id": "q34_newsletter_optin", "label": "Accept newsletter", "ty": "Bool", "required": false, "unique": false },
        "q35_newsletter_topics": { "id": "q35_newsletter_topics", "label": "Newsletter topics", "ty": "Str", "required": false, "unique": false },
        "q36_language": { "id": "q36_language", "label": "Language", "ty": "Str", "required": false, "unique": false },
        "q37_time_zone": { "id": "q37_time_zone", "label": "Time zone", "ty": "Str", "required": false, "unique": false },
        "q38_support_tier": { "id": "q38_support_tier", "label": "Support tier", "ty": "Str", "required": false, "unique": false },
        "q39_open_tickets": { "id": "q39_open_tickets", "label": "Open tickets", "ty": "Str", "required": false, "unique": false },
        "q40_incident_contact": { "id": "q40_incident_contact", "label": "Incident contact", "ty": "Str", "required": false, "unique": false },
        "q41_escalation_notes": { "id": "q41_escalation_notes", "label": "Escalation notes", "ty": "Str", "required": false, "unique": false },
        "q42_warranty_period": { "id": "q42_warranty_period", "label": "Warranty period", "ty": "Str", "required": false, "unique": false },
        "q43_serial_number": { "id": "q43_serial_number", "label": "Serial number", "ty": "Str", "required": false, "unique": false },
        "q44_install_address": { "id": "q44_install_address", "label": "Installation address", "ty": "Str", "required": false, "unique": false },
        "q45_install_postcode": { "id": "q45_install_postcode", "label": "Installation postcode", "ty": "Str", "required": false, "unique": false },
        "q46_access_instructions": { "id": "q46_access_instructions", "label": "Access instructions", "ty": "Str", "required": false, "unique": false },
        "q47_parking_needed": { "id": "q47_parking_needed", "label": "Parking needed", "ty": "Bool", "required": false, "unique": false },
        "q48_delivery_notes": { "id": "q48_delivery_notes", "label": "Delivery notes", "ty": "Str", "required": false, "unique": false },
        "q49_delivery_window": { "id": "q49_delivery_window", "label": "Preferred delivery window", "ty": "Str", "required": false, "unique": false },
        "q50_gift_message": { "id": "q50_gift_message", "label": "Gift message", "ty": "Str", "required": false, "unique": false },
        "q51_order_reference": { "id": "q51_order_reference", "label": "Order reference", "ty": "Str", "required": false, "unique": false },
        "q52_invoice_reference": { "id": "q52_invoice_reference", "label": "Invoice reference", "ty": "Str", "required": false, "unique": false },
        "q53_payment_terms": { "id": "q53_payment_terms", "label": "Payment terms", "ty": "Str", "required": false, "unique": false },
        "q54_additional_comments": { "id": "q54_additional_comments", "label": "Additional comments", "ty": "Str", "required": false, "unique": false } },
      "constraints": {},
      "retention": { "days": 730, "from": "Created" } },
    { "id": "forms__consent_capture", "label": "Consent capture",
      "fields": {
        "submission": { "id": "submission", "label": "Submission", "ty": { "Ref": { "target": "forms__form_submission", "on-delete": "Restrict" } }, "required": true, "unique": false },
        "purpose": { "id": "purpose", "label": "Purpose", "ty": "Str", "required": true, "unique": false },
        "granted": { "id": "granted", "label": "Granted", "ty": "Bool", "required": true, "unique": false },
        "captured_at": { "id": "captured_at", "label": "Captured", "ty": "Time", "required": true, "unique": false },
        "subject_email": { "id": "subject_email", "label": "Subject email", "ty": "Str", "required": false, "unique": false,
          "personal": { "kind": "email-address", "subject": { "Field": { "field": "subject_email" } }, "searchable": false } } },
      "constraints": {},
      "retention": { "days": 1095, "from": "Created" } },
    { "id": "forms__attachment", "label": "Attachment",
      "fields": {
        "label": { "id": "label", "label": "Label", "ty": "Str", "required": false, "unique": false },
        "file": { "id": "file", "label": "File", "ty": { "File": { "media-types": ["application/pdf", "image/png", "image/jpeg"], "max-bytes": 20971520, "renditions": [] } }, "required": true, "unique": false },
        "submission": { "id": "submission", "label": "Submission", "ty": { "Ref": { "target": "forms__form_submission", "on-delete": "Restrict" } }, "required": true, "unique": false },
        "scan_state": { "id": "scan_state", "label": "Scan state", "ty": "Str", "required": false, "unique": false },
        "uploaded_at": { "id": "uploaded_at", "label": "Uploaded", "ty": "Time", "required": true, "unique": false } },
      "constraints": {},
      "retention": { "days": 365, "from": "Created" } },
    { "id": "forms__webhook_subscription", "label": "Webhook subscription",
      "fields": {
        "name": { "id": "name", "label": "Name", "ty": "Str", "required": true, "unique": true },
        "endpoint": { "id": "endpoint", "label": "Endpoint", "ty": "Str", "required": true, "unique": false },
        "target_url": { "id": "target_url", "label": "Target address", "ty": "Str", "required": true, "unique": false },
        "enabled": { "id": "enabled", "label": "Enabled", "ty": "Bool", "required": true, "unique": false },
        "secret_hint": { "id": "secret_hint", "label": "Secret hint", "ty": "Str", "required": false, "unique": false },
        "last_delivery": { "id": "last_delivery", "label": "Last delivery", "ty": "Str", "required": false, "unique": false } },
      "constraints": {},
      "retention": { "days": 365, "from": "Created" } }
  ],
  "policies": [
    { "id": "forms__owner_definitions", "role": "forms__form_owner", "resource": { "Object": "forms__form_definition" }, "actions": ["Create", "Read", "Update"] },
    { "id": "forms__owner_submissions", "role": "forms__form_owner", "resource": { "Object": "forms__form_submission" }, "actions": ["Read"] },
    { "id": "forms__member_own_submissions", "role": "member", "resource": { "Object": "forms__form_submission" }, "actions": ["Read"], "condition": "record.respondent_email == principal" },
    { "id": "forms__review_consent", "role": "forms__compliance_reviewer", "resource": { "Object": "forms__consent_capture" }, "actions": ["Read"] },
    { "id": "forms__review_attachments", "role": "forms__compliance_reviewer", "resource": { "Object": "forms__attachment" }, "actions": ["Read", "Delete"] }
  ],
  "queries": [
    { "id": "forms__published_forms", "object": "forms__form_definition", "filter": "record.status == 'published'", "params": [], "order": [ { "field": "name", "descending": false } ], "limit": 50 },
    { "id": "forms__submissions_for_definition", "object": "forms__form_submission", "filter": "record.definition == param.definition", "params": ["definition"], "order": [ { "field": "submitted_at", "descending": true } ], "limit": 200 }
  ],
  "views": [
    { "id": "forms__definition_board", "route": "/forms/board", "title": "Published forms",
      "sections": { "main": { "query": "forms__published_forms", "args": {}, "include": [], "markdown": [], "single": false } } }
  ],
  "workflows": [
    { "id": "forms__form_lifecycle", "object": "forms__form_definition", "field": "status", "initial": ["draft"],
      "transitions": [
        { "name": "publish", "from": "draft", "to": "published", "guard": "old.status == 'draft'", "set": { "published_at": "now" } },
        { "name": "retire", "from": "published", "to": "retired", "guard": "old.status == 'published'", "set": { "retired_at": "now" } } ] }
  ],
  "settings": [
    { "id": "forms__default_retention_days", "label": "Default retention for submissions", "type": "i64", "default": {"Int": 730}, "levels": ["tenant"] },
    { "id": "forms__default_locale", "label": "Default locale", "type": "string", "default": {"Str": "en-GB"}, "levels": ["tenant", "team"] }
  ],
  "mailTemplates": [
    { "id": "forms__submission_mail", "subject": "We received your response",
      "body": "[{\"type\":\"paragraph\",\"inlines\":[{\"type\":\"text\",\"text\":\"Thank you. We received your response and will be in touch.\"}]}]" }
  ],
  "noticeTemplates": [
    { "id": "forms__submission_notice", "title": "New form submission",
      "body": "[{\"type\":\"paragraph\",\"inlines\":[{\"type\":\"text\",\"text\":\"A new response was received for one of your forms.\"}]}]" }
  ],
  "triggers": [
    { "id": "forms__on_submission", "on": { "RecordCreated": { "object": "forms__form_submission" } }, "automation": "forms__submission_pipeline" },
    { "id": "forms__on_partner_webhook", "on": { "InboundWebhook": { "endpoint": "form-partner" } }, "automation": "forms__submission_pipeline" }
  ],
  "automations": [
    { "id": "forms__submission_pipeline", "label": "Tell the form owner, notify the partner webhook and confirm to the respondent",
      "run-as": { "roles": ["forms__form_owner"] }, "run-key": "param.owner",
      "start": "notify",
      "steps": {
        "notify": { "action": { "CreateNotice": { "template": "forms__submission_notice", "to": "param.owner", "record": "param.record" } }, "next": "hook", "retry": { "attempts": 3 } },
        "hook": { "action": { "CallWebhook": { "subscription": "7a2d3b4c-4e5f-4a6b-9c7d-1e2f3a4b5c62", "body": { "submission": "param.record", "event": "'form.submitted'" } } }, "next": "mail", "timeout": 15000 },
        "mail": { "action": { "SendMail": { "template": "forms__submission_mail", "to": "param.owner", "category": "transactional" } }, "next": "done", "timeout": 30000 },
        "done": { "action": "End" } } }
  ],
  "operations": [
    { "id": "forms__publish_form", "label": "Publish a form definition",
      "inputs": [ { "name": "definition", "ty": "Str", "required": true, "label": "The form definition" } ],
      "invokers": { "signed-in": true, "roles": ["forms__form_owner"] },
      "subject": { "object": "forms__form_definition", "input": "definition" },
      "conditions": [ { "id": "is_draft", "expr": "record.status == 'draft'", "error": "not-draft", "message": "Only a draft form can be published." } ],
      "steps": [
        { "UpdateRecord": { "id": "set_published", "object": "forms__form_definition", "record": "record.$id", "fields": { "status": "'published'", "published_at": "now" } } } ] },
    { "id": "forms__retire_form", "label": "Retire a published form",
      "inputs": [ { "name": "definition", "ty": "Str", "required": true, "label": "The form definition" } ],
      "invokers": { "signed-in": true, "roles": ["forms__form_owner"] },
      "subject": { "object": "forms__form_definition", "input": "definition" },
      "conditions": [ { "id": "is_published", "expr": "record.status == 'published'", "error": "not-published", "message": "Only a published form can be retired." } ],
      "steps": [
        { "UpdateRecord": { "id": "set_retired", "object": "forms__form_definition", "record": "record.$id", "fields": { "status": "'retired'", "retired_at": "now" } } } ] }
  ],
  "eventKinds": [
    { "id": "forms__submission_received", "kind": "app.forms-submission-received",
      "fields": [ { "name": "definition", "type": "string" }, { "name": "submitted_at", "type": "timestamp" }, { "name": "channel", "type": "string" } ],
      "readers": ["forms__form_owner"] }
  ]
}
