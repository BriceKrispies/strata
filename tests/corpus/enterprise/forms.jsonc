{
  // Form builder for definitions, versions, submissions, consent captures, attachments and webhook subscriptions; depends on the platform form, consent and webhook capabilities.
  "product": {
    "id": "forms",
    "name": "Forms",
    "description": "Form builder for collecting submissions, consent and attachments.",
    "version": "1.0.0",
    "platform": { "min": "0.2" },
    "imports": {
      "spec": "../../../specifications/spec.jsonc",
      "entities": ["product-module", "ui-notice-received", "ui-session-ended", "api-error", "form-submit", "consent-record", "webhook-receive", "webhooks-manage"]
    }
  },
  "records": [
    { "id": "forms__form_definition_rec", "name": "Form definition", "owner": "product-module", "key": ["id"],
      "fields": [
        { "name": "id", "type": "u64" },
        { "name": "name", "type": "string" },
        { "name": "slug", "type": "string" },
        { "name": "status", "type": "forms__form_status" },
        { "name": "owner_team", "type": "string" },
        { "name": "current_version", "type": "u64", "refersTo": "forms__form_version_rec", "onDelete": "set-null", "optional": true },
        { "name": "published_at", "type": "timestamp", "optional": true } ],
      "retention": "Kept for the life of the tenant; retired definitions are archived, not deleted.",
      "schemaVersion": 1, "realisation": "target" },
    { "id": "forms__form_version_rec", "name": "Form version", "owner": "product-module", "key": ["id"],
      "fields": [
        { "name": "id", "type": "u64" },
        { "name": "definition", "type": "u64", "refersTo": "forms__form_definition_rec", "onDelete": "restrict" },
        { "name": "version_number", "type": "u32" },
        { "name": "schema", "type": "json" },
        { "name": "published_at", "type": "timestamp", "optional": true } ],
      "retention": "Kept while any submission refers to the version.",
      "schemaVersion": 1, "realisation": "target" },
    { "id": "forms__form_submission_rec", "name": "Form submission", "owner": "product-module", "key": ["id"],
      "fields": [
        { "name": "id", "type": "u64" },
        { "name": "form_version", "type": "u64", "refersTo": "forms__form_version_rec", "onDelete": "restrict" },
        { "name": "submitted_at", "type": "timestamp" },
        { "name": "respondent_name", "type": "string", "personal": "name" },
        { "name": "respondent_email", "type": "string", "personal": "contact" },
        { "name": "consent_given", "type": "bool" },
        { "name": "q01_company_name", "type": "string" },
        { "name": "q02_job_title", "type": "string" },
        { "name": "q03_department", "type": "string" },
        { "name": "q04_team_size", "type": "string" },
        { "name": "q05_regulated_sector", "type": "bool" },
        { "name": "q06_primary_country", "type": "string" },
        { "name": "q07_region", "type": "string" },
        { "name": "q08_billing_entity", "type": "string" },
        { "name": "q09_vat_number", "type": "string" },
        { "name": "q10_industry_sector", "type": "string" },
        { "name": "q11_annual_spend_band", "type": "string" },
        { "name": "q12_current_platform", "type": "string" },
        { "name": "q13_implementation_timeline", "type": "string" },
        { "name": "q14_pilot_needed", "type": "bool" },
        { "name": "q15_use_case_summary", "type": "string" },
        { "name": "q16_pain_points", "type": "string" },
        { "name": "q17_integrations", "type": "string" },
        { "name": "q18_data_residency", "type": "string" },
        { "name": "q19_security_questionnaire", "type": "bool" },
        { "name": "q20_procurement_route", "type": "string" },
        { "name": "q21_preferred_contact", "type": "string" },
        { "name": "q22_call_window", "type": "string" },
        { "name": "q23_accessibility_needs", "type": "string" },
        { "name": "q24_event_dietary", "type": "string" },
        { "name": "q25_attending_in_person", "type": "bool" },
        { "name": "q26_badge_name", "type": "string" },
        { "name": "q27_guest_count", "type": "string" },
        { "name": "q28_session_interest_1", "type": "string" },
        { "name": "q29_session_interest_2", "type": "string" },
        { "name": "q30_session_interest_3", "type": "string" },
        { "name": "q31_previous_attendee", "type": "bool" },
        { "name": "q32_referral_source", "type": "string" },
        { "name": "q33_campaign_code", "type": "string" },
        { "name": "q34_newsletter_optin", "type": "bool" },
        { "name": "q35_newsletter_topics", "type": "string" },
        { "name": "q36_language", "type": "string" },
        { "name": "q37_time_zone", "type": "string" },
        { "name": "q38_support_tier", "type": "string" },
        { "name": "q39_open_tickets", "type": "string" },
        { "name": "q40_incident_contact", "type": "string" },
        { "name": "q41_escalation_notes", "type": "string" },
        { "name": "q42_warranty_period", "type": "string" },
        { "name": "q43_serial_number", "type": "string" },
        { "name": "q44_install_address", "type": "string" },
        { "name": "q45_install_postcode", "type": "string" },
        { "name": "q46_access_instructions", "type": "string" },
        { "name": "q47_parking_needed", "type": "bool" },
        { "name": "q48_delivery_notes", "type": "string" },
        { "name": "q49_delivery_window", "type": "string" },
        { "name": "q50_gift_message", "type": "string" },
        { "name": "q51_order_reference", "type": "string" },
        { "name": "q52_invoice_reference", "type": "string" },
        { "name": "q53_payment_terms", "type": "string" },
        { "name": "q54_additional_comments", "type": "string" } ],
      "retention": "Kept for two years from submission, then removed by the retention rule.",
      "schemaVersion": 1, "realisation": "target" },
    { "id": "forms__consent_capture_rec", "name": "Consent capture", "owner": "product-module", "key": ["id"],
      "fields": [
        { "name": "id", "type": "u64" },
        { "name": "submission", "type": "u64", "refersTo": "forms__form_submission_rec", "onDelete": "restrict" },
        { "name": "purpose", "type": "forms__consent_purpose" },
        { "name": "granted", "type": "bool" },
        { "name": "captured_at", "type": "timestamp" },
        { "name": "subject_email", "type": "string", "personal": "contact" } ],
      "retention": "Kept three years after capture, as evidence of consent.",
      "schemaVersion": 1, "realisation": "target" },
    { "id": "forms__attachment_rec", "name": "Attachment", "owner": "product-module", "key": ["id"],
      "fields": [
        { "name": "id", "type": "u64" },
        { "name": "submission", "type": "u64", "refersTo": "forms__form_submission_rec", "onDelete": "restrict" },
        { "name": "file_name", "type": "string" },
        { "name": "scan_state", "type": "forms__attachment_scan" },
        { "name": "uploaded_at", "type": "timestamp" } ],
      "retention": "Kept one year from upload, then removed with its submission.",
      "schemaVersion": 1, "realisation": "target" },
    { "id": "forms__webhook_subscription_rec", "name": "Webhook subscription", "owner": "product-module", "key": ["id"],
      "fields": [
        { "name": "id", "type": "u64" },
        { "name": "name", "type": "string" },
        { "name": "endpoint", "type": "string" },
        { "name": "target_url", "type": "string" },
        { "name": "enabled", "type": "bool" },
        { "name": "last_delivery", "type": "forms__delivery_state", "optional": true } ],
      "retention": "Kept while the subscription exists; deleted with its form.",
      "schemaVersion": 1, "realisation": "target" }
  ],
  "types": [
    { "id": "forms__form_status", "name": "Form status", "kind": "enum",
      "values": ["draft", "published", "retired"], "description": "Where a form definition is in its life." },
    { "id": "forms__control_kind", "name": "Control kind", "kind": "enum",
      "values": ["text", "textarea", "checkbox", "password"], "description": "The input control a form field uses." },
    { "id": "forms__webhook_event", "name": "Webhook event", "kind": "enum",
      "values": ["form_submitted", "form_published", "form_retired"], "description": "The event a webhook subscription receives." },
    { "id": "forms__consent_purpose", "name": "Consent purpose", "kind": "enum",
      "values": ["marketing", "service", "research", "partner_share"], "description": "Why a respondent agreed to be contacted or to share data." },
    { "id": "forms__answer_pair", "name": "Answer pair", "kind": "struct",
      "fields": [ { "name": "question", "type": "string" }, { "name": "answer", "type": "string" } ], "description": "One question and its answer, for export." },
    { "id": "forms__field_setting", "name": "Field setting", "kind": "struct",
      "fields": [ { "name": "name", "type": "string" }, { "name": "label", "type": "string" }, { "name": "control", "type": "string" } ], "description": "The saved settings of one form field." },
    { "id": "forms__delivery_state", "name": "Delivery state", "kind": "enum",
      "values": ["queued", "sent", "failed", "dead_letter"], "description": "The state of the last webhook delivery." },
    { "id": "forms__attachment_scan", "name": "Attachment scan", "kind": "enum",
      "values": ["pending", "clean", "infected"], "description": "The malware scan result of an attachment." }
  ],
  "screens": [
    { "id": "forms__definition_list", "name": "Form definitions", "route": "/forms/definitions", "viewModel": "forms__read_definitions", "kind": "forms.list", "auth": "session", "description": "The form definitions of the tenant, by status.", "viewName": "forms_definition_list", "title": "Forms" },
    { "id": "forms__builder_screen", "name": "Form builder", "route": "/forms/builder/:slug", "viewModel": "forms__read_builder", "kind": "forms.editor", "auth": "session", "description": "Edit a draft form and the settings of each of its fields.", "viewName": "forms_builder", "title": "Form builder" },
    { "id": "forms__respond_screen", "name": "Respond to a form", "route": "/forms/respond/:slug", "viewModel": "forms__read_respondent_form", "kind": "forms.editor", "auth": "session", "description": "The form a respondent completes and submits.", "viewName": "forms_respond", "title": "Respond" },
    { "id": "forms__submission_list", "name": "Submissions", "route": "/forms/submissions", "viewModel": "forms__read_submission_board", "kind": "forms.list", "auth": "session", "description": "The submissions received, newest first.", "viewName": "forms_submission_list", "title": "Submissions" },
    { "id": "forms__submission_detail", "name": "Submission detail", "route": "/forms/submissions/:id", "viewModel": "forms__read_submission_board", "kind": "forms.detail", "auth": "session", "description": "One submission with its answers and consent captures.", "viewName": "forms_submission_detail", "title": "Submission" },
    { "id": "forms__consent_log", "name": "Consent log", "route": "/forms/consent", "viewModel": "forms__read_consent_log", "kind": "forms.list", "auth": "session", "description": "Consent captures across all forms.", "viewName": "forms_consent_log", "title": "Consent log" }
  ],
  "forms": [
    { "id": "forms__form_builder", "screen": "forms__builder_screen", "contract": "forms__save_form_builder",
      "fields": [
        { "name": "form_name", "input": "form_name", "label": "Form name", "control": "text" },
        { "name": "form_description", "input": "form_description", "label": "Form description", "control": "text" },
        { "name": "slot_01_label", "input": "slot_01_label", "label": "Slot 1 label", "control": "text" },
        { "name": "slot_01_default", "input": "slot_01_default", "label": "Slot 1 default value", "control": "text" },
        { "name": "slot_02_label", "input": "slot_02_label", "label": "Slot 2 label", "control": "text" },
        { "name": "slot_02_default", "input": "slot_02_default", "label": "Slot 2 default value", "control": "text" },
        { "name": "slot_03_label", "input": "slot_03_label", "label": "Slot 3 label", "control": "text" },
        { "name": "slot_03_default", "input": "slot_03_default", "label": "Slot 3 default value", "control": "text" },
        { "name": "slot_04_label", "input": "slot_04_label", "label": "Slot 4 label", "control": "text" },
        { "name": "slot_04_default", "input": "slot_04_default", "label": "Slot 4 default value", "control": "text" },
        { "name": "slot_05_label", "input": "slot_05_label", "label": "Slot 5 label", "control": "text" },
        { "name": "slot_05_default", "input": "slot_05_default", "label": "Slot 5 default value", "control": "text" },
        { "name": "slot_06_label", "input": "slot_06_label", "label": "Slot 6 label", "control": "text" },
        { "name": "slot_06_default", "input": "slot_06_default", "label": "Slot 6 default value", "control": "text" },
        { "name": "slot_07_label", "input": "slot_07_label", "label": "Slot 7 label", "control": "text" },
        { "name": "slot_07_default", "input": "slot_07_default", "label": "Slot 7 default value", "control": "text" },
        { "name": "slot_08_label", "input": "slot_08_label", "label": "Slot 8 label", "control": "text" },
        { "name": "slot_08_default", "input": "slot_08_default", "label": "Slot 8 default value", "control": "text" },
        { "name": "slot_09_label", "input": "slot_09_label", "label": "Slot 9 label", "control": "text" },
        { "name": "slot_09_default", "input": "slot_09_default", "label": "Slot 9 default value", "control": "text" },
        { "name": "slot_10_label", "input": "slot_10_label", "label": "Slot 10 label", "control": "text" },
        { "name": "slot_10_default", "input": "slot_10_default", "label": "Slot 10 default value", "control": "text" },
        { "name": "slot_11_label", "input": "slot_11_label", "label": "Slot 11 label", "control": "text" },
        { "name": "slot_11_default", "input": "slot_11_default", "label": "Slot 11 default value", "control": "text" },
        { "name": "slot_12_label", "input": "slot_12_label", "label": "Slot 12 label", "control": "text" },
        { "name": "slot_12_default", "input": "slot_12_default", "label": "Slot 12 default value", "control": "text" },
        { "name": "slot_13_label", "input": "slot_13_label", "label": "Slot 13 label", "control": "text" },
        { "name": "slot_13_default", "input": "slot_13_default", "label": "Slot 13 default value", "control": "text" },
        { "name": "slot_14_label", "input": "slot_14_label", "label": "Slot 14 label", "control": "text" },
        { "name": "slot_14_default", "input": "slot_14_default", "label": "Slot 14 default value", "control": "text" },
        { "name": "slot_15_label", "input": "slot_15_label", "label": "Slot 15 label", "control": "text" },
        { "name": "slot_15_default", "input": "slot_15_default", "label": "Slot 15 default value", "control": "text" },
        { "name": "slot_16_label", "input": "slot_16_label", "label": "Slot 16 label", "control": "text" },
        { "name": "slot_16_default", "input": "slot_16_default", "label": "Slot 16 default value", "control": "text" },
        { "name": "slot_17_label", "input": "slot_17_label", "label": "Slot 17 label", "control": "text" },
        { "name": "slot_17_default", "input": "slot_17_default", "label": "Slot 17 default value", "control": "text" },
