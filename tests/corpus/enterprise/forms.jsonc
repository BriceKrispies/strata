        { "name": "slot_38_default", "input": "slot_38_default", "label": "Slot 38 default value", "control": "text" },
        { "name": "slot_39_label", "input": "slot_39_label", "label": "Slot 39 label", "control": "text" },
        { "name": "slot_39_default", "input": "slot_39_default", "label": "Slot 39 default value", "control": "text" } ],
      "submitLabel": "Save draft", "onSuccess": { "toast": "Form saved." }, "onError": { "show": "inline" } },
    { "id": "forms__submission_form", "screen": "forms__respond_screen", "contract": "forms__submit_form",
      "fields": [
        { "name": "respondent_name", "input": "respondent_name", "label": "Your name", "control": "text", "normalize": "trim" },
        { "name": "respondent_email", "input": "respondent_email", "label": "Your email", "control": "text", "normalize": "trim" },
        { "name": "consent_given", "input": "consent_given", "label": "I agree to be contacted about this request", "control": "checkbox" },
        { "name": "q01_company_name", "input": "q01_company_name", "label": "Company name", "control": "text" },
        { "name": "q02_job_title", "input": "q02_job_title", "label": "Job title", "control": "text" },
        { "name": "q03_department", "input": "q03_department", "label": "Department", "control": "text" },
        { "name": "q04_team_size", "input": "q04_team_size", "label": "Team size", "control": "text" },
        { "name": "q05_regulated_sector", "input": "q05_regulated_sector", "label": "Works in a regulated sector", "control": "checkbox" },
        { "name": "q06_primary_country", "input": "q06_primary_country", "label": "Primary country", "control": "text" },
        { "name": "q07_region", "input": "q07_region", "label": "Region", "control": "text" },
        { "name": "q08_billing_entity", "input": "q08_billing_entity", "label": "Billing entity", "control": "text" },
        { "name": "q09_vat_number", "input": "q09_vat_number", "label": "VAT number", "control": "text" },
        { "name": "q10_industry_sector", "input": "q10_industry_sector", "label": "Industry sector", "control": "text" },
        { "name": "q11_annual_spend_band", "input": "q11_annual_spend_band", "label": "Annual spend band", "control": "text" },
        { "name": "q12_current_platform", "input": "q12_current_platform", "label": "Current platform", "control": "text" },
        { "name": "q13_implementation_timeline", "input": "q13_implementation_timeline", "label": "Implementation timeline", "control": "text" },
        { "name": "q14_pilot_needed", "input": "q14_pilot_needed", "label": "Pilot needed", "control": "checkbox" },
        { "name": "q15_use_case_summary", "input": "q15_use_case_summary", "label": "Use case summary", "control": "textarea" },
        { "name": "q16_pain_points", "input": "q16_pain_points", "label": "Current pain points", "control": "textarea" },
        { "name": "q17_integrations", "input": "q17_integrations", "label": "Integrations required", "control": "textarea" },
        { "name": "q18_data_residency", "input": "q18_data_residency", "label": "Data residency requirement", "control": "text" },
        { "name": "q19_security_questionnaire", "input": "q19_security_questionnaire", "label": "Security questionnaire attached", "control": "checkbox" },
        { "name": "q20_procurement_route", "input": "q20_procurement_route", "label": "Procurement route", "control": "text" },
        { "name": "q21_preferred_contact", "input": "q21_preferred_contact", "label": "Preferred contact method", "control": "text" },
        { "name": "q22_call_window", "input": "q22_call_window", "label": "Preferred call window", "control": "text" },
        { "name": "q23_accessibility_needs", "input": "q23_accessibility_needs", "label": "Accessibility needs", "control": "textarea" },
        { "name": "q24_event_dietary", "input": "q24_event_dietary", "label": "Dietary needs for event", "control": "textarea" },
        { "name": "q25_attending_in_person", "input": "q25_attending_in_person", "label": "Attending in person", "control": "checkbox" },
        { "name": "q26_badge_name", "input": "q26_badge_name", "label": "Badge name", "control": "text" },
        { "name": "q27_guest_count", "input": "q27_guest_count", "label": "Guest count", "control": "text" },
        { "name": "q28_session_interest_1", "input": "q28_session_interest_1", "label": "Session interest 1", "control": "text" },
        { "name": "q29_session_interest_2", "input": "q29_session_interest_2", "label": "Session interest 2", "control": "text" },
        { "name": "q30_session_interest_3", "input": "q30_session_interest_3", "label": "Session interest 3", "control": "text" },
        { "name": "q31_previous_attendee", "input": "q31_previous_attendee", "label": "Previous attendee", "control": "checkbox" },
        { "name": "q32_referral_source", "input": "q32_referral_source", "label": "Referral source", "control": "text" },
        { "name": "q33_campaign_code", "input": "q33_campaign_code", "label": "Campaign code", "control": "text" },
        { "name": "q34_newsletter_optin", "input": "q34_newsletter_optin", "label": "Accept newsletter", "control": "checkbox" },
        { "name": "q35_newsletter_topics", "input": "q35_newsletter_topics", "label": "Newsletter topics", "control": "textarea" },
        { "name": "q36_language", "input": "q36_language", "label": "Language", "control": "text" },
        { "name": "q37_time_zone", "input": "q37_time_zone", "label": "Time zone", "control": "text" },
        { "name": "q38_support_tier", "input": "q38_support_tier", "label": "Support tier", "control": "text" },
        { "name": "q39_open_tickets", "input": "q39_open_tickets", "label": "Open tickets", "control": "text" },
        { "name": "q40_incident_contact", "input": "q40_incident_contact", "label": "Incident contact", "control": "text" },
        { "name": "q41_escalation_notes", "input": "q41_escalation_notes", "label": "Escalation notes", "control": "textarea" },
        { "name": "q42_warranty_period", "input": "q42_warranty_period", "label": "Warranty period", "control": "text" },
        { "name": "q43_serial_number", "input": "q43_serial_number", "label": "Serial number", "control": "text" },
        { "name": "q44_install_address", "input": "q44_install_address", "label": "Installation address", "control": "text" },
        { "name": "q45_install_postcode", "input": "q45_install_postcode", "label": "Installation postcode", "control": "text" },
        { "name": "q46_access_instructions", "input": "q46_access_instructions", "label": "Access instructions", "control": "textarea" },
        { "name": "q47_parking_needed", "input": "q47_parking_needed", "label": "Parking needed", "control": "checkbox" },
        { "name": "q48_delivery_notes", "input": "q48_delivery_notes", "label": "Delivery notes", "control": "textarea" },
        { "name": "q49_delivery_window", "input": "q49_delivery_window", "label": "Preferred delivery window", "control": "text" },
        { "name": "q50_gift_message", "input": "q50_gift_message", "label": "Gift message", "control": "textarea" },
        { "name": "q51_order_reference", "input": "q51_order_reference", "label": "Order reference", "control": "text" },
        { "name": "q52_invoice_reference", "input": "q52_invoice_reference", "label": "Invoice reference", "control": "text" },
        { "name": "q53_payment_terms", "input": "q53_payment_terms", "label": "Payment terms", "control": "text" },
        { "name": "q54_additional_comments", "input": "q54_additional_comments", "label": "Additional comments", "control": "textarea" },
        { "name": "q55_status_page_subscribe", "input": "q55_status_page_subscribe", "label": "Subscribe to status page", "control": "checkbox" },
        { "name": "q56_notify_changes", "input": "q56_notify_changes", "label": "Notify on changes", "control": "checkbox" },
        { "name": "q57_anything_else", "input": "q57_anything_else", "label": "Anything else we should know", "control": "textarea" } ],
      "submitLabel": "Send", "onSuccess": { "navigate": { "screen": "forms__submission_list" }, "toast": "Thank you. Your response was received." }, "onError": { "show": "inline" } },
    { "id": "forms__consent_form", "screen": "forms__respond_screen", "contract": "forms__record_consent",
      "fields": [
        { "name": "submission", "input": "submission", "label": "Submission reference", "control": "text" },
        { "name": "purpose", "input": "purpose", "label": "Purpose", "control": "text" },
        { "name": "granted", "input": "granted", "label": "Consent granted", "control": "checkbox" } ],
      "submitLabel": "Record consent", "onSuccess": { "toast": "Consent recorded." }, "onError": { "show": "inline" } },
    { "id": "forms__partner_webhook_form", "screen": "forms__builder_screen", "contract": "forms__manage_webhook_subscription",
      "fields": [
        { "name": "endpoint", "input": "endpoint", "label": "Endpoint name", "control": "text" },
        { "name": "target_url", "input": "target_url", "label": "Target address", "control": "text", "normalize": "trim" },
        { "name": "enabled", "input": "enabled", "label": "Enabled", "control": "checkbox" },
        { "name": "secret_hint", "input": "secret_hint", "label": "Secret hint", "control": "text" } ],
      "submitLabel": "Save subscription", "onSuccess": { "toast": "Subscription saved." }, "onError": { "show": "inline" } }
  ],
  "actions": [
    { "id": "forms__action_save_builder", "screen": "forms__builder_screen", "label": "Save draft", "contract": "forms__save_form_builder", "form": "forms__form_builder", "arguments": { "name": "form.form_name", "description": "form.form_description" }, "onSuccess": { "toast": "Draft saved." }, "onError": { "show": "inline" } },
    { "id": "forms__action_publish", "screen": "forms__definition_list", "label": "Publish", "contract": "forms__publish_form_definition", "onSuccess": { "toast": "Published." }, "onError": { "show": "toast" } },
    { "id": "forms__action_submit_response", "screen": "forms__respond_screen", "label": "Send", "contract": "forms__submit_form", "form": "forms__submission_form", "arguments": { "respondent_name": "form.respondent_name", "respondent_email": "form.respondent_email", "consent_given": "form.consent_given" }, "onSuccess": { "toast": "Response sent." }, "onError": { "show": "inline" } }
  ],
  "liveBindings": [
    { "id": "forms__live_definition_list", "screen": "forms__definition_list", "event": "ui-notice-received", "refresh": "whole", "when": { "any": ["event.kind == 'membership'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "forms__live_definition_list_ended", "screen": "forms__definition_list", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "forms__live_builder", "screen": "forms__builder_screen", "event": "ui-notice-received", "refresh": "whole", "when": { "any": ["event.kind == 'membership'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "forms__live_builder_ended", "screen": "forms__builder_screen", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "forms__live_respond", "screen": "forms__respond_screen", "event": "ui-notice-received", "refresh": "whole", "when": { "any": ["event.kind == 'membership'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "forms__live_respond_ended", "screen": "forms__respond_screen", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "forms__live_submission_list", "screen": "forms__submission_list", "event": "ui-notice-received", "refresh": "whole", "when": { "any": ["event.kind == 'membership'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "forms__live_submission_list_ended", "screen": "forms__submission_list", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "forms__live_submission_detail", "screen": "forms__submission_detail", "event": "ui-notice-received", "refresh": "whole", "when": { "any": ["event.kind == 'membership'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "forms__live_submission_detail_ended", "screen": "forms__submission_detail", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "forms__live_consent_log", "screen": "forms__consent_log", "event": "ui-notice-received", "refresh": "whole", "when": { "any": ["event.kind == 'membership'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "forms__live_consent_log_ended", "screen": "forms__consent_log", "event": "ui-session-ended", "refresh": "whole" }
  ],
  "errorMessages": [
    { "id": "forms__error_slug_taken", "on": "check", "kinds": ["unique"], "text": "Another form already uses this slug.", "field": { "name": "slug" } },
    { "id": "forms__error_not_editable", "on": "error", "kinds": ["workflow"], "text": "This form is published and can no longer be edited. Create a new version." }
  ],
  "roles": [
    { "id": "forms__form_owner", "name": "Form owner", "description": "Builds, publishes and retires forms for a team.", "level": "tenant",
      "holders": ["person", "team"], "capabilities": ["forms__build", "forms__publish", "webhooks-manage"] },
    { "id": "forms__compliance_reviewer", "name": "Compliance reviewer", "description": "Reads submissions, consent captures and attachments.", "level": "tenant",
      "holders": ["person", "team"], "capabilities": ["forms__review", "consent-record"] },
    { "id": "forms__respondent", "name": "Respondent", "description": "Completes and sends a published form.", "level": "tenant",
      "holders": ["person"], "capabilities": ["form-submit"] },
    { "id": "forms__member", "name": "Member", "description": "Any member of the tenant who reads what the product shares with everyone.", "level": "tenant",
      "holders": ["person", "team"], "capabilities": ["form-submit"] }
  ],
  "claims": [
    { "id": "forms__submission-retention-follows-consent", "kind": "structural",
      "statement": "A submission with a consent capture SHALL NOT be removed before the consent capture is removed.",
      "subjects": ["product-module"],
      "rationale": "Consent evidence must outlive the answers it covers.",
      "evaluate": { "method": "external-evidence" } },
    { "id": "forms__published-form-is-versioned", "kind": "structural",
      "statement": "A published form definition SHALL NOT change its fields without a new form version.",
      "subjects": ["product-module"],
      "rationale": "Submissions refer to the version they were answered against.",
      "evaluate": { "method": "external-evidence" } }
  ],
  "capabilities": [
    { "id": "forms__build", "name": "Build forms", "description": "Create and edit draft form definitions." },
    { "id": "forms__publish", "name": "Publish forms", "description": "Make a form definition live for respondents." },
    { "id": "forms__review", "name": "Review submissions", "description": "Read submissions, consent captures and attachments." }
  ],
  "objects": [
