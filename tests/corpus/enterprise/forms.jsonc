        { "name": "slot_31_label", "input": "slot_31_label", "label": "Slot 31 label", "control": "text" },
        { "name": "slot_31_default", "input": "slot_31_default", "label": "Slot 31 default value", "control": "text" },
        { "name": "slot_32_label", "input": "slot_32_label", "label": "Slot 32 label", "control": "text" },
        { "name": "slot_32_default", "input": "slot_32_default", "label": "Slot 32 default value", "control": "text" },
        { "name": "slot_33_label", "input": "slot_33_label", "label": "Slot 33 label", "control": "text" },
        { "name": "slot_33_default", "input": "slot_33_default", "label": "Slot 33 default value", "control": "text" },
        { "name": "slot_34_label", "input": "slot_34_label", "label": "Slot 34 label", "control": "text" },
        { "name": "slot_34_default", "input": "slot_34_default", "label": "Slot 34 default value", "control": "text" },
        { "name": "slot_35_label", "input": "slot_35_label", "label": "Slot 35 label", "control": "text" },
        { "name": "slot_35_default", "input": "slot_35_default", "label": "Slot 35 default value", "control": "text" },
        { "name": "slot_36_label", "input": "slot_36_label", "label": "Slot 36 label", "control": "text" },
        { "name": "slot_36_default", "input": "slot_36_default", "label": "Slot 36 default value", "control": "text" },
        { "name": "slot_37_label", "input": "slot_37_label", "label": "Slot 37 label", "control": "text" },
        { "name": "slot_37_default", "input": "slot_37_default", "label": "Slot 37 default value", "control": "text" },
        { "name": "slot_38_label", "input": "slot_38_label", "label": "Slot 38 label", "control": "text" },
