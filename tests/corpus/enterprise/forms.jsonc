          "personal": { "kind": "email-address", "subject": { "Field": { "field": "subject_email" } }, "searchable": false } } },
      "constraints": {},
      "retention": { "days": 1095, "from": "Created" } },
    { "id": "forms__attachment", "label": "Attachment",
      "fields": {
        "label": { "id": "label", "label": "Label", "ty": "Str", "required": false, "unique": false },
        "file": { "id": "file", "label": "File", "ty": { "File": { "media-types": ["application/pdf", "image/png", "image/jpeg"], "max-bytes": 20971520, "renditions": [] } }, "required": true, "unique": false },
        "submission": { "id": "submission", "label": "Submission", "ty": { "Ref": { "target": "forms__form_submission", "on-delete": "Restrict" } }, "required": true, "unique": false },
        "scan_state": { "id": "scan_state", "label": "Scan state", "ty": "Str", "required": false, "unique": false },
        "uploaded_at": { "id": "uploaded_at", "label": "Uploaded", "ty": "Time", "required": true, "unique": false } },
