  ],
  "policies": [
    { "id": "forms__owner_definitions", "role": "forms__form_owner", "resource": { "Object": "forms__form_definition" }, "actions": ["Create", "Read", "Update"] },
    { "id": "forms__owner_submissions", "role": "forms__form_owner", "resource": { "Object": "forms__form_submission" }, "actions": ["Read"] },
    { "id": "forms__member_own_submissions", "role": "forms__member", "resource": { "Object": "forms__form_submission" }, "actions": ["Read"], "condition": "record.respondent_email == principal" },
    { "id": "forms__review_consent", "role": "forms__compliance_reviewer", "resource": { "Object": "forms__consent_capture" }, "actions": ["Read"] },
    { "id": "forms__review_attachments", "role": "forms__compliance_reviewer", "resource": { "Object": "forms__attachment" }, "actions": ["Read", "Delete"] }
  ],
  "queries": [
    { "id": "forms__published_forms", "object": "forms__form_definition", "filter": "record.status == 'published'", "params": [], "order": [ { "field": "name", "descending": false } ], "limit": 50 },
    { "id": "forms__submissions_for_definition", "object": "forms__form_submission", "filter": "record.definition == param.definition", "params": ["definition"], "order": [ { "field": "submitted_at", "descending": true } ], "limit": 200 }
  ],
  "views": [
    { "id": "forms__definition_board", "route": "/forms/board", "title": "Published forms",
      "sections": { "main": { "query": "forms__published_forms", "args": {}, "include": [], "markdown": [], "single": false } } },
    {"id":"forms__definition_list_view","route":"/forms/definitions","title":"Forms","sections":{"main":{"query":"forms__submissions_for_definition","args":{"definition":{"Const":{"Str":"x"}}},"include":[],"markdown":[],"single":false}}},
    {"id":"forms__builder_screen_view","route":"/forms/builder/:slug","title":"Form builder","sections":{"main":{"query":"forms__published_forms","args":{},"include":[],"markdown":[],"single":false}}},
    {"id":"forms__respond_screen_view","route":"/forms/respond/:slug","title":"Respond","sections":{"main":{"query":"forms__published_forms","args":{},"include":[],"markdown":[],"single":false}}},
    {"id":"forms__submission_list_view","route":"/forms/submissions","title":"Submissions","sections":{"main":{"query":"forms__submissions_for_definition","args":{"definition":{"Const":{"Str":"x"}}},"include":[],"markdown":[],"single":false}}},
    {"id":"forms__submission_detail_view","route":"/forms/submissions/:id","title":"Submission","sections":{"main":{"query":"forms__submissions_for_definition","args":{"definition":{"Const":{"Str":"x"}}},"include":[],"markdown":[],"single":false}}},
    {"id":"forms__consent_log_view","route":"/forms/consent","title":"Consent log","sections":{"main":{"query":"forms__published_forms","args":{},"include":[],"markdown":[],"single":false}}}
  ],
  "workflows": [
    { "id": "forms__form_lifecycle", "object": "forms__form_definition", "field": "status", "initial": ["draft"],
      "transitions": [
        { "name": "publish", "from": "draft", "to": "published", "guard": "old.status == 'draft'", "set": { "published_at": "now" } },
        { "name": "retire", "from": "published", "to": "retired", "guard": "old.status == 'published'", "set": { "retired_at": "now" } } ] }
  ],
  "settings": [
    { "id": "forms__default_retention_days", "label": "Default retention for submissions", "type": "i64", "default": {"Int": 730}, "levels": ["tenant"] },
    { "id": "forms__default_locale", "label": "Default locale", "type": "string", "default": {"Str": "en-GB"}, "levels": ["tenant", "team"] }
  ],
  "mailTemplates": [
    { "id": "forms__submission_mail", "subject": "We received your response",
      "body": "[{\"type\":\"paragraph\",\"inlines\":[{\"type\":\"text\",\"text\":\"Thank you. We received your response and will be in touch.\"}]}]" }
  ],
  "noticeTemplates": [
    { "id": "forms__submission_notice", "title": "New form submission",
      "body": "[{\"type\":\"paragraph\",\"inlines\":[{\"type\":\"text\",\"text\":\"A new response was received for one of your forms.\"}]}]" }
  ],
  "triggers": [
    { "id": "forms__on_submission", "on": { "RecordCreated": { "object": "forms__form_submission" } }, "automation": "forms__submission_pipeline" },
    { "id": "forms__on_partner_webhook", "on": { "InboundWebhook": { "endpoint": "form-partner" } }, "automation": "forms__submission_pipeline" }
  ],
  "automations": [
    { "id": "forms__submission_pipeline", "label": "Tell the form owner, notify the partner webhook and confirm to the respondent",
      "run-as": { "roles": ["forms__form_owner"] }, "run-key": "param.owner",
      "start": "notify",
      "steps": {
        "notify": { "action": { "CreateNotice": { "template": "forms__submission_notice", "to": "param.owner", "record": "record.$id" } }, "next": "hook", "retry": { "attempts": 3 } },
        "hook": { "action": { "CallWebhook": { "subscription": "7a2d3b4c-4e5f-4a6b-9c7d-1e2f3a4b5c62", "body": { "submission": "record.$id", "event": "'form.submitted'" } } }, "next": "mail", "timeout": 15000 },
        "mail": { "action": { "SendMail": { "template": "forms__submission_mail", "to": "param.owner", "category": "transactional" } }, "next": "done", "timeout": 30000 },
        "done": { "action": "End" } } }
  ],
  "operations": [
    { "id": "forms__publish_form", "label": "Publish a form definition",
      "inputs": [ { "name": "definition", "ty": { "Ref": { "target": "forms__form_definition", "on-delete": "Restrict" } }, "required": true, "label": "The form definition" } ],
      "invokers": { "signed-in": true, "roles": ["forms__form_owner"] },
      "subject": { "object": "forms__form_definition", "input": "definition" },
      "conditions": [ { "id": "is_draft", "expr": "record.status == 'draft'", "error": "not-draft", "message": "Only a draft form can be published." } ],
      "steps": [
        { "UpdateRecord": { "id": "set_published", "object": "forms__form_definition", "record": "record.$id", "fields": { "status": "'published'", "published_at": "now" } } } ] },
    { "id": "forms__retire_form", "label": "Retire a published form",
      "inputs": [ { "name": "definition", "ty": { "Ref": { "target": "forms__form_definition", "on-delete": "Restrict" } }, "required": true, "label": "The form definition" } ],
      "invokers": { "signed-in": true, "roles": ["forms__form_owner"] },
      "subject": { "object": "forms__form_definition", "input": "definition" },
      "conditions": [ { "id": "is_published", "expr": "record.status == 'published'", "error": "not-published", "message": "Only a published form can be retired." } ],
      "steps": [
        { "UpdateRecord": { "id": "set_retired", "object": "forms__form_definition", "record": "record.$id", "fields": { "status": "'retired'", "retired_at": "now" } } } ] },
