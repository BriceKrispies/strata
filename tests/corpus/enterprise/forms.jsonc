        { "name": "slot_07_label", "input": "slot_07_label", "label": "Slot 7 label", "control": "text" },
        { "name": "slot_07_default", "input": "slot_07_default", "label": "Slot 7 default value", "control": "text" },
        { "name": "slot_08_label", "input": "slot_08_label", "label": "Slot 8 label", "control": "text" },
        { "name": "slot_08_default", "input": "slot_08_default", "label": "Slot 8 default value", "control": "text" },
