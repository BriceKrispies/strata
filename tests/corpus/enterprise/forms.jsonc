{
  // Form builder for definitions, versions, submissions, consent captures, attachments and webhook subscriptions; depends on the platform form, consent and webhook capabilities.
  "product": {
    "id": "forms",
    "name": "Forms",
    "description": "Form builder for collecting submissions, consent and attachments.",
    "version": "1.0.0",
    "platform": { "min": "0.2" },
    "imports": {
      "spec": "../../../specifications/spec.jsonc",
      "entities": ["product-module", "ui-notice-received", "ui-session-ended", "api-error", "form-submit", "consent-record", "webhook-receive", "webhooks-manage"]
    }
  },
  "screens": [
    { "id": "forms__definition_list", "name": "Form definitions", "route": "/forms/definitions", "viewModel": "forms__definition_list_view", "kind": "forms.list", "auth": "session", "description": "The form definitions of the tenant, by status.", "viewName": "forms_definition_list", "title": "Forms" },
    { "id": "forms__builder_screen", "name": "Form builder", "route": "/forms/builder/:slug", "viewModel": "forms__builder_screen_view", "kind": "forms.editor", "auth": "session", "description": "Edit a draft form and the settings of each of its fields.", "viewName": "forms_builder", "title": "Form builder" },
    { "id": "forms__respond_screen", "name": "Respond to a form", "route": "/forms/respond/:slug", "viewModel": "forms__respond_screen_view", "kind": "forms.editor", "auth": "session", "description": "The form a respondent completes and submits.", "viewName": "forms_respond", "title": "Respond" },
    { "id": "forms__submission_list", "name": "Submissions", "route": "/forms/submissions", "viewModel": "forms__submission_list_view", "kind": "forms.list", "auth": "session", "description": "The submissions received, newest first.", "viewName": "forms_submission_list", "title": "Submissions" },
    { "id": "forms__submission_detail", "name": "Submission detail", "route": "/forms/submissions/:id", "viewModel": "forms__submission_detail_view", "kind": "forms.detail", "auth": "session", "description": "One submission with its answers and consent captures.", "viewName": "forms_submission_detail", "title": "Submission" },
    { "id": "forms__consent_log", "name": "Consent log", "route": "/forms/consent", "viewModel": "forms__consent_log_view", "kind": "forms.list", "auth": "session", "description": "Consent captures across all forms.", "viewName": "forms_consent_log", "title": "Consent log" }
  ],
  "forms": [
    { "id": "forms__form_builder", "screen": "forms__builder_screen", "contract": "forms__save_form_builder",
      "fields": [
        { "name": "form_name", "input": "form_name", "label": "Form name", "control": "text" },
        { "name": "form_description", "input": "form_description", "label": "Form description", "control": "text" },
        { "name": "slot_01_label", "input": "slot_01_label", "label": "Slot 1 label", "control": "text" },
        { "name": "slot_01_default", "input": "slot_01_default", "label": "Slot 1 default value", "control": "text" },
        { "name": "slot_02_label", "input": "slot_02_label", "label": "Slot 2 label", "control": "text" },
        { "name": "slot_02_default", "input": "slot_02_default", "label": "Slot 2 default value", "control": "text" },
        { "name": "slot_03_label", "input": "slot_03_label", "label": "Slot 3 label", "control": "text" },
        { "name": "slot_03_default", "input": "slot_03_default", "label": "Slot 3 default value", "control": "text" },
        { "name": "slot_04_label", "input": "slot_04_label", "label": "Slot 4 label", "control": "text" },
        { "name": "slot_04_default", "input": "slot_04_default", "label": "Slot 4 default value", "control": "text" },
