{
  // Multi-stage legal, brand and regional approval chains with delegations and SLA escalation; depends on the platform records, workflow, settings and automation capabilities.
  "product": {
    "id": "approvals",
    "name": "Approvals",
    "description": "Multi-stage legal, brand and regional approval chains with delegations, SLAs and escalations.",
    "version": "1.0.0",
    "platform": { "min": "0.2" },
    "imports": {
      "spec": "../../../specifications/spec.jsonc",
      "entities": ["product-module", "ui-notice-received", "ui-session-ended", "api-error", "records-read", "workflow-approve", "setting-read", "setting-write-tenant", "self-record-write"]
    }
  },
  "roles": [
    { "id": "approvals__legal_approver", "name": "Legal approver", "description": "Reviews the legal stage of a request.", "level": "tenant",
      "holders": ["person", "team"], "capabilities": ["records-read", "workflow-approve", "approvals__review_legal"] },
    { "id": "approvals__brand_approver", "name": "Brand approver", "description": "Reviews the brand stage of a request.", "level": "tenant",
      "holders": ["person", "team"], "capabilities": ["records-read", "workflow-approve", "approvals__review_brand"] },
    { "id": "approvals__regional_approver_emea", "name": "Regional approver, EMEA", "description": "Reviews regional stages for the EMEA region.", "level": "tenant",
      "holders": ["person", "team"], "capabilities": ["records-read", "workflow-approve", "approvals__review_region"] },
    { "id": "approvals__regional_approver_apac", "name": "Regional approver, APAC", "description": "Reviews regional stages for the APAC region.", "level": "tenant",
      "holders": ["person", "team"], "capabilities": ["records-read", "workflow-approve", "approvals__review_region"] },
    { "id": "approvals__regional_approver_amer", "name": "Regional approver, AMER", "description": "Reviews regional stages for the AMER region.", "level": "tenant",
      "holders": ["person", "team"], "capabilities": ["records-read", "workflow-approve", "approvals__review_region"] },
    { "id": "approvals__approval_admin", "name": "Approval administrator", "description": "Runs the approval chains, withdraws requests and maintains SLA settings.", "level": "tenant",
      "holders": ["person", "team", "agent"], "capabilities": ["records-read", "workflow-approve", "setting-read", "setting-write-tenant", "self-record-write", "approvals__administer"] }
  ],
  "capabilities": [
    { "id": "approvals__review_legal", "name": "Review legal stages", "description": "Decide the legal stage of an approval request." },
    { "id": "approvals__review_brand", "name": "Review brand stages", "description": "Decide the brand stage of an approval request." },
    { "id": "approvals__review_region", "name": "Review regional stages", "description": "Decide the regional stage of an approval request for the region of the role." },
    { "id": "approvals__administer", "name": "Administer approvals", "description": "Run approval chains, withdraw requests and change SLA settings." }
  ],
  "objects": [
    { "id": "approvals__approval_request", "label": "Approval request",
      "fields": {
        "title": { "id": "title", "label": "Title", "ty": "Str", "required": true, "unique": false },
        "status": { "id": "status", "label": "Status", "ty": "Str", "required": true, "unique": false },
        "region": { "id": "region", "label": "Region", "ty": "Str", "required": true, "unique": false },
        "business_unit": { "id": "business_unit", "label": "Business unit", "ty": "Str", "required": false, "unique": false },
        "submitted_at": { "id": "submitted_at", "label": "Submitted", "ty": "Time", "required": true, "unique": false },
        "expedite": { "id": "expedite", "label": "Expedite", "ty": "Bool", "required": false, "unique": false },
        "current_stage": { "id": "current_stage", "label": "Current stage", "ty": { "Ref": { "target": "approvals__approval_stage", "on-delete": "Restrict" } }, "required": false, "unique": false } },
      "constraints": {},
      "retention": { "days": 1095, "from": "Created" } },
    { "id": "approvals__approval_stage", "label": "Approval stage",
      "fields": {
        "request": { "id": "request", "label": "Request", "ty": { "Ref": { "target": "approvals__approval_request", "on-delete": "Restrict" } }, "required": true, "unique": false },
        "stage_kind": { "id": "stage_kind", "label": "Stage kind", "ty": "Str", "required": true, "unique": false },
        "region": { "id": "region", "label": "Region", "ty": "Str", "required": true, "unique": false },
        "decision": { "id": "decision", "label": "Decision", "ty": "Str", "required": true, "unique": false },
        "approver_role": { "id": "approver_role", "label": "Approver role", "ty": "Str", "required": true, "unique": false },
        "due_at": { "id": "due_at", "label": "Due", "ty": "Time", "required": false, "unique": false },
        "decided_at": { "id": "decided_at", "label": "Decided", "ty": "Time", "required": false, "unique": false } },
      "constraints": {},
      "retention": { "days": 1095, "from": "Created" } },
    { "id": "approvals__delegation", "label": "Delegation",
      "fields": {
        "stage": { "id": "stage", "label": "Stage", "ty": { "Ref": { "target": "approvals__approval_stage", "on-delete": "Restrict" } }, "required": true, "unique": false },
        "delegator": { "id": "delegator", "label": "Delegator", "ty": "Str", "required": true, "unique": false },
        "delegate_name": { "id": "delegate_name", "label": "Delegate", "ty": "Str", "required": true, "unique": false,
          "personal": { "kind": "name", "subject": { "Field": { "field": "delegate_name" } }, "searchable": false } },
        "delegate_contact": { "id": "delegate_contact", "label": "Delegate contact", "ty": "Str", "required": true, "unique": false,
          "personal": { "kind": "email-address", "subject": { "Field": { "field": "delegate_contact" } }, "searchable": false } },
        "starts_at": { "id": "starts_at", "label": "Starts", "ty": "Time", "required": true, "unique": false },
        "ends_at": { "id": "ends_at", "label": "Ends", "ty": "Time", "required": true, "unique": false } },
      "constraints": {},
      "retention": { "days": 365, "from": "Created" } },
    { "id": "approvals__sla_policy", "label": "SLA policy",
      "fields": {
        "name": { "id": "name", "label": "Name", "ty": "Str", "required": true, "unique": true },
        "hours": { "id": "hours", "label": "Hours", "ty": "Int", "required": true, "unique": false },
        "escalation_role": { "id": "escalation_role", "label": "Escalation role", "ty": "Str", "required": true, "unique": false },
        "region": { "id": "region", "label": "Region", "ty": "Str", "required": false, "unique": false } },
      "constraints": {},
      "retention": { "days": 3650, "from": "Created" } },
    { "id": "approvals__escalation", "label": "Escalation",
      "fields": {
        "stage": { "id": "stage", "label": "Stage", "ty": { "Ref": { "target": "approvals__approval_stage", "on-delete": "Restrict" } }, "required": true, "unique": false },
        "level": { "id": "level", "label": "Level", "ty": "Int", "required": true, "unique": false },
        "reason": { "id": "reason", "label": "Reason", "ty": "Str", "required": true, "unique": false },
        "raised_at": { "id": "raised_at", "label": "Raised", "ty": "Time", "required": true, "unique": false } },
      "constraints": {},
      "retention": { "days": 1095, "from": "Created" } }
  ],
  "policies": [
    { "id": "approvals__legal_stage_reviews", "role": "approvals__legal_approver", "resource": { "Object": "approvals__approval_stage" },
      "actions": ["Read", "Update"], "condition": "record.stage_kind == 'legal'" },
    { "id": "approvals__brand_stage_reviews", "role": "approvals__brand_approver", "resource": { "Object": "approvals__approval_stage" },
      "actions": ["Read", "Update"], "condition": "record.stage_kind == 'brand'" },
    { "id": "approvals__emea_stage_reviews", "role": "approvals__regional_approver_emea", "resource": { "Object": "approvals__approval_stage" },
      "actions": ["Read", "Update"], "condition": "record.region == 'emea' and record.stage_kind == 'regional'" },
    { "id": "approvals__apac_stage_reviews", "role": "approvals__regional_approver_apac", "resource": { "Object": "approvals__approval_stage" },
      "actions": ["Read", "Update"], "condition": "record.region == 'apac' and record.stage_kind == 'regional'" },
    { "id": "approvals__amer_stage_reviews", "role": "approvals__regional_approver_amer", "resource": { "Object": "approvals__approval_stage" },
      "actions": ["Read", "Update"], "condition": "record.region == 'amer' and record.stage_kind == 'regional'" },
    { "id": "approvals__admin_requests", "role": "approvals__approval_admin", "resource": { "Object": "approvals__approval_request" },
      "actions": ["Create", "Read", "Update", "Delete"] }
  ],
  "queries": [
    { "id": "approvals__open_requests", "object": "approvals__approval_request",
      "filter": "record.status == 'submitted' or record.status == 'in_legal' or record.status == 'in_brand' or record.status == 'in_region'",
      "params": [], "order": [ { "field": "submitted_at", "descending": true } ], "limit": 100 },
    { "id": "approvals__pending_stages_for_region", "object": "approvals__approval_stage",
      "filter": "record.region == param.region and record.decision == 'pending'",
      "params": ["region"], "order": [ { "field": "due_at", "descending": false } ], "limit": 200 }
  ],
  "views": [
    { "id": "approvals__request_board", "route": "/approvals/board", "title": "Approval board",
      "sections": { "main": { "query": "approvals__open_requests", "args": {}, "include": [], "markdown": [], "single": false } } },
    {"id":"approvals__request_queue_view","route":"/approvals/queue","title":"Approval queue","sections":{"main":{"query":"approvals__open_requests","args":{},"include":[],"markdown":[],"single":false}}},
    {"id":"approvals__request_editor_view","route":"/approvals/requests/new","title":"New approval request","sections":{"main":{"query":"approvals__open_requests","args":{},"include":[],"markdown":[],"single":false}}},
    {"id":"approvals__request_detail_view","route":"/approvals/requests/:request","title":"Approval request","sections":{"main":{"query":"approvals__open_requests","args":{},"include":[],"markdown":[],"single":false}}},
    {"id":"approvals__decision_panel_view","route":"/approvals/decide/:stage","title":"Decide stage","sections":{"main":{"query":"approvals__pending_stages_for_region","args":{"region":{"Const":{"Str":"x"}}},"include":[],"markdown":[],"single":false}}},
    {"id":"approvals__delegation_editor_view","route":"/approvals/delegations/new","title":"New delegation","sections":{"main":{"query":"approvals__open_requests","args":{},"include":[],"markdown":[],"single":false}}},
    {"id":"approvals__settings_page_view","route":"/approvals/settings","title":"Approval settings","sections":{"main":{"query":"approvals__open_requests","args":{},"include":[],"markdown":[],"single":false}}}
  ],
  "workflows": [
    { "id": "approvals__request_lifecycle", "object": "approvals__approval_request", "field": "status", "initial": ["submitted"],
      "transitions": [
        { "name": "start_legal", "from": "submitted", "to": "in_legal", "guard": "old.status == 'submitted'", "set": {} },
        { "name": "start_brand", "from": "in_legal", "to": "in_brand", "guard": "old.status == 'in_legal'", "set": {} },
        { "name": "start_region", "from": "in_brand", "to": "in_region", "guard": "old.status == 'in_brand'", "set": {} },
        { "name": "approve", "from": "in_region", "to": "approved", "guard": "old.status == 'in_region'", "set": {} },
        { "name": "refuse_legal", "from": "in_legal", "to": "refused", "guard": "old.status == 'in_legal'", "set": {} },
        { "name": "refuse_brand", "from": "in_brand", "to": "refused", "guard": "old.status == 'in_brand'", "set": {} },
        { "name": "refuse_region", "from": "in_region", "to": "refused", "guard": "old.status == 'in_region'", "set": {} },
        { "name": "withdraw_submitted", "from": "submitted", "to": "withdrawn", "guard": "old.status == 'submitted'", "set": {} },
        { "name": "withdraw_legal", "from": "in_legal", "to": "withdrawn", "guard": "old.status == 'in_legal'", "set": {} },
        { "name": "withdraw_brand", "from": "in_brand", "to": "withdrawn", "guard": "old.status == 'in_brand'", "set": {} },
        { "name": "withdraw_region", "from": "in_region", "to": "withdrawn", "guard": "old.status == 'in_region'", "set": {} } ] }
  ],
  "screens": [
    { "id": "approvals__request_queue", "name": "Approval queue", "route": "/approvals/queue", "viewModel": "approvals__request_queue_view",
      "kind": "approvals.list", "auth": "session", "description": "Open approval requests, newest first.",
      "viewName": "approvals_request_queue", "title": "Approval queue" },
    { "id": "approvals__request_editor", "name": "Request editor", "route": "/approvals/requests/new", "viewModel": "approvals__request_editor_view",
      "kind": "approvals.editor", "auth": "session", "description": "Start a new approval request.",
      "viewName": "approvals_request_editor", "title": "New approval request" },
    { "id": "approvals__request_detail", "name": "Request detail", "route": "/approvals/requests/:request", "viewModel": "approvals__request_detail_view",
      "kind": "approvals.detail", "auth": "session", "description": "One request, its stages and its escalations.",
      "viewName": "approvals_request_detail", "title": "Approval request", "query": ["tab"] },
    { "id": "approvals__decision_panel", "name": "Decision panel", "route": "/approvals/decide/:stage", "viewModel": "approvals__decision_panel_view",
      "kind": "approvals.detail", "auth": "session", "description": "Record a decision on one stage.",
      "viewName": "approvals_decision_panel", "title": "Decide stage" },
    { "id": "approvals__delegation_editor", "name": "Delegation editor", "route": "/approvals/delegations/new", "viewModel": "approvals__delegation_editor_view",
      "kind": "approvals.editor", "auth": "session", "description": "Hand a stage to a delegate for a period.",
      "viewName": "approvals_delegation_editor", "title": "New delegation" },
    { "id": "approvals__settings_page", "name": "Approval settings", "route": "/approvals/settings", "viewModel": "approvals__settings_page_view",
      "kind": "approvals.settings", "auth": "session", "description": "SLA hours and the escalation contact role.",
      "viewName": "approvals_settings_page", "title": "Approval settings" }
  ],
  "forms": [
    { "id": "approvals__form_request_submit", "screen": "approvals__request_editor", "contract": "approvals__submit_request",
      "fields": [
        { "name": "title", "input": "title", "label": "Title", "control": "text", "normalize": "trim" },
        { "name": "summary", "input": "summary", "label": "Summary", "control": "textarea" },
        { "name": "region", "input": "region", "label": "Region", "control": "text" },
        { "name": "business_unit", "input": "business_unit", "label": "Business unit", "control": "text" },
        { "name": "expedite", "input": "expedite", "label": "Expedite this request", "control": "checkbox" },
        { "name": "attachment_note", "input": "attachment_note", "label": "Attachment note", "control": "textarea" } ],
      "submitLabel": "Submit for approval", "onSuccess": { "navigate": { "screen": "approvals__request_queue" }, "toast": "Submitted." },
      "onError": { "show": "inline" } },
    { "id": "approvals__form_decision", "screen": "approvals__decision_panel", "contract": "approvals__decide_stage",
      "fields": [
        { "name": "stage", "input": "stage", "label": "Stage", "control": "text" },
        { "name": "decision", "input": "decision", "label": "Decision", "control": "text" },
        { "name": "comment", "input": "comment", "label": "Comment", "control": "textarea" },
        { "name": "conditions", "input": "conditions", "label": "Approved with conditions", "control": "checkbox" } ],
      "submitLabel": "Record decision", "onSuccess": { "navigate": { "screen": "approvals__request_queue" }, "toast": "Decision recorded." },
      "onError": { "show": "inline" } },
    { "id": "approvals__form_delegation", "screen": "approvals__delegation_editor", "contract": "approvals__delegate_stage",
      "fields": [
        { "name": "stage", "input": "stage", "label": "Stage", "control": "text" },
        { "name": "delegate_name", "input": "delegate_name", "label": "Delegate name", "control": "text" },
        { "name": "delegate_contact", "input": "delegate_contact", "label": "Delegate email", "control": "text", "normalize": "trim" },
        { "name": "starts_at", "input": "starts_at", "label": "Starts", "control": "text" },
        { "name": "ends_at", "input": "ends_at", "label": "Ends", "control": "text" },
        { "name": "notes", "input": "notes", "label": "Notes for the delegate", "control": "textarea" } ],
      "submitLabel": "Save delegation", "onSuccess": { "navigate": { "screen": "approvals__request_queue" }, "toast": "Delegation saved." },
      "onError": { "show": "inline" } },
    { "id": "approvals__form_sla_settings", "screen": "approvals__settings_page", "contract": "approvals__save_sla_settings",
      "fields": [
        { "name": "sla_hours", "input": "sla_hours", "label": "SLA hours", "control": "text" },
        { "name": "escalation_role", "input": "escalation_role", "label": "Escalation contact role", "control": "text" },
        { "name": "notify_on_escalation", "input": "notify_on_escalation", "label": "Notify the escalation contact", "control": "checkbox" } ],
      "submitLabel": "Save settings", "onSuccess": { "toast": "Settings saved." },
      "onError": { "show": "inline" } }
  ],
  "actions": [
    { "id": "approvals__action_submit_request", "screen": "approvals__request_editor", "label": "Submit",
      "contract": "approvals__submit_request", "form": "approvals__form_request_submit",
      "arguments": { "title": "form.title", "summary": "form.summary", "region": "form.region", "business_unit": "form.business_unit", "expedite": "form.expedite", "attachment_note": "form.attachment_note" },
      "onSuccess": { "toast": "Submitted." }, "onError": { "show": "inline" } },
    { "id": "approvals__action_record_decision", "screen": "approvals__decision_panel", "label": "Record decision",
      "contract": "approvals__decide_stage", "form": "approvals__form_decision",
      "arguments": { "stage": "form.stage", "decision": "form.decision", "comment": "form.comment", "conditions": "form.conditions" },
      "onSuccess": { "toast": "Decision recorded." }, "onError": { "show": "toast" } },
    { "id": "approvals__action_save_settings", "screen": "approvals__settings_page", "label": "Save settings",
      "contract": "approvals__save_sla_settings", "form": "approvals__form_sla_settings",
      "arguments": { "sla_hours": "form.sla_hours", "escalation_role": "form.escalation_role", "notify_on_escalation": "form.notify_on_escalation" },
      "onSuccess": { "toast": "Settings saved." }, "onError": { "show": "inline" } }
  ],
  "liveBindings": [
    { "id": "approvals__live_request_queue", "screen": "approvals__request_queue", "event": "ui-notice-received", "refresh": "whole",
      "when": { "any": ["event.kind == 'upsert'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "approvals__live_request_queue_ended", "screen": "approvals__request_queue", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "approvals__live_request_editor", "screen": "approvals__request_editor", "event": "ui-notice-received", "refresh": "whole",
      "when": { "any": ["event.kind == 'upsert'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "approvals__live_request_editor_ended", "screen": "approvals__request_editor", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "approvals__live_request_detail", "screen": "approvals__request_detail", "event": "ui-notice-received", "refresh": "whole",
      "when": { "any": ["event.kind == 'upsert'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "approvals__live_request_detail_ended", "screen": "approvals__request_detail", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "approvals__live_decision_panel", "screen": "approvals__decision_panel", "event": "ui-notice-received", "refresh": "whole",
      "when": { "any": ["event.kind == 'upsert'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "approvals__live_decision_panel_ended", "screen": "approvals__decision_panel", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "approvals__live_delegation_editor", "screen": "approvals__delegation_editor", "event": "ui-notice-received", "refresh": "whole",
      "when": { "any": ["event.kind == 'upsert'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "approvals__live_delegation_editor_ended", "screen": "approvals__delegation_editor", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "approvals__live_settings_page", "screen": "approvals__settings_page", "event": "ui-notice-received", "refresh": "whole",
      "when": { "any": ["event.kind == 'upsert'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "approvals__live_settings_page_ended", "screen": "approvals__settings_page", "event": "ui-session-ended", "refresh": "whole" }
  ],
  "errorMessages": [
    { "id": "approvals__error_title_required", "on": "check", "kinds": ["required"], "text": "Give the request a title.", "field": { "name": "title" } },
    { "id": "approvals__error_already_decided", "on": "error", "kinds": ["workflow"], "text": "This stage has already been decided. Reload to see the latest state." }
  ],
  "claims": [
    { "id": "approvals__no-approval-without-chain", "kind": "structural",
      "statement": "An approval request SHALL NOT reach the approved state without a decision on every stage of its chain.",
      "subjects": ["product-module"],
      "rationale": "The approve transition is guarded by the stage decisions of the request.",
      "evaluate": { "method": "external-evidence" } },
    { "id": "approvals__delegation-ends", "kind": "structural",
      "statement": "A delegation SHALL NOT decide a stage after its end time.",
      "subjects": ["product-module"],
      "rationale": "A delegate acts only inside the period the delegation names.",
      "evaluate": { "method": "external-evidence" } }
  ],
  "triggers": [
    { "id": "approvals__on_legal_start", "on": { "RecordUpdated": { "object": "approvals__approval_request", "transition": "start_legal" } },
      "condition": "param.hop < 4", "automation": "approvals__legal_review" }
  ],
  "automations": [
    { "id": "approvals__legal_review", "label": "Run the legal stage of an approval request",
      "run-as": { "roles": ["approvals__approval_admin"] }, "run-key": "param.seq",
      "start": "request",
      "steps": {
        "request": { "action": { "RequestApproval": { "policy": "approvals__legal_stage_reviews", "timeout": 172800000, "approved": "legal_approved", "refused": "legal_refused" } } },
        "legal_approved": { "action": { "UpdateRecord": { "object": "approvals__approval_stage", "record": "record.$id", "fields": { "decision": "'approved'" } } }, "next": "grace" },
        "legal_refused": { "action": { "UpdateRecord": { "object": "approvals__approval_stage", "record": "record.$id", "fields": { "decision": "'refused'" } } }, "next": "grace" },
        "grace": { "action": { "WaitFor": { "duration": 3600000 } }, "next": "escalate_check" },
        "escalate_check": { "action": { "Branch": { "condition": "record.due_at < now", "object": "approvals__approval_stage", "record": "record.$id", "then": "raise", "else": "notify_result" } } },
        "raise": { "action": { "CreateRecord": { "object": "approvals__escalation", "fields": { "stage": "record.$id", "level": "1", "reason": "'sla_breached'", "raised_at": "now" } } }, "next": "notify_result" },
        "notify_result": { "action": { "CreateNotice": { "template": "approvals__stage_notice", "to": "param.owner", "record": "record.$id" } }, "next": "mail", "retry": { "attempts": 3 } },
        "mail": { "action": { "SendMail": { "template": "approvals__decision_mail", "to": "param.owner", "category": "transactional" } }, "next": "done", "timeout": 30000 },
        "done": { "action": "End" } } }
  ],
  "operations": [
    { "id": "approvals__delegate_approval", "label": "Delegate an approval stage",
      "inputs": [
        { "name": "stage", "ty": { "Ref": { "target": "approvals__approval_stage", "on-delete": "Restrict" } }, "required": true, "label": "Stage" },
        { "name": "delegate_name", "ty": "Str", "required": true, "label": "Delegate name" },
        { "name": "delegate_contact", "ty": "Str", "required": true, "label": "Delegate email" },
        { "name": "starts_at", "ty": "Time", "required": true, "label": "Starts" },
        { "name": "ends_at", "ty": "Time", "required": true, "label": "Ends" } ],
      "invokers": { "signed-in": true, "roles": ["approvals__legal_approver", "approvals__brand_approver", "approvals__regional_approver_emea", "approvals__regional_approver_apac", "approvals__regional_approver_amer"] },
      "subject": { "object": "approvals__approval_stage", "input": "stage" },
      "conditions": [ { "id": "still_pending", "expr": "record.decision == 'pending'", "error": "already-decided", "message": "This stage has already been decided." } ],
      "steps": [
        { "CreateRecord": { "id": "delegation", "object": "approvals__delegation", "fields": { "stage": "record.$id", "delegator": "principal", "delegate_name": "param.delegate_name", "delegate_contact": "param.delegate_contact", "starts_at": "param.starts_at", "ends_at": "param.ends_at" } } } ] },
    { "id": "approvals__withdraw_request", "label": "Withdraw an approval request",
      "inputs": [ { "name": "request", "ty": { "Ref": { "target": "approvals__approval_request", "on-delete": "Restrict" } }, "required": true, "label": "The request" } ],
      "invokers": { "signed-in": true, "roles": ["approvals__approval_admin"] },
      "subject": { "object": "approvals__approval_request", "input": "request" },
      "conditions": [ { "id": "still_open", "expr": "record.status == 'submitted' or record.status == 'in_legal' or record.status == 'in_brand' or record.status == 'in_region'", "error": "already-decided", "message": "This request can no longer be withdrawn." } ],
      "steps": [
        { "UpdateRecord": { "id": "withdraw", "object": "approvals__approval_request", "record": "record.$id", "fields": { "status": "'withdrawn'" } } } ] },
    {"id":"approvals__submit_request","label":"Submit an approval request","inputs":[{"name":"title","ty":"Str","required":false,"label":"title"},{"name":"summary","ty":"Str","required":false,"label":"summary"},{"name":"region","ty":"Str","required":false,"label":"region"},{"name":"business_unit","ty":"Str","required":false,"label":"business unit"},{"name":"expedite","ty":"Bool","required":false,"label":"expedite"},{"name":"attachment_note","ty":"Str","required":false,"label":"attachment note"}],"invokers":{"signed-in":true,"roles":[]},"conditions":[],"steps":[]},
    {"id":"approvals__decide_stage","label":"Record a stage decision","inputs":[{"name":"stage","ty":"Str","required":false,"label":"stage"},{"name":"decision","ty":"Str","required":false,"label":"decision"},{"name":"comment","ty":"Str","required":false,"label":"comment"},{"name":"conditions","ty":"Bool","required":false,"label":"conditions"}],"invokers":{"signed-in":true,"roles":[]},"conditions":[],"steps":[]},
    {"id":"approvals__delegate_stage","label":"Delegate a stage","inputs":[{"name":"stage","ty":"Str","required":false,"label":"stage"},{"name":"delegate_name","ty":"Str","required":false,"label":"delegate name"},{"name":"delegate_contact","ty":"Str","required":false,"label":"delegate contact"},{"name":"starts_at","ty":"Time","required":false,"label":"starts at"},{"name":"ends_at","ty":"Time","required":false,"label":"ends at"},{"name":"notes","ty":"Str","required":false,"label":"notes"}],"invokers":{"signed-in":true,"roles":[]},"conditions":[],"steps":[]},
    {"id":"approvals__save_sla_settings","label":"Save SLA settings","inputs":[{"name":"sla_hours","ty":"Int","required":false,"label":"sla hours"},{"name":"escalation_role","ty":"Str","required":false,"label":"escalation role"},{"name":"notify_on_escalation","ty":"Bool","required":false,"label":"notify on escalation"}],"invokers":{"signed-in":true,"roles":[]},"conditions":[],"steps":[]}
  ],
  "mailTemplates": [
    { "id": "approvals__decision_mail", "subject": "A decision was recorded on your approval request",
      "body": "[{\"type\":\"paragraph\",\"inlines\":[{\"type\":\"text\",\"text\":\"A decision was recorded on your approval request. Open the request to see the stage outcome.\"}]}]" }
  ],
  "noticeTemplates": [
    { "id": "approvals__stage_notice", "title": "Approval decision recorded",
      "body": "[{\"type\":\"paragraph\",\"inlines\":[{\"type\":\"text\",\"text\":\"A stage of your approval request has a decision.\"}]}]" }
  ],
  "settings": [
    { "id": "approvals__sla_hours", "label": "Approval SLA hours", "type": "i64", "default": {"Int": 48}, "levels": ["tenant", "team"] },
    { "id": "approvals__escalation_contact_role", "label": "Escalation contact role", "type": "string", "default": {"Str": "approval_admin"}, "levels": ["tenant"] }
  ]
}
