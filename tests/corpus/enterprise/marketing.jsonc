{
  // Marketing campaigns, customer journeys, audiences and email templates; depends on the segments, messaging and automations platform modules.
  "product": {
    "id": "marketing",
    "name": "Marketing",
    "description": "Runs campaigns, customer journeys, email templates and audience segments for the tenant.",
    "version": "1.0.0",
    "platform": { "min": "0.2" },
    "imports": {
      "spec": "../../../specifications/spec.jsonc",
      "entities": ["product-module", "ui-notice-received", "ui-session-ended", "api-error", "segments-define", "segments-read", "messages-send", "automations-define", "automations-read", "consent-record", "workflow-approve", "setting-read", "setting-write-tenant"]
    }
  },

  // Data model: campaigns and journeys refer to each other, so the cycle is in the records.


  "capabilities": [
    { "id": "marketing__manage_campaigns", "name": "Manage campaigns", "description": "Create, schedule and launch campaigns." },
    { "id": "marketing__manage_journeys", "name": "Manage journeys", "description": "Edit journey steps and pause or resume live journeys." },
    { "id": "marketing__view_audiences", "name": "View audiences", "description": "See audience members and segment counts." }
  ],

  "roles": [
    { "id": "marketing__marketer", "name": "Marketer", "description": "Runs day-to-day campaigns.", "level": "tenant",
      "holders": ["person", "team"], "capabilities": ["marketing__manage_campaigns", "marketing__view_audiences", "segments-read", "messages-send"] },
    { "id": "marketing__journey_editor", "name": "Journey editor", "description": "Designs and pauses customer journeys.", "level": "tenant",
      "holders": ["person", "team"], "capabilities": ["marketing__manage_journeys", "marketing__view_audiences", "automations-define", "automations-read", "segments-define"] },
    { "id": "marketing__marketing_lead", "name": "Marketing lead", "description": "Approves launches and owns consent.", "level": "tenant",
      "holders": ["person", "team"], "capabilities": ["marketing__manage_campaigns", "marketing__manage_journeys", "marketing__view_audiences", "workflow-approve", "consent-record"] },
    { "id": "marketing__member", "name": "Member", "description": "Any member of the tenant who reads what the product shares with everyone.", "level": "tenant",
      "holders": ["person", "team"], "capabilities": ["segments-read"] }
  ],

  "policies": [
    { "id": "marketing__marketer_campaigns", "role": "marketing__marketer", "resource": { "Object": "marketing__campaign" }, "actions": ["Create", "Read", "Update"] },
    { "id": "marketing__marketer_audiences", "role": "marketing__marketer", "resource": { "Object": "marketing__audience_member" }, "actions": ["Read"] },
    { "id": "marketing__journey_editor_steps", "role": "marketing__journey_editor", "resource": { "Object": "marketing__journey_step" }, "actions": ["Create", "Read", "Update", "Delete"] },
    { "id": "marketing__owner_drafts", "role": "marketing__member", "resource": { "Object": "marketing__campaign" }, "actions": ["Read", "Update"], "condition": "record.owner_name == principal" },
    { "id": "marketing__lead_approves_launch", "role": "marketing__marketing_lead", "resource": { "Object": "marketing__campaign" }, "actions": ["Update"] }
  ],

  "objects": [
    { "id": "marketing__campaign", "label": "Campaign",
      "fields": {
        "title": { "id": "title", "label": "Title", "ty": "Str", "required": true, "unique": false },
        "owner_name": { "id": "owner_name", "label": "Owner", "ty": "Str", "required": true, "unique": false },
        "state": { "id": "state", "label": "State", "ty": "Str", "required": true, "unique": false },
        "segment": { "id": "segment", "label": "Audience segment", "ty": "Str", "required": true, "unique": false },
        "summary": { "id": "summary", "label": "Summary", "ty": "Str", "required": false, "unique": false },
        "send_now": { "id": "send_now", "label": "Send now", "ty": "Bool", "required": false, "unique": false } },
      "constraints": {},
      "retention": { "days": 730, "from": "Created" } },
    { "id": "marketing__journey", "label": "Journey",
      "fields": {
        "title": { "id": "title", "label": "Title", "ty": "Str", "required": true, "unique": false },
        "state": { "id": "state", "label": "State", "ty": "Str", "required": true, "unique": false },
        "owner_name": { "id": "owner_name", "label": "Owner", "ty": "Str", "required": true, "unique": false },
        "campaign": { "id": "campaign", "label": "Campaign", "ty": { "Ref": { "target": "marketing__campaign", "on-delete": "Restrict" } }, "required": false, "unique": false } },
      "constraints": {},
      "retention": { "days": 730, "from": "Created" } },
    { "id": "marketing__journey_step", "label": "Journey step",
      "fields": {
        "name": { "id": "name", "label": "Name", "ty": "Str", "required": true, "unique": false },
        "kind": { "id": "kind", "label": "Kind", "ty": "Str", "required": true, "unique": false },
        "position": { "id": "position", "label": "Position", "ty": "Int", "required": true, "unique": false },
        "delay_ms": { "id": "delay_ms", "label": "Delay (ms)", "ty": "Int", "required": false, "unique": false },
        "journey": { "id": "journey", "label": "Journey", "ty": { "Ref": { "target": "marketing__journey", "on-delete": "Restrict" } }, "required": true, "unique": false } },
      "constraints": {},
      "retention": { "days": 730, "from": "Created" } },
    { "id": "marketing__audience_member", "label": "Audience member",
      "fields": {
        "full_name": { "id": "full_name", "label": "Full name", "ty": "Str", "required": false, "unique": false,
          "personal": { "kind": "name", "subject": { "Field": { "field": "email" } }, "searchable": false } },
        "email": { "id": "email", "label": "Email", "ty": "Str", "required": true, "unique": true,
          "personal": { "kind": "email-address", "subject": { "Field": { "field": "email" } }, "searchable": false } },
        "tier": { "id": "tier", "label": "Tier", "ty": "Str", "required": false, "unique": false },
        "lifetime_value": { "id": "lifetime_value", "label": "Lifetime value", "ty": "Int", "required": false, "unique": false },
        "opted_in": { "id": "opted_in", "label": "Opted in", "ty": "Bool", "required": true, "unique": false },
        "lapsed": { "id": "lapsed", "label": "Lapsed", "ty": "Bool", "required": true, "unique": false },
        "last_seen_at": { "id": "last_seen_at", "label": "Last seen", "ty": "Time", "required": false, "unique": false } },
      "constraints": {},
      "retention": { "days": 730, "from": "Created" } },
    { "id": "marketing__email_send", "label": "Email send",
      "fields": {
        "member": { "id": "member", "label": "Member", "ty": { "Ref": { "target": "marketing__audience_member", "on-delete": "Restrict" } }, "required": true, "unique": false },
        "template": { "id": "template", "label": "Template", "ty": "Str", "required": true, "unique": false },
        "category": { "id": "category", "label": "Category", "ty": "Str", "required": true, "unique": false },
        "outcome": { "id": "outcome", "label": "Outcome", "ty": "Str", "required": false, "unique": false },
        "sent_at": { "id": "sent_at", "label": "Sent", "ty": "Time", "required": true, "unique": false } },
      "constraints": {},
      "retention": { "days": 365, "from": "Created" } }
  ],

  "segments": [
    { "id": "marketing__opted_in_members", "name": "Opted-in members", "subject-type": "marketing__audience_member", "principal-field": "email", "predicate": "record.opted_in == true" },
    { "id": "marketing__lapsed_members", "name": "Lapsed members", "subject-type": "marketing__audience_member", "principal-field": "email", "predicate": "record.opted_in == true and record.lapsed == true" },
    { "id": "marketing__high_value_members", "name": "High-value members", "subject-type": "marketing__audience_member", "principal-field": "email", "predicate": "record.opted_in == true and record.lifetime_value >= 500" }
  ],

  "settings": [
    { "id": "marketing__frequency_cap", "label": "Messages per member per week", "type": "i64", "default": {"Int": 3}, "levels": ["tenant", "team"] },
    { "id": "marketing__quiet_hours_start", "label": "Quiet hours start", "type": "string", "default": {"Str": "21:00"}, "levels": ["tenant"] }
  ],

  "workflows": [
    { "id": "marketing__campaign_lifecycle", "object": "marketing__campaign", "field": "state", "initial": ["draft"],
      "transitions": [
        { "name": "schedule", "from": "draft", "to": "scheduled", "guard": "old.state == 'draft'", "set": {} },
        { "name": "launch", "from": "scheduled", "to": "live", "guard": "old.state == 'scheduled'", "set": {} },
        { "name": "pause", "from": "live", "to": "paused", "set": {} },
        { "name": "resume", "from": "paused", "to": "live", "set": {} },
        { "name": "end", "from": "live", "to": "ended", "set": {} } ] }
  ],

  "queries": [
    { "id": "marketing__live_campaigns", "object": "marketing__campaign", "filter": "record.state == 'live'",
      "params": [], "order": [ { "field": "title", "descending": false } ], "limit": 50 },
    { "id": "marketing__members_by_tier", "object": "marketing__audience_member", "filter": "record.tier == param.tier",
      "params": ["tier"], "order": [ { "field": "full_name", "descending": false } ], "limit": 100 }
  ],

  "views": [
    { "id": "marketing__campaign_board", "route": "/marketing/board", "title": "Campaign board",
      "sections": { "main": { "query": "marketing__live_campaigns", "args": {}, "include": [], "markdown": [], "single": false } } },
    {"id":"marketing__campaign_list_view","route":"/marketing/campaigns","title":"Campaigns","sections":{"main":{"query":"marketing__live_campaigns","args":{},"include":[],"markdown":[],"single":false}}},
    {"id":"marketing__campaign_editor_view","route":"/marketing/campaigns/:slug","title":"Campaign","sections":{"main":{"query":"marketing__live_campaigns","args":{},"include":[],"markdown":[],"single":false}}},
    {"id":"marketing__journey_board_view","route":"/marketing/journeys","title":"Journeys","sections":{"main":{"query":"marketing__live_campaigns","args":{},"include":[],"markdown":[],"single":false}}},
    {"id":"marketing__journey_designer_view","route":"/marketing/journeys/:slug","title":"Journey","sections":{"main":{"query":"marketing__live_campaigns","args":{},"include":[],"markdown":[],"single":false}}},
    {"id":"marketing__audience_list_view","route":"/marketing/audiences","title":"Audiences","sections":{"main":{"query":"marketing__live_campaigns","args":{},"include":[],"markdown":[],"single":false}}},
    {"id":"marketing__template_settings_view","route":"/marketing/settings","title":"Marketing settings","sections":{"main":{"query":"marketing__live_campaigns","args":{},"include":[],"markdown":[],"single":false}}}
  ],

  "mailTemplates": [
    { "id": "marketing__welcome_mail", "subject": "Welcome to the club",
      "body": "[{\"type\":\"paragraph\",\"inlines\":[{\"type\":\"text\",\"text\":\"Thanks for joining us. Here is what to expect next.\"}]}]" },
    { "id": "marketing__reminder_mail", "subject": "A quick reminder from us",
      "body": "[{\"type\":\"paragraph\",\"inlines\":[{\"type\":\"text\",\"text\":\"Your rewards are waiting for you.\"}]}]" },
    { "id": "marketing__winback_mail", "subject": "We miss you",
      "body": "[{\"type\":\"paragraph\",\"inlines\":[{\"type\":\"text\",\"text\":\"Come back this month and get a welcome-back offer.\"}]}]" }
  ],

  "noticeTemplates": [
    { "id": "marketing__campaign_live_notice", "title": "Campaign is live",
      "body": "[{\"type\":\"paragraph\",\"inlines\":[{\"type\":\"text\",\"text\":\"The campaign has started sending.\"}]}]" }
  ],



  "triggers": [
    { "id": "marketing__on_opt_in", "on": { "SegmentEntered": { "segment": "36e002ad-7049-8823-b89e-ec00ea9dafb1" } }, "automation": "marketing__welcome_journey" },
    { "id": "marketing__on_high_value", "on": { "SegmentEntered": { "segment": "863d1a73-129b-89ae-8473-5bc5fa841e50" } }, "automation": "marketing__reminder_journey" },
    { "id": "marketing__on_lapsed", "on": { "SegmentEntered": { "segment": "dc998259-97c8-83ab-9e50-a790dcc6b029" } }, "automation": "marketing__winback_fanout" }
  ],

  "automations": [
    { "id": "marketing__welcome_journey", "label": "Welcome a newly opted-in member",
      "run-as": { "roles": ["marketing__journey_editor"] }, "run-key": "param.seq",
      "start": "wait",
      "steps": {
        "wait": { "action": { "WaitFor": { "duration": 86400000 } }, "next": "check" },
        "check": { "action": { "Branch": { "condition": "record.opted_in == true", "object": "marketing__audience_member", "record": "record.$id", "then": "send", "else": "done" } } },
        "send": { "action": { "SendMail": { "template": "marketing__welcome_mail", "to": "param.person", "category": "marketing" } }, "next": "done", "retry": { "attempts": 3 }, "timeout": 30000 },
        "done": { "action": "End" } } },
    { "id": "marketing__reminder_journey", "label": "Remind a high-value member three days later",
      "run-as": { "roles": ["marketing__journey_editor"] }, "run-key": "param.seq",
      "start": "wait",
      "steps": {
        "wait": { "action": { "WaitFor": { "duration": 259200000 } }, "next": "remind" },
        "remind": { "action": { "SendMail": { "template": "marketing__reminder_mail", "to": "param.person", "category": "marketing" } }, "next": "done", "retry": { "attempts": 3 }, "timeout": 30000 },
        "done": { "action": "End" } } },
    { "id": "marketing__winback_fanout", "label": "Send a win-back mail to every lapsed member in batches",
      "run-as": { "roles": ["marketing__marketing_lead"] },
      "start": "fan",
      "steps": {
        "fan": { "action": { "FanOut": { "segment": "dc998259-97c8-83ab-9e50-a790dcc6b029", "batch": 100, "each": "mail" } }, "next": "done" },
        "mail": { "action": { "SendMail": { "template": "marketing__winback_mail", "to": "param.member", "category": "promotional" } }, "next": "done", "retry": { "attempts": 5 } },
        "done": { "action": "End" } } }
  ],

  "operations": [
    { "id": "marketing__launch_campaign", "label": "Launch a campaign",
      "inputs": [
        { "name": "title", "ty": "Str", "required": true, "label": "Campaign title" },
        { "name": "segment", "ty": "Str", "required": true, "label": "Audience segment" },
        { "name": "send_now", "ty": "Bool", "required": false, "label": "Send now" } ],
      "invokers": { "signed-in": true, "roles": ["marketing__marketer", "marketing__marketing_lead"] },
      "conditions": [ { "id": "has_title", "expr": "param.title != null", "error": "missing-title", "message": "A campaign needs a title." } ],
      "steps": [
        { "CreateRecord": { "id": "campaign", "object": "marketing__campaign", "fields": { "title": "param.title", "owner_name": "principal", "state": "'scheduled'", "segment": "param.segment", "send_now": "param.send_now" } } } ] },
    { "id": "marketing__pause_journey", "label": "Pause a journey",
      "inputs": [ { "name": "journey", "ty": { "Ref": { "target": "marketing__journey", "on-delete": "Restrict" } }, "required": true, "label": "The journey" } ],
      "invokers": { "signed-in": true, "roles": ["marketing__journey_editor", "marketing__marketing_lead"] },
      "subject": { "object": "marketing__journey", "input": "journey" },
      "conditions": [ { "id": "is_live", "expr": "record.state == 'live'", "error": "not-live", "message": "Only a live journey can be paused." } ],
      "steps": [
        { "UpdateRecord": { "id": "pause", "object": "marketing__journey", "record": "record.$id", "fields": { "state": "'paused'" } } } ] },
    {"id":"marketing__submit_campaign","label":"Submit a campaign for launch","inputs":[{"name":"title","ty":"Str","required":false,"label":"title"},{"name":"summary","ty":"Str","required":false,"label":"summary"},{"name":"segment","ty":"Str","required":false,"label":"segment"},{"name":"send_now","ty":"Bool","required":false,"label":"send now"}],"invokers":{"signed-in":true,"roles":[]},"conditions":[],"steps":[]},
    {"id":"marketing__request_journey_pause","label":"Request a journey pause","inputs":[{"name":"journey","ty":"Str","required":false,"label":"journey"},{"name":"reason","ty":"Str","required":false,"label":"reason"}],"invokers":{"signed-in":true,"roles":[]},"conditions":[],"steps":[]},
    {"id":"marketing__read_audience_page","label":"Read the audience page","inputs":[{"name":"tier","ty":"Str","required":false,"label":"tier"},{"name":"include_lapsed","ty":"Bool","required":false,"label":"include lapsed"}],"invokers":{"signed-in":true,"roles":[]},"conditions":[],"steps":[]},
    {"id":"marketing__save_settings","label":"Save the marketing settings","inputs":[{"name":"frequency_cap","ty":"Int","required":false,"label":"frequency cap"},{"name":"quiet_hours_start","ty":"Str","required":false,"label":"quiet hours start"},{"name":"weekly_digest","ty":"Bool","required":false,"label":"weekly digest"}],"invokers":{"signed-in":true,"roles":[]},"conditions":[],"steps":[]}
  ],


  "screens": [
    { "id": "marketing__campaign_list", "name": "Campaign list", "route": "/marketing/campaigns", "viewModel": "marketing__campaign_list_view",
      "kind": "marketing.list", "auth": "session", "description": "The campaigns of the tenant, by state.",
      "viewName": "marketing_campaign_list", "title": "Campaigns" },
    { "id": "marketing__campaign_editor", "name": "Campaign editor", "route": "/marketing/campaigns/:slug", "viewModel": "marketing__campaign_editor_view",
      "kind": "marketing.editor", "auth": "session", "description": "Write and launch one campaign.",
      "viewName": "marketing_campaign_editor", "title": "Campaign" },
    { "id": "marketing__journey_board", "name": "Journey board", "route": "/marketing/journeys", "viewModel": "marketing__journey_board_view",
      "kind": "marketing.list", "auth": "session", "description": "The customer journeys, by state.",
      "viewName": "marketing_journey_board", "title": "Journeys" },
    { "id": "marketing__journey_designer", "name": "Journey designer", "route": "/marketing/journeys/:slug", "viewModel": "marketing__journey_designer_view",
      "kind": "marketing.editor", "auth": "session", "description": "Lay out the steps of one journey.",
      "viewName": "marketing_journey_designer", "title": "Journey" },
    { "id": "marketing__audience_list", "name": "Audience list", "route": "/marketing/audiences", "viewModel": "marketing__audience_list_view",
      "kind": "marketing.list", "auth": "session", "description": "Audience members filtered by tier.",
      "viewName": "marketing_audience_list", "title": "Audiences" },
    { "id": "marketing__template_settings", "name": "Template and cap settings", "route": "/marketing/settings", "viewModel": "marketing__template_settings_view",
      "kind": "marketing.settings", "auth": "session", "description": "Frequency cap, quiet hours and digest settings.",
      "viewName": "marketing_template_settings", "title": "Marketing settings" }
  ],

  "forms": [
    { "id": "marketing__form_campaign_editor", "screen": "marketing__campaign_editor", "contract": "marketing__submit_campaign",
      "fields": [
        { "name": "title", "input": "title", "label": "Campaign title", "control": "text", "normalize": "trim" },
        { "name": "summary", "input": "summary", "label": "Summary", "control": "textarea" },
        { "name": "segment", "input": "segment", "label": "Audience segment", "control": "text" },
        { "name": "send_now", "input": "send_now", "label": "Send now", "control": "checkbox" } ],
      "submitLabel": "Launch", "onSuccess": { "navigate": { "screen": "marketing__campaign_list" }, "toast": "Campaign launched." },
      "onError": { "show": "inline" } },
    { "id": "marketing__form_journey_pause", "screen": "marketing__journey_board", "contract": "marketing__request_journey_pause",
      "fields": [
        { "name": "journey", "input": "journey", "label": "Journey", "control": "text" },
        { "name": "reason", "input": "reason", "label": "Reason", "control": "textarea" } ],
      "submitLabel": "Pause", "onSuccess": { "toast": "Pause requested." },
      "onError": { "show": "inline" } },
    { "id": "marketing__form_audience_filter", "screen": "marketing__audience_list", "contract": "marketing__read_audience_page",
      "fields": [
        { "name": "tier", "input": "tier", "label": "Tier", "control": "text" },
        { "name": "include_lapsed", "input": "include_lapsed", "label": "Include lapsed members", "control": "checkbox" } ],
      "submitLabel": "Apply", "onError": { "show": "inline" } },
    { "id": "marketing__form_template_settings", "screen": "marketing__template_settings", "contract": "marketing__save_settings",
      "fields": [
        { "name": "frequency_cap", "input": "frequency_cap", "label": "Messages per member per week", "control": "text" },
        { "name": "quiet_hours_start", "input": "quiet_hours_start", "label": "Quiet hours start", "control": "text" },
        { "name": "weekly_digest", "input": "weekly_digest", "label": "Send the weekly digest", "control": "checkbox" } ],
      "submitLabel": "Save", "onSuccess": { "toast": "Settings saved." },
      "onError": { "show": "inline" } }
  ],

  "actions": [
    { "id": "marketing__action_launch", "screen": "marketing__campaign_editor", "label": "Launch campaign",
      "contract": "marketing__submit_campaign", "form": "marketing__form_campaign_editor",
      "arguments": { "title": "form.title", "summary": "form.summary", "segment": "form.segment", "send_now": "form.send_now" },
      "onSuccess": { "toast": "Campaign launched." }, "onError": { "show": "toast" } },
    { "id": "marketing__action_request_pause", "screen": "marketing__journey_board", "label": "Pause journey",
      "contract": "marketing__request_journey_pause", "form": "marketing__form_journey_pause",
      "arguments": { "journey": "form.journey", "reason": "form.reason" },
      "onSuccess": { "toast": "Pause requested." }, "onError": { "show": "toast" } },
    { "id": "marketing__action_filter_audience", "screen": "marketing__audience_list", "label": "Apply filter",
      "contract": "marketing__read_audience_page", "form": "marketing__form_audience_filter",
      "arguments": { "tier": "form.tier", "include_lapsed": "form.include_lapsed" },
      "onError": { "show": "toast" } },
    { "id": "marketing__action_save_settings", "screen": "marketing__template_settings", "label": "Save settings",
      "contract": "marketing__save_settings", "form": "marketing__form_template_settings",
      "arguments": { "frequency_cap": "form.frequency_cap", "quiet_hours_start": "form.quiet_hours_start", "weekly_digest": "form.weekly_digest" },
      "onSuccess": { "toast": "Settings saved." }, "onError": { "show": "toast" } }
  ],

  "liveBindings": [
    { "id": "marketing__live_campaign_list", "screen": "marketing__campaign_list", "event": "ui-notice-received", "refresh": "whole",
      "when": { "any": ["event.kind == 'upsert'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "marketing__live_campaign_list_ended", "screen": "marketing__campaign_list", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "marketing__live_campaign_editor", "screen": "marketing__campaign_editor", "event": "ui-notice-received", "refresh": "whole",
      "when": { "any": ["event.kind == 'upsert'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "marketing__live_campaign_editor_ended", "screen": "marketing__campaign_editor", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "marketing__live_journey_board", "screen": "marketing__journey_board", "event": "ui-notice-received", "refresh": "whole",
      "when": { "any": ["event.kind == 'upsert'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "marketing__live_journey_board_ended", "screen": "marketing__journey_board", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "marketing__live_journey_designer", "screen": "marketing__journey_designer", "event": "ui-notice-received", "refresh": "whole",
      "when": { "any": ["event.kind == 'upsert'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "marketing__live_journey_designer_ended", "screen": "marketing__journey_designer", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "marketing__live_audience_list", "screen": "marketing__audience_list", "event": "ui-notice-received", "refresh": "whole",
      "when": { "any": ["event.kind == 'upsert'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "marketing__live_audience_list_ended", "screen": "marketing__audience_list", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "marketing__live_template_settings", "screen": "marketing__template_settings", "event": "ui-notice-received", "refresh": "whole",
      "when": { "any": ["event.kind == 'upsert'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "marketing__live_template_settings_ended", "screen": "marketing__template_settings", "event": "ui-session-ended", "refresh": "whole" }
  ],

  "errorMessages": [
    { "id": "marketing__error_title_taken", "on": "check", "kinds": ["unique"], "text": "A campaign already uses this title.", "field": { "name": "title" } },
    { "id": "marketing__error_journey_not_live", "on": "error", "kinds": ["workflow"], "text": "Only a live journey can be paused." }
  ],

  "claims": [
    { "id": "marketing__live-needs-approval", "kind": "structural",
      "statement": "A campaign SHALL NOT reach the live state without an approval from a marketing lead.",
      "subjects": ["product-module"],
      "rationale": "Launches reach real audiences, so a lead signs off each one.",
      "evaluate": { "method": "external-evidence" } },
    { "id": "marketing__no-send-without-opt-in", "kind": "structural",
      "statement": "A marketing message SHALL NOT be sent to an audience member who has not opted in.",
      "subjects": ["product-module"],
      "rationale": "Marketing sends need recorded consent under the consent rules.",
      "evaluate": { "method": "external-evidence" } }
  ]
}
