{
  // Connector automation for the tenant: connectors, webhook subscriptions, schedules, run logs and an API call budget. Depends on the platform webhook, automation and ledger capabilities.
  "product": {
    "id": "automation",
    "name": "Automation",
    "description": "Connectors, webhook subscriptions, schedules and an API call budget that run tenant automations.",
    "version": "1.0.0",
    "platform": { "min": "0.2" },
    "imports": {
      "spec": "../../../specifications/spec.jsonc",
      "entities": ["product-module", "ui-notice-received", "ui-session-ended", "api-error", "automations-read", "webhook-receive", "webhooks-manage", "ledger-read", "ledger-configure"]
    }
  },



  "roles": [
    { "id": "automation__automation_operator", "name": "Automation operator", "description": "Runs and watches connector automations day to day.", "level": "tenant",
      "holders": ["person", "team", "agent"], "capabilities": ["automations-read", "webhook-receive", "automation__run_connectors"] },
    { "id": "automation__connector_admin", "name": "Connector admin", "description": "Owns connector setup, webhook subscriptions and secret rotation.", "level": "tenant",
      "holders": ["person", "team"], "capabilities": ["webhooks-manage", "webhook-receive", "automations-read", "automation__run_connectors", "automation__rotate_subscriptions"] },
    { "id": "automation__budget_owner", "name": "Budget owner", "description": "Holds the API call budget and grants allowance from it.", "level": "tenant",
      "holders": ["person", "team"], "capabilities": ["ledger-configure", "ledger-read", "automation__manage_budget"] },
    { "id": "automation__member", "name": "Member", "description": "Any member of the tenant who reads what the product shares with everyone.", "level": "tenant",
      "holders": ["person", "team"], "capabilities": ["automations-read"] }
  ],

  "capabilities": [
    { "id": "automation__run_connectors", "name": "Run connectors", "description": "Start connector runs and watch their run logs." },
    { "id": "automation__rotate_subscriptions", "name": "Rotate subscription secrets", "description": "Rotate the signing secret of a webhook subscription." },
    { "id": "automation__manage_budget", "name": "Manage API budget", "description": "Grant allowance from the API call budget." }
  ],

  "objects": [
    { "id": "automation__connector", "label": "Connector",
      "fields": {
        "name": { "id": "name", "label": "Name", "ty": "Str", "required": true, "unique": true },
        "status": { "id": "status", "label": "Status", "ty": "Str", "required": true, "unique": false },
        "contact_email": { "id": "contact_email", "label": "Contact", "ty": "Str", "required": false, "unique": false,
          "personal": { "kind": "email-address", "subject": { "Field": { "field": "contact_email" } }, "searchable": false } },
        "subscription": { "id": "subscription", "label": "Subscription", "ty": { "Ref": { "target": "automation__webhook_subscription", "on-delete": "Restrict" } }, "required": false, "unique": false },
        "created_at": { "id": "created_at", "label": "Created", "ty": "Time", "required": true, "unique": false } },
      "constraints": {},
      "retention": { "days": 730, "from": "Created" } },
    { "id": "automation__webhook_subscription", "label": "Webhook subscription",
      "fields": {
        "target_url": { "id": "target_url", "label": "Endpoint URL", "ty": "Str", "required": true, "unique": false },
        "state": { "id": "state", "label": "State", "ty": "Str", "required": true, "unique": false },
        "secret_version": { "id": "secret_version", "label": "Secret version", "ty": "Int", "required": true, "unique": false },
        "rotated_at": { "id": "rotated_at", "label": "Rotated", "ty": "Time", "required": false, "unique": false },
        "connector": { "id": "connector", "label": "Connector", "ty": { "Ref": { "target": "automation__connector", "on-delete": "Restrict" } }, "required": false, "unique": false } },
      "constraints": {},
      "retention": { "days": 730, "from": "Created" } },
    { "id": "automation__schedule", "label": "Schedule",
      "fields": {
        "name": { "id": "name", "label": "Name", "ty": "Str", "required": true, "unique": false },
        "cadence": { "id": "cadence", "label": "Cadence", "ty": "Str", "required": true, "unique": false },
        "next_run": { "id": "next_run", "label": "Next run", "ty": "Time", "required": true, "unique": false },
        "paused": { "id": "paused", "label": "Paused", "ty": "Bool", "required": true, "unique": false },
        "connector": { "id": "connector", "label": "Connector", "ty": { "Ref": { "target": "automation__connector", "on-delete": "Restrict" } }, "required": false, "unique": false } },
      "constraints": {},
      "retention": { "days": 365, "from": "Created" } },
    { "id": "automation__run_log", "label": "Run log",
      "fields": {
        "schedule": { "id": "schedule", "label": "Schedule", "ty": { "Ref": { "target": "automation__schedule", "on-delete": "Restrict" } }, "required": false, "unique": false },
        "started_at": { "id": "started_at", "label": "Started", "ty": "Time", "required": true, "unique": false },
        "finished_at": { "id": "finished_at", "label": "Finished", "ty": "Time", "required": false, "unique": false },
        "outcome": { "id": "outcome", "label": "Outcome", "ty": "Str", "required": true, "unique": false },
        "calls": { "id": "calls", "label": "Calls", "ty": "Int", "required": true, "unique": false },
        "error_message": { "id": "error_message", "label": "Error", "ty": "Str", "required": false, "unique": false } },
      "constraints": {},
      "retention": { "days": 90, "from": "Created" } },
    { "id": "automation__budget_grant", "label": "Budget grant",
      "fields": {
        "budget_owner_name": { "id": "budget_owner_name", "label": "Budget owner", "ty": "Str", "required": true, "unique": false,
          "personal": { "kind": "name", "subject": { "Field": { "field": "budget_owner_name" } }, "searchable": false } },
        "units": { "id": "units", "label": "Units", "ty": "Int", "required": true, "unique": false },
        "period": { "id": "period", "label": "Period", "ty": "Str", "required": true, "unique": false },
        "granted_at": { "id": "granted_at", "label": "Granted", "ty": "Time", "required": true, "unique": false } },
      "constraints": {},
      "retention": { "days": 365, "from": "Created" } }
  ],

  "policies": [
    { "id": "automation__operator_reads_connectors", "role": "automation__automation_operator", "resource": { "Object": "automation__connector" }, "actions": ["Read"] },
    { "id": "automation__admin_manages_connectors", "role": "automation__connector_admin", "resource": { "Object": "automation__connector" }, "actions": ["Create", "Read", "Update"] },
    { "id": "automation__admin_manages_subscriptions", "role": "automation__connector_admin", "resource": { "Object": "automation__webhook_subscription" }, "actions": ["Read", "Update"] },
    { "id": "automation__budget_owner_grants", "role": "automation__budget_owner", "resource": { "Object": "automation__budget_grant" }, "actions": ["Create", "Read", "Update"] },
    { "id": "automation__member_reads_runs", "role": "automation__member", "resource": { "Object": "automation__run_log" }, "actions": ["Read"], "condition": "record.outcome != 'cancelled'" }
  ],

  "queries": [
    { "id": "automation__active_connector_list", "object": "automation__connector", "filter": "record.status == 'active'",
      "params": [], "order": [ { "field": "name", "descending": false } ], "limit": 100 },
    { "id": "automation__connector_by_status", "object": "automation__connector", "filter": "record.status == param.status",
      "params": ["status"], "order": [ { "field": "name", "descending": false } ], "limit": 100 },
    { "id": "automation__failing_runs", "object": "automation__run_log", "filter": "record.outcome == 'failed'",
      "params": [], "order": [ { "field": "started_at", "descending": true } ], "limit": 50 }
  ],

  "views": [
    { "id": "automation__connector_board", "route": "/automation/board", "title": "Connector board",
      "sections": { "main": { "query": "automation__active_connector_list", "args": {}, "include": [], "markdown": [], "single": false } } },
    {"id":"automation__connector_list_view","route":"/automation/connectors","title":"Connectors","sections":{"main":{"query":"automation__active_connector_list","args":{},"include":[],"markdown":[],"single":false}}},
    {"id":"automation__connector_detail_view","route":"/automation/connectors/:slug","title":"Connector","sections":{"main":{"query":"automation__active_connector_list","args":{},"include":[],"markdown":[],"single":false}}},
    {"id":"automation__connector_editor_view","route":"/automation/connectors/:slug/edit","title":"Edit connector","sections":{"main":{"query":"automation__active_connector_list","args":{},"include":[],"markdown":[],"single":false}}},
    {"id":"automation__subscription_list_view","route":"/automation/subscriptions","title":"Subscriptions","sections":{"main":{"query":"automation__active_connector_list","args":{},"include":[],"markdown":[],"single":false}}},
    {"id":"automation__schedule_list_view","route":"/automation/schedules","title":"Schedules","sections":{"main":{"query":"automation__active_connector_list","args":{},"include":[],"markdown":[],"single":false}}},
    {"id":"automation__budget_settings_view","route":"/automation/budget","title":"API budget","sections":{"main":{"query":"automation__active_connector_list","args":{},"include":[],"markdown":[],"single":false}}}
  ],

  "workflows": [
    { "id": "automation__subscription_lifecycle", "object": "automation__webhook_subscription", "field": "state", "initial": ["active"],
      "transitions": [
        { "name": "rotate", "from": "active", "to": "rotating", "guard": "old.state == 'active'", "set": { "rotated_at": "now" } },
        { "name": "complete_rotation", "from": "rotating", "to": "active", "set": {} },
        { "name": "retire", "from": "active", "to": "retired", "set": {} } ] }
  ],

  "screens": [
    { "id": "automation__connector_list", "name": "Connector list", "route": "/automation/connectors", "viewModel": "automation__connector_list_view",
      "kind": "automation.list", "auth": "session", "description": "The connectors of the tenant, by status.", "viewName": "automation_connector_list", "title": "Connectors" },
    { "id": "automation__connector_detail", "name": "Connector detail", "route": "/automation/connectors/:slug", "viewModel": "automation__connector_detail_view",
      "kind": "automation.detail", "auth": "session", "description": "One connector, its subscription and its recent runs.", "viewName": "automation_connector_detail", "title": "Connector" },
    { "id": "automation__connector_editor", "name": "Connector editor", "route": "/automation/connectors/:slug/edit", "viewModel": "automation__connector_editor_view",
      "kind": "automation.editor", "auth": "session", "description": "Edit a connector's contact, authentication and status.", "viewName": "automation_connector_editor", "title": "Edit connector" },
    { "id": "automation__subscription_list", "name": "Subscription list", "route": "/automation/subscriptions", "viewModel": "automation__subscription_list_view",
      "kind": "automation.list", "auth": "session", "description": "Webhook subscriptions and their secret rotation state.", "viewName": "automation_subscription_list", "title": "Subscriptions" },
    { "id": "automation__schedule_list", "name": "Schedule list", "route": "/automation/schedules", "viewModel": "automation__schedule_list_view",
      "kind": "automation.list", "auth": "session", "description": "Schedules and when each one next runs.", "viewName": "automation_schedule_list", "title": "Schedules" },
    { "id": "automation__budget_settings", "name": "Budget settings", "route": "/automation/budget", "viewModel": "automation__budget_settings_view",
      "kind": "automation.settings", "auth": "session", "description": "The API call budget and the grants drawn from it.", "viewName": "automation_budget_settings", "title": "API budget" }
  ],


  "forms": [
    { "id": "automation__form_connector_editor", "screen": "automation__connector_editor", "contract": "automation__submit_connector",
      "fields": [
        { "name": "name", "input": "name", "label": "Connector name", "control": "text", "normalize": "trim" },
        { "name": "status", "input": "status", "label": "Status", "control": "text" },
        { "name": "contact_email", "input": "contact_email", "label": "Contact email", "control": "text", "normalize": "trim" },
        { "name": "auth_scheme", "input": "auth_scheme", "label": "Auth scheme", "control": "text" },
        { "name": "api_key", "input": "api_key", "label": "API key", "control": "password" },
        { "name": "notes", "input": "notes", "label": "Notes", "control": "textarea" } ],
      "submitLabel": "Save connector", "onSuccess": { "navigate": { "screen": "automation__connector_list" }, "toast": "Connector saved." },
      "onError": { "show": "inline" } },
    { "id": "automation__form_subscription_rotation", "screen": "automation__subscription_list", "contract": "automation__submit_rotation",
      "fields": [
        { "name": "subscription", "input": "subscription", "label": "Subscription", "control": "text" },
        { "name": "target_url", "input": "target_url", "label": "Endpoint URL", "control": "text", "normalize": "trim" },
        { "name": "confirm", "input": "confirm", "label": "Confirm rotation", "control": "checkbox" } ],
      "submitLabel": "Rotate secret", "onSuccess": { "toast": "Secret rotated." }, "onError": { "show": "inline" } },
    { "id": "automation__form_budget_grant", "screen": "automation__budget_settings", "contract": "automation__submit_budget",
      "fields": [
        { "name": "owner_name", "input": "owner_name", "label": "Budget owner", "control": "text", "normalize": "trim" },
        { "name": "units", "input": "units", "label": "Units", "control": "text" },
        { "name": "period", "input": "period", "label": "Period", "control": "text" },
        { "name": "note", "input": "note", "label": "Note", "control": "textarea" } ],
      "submitLabel": "Grant budget", "onSuccess": { "toast": "Budget granted." }, "onError": { "show": "inline" } },
    { "id": "automation__form_connector_filter", "screen": "automation__connector_list", "contract": "automation__read_connector_board",
      "fields": [
        { "name": "status", "input": "status", "label": "Status", "control": "text" } ],
      "submitLabel": "Filter", "onSuccess": { "toast": "Filter applied." }, "onError": { "show": "inline" } }
  ],

  "actions": [
    { "id": "automation__action_save_connector", "screen": "automation__connector_editor", "label": "Save connector",
      "contract": "automation__submit_connector", "form": "automation__form_connector_editor",
      "arguments": { "name": "form.name", "status": "form.status", "contact_email": "form.contact_email", "auth_scheme": "form.auth_scheme", "api_key": "form.api_key", "notes": "form.notes" },
      "onSuccess": { "toast": "Connector saved." }, "onError": { "show": "inline" } },
    { "id": "automation__action_rotate", "screen": "automation__subscription_list", "label": "Rotate secret",
      "contract": "automation__submit_rotation", "form": "automation__form_subscription_rotation",
      "arguments": { "subscription": "form.subscription", "target_url": "form.target_url", "confirm": "form.confirm" },
      "onSuccess": { "toast": "Secret rotated." }, "onError": { "show": "toast" } },
    { "id": "automation__action_grant_budget", "screen": "automation__budget_settings", "label": "Grant budget",
      "contract": "automation__submit_budget", "form": "automation__form_budget_grant",
      "arguments": { "owner_name": "form.owner_name", "units": "form.units", "period": "form.period", "note": "form.note" },
      "onSuccess": { "toast": "Budget granted." }, "onError": { "show": "inline" } }
  ],

  "liveBindings": [
    { "id": "automation__live_connector_list", "screen": "automation__connector_list", "event": "ui-notice-received", "refresh": "whole",
      "when": { "any": ["event.kind == 'upsert'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "automation__live_connector_list_ended", "screen": "automation__connector_list", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "automation__live_connector_detail", "screen": "automation__connector_detail", "event": "ui-notice-received", "refresh": "whole",
      "when": { "any": ["event.kind == 'upsert'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "automation__live_connector_detail_ended", "screen": "automation__connector_detail", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "automation__live_connector_editor", "screen": "automation__connector_editor", "event": "ui-notice-received", "refresh": "whole",
      "when": { "any": ["event.kind == 'upsert'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "automation__live_connector_editor_ended", "screen": "automation__connector_editor", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "automation__live_subscription_list", "screen": "automation__subscription_list", "event": "ui-notice-received", "refresh": "whole",
      "when": { "any": ["event.kind == 'upsert'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "automation__live_subscription_list_ended", "screen": "automation__subscription_list", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "automation__live_schedule_list", "screen": "automation__schedule_list", "event": "ui-notice-received", "refresh": "whole",
      "when": { "any": ["event.kind == 'upsert'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "automation__live_schedule_list_ended", "screen": "automation__schedule_list", "event": "ui-session-ended", "refresh": "whole" },
    { "id": "automation__live_budget_settings", "screen": "automation__budget_settings", "event": "ui-notice-received", "refresh": "whole",
      "when": { "any": ["event.kind == 'upsert'", { "value": "event.object", "in": "depends-on" }] } },
    { "id": "automation__live_budget_settings_ended", "screen": "automation__budget_settings", "event": "ui-session-ended", "refresh": "whole" }
  ],

  "errorMessages": [
    { "id": "automation__error_name_taken", "on": "check", "kinds": ["unique"], "text": "Another connector already uses this name.", "field": { "name": "name" } },
    { "id": "automation__error_conflict", "on": "error", "kinds": ["conflict"], "text": "This was changed elsewhere. Reload to see the latest version." }
  ],


  "eventKinds": [
    { "id": "automation__run_finished", "kind": "app.automation-run-finished",
      "fields": [ { "name": "connector", "type": "string" }, { "name": "outcome", "type": "string" }, { "name": "finished_at", "type": "timestamp" } ],
      "readers": ["automation__automation_operator"] }
  ],

  "claims": [
    { "id": "automation__budget-never-negative", "kind": "structural",
      "statement": "The API call budget SHALL NOT fall below its floor of zero units.",
      "subjects": ["product-module"],
      "rationale": "The ledger floor rejects any PostLedger that would overdraw the pool.",
      "evaluate": { "method": "external-evidence" } },
    { "id": "automation__rotation-retires-old-secret", "kind": "structural",
      "statement": "A webhook subscription SHALL NOT accept deliveries signed with a retired secret once rotation completes.",
      "subjects": ["product-module"],
      "rationale": "Rotation advances the secret version and the previous version is refused.",
      "evaluate": { "method": "external-evidence" } }
  ],

  "settings": [
    { "id": "automation__sync_batch_size", "label": "Sync batch size", "type": "i64", "default": {"Int": 50}, "levels": ["tenant", "team"] },
    { "id": "automation__run_retention_days", "label": "Run log retention", "type": "i64", "default": {"Int": 90}, "levels": ["tenant"] }
  ],

  "segments": [
    { "id": "automation__active_connectors", "name": "Active connectors", "subject-type": "automation__connector", "principal-field": "name",
      "predicate": "record.status == 'active'" }
  ],

  "ledgerUnits": [
    { "id": "automation__api_calls", "description": "API calls the automation worker may make, one account per tenant." }
  ],

  "ledgerPools": [
    { "id": "automation__budget_pool", "description": "The pool that holds the API call budget." }
  ],

  "ledgerLimits": [
    { "id": "automation__api_floor", "unit": "automation__api_calls", "owner": { "pool": { "pool": "automation__budget_pool" } }, "floor": 0 }
  ],

  "mailTemplates": [
    { "id": "automation__rotation_mail", "subject": "A webhook secret was rotated",
      "body": "[{\"type\":\"paragraph\",\"inlines\":[{\"type\":\"text\",\"text\":\"The signing secret for one of your webhook subscriptions was rotated. Update the receiving endpoint before the old secret is retired.\"}]}]" }
  ],

  "noticeTemplates": [
    { "id": "automation__rotation_notice_template", "title": "Webhook secret rotated",
      "body": "[{\"type\":\"paragraph\",\"inlines\":[{\"type\":\"text\",\"text\":\"A subscription secret was rotated.\"}]}]" },
    { "id": "automation__budget_notice_template", "title": "API budget moved",
      "body": "[{\"type\":\"paragraph\",\"inlines\":[{\"type\":\"text\",\"text\":\"The API call budget changed. Check the remaining allowance.\"}]}]" }
  ],

  "triggers": [
    { "id": "automation__on_connector_event", "on": { "InboundWebhook": { "endpoint": "connector-events" } },
      "automation": "automation__sync_connectors" },
    { "id": "automation__on_rotation", "on": { "RecordUpdated": { "object": "automation__webhook_subscription", "transition": "rotate" } },
      "condition": "param.hop < 4", "automation": "automation__rotation_notice" },
    { "id": "automation__on_api_call", "on": { "LedgerPosted": { "unit": "automation__api_calls" } },
      "automation": "automation__budget_watch" },
    { "id": "automation__on_run_finished", "on": { "DeclaredEvent": { "kind": "app.automation-run-finished" } },
      "automation": "automation__invoke_connector_run" }
  ],

  "automations": [
    { "id": "automation__sync_connectors", "label": "Sync every active connector through its webhook",
      "run-as": { "roles": ["automation__connector_admin"] },
      "start": "fan",
      "steps": {
        "fan": { "action": { "FanOut": { "segment": "automation__active_connectors", "batch": 50, "each": "sync" } }, "next": "fan_done" },
        "sync": { "action": { "CallWebhook": { "subscription": "6f1c2a9e-3b4d-4e5f-8a9b-0c1d2e3f4a51", "body": { "connector": "record.$id", "requested_at": "now" } } }, "next": "sync_done", "retry": { "attempts": 3 } },
        "fan_done": { "action": "End" },
        "sync_done": { "action": "End" } } },
    { "id": "automation__rotation_notice", "label": "Tell the connector admin that a subscription secret was rotated",
      "run-as": { "roles": ["automation__connector_admin"] }, "run-key": "param.owner",
      "start": "notice",
      "steps": {
        "notice": { "action": { "CreateNotice": { "template": "automation__rotation_notice_template", "to": "param.owner", "record": "record.$id" } }, "next": "mail", "retry": { "attempts": 5 } },
        "mail": { "action": { "SendMail": { "template": "automation__rotation_mail", "to": "param.owner", "category": "transactional" } }, "next": "mail_done", "timeout": 30000 },
        "mail_done": { "action": "End" } } },
    { "id": "automation__budget_watch", "label": "Tell the budget owner when API calls are posted",
      "run-as": { "roles": ["automation__budget_owner"] },
      "start": "notice",
      "steps": {
        "notice": { "action": { "CreateNotice": { "template": "automation__budget_notice_template", "to": "param.owner", "record": "record.$id" } }, "next": "notice_done" },
        "notice_done": { "action": "End" } } },
    { "id": "automation__scheduled_run", "label": "Wait for a schedule's next run and open a run log",
      "run-as": { "roles": ["automation__automation_operator"] }, "run-key": "record.$id",
      "start": "wait",
      "steps": {
        "wait": { "action": { "WaitUntil": { "at": "param.due_at" } }, "next": "open_run" },
        "open_run": { "action": { "CreateRecord": { "object": "automation__run_log", "fields": { "schedule": "record.$id", "started_at": "now", "outcome": "'running'", "calls": "0" } } }, "next": "run_done" },
        "run_done": { "action": "End" } } },
    { "id": "automation__invoke_connector_run", "label": "Invoke the connector run that a finished run asks for",
      "run-as": { "roles": ["automation__automation_operator"] }, "run-key": "param.seq",
      "start": "invoke",
      "steps": {
        "invoke": { "action": { "InvokeOperation": { "operation": "automation__invoke_connector", "inputs": { "connector": "param.subject", "reason": "'run-finished'" } } }, "next": "invoke_done" },
        "invoke_done": { "action": "End" } } }
  ],

  "operations": [
    { "id": "automation__invoke_connector", "label": "Invoke a connector run",
      "inputs": [
        { "name": "connector", "ty": { "Ref": { "target": "automation__connector", "on-delete": "Restrict" } }, "required": true, "label": "The connector" },
        { "name": "reason", "ty": "Str", "required": false, "label": "Reason" } ],
      "invokers": { "signed-in": true, "roles": ["automation__automation_operator"] },
      "subject": { "object": "automation__connector", "input": "connector" },
      "conditions": [ { "id": "is_active", "expr": "record.status == 'active'", "error": "not-active", "message": "This connector is not active." } ],
      "steps": [
        { "PostLedger": { "id": "take_call", "owner": { "Pool": { "pool": "automation__budget_pool" } }, "unit": "automation__api_calls", "scope": "text(record.$id)", "amount": "-1", "reason": "connector-run" } },
        { "CreateRecord": { "id": "run", "object": "automation__run_log", "fields": { "started_at": "now", "outcome": "'queued'", "calls": "1" } } } ] },
    { "id": "automation__rotate_subscription", "label": "Rotate a subscription secret",
      "inputs": [ { "name": "subscription", "ty": { "Ref": { "target": "automation__webhook_subscription", "on-delete": "Restrict" } }, "required": true, "label": "The subscription" } ],
      "invokers": { "signed-in": true, "roles": ["automation__connector_admin"] },
      "subject": { "object": "automation__webhook_subscription", "input": "subscription" },
      "conditions": [ { "id": "is_active", "expr": "record.state == 'active'", "error": "not-active", "message": "Only an active subscription can be rotated." } ],
      "steps": [
        { "UpdateRecord": { "id": "rotate", "object": "automation__webhook_subscription", "record": "record.$id", "fields": { "state": "'rotating'", "rotated_at": "now" } } } ] },
    {"id":"automation__submit_connector","label":"Save a connector","inputs":[{"name":"name","ty":"Str","required":false,"label":"name"},{"name":"status","ty":"Str","required":false,"label":"status"},{"name":"contact_email","ty":"Str","required":false,"label":"contact email"},{"name":"auth_scheme","ty":"Str","required":false,"label":"auth scheme"},{"name":"api_key","ty":"Str","required":false,"label":"api key"},{"name":"notes","ty":"Str","required":false,"label":"notes"}],"invokers":{"signed-in":true,"roles":[]},"conditions":[],"steps":[]},
    {"id":"automation__submit_rotation","label":"Rotate a subscription secret","inputs":[{"name":"subscription","ty":"Str","required":false,"label":"subscription"},{"name":"target_url","ty":"Str","required":false,"label":"target url"},{"name":"confirm","ty":"Bool","required":false,"label":"confirm"}],"invokers":{"signed-in":true,"roles":[]},"conditions":[],"steps":[]},
    {"id":"automation__submit_budget","label":"Grant API budget","inputs":[{"name":"owner_name","ty":"Str","required":false,"label":"owner name"},{"name":"units","ty":"Int","required":false,"label":"units"},{"name":"period","ty":"Str","required":false,"label":"period"},{"name":"note","ty":"Str","required":false,"label":"note"}],"invokers":{"signed-in":true,"roles":[]},"conditions":[],"steps":[]},
    {"id":"automation__read_connector_board","label":"Read the connector board","inputs":[{"name":"status","ty":"Str","required":false,"label":"status"}],"invokers":{"signed-in":true,"roles":[]},"conditions":[],"steps":[]}
  ]
}
