// One huge tenant. A single tenant far larger than any budget, with reads concentrated on a
// small hot set and a tail that cannot be held. Accounting is under the most strain here. A
// second node updates hot assets and articles in the background.
{
  "name": "one-huge-tenant",
  "description": "A single tenant of tens of thousands of records, hot-set reads, a long tail and a few pages and scans.",
  "modules": ["content", "assets", "commerce"],
  "scale": 20000,
  "length": 4000,
  "clients": 4,
  "skew": 1.3,
  "mix": [
    { "op": "get", "object": "content__article", "weight": 30, "actor": "reader" },
    { "op": "get", "object": "assets__asset", "weight": 25, "actor": "reader" },
    { "op": "get", "object": "assets__rendition", "weight": 15, "actor": "reader" },
    { "op": "get", "object": "commerce__sku", "weight": 15, "actor": "reader" },
    { "op": "page", "object": "assets__asset", "weight": 6, "page-size": 50, "actor": "reader" },
    { "op": "scan", "object": "assets__collection", "weight": 2, "actor": "reader" },
    { "op": "update", "object": "assets__asset", "weight": 5, "actor": "editor" },
    { "op": "header", "weight": 2 }
  ],
  "faults": [
    { "kind": "foreign-commit", "every": 300, "object": "assets__asset" },
    { "kind": "foreign-commit", "every": 450, "object": "content__article" }
  ],
  "measures": [
    "wrapper.resident_bytes",
    "wrapper.hit_rate_by_cost",
    "store_side.bytes_read",
    "timing.overall",
    "coherence.divergences"
  ],
  "refutation": {
    "criterion": "Measured RSS exceeding accounted bytes plus reserves by more than the calibrated tolerance.",
    "result": "At a tenant much larger than the budget, process RSS exceeds resident_bytes plus reserves by more than the tolerance, or resident_bytes passes the budget."
  }
}
