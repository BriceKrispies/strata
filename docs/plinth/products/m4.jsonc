    {
      "id": "plinth_store__wishlist_add",
      "label": "wishlist add",
      "invokers": {
        "signed-in": false,
        "roles": [
          "plinth_store__role__member"
        ]
      },
      "inputs": [
        {
          "name": "product",
          "label": "Product",
          "ty": {
            "Ref": {
              "target": "plinth_store__product_inventory",
              "on-delete": "Restrict"
            }
          },
          "required": true
        }
      ],
      "conditions": [],
      "steps": [
        {
          "FindRecord": {
            "id": "mine",
            "object": "plinth_store__wishlist_items",
            "predicate": "record.member_id == principal and record.product_id == param.product",
            "error": "wishlist-ambiguous"
          }
        },
        {
          "Branch": {
            "id": "added",
            "test": {
              "Found": {
                "binding": "mine"
              }
            },
            "matched": [],
            "unmatched": [
              {
                "CreateRecord": {
                  "id": "item",
                  "object": "plinth_store__wishlist_items",
                  "fields": {
                    "member_id": "principal",
                    "product_id": "param.product",
                    "added_at": "now"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "plinth_store__wishlist_remove",
      "label": "wishlist remove",
      "invokers": {
        "signed-in": false,
        "roles": [
          "plinth_store__role__member"
        ]
      },
      "inputs": [
        {
          "name": "product",
          "label": "Product",
          "ty": {
            "Ref": {
              "target": "plinth_store__product_inventory",
              "on-delete": "Restrict"
            }
          },
          "required": true
        }
      ],
      "conditions": [],
      "steps": [
        {
          "FindRecord": {
            "id": "mine",
            "object": "plinth_store__wishlist_items",
            "predicate": "record.member_id == principal and record.product_id == param.product",
            "error": "wishlist-ambiguous"
          }
        },
        {
          "Branch": {
            "id": "removed",
            "test": {
              "Found": {
                "binding": "mine"
              }
            },
            "matched": [
              {
                "DeleteRecord": {
                  "id": "gone",
                  "object": "plinth_store__wishlist_items",
                  "record": "param.mine"
                }
              }
            ],
            "unmatched": []
          }
        }
      ]
    },
    {
      "id": "plinth_store__inventory_adjust",
      "label": "inventory adjust",
      "invokers": {
        "signed-in": false,
        "roles": [
          "plinth_store__role__admin"
        ]
      },
      "inputs": [
        {
          "name": "product",
          "label": "Product",
          "ty": {
            "Ref": {
              "target": "plinth_store__product_inventory",
              "on-delete": "Restrict"
            }
          },
          "required": true
        },
        {
          "name": "delta",
          "label": "Delta",
          "ty": "Int",
          "required": true
        },
        {
          "name": "reason",
          "label": "Reason",
          "ty": "Str",
          "required": true
        },
        {
          "name": "note",
          "label": "Note",
          "ty": "Str",
          "required": false
        }
      ],
      "subject": {
        "object": "plinth_store__product_inventory",
        "input": "product"
      },
      "conditions": [
        {
          "id": "reason_values",
          "expr": "param.reason in ['restock', 'damage', 'count_correction', 'return']",
          "error": "bad-reason",
          "message": "reason is one of restock, damage, count_correction, return."
        }
      ],
      "steps": [
        {
          "PostLedger": {
            "id": "adjust",
            "owner": {
              "Pool": {
                "pool": "plinth_store__stock_pool"
              }
            },
            "unit": "plinth_store__stock",
            "scope": "text(param.product)",
            "amount": "param.delta",
            "reason": "adjustment"
          }
        }
      ]
    }
  ],
