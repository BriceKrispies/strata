    {
      "id": "plinth_store__store_review_moderate",
      "label": "store review_moderate",
      "invokers": {
        "signed-in": false,
        "roles": [
          "plinth_store__role__admin"
        ]
      },
      "inputs": [
        {
          "name": "review_id",
          "label": "Review id",
          "ty": {
            "Ref": {
              "target": "plinth_store__product_reviews",
              "on-delete": "Restrict"
            }
          },
          "required": true
        },
        {
          "name": "status",
          "label": "Status",
          "ty": "Str",
          "required": true
        },
        {
          "name": "reason",
          "label": "Reason",
          "ty": "Str",
          "required": true
        }
      ],
      "conditions": [
        {
          "id": "status_values",
          "expr": "param.status in ['published', 'hidden']",
          "error": "bad-status",
          "message": "status is one of published, hidden."
        }
      ],
      "steps": [
        {
          "UpdateRecord": {
            "id": "step_1",
            "object": "plinth_store__product_reviews",
            "record": "param.review_id",
            "fields": {
              "status": "param.status",
              "moderated_by": "principal",
              "moderated_at": "now"
            }
          }
        }
      ]
    },
    // PLANNED F-priced-quote (checkout.place): Ranked, stackable, budgeted rule evaluation with a quote fingerprint. F-priced-quote: Plinth takes locks in a fixed order (CONTRACT §7.5 step 2); Strata locks are the kernel's revision guard (cms-1552), not the same ordering.; F-held-operations: approval: Agent calls are held (registry agent: approval); a high-value order (total >= high_value_threshold_points) is filed for store:approve by a person who is not the member.; F-visibility: row scope: owner only
