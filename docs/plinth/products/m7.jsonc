  "workflows": [
    {
      "id": "plinth_automation__automation_steps_lifecycle",
      "object": "plinth_automation__automation_steps",
      "field": "status",
      "initial": [
        "pending"
      ],
      "transitions": [
        {
          "name": "pending_to_running",
          "from": "pending",
          "to": "running",
          "set": {}
        },
        {
          "name": "pending_to_skipped",
          "from": "pending",
          "to": "skipped",
          "set": {}
        },
        {
          "name": "running_to_pending",
          "from": "running",
          "to": "pending",
          "set": {}
        }
      ]
    }
  ],
