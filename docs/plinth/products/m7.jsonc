      "constraints": {
        "type_values": {
          "id": "type_values",
          "expr": "record.type in ['award_points', 'notify', 'send_message', 'apply_promotion', 'create_task', 'webhook']",
          "message": "type is one of award_points, notify, send_message, apply_promotion, create_task, webhook."
